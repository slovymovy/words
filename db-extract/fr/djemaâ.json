                        "glosses": [
                            "Sorte d'unité politique coutumière des Kabyles."
                        ],
                        "tags": [
                            "Maroc",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "aed8e59e-d3e5-4348-b8e8-68d5b81de1dc",
                                "sense_id": "2ee7f4dc-d2fb-3777-9fc6-88b3d5ba2507",
                                "text": "Chez les Berbères l’unité politique est la djemaâ, c’est-à-dire la réunion d'un certain nombre de familles ayant une origine commune et vivant dans un douar, un kçar ou une dechra."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a31977e-0886-3090-b948-6aa977a8b06f",
                        "entry_id": "ec5a5c42-6502-3a26-913e-0161b5e80685",
                        "glosses": [
                            "Assemblée qui gouverne cette communauté politique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ffa352-5092-468d-8fc4-d066d416654f",
                                "sense_id": "5a31977e-0886-3090-b948-6aa977a8b06f",
                                "text": "L’amghar était investi d'un pouvoir exécutif alors que la djemaâ possédait un pouvoir consultatif et se portait garante des coutumes et des relations intérieures et extérieures de la communauté."
                            }
                        ]
