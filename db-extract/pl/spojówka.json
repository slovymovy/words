                "translations": [
                    {
                        "translation_id": "489ae822-11e3-46cb-9e81-f32dfaa83119",
                        "source_entry_id": "37782f9a-5d29-3813-898a-b991ca42b0b3",
                        "source_sense_id": "95353ac6-2cb7-3188-8a95-539481ab9e4e",
                        "target_lang_word": "conjunctiva",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunctiva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                        "entry_id": "9fcebccc-2872-34eb-b0d0-40e75c9531fb",
                                        "glosses": [
                                            "A clear mucous membrane that lines the inner surface of the eyelid and the exposed surface of the eyeball or sclera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51992dc6-2ed9-4317-bbae-526b675deae6",
                                                "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                                "text": "There is a third inner eyelid, highly developed and of beautiful mechanism: this is the nictitating membrane, or \"winker\" (nictito, I wink), a delicate, elastic, translucent, pearly-white fold of the conjunctiva. While the other lids move vertically and have a horizontal commissure, the winker sweeps horizontally or obliquely across the ball, from the side next the beak to the opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b829f75d-e860-4e57-a084-779bc9df3053",
                        "source_entry_id": "37782f9a-5d29-3813-898a-b991ca42b0b3",
                        "source_sense_id": "95353ac6-2cb7-3188-8a95-539481ab9e4e",
                        "target_lang_word": "结膜",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86f5b27a-0489-4df8-b2b8-ec53ded626a7",
                        "source_entry_id": "37782f9a-5d29-3813-898a-b991ca42b0b3",
                        "source_sense_id": "95353ac6-2cb7-3188-8a95-539481ab9e4e",
