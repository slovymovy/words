                        ],
                        "examples": [
                            {
                                "example_id": "be952a04-f1ff-4c69-8b31-77e8fb343641",
                                "sense_id": "54d8298d-dc9e-3f63-86bd-ca64c972f9cc",
                                "text": "Faire mettre son vin dans des quartauts."
                            },
                            {
                                "example_id": "625e969f-166c-42f9-b889-7542607bb180",
                                "sense_id": "54d8298d-dc9e-3f63-86bd-ca64c972f9cc",
                                "text": "Il pressait sa vendange, tandis que le carillonneur changeait de bras pour tirer sa corde et que le petit verdagon dauphinois remplissait les quartauts."
                            }
                        ]
                    }
