                            {
                                "example_id": "be3f9516-8976-4eab-91c8-a46e332b3cd5",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Die Software kann kundenspezifisch angepasst werden.“"
                            },
                            {
                                "example_id": "c23324bd-9501-4a22-8001-2277511b1f62",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Unter dem Namen WEdirekt betreibt das Unternehmen einen Online-Shop für kundenspezifisch gefertigte Platinen.“"
                            },
                            {
                                "example_id": "af3b913f-e578-4ecb-94fb-1d420eefeaa9",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Der Mittelständler mit seinen 140 Mitarbeitern begreift sich als Manufaktur, die hochtechnologische Einzelfertigungen nach kundenspezifischen Aufträgen baut.“"
                            },
                            {
                                "example_id": "ec8871c1-cc5e-475f-a135-9ee7da3a8f07",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "[…] „Sie bauen vornehmlich kundenspezifische Spezialmaschinen, während die Japaner, mit denen sich die Deutschen seit Jahren ein Kopf-an-Kopf-Rennen liefern, hauptsächlich Standardmaschinen liefern.“"
                            },
                            {
                                "example_id": "ad4df57a-ffeb-4041-a299-3147c4a553fb",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Sie steigerten den Anteil kundenspezifischer Produkte am Umsatz zwischen 1989 und 1992 fast nicht.“"
                            },
                            {
                                "example_id": "2e972ee9-26a4-47ee-97f2-0c46fb8811a5",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Beispiele typisierter Erzeugnisse mit kundenspezifischen Varianten und einfacher Struktur sind u. a. zahlreiche Zulieferkomponenten in der Automobilindustrie.“"
                            },
                            {
                                "example_id": "162b5160-495f-447e-aff5-af507a3c4e75",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„In einem ersten Schritt werden die kundenspezifischen Herstellkosten des Umsatzes und die sonstigen sowohl kundenspezifisch als auch nicht kundenspezifisch zuordenbaren Herstellkosten vom Nettoumsatz abgezogen.“"
                            },
                            {
                                "example_id": "3ccd35a8-6884-4e9a-951b-3af3dde6f815",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Der kundenspezifische Umsatz ist sicherlich die am leichtesten zu erfassende Größe.“",
                                "translation": "Den Kunden charakterisierend:"
                            },
                            {
                                "example_id": "f4adc70e-59e9-4a42-b99c-c7acd613cb33",
                                "sense_id": "3575a4a9-d831-31fb-8c4e-dcf8aa5ecf4a",
                                "text": "„Der Bedarfshorizont des Lieferabrufs ist kundenspezifisch. Es gibt Hersteller, die einen Lieferabruf mit Bedarfshorizont von bis zu 6 Monaten senden oder auch Hersteller, die einen Bedarfshorizont von über 12 Monate übermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
