{
    "word_family": [
        "администрация",
        "администрирование",
        "административный",
        "администрировать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a87b5ba-66de-341a-9785-9d043c008762",
                    "sense_definition": "Сотрудник гостиницы, ресторана, салона или другого заведения, отвечающий за встречу посетителей и организацию работы персонала.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "service_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Приветливый <w>администратор</w> на входе сразу проводил нас к свободному столику.",
                            "target_lang_translations": {
                                "en": "The friendly <w>manager</w> at the entrance immediately led us to a free table.",
                                "zh": "门口那位热情的<w>经理</w>立刻带我们到了空桌旁。"
                            }
                        },
                        {
                            "text": "Мы попросили <w>администратора</w> гостиницы разбудить нас ровно в семь утра.",
                            "target_lang_translations": {
                                "en": "We asked the hotel <w>receptionist</w> to wake us up at exactly seven in the morning.",
                                "zh": "我们请酒店的<w>前台</w>在早上七点整叫醒我们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "администратор гостиницы",
                        "администратор салона",
                        "стойка администратора",
                        "дежурный администратор"
                    ],
                    "target_lang_definitions": {
                        "en": "An employee in a hotel, restaurant, or salon who greets guests and organizes the work of the staff.",
                        "zh": "在酒店、餐厅或沙龙等场所负责接待客人并协调员工工作的员工。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "receptionist",
                                "target_lang_sense_clarification": "in a hotel or salon"
                            },
                            {
                                "target_lang_word": "manager",
                                "target_lang_sense_clarification": "in a restaurant or shop"
                            },
                            {
                                "target_lang_word": "administrator",
                                "target_lang_sense_clarification": "formal job title"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前台",
                                "target_lang_sense_clarification": "指酒店或沙龙的接待人员"
                            },
                            {
                                "target_lang_word": "经理",
                                "target_lang_sense_clarification": "指餐厅或商店的负责人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "142e3d57-ac27-39ab-b8cb-0c03f57996ac",
                    "sense_definition": "Должностное лицо, управляющее чем-либо; распорядитель в учреждении или коллективе.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manager_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Главный <w>администратор</w> театра следит за порядком во время спектакля.",
                            "target_lang_translations": {
                                "en": "The chief <w>administrator</w> of the theater watches over order during the performance.",
                                "zh": "剧院的首席<w>管理员</w>在演出期间负责维持秩序。"
                            }
                        },
                        {
                            "text": "Если у вас есть жалоба, вы можете позвать старшего <w>администратора</w> магазина.",
                            "target_lang_translations": {
                                "en": "If you have a complaint, you can call the senior store <w>manager</w>.",
                                "zh": "如果您有投诉，可以叫商店的资深<w>经理</w>过来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "управляющий",
                        "распорядитель"
                    ],
                    "antonyms": [
                        "подчинённый"
                    ],
                    "common_phrases": [
                        "старший администратор",
                        "администратор проекта",
                        "работа администратором"
                    ],
                    "target_lang_definitions": {
                        "en": "An official or person in charge who manages an organization, department, or specific tasks.",
                        "zh": "负责管理机构、部门或特定事务的官员或负责人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "administrator",
                                "target_lang_sense_clarification": "person managing affairs"
                            },
                            {
                                "target_lang_word": "manager",
                                "target_lang_sense_clarification": "person in charge of a business"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理员",
                                "target_lang_sense_clarification": "负责处理事务的人员"
                            },
                            {
                                "target_lang_word": "经理",
                                "target_lang_sense_clarification": "负责管理业务的人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d35bab1-9306-376f-8ba9-1843a6d2ad6a",
                    "sense_definition": "Специалист, занимающийся настройкой, наладкой и поддержанием работоспособности компьютерной сети и оборудования.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "it_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш системный <w>администратор</w> установил новое программное обеспечение на все офисные компьютеры.",
                            "target_lang_translations": {
                                "en": "Our system <w>administrator</w> installed new software on all office computers.",
                                "zh": "我们的<w>系统管理员</w>给所有办公电脑都安装了新软件。"
                            }
                        },
                        {
                            "text": "При возникновении проблем с интернетом нужно срочно звонить сетевому <w>администратору</w>.",
                            "target_lang_translations": {
                                "en": "If there are problems with the internet, you need to call the network <w>administrator</w> immediately.",
                                "zh": "如果网络出现问题，需要立即给<w>网管</w>打电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "системный администратор",
                        "сисадмин",
                        "админ"
                    ],
                    "common_phrases": [
                        "сетевой администратор",
                        "вызвать администратора"
                    ],
                    "target_lang_definitions": {
                        "en": "A specialist who sets up and maintains computer networks and equipment.",
                        "zh": "负责设置、维护计算机网络及设备的专业人员。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "system administrator",
                                "target_lang_sense_clarification": "full job title"
                            },
                            {
                                "target_lang_word": "administrator",
                                "target_lang_sense_clarification": "general term"
                            },
                            {
                                "target_lang_word": "admin",
                                "target_lang_sense_clarification": "informal short form"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "系统管理员",
                                "target_lang_sense_clarification": "正式职位名称"
                            },
                            {
                                "target_lang_word": "网管",
                                "target_lang_sense_clarification": "非正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598d0c87-2529-3169-831f-1d7cdcb6314f",
                    "sense_definition": "Учетная запись пользователя с максимальными правами доступа, позволяющими выполнять любые действия в компьютерной системе.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "it_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для установки этого драйвера вам потребуются права <w>администратора</w> на данном компьютере.",
                            "target_lang_translations": {
                                "en": "To install this driver, you will need <w>administrator</w> rights on this computer.",
                                "zh": "安装此驱动程序需要您拥有这台电脑的<w>管理员</w>权限。"
                            }
                        },
                        {
                            "text": "Не рекомендуется постоянно работать в системе под учетной записью <w>администратора</w> в целях безопасности.",
                            "target_lang_translations": {
                                "en": "It is not recommended to constantly work in the system under the <w>administrator</w> account for security reasons.",
                                "zh": "出于安全考虑，不建议始终使用<w>管理员</w>账户操作系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "суперпользователь",
                        "рут"
                    ],
                    "antonyms": [
                        "гость"
                    ],
                    "common_phrases": [
                        "права администратора",
                        "запуск от администратора",
                        "пароль администратора"
                    ],
                    "target_lang_definitions": {
                        "en": "A user account with full access rights to control a computer system.",
                        "zh": "拥有对计算机系统进行完全控制权限的用户账户。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "administrator",
                                "target_lang_sense_clarification": "account type"
                            },
                            {
                                "target_lang_word": "admin",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理员",
                                "target_lang_sense_clarification": "账户类型"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}