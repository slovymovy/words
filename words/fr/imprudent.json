    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c534486d-8d78-3c14-92ac-959ba984aed3",
                    "sense_definition": "Qui manque de prudence, qui agit sans précaution ni discernement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_prudence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune cycliste est très <w>imprudent</w> lorsqu'il traverse le carrefour sans regarder.",
                            "target_lang_translations": {
                                "en": "This young cyclist is very <w>careless</w> when he crosses the junction without looking.",
                                "ru": "Этот молодой велосипедист очень <w>неосторожен</w>, когда пересекает перекрёсток, не глядя по сторонам.",
                                "de": "Dieser junge Radfahrer ist sehr <w>unvorsichtig</w>, wenn er die Kreuzung überquert, ohne zu schauen.",
                                "es": "Este joven ciclista es muy <w>imprudente</w> cuando cruza la intersección sin mirar.",
                                "zh": "这个年轻的骑车人横穿十字路口时从不看路，非常<w>不谨慎</w>。"
                            }
                        },
                        {
                            "text": "Elle a été bien <w>imprudente</w> de confier ses économies à un inconnu.",
                            "target_lang_translations": {
                                "en": "She was really <w>imprudent</w> to entrust her savings to a stranger.",
                                "ru": "Она была очень <w>неосторожна</w>, доверив свои сбережения незнакомцу.",
                                "de": "Es war wirklich <w>unvorsichtig</w> von ihr, ihre Ersparnisse einem Fremden anzuvertrauen.",
                                "es": "Ella fue realmente <w>imprudente</w> al confiar sus ahorros a un desconocido.",
                                "zh": "她把积蓄交给一个陌生人，真是太<w>不谨慎</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inconsidéré",
                        "téméraire",
                        "insouciant"
                    ],
                    "antonyms": [
                        "prudent"
                    ],
                    "common_phrases": [
                        "conducteur imprudent"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking caution or discernment; acting without care or judgement.",
                        "ru": "Не проявляющий должной осторожности и рассудительности; действующий необдуманно.",
                        "de": "Ohne ausreichende Vorsicht oder Überlegung handelnd. Mögliche Gefahren werden nicht bedacht.",
                        "es": "Que actúa sin la precaución ni el criterio necesarios. Se aplica a personas y a sus actos.",
                        "zh": "缺乏谨慎和判断力，做事不注意分寸，不加考虑。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imprudent",
                                "target_lang_sense_clarification": "neutral, everyday register"
                            },
                            {
