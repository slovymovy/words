                        "entry_id": "ad53e016-c43f-3e96-82db-c9a0727ca441",
                        "glosses": [
                            "Qui concerne l’ordinal trente-trois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5e0f5d6-41ac-492a-b927-1f7805d4e4ba",
                                "sense_id": "14cfb261-5663-32de-a021-9bb598ae06bd",
                                "text": "Dans sa trente-troisième année."
                            },
                            {
                                "example_id": "42e9671f-7a6d-4e29-ab93-aa4a47555e66",
                                "sense_id": "14cfb261-5663-32de-a021-9bb598ae06bd",
                                "text": "Au trente-troisième étage\n sous l’œil fixe des fenêtres\n arrête\n Mon cœur est dans le ciel et manque de vertu\n Mais les ascenseurs se suivent\n et ne se ressemblent pas"
                            },
                            {
                                "example_id": "6295af96-b408-4cd1-8bac-382643a815f9",
                                "sense_id": "14cfb261-5663-32de-a021-9bb598ae06bd",
                                "text": "Il ne doit pas paraître singulier qu’un trente-troisième degré de proximité de plus ne nous échauffe pas, car je n’ai guère plus chaud à trente-deux pieds de ma cheminée qu’à trente-trois."
                            }
                        ]
