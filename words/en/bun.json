{
    "word_family": [
        "bunny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d62346a-2d72-3236-8af9-d5088c3d9158",
                    "sense_definition": "A bread roll that is served with a savoury filling such as a hamburger or hot dog.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the grilled hamburger on a fresh <w>bun</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи поджаренный гамбургер на свежую <w>булочку</w>.",
                                "zh": "请把烤好的汉堡肉饼放在新鲜的<w>小圆面包</w>上。"
                            }
                        },
                        {
                            "text": "The sesame seed <w>bun</w> was toasted perfectly for the sandwich.",
                            "target_lang_translations": {
                                "ru": "<w>Булочка</w> с кунжутом была идеально поджарена для сэндвича.",
                                "zh": "这个芝麻<w>小圆面包</w>烤得恰到好处，非常适合做三明治。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hamburger bun",
                        "hot dog bun",
                        "sesame seed bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Булочка, которая подается с несладкой начинкой, например, для гамбургера или хот-дога.",
                        "zh": "一种用于汉堡或热狗等食物的圆形面包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булочка",
                                "target_lang_sense_clarification": "для бургеров или хот-догов"
                            },
                            {
                                "target_lang_word": "булка",
                                "target_lang_sense_clarification": "хлебное изделие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小圆面包",
                                "target_lang_sense_clarification": "汉堡或热狗用的面包"
                            },
                            {
                                "target_lang_word": "汉堡胚",
                                "target_lang_sense_clarification": "特指汉堡用的面包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7caf43-da8b-3d84-b936-c55594b069a2",
                    "sense_definition": "A small bread roll that is sweetened or spiced.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ate a delicious cinnamon <w>bun</w> for breakfast this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня на завтрак мы съели вкусную <w>булочку</w> с корицей.",
                                "zh": "今天早上我们早餐吃了一份美味的肉桂<w>甜面包</w>。"
                            }
                        },
                        {
                            "text": "The bakery sells a sweet <w>bun</w> topped with white icing.",
                            "target_lang_translations": {
                                "ru": "В пекарне продается сладкая <w>плюшка</w>, покрытая белой глазурью.",
                                "zh": "这家面包店出售一种上面淋有白色糖霜的<w>甜面包</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinnamon bun",
                        "sticky bun",
                        "sweet bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сладкая или пряная булочка.",
                        "zh": "一种甜味或带有香料的小面包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булочка",
                                "target_lang_sense_clarification": "сладкая выпечка"
                            },
                            {
                                "target_lang_word": "плюшка",
                                "target_lang_sense_clarification": "сдобное изделие"
                            },
                            {
                                "target_lang_word": "сайка",
                                "target_lang_sense_clarification": "вид белой булки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甜面包",
                                "target_lang_sense_clarification": "甜味烘焙食品"
                            },
                            {
                                "target_lang_word": "小餐包",
                                "target_lang_sense_clarification": "小型面包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ac5188-f30b-3771-9a39-ef0f9d809382",
                    "sense_definition": "A roll of hair worn at the back of the head.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hairstyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied her long hair into a messy <w>bun</w> before starting her workout.",
                            "target_lang_translations": {
                                "ru": "Перед тренировкой она собрала свои длинные волосы в небрежный <w>пучок</w>.",
                                "zh": "运动前，她把长发随意地盘成了一个<w>丸子头</w>。"
                            }
                        },
                        {
                            "text": "The ballerina wore a tight <w>bun</w> to keep her hair out of her face.",
                            "target_lang_translations": {
                                "ru": "Балерина сделала тугой <w>узел</w>, чтобы волосы не лезли в лицо.",
                                "zh": "芭蕾舞演员梳了一个紧致的<w>发髻</w>，以防头发遮住脸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hair bun",
                        "chignon"
                    ],
                    "common_phrases": [
                        "messy bun",
                        "tight bun",
                        "hair bun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прическа в виде собранных на затылке волос.",
                        "zh": "将头发盘在脑后形成的圆球状发型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "прическа"
                            },
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "из волос"
                            },
                            {
                                "target_lang_word": "шиньон",
                                "target_lang_sense_clarification": "накладной или собранный элемент прически"
                            }
                        ],
                        "zh": [
