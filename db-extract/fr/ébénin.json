                        "examples": [
                            {
                                "example_id": "f3216c9e-f7b9-4751-803e-ead3c446ae4d",
                                "sense_id": "8e0399df-4e06-377f-ac1c-0a19b465ea78",
                                "text": "Le col grosset, courte l’oreille,\nEt, dessous un nez ebenin,\nUn petit mufle lyonin."
                            },
                            {
                                "example_id": "e9aac692-1fcd-413a-b945-6c6216b7827d",
                                "sense_id": "8e0399df-4e06-377f-ac1c-0a19b465ea78",
                                "text": "Ces deus voûtes ébénines,\nCes petits yeux colombins,\nCes deus lèvres coralines,\nCes deus rangs de perles fines\nTe sont ornements divins."
                            }
                        ]
                    }
