                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777de813-0716-4514-b88c-801eaea40fd5",
                                "sense_id": "9b2b333b-a9c4-364b-be59-ba828a2d58bd",
                                "text": "Il résulte de ce fait incontestable qu’en plus de voyager, bénévoler, aquagymer et choraler, les femmes sexas grandmaternent."
                            },
                            {
                                "example_id": "ac4a51da-c0c8-49e4-abe2-59568c4943cb",
                                "sense_id": "9b2b333b-a9c4-364b-be59-ba828a2d58bd",
                                "text": "les filles du 63 voulez-vous aquagymer ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "796aaaaf-41c4-313e-9cbd-006acf6511d3",
                        "entry_id": "a59bef9a-f1ea-3b00-a4e8-0a3382e838cc",
                        "glosses": [
                            "Pratiquer l’aquagym pour faire évoluer (son corps ou une partie de son corps)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b0428f56-e2a7-4e2e-aa53-87576bf5d3f5",
                                "sense_id": "796aaaaf-41c4-313e-9cbd-006acf6511d3",
                                "text": "Les tendons proéminents à l’aine, les côtes saillantes, le fessier plat aquagymé en vain et zébré de vergetures."
