                "senses": [
                    {
                        "sense_id": "f68bc59a-ee52-3f03-85d7-b88528842129",
                        "entry_id": "7cf76038-a142-3a31-bb28-fabd478f521e",
                        "glosses": [
                            "пренебр. то же, что американец"
