    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3fda33f8-adb0-344b-9da7-a54a08fb5b10",
                "word": "sulcus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c38d8ccd-9e07-42e5-8a49-7d7a84203687",
                        "entry_id": "3fda33f8-adb0-344b-9da7-a54a08fb5b10",
                        "tags": [
                            "plural"
                        ],
                        "form": "sulci"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                        "entry_id": "3fda33f8-adb0-344b-9da7-a54a08fb5b10",
                        "glosses": [
                            "A furrow or groove in an organ or a tissue, especially that marking the convolutions of the surface of the brain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4332aec5-cf5d-41f5-ad31-54c0de8a5cb3",
                                "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                                "text": "The sulci and gyri are the grooves and ridges, respectively."
                            },
                            {
                                "example_id": "0cbb2019-12bf-4090-a952-e9e30764cf77",
                                "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                                "text": "The Union’s soft latex-polymer roof is cerebrally domed and a cloudy piamater pink except in spots where it’s eroded down to pasty gray, and everywhere textured, the bulging rooftop, with sulci and bulbous convolutions."
                            },
                            {
                                "example_id": "c65c0283-2a21-42bf-91bc-4b7451c98bfa",
                                "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                                "text": "The largest sulcus, the longitudinal fissure, divides the brain into left and right hemispheres."
                            },
                            {
                                "example_id": "2fc6235e-457c-42ba-ac1b-82624e5dab0a",
                                "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                                "text": "Unlike most other sulci, the lateral sulcus is very deep."
                            },
                            {
                                "example_id": "3f995800-6254-4f21-a375-c05ea8747ada",
                                "sense_id": "2e264dd5-8927-3ced-ad88-2fe1b35da453",
                                "text": "The large surface area of the human cerebral cortex results in a pattern of gyri and sulci."
                            }
                        ]
                    },
