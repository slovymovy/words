                "senses": [
                    {
                        "sense_id": "ae3fcded-a890-3b6c-b856-038a4f29e405",
                        "entry_id": "e871cb61-bec4-3cfa-80ae-67bbcb6fa492",
                        "glosses": [
                            "Spülbecken mit unten befindlicher Öffnung zum Entsorgen von Flüssigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc84e675-77be-40ba-9695-96c00eb33056",
                                "sense_id": "ae3fcded-a890-3b6c-b856-038a4f29e405",
                                "text": "„Fine sortierte mit Bedacht die schlechten Pflaumen aus und die anderen wusch sie im Spülstein und legte sie dann in die gute Schüssel und schüttete darauf Brunnenwasser, damit sie sich nach dem langen Winter noch einmal vollsaugten und aufquollen und rund wurden und behäbig schimmerten.“"
                            },
                            {
                                "example_id": "69d7aae2-b907-42c4-8d77-fb8f7d3edb3b",
                                "sense_id": "ae3fcded-a890-3b6c-b856-038a4f29e405",
                                "text": "„Er lehnte sich an den Rand desSpülsteins und knetete seine Hände in der Schürze.“"
                            },
                            {
                                "example_id": "acc7fbc4-db7e-4780-a70a-35b18928a7bf",
                                "sense_id": "ae3fcded-a890-3b6c-b856-038a4f29e405",
                                "text": "„Neben dem Spülstein stapelt sich das benutzte Geschirr vom Kaffeetrinken und Abendessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
