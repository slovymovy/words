                "senses": [
                    {
                        "sense_id": "dfff13ec-cbb5-3d37-93d2-f3cb26ca57af",
                        "entry_id": "8a368382-5bae-3742-93e8-aef37b58321a",
                        "glosses": [
                            "großes, zur Beförderung von Gütern von sehr hohem Gewicht und Ausmaß genutztes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8e3896-026b-455f-8b52-cfec83253263",
                                "sense_id": "dfff13ec-cbb5-3d37-93d2-f3cb26ca57af",
                                "text": "„Wie ein Polizeisprecher sagte, war der Schwertransport mit etwa 50 bis 60 Stundenkilometern unterwegs.“"
                            },
                            {
                                "example_id": "2a75b649-c5d4-414d-9b4d-caef00e104c9",
                                "sense_id": "dfff13ec-cbb5-3d37-93d2-f3cb26ca57af",
                                "text": "„Denn an dem 79,5 Meter langen Schwertransport steuern nicht nur die Zugmaschinen, sondern auch sieben hydraulische Elemente der sogenannten Kesselbrücke, eine Art Auflieger.“"
                            },
                            {
                                "example_id": "964a5519-a492-47e3-8e8f-fdbdd638dd3f",
                                "sense_id": "dfff13ec-cbb5-3d37-93d2-f3cb26ca57af",
                                "text": "„Der 42 Meter lange und 5,4 Meter breite Schwertransport benötigte fast acht Stunden für die etwa 150 Kilometer auf der Autobahn vom Flughafen Zürich bis an den Flugplatz Eschbach-Bremgarten.“"
                            },
                            {
                                "example_id": "33ddf326-2b7a-464f-b713-6fa66a55208e",
                                "sense_id": "dfff13ec-cbb5-3d37-93d2-f3cb26ca57af",
                                "text": "„Jedes Jahr organisiere er 700 Schwertransporte, etliche seien schwerer als dieser, aber selten habe er solche Schwierigkeiten, sagt er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
