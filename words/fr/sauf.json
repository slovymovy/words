                    "sense_definition": "Indique une exception ou une exclusion ; hormis, excepté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le monde est venu à la réunion <w>sauf</w> Thomas qui était souffrant.",
                            "target_lang_translations": {
                                "en": "Everyone came to the meeting <w>except</w> Thomas, who was unwell.",
                                "ru": "Все пришли на собрание, <w>кроме</w> Томаса, который плохо себя чувствовал.",
                                "nl": "Iedereen kwam naar de vergadering, <w>behalve</w> Thomas, die ziek was.",
                                "de": "Alle sind zur Besprechung gekommen, <w>außer</w> Thomas, der krank war.",
                                "pl": "Wszyscy przyszli na zebranie <w>oprócz</w> Tomasza, który był chory.",
                                "it": "Tutti sono venuti alla riunione <w>tranne</w> Thomas, che non stava bene.",
                                "cs": "Na schůzi přišli všichni <w>kromě</w> Thomase, který byl nemocný.",
                                "tr": "Toplantıya, rahatsız olan Thomas <w>hariç</w> herkes geldi.",
                                "es": "Todo el mundo vino a la reunión <w>salvo</w> Thomas, que estaba indispuesto.",
                                "zh": "大家都来参加了会议，<w>除了</w>托马斯，他那天身体不舒服。"
                            }
                        },
                        {
                            "text": "Le musée municipal est ouvert tous les jours de la semaine <w>sauf</w> le lundi.",
                            "target_lang_translations": {
                                "en": "The city museum is open every day of the week <w>except</w> Mondays.",
                                "ru": "Городской музей открыт каждый день недели, <w>кроме</w> понедельника.",
                                "nl": "Het stadsmuseum is elke dag van de week open, <w>behalve</w> op maandag.",
                                "de": "Das Stadtmuseum ist täglich geöffnet, <w>außer</w> montags.",
                                "pl": "Muzeum miejskie jest otwarte codziennie <w>oprócz</w> poniedziałków.",
                                "it": "Il museo civico è aperto tutti i giorni della settimana <w>tranne</w> il lunedì.",
                                "cs": "Městské muzeum je otevřeno každý den v týdnu <w>kromě</w> pondělí.",
                                "tr": "Şehir müzesi, pazartesi <w>hariç</w> haftanın her günü açıktır.",
                                "es": "El museo municipal está abierto todos los días de la semana <w>excepto</w> los lunes.",
                                "zh": "这家市立博物馆一周内每天开放，<w>除了</w>周一。"
                            }
                        }
