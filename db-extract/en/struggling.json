                                "target_senses": [
                                    {
                                        "sense_id": "038614f9-664e-35b1-a60b-969ad4c9d6c5",
                                        "entry_id": "a285d913-e56f-3662-be15-f472fa9d9999",
                                        "glosses": [
                                            "высок., поэт. борьба; противостояние"
                                        ],
                                        "tags": [],
