                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68dcbd5c-ac5e-330e-a830-774e199100d1",
                                        "entry_id": "5643b481-42ac-30e7-9a05-cfa7ba354840",
                                        "glosses": [
                                            "Situación embarazosa; conflicto del cual no se sabe cómo salir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "874f7d7a-3e2e-471a-b82f-c2b277cdcda1",
                                                "sense_id": "68dcbd5c-ac5e-330e-a830-774e199100d1",
                                                "text": "«Era evidente que el día podía no acabar tan mal. Primero, me quitaba la depresión. Después, me ofrecía la posibilidad de salir del embrollo en el que me había metido. Iba a poder averiguar algo útil»."
                                            }
                                        ],
