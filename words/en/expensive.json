                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowler had an <w>expensive</w> over, giving away twenty runs to the batsman.",
                            "target_lang_translations": {
                                "ru": "У боулера был <w>неудачный</w> овер, в котором он отдал бэтсмену двадцать ранов.",
