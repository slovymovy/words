                        "sense_id": "a2003164-50c5-3fcb-9a00-ff026be3fc69",
                        "entry_id": "bb96e6a5-7c1b-33d8-aceb-5fa37a0ae354",
                        "glosses": [
                            "Adepte du jaïnisme, jaïna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2955aa17-45c9-4268-ab41-899362b29bde",
                                "sense_id": "a2003164-50c5-3fcb-9a00-ff026be3fc69",
                                "text": "Ni fou ni exhibitionniste, l’Indien nu, un jaïn, respecte les préceptes les plus extrêmes de sa religion."
                            },
                            {
                                "example_id": "87e44034-2f7b-4ab5-a560-60e981b37e51",
                                "sense_id": "a2003164-50c5-3fcb-9a00-ff026be3fc69",
                                "text": "Pour les jaïns, la nuit de Divali serait celle où Mahavira, l'un des personnages centraux de la tradition, aurait atteint l'illumination. La fête a une signification particulière également pour les hindous qui l'associent à la déesse de la prospérité, Laksmi."
                            }
                        ]
                    }
                ],
