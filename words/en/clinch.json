                    "sense_id": "c3e9b6b1-dc78-3b5b-b5fd-ea8697174722",
                    "sense_definition": "A firm hold, grip, or grasp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
