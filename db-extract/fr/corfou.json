        "fr-extract.jsonl": [
            {
                "entry_id": "e1a54996-1500-3c94-b1cf-065e3a96a08b",
                "word": "Corfou",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d808cfae-2a0a-33a8-bf1b-71a73cc81bab",
                        "entry_id": "e1a54996-1500-3c94-b1cf-065e3a96a08b",
                        "glosses": [
                            "Île de la mer Ionienne, en Grèce."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "f6979767-b504-497a-8463-3ea754b14ef8",
                                "sense_id": "d808cfae-2a0a-33a8-bf1b-71a73cc81bab",
                                "text": "Corfou est l’île la plus septentrionale des îles Ioniennes (2,307 km²), qui comprennent aussi Céphalonie, Cythère, Ithaque, Leucade, Paxos et Zante."
                            }
                        ]
                    },
                    {
                        "sense_id": "651c60b1-39b4-3fad-8196-c9af210ea1fd",
                        "entry_id": "e1a54996-1500-3c94-b1cf-065e3a96a08b",
                        "glosses": [
                            "La ville principale et capitale de cette île."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f3dc204-a81d-4e3e-a0de-d73f8f760f49",
                        "source_entry_id": "e1a54996-1500-3c94-b1cf-065e3a96a08b",
                        "target_lang_word": "Korfu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korfu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "575967b4-ab3f-338e-a12b-78947325ca20",
                                        "entry_id": "b08b8f3c-4191-365a-9fc9-d644161f79d0",
                                        "glosses": [
                                            "griechische Insel im Ionischen Meer"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d39600-8b71-4b7f-8d25-2ed817bf95fa",
                                                "sense_id": "575967b4-ab3f-338e-a12b-78947325ca20",
                                                "text": "„Auf der griechischen Insel Korfu ist eine 22-jährige Belgierin, die per europäischem Haftbefehl gesucht wurde, festgenommen worden.“"
                                            },
                                            {
                                                "example_id": "e6390774-9954-452c-a821-72601d7379f8",
                                                "sense_id": "575967b4-ab3f-338e-a12b-78947325ca20",
                                                "text": "„Ich aber fand die Schwatzhaftigkeit von Signora F. unglaublich, die doch nicht ganz Korfu verraten mußte, welcher Art die Geschichten waren, die ich ihr unter vier Augen erzählte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49b9326e-1901-4698-ae2e-c13e308ad483",
                        "source_entry_id": "e1a54996-1500-3c94-b1cf-065e3a96a08b",
