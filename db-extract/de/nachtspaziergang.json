                        "form": "die Nachtspaziergänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                        "entry_id": "e79bbe79-fedb-30ba-968f-e81250835811",
                        "glosses": [
                            "geruhsames Gehen zur nächtlichen Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de822213-74c8-4f0b-b614-ca0f009bda0a",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "Wir genossen unseren Nachtspaziergang im Dorf."
                            },
                            {
                                "example_id": "0ba0b816-0e74-4fdd-a65a-1950ee33e3d9",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "Er meinte, während seines Nachtspazierganges im Wald einen Bären erblickt zu haben."
                            },
                            {
                                "example_id": "d3e47b04-a715-4f49-a648-784e626f0998",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "„Um 7 Uhr brachten wir die beiden zur Bahn und machten dann noch einen schönen Nachtspaziergang durch den dicken Schnee. Der Wind pfeift kalt aber in unsern Herzen war es warm denn wir waren glücklich.“"
                            },
                            {
                                "example_id": "b359426b-629e-4700-960f-4e9790b9598e",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "„Nachtspaziergänge von 3 Stunden und mehr waren für mich keine Seltenheit. Ich lernte dadurch, meine Umgebung auch nachts zu erkennen.“"
                            },
                            {
                                "example_id": "3d79a2c7-9bfb-48bb-9b11-263947a055e1",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "„Was den seltsamen Vierhänder zu seinem Nachtspaziergange veranlaßt haben mochte, konnte ich natürlich nicht ergründen.“"
                            },
                            {
                                "example_id": "1b1bf0e2-4ad2-4907-8831-9fb5142d15c9",
                                "sense_id": "5ffd99c5-e17b-317e-b0fb-f7c61295b298",
                                "text": "„Wobei sich der Todeszeitpunkt natürlich noch nicht exakt ermitteln ließ, denn es war unklar, wie lange sie auf der Straße gelegen hatte, als Guđjón sie bei seinem Nachtspaziergang entdeckt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
