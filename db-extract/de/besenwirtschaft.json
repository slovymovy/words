                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "d8e257a0-3bbc-471e-9b1a-5983722efe73",
                                "sense_id": "59cc1eed-b82d-31dd-b03a-e74d31809003",
                                "text": "Heute Abend geh' ich mit meinen Freunden in die Besenwirtschaft hier im Dorf."
                            },
                            {
                                "example_id": "3f22161f-f77f-46b8-a994-b6f833a40967",
                                "sense_id": "59cc1eed-b82d-31dd-b03a-e74d31809003",
                                "text": "„In den Besenwirtschaften ging es immer hoch her, und einmal saß ich dort zufällig mit Professor Schröder an einem Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
