                                "example_id": "34693121-4b02-4224-90b3-8b142bfe839b",
                                "sense_id": "46c3dede-0f5c-3204-b7ee-d6a5c470edfb",
                                "text": "Internetzoekmotor Google kreeg uit België al meer dan 5.000 aanvragen om bepaalde websites niet meer weer te geven in de resultatenlijst van een opzoeking op basis van een persoonsnaam."
                            },
                            {
                                "example_id": "c6a311c9-2123-4e27-9ef2-28135412f69a",
                                "sense_id": "46c3dede-0f5c-3204-b7ee-d6a5c470edfb",
                                "text": "‘De festivalgangers kunnen het beste traject vinden om de concertplekken te bereiken via de zoekmotor op mivb.brussels.’"
                            }
                        ]
