                ],
                "senses": [
                    {
                        "sense_id": "58e85238-c880-3c6f-b1ed-d4a2626977f1",
                        "entry_id": "9983ef0b-a426-3df2-bdcf-c0a6e54e5477",
                        "glosses": [
                            "Relatif à l’inerrantisme, de l’inerrance de textes ou d’une doctrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c13639-db36-40ab-8be7-c5dfc34c70b8",
                                "sense_id": "58e85238-c880-3c6f-b1ed-d4a2626977f1",
                                "text": "La victoire du « parti inerrantiste » au sein de la principale dénomination évangélique et protestante, la Convention baptiste du Sud, entraîne sa fragmentation en une multitude de regroupements s’opérant sur base régionale ou par affinités, au point qu’il n’est plus possible aujourd’hui de parler d’une seule Convention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d25f7d6b-0276-4e5c-90d9-6d1f546d0b7e",
                        "source_entry_id": "9983ef0b-a426-3df2-bdcf-c0a6e54e5477",
                        "source_sense_id": "58e85238-c880-3c6f-b1ed-d4a2626977f1",
                        "target_lang_word": "inerrantist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inerrantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd358167-76c2-3f71-bd11-505326d02940",
                                        "entry_id": "460e6c04-1bd4-34bb-b6d2-62798bca3afd",
                                        "glosses": [
                                            "Someone who believes in the inerrancy of religious scripture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3532d343-42ed-48d9-8b3a-f21044597b6a",
                                                "sense_id": "cd358167-76c2-3f71-bd11-505326d02940",
                                                "text": "If you were to ask an inerrantist if she agrees with Ezek 18:20, she would certainly answer in the affirmative."
                                            },
                                            {
                                                "example_id": "738674ca-edb1-4ae8-96f6-743a94aeb7ee",
                                                "sense_id": "cd358167-76c2-3f71-bd11-505326d02940",
                                                "text": "Both the errantist and the inerrantist, each in his own way, allows the conviction that geocentricism is false to shape his interpretation of what God was saying by way of that passage from Psalm 93."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inerrantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1d5e05-e976-3e8b-8c67-9cdf1271ab6f",
                                        "entry_id": "befcecdb-b0a8-3a71-acef-de4b325de8fb",
                                        "glosses": [
                                            "Pertaining to such beliefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9919b00a-3f06-418d-aad8-39cc930a3eb7",
                                                "sense_id": "0d1d5e05-e976-3e8b-8c67-9cdf1271ab6f",
                                                "text": "Theologians who reject the inerrantist view of the Bible have pointed out several problems with it."
                                            },
                                            {
                                                "example_id": "8fa520f0-9578-49a9-a9a2-1ced272ab869",
                                                "sense_id": "0d1d5e05-e976-3e8b-8c67-9cdf1271ab6f",
                                                "text": "Many commentators, especially those with an “inerrantist” view of Scripture, claim that any interpretation questioning the actions of Elisha and the value of this story is sinful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
