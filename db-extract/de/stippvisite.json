                "senses": [
                    {
                        "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                        "entry_id": "913c3b39-dfc7-35aa-a9b2-6f63609edcdc",
                        "glosses": [
                            "kurzer Besuch"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e55c6b7c-34f7-4e77-bf14-5163f66df0e9",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "Er machte noch eine Stippvisite bei seinen Großeltern, bevor er nach Hause ging."
                            },
                            {
                                "example_id": "a37146d2-6cf5-4781-ba14-e2022ca22948",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "„Ich bin ja wohl nicht der erste, der glaubte, hier eine Stippvisite zu machen, und für den es dann anders kam.“"
                            },
                            {
                                "example_id": "a335325a-d64a-458e-9d4e-1546d9a5f69d",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "„Das war ja keine Erholungsreise nach der Krim und keine Stippvisite bei lieben Verwandten.“"
                            },
                            {
                                "example_id": "52bbdd98-b435-4ce5-a73e-66b245887d5f",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "„Er war auf eine Stippvisite aus Gaza gekommen, dem sein erster, ausgiebiger Besuch gegolten hatte.“"
                            },
                            {
                                "example_id": "a80886c3-0041-4d7c-9b21-e284437ddb62",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "„Zwischen zwei Stippvisiten setzt er seine Gitarristenlaufbahn fort, flattert von Mädchen zu Mädchen, versucht sein Glück in New York, spielt hier und dort vor und genießt im Dunst der Nacht rückhaltlos seine Jugend.“"
                            },
                            {
                                "example_id": "7462734d-fa00-4f55-bb0c-92dd22084969",
                                "sense_id": "ef6a0b28-e19a-3142-b6b8-3bb9d4f9d340",
                                "text": "„Nach den Stippvisiten Caesars in Britannien sollten 90 Jahre vergehen, ehe sich den Römern unter Kaiser Claudius eine Gelegenheit bot, das Land zu erobern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
