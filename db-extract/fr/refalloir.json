                "senses": [
                    {
                        "sense_id": "423a5786-d287-3f1e-b2cf-5dad1b1358af",
                        "entry_id": "efc32291-f408-3d7c-8d9c-98512b154559",
                        "glosses": [
                            "Falloir à nouveau."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "38ea857c-f321-4540-a6b7-28d903f51ec1",
                                "sense_id": "423a5786-d287-3f1e-b2cf-5dad1b1358af",
                                "text": "Pour leur amalgame, il en était arrivé à la conclusion, valable pour tous les temps, qu'il refallait à la nation et au Roi une armée."
                            },
                            {
                                "example_id": "618237ab-5704-4c93-acd5-e94dc6311eeb",
                                "sense_id": "423a5786-d287-3f1e-b2cf-5dad1b1358af",
                                "text": "Avec le temps là qu'il fait, ça ne sera pas une promenade, et puis, il refaudra courir la montagne pour l'annonce de la tatan Félicie..."
                            },
                            {
                                "example_id": "57a413b6-0f00-402f-93cb-d4d9f7adb108",
                                "sense_id": "423a5786-d287-3f1e-b2cf-5dad1b1358af",
                                "text": "Rien de grave. Il va refalloir les laissez-passer, même pour enfants et nous ferons notre mars tranquillement."
                            },
                            {
                                "example_id": "2f76f528-174e-49e8-8945-c3295bf859a3",
                                "sense_id": "423a5786-d287-3f1e-b2cf-5dad1b1358af",
                                "text": "Eh bien dans cette mesure, mon cher Justin Loret, va refalloir nous dire votre honorée du tant."
                            }
                        ]
                    }
