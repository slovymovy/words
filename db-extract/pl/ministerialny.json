                                "target_senses": [
                                    {
                                        "sense_id": "54c96ebe-9187-38fc-b563-fd6dfefd7239",
                                        "entry_id": "49d1b1af-1d06-3611-bd87-f928f1ff3d44",
                                        "glosses": [
                                            "Related to a religious minister or ministry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a8378e9-b7a5-3613-9deb-81f94820b856",
                                        "entry_id": "49d1b1af-1d06-3611-bd87-f928f1ff3d44",
                                        "glosses": [
                                            "Related to a governmental minister or ministry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c60d0e-2d43-4dba-84a6-9059b1518390",
                                                "sense_id": "2a8378e9-b7a5-3613-9deb-81f94820b856",
                                                "text": "In over a quarter of a century of writing this column, there has been no end of scandals, mishaps, errors and general cock-ups resulting from ministerial incompetence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b71b10-5507-3408-9224-c93bd50ddbad",
                                        "entry_id": "49d1b1af-1d06-3611-bd87-f928f1ff3d44",
                                        "glosses": [
                                            "Having the power to wield delegated executive authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "996a08df-3de9-3b63-af51-25157026e5ea",
                                        "entry_id": "49d1b1af-1d06-3611-bd87-f928f1ff3d44",
                                        "glosses": [
                                            "Serving as an instrument or means (i.e., procedural or ancillary, not substantive)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e821372a-d973-4c30-a245-a0e52da00dd0",
                                                "sense_id": "996a08df-3de9-3b63-af51-25157026e5ea",
                                                "text": "Filling out the form under the direction of a lawyer is a ministerial task performed by a legal secretary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ministerial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b11d2c-70d0-3000-a34e-99c10c7f4d9e",
                                        "entry_id": "71fbe9a5-6b30-38bc-b694-1a4db867d217",
                                        "glosses": [
                                            "A member of the mediaeval estate or caste of unfree nobles."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d74a1c-78a0-4cb9-8eb7-814c60c8ea57",
                                                "sense_id": "b4b11d2c-70d0-3000-a34e-99c10c7f4d9e",
                                                "text": "By the time of the Nibelungenlied the word was used to denote a wide variety of usually ecclesiastic or royal administrators, from the lowest, unfree ministerial to an enfeoffed judge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51149a16-cf6c-358e-875c-93f9dda33d1e",
                                        "entry_id": "71fbe9a5-6b30-38bc-b694-1a4db867d217",
                                        "glosses": [
                                            "A meeting of government ministers from partner countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ebc101c-4291-426b-991d-a434e2288e30",
                                                "sense_id": "51149a16-cf6c-358e-875c-93f9dda33d1e",
                                                "text": "The NATO ministerial was attended by the defence ministers of all member states."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
