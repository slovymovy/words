        "fr-extract.jsonl": [
            {
                "entry_id": "f7e66afe-d3ac-3e38-8926-dbc5c4eeb82d",
                "word": "carbonisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8ee09bb-2de3-478c-8446-63f1217f2a16",
                        "entry_id": "f7e66afe-d3ac-3e38-8926-dbc5c4eeb82d",
                        "tags": [
                            "plural"
                        ],
                        "form": "carbonisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "197744be-fc17-3b8e-ad54-de142c07a9ef",
                        "entry_id": "f7e66afe-d3ac-3e38-8926-dbc5c4eeb82d",
                        "glosses": [
                            "Transformation d’une substance organique en charbon."
                        ],
                        "tags": [
                            "Chimie organique",
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "c10ce1b9-7609-47c8-bfd5-b3a8f5b057a4",
                                "sense_id": "197744be-fc17-3b8e-ad54-de142c07a9ef",
                                "text": "La carbonisation est une opération qui a pour but d’extraire du bois la partie fixe qu'il renferme."
                            },
                            {
                                "example_id": "194908a5-d7af-4b53-a859-5b49b132d79e",
                                "sense_id": "197744be-fc17-3b8e-ad54-de142c07a9ef",
                                "text": "Jusqu’ici l’épaillage est préparé, mais non effectué. Il faut maintenant soumettre la laine pendant quelque temps à l’action d’une température de 80° à 100°, afin de permettre la carbonisation."
                            },
                            {
                                "example_id": "962b7d40-72bb-44d7-9211-468b3cbdcdf0",
                                "sense_id": "197744be-fc17-3b8e-ad54-de142c07a9ef",
                                "text": "Les opérations de broyage marquent usuellement le terme des opérations d’épuration des fines, que celles-ci soient destinées à l’agglomération ou à la carbonisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "07ee8ab1-8967-3816-9793-cfc98e2c1482",
                        "entry_id": "f7e66afe-d3ac-3e38-8926-dbc5c4eeb82d",
                        "glosses": [
                            "Traitement thermique de la laine qui consistait à faire bruler les fibres végétales mêlées à la laine car celles-ci se carbonisent à une température inférieure à celle de la laine une fois le tout préalablement trempé dans un bain acidifié puis essorées."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5722e1e7-4cdd-3d23-86e7-a2ce23a8dfa9",
                        "entry_id": "f7e66afe-d3ac-3e38-8926-dbc5c4eeb82d",
                        "glosses": [
                            "Processus naturel par lequel des restes végétaux sont transformés en résidu carboné (tels que le charbon fossile, la xylite, la lignite ou des films de carbone) sous l’effet de la pression et du temps, dans des conditions de fossilisation."
                        ],
                        "tags": [
                            "Paléobotanique"
                        ],
                        "examples": [
                            {
                                "example_id": "b5cffef8-da35-4d90-b106-1de008ceb312",
                                "sense_id": "5722e1e7-4cdd-3d23-86e7-a2ce23a8dfa9",
                                "text": "La carbonisation peut également survenir suite à un incendie."
                            }
                        ]
                    }
                ],
                "translations": [
