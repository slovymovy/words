                        "entry_id": "708b91ec-932c-3ee3-b6ff-0b73620b8501",
                        "glosses": [
                            "nach langjährigen Verhandlungen unter Beteiligung der verschiedenen Stenografenschulen beschlossene Kompromissform der Kurzschrift, verbindlich im ganz Deutschland. Vollständige Bezeichnung: Deutsche Einheitskurzschrift."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fa32818-b249-4f82-99ab-75e61278c0cd",
                                "sense_id": "4a7c3ae8-673e-3858-b3d7-cd991fefa597",
                                "text": "Die Deutsche „Einheitskurzschrift“ wurde am 20.9.1924 durch den Reichsinnenminister im Deutschen Reich in Kraft gesetzt."
                            },
                            {
                                "example_id": "26541878-2eb3-46de-8729-78a1f189aeb6",
                                "sense_id": "4a7c3ae8-673e-3858-b3d7-cd991fefa597",
                                "text": "„Die gesamte deutsche Kurzschriftbewegung zeigte sich von dieser Zeit an dauernd und vorwiegend durch das Bestreben geleitet, eine Einheitskurzschrift zu schaffen.“"
                            }
                        ],
