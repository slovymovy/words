                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e98d061-1001-4f7f-a388-725096d1580c",
                                                "sense_id": "8b08ccab-c8fe-3676-bab2-191299085fde",
                                                "text": "It is, frankly, a scandal that at the various rail industry events I attend, the number of non-white faces can be counted on one or (at best) two hands."
                                            },
                                            {
                                                "example_id": "3fd6678e-74b8-4888-be9b-2da6d78a2ab0",
                                                "sense_id": "8b08ccab-c8fe-3676-bab2-191299085fde",
                                                "text": "Coincidentally, support for race-conscious policies, such as affirmative action, financial reparations for slavery, and race-based government assistance, have reached record highs. In fact, by some measures, the racial liberalism of white Democrats and liberals has even surpassed that of their non-white counterparts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-white",
                                "target_lang_code": "en",
                                "target_senses": [
