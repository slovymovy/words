                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea eagle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                        "entry_id": "dfbd8721-7fc4-3976-97f1-8e645ba8de50",
                                        "glosses": [
                                            "An eagle with a distinctive white tail; specifically, a white-tailed eagle (Haliaeetus albicilla)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bf9007-3308-40a8-ad9d-0b6a9df7f8b8",
                                                "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                                "text": "His face is wild and keen like a sea-eagle’s, and from his bristling brows the eyes dart glances sharp as a glancing spear."
                                            },
                                            {
                                                "example_id": "b7f9c4bd-fdd0-460e-855d-4d1faba7ebbb",
                                                "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                                "text": "\"Up on Rannoch Moor, we often see Sea Eagles,\" she says, although in the rain, there is no sign of them today. \"If we hit a deer, that's their lunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1718e60-0bd4-39b4-9375-833af0104b0f",
                                        "entry_id": "dfbd8721-7fc4-3976-97f1-8e645ba8de50",
                                        "glosses": [
                                            "A genus of eagles (genus Haliaeetus)."
                                        ],
