        "fr-extract.jsonl": [
            {
                "entry_id": "8f014bfa-8234-39c2-8a8c-318778a5dc15",
                "word": "Faucheux",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e32cac3b-1f67-3183-980d-5fe7a94ebf19",
                        "entry_id": "8f014bfa-8234-39c2-8a8c-318778a5dc15",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c1ed573-d4cd-474a-b1b9-3b9aae57f99b",
                                "sense_id": "e32cac3b-1f67-3183-980d-5fe7a94ebf19",
                                "text": "Les antagonistes, dans les films et les livres pour enfants, ont pour fonction de créer une tension dramatique, bien sûr, mais surtout d’éclairer les méchants, expose Pierre Faucheux, psychologue pour enfant au CMP de Viroflay."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f0b17495-1c8a-32e8-938b-817d3b558195",
                "word": "faucheux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                        "entry_id": "f0b17495-1c8a-32e8-938b-817d3b558195",
                        "glosses": [
                            "Ordre d'arachnides également nommés opilions et possédant quatre paires de pattes grêles. → voir faucheur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c371ebb0-7634-4e24-9721-89414d44d249",
                                "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                                "text": "Les faucheux se distinguent des araignées par l'absence de venin et le fait qu'ils ne tissent pas de toile."
                            },
                            {
                                "example_id": "3f188f80-c617-43a8-8848-07b9be4bc25b",
                                "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                                "text": "— C’est vrai, répliqua l’acteur ainsi interpellé en dépliant ses longs membres articulés comme des pattes de faucheux, tout le monde n’a pas l’avantage d’être un Polyphème, un Cacus, une montagne de chair et d’os comme toi, ni un sac à vin, un tonneau à deux pieds comme Blazius."
                            },
                            {
                                "example_id": "f6d93083-2bc8-4737-a763-1a274eea2490",
                                "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                                "text": "Le second laquais, grand diable aux jambes de faucheux, se mit à courir après lui en criant à la garde."
                            },
                            {
                                "example_id": "9d532ed7-df22-414c-b37e-ca2d69fc59ea",
                                "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                                "text": "C'était beau et c'était stupéfiant. Les projecteurs avaient commencé à se concentrer en haut, à gauche du tableau, tremblant et vacillant comme les longues pattes malhabiles et embarrassées d'un faucheux."
                            },
                            {
                                "example_id": "8b519505-be44-439d-a8ee-d0933b8951d6",
                                "sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                                "text": "Une altercation s'est ensuivie, au terme de laquelle Pistohlkors s'est fait insulter. Sans hésiter un seul instant, il s'est alors rué sur l'autre. C'était comme un faucheux qui harcèlerait un buffle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "946a3d1f-8cbb-4e0a-b7c7-cdbf4f507f39",
                        "source_entry_id": "f0b17495-1c8a-32e8-938b-817d3b558195",
                        "source_sense_id": "6c557a2a-359a-3ad5-8452-939c50d4d2e6",
                        "target_lang_word": "Weberknecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weberknecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                        "entry_id": "45c8ce18-b4b1-366f-8e98-98820f076129",
                                        "glosses": [
                                            "langbeiniges Spinnentier, das weder Netzfäden noch Gift produziert (Opiliones)"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35ef8dc0-3e4f-4c59-b0e0-074c6f90c686",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Während Aurich auf den Teppich starrte, stakte steifbeinig ein Weberknecht in den Sonnenfleck.“"
                                            },
                                            {
                                                "example_id": "b19472de-bdfc-4c60-87f0-9ebcb0c1f1c1",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Wieder, wie schon vor einigen Stunden beim Anblick des Weberknechts im Sonnenfleck, überkam Aurich die nun schon bekannte Erregung und begann sein Herz in unmäßigem Tempo zu schlagen.“"
                                            },
                                            {
                                                "example_id": "2fe39870-c55c-4920-a375-361e1400cb96",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Charakteristisch für die Weberknechte sind der eiförmige Körper ohne Taille zwischen Vorder- und Hinterkörper und die extrem langen Beine. […] Weberknechte – auch Kanker genannt – jagen Insekten, kleine Spinnen und Milben. Manche Arten erbeuten auch kleine Gehäuseschnecken. Ihre Beute finden Weberknechte hauptsächlich mit dem Geruchssinn.“"
                                            },
                                            {
                                                "example_id": "d4affb01-3018-4db1-9ec5-a249929a50c1",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Weberknechte kommen überall auf der Erde vor. […] Im Unterschied zu echten Spinnen besitzen Weberknechte keine Spinnwarzen. Und sie sind nicht giftig. Außerdem haben Weberknechte nur zwei Punktaugen, Spinnen meist acht. Weberknechte sind völlig harmlos.“"
                                            },
                                            {
                                                "example_id": "a0d96f87-c586-44e8-8179-f4fd1534df08",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Die Mobilität ist bei Weberknechten im Allgemeinen durch eine Flugunfähigkeit und ausschließliche natürliche Ausbreitung per pedes oder durch Gesteinslawinen, Erdmuren bergabwärts oder über ein Verdriften an Totholz flussabwärts als gering einzustufen.“"
                                            },
                                            {
                                                "example_id": "e2e30ed0-3c86-466d-bc96-07be96a45eb9",
                                                "sense_id": "3d29f09a-b972-3958-82a8-f991fb617c52",
                                                "text": "„Innerhalb der Gliederfüßer zählen Vogelspinnen mit Skorpionen, Weberknechten, Milben, Pseudoskorpionen und Weiteren zur Klasse der Spinnentiere (Arachnida).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
