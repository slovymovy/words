                                        "sense_id": "14898d1c-fb46-3e9c-82a2-4d82c332ffdb",
                                        "entry_id": "44dcdd99-67ca-382a-997d-6a4f867d02d8",
                                        "glosses": [
                                            "The study of the mutual interrelationships between organisms and their environment; branch of biology; former term for ecology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc96988f-cbbd-48f6-a4f0-bec273854505",
                                                "sense_id": "14898d1c-fb46-3e9c-82a2-4d82c332ffdb",
                                                "text": "Apart from genetics the mesology bears a great influence on the physical body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290b71d1-c7e9-30d3-85b8-2cdf83699795",
                                        "entry_id": "44dcdd99-67ca-382a-997d-6a4f867d02d8",
                                        "glosses": [
                                            "The environmental or sociological influence on a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb269a5-f9fc-4961-b249-787a311389ca",
                                                "sense_id": "290b71d1-c7e9-30d3-85b8-2cdf83699795",
                                                "text": "The mesology of a child can be resumed in two living environments: the family and the school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a483e16b-69c0-4693-a759-8a781da71425",
                        "source_entry_id": "aaf86d65-a2e9-3b87-8645-beb65ceb6bfe",
                        "source_sense_id": "679fb0e5-7287-3f4e-b9dd-94ce4656fcd3",
                        "target_lang_word": "mésologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mésologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a3b9267-f584-3649-ba24-6d4d3dfb64be",
                                        "entry_id": "c3328e57-ffcc-354d-b4c4-ebbac097b54b",
                                        "glosses": [
                                            "Science des milieux, qui étudie de manière interdisciplinaire la relation des êtres vivants en général, ou des êtres humains en particulier, avec leur environnement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb9723df-6f88-33ac-895a-ff2ec758ce1c",
                                        "entry_id": "c3328e57-ffcc-354d-b4c4-ebbac097b54b",
                                        "glosses": [
                                            "Science des milieux, qui étudie de manière interdisciplinaire la relation des êtres vivants en général, ou des êtres humains en particulier, avec leur environnement.",
                                            "Dans un premier sens, le plus ancien, « milieu » est synonyme d’« environnement », c’est-à-dire le donné environnemental objectif et universel qui fait aujourd’hui l’objet de l’écologie. La première édition du Petit Larousse (1906) pouvait ainsi définir la mésologie comme « partie de la biologie qui étudie les rapports des milieux et des organismes »."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ba3ddbb-db9d-34db-837f-95b2194a9b9d",
                                        "entry_id": "c3328e57-ffcc-354d-b4c4-ebbac097b54b",
                                        "glosses": [
                                            "Science des milieux, qui étudie de manière interdisciplinaire la relation des êtres vivants en général, ou des êtres humains en particulier, avec leur environnement.",
                                            "Dans un second sens, apparu sous l’influence de la phénoménologie dans les travaux de Jakob von Uexküll et de Tetsurō Watsuji (v. plus bas « Histoire du mot »), le français mésologie est synonyme de l’allemand Umweltlehre et du japonais 風土学 fūdogaku. Ici, le milieu (Umwelt, fūdo) n’est pas le donné environnemental objectif (Umgebung, shizen kankyō 自然環境), mais les termes dans lesquels celui-ci existe pour un certain être (individu, société, espèce…). C’est la réalité du monde ambiant propre à cet être, et non à d’autres. Le milieu est donc singulier, tandis que l’environnement est universel. Corrélativement, la mésologie n’est pas l’écologie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
