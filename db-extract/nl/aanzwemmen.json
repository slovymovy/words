                    {
                        "sense_id": "e0dd16a3-a3a8-3742-8435-ba4ed1205ccd",
                        "entry_id": "9c425fb2-d486-360b-a47c-682de666db95",
                        "glosses": [
                            "naderen door te zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb1d769-12a6-406b-9859-5c181f6f626a",
                                "sense_id": "e0dd16a3-a3a8-3742-8435-ba4ed1205ccd",
                                "text": "Er komt een antiloopje aanzwemmen en het enige wat de alligator doet is het vastklemmen van het linkervoorpootje tussen zijn kaken. Dat pootje was immers een bewegend en dus herkenbaar iets voor de allesvreter. Voorts blijft hij weer stil liggen."
                            },
                            {
                                "example_id": "5aea4aa1-8995-4b69-bb18-d7a24dc52cdf",
                                "sense_id": "e0dd16a3-a3a8-3742-8435-ba4ed1205ccd",
                                "text": "'Toen ik dacht dat het over was, kwam er iemand aanzwemmen'."
                            }
                        ]
                    }
                ],
