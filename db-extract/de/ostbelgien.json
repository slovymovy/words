                        "glosses": [
                            "das offizielle deutsche Sprachgebiet Belgiens, zum Teil auch zuzüglich der Gemeinden Malmedy und Weismes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e3e2f57-4e44-45b7-b5f5-695c6d7e9958",
                                "sense_id": "2e5a64d8-2054-3a2f-9876-e5b8abde423e",
                                "text": "Wir wollten erfahren, welchen Stellenwert der Sport in Ostbelgien hat."
                            },
                            {
                                "example_id": "557b1700-d22d-4b81-a7ed-035d876be7dd",
                                "sense_id": "2e5a64d8-2054-3a2f-9876-e5b8abde423e",
                                "text": "Vor genau hundert Jahren wurde die deutsche Region Eupen-Malmedy-St. Vith, das heutige Ostbelgien, an der Grenze zu Aachen und Trier, wo die deutschsprachige Minderheit unseres Landes lebt, belgisch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
