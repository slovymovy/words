                {
                    "sense_id": "4b9c4e97-47ae-33ce-ac50-6cbca41504e0",
                    "sense_definition": "Веселиться, развлекаться, отмечать праздник (часто с употреблением алкоголя).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leisure_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся деревня три дня <w>гуляла</w> на шумной свадьбе.",
                            "target_lang_translations": {
                                "en": "The whole village <w>partied</w> at the noisy wedding for three days.",
                                "nl": "Het hele dorp heeft drie dagen lang <w>gefeest</w> op de luidruchtige bruiloft.",
                                "pl": "Cała wieś przez trzy dni <w>bawiła się</w> na hucznym weselu."
                            }
                        },
                        {
                            "text": "Студенты сдали последнюю сессию и <w>гуляли</w> до самого утра.",
                            "target_lang_translations": {
                                "en": "The students passed their last session and <w>partied</w> until the very morning.",
                                "nl": "De studenten hadden hun laatste examen gehaald en <w>feestten</w> tot in de vroege ochtend.",
                                "pl": "Studenci zdali ostatnią sesję i <w>imprezowali</w> do samego rana."
                            }
                        }
                    ],
                    "synonyms": [
                        "веселиться",
                        "развлекаться",
                        "кутить"
