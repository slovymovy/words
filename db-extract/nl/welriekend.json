                                "target_senses": [
                                    {
                                        "sense_id": "98aab28d-0386-334c-9a9a-73b6010608ec",
                                        "entry_id": "71ee1438-aa88-3c96-bdd5-39bc873533ad",
                                        "glosses": [
                                            "Containing nuts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "020f75be-7f9b-424f-9790-0ffa92867dc6",
                                                "sense_id": "98aab28d-0386-334c-9a9a-73b6010608ec",
                                                "text": "This is a nutty chocolate bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aecedb2-1760-32c8-b1e2-9e352dae26e8",
                                        "entry_id": "71ee1438-aa88-3c96-bdd5-39bc873533ad",
                                        "glosses": [
                                            "Resembling or characteristic of nuts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf92d20-0fe9-460f-80a9-33ecbfa1385f",
                                                "sense_id": "1aecedb2-1760-32c8-b1e2-9e352dae26e8",
                                                "text": "Brown rice has had only its outer hull removed, leaving it with a beige color and a pleasantly nutty flavor."
                                            },
                                            {
                                                "example_id": "18d3d91c-6900-4528-b9b4-ac0e57dda1d1",
                                                "sense_id": "1aecedb2-1760-32c8-b1e2-9e352dae26e8",
                                                "text": "David Mason, Beverage and Bar Manager at St. Regis, describes the complex aromas and layered palate of the cognac thus: “It’s kind of autumn flavors. Really nutty, almondy – kind of fig, plum, dried fruits. But it finishes off really smoothly but with a little bit of tobacco leaf.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14fd8824-65b0-342a-8c9c-8f59e5b64ee3",
                                        "entry_id": "71ee1438-aa88-3c96-bdd5-39bc873533ad",
                                        "glosses": [
                                            "Barmy: eccentric, odd; crazy, mad, insane."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24f37553-39bc-4d3f-a0f1-6d46791e8d97",
                                                "sense_id": "14fd8824-65b0-342a-8c9c-8f59e5b64ee3",
                                                "text": "Near-synonyms: nuts; see also Thesaurus:insane"
                                            },
                                            {
                                                "example_id": "bb8dec5b-1736-448a-be7f-4deb79ff27f0",
                                                "sense_id": "14fd8824-65b0-342a-8c9c-8f59e5b64ee3",
                                                "text": "That student's parents seem to be nutty as a fruitcake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed6fb13-9dd0-3c47-924b-ba52f348bfc5",
                                        "entry_id": "71ee1438-aa88-3c96-bdd5-39bc873533ad",
                                        "glosses": [
                                            "Extravagantly fashionable."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "760ea35b-495c-4dbe-b648-9697ba103b85",
                                                "sense_id": "fed6fb13-9dd0-3c47-924b-ba52f348bfc5",
                                                "text": "Skinner's friendship with his nutty pals seemed to have come to a sudden end."
                                            }
                                        ]
                                    }
