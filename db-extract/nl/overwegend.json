                    {
                        "translation_id": "39e613cf-6e91-499a-a544-133bdbed5ea9",
                        "source_entry_id": "0b58ebaf-e60c-33fa-99d9-bf23fcace838",
                        "source_sense_id": "3aa26afc-5426-3267-b3cb-633dc4e2a27d",
