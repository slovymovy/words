                },
                {
                    "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                    "sense_definition": "The removal of a losing contestant or team from a match, tournament, or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team fought hard to avoid <w>elimination</w> from the championship.",
                            "target_lang_translations": {
                                "ru": "Команда упорно боролась, чтобы избежать <w>выбывания</w> из чемпионата.",
                                "zh": "该队顽强拼搏，以避免在锦标赛中遭<w>淘汰</w>。"
                            }
                        },
                        {
                            "text": "After his <w>elimination</w> in the semi-finals, he stayed to cheer for his friends.",
                            "target_lang_translations": {
                                "ru": "После своего <w>выбывания</w> в полуфинале он остался болеть за друзей.",
                                "zh": "在半决赛被<w>淘汰</w>后，他留下来为朋友加油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ousting",
                        "exclusion"
                    ],
                    "antonyms": [
                        "qualification"
                    ],
                    "common_phrases": [
                        "elimination round",
                        "face elimination",
                        "risk of elimination",
                        "single elimination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключение проигравшего участника или команды из матча, турнира или соревнования.",
                        "zh": "在比赛或锦标赛中落败而被淘汰出局。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбывание",
                                "target_lang_sense_clarification": "из соревнований"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淘汰",
