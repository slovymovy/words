                ],
                "senses": [
                    {
                        "sense_id": "f7bd6e75-9af8-3f2f-9d35-6397f79a7a96",
                        "entry_id": "b9c0c010-6bc2-381e-aa30-10fcdf2af067",
                        "glosses": [
                            "Thérapie qui utilise la création artistique pour permettre au patient d'exprimer ses symptômes, ses pulsions, ses névroses."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "e8d3a59b-bb71-41b3-aa50-9607292b0014",
                                "sense_id": "f7bd6e75-9af8-3f2f-9d35-6397f79a7a96",
                                "text": "Mais elle est explicitement et officiellement responsable de la gestion d’un ensemble de pratiques soignantes bien qu’il ne s’agisse pas ni de la totalité ni de la majorité des protocoles soignants en cours dans le « réseau alcoologique Dr Haas » ; là encore, le portefeuille des pratiques soignantes en charge de l’URSA fluctue selon les époques : outre le Grand Cirque (pratique phare des soins clodoaldiens), l’accueil bihebdomadaire au bar de l’URSA et les activités art-thérapie et théâtre-thérapie, nous allons citer la bibliographie, la réunion des femmes, voire la cinémathèque et enfin l’intervention au chevet du patient."
                            },
                            {
                                "example_id": "36729eb5-9f8f-4497-86f8-8242b6941b18",
                                "sense_id": "f7bd6e75-9af8-3f2f-9d35-6397f79a7a96",
                                "text": "Elle est devenue l’une des figures de l’art-thérapie en France en jouant pour les malades en fin de vie ou les autistes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d968b7dc-60a9-4350-8e24-7fd1143bf882",
                        "source_entry_id": "b9c0c010-6bc2-381e-aa30-10fcdf2af067",
                        "source_sense_id": "f7bd6e75-9af8-3f2f-9d35-6397f79a7a96",
