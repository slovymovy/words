                    {
                        "sense_id": "9bead4a2-25dc-33a8-8a6d-4b75bba65453",
                        "entry_id": "484cd881-f9eb-3768-9ec8-bededd5e9b46",
                        "glosses": [
                            "Gerät zum Drehen von Schrauben, insbesondere Elektrowerkzeug"
                        ],
                        "tags": [
                            "Handwerk"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f92c0d8-2f44-3fa0-b77a-b0bd9d4e5c87",
                        "entry_id": "484cd881-f9eb-3768-9ec8-bededd5e9b46",
                        "glosses": [
                            "Person, die gerne an technischen Geräten und Maschinen arbeitet und diese gerne repariert oder modifiziert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5621f547-62e9-4983-9d49-f4875c29882b",
                                "sense_id": "5f92c0d8-2f44-3fa0-b77a-b0bd9d4e5c87",
                                "text": "Mein Vater ist ein echter Schrauber und hat schon so manches kaputte Gerät wieder zum Laufen gebracht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
