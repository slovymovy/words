            {
                "entry_id": "963e8717-eb4e-3756-a32e-24d675cd3d6d",
                "word": "linaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ff1729ee-0966-416a-b797-e4ace1927114",
                        "entry_id": "963e8717-eb4e-3756-a32e-24d675cd3d6d",
                        "tags": [
                            "plural"
                        ],
                        "form": "linaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5081c2b-5bb3-37fd-81f7-1d35a5a83946",
                        "entry_id": "963e8717-eb4e-3756-a32e-24d675cd3d6d",
                        "glosses": [
                            "Plante herbacée du genre Chaenorhinum dont les feuilles ressemblent à celles du lin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cef5f2f-7577-42c0-8a7f-59beab5c50cc",
                                "sense_id": "b5081c2b-5bb3-37fd-81f7-1d35a5a83946",
                                "text": "Linaria chalepensis, la linaire de Chalep, est une annuelle à tige dressée qui atteint 40 cm."
                            },
                            {
                                "example_id": "e7be2bab-013b-472c-91c5-ba511d54cbe7",
                                "sense_id": "b5081c2b-5bb3-37fd-81f7-1d35a5a83946",
                                "text": "[…] l’aspect automnal, de beaucoup le mieux marqué, est surtout déterminé par la floraison de Galeopsis Ladanum qui étend ses nappes roses lilacées sur le fond jauni des chaumes parmi le rouge des Coquelicots, le jaune soufre des Linaires et l’azur des Bleuets."
                            },
                            {
                                "example_id": "5fa473b0-15f3-4874-b1c2-6e085e361a56",
                                "sense_id": "b5081c2b-5bb3-37fd-81f7-1d35a5a83946",
                                "text": "Les talus étaient semés de fleurs intactes, coquelicots, linaires et vipérines."
                            }
                        ]
                    },
                    {
                        "sense_id": "5eacfb71-7140-3a0e-a34c-7b4813310b94",
                        "entry_id": "963e8717-eb4e-3756-a32e-24d675cd3d6d",
                        "glosses": [
                            "Plante herbacée du genre Linaria de la famille des Plantaginaceae."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e01ed71f-cd66-40a0-88cc-f07b985bfd17",
                        "source_entry_id": "963e8717-eb4e-3756-a32e-24d675cd3d6d",
                        "target_lang_word": "Leinkraut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leinkraut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eade6dd0-821a-3bf3-b758-b47475d1929f",
                                        "entry_id": "c37af889-1e54-30a0-b80b-d5f27221a004",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung der Leinkrautgewächse ( Linaria), die zur Familie der Wegerichgewächse ( Plantaginaceae) gehört"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d586745c-eb2d-4348-9867-0dc3d3535cd4",
                                                "sense_id": "eade6dd0-821a-3bf3-b758-b47475d1929f",
                                                "text": "„Die Gattung Leinkräuter (Linaria) enthält etwa 100 bis 150 Arten […].“"
                                            },
                                            {
                                                "example_id": "ae267773-c778-418a-8f94-c1f1bd4541d5",
                                                "sense_id": "eade6dd0-821a-3bf3-b758-b47475d1929f",
                                                "text": "„Fest eingebaute und vererbbare T-DNA-Bestandteile wurden bisher erst zweimal in Pflanzen nachgewiesen. Zuerst vor etwa 30 Jahren in einer Tabak-Art. Später fand man die genetischen Spuren von Agrobakterien in weiteren Tabaksorten und einigen Leinkräutern. Doch jetzt, und zum ersten Mal, in einem Nahrungsmittel – der Süßkartoffel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91bd2750-4edf-3252-8bfa-0954400e3b2a",
                                        "entry_id": "c37af889-1e54-30a0-b80b-d5f27221a004",
                                        "glosses": [
