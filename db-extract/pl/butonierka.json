                                "sense_id": "e72f4002-e84c-3c68-bf05-188cff96cd94",
                                "text": "W dzisiejszych czasach butonierka nie pełni tej samej roli, co kiedyś."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5bf0e180-6ffe-3153-926c-472e6adca510",
                        "entry_id": "1b2a4910-8973-3248-aa26-bef48b9394da",
                        "glosses": [
                            "niewielka, płytka kieszeń, umieszczona na wysokości piersi w marynarce lub żakiecie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbf6a1b-5414-4112-b038-96f68686fea5",
                                "sense_id": "5bf0e180-6ffe-3153-926c-472e6adca510",
                                "text": "A w butonierkę wetknij sobie ozdobną chusteczkę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cb9b8eb3-cc9a-3963-979b-250f9dbb3a8d",
                        "entry_id": "1b2a4910-8973-3248-aa26-bef48b9394da",
                        "glosses": [
                            "niewielki flakonik na kwiaty, który przypinano do sukni balowej"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "81c72116-246e-42ea-b5df-147d8fb3d1d1",
                                "sense_id": "cb9b8eb3-cc9a-3963-979b-250f9dbb3a8d",
                                "text": "Dawniej kobiety nosiły butonierki przy eleganckich sukniach."
