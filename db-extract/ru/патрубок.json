                                    },
                                    {
                                        "sense_id": "89f5ac36-638e-3b6d-93d6-e9aa40e215b9",
                                        "entry_id": "12a08e21-96ea-30db-aa03-ad79162188f4",
                                        "glosses": [
                                            "Any of various concave objects (or portions of larger objects) that envelop a counterpart object.",
                                            "The hollow of a candlestick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d9f69c-3304-4b1d-a3ee-5cca91662221",
                                                "sense_id": "89f5ac36-638e-3b6d-93d6-e9aa40e215b9",
                                                "text": "Chriſt calls his Miniſters, Lux Mundi, the light of the World, Matth. 5. 14. therefore they must be alwayes giving forth their luſtre; their light must not go out till it be in the ſocket or till violent death as an extinguisher put it out."
                                            },
                                            {
                                                "example_id": "65c3e8cb-ea81-4665-b630-5fbcd22cf15b",
                                                "sense_id": "89f5ac36-638e-3b6d-93d6-e9aa40e215b9",
                                                "text": "The candle burned to its socket, the fire went out, the night air grew heavy with silence, before Herbert lay down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed247fb-dd9b-3257-ac2d-2cac0576e45e",
