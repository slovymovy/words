        "fr-extract.jsonl": [
            {
                "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                "word": "coloration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b02c54f-918d-431a-bd4d-dc86a3ab0897",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "tags": [
                            "plural"
                        ],
                        "form": "colorations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c74da9e6-fc48-3f03-88a9-62d23a472291",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "glosses": [
                            "Action de colorer ; fait de devenir coloré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d4bae7-3422-45c7-a806-65948f5ad2f2",
                                "sense_id": "c74da9e6-fc48-3f03-88a9-62d23a472291",
                                "text": "L’exploitation du bismuth, et surtout du cobalt pour la coloration en bleu des verres et faïences, ralentit le déclin pendant la seconde moitié du xvie siècle."
                            },
                            {
                                "example_id": "27e10747-5155-42be-8910-c582cc6c67ad",
                                "sense_id": "c74da9e6-fc48-3f03-88a9-62d23a472291",
                                "text": "La technique de coloration des agates est connue depuis l’Antiquité, mais aujourd’hui on utilise des colorants inorganiques aux teintes plus vives et qui ne palissent pas à la lumière."
                            }
                        ]
                    },
                    {
                        "sense_id": "c37dc4e0-4982-32a9-a531-94d8ae53b61d",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "glosses": [
                            "Fait de se teindre les cheveux ; teinte que l’on donne à ses cheveux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "368f2b2b-ad12-4aec-838d-d41671fcc5c0",
                                "sense_id": "c37dc4e0-4982-32a9-a531-94d8ae53b61d",
                                "text": "A priori, toutes les femmes (et tous les hommes) peuvent avoir recours à la coloration végétale. Cette méthode permet de reproduire de nombreuses couleurs même si le nuancier de la coloration végétale est plus restreint que celui de la coloration classique."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cec2f40-c3f6-3982-a971-1ca9e5e86584",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "glosses": [
                            "Changement de couleur du bois sans dégradation de ses qualités mécaniques."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7b1a6d29-95c2-4b10-8ef8-d08c74172791",
                                "sense_id": "5cec2f40-c3f6-3982-a971-1ca9e5e86584",
                                "text": "L’altération se limite très généralement à une coloration anormale de tout ou partie du duramen, de brun léger à brun foncé, essentiellement visible sur bois humide et n’affectant pas les caractéristiques mécaniques du bois. Cette coloration peut présenter divers faciès : uniforme, sous forme de lignes rayonnantes ou encore d’écailles. Longitudinalement la coloration prend l’allure d’une flamme d’une hauteur de un à plusieurs mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a40fe8c-cf66-38d7-bb4c-4ce08fab84df",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "glosses": [
                            "État de ce qui est coloré ; teinte, couleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d828082-5ef5-4640-b0a9-78c39d041787",
                                "sense_id": "0a40fe8c-cf66-38d7-bb4c-4ce08fab84df",
                                "text": "Quelques blancheurs commencent à nuancer l’horizon vers l’est. Les nuages du zénith en reçoivent une première coloration."
                            },
                            {
                                "example_id": "c6bd1f87-1302-4bdb-99ee-730b7f9b02eb",
                                "sense_id": "0a40fe8c-cf66-38d7-bb4c-4ce08fab84df",
                                "text": "J’ai d’abord fait réagir le réactif à la vanilline et au pipéronal sur une série d’huiles, et j’ai observé les colorations directement après mélange et également au bout d’un certain temps."
                            },
                            {
                                "example_id": "97321298-e638-4811-b261-70590f731639",
                                "sense_id": "0a40fe8c-cf66-38d7-bb4c-4ce08fab84df",
                                "text": "Le perchlorure de fer ajouté à une solution d’antipyrine donne une coloration rouge."
                            },
                            {
                                "example_id": "ab5ffcad-749c-407e-a71d-a9edbfd539d4",
                                "sense_id": "0a40fe8c-cf66-38d7-bb4c-4ce08fab84df",
                                "text": "La soie Glanzstoff ou la soie de Givet sthénosée, n’est plus colorée qu’en jaune pâle. Le permanganate de potasse donne une coloration légère de bistre manganèse , s’accentuant peu à peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba6d24b5-4eaf-3a10-b516-f6fa9aa03fe9",
                        "entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "glosses": [
                            "Dimension, aspect, tournure."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f41fd821-aba9-4a3a-84f5-9b887e0061a1",
                                "sense_id": "ba6d24b5-4eaf-3a10-b516-f6fa9aa03fe9",
                                "text": "Systématiquement ou presque, sur tout le continent, cette méfiance s’est accompagnée d’une politique de rejet à forte coloration xénophobe."
                            },
                            {
                                "example_id": "a34aaad0-b967-4b5b-ac7d-5aaed83abd78",
                                "sense_id": "ba6d24b5-4eaf-3a10-b516-f6fa9aa03fe9",
                                "text": "Il voulait aussi donner une coloration scientifique à son aventure extrême pour faire partie de ceux qui font progresser la connaissance."
                            },
                            {
                                "example_id": "22732be8-3447-4f34-a43d-4fc15a225da0",
                                "sense_id": "ba6d24b5-4eaf-3a10-b516-f6fa9aa03fe9",
                                "text": "L’amygdale […] que la neurologie clinique a depuis longtemps identifiée comme étant l’une des clés de voûte de notre faculté à attribuer une coloration émotionnelle à nos pensées et à nos percepts les plus divers. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 38)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05148bd2-09ac-4a32-907f-0af624683ec0",
                        "source_entry_id": "a1f032e0-ac7e-36e1-8f19-e8cb39605996",
                        "target_lang_word": "Färbung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Färbung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb57dc44-95b5-3174-985c-d5336e6aca7d",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
                                            "das Färben beziehungsweise Gefärbtwerden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73494a17-d0dc-4100-992e-2218a6b8e2e3",
                                                "sense_id": "bb57dc44-95b5-3174-985c-d5336e6aca7d",
                                                "text": "Dass die Färbung gleichzeitige mit mehreren Farbstoffen erfolgt, beschleunigt den Prozess."
                                            },
                                            {
                                                "example_id": "99828b6d-2076-47f4-a5e0-5b8de32c4565",
                                                "sense_id": "bb57dc44-95b5-3174-985c-d5336e6aca7d",
                                                "text": "Die Färbung des Leders erfolgt noch in der Fabrik, nachdem es entsprechend dem Endprodukt zurechtgeschnitten wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a672d21a-903e-367f-9dc8-8c331174e3c7",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
                                            "die Art und Weise, wie etwas gefärbt worden ist; das Gefärbtsein; die Farbgebung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "911722e6-6a0c-4b29-b2a5-30bc0c63babc",
                                                "sense_id": "a672d21a-903e-367f-9dc8-8c331174e3c7",
                                                "text": "Besser wäre eine Tönung gewesen, da ihr die Färbung ihres Haares nicht steht."
                                            },
                                            {
                                                "example_id": "4dfb9e21-3449-43b7-baa9-7aaa9ecd8108",
                                                "sense_id": "a672d21a-903e-367f-9dc8-8c331174e3c7",
                                                "text": "„Über die Ursache der schwarzen Färbung des Schlammes in mehreren kleinen Wassergräben in der Nähe des Ferdinandsbrunnens:",
                                                "translation": "Die Untersuchung ergab als Resultat, daß diese schwarze Färbung von Schwefeleisen herrührt, welches dieser Schlamm in nicht unbeträchtlicher Menge enthält.“"
                                            },
                                            {
                                                "example_id": "0ce9aa74-63b3-4ae4-8337-3b816b435c08",
                                                "sense_id": "a672d21a-903e-367f-9dc8-8c331174e3c7",
                                                "text": "Durch die besonders grelle Färbung ihres roten Mantels fällt sie in der Menge auf."
                                            },
                                            {
                                                "example_id": "113e94ee-98b1-43f2-82a4-f44a7f729f8d",
                                                "sense_id": "a672d21a-903e-367f-9dc8-8c331174e3c7",
                                                "text": "„Und er sah die Dinge in allen Einzelheiten, sah die Farbe der Federn, den Busch, die Form und die Färbung der Blätter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "00d795be-7e38-3382-9d17-6d8845006fd6",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
                                            "das Zusammenspielen der Farbtöne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77e09eae-28eb-4413-8e8b-f08e6177aefd",
                                                "sense_id": "00d795be-7e38-3382-9d17-6d8845006fd6",
                                                "text": "„Neben dem gelb leuchtenden Ginkgo fallen in der Werderstraße derzeit einige andere Bäume durch ihre prächtig rote, orangefarbene und gelbe Färbung auf.“"
                                            },
                                            {
                                                "example_id": "fa24ccde-e0c7-4e6d-a900-1ff5a3076ea7",
                                                "sense_id": "00d795be-7e38-3382-9d17-6d8845006fd6",
                                                "text": "Seine Katze hat eine besonders schöne Färbung des Felles."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "883b9d69-ca3e-3ecc-8625-4ec63f4c7235",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
                                            "in eine bestimmte Richtung zielende Abweichung, Tendenz"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c412b592-a081-486c-8dd8-28ffddec7650",
                                                "sense_id": "883b9d69-ca3e-3ecc-8625-4ec63f4c7235",
                                                "text": "„Er gab seiner Rede eine ironische Färbung.“"
                                            },
                                            {
                                                "example_id": "d353914b-cbd4-487a-8b9b-20be2f92377c",
                                                "sense_id": "883b9d69-ca3e-3ecc-8625-4ec63f4c7235",
                                                "text": "„Früher schien dieser Dillinger Demokrat mit stark sozialistischer Färbung zu sein.“"
                                            },
                                            {
                                                "example_id": "ac62d151-b190-4e64-bd73-f270eb598ccc",
                                                "sense_id": "883b9d69-ca3e-3ecc-8625-4ec63f4c7235",
                                                "text": "„Die landschaftliche Färbung seiner Sprache verriet seine Herkunft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4d32fcda-4fe3-335a-a6c1-c1f1de9b1079",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
                                            "die Zuordnung jedes Knotens beziehungsweise jeder Kante in einem ungerichteten Graphen eine Farbe"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fdcc55bf-b87e-3e5c-90bf-abf162598576",
                                        "entry_id": "8c771eaa-d7a3-3fd7-92db-549df186c110",
                                        "glosses": [
