                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f577e01e-d294-4ee1-8760-1da9e986c1aa",
                                "sense_id": "0b7d954b-290c-348a-b21c-7fa3ad50b5f2",
                                "text": "„Er richtete zwei Destillerien ein, um aus den Kartoffeln, die in Varzin angebaut wurden, Schnaps zu brennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
