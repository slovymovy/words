                "senses": [
                    {
                        "sense_id": "9aaaf134-5c7c-3287-a98c-a7b626bbcca8",
                        "entry_id": "a4cef3cf-3bb3-3033-81db-8c8c4f435106",
                        "glosses": [
                            "Vomir ce qu’on vient d’avaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63882fb-9ece-4b20-a3a1-f3a6b7202c67",
                                "sense_id": "9aaaf134-5c7c-3287-a98c-a7b626bbcca8",
                                "text": "Dès qu’il a pris un bouillon, il le revomit."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab1d2d68-c6be-3035-9579-c1c0e9ff9338",
                        "entry_id": "a4cef3cf-3bb3-3033-81db-8c8c4f435106",
                        "glosses": [
                            "Vomir de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a2e11c1-3bf0-3a0e-ae29-910e2f968295",
                        "entry_id": "a4cef3cf-3bb3-3033-81db-8c8c4f435106",
                        "glosses": [
                            "Rejeter, comme en vomissant, ce qui avait d'abord été absorbé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "601905cd-0975-497a-bec9-f540556bf3b2",
                                "sense_id": "7a2e11c1-3bf0-3a0e-ae29-910e2f968295",
                                "text": "Oui, la mer, une fois, m’a saisi, elle m’a roulé dans ses vagues, et puis, elle m’a revomi, vivant, sur un coin de la plage, comme si j’étais indigne de disparaître en elle…"
                            }
                        ]
                    }
