                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba2eee62-661a-46f7-951d-3a69d89f8a68",
                        "source_entry_id": "b0b3fff4-7d54-3206-a75e-a8eb2bb10517",
                        "source_sense_id": "488d0404-5d81-3190-bd1a-01053a06d5f9",
                        "target_lang_word": "admiration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admiration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "A positive emotion including wonder and approbation; the regarding of another as being wonderful"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19d9eb30-9ee9-415d-9e4a-d59250a946a5",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "admiration of a war hero"
                                            },
                                            {
                                                "example_id": "d3dc2194-1201-4a6d-b7b1-04a86ddbfada",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "They looked at the landscape in admiration."
                                            },
                                            {
                                                "example_id": "29f2a30c-0e3c-4f70-bb31-dd221ba67901",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "For in this Instance, Life most exactly resembles the Stage, since it is often the same Person who represents the Villain and the Heroe; and he who engages your Admiration To-day, will probably attract your Contempt To-Morrow."
                                            },
                                            {
                                                "example_id": "dccfab99-4e33-4092-861c-70230f2d9466",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "A lady’s imagination is very rapid; it jumps from admiration to love, from love to matrimony in a moment."
                                            },
                                            {
                                                "example_id": "ed40b1b2-2ced-4087-96e2-e39dd6804ea5",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "Dr. Veraswami had a passionate admiration for the English, which a thousand snubs from Englishmen had not shaken."
                                            },
                                            {
                                                "example_id": "1368c8a3-526b-407b-bffe-4c651cc2880e",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "[I]n the towns, the storekeepers hated them because they had no money to spend. There is no shorter path to a storekeeper’s contempt, and all his admirations are exactly opposite. The town men, little bankers, hated Okies because there was nothing to gain from them."
                                            },
                                            {
                                                "example_id": "f9a47d2a-d8bd-4c09-9d0f-c77e5cdb3e52",
                                                "sense_id": "edf873a8-e29f-3a7f-8146-8817b6014916",
                                                "text": "Equally I can stand in a station like Lucerne in Switzerland, and watch with ill-concealed admiration the majestic entry of one of the latest Gotthard \"Ae 6/6\" electrics, packing 6,000 horsepower within its 60 ft. of length and 121 tons of weight, with its sleek dark green sides and handsome stainless steel bands and front wings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "Wondering or questioning (without any particular positive or negative attitude to the subject)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27228389-42ce-4b58-ae9d-0865cad9cf11",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "Lear. Your name, fair gentlewoman?\nGoneril. This admiration, sir, is much o’ th’ savour\nOf other your new pranks."
                                            },
                                            {
                                                "example_id": "693604c0-4e68-4cc3-8bf3-5764c9608de4",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "And I saw the woman drunken with the blood of the saints, and with the blood of the martyrs of Jesus: and when I saw her, I wondered with great admiration."
                                            },
                                            {
                                                "example_id": "433c2d56-58db-46a3-b7d0-b28462524fc8",
                                                "sense_id": "70ef4473-6af6-38af-aa2b-e6d6ed0ff3fd",
                                                "text": "[…] Admiration seized\nAll Heaven, what this might mean, and whither tend,\nWondering;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f748cfe3-68bd-3b50-b958-900d0abd8eab",
                                        "entry_id": "a0eabd36-5cfd-3d5c-9f4f-dfd50eeecbdc",
                                        "glosses": [
                                            "Cause of admiration; something to excite wonder, or pleased surprise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e94a9e4-a1a7-425e-8879-ee4ccc90e033",
                                                "sense_id": "f748cfe3-68bd-3b50-b958-900d0abd8eab",
                                                "text": "Now, good Lafeu,\nBring in the admiration; that we with thee\nMay spend our wonder too, or take off thine\nBy wondering how thou took’st it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
