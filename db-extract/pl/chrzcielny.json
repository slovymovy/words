                                "target_senses": [
                                    {
                                        "sense_id": "314cc6f3-2f69-3de5-a9d6-55380bfea4b5",
                                        "entry_id": "327565a0-9d54-3036-9684-135e00b0d29f",
                                        "glosses": [
                                            "Of or relating to baptism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d29459e0-f30a-358d-8d1a-ed5665cbcffd",
                                        "entry_id": "327565a0-9d54-3036-9684-135e00b0d29f",
                                        "glosses": [
                                            "Of a name, conferred at baptism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af580d33-91f1-49e6-b271-81f0bcaed926",
                                                "sense_id": "d29459e0-f30a-358d-8d1a-ed5665cbcffd",
                                                "text": "The neophyte was given a new name in place of the baptismal one, usually of an evil and revolting character, and this was written in blood in the Devil's book, the covers of which were bound in the skin of unbaptised infants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baptismal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7512266b-03fc-3a8c-ac34-97f6523d841e",
                                        "entry_id": "36ff64fb-d515-3dd8-9fa0-92ca3b5a23bb",
                                        "glosses": [
                                            "A baptismal name: a name given at baptism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d5d362-b77e-4eed-bd6c-79b9ad7fdb19",
                                                "sense_id": "7512266b-03fc-3a8c-ac34-97f6523d841e",
                                                "text": "...Mr. Andrew Theophilus Smith, or some such unlikely pair of baptismals..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bf93a54-ded9-3042-9cb9-94bac1d74558",
                                        "entry_id": "36ff64fb-d515-3dd8-9fa0-92ca3b5a23bb",
                                        "glosses": [
                                            "A baptismal font: a large basin used for baptism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba77e695-6d1f-47f0-83bf-2019fb5e6e8a",
                                                "sense_id": "6bf93a54-ded9-3042-9cb9-94bac1d74558",
                                                "text": "The baptismal is in the front of the sanctuary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2c4554e-9a84-45f0-a1e6-890d7af8aa77",
                        "source_entry_id": "a7c687fe-6705-30c6-aa21-79c0bad7673f",
