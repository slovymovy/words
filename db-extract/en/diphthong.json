                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                        "glosses": [
                            "A complex vowel sound that begins with the sound of one vowel and ends with the sound of another vowel, in the same syllable."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "552b2b29-59e7-3cf0-bd4b-210815cbf372",
                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                        "glosses": [
                            "A diaphoneme realized as a two-target vowel in some but not necessarily all dialects."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                        "entry_id": "7b32b597-e07a-3196-ae02-7f8bec1e4c47",
                        "glosses": [
                            "A vowel digraph or ligature."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d04f4a23-662b-4c63-9940-64e429b214b2",
                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                "text": "And he might have written the name, also, with the diphthong æ, as well as the single vowel, in the initial syllable, throughout all the preceding forms."
                            },
                            {
                                "example_id": "87489c8d-31c0-4e75-9e85-9776fd0e6965",
                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                "text": "An improper diphthong has only one of the vowels sounded; as, ea in heat, oa in coal."
                            },
                            {
                                "example_id": "9eb62d20-8fc1-4995-9527-67f4102cb732",
                                "sense_id": "6c39f278-dcbe-33f8-940e-5c4fb763734b",
                                "text": "The diphthong ae is sounded like ē (§7); that is, it has the sound of ey in they."
                            }
                        ]
                    }
                ],
