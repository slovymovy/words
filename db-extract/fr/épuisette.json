        "fr-extract.jsonl": [
            {
                "entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                "word": "épuisette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc10c46e-d582-488e-bfd0-152ea0476ebf",
                        "entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "tags": [
                            "plural"
                        ],
                        "form": "épuisettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa3ee735-5069-3c71-83d3-6d8bdc7484d7",
                        "entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "glosses": [
                            "Filet de pêche monté sur un cerceau adapté à un manche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0943fcb-4dfa-461f-b146-1513a6853901",
                                "sense_id": "fa3ee735-5069-3c71-83d3-6d8bdc7484d7",
                                "text": "Debout au bord du marécage, les jambes enfouies jusqu’aux jarrets, ils avaient fini par interrompre leur besogne, par reposer leurs bras sur leurs épuisettes inutiles."
                            },
                            {
                                "example_id": "79ff0a74-1680-4097-8d1d-15353150811d",
                                "sense_id": "fa3ee735-5069-3c71-83d3-6d8bdc7484d7",
                                "text": "Sur le fond, et autour de l’aquarium, des présentoirs exhibaient les attirails, des plus simples aux plus compliqués : gaules en bambou, cannes en fibre de verre, grandes cannes télescopiques pour moulinet à tambour tournant, boîtes de mouches et de cuillères, d’hameçons et de plombs, devons, moulinets de tous calibres, montures pour poissons morts, dégorgeoirs, bourriches, épuisettes, appâts réputés fantastiques ! fabuleux ! ou, plus prosaïquement, épatants !"
                            },
                            {
                                "example_id": "44909059-b3f9-4f06-ab3e-4d6c1d0e67ab",
                                "sense_id": "fa3ee735-5069-3c71-83d3-6d8bdc7484d7",
                                "text": "Une épuisette était plantée dans le porte-parapluies."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f1c6f40-cb6e-3a3c-834e-ca1ad08e82c8",
                        "entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "glosses": [
                            "Filet pour attraper les oiseaux dans une volière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "165d37b2-db32-4f45-b44a-1992310325af",
                                "sense_id": "7f1c6f40-cb6e-3a3c-834e-ca1ad08e82c8",
                                "text": "Vite, un homme met une énorme épuisette sur le trajet de l’oiseau."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a0509ac-b0b2-3cbd-a466-36bbb314b642",
                        "entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
                        "glosses": [
                            "Synonyme de écope."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ce25ffe-60b1-4023-b0f9-7e99719606fb",
                        "source_entry_id": "f75ff9ac-c08d-33ce-917c-48fc94e14219",
