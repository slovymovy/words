                ],
                "senses": [
                    {
                        "sense_id": "e016695e-e30a-3442-b5ea-51c711ebe33d",
                        "entry_id": "2a9cc497-1011-3bc2-834b-cf496e68a55f",
                        "glosses": [
                            "Spécialiste des ovnis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af250c4-f3e1-4c2c-b7f3-c598d120507d",
                                "sense_id": "e016695e-e30a-3442-b5ea-51c711ebe33d",
                                "text": "« 22 à 23% des phénomènes restent non identifiés », rappelle-t-on au Geipan, le très officiel Groupe d’études et d’informations sur les phénomènes aérospatiaux non identifiés (PAN) français… « Un travail qui ne sert strictement à rien », assène l’ufologue Jean-Pierre Petit, scientifique du CNR à la retraite qui pense que des extraterrestres nous rendent régulièrement visite. « Pourquoi ne pas essayer de comprendre comment fonctionnent ces engins, ça serait plus utile ! »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0418324-d8fd-469a-b385-2c33cd748203",
                        "source_entry_id": "2a9cc497-1011-3bc2-834b-cf496e68a55f",
                        "source_sense_id": "e016695e-e30a-3442-b5ea-51c711ebe33d",
                        "target_lang_word": "Ufologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ufologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34764540-3fc1-3bd3-9210-56567b47f52b",
                                        "entry_id": "4a52d891-5795-3182-8925-130539a46c8e",
                                        "glosses": [
                                            "Person, die sich mit Ufologie befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb3dc708-4c49-44ea-8264-8e3637f15f7e",
                                                "sense_id": "34764540-3fc1-3bd3-9210-56567b47f52b",
                                                "text": "„Der deutsche Ufologe Werner Walter ist tot.“"
                                            },
                                            {
                                                "example_id": "aea2e9ef-6f2d-4120-b25a-4429f955a4c5",
                                                "sense_id": "34764540-3fc1-3bd3-9210-56567b47f52b",
                                                "text": "„Betroffen von der Katastrophe war auch Bestsellerautor und Ufologe Erich von Däniken, der zu jener Zeit als Barkeeper im Hotel arbeitete.“"
                                            },
                                            {
                                                "example_id": "ebb7435e-e10f-437c-a627-88fb12960fa2",
                                                "sense_id": "34764540-3fc1-3bd3-9210-56567b47f52b",
                                                "text": "„Ufologe David Clarke of Sheffield Hallam University sieht darin Beweise, wie sich die Form von Ufos in den vergangenen Jahrzehnten verändert hat - gemäß ihrer Darstellung in der Popkultur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6423ab11-c630-46d7-9810-94403bac1f91",
                        "source_entry_id": "2a9cc497-1011-3bc2-834b-cf496e68a55f",
                        "source_sense_id": "e016695e-e30a-3442-b5ea-51c711ebe33d",
                        "target_lang_word": "ufologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ufologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                                        "entry_id": "d4b5be3e-657e-3352-9eaf-3601db333836",
                                        "glosses": [
                                            "A person who studies UFOs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93dd93b8-a812-41ab-81e0-53b2bea13666",
                                                "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                                                "text": "Still, something strange was afoot in Rendlesham, and even if the file is unlikely to satisfy either ufologists or debunkers, it suggests that the truth is still out there."
                                            },
                                            {
                                                "example_id": "636d0fde-d9c6-41c1-8cf7-958aa94cc9ea",
                                                "sense_id": "4ae35cf4-d77d-3f0e-8020-a2bddbf8bc36",
                                                "text": "But fear of abduction never stopped a good ufologist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
