                    {
                        "translation_id": "ab4523e6-ad62-4ac7-972e-5986c1b07ee1",
                        "source_entry_id": "ded565af-bf77-3c42-8492-ed9d4f24e47e",
                        "source_sense_id": "e9a28003-d37d-307d-952c-0b190e0106f8",
