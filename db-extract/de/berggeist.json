                "senses": [
                    {
                        "sense_id": "42ab56f0-61a2-396c-91d2-4587c6ac379f",
                        "entry_id": "a58e7cde-1746-3de8-bd2b-b2057a19f245",
                        "glosses": [
                            "Fabelwesen, die in Bergwerken oder im Gebirge zu finden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f14623-d4a8-4920-bc20-55cb91785f26",
                                "sense_id": "42ab56f0-61a2-396c-91d2-4587c6ac379f",
                                "text": "„Hoch oben bei den höchsten Gipfeln der Alpen, da lebt er in einer schönen großen Höhle – der Berggeist.“"
                            },
                            {
                                "example_id": "40babb36-f740-4c4f-ac2b-06ed940d1c7e",
                                "sense_id": "42ab56f0-61a2-396c-91d2-4587c6ac379f",
                                "text": "„Aber so viel Schönes ihr auch der Berggeist darbot, sie wollte seine Gemahlin nicht werden.“"
                            },
                            {
                                "example_id": "be4ebe0c-44f2-4c6f-abcb-107ad2aaf057",
                                "sense_id": "42ab56f0-61a2-396c-91d2-4587c6ac379f",
                                "text": "„Der Sage nach treibt in dem Naturschutzgebiet seit Jahrhunderten ein Berggeist sein Unwesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
