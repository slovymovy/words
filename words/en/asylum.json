                                "target_lang_sense_clarification": "miejsce schronienia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避难所",
                                "target_lang_sense_clarification": "安全场所"
                            },
                            {
                                "target_lang_word": "庇护所",
                                "target_lang_sense_clarification": "躲避危险的地方"
                            },
                            {
                                "target_lang_word": "栖身之所",
                                "target_lang_sense_clarification": "安身之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37577d8d-8048-3840-9dd8-fe8bf6c0c5ab",
                    "sense_definition": "An institution for the care of people who are mentally ill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the nineteenth century, patients were often sent to an <w>asylum</w> for treatment.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке пациентов часто отправляли на лечение в <w>психиатрическую лечебницу</w>.",
                                "pl": "W XIX wieku pacjentów często wysyłano na leczenie do <w>szpitala psychiatrycznego</w>.",
                                "zh": "在十九世纪，病人常被送往<w>精神病院</w>接受治疗。"
                            }
                        },
                        {
                            "text": "The old <w>asylum</w> has been converted into a museum.",
                            "target_lang_translations": {
                                "ru": "Старая <w>психиатрическая лечебница</w> была превращена в музей.",
                                "pl": "Stary <w>szpital psychiatryczny</w> został przekształcony w muzeum.",
                                "zh": "那座旧<w>精神病院</w>已经被改建成了一座博物馆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "insane asylum",
                        "lunatic asylum"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often replaced by terms like psychiatric hospital"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учреждение для содержания и лечения душевнобольных (устаревшее).",
                        "pl": "Instytucja zajmująca się opieką nad osobami chorymi psychicznie (termin przestarzały).",
                        "zh": "用于收容和治疗精神病患者的机构（现多用精神病院）。"
                    },
                    "translations": {
