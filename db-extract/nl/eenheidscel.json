                                        "examples": [
                                            {
                                                "example_id": "46b88dd2-2353-45a1-943b-eacf7cca9f37",
                                                "sense_id": "7eea8733-3cd2-3821-9a5a-9cc07ca970ae",
                                                "text": "Avoir la maille au Bac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba774f00-1587-3048-97eb-311573158b72",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Encore."
                                        ],
                                        "tags": [
                                            "Hautes-Alpes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa3a31d3-c67a-4515-a5da-2bf48c6ffd59",
                                                "sense_id": "ba774f00-1587-3048-97eb-311573158b72",
                                                "text": "Il va maille falloir retourner travailler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3958744-5962-30c7-9ba1-01f12f79a325",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Moitié d’un denier, la plus petite pièce de monnaie : « Être sans sou ni maille. »"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "maille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a898aad2-a9a0-352b-a79d-c013870b3397",
                                        "entry_id": "f0b3a5dc-d1f1-3fde-861f-b25f3db0d547",
                                        "glosses": [
                                            "Ancienne monnaie de billon, au-dessous du denier, qui était la dernière division de la monnaie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e725b774-ff94-450e-b8b2-73e7cc74fa8e",
                                                "sense_id": "a898aad2-a9a0-352b-a79d-c013870b3397",
                                                "text": "Monsieur l’aumônier les régala, au nom des maîtres du logis, chacun d’une gaufre et d’une maille."
                                            },
                                            {
                                                "example_id": "c1248fe9-40df-4415-9d9a-a4f65baa9d3f",
                                                "sense_id": "a898aad2-a9a0-352b-a79d-c013870b3397",
                                                "text": "Voudriez vous pire maladie Que n’avoir (ni) maille ni denier?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b02e2a7a-c9c6-3fe2-840f-f54a0e91f56d",
                                        "entry_id": "f0b3a5dc-d1f1-3fde-861f-b25f3db0d547",
                                        "glosses": [
                                            "Chose de très petite valeur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6021d01a-8443-3f48-94ca-e0463aa3994b",
                                        "entry_id": "f0b3a5dc-d1f1-3fde-861f-b25f3db0d547",
                                        "glosses": [
                                            "Argent ; monnaie."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246570b1-5d6a-4dde-a14f-173fc23ef857",
                                                "sense_id": "6021d01a-8443-3f48-94ca-e0463aa3994b",
                                                "text": "On est franc et sincère : « Un livre, doit y avoir de la maille à se faire avec... »."
                                            },
                                            {
                                                "example_id": "542cfdd9-c2b8-4ae9-beaa-5f49d3b49655",
                                                "sense_id": "6021d01a-8443-3f48-94ca-e0463aa3994b",
                                                "text": "Je parle même pas des bougs camouflés en honnêtes travailleurs, et qui zieutent ceux qui ont de la maille en attendant le bon moment. C'est ça qui me vénèr le plus, gros."
                                            }
                                        ]
                                    }
                                ]
