    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5630a358-791a-3e89-9e08-3c44679d4fc9",
                    "sense_definition": "Personne appartenant à la classe moyenne ou aisée, attachée à un mode de vie confortable et souvent perçue comme conformiste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "classe_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>bourgeois</w> passe tous ses dimanches à s'occuper de son grand jardin."
                        },
                        {
                            "text": "Les <w>bourgeois</w> du quartier aiment se retrouver dans ce café élégant."
                        }
                    ],
                    "synonyms": [
                        "bourge"
                    ],
                    "common_phrases": [
                        "grand bourgeois",
                        "petit bourgeois"
                    ]
                },
                {
                    "sense_id": "d8d073bd-d5ab-3be4-a911-1efaa4f6675a",
                    "sense_definition": "Membre de la classe dirigeante détenant les moyens de production, par opposition au prolétariat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marxisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette théorie politique affirme que les <w>bourgeois</w> exploitent le travail des ouvriers."
                        },
                        {
                            "text": "Les manifestants dénonçaient le pouvoir économique concentré entre les mains des <w>bourgeois</w>."
                        }
                    ],
                    "antonyms": [
                        "prolétaire"
                    ]
                },
                {
                    "sense_id": "c3a1ba50-add7-3a98-8f48-7bebc179a33c",
                    "sense_definition": "Au Moyen Âge et sous l'Ancien Régime, habitant libre d'une ville ou d'un bourg disposant de droits et privilèges.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>bourgeois</w> de la commune ont négocié de nouveaux privilèges avec le roi."
                        },
                        {
                            "text": "Au douzième siècle, chaque riche <w>bourgeois</w> participait à la défense des remparts."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "contexte historique médiéval"
                        }
                    ]
                },
                {
                    "sense_id": "31e96dd2-7bfd-3465-8d19-8cfbb5dcdab3",
                    "sense_definition": "Policier qui opère en tenue civile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux <w>bourgeois</w> de la brigade surveillaient discrètement les allées et venues devant l'immeuble."
                        },
                        {
                            "text": "Le voleur a été appréhendé immédiatement par un <w>bourgeois</w> en planque."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot policier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68ad299c-1810-38c9-a959-ce80ff73cfd2",
                    "sense_definition": "Relatif à la bourgeoisie, à ses caractéristiques sociales ou à son cadre de vie aisé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "classe_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils viennent d'emménager dans une splendide maison <w>bourgeoise</w> au centre de la ville."
                        },
                        {
                            "text": "Toute cette famille <w>bourgeoise</w> passe traditionnellement les vacances d'été sur la côte."
                        }
                    ],
                    "common_phrases": [
                        "famille bourgeoise",
                        "maison bourgeoise",
                        "quartier bourgeois"
                    ]
                },
                {
                    "sense_id": "ee4831ea-613f-3252-9740-f7720af4dbdd",
                    "sense_definition": "Qui manifeste un esprit conventionnel, timoré ou dénué d'audace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mentalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste refusait fermement d'adopter des idées <w>bourgeoises</w> dans ses nouvelles peintures."
                        },
                        {
                            "text": "Cette façon de penser très <w>bourgeoise</w> limite fortement son imagination créatrice."
                        }
                    ],
                    "common_phrases": [
                        "idées bourgeoises",
                        "morale bourgeoise"
                    ]
                }
            ]
        },
