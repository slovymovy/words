                "senses": [
                    {
                        "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                        "entry_id": "9f9bd0e2-89d4-3053-8fc3-acb3f22039ea",
                        "glosses": [
                            "Menge von Sauerstoff in einem Medium (zum Beispiel in der Luft, einer Flüssigkeit oder im Blut); Sättigung mit Sauerstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d7090ce-b06b-40c2-a841-81cec9493bef",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Die Sauerstoffsättigung im Blut lag bei 75 Prozent – normal wären 99 Prozent.“"
                            },
                            {
                                "example_id": "16074a66-91a6-4093-b8ad-d54020b99bbe",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Die starke Bewegung und der Reichtum des Wassers an grünen Pflanzen bewirken hier eine Sauerstoffsättigung des Wassers […].“"
                            },
                            {
                                "example_id": "0799e4bd-01b0-49d2-9996-79e589e0b50c",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Einige Tage später verschlechterte sich ihr Zustand, die Sauerstoffsättigung in ihrem Blut fiel auf einen gefährlich niedrigen Wert.“"
                            },
                            {
                                "example_id": "f5ff6479-9918-44d8-8475-af756742c605",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Gezeichnet von der Kälte, gebrochen, ausgehungert, anämisch und aufgrund der geringen Sauerstoffsättigung der Luft halluzinierend, torkelten sie wie versteinerte Zombies in das Basiscamp.“"
                            },
                            {
                                "example_id": "c5646197-6b2c-46e3-8d9c-7ca4a8ab9bb1",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Unter photoelektrischer Oxymetrie, diese ist hier gemeint, versteht man die Messung der Sauerstoffsättigung im Blut auf photoelektrischem Weg.“"
                            },
                            {
                                "example_id": "1b905b14-9405-47f3-8ecf-654a2a8c8798",
                                "sense_id": "11021a6b-159b-37b7-bec4-573ecba71d73",
                                "text": "„Die Sauerstoffsättigung informiert darüber, wie das Hämoglobin der roten Blutkörperchen mit Sauerstoff bestückt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
