                    "frequency": "Middle",
                    "semantic_group_id": "tyrannique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens descendent dans la rue pour lutter contre l'<w>arbitraire</w> du régime autoritaire."
