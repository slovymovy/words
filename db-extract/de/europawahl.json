                ],
                "senses": [
                    {
                        "sense_id": "c4f7b898-ec6f-3ef4-aff8-73bbd9e0ba2a",
                        "entry_id": "dbaac28d-c4b8-3bf9-a3fa-be5887a4686a",
                        "glosses": [
                            "Wahl der Mitglieder des Europäischen Parlaments"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8134ab0f-73fd-45d7-b2bb-4c32cfc8d5fc",
                                "sense_id": "c4f7b898-ec6f-3ef4-aff8-73bbd9e0ba2a",
                                "text": "Am kommenden Sonntag ist Europawahl."
                            },
                            {
                                "example_id": "7a9f597f-4e4f-40af-804a-cbc3b06a052f",
                                "sense_id": "c4f7b898-ec6f-3ef4-aff8-73bbd9e0ba2a",
                                "text": "„Die ÖVP versucht, sich für die Europawahl als Kraft der Veränderung zu positionieren – Karas, Kurz und Weber im gleichen Takt.“"
                            },
                            {
                                "example_id": "4a5f68f7-42fe-431a-97d7-6c0546607f8e",
                                "sense_id": "c4f7b898-ec6f-3ef4-aff8-73bbd9e0ba2a",
                                "text": "„Nach der Europawahl müssen in der EU gleich fünf Spitzenposten neu besetzt werden.“"
                            },
                            {
                                "example_id": "c7862430-0822-4877-9da6-27b9a67f4706",
                                "sense_id": "c4f7b898-ec6f-3ef4-aff8-73bbd9e0ba2a",
                                "text": "„Eine Besonderheit der Europawahl ist, dass sie von den 27 Mitgliedsstaaten nicht einheitlich organisiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
