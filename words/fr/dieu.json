    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b252389-1fbf-3e1c-a113-8e1a7a378394",
                    "sense_definition": "Être surnaturel doué d'une puissance supérieure et faisant l'objet d'un culte dans les religions polythéistes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "divinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la mythologie grecque, Poséidon est le puissant <w>dieu</w> des mers et des tempêtes."
                        },
                        {
                            "text": "Les fidèles apportaient des offrandes au temple des <w>dieux</w> pour obtenir de bonnes récoltes."
                        }
                    ],
                    "synonyms": [
                        "déité",
                        "divinité"
                    ],
                    "common_phrases": [
                        "dieux de l'Olympe",
                        "temple des dieux"
                    ]
                },
                {
                    "sense_id": "e1e6ac8a-c3de-3074-912e-794aaf3eb11b",
                    "sense_definition": "Personne qui démontre une maîtrise ou un talent exceptionnel dans une discipline particulière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à sa technique incomparable sur scène, ce musicien est considéré comme un <w>dieu</w> vivant de la guitare."
                        },
                        {
                            "text": "Le jeune attaquant est devenu le <w>dieu</w> du stade après avoir marqué trois buts décisifs."
                        }
                    ],
                    "synonyms": [
                        "idole"
                    ],
                    "common_phrases": [
                        "dieu du stade",
                        "dieu vivant"
                    ]
                },
                {
                    "sense_id": "2964b471-ad52-3c85-b760-8ece93890570",
                    "sense_definition": "Personne ou chose qui fait l'objet d'une admiration exclusive, d'une passion ou d'une dévotion sans bornes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "veneration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour cet homme d'affaires ambitieux, l'argent est l'unique <w>dieu</w> auquel il sacrifie tout."
                        },
                        {
                            "text": "Cette écrivaine brillante était le <w>dieu</w> de tous les jeunes poètes de sa génération."
                        }
                    ],
                    "synonyms": [
                        "idole"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8105d2ae-b6fc-30e1-8154-dcd286e8f54e",
                    "sense_definition": "Être suprême, créateur de l'univers et principe absolu dans les croyances et religions monothéistes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "monotheisme",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Tous les soirs, l'enfant adresse une prière sincère à <w>Dieu</w> avant de s'endormir."
                        },
                        {
                            "text": "Nous sommes arrivés sains et saufs à la maison, <w>Dieu</w> merci."
                        }
                    ],
                    "synonyms": [
                        "Créateur",
                        "Éternel",
                        "Seigneur",
                        "Tout-Puissant"
                    ],
                    "common_phrases": [
                        "croire en Dieu",
                        "Dieu merci",
                        "grâce à Dieu"
                    ]
                },
                {
                    "sense_id": "18ffbe1a-1a62-33b8-89fa-9312ebfd53e2",
                    "sense_definition": "Nom de famille porté principalement en France et dans les pays francophones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patronyme",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "L'artiste Sébastien <w>Dieu</w> expose ses nouvelles sculptures dans cette célèbre galerie d'art contemporain."
                        },
                        {
                            "text": "Plusieurs personnes nommées <w>Dieu</w> figurent dans les registres d'état civil de la région."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nom de famille"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b15731d1-72a1-3a46-b260-be5490b74859",
                    "sense_definition": "Exclamation exprimant la stupeur, l'effroi, le soulagement ou une vive émotion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>Dieu</w>, comment as-tu pu oublier un rendez-vous aussi important ?"
