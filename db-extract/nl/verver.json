                                "target_senses": [
                                    {
                                        "sense_id": "bdd0bdf3-ec1d-34d3-99b3-1dce0cd74edb",
                                        "entry_id": "fe7a692d-23be-3060-ab31-6a9cb9b5f888",
                                        "glosses": [
                                            "Artiste utilisant la peinture pour son art."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab12ac4-14de-4660-adfb-7d7af69f2fc7",
                                                "sense_id": "bdd0bdf3-ec1d-34d3-99b3-1dce0cd74edb",
                                                "text": "Hazlitt avait d’abord été peintre, mais il peignait si mal qu’il finit par s’en apercevoir, et il se mit à écrire."
                                            },
                                            {
                                                "example_id": "8406632f-29cd-4565-a563-694f90886cee",
                                                "sense_id": "bdd0bdf3-ec1d-34d3-99b3-1dce0cd74edb",
                                                "text": "Outre l’ascension du peintre refoulé devenu soldat fanatique puis sauveur vénéré d’une Allemagne en perdition, le musée abordait l’Holocauste et ses millions de victimes, photographies sans concession à l’appui, montrant comment la folie d’une poignée d’individus ultradéterminés avait mené le pays dans l’horreur."
                                            },
                                            {
                                                "example_id": "eff5c005-d3f2-4da6-b58d-1978fa58a263",
                                                "sense_id": "bdd0bdf3-ec1d-34d3-99b3-1dce0cd74edb",
                                                "text": "La jeune Artemisia Gentileschi est une peintre remarquablement douée, qui dépasse rapidement la dextérité de son père, Ortazio Gentileschi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff40a23-c4da-3d39-8409-0a430b447c29",
                                        "entry_id": "fe7a692d-23be-3060-ab31-6a9cb9b5f888",
                                        "glosses": [
                                            "Artisan dont le métier est de couvrir de couleur des murailles, des lambris, des plafonds, etc."
                                        ],
                                        "tags": [
                                            "Peinture industrielle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d725bd31-b368-4a37-9d39-6505b48fd8c7",
                                                "sense_id": "7ff40a23-c4da-3d39-8409-0a430b447c29",
                                                "text": "Un peintre en bâtiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37eed2d1-c780-3db8-ad7e-9c328b9aa9ab",
                                        "entry_id": "fe7a692d-23be-3060-ab31-6a9cb9b5f888",
                                        "glosses": [
                                            "Épouse d’un peintre."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7405fcd-345b-3c25-8cca-e903185a5496",
                                        "entry_id": "fe7a692d-23be-3060-ab31-6a9cb9b5f888",
                                        "glosses": [
                                            "Celui qui représente fidèlement les choses dont il parle, dont il traite, soit en prose, soit en vers."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fa1846-6035-421b-8ffe-f558ffa4e47a",
                                                "sense_id": "a7405fcd-345b-3c25-8cca-e903185a5496",
                                                "text": "Cet écrivain est un excellent peintre."
                                            },
                                            {
                                                "example_id": "4927aa7b-e815-4497-985f-18467d37cee4",
                                                "sense_id": "a7405fcd-345b-3c25-8cca-e903185a5496",
                                                "text": "Molière est un grand peintre des vices et des travers de l’humanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6df82de-f6ed-374a-8f7b-c2157b25f1fa",
                                        "entry_id": "fe7a692d-23be-3060-ab31-6a9cb9b5f888",
                                        "glosses": [
                                            "Cochonnet (jeu de pétanque)."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56176de1-2085-44cc-b72b-10c3937e93b7",
                                                "sense_id": "c6df82de-f6ed-374a-8f7b-c2157b25f1fa",
                                                "text": "Suivant les régions le cochonnet répond au doux nom de petit, de pitchoun, de leu (loup), de ministre, de peintre, de gari ou de bouchon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
