                    {
                        "sense_id": "3997714c-4f74-39f2-a68b-4d28835a4456",
                        "entry_id": "866b73e4-1fe0-3913-ac4b-177175680958",
                        "glosses": [
                            "To cancel the requirement for; to make something that is required into something that is not required."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "afce5fdf-76c1-4984-8fc2-6decfa7d7c05",
                                "sense_id": "3997714c-4f74-39f2-a68b-4d28835a4456",
                                "text": "[…] today Colt's supremacy has been unrequiring the use of optical instruments."
                            },
                            {
                                "example_id": "250c72f5-de9c-4e12-81c5-5cee2bf5911f",
                                "sense_id": "3997714c-4f74-39f2-a68b-4d28835a4456",
                                "text": "Being Auxorean, I unrequire artificial aids, but for you a booster."
                            },
                            {
                                "example_id": "fcfd6622-a63e-4a3a-ad18-0f96c5968bff",
                                "sense_id": "3997714c-4f74-39f2-a68b-4d28835a4456",
                                "text": "To start with, as someone who believes that Shakespeare's work does have inherent greatness and wants others to experience and enjoy those works, I would celebrate any decision to unrequire Shakespeare."
                            },
                            {
                                "example_id": "0325eba9-fa31-42b5-add8-d1f2e0ab3c18",
                                "sense_id": "3997714c-4f74-39f2-a68b-4d28835a4456",
                                "text": "This tool is available in the Unhide All flyout and is used to unrequire all the objects that were made required."
                            }
                        ]
                    }
