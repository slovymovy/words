                    },
                    {
                        "form_id": "5e01ade4-1402-4a52-83a3-d4f8ff84fc85",
                        "entry_id": "aa4b5f5a-6425-31e7-bbcc-57d991634d5b",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "попа́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                        "entry_id": "aa4b5f5a-6425-31e7-bbcc-57d991634d5b",
                        "glosses": [
                            "оказаться пойманным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6e5d9c-b356-49a4-be95-20ea382030d0",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Попасться в капкан."
                            },
                            {
                                "example_id": "f24d8371-ce3f-4104-8b6c-92e38838878b",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Попасться в ловушку."
                            },
                            {
                                "example_id": "dca8510a-725e-4a02-8f0a-3c5bc27706d2",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Попасться в плен."
                            },
                            {
                                "example_id": "00aef9a5-b90b-4776-a902-c888956200eb",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Попасться на удочку."
                            },
                            {
                                "example_id": "555909f2-29d8-4925-9baa-77b590369153",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Попался сюда, изволь дурачиться вместе с другими."
                            },
                            {
                                "example_id": "58285784-937c-44e8-9d5b-ed72c4484056",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "Спустился — в сети тут попалась наша птичка!"
                            },
                            {
                                "example_id": "637a1cfb-3c05-460f-bdf1-92dbd41ebd71",
                                "sense_id": "cf445d07-5a0a-352e-9f94-58d61b484e57",
                                "text": "За счастьем, кажется, ты по пятам несёшься; // А как на деле с ним сочтёшься — // Попался, как ворона в суп!"
                            }
                        ]
                    },
                    {
                        "sense_id": "d3180c90-6765-3830-a9cd-f2e089747001",
                        "entry_id": "aa4b5f5a-6425-31e7-bbcc-57d991634d5b",
                        "glosses": [
                            "оказаться уличённым в чём-либо, застигнутым при совершении неблаговидного действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039126da-baaa-4bc3-b9b8-e9e4dcfcc6b3",
                                "sense_id": "d3180c90-6765-3830-a9cd-f2e089747001",
                                "text": "Попался в мошенничестве."
                            },
                            {
                                "example_id": "3c7e3747-83b8-4770-a6ff-409569f43611",
                                "sense_id": "d3180c90-6765-3830-a9cd-f2e089747001",
                                "text": "Долго воровал и наконец попался."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bd44fef-78f3-3ffe-ab7f-2c14463c0039",
                        "entry_id": "aa4b5f5a-6425-31e7-bbcc-57d991634d5b",
                        "glosses": [
                            "разг., ( повстречаться, встретиться случайно, быть замеченным кем-либо"
                        ],
                        "tags": [
                            "кому"
                        ],
                        "examples": [
                            {
                                "example_id": "aabdaed9-b6a9-47c7-9c7c-c52f9d876528",
                                "sense_id": "8bd44fef-78f3-3ffe-ab7f-2c14463c0039",
                                "text": "Попался мне один рыбак."
                            },
                            {
                                "example_id": "2634c659-df17-461e-b04e-597054ed3abf",
                                "sense_id": "8bd44fef-78f3-3ffe-ab7f-2c14463c0039",
                                "text": "Да попался Петруха, свой брат, // В кабаке: назвался угостить."
                            },
                            {
                                "example_id": "9585b183-c5f3-47c0-bb22-3ae4b84b53dd",
                                "sense_id": "8bd44fef-78f3-3ffe-ab7f-2c14463c0039",
                                "text": "Мне попался на дороге один только человек."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecbfd30d-d5a2-354a-a4eb-c96dcb2c1ced",
                        "entry_id": "aa4b5f5a-6425-31e7-bbcc-57d991634d5b",
                        "glosses": [
                            "устар. оказаться против воли в каких-либо условиях, обстоятельствах, в чьём-нибудь обладании, власти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3299ed0c-74bd-4095-8bb3-e0cdd86f3d6f",
                                "sense_id": "ecbfd30d-d5a2-354a-a4eb-c96dcb2c1ced",
                                "text": "И имя ей попалось премудрёное: Снандулия!"
                            },
                            {
                                "example_id": "cc3cbc79-cf2e-4766-a700-432fdf2f87c3",
                                "sense_id": "ecbfd30d-d5a2-354a-a4eb-c96dcb2c1ced",
                                "text": "Но только несдобровать тому, кто мне попадётся!"
                            },
                            {
                                "example_id": "268fdb7a-1474-47c2-816d-561d59ab96d8",
                                "sense_id": "ecbfd30d-d5a2-354a-a4eb-c96dcb2c1ced",
                                "text": "Попадись эта тема другому автору, тот бы ее обделал иначе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28cbcff0-d43a-4753-96cc-9c09453a6ade",
