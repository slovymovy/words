                "senses": [
                    {
                        "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                        "entry_id": "5c299881-8efe-3962-921b-228c96c6ab57",
                        "glosses": [
                            "To make (something) a crime; to make illegal under criminal law; to ban."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "97dc8046-ed23-4252-838c-38f37373b57a",
                                "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                                "text": "\"Ag-gag laws criminalize undercover investigations by prohibiting one or more of three types of behavior: trespass, recording of videos, and failure to submit a video to law enforcement.\""
                            },
                            {
                                "example_id": "e9594c5c-545d-4081-8a4e-7c4ef8bc8256",
                                "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                                "text": "The Nixon campaign in 1968[…] had two enemies: the antiwar left and black people. […] [B]y getting the public to associate the hippies with marijuana and blacks with heroin, and then criminalizing both heavily, we could disrupt those communities."
                            },
                            {
                                "example_id": "672c9aea-dc8e-49ce-af01-b1c9b41c60ef",
                                "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                                "text": "Advocates for homeless people, the American Psychiatric Association and several left-leaning states, including New York, Illinois and Minnesota, argue that criminalizing homelessness only worsens the problem."
                            },
                            {
                                "example_id": "c27e60c5-8faf-4b12-87b4-2ac356a2eb86",
                                "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                                "text": "A group of homeless residents sued the city, challenging the ordinances and contending that the local laws essentially criminalized homelessness."
                            },
                            {
                                "example_id": "2d32f26f-a2d6-417d-a48d-624f8ae5aa36",
                                "sense_id": "d49ac569-60b2-343e-8928-cff760619a58",
                                "text": "Italy passed a law on Wednesday that criminalizes seeking surrogacy abroad, a move the country’s conservative government said would protect women’s dignity, while critics see it as yet another crackdown by the government on L.G.B.T. families, as the law will make it virtually impossible for gay fathers to have children."
                            }
                        ]
                    },
                    {
                        "sense_id": "86aa4f87-6bd0-37e0-9465-97d4b3c8a731",
                        "entry_id": "5c299881-8efe-3962-921b-228c96c6ab57",
                        "glosses": [
                            "To treat as a criminal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a50ace1-6a5e-4c4b-974b-341d2963ebf6",
                        "source_entry_id": "5c299881-8efe-3962-921b-228c96c6ab57",
                        "source_sense_description": "to make something be a crime",
                        "target_lang_word": "criminaliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9869bef-4c68-314a-821c-23c3878faff2",
                                        "entry_id": "371895d5-fee7-3999-bcd4-54e428e93b31",
                                        "glosses": [
                                            "Promulguer une loi décrivant une action comme un crime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f90a5a5-120a-3638-92dc-d6dc9b1adc6b",
                                        "entry_id": "371895d5-fee7-3999-bcd4-54e428e93b31",
                                        "glosses": [
                                            "Porter, renvoyer une affaire d’un tribunal civil à un tribunal criminel, faire d’un procès civil un procès criminel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e60c30-6e85-4d32-9d94-fce220d08cb9",
                                                "sense_id": "8f90a5a5-120a-3638-92dc-d6dc9b1adc6b",
                                                "text": "Par la nature, la forme et l'esprit de la prévention, on remonte à la pensée mère, à l'élément substantiel de ce procès innomé et stupide, où la suprématie gouvernementale, l’interprétation intolérable de l’ordre public, violent et criminalisent le droit privé et le droit commun sous le couvert de la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98df90b0-3064-389b-a706-c0d7f0d97097",
                                        "entry_id": "371895d5-fee7-3999-bcd4-54e428e93b31",
                                        "glosses": [
                                            "Faire croire qu’une action légitime est une affaire criminelle, en manipulant les populations."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4c2ea8b-0810-473d-899d-7c827959e53d",
                                                "sense_id": "98df90b0-3064-389b-a706-c0d7f0d97097",
                                                "text": "Dès qu’il y a manifestation, on lâche les milices du pouvoir qui cassent et fracassent. La peur reprend le dessus et le mouvement est brisé, clochardisé, criminalisé."
                                            },
                                            {
                                                "example_id": "8304f3c1-255d-4678-b233-6a33ec82e78b",
                                                "sense_id": "98df90b0-3064-389b-a706-c0d7f0d97097",
                                                "text": "Pour de nombreuses personnalités comme la juriste Vanessa Codaccioni ou l’avocat Raphaël Kempf, l’usage du terme « écoterrorisme » sert en fait une autre finalité. Il ne s’agit pas de décrire une réalité, mais bien de dépolitiser l’action des militants en les criminalisant, voire en pathologisant."
                                            },
                                            {
                                                "example_id": "f52550e0-604f-4797-ace7-0d239cfb4315",
                                                "sense_id": "98df90b0-3064-389b-a706-c0d7f0d97097",
                                                "text": "Ces éléments démontrent, de la part de la police française, une volonté sans précédent de criminaliser l’usage des technologies de protection de la vie privée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
