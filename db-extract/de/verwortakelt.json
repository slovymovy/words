                ],
                "senses": [
                    {
                        "sense_id": "87e8cf2e-a0fa-396f-a7c2-326e485fa9ac",
                        "entry_id": "a092a17b-c8ed-35a1-b46d-27e8564de4f1",
                        "glosses": [
                            "aus der Form geraten"
                        ],
                        "tags": [
                            "Ostösterreich"
                        ],
                        "examples": [
                            {
                                "example_id": "a1713a6a-1f53-45b0-81b9-669fbf17dc18",
                                "sense_id": "87e8cf2e-a0fa-396f-a7c2-326e485fa9ac",
                                "text": "„Darauf folgt die Wegoperierung der Brille, die ihr verrutscht ist und auf der sie verwortakelt [sic!] liegt.“"
                            },
                            {
                                "example_id": "c554d34c-6828-47df-a3cc-db36bf068f7f",
                                "sense_id": "87e8cf2e-a0fa-396f-a7c2-326e485fa9ac",
                                "text": "„Drei Mitteilungen dreier bundesdeutscher Presseorgane – und deutsche Organe lügen nicht – sind es, die mein Innenleben bis zum Äußersten dissoniert und disturbiert haben, wenn nicht gar verwortakelt [sic!].“"
