                ],
                "senses": [
                    {
                        "sense_id": "e4fc5c39-9153-3617-a25f-06ad0c705c45",
                        "entry_id": "e9bfdb4c-5b54-300d-b471-a8574ecb48f0",
                        "glosses": [
                            "günstigerer Bereich in Zügen mit Sitzbänken aus Holz, in Abgrenzung zur 1. oder 2. Klasse, in denen die Sitzbänke gepolstert waren"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f62a44af-8df2-4ac2-98c0-b47d9e4a35f8",
                                "sense_id": "e4fc5c39-9153-3617-a25f-06ad0c705c45",
                                "text": "„Zehn Pfennig kostet eine Fahrt im Abteil der dritten Klasse, der sogenannten Holzklasse, für bis zu fünf Stationen. 15 Pfennig zahlen die Fahrgäste in der mit Linoleumfußboden und Kunstlederpolstern ausgestatteten zweiten Klasse.“"
                            },
                            {
                                "example_id": "d5681354-5c6d-44de-ac16-ea8065f5e6ac",
                                "sense_id": "e4fc5c39-9153-3617-a25f-06ad0c705c45",
                                "text": "„Dann kaufte die Mutter am Schalter den Fahrschein (Holzklasse natürlich) und eine Bahnsteigkarte.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                        "entry_id": "e9bfdb4c-5b54-300d-b471-a8574ecb48f0",
                        "glosses": [
                            "günstigerer Bereich in Verkehrsmittel, häufig Flugzeugen, in denen Einschränkungen beim Komfort oder Service hingenommen werden müssen"
                        ],
                        "tags": [
                            "mit Bezug zu Verkehrsmitteln",
                            "übertragen (zu Bed. 1a)"
                        ],
                        "examples": [
                            {
                                "example_id": "51b431ab-f996-4d92-a63f-0bbcc6af70c4",
                                "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                                "text": "Selbst Manager der Industrie müssen heute Holzklasse fliegen."
                            },
                            {
                                "example_id": "7e2e5f49-b36c-4616-9127-facfea220613",
                                "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                                "text": "„Sicherlich flog Tebartz-van Elst an diesem Mittwoch (28.08.2013) nicht in der Holzklasse nach Rom.“"
                            },
                            {
                                "example_id": "cbc0bf54-3097-4b9e-81ca-7c42cd0066db",
                                "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                                "text": "„[…] sein Vater war ein ganz gewöhnlicher Einwanderer gewesen, und noch in drei Generationen sollten die oberen Zehntausend der Stadt beim Dinner ihren Tischnachbarn zuflüstern: »Aber ja, meine Liebe, Cornelias Großvater kam in der Holzklasse über den Atlantik!«“"
                            },
                            {
                                "example_id": "ff668139-19dc-4c59-a3a8-bd8db35e3176",
                                "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                                "text": "„Der Jumbo kommt gerade von einem Sonderflug zurück. Es ist der erste Einsatz einer neuen Kabinenklasse. „Premium Economy“ nennt sie die Lufthansa, sie bietet etwas mehr Platz als die enge Holzklasse.“"
                            },
                            {
                                "example_id": "2f4bd321-5446-4fd8-b5b3-4f033dad41bc",
                                "sense_id": "26b411da-8d52-33dc-84f1-7c2491001484",
                                "text": "Sie planen, ganz, ganz weit vorne im Flieger zu sitzen und klagen über die hohen Kosten? Kein Problem. Buchen Sie Holzklasse und schon haben Sie viel gespart."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "c4f2b131-0687-356d-8d36-19b7e6aff316",
                        "entry_id": "e9bfdb4c-5b54-300d-b471-a8574ecb48f0",
                        "glosses": [
                            "Güteklasse (Qualität) von Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02adebab-134e-4e0e-a90a-b1bb503b3dc9",
                                "sense_id": "c4f2b131-0687-356d-8d36-19b7e6aff316",
                                "text": "„Der erſte Tarifſatz oder die erſte Holzklaſſe mit einem Reinertrage von jährlich 42 Sgr. pro Morgen umfaßt die III. Bodenklaſſe für Eichenhochwald, und die II. Bodenklaſſe für Buchenhochwald.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
