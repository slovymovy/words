                                            {
                                                "example_id": "83d8c3da-0ad6-4f20-a248-bf37503ee40e",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "In der Disco war es gestern rappelvoll."
                                            },
                                            {
                                                "example_id": "452d46c8-6ed7-46d2-8b6e-674cfca8e95b",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Die Gefängnisse in der Türkei sind rappelvoll."
                                            },
                                            {
                                                "example_id": "20164879-a1fc-4798-ad19-3c3ec038d23f",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "„Sein Terminkalender ist rappelvoll.“"
                                            },
                                            {
                                                "example_id": "36aaef49-b6a1-4b5d-a18f-60a15d7ac89c",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Die Restaurantkette ist vor allem beliebt für ihre türkischen Grill-Spezialitäten und deswegen meist rappelvoll."
                                            },
                                            {
                                                "example_id": "fec5a657-bdc2-4e33-bf7e-89dc8f37e477",
                                                "sense_id": "ef6ff35e-d1b4-3a2e-a3ad-420b0f270223",
                                                "text": "Gerade jetzt ist das Deutsche unglaublich gut besucht in den ganzen Goethe-Instituten in Griechenland, in Spanien, in Portugal. Die sind rappelvoll, was sie jahrzehntelang - in Bezug auf Sprachunterricht - nicht waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
