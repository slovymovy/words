                ],
                "senses": [
                    {
                        "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                        "entry_id": "93b9195c-f404-3fb3-83ac-e97f3cb474d1",
                        "glosses": [
                            "Menschen in einer Region, bei denen besondere Eigenschaften auffallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02645f1b-adf5-403e-a695-4131b3e07ac0",
                                "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                                "text": "Die Küstenbewohner sind ein ganz besonderer Menschenschlag."
                            },
                            {
                                "example_id": "a357d439-7989-4f98-ae62-b44090cc1c9c",
                                "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                                "text": "„In Niederbayern ist dann wieder einer der schwarzhaarigsten und dunkeläugigsten Menschenschläge zuhause, die es auf deutschem Boden gibt, besonders von Regensburg gegen den Bayrischen Wald und nach Amberg und Schwandorf hin.“"
                            },
                            {
                                "example_id": "9ceef5cb-572c-452b-bc2a-0a3b878c7c76",
                                "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                                "text": "„Die Kohlegruben und großen Metallfabriken brachten einen halbwilden Menschenschlag hervor, aufbrausend und besessen von Hass auf Bristol, was angesichts der giftigen Dämpfe und Ausdünstungen von Kingswood nicht verwundern konnte.“"
                            },
                            {
                                "example_id": "5504f3f3-c76d-4b70-9a39-187bcb46f077",
                                "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                                "text": "„Man begegne hier einem ganz anderen Menschenschlag als im alpenländischen Meran.“"
                            },
                            {
                                "example_id": "28509b95-2398-47f8-af8a-131220f413c1",
                                "sense_id": "cd9d9e15-6686-39c6-9bde-88417d844fbf",
                                "text": "„Alle mochten Lindsay, und sie mochte diesen besonderen Menschenschlag, diese offene, direkte Art der Trucker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
