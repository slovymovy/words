                                        "entry_id": "6cc6ffcb-93e6-34b0-9120-b755041db5c9",
                                        "glosses": [
                                            "Boisson qui se fait avec du jus d’orange, du sucre et de l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c258cd-0f27-4818-8fb7-3267f6f6d004",
                                                "sense_id": "f37024eb-1cc7-3c17-8b64-c5cdef7616e0",
                                                "text": "c’est la mode aujourd’hui de prévenir ainsi la soif : les uns prennent de l’orangeade ou de l’eau de limon, les autres de l’eau de mélisse."
                                            },
                                            {
                                                "example_id": "7de6ebb7-1532-4d54-ab80-88392fe42d9b",
                                                "sense_id": "f37024eb-1cc7-3c17-8b64-c5cdef7616e0",
                                                "text": "Mais elle avait pris la route avant l'aube et sous l’orage. Pour voir sa fille, pour l'entendre, pour ne pas l’inquiéter. Après avoir bu son orangeade..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d89a16b-73b6-4552-a18d-4fde75286980",
                        "source_entry_id": "0e5b8896-3d7a-3d78-ba32-40091081b457",
                        "source_sense_description": "orange-flavored soft drink",
                        "target_lang_word": "Orangeade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orangeade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "996138aa-27f4-3d8b-a62f-4f7c43e5ef55",
                                        "entry_id": "68e92697-194e-337f-a798-e4af35d2d58c",
                                        "glosses": [
                                            "süßes Getränk mit Soda (kohlensäurehaltiges Wasser) und dem Geschmack nach Orange/Apfelsine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a33d53-2356-4e22-b9c7-b20b68af48a8",
                                                "sense_id": "996138aa-27f4-3d8b-a62f-4f7c43e5ef55",
                                                "text": "Fünf Damen saßen an einem Tischchen im Schatten und tranken Orangeade."
                                            },
                                            {
                                                "example_id": "7be60afa-0624-46b8-a772-c4f0d5e8ad7c",
                                                "sense_id": "996138aa-27f4-3d8b-a62f-4f7c43e5ef55",
                                                "text": "„Dem Kartoffelmus wird vom Luftzug so viel Wärme entzogen, dass es als Erfrischung dienen kann, zumal die bereitgestellte Orangeade durch ihren Gehalt an tragisch ums Leben gekommenen Mücken nicht mehr zum Genuss reizt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86855522-c1d2-492e-80d0-9dc10de2c981",
                        "source_entry_id": "0e5b8896-3d7a-3d78-ba32-40091081b457",
                        "source_sense_description": "orange-flavored soft drink",
                        "target_lang_word": "Orangenlimo",
