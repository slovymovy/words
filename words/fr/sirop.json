    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d83694cc-3619-3dac-9c58-e2e9e0b67d39",
                    "sense_definition": "Liquide sucré et aromatisé que l'on dilue avec de l'eau pour préparer une boisson rafraîchissante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'été, les enfants adorent boire un verre d'eau fraîche avec du <w>sirop</w> de fraise."
                        },
                        {
                            "text": "Le serveur a apporté une carafe d'eau et un grand verre de <w>sirop</w> de menthe."
                        }
                    ],
                    "common_phrases": [
                        "sirop de menthe",
                        "sirop de grenadine",
                        "verre de sirop"
                    ]
                },
                {
                    "sense_id": "362335b9-4319-3479-aa0d-4d6b01086394",
                    "sense_definition": "Médicament liquide et visqueux, généralement sucré, destiné à être avalé pour traiter une affection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a prescrit un <w>sirop</w> efficace pour calmer ma vilaine toux."
                        },
                        {
                            "text": "Il faut prendre une cuillère de ce <w>sirop</w> trois fois par jour après les repas."
                        }
                    ],
                    "common_phrases": [
                        "sirop pour la toux",
                        "cuillère de sirop",
                        "prendre du sirop"
                    ]
                },
                {
                    "sense_id": "278119a2-2cae-36a0-8dfe-3facb9211ead",
                    "sense_definition": "Liquide concentré obtenu par la cuisson d'eau et de sucre avec des sucs de fruits ou des plantes, utilisé en cuisine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pâtissier imbibe le gâteau avec un <w>sirop</w> parfumé à la vanille."
                        },
                        {
                            "text": "Au petit-déjeuner, nous aimons verser un filet de <w>sirop</w> d'érable sur les crêpes chaudes."
                        }
                    ],
                    "common_phrases": [
                        "sirop d'érable",
                        "sirop de canne",
                        "poires au sirop"
                    ]
                },
                {
                    "sense_id": "fb36e206-9491-3ddb-bb92-245b3eebb671",
                    "sense_definition": "Solution dense et concentrée obtenue en dissolvant une forte proportion de sucre dans l'eau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chimie_cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour préparer cette liqueur artisanale, le chimiste mélange de l'alcool pur avec un <w>sirop</w> de sucre."
                        },
                        {
                            "text": "La recette exige d'amener le <w>sirop</w> à ébullition jusqu'à ce que tout le sucre soit dissous."
                        }
                    ],
                    "common_phrases": [
                        "sirop simple",
                        "sirop de sucre"
                    ]
                },
                {
                    "sense_id": "c8c7e437-9d36-357f-a3cb-4e599727ee84",
                    "sense_definition": "Sirop d'érable, par ellipse dans le contexte de la production acéricole.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque printemps, toute la famille se réunit à la cabane pour fabriquer le <w>sirop</w> frais."
                        },
                        {
                            "text": "Ce producteur québécois vend son <w>sirop</w> artisanal directement aux visiteurs de sa ferme."
                        }
                    ],
                    "common_phrases": [
