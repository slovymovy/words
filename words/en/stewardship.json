{
    "word_family": [
        "steward",
        "stewardess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1233da44-6e68-38a2-af75-1a42763d49e2",
                    "sense_definition": "The careful and responsible management or care of something entrusted to one's charge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was praised for its environmental <w>stewardship</w> and waste reduction programs.",
                            "target_lang_translations": {
                                "cs": "Společnost byla chválena za svou <w>péči</w> o životní prostředí a programy na snižování množství odpadu."
                            }
                        },
                        {
                            "text": "Effective <w>stewardship</w> of public funds requires full transparency and accountability.",
                            "target_lang_translations": {
                                "cs": "Efektivní <w>správa</w> veřejných financí vyžaduje plnou transparentnost a odpovědnost."
                            }
                        }
                    ],
                    "synonyms": [
                        "custodianship",
                        "guardianship",
                        "care",
                        "management"
                    ],
                    "antonyms": [
                        "neglect",
                        "mismanagement"
                    ],
                    "common_phrases": [
                        "environmental stewardship",
                        "good stewardship"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pečlivá a odpovědná péče či správa něčeho, co bylo svěřeno do něčí péče."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "správa",
                                "target_lang_sense_clarification": "péče a odpovědné vedení (např. zdrojů, financí)"
                            },
                            {
                                "target_lang_word": "péče",
                                "target_lang_sense_clarification": "odpovědné nakládání (např. s životním prostředím)"
                            },
                            {
                                "target_lang_word": "hospodaření",
                                "target_lang_sense_clarification": "odpovědné využívání prostředků či zdrojů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7d4d08c-cb73-3052-a94b-50813498589b",
                    "sense_definition": "The official position, rank, or term of office of a steward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During his <w>stewardship</w> of the estate, agricultural production increased significantly.",
                            "target_lang_translations": {
                                "cs": "Během jeho <w>správcovství</w> na panství zemědělská produkce výrazně vzrostla."
                            }
                        },
                        {
                            "text": "She resigned from her <w>stewardship</w> after serving the committee for five years.",
                            "target_lang_translations": {
                                "cs": "Po pěti letech působení ve výboru na svou <w>funkci správce</w> rezignovala."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Oficiální pozice, funkce nebo funkční období správce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "správcovství",
                                "target_lang_sense_clarification": "funkce, úřad nebo působení správce"
                            },
                            {
                                "target_lang_word": "vedení",
                                "target_lang_sense_clarification": "období výkonu funkce ve vedení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}