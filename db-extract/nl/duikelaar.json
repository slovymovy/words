                        "source_sense_id": "51c64d19-ff3a-3ad1-906a-64ce4e0b337e",
                        "source_sense_description": "speeltuigje",
                        "target_lang_word": "Stehaufmännchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stehaufmännchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca98674a-9e50-3c66-b082-6149343f8c60",
                                        "entry_id": "6ffd21d6-483d-37cb-b58d-0b1cb2f25a2d",
                                        "glosses": [
                                            "Person, die sich auch von großem Pech/Unglück nicht unterkriegen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d90295-2a04-4ebb-af50-b2f3a742f945",
                                                "sense_id": "ca98674a-9e50-3c66-b082-6149343f8c60",
                                                "text": "[Überschrift:] Stewart O'Nan über Scott F. Fitzgerald: „Er war ein Stehaufmännchen“"
                                            },
                                            {
                                                "example_id": "a5cb51da-b43b-408d-b300-01ad0d541746",
                                                "sense_id": "ca98674a-9e50-3c66-b082-6149343f8c60",
                                                "text": "Als Dittmann aber mit seinem Geschäft an die Börse wollte, scheiterte er und verlor fast alles. Aber er ist ein Stehaufmännchen und fing wieder von vorn an."
                                            },
                                            {
                                                "example_id": "b368b444-2fb5-40e4-a4d5-00465d450bb4",
                                                "sense_id": "ca98674a-9e50-3c66-b082-6149343f8c60",
                                                "text": "„Trotzdem erweist er sich wieder einmal als wahres Stehaufmännchen, denn bald darauf setzt er mit Wulffen die Wanderung fort.“"
                                            },
                                            {
                                                "example_id": "4069f51e-81b7-4bf4-b41d-06a63c33bbf5",
                                                "sense_id": "ca98674a-9e50-3c66-b082-6149343f8c60",
                                                "text": "[Ein Stehaufmännchen] ist jemand, der es immer schafft, sich selbst zusammenzureißen und weiterzumachen. Egal, ob sich jemand gerade in einer tiefen Lebenskrise befindet, die Liebste oder der Liebste einen verlassen oder der Sportverein mal wieder verloren hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94a422cc-be4a-39b6-aa2f-6ed842555d21",
                                        "entry_id": "6ffd21d6-483d-37cb-b58d-0b1cb2f25a2d",
                                        "glosses": [
                                            "Figur mit tief liegenden Schwerpunkt, so dass sie sich immer wieder aufrichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2ab503-b239-4296-afe7-d444b3b4da3a",
                                                "sense_id": "94a422cc-be4a-39b6-aa2f-6ed842555d21",
                                                "text": "Auf dem Dachboden fanden sie in einer Kiste einen Kreisel, ein Stehaufmännchen und einen Affen zum Aufziehen, der die Schellen zusammenschlägt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
