                "senses": [
                    {
                        "sense_id": "b4d24e73-9378-3de5-8521-0fd5ccec314f",
                        "entry_id": "765798ed-60cd-3380-8136-8447b9acd22c",
                        "glosses": [
                            "kobieta uzależniona od robienia zakupów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f417ccc2-f987-4cc1-9973-4e9d28d6e4b3",
                                "sense_id": "b4d24e73-9378-3de5-8521-0fd5ccec314f",
                                "text": "Zakupoholiczka (…) powraca. I podczas podróży poślubnej, nie kontrolując stanu konta, wydaje ciężko zarobione przez męża pieniądze – na drobiazgi"
                            },
                            {
                                "example_id": "b788c2da-ac7e-4869-a36d-9e5ce3f60858",
                                "sense_id": "b4d24e73-9378-3de5-8521-0fd5ccec314f",
                                "text": "Już sam akt kupowania jest dla nich niezmiernie uzależniający, obojętnie co kupują. Pewna zakupoholiczka miewa w trakcie zakupów i tuż przed ich rozpoczęciem mrowienia, suchy język i podniebienie, dzwonienie w uszach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
