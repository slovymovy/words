                            {
                                "target_lang_word": "olive",
                                "target_lang_sense_clarification": "color"
                            },
                            {
                                "target_lang_word": "olive-green",
                                "target_lang_sense_clarification": "color"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21f29477-1203-3190-9213-29172a5ceb2c",
                    "sense_definition": "wykonany z twardego drewna drzewa oliwnego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na pamiątkę kupił figurkę wykonaną z drewna <w>oliwnego</w>.",
                            "target_lang_translations": {
