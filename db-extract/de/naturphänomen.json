                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947d7f6e-b299-46fb-9256-6c7dc1608e09",
                                "sense_id": "1654292c-c5bb-3985-a4b3-905f5ac2fa90",
                                "text": "Der Blitz ist ein Naturphänomen, das bei einem Gewitter auftritt."
                            },
                            {
                                "example_id": "ef913515-6216-44eb-8e27-dcd019e753f4",
                                "sense_id": "1654292c-c5bb-3985-a4b3-905f5ac2fa90",
                                "text": "„So schön Naturphänomene wie Sternschnuppen anzusehen sind, so schwierig lassen sie sich meist fotografieren.“"
                            },
                            {
                                "example_id": "1878ad76-3365-45d2-9c3c-851e52b9ad92",
                                "sense_id": "1654292c-c5bb-3985-a4b3-905f5ac2fa90",
                                "text": "„Grenzenloser Schrecken vor den kommenden Ereignissen wurde durch dieses Naturphänomen in den Herzen der Bevölkerung Mitteleuropas ausgelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
