                        "source_sense_id": "b8b8310d-8f5e-3e5b-87e0-76dea318236c",
                        "source_sense_description": "organism that lives on dead organic matter",
                        "target_lang_word": "saprofyt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saprofyt",
