                                                "sense_id": "a3c95606-c74b-36a5-ac7b-0103e610d512",
                                                "text": "Le subjectif et l’objectif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subjectif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "165152ad-b86c-3dd8-a022-bc48e871c913",
                                        "entry_id": "b294db5b-baad-325c-b0eb-b7fc655e9edb",
                                        "glosses": [
                                            "Qui a rapport au sujet, en parlant de ce qui se passe dans notre esprit, de ce qui est en nous et s’oppose à objectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47c6ae02-cb9b-4bef-8605-cbcf3af79bfd",
                                                "sense_id": "165152ad-b86c-3dd8-a022-bc48e871c913",
                                                "text": "Réalité subjective. — Conceptions subjectives."
                                            },
                                            {
                                                "example_id": "e05509e7-1d85-41fc-b80a-19e8252ecc60",
                                                "sense_id": "165152ad-b86c-3dd8-a022-bc48e871c913",
                                                "text": "L’art est la conquête du subjectif à travers l’objectif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "961a4bc3-0d40-3358-a873-46abb08c286e",
                                        "entry_id": "b294db5b-baad-325c-b0eb-b7fc655e9edb",
                                        "glosses": [
                                            "Qui relève du jugement ou du goût personnel."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35592f6c-e9a3-42a1-a61b-aa59b2d8f5cf",
                                                "sense_id": "961a4bc3-0d40-3358-a873-46abb08c286e",
                                                "text": "Je me défie habituellement des impressions en voyage. Ces impressions sont subjectives, – un mot que j’emploie parce qu’il est à la mode, bien que je n’aie jamais bien su ce qu’il veut dire. Un homme gai verra gaiement les choses. Un homme triste les verra tristement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
