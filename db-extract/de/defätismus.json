                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc75899c-1e89-4da0-8533-945f5fa01f42",
                        "source_entry_id": "544baac3-2438-39ef-b34d-5087eaea0765",
                        "source_sense_id": "66f72f7a-77c7-3d15-9bc2-70f51081d1ac",
