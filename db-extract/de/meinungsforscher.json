                        "glosses": [
                            "Person, die sich mit der Untersuchung der öffentlichen Meinung beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e323b6-5196-449f-b506-f424b171a899",
                                "sense_id": "6d3a4c62-2edd-37df-aa62-9dc31036e262",
                                "text": "Die israelischen Meinungsforscher, unter ihnen auch Scheindlin, kamen daher zum Schluss, dass die alte Dichotomie von \"entweder oder\" überholt ist."
                            },
                            {
                                "example_id": "7bcebed0-cd88-46ff-b860-06f17f9aa979",
                                "sense_id": "6d3a4c62-2edd-37df-aa62-9dc31036e262",
                                "text": "„Auch Meinungsforscher hatten der SPD intern immer Mut gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
