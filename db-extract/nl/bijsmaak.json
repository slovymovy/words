                "translations": [
                    {
                        "translation_id": "740fc855-e2ed-4f44-94e4-84ece8d5494f",
                        "source_entry_id": "b3c4fece-5e0a-3be3-b96a-2314fbcb91ba",
                        "source_sense_id": "f7f0c72e-f6b1-3b54-bc42-0deb108d4174",
                        "source_sense_description": "een extra smaak die er eigenlijk niet bij hoort",
                        "target_lang_word": "Beigeschmack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beigeschmack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2d0710-a27c-3c42-86c0-61fcf61c92fd",
                                        "entry_id": "dea08af3-b1ab-3dda-80c2-afc51a7d5bec",
                                        "glosses": [
                                            "ein nebensächlicher Geschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065ee5b0-b662-49b2-b4f9-a7f54a6cce6e",
                                                "sense_id": "0a2d0710-a27c-3c42-86c0-61fcf61c92fd",
                                                "text": "Der holzige Beigeschmack wird bewusst durch die Lagerung erzeugt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                        "entry_id": "dea08af3-b1ab-3dda-80c2-afc51a7d5bec",
                                        "glosses": [
                                            "ein nebensächlicher, meist unerwünschter Anteil einer Sache (z.B. einer Äußerung)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ecf08a-65b7-4a06-8cca-788ced5ecce1",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "Seine Rede hatten einen üblen Beigeschmack von Polit-Propaganda."
                                            },
                                            {
                                                "example_id": "1c9d3d1e-3e85-4456-91d6-8f8de13b3026",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "Die fragwürdige Aktion hinterließ einen fahlen Beigeschmack."
                                            },
                                            {
                                                "example_id": "ca4c274d-7841-4db6-9a2f-c34da4440d5a",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "„Und wirklich war in der Prozedur des Friedensrichters, ungeachtet des starken Beigeschmacks hinterwäldischer Manieren, eine Offenheit und Biederkeit, die nicht fehlen konnten, ihm Vertrauen zu seinen neuen Bekannten einzuflößen.“"
                                            },
                                            {
                                                "example_id": "ec5852f9-8366-4652-963e-75745ea7f53b",
                                                "sense_id": "1db157f4-e5ef-3cb3-b8d8-00b10299ca01",
                                                "text": "„Die zahlenmäßig zweitstärkste Bevölkerungsgruppe bilden die Paschtunen mit 15,4 Prozent (1998) der Gesamtbevölkerung. In Pakistan werden sie häufig als Pathanen bezeichnet, jedoch hat diese Benennung, die auf die Briten zurückgeht, einen kolonialistischen Beigeschmack.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
