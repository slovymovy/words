                                    }
                                ]
                            },
                            {
                                "target_word": "tact",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd33452-bfb9-398c-beab-30e5ffa7f292",
                                        "entry_id": "d3e26bbe-93c9-3019-a5da-05518e4318c1",
                                        "glosses": [
                                            "Clipping of tactic."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0168d29b-25b2-4b01-831d-bcfc33db8282",
                                                "sense_id": "cdd33452-bfb9-398c-beab-30e5ffa7f292",
                                                "text": "Wanda \"Hey, can you show us?\"\nKaren \"No\"\nBrent \"We promise not to make fun of you.\"\nKaren \"No\"\nLacey \"Okay, we promise TO make fun of you.\"\nKaren \"I'm getting a drink\"\nLacey \"I was trying a different tact.\"\nWanda \"Bad tack.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a71b21c-bd50-4f14-87c3-b40066d057af",
                        "source_entry_id": "c8d8fc9f-67fc-3619-9d02-1c60df946d85",
                        "source_sense_id": "a5e656a2-e55b-336f-88e0-735a695345cd",
                        "source_sense_description": "Gefühl dafür, was sich im Umgang mit anderen Personen ziemt",
                        "target_lang_word": "tact",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tact",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9a3fce5-82f7-31a4-ba6a-ef49226a79ac",
                                        "entry_id": "18ccd3d2-3fba-364e-b582-5e4f49ed3d12",
                                        "glosses": [
                                            "Toucher, sens par lequel on connaît ce qui est chaud ou froid, dur ou mou, uni ou raboteux, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1831b64e-b2b0-4640-96db-fea543d88884",
                                                "sense_id": "e9a3fce5-82f7-31a4-ba6a-ef49226a79ac",
                                                "text": "Les pectorales, larges et allongées, présentent trois rayons libres auxquels se rendent des nerfs volumineux; ce sont des organes de tact."
                                            },
                                            {
                                                "example_id": "17e333d2-a0ef-4056-94b4-0b590bde4df3",
                                                "sense_id": "e9a3fce5-82f7-31a4-ba6a-ef49226a79ac",
                                                "text": "Nos verriers de l'Est, reprend M. Daum, ont un tact parfait en ce genre de fabrication limonadière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ba7abf5-2bde-3070-b88e-b09acf4cf010",
                                        "entry_id": "18ccd3d2-3fba-364e-b582-5e4f49ed3d12",
                                        "glosses": [
                                            "Sentiment délicat des convenances, des nuances, de la mesure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb0df8e-507a-49e8-9858-5e02ec8230d6",
                                                "sense_id": "9ba7abf5-2bde-3070-b88e-b09acf4cf010",
                                                "text": "Elle paraissait supérieure même aux femmes les plus heureusement douées, grâce à un tact naturel exquis. Ce discernement merveilleux de l’opportunité en toutes choses la servait peut-être plus encore que tous ses autres avantages."
                                            },
                                            {
                                                "example_id": "15deeb97-169c-43dd-b8f4-447898860c98",
                                                "sense_id": "9ba7abf5-2bde-3070-b88e-b09acf4cf010",
                                                "text": "Avec beaucoup de tact, ce vieillard, qui savait n'être ni autoritaire ni égoïste, s'efforçait de gagner l'affection de Nazira et de se faire pardonner d'être vieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ffae10-9756-3d0c-b411-99034e3e5d8e",
                                        "entry_id": "18ccd3d2-3fba-364e-b582-5e4f49ed3d12",
                                        "glosses": [
                                            "Faculté de se conduire ou de parler en prenant garde à ne pas blesser la sensibilité, l'amour-propre ou plus simplement les convenances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c94a0973-a9e4-4c42-804a-2029d668c73b",
                                                "sense_id": "c7ffae10-9756-3d0c-b411-99034e3e5d8e",
                                                "text": "À trente ans seulement une femme peut connaître les ressources de cette situation. […]. Elle possède alors le tact nécessaire pour attaquer chez un homme toutes les cordes sensibles, et pour étudier les sons qu'elle en tire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
