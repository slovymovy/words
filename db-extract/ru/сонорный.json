                    {
                        "translation_id": "efd0d708-262e-48a9-bd09-fe193c12a6b7",
                        "source_entry_id": "585e2ad8-f913-3c5c-aa75-4f53f51e2228",
                        "target_lang_word": "sonorant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sonorant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e01b40-658b-3279-bf77-d598712d4b36",
                                        "entry_id": "d22d6ebf-c219-3b67-81d3-d39c162fbb90",
                                        "glosses": [
                                            "A speech sound that is produced without turbulent airflow in the vocal tract; the generic term of vowel, approximant, nasal consonant, etc."
                                        ],
                                        "tags": [],
