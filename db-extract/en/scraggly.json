                                                "sense_id": "c8f0c7a6-d231-375f-9a67-96ab4933fe97",
                                                "text": "Der wilde Junge schlug um sich."
                                            },
                                            {
                                                "example_id": "c2292ff7-c78b-4bc8-8865-ca343b7b0819",
                                                "sense_id": "c8f0c7a6-d231-375f-9a67-96ab4933fe97",
                                                "text": "Wenn du das noch einmal sagst, werde ich wild!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a4bc0561-2179-3768-8609-5cc3c48c9238",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
