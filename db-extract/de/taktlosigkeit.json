                ],
                "senses": [
                    {
                        "sense_id": "da364897-e0db-37ef-b942-bfacef416c5a",
                        "entry_id": "26bacc55-a212-3c9f-87c7-3b4625d4b10f",
                        "glosses": [
                            "das Fehlen von Feingefühl beim Umgang mit anderen Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8671c00b-9d1c-4ac6-851b-eb54b0d761bd",
                                "sense_id": "da364897-e0db-37ef-b942-bfacef416c5a",
                                "text": "Deine Taktlosigkeit wird dir noch zum Nachteil werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4e266575-55dc-34bc-bd25-52707fe11d6c",
                        "entry_id": "26bacc55-a212-3c9f-87c7-3b4625d4b10f",
                        "glosses": [
                            "eine taktlose Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3f9d4e-ad0e-4db0-9fcd-38f245ca67bb",
                                "sense_id": "4e266575-55dc-34bc-bd25-52707fe11d6c",
                                "text": "Diese völlig unnötige Taktlosigkeit hat ihn viele Sympathien gekostet."
                            },
                            {
                                "example_id": "b298753a-4a56-4ca6-8f37-6cab5c03c0cf",
                                "sense_id": "4e266575-55dc-34bc-bd25-52707fe11d6c",
                                "text": "„Wenn man sie jetzt auf diese Taktlosigkeit anspricht, schaut sie unschuldig wie die frühe Angela Merkel.“"
                            },
                            {
                                "example_id": "97dfd8ef-ee7a-485d-906c-248522a5bba5",
                                "sense_id": "4e266575-55dc-34bc-bd25-52707fe11d6c",
                                "text": "„Nun kommt der Augenblick, in dem mich die Wahrheit bedrückt, da ich mich genötigt sehe, sie zu gestehen und mich einer Taktlosigkeit fähig zu bekennen, die den Leser zu einem falschen Urteil über mich veranlassen könnte, falls er sie als kennzeichnend für mich ansieht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
