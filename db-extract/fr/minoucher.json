                ],
                "senses": [
                    {
                        "sense_id": "c7bc67f1-2245-37c0-929b-b787f9f1960f",
                        "entry_id": "5f799de4-d5c9-377d-8d94-4968d060c710",
                        "glosses": [
                            "Caresser."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "5c183505-b415-476b-b1f0-bdaaaf395929",
                                "sense_id": "c7bc67f1-2245-37c0-929b-b787f9f1960f",
                                "text": "Par la fenêtre, j'aperçois Le Richard et sa Johanse de femme qui se minouchent au coin du zinc."
                            },
                            {
                                "example_id": "826a7882-7f50-400e-9d7d-dae445ccd23a",
                                "sense_id": "c7bc67f1-2245-37c0-929b-b787f9f1960f",
                                "text": "L'aubergiste leur apporte tisanes et sucreries pendant que tous deux se réchauffent près du feu. Entourés de leurs parents respectifs qui les cajolent et les minouchent, nos deux amis apprécient intérieurement leurs moments de gloire."
                            },
                            {
                                "example_id": "93205f73-114c-4cf5-a497-2edaa2467f71",
                                "sense_id": "c7bc67f1-2245-37c0-929b-b787f9f1960f",
                                "text": "Pierre et moi avons suivi Yannick et la jolie Noire qui s'accrochait à son bras vers un petit salon, d'où les gardes du corps de Met Y avaient chassé les couples qui s’y minouchaient."
                            }
                        ]
                    }
                ],
