                        "cross_references": [
                            {
                                "target_word": "pressing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                        "entry_id": "7b097499-a34b-389f-82fa-a0c21e6bcd7e",
                                        "glosses": [
                                            "Needing urgent attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b7a8b7-2431-4ef0-b3b6-99e66bf9d4a0",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "“I come on business.—Private,” he added, with a glance at the man who stood looking on, “and very pressing business.”"
                                            },
                                            {
                                                "example_id": "4a54df98-5701-420c-b231-197bdd4b18b2",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "The rebuilding of damaged stations is proceeding slowly, on account of the shortage of building materials and the pressing needs of housing, but steady progress is being made."
                                            },
                                            {
                                                "example_id": "81a37a13-0b4c-4248-b1ed-f06f6f6282bc",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "Argentinians support the \"Malvinas\" cause, which is written into the constitution. But they are also worried about pressing economic problems such as inflation, rising crime and corruption."
                                            },
                                            {
                                                "example_id": "12754b6e-fc91-4ac8-b0ae-55f0afec3df1",
                                                "sense_id": "e1f95dff-a79b-3905-9fcc-3f09d70b4737",
                                                "text": "Four Japanese torpedo boats launch an attack on the Suvorov. Despite burning steadily for several hours and now taking a torpedo to the stern, the ship still lashes out at its attackers with a few remaining guns. With no pressing need to continue the attack to closer range, the torpedo boats fall back, noting the position for a night attack if Suvorov survives that long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                        "entry_id": "7b097499-a34b-389f-82fa-a0c21e6bcd7e",
                                        "glosses": [
                                            "Insistent, earnest, or persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1389d6cf-6b19-429a-aa31-dceb88224999",
                                                "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                                "text": "You are very pressing, Basil, but I am afraid I must go."
                                            },
                                            {
                                                "example_id": "d71e5190-35a5-473e-a068-49e76265321c",
                                                "sense_id": "d4f51ebb-290b-3c74-aaec-aa03af5dfcc1",
                                                "text": "He was pressing and persuasive."
                                            }
                                        ]
                                    }
                                ]
                            },
