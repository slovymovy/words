                    },
                    {
                        "form_id": "90a0b005-fe3f-4d4b-858e-9275faea248e",
                        "entry_id": "d0ae347e-cd66-3dda-8e37-b1077d44519f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Missetaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                        "entry_id": "d0ae347e-cd66-3dda-8e37-b1077d44519f",
                        "glosses": [
                            "verwerfliche Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d9f71c-ffb4-400b-8486-bbf7f91bbe57",
                                "sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                                "text": "Durch aufmerksame Nachbarn konnte die Polizei den Einbrecher direkt nach seiner Missetat fassen."
                            },
                            {
                                "example_id": "c9271110-7982-4c7f-ac00-d1e42564720f",
                                "sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                                "text": "„Er zähle etwas über dreißig Jahre, und sei sich keiner weiteren Missetat bewußt, als daß er die verheiratete Tochter seines Dienstherrn, dem er sich in Leibeigenschaft verkauft hatte, verführt und mitsamt ihrer Zofe, seiner eigenen Frau, entführt und in ein öffentliches Haus verschleppt habe.“"
                            },
                            {
                                "example_id": "1c2d1a57-ebb6-4c7a-8e7b-c42b08bd0343",
                                "sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                                "text": "„Zenobia stieg als erste aus; aber ich bemerkte als Folge der begangenen Missetat einen dicken großen Flecken an der auffälligsten Stelle meiner hellgrauen Samthose, der furchtbar aussehen mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79ad333f-5808-43b0-94a8-29b2d0875298",
                        "source_entry_id": "d0ae347e-cd66-3dda-8e37-b1077d44519f",
                        "source_sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                        "source_sense_description": "verwerfliche Handlung",
                        "target_lang_word": "misdeed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misdeed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                        "entry_id": "cb81d770-210a-38f3-97a7-abc61ccdb480",
                                        "glosses": [
                                            "That which was done that should not have been, ranging from any sin or moral offense to various degrees of crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d345cc99-bdae-4a40-b3ad-d09ab30d3750",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "The petty misdeeds of his youth came back to haunt him when he ran for political office and his character was smeared."
                                            },
                                            {
                                                "example_id": "7d90b864-53ab-423c-b7d8-aa3803e2a5e0",
                                                "sense_id": "d375b860-1d11-3786-8f86-4c9f3f210229",
                                                "text": "These [putting feet on seats and leaving rubbish behind] are officially among the worst habits revealed by staff working on Northern's trains and at stations. Other bugbears include playing music through loudspeakers, not giving way to passengers getting off the train and actually illegal activities such as fare evasion and vaping in enclosed spaces. The list of misdeeds was released by the operator on March 3 to coincide with Employee Appreciation Day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f96cf508-b459-442c-8aa8-7e90d45f4da1",
                        "source_entry_id": "d0ae347e-cd66-3dda-8e37-b1077d44519f",
                        "source_sense_id": "8a3f3c9c-a0b2-31b8-8f84-7b0f370590b8",
                        "source_sense_description": "verwerfliche Handlung",
                        "target_lang_word": "méfait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méfait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Mauvaise action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eadaa461-186d-48d8-907c-1841be80d8e2",
                                                "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                                "text": "Vers 1255, le bailli de Pont-Audemer, nommé Jean de Neuvy, était sous le poids des plus graves accusations, et parmi les nombreux méfaits qui lui étaient reprochés se trouvait l’impunité d'un assassinat commis sur un homme de Bourneville."
                                            },
                                            {
                                                "example_id": "b8600bad-d66e-4bcc-8c3b-21d74098a101",
                                                "sense_id": "aa7a7486-5d32-37c6-8c39-4238a7816da1",
                                                "text": "La reconnaissance d’un méfait constituerait déjà une petite victoire pour ceux et celles qui considèrent que l’homme n’a jamais pleinement payé le prix de ses frasques. Un argument fort en faveur d’un pardon réside dans son effet présumément unificateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383c1ec7-6c7f-36ce-8251-9856739787e2",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Acte criminel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c08cf9e-9237-3b1b-865d-9a253a99260a",
                                        "entry_id": "d7ed631d-9df5-3785-b35f-34f337b8a4e5",
                                        "glosses": [
                                            "Dégât, conséquence négative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5783d69-0c8e-412f-b282-113b02d93624",
                                                "sense_id": "1c08cf9e-9237-3b1b-865d-9a253a99260a",
                                                "text": "Je mentionne, en passant, les méfaits du micronationalisme."
                                            }
                                        ]
                                    }
