                "senses": [
                    {
                        "sense_id": "ea5e3dba-096f-397a-abdc-20b9a8d7cedf",
                        "entry_id": "2279eb9b-fceb-3fdc-b6ca-ad307ceb98cb",
                        "glosses": [
                            "zur Ablage in Ordnern vorgefertigtes Blatt mit Löchern"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "42bc0809-7a4b-42ab-aa10-24f165bc4008",
                                "sense_id": "ea5e3dba-096f-397a-abdc-20b9a8d7cedf",
                                "text": "„Während der Anfangsphase standen den Schülern nicht immer Briefbögen mit der Firma des Lernbüros zur Verfügung, so daß sie sich mit einfachem Schreibmaschinenpapier oder privaten Ringbucheinlagen helfen mußten.“"
                            },
                            {
                                "example_id": "b5fdaa41-ddac-481c-a728-c66a4b1daa99",
                                "sense_id": "ea5e3dba-096f-397a-abdc-20b9a8d7cedf",
                                "text": "„Ein Startpaket im billigsten Geschäft kostet 65 Euro, im teuersten sind es 287 Euro, und ein solches besteht aus Füllfeder, Tintenkiller, Bleistiften, Buntstiften, Federpennal, Filzstiften, Heften, Klebestift, Bastelschere, Zeichenblock, Deckweiß, Malfarben, Borstenpinsel, Radiergummi, Ringbucheinlagen, Ringmappe, Dosenspitzer, Wachskreiden, Sportbeutel, Schultasche und Handarbeitskoffer.“"
                            },
                            {
                                "example_id": "5d8520c6-ee5c-437b-8709-260c62383178",
                                "sense_id": "ea5e3dba-096f-397a-abdc-20b9a8d7cedf",
                                "text": "„Der frühere Werbekönig Bierhoff verteilt in der Mannschaft Ringbucheinlagen mit allen Geburtstagen, den Adressen der Sponsoren und mit Benimmregeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
