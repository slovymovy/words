                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad8fbf54-dd65-3f14-8bcd-2f7158b6a46d",
                        "entry_id": "83f4f4e8-e5c5-3312-8d75-de3411e04e99",
                        "glosses": [
                            "Action de dévoiler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd2efa0-538f-4511-88c6-68622bf9f393",
                                "sense_id": "ad8fbf54-dd65-3f14-8bcd-2f7158b6a46d",
                                "text": "— Le premier correspond à l’intrigue, dans laquelle on se laisse entraîner d'autant plus facilement que la feuilletonisation du récit est parfaitement maîtrisée grâce à un découpage et un rythme qui ménagent suspense, dévoilements et rebondissements."
                            },
                            {
                                "example_id": "51dc6a22-2163-4ee3-a3f5-560859bd4aba",
                                "sense_id": "ad8fbf54-dd65-3f14-8bcd-2f7158b6a46d",
                                "text": "À Super-Discount, une caissière jeune, peut-être remplaçante, rit avec des connaissances, deux filles debout près d’elle. Réprobation visible des clients de la file. On voit clairement qu’elle n’a rien à faire de nous, elle tape les produits, un point c’est tout. On lui en veut de ce dévoilement."
                            },
                            {
                                "example_id": "cdda5ccc-cb00-42c5-b816-71f4d50737be",
                                "sense_id": "ad8fbf54-dd65-3f14-8bcd-2f7158b6a46d",
                                "text": "À l’école de Novokouznetsk, les élèves ont assisté au dévoilement d’une plaque commémorative en l’honneur d’un ancien élève, mort quelques jours après avoir été envoyé sur le front."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c6780de-9bdd-4d12-8a2c-98c7969d7b69",
                        "source_entry_id": "83f4f4e8-e5c5-3312-8d75-de3411e04e99",
                        "source_sense_id": "ad8fbf54-dd65-3f14-8bcd-2f7158b6a46d",
                        "target_lang_word": "onthulling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onthulling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75b2f637-3440-30bd-a652-b9fb23b22b2a",
                                        "entry_id": "67ee1fef-117b-31c9-9e06-425ce40e8067",
                                        "glosses": [
                                            "bekend maken wat eerst verborgen was"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6e0895-d3b6-4c15-95e9-5b908a87c9d3",
                                                "sense_id": "75b2f637-3440-30bd-a652-b9fb23b22b2a",
                                                "text": "De onthulling van het straatbord werd wegens de pandemie twee jaar uitgesteld. Naast het naambord werd ook het kunstwerk, met daarop de tekst 'Ik heb je lief', voor het eerst getoond. Dat is een zin uit de tekst van het beroemde nummer Pastorale, dat List samen met Ramses Shaffy zong."
                                            },
                                            {
                                                "example_id": "f86e8a1e-636b-4fe7-91ff-333dca21bcb1",
                                                "sense_id": "75b2f637-3440-30bd-a652-b9fb23b22b2a",
                                                "text": "Maar deze week tegen het eind van maart, toen alle anderen het alleen maar over autodiefstallen hadden in de pauze, kwam Joar met de geweldigste onthulling tot nu toe."
                                            },
                                            {
                                                "example_id": "a68295bb-b865-4d4e-938e-a827d7e569e5",
                                                "sense_id": "75b2f637-3440-30bd-a652-b9fb23b22b2a",
                                                "text": "Tijdens het grote feest was er de onthulling van het nieuwe standbeeld."
                                            },
                                            {
                                                "example_id": "8c5fad3a-50fa-41e2-9e26-6e50c01276dc",
                                                "sense_id": "75b2f637-3440-30bd-a652-b9fb23b22b2a",
                                                "text": "De onthulling van de foto is voor Falcke een grote opluchting. ‘We hebben hier 25 jaar op gewacht. En toen ik eindelijk wist wat eruit kwam, mocht ik er niet over praten. Nu is het openbaar en is deze foto niet meer van ons alleen, maar van iedereen’, laat hij aan de telefoon weten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
