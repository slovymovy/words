                                        "entry_id": "88ea2a98-5a8b-3aeb-a8ca-e76c11364190",
                                        "glosses": [
                                            "The process of giving birth; pregnancy and parturition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249bb0c7-928b-4cb0-97ba-d8659567b9d5",
                                                "sense_id": "c3bd357b-a8b8-380c-b271-d2cac053e117",
                                                "text": "From the Swedish returns (1776-1855) it appears that 100 childbearings produced 101.62 children, viz., 2.82 stillborn, 98.80 quickborn; consequently 100 quickborn children imply 101.21 childbearings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "childbearing",
