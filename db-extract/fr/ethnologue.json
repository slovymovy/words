                                            {
                                                "example_id": "87a7348c-675b-4f8a-83ed-ef2e3d5881fe",
                                                "sense_id": "d028e491-958f-34b9-93cc-83e91e974f5e",
                                                "text": "„Wir befinden uns auf der Insel Corisco, wo die britische Ethnologin Mary Kingsley 1895 von dem Segelkutter Lafayette an Land geht.“"
                                            }
