                        "sense_id": "81e2e987-4240-3300-90b4-9441faebc97a",
                        "entry_id": "cd8fc21e-b60e-3a85-83c2-114b54f53ae2",
                        "glosses": [
                            "действие по значению гл. колыхать, колыхаться; лёгкое, мерное колебание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0d259c-3899-4d14-88a8-eed2a79a0f1b",
                                "sense_id": "81e2e987-4240-3300-90b4-9441faebc97a",
                                "text": "Весенняя капель, скрип тормозов, колыхание листьев на ветру — все это, в той или иной степени, музыка."
                            }
                        ]
                    }
                ],
                "translations": [
