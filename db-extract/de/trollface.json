                "senses": [
                    {
                        "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                        "entry_id": "58524423-aee4-3507-858f-40b333ad6993",
                        "glosses": [
                            "Bild eines gezeichneten Gesichtes mit einem sehr breiten Grinsen, einem leicht nach rechts geöffneten Mund, zusammengekniffenen Augen und zahlreichen Falten; Visualisierung eines Trolls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16a98be-32da-4d65-86bf-bcb581a5e1f5",
                                "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                                "text": "Ich habe ihm gestern ein Trollface geschickt."
                            },
                            {
                                "example_id": "59b34bde-7706-4413-8f3d-e3324ee3d691",
                                "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                                "text": "Dieser Blick, diese Wangen, diese Zähne: Das sogenannte Trollface hat fast jeder Internetnutzer schon einmal gesehen."
                            },
                            {
                                "example_id": "360f0445-6226-4317-ba58-b08d3f3c5b8f",
                                "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                                "text": "Ein Trollface kann meinen: „Gibt es ein Problem?“"
                            },
                            {
                                "example_id": "1884123f-15db-494e-8f0e-38a3765c659f",
                                "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                                "text": "Das Trollface wurde seit seiner ersten Veröffentlichung im Jahre 2008 zu einem wahren Internetphänomen, es ist ein sogenanntes Meme. Dies sind meistens Bilder oder Fotos, denen ein Text hinzugefügt wird und die dadurch einen neuen oder ganz anderen Inhalt bekommen."
                            },
                            {
                                "example_id": "77496028-9c9c-493e-b287-b10b7ce4d87a",
                                "sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                                "text": "Das Trollface hat ein Copyright."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "402a11fe-b212-4742-8ab0-1660a5dc54eb",
                        "source_entry_id": "58524423-aee4-3507-858f-40b333ad6993",
                        "source_sense_id": "db9d1076-af57-32b0-af3b-313aeaa14687",
                        "target_lang_word": "trollface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trollface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c67bf392-ff37-339d-888b-30f7d14709d9",
                                        "entry_id": "05283748-39cc-3b0f-bfca-aab5587b9758",
                                        "glosses": [
                                            "An ugly, unpleasant, or otherwise objectionable person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd29e2d-f495-4c31-a584-4dcc51167b1f",
                                                "sense_id": "c67bf392-ff37-339d-888b-30f7d14709d9",
                                                "text": "You brought them home, old trollface, but you did it your own way, not mine."
                                            },
                                            {
                                                "example_id": "a956ba8e-3295-4003-bc5d-0ba12fb14b90",
                                                "sense_id": "c67bf392-ff37-339d-888b-30f7d14709d9",
                                                "text": "\"Hi, dollface,\" he said to me.\n\"Hi, trollface,\" Tracy answered for both of us."
                                            },
                                            {
                                                "example_id": "331dfca0-2ef8-4618-9139-97c400032dbc",
                                                "sense_id": "c67bf392-ff37-339d-888b-30f7d14709d9",
                                                "text": "\"Hey, I'm sure Mrs. Trollface has some horror lined up for me, too. We can have detention together.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trollface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03e30d2a-2f28-33d0-bcbd-1e3941e7cc08",
                                        "entry_id": "482555cd-e646-32ba-bb9a-d5431305175c",
                                        "glosses": [
                                            "An illustration of a face with a cartoonishly wide, maniacal grin (from a comic drawn by Carlos Ramirez and originally posted on the 4chan community), typically featured in image macros to convey trolling, mockery, or humorous intent."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507e17a3-3da0-4170-b793-5b2967eef1a6",
                                                "sense_id": "03e30d2a-2f28-33d0-bcbd-1e3941e7cc08",
                                                "text": "Geek revelers. This is a very rare antagonism. Maybe it doesn't even exist. But if it exists, Gigablog leaves here a fantasy tip. Carnatroll is a mask with the face of the most famous meme on the internet, the Trollface."
                                            },
                                            {
                                                "example_id": "59c6f9eb-cbbe-4957-a82b-afe476b6531f",
                                                "sense_id": "03e30d2a-2f28-33d0-bcbd-1e3941e7cc08",
                                                "text": "Thanks to the Trollface meme, those with a secret affinity for the hilarious ways of trolling now have a figure to worship."
                                            },
                                            {
                                                "example_id": "9e402956-cce2-4674-bdec-fd977e2e1f12",
                                                "sense_id": "03e30d2a-2f28-33d0-bcbd-1e3941e7cc08",
                                                "text": "People took trollface and pasted it into other comics, whenever a character was either being a pest or generally annoying people."
                                            },
                                            {
                                                "example_id": "8af6bb49-74f4-4510-b7a4-0539f2ad8f10",
                                                "sense_id": "03e30d2a-2f28-33d0-bcbd-1e3941e7cc08",
                                                "text": "The trollface is a visual representation of what someone might look like when engaging in trolling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
