                                "target_senses": [
                                    {
                                        "sense_id": "a439725d-424b-3b1c-bccc-bfe52fb044d9",
                                        "entry_id": "ff6b88be-8ee0-3944-8294-33caccd33089",
                                        "glosses": [
                                            "A female given name from Old English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b539298-ea41-48cb-9026-a3bd205b9718",
                                                "sense_id": "a439725d-424b-3b1c-bccc-bfe52fb044d9",
                                                "text": "Queens drop away, while blue-legg'd Maukin lives; / Drones thrive when bees are burnt within their hives; / And courtly Mildred dies, while country Madge survives."
                                            },
                                            {
                                                "example_id": "520d0918-0b64-4921-978b-1daa033f3de9",
                                                "sense_id": "a439725d-424b-3b1c-bccc-bfe52fb044d9",
                                                "text": "One day Dunsford told him her name was Mildred. He had heard one of the other girls in the shop address her. \"What an odious name,\" said Philip. \"Why?\" asked Dunsford. \"I like it.\" . \"It's so pretentious.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
