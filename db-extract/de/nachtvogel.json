                                    {
                                        "sense_id": "1a4e0d84-540c-34ab-9165-eb32a5c3b41b",
                                        "entry_id": "7d1b7196-c5b6-3e52-8d8d-a34d94dbb989",
                                        "glosses": [
                                            "aanduiding voor vogels (Aves) uit soorten die overdag slapen en in de schemering of nacht actief zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6de8164-ffef-4692-9a50-607b0ea8d864",
                                                "sense_id": "1a4e0d84-540c-34ab-9165-eb32a5c3b41b",
                                                "text": "Ergens in de verte kraste een nachtvogel."
                                            },
                                            {
                                                "example_id": "d62ed22b-3b11-4db3-867d-7a17551ab885",
                                                "sense_id": "1a4e0d84-540c-34ab-9165-eb32a5c3b41b",
                                                "text": "De kleine uil, met bruine en witte vleugels en grote goudkleurige ogen, is al meer dan een eeuw verward met een vergelijkbare soort. Maar wetenschappers uit Zweden en de VS die op het eiland onderzoek deden naar een andere nachtvogel, ontdekten min of meer bij toeval de aparte fluittoon van deze uil, die beduidend verschilt van zijn soortgenoten."
                                            }
                                        ]
                                    }
