                "senses": [
                    {
                        "sense_id": "791e0453-bf43-3eca-b219-65dd97e30e2b",
                        "entry_id": "15c41332-19d3-34f1-b54e-961911d6c7f6",
                        "glosses": [
                            "Partie inférieure d’une construction sur laquelle porte l’édifice et qui porte elle-même sur les fondations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d51c584-e0bc-49d3-b568-b4c4727dc09b",
                                "sense_id": "791e0453-bf43-3eca-b219-65dd97e30e2b",
                                "text": "Ce soubassement est intact, […], les parties inférieures du monument sont restées enterrées pendant des siècles et ont été ainsi préservées des mutilations."
                            },
                            {
                                "example_id": "1f174cb2-a962-476e-aca0-72f93e739247",
                                "sense_id": "791e0453-bf43-3eca-b219-65dd97e30e2b",
                                "text": "L'autre porte en bois, vermoulue, disjointe, s'encastrait dans les soubassements de cette partie de l'hôtel et ouvrait sur un escalier aboutissant à une cave où l'on avait entassé toutes sortes de vieux meubles inutiles."
                            }
                        ]
                    },
                    {
                        "sense_id": "700cfc2b-97b3-3be7-a89d-02ee055f40f4",
                        "entry_id": "15c41332-19d3-34f1-b54e-961911d6c7f6",
                        "glosses": [
                            "Socle rocheux sur lequel reposent les couches de terrain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ec83df2-9368-3506-9250-781bb3e1fa9d",
                        "entry_id": "15c41332-19d3-34f1-b54e-961911d6c7f6",
                        "glosses": [
                            "Base, fondement, socle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
