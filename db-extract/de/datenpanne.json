                ],
                "senses": [
                    {
                        "sense_id": "6705c73f-dcc0-3529-b6b9-298f7c53c019",
                        "entry_id": "c8c8f9da-9b19-3a63-8301-12d0bf9a7c0f",
                        "glosses": [
                            "ungewolltes Ereignis in einem Unternehmen oder einem Amt, durch das vertrauliche Daten öffentlich einsehbar werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d99cb92-ebd3-458c-8898-c154ae7a2a7c",
                                "sense_id": "6705c73f-dcc0-3529-b6b9-298f7c53c019",
                                "text": "Am 19. Oktober 2009 ist eine Datenpanne bekannt geworden, bei der Kreditkartennummern der Karstadt-MasterCards von KarstadtQuelle-Bank-Kunden gestohlen wurden."
                            },
                            {
                                "example_id": "0300e530-b500-48fe-bccc-66dcb0de8c1f",
                                "sense_id": "6705c73f-dcc0-3529-b6b9-298f7c53c019",
                                "text": "Der Hamburger Datenschutzbeauftragte, Johannes Caspar, sagte dem Südwestrundfunk: „Ich halte die Datenpanne schon für ziemlich schwerwiegend, die von den Ausmaßen ziemlich erschreckend ist.“"
                            },
                            {
                                "example_id": "fc8df349-53f8-4eba-82b8-b198dd4cac03",
                                "sense_id": "6705c73f-dcc0-3529-b6b9-298f7c53c019",
                                "text": "Die Serie von Datenpannen bei der Deutschen Telekom reißt nicht ab: Hunderttausende Datensätze, darunter auch Bankverbindungen, sollen über Vertriebspartner des Unternehmens unter anderem in die Türkei gelangt sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88a33484-3621-486d-b640-7667fcb2fb61",
                        "source_entry_id": "c8c8f9da-9b19-3a63-8301-12d0bf9a7c0f",
                        "source_sense_id": "6705c73f-dcc0-3529-b6b9-298f7c53c019",
                        "source_sense_description": "ungewolltes Ereignis in großen Organisationen, durch das vertrauliche Daten öffentlich einsehbar werden",
                        "target_lang_word": "data leak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "data leak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c05c01cf-ed1b-3fde-a60d-2303ebeb9cd7",
                                        "entry_id": "20a672d5-b23c-39ee-81f4-75ad38cc1515",
                                        "glosses": [
                                            "Accidental exposure of sensitive data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca41e7fd-7d02-4d84-bcf0-2b80ed5e7613",
                                                "sense_id": "c05c01cf-ed1b-3fde-a60d-2303ebeb9cd7",
                                                "text": "The parallel was not lost on Google, and the company chose not to disclose the data leak, the Wall Street Journal revealed Monday, in order to avoid the public relations headache and potential regulatory enforcement."
                                            },
                                            {
                                                "example_id": "65f6aa28-1243-4328-a3e0-364e13ed56ef",
                                                "sense_id": "c05c01cf-ed1b-3fde-a60d-2303ebeb9cd7",
                                                "text": "One phone that has contained signs of Pegasus activity belonged to our esteemed Mexican colleague Carmen Aristegui, whose number was in the data leak and who was targeted following her exposé of a corruption scandal involving her country’s former president Enrique Peña Nieto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
