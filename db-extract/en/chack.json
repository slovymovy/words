                    }
                ],
                "translations": [
                    {
                        "translation_id": "42070d01-89c4-4eb5-97f5-f5ca32f4e76a",
                        "source_entry_id": "d348f9d0-c399-3ce3-8189-a13fba31ba72",
                        "source_sense_id": "6ac2615b-5ad0-3e35-b0eb-c136ea84411a",
                        "source_sense_description": "(Jamaica): genau, im Ganzen, ganz",
                        "target_lang_word": "genau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                        "entry_id": "31930962-bc1d-3852-bf69-caecc075b285",
                                        "glosses": [
                                            "gründlich und sorgfältig, was das Einhalten von selbstgesetzten oder fremden Regeln betrifft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06f021e0-4200-4e08-97cb-36a2bf91409a",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "Sie ist in Geldangelegenheiten sehr genau."
                                            },
                                            {
                                                "example_id": "4c849695-fe14-4276-a406-3e317b5be98c",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "Sie müssen genau haushalten."
                                            },
                                            {
                                                "example_id": "edc155ce-a8ce-46c5-b051-8479b1cf3cb6",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "Er nimmt es mit dem Geld nicht so genau."
                                            },
                                            {
                                                "example_id": "8b011417-086c-48ce-9e88-4a43d7054d0a",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "„Eure Befehle sollen schnell und genau befolgt werden.“ _(Goethe)"
                                            },
                                            {
                                                "example_id": "5b09e397-2d0c-41f0-aec7-60cca2965d2d",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "Er war genau im Reden und Handeln und forderte das gleiche von andern."
                                            },
                                            {
                                                "example_id": "a39ce6cb-332f-4879-84b0-569cff452a30",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "„Zwei Wochen Olympia in Rio. Man sollte, man muss da sehr genau hinsehen.“"
                                            },
                                            {
                                                "example_id": "64d79740-825e-48f9-9067-44e6cd222488",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "„Doch bei genauerer Betrachtung bleibt sie auch damit sich selbst treu.“"
                                            },
                                            {
                                                "example_id": "bb740da8-d538-423c-b35e-30d9eed21057",
                                                "sense_id": "5f337501-4fa4-3238-b5d0-bb3d20c47249",
                                                "text": "Also, der nimmt's jetzt zu genau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                        "entry_id": "31930962-bc1d-3852-bf69-caecc075b285",
                                        "glosses": [
                                            "um nichts abweichend; exakt zutreffend; auf den Punkt exakt so"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4bd49d-f35e-4643-b78a-dbe309c8c114",
                                                "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                                "text": "Also, der nimmt's jetzt zu genau."
                                            },
                                            {
                                                "example_id": "d17f81e8-2e49-46e5-9475-2068d8b55e8b",
                                                "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                                "text": "Mir ist genau wie dir."
                                            },
                                            {
                                                "example_id": "7274d076-b495-48bd-8baa-45562b89faed",
                                                "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                                "text": "Das ist genau mein Fall."
                                            },
                                            {
                                                "example_id": "6b48d474-71cd-4395-aad9-3914acc6b918",
                                                "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                                "text": "Eine Rechnung stimmt genau, wenn der Nachrechnende ebenso zu demselben Ergebnis kommt."
                                            },
                                            {
                                                "example_id": "e49a6128-c918-4b73-b0ce-44ccba9f0e23",
                                                "sense_id": "c239dc20-2500-323f-8352-4c0f94e3262f",
                                                "text": "Das Wasser ist an dieser Stelle genau 3 Meter tief."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "genau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d85f28fa-30bf-355d-8295-5fa2e9c3231a",
                                        "entry_id": "fd2703ad-eb5b-3144-838c-ec7d1c6f9396",
                                        "glosses": [
                                            "Zustimmung ausdrückend, die Aussage oder Frage bestätigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d476d435-c32f-4613-a7d9-ee569cc9c170",
                                                "sense_id": "d85f28fa-30bf-355d-8295-5fa2e9c3231a",
                                                "text": "„Deine Freundin ist doch erst sechzehn!“ „Genau!“"
                                            },
                                            {
                                                "example_id": "50833907-782c-4f9c-8b27-cc324de890d9",
                                                "sense_id": "d85f28fa-30bf-355d-8295-5fa2e9c3231a",
                                                "text": "„Und du willst alleine in den Urlaub fahren?“ „Genau!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "508f669d-c16a-3952-80ba-76b88b17db34",
                                        "entry_id": "fd2703ad-eb5b-3144-838c-ec7d1c6f9396",
                                        "glosses": [
                                            "Füllwort zur Selbstbestätigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8243536d-f96d-468a-a185-17bbcfa972a3",
                                                "sense_id": "508f669d-c16a-3952-80ba-76b88b17db34",
                                                "text": "„Gleich muss ich noch die Tasche packen und dann kann es losgehen … genau.“"
                                            },
                                            {
                                                "example_id": "01a1a6f3-d7b6-44ff-877e-f98567fc4e8d",
                                                "sense_id": "508f669d-c16a-3952-80ba-76b88b17db34",
                                                "text": "„Genau, meine Damen und Herren! Ich freue mich sehr, dass Sie heute Abend alle hier versammelt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a65c9c2e-473b-4906-96c1-f94c63c0be4f",
                        "source_entry_id": "d348f9d0-c399-3ce3-8189-a13fba31ba72",
                        "source_sense_id": "6ac2615b-5ad0-3e35-b0eb-c136ea84411a",
                        "source_sense_description": "(Jamaica): genau, im Ganzen, ganz",
                        "target_lang_word": "im Ganzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "im Ganzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                        "entry_id": "8c85c287-3d40-36dc-bd8d-55b87549d745",
                                        "glosses": [
                                            "nicht in Scheiben (oder andere Teile) geschnitten"
                                        ],
                                        "tags": [
                                            "Wurst",
                                            "Fleisch",
                                            "Käse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8626de35-321f-404b-b53e-f766b340953d",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Für das Füllen von 5 Sacherwürsteln benötigt man 1 Stück Emmentaler im Ganzen (ca. 10 dag) und 4–5 lange Speckstreifen pro Sacherwürstel.“"
                                            },
                                            {
                                                "example_id": "8593e6f3-fbd7-4c4a-b1a7-b6603f2cb763",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Ich bin der Wurst als Nahrungsmittel hoffnungslos verfallen, aber sie war für mich immer schon viel mehr als etwas, das scheibchenweise aufs Brot oder im Ganzen auf den Teller kommt.“"
                                            },
                                            {
                                                "example_id": "9178cb82-6821-4519-875d-b9390e4339e3",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Dann aber im Ganzen belassen und nur bei Bedarf die gewünschte Anzahl Scheiben abschneiden.“"
                                            },
                                            {
                                                "example_id": "c5dc1a9c-a17b-4ec0-9ca0-7a707f8ce50a",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Den Schinken im Ganzen auf den Tisch stellen.“"
                                            },
                                            {
                                                "example_id": "cf6a892d-77ce-4d1d-ade5-ba29ffd952bc",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Die Unterscheidung zwischen Schinken im ganzen und im Ausschnitt besteht seit 1910.“"
                                            },
                                            {
                                                "example_id": "93e8211b-eb5d-467b-83ee-53cd69d56ed8",
                                                "sense_id": "83293edb-9e34-36ea-9807-01138a97ddfc",
                                                "text": "„Das Poularde oder der Kapaun wird abflammiert, abgeklaubt, von den Stifteln gereinigt, inwendig ausgewaschen, gesalzt, zierlich dressirt, und in einer öfter beschriebenen Braise gehörig weich gesotten, im Ganzen oder in 6 Theile zerschnitten angerichtet, und eine von den schon beschriebenen Saucen, mit Beobachtung der Jahreszeit, dazu gefügt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "674854e7-d4a8-41c2-91ce-58e67de5a82e",
                        "source_entry_id": "d348f9d0-c399-3ce3-8189-a13fba31ba72",
                        "source_sense_id": "6ac2615b-5ad0-3e35-b0eb-c136ea84411a",
                        "source_sense_description": "(Jamaica): genau, im Ganzen, ganz",
                        "target_lang_word": "ganz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ganz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d84259a-938e-3ad5-9432-34d498dd5ea2",
                                        "entry_id": "126f8e36-8138-3004-b9b9-83357faa5e3a",
                                        "glosses": [
                                            "nicht zerbrochen, unversehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5870dc03-783a-4535-b691-b5e15a59757b",
                                                "sense_id": "1d84259a-938e-3ad5-9432-34d498dd5ea2",
                                                "text": "So, mein Hans, so, mein Hans, bist du wieder ganz! – (Variante von Hänschen klein)"
                                            },
                                            {
                                                "example_id": "699107cb-a9cf-4b73-ad87-3d33bd3dc9d5",
                                                "sense_id": "1d84259a-938e-3ad5-9432-34d498dd5ea2",
                                                "text": "Obwohl die Vase auf den Boden gefallen ist, ist sie noch ganz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c9e3b19-48da-3369-92a0-a6a1fe302213",
                                        "entry_id": "126f8e36-8138-3004-b9b9-83357faa5e3a",
                                        "glosses": [
                                            "alles davon, nicht nur ein Teil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabe6cc5-a428-4f85-bc3b-32a61df9a8be",
                                                "sense_id": "9c9e3b19-48da-3369-92a0-a6a1fe302213",
                                                "text": "Er hat die Welt in nur 80 Tagen ganz umrundet."
                                            },
                                            {
