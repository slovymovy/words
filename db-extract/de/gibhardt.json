                ],
                "senses": [
                    {
                        "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                        "entry_id": "0454c665-2ee5-3dab-bc1a-21f840495f70",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd58759-92a7-4a3b-b141-6e6de2d5bf74",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Frau Gibhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5c743977-f376-45e6-bce4-bf741f999ba7",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Herr Gibhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "10140552-2e29-41c5-871c-a8046f2a8d2d",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Die Gibhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "400df918-ea4b-4587-81b2-e85dfeac975a",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Der Gibhardt trägt nie die Schals, die die Gibhardt ihm strickt."
                            },
                            {
                                "example_id": "8056b22f-eb1b-4a60-a045-db51f4b08bcf",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gibhardt kommt, geht der Herr Gibhardt.“"
                            },
                            {
                                "example_id": "fa0efc35-ce76-4e98-8b57-2dd775077210",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Gibhardt kommt und geht."
                            },
                            {
                                "example_id": "2ec31644-876c-437f-a71e-e2f51c9b0d76",
                                "sense_id": "018c8914-6a8c-3284-9eba-bf37096a7a83",
                                "text": "Gibhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
