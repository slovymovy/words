                "senses": [
                    {
                        "sense_id": "255ec304-ca8d-3b20-8c57-afd8e15f6dc4",
                        "entry_id": "a5f5a843-a3e3-3346-8a9f-c01407eb30c4",
                        "glosses": [
                            "durch ein Ereignis oder einen Umstand verursachte Beeinträchtigung eines Motors; Beschädigung oder Defekt eines Motors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ecedeb-e6c2-414b-8348-fc42fc058b50",
                                "sense_id": "255ec304-ca8d-3b20-8c57-afd8e15f6dc4",
                                "text": "„Er schaut den Patienten interessiert an, doch so, wie ein Mechaniker ein Auto betrachtet, das einen Motordefekt hat.“"
                            },
                            {
                                "example_id": "03007430-3fd3-467d-a84d-26064ea62204",
                                "sense_id": "255ec304-ca8d-3b20-8c57-afd8e15f6dc4",
                                "text": "„Ein Motordefekt am zweiten Fahrzeug brachte eine erneute Verzögerung, doch gelang es einigen Chauffeuren, diesen zu beheben und den Wagen wieder fahrtüchtig zu machen.“"
                            },
                            {
                                "example_id": "821c3b40-fb34-4864-b2d5-6e7b66f6832f",
                                "sense_id": "255ec304-ca8d-3b20-8c57-afd8e15f6dc4",
                                "text": "„Wir beschlossen daher sofort, zwei Maschinen zu benutzen, damit der Flug mit einer Maschine fortgesetzt werden könnte, für den Fall, daß die andre Maschine einen Motordefekt bekäme, der nicht ausgebessert werden konnte.“"
                            },
                            {
                                "example_id": "48c56c77-1d1d-44be-9a31-acceb72c856e",
                                "sense_id": "255ec304-ca8d-3b20-8c57-afd8e15f6dc4",
                                "text": "„Immer wieder lehnten die Pfadfinder ein großes rotes A gegen eine der Nummern, wenn ein Motordefekt, ein Zusammenstoß oder Headlong Corner ein neues Opfer gefordert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
