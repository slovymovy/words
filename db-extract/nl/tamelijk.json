                                        "glosses": [
                                            "im Vergleich zu Anderem deutlich mehr, sehr, in großem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de809eeb-107d-4d03-b6ad-2a1d5c301a18",
                                                "sense_id": "311bd707-cd65-305b-947f-1af2e4bd15ca",
                                                "text": "Das war schon eine ziemlich herbe Enttäuschung, als wir unsere Teilnahme zurückziehen mussten."
                                            },
                                            {
                                                "example_id": "1c2f0823-272c-456c-aaa2-52457beb0cde",
                                                "sense_id": "311bd707-cd65-305b-947f-1af2e4bd15ca",
                                                "text": "Da wurde ziemlich wenig umgesetzt."
                                            },
                                            {
                                                "example_id": "d0879fbc-f5ab-4e7b-81db-551d497fcf3a",
                                                "sense_id": "311bd707-cd65-305b-947f-1af2e4bd15ca",
                                                "text": "Der Regen ist ziemlich stark."
                                            }
                                        ],
