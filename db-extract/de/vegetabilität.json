                ],
                "senses": [
                    {
                        "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                        "entry_id": "fb8b7e0d-be78-3de7-bafb-afe69e2835b9",
                        "glosses": [
                            "Eigenschaft/Kraft, die pflanzliche (vegetabile, vegetabilische), grundlegende (vegetative) Aspekte vorweist; gemeint ist einfache Lebendigkeit im Gegensatz zu (entwickelteren Stufen wie) Animalität und Humanität"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c8b9c1-c6c2-4e3e-bbd9-a9e80b9bba73",
                                "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                                "text": "„Vegetabilität und Sensibilität verhalten sich zu einander nur, wie Venerisches und Besonderes an einer und derselben Sache, indem die Vegetabilität Lebendigkeit im Allgemeinen, Sensibilität die besondere Modalität des Lebendigseins ausdrückt.“ (1861)"
                            },
                            {
                                "example_id": "e6bde86c-da37-4e79-8a1e-1b549c7bd89c",
                                "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                                "text": "„Um die Kraft, welche Mineral, Pflanze und Thier, und zwar Jedes eigens zum Organismus macht, um die Mineralität, Vegetabilität und Animalität der Organismen, als um dieses Entstehen, Sichentwickeln und Sichselbsterhalten von Mineral, Pflanze und Thier, wird es also nunmehr zu thun sein.“ (1875)"
                            },
                            {
                                "example_id": "8dc27d36-b259-45f5-b7a3-1bbcb3874837",
                                "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                                "text": "„Die den gröbern Boden des Somatischen durchwaltende Grundkraft spricht sich als Vegetabilität aus.“ (1833)"
                            },
                            {
                                "example_id": "fb5eb890-a755-47fb-857f-b80de0e50f1a",
                                "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                                "text": "„Vegetabilität und Animalität sind die großen Geschlechter der organischen Natur: in der Vegetabilität erscheint ein irdisches mütterliches Leben; in der Animalität ist die Offenbarung des himmlischen, väterlichen Lebens.“ (1826)"
                            },
                            {
                                "example_id": "d4b7ffad-9610-45a0-a418-d01287d119da",
                                "sense_id": "2cf7ea16-9615-3789-ae5a-3018b035450d",
                                "text": "„Jene nicht etwa ein bloßer Abkömmling der letzteren, hat vielmehr ihren Ursprung, ihre niedrigste Stufe ganz nahe an der Seite der vegetabilischen, und die Animalität ist daher nicht etwa nur eine erhöhte und veredelte Vegetabilität.“ (1809)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
