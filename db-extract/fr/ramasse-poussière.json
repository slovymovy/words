                        "glosses": [
                            "Petite pelle pour ramasser la poussière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d36e005-1e62-49d4-bbd1-fc29985e6ef7",
                                "sense_id": "c30b29ba-2991-3251-9a2b-dcbc608e3b35",
                                "text": "Où sont la balayette et le ramasse-poussière ?"
                            },
                            {
                                "example_id": "668a12c8-5bcc-4152-ad84-b91f5130946b",
                                "sense_id": "c30b29ba-2991-3251-9a2b-dcbc608e3b35",
                                "text": "Pauvre Rosalie ! elle glisse dans l’antichambre sur le ramasse-poussière d’Ernestine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c717f5aa-a34a-3ec2-b3d1-7e322006be77",
                        "entry_id": "8db956fc-4a2b-356d-914d-35326ecc1690",
                        "glosses": [
                            "Objet inutile, dont l’unique objet est d’accumuler la poussière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd0781b-4a20-4172-b7f3-159b78c5032b",
                                "sense_id": "c717f5aa-a34a-3ec2-b3d1-7e322006be77",
                                "text": "Je n’ai qu’une envie, c’est de bazarder ta collection de ramasse-poussières."
                            },
                            {
                                "example_id": "579bb90a-6a89-4907-84e4-001d2035b6d1",
                                "sense_id": "c717f5aa-a34a-3ec2-b3d1-7e322006be77",
                                "text": "Rien à voir pourtant avec l’horloge comtoise, une treurie dont on s’était débarrassé avec plaisir au profit de mes parents, déjà amateurs de ces ramasse-poussière de dans le temps."
                            }
                        ]
                    }
                ],
