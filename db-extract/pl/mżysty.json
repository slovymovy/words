                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ae489e-c14c-424e-bf5b-b6604daee036",
                                                "sense_id": "0ff9768d-5d30-36ae-926c-fd126b13cbde",
                                                "text": "Thursday, January 21, was a miserable, wet, drizzly day; the thaw started fairly rapidly and transport began to move again."
                                            },
                                            {
                                                "example_id": "1ccf1403-cccc-49a9-bc6f-f0238462f55a",
                                                "sense_id": "0ff9768d-5d30-36ae-926c-fd126b13cbde",
                                                "text": "On a drizzly mid-January evening, I stood at the arches of the wall of Buda Castle, overlooking the Danube and the 19th-century Chain Bridge that links Buda with Pest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
