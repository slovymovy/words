                                            {
                                                "example_id": "d5190efa-afec-4c28-ac46-afc3cc323d20",
                                                "sense_id": "1f76943c-21e4-347e-bed7-a7aa4764d755",
                                                "text": "Aby Warburg (1866-1929) wordt vaak genoemd als een van de grondleggers van de kunsthistorische wetenschap én als een van de bedenkers van de iconografie, de studie naar de inhoud en betekenis van een kunstwerk."
                                            }
