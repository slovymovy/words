                "senses": [
                    {
                        "sense_id": "9019c8ba-2415-3c9f-9736-37264210f9ce",
                        "entry_id": "db9ec662-0f4b-3522-a6d3-fb67fcc0e295",
                        "glosses": [
                            "een concrete figuur waarmee een abstract begrip zoals een natie, een ideaal, een gevoel enz. wordt verbeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bef9e32-4a0d-4f40-8c92-d911dc6128e7",
                                "sense_id": "9019c8ba-2415-3c9f-9736-37264210f9ce",
                                "text": "Een duif is het zinnebeeld van \"de vrede\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbbd176-8a94-4fae-bc17-ad5eadc46de8",
                        "source_entry_id": "db9ec662-0f4b-3522-a6d3-fb67fcc0e295",
                        "source_sense_id": "9019c8ba-2415-3c9f-9736-37264210f9ce",
                        "source_sense_description": "concrete figuur voor een abstract begrip",
                        "target_lang_word": "Symbol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Symbol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51b66045-33e6-3121-a623-bd8b6d2ff3b0",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "stellvertretende, vereinfachte Darstellung eines Objekts oder Sachverhalts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0297de3b-00af-4b33-9a0a-b60e19954d00",
                                                "sense_id": "51b66045-33e6-3121-a623-bd8b6d2ff3b0",
                                                "text": "Jeanne d'Arc war ein Symbol des französischen Widerstands."
                                            },
                                            {
                                                "example_id": "ae9a2a3b-64bf-4974-b292-61cb89bcb34e",
                                                "sense_id": "51b66045-33e6-3121-a623-bd8b6d2ff3b0",
                                                "text": "„Daß die Staatsform der Demokratie keiner Zeremonien und Symbole bedürfe - diese Ansicht galt in der Bonner Republik über Jahrzehnte hinweg als unausgesprochene Maxime."
                                            },
                                            {
                                                "example_id": "a1ed5897-da77-4e64-aa49-aedef70e33cd",
                                                "sense_id": "51b66045-33e6-3121-a623-bd8b6d2ff3b0",
                                                "text": "„Als Tom sein Büro erreicht hatte und sich in seinen Bürosessel fallen ließ, blinkte das Symbol für eingegangene E-Mails auf dem Monitor auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24530c39-dc71-3975-9ad3-3703555c6bcb",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "kleines Bild auf der Benutzeroberfläche, das zum Beispiel angeklickt werden kann, um ein Programm zu starten"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b948b30-8ea1-4e0f-bdcf-4a2569a66152",
                                                "sense_id": "24530c39-dc71-3975-9ad3-3703555c6bcb",
                                                "text": "Wenn ich auf dieses Symbol klicke, öffne ich die Textverarbeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aefcf2a7-1b01-388e-af51-af976ca60386",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "jedes Objekt (Zeichen, Wort) im Programmcode zur Darstellung oder Beschreibung einer Informationseinheit"
                                        ],
                                        "tags": [
                                            "EDV",
                                            "Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2696a013-a5db-4571-b6fa-ae37554a4813",
                                                "sense_id": "aefcf2a7-1b01-388e-af51-af976ca60386",
                                                "text": "„Um den Quellcode im Speicher kompakt darzustellen, ersetzt der Scanner jedes erkannte Schlüsselwort, jeden Variablennamen und alle weiteren Elemente jeweils durch ein Symbol.“"
                                            },
                                            {
                                                "example_id": "d6328272-1295-4837-8c5f-822e14d35ef7",
                                                "sense_id": "aefcf2a7-1b01-388e-af51-af976ca60386",
                                                "text": "„Die Aufbereitung der Symbole findet zwar typischerweise während der lexikalischen Analyse statt, aber der TypeScript-Compiler führt sie bewusst zu einem späteren Zeitpunkt durch.“"
                                            },
                                            {
                                                "example_id": "fddf30b2-da66-4dbd-bcb3-9a49dce6f730",
                                                "sense_id": "aefcf2a7-1b01-388e-af51-af976ca60386",
                                                "text": "„Die Symbole LOOP und END, die in Sprungbefehlen verwendet werden, werden vom Assembler in die Adresse des Instruktionsspeichers übersetzt, in die die nach ihnen deklarierte Instruktion geschrieben wird.“"
                                            },
                                            {
                                                "example_id": "8e235a13-4bf8-4f0b-b7df-31c41c51ace3",
                                                "sense_id": "aefcf2a7-1b01-388e-af51-af976ca60386",
                                                "text": "„Vorläufig soll ein Name, wie quader_of oder a, als ein Symbol aufgefaßt werden, das dazu dient, einen Speicherbereich zu identifizieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e805020e-19b1-3faf-93e2-7c07f1c73bbf",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "graphische Darstellung eines Sinnbildes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b276fbd-b398-479f-a651-d4ff258af6bf",
                                                "sense_id": "e805020e-19b1-3faf-93e2-7c07f1c73bbf",
                                                "text": "Wenn ich auf dieses Symbol klicke, öffne ich die Textverarbeitung."
                                            },
                                            {
                                                "example_id": "5f2a8b5d-2c28-41ab-aff1-cc79b0997cd4",
                                                "sense_id": "e805020e-19b1-3faf-93e2-7c07f1c73bbf",
                                                "text": "Die Hinweisschilder auf dem Flughafen enthalten Symbole, damit sie international verständlich sind."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "15d051de-61e0-38a5-8933-a0f788350b70",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "Zeichen für ein chemisches Element"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df56f51a-ab00-4401-8cc8-101529b07460",
                                                "sense_id": "15d051de-61e0-38a5-8933-a0f788350b70",
                                                "text": "Das Symbol für Wasserstoff ist „H“."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "657d5a70-8170-383f-b5be-d328ca6f4f0c",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "Zeichen für einen physikalischen oder mathematischen Begriff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4401cfcc-7854-4647-929a-a4d562855899",
                                                "sense_id": "657d5a70-8170-383f-b5be-d328ca6f4f0c",
                                                "text": "Die liegende Acht ist das Symbol für Unendlichkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c212f2ef-ca17-34f2-9097-d29e4cf6f37f",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "Zeichentyp, bei dem die Form nicht auf den Inhalt schließen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59104e5d-2dae-44db-b3fd-ee14eb6f6179",
                                                "sense_id": "c212f2ef-ca17-34f2-9097-d29e4cf6f37f",
                                                "text": "Symbol ist ein Zeichentyp neben Ikon und Index. Das Wort \"Hund\" ist ein Symbol; die Wörter \"Kuckuck\", \"Uhu\" und \"Zilpzalp\" sind Ikone; Namen wie \"Peter\" gehören zum Zeichentyp Index."
                                            },
                                            {
                                                "example_id": "8bc7348d-82d2-4d96-bb67-cd393ca5e587",
                                                "sense_id": "c212f2ef-ca17-34f2-9097-d29e4cf6f37f",
                                                "text": "„Sie betrachten das als Lautkontinuum feststellbare sprachliche Zeichen als Symbol.“"
                                            },
                                            {
                                                "example_id": "44cdead2-4472-4dec-89ab-39b61355e6d0",
                                                "sense_id": "c212f2ef-ca17-34f2-9097-d29e4cf6f37f",
                                                "text": "„Die ältesten Schriftformen haben mit dem Wortklang überhaupt nichts zu tun. Sie setzen für jede Sache ein Symbol, ein Zeichen, ein Ideo- oder Logogramm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "50575d26-dc4c-36cd-91df-46d2684f4fe4",
                                        "entry_id": "6b3c7e39-b961-3cc3-b20a-c1ea233413da",
                                        "glosses": [
                                            "Aspekt des Organon-Modells von Karl Bühler: Relation der Ausdrucksseite des Zeichens zu den gemeinten Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5efe76-2a07-4299-a4e2-25577c5f8e2b",
                                                "sense_id": "50575d26-dc4c-36cd-91df-46d2684f4fe4",
                                                "text": "Zur Ausdrucksseite des sprachlichen Zeichens: „Es ist Symbol kraft seiner Zuordnung zu Gegenständen und Sachverhalten, Symptom (Anzeichen, Indicium) kraft seiner Abhängigkeit vom Sender, dessen Innerlichkeit es ausdrückt, und Signal kraft seines Appells an den Hörer, dessen äußeres oder inneres Verhalten es steuert wie andere Verkehrszeichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153e7f9c-f9f8-44e3-ae18-b518036effb0",
                        "source_entry_id": "db9ec662-0f4b-3522-a6d3-fb67fcc0e295",
