                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un grand <w>romantique</w> qui croit encore au coup de foudre et aux histoires éternelles."
