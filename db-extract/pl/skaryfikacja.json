                        "entry_id": "79375fec-b439-3843-a663-ab4b34cde73a",
                        "glosses": [
                            "zabieg polegający na sztucznym uszkadzaniu okryw nasiennych lub owoców, np. orzecha, w celu ułatwienia wnikania wody i gazów do wnętrza i przyśpieszenia kiełkowania"
                        ],
                        "tags": [],
                        "examples": [],
