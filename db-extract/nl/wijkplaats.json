                    {
                        "translation_id": "5a4225d1-f5ba-40ef-9a17-27ec2db14d6c",
                        "source_entry_id": "135fc2b5-4773-3187-8a0a-86c70efaedb0",
                        "source_sense_id": "7ae9addd-c486-3530-b218-aee271b21935",
