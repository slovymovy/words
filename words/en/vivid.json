                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please pass me the black <w>vivid</w> so I can label this box.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передай мне черный <w>ма́ркер</w>, чтобы я мог подписать эту коробку.",
                                "pl": "Podaj mi proszę czarny <w>marker</w>, żebym mógł opisać to pudełko."
                            }
                        },
                        {
                            "text": "She drew a picture on the cardboard using a red <w>vivid</w>.",
                            "target_lang_translations": {
                                "ru": "Она нарисовала картинку на картоне красным <w>флома́стером</w>.",
