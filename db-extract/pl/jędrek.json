                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "02cf7799-343e-4d33-bdcb-e1b12d80451d",
                                "sense_id": "0d58cb6d-3804-3a06-a06c-3e893e9dbf5b",
                                "text": "Mój pradziad, Jakub, przywiózł z Polski syna Jędrka. Tego samego roku powiedział do niego: – Idź, Jędruś, do Kosińskich, tam jest Kaśka, może ona się z tobą ożeni. A jak się ożeni, to ci dam dwadzieścia pięć hektarów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
