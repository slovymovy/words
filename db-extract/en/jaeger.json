                "senses": [
                    {
                        "sense_id": "dc3da119-e9ce-3d8c-8f48-28ee631ed591",
                        "entry_id": "ff0e6a85-c96e-3644-849b-9cacc9f8b3b9",
                        "glosses": [
                            "Any of three seabirds in the skua genus Stercorarius."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "15b8bfb1-127e-3e35-a6b8-06b44dc29ecb",
                        "entry_id": "ff0e6a85-c96e-3644-849b-9cacc9f8b3b9",
                        "glosses": [
                            "A hunter's guide."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3b57febf-5691-35b0-9260-b831ae22a481",
                        "entry_id": "ff0e6a85-c96e-3644-849b-9cacc9f8b3b9",
                        "glosses": [
                            "A rifle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901568a8-18ff-4482-b846-973d7bf57b01",
                                "sense_id": "3b57febf-5691-35b0-9260-b831ae22a481",
                                "text": "The jaeger was the creation of Central European gunsmiths ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcb822df-6587-3b0c-9e05-823118460033",
                        "entry_id": "ff0e6a85-c96e-3644-849b-9cacc9f8b3b9",
                        "glosses": [
                            "A sharpshooter, a rifleman, light infantry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a3bdd2-833f-4653-937a-79e985a8bb3f",
                                "sense_id": "fcb822df-6587-3b0c-9e05-823118460033",
                                "text": "These were the mounted Hessian riflemen, the dreaded Jaegers."
                            },
                            {
                                "example_id": "cac394fb-9fdc-4165-8271-6fe843fca76c",
                                "sense_id": "fcb822df-6587-3b0c-9e05-823118460033",
                                "text": "St. Louis, however, was not a place where such things could be kept secret for long. By early March, Democratic papers carried reports of a terrifying new battalion known as the Black Jaegers --"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "162db213-6bf7-4188-ad42-15f3d3153feb",
                        "source_entry_id": "ff0e6a85-c96e-3644-849b-9cacc9f8b3b9",
                        "source_sense_description": "seabird",
                        "target_lang_word": "помо́рник",
                        "target_lang_code": "ru",
