                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5671d42-4c8b-35cd-9bb0-13efad40a0d6",
                        "entry_id": "48e3ae26-2043-3353-bbe5-0f149699439b",
                        "glosses": [
                            "Made of or covered with wax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e396fd1-cd45-44a5-bee4-c05edbd06d8b",
                                "sense_id": "b5671d42-4c8b-35cd-9bb0-13efad40a0d6",
                                "text": "a waxen tablet"
                            },
                            {
                                "example_id": "9d77cad0-328d-428c-b236-8de6934a42a3",
                                "sense_id": "b5671d42-4c8b-35cd-9bb0-13efad40a0d6",
                                "text": "She is fair; and so is Julia that I love—\nThat I did love, for now my love is thaw’d;\nWhich, like a waxen image, ’gainst a fire,\nBears no impression of the thing it was."
                            }
                        ]
                    },
                    {
                        "sense_id": "db08e9fb-545f-3afe-a0c1-c1b918ff07e2",
                        "entry_id": "48e3ae26-2043-3353-bbe5-0f149699439b",
                        "glosses": [
                            "Of or pertaining to wax."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6aba742-3803-3f95-b06e-38065b87ccb9",
                        "entry_id": "48e3ae26-2043-3353-bbe5-0f149699439b",
                        "glosses": [
                            "Having the pale smooth characteristics of wax, waxlike, waxy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "751d1aaa-577b-4957-b37c-59da67627c3c",
                                "sense_id": "b6aba742-3803-3f95-b06e-38065b87ccb9",
                                "text": "It was hard to imagine that the broken thing had once been new; that those withered, waxen cheeks had been fresh and tinted. That her eyes had long ago glinted with laughter."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bb38f43-88a6-363a-afd9-0678272db446",
                        "entry_id": "48e3ae26-2043-3353-bbe5-0f149699439b",
                        "glosses": [
                            "Easily molded, influenced, or bent; yielding, impressible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484d566b-d258-4b73-be40-dec3964f01bb",
                                "sense_id": "6bb38f43-88a6-363a-afd9-0678272db446",
                                "text": "The traveller hears me now and then,\n⁠And sometimes harshly will he speak:\n⁠‘This fellow would make weakness weak,\nAnd melt the waxen hearts of men.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "dbdb8c19-bffc-31dd-9a76-80d867cb5473",
                        "entry_id": "48e3ae26-2043-3353-bbe5-0f149699439b",
                        "glosses": [
                            "Easily effaced, as if written in wax."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
