                                                "example_id": "75dc7c2f-0ddb-4ecb-8094-25f49b3c517c",
                                                "sense_id": "b035e605-a7cd-3f7d-b62a-2375133fa037",
                                                "text": "Who is there of mine goes to this war that I should grieve for his wounding or look for his return?"
