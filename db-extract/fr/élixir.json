        "fr-extract.jsonl": [
            {
                "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                "word": "élixir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "22feee96-49eb-4c79-a8e9-ab1606abc9b9",
                        "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "tags": [
                            "plural"
                        ],
                        "form": "élixirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5050ef12-08f8-3fdf-824d-2b9060c7a506",
                        "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "glosses": [
                            "Liqueur spiritueuse qui résulte du mélange de certains sirops avec de l’alcool."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "285e23ab-440d-4321-9536-0b50b9c11058",
                                "sense_id": "5050ef12-08f8-3fdf-824d-2b9060c7a506",
                                "text": "Dites-moi bien tout alors, ne me cachez rien, j’aurai des élixirs pour toutes vos douleurs."
                            },
                            {
                                "example_id": "b51296a9-2897-4a16-b30c-610fb88bae43",
                                "sense_id": "5050ef12-08f8-3fdf-824d-2b9060c7a506",
                                "text": "[L]e curé de Graveson me versa deux doigts d’une liqueur verte, dorée, chaude, étincelante, exquise… J’en eus l’estomac tout ensoleillé.\n— C’est l’élixir du Père Gaucher, la joie et la santé de notre Provence, me fit le brave homme d’un air triomphant […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e109c0-7ef7-34bb-a46b-6a3e8efaa1e7",
                        "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "glosses": [
                            "La substance la plus pure que l’on tire de certaines choses."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b2d7437d-5f18-40e0-bbe6-bc282ae30447",
                                "sense_id": "20e109c0-7ef7-34bb-a46b-6a3e8efaa1e7",
                                "text": "Leur ignominie, que j’avais estimée complète, irréprochable et savoureuse autant que peut l’être un élixir de malédiction, n’avait plus la moindre sapidité et ressemblait à de la noblesse en comparaison de cet indévoilable cauchemar d’opprobre."
                            }
                        ]
                    },
                    {
                        "sense_id": "eddfc8b3-51e7-36a7-9f93-f31a501f8d89",
                        "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "glosses": [
                            "Liqueur réputée dotée d’effets magiques."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "30f86aea-a02b-4740-9da4-33020d37cf37",
                                "sense_id": "eddfc8b3-51e7-36a7-9f93-f31a501f8d89",
                                "text": "Il a connu Cagliostro et le comte de Saint-Germain : il prétend être de leur famille, avoir comme eux le secret de l’élixir de longue vie."
                            },
                            {
                                "example_id": "f934f79a-1a65-405c-8e2e-28110a4d5b8d",
                                "sense_id": "eddfc8b3-51e7-36a7-9f93-f31a501f8d89",
                                "text": "Baume universel, élixir composé par les alchimistes : c’est, disent-ils, le remède souverain et infaillible de toutes les maladies. Il peut même, au besoin, ressusciter des morts."
                            },
                            {
                                "example_id": "2298ea17-7004-4c8f-b351-ba95d9a71b00",
                                "sense_id": "eddfc8b3-51e7-36a7-9f93-f31a501f8d89",
                                "text": "Je sens la force bienfaisante de l'élixir voltan m'envahir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c844830e-df68-33be-808f-705994a91f40",
                        "entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "glosses": [
                            "La quintessence d’une chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c421362c-3ca5-4790-bea8-d32a1d50a068",
                                "sense_id": "c844830e-df68-33be-808f-705994a91f40",
                                "text": "Tout mes travaux et expos se rejoignent dans l’humour et le dessin pour en extraire l’élixir de l'auto[-]dérision"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50608cb0-0e67-4e32-9376-e1843e9b8409",
                        "source_entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "target_lang_word": "Elixier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elixier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3269b26-f926-373c-a64f-8add84dd32c3",
                                        "entry_id": "a7cd8b78-82e0-318b-aa3f-222f9f7073b3",
                                        "glosses": [
                                            "in Wein oder Alkohol gelöster Auszug aus Heilpflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130420f8-487c-4ade-9034-39094572ec01",
                                                "sense_id": "c3269b26-f926-373c-a64f-8add84dd32c3",
                                                "text": "Wer hat dieses Elixier hergestellt?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b8cdf20-9275-3c79-8fac-425f75d3a0bc",
                                        "entry_id": "a7cd8b78-82e0-318b-aa3f-222f9f7073b3",
                                        "glosses": [
                                            "Heiltrank, Zaubertrank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e310e0-0566-423e-a4d4-0134593654b7",
                                                "sense_id": "1b8cdf20-9275-3c79-8fac-425f75d3a0bc",
                                                "text": "Dieses Elixier bringt mich wieder auf die Beine."
                                            },
                                            {
                                                "example_id": "779e180e-b90a-4af9-b1b8-139775fbf6cb",
                                                "sense_id": "1b8cdf20-9275-3c79-8fac-425f75d3a0bc",
                                                "text": "„Unsere Reiseapotheke ist gut gefüllt, doch Solomon möchte die gerade erstandene Flasche mit dem Elixier, das gegen Gebrechen jeder Art helfen soll, füllen und für etwaige, auf der Fahrt zu erwartende Beschwerden mitnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a3055423-c3c0-3432-a48c-5179eacbf0ae",
                                        "entry_id": "a7cd8b78-82e0-318b-aa3f-222f9f7073b3",
                                        "glosses": [
                                            "Lebenssaft, lebenspendender Saft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f541eae-ce59-441b-b93d-88f6ec7ff641",
                                                "sense_id": "a3055423-c3c0-3432-a48c-5179eacbf0ae",
                                                "text": "Das Blut ist ein Elixier des Lebens."
                                            },
                                            {
                                                "example_id": "b8923c74-768e-49e6-8bcd-f63d11f6d56f",
                                                "sense_id": "a3055423-c3c0-3432-a48c-5179eacbf0ae",
                                                "text": "„Das traf sie hart, weil der musikalische Austausch für sie das Elixier ihrer Liebe war.“"
                                            },
                                            {
                                                "example_id": "30685db9-2ab4-44d9-8322-d8d293e3ac9a",
                                                "sense_id": "a3055423-c3c0-3432-a48c-5179eacbf0ae",
                                                "text": "„Mehrdeutigkeit und Vielfalt wurden zum Elixier ihres Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52dcf503-ded5-4fec-8325-05121f94c888",
                        "source_entry_id": "6e77173d-ec2e-3b32-843c-8bbb2157f249",
                        "target_lang_word": "elixir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elixir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c29d3029-4ca8-3c1e-a5be-2e7c655b32c2",
                                        "entry_id": "8919aa1a-20aa-3098-aab9-5a18a533efa8",
                                        "glosses": [
                                            "A liquid which converts lead to gold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fcc6561-788b-4198-a2ad-9b9d549b955b",
                                                "sense_id": "c29d3029-4ca8-3c1e-a5be-2e7c655b32c2",
                                                "text": "For Chinese alchemists, gold held the key to the Elixir, the Eastern equivalent of the Philosopher's Stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131c0a99-d16a-3875-a3a7-c425ca0e5eac",
                                        "entry_id": "8919aa1a-20aa-3098-aab9-5a18a533efa8",
                                        "glosses": [
                                            "A substance or liquid which is believed to cure all ills and give eternal life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4706408-2dd3-3cdc-9b53-836f98e1d08a",
                                        "entry_id": "8919aa1a-20aa-3098-aab9-5a18a533efa8",
                                        "glosses": [
                                            "The alleged cure for all ailments; cure-all, panacea."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73497750-933c-4712-a422-755904719428",
                                                "sense_id": "f4706408-2dd3-3cdc-9b53-836f98e1d08a",
                                                "text": "The silver-bullet cancer cures of yesterday’s newsmagazine covers, like interferon and angiogenesis inhibitors, disappointed the breathless expectations, as have elixirs such as antioxidants, Vioxx, and hormone replacement therapy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5397fa34-9dd3-3f17-a867-78479855740a",
                                        "entry_id": "8919aa1a-20aa-3098-aab9-5a18a533efa8",
                                        "glosses": [
                                            "A sweet flavored liquid (usually containing a small amount of alcohol) used in compounding medicines to be taken by mouth in order to mask an unpleasant taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e520bbf-4be1-4e19-821e-e642c0ea4a0f",
                                                "sense_id": "5397fa34-9dd3-3f17-a867-78479855740a",
                                                "text": "The subcommittee's report to the Council on Pharmacy and Chemistry shows that the action of somnos is practically identical with that of a 5 per cent elixir of hydrated chloral."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
