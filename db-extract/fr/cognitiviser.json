                "senses": [
                    {
                        "sense_id": "e34401cb-7c5e-3d28-8f28-ff93887574bc",
                        "entry_id": "56ef9c49-b00d-3a22-8ece-5359bc8eca23",
                        "glosses": [
                            "Donner un caractère cognitif à, considérer du point de vue cognitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fc9c8f4-74d7-49f5-895a-5b6909e3a919",
                                "sense_id": "e34401cb-7c5e-3d28-8f28-ff93887574bc",
                                "text": "Cognitiviser le normatif, qu’il soit juridique ou moral, c’est le trivialiser et le convertir en son contraire."
                            },
                            {
                                "example_id": "601d86cf-9edd-4b5e-80c2-d2cd95a208ba",
                                "sense_id": "e34401cb-7c5e-3d28-8f28-ff93887574bc",
                                "text": "A condition de renoncer à « cognitiviser » des entités qui n’ont rien à voir avec les processus putatifs de la physiologie du système nerveux humain, ou de son antichambre « intentionnelle-naturalisée » qui, elle, est imaginaire."
                            }
                        ]
                    }
