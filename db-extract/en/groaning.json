                                            {
                                                "example_id": "898c5b08-ac55-4148-82fe-511f67506d83",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Er hörte das Stöhnen eines Mannes, der offenbar dabei war, sich zu vergnügen, während die mütterliche Stimme einer Frau ihn anspornte.“"
                                            },
                                            {
                                                "example_id": "942f8b6d-cd46-4e9a-b870-58dafdeaae58",
                                                "sense_id": "0fcad849-2ce8-3ea5-b339-75491cabd291",
                                                "text": "„Ein Stöhnen aus dem Beiboot veranlasste ihn, sich ein, zwei Meter am Boot entlangzuhangeln und dann über den Bootsrand zu spähen, wobei er darauf achtete, das Boot zwischen sich und dem Frachtschiff in knapp 200 Metern Entfernung zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
