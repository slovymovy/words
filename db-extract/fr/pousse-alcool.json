                        "source_sense_id": "fdaff915-c2b7-3df1-8dde-0330c55fbe56",
                        "target_lang_word": "chaser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a21bf1db-ef92-3098-b05f-e087276283e0",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "Something or someone who chases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6670afa1-5c8c-4b28-b045-b133a9d9fcb5",
                                                "sense_id": "a21bf1db-ef92-3098-b05f-e087276283e0",
                                                "text": "One student is the chaser and the other is the chasee. Give the chasee three seconds to get away and then allow the chaser to attempt to tag the chasee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cb88903-3e8e-3887-9248-f61daff43740",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A horse trained for steeplechasing; a steeplechaser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ed3b06-d280-4af7-b351-fd2cf6ad57e8",
                                                "sense_id": "7cb88903-3e8e-3887-9248-f61daff43740",
                                                "text": "\"[I]t looked like The Fellow was the best steeplechaser in many years. He'd earned the best speed rating I'd ever given a chaser.\""
                                            },
                                            {
                                                "example_id": "252af456-0995-4bf0-8692-0509e7a0c997",
                                                "sense_id": "7cb88903-3e8e-3887-9248-f61daff43740",
                                                "text": "\"Wild Risk...had his greatest successes as a steeplechaser rather than a flat racer... It is rare indeed that a 'chaser - even one as good as wild risk - makes a good flat sire.\""
                                            },
                                            {
                                                "example_id": "c35de221-2c00-4d80-b029-5dcd77dc7576",
                                                "sense_id": "7cb88903-3e8e-3887-9248-f61daff43740",
                                                "text": "Oh, that final furlong! It can be both agony and ecstasy. Anyone who doubts that should have seen the television close-up of Jim Lewis as his great chaser Best Mate came up the final hill at Cheltenham in 2004 to clich a hat-trick of Gold Cups. ... Best mate is the best steeplechaser we have seen for years and all being well will be at the Cheltenham Festival again in 2005 to try and make it four Gold Cups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafdb10b-153c-3eb5-8648-5580ab8200db",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A hunter (a horse bred and trained for use in hunting)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56eb64a6-b996-32d2-88a0-0ed5a0dff99b",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A drink consumed after another of a different kind."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1bed2e-913b-4c00-be86-f3f7210d0543",
                                                "sense_id": "56eb64a6-b996-32d2-88a0-0ed5a0dff99b",
                                                "text": "beer chaser"
                                            },
                                            {
                                                "example_id": "da9c3aaf-b7b0-4ad2-b65c-d66ecba275cf",
                                                "sense_id": "56eb64a6-b996-32d2-88a0-0ed5a0dff99b",
                                                "text": "straight, no chaser"
                                            },
                                            {
                                                "example_id": "46dc99a8-f605-4e91-9e12-39f00d460547",
                                                "sense_id": "56eb64a6-b996-32d2-88a0-0ed5a0dff99b",
                                                "text": "Cowboys in high-heeled boots teeter along its sidewalks, or push the swinging doors aside for a shot or two—straight, no chaser."
                                            },
                                            {
                                                "example_id": "101c5b5f-5a72-4ce9-af09-878f985c0955",
                                                "sense_id": "56eb64a6-b996-32d2-88a0-0ed5a0dff99b",
                                                "text": "All this stuff is blocking us / I'm neat with no chaser / I'm all spirit, but I'm sinking"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "330d787e-232f-3794-9d16-da5cf0414604",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "Someone who follows logs out of the forest in order to signal a yarder engineer to stop them if they become fouled"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673bb660-d6cb-4be1-877e-60a3b28960e5",
                                                "sense_id": "330d787e-232f-3794-9d16-da5cf0414604",
                                                "text": "...on one end known as a Bardon choker hook, to facilitate making a loop. It stays tight and makes it unnecessary for the \"chaser\" or \"choker setter\" to follow the \"turn\" to the landing as might have to be done if tongs are used"
                                            },
                                            {
                                                "example_id": "155e6cf1-1e98-40bd-ba9d-e75685b00a3a",
                                                "sense_id": "330d787e-232f-3794-9d16-da5cf0414604",
                                                "text": "\"A chaser follows the logs to the landing, often riding in a rigging sled hollowed out of a log, which is attached to the rear log. The chaser can signal to the road engineer at any point...\""
                                            },
                                            {
                                                "example_id": "7c498f68-59bd-4902-83c4-95238e52e309",
                                                "sense_id": "330d787e-232f-3794-9d16-da5cf0414604",
                                                "text": "\"and the chaser is the fellow whose job it is to follow along after these logs to...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "124ca0a4-cb83-3b29-b8a0-0b3000a9fb1f",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "One who unhooks chokers from the logs at the landing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79bbf655-6ded-4d31-a4c2-0ae3cb62647b",
                                                "sense_id": "124ca0a4-cb83-3b29-b8a0-0b3000a9fb1f",
                                                "text": "\"The rigging slinger hooks the chokers to the main line, the chaser unhooks them at the spar tree.\""
                                            },
                                            {
                                                "example_id": "c66d67be-330f-435a-bb9e-1fc1c64e292d",
                                                "sense_id": "124ca0a4-cb83-3b29-b8a0-0b3000a9fb1f",
                                                "text": "A chaser was the man who unhooked the logs that were yarded in to the spar tree."
                                            },
                                            {
                                                "example_id": "4e94a726-134d-42e2-a588-8a740ee26781",
                                                "sense_id": "124ca0a4-cb83-3b29-b8a0-0b3000a9fb1f",
                                                "text": "\"When the turn arrives at the landing, the chaser directs the engineer where to drop the turn by hand signals. The chaser then unhooks the chokers, gets in the clear, and singlas to reel in the haulback line\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a03df664-2166-3c7d-92da-8bdcd9df3640",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A piece of music played after a performance while the audience leaves."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e3c502-7c6f-4654-8c8f-3f8533523481",
                                                "sense_id": "a03df664-2166-3c7d-92da-8bdcd9df3640",
                                                "text": "After the final curtain the orchestra played a \"chaser\" which was music played while the audience members not remaining for the after-show concert left the theatre."
                                            },
                                            {
                                                "example_id": "c1ff4330-ca8e-4ce8-bbf7-d378ddc5c3f2",
                                                "sense_id": "a03df664-2166-3c7d-92da-8bdcd9df3640",
                                                "text": "Films had become a regular feature of the typical vaudeville program, ending most programs and occasionally serving as a “chaser” that encouraged audiences to leave the continuous programs rather than retain their seats to watch them a second time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd08803-4ee6-3259-ba73-617d87b07d85",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A long piece of flexible wire used to draw an electrical cable through a wall cavity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a0c8ddd-fe47-31d6-82bc-646cf30de09f",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "One of a series of adjacent light bulbs that cycle on and off to give the illusion of movement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02f583cb-8d6f-3a38-97d8-d081f297354c",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A person who guards military prisoners on fatigue duty; a prison guard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7df6b82-8473-3c6a-9f58-947f1f8b09f8",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A person who is attracted to and seeks out sexual partners with a particular quality, usually in a fetishistic manner.",
                                            "A chaser for transgender people; a tranny chaser."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646f88df-a37d-498f-aea3-4ebd5438723a",
                                                "sense_id": "b7df6b82-8473-3c6a-9f58-947f1f8b09f8",
                                                "text": "These types despise TGentlemen and insist that any man who is interested in TGirls is automatically a troll, a chaser, or just a gay man in denial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f6089c-2712-3f0d-b608-cef80ae6a6c9",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A person who is attracted to and seeks out sexual partners with a particular quality, usually in a fetishistic manner.",
                                            "A chaser for overweight or obese people; a chubby chaser."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5d1c6b9-be2b-3f1a-bdd0-8bfce0b06877",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "A person who is attracted to and seeks out sexual partners with a particular quality, usually in a fetishistic manner.",
                                            "A person who seeks partners with HIV in order to become infected."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311d9a84-efe8-48d7-abcb-2446db8bd0df",
                                                "sense_id": "e5d1c6b9-be2b-3f1a-bdd0-8bfce0b06877",
                                                "text": "At any given time, there are often dozens of people actively posting online ads as “chasers” or “gifters” in San Francisco and elsewhere around the nation .. Though chasers and gifters are active around the world, many see San Francisco as a kind of mecca .. apps like Grindr and Recon, as well as the website Breeding.Zone, where gifters and chasers share advice and stories about their sexual experiences, make it relatively straightforward to meet people who want to be infected with the virus that causes AIDS — or to infect their partners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68fbf6c-0b07-3cc4-b450-ab47416513a3",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "In the sport of Quidditch or Muggle quidditch, a player responsible for passing the quaffle and scoring goals with it."
                                        ],
                                        "tags": [
                                            "Harry-Potter"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd73e2c2-ef16-35be-8181-80386099e929",
                                        "entry_id": "c90d98b7-686d-3095-b30b-a7838333a93c",
                                        "glosses": [
                                            "Any dragonfly of family Libellulidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chaser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e94a53d-faf3-3e5b-a993-4aeafa8ed3b9",
                                        "entry_id": "99feabf3-a2d0-36f2-b906-9fcf40963f5b",
                                        "glosses": [
                                            "Someone who chases (decorates) metal; a person who decorates metal by engraving or embossing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b291fec1-b650-421d-a3e0-285da39dc8e5",
                                                "sense_id": "1e94a53d-faf3-3e5b-a993-4aeafa8ed3b9",
                                                "text": "\"Mr B., heraldic chaser, says there are several processes in making heraldy plates, sketching, engraving, embossing, chasing and burnishing.\"\n\"H. & C., manufacturers of cloth and gilt buttons, say it requires some weeks to learn to chase the gilt buttons, which are done with small metal tools and a hammer. Chasers are paid by the piece, working ten hours a day, and some can earn $1 a day.\""
                                            },
                                            {
                                                "example_id": "ecedf61d-3044-4b1d-bc85-17f162a07ff7",
                                                "sense_id": "1e94a53d-faf3-3e5b-a993-4aeafa8ed3b9",
                                                "text": "\"Flat chasing in sunken or low relief is a technique by which the ornament is formed by beating down the ground from the front. This is done in essentially the same manner as repoussé work, where the ornament appears in high relief, but the design is punched from the face of the silver plate. ... Sometimes, instead of applying a freehand design, the chaser covers the greased surface with a paper pattern in which the design is pricked with pins.\""
                                            },
                                            {
                                                "example_id": "ffbf37a0-2f03-44c2-a5ac-b6c365b2a9c0",
                                                "sense_id": "1e94a53d-faf3-3e5b-a993-4aeafa8ed3b9",
                                                "text": "\"Chasing in general can be distinguished from engraving, in that the design can be seen on the reverse or inside of the pieces. Having outlined the pattern on the surface, the chaser cuts and at the same time slightly depresses the surface. A light hammer can be used in this process also.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db98e67a-9024-3ee5-b0b6-71a29f362824",
                                        "entry_id": "99feabf3-a2d0-36f2-b906-9fcf40963f5b",
                                        "glosses": [
                                            "A tool used for cleaning out screw threads, either as an integral part of a tap or die to remove waste material produced by the cutting tool, or as a separate tool to repair damaged threads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484d71e1-9b04-4b59-a089-63324049b7ba",
                                                "sense_id": "db98e67a-9024-3ee5-b0b6-71a29f362824",
                                                "text": "In Fig. i is shown one of the chasers in the position which it occupies in cutting a thread."
                                            },
                                            {
                                                "example_id": "82d4c952-ec21-440b-8cc5-492589b4b9eb",
                                                "sense_id": "db98e67a-9024-3ee5-b0b6-71a29f362824",
                                                "text": "\"Many screw threads are also finished completely with chasers of this type, although they are not adapted for extremely accurate work unless the teeth are ground after hardening, because the pitch of the chaser teeth is affected more or less by...\""
                                            },
                                            {
                                                "example_id": "a0f31e16-08c5-4534-ba7b-3348904f5c79",
                                                "sense_id": "db98e67a-9024-3ee5-b0b6-71a29f362824",
                                                "text": "\"The category of thread cutting tools includes both the single-point and multiple-point [chaser type] lathe cutters.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ecf00d3-d686-39e7-9d32-1435d8448687",
                                        "entry_id": "99feabf3-a2d0-36f2-b906-9fcf40963f5b",
                                        "glosses": [
                                            "A chase gun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e41fb1e-a68a-44d2-bae5-16800ec8941a",
                                                "sense_id": "6ecf00d3-d686-39e7-9d32-1435d8448687",
                                                "text": "bow chaser; stern chaser"
                                            }
                                        ]
                                    }
                                ]
                            }
