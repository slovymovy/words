                    {
                        "translation_id": "fb351957-d09c-486c-9961-6de3746e350b",
                        "source_entry_id": "f698e363-8e31-3f58-bd0e-0534914064f7",
                        "source_sense_id": "163d7c02-705b-312a-820b-fc490c03255a",
                        "target_lang_word": "lawful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lawful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b6afe51-ec14-3982-9dfd-417538c62e31",
                                        "entry_id": "92284070-d9de-3b45-b0da-dfa581bd635d",
                                        "glosses": [
                                            "Conforming to, or recognised by the laws of society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dccf55f0-99fb-4e66-8894-416bcb81cf5d",
                                                "sense_id": "9b6afe51-ec14-3982-9dfd-417538c62e31",
                                                "text": "Lawful money is always a land asset and can only be issued by an actual land jurisdiction government — not a corporation."
                                            },
                                            {
                                                "example_id": "8788fcc3-607c-4c18-8e1b-fb4bac2ad9b1",
                                                "sense_id": "9b6afe51-ec14-3982-9dfd-417538c62e31",
                                                "text": "The laws are controversial. Forcing someone to work during a lawful strike is a major step. It was always likely to inflame a situation, and so it proved with LNER. ASLEF's counter-tactic came as a five-day walkout, which would have been the longest stoppage for many years had LNER not withdrawn its plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04058b00-0733-3641-b1ca-564529725a4a",
                                        "entry_id": "92284070-d9de-3b45-b0da-dfa581bd635d",
                                        "glosses": [
                                            "Operating according to some law or fundamental principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31fd3de4-d4e5-4eb3-9079-5afbcbc89ed2",
                                                "sense_id": "04058b00-0733-3641-b1ca-564529725a4a",
                                                "text": "Or would they have it believed, that there is in their ſelves ſome ſuperior ſanctity, ſome peculiar privilege, by which theſe things are lawful to them, which are unlawful to all the world beſides?"
                                            },
                                            {
                                                "example_id": "1e44568d-c9e3-4a3c-a69e-6e3d91743252",
                                                "sense_id": "04058b00-0733-3641-b1ca-564529725a4a",
                                                "text": "[…] so that the person's actions are merely the inevitable product of lawful causes stemming from prior events […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d598ac6d-4905-3926-b079-c14bb8bc143b",
                                        "entry_id": "92284070-d9de-3b45-b0da-dfa581bd635d",
                                        "glosses": [
                                            "Of a character: having an alignment which makes them tend to follow the laws and conventions of society."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lawful",
                                "target_lang_code": "en",
                                "target_senses": [
