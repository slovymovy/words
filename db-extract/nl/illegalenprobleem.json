                        "examples": [
                            {
                                "example_id": "da512f6b-318d-4644-bd20-fa0af5d55bee",
                                "sense_id": "4c16f53c-d33a-35db-8564-a08144619483",
                                "text": "Negen van de tien illegale migranten gebruiken Griekenland als springplank om de EU in te komen. Athene klaagde jarenlang dat Turkije te weinig doet om illegalen tegen te houden. Ook weigert Ankara illegalen terug te nemen omdat het hen zou aanmoedigen de Turkije-route te nemen. Beide landen kwamen onlangs overeen meer samen te werken om het illegalenprobleem aan te pakken."
                            },
                            {
                                "example_id": "37b2df75-345e-4701-bac0-4ed0262a7952",
                                "sense_id": "4c16f53c-d33a-35db-8564-a08144619483",
                                "text": "Critici hebben gelijk dat het kabinet het illegalenprobleem daarmee nog niet oplost. Maar dat is dan ook onoplosbaar. Geen welvarende samenleving zonder mensen die liever illegaal op zichzelf zijn aangewezen dan dat ze legaal wonen in hun vaderland."
                            }
                        ]
