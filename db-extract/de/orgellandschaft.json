                "senses": [
                    {
                        "sense_id": "9f16bcff-57d0-342f-b5c8-dc8b1a003c44",
                        "entry_id": "ddc91364-5d38-3630-8cf2-ae160a281a3a",
                        "glosses": [
                            "(regionales/nationales) Gebiet, das Orgeln mit bestimmten Eigenheiten zusammenfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95abb5f8-e681-48f1-ba9c-a0fd83c8d9c3",
                                "sense_id": "9f16bcff-57d0-342f-b5c8-dc8b1a003c44",
                                "text": "„Innerhalb nationaler Kulturräume lassen sich regionale Orgellandschaften ausmachen, die in erster Linie geographisch definiert sind. Sie fallen in Deutschland in der Regel mit den Grenzen der historischen Herzogtümer und Grafschaften zusammen (beispielsweise bei der Orgellandschaft Ostfriesland, Orgellandschaft Oldenburg und Orgellandschaft Oberschwaben). […] Eine regionale Orgellandschaft besteht aus Instrumenten zahlreicher Epochen und vereinigt zahlreiche Einflüsse, deren Mischung für die jeweilige Orgellandschaft kennzeichnend ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
