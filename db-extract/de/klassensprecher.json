                "senses": [
                    {
                        "sense_id": "bc09f9a3-e401-364a-823e-62ec3339c039",
                        "entry_id": "69b68028-8ede-36e3-b198-0e629b7b72b3",
                        "glosses": [
                            "Schüler, der von den Mitschülern seiner Klasse gewählt wird, um die Anliegen der Klasse gegenüber den Lehrkräften und in der Schülervertretung zu vertreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700afd6e-107e-47d1-becc-9048f92445b1",
                                "sense_id": "bc09f9a3-e401-364a-823e-62ec3339c039",
                                "text": "„Als Teil der Schuldemokratie sind ab der 5. Schulstufe nach dem Schulunterrichtsgesetz (SchUG) für jede Klasse ein Klassensprecher bzw. eine Klassensprecherin zu wählen.“"
                            },
                            {
                                "example_id": "477cad8d-dd08-4da3-a2b2-4dee6d3942fc",
                                "sense_id": "bc09f9a3-e401-364a-823e-62ec3339c039",
                                "text": "„Vielleicht war Roth zum Kongress eingeladen, weil er stellvertretender Klassensprecher war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
