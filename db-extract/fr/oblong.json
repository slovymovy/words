                                                "sense_id": "06ebf543-0e55-3bd8-972b-d07b55143df6",
                                                "text": "Of the smaller oblong formats, none is specifically designated for music."
                                            },
                                            {
                                                "example_id": "f59835b3-922e-425f-844e-67212ade0822",
                                                "sense_id": "06ebf543-0e55-3bd8-972b-d07b55143df6",
                                                "text": "Mass cycles and motets had never been presented in small oblong format, so far as we can tell."
                                            }
                                        ]
