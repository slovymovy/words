                                "sense_id": "66f79254-b626-3c23-b53e-8f94d5c7ba41",
                                "text": "L'aimé-je ?",
                                "translation": "Do I love him/her/it?",
                                "english": "Do I love him/her/it?"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3cfc7d1-0619-3f49-8123-6f977d84a770",
                        "entry_id": "52e28249-466e-3717-9966-0ebd32f79670",
                        "glosses": [
