                        "form": "*"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "331430d8-38e8-3c10-979c-3ea29144e5d6",
                        "entry_id": "5bb7764e-504c-3b9f-bed0-f4bbcffebcee",
                        "glosses": [
                            "предназначенный для питья (действия или напитка)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef7a57b-4ce9-4a94-b9a2-6a72e74be70f",
                                "sense_id": "331430d8-38e8-3c10-979c-3ea29144e5d6",
                                "text": "В магазине продавался питьевой спирт в литровых бутылках."
                            },
                            {
                                "example_id": "f777e20b-36a1-4aaa-bfec-c3ce6e6c29c9",
                                "sense_id": "331430d8-38e8-3c10-979c-3ea29144e5d6",
                                "text": "Добавьте в тесто три ложки питьевой соды."
                            },
                            {
                                "example_id": "9258bee4-c48e-4179-a999-684dabd3bbd7",
                                "sense_id": "331430d8-38e8-3c10-979c-3ea29144e5d6",
                                "text": "У кровати стоят... бутылка водки и пузырь русского кваса. Никакой питьевой посуды. Так, значит, из горла и садил."
                            }
                        ]
                    },
                    {
                        "sense_id": "c20b7260-ba06-3907-a018-76a20e31515a",
                        "entry_id": "5bb7764e-504c-3b9f-bed0-f4bbcffebcee",
                        "glosses": [
                            "пригодный для питья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ec9cce-e9da-4cb3-8660-b96e4fc28d29",
                                "sense_id": "c20b7260-ba06-3907-a018-76a20e31515a",
                                "text": "В этот кран подаётся питьевая вода, а в баке находится вода непитьевая, для хознужд."
                            }
                        ]
                    },
                    {
