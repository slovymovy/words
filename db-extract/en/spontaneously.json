                    {
                        "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                        "entry_id": "bc55a7bc-f2c6-3dd2-b284-35a37bf9da46",
                        "glosses": [
                            "In a spontaneous manner; naturally; voluntarily."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5dc00a-ae09-4b97-8605-448f6289a92f",
                                "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                                "text": "The idea that the body could spontaneously ignite was promoted by the 19th-century temperance movement."
                            },
                            {
                                "example_id": "ed3d3799-255f-4f6b-bed8-1847f5aa1a03",
                                "sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                                "text": "Smaller-scale isolated deaf-education programs had existed previously in 20th-century Nicaragua, Shepard-Kegl says, but the critical mass needed to spontaneously develop Nicaraguan Sign Language only occurred with the opening of Melania Morales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90d41bf5-2307-4196-aa17-85322cc06cae",
                        "source_entry_id": "bc55a7bc-f2c6-3dd2-b284-35a37bf9da46",
                        "source_sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                        "source_sense_description": "in a spontaneous manner",
                        "target_lang_word": "spontaan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontaan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                                        "glosses": [
                                            "uit een opwelling voortkomend, niet uitgelokt of door een ander teweeggebracht: een spontane hulde, ontboezeming."
                                        ],
                                        "tags": [
                                            "van handelingen en uitingen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d35d8288-996b-4190-a814-39ddac929a91",
                                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                                "text": "Een spontaan applaus klinkt op."
                                            },
                                            {
                                                "example_id": "ce8a8f43-0b70-47c7-a5ad-d1aaccaa4c17",
                                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                                "text": "De productie werd door een spontane staking stilgelegd."
                                            },
                                            {
                                                "example_id": "754189ea-93e6-46ed-b208-7ba37d896800",
                                                "sense_id": "828b4d37-00d4-3022-a336-3afb849e7771",
                                                "text": "\"Dat heb ik ook steeds\", roept een meisje spontaan vanaf haar plek in de kerkzaal. En als de dominee vraagt of dat bij andere kinderen thuis ook wel eens voorkomt, steken meerderen de hand op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b6be4b-e604-3c9e-88ae-842793edd02d",
                                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                                        "glosses": [
                                            "geneigd zijn opwellingen aanstonds te uitten: mensen, spontaan in vreugde en verdriet."
                                        ],
                                        "tags": [
                                            "van personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f958ed97-5f83-48de-b4c4-6eb030d7e211",
                                                "sense_id": "77b6be4b-e604-3c9e-88ae-842793edd02d",
                                                "text": "De jury prees haar spontane uitstraling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                                        "entry_id": "e6be5989-4370-3513-a715-d788b4720d48",
                                        "glosses": [
                                            "niet door uitwendige oorzaken bewerkt, vanzelf optredend: een spontane infectie; spontaan geïnfecteerd."
                                        ],
                                        "tags": [
                                            "van biologische verschijnselen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8009b601-57f4-46d4-be80-b9b861248bd1",
                                                "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                                                "text": "De streek wordt geteisterd door spontane branden."
                                            },
                                            {
                                                "example_id": "3283662b-0c2a-4508-8453-c8c3d91418a1",
                                                "sense_id": "76e6a5c2-8ca1-30c1-bf5a-b27a018d217c",
                                                "text": "De ziekte ontstaat als gevolg van een spontane mutatie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dc3e153-2a22-440b-b639-88e21138e420",
                        "source_entry_id": "bc55a7bc-f2c6-3dd2-b284-35a37bf9da46",
                        "source_sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                        "source_sense_description": "in a spontaneous manner",
                        "target_lang_word": "spontanément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontanément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                        "entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                                        "glosses": [
                                            "D’une manière spontanée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef8fc77-9dc0-460f-9086-295bf6d1c5aa",
                                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                                "text": "Les uns admettent que l'atmosphère transporte les germes du corps vibrionnaire; les autres pensent, au contraire, que ces germes se forment spontanément dans la matière fermentescible."
                                            },
                                            {
                                                "example_id": "0a42b946-2148-4d21-a117-433f98e0932f",
                                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                                "text": "À l'époque du frai, il pousse spontanément un petit cri peu harmonieux, qui participe de l'aboiement du roquet et du pépiement du poussin."
                                            },
                                            {
                                                "example_id": "38db0772-4fdb-426a-aeeb-12b029398e25",
                                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                                "text": "Il faut que tous les incidents qui font sortir le caractère, soient naturellement amenés, de façon que chaque circonstance paraisse naître spontanément pour seconder l’intention du peintre,"
                                            },
                                            {
                                                "example_id": "d17b111a-e10b-4fd9-92dd-a9db5850fd2a",
                                                "sense_id": "ba0fa2a6-ff3d-3708-8e81-d640739cf99d",
                                                "text": "Ce jour-là, au moment de la séparation, spontanément, avec un sourire heureux, Yasmina lui donna un baiser, le premier..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                                        "entry_id": "0db14474-7bb7-355e-be0c-5f51aed2b326",
                                        "glosses": [
                                            "D'une manière naturelle ; sans intervention humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107f3dfe-b7c9-4296-82b4-9f27ce7a39e0",
                                                "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                                                "text": "Et pourtant les figuiers s'obstinent à pousser spontanément parmi les gravats et je me gorge, sans rien payer, de leurs fruits cramoisis."
                                            },
                                            {
                                                "example_id": "747386a1-1b7f-4e2a-9d5b-54eb6bfd2ce3",
                                                "sense_id": "6e3a0d25-3fb2-31a6-9c97-21f9911f5f78",
                                                "text": "[…]; d'autre part, la nature d'un terrain non agricole, spontanément, ce n'est pas le bois, mais la broussaille, la friche, la lande, la ginestaie, la garrigue, la genévraie, le maquis, la pelouse rase... ou le désert !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4fc28cc-a32d-4118-8073-ecd3ff0bd32c",
                        "source_entry_id": "bc55a7bc-f2c6-3dd2-b284-35a37bf9da46",
                        "source_sense_id": "67ab641b-f563-3013-99ca-274e9bfe0e4f",
                        "source_sense_description": "in a spontaneous manner",
                        "target_lang_word": "spontan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f09e68c2-e463-324e-9e46-9bad694436be",
                                        "entry_id": "248bb0de-0202-30d1-9b92-3cd4f0eb746c",
                                        "glosses": [
                                            "aus eigenem inneren Antrieb, ohne Planung, ohne lange Überlegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d58f6126-68f4-4dd6-80e4-3a824d2774ad",
                                                "sense_id": "f09e68c2-e463-324e-9e46-9bad694436be",
                                                "text": "Am letzten Urlaubstag entschlossen sie sich spontan, noch eine Woche länger zu bleiben."
                                            },
                                            {
                                                "example_id": "fce879fa-bab1-4cf7-9633-76d871361217",
                                                "sense_id": "f09e68c2-e463-324e-9e46-9bad694436be",
                                                "text": "„Was tut nun Lourdes mit den Massen? Es versetzt zunächst die fernen Kranken durch seine Reputation, die künstlich genährt und gesteigert wird, in sanften Schwindel. Die Wallfahrten sind ja nicht spontan, sondern sorgfältig organisiert, ihre Beteiligung ist häufig unter mehr oder minder starker Beeinflussung erfolgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fd01d46-4b4c-3a18-9bae-a8aaf66fb625",
                                        "entry_id": "248bb0de-0202-30d1-9b92-3cd4f0eb746c",
                                        "glosses": [
                                            "ohne äußere Anregung, ohne äußeren Einfluss, aus sich selbst heraus"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "726b8f8d-eb51-4ce4-8263-1a2e6a2ea51b",
                                                "sense_id": "8fd01d46-4b4c-3a18-9bae-a8aaf66fb625",
                                                "text": "Die Hälfte aller befruchteten Eizellen geht spontan zu Grunde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3656400c-b28c-452a-a0c5-74c75677b39a",
