                            {
                                "example_id": "412870c7-a10b-4ed5-90c1-93788aeeabeb",
                                "sense_id": "4f861385-a3a0-325f-8717-05e50f8a6ff6",
                                "text": "Вре́мя, каза́лось, останови́лось для них; никако́е «но́вшевство» не проника́ло за грани́цу их «оа́зиса».",
                                "translation": "Time seemed to have stood still for them; no 'novelty' had crossed the boundary of their 'oasis.'",
                                "english": "Time seemed to have stood still for them; no 'novelty' had crossed the boundary of their 'oasis.'"
                            }
                        ]
                    }
