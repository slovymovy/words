                                                "example_id": "a2004020-56e2-447d-857f-9106ca96ebf1",
                                                "sense_id": "0a273014-23b6-3553-baca-fcc508f2a948",
                                                "text": "Vaag!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb8b6d6-27c3-3c66-9059-d3adf4707c65",
                                        "entry_id": "68fe5720-3b5b-3184-96df-b451a1227b2a",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van vagen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5089f9da-2115-40c2-87eb-0297fd71a137",
                                                "sense_id": "2bb8b6d6-27c3-3c66-9059-d3adf4707c65",
                                                "text": "Vaag je?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5df89215-10fb-40fb-a6d0-258595dcb466",
                        "source_entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                        "source_sense_description": "in a vague manner",
                        "target_lang_word": "vaguement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaguement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                        "entry_id": "3960fb2a-f770-38c0-a347-4d288b510134",
                                        "glosses": [
                                            "D’une manière vague."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c254b2-456e-49bc-822a-0b72eed03d12",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Tous les habitants de la factorerie, hommes et femmes, s'y trouvaient rassemblés, vaguement éclairés par la lumière des lampes."
                                            },
                                            {
                                                "example_id": "4e8ce6fc-03bb-4612-a619-9c15a9ee1bdc",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Elle n'avait commencé à penser, très vaguement, que du jour où elle avait aimé."
                                            },
                                            {
                                                "example_id": "690f8b6d-6431-41c3-97d4-9850f685b6b3",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Il labourait dans le parc et cultivait assez de terrain pour nourrir ses chevaux et ses gens ; il y bottelait trois cents milliers de foin excellent, et n’en comptait que cent, en s’autorisant d’une permission vaguement accordée par le comte."
                                            },
                                            {
                                                "example_id": "63145d4e-3eff-43d9-9d65-0692bf4c076b",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "A l'infini, les sables ardents sont bosselés de touffes pâles, vaguement teintées d'un mélange de vert, de bleu et de gris, — les touffes de hâd arrondies, basses, compactes, hérissées de menus piquants."
                                            },
                                            {
                                                "example_id": "d02af268-22fa-4708-822c-217fd8bf499b",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Le traité avait pour objectif de délimiter « les régions sous-marines » du golfe de Paria qui sépare Trinité-et-Tobago, alors colonie britannique, du Venezuela. L'accord fixait ainsi trois segments depuis les bouches du Dragon jusqu'aux bouches du Serpent. Les surfaces délimitées respectaient vaguement ce qu'aurait pu donner une ligne d’équidistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597082d4-fac4-412e-934c-d236d961e2c0",
                        "source_entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                        "source_sense_description": "in a vague manner",
                        "target_lang_word": "vage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                        "entry_id": "5b9b9203-1701-32a7-adc9-ac59443c80f4",
                                        "glosses": [
                                            "schwer erkennbar oder vorstellbar, ungewiss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "349794b3-80bc-4d5c-ac7e-7cbae7f195ee",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Bevor es losging, hatten wir nur eine sehr vage Vorstellung davon, was uns erwarten würde."
                                            },
                                            {
                                                "example_id": "a9fdfcc5-e307-4656-9802-8065360321da",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Kurt Kalb hatte ihm tags zuvor einen vagen Tipp gegeben – und Jeannée witterte die Sensation."
                                            },
                                            {
                                                "example_id": "4b3eee3c-9b29-44ec-8c77-4b1272b9859a",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Studie zeigt: Die EU vertraut bei ihrem Pipeline-Plan auf vage Versprechungen."
                                            },
                                            {
                                                "example_id": "2af8a12d-bb13-483e-a667-b176964be07a",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Das Christentum selbst liegt darüber hinaus: das heißt, vage Begriffe über ein gescheitertes historisches Ereignis wurden von Männern herumgetragen, die dabei beteiligt gewesen waren."
                                            },
                                            {
                                                "example_id": "a99343c7-7827-45d1-9d8b-7e183450e6ae",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Und auf die vage Möglichkeit hin, sie zu sehen, fuhr ich in derselben Nacht meine besten Pferde tot…"
                                            },
                                            {
                                                "example_id": "5077147d-e628-4f62-b7d8-e5875eb7ad8b",
                                                "sense_id": "4ce5ddc0-5140-316e-acb2-c348281fbc78",
                                                "text": "Eine vage Erinnerung, daß dies die gewöhnliche Formel sei, welche die Polizei gegen ihre unfreiwilligen Klienten anwendet, veranlaßte Mr. Harthouse, den Kellner trotzig entrüstet zu fragen, was zum Teufel er mit dem »verlangt« sagen wolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04e4f412-b756-3729-a152-e17c7ddeca44",
                                        "entry_id": "5b9b9203-1701-32a7-adc9-ac59443c80f4",
                                        "glosses": [
                                            "zwischen wahr und unwahr liegend"
                                        ],
                                        "tags": [
                                            "Fuzzylogik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7dd32f0-3a2d-423e-9920-cb9bd15d3357",
                                                "sense_id": "04e4f412-b756-3729-a152-e17c7ddeca44",
                                                "text": "Fuzzy bedeutet unscharf, vage oder kraus und klingt dem Englisch sprechenden Menschen nicht richtig gut im Ohr. … In den siebziger Jahren erdachte er dann die Fuzzy-Logik, die auch mit vagen Prämissen auskommt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
