                ],
                "senses": [
                    {
                        "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                        "entry_id": "4fef0873-1f54-3389-9852-5dc9e417b4af",
                        "glosses": [
                            "Geländer an einer Treppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16dbfe19-4453-46ea-b843-db8668183f45",
                                "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                                "text": "Nimm das Treppengeländer, um dich abzustützen."
                            },
                            {
                                "example_id": "122d9d4f-e10f-47ae-9a2b-be576911b99e",
                                "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                                "text": "„Ende März kriegten wir endlich Strom, das Treppengeländer und alle Lichtschachtgitter, und ich kriegte überall Pickel.“"
                            },
                            {
                                "example_id": "b7f35334-fc15-4a64-ba1e-411336769d6e",
                                "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                                "text": "„Er setzte sich auf eine Treppenstufe, steckte die Hand und den Arm durch das Gitter des Treppengeländers und forderte sie auf, seinen Unterarm mit beiden Händen festzuhalten, er wollte den ausgekugelten Arm mit einem Ruck zurück ins Gelenk setzen.“"
                            },
                            {
                                "example_id": "23e8b61c-9d91-4c26-bf83-2eddaa89cb3b",
                                "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                                "text": "„Währenddessen verschmierte sich Tante Praskovia, aufs Treppengeländer der ersten Etage gestützt, ihr Gesicht langsam mit Tränen und behauptete gurrend wie eine kranke Taube, daß ihre Gebete uns gerettet hätten.“"
                            },
                            {
                                "example_id": "b180832b-3143-451e-b21e-f888e3931594",
                                "sense_id": "d9fa89b8-56cd-3fff-9467-148d0985b0fe",
                                "text": "„Man sah an den Knaufen der Treppengeländer, an den Resten von bunten Fliesen, an den abgeschabten Wappensteinen, daß das Haus einstmals einem vornehmen Mann gehört hatte, einem Kaufmann oder Seefahrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
