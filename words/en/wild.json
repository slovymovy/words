    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5b97eb90-ffe0-3e17-bb04-19805a284e4f",
                    "sense_definition": "Living in a natural state and not domesticated or tamed by humans.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a herd of <w>wild</w> horses running across the open plains during our trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки мы видели табун <w>диких</w> лошадей, скачущих по открытым равнинам."
                            }
                        },
                        {
                            "text": "It is important to protect <w>wild</w> animals and their natural habitats from destruction.",
                            "target_lang_translations": {
                                "ru": "Важно защищать <w>диких</w> животных и их естественную среду обитания от разрушения."
                            }
                        }
                    ],
                    "synonyms": [
                        "untamed",
                        "undomesticated",
                        "feral"
                    ],
                    "antonyms": [
                        "tame"
                    ],
                    "common_phrases": [
                        "wild animals",
                        "wild flowers",
                        "wild horses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живущий в естественной среде, не одомашненный и не прирученный человеком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "о животных и растениях"
                            },
                            {
                                "target_lang_word": "неприрученный",
                                "target_lang_sense_clarification": "не знающий человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "497a1499-66f5-3b6e-9080-5639d6cdcda2",
                    "sense_definition": "Lacking discipline or restraint; characterized by rowdy or unruly behavior.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors complained about the <w>wild</w> parties that lasted until four in the morning.",
                            "target_lang_translations": {
                                "ru": "Соседи жаловались на <w>буйные</w> вечеринки, которые продолжались до четырех утра."
                            }
                        },
                        {
                            "text": "He was known for his <w>wild</w> behavior during his college years.",
                            "target_lang_translations": {
                                "ru": "Он был известен своим <w>диким</w> поведением в студенческие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "unruly",
                        "rowdy",
                        "unrestrained"
                    ],
                    "antonyms": [
                        "tame"
                    ],
                    "common_phrases": [
                        "wild party",
                        "wild night",
                        "run wild"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный дисциплины или сдержанности; характеризующийся шумным или непокорным поведением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "шумный и неспокойный"
                            },
                            {
                                "target_lang_word": "безудержный",
                                "target_lang_sense_clarification": "не знающий границ"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "неистовый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c03462d5-0e84-3e87-842b-1b1fa8f56d25",
                    "sense_definition": "Intense, extreme, or uncontrolled, especially regarding emotions or ideas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>wild</w> imagination and often wrote stories about distant planets.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>безумное</w> воображение, и она часто писала рассказы о далеких планетах."
                            }
                        },
                        {
                            "text": "The news filled him with <w>wild</w> excitement about the future.",
                            "target_lang_translations": {
                                "ru": "Эта новость наполнила его <w>неистовым</w> восторгом по поводу будущего."
                            }
                        }
                    ],
                    "synonyms": [
                        "intense",
                        "uninhibited",
                        "extravagant"
                    ],
                    "common_phrases": [
                        "wild imagination",
                        "wild guess",
                        "wild dreams"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интенсивный, крайний или неконтролируемый, особенно в отношении эмоций или идей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "о воображении или идеях"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "крайне сильный"
                            },
                            {
                                "target_lang_word": "неистовый",
                                "target_lang_sense_clarification": "о чувствах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0332a6-eec1-319f-b41b-f7fd3b998aff",
                    "sense_definition": "Looking messy, untidy, or disheveled.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>wild</w> hair made him look like he had just woken up.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>растрепанных</w> волос он выглядел так, будто только что проснулся."
                            }
                        },
                        {
                            "text": "After the long hike through the wind, her appearance was quite <w>wild</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого похода на ветру ее вид был довольно <w>диким</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disheveled",
                        "untidy",
                        "messy"
                    ],
                    "common_phrases": [
                        "wild hair",
                        "wild look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядящий неопрятно, беспорядочно или растрепанно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрепанный",
                                "target_lang_sense_clarification": "о волосах или виде"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "неухоженный"
                            },
                            {
                                "target_lang_word": "всклокоченный",
                                "target_lang_sense_clarification": "о прическе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad72d632-4318-3e70-8bc0-ea733351afe9",
                    "sense_definition": "Very enthusiastic or excited about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enthusiasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not <w>wild</w> about the idea of working on the weekend.",
                            "target_lang_translations": {
                                "ru": "Я не <w>в восторге</w> от идеи работать в выходные."
                            }
                        },
                        {
                            "text": "The crowd went <w>wild</w> when the band finally started playing their hit song.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>обезумела</w> от восторга, когда группа наконец начала играть свой хит."
                            }
                        }
                    ],
                    "synonyms": [
                        "enthusiastic",
                        "eager",
                        "crazy"
                    ],
                    "common_phrases": [
                        "go wild",
                        "wild about"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the negative 'not wild about' or 'go wild'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень воодушевленный или взволнованный чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в восторге",
                                "target_lang_sense_clarification": "очень нравится"
                            },
                            {
                                "target_lang_word": "без ума",
                                "target_lang_sense_clarification": "сильно увлечен"
                            },
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "о восторге толпы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d10d0ca3-79e7-3635-8a43-f3032d81441d",
                    "sense_definition": "Very inaccurate or far from the intended target.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>wild</w> guess turned out to be surprisingly close to the actual number.",
                            "target_lang_translations": {
                                "ru": "Его догадка <w>наобум</w> оказалась на удивление близкой к реальному числу."
                            }
                        },
                        {
                            "text": "The striker took a <w>wild</w> shot that missed the goal by several yards.",
                            "target_lang_translations": {
                                "ru": "Нападающий нанес <w>шальной</w> удар, который прошел в нескольких ярдах от ворот."
                            }
                        }
                    ],
                    "synonyms": [
                        "inaccurate",
                        "random"
                    ],
                    "common_phrases": [
                        "wild guess",
                        "wild shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень неточный или далекий от намеченной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наобум",
                                "target_lang_sense_clarification": "о догадке"
                            },
                            {
                                "target_lang_word": "шальной",
                                "target_lang_sense_clarification": "о выстреле или ударе"
                            },
                            {
                                "target_lang_word": "пальцем в небо",
                                "target_lang_sense_clarification": "о крайне неточной попытке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "451cac42-4784-3c52-b555-3791839eb8b1",
                    "sense_definition": "Extremely impressive, unusual, or hard to believe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>wild</w> to think that we have known each other for twenty years.",
                            "target_lang_translations": {
                                "ru": "Просто <w>безумие</w> думать о том, что мы знаем друг друга уже двадцать лет."
                            }
                        },
                        {
                            "text": "That story you told about the mountain lion is absolutely <w>wild</w>.",
                            "target_lang_translations": {
                                "ru": "Та история, которую ты рассказал про пуму, просто <w>дикая</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "amazing",
                        "unbelievable",
                        "crazy"
                    ],
                    "common_phrases": [
                        "that is wild"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in modern informal speech to mean 'crazy' or 'amazing'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно впечатляющий, необычный или трудноповеримый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "невероятный"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "странный или поразительный"
                            },
                            {
                                "target_lang_word": "обалденный",
                                "target_lang_sense_clarification": "сленг: крутой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b1c466-e3a3-3e4f-8314-9dcb48448cdd",
                    "sense_definition": "In games or computing, having the power to represent any other value or character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this version of poker, the deuces are <w>wild</w> and can be any suit.",
                            "target_lang_translations": {
                                "ru": "В этой версии покера двойки являются <w>джокерами</w> и могут заменять любую масть."
                            }
                        },
                        {
                            "text": "You can use a <w>wild</w> character to search for multiple file names at once.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>универсальный</w> символ для поиска нескольких имен файлов одновременно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jokers are wild",
                        "wild card"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in gaming and technical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В играх или вычислениях: имеющий право заменять любое другое значение или символ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джокер",
                                "target_lang_sense_clarification": "в картах"
                            },
                            {
                                "target_lang_word": "универсальный",
                                "target_lang_sense_clarification": "о символе подстановки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8d66363-d2f3-38a7-a092-c55e25b9e172",
                    "sense_definition": "A natural, undomesticated state or environment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nature_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary shows how these predators survive in the <w>wild</w>.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм показывает, как эти хищники выживают в <w>дикой природе</w>."
                            }
                        },
                        {
                            "text": "After being rehabilitated at the zoo, the eagle was released back into the <w>wild</w>.",
                            "target_lang_translations": {
                                "ru": "После реабилитации в зоопарке орла выпустили обратно на <w>волю</w>."
                            }
                        }
                    ],
                    "synonyms": [
