                "senses": [
                    {
                        "sense_id": "d43b0176-aa95-38f9-95c9-901fa4fec53c",
                        "entry_id": "a87e344e-959b-376b-afe0-641cbbf2e51a",
                        "glosses": [
                            "Étude des textes et des doctrines de Karl Marx."
                        ],
                        "tags": [
                            "Marxism"
                        ],
                        "examples": [
                            {
                                "example_id": "08c27870-cfab-47ce-ad0f-6dbf66b447ed",
                                "sense_id": "d43b0176-aa95-38f9-95c9-901fa4fec53c",
                                "text": "Dans tout ce qui précède, nous n'avons fait référence qu'avec parcimonie aux études, interprétations, polémiques internes à ce vaste champ que l'on peut nommer « marxologie »."
                            },
                            {
                                "example_id": "96b2f5af-6fa4-4016-8b1c-9e1751cdecae",
                                "sense_id": "d43b0176-aa95-38f9-95c9-901fa4fec53c",
                                "text": "La marxologie occidentale s'ouvre par une question de Marx : qu'est-ce que la valeur ?"
                            },
                            {
                                "example_id": "d82d4cda-1525-4c44-ae34-ced495815bbd",
                                "sense_id": "d43b0176-aa95-38f9-95c9-901fa4fec53c",
                                "text": "[…] mais de l'autre côté il y a, de nos jours, différentes « marxologies », chacune reflétant les vues de ses promoteurs ou annonciateurs, concernant les conceptions historiques, philosophiques, économiques et sociologiques, etc., de Marx."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39af84cc-5bab-4450-9d9f-630b6e4724a1",
                        "source_entry_id": "a87e344e-959b-376b-afe0-641cbbf2e51a",
                        "source_sense_id": "d43b0176-aa95-38f9-95c9-901fa4fec53c",
                        "target_lang_word": "Marxology",
