                            },
                            {
                                "target_lang_word": "список слов",
                                "target_lang_sense_clarification": "перечень слов для изучения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "词汇表",
                                "target_lang_sense_clarification": "书后附带的词汇列表"
                            },
                            {
                                "target_lang_word": "生词表",
                                "target_lang_sense_clarification": "供学习用的词汇清单"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7c80cb-75b3-371b-926a-fe32eb2416a4",
                    "sense_definition": "The words of a language collectively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lexicon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vocabulary</w> of any language is influenced by contacts with other cultures.",
                            "target_lang_translations": {
                                "ru": "На <w>лексику</w> любого языка влияют контакты с другими культурами.",
                                "zh": "任何语言的<w>词汇</w>都会受到与其他文化接触的影响。"
                            }
                        },
                        {
                            "text": "English has a very large and diverse <w>vocabulary</w> compared to some other languages.",
                            "target_lang_translations": {
                                "ru": "В английском языке очень обширный и разнообразный <w>словарный состав</w> по сравнению с некоторыми другими языками.",
                                "zh": "与其他一些语言相比，英语拥有非常庞大且多样的<w>词汇</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "word-stock"
                    ],
                    "common_phrases": [
                        "English vocabulary",
                        "rich vocabulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность всех слов определенного языка.",
                        "zh": "某种语言中所有词汇的总和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лексика",
                                "target_lang_sense_clarification": "совокупность слов языка"
                            },
                            {
                                "target_lang_word": "словарный состав",
                                "target_lang_sense_clarification": "полный набор слов языка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "词汇",
                                "target_lang_sense_clarification": "语言的全部词汇"
                            },
                            {
                                "target_lang_word": "词汇系统",
                                "target_lang_sense_clarification": "语言的词汇构成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf2e88e3-bd36-31a9-ab09-6635da9d38a2",
                    "sense_definition": "The stock of words used in a particular field or subject.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lexicon_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vocabulary</w> of social sciences is often incomprehensible to ordinary people.",
                            "target_lang_translations": {
                                "ru": "<w>Терминология</w> общественных наук часто непонятна обычным людям.",
                                "zh": "社会科学的<w>术语</w>对普通人来说往往难以理解。"
                            }
                        },
                        {
                            "text": "You need to learn the technical <w>vocabulary</w> to communicate effectively in medicine.",
                            "target_lang_translations": {
                                "ru": "Вам нужно изучить техническую <w>терминологию</w>, чтобы эффективно общаться в сфере медицины.",
                                "zh": "你需要学习医学领域的<w>专业词汇</w>才能进行有效沟通。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "technical vocabulary",
                        "scientific vocabulary",
                        "specialized vocabulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор слов и терминов, используемых в определенной области знаний или предмете.",
                        "zh": "特定领域或学科中使用的词汇和术语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терминология",
                                "target_lang_sense_clarification": "совокупность терминов"
                            },
                            {
                                "target_lang_word": "специальная лексика",
                                "target_lang_sense_clarification": "профессиональный язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "术语",
                                "target_lang_sense_clarification": "专业领域的专门用语"
                            },
                            {
                                "target_lang_word": "专业词汇",
                                "target_lang_sense_clarification": "特定学科的用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4af2361-f940-3fd5-beb4-fead96b19d03",
                    "sense_definition": "A range of artistic or stylistic forms or techniques.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "style_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect used a modern <w>vocabulary</w> of glass and steel for the new building.",
                            "target_lang_translations": {
                                "ru": "Архитектор использовал современный <w>язык</w> стекла и стали для нового здания.",
                                "zh": "建筑师为这座新建筑运用了玻璃和钢材的现代设计<w>语言</w>。"
                            }
                        },
                        {
                            "text": "Her dance <w>vocabulary</w> includes movements from both ballet and hip-hop.",
                            "target_lang_translations": {
                                "ru": "Её танцевальная <w>лексика</w> включает движения как из балета, так и из хип-хопа.",
                                "zh": "她的舞蹈<w>表现手法</w>融合了芭蕾和嘻哈的动作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "visual vocabulary",
                        "design vocabulary",
                        "musical vocabulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор художественных форм, приемов или стилистических средств.",
                        "zh": "一系列艺术或风格的表现形式、技巧或手段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язык",
                                "target_lang_sense_clarification": "система выразительных средств"
                            },
                            {
                                "target_lang_word": "арсенал",
                                "target_lang_sense_clarification": "набор приемов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语言",
                                "target_lang_sense_clarification": "艺术表现手法"
                            },
                            {
                                "target_lang_word": "表现手法",
                                "target_lang_sense_clarification": "艺术创作的技巧集合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
