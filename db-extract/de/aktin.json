                                "target_senses": [
                                    {
                                        "sense_id": "4921305b-a8f8-3190-b5a4-3a049a1900c8",
                                        "entry_id": "8e1a655c-7a7e-34e5-99a2-7e990a115cab",
                                        "glosses": [
                                            "A globular structural protein that polymerizes in a helical fashion to form an actin filament (or microfilament)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1f20e5-2edc-416d-8f03-9e0e3aca952c",
                                                "sense_id": "4921305b-a8f8-3190-b5a4-3a049a1900c8",
                                                "text": "2012, Elaine N. Marieb & Katja Hoehn, Human Anatomy & Physiology, 8th ed., chapter 9 \"Muscles and Muscle Tissue\", page 281.\nActin has kidney-shaped polypeptide subunits, called globular actin or G actin, which bear the active sites to which the myosin heads attach during contraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabbe8cf-3adc-3c5c-bc7e-2296540f3fcc",
                                        "entry_id": "8e1a655c-7a7e-34e5-99a2-7e990a115cab",
                                        "glosses": [
                                            "One of the six isoforms of actin."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c32d09ae-509c-4381-8a48-5fa4871bbbc3",
                        "source_entry_id": "35477853-0680-332b-b9e7-cbfb8207f572",
                        "source_sense_id": "44c5c384-6521-3973-8510-c483642ed1ea",
                        "source_sense_description": "Biochemie, Molekularbiologie: ein Eiweißkörper im Muskel",
                        "target_lang_word": "actine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5edec02e-8e46-3211-a795-5af0426069e2",
                                        "entry_id": "2758f989-839e-3e06-bcae-47d378d6a154",
                                        "glosses": [
                                            "Protéine biglobulaire participant aux mouvements des cellules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca2f66b-7a03-4497-97b5-0980954d3176",
                                                "sense_id": "5edec02e-8e46-3211-a795-5af0426069e2",
                                                "text": "La plus abondante des protéines se fixant à l’actine est la thymosine, une petite protéine de 5 kDa, qui s’avère la principale responsable de la séquestration des protomères d’actine et, ce faisant, de leur assemblage en filament."
                                            },
                                            {
                                                "example_id": "723404df-3305-4c12-9de8-246af952506f",
                                                "sense_id": "5edec02e-8e46-3211-a795-5af0426069e2",
                                                "text": "La vitesse de raccourcissement du muscle est déterminée par la vitesse des cycles des ponts d’actine - myosine."
                                            },
                                            {
                                                "example_id": "20d23ab9-76a6-4906-a539-6ee9b3044573",
                                                "sense_id": "5edec02e-8e46-3211-a795-5af0426069e2",
                                                "text": "Mais quand j’ai déshybridé la membrane pour hybrider l’actine, à la révélation c’était la catastrophe, j’ai eu presque pour tous les puits des mi bandes, comme si les puits étaient remplis qu’à moitié avec les protéines…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f1314dc-2e83-4b1c-966c-64d9abb72cfc",
                        "source_entry_id": "35477853-0680-332b-b9e7-cbfb8207f572",
