                        ],
                        "form": "gildes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f113dfd-14e3-3508-aec0-3c5e5d92e38b",
                        "entry_id": "2d881d6f-5f31-3a7c-b7aa-519b74e50da1",
                        "glosses": [
                            "een middeleeuwse beroepsorganisatie, meest op monopolie en handhaven van bepaalde standaarden gericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3af22b-a65c-4d9e-88b2-8f95e3d720c6",
                                "sense_id": "4f113dfd-14e3-3508-aec0-3c5e5d92e38b",
                                "text": "Het gilde heeft het geregeld, de burgemeesters hebben toestemming gegeven."
                            },
                            {
                                "example_id": "95cca7de-1d89-4c00-826f-eb97e09f227a",
                                "sense_id": "4f113dfd-14e3-3508-aec0-3c5e5d92e38b",
                                "text": "Geen enkel gilde zou haar willen hebben, behalve de naaisters of de stinkende turfdragers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c8be6fc-1a9c-4974-a1eb-a296f3ef781a",
                        "source_entry_id": "2d881d6f-5f31-3a7c-b7aa-519b74e50da1",
                        "source_sense_id": "4f113dfd-14e3-3508-aec0-3c5e5d92e38b",
                        "target_lang_word": "corporation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corporation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd88e9c-d761-3239-a2dc-6e713b7bfe48",
                                        "entry_id": "539dd610-5f8b-3fc5-a910-0bcfd3146a7d",
                                        "glosses": [
                                            "A body corporate, created by law or under authority of law, having a continuous existence independent of the existences of its members, and powers and liabilities distinct from those of its members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4456da40-f2a6-4b60-a9f8-79b97d379887",
                                                "sense_id": "7cd88e9c-d761-3239-a2dc-6e713b7bfe48",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5014793a-9140-3f80-b351-b51de9e11e05",
                                        "entry_id": "539dd610-5f8b-3fc5-a910-0bcfd3146a7d",
                                        "glosses": [
                                            "The municipal governing body of a borough or city."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0d71e6c-e64b-3d70-b477-3c5e0549a60d",
                                        "entry_id": "539dd610-5f8b-3fc5-a910-0bcfd3146a7d",
                                        "glosses": [
                                            "In Fascist Italy, a joint association of employers' and workers' representatives."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d312fc44-6434-3b38-bb32-340ba5b6ebf7",
                                        "entry_id": "539dd610-5f8b-3fc5-a910-0bcfd3146a7d",
                                        "glosses": [
                                            "A protruding belly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c262fc50-4aa1-4546-9e25-56c4f1b47caf",
                                                "sense_id": "d312fc44-6434-3b38-bb32-340ba5b6ebf7",
                                                "text": "[The Rector], looming large in full canonicals, walking, as became a beneficed priest, under the canopy of a shovel-hat, with the dignity of an ample corporation, the embellishment of the squarest and vastest of black coats, and the support of the stoutest of gold-headed canes."
                                            },
                                            {
                                                "example_id": "2971a702-e989-4902-a1a8-11d0f9a9ff13",
                                                "sense_id": "d312fc44-6434-3b38-bb32-340ba5b6ebf7",
                                                "text": "'You'd be surprised,' said Stanley, as though this were intensely interesting, 'at the number of chaps at the club who have got a corporation.'"
                                            },
                                            {
                                                "example_id": "f270b9df-bd9d-431c-8165-685be1273970",
                                                "sense_id": "d312fc44-6434-3b38-bb32-340ba5b6ebf7",
                                                "text": "He was a big chap with a corporation already, and a flat face rather like Dora's, and he had a thin black moustache."
                                            },
                                            {
                                                "example_id": "24d279ff-ae67-4d23-9ce2-aba8babf1842",
                                                "sense_id": "d312fc44-6434-3b38-bb32-340ba5b6ebf7",
                                                "text": "The sergeant was a goner. There was only one way to save him, and he threw himself on top, hurling the man to the ground. He lay covering his corporation with as much as his body and limbs would allow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aee0c65b-7b59-4c71-983f-466bfa1c7beb",
                        "source_entry_id": "2d881d6f-5f31-3a7c-b7aa-519b74e50da1",
                        "source_sense_id": "4f113dfd-14e3-3508-aec0-3c5e5d92e38b",
                        "target_lang_word": "gild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b058303f-2ff1-3bc0-8797-fdcd76b3f580",
                                        "entry_id": "acdf458e-01c1-3402-ac54-7ea163424d2d",
                                        "glosses": [
                                            "To cover with a thin layer of gold; to cover with gold leaf."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e3d6e7-e016-49ad-ba05-157f5bbb64c8",
                                                "sense_id": "b058303f-2ff1-3bc0-8797-fdcd76b3f580",
                                                "text": "High above the city, on a tall column, stood the statue of the Happy Prince. He was gilded all over with thin leaves of fine gold, for eyes he had two bright sapphires, and a large red ruby glowed on his sword-hilt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bcd47a6-e474-32aa-bfb5-7ac4b7a2131e",
                                        "entry_id": "acdf458e-01c1-3402-ac54-7ea163424d2d",
                                        "glosses": [
                                            "To adorn."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b06a4f-a331-4966-8f6c-7b06308e7261",
                                                "sense_id": "1bcd47a6-e474-32aa-bfb5-7ac4b7a2131e",
                                                "text": "I will make fast the doors, and gild myself\n With some more ducats, and be with you straight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbba27b-13cd-3a01-82f1-32f795d6ecbb",
                                        "entry_id": "acdf458e-01c1-3402-ac54-7ea163424d2d",
                                        "glosses": [
                                            "To decorate with a golden surface appearance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46bddd00-06fb-4012-a689-c7f1261178fa",
                                                "sense_id": "ebbba27b-13cd-3a01-82f1-32f795d6ecbb",
                                                "text": "Gild the entire outside with beaten egg yolk, and sprinkle it with grated parmesan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef0db54-8a9d-3b2a-ab63-fd9fbc971291",
                                        "entry_id": "acdf458e-01c1-3402-ac54-7ea163424d2d",
                                        "glosses": [
                                            "To give a bright or pleasing aspect to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0770c4a8-7bf1-4368-8e80-cb4994777b1c",
                                                "sense_id": "0ef0db54-8a9d-3b2a-ab63-fd9fbc971291",
                                                "text": "When sparkling stars twire not, thou gild'st the even."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6097775f-1b57-3e1c-9e29-327b5b1a557a",
                                        "entry_id": "acdf458e-01c1-3402-ac54-7ea163424d2d",
                                        "glosses": [
                                            "To give a brilliant colour or flush to one's face; (also) to make appear drunk."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56bc6a67-14ef-41a7-9aa5-c3fad21efdc4",
                                                "sense_id": "6097775f-1b57-3e1c-9e29-327b5b1a557a",
                                                "text": "[Alonso] And Trinculo is reeling-ripe: vvhere sſhould they\nFinde this grand Liquor that hath gilded'em?\nHovv cam'ſt thou in this pickle?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34eb7ef4-f9e4-35af-b50f-0599845e3c51",
                                        "entry_id": "786d53d7-a625-3629-acd4-f6c780a6d7ba",
                                        "glosses": [
                                            "Obsolete spelling of guild."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77f5c4a-df9d-4367-9d3f-46197ed09ffe",
                                                "sense_id": "34eb7ef4-f9e4-35af-b50f-0599845e3c51",
                                                "text": "No trade gild might be started without the consent of the whole body of hanasters, who would insist that the regulations were not harmful to the burgesses as a whole; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
