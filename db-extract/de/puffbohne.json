                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "féverole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fee39877-a92d-3b03-8590-ffccadc718b1",
                                        "entry_id": "0bfed740-2277-3d6a-a805-4af0c53fd76c",
                                        "glosses": [
                                            "Nom usuel de Vicia faba, plante herbacée, annuelle de la famille des Fabaceae (Fabacées), cultivées pour leurs graines comestibles données aux bovins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ba0f7d-3d32-4003-b04f-f52ed23ce5a3",
                                                "sense_id": "fee39877-a92d-3b03-8590-ffccadc718b1",
                                                "text": "Les céréales secondaires et les protéagineux (féverole, pois) sont principalement destinés à l'élevage, en dehors du blé qui représente 15 % au maximum de la sole."
                                            },
                                            {
                                                "example_id": "dd2c8318-90a2-4c62-90ff-81a21d402c31",
                                                "sense_id": "fee39877-a92d-3b03-8590-ffccadc718b1",
                                                "text": "Les Gaulois cultivent essentiellement les céréales et les légumineuses. Parmi les premières, les plus courantes sont différentes sortes de blé ([…]), l'orge, l'avoine et le millet. Les secondes sont la lentille, le pois, la féverole, l’ers et la vesce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cc8ca1-881a-3611-8632-f6f4568c4b90",
                                        "entry_id": "0bfed740-2277-3d6a-a805-4af0c53fd76c",
                                        "glosses": [
                                            "Nom donné à la graine comestible de cette plante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11201aef-8ae7-4e22-94c2-cf5629c0bebc",
                        "source_entry_id": "672af783-97c1-36c6-be63-86d8bac8c99b",
                        "source_sense_id": "2cab267f-3e95-3384-a43c-c1ebd55e6f11",
                        "target_lang_word": "féverolle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
