                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a17818b-9fc0-423f-aed1-0a09b9c9ec99",
                                "sense_id": "5ead1b34-060c-3ad6-81cb-4887a98f027a",
                                "text": "Drie nachten bleef ik in deze hemelse tuin en genoot van films en gesprekken met de andere hikers."
                            }
                        ]
                    },
                    {
                        "sense_id": "467ad0f5-a258-3bfc-80af-7ddd7dd9e5c6",
                        "entry_id": "b74df064-b111-3f11-9666-48d605dd45a0",
                        "glosses": [
                            "lekker, zalig, verrukkelijk, heerlijk"
                        ],
                        "tags": [
