                            },
                            {
                                "target_lang_word": "фасовочный автомат",
                                "target_lang_sense_clarification": "оборудование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d054584e-f784-38e1-8999-7f6e5a7a71b5",
                    "sense_definition": "A touring motorcycle equipped with saddlebags for carrying luggage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motorcycle_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rode his custom <w>bagger</w> across the country, enjoying the extra storage space for his gear.",
                            "target_lang_translations": {
                                "ru": "Он проехал через всю страну на своем кастомном <w>бэггере</w>, наслаждаясь дополнительным местом для снаряжения."
                            }
                        },
                        {
                            "text": "Many riders prefer a comfortable <w>bagger</w> for long-distance highway cruising.",
                            "target_lang_translations": {
