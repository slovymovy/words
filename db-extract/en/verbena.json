                        "entry_id": "f7c7d2c0-a711-311e-8b76-c238253f30c0",
                        "glosses": [
                            "Verbena, a genus of herbaceous plants of which several species are extensively cultivated for the great beauty of their flowers; vervain."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "527f7818-ffb7-439e-9c14-663ab98aac49",
                                "sense_id": "a53e306e-2997-38aa-9def-979b5ffb75fa",
                                "text": "Linda pulled a piece of verbena and crumpled it, and held her hands to her mother. -"
                            },
                            {
                                "example_id": "5228fc05-83d3-4c9e-a837-492b78399647",
                                "sense_id": "a53e306e-2997-38aa-9def-979b5ffb75fa",
                                "text": "Hidden behind a large stone urn full of verbena, Dottie watched as her enemy greeted Johnny at the door."
                            }
                        ]
