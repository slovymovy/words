                                        "entry_id": "56330617-ce7d-3a2f-bf8c-ad25d89f2cef",
                                        "glosses": [
                                            "Espèce minérale formée d’oxyde de titane de formule TiO₂ avec des traces de fer, d’étain, de vanadium et de niobium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ececf8f-438c-4ca1-aaf5-e2f86a91af13",
                                                "sense_id": "365f8374-f78a-35b0-a19d-74877c1e1820",
                                                "text": "Une étude radiocristallographique en fonction du temps montre que le dioxyde formé est constitué initialement d’un mélange d’anatase et de rutile."
                                            }
                                        ]
                                    }
                                ]
