                    {
                        "translation_id": "95ec39b8-c502-48f9-8658-3aa91177e79a",
                        "source_entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                        "source_sense_description": "experienced person — see also old hand",
                        "target_lang_word": "Haudegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haudegen",
