                "senses": [
                    {
                        "sense_id": "603ee51a-612e-3444-835b-504a0fac5a56",
                        "entry_id": "545da8b5-0f44-3942-9ef7-dc1c6b4d55ae",
                        "glosses": [
                            "Poignée de porte."
                        ],
                        "tags": [
                            "Ardennes",
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ef6332-9b91-4668-aa3c-5a57d6c5c5d4",
                                "sense_id": "603ee51a-612e-3444-835b-504a0fac5a56",
                                "text": "Chaque compartiment est muni, par devant et par derrière, d’une cliche à charnière […]"
                            },
                            {
                                "example_id": "ba8e1d6f-0300-4d94-b660-c5a8049db251",
                                "sense_id": "603ee51a-612e-3444-835b-504a0fac5a56",
                                "text": "Il est certain que si l'on persuade à un « bon sujet » qu'une cliche de porte est magnétisée, au moment où il avancera la main pour ouvrir la porte il tombera en hypnotisme."
                            },
                            {
                                "example_id": "ad9c6132-7185-4da9-994f-8d621fb498c5",
                                "sense_id": "603ee51a-612e-3444-835b-504a0fac5a56",
                                "text": "[…] : Liza, grelottant de frayeur, enfonça la clef, tourna une cliche, et respira un bon coup ; la porte bâilla ; nous étions en extase, dans la mansarde de Paterfamilias."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "52bd5fca-9fc7-301b-b57d-1736d138451f",
                "word": "cliche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e9ba63f-a255-45b5-9927-59e5df8589c7",
