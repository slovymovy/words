                "senses": [
                    {
                        "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                        "entry_id": "538c4c3b-11a0-37fa-8542-224e8232fc5a",
                        "glosses": [
                            "Qui a la nature ou l’apparence du beurre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ac1d06-fe04-42e6-ba85-18215bf1a6e9",
                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                "text": "[…] ces différentes qualités du lait sont relatives à la quantité plus ou moins grande des parties butyreuses, caséeuses et séreuses qui le composent"
                            },
                            {
                                "example_id": "1dc38136-d78c-4d89-8ab4-58697b6def04",
                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                "text": "Il restait au fond du verre une sorte de crème épaisse et presque butyreuse."
                            },
                            {
                                "example_id": "8aebf6b3-5176-404e-bb05-7dde17c26d9d",
                                "sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                                "text": "Ces molécules blanchâtres , confondues avec les parties butyreuses, jaunies par la bile qui domine alors sur la matière , composent ensemble la masse des excremens qui ressemble beaucoup à des œufs brouillés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c381267-3447-4860-9c80-f61a60b4064d",
                        "source_entry_id": "538c4c3b-11a0-37fa-8542-224e8232fc5a",
                        "source_sense_id": "e5011846-577f-363b-8561-26d786cf12b7",
                        "target_lang_word": "buttery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buttery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e55c8ea8-de9b-3d97-b7c4-8cffc5e940a1",
                                        "entry_id": "189c0c57-a238-3d9c-bbad-bb5e52f2e49b",
                                        "glosses": [
                                            "Made with or tasting of butter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014a0404-6a22-4983-ab8b-6b3e424a5fb9",
                                                "sense_id": "e55c8ea8-de9b-3d97-b7c4-8cffc5e940a1",
                                                "text": "The buttery-tasting cookie was actually made with margarine, but you couldn't tell by tasting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7d3057-87c9-3aad-9775-de71e72947f6",
                                        "entry_id": "189c0c57-a238-3d9c-bbad-bb5e52f2e49b",
                                        "glosses": [
                                            "Resembling butter in some way, such as yellow color or smooth texture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026cb03f-dc46-4b63-88a4-e1fcce16eaca",
                                                "sense_id": "ce7d3057-87c9-3aad-9775-de71e72947f6",
                                                "text": "Most libraries have smooth, buttery legatos and exciting, natural-sounding spiccatos."
                                            },
                                            {
                                                "example_id": "ad15c04e-c0ca-48fb-b718-4c5a52d732d9",
                                                "sense_id": "ce7d3057-87c9-3aad-9775-de71e72947f6",
                                                "text": "The old paper was a buttery color you no longer get."
                                            },
                                            {
                                                "example_id": "d754d956-c2c4-4041-b0c1-90fb9e91a03a",
                                                "sense_id": "ce7d3057-87c9-3aad-9775-de71e72947f6",
                                                "text": "While the European pear is, at its finest, buttery and surrenders to the slightest pressure, Asian pears are firm, very crisp, hugely juicy and sweet and, in some cases, highly aromatic – spicy almost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661e7e2e-abac-31e3-8cc5-f98dfcfacddc",
                                        "entry_id": "189c0c57-a238-3d9c-bbad-bb5e52f2e49b",
                                        "glosses": [
                                            "Marked by insincere flattery; obsequious."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9f65bb-bbdb-4d89-924b-41e91860dcc1",
                                                "sense_id": "661e7e2e-abac-31e3-8cc5-f98dfcfacddc",
                                                "text": "He'll be nothing but enraptured with your buttery words ."
                                            },
                                            {
                                                "example_id": "2081139a-9cae-4f14-9752-d9c08906f500",
                                                "sense_id": "661e7e2e-abac-31e3-8cc5-f98dfcfacddc",
                                                "text": "Dawson, for one, is on the right wavelength, goosing his buttery game-show host persona into a caricature of unctuous evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                        "entry_id": "189c0c57-a238-3d9c-bbad-bb5e52f2e49b",
                                        "glosses": [
                                            "Ellipsis of buttery smooth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a67ac466-351b-476a-86a9-ee4448310307",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "(see title)"
                                            },
                                            {
                                                "example_id": "33d0b4f4-a1d1-477e-8af4-75231e04a79e",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "These include improved textures and character models plus a new buttery frame rate as the game gets boosted to 1080p resolution and animation of 60 frames per second. Stylish."
                                            },
                                            {
                                                "example_id": "d4803723-3020-4a9d-af8e-0fc5426daeab",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "I dipped a few of the Nvidia-specific settings since I prefer smooth, buttery frame rate, but that’s impressive in itself given it’s the only game this year to make that happen."
                                            },
                                            {
                                                "example_id": "3c1f8a5a-9266-4054-96bc-61608f911d55",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "For video, setting a higher frame rate, like 60 frames per second, means having the ability for getting nicer, buttery, silky-smooth, slow motion—if you're into that sort of thing."
                                            },
                                            {
                                                "example_id": "855e0fb4-61da-4164-9125-709a04592102",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "That frame rate is buttery. Your computer has an excellent graphics card, Masato"
                                            },
                                            {
                                                "example_id": "74824826-1379-4a2e-ad11-fa38dd85c763",
                                                "sense_id": "104fe9d4-092b-30b7-b8d3-cd5686f85a85",
                                                "text": "So, if you're looking to play PC games with a buttery frame rate, these monitors are ready to deliver a great experience, and it gets even better when paired with Nvidia’s G-Sync or AMD’s FreeSync."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buttery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "910956cb-cf1f-339f-bdc3-de015996c193",
                                        "entry_id": "c86158c4-86dc-3e61-9abe-e4b8b3bcb0ab",
                                        "glosses": [
                                            "A rowie."
