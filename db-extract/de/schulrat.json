                "senses": [
                    {
                        "sense_id": "e18ad2b1-174e-39c7-a7d2-508f985cc34e",
                        "entry_id": "c13d227b-b0cb-3a11-9f47-a3180aa5f7d4",
                        "glosses": [
                            "Mitglied/Vertreter (Beamter) der Schulaufsichtsbehörde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a14d8000-37ae-4f9d-8082-c47c00a5b94f",
                                "sense_id": "e18ad2b1-174e-39c7-a7d2-508f985cc34e",
                                "text": "„Bevor der Schulrat kam, impfte Frau Katzer uns ein, was wir auf ihre Fragen antworten sollten, bis ins kleinste.“"
                            },
                            {
                                "example_id": "8cebb7b0-c5d2-4913-9893-2e392bd51dfd",
                                "sense_id": "e18ad2b1-174e-39c7-a7d2-508f985cc34e",
                                "text": "„Der Leiter des Kreises, der Schulrat, bei Fortbildungs- und Fachschulen der Vorsitzende des Schulvorstandes, sind rechtzeitig vorher zu benachrichtigen.“"
                            },
                            {
                                "example_id": "6335b25e-c448-4f34-93db-0e41fefe4912",
                                "sense_id": "e18ad2b1-174e-39c7-a7d2-508f985cc34e",
                                "text": "„Wenn ein Besuch des Schulrates in Aussicht steht, werden Wachen aufgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
