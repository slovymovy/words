                    "sense_id": "3d48a6d3-2c82-38d8-b784-2b7ad990edc8",
                    "sense_definition": "iemand een voorkeursbehandeling geven boven anderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd ervan beschuldigd <w>voorgetrokken</w> te zijn door zijn leraar.",
                            "target_lang_translations": {
                                "en": "He was accused of being <w>favored</w> by his teacher."
                            }
                        },
                        {
                            "text": "Ouders moeten proberen om nooit een van hun kinderen <w>voortrekken</w>.",
                            "target_lang_translations": {
                                "en": "Parents should try never to <w>show favoritism</w> toward one of their children."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevoordelen",
                        "prefereren"
                    ],
                    "antonyms": [
                        "achterstellen",
                        "benadelen"
                    ],
                    "common_phrases": [
                        "iemand voortrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to give someone preferential treatment over others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to favor",
                                "target_lang_sense_clarification": "to treat someone better than others"
                            },
                            {
                                "target_lang_word": "to show favoritism",
                                "target_lang_sense_clarification": "to give unfair preference to someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4dd079-9b83-3f27-af0e-b228d4ed8bf5",
                    "sense_definition": "planten of bloemen eerder dan de natuurlijke tijd tot bloei laten komen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tuinieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Omdat de bloemen van de dahlia laat op gang komen, kun je ze ook <w>voortrekken</w> in bloempotten.",
                            "target_lang_translations": {
                                "en": "Because dahlia flowers start late, you can also <w>force</w> them in flower pots."
                            }
                        },
                        {
                            "text": "In de winter kun je bollen in een warme kas <w>voortrekken</w> voor een vroege lente.",
                            "target_lang_translations": {
                                "en": "In winter, you can <w>pre-grow</w> bulbs in a warm greenhouse for an early spring."
                            }
                        }
                    ],
                    "synonyms": [
                        "forceren"
                    ],
                    "common_phrases": [
                        "planten voortrekken",
                        "bollen voortrekken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tuinbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to cause plants or flowers to bloom earlier than their natural time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to force",
                                "target_lang_sense_clarification": "to make plants grow or bloom early"
                            },
                            {
                                "target_lang_word": "to pre-grow",
                                "target_lang_sense_clarification": "to start plants indoors or in a greenhouse before the season"
                            }
                        ]
                    }
                },
                {
