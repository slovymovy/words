                                        "examples": [
                                            {
                                                "example_id": "1f7d1d5e-455b-4878-a1ef-879a3888db35",
                                                "sense_id": "dd736888-b73a-3fde-a6cf-02d8421a7c65",
                                                "text": "— Sup?\n— Not much."
                                            }
