                            {
                                "example_id": "3af00ae0-68d6-4baa-96ed-9b47d700bbfa",
                                "sense_id": "40ce161c-2887-37e1-bfd7-2d8e8c871fa5",
                                "text": "De uitgestrekte kinderhand (of voet) moet gemakkelijk in het schaaltje passen."
