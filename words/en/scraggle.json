{
    "word_family": [
        "scraggly",
        "scragginess"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73d469ff-e96b-3a68-9a62-e90bb2b17f13",
                    "sense_definition": "To make something rough, scruffy, or unkempt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind will <w>scraggle</w> your hair if you stay outside without a hat.",
                            "target_lang_translations": {
                                "tr": "Şapkasız dışarıda kalırsan rüzgar saçını <w>darmadağın edecek</w>."
                            }
                        },
                        {
                            "text": "The storm managed to <w>scraggle</w> the bushes in the garden.",
                            "target_lang_translations": {
                                "tr": "Fırtına bahçedeki çalıları <w>darmadağın etmeyi</w> başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "tousle",
                        "muss"
                    ],
                    "antonyms": [
                        "groom",
                        "tidy"
                    ],
                    "common_phrases": [
                        "scraggle hair",
                        "scraggle bushes"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi darmadağın, pürüzlü veya bakımsız hale getirmek, karıştırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "darmadağın etmek",
                                "target_lang_sense_clarification": "saç veya çalı gibi şeyleri karmaşıklaştırmak"
                            },
                            {
                                "target_lang_word": "karıştırmak",
                                "target_lang_sense_clarification": "saçı bozmak, dağıtmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90efa435-171c-3fca-9479-a6094bcafac2",
                    "sense_definition": "A small, thin, untidy, or irregular piece or cluster of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew a <w>scraggle</w> of beard on his chin over the weekend.",
                            "target_lang_translations": {
                                "tr": "Hafta sonu çenesinde bir <w>tutam</w> sakal uzattı."
                            }
                        },
                        {
                            "text": "A loose <w>scraggle</w> of hair fell over her eyes as she leaned down.",
                            "target_lang_translations": {
                                "tr": "Eğildiğinde gözlerinin üzerine gevşek bir saç <w>tutamı</w> düştü."
                            }
                        }
                    ],
                    "synonyms": [
                        "wisp",
                        "clump"
                    ],
                    "common_phrases": [
                        "scraggle of beard",
                        "scraggle of hair"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin küçük, ince, düzensiz veya seyrek tutamı/parçası."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tutam",
                                "target_lang_sense_clarification": "ince, düzensiz saç veya sakal kümesi"
                            },
                            {
                                "target_lang_word": "seyrek demet",
                                "target_lang_sense_clarification": "düzensiz parçacık veya küme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}