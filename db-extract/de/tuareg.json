                "senses": [
                    {
                        "sense_id": "e1887389-454f-30b9-a619-452a6e4a18a3",
                        "entry_id": "c18bf856-16b4-3bea-8c36-ccd64e465128",
                        "glosses": [
                            "im nördlichen Burkina Faso, Niger, Mali, südlichen Algerien und südwestlichen Libyen sowie größeren Migrantengruppen in Tschad, Nigeria und Mauretanien von 1,5 Millionen Menschen gesprochene/r Berberdialekt/Berbersprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478a1d9a-b3da-483d-b691-d45352d47683",
                                "sense_id": "e1887389-454f-30b9-a619-452a6e4a18a3",
                                "text": "„Nach diesem System verfahren der Dialekt von Ghat, das Zenatia des Mzab, das Zenaga und das Tuareg.“"
                            },
                            {
                                "example_id": "82483a35-9521-4e8b-90e6-f728bd114ea8",
                                "sense_id": "e1887389-454f-30b9-a619-452a6e4a18a3",
                                "text": "„Gleichzeitig hört man Tarifit im Rifgebirge, Tamazight im Mittleren Atlas, und Tuareg in der Sahara.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
