                "senses": [
                    {
                        "sense_id": "b3aca02b-2105-38dc-968c-29cbff2efec5",
                        "entry_id": "db433a10-d429-32e1-9ed0-799bb20ee9b2",
                        "glosses": [
                            "altes Fahrzeug, Flugzeug, Schiff, Modell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a679124b-917d-49d8-9cc6-b17fb9b21eb0",
                                "sense_id": "b3aca02b-2105-38dc-968c-29cbff2efec5",
                                "text": "Fritz hat 15.000 Euro in die Restauration seines Oldtimers gesteckt."
                            },
                            {
                                "example_id": "8d1b5247-a6c7-49a6-beed-efc868acb995",
                                "sense_id": "b3aca02b-2105-38dc-968c-29cbff2efec5",
                                "text": "„Nachher stand er mit klopfendem Herzen am Fenster und sah auf ein elegantes Paar hinunter, das sich, aus dem Restaurant kommend, in der Andeutung eines Tangoschritts auf die Treppe zubewegte, um dann lachend hinunterzuhüpfen und in einem Oldtimer mit Chauffeur zu verschwinden.“"
                            },
                            {
                                "example_id": "f941e6d5-3e29-41c3-a0b1-6064fef6adfe",
                                "sense_id": "b3aca02b-2105-38dc-968c-29cbff2efec5",
                                "text": "„Hinter dem Haus steht ein Oldtimer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
