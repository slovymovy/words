                                        ]
                                    },
                                    {
                                        "sense_id": "bdf28448-0651-3c6d-b09a-de7f3bab5876",
                                        "entry_id": "9bdaf2df-a02a-3cdb-9633-9204440344d3",
                                        "glosses": [
