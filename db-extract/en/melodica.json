                        "entry_id": "3e489714-2efa-35bd-9439-03e740465194",
                        "glosses": [
                            "A free-reed keyboard wind instrument, often played with a flexible plastic tube connected to the mouthpiece."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e46e70-6cc7-49b6-91ef-972fea2c5f99",
                                "sense_id": "0e45c4f4-7185-34e8-ac12-2b6ee1d3c5b4",
                                "text": "On “Seven by Seven” it was the reedy blend of two melodicas, played by Mr. Apfelbaum and Mr. Valera over a haunting drone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
