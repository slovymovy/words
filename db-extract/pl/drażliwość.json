                "translations": [
                    {
                        "translation_id": "c8f5bccb-1465-49d7-a4c6-852cab456127",
                        "source_entry_id": "3f5b4d4a-3411-3532-bfc2-4c06391ee651",
                        "source_sense_id": "c4965c13-91d5-3c37-ae21-d28e35563d3e",
                        "target_lang_word": "peevishness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peevishness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b15ce26b-f39e-3f47-9217-8e3b91b0c669",
                                        "entry_id": "f1ebc63b-5dda-3de7-bacf-ff60f9a6c344",
                                        "glosses": [
                                            "The state of being peevish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9df2792-2488-40f6-a159-8c2536c0e469",
                                                "sense_id": "b15ce26b-f39e-3f47-9217-8e3b91b0c669",
                                                "text": "Moreover, it were ungenerous, having bred thee up freakish and fiery, to dismiss thee to want or wandering, for shewing that very peevishness and impatience of discipline which arose from thy too delicate nurture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85d25236-e08b-4539-bf4a-c4f1a853c5bb",
                        "source_entry_id": "3f5b4d4a-3411-3532-bfc2-4c06391ee651",
                        "source_sense_id": "c4965c13-91d5-3c37-ae21-d28e35563d3e",
                        "target_lang_word": "irritability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irritability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                                        "glosses": [
                                            "The state or quality of being irritable; quick excitability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68377965-7c3c-4f14-b138-cde94830a2b1",
                                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                                "text": "irritability of temper"
                                            },
                                            {
                                                "example_id": "e08ccc36-3a93-40a6-b0fd-7b7059eddddf",
                                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                                "text": "Blue No. 1 and yellow No. 6 may also be toxic to some human cells. And as little as 1 milligram of yellow dye No. 5 may cause irritability, restlessness and sleep disturbances for sensitive children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                                        "glosses": [
                                            "A natural susceptibility, characteristic of all living organisms, tissues, and cells, to the influence of certain stimuli, response being manifested in a variety of ways."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f0b6d0c-eaa6-47c6-87d3-8c8efe97b192",
                                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                                "text": "We find a renitency in ourselves to ascribe life and irritability to the cold and motionless fibres of plants."
                                            },
                                            {
                                                "example_id": "67512995-dc4c-47a9-99ac-90a1e34da714",
                                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                                "text": "There is growth only in plants; but there is irritability, or, a better word, instinctivity, in insects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ccd5ce-5409-3500-9eb8-f5cd47deee34",
                                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                                        "glosses": [
                                            "A condition of morbid excitability of an organ or part of the body; undue susceptibility to the influence of stimuli."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876307a7-b376-4ef5-9ce8-1c93229b01eb",
                        "source_entry_id": "3f5b4d4a-3411-3532-bfc2-4c06391ee651",
                        "source_sense_id": "c4965c13-91d5-3c37-ae21-d28e35563d3e",
                        "target_lang_word": "petulance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petulance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "Rudeness, insolence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d22997c9-8039-4e84-9023-36fa4112f111",
                                                "sense_id": "a51e95ff-6942-38ea-8925-24cf125ad491",
                                                "text": "[W]ise men knew, that that, which looked like pride in some, and like petulance in others, would, by experience in affairs, and conversation amongst men, both of which most of them wanted, be in time wrought off […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "An insolent remark or act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b156f3-6fd8-4b89-a495-6b307f34f235",
                                                "sense_id": "bcf07f82-4a5d-399e-9988-37834b2acfd5",
                                                "text": "I believe I was guilty of a petulance, which nothing but my uneasy situation can excuse; if that can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                                        "entry_id": "38e01940-0247-3bb7-b3cc-810154de1cb1",
                                        "glosses": [
                                            "Childish impatience or sulkiness; testiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ed5670-0531-4248-b4c1-1c27de6c4f31",
                                                "sense_id": "df425096-93ee-332e-9c5c-21146bef2633",
                                                "text": "She […] had shown herself angry and sore, and was now ashamed of her own petulance, and yet unable to discontinue it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d11a4065-91d1-43f2-a5a9-440c270519dc",
                        "source_entry_id": "3f5b4d4a-3411-3532-bfc2-4c06391ee651",
                        "source_sense_id": "c4965c13-91d5-3c37-ae21-d28e35563d3e",
                        "target_lang_word": "touchiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touchiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d49b2c-8779-3618-8304-2cbc6daf72a9",
                                        "entry_id": "af69aa3b-15c1-3e52-b587-c10ecd291f02",
                                        "glosses": [
                                            "The property of being touchy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0385a906-b9b1-4e32-a056-85b2b7bafe81",
                                                "sense_id": "e8d49b2c-8779-3618-8304-2cbc6daf72a9",
                                                "text": "The engine seemed a little sensitive to wet rails, and in consequence the uphill work was not so good north of Dundee as it had been earlier. But I have noted this same \"touchiness\" on the part of the \"A4s\", and other modern British 4-6-2s, so that in this respect No. 2006 proved no exception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d4de3a7-40e5-43c7-b297-1aa99293612d",
                        "source_entry_id": "3f5b4d4a-3411-3532-bfc2-4c06391ee651",
                        "source_sense_id": "c4965c13-91d5-3c37-ae21-d28e35563d3e",
                        "target_lang_word": "irritabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irritabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                        "entry_id": "e3b68897-7e88-3388-a178-011dcb9168ac",
                                        "glosses": [
                                            "Caractère de celui qui s’irrite facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16da00c5-532b-4e9b-8f03-0846eb37114e",
                                                "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                                "text": "Il est d’une grande irritabilité."
                                            },
                                            {
                                                "example_id": "eb8080c2-c5e5-441e-b4f2-2f224c60b574",
                                                "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                                "text": "L’irritabilité du caractère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                        "entry_id": "e3b68897-7e88-3388-a178-011dcb9168ac",
                                        "glosses": [
                                            "Qualité de ce qui est irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cead8176-45fc-4e02-8c5e-ef76ed1ef1c1",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "L’irritabilité des fibres, des muscles."
                                            },
                                            {
                                                "example_id": "eb38ff5d-187a-4d45-bc79-3b151d3cba10",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "Les premiers montraient que l’irritabilité musculaire était conservée lorsque le cerveau ou la moelle étaient lésés, ce qui tendait à faire de l’irritabilité une propriété inhérente à la fibre musculaire."
                                            },
                                            {
                                                "example_id": "972ee3a3-ee86-4d2a-8ac3-01e67ec2a2a6",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "Les névroses idiopathiques de la vie de relation, dont le siége peut être dans les expansions ou les cordons nerveux, sont également précédées de phlegmasies, lorsque l’inflammation, en ramollissant les tissus, a exalté la sensibilité, au point de développer des névralgies, des mouvemens convulsifs, des paralysies, a augmenté, diminué ou aboli l’irritabilité des expansions vasculo-nerveuses qui forment les sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da9593a1-19c0-4927-b8d4-c0bb83a28ece",
