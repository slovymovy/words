                        "examples": [
                            {
                                "example_id": "f297cc8b-2c3c-4b13-a6b3-b947db03ba8f",
                                "sense_id": "31773fe7-8aed-3372-a8b8-99b7790b12c2",
                                "text": "Nationale herdenking Een groot incident is in Nederland al heel snel een ramp, vindt hij. Terwijl Nederland nauwelijks echte rampen kent. De vuurwerkfabriek die ontplofte in een woonwijk in Enschede stond al snel bekend als de vuurwerkramp. Een brand in een Volendams café werd de Volendamramp. En na koninginnedag was er een nationale herdenking voor nodig om de aanslag van Karst T. een plekje te geven."
                            },
                            {
                                "example_id": "f71efb76-24ae-42f4-a1a7-49e739271933",
                                "sense_id": "31773fe7-8aed-3372-a8b8-99b7790b12c2",
                                "text": "Onder degenen die aangifte deden, waren oud-directeur Bakker van de vuurwerkfabriek SE Fireworks en de oud-rechercheur. Ze hebben laten weten dat ze geen genoegen nemen met het besluit van het OM en in hoger beroep gaan."
                            }
                        ]
                    }
