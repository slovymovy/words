                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db90ceb6-0648-46ec-8628-a48aa14b92b8",
                                "sense_id": "473c532f-9a19-3d42-aaeb-7dc37efe7e56",
                                "text": "Il a accès à des listes entières de gens à guantanamoïser, ou pire."
                            },
                            {
                                "example_id": "26019eaf-dac1-48bf-9397-aa335dfca4bb",
                                "sense_id": "473c532f-9a19-3d42-aaeb-7dc37efe7e56",
                                "text": "Le cérémonial c'est parce qu'elle va se faire Guantanamoïser, c'est pas rien."
                            }
                        ]
