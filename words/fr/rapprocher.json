{
    "word_family": [
        "rapprochement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a796f95-12a7-390e-92f5-2954fbde8d54",
                    "sense_definition": "Mettre plus près dans l'espace ou dans le temps, ou réduire la distance qui sépare des choses ou des personnes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu <w>rapprocher</w> la lampe pour que je voie un peu mieux mon livre ?"
                        },
                        {
                            "text": "Le bateau commence à se <w>rapprocher</w> lentement de la côte."
                        }
                    ],
                    "synonyms": [
                        "approcher"
                    ],
                    "antonyms": [
                        "éloigner"
                    ],
                    "common_phrases": [
                        "se rapprocher du but"
                    ]
                },
                {
                    "sense_id": "60df4a9e-adc2-39fa-b06c-18369b790534",
                    "sense_definition": "Créer de la sympathie, favoriser l'entente ou réconcilier des personnes en conflit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette épreuve difficile a permis de <w>rapprocher</w> les deux frères après des années de dispute."
                        },
                        {
                            "text": "Le médiateur tente de <w>rapprocher</w> les deux collègues avant la fin de la réunion."
                        }
                    ],
                    "synonyms": [
                        "réconcilier",
                        "unir"
                    ],
                    "antonyms": [
                        "diviser",
                        "éloigner",
                        "brouiller"
                    ],
                    "common_phrases": [
                        "rapprocher les points de vue"
                    ]
                },
                {
                    "sense_id": "edb6b610-300b-36cf-867e-17e185e6d940",
                    "sense_definition": "Mettre en relation ou en parallèle des faits, des idées ou des éléments pour établir une comparaison.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'analyste cherche à <w>rapprocher</w> ces deux événements pour expliquer la crise actuelle."
                        },
                        {
                            "text": "Le professeur a voulu <w>rapprocher</w> ces deux textes pour illustrer le style de l'époque."
                        }
                    ],
                    "synonyms": [
                        "comparer",
                        "confronter"
                    ],
                    "antonyms": [
                        "dissocier"
                    ],
                    "common_phrases": [
                        "rapprocher deux faits"
                    ]
                },
                {
                    "sense_id": "e20e7e59-f6cb-33fd-bd21-2177400fb9e0",
                    "sense_definition": "Mettre ou venir plus près de nouveau après avoir reculé ou éloigné.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir reculé le fauteuil, elle décida de le <w>rapprocher</w> encore une fois de la cheminée."
                        },
                        {
                            "text": "Il a dû <w>rapprocher</w> le micro après s'être rendu compte qu'on ne l'entendait plus."
                        }
                    ]
                },
                {
                    "sense_id": "c23a2298-39eb-3faa-b6fe-c7c6f443c588",
                    "sense_definition": "Associer et vérifier la conformité entre des écritures comptables et des relevés bancaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comptabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable doit <w>rapprocher</w> le relevé bancaire avec les factures enregistrées le mois dernier."
                        },
                        {
                            "text": "Il faut <w>rapprocher</w> ces différentes écritures afin de repérer les éventuelles anomalies."
                        }
                    ],
                    "synonyms": [
                        "concilier"
                    ]
                }
            ]
        }
    ]
}