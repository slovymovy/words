                        "entry_id": "eae4009e-db9b-32e9-b90a-6f4b1fb7a37c",
                        "glosses": [
                            "Spécialiste de bactériologie, de l'étude des bactéries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ddd82a-3ab3-420f-ad55-a24529b35467",
                                "sense_id": "e5c85441-ac83-38ea-9364-6bd9783c4e9d",
                                "text": "En matière de maladies infectieuses, si les bactériologistes ont découvert de nombreux micro-organismes responsables de maladies, leurs connaissances n'ont pas encore engendré de moyens de traitement efficaces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8a30e83-1d14-494c-9720-035545c0b76a",
                        "source_entry_id": "eae4009e-db9b-32e9-b90a-6f4b1fb7a37c",
                        "source_sense_id": "e5c85441-ac83-38ea-9364-6bd9783c4e9d",
                        "target_lang_word": "Bakteriologe",
                        "target_lang_code": "de",
