                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b522e9-237a-4a8e-99cc-557bced086b1",
                                "sense_id": "c55becc0-f510-39d6-98eb-184b0708c068",
                                "text": "Europa werd vroeger bewoond door verschillende Indo-Europese volkeren."
                            },
                            {
                                "example_id": "e2b32bee-1d57-447b-b6c0-7359105c0a8c",
                                "sense_id": "c55becc0-f510-39d6-98eb-184b0708c068",
                                "text": "En ook 2.500 jaar oud is een graf van een ander Indo-Europees steppenvolk, de Tocharen, uit Noordwest-China."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dcc0256-ec0a-3d13-81ca-c698c54aa4af",
                        "entry_id": "c70943f5-5d36-3887-8d41-c562be2580aa",
                        "glosses": [
                            "betrekking hebbend op de nazaten uit gemengd Indonesische en Europese (veelal Nederlandse) relaties in voormalig Nederlands-Indië, gewoonlijk betiteld als “Indo's” of (in formeel taalgebruik) “Indo-Europeanen”"
                        ],
