                ],
                "senses": [
                    {
                        "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                        "entry_id": "17d2b1e3-0450-31be-b608-604efe56c9d6",
                        "glosses": [
                            "Diktatur, in der die Macht beim Militär liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358e06fc-ccf9-4fc2-8a7c-e08fb080bf17",
                                "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                                "text": "„Indonesien blieb die restliche Zeit des Kalten Krieges hindurch eine Militärdiktatur.“"
                            },
                            {
                                "example_id": "1ce5b9de-10d6-4480-a21d-b81301e04119",
                                "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                                "text": "„Vorrangiges Ziel ist nun, eine prowestliche Militärdiktatur in Léopoldville zu etablieren.“"
                            },
                            {
                                "example_id": "5e0018d4-bde7-4b09-b3af-275f544af85e",
                                "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                                "text": "„In Ägypten scheint der »Arabische Frühling« in eine kaum verschleierte Militärdiktatur zu münden.“"
                            },
                            {
                                "example_id": "aae1a9b9-0785-402a-9938-f25372e68caf",
                                "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                                "text": "„Im Kapp-Putsch kämpfte er für die Errichtung einer Militärdiktatur.“"
                            },
                            {
                                "example_id": "b88795a8-6841-49ea-b287-9e075f272f4b",
                                "sense_id": "9b03a883-c7fc-3f25-a3ec-6ca2cedeec43",
                                "text": "„Obwohl Zia-ul-Haqs Militärdiktatur sich als die bisher längste Regierungsperiode in der Geschichte Pakistans erweisen sollte, war das Regime nicht von vornherein auf Dauer angelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
