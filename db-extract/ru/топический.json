                                    {
                                        "sense_id": "d076b165-5ab5-31da-aa6c-bd30caad4642",
                                        "entry_id": "aa59d66d-8531-3dcc-b57f-d9836246c1fa",
                                        "glosses": [
                                            "A substance, especially a medication, applied externally (to the surface of the skin or eye)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4016f73d-2bb2-4b44-a050-e78c59b4b143",
                                                "sense_id": "d076b165-5ab5-31da-aa6c-bd30caad4642",
                                                "text": "Small amounts of potent ingredients can, in theory, mean far less skin irritation, as one might get with a one-time high dose of retinol. And with topicals, there is a more uniform delivery of product to the skin’s surface."
                                            },
                                            {
                                                "example_id": "c0db408c-e8df-46d5-a018-67bafe95a8b2",
                                                "sense_id": "d076b165-5ab5-31da-aa6c-bd30caad4642",
                                                "text": "\"This is a great introductory line to first-time cannabis users because two of the items are topicals, which don't get you high,\" says Elisabeth, who prides herself and her growers on having a well-balanced and chemical-free strand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "276c47c1-6018-32a8-8ebe-bcb4d2583521",
                                        "entry_id": "aa59d66d-8531-3dcc-b57f-d9836246c1fa",
                                        "glosses": [
                                            "A substance, especially a medication, applied externally (to the surface of the skin or eye).",
                                            "A topical anaesthetic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dbfa3b1-ddae-3790-8aec-9b666f289e3f",
                                        "entry_id": "aa59d66d-8531-3dcc-b57f-d9836246c1fa",
                                        "glosses": [
                                            "A joke dealing with current events or topical subjects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af07239b-f4f0-4e9c-8b5a-832886a6731e",
                                                "sense_id": "6dbfa3b1-ddae-3790-8aec-9b666f289e3f",
                                                "text": "You can’t do a show at an audience – you have to do a show with an audience and structure the act so that you start with the “hello” gags, then the topicals, then the surreal stuff."
                                            }
                                        ]
                                    },
                                    {
