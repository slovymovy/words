                    }
                ],
                "senses": [
                    {
                        "sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                        "entry_id": "4478d456-deaf-308a-bb90-e9bdecb3b288",
                        "glosses": [
                            "A loudspeaker designed to produce low-frequency sound, especially subbass."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51352043-6193-4f39-ab73-9963641cea45",
                                "sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                                "text": "Hip-hop took the language and made it graffiti—it was music video on a wall with a beatbox blowing its subwoofers next to it."
                            },
                            {
                                "example_id": "7ce14157-d0e6-43d4-84ad-6b0b3156cf5c",
                                "sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                                "text": "Even economy vehicles offer multispeaker audio upgrades, including a subwoofer."
                            },
                            {
                                "example_id": "6f204bbd-963b-4c75-ba0f-3db87538dcd2",
                                "sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                                "text": "Subwoofers are typically placed not only near the floor, but also close to one of the walls."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0e7034e-cc48-4c64-aef7-500bfcec9c75",
                        "source_entry_id": "4478d456-deaf-308a-bb90-e9bdecb3b288",
                        "source_sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
                        "source_sense_description": "a woofer dedicated to the reproduction of low-pitched audio frequencies",
                        "target_lang_word": "subwoofer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subwoofer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fe23cc0b-82e5-383d-8c4e-0d6b0f9d0fa8",
                                        "entry_id": "fbf0c200-cf00-3499-a7a8-c078033b3043",
                                        "glosses": [
                                            "een luidspreker die speciaal is ontworpen voor het weergeven van lage tot zeer lage tonen, die vaak ook gevoeld kunnen worden en onder (sub) het bereik liggen van een normale woofer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a1a0872-c895-406d-92a1-4e0112c7935b",
                                                "sense_id": "fe23cc0b-82e5-383d-8c4e-0d6b0f9d0fa8",
                                                "text": "De geteste versie is de Polo met de 95 pk sterke 1.0 TSI-motor, die vanaf €19.650 in de prijslijst staat. In dit geval ging het om de Beats-uitvoering, die vanaf € 21.130 kost. Deze Beats ontleent zijn naam de beroemde Beats-audiosystemen van Dr. Dre. In de auto schuilt dan ook een 300 Wattaudiosysteem met digitale soundprocessor, zes luidsprekers en een subwoofer."
                                            },
                                            {
                                                "example_id": "fbe302e5-15bc-4575-b6cf-abd3cc2e06a3",
                                                "sense_id": "fe23cc0b-82e5-383d-8c4e-0d6b0f9d0fa8",
                                                "text": "Chique alleskunner met uitstekende afwerking. De speakers zijn stevig en klinken mooi. De receiver ondersteunt al je apparaten, apps en audio- resoluties. Heeft zelfs een aansluiting voor een subwoofer."
                                            },
                                            {
                                                "example_id": "090c1122-a850-4894-9fb2-c48b36498b0a",
                                                "sense_id": "fe23cc0b-82e5-383d-8c4e-0d6b0f9d0fa8",
                                                "text": "Volgens Nasa is het lage, ruisende geluid - dat alleen goed te horen is met een koptelefoon of installatie met goede subwoofer voor lage tonen - opgevangen met een geavanceerde seismometer die de kleinste trillingen kan registreren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1828b90-eb68-46b0-8ecd-7ac02c78c78a",
                        "source_entry_id": "4478d456-deaf-308a-bb90-e9bdecb3b288",
                        "source_sense_id": "d522cfd0-e2ec-39b7-a02f-69dfec64a272",
