                "senses": [
                    {
                        "sense_id": "d830b342-a7d5-31f1-9bce-c67aebe08e9a",
                        "entry_id": "cafc0835-7ccd-3357-b15d-ec27e9207f41",
                        "glosses": [
                            "прост. то же, что тамус обыкновенный; травянистая лиана с лазающими побегами, распространена в Европе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca155e10-dc89-447c-86f6-0deaba8a4281",
                                "sense_id": "d830b342-a7d5-31f1-9bce-c67aebe08e9a",
                                "text": "При лечении ревматизма и ишиаса водогон применяют наружно."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e4fc47-6b43-3c12-9e44-0255c7a3eab9",
                        "entry_id": "cafc0835-7ccd-3357-b15d-ec27e9207f41",
                        "glosses": [
                            "рег. ветер, выгоняющий воду в море из реки"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "73a6042c-09a3-3af2-b175-254c766f4e76",
                        "entry_id": "cafc0835-7ccd-3357-b15d-ec27e9207f41",
                        "glosses": [
                            "устар., техн. машина для перемещения воды; водомёт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb19b45-ee03-4735-a546-ac9a602e8d4e",
                                "sense_id": "73a6042c-09a3-3af2-b175-254c766f4e76",
                                "text": "3 октября 1840 года в Кронштадте состоялось публичное испытание лодки Шильдера, оснащенной водогоном Саблукова. Правда, недостаток средств вынудил Шильдера отказаться от первоначально запланированного электродвигателя и приводить водогон в действие мускульной силой матросов."
                            }
                        ]
                    }
