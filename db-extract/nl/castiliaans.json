                "senses": [
                    {
                        "sense_id": "c475012b-49c5-3d3c-a4f0-766ec3b5405f",
                        "entry_id": "fd96ea26-d224-3374-984a-f23d7675e4fa",
                        "glosses": [
                            "afkomstig van of met betrekking tot Castilië, een van de vorstendommen waaruit Spanje is ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af5106b-1aac-486d-9a77-1824b3bd33f4",
                                "sense_id": "c475012b-49c5-3d3c-a4f0-766ec3b5405f",
                                "text": "Het eigenlijke staatshoofd van het zestiende-eeuwse Spanje was God Almachtig, zijn grondwet het alleenzaligmakende Katholieke Geloof, de handhaver dezer grondwet: Gods meest toegewijde dienaar koning Filips II. Wie deze constellatie voor ogen houdt en haar beziet in een door zon en droogte geschroeid land, dat nog pas kortelings met het zwaard op een vreemde overweldiger was terugveroverd, zal het merkwaardige feit begrijpen dat op de admiraalsvlag van Medina Sidonia niet Filips' wapen, noch enig Castiliaans of Aragonees embleem prijkte, maar niemand minder dan Christus aan het Kruis zelf, geflankeerd door zijn hemelse Moeder en Maria Magdalena."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f175bb4-5f66-3bd2-a60a-54f1f4256dee",
                        "entry_id": "fd96ea26-d224-3374-984a-f23d7675e4fa",
                        "glosses": [
                            "in of met betrekking tot de taal Castiliaans zn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d580a7fc-7035-4cca-8ef4-88368f631126",
                                "sense_id": "8f175bb4-5f66-3bd2-a60a-54f1f4256dee",
                                "text": "Ontstaan in de conventillo's bediende de tango zich aanvankelijk van de alledaagse volkstaal. Toen de populariteit van de tango onder bredere lagen van de samenleving toenam, en hij zelfs geexporteerd [sic!] werd naar Europa, ontstonden de Castiliaanse teksten."
                            }
                        ]
                    }
