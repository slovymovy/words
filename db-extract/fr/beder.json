                ],
                "senses": [
                    {
                        "sense_id": "54a1ec6d-4ff7-3120-8a80-a90d12f6a6ef",
                        "entry_id": "64717648-9472-3251-8ea0-b6e0d44e6e8d",
                        "glosses": [
                            "Réduire à recommencer, renvoyer d’où l’on est venu ^([1])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c77e22-4f3f-4613-8aae-17b43e2825bf",
                                "sense_id": "54a1ec6d-4ff7-3120-8a80-a90d12f6a6ef",
                                "text": "Depuis s’en vindrent par la ville,\nPour François cuider suborner :\nMais l’en les fist sur pié sur bille [en désordre]\nBien-tost beder et retourner."
                            }
                        ]
                    },
                    {
                        "sense_id": "12c74b39-fa65-3274-83e8-e68aad100b8b",
                        "entry_id": "64717648-9472-3251-8ea0-b6e0d44e6e8d",
                        "glosses": [
                            "Se dit dans les pensionnats de la ville de Blois pour « languir » au jeu de la « languisse ». S’emploie aussi au jeu de l’oie ^([2])."
                        ],
                        "tags": [
                            "Pays Blaisois"
                        ],
                        "examples": [
                            {
                                "example_id": "1a58a177-fe90-4e9f-b35e-53f84431325e",
                                "sense_id": "12c74b39-fa65-3274-83e8-e68aad100b8b",
                                "text": "Jouer à beder."
                            }
                        ]
                    },
                    {
                        "sense_id": "e90b0c60-5c17-36a5-baf4-f77dab05892b",
                        "entry_id": "64717648-9472-3251-8ea0-b6e0d44e6e8d",
                        "glosses": [
                            "Draguer, partir pour trouver des filles ^([3])."
                        ],
                        "tags": [
                            "Haut-Jura"
                        ],
                        "examples": [
                            {
                                "example_id": "10068a73-a2bc-4cd1-83b5-c3a300662ae8",
                                "sense_id": "e90b0c60-5c17-36a5-baf4-f77dab05892b",
                                "text": "Il n’arrête pas de beder, on ne sait jamais où il est, et il ne travaille pas."
                            }
                        ]
                    }
                ],
