                    {
                        "sense_id": "8bd8d241-4763-381b-93b9-618efc12fcbf",
                        "entry_id": "dc5b9299-8831-38fb-92bf-580a9657c091",
                        "glosses": [
                            "ein Vorsprung im Verlauf einer Küste, eine hervorragende Spitze des Ufers"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "dd9c0af1-3523-4ff3-aa65-5d4cc29efd51",
                                "sense_id": "8bd8d241-4763-381b-93b9-618efc12fcbf",
                                "text": "Die künstlich entstandene aufgespülte Fläche der Huk (Haken, Landzunge), trennt die Boltenhagener Bucht von der Wohlenberger Wiek."
                            },
                            {
                                "example_id": "93d7d10c-b027-4fe5-a3ca-835c1816d20c",
                                "sense_id": "8bd8d241-4763-381b-93b9-618efc12fcbf",
                                "text": "Hohen Wieschendorf Huk bei Wismar ist eine nach Norden vorspringende Landzunge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
