                        "glosses": [
                            "ruzie, onenigheid, discussie veroorzakend; betwistbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c374367e-7d63-4062-a5fe-4eb57c6b75ec",
                                "sense_id": "a8c3a0cc-9a62-3af5-8371-5fd131ea2fa3",
                                "text": "De contentieus schrijvende Van Geemert haalt onder meer de Zwarte-Pietdiscussie aan die W.F. Hermans in 1969 op het eiland voerde: ‘Ik geloof niet dat het allemaal verbeelding is, wanneer de negers denken dat deze folklore in stand gehouden wordt om hen iets te laten voelen.’ (Arjen Fortuin NRC 26 oktober 2013)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
