                            {
                                "example_id": "6f1c1cc8-7fdf-45a8-9c9e-e21489bf153b",
                                "sense_id": "f56bdbd4-2d6e-34fd-9e97-07a1e4a03beb",
                                "text": "Hier treurt ze met ontstellende tastbaarheid over het verleden, en dat iedere nacht haar vroegere verstokte gewoonten ontbranden."
                            },
                            {
                                "example_id": "c50f2515-59d6-45ac-b0ef-44f57a75181d",
                                "sense_id": "f56bdbd4-2d6e-34fd-9e97-07a1e4a03beb",
                                "text": ",,We zijn al een paar jaar bezig om duurzamer te worden”, zegt Van Loon. ,,Maar dat zijn allemaal programma's voor de langere termijn. We willen ook dat het nu al tastbaar wordt voor onze klanten, zodat ook de mensen die nog niet overstappen naar elektrisch rijden iets kunnen doen.”"
                            }
                        ]
                    }
