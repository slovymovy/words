                "senses": [
                    {
                        "sense_id": "646abc93-14dd-33f3-94d1-0131398af0ae",
                        "entry_id": "1dbe89cc-7d0e-3f64-a550-9ac7d39f5b1f",
                        "glosses": [
                            "яблочный или грушевый бренди"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b25fdacc-9415-4c18-bf4b-3d799eb46a61",
                                "sense_id": "646abc93-14dd-33f3-94d1-0131398af0ae",
                                "text": "Он глядел в окно и чувствовал, как в жилах переливается сверкающий кальвадос."
                            },
                            {
                                "example_id": "b9065c23-8c14-44a2-b269-17c62a223159",
                                "sense_id": "646abc93-14dd-33f3-94d1-0131398af0ae",
                                "text": "Доктор запретил пить кальвадос и велел лежать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
