                    {
                        "translation_id": "3f73b26a-d8ef-408d-ae72-318f0b0dc1f9",
                        "source_entry_id": "b55c0885-c49f-3f16-8819-9f456589ddde",
                        "source_sense_id": "adabc7ea-4df7-3dfc-8a53-192e6e6129f8",
                        "target_lang_word": "Steckdose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steckdose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                        "entry_id": "1f27d99d-f8ee-32b5-966f-3ec1d93876c1",
                                        "glosses": [
                                            "Vorrichtung zum Anschluss elektrischer Geräte an das Stromnetz mit zwei oder mehr Kontakthülsen zur Aufnahme der Steckerstifte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "192c62f0-454f-445a-808e-018ee408725c",
                                                "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                                "text": "Wenn meine zweijährige Nichte zu Besuch kommt, muss ich alle Steckdosen kindersicher machen."
                                            },
                                            {
                                                "example_id": "9f3e946c-190d-4373-9401-29d7d2abb47a",
                                                "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                                "text": "„Dincklage rückte sie ein wenig zur Seite, die Steckdose kam zum Vorschein, er stellte die Lampe auf die Kiste, brachte sie mit dem Stromnetz in Kontakt, knipste sie an: sie brannte.“"
                                            },
                                            {
                                                "example_id": "6675b8b2-106a-4bd3-82e9-bf3c791c5426",
                                                "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                                "text": "„Ich gehe in meine Kabine, schließe es an die Steckdose an und lese in dem Mafia-Thriller weiter.“"
                                            },
                                            {
                                                "example_id": "21c79119-5135-4c80-86fc-573ddd8f2847",
                                                "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                                "text": "„Fasziniert vom elektrisierten Leben mit Steckdosen und Lichtschaltern auf einer glatten Wand, inspizierte Chrissi die kleine Drei-Zimmer-Wohnung jeden Tag aufs Neue, ohne dass ihr Staunen darüber, wie sauber und einfach hier alles war, je kleiner wurde.“"
                                            },
                                            {
                                                "example_id": "37a5fea6-8b1f-4db9-bef3-9473c18e4e4e",
                                                "sense_id": "931254eb-d2be-3384-b9d3-2c94bb4c3e17",
                                                "text": "„Offensichtlich hatten Nina und Stian eine Wand herausgebrochen, um Platz für die Küche zu schaffen, die Insel mit Herd und Spülbecken, wo Steckdosen und Dunstabzug in die Arbeitsfläche eingelassen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5982e9c-3311-43b6-bec7-5185e10d15ec",
                        "source_entry_id": "b55c0885-c49f-3f16-8819-9f456589ddde",
                        "source_sense_id": "adabc7ea-4df7-3dfc-8a53-192e6e6129f8",
