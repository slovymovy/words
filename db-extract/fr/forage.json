                    {
                        "translation_id": "dcf2a895-1ee3-40ef-80a6-3f452a3f0221",
                        "source_entry_id": "7b774aec-f094-3703-b309-d6de203d48d6",
                        "source_sense_id": "2372f3ad-2db3-39e3-9eac-3b4e88b23ece",
                        "target_lang_word": "Bohrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bohrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8c55f7-2e37-383c-be2c-00956d6186b2",
                                        "entry_id": "6f432f9f-9056-33f0-ae61-90ace2111784",
                                        "glosses": [
                                            "die Handlung des Bohrens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedcaa35-a842-4333-8aaf-eb958acf965c",
                                                "sense_id": "9a8c55f7-2e37-383c-be2c-00956d6186b2",
                                                "text": "Die Bohrungen im Eis verhelfen den Forschern zu wichtigen Proben, die Auskunft über die Vergangenheit geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60053ded-af4a-31cb-ad2c-197c3e97f211",
                                        "entry_id": "6f432f9f-9056-33f0-ae61-90ace2111784",
                                        "glosses": [
                                            "das Ergebnis des Bohrens, das Bohrloch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ead221-81f7-4bc7-8be5-56172bb95695",
                                                "sense_id": "60053ded-af4a-31cb-ad2c-197c3e97f211",
                                                "text": "Die Forscher hatten noch ein paar Bohrungen niedergebracht."
                                            },
                                            {
                                                "example_id": "33db907f-dba8-4df2-b5e4-184f20a8c85f",
                                                "sense_id": "60053ded-af4a-31cb-ad2c-197c3e97f211",
                                                "text": "[Erdsonden für Wärmepumpen:] „Dafür sind die Bohrungen recht teuer. Fachleute rechnen mit etwa 80 bis 150 Euro pro Meter – je nachdem, wie der Untergrund beschaffen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a9f76d8-300f-323f-9aa5-55d202f5e517",
                                        "entry_id": "6f432f9f-9056-33f0-ae61-90ace2111784",
                                        "glosses": [
                                            "„Innendurchmesser der Zylinder“"
                                        ],
                                        "tags": [
                                            "bei Kolbenmotoren"
                                        ],
                                        "examples": [],
