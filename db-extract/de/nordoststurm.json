                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fee1b536-6d8b-431f-9421-fd72ace0b5ae",
                                "sense_id": "0683cd55-b783-3b8c-a95f-c5eb3d777aee",
                                "text": "„Brennendheiße Wut im Leibe, kämpfte Thomas Lieven mit zusammengepreßtem Kiefer und vorgeneigten Schultern gegen einen eiskalten Nordoststurm an, als er in der Dämmerstunde des 7. Dezember 1940 in die Rue de Paradis zu Marseille einbog.“"
                            },
                            {
                                "example_id": "43e5a3ec-8444-4051-bea5-e7ca9b8a6df0",
                                "sense_id": "0683cd55-b783-3b8c-a95f-c5eb3d777aee",
                                "text": "„Kaum jemand dürfte wohl jenen katastrophalen Nordoststurm vergessen haben, der um die Tagundnachtgleiche herum losbrach und das Barometer auf 710 mm hinunterdrückte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
