                "senses": [
                    {
                        "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                        "entry_id": "1a98e030-696a-35f2-a9ad-05209a5fd89f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0841ecff-03a6-4012-a575-c7c4732cd676",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Frau Habrecht ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fa4ca1c3-cf44-43a8-a842-d0c80b6fa12b",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Herr Habrecht wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ccf721c5-e959-477e-93e9-d29d857108d9",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Die Habrechts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f8c9b381-104a-4542-b0d1-2475e1463b34",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Der Habrecht trägt nie die Schals, die die Habrecht ihm strickt."
                            },
                            {
                                "example_id": "35f2472c-2da7-444d-80c2-5706c857aa00",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Habrecht kommt, geht der Herr Habrecht.“"
                            },
                            {
                                "example_id": "012a7ec7-c873-428a-b6cd-c612444bd671",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Habrecht kommt und geht."
                            },
                            {
                                "example_id": "f6bcb34a-75e2-4cc5-b6d9-82518c28dfed",
                                "sense_id": "89f07800-4182-378f-9965-348f1ea445df",
                                "text": "Habrechts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
