{
    "word_family": [
        "relation",
        "relationship",
        "relative",
        "relativity",
        "relatedness",
        "relator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa07542f-760b-3e23-9f9b-bf5a3b1448e2",
                    "sense_definition": "To show or make a connection between two or more things.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "connection_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher tried to <w>relate</w> the rise in temperature to increased pollution levels.",
                            "target_lang_translations": {
                                "ru": "Исследователь пытался <w>связать</w> повышение температуры с ростом уровня загрязнения.",
                                "zh": "研究人员试图把气温上升与污染程度加剧<w>联系</w>起来。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>relate</w> abstract theories to practical everyday situations.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>соотнести</w> абстрактные теории с практическими повседневными ситуациями.",
                                "zh": "要把抽象理论与日常生活中的实际情况<w>联系</w>起来往往很困难。"
                            }
                        }
                    ],
                    "antonyms": [
                        "disconnect",
                        "dissociate",
                        "separate"
                    ],
                    "common_phrases": [
                        "relate X to Y",
                        "relate cause and effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать связь или показывать отношение между двумя или более вещами.",
                        "zh": "显示或建立两个或多个事物之间的联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять факты или явления"
                            },
                            {
                                "target_lang_word": "соотносить",
                                "target_lang_sense_clarification": "сравнивать или находить соответствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "把两个或多个事物连接起来，指出它们之间的关系"
                            },
                            {
                                "target_lang_word": "关联",
                                "target_lang_sense_clarification": "强调事物之间存在关联或对应关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25806ebc-0312-353e-9fc5-271b3fc1b382",
                    "sense_definition": "To have a connection with or refer to something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "connection_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most of the questions in the interview <w>relate</w> to your previous work experience.",
                            "target_lang_translations": {
                                "ru": "Большинство вопросов на собеседовании <w>относятся</w> к вашему предыдущему опыту работы.",
                                "zh": "面试中的大多数问题都<w>与</w>你之前的工作经历<w>有关</w>。"
                            }
                        },
                        {
                            "text": "The new safety regulations <w>relate</w> to everyone working in the factory.",
                            "target_lang_translations": {
                                "ru": "Новые правила техники безопасности <w>касаются</w> всех, кто работает на заводе.",
                                "zh": "新的安全规定<w>涉及</w>所有在工厂工作的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "refer"
                    ],
                    "common_phrases": [
                        "relate to",
                        "closely relate to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь отношение к чему-либо или касаться чего-либо.",
                        "zh": "与某事有联系，或指与某事相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "иметь касательство к чему-либо"
                            },
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "затрагивать кого-либо или что-либо"
                            },
                            {
                                "target_lang_word": "иметь отношение",
                                "target_lang_sense_clarification": "быть связанным с чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "与……有关",
                                "target_lang_sense_clarification": "表示与某事有关系，常说“与……有关”"
                            },
                            {
                                "target_lang_word": "涉及",
                                "target_lang_sense_clarification": "指内容牵涉到某人或某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3eeb427-0f33-387f-9d57-ee1ccbee8859",
                    "sense_definition": "To understand and sympathize with someone or something based on shared feelings or experiences.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "understanding_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can <w>relate</w> to your frustration because I had the same problem last week.",
                            "target_lang_translations": {
                                "ru": "Я могу <w>понять</w> ваше разочарование, так как у меня была та же проблема на прошлой неделе.",
                                "zh": "我能<w>理解</w>你的沮丧，因为我上周也遇到了同样的问题。"
                            }
                        },
                        {
                            "text": "Many teenagers find it difficult to <w>relate</w> to the older generation.",
                            "target_lang_translations": {
                                "ru": "Многим подросткам трудно <w>найти общий язык</w> со старшим поколением.",
                                "zh": "许多青少年发现自己很难与老一代人<w>产生共鸣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "relate to someone",
                        "can relate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать чувства другого человека, находить с ним общий язык на основе схожего опыта.",
                        "zh": "基于相似的感受或经历而理解并同情某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "чувствовать то же самое, сопереживать"
                            },
                            {
                                "target_lang_word": "находить общий язык",
                                "target_lang_sense_clarification": "устанавливать взаимопонимание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理解",
                                "target_lang_sense_clarification": "能够体会并理解对方的感受"
                            },
                            {
                                "target_lang_word": "产生共鸣",
                                "target_lang_sense_clarification": "因有相似经历或感受而能共情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9801ed8b-ed76-3486-b343-af4fdf0a34dd",
                    "sense_definition": "To give an account of a sequence of events; to tell a story or describe something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness proceeded to <w>relate</w> the details of the accident to the police officer.",
                            "target_lang_translations": {
                                "ru": "Свидетель начал <w>излагать</w> подробности происшествия полицейскому.",
                                "zh": "目击者接着向警察<w>讲述</w>了事故的细节。"
                            }
                        },
                        {
                            "text": "She loves to <w>relate</w> a story about her adventures in the jungle.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>рассказывать</w> историю о своих приключениях в джунглях.",
                                "zh": "她喜欢<w>讲述</w>自己在丛林中的冒险故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recount",
                        "describe",
                        "chronicle",
                        "state",
                        "divulge"
                    ],
                    "antonyms": [
                        "suppress",
                        "conceal"
                    ],
                    "common_phrases": [
                        "relate a story",
                        "relate the facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассказывать историю или описывать последовательность событий.",
                        "zh": "讲述一连串发生的事情；叙说故事或描述某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассказывать",
                                "target_lang_sense_clarification": "передавать историю устно"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "описывать подробно или официально"
                            },
                            {
                                "target_lang_word": "повествовать",
                                "target_lang_sense_clarification": "вести рассказ (книжное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讲述",
                                "target_lang_sense_clarification": "把事情或故事说出来"
                            },
                            {
                                "target_lang_word": "叙述",
                                "target_lang_sense_clarification": "较正式地把经过或内容说清楚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e7c52a2-1e32-3a0c-89a6-90a72b691dcd",
                    "sense_definition": "To bring back or restore something to a former state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "restoration_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient magic spell served to <w>relate</w> the cursed prince to his human form.",
                            "target_lang_translations": {
                                "ru": "Древнее магическое заклинание послужило тому, чтобы <w>вернуть</w> проклятому принцу его человеческий облик.",
                                "zh": "那道古老的魔法咒语让被诅咒的王子<w>恢复</w>了人形。"
                            }
                        },
                        {
                            "text": "No medicine could <w>relate</w> the fallen warrior to his previous strength.",
                            "target_lang_translations": {
                                "ru": "Никакое лекарство не могло <w>восстановить</w> прежнюю силу павшего воина.",
                                "zh": "没有任何药物能让这位倒下的战士<w>恢复</w>到从前的力量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращать или восстанавливать что-либо в прежнее состояние (устаревшее значение).",
                        "zh": "使某物回到先前的状态；恢复原状（古旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "возвращать утраченное состояние"
                            },
                            {
                                "target_lang_word": "возвращать",
                                "target_lang_sense_clarification": "приводить обратно к исходному виду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "使某物回到原来的状态"
                            },
                            {
                                "target_lang_word": "使恢复原状",
                                "target_lang_sense_clarification": "强调回到先前的样子，多用于较书面表达"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}