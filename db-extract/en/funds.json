                                                "sense_id": "bfc802d0-18c0-36a0-bbf8-6da0141f92c2",
                                                "text": "Je sens que je fonds et que je me déclowne à vue d’œil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac1e1718-400c-3eba-a202-2999df390337",
                                        "entry_id": "66532655-60e7-3753-abb6-2f87a1d22989",
                                        "glosses": [
