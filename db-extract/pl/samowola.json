                    {
                        "translation_id": "3891cc45-9ff8-4b04-b957-367bcc0eb94d",
                        "source_entry_id": "9be61260-1b50-36a1-89e9-f7e5b19ff7f4",
                        "source_sense_id": "4512059b-7723-397f-97e5-5049c97b9b47",
