                    {
                        "sense_id": "eb73070d-7f6b-306e-aea0-306b7822c160",
                        "entry_id": "6941d297-1a62-39fc-a153-c75f29c8a748",
                        "glosses": [
                            "Féminin singulier de bourgeois."
