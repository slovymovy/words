                        "glosses": [
                            "paleolityczne narzędzie posiadające wyodrębniony wąski, lecz zaokrąglony wierzchołek powstały na skutek retuszu (obróbki) zwykle dwóch krawędzi bocznych, służący do przekłuwania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e90cd34-db81-4123-b73e-8343817fe861",
                                "sense_id": "075ab570-0126-337e-9a30-9b2b7f87840a",
                                "text": "Przekłuwacze są jedną z najbardziej charakterystycznych grup narzędzi w kulturze magdaleńskiej i epimagdaleńskiej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
