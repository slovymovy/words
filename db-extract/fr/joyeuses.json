                        ],
                        "examples": [
                            {
                                "example_id": "5f645e12-52a6-40f9-8c04-c090bb4febcf",
                                "sense_id": "cc138096-5abd-3536-af79-d7e0dfb3c741",
                                "text": "Cet inconnu se dépitait si bien au moment où l’on ouvrit précipitamment la lucarne du grenier, qu’il n’y vit pas apparaître trois joyeuses figures rondelettes, blanches, roses, mais aussi communes que le sont les figures du Commerce sculptées sur certains monuments."
                            }
                        ]
                    }
                ],
