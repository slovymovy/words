                                "target_senses": [
                                    {
                                        "sense_id": "0fcb218c-8b7c-3542-9492-8c6b77b9b1aa",
                                        "entry_id": "28d31119-07a5-301a-aebe-bdd8d3dd7e73",
                                        "glosses": [
                                            "Bestrafung durch körperliche Gewaltanwendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cb1a5d-dfef-4525-82f6-86445b957fcb",
                                                "sense_id": "0fcb218c-8b7c-3542-9492-8c6b77b9b1aa",
                                                "text": "„Bis in die neunziger Jahre durften Eltern ihre Kinder schlagen, wenn es erzieherisch begründet und die Züchtigung ‚nicht unverhältnismäßig‘ war.“"
                                            },
                                            {
                                                "example_id": "15e387db-3b01-4b50-9584-f23551413ee5",
