{
    "word_family": [
        "incensification",
        "incensory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07277a09-b886-3aa2-bc42-b4358b81ac01",
                    "sense_definition": "A substance that releases a pleasant smell when burned, often used in religious ceremonies or to perfume a room.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fragrant_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with the sweet scent of burning <w>incense</w>.",
                            "target_lang_translations": {
                                "tr": "Oda, yanan <w>tütsünün</w> tatlı kokusuyla doluydu."
                            }
                        },
                        {
                            "text": "She likes to burn <w>incense</w> sticks while practicing yoga.",
                            "target_lang_translations": {
                                "tr": "Yoga yaparken <w>tütsü</w> çubukları yakmayı sever."
                            }
                        }
                    ],
                    "common_phrases": [
                        "burn incense",
                        "incense stick"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yakıldığında hoş bir koku yayan, genellikle dini törenlerde veya odayı kokutmak için kullanılan madde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tütsü",
                                "target_lang_sense_clarification": "hoş kokulu yakılan madde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1343779-0cbc-3df5-9376-15c671db97e3",
                    "sense_definition": "The sweet-smelling smoke produced by burning incense.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fragrant_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick clouds of <w>incense</w> rose to the ceiling during the ancient ritual.",
                            "target_lang_translations": {
                                "tr": "Kadim ritüel sırasında yoğun <w>tütsü</w> bulutları tavana yükseldi."
                            }
                        },
                        {
                            "text": "The rich smell of <w>incense</w> hung heavy in the air of the cathedral.",
                            "target_lang_translations": {
                                "tr": "Katedralin havasında yoğun bir <w>tütsü</w> kokusu hakim kılınmıştı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clouds of incense"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tütsünün yakılmasıyla ortaya çıkan tatlı kokulu duman."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tütsü dumanı",
                                "target_lang_sense_clarification": "tütsünün çıkardığı koku ve duman"
                            },
                            {
                                "target_lang_word": "tütsü kokusu",
                                "target_lang_sense_clarification": "tütsünün yaydığı koku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a11c5ad-8598-38d8-acfc-bdce5003b6b4",
                    "sense_definition": "To make someone extremely angry or furious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "make_angry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decision to raise taxes will <w>incense</w> many local residents.",
                            "target_lang_translations": {
                                "tr": "Vergileri artırma kararı birçok yerel halkı <w>çileden çıkaracak</w>."
                            }
                        },
                        {
                            "text": "Her unfair treatment by the company managed to <w>incense</w> the entire union.",
                            "target_lang_translations": {
                                "tr": "Şirketin ona yaptığı haksız muamele tüm sendikayı <w>öfkelendirmeyi</w> başardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "infuriate",
                        "enrage",
                        "madden",
                        "outrage"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini son derece öfkelendirmek veya çileden çıkarmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çileden çıkarmak",
                                "target_lang_sense_clarification": "çok öfkelendirmek"
                            },
                            {
                                "target_lang_word": "öfkelendirmek",
                                "target_lang_sense_clarification": "kızdırmak, gazaba getirmek"
                            },
                            {
                                "target_lang_word": "kızdırmak",
                                "target_lang_sense_clarification": "şiddetle öfkelendirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd72c881-ff34-3a89-a8e1-37b8084cc86b",
                    "sense_definition": "To perfume or treat with incense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest began to <w>incense</w> the altar before starting the main service.",
                            "target_lang_translations": {
                                "tr": "Rahip, ana ayine başlamadan önce sunağı <w>tütsülemeye</w> başladı."
                            }
                        },
                        {
                            "text": "They would traditionally <w>incense</w> the statues during religious festivals.",
                            "target_lang_translations": {
                                "tr": "Dini festivaller sırasında heykelleri geleneksel olarak <w>tütsülerlerdi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scent",
                        "aromatize"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tütsü ile kokutmak veya tütsülemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tütsülemek",
                                "target_lang_sense_clarification": "tütsü yakarak kokutmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}