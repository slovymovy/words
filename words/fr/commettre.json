{
    "word_family": [
        "commission",
        "commis",
        "commissaire",
        "commissariat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1b6f274-23b4-3728-a34a-3db8efe14b2b",
                    "sense_definition": "Accomplir une action répréhensible, illégale ou fautive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acte_blamable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le suspect affirme qu'il n'a pas <w>commis</w> ce cambriolage."
                        },
                        {
                            "text": "Il est tout à fait humain de <w>commettre</w> une erreur de temps en temps."
                        }
                    ],
                    "synonyms": [
                        "perpétrer"
                    ],
                    "common_phrases": [
                        "commettre une erreur",
                        "commettre un crime",
                        "commettre une faute",
                        "commettre un délit"
                    ]
                },
                {
                    "sense_id": "ee232ef3-44fe-3cb4-ae62-e980e34c3e7d",
                    "sense_definition": "Mettre en danger sa réputation en se liant à des personnes douteuses ou en participant à une action contestable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compromettre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse de se <w>commettre</w> avec des gens malhonnêtes."
                        },
                        {
                            "text": "Un diplomate prudent évite toujours de se <w>commettre</w> dans de pareils scandales."
                        }
                    ],
                    "common_phrases": [
                        "se commettre avec"
                    ]
                },
                {
                    "sense_id": "98898ac4-b0c1-3a64-9203-98285fa17b04",
                    "sense_definition": "Désigner ou préposer officiellement une personne pour accomplir une charge ou une mission juridique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "designation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a <w>commis</w> un expert pour analyser les documents financiers."
                        },
                        {
                            "text": "Un avocat a été <w>commis</w> d'office pour représenter l'accusé au procès."
                        }
                    ],
                    "common_phrases": [
                        "commis d office"
                    ]
                },
                {
                    "sense_id": "37828415-7242-3545-843c-29e132d13238",
                    "sense_definition": "Écrire, publier ou réaliser une œuvre, souvent dit sur un ton ironique ou avec autodérision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "production_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans sa jeunesse, cet auteur avait <w>commis</w> un roman policier assez médiocre."
                        },
                        {
                            "text": "Le réalisateur a encore <w>commis</w> un navet cette année."
                        }
                    ],
                    "common_phrases": [
                        "commettre un livre",
                        "commettre un roman"
                    ]
                }
            ]
        }
    ]
}