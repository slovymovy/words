                "senses": [
                    {
                        "sense_id": "0aad5cdc-105a-304d-9208-08bde5a66f78",
                        "entry_id": "3e9bf9c0-2543-3a46-b9a7-627f5fda0152",
                        "glosses": [
                            "nieprzyjemny zapach"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e72554f5-f291-45df-8cee-64189c2e7377",
                                "sense_id": "0aad5cdc-105a-304d-9208-08bde5a66f78",
                                "text": "Nie zostanę medykiem sądowym, bo nie umiem wytrzymać odoru rozkładającego się ludzkiego ciała."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a24e967-a3c7-4339-85cd-dc0ddfcd8868",
                        "source_entry_id": "3e9bf9c0-2543-3a46-b9a7-627f5fda0152",
                        "source_sense_id": "0aad5cdc-105a-304d-9208-08bde5a66f78",
                        "target_lang_word": "odour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d231c0b9-e39e-3f60-b5fb-362fb3111fa2",
                                        "entry_id": "7aa520c0-b804-37fa-9245-fed3a6ab144b",
                                        "glosses": [
                                            "Alternative spelling of odor."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2592558-e722-4c31-8873-a0d4ca64c90d",
                                                "sense_id": "d231c0b9-e39e-3f60-b5fb-362fb3111fa2",
                                                "text": "So after learning a great deal about iron founding and much more about pike fishing, one regretfully took leave of a shop full of kindly characters and proceeded to a worse lot of odours in the brass foundry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8edf54e-c4ed-4012-8ffd-ea79abc2640f",
                        "source_entry_id": "3e9bf9c0-2543-3a46-b9a7-627f5fda0152",
                        "source_sense_id": "0aad5cdc-105a-304d-9208-08bde5a66f78",
                        "target_lang_word": "odor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8140cf-b33f-3f07-bb0a-34e08cf729f5",
                                        "entry_id": "e7733731-2377-349f-b67a-c9646c9bcc19",
                                        "glosses": [
                                            "Any smell, whether fragrant or offensive."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0bf79cd-a814-458c-91dc-275734b2d0ed",
                                                "sense_id": "1d8140cf-b33f-3f07-bb0a-34e08cf729f5",
                                                "text": "Now, I still think that for this box of matches to have escaped the wear of time for immemorial years was a strange, and for me, a most fortunate thing. Yet oddly enough I found here a far more unlikely substance, and that was camphor. I found it in a sealed jar, that, by chance, I supposed had been really hermetically sealed. I fancied at first the stuff was paraffin wax, and smashed the jar accordingly. But the odour of camphor was unmistakable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81ebb7e-7646-3202-b053-fb0754998ba6",
                                        "entry_id": "e7733731-2377-349f-b67a-c9646c9bcc19",
                                        "glosses": [
                                            "A strong, pervasive quality."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256ff439-0bdd-4937-be65-dec19acbc532",
                                                "sense_id": "b81ebb7e-7646-3202-b053-fb0754998ba6",
                                                "text": "In different parts of the coast different species of animals are accounted sacred, because they are supposed to be animated by the spirits of the dead. Hence monkeys near Fishtown, snakes at Whydah, and crocodiles near Dix Cove live in the odour of sanctity.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a751ed36-551b-38e6-9735-df5de18ab1e8",
                                        "entry_id": "e7733731-2377-349f-b67a-c9646c9bcc19",
                                        "glosses": [
                                            "Esteem."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38d2f6fc-406a-38d6-a8d4-15679a9bf5fc",
                                        "entry_id": "e7733731-2377-349f-b67a-c9646c9bcc19",
                                        "glosses": [
                                            "Something which produces a scent; incense, a perfume."
                                        ],
                                        "tags": [
                                            "US",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d522eee9-9f9e-4287-b1f8-11c6842dec51",
                                                "sense_id": "38d2f6fc-406a-38d6-a8d4-15679a9bf5fc",
                                                "text": "On the morowe after the ſaboth / erly in the mornynge / they cam vnto the toumbe and brought the odourſ whych they had prepared / and other wemen wyth them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
