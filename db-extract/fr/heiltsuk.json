                "senses": [
                    {
                        "sense_id": "439df1a7-9c2a-3ee7-a361-1081b8c5d622",
                        "entry_id": "37ed0a6c-ae56-3a01-bb1d-0094c5e991d2",
                        "glosses": [
                            "Langue de la famille wakashane parlée par les Heiltsuk en Colombie-Britannique (Canada)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03d34490-330a-421a-b95f-1448bf0cab6b",
                                "sense_id": "439df1a7-9c2a-3ee7-a361-1081b8c5d622",
                                "text": "Le kwak’wala, de la famille linguistique wakashane, est apparenté à d’autres langues autochtones parlées en Colombie-Britannique, comme le nuu-chah-nulth (Nootkas), le heiltsuk (Bella Bellas), le oowekyala et le haisla (Kitamaats)."
                            },
                            {
                                "example_id": "1fa2f2bf-0ff4-465d-a1b1-61c6bdb9cac5",
                                "sense_id": "439df1a7-9c2a-3ee7-a361-1081b8c5d622",
                                "text": "Notre langue, l’oweekyala, fait partie de la famille linguistique wakashane du Nord, qui englobe également le haisla, le heiltsuk et le kwakwala."
                            }
                        ]
                    }
