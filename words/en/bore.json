{
    "word_family": [
        "boredom",
        "boring",
        "bored",
        "borer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef03ec11-ad73-3a47-b131-e62538e0906e",
                    "sense_definition": "The simple past tense of <w>bear</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>bore</w> the heavy responsibility without complaining.",
                            "target_lang_translations": {
                                "ru": "Она <w>несла</w> тяжкий груз ответственности, не жалуясь.",
                                "zh": "她毫无怨言地<w>承担</w>了沉重的责任。"
                            }
                        },
                        {
                            "text": "The tree <w>bore</w> fruit for the first time this year.",
                            "target_lang_translations": {
                                "ru": "Дерево впервые <w>принесло</w> плоды в этом году.",
                                "zh": "这棵树今年第一次<w>结出</w>了果实。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола \"bear\" (нести, выносить, рожать).",
                        "zh": "动词 bear 的过去式（意为承担、忍受、生育）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нёс",
                                "target_lang_sense_clarification": "прошедшее время от 'нести'"
                            },
                            {
                                "target_lang_word": "выносил",
                                "target_lang_sense_clarification": "прошедшее время от 'выносить' (терпеть)"
                            },
                            {
                                "target_lang_word": "родила",
                                "target_lang_sense_clarification": "прошедшее время от 'рожать'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承担",
                                "target_lang_sense_clarification": "过去式，指承担责任"
                            },
                            {
                                "target_lang_word": "结出",
                                "target_lang_sense_clarification": "过去式，指植物结出果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72d33c69-b80c-3d16-a232-00fb41e44871",
                    "sense_definition": "To cause someone to feel tired and unhappy because something is not interesting or because they have nothing to do.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "boredom_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>bore</w> me with the details of your commute.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>утомляй</w> меня подробностями своей поездки.",
                                "zh": "请别用你通勤的琐事来<w>烦</w>我。"
                            }
                        },
                        {
                            "text": "The long lecture began to <w>bore</w> the students after ten minutes.",
                            "target_lang_translations": {
                                "ru": "Длинная лекция начала <w>наводить скуку</w> на студентов уже через десять минут.",
                                "zh": "十分钟后，冗长的讲座就开始让学生们感到<w>厌倦</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "interest"
                    ],
                    "common_phrases": [
                        "bore someone to death",
                        "bore to tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-то чувство скуки и усталости из-за отсутствия интереса или дела.",
                        "zh": "使人感到厌烦或无聊。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводить скуку",
                                "target_lang_sense_clarification": "заставлять скучать"
                            },
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "надоедать однообразием"
                            },
                            {
                                "target_lang_word": "наскучивать",
                                "target_lang_sense_clarification": "становиться неинтересным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使……厌烦",
                                "target_lang_sense_clarification": "令某人感到无聊"
                            },
                            {
                                "target_lang_word": "令人厌倦",
                                "target_lang_sense_clarification": "使人失去兴趣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31c96f24-5626-3645-9995-0be388d301c2",
                    "sense_definition": "To make a deep hole in something hard, usually with a special tool.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They needed to <w>bore</w> a tunnel through the solid rock.",
                            "target_lang_translations": {
                                "ru": "Им нужно было <w>пробурить</w> туннель в сплошной скале.",
                                "zh": "他们需要在坚硬的岩石中<w>凿</w>出一条隧道。"
                            }
                        },
                        {
                            "text": "Insects can <w>bore</w> into the wood and damage the furniture.",
                            "target_lang_translations": {
                                "ru": "Насекомые могут <w>вгрызаться</w> в древесину и портить мебель.",
                                "zh": "昆虫会<w>钻</w>进木头里，损坏家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "make a hole"
                    ],
                    "common_phrases": [
                        "bore a hole",
                        "bore into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать глубокое отверстие в чем-то твердом, обычно специальным инструментом.",
                        "zh": "用工具在坚硬物体上钻孔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверлить",
                                "target_lang_sense_clarification": "делать отверстие сверлом"
                            },
                            {
                                "target_lang_word": "бурить",
                                "target_lang_sense_clarification": "делать скважину или туннель"
                            },
                            {
                                "target_lang_word": "протачивать",
                                "target_lang_sense_clarification": "прогрызать (о насекомых)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钻",
                                "target_lang_sense_clarification": "用钻头打孔"
                            },
                            {
                                "target_lang_word": "凿",
                                "target_lang_sense_clarification": "挖掘或开凿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05d878c3-3ebb-33c8-a134-56dd1f960270",
                    "sense_definition": "To stare very intensely at someone, as if drilling a hole with the eyes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could feel his eyes <w>bore</w> into my back as I walked away.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал, как его глаза <w>сверлят</w> мне спину, когда я уходил.",
                                "zh": "我走开时，能感觉到他的目光<w>死死盯着</w>我的后背。"
                            }
                        },
                        {
                            "text": "She seemed to <w>bore</w> right through me with her intense gaze.",
                            "target_lang_translations": {
                                "ru": "Казалось, она <w>буравит</w> меня насквозь своим пристальным взглядом.",
                                "zh": "她那锐利的目光仿佛要将我<w>看穿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bore into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пристально смотреть на кого-то, словно просверливая глазами.",
                        "zh": "用目光死死盯着某人，仿佛要看穿对方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверлить взглядом",
                                "target_lang_sense_clarification": "пристально смотреть"
                            },
                            {
                                "target_lang_word": "буравить",
                                "target_lang_sense_clarification": "пронзать взглядом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死死盯着",
                                "target_lang_sense_clarification": "目光锐利地注视"
                            },
                            {
                                "target_lang_word": "凝视",
                                "target_lang_sense_clarification": "专注地看"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64d215ac-ef69-3661-93b0-1cdea9981328",
                    "sense_definition": "A situation, activity, or thing that is dull, annoying, or uninteresting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waiting in line at the bank is such a <w>bore</w>.",
                            "target_lang_translations": {
                                "ru": "Стоять в очереди в банке — такая <w>скука</w>.",
                                "zh": "在银行排队真是件<w>无聊的事</w>。"
                            }
                        },
                        {
                            "text": "It was a real <w>bore</w> to wash all those dishes by hand.",
                            "target_lang_translations": {
                                "ru": "Было настоящей <w>тоской</w> мыть всю эту посуду вручную.",
                                "zh": "手洗那么多碗盘真是件<w>烦心事</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snooze",
                        "nuisance",
                        "drag"
                    ],
                    "antonyms": [
                        "thrillsville"
                    ],
                    "common_phrases": [
                        "what a bore",
                        "such a bore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ситуация, занятие или вещь, которые скучны, раздражают или неинтересны.",
                        "zh": "令人感到无聊或厌烦的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скука",
                                "target_lang_sense_clarification": "скучное занятие или состояние"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "что-то унылое и неинтересное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无聊的事",
                                "target_lang_sense_clarification": "令人乏味的事情"
                            },
                            {
                                "target_lang_word": "烦心事",
                                "target_lang_sense_clarification": "令人厌烦的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f0f1ba0-4f37-3379-8ee1-54bd0fe0875a",
                    "sense_definition": "A person who is very dull and causes others to lose interest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>bore</w>; come to the party with us!",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>занудой</w>, пойдем на вечеринку с нами!",
                                "zh": "别那么<w>无趣</w>，跟我们一起去派对吧！"
                            }
                        },
                        {
                            "text": "He is a terrible <w>bore</w> when he talks about his coin collection.",
                            "target_lang_translations": {
                                "ru": "Он жуткий <w>зануда</w>, когда говорит о своей коллекции монет.",
                                "zh": "他一谈起自己的钱币收藏，就是个十足的<w>乏味的人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drag",
                        "wet blanket"
                    ],
                    "common_phrases": [
                        "total bore",
                        "crashing bore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который очень скучен и вызывает у других потерю интереса.",
                        "zh": "令人感到乏味、无趣的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "надоедливый, скучный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无趣的人",
                                "target_lang_sense_clarification": "令人感到枯燥的人"
                            },
                            {
                                "target_lang_word": "乏味的人",
                                "target_lang_sense_clarification": "说话做事没意思的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "356abbb2-df55-3ed7-9ff5-3a6f0cefa25c",
                    "sense_definition": "The hollow part inside a gun barrel or a tube, or the diameter of this part.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic measured the <w>bore</w> of the cylinder.",
                            "target_lang_translations": {
                                "ru": "Механик измерил <w>диаметр</w> цилиндра.",
                                "zh": "技工测量了气缸的<w>内径</w>。"
                            }
                        },
                        {
                            "text": "This old rifle has a very large <w>bore</w>.",
                            "target_lang_translations": {
                                "ru": "У этой старой винтовки очень крупный <w>калибр</w>.",
                                "zh": "这把旧步枪的<w>口径</w>很大。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "smooth bore",
                        "small bore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полость внутри ствола оружия или трубы, либо диаметр этой части.",
                        "zh": "枪管或管子的内径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "калибр",
                                "target_lang_sense_clarification": "диаметр отверстия"
                            },
                            {
                                "target_lang_word": "канал ствола",
                                "target_lang_sense_clarification": "внутренняя полость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口径",
                                "target_lang_sense_clarification": "枪管内径"
                            },
                            {
                                "target_lang_word": "内径",
                                "target_lang_sense_clarification": "管状物的内部直径"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb21d94-9e24-38ed-b6aa-7bec6c059869",
                    "sense_definition": "A sudden, high wave caused by the tide rushing up a narrow river or estuary.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Surfers gathered to ride the tidal <w>bore</w> up the river.",
                            "target_lang_translations": {
                                "ru": "Серферы собрались, чтобы оседлать приливную <w>волну</w> на реке.",
                                "zh": "冲浪者们聚集在一起，准备在河中冲<w>涌潮</w>。"
                            }
                        },
                        {
                            "text": "The incoming <w>bore</w> swept rapidly upstream, flooding the banks.",
                            "target_lang_translations": {
                                "ru": "Наступающий <w>бор</w> стремительно пронесся вверх по течению, затапливая берега.",
                                "zh": "奔涌而来的<w>涌潮</w>迅速向上游推进，淹没了河岸。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tidal bore",
                        "eagre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная высокая волна, вызванная приливом, устремляющимся вверх по узкой реке или эстуарию.",
                        "zh": "由潮汐引起的涌入狭窄河流的突发性高浪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бор",
                                "target_lang_sense_clarification": "высокая приливная волна"
                            },
                            {
                                "target_lang_word": "приливная волна",
                                "target_lang_sense_clarification": "волна прилива в устье реки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌潮",
                                "target_lang_sense_clarification": "潮汐形成的浪潮"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "85fd5bad-b41c-34ea-8383-bbe91b1a4935",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bore</w> signed the document.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бор</w> подписал документ.",
                                "zh": "<w>博尔</w>先生签署了这份文件。"
                            }
                        },
                        {
                            "text": "We looked up the name <w>Bore</w> in the directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали фамилию <w>Бор</w> в справочнике.",
                                "zh": "我们在名录里查找了<w>博尔</w>这个名字。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бор",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "博尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}