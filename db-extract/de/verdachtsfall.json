                "senses": [
                    {
                        "sense_id": "23c16bf3-fdea-3a80-a273-d6c59e180bfb",
                        "entry_id": "b7b2f0e2-bee9-3e46-bd60-0c58ed9215a4",
                        "glosses": [
                            "Situation (Fall), in der man davon ausgeht, dass eine bestimmte Vermutung (Verdacht) begründet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c535be8c-171a-43a6-b0bc-f8c5459c8556",
                                "sense_id": "23c16bf3-fdea-3a80-a273-d6c59e180bfb",
                                "text": "In der Elektroindustrie nannten cirka 10 Prozent der Unternehmen konkrete Verdachtsfälle zu Wirtschaftsspionage und Konkurrenzausspähung in den vergangenen fünf Jahren."
                            },
                            {
                                "example_id": "e1c67bc0-4feb-4acc-a073-ca2b3d538e37",
                                "sense_id": "23c16bf3-fdea-3a80-a273-d6c59e180bfb",
                                "text": "„Der Verdachtsfall auf eine Infektion mit dem Coronavirus im Rhein-Sieg-Kreis konnte am Donnerstagmittag nicht bestätigt werden.“"
                            },
                            {
                                "example_id": "7ffba4a2-b833-47bc-8f71-a9ddbd511767",
                                "sense_id": "23c16bf3-fdea-3a80-a273-d6c59e180bfb",
                                "text": "„Das dortige Oberverwaltungsgericht hat am Montag geurteilt, dass der Verfassungsschutz die AfD als rechtsextremen Verdachtsfall beobachten und die Öffentlichkeit darüber informieren darf. Das Vorgehen des Inlandsgeheimdienstes sei nach dem Verfassungsschutzgesetz erforderlich und geboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e63cb039-6d30-39c0-8b5d-c36d614a7bd7",
                        "entry_id": "b7b2f0e2-bee9-3e46-bd60-0c58ed9215a4",
                        "glosses": [
                            "Person, die vermutlich mit einem Krankheitserreger infiziert ist oder auch vermutlich an einer Krankheit leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc53cef3-1f07-47f5-966d-a1d60249f013",
                                "sense_id": "e63cb039-6d30-39c0-8b5d-c36d614a7bd7",
                                "text": "Die Zahl der Infizierten und Verdachtsfälle steigt immer noch leicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
