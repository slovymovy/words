            {
                "entry_id": "1b4f69f7-15e3-3f60-af88-1189d390fd1d",
                "word": "rhétoricien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d3a3104-d4d7-4ac9-b13a-2199ff31c712",
                        "entry_id": "1b4f69f7-15e3-3f60-af88-1189d390fd1d",
                        "tags": [
