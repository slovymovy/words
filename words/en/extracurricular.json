{
    "word_family": [
        "curricular",
        "curriculum",
        "cocurricular",
        "intercurricular"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0fdc1e00-0498-3280-8b56-e6a4c39876d9",
                    "sense_definition": "Existing or taking place outside the normal curriculum of an educational establishment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students enjoy participating in a number of <w>extracurricular</w> activities after school.",
                            "target_lang_translations": {
                                "ru": "Ученикам нравится участвовать во многих <w>внеклассных</w> мероприятиях после школы."
                            }
                        },
                        {
                            "text": "Universities often look for applicants with rich <w>extracurricular</w> backgrounds.",
                            "target_lang_translations": {
                                "ru": "Университеты часто ищут абитуриентов с богатым опытом <w>внеучебной</w> деятельности."
                            }
                        }
                    ],
                    "synonyms": [
                        "after-school",
                        "cocurricular"
                    ],
                    "antonyms": [
                        "curricular"
                    ],
                    "common_phrases": [
                        "extracurricular activities",
                        "extracurricular pursuits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или проводящийся вне рамок основной учебной программы образовательного учреждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внеклассный",
                                "target_lang_sense_clarification": "о занятиях или деятельности школьников"
                            },
                            {
                                "target_lang_word": "внеурочный",
                                "target_lang_sense_clarification": "проходящий не на уроках, вне расписания"
                            },
                            {
                                "target_lang_word": "внеучебный",
                                "target_lang_sense_clarification": "относящийся к деятельности вне учебного плана"
                            },
                            {
                                "target_lang_word": "внеаудиторный",
                                "target_lang_sense_clarification": "о деятельности студентов вне лекций и семинаров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96085b9-107e-3309-b7b5-c8eae44d1b13",
                    "sense_definition": "Occurring outside of or in addition to the normal duties of a job or profession.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "job_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager devoted his weekends to <w>extracurricular</w> community service projects.",
                            "target_lang_translations": {
                                "ru": "Менеджер посвящал свои выходные <w>общественным</w> волонтерским проектам."
                            }
                        },
                        {
                            "text": "Her boss disapproved of any <w>extracurricular</w> consulting work during the quarter.",
                            "target_lang_translations": {
                                "ru": "Её начальник не одобрял никакой <w>сторонней</w> консультационной работы в течение квартала."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий помимо или в дополнение к основным профессиональным или служебным обязанностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "сверх основной работы"
                            },
                            {
                                "target_lang_word": "общественный",
                                "target_lang_sense_clarification": "о внеслужебной деятельности"
                            },
                            {
                                "target_lang_word": "сторонний",
                                "target_lang_sense_clarification": "не связанный с прямыми обязанностями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "302805ab-f5e5-3bd9-a295-3f558c79465f",
                    "sense_definition": "Occurring outside of marriage; extramarital.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affair_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician resigned after details of his <w>extracurricular</w> romance became public.",
                            "target_lang_translations": {
                                "ru": "Политик ушел в отставку после того, как подробности его романа <w>на стороне</w> стали достоянием общественности."
                            }
                        },
                        {
                            "text": "Rumors about his <w>extracurricular</w> liaisons circulated in the press for weeks.",
                            "target_lang_translations": {
                                "ru": "Слухи о его <w>внебрачных</w> связях циркулировали в прессе несколько недель."
                            }
                        }
                    ],
                    "synonyms": [
                        "extramarital",
                        "adulterous"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий вне брака; внебрачный (обычно шутливо или эвфемистично)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внебрачный",
                                "target_lang_sense_clarification": "о романе или интрижке на стороне"
                            },
                            {
                                "target_lang_word": "на стороне",
                                "target_lang_sense_clarification": "о любовных связях вне брака"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fd8dde4-3e5b-3548-bb1c-e2f34a9412ef",
                    "sense_definition": "An activity pursued outside the regular academic course of study.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He balanced his coursework with sports and other <w>extracurriculars</w>.",
                            "target_lang_translations": {
                                "ru": "Он совмещал учебу со спортом и другими <w>внеклассными занятиями</w>."
                            }
                        },
                        {
                            "text": "Joining the debate club was her favorite <w>extracurricular</w> during high school.",
                            "target_lang_translations": {
                                "ru": "Участие в дебат-клубе было её любимым <w>кружком</w> в старших классах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кружок, секция или любое занятие, которым занимаются помимо обязательной учебной программы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внеклассное занятие",
                                "target_lang_sense_clarification": "секция, кружок или активность школьника"
                            },
                            {
                                "target_lang_word": "внеучебная деятельность",
                                "target_lang_sense_clarification": "студенческие или школьные активности помимо учебы"
                            },
                            {
                                "target_lang_word": "кружок",
                                "target_lang_sense_clarification": "факультативное занятие по интересам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2eae0069-01dd-3bc0-940a-8ca37c4a4def",
                    "sense_definition": "An activity or pursuit conducted beyond one's official professional duties.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "job_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent so much time on office <w>extracurriculars</w> that his primary work suffered.",
                            "target_lang_translations": {
                                "ru": "Он тратил так много времени на корпоративную <w>общественную деятельность</w>, что страдала его основная работа."
                            }
                        },
                        {
                            "text": "Volunteering on the company charity board was a rewarding <w>extracurricular</w>.",
                            "target_lang_translations": {
                                "ru": "Волонтерство в благотворительном совете компании было полезной <w>общественной нагрузкой</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность, проект или увлечение, выходящие за рамки официальных трудовых обязанностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общественная нагрузка",
                                "target_lang_sense_clarification": "дополнительная деятельность на работе"
                            },
                            {
                                "target_lang_word": "сторонний проект",
                                "target_lang_sense_clarification": "дополнительное занятие помимо основной работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b210c526-4ecf-3d68-8ba1-948cf4228e0a",
                    "sense_definition": "An illicit sexual relationship outside of marriage; an extramarital affair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affair_scope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tabloid focused heavily on his secret <w>extracurriculars</w> while on tour.",
                            "target_lang_translations": {
                                "ru": "Таблоид уделил особое внимание его тайным <w>походам налево</w> во время гастролей."
                            }
                        },
                        {
                            "text": "She discovered evidence that exposed his latest <w>extracurricular</w>.",
                            "target_lang_translations": {
                                "ru": "Она нашла улики, разоблачившие его очередную <w>интрижку на стороне</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "affair",
                        "adultery"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любовная связь вне брака; интрижка на стороне (шутл. или эвф.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интрижка на стороне",
                                "target_lang_sense_clarification": "мимолетный роман вне брака"
                            },
                            {
                                "target_lang_word": "поход налево",
                                "target_lang_sense_clarification": "супружеская измена (разг., шутл.)"
                            },
                            {
                                "target_lang_word": "связь на стороне",
                                "target_lang_sense_clarification": "внебрачные отношения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}