                                                "sense_id": "6f44c16d-5c68-318d-b974-95928c41ea5f",
                                                "text": "Phew, that took a long time to cook!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "795eafab-0e89-3c6d-8abf-1f5f133dbfa5",
                                        "entry_id": "20772688-ce7d-3ab4-9337-c50f889f6110",
                                        "glosses": [
