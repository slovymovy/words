                "senses": [
                    {
                        "sense_id": "c957a8a4-537a-3d90-9cf1-4cf840845909",
                        "entry_id": "a87bcb50-fe7c-3cf1-a577-debb367b1975",
                        "glosses": [
                            "Angehörige der gleichnamigen Bevölkerungsgruppe im Osten Siebenbürgens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f196b59-2d7e-489b-bebb-818e279c54c6",
                                "sense_id": "c957a8a4-537a-3d90-9cf1-4cf840845909",
                                "text": "„Da wir Gäste sind, führt uns die wohlerzogene Szeklerin in das ‚große Haus‘ (nagy-ház).“"
                            },
                            {
                                "example_id": "81a6a263-8d46-4982-87a6-b2d7b2aa3045",
                                "sense_id": "c957a8a4-537a-3d90-9cf1-4cf840845909",
                                "text": "„Dieses Kleidungsverhalten teilten die jungen Sächsinnen und Landlerinnen in der Stadt mit den Szeklerinnen, die sich aus ähnlichen Gründen zeitweilig nach Hermannstadt oder gar nach Bukarest verdingten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
