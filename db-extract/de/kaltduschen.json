                "senses": [
                    {
                        "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                        "entry_id": "af8f1ba8-a9b8-30fb-ba5d-7c19d376e1e8",
                        "glosses": [
                            "Duschen mit kaltem Wasser (meist zur Abhärtung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857a9737-8454-4351-b58f-29d3ee5a2968",
                                "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                                "text": "„Ein Mensch müsse sich ja auch ans Kaltduschen gewöhnen.“"
                            },
                            {
                                "example_id": "d5beb73a-99d9-4f9c-8d40-410dae35cb48",
                                "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                                "text": "„Und während ich selbst von Kindheit an eine Verfechterin des Kaltduschens bin und des dicken Pullovers mit dem Tee zum Händewärmen im Winter, spüre ich eine leise Sorge angesichts der Tipps.“"
                            },
                            {
                                "example_id": "33340220-7483-4400-bf8e-00ecedfde55d",
                                "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                                "text": "„Go with the flow und sieh es als gute Möglichkeit, dir die Vorzüge des Kaltduschens anzugewöhnen und schätzen zu lernen.“"
                            },
                            {
                                "example_id": "efaceb68-bd2d-4b83-b74a-4d445d888747",
                                "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                                "text": "„Noch vor Verbrennermotor und dem über offenem Feuer geschwärzten Nackensteak gehört Kaltduschen zu den mythologischen Kraftquellen der deutschen Seele.“"
                            },
                            {
                                "example_id": "a881429d-d64d-498d-b651-6fa9e95a7b2d",
                                "sense_id": "1b280fb1-201d-3f93-a4fd-411f011cacc4",
                                "text": "„Ich weiß nicht, wie ich auf die Idee mit dem Kaltduschen gekommen bin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
