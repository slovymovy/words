                        "cross_references": [
                            {
                                "target_word": "狐狸精",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "17b7cb7c-de85-3be6-aa8e-8b142717ff14",
                                        "entry_id": "82431f88-1f20-3ea5-ada8-5f7f282b0eb1",
                                        "glosses": [
                                            "狐仙"
                                        ],
                                        "tags": [
                                            "中國神話"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94908437-a7a1-4fe2-8c85-b37e5195c056",
                                                "sense_id": "17b7cb7c-de85-3be6-aa8e-8b142717ff14",
                                                "text": "他們說那一個叫作妲己的是狐狸精，只有兩隻腳變不成人樣，便用布條子裹起來。"
                                            },
                                            {
                                                "example_id": "a2ae5cf4-c42e-4e87-a07c-024f397fe7e4",
                                                "sense_id": "17b7cb7c-de85-3be6-aa8e-8b142717ff14",
                                                "text": "他们说那一个叫作妲己的是狐狸精，只有两只脚变不成人样，便用布条子裹起来。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8996338-3478-3fff-bd3a-accb9da19702",
                                        "entry_id": "82431f88-1f20-3ea5-ada8-5f7f282b0eb1",
                                        "glosses": [
                                            "妖豔淫蕩的女子；狡猾奸詐的人"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbd3b78-0bd2-4001-8475-37490c4d0029",
                                                "sense_id": "d8996338-3478-3fff-bd3a-accb9da19702",
                                                "text": "我雖生的比別人略好些，并沒有私情密意勾引你怎樣，如何一口死咬定了我是個狐狸精！"
                                            },
                                            {
                                                "example_id": "deab92a4-43ef-45fb-8ce3-e661f4155db1",
                                                "sense_id": "d8996338-3478-3fff-bd3a-accb9da19702",
                                                "text": "我虽生的比别人略好些，并没有私情密意勾引你怎样，如何一口死咬定了我是个狐狸精！"
                                            }
                                        ]
                                    }
                                ]
                            }
