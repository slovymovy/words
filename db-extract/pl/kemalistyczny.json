                                        "sense_id": "e191a412-10eb-3edb-9f22-48a7bc653559",
                                        "entry_id": "bcb45172-c1e1-3a0b-a0ed-c175e3355b02",
                                        "glosses": [
                                            "Of or pertaining to the ideology of Mustafa Kemal Atatürk; following the ideals of Kemalism, including separation of the new Turkish state from its Ottoman predecessor and the embracement of Western-style democracy and secularism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "193d229b-c0d1-40cb-a942-8b1914fc665f",
                                                "sense_id": "e191a412-10eb-3edb-9f22-48a7bc653559",
                                                "text": "From successive crises in Crete and Cyprus over enosis (‘union’) with the Greek mainland to the great clash with Kemalist Turkey over Anatolia in the aftermath of the First World War, dreams of greater Greece have wrought untold havoc in the eastern Mediterranean."
                                            }
                                        ]
                                    }
