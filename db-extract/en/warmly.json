                ],
                "senses": [
                    {
                        "sense_id": "30c5b1e8-c480-3dc9-967a-8def5137afcb",
                        "entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "glosses": [
                            "In a manner that maintains warm temperature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b8aab83-75db-42fe-b835-3447ba267374",
                                "sense_id": "30c5b1e8-c480-3dc9-967a-8def5137afcb",
                                "text": "Be sure to dress warmly today!"
                            },
                            {
                                "example_id": "9adaae0d-2df5-4be3-b1b5-734179927e43",
                                "sense_id": "30c5b1e8-c480-3dc9-967a-8def5137afcb",
                                "text": "When praying in winter — and the winter in Regensburg was very cold — one should not shorten the prayers. He who is not warmly dressed, should go home."
                            }
                        ]
                    },
                    {
                        "sense_id": "881e9280-5863-357a-9776-8c68f943fd68",
                        "entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "glosses": [
                            "In a warm, friendly manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b906aba-7a73-417f-91e6-26935379a87a",
                                "sense_id": "881e9280-5863-357a-9776-8c68f943fd68",
                                "text": "I said so - I said so warmly, for I felt that the Professor was an ill-used man."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fd42796-4c66-3429-82a1-2c0d168d729e",
                        "entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "glosses": [
                            "With emotion, especially some anger; somewhat hotly."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "03b1fa02-926e-45a8-abda-c36ec2a4d46f",
                                "sense_id": "8fd42796-4c66-3429-82a1-2c0d168d729e",
                                "text": "One evening in particular, about a week after Colonel Brandon left the country, his heart seemed more than usually open to every feeling of attachment to the objects around him; and on Mrs. Dashwood’s happening to mention her design of improving the cottage in the spring, he warmly opposed every alteration of a place which affection had established as perfect with him. “What!” he exclaimed⁠—“improve this dear cottage! No. That I will never consent to. Not a stone must be added to its walls, not an inch to its size, if my feelings are regarded.”"
                            },
                            {
                                "example_id": "8a6fb25b-73db-431e-bee8-fb21ecb6f29b",
                                "sense_id": "8fd42796-4c66-3429-82a1-2c0d168d729e",
                                "text": "Elinor then ventured to doubt the propriety of her receiving such a present from a man so little, or at least so lately known to her. This was too much. “You are mistaken, Elinor,” said she warmly, “in supposing I know very little of Willoughby.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dab5c234-0406-42ca-830f-c2319cbb4313",
                        "source_entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "source_sense_description": "in a manner maintaining warm temperature",
                        "target_lang_word": "teple",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed672fed-b883-44ba-9066-e56d3cc21c3a",
                        "source_entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "source_sense_description": "in a manner maintaining warm temperature",
                        "target_lang_word": "chaudement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaudement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "891c5aac-7d73-3b59-b5fd-f7725b4dfcd6",
                                        "entry_id": "336b6c54-940c-3527-abd9-3148a7f971aa",
                                        "glosses": [
                                            "Avec chaleur ; de manière à conserver sa chaleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a0ee91-e7ea-4c7c-a1c6-59b710df6079",
                                                "sense_id": "891c5aac-7d73-3b59-b5fd-f7725b4dfcd6",
                                                "text": "Aussi lorsque mon conducteur me voit apparaître, chaudement emmitouflée dans ma veste de ragondin et chaussée de confortables après-skis bien fourrés, il applaudit :\n— Vous avez l'air d'une vraie Canadienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598dc3ee-873e-35e8-9fe2-ec3024d80b06",
                                        "entry_id": "336b6c54-940c-3527-abd9-3148a7f971aa",
                                        "glosses": [
                                            "Avec ardeur et vivacité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5659259-086a-415d-80bd-5f139f90c22a",
                                                "sense_id": "598dc3ee-873e-35e8-9fe2-ec3024d80b06",
                                                "text": "L’éminent gastronome Grimod de la Reynière fait chorus, qui déconseille le céleri aux timides, mais le recommande chaudement aux célibataires."
                                            },
                                            {
                                                "example_id": "187357e0-148d-4c5b-a9c6-d1651c8daf7a",
                                                "sense_id": "598dc3ee-873e-35e8-9fe2-ec3024d80b06",
                                                "text": "Ils poursuivaient chaudement leur ennemi."
                                            },
                                            {
                                                "example_id": "2e419138-8063-4235-b6ef-627187b651bc",
                                                "sense_id": "598dc3ee-873e-35e8-9fe2-ec3024d80b06",
                                                "text": "Le prince qui prend si chaudement les intérêts d’Alexandre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10ae7b4b-9a59-3ced-80c6-7306c96e67d8",
                                        "entry_id": "336b6c54-940c-3527-abd9-3148a7f971aa",
                                        "glosses": [
                                            "Tout de suite, à l’instant même."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e5837c-b3c5-46b8-988a-e7bd2a34bdb1",
                                                "sense_id": "10ae7b4b-9a59-3ced-80c6-7306c96e67d8",
                                                "text": "Voilà ses mêmes paroles que je vous écris tout chaudement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8babd0cb-aab3-471d-8d27-c65faf3d785f",
                        "source_entry_id": "81ff6b7a-41c1-3d71-863f-90db8dd95f99",
                        "source_sense_description": "in a manner maintaining warm temperature",
                        "target_lang_word": "тепло́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тепло́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a5aa7fd5-484d-3163-be14-7dd1ffa07911",
                                        "entry_id": "f40b9232-21a1-3acf-b55f-8c86c4f28ba8",
                                        "glosses": [
                                            "нагретое состояние, высокая температура, слабый жар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbdddcc8-cad7-44bb-bae0-37542ad6bcd8",
                                                "sense_id": "a5aa7fd5-484d-3163-be14-7dd1ffa07911",
                                                "text": "От печки исходит приятное тепло."
                                            },
                                            {
                                                "example_id": "41baf593-2a8e-4708-8ddd-16bd1b042cf5",
                                                "sense_id": "a5aa7fd5-484d-3163-be14-7dd1ffa07911",
                                                "text": "Весеннее тепло сменило зимний холод."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43066499-d487-3e94-b62d-8c84f17841bb",
                                        "entry_id": "f40b9232-21a1-3acf-b55f-8c86c4f28ba8",
                                        "glosses": [
                                            "перен. душевная доброта, сердечная приветливость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf13f115-17b2-49e9-89af-7ac5f23b3ecb",
                                                "sense_id": "43066499-d487-3e94-b62d-8c84f17841bb",
                                                "text": "Всё, что мог и хотел дать сыну Маркел Тихонович: любовь, тепло сердца, навыки в сельском, глазу не заметном труде, ремёсла, так необходимые в хозяйстве, — всё-всё готов был тесть обрушить на зятя."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "тепло́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "506234d6-4dfb-3ee1-88e0-7196f4358626",
                                        "entry_id": "15c5bce7-ce1b-3b6e-ba11-741ba32d0ebd",
                                        "glosses": [
                                            "наречие по значению прилагательного тёплый (прям. и перен.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9646a23a-0557-4764-b021-91580f1c9951",
                                                "sense_id": "506234d6-4dfb-3ee1-88e0-7196f4358626",
                                                "text": "Для того дети, весьма тепло одеваемые, бывают слабы и склонны к разным болезням, происходящим от худобы и нечистоты соков."
                                            },
                                            {
                                                "example_id": "6fa31f30-4ff5-48eb-b322-38e92cddc76a",
                                                "sense_id": "506234d6-4dfb-3ee1-88e0-7196f4358626",
                                                "text": "Повелеваем объявлять нам ежегодно, сколько в котором округе стариков, коих семья не в состоянии их одевать тепло, кормить мясом и поить вином, да удовольствуют их нашим собственным, и проч.»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "440a282e-e8b5-3c91-8f1d-0067aef4cb3b",
                                        "entry_id": "15c5bce7-ce1b-3b6e-ba11-741ba32d0ebd",
                                        "glosses": [
                                            "предик. ощущается тепло [I]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51d897f-886a-4695-a46b-ee22761bf7c0",
                                                "sense_id": "440a282e-e8b5-3c91-8f1d-0067aef4cb3b",
                                                "text": "И слыша, что у Ратибора в избе тепло и завтрак приготовлен, пошли во оную."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
