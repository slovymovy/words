                                        "examples": [
                                            {
                                                "example_id": "8e32a876-36e4-48ce-be15-bf027fc10782",
                                                "sense_id": "e38f9ed3-6401-3a08-b127-50091a9612a6",
                                                "text": "À son premier départ, face aux Elks d’Edmonton, Evans a lancé trois passes de touché dans une victoire de 34 à 24."
                                            },
                                            {
                                                "example_id": "fcdbd2c0-5c65-47d1-a620-138ff26a51bd",
                                                "sense_id": "e38f9ed3-6401-3a08-b127-50091a9612a6",
                                                "text": "J’en suis à ma cinquième année, j’ai un Super Bowl, j’ai beaucoup de matchs à mon actif et ce qui me manquait, c’était un touché."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "touché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8d152a-b09d-3590-986c-e865285f3ffa",
