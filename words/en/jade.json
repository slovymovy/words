{
    "word_family": [
        "jaded",
        "jadedly",
        "jadedness",
        "jadestone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0049d23d-be0c-3728-bdfb-5e54af90a891",
                    "sense_definition": "A semiprecious stone, either nephrite or jadeite, generally green or white in color, often used for carving figurines.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "stone_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a magnificent statue carved entirely from white <w>jade</w>.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена великолепная статуя, вырезанная целиком из белого <w>нефрита</w>.",
                                "pl": "W muzeum wystawiono wspaniały posąg wyrzeźbiony w całości z białego <w>jadeitu</w>."
                            }
                        },
                        {
                            "text": "She wore a delicate necklace made of green <w>jade</w> beads around her neck.",
                            "target_lang_translations": {
                                "ru": "Она носила на шее изящное ожерелье из бусин зеленого <w>нефрита</w>.",
                                "pl": "Nosiła na szyi delikatny naszyjnik z koralików z zielonego <w>jadeitu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jadestone"
                    ],
                    "common_phrases": [
                        "piece of jade",
                        "carved jade",
                        "green jade",
                        "jade carving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полудрагоценный камень, обычно зеленого или белого цвета, используемый для резьбы и украшений.",
                        "pl": "Półszlachetny minerał, zazwyczaj zielony lub biały, używany do rzeźbienia figurek i wyrobu biżuterii."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нефрит",
                                "target_lang_sense_clarification": "минерал"
                            },
                            {
                                "target_lang_word": "жадеит",
                                "target_lang_sense_clarification": "разновидность минерала"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jadeit",
                                "target_lang_sense_clarification": "minerał"
                            },
                            {
                                "target_lang_word": "nefryt",
                                "target_lang_sense_clarification": "minerał"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e586fa3-d1b0-3483-80c4-9d27b483b214",
                    "sense_definition": "A bright shade of slightly bluish or greyish green, typical of polished jade stones.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_shade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the ocean with deep blues and flashes of <w>jade</w>.",
                            "target_lang_translations": {
                                "ru": "Художник написал океан глубокими синими красками с проблесками <w>нефритового цвета</w>.",
                                "pl": "Artysta namalował ocean głębokimi błękitami z przebłyskami <w>koloru jadeitowego</w>."
                            }
                        },
                        {
                            "text": "We decided to paint the bathroom walls a soothing shade of <w>jade</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили покрасить стены ванной в успокаивающий оттенок <w>нефрита</w>.",
                                "pl": "Zdecydowaliśmy się pomalować ściany w łazience na kojący <w>odcień jadeitu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jade green"
                    ],
                    "common_phrases": [
                        "shade of jade",
                        "dark jade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий оттенок зеленого цвета (обычно с голубоватым или сероватым отливом), характерный для нефрита.",
                        "pl": "Jasny odcień zieleni, często z niebieskawym lub szarawym zabarwieniem, przypominający kolor kamienia jadeitu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нефритовый цвет",
                                "target_lang_sense_clarification": "существительное"
                            },
                            {
                                "target_lang_word": "цвет нефрита",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kolor jadeitowy",
                                "target_lang_sense_clarification": "odcień koloru"
                            },
                            {
                                "target_lang_word": "kolor nefrytowy",
                                "target_lang_sense_clarification": "odcień koloru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1bd7d82-feaa-3895-a93b-2a65da0cba1b",
                    "sense_definition": "A succulent plant, Crassula ovata, often grown as a houseplant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I keep a small <w>jade</w> on the windowsill because it requires very little water.",
                            "target_lang_translations": {
                                "ru": "Я держу на подоконнике маленькую <w>толстянку</w>, потому что она требует очень мало воды.",
                                "pl": "Trzymam małego <w>grubosza</w> na parapecie, ponieważ wymaga bardzo mało wody."
                            }
                        },
                        {
                            "text": "Her grandmother gave her a cutting from her large <w>jade</w> plant to grow at home.",
                            "target_lang_translations": {
                                "ru": "Бабушка дала ей черенок от своего большого <w>денежного дерева</w>, чтобы она вырастила его дома.",
                                "pl": "Babcia dała jej sadzonkę ze swojego dużego <w>drzewka szczęścia</w>, żeby wyhodowała je w domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "jade plant",
                        "money tree"
                    ],
                    "common_phrases": [
                        "potted jade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суккулентное растение (толстянка яйцевидная), часто выращиваемое как комнатное.",
                        "pl": "Roślina sukulentowa (Crassula ovata), często uprawiana jako roślina doniczkowa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толстянка",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "денежное дерево",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "grubosz",
                                "target_lang_sense_clarification": "nazwa botaniczna"
                            },
                            {
                                "target_lang_word": "drzewko szczęścia",
                                "target_lang_sense_clarification": "potoczna nazwa rośliny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                    "sense_definition": "A horse that is too old or worn out to be put to work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer refused to ride the broken-down <w>jade</w> into the city.",
                            "target_lang_translations": {
                                "ru": "Фермер отказался ехать в город на этой разбитой <w>кляче</w>.",
                                "pl": "Rolnik odmówił wjazdu do miasta na tej zajeżdżonej <w>szkapie</w>."
                            }
                        },
                        {
                            "text": "He traded his strong stallion for a sorry <w>jade</w> and regretted it immediately.",
                            "target_lang_translations": {
                                "ru": "Он обменял своего сильного жеребца на жалкую <w>клячу</w> и тут же пожалел об этом.",
                                "pl": "Zamienił swojego silnego ogiera na marną <w>chabetę</w> i natychmiast tego pożałował."
                            }
                        }
                    ],
                    "synonyms": [
                        "nag"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадь, которая слишком стара, больна или изнурена для работы.",
                        "pl": "Stary, wycieńczony lub zaniedbany koń, niezdolny do ciężkiej pracy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кляча",
                                "target_lang_sense_clarification": "старая лошадь"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szkapa",
                                "target_lang_sense_clarification": "stary, lichy koń"
                            },
                            {
                                "target_lang_word": "chabeta",
                                "target_lang_sense_clarification": "stary, zaniedbany koń"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                    "sense_definition": "A bad-tempered or disreputable woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old play, the villain describes the heroine as a spiteful <w>jade</w>.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе злодей описывает героиню как злобную <w>мегеру</w>.",
                                "pl": "W starej sztuce czarny charakter opisuje bohaterkę jako złośliwą <w>megerę</w>."
                            }
                        },
                        {
                            "text": "The angry landlord called her a <w>jade</w> when she refused to pay the rent.",
                            "target_lang_translations": {
                                "ru": "Рассерженный домовладелец обозвал её <w>негодницей</w>, когда она отказалась платить за аренду.",
                                "pl": "Wściekły właściciel mieszkania nazwał ją <w>wiedźmą</w>, gdy odmówiła zapłacenia czynszu."
                            }
                        }
                    ],
                    "synonyms": [
                        "harridan",
                        "shrew",
                        "termagant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сварливая женщина или женщина с дурной репутацией.",
                        "pl": "Przestarzałe określenie na złośliwą, kłótliwą kobietę lub kobietę o złej reputacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мегера",
                                "target_lang_sense_clarification": "злая женщина"
                            },
                            {
                                "target_lang_word": "негодница",
                                "target_lang_sense_clarification": "бранное слово"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "megera",
                                "target_lang_sense_clarification": "złośliwa kobieta"
                            },
                            {
                                "target_lang_word": "wiedźma",
                                "target_lang_sense_clarification": "obraźliwie o kobiecie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2868080-69b0-3d65-bc9e-ebba30f31c09",
                    "sense_definition": "Of a grayish shade of green, typical of jade stones.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_shade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a beautiful <w>jade</w> dress for the evening party.",
                            "target_lang_translations": {
                                "ru": "Она купила красивое <w>нефритовое</w> платье для вечеринки.",
                                "pl": "Kupiła piękną <w>jadeitową</w> sukienkę na wieczorne przyjęcie."
                            }
                        },
                        {
                            "text": "The water in the bay was a deep <w>jade</w> color before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Вода в заливе была глубокого <w>нефритового</w> цвета перед началом шторма.",
                                "pl": "Woda w zatoce miała głęboki <w>jadeitowy</w> kolor przed nadejściem burzy."
                            }
                        }
                    ],
                    "synonyms": [
                        "jade-green"
                    ],
                    "common_phrases": [
                        "jade eyes",
                        "jade figurine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий серовато-зеленый оттенок, свойственный нефриту.",
                        "pl": "Mający szaro-zielony odcień, charakterystyczny dla kamieni jadeitu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нефритовый",
                                "target_lang_sense_clarification": "прилагательное цвета"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "jadeitowy",
                                "target_lang_sense_clarification": "przymiotnik określający kolor"
                            },
                            {
                                "target_lang_word": "nefrytowy",
                                "target_lang_sense_clarification": "przymiotnik określający kolor"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3d87283f-eb39-3ed0-8d79-19e5b8cbcb49",
                    "sense_definition": "A female given name.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Jade</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Джейд</w> придет сегодня на ужин.",
                                "pl": "Moja przyjaciółka <w>Jade</w> przychodzi dziś na kolację."
                            }
                        },
                        {
                            "text": "They decided to name their new daughter <w>Jade</w> after the precious stone.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою новорожденную дочь <w>Джейд</w> в честь драгоценного камня.",
                                "pl": "Postanowili nazwać swoją nowo narodzoną córkę <w>Jade</w> na cześć tego drogocennego kamienia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "pl": "Żeńskie imię własne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джейд",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Jade",
                                "target_lang_sense_clarification": "imię"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8297fc9e-4e60-3305-a413-64a00e46c4ac",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Jade</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Джейд</w> примет вас в своем кабинете сейчас.",
                                "pl": "Pan <w>Jade</w> przyjmie cię teraz w swoim gabinecie."
                            }
                        },
                        {
                            "text": "We looked up the <w>Jade</w> family in the local telephone directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали семью <w>Джейд</w> в местном телефонном справочнике.",
                                "pl": "Sprawdziliśmy rodzinę <w>Jade</w> w lokalnej książce telefonicznej."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "pl": "Nazwisko."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джейд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Jade",
                                "target_lang_sense_clarification": "nazwisko"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "660cd9ce-3507-311a-98ce-481a9e4e95fb",
                    "sense_definition": "To fatigue, tire, or weary someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fatigue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long journey began to <w>jade</w> the horses before they reached the inn.",
                            "target_lang_translations": {
                                "ru": "Долгое путешествие начало <w>утомлять</w> лошадей еще до того, как они добрались до постоялого двора.",
                                "pl": "Długa podróż zaczęła <w>męczyć</w> konie, zanim dotarły do gospody."
                            }
                        },
                        {
                            "text": "Constant repetition can <w>jade</w> even the most enthusiastic student.",
                            "target_lang_translations": {
                                "ru": "Постоянное повторение может <w>изнурить</w> даже самого полного энтузиазма студента.",
                                "pl": "Ciągłe powtarzanie może <w>nużyć</w> nawet najbardziej entuzjastycznego ucznia."
                            }
                        }
                    ],
                    "synonyms": [
                        "tire",
                        "exhaust",
                        "weary",
                        "fatigue"
                    ],
                    "common_phrases": [
                        "jade the appetite"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in the participle form 'jaded'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомлять, изнурять или лишать интереса кого-либо.",
                        "pl": "Powodować zmęczenie, znużenie lub wyczerpanie u kogoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утомлять",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "изнурять",
                                "target_lang_sense_clarification": "сильная усталость"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "męczyć",
                                "target_lang_sense_clarification": "powodować zmęczenie"
                            },
                            {
                                "target_lang_word": "nużyć",
                                "target_lang_sense_clarification": "powodować znużenie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}