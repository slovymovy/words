                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song was difficult because it was written in a very high <w>register</w>.",
                            "target_lang_translations": {
                                "ru": "Песня была сложной, потому что была написана в очень высоком <w>регистре</w>.",
                                "zh": "这首歌很难唱，因为它写在非常高的<w>音域</w>。"
                            }
