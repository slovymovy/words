                    },
                    {
                        "translation_id": "aff5b538-f399-4928-9228-7418fc445b34",
                        "source_entry_id": "b377f246-7206-3432-b351-62752fa5ecdd",
                        "source_sense_id": "c34eae2a-fb3a-33f9-a0a9-f64d0483c2c6",
                        "target_lang_word": "prospérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prospérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                        "entry_id": "7479ada2-3b80-3bff-b2e1-16bba1e6ecf7",
                                        "glosses": [
                                            "Heureux état, heureuse situation, soit des affaires générales, soit des affaires particulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f360882-c805-454d-8bfb-87ef7774f057",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Les divers états de prospérité ou de dépérissement d'une Nation agricole, offrent une multitude d'autres données, dont chacune est le fondement d'un calcul particulier qui lui est propre en toute rigueur."
                                            },
                                            {
                                                "example_id": "3d567ee7-beb8-4391-8354-5f2d6ddf217a",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "J'ai connu l'Amérique de la prospérité. J'ai connu cette confiance, cette certitude, cet orgueil. J'ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                                            },
                                            {
                                                "example_id": "41a1cad0-9899-4f10-a4a5-8cba48c30103",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Elle ne devint catastrophe que dans sa troisième phase, quand soudain, au milieu d'un ciel serein, la foudre du krach bancaire de New-York frappa l'édifice orgueilleux de la prospérité du capital américain."
                                            },
                                            {
                                                "example_id": "89801814-1297-4dbc-a5f7-62b3ad8540e3",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Les paysans du Lot, il y a vingt ans, étaient misérables, accablés par les hypothèques dont une prospérité relative, survenue à la suite de la guerre, les libéra."
                                            },
                                            {
                                                "example_id": "7cc54715-e42a-48a1-a634-ecb3ba289ef0",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "La vie urbaine dépérit et, comme la civilisation islamique médiévale était elle-même essentiellement urbaine et que la richesse matérielle dépendait du commerce, la prospérité déclina."
                                            },
                                            {
                                                "example_id": "86f84627-2a8e-45c9-a8f6-53b8e4d56b18",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Du même coup, Épernay passe de 4.000 habitants vers 1850 à 20.000 vers 1900, à 23.000 de nos jours, entraînant dans sa prospérité ses voisines Ay, Dizy, Magenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e232d335-2a0d-3d24-8754-6e30e3744bb4",
                                        "entry_id": "7479ada2-3b80-3bff-b2e1-16bba1e6ecf7",
                                        "glosses": [
                                            "Événements heureux."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44d8c21-691b-44b6-8b60-9fd0f0e9f680",
                                                "sense_id": "e232d335-2a0d-3d24-8754-6e30e3744bb4",
                                                "text": "Rien n’a interrompu le cours de ses prospérités. - Je vous souhaite toute sorte de prospérités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
