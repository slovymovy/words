            {
                "entry_id": "15c0b6df-b717-38fc-a1bc-dba110aa23ea",
                "word": "Mephistopheles",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                        "entry_id": "15c0b6df-b717-38fc-a1bc-dba110aa23ea",
                        "glosses": [
                            "A fiendish person, especially one who tricks someone into following a destructive or disastrous course of action; a tempter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24511b56-a384-4621-a644-f3eb1468374e",
                                "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                                "text": "Poison in my idle mind makes quick work for the Mephistopheles, / Who quickly makes his excuses"
                            },
                            {
                                "example_id": "cbeeda54-7965-4faf-82a9-597ae9ac1a13",
                                "sense_id": "ae5ad08b-4cbc-3771-b040-9b7dcaafe705",
                                "text": "A man weeping in moral torment over bags of money; another so bored, depressed and isolated that he can barely raise his eyes to yet another shopping cart full of cash. These are the products of what I have come to think of as Donaldson in full Mephistopheles mode. “Look what these creatures of flesh and blood will do for cash,” he seems constantly on the verge of intoning, as he observes his subjects like so many mazed rats."
                            }
                        ]
                    }
                ],
