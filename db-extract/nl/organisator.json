                                        "sense_id": "e3c924c3-2d54-38a5-8986-a1d7953f709b",
                                        "entry_id": "b5fe9042-4197-3ee6-bc25-9f0243561c7c",
                                        "glosses": [
                                            "A hand-held micro-computer that will perform specific tasks; can be used as an electronic diary, alarm clock, recorder of memos and notes, a portable database etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4492b281-9a6f-41c3-a4e7-e06a10f64027",
                                                "sense_id": "e3c924c3-2d54-38a5-8986-a1d7953f709b",
                                                "text": "I'll add that meeting to my organizer."
                                            }
                                        ]
                                    },
