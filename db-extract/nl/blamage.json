                "senses": [
                    {
                        "sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "glosses": [
                            "een afgang veroorzaakt door eigen falen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ca74fa-fe5d-4dd8-bbc4-28622a61aefd",
                                "sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                                "text": "De actie werd een complete blamage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d28c891-3462-4476-8b91-807d6f33adf7",
                        "source_entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "source_sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "source_sense_description": "een afgang veroorzaakt door eigen falen",
                        "target_lang_word": "Blamage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blamage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                        "entry_id": "cdcab708-143a-34c4-abde-beda902478d8",
                                        "glosses": [
                                            "Beschämung, Situation, die zu einem Gesichtsverlust führt, die peinlich ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0dffb69-c7d1-474a-a11d-17391acfaa99",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "Der Sturz von der Bühne war eine echte Blamage."
                                            },
                                            {
                                                "example_id": "486a374b-2f26-4c9b-ad33-042a6c3e0df3",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Das war aber weit gefehlt und eine Blamage für Herrn Schutt, denn nichts, was Herr Caroli von sich gab, entstammte dem Büchmann.“"
                                            },
                                            {
                                                "example_id": "bc4115fd-d843-4c56-ad60-e23d9cab5abd",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Niemand würde kommen, sagten sie, um mich anzuhören, und das würde eine demütigende Blamage für mich werden.“"
                                            },
                                            {
                                                "example_id": "0ded1529-e28a-490b-970a-e4af9bd26364",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Keine Regierung hätte es geschafft, einen solchen Modernisierungsschub herbeizuführen, wenn nicht die Aussicht auf internationales Prestige oder auch eine internationale Blamage gewunken hätte.“"
                                            },
                                            {
                                                "example_id": "e9551bae-8a37-4a6f-865d-f30e5411bf80",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Die zweite scheinbare Blamage erlitt Gall bei einem Besuche in einem Gefängnis, wo er in der Kanzlei einen Sträfling nach seiner Schädelform als technisches Genie diagnostiziert hatte.“"
                                            },
                                            {
                                                "example_id": "b1baf80a-3336-4412-aaa5-eb00ef582705",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Wir hatten Angst, dass die Jungen nicht kommen würden, dass wir nicht richtig tanzen können und dass das Ganze letztendlich eine Blamage wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a777fbda-5390-4208-9be8-a44aa679bf40",
                        "source_entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "source_sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "source_sense_description": "een afgang veroorzaakt door eigen falen",
                        "target_lang_word": "disgrace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9f5d1c-214c-3f41-8c98-ba33b4a6b5be",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "The condition of being out of favor; loss of favor, regard, or respect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc174b0-9d1e-4575-ac38-d9b3727b12c9",
                                                "sense_id": "af9f5d1c-214c-3f41-8c98-ba33b4a6b5be",
                                                "text": "I heare / Macduffe liues in diſgrace. Sir, can you tell / Where he beſtowes himſelfe?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be99cd5-8000-39e5-aab9-78c3cfd109e1",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "The state of being dishonored, or covered with shame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7756053a-8f4a-47b8-a6dc-35ce986c9d1f",
                                                "sense_id": "6be99cd5-8000-39e5-aab9-78c3cfd109e1",
                                                "text": "Now she lives in disgrace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "Something which brings dishonor; the cause of reproach or shame; great discredit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6366a8e0-9952-49d6-826e-46e7372d03ac",
                                                "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                                "text": "His behaviour at the party was a total disgrace! He was leeching on all the ladies, and insulting the men."
                                            },
                                            {
                                                "example_id": "c0e8ca50-9b33-4a8d-8471-0825a5e950d1",
                                                "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                                "text": "Practice and whipping were alike unavailing, and Epps, satisfied of it at last, swore I was a disgrace—that I was not fit to associate with a cotton-picking \"nigger\"—that I could not pick enough in a day to pay the trouble of weighing it, and that I should go into the cotton field no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74fcdf24-767f-3906-890a-83d77428e0ad",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "An act of unkindness; a disfavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358e13b3-720c-4406-b42c-04b97bbfb423",
                                                "sense_id": "74fcdf24-767f-3906-890a-83d77428e0ad",
                                                "text": "As for the pulling of them [ambitious men] downe, if the Affaires require it, and that it may not be done with ſafety ſuddainly, the onely Way is, the Enterchange, continually of Fauours, and Diſgraces, whereby they may not know, what to expect; And be, as it were, in a Wood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disgrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e20ef1d8-7040-3dc1-b0a5-da0a9fb4735f",
                                        "entry_id": "3de008e8-961c-3a15-a0c5-566717b3bb8c",
                                        "glosses": [
                                            "To put someone or something out of favor; to bring shame or ignominy upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07fe5c7-a9db-4a30-a640-26c42383455e",
                                                "sense_id": "e20ef1d8-7040-3dc1-b0a5-da0a9fb4735f",
                                                "text": "[…] some families renounced the use of a certain praenomen which had been disgraced by one of their name […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09893fe-282c-4c47-82a3-457f3588e821",
                        "source_entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "source_sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "source_sense_description": "een afgang veroorzaakt door eigen falen",
                        "target_lang_word": "honte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Déshonneur, opprobre, humiliation (ce qui est le sens étymologique et ancien)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e27443-841c-4a9a-a000-732289c647f6",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "La honte est dans l’offense, et non pas dans l’excuse."
                                            },
                                            {
                                                "example_id": "dd6444c4-f36d-4b78-a87e-40aaedf3d4c4",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Tu vois mon sort, tu vois la honte où je me livre."
                                            },
                                            {
                                                "example_id": "14d3f24c-607d-4e15-a87d-1b2eb1621144",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Va, la honte serait de trahir ce que j'aime."
                                            },
                                            {
                                                "example_id": "7f8ebed7-7578-4ee4-8a07-71da2b5c89cf",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Se plaindre est une honte et soupirer un crime."
                                            },
                                            {
                                                "example_id": "f884476f-0d9c-4047-a68f-5cb126f99b55",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "La gloire d’une mort qui nous couvre de honte."
                                            },
                                            {
                                                "example_id": "007b2acf-b9fd-4bb3-a142-3bb2b9ace623",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Mais pour braver Marcelle et m’affranchir de honte, Il est une autre voie et plus sûre et plus prompte."
                                            },
                                            {
                                                "example_id": "55c64a24-78b3-4f77-aea0-3e24b4587df9",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Dans la nuit du tombeau j'enfermerai ma honte."
                                            },
                                            {
                                                "example_id": "9bfa4365-8dab-4b16-82c4-5b143a5ae848",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "J'ai déclaré ma honte aux yeux de mon vainqueur."
                                            },
                                            {
                                                "example_id": "9d62b2b5-f452-4be0-900e-16e7688412cd",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Déjà de sa présence [de Phèdre] avec honte chassée,\nDans la profonde mer Œnone s’est lancée."
                                            },
                                            {
                                                "example_id": "25b6c757-864b-449e-941a-a9f244f3b04e",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Il y aurait de la honte à m’abandonner."
                                            },
                                            {
                                                "example_id": "37250205-9935-4917-bce9-6af1c1ef9386",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Il fait à l’homme de bien une honte de la vertu."
                                            },
                                            {
                                                "example_id": "42cded06-54ce-459c-9875-53042e3a9705",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Et si je n'écoutais que ta honte et ma gloire."
                                            },
                                            {
                                                "example_id": "b99489c7-58d2-4731-9620-34901442c374",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Ce n'est pas ce que voulait madame Kaufmann : il lui fallait savourer la honte de sa rivale, la voir humiliée, perdue, insultée."
                                            },
                                            {
                                                "example_id": "8ddd6980-e38c-4a6f-a32b-e56f44705f01",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "Sous la table, le jeune prêtre pose doucement la main sur la jambe nue de l’élève, remonte un peu plus haut. L’air bouleversé du garçon lui fit cesser son jeu. Mais Michel n’oubliera jamais ce visage de supplication et de honte, cet air d’absorption et de quasi-douleur qui est celui du désir et du plaisir à demi accompli."
                                            },
                                            {
                                                "example_id": "3e658201-a7b3-41ab-8f2d-28468267ff65",
                                                "sense_id": "13d21810-9262-3b39-9a6e-d4453379499f",
                                                "text": "C'est là que ma colère explose : « Ce sont des cague-brailles, des minables, des traîtres doublés d'idiots, c'est une honte pour la France, d’abandonner en rase campagne des gens, ça nous coûtera une fortune ! Il aura ma démission. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75cb3d4a-f5eb-3399-8b2a-beae09714fba",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Déshonneur, opprobre, humiliation (ce qui est le sens étymologique et ancien).",
                                            "Par exclamation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f049f918-7639-4cd5-9996-7c2458a73dc6",
                                                "sense_id": "75cb3d4a-f5eb-3399-8b2a-beae09714fba",
                                                "text": "Ô honte, qui jamais ne peut être effacée !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d01c546-170b-3d71-b623-9deecd184781",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Ce qui ne convient pas, ce qui est messéant."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "372b79ea-d260-4886-a5f0-e9f5093c031f",
                                                "sense_id": "1d01c546-170b-3d71-b623-9deecd184781",
                                                "text": "Et que c’est honte au roi de ne leur donner rien."
                                            },
                                            {
                                                "example_id": "a7975d66-4d08-41d3-8878-2d0647f3bfbc",
                                                "sense_id": "1d01c546-170b-3d71-b623-9deecd184781",
                                                "text": "Car c’est honte de vivre et de n’être amoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Se dit aussi au pluriel (Voltaire a condamné cet emploi ; mais, outre les autorités, la raison et l’usage n'empêchent pas d’employer ce mot abstrait au pluriel)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b38bfe-876a-4deb-b8da-7f70eefde05e",
                                                "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                                "text": "Les soins que cette amour nous donne en cette vie\nNe peuvent aussi bien nous élever si haut,\nQue la perfection la plus digne d’envie\nN’y soit toujours suivie\nDes hontes d’un défaut."
                                            },
                                            {
                                                "example_id": "93b5e474-591e-40b1-8460-942bf4008157",
                                                "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                                "text": "Mais tu sais quel orgueil ont lors montré les comtes ;\nCombien d’affronts pour lui, combien pour moi de hontes !"
                                            },
                                            {
                                                "example_id": "53a555a2-d929-4197-b220-194dd3c1e3db",
                                                "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                                "text": "Pour réserver sa tête aux hontes du supplice."
                                            },
                                            {
                                                "example_id": "3483eba5-dfff-4e79-9811-d24842ec7bd7",
                                                "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                                "text": "La plus brillante fortune ne mérite point ni le tourment que je me donne, ni les humiliations, ni les hontes que j’essuie."
                                            },
                                            {
                                                "example_id": "15dd73fe-35ea-48b7-b749-8ff92e1388a9",
                                                "sense_id": "472afe0e-8e4b-3761-813c-ea328ed30215",
                                                "text": "Il aurait fallu prévoir les écueils d’un tel succès, et empêcher les méfaits et les hontes dont le monarque délivré allait charger sa couronne, et, jusqu'à un certain point, la responsabilité de ses libérateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27405cdc-a9b5-3891-990d-bb1f81c2d930",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Sentiment pénible qu’excite dans l’âme la pensée ou la crainte du déshonneur; ou la conscience d’une faute commise et la confusion, le trouble qu’on en ressent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3fc111-595b-49f8-bbdc-1f028cbf8753",
                                                "sense_id": "27405cdc-a9b5-3891-990d-bb1f81c2d930",
                                                "text": "La honte se met entre la vertu et le péché pour empêcher qu’on ne la quitte ; puis entre le péché et la vertu pour empêcher qu’on ne la reprenne."
                                            },
                                            {
                                                "example_id": "89176532-ab33-41e8-97e9-06048c1df635",
                                                "sense_id": "27405cdc-a9b5-3891-990d-bb1f81c2d930",
                                                "text": "La mariée arrive avec le retard de circonstance, affublée d'une extraordinaire robe bouffante et emperlousée qui aurait fait rougir de honte même la fée la plus frivole."
                                            },
                                            {
                                                "example_id": "c614c2fd-70f4-46e6-8646-0a36b7385927",
                                                "sense_id": "27405cdc-a9b5-3891-990d-bb1f81c2d930",
                                                "text": "La honte est une passion que la nature raisonnable excite en nous et qui nous détourne, sans que nous remarquions même ni comment ni pourquoi, de tous les excès et de toutes les impuretés du vice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a18d3b6-a2a3-3b1d-8f20-67654a94d9c0",
                                        "entry_id": "6f6a3d06-e74c-30b8-ae48-62198769a97f",
                                        "glosses": [
                                            "Dans le langage biblique, les parties que l’on doit cacher."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "562b0d33-26c9-4ea3-9bea-e226a7ae4ab6",
                                                "sense_id": "6a18d3b6-a2a3-3b1d-8f20-67654a94d9c0",
                                                "text": "C’est pourquoi j’ai relevé vos vêtements sur votre visage, et on a vu votre honte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a41bc05a-b085-430a-a721-904598441b4e",
                        "source_entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "source_sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "source_sense_description": "een afgang veroorzaakt door eigen falen",
                        "target_lang_word": "déshonneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déshonneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                        "entry_id": "d52d2b90-1459-3a47-86d1-738f10690a30",
                                        "glosses": [
                                            "Perte de l’honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a70e3a-1b9d-4e20-ab43-ca6534bc08b4",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "Hantés par des idées de déshonneur, d'attentat à la dignité du nom et autres sornettes ridicules, se croyant de grands criminels et ne voyant à leur situation aucune issue, ces petits étourdis seraient bien capables de se suicider."
                                            },
                                            {
                                                "example_id": "2b90c6e0-da38-469f-aa1e-5ee5f92e95b6",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "[…], il lui représenta donc charitablement qu’il aurait grand tort de ne pas profiter de l’occasion qui lui était offerte pour faire marcher un salaud de richard qui jetait sans scrupules le déshonneur et la misère dans les familles pauvres, mais honorables."
                                            },
                                            {
                                                "example_id": "f19997b2-7503-44aa-8754-35f22d906f9c",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "La mère envoya de l’argent, mais elle joignit à son envoi un flacon de chloroforme en lui recommandant de le boire pour échapper au déshonneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c51b115-a9bf-4049-86a0-9abf4b7f7c4a",
                        "source_entry_id": "c592952a-86c2-35cc-aa31-430fa4da65aa",
                        "source_sense_id": "42cdc286-25ba-326c-8f57-00f89b11fda6",
                        "source_sense_description": "een afgang veroorzaakt door eigen falen",
                        "target_lang_word": "vergüenza",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergüenza",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "d1df646a-0130-3824-bf55-60b28d3f6750",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Sentimiento de turbación causado por sentir culpa, humillación o deshonra."
                                        ],
                                        "tags": [
                                            "Sentimientos"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68b676dd-3167-44b3-b728-4f18bba515ad",
                                                "sense_id": "d1df646a-0130-3824-bf55-60b28d3f6750",
                                                "text": "Necesitó la pobre mujer de todas las energías de su espíritu para no caerse muerta de vergüenza. No traían los tales otro objeto que enterarse de si la llevaban presa, y al saber que iba en tal compañía por su gusto, se asombraron, y a todo trance querían apartarla de la conducta y llevársela con ellos, para evitarle el bochorno de entrar en el pueblo en cuerda de asesinos, ladrones y apóstoles."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "921022da-91a9-3d47-a1d5-77e9d3c1a3dd",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Alta estima en la que se tiene la honra, el honor o el prestigio propios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb0d9bf-6dda-46ea-b74e-cbb5244e0d10",
                                                "sense_id": "921022da-91a9-3d47-a1d5-77e9d3c1a3dd",
                                                "text": "Arte, valor, seguridad, vergüenza torera, todo eso y algo más se veía por arrobas en el novel diestro."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7758934-962a-3804-97f3-0f3654eae145",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Escasez de ánimo o timidez para llevar algo a cabo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a82c772-0a6e-47f7-846f-809df273ef92",
                                                "sense_id": "a7758934-962a-3804-97f3-0f3654eae145",
                                                "text": "Por vergüenza de confesarle a su madre que se casaría gustosa, la destinaron a monja, reservando a su hermana Jacinta para el matrimonio;."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "39322f74-f7b3-34e2-9252-7a29f34cf979",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Acto deshonroso o que afecta gravemente al honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a2e60f-aaae-47fa-a1a9-01896e68c32a",
                                                "sense_id": "39322f74-f7b3-34e2-9252-7a29f34cf979",
                                                "text": "¿Quién podrá sufrir el que por las chocarrerías de Favonio y Domicio y porque no le llamaron Agamenón hubiese sido violentado a poner a riesgo el imperio y la libertad? Y si sólo miraba a la vergüenza e ignominia del momento presente, debió hacer frente en el principio y combatir en defensa de Roma;."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7d290f64-0104-361b-8f38-144b3d0412db",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Castigo consistente en la exposición pública del delito cometido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac87c7f0-ce06-4f49-bff5-42c0574674a7",
                                                "sense_id": "7d290f64-0104-361b-8f38-144b3d0412db",
                                                "text": "Mas últimamente, por no ser adaptable a todos los casos, el señor Felipe II, dejándola en su vigor para las causas de sentencia capital, en que el testigo debe siempre ser castigado con la misma pena correspondiente al delito que falsamente asevera, constituyó para todos los demás casos la pena de vergüenza pública y galeras perpetuas."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "48ca1752-c112-31bc-8b32-12e290ce36f5",
                                        "entry_id": "12299094-d8b5-38ab-81d4-0b85ec19d662",
                                        "glosses": [
                                            "Por extensión, enrojecimiento visible del rostro que hace patente una emoción como la vergüenza₁."
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
