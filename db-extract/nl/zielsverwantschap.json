                                        "glosses": [
                                            "The quality of being congenial; the state of being agreeable or of having similar tastes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55773dcc-8635-4d7e-81b9-60143b2ef7c6",
                                                "sense_id": "b2a6151f-0622-3f32-8c88-5fb405e11ddd",
                                                "text": "Eugenie was known for her congeniality; she could easily fit in to virtually any group of people and have a good time."
                                            },
                                            {
                                                "example_id": "4c9e0d99-bb57-4fff-b628-3d002d33d434",
                                                "sense_id": "b2a6151f-0622-3f32-8c88-5fb405e11ddd",
                                                "text": "If congeniality of tastes could have made a marriage happy, that union should have been thrice blessed."
                                            }
