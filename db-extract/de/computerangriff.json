                "senses": [
                    {
                        "sense_id": "2395bee1-4971-302f-9d8c-7bdcfa430a51",
                        "entry_id": "e550b0bb-ff00-3995-85ff-e65cc13eb0cb",
                        "glosses": [
                            "Angriff auf oder mit einem Computersystem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "222a8067-5924-4bfb-86d1-e5091d1a3e19",
                                "sense_id": "2395bee1-4971-302f-9d8c-7bdcfa430a51",
                                "text": "„Bis das Internet vollständig von diesem Computerangriff gereinigt sein wird, wird er wohl als der teuerste in die Geschichte eingehen.“"
                            },
                            {
                                "example_id": "3f765617-0f4c-4b9a-bee3-cc05930aa9b3",
                                "sense_id": "2395bee1-4971-302f-9d8c-7bdcfa430a51",
                                "text": "„Schon wieder ist ein Computer-Wurm im Umlauf, der seinen Empfänger lokalisieren kann. Experten befürchten darin einen Trend: Die Computerangriffe werden gezielter personalisiert - und am Ende klicken Nutzer häufiger auf bösartige Seiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
