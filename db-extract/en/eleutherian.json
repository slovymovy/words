    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "089dad78-bb8a-3a62-a2ed-1d29bf15685e",
                "word": "Eleutherian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1739a10f-ffaa-480d-a3da-fec52585d8e7",
                        "entry_id": "089dad78-bb8a-3a62-a2ed-1d29bf15685e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Eleutherian"
                    },
                    {
                        "form_id": "89cc7909-2c5e-46b9-9a7a-814a3f5aa8b2",
                        "entry_id": "089dad78-bb8a-3a62-a2ed-1d29bf15685e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Eleutherian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                        "entry_id": "089dad78-bb8a-3a62-a2ed-1d29bf15685e",
                        "glosses": [
                            "Pertaining to the island of Eleuthera in the Bahamas, especially to the original settlers of the island."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f09266c-0559-4909-b41c-fbb0676fedbd",
                                "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                                "text": "Your Eleutherian son is very valuable to us & will daily become more so."
                            },
                            {
                                "example_id": "21f048bb-26ff-4eae-b25c-18d2de9e1ebd",
                                "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                                "text": "A naturalist would never weary in the Eleutherian scene."
                            },
                            {
                                "example_id": "a26016f8-9573-4a34-8871-ab7edb889320",
                                "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                                "text": "Eleutherian settlers give Harvard ten tons of braziletto wood."
                            },
                            {
                                "example_id": "9e2e66d6-e30c-4ce9-89a1-4659d3ba9d73",
                                "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                                "text": "Spanish warships burned the original Eleutherian villages to the ground in 1684, but by that time scattered settlements had appeared all along Eleuthera's coastline and neighboring cays."
                            },
                            {
                                "example_id": "d8f44ee4-b1a1-4b0b-93f1-4f8751860e39",
                                "sense_id": "51c99266-d21b-375d-8031-aa8f3edb5a80",
                                "text": "I've been familiar with the story of the Eleutherian Adventurers for several decades, since high school in Nassau, where our history teacher told us that we could be descended from these people— and some of us were."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8ca64404-670c-3e0a-a812-fee92d577086",
                "word": "Eleutherian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "580dacd6-0c2a-4fd9-9502-90013b3b0af0",
                        "entry_id": "8ca64404-670c-3e0a-a812-fee92d577086",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more Eleutherian"
                    },
                    {
                        "form_id": "9b935402-7f27-495a-b3cc-88ebde1d1127",
                        "entry_id": "8ca64404-670c-3e0a-a812-fee92d577086",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Eleutherian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42e858ec-491c-3343-9ee2-d177c3efa432",
                        "entry_id": "8ca64404-670c-3e0a-a812-fee92d577086",
                        "glosses": [
                            "Pertaining to Eleutheria, the personification of freedom, or Zeus Eleutheria, the protector of freedom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f07d517-2c1d-4252-a3c8-17da22c13887",
                                "sense_id": "42e858ec-491c-3343-9ee2-d177c3efa432",
                                "text": "He enters the ruins of a temple, sacred to Eleutherian Jove, where himself and his train are suddenly alarmed by the voice of one, who complains of the severe fate of Eretria."
                            },
                            {
                                "example_id": "6c1fc7d9-5ca4-427d-b7fe-3682fae2ddd1",
                                "sense_id": "42e858ec-491c-3343-9ee2-d177c3efa432",
                                "text": "Liberty, in these latter days, means something more than was celebrated in the Eleutherian festivals, or exemplified in the political institutions of the States of Greece, and the Commonwealth of Rome."
                            },
                            {
                                "example_id": "36343633-1681-41a6-8755-ba17ef5363de",
                                "sense_id": "42e858ec-491c-3343-9ee2-d177c3efa432",
                                "text": "The Eleutherian festival was a long-established panhellenic festival, held every four years. It honoured Zeus Eleutherius, protector of the freedom (eleutheria) from barbarian dominion which the victory on this spot had secured for the Greeks of former times."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b07a33bc-5f0c-3af5-9211-9f386246a216",
                "word": "Eleutherian",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98561f68-9d6f-3ed9-9730-3b1d1c7eb28d",
                        "entry_id": "b07a33bc-5f0c-3af5-9211-9f386246a216",
                        "glosses": [
                            "One of two temples on the southern slope below the Acropolis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d2d18f-ee69-4f8c-a1ee-3ad37a76bbb2",
                                "sense_id": "98561f68-9d6f-3ed9-9730-3b1d1c7eb28d",
                                "text": "She was occupied in negotiating with the ambassador of Charlemagne the conditions of the great alliance between them, whereby the crowns of the East and West were to have been united on one head, when the patrician and chancellor of the empire, Nicephorus, summoned to the emperor, burst into the palace, and at first with friendly words offered to discover all the treasures of the crown, for which he promised to make over to the Eleutherian palace as a widow's residence."
                            },
                            {
                                "example_id": "c759f9e6-a86a-4e6c-ae8c-66bc83eb7c0b",
                                "sense_id": "98561f68-9d6f-3ed9-9730-3b1d1c7eb28d",
                                "text": "There are no signs of rebuilding, and yet Pausanias saw two temples, one containing the old Eleutherian image."
                            },
                            {
                                "example_id": "f3934a50-886d-4f3a-a5a5-06ee2dd92326",
                                "sense_id": "98561f68-9d6f-3ed9-9730-3b1d1c7eb28d",
                                "text": "If the work cannot compare with the Hellenic masonry of the Messenian or Eleutherian walls, neither does it betray the rude power and massiveness of the Argolic acropoles."
                            },
                            {
                                "example_id": "e16183d9-692a-4ad2-b2fc-0b5d2741d84f",
                                "sense_id": "98561f68-9d6f-3ed9-9730-3b1d1c7eb28d",
                                "text": "He sees within the precinct there two temples, the foundations of which remain to-day; one of them was named Eleutherian, the other we think may surely have belonged to Dionysos-in-the-Marshes"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "69593d92-8e2d-3a7a-8b30-75656f1ae64e",
                "word": "Eleutherian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c43eefbb-769f-454c-90cd-9d004b7af2ed",
                        "entry_id": "69593d92-8e2d-3a7a-8b30-75656f1ae64e",
                        "tags": [
                            "plural"
                        ],
                        "form": "Eleutherians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "500f980d-8c5d-3a4e-b7f9-bec397d16a2a",
                        "entry_id": "69593d92-8e2d-3a7a-8b30-75656f1ae64e",
                        "glosses": [
                            "One of the original settlers of Eleuthera, who settled prior to the American Revolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c65c72-38d7-4193-a920-8addcebbd1f8",
                                "sense_id": "500f980d-8c5d-3a4e-b7f9-bec397d16a2a",
                                "text": "The New Englanders generously sent supplies, and the Eleutherians thanked them by returning the ship loaded with hardwood."
                            },
                            {
                                "example_id": "f7102e7c-c702-481d-8802-8b35169fbcd9",
                                "sense_id": "500f980d-8c5d-3a4e-b7f9-bec397d16a2a",
                                "text": "He was one of the six Eleutherians whom Governor George Phenny had selected from among the inhabitants of the Colony as \"fit persons to be recommended to His Majesty to be elected by the Public to make an Assembly, or execute other public offices under the Government.\""
                            },
                            {
                                "example_id": "a06d709d-f40a-4fb4-a38f-baf535635798",
                                "sense_id": "500f980d-8c5d-3a4e-b7f9-bec397d16a2a",
                                "text": "Freedom of a sort the Eleutherians certainly had."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "913f6ab4-56f6-3309-8367-393625a44b22",
                "word": "Eleutherian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "013f3dcf-18ae-4d25-932c-f060a3f6f876",
                        "entry_id": "913f6ab4-56f6-3309-8367-393625a44b22",
                        "tags": [
                            "plural"
                        ],
                        "form": "Eleutherians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80db2685-aae9-3738-a13b-c2dc67721826",
                        "entry_id": "913f6ab4-56f6-3309-8367-393625a44b22",
                        "glosses": [
                            "One of a people of Ancient Greece, originally associated with Thebes but later granted rights with Athens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c2321f-b217-407e-b5ca-193c0f21a811",
                                "sense_id": "80db2685-aae9-3738-a13b-c2dc67721826",
                                "text": "This Valley belonged in very ancient times to the Eleutherians; who being subjećt to those of Thebes, out of an inveterated hatred and emulation revolted from them and join'd themselves to the Athenians, as was pretended out of a great fancy and good affection they took to their way of Government."
                            },
                            {
                                "example_id": "724bf0f7-fbac-4f4d-b5a4-032751db31d8",
                                "sense_id": "80db2685-aae9-3738-a13b-c2dc67721826",
                                "text": "Thus, these considerations associate the citizenship of the Eleutherians with their joining the Athenians in the late sixth century, which is exactly what Pausanias tells us."
                            },
                            {
                                "example_id": "61bdfd42-85f6-4267-875a-b85026b9dbd8",
                                "sense_id": "80db2685-aae9-3738-a13b-c2dc67721826",
                                "text": "Pausanias does not specifically say that the Eleutherians received Athenian citizenship, only that they desired it; but there is nothing inherently implausible in the suggestion that the Eleutherians were made Athenian citizens"
                            }
                        ]
                    },
                    {
                        "sense_id": "04892cbc-9ffe-34de-bbc5-ce61baf09af2",
                        "entry_id": "913f6ab4-56f6-3309-8367-393625a44b22",
                        "glosses": [
                            "A member of a splinter group of puritans led by Cotton Mather."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6137b2d5-3607-49ef-8f9c-e31f6a649e17",
                                "sense_id": "04892cbc-9ffe-34de-bbc5-ce61baf09af2",
                                "text": "True ELEUTHERIANS will consider, how far any further Agreement may be Necessary: And whether those unreasonable Sons of Procrustes, the Narrow-soul'd and Imperious Bigots for Uniforming, will do Religion any real Service, by the pressing of it."
                            },
                            {
                                "example_id": "4b642019-ecf6-4370-ae71-f309afe7bf7c",
                                "sense_id": "04892cbc-9ffe-34de-bbc5-ce61baf09af2",
                                "text": "Sept. 15. Land in Casco Bay granted to the Eleutherians."
                            },
                            {
                                "example_id": "ed687699-7aa5-44f6-b7be-5592b103706e",
                                "sense_id": "04892cbc-9ffe-34de-bbc5-ce61baf09af2",
                                "text": "Beginning in the late 1690s, Cotton became the leader — he privately wrote that he was the sole leader — of an alternative party of “Eleutherians.” This meant freemen, or libertarians, who embrace the fullness of the gospel life."
                            }
                        ]
                    }
                ],
