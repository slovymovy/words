                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83f0b91a-ec9a-4ba9-a311-61469e6a3fd7",
                        "source_entry_id": "9859e42b-c8b8-3712-a689-7af1b06dfccc",
                        "source_sense_id": "187f3362-1ea0-331a-a670-73a4e45e87a1",
                        "source_sense_description": "Ufer eines Meeres",
                        "target_lang_word": "rivage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                        "entry_id": "b242b561-8a93-346e-b9c4-f550a8f498a3",
                                        "glosses": [
                                            "Partie de la terre qui borde la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5169fdee-a29b-40dc-8910-102d3bba5839",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Le rivage n'était pas entièrement continu, le récif était frangé d'îles qui présentaient entre elles de minuscules passes."
                                            },
                                            {
                                                "example_id": "ac1e8fbd-08c3-4ec9-a07e-fa9d458ca6ba",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Pourtant, d’autres chasseurs hantent ces rivages, avec des intentions moins ludiques : des liches amies, des sérioles ambrées, des tassergals aux dents pointues errent dans la frange côtière, à la poursuite des mulets et orphies."
                                            },
                                            {
                                                "example_id": "325ba6fc-d3c3-4186-b82e-f7acfbb85aa0",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Au rivage."
                                            },
                                            {
                                                "example_id": "b9243597-fdd6-44b5-a6e7-212036807ad3",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Sur le rivage de la mer."
                                            },
                                            {
                                                "example_id": "224324e5-5d5b-4bdf-bd00-8f58e1aa244a",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "De lointains rivages."
                                            },
                                            {
                                                "example_id": "0c3a5e4a-3b45-4df9-8457-f80b38d1de91",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Les pirates infestaient autrefois ces rivages."
                                            },
                                            {
                                                "example_id": "2c9396db-d954-43b7-9a8d-1a318ffe5ea7",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "S’éloigner du rivage."
                                            },
                                            {
                                                "example_id": "3d98d24b-55b0-493a-9ea0-f0f4661769f4",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Quitter le rivage."
                                            },
                                            {
                                                "example_id": "16f33371-40df-41d5-b2f1-6923c955046f",
                                                "sense_id": "ffb1f00b-79de-3766-9cff-39ce87a6bfe6",
                                                "text": "Regagner le rivage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc4d6b4-d1b2-36f1-bdda-c996379ead77",
                                        "entry_id": "b242b561-8a93-346e-b9c4-f550a8f498a3",
                                        "glosses": [
                                            "Se dit aussi en parlant des fleuves, des rivières, des lacs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9dc23d5-a4cb-4680-bd09-55ccfce26b81",
                                                "sense_id": "0dc4d6b4-d1b2-36f1-bdda-c996379ead77",
                                                "text": "Sur le rivage de la Seine."
                                            },
                                            {
                                                "example_id": "c2efa37c-854d-4766-8e3a-2979acc1c282",
                                                "sense_id": "0dc4d6b4-d1b2-36f1-bdda-c996379ead77",
                                                "text": "Les rivages de la Loire."
                                            },
                                            {
                                                "example_id": "d018e632-c238-426d-b33a-3a98534cdf57",
                                                "sense_id": "0dc4d6b4-d1b2-36f1-bdda-c996379ead77",
                                                "text": "Les rivages du Léman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8588e7ef-e699-3155-a4fc-43f6cbfe166d",
                                        "entry_id": "b242b561-8a93-346e-b9c4-f550a8f498a3",
                                        "glosses": [
                                            "Toute sorte de rebord, de précipice, de délimitation, de frontière, de net séparation."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea4676ae-717d-4e37-8e94-cf623d691026",
                                                "sense_id": "8588e7ef-e699-3155-a4fc-43f6cbfe166d",
                                                "text": "Le noir rivage, le sombre rivage, le rivage des morts : Les rivages des fleuves des enfers dans la Mythologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f116da1b-ded4-3c10-a342-9e75e82f3c6c",
                                        "entry_id": "b242b561-8a93-346e-b9c4-f550a8f498a3",
                                        "glosses": [
                                            "Pays ; contrée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54afa1e2-1262-4018-885b-9337a5ec5f9d",
                                                "sense_id": "f116da1b-ded4-3c10-a342-9e75e82f3c6c",
                                                "text": "La guerre en Chine est un jeu d’enfant comparé à la leur. Nous nous battons encore avec des mausers. La guerre de l’Occident, impersonnelle, automatique, n'a pas encore atteint ces rivages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
