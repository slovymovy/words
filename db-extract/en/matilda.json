                "senses": [
                    {
                        "sense_id": "1998a794-5790-3782-a783-bd6047405793",
                        "entry_id": "de2b397e-3744-3a47-9103-99fdeab53f5e",
                        "glosses": [
                            "A bundle of possessions, often tied up in a sack; a swag."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "c2743c03-10da-458f-b91f-254d860eab35",
                                "sense_id": "1998a794-5790-3782-a783-bd6047405793",
                                "text": "1906, A. B. Paterson, On The Road to Gundagai, The Old Bush Songs, Gutenberg eBook #10493,\nIn a week the spree was over and the cheque was all knocked down, / So we shouldered our “Matildas,” and we turned our backs on town, / And the girls they stood a nobbler as we sadly said “Good bye,” / And we tramped from Lazy Harry’s, not five miles from Gundagai;"
                            },
                            {
                                "example_id": "b6e6f571-265a-42fe-b1ec-557e8f88c9c3",
                                "sense_id": "1998a794-5790-3782-a783-bd6047405793",
                                "text": "When a hobo roams through the outback with a matilda on his back, he is said to be “waltzing matilda.”"
                            }
                        ]
                    }
                ],
