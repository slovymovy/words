                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "205dc060-3415-4beb-b471-5e6abbc1216c",
                        "source_entry_id": "a005c6ec-bd3f-31c3-a3af-5d1a83471ffa",
                        "source_sense_id": "f82882ec-dc2a-3c4c-a45a-f0f36d14fd84",
                        "target_lang_word": "handelsbarrière",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handelsbarrière",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "da25be33-9d0c-373e-b442-a4453581aaa6",
                                        "entry_id": "740b5038-fb95-3ebc-8518-3bc4770bcbae",
                                        "glosses": [
                                            "maatregel die het moeilijker maakt om goederen en diensten naar een ander land te leveren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27ffc37-c0de-4072-b249-3ed765d6ac81",
                                                "sense_id": "da25be33-9d0c-373e-b442-a4453581aaa6",
                                                "text": "China heeft maandag aangekondigd de importheffingen op Amerikaanse producten vanaf 1 juni te verhogen van 5 naar 25 procent. (…) De nieuwe handelsbarrière is een reactie op de vrijdag ingestelde Amerikaanse importheffing op Chinese producten."
                                            },
                                            {
                                                "example_id": "978f716e-ce8e-4bfc-aa4c-eb8f0bf027cb",
                                                "sense_id": "da25be33-9d0c-373e-b442-a4453581aaa6",
                                                "text": "Waar de één relatief strenge Europese regels voor de toelating van chemische stoffen beschouwt als technische handelsbarrière is het voor de ander een essentiële regel voor bescherming van consument en milieu."
                                            },
                                            {
                                                "example_id": "3e26e699-b53d-46d6-ba8a-0ceaf36f851c",
                                                "sense_id": "da25be33-9d0c-373e-b442-a4453581aaa6",
                                                "text": "Lange tijd is het gelukt om op Europees niveau een gemeenschappelijke ondergrens te formuleren, maar misschien zitten we nu op het punt dat we lidstaten weer iets meer ruimte moeten geven voor eigen standaarden. Juristen en grote bedrijven zullen gruwen van de handelsbarrières die 28 verschillende regimes nu weer gaan opleveren en klagen over het ontbreken van een ‘level playing field’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
