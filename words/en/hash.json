                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завалить",
                                "target_lang_sense_clarification": "плохо справиться с делом"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать что-то негодным"
                            },
                            {
                                "target_lang_word": "напортачить",
                                "target_lang_sense_clarification": "допустить грубые ошибки"
                            }
