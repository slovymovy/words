                ],
                "senses": [
                    {
                        "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                        "entry_id": "e9e8fdf6-1266-3b2c-8b1a-024432532703",
                        "glosses": [
                            "niederdeutscher Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04977194-9d7c-4d32-8620-4f310e5f53de",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Frau Kruse ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3f67a0b6-bede-4249-b03b-608ee644dbb3",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Herr Kruse wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c04afec-e008-4fde-9adb-6d19e151d79e",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Die Kruses fliegen heute nach London."
                            },
                            {
                                "example_id": "f432cc61-f264-40e5-a1d0-30c665aaf0a5",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Der Kruse trägt nie die Pullover, die die Kruse ihm strickt."
                            },
                            {
                                "example_id": "925c073c-bf7a-42a1-9d30-87235b750b92",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kruse kommt, geht der Herr Kruse.“"
                            },
                            {
                                "example_id": "09891877-6585-446a-a8e1-210ac4e819f3",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Kruse kommt und geht."
                            },
                            {
                                "example_id": "b5ad1ac7-ddd2-45cd-89cf-ff4b332dcf67",
                                "sense_id": "a204b091-afc4-3ed3-9c53-fb37e0467eb5",
                                "text": "Kruses kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
