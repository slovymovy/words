                                        "entry_id": "619d3f57-39d7-3306-b72d-54bb165e2cdf",
                                        "glosses": [
                                            "A severe spasm; a twinge; a pang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd42412-547b-4d09-aee0-e1f4eac1638e",
                                                "sense_id": "0cef7ef5-a650-3dd1-b6cf-96d605b14559",
                                                "text": "Conscience […] is freed from many fearful girds and twinges which the atheist feels."
                                            }
                                        ]
