                        "source_entry_id": "edfc8c52-99ac-3891-bc5e-32ac4a863a0e",
                        "source_sense_description": "pancreas or thymus gland of an animal as food",
                        "target_lang_word": "Bries",
                        "target_lang_code": "de",
                        "note": "from thymus",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
