                "senses": [
                    {
                        "sense_id": "80847f0d-b0a9-3aae-8eac-27b68ec2b152",
                        "entry_id": "f09b5cef-374b-3a1e-b5b0-a9db4af8955d",
                        "glosses": [
                            "Einzelrichter für Zivil- und Strafsachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea91c902-8330-434d-9d4d-86a9df759cde",
                                "sense_id": "80847f0d-b0a9-3aae-8eac-27b68ec2b152",
                                "text": "Der Friedensrichter entschied bei kleinen Delikten."
                            },
                            {
                                "example_id": "80f7aa34-0d8a-4f73-9180-6b34e7f1bb94",
                                "sense_id": "80847f0d-b0a9-3aae-8eac-27b68ec2b152",
                                "text": "„Unter diesen letztern war das des Friedensrichters oder, wie er schlechtweg genannt wird: Squire.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48dadada-b670-38d4-8d79-c952882af477",
                        "entry_id": "f09b5cef-374b-3a1e-b5b0-a9db4af8955d",
                        "glosses": [
                            "ehrenamtlicher Schiedsrichter, Schiedsmann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa07242f-8c4d-407c-9e44-b723994bfde3",
                                "sense_id": "48dadada-b670-38d4-8d79-c952882af477",
                                "text": "Zur Schlichtung des Streitfalls wurde ein Friedensrichter gewählt."
                            },
                            {
                                "example_id": "a7dfcaa0-87d6-41ca-bb83-ad699fb67e60",
                                "sense_id": "48dadada-b670-38d4-8d79-c952882af477",
                                "text": "„Friedensrichter kommen fast ausschließlich zum Einsatz, wenn sowohl Täter als auch Opfer aus dem islamischen Kulturkreis stammen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
