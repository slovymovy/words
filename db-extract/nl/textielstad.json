                        "examples": [
                            {
                                "example_id": "9ab198ab-9bab-4fdb-845f-2f95f5f5c772",
                                "sense_id": "eeeade22-1f35-36af-8fc5-26e365a947b7",
                                "text": "Zelf word ik een paar maanden na het muziekavondje in de Gitrovka ten huwelijk gevraagd door een jonge, aantrekkelijke, gescheiden Russische vrouw met kind in het textielstadje Ivanovo."
                            },
                            {
                                "example_id": "0abdfffe-28cd-496d-aa9b-676b3e312a8b",
                                "sense_id": "eeeade22-1f35-36af-8fc5-26e365a947b7",
                                "text": "AZ heeft donderdag goede papieren om zich onder de beste zestien van de Europa League te scharen. Door een late treffer van Nick Viergever vorige week in de Boheemse textielstad Liberec, verdedigen de Alkmaarders een 1-0 voorsprong tegen Slovan Liberec."
                            },
                            {
                                "example_id": "00e57572-2efd-4c64-a4bf-15db29bd6791",
                                "sense_id": "eeeade22-1f35-36af-8fc5-26e365a947b7",
                                "text": "Het is geen toeval dat de poppen juist naar Almelo zijn gehaald. Ivo wijst erop dat de Twentse stad van oudsher een textielstad is. \"Barbie staat bekend om haar verschillende kledingstukken. Avondjurken, mantelpakjes, badpakken. De pop is altijd met de mode meegegaan\", benadrukt Ivo."
                            }
                        ]
                    }
