                        ],
                        "examples": [
                            {
                                "example_id": "309c6b16-20df-42a5-b663-82de42eb8cba",
                                "sense_id": "7a9b0a1f-238a-332f-804a-088a07fc1a92",
                                "text": "\"Specifiek in sterrenzaken is dit altijd een probleem geweest\", zegt Edwin Vlek, bestuurder van de FNV Horecabond. \"En door het personeelstekort is dit op sommige plekken alleen maar nijpender geworden. Restaurants willen hetzelfde niveau halen met minder medewerkers.\""
                            }
                        ]
