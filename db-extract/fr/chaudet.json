                                        "entry_id": "aca0e94d-1882-36f8-9df4-c9a020ea26a4",
                                        "glosses": [
                                            "A drink given to the sick, consisting of ale or wine, bread, and eggs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f72693-c79f-43d2-ba2d-b74bb20d62ed",
                                                "sense_id": "22cd1324-d883-37e2-8398-0b63b01ae539",
                                                "text": "Could a Taff'ta ſcarf, a long Eſtridge vvhing, / A ſtiffe Iron Doublet, and a Brazeel Pole / Tempt thee from Cambrick ſheets, fine active Thighs, / From Caudles vvhere the precious Amber ſvvims?"
                                            },
                                            {
                                                "example_id": "00f4dcfb-55ca-43bc-9149-e1a07188a331",
                                                "sense_id": "22cd1324-d883-37e2-8398-0b63b01ae539",
                                                "text": "A venerable lady, known as Great-Aunt Grantley, who had money to bequeath to the Heir, and whom Adrian called The Eighteenth Century, occupied with Hippias the back ground of the house, and shared her caudles with him."
                                            }
                                        ]
                                    }
                                ]
                            },
