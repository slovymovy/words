                    },
                    {
                        "translation_id": "27dd9e19-ed96-40f5-b469-200f87790bfa",
                        "source_entry_id": "627e4088-05b0-3a7c-bdac-f01c40acdb7a",
                        "source_sense_id": "d3e304c4-af68-3c84-8188-21a7a1d6fb58",
                        "target_lang_word": "aguamanil",
