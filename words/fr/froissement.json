    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05dcdaee-1362-3dfe-b86e-7aefa43e0172",
                    "sense_definition": "Action de chiffonner ou d'altérer la surface d'un tissu, d'un papier, ou résultat de cette action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration_matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>froissement</w> accidentel de cette chemise en lin nécessite un nouveau coup de fer."
                        },
                        {
                            "text": "Ce tissu délicat ne résiste pas au <w>froissement</w> régulier lors des longs voyages."
                        }
                    ],
                    "synonyms": [
                        "fripage",
                        "froissure"
                    ],
                    "antonyms": [
                        "repassage"
                    ],
                    "common_phrases": [
                        "froissement de tissu",
                        "résistant au froissement"
                    ]
                },
                {
                    "sense_id": "ef778d01-96ad-39c8-9be3-f16672a8d144",
                    "sense_definition": "Bruit sec et léger produit par le frottement ou le remuement d'étoffes, de feuilles ou de papier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le silence de la nuit, elle entendit soudain le léger <w>froissement</w> des feuilles sèches."
                        },
                        {
                            "text": "Un doux <w>froissement</w> d'étoffe annonça la venue de la danseuse sur la scène."
                        }
                    ],
                    "synonyms": [
                        "bruissement",
                        "froufrou"
                    ],
                    "common_phrases": [
                        "froissement de feuilles",
                        "froissement d'étoffe"
                    ]
                },
                {
                    "sense_id": "de66e592-38a8-3a48-b21a-5a95fcbe4e99",
                    "sense_definition": "Lésion bénigne subie par un muscle ou un tissu à la suite d'un choc ou d'un effort violent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après son sprint intense, l'athlète a ressenti un douloureux <w>froissement</w> musculaire à la cuisse."
                        },
                        {
                            "text": "Le médecin a diagnostiqué un simple <w>froissement</w> et lui a prescrit quelques jours de repos complet."
                        }
                    ],
                    "synonyms": [
                        "élongation"
                    ],
                    "common_phrases": [
                        "froissement musculaire"
                    ]
                },
                {
                    "sense_id": "78b88144-46c4-3f74-ad23-7492340635c9",
                    "sense_definition": "Atteinte blessante portée à l'amour-propre, aux susceptibilités ou aux intérêts de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses paroles maladroites ont causé un vif <w>froissement</w> d'amour-propre au sein de notre équipe."
                        },
                        {
                            "text": "Pour éviter tout <w>froissement</w> diplomatique, les deux délégués ont choisi leurs termes avec beaucoup de prudence."
                        }
                    ],
                    "synonyms": [
                        "vexation",
                        "heurt"
                    ],
                    "antonyms": [
                        "apaisement"
                    ],
                    "common_phrases": [
                        "froissement d'amour-propre"
                    ]
                },
                {
                    "sense_id": "ab62728e-7bf4-327c-b3a4-cd20d59ea2a7",
                    "sense_definition": "En escrime, pression brusque exercée le long de la lame de l'adversaire pour l'écarter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "escrime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'escrimeur a déstabilisé la garde adverse par un <w>froissement</w> rapide avant de porter sa touche."
                        },
                        {
                            "text": "Le maître d'armes montre comment exécuter un <w>froissement</w> précis le long du fleuret adverse."
                        }
                    ]
                }
            ]
        }
    ]
