                        "glosses": [
                            "Odeur de sperme caractéristique des champignons Inocybes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c266cbd-ffe1-4359-baf4-37a1030b3c42",
                                "sense_id": "1e1081e2-9fc7-3e8a-b295-ce85e81dd7f9",
                                "text": "La pipéridine est un composé organique qui se présente sous la forme d'un liquide clair avec une odeur spermatique quelquefois mentionnée pour définir certains Inocybes."
                            },
                            {
                                "example_id": "5374d499-f817-4cd4-b09d-9a5d51a0e466",
                                "sense_id": "1e1081e2-9fc7-3e8a-b295-ce85e81dd7f9",
                                "text": "L’odeur d’Inocybe praetervisa est faible et légèrement spermatique."
                            }
                        ]
