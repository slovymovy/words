                                ]
                            },
                            {
                                "target_word": "criminologiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "021cb665-8db8-3055-9182-ea6b02a9d646",
                                        "entry_id": "1f7ebfe5-1ddd-32e8-b478-e6d056d7c19f",
                                        "glosses": [
                                            "Spécialiste de criminologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70aa9d55-8dcd-47ab-a305-024a9bffb425",
                                                "sense_id": "021cb665-8db8-3055-9182-ea6b02a9d646",
                                                "text": "Il était souriant, patient, serviable, et les professeurs le citaient en exemple. Il s’intéressait pourtant beaucoup aux actions des « mauvais sujets », et il se tenait au courant des punitions qui pleuvaient autour de lui, comme ces honnêtes criminologistes qui font des livres sur la psychologie des assassins, ou des enquêtes sur les bagnes."
                                            },
                                            {
                                                "example_id": "66fc703a-e84e-46c0-bb70-3fab5980a7f0",
                                                "sense_id": "021cb665-8db8-3055-9182-ea6b02a9d646",
                                                "text": "Un criminologiste fameux, le professeur Loccard, me prend sous sa protection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fc5c2eb-3727-4455-8857-529023336ced",
                        "source_entry_id": "361a156d-15bc-3a14-bf9d-e44e0e95ecfc",
                        "source_sense_id": "5ca069aa-85eb-3c6e-a9b8-2ab61050d8d4",
                        "source_sense_description": "person who practices criminology",
                        "target_lang_word": "Kriminalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriminalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                        "entry_id": "e200778d-9085-39a1-9983-370d288517dd",
                                        "glosses": [
                                            "jemand, der sich mit der Aufklärung von Kriminalfällen beschäftigt; ein Fachmann der Kriminalistik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626bdf76-a6da-4891-9d92-dd6fd9a84e39",
                                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                                "text": "Mein Großvater war ein begnadeter Kriminalist."
                                            },
                                            {
                                                "example_id": "fa10fe20-520e-45dd-b225-eafc6d8791d4",
                                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                                "text": "„Kriminalisten erzählen von den Schwierigkeiten, die es macht, einen Verbrecher zu verhaften.“"
                                            },
                                            {
                                                "example_id": "167a9f8c-01eb-4896-9af9-f2b58ee514e4",
                                                "sense_id": "8456c882-9aad-38d5-a16d-1182466debb0",
                                                "text": "„Das Refugium des ersten Kriminalisten Amerikas war mit schönen antiken Möbeln eingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dbfebff-2450-40a5-af6b-d763b069ef4e",
                        "source_entry_id": "361a156d-15bc-3a14-bf9d-e44e0e95ecfc",
                        "source_sense_id": "5ca069aa-85eb-3c6e-a9b8-2ab61050d8d4",
