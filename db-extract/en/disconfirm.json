                "senses": [
                    {
                        "sense_id": "2f962e1d-5c00-33d3-9f45-2680a038aac1",
                        "entry_id": "77a3248f-be19-327f-ba77-50fcd86dbe1a",
                        "glosses": [
                            "To establish the falsity of a claim or belief; to show or to tend to show that a theory or hypothesis is not valid."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "19aae241-94f7-4ea1-a6c3-55f2712edc2c",
                                "sense_id": "2f962e1d-5c00-33d3-9f45-2680a038aac1",
                                "text": "The empirical data obtained in a test—or, as we shall prefer to say, the observation sentences describing those data—may then either confirm or disconfirm the given hypothesis, or they may be neutral with respect to it."
                            },
                            {
                                "example_id": "980fab81-ac88-4bb6-aedc-108f886b0ecc",
                                "sense_id": "2f962e1d-5c00-33d3-9f45-2680a038aac1",
                                "text": "As a result, if facts disconfirm the officially sanctioned theoretical vision, they are subordinated."
                            }
                        ]
                    }
                ],
