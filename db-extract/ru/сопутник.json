                                        "entry_id": "da0fea94-22a6-3a74-a291-3551f2749286",
                                        "glosses": [
                                            "The covering of a hatchway on an upper deck which leads to the companionway; the stairs themselves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e79bf50-31b5-382a-aa5c-ee1fdbd38b8a",
                                        "entry_id": "da0fea94-22a6-3a74-a291-3551f2749286",
