                        ]
                    },
                    {
                        "translation_id": "d58ee65b-25e5-4458-980a-2da8607d223d",
                        "source_entry_id": "9602bd9d-c8d9-39a3-84be-52c5f34b7dd8",
                        "source_sense_id": "b4d4761e-285d-32a3-bf72-fea445e41632",
                        "target_lang_word": "охапка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "охапка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                        "entry_id": "2db8a60e-fcd7-3ef8-a8b2-5d23aa269640",
                                        "glosses": [
                                            "количество чего-либо, которое можно взять, унести, обхватив руками или рукой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148e694f-50e8-4b73-ae48-055a46050a70",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "И в два прыжка она уже у цветов и срывает их охапками."
                                            },
                                            {
                                                "example_id": "a24ed9f4-d4e7-46e1-a3c4-a3f34af5903a",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "Эх, бывало, заломишь шапку, // Да заложишь в оглобли коня, // Да приляжешь на сена охапку, ― // Вспоминай лишь, как звали меня."
                                            },
                                            {
                                                "example_id": "c43b5c74-624a-4381-8c5d-51a9bea3f8cb",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "Он зашёл на кухню, разгрёб спрятанные в золе ещё не погасшие угольки, потом вышел на кухонную веранду и принёс оттуда охапку дров и сухих веток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211b1ceb-3aae-3ad5-85ce-468ebf66abfc",
                                        "entry_id": "2db8a60e-fcd7-3ef8-a8b2-5d23aa269640",
                                        "glosses": [
                                            "перен. большое количество чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd109495-8444-49f4-9032-ca13da65a422",
                                                "sense_id": "211b1ceb-3aae-3ad5-85ce-468ebf66abfc",
                                                "text": "У него, я вам доложу, одних овец сто тысяч по Оке пасутся, так если с каждой… ну, по скольку? ― ну, хоть по полупуду шерсти получать, так ведь денег-то какая охапка выйдет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
