                        "entry_id": "4c30fed7-bde5-3017-bde7-6e07c6098da8",
                        "glosses": [
                            "Action d’arrimer ou résultat de cette action, qui consiste à arranger convenablement et placer avec solidité à l’intérieur d’un bâtiment les divers objets qui composent sa charge, sa cargaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55340c8-c62d-41a6-b83e-ccd50363fed7",
                                "sense_id": "d9665796-53f9-3e10-93e5-b4501dcbd666",
                                "text": "Chargement d’un bon arrimage, d’un difficile arrimage."
                            },
                            {
                                "example_id": "8f129925-1872-4855-bea1-eb0ef42251b5",
                                "sense_id": "d9665796-53f9-3e10-93e5-b4501dcbd666",
                                "text": "Frais d’arrimage. Arrimage bien fait, mal fait."
                            },
                            {
                                "example_id": "d2ebb355-537f-4705-a017-0d916f607446",
                                "sense_id": "d9665796-53f9-3e10-93e5-b4501dcbd666",
                                "text": "On appelle arrimage l’aménagement et la disposition des marchandises à bord du navire transporteur."
                            }
                        ]
                    }
