    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b72742af-5740-3422-8388-bf229e87f30f",
                    "sense_definition": "A cat, especially a young one or a pet; often used as an affectionate name.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cat_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>kitty</w> played with a ball of yarn on the floor.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>котёнок</w> играл с клубком пряжи на полу.",
                                "zh": "那只小<w>猫咪</w>在地板上玩一团毛线。"
                            }
                        },
                        {
                            "text": "She called out, \"Here <w>kitty</w> kitty,\" hoping her pet would come home for dinner.",
                            "target_lang_translations": {
                                "ru": "Она позвала: «Кс-кс-кс, <w>киса</w>, киса», надеясь, что её питомец придет домой к ужину.",
                                "zh": "她喊道：“<w>猫咪</w>，猫咪，快过来！”希望她的宠物回家吃晚饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cat",
                        "kitten",
                        "pussy-cat",
                        "kitty-cat",
                        "puss"
                    ],
                    "common_phrases": [
                        "here kitty kitty",
                        "nice kitty",
                        "soft kitty"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used by children or affectionately"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кошка, особенно молодая, или домашний питомец; часто используется как ласковое обращение.",
                        "zh": "猫，尤指小猫或宠物猫；也常用作亲昵的称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киса",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "котёнок",
                                "target_lang_sense_clarification": "детёныш кошки"
                            },
                            {
                                "target_lang_word": "киска",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            },
                            {
                                "target_lang_word": "кошечка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小猫",
                                "target_lang_sense_clarification": "尤指小猫"
                            },
                            {
                                "target_lang_word": "猫咪",
                                "target_lang_sense_clarification": "亲昵说法，指猫或宠物猫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95e8f87e-9469-3479-8e39-42f2bea66406",
                    "sense_definition": "A fund of money contributed by a group of people for shared expenses or used as the pot in a card game.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_pool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all put five dollars into the <w>kitty</w> to pay for the office party snacks.",
                            "target_lang_translations": {
                                "ru": "Мы все скинулись по пять долларов в <w>общую кассу</w>, чтобы заплатить за закуски для офисной вечеринки.",
                                "zh": "我们每个人都往<w>公共基金</w>里放了五美元，用来支付办公室聚会的零食。"
                            }
                        },
                        {
                            "text": "The winner of the poker hand took all the money from the <w>kitty</w>.",
                            "target_lang_translations": {
                                "ru": "Победитель в раздаче покера забрал все деньги из <w>банка</w>.",
                                "zh": "赢了那局扑克的人拿走了<w>底池</w>里的全部钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pool",
                        "pot"
                    ],
                    "common_phrases": [
                        "in the kitty",
                        "put in the kitty"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежный фонд, собранный группой людей для общих расходов, или кон в карточной игре.",
                        "zh": "一群人凑起来用于共同开销的一笔钱；也指纸牌游戏中的彩池或底池。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общая касса",
                                "target_lang_sense_clarification": "фонд для общих расходов"
                            },
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "в азартных играх"
                            },
                            {
                                "target_lang_word": "общий котёл",
                                "target_lang_sense_clarification": "разг. общие деньги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公共基金",
                                "target_lang_sense_clarification": "大家凑起来供共同开销的钱"
                            },
                            {
                                "target_lang_word": "底池",
                                "target_lang_sense_clarification": "牌局中集中起来的钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36574f90-4122-35f0-88ab-4d0a33ca701b",
                    "sense_definition": "A slang term for the female genitals.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "body_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian made a rude joke about a <w>kitty</w> that offended some people in the audience.",
                            "target_lang_translations": {
                                "ru": "Комик отпустил непристойную шутку про <w>киску</w>, которая оскорбила некоторых зрителей.",
                                "zh": "那个喜剧演员拿<w>逼</w>开了个下流玩笑，冒犯了部分观众。"
                            }
                        },
                        {
                            "text": "He used the word <w>kitty</w> in a vulgar way to describe her body.",
                            "target_lang_translations": {
                                "ru": "Он использовал слово <w>киска</w> в вульгарном смысле для описания её тела.",
                                "zh": "他用“<w>逼</w>”这个粗俗词语来描述她的身体。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pussy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название женских половых органов.",
                        "zh": "粗俗俚语，指女性生殖器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киска",
                                "target_lang_sense_clarification": "вульг."
                            },
                            {
                                "target_lang_word": "киса",
                                "target_lang_sense_clarification": "вульг."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逼",
                                "target_lang_sense_clarification": "粗俗俚语，指女性生殖器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cb30574-13e0-3097-8273-d3a4f3700aae",
                    "sense_definition": "A jail or prison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "prison_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old thief spent ten years rotting in the <w>kitty</w> for his crimes.",
                            "target_lang_translations": {
                                "ru": "Старый вор провел десять лет, гния в <w>тюряге</w> за свои преступления.",
                                "zh": "那个老贼因自己的罪行坐了十年<w>大牢</w>。"
                            }
                        },
                        {
                            "text": "They dragged the criminal off to the <w>kitty</w> to await his trial.",
                            "target_lang_translations": {
                                "ru": "Они потащили преступника в <w>кутузку</w> ожидать суда.",
                                "zh": "他们把那个罪犯拖进<w>监牢</w>候审。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
