                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5013f087-22a6-4ef3-9f6a-2413dc6e9978",
                                "sense_id": "bec71189-3373-35b2-a2dd-6b4d2e353b2b",
                                "text": "Pluk blaadjes van de slakrop, was ze en dep voorzichtig droog met keukenpapier."
                            },
                            {
                                "example_id": "05ec9aaa-0713-4f23-b823-4a94c3c7032e",
                                "sense_id": "bec71189-3373-35b2-a2dd-6b4d2e353b2b",
                                "text": "De conclusie betekent niet dat de tuinier zijn hosta's en slakroppen dan maar moet opvoeren aan de weekdieren."
                            },
                            {
                                "example_id": "e65d5b62-fa2d-4b9d-ba66-216df6db4f64",
                                "sense_id": "bec71189-3373-35b2-a2dd-6b4d2e353b2b",
                                "text": "„We komen uit Rotterdam gevaren en we zijn op weg naar het Duitse Wesel”, vertelt Lenten, terwijl ze een verse slakrop in haar boodschappenkarretje legt. „We vervangen onze zoon die normaliter op dit schip vaart, want hij heeft een paar dagen vrij."
                            }
                        ]
