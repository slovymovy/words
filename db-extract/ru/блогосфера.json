                                        "glosses": [
                                            "ogół blogów traktowanych jako przestrzeń społeczna i publicystyczna autorów oraz ich czytelników"
                                        ],
                                        "tags": [
                                            "publ."
                                        ],
                                        "examples": [
                                            {
