                        "translation_id": "b33549b2-949e-4cba-81ed-b89f7d70ff97",
                        "source_entry_id": "e5898090-2041-3000-8064-44957de18734",
                        "source_sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                        "target_lang_word": "museo all'aperto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9878a199-962b-4e5f-932e-bef30025ed9b",
                        "source_entry_id": "e5898090-2041-3000-8064-44957de18734",
                        "source_sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                        "target_lang_word": "openluchtmuseum",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "openluchtmuseum",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "510c5a9e-bed9-32f7-baab-0a25d6b6326d",
                                        "entry_id": "86eca834-2d3a-301a-a3a4-6fdf5be3a03c",
                                        "glosses": [
                                            "museum met karakteristieke woonhuizen, boerderijen, industriegebouwen e.d. die in de buitenlucht zijn tentoongesteld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c84f0aa-ce88-493b-af8f-c61897554d98",
                                                "sense_id": "510c5a9e-bed9-32f7-baab-0a25d6b6326d",
                                                "text": "En er is natuurlijk het gigantische Holocaustmonument aan de Brandenburgse poort, het Gedenkteken voor de in Europa vermoorde Joden, zoals het officieel heet. Niet zo ver daarvandaan, op de plek waar het hoofdkwartier van de Gestapo stond, is er een openluchtmuseum met een al even toepasselijke naam: Topographie des Terrors. Haarfijn wordt hier uit de doeken gedaan hoe de nazi’s de macht hebben veroverd en hoe meedogenloos ze hun tegenstanders vervolgden."
                                            },
                                            {
                                                "example_id": "5fafeaf6-7d29-4c9b-a650-553af02e8df3",
                                                "sense_id": "510c5a9e-bed9-32f7-baab-0a25d6b6326d",
                                                "text": "Bij de Denekampse Fietsvierdaagse kunnen deelnemers kiezen uit 25, 40, 60 of 100 kilometer. De routes, die allemaal uitgepijld worden, voeren door natuurgebieden in Noordoost-Twente en het grensgebied met Duitsland. Onderweg zijn er diverse pauzelocaties, waaronder fruitboerderij Oald Bleank in Rossum, het Openluchtmuseum in Ootmarsum en de Westerveldmolen in Tilligte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cfec37-e434-34ba-aa89-208c7203e1cf",
                                        "entry_id": "86eca834-2d3a-301a-a3a4-6fdf5be3a03c",
                                        "glosses": [
                                            "expositie van kunstwerken in de buitenlucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56cfe67-282f-4529-890d-1d1c8e4415d8",
                                                "sense_id": "53cfec37-e434-34ba-aa89-208c7203e1cf",
                                                "text": "Toch is juist deze plek al veertig jaar een inspiratiebron voor grote namen uit de kunstwereld. Sinds de eerste editie van Skulptur Projekte Münster in 1977 hebben honderden kunstenaars hier hun werken in de openbare ruimte geplant. Veel van die sculpturen zijn in het straatbeeld blijven staan. Dat maakt Münster tot een uniek openluchtmuseum, waar je op iedere straathoek struikelt over monumentale werken van Per Kirkeby, Bruce Nauman, Giuseppe Penone of Claes Oldenburg. Ver voordat andere steden beeldenroutes ontdekten als ideale vorm van citymarketing, pionierde Münster al met publieke kunst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
