                                        "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                        "entry_id": "acce1b25-d8db-3fa6-be0d-06930b61ecb8",
                                        "glosses": [
                                            "Art der wetterbeständigen Fassadenmalerei, bei der zunächst auf Rohputz verschiedenfarbige Putzschichten aufgetragen werden und dann durch ein unterschiedlich tiefes Kratzen mit einem Kratzeisen mehrfarbige Motive kreiert werden"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e1d4f4-efe1-42e7-b105-008dc6332722",
                                                "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                                "text": "Vor allem in der italienischen Renaissance wurden viele Sgraffiti geschaffen."
                                            },
                                            {
                                                "example_id": "47eb72f5-648f-44a1-b1df-c02c44266de7",
                                                "sense_id": "afbd1c22-5b9c-3931-a241-4d50b00b72c9",
                                                "text": "Sgraffiti und Graffiti, beide Bezeichnungen standen synonym für eine Technik der Fassadengestaltung, einer Kratzputztechnik, bei welcher verschiedenfarbige Putzschichten aufgetragen und dann durch Wegkratzen der oberen Schicht reliefartige Motive gestaltet wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
