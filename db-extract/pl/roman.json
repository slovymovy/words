                                                "sense_id": "895cb7a6-173f-3ea9-9afa-5722ea1d1019",
                                                "text": "Roman hat keine Ahnung von Pferden."
                                            },
                                            {
                                                "example_id": "c1613728-b4fc-4845-bd92-f7d426968d46",
                                                "sense_id": "895cb7a6-173f-3ea9-9afa-5722ea1d1019",
                                                "text": "Roman Herzog war ein deutscher Bundespräsident."
                                            }
                                        ],
