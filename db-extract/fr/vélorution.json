                        "glosses": [
                            "Mouvement cycliste, se caractérisant parfois par une manifestation cycliste pour la promotion de l’usage du vélo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "272654d5-33c2-4357-baa7-d16722268854",
                                "sense_id": "01abd74c-8d65-3d4b-a8a6-7a9ac00ee9f8",
                                "text": "Vélorution ! Derrière ce mot valise, se cache un mouvement international qui vise à donner aux déplacements cyclistes une place centrale dans les déplacements urbains."
                            },
                            {
                                "example_id": "aa469c45-47e1-48ad-8cb2-da2bf1ebd458",
                                "sense_id": "01abd74c-8d65-3d4b-a8a6-7a9ac00ee9f8",
                                "text": "La première vélorution a été organisée en France au début des années 70 à Paris contre un projet d’autoroute qui devait longer la Seine et traverser la capitale d’est en ouest."
                            }
                        ]
                    }
