    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47763ba9-6835-393f-bec8-d066bc83db67",
                    "sense_definition": "Kind, sensitive, or empathetic.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>caring</w> person who always helps her neighbors.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>заботливый</w> человек, который всегда помогает своим соседям.",
                                "es": "Es una persona muy <w>atenta</w> que siempre ayuda a sus vecinos.",
                                "fr": "C'est une personne très <w>attentionnée</w> qui aide toujours ses voisins."
                            }
                        },
                        {
                            "text": "Doctors need to have a <w>caring</w> attitude to make patients feel safe.",
                            "target_lang_translations": {
                                "ru": "Врачам необходимо иметь <w>чуткое</w> отношение, чтобы пациенты чувствовали себя в безопасности.",
                                "es": "Los médicos necesitan tener una actitud <w>cálida</w> para hacer que los pacientes se sientan seguros.",
                                "fr": "Les médecins doivent adopter une attitude <w>bienveillante</w> pour que les patients se sentent en sécurité."
                            }
                        }
                    ],
                    "synonyms": [
                        "kind",
                        "thoughtful",
                        "compassionate",
                        "considerate",
                        "sympathetic"
                    ],
                    "antonyms": [
                        "uncaring",
                        "callous",
                        "indifferent",
                        "cold"
                    ],
                    "common_phrases": [
                        "caring person",
                        "caring attitude",
                        "loving and caring",
                        "caring nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добрый, чуткий или проявляющий эмпатию.",
                        "es": "Amable, atento, empático o afectuoso con los demás.",
                        "fr": "Bienveillant, attentif, attentionné ou faisant preuve d'empathie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заботливый",
                                "target_lang_sense_clarification": "проявляющий внимание и доброту"
                            },
                            {
                                "target_lang_word": "чуткий",
                                "target_lang_sense_clarification": "отзывчивый, понимающий чувства других"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atento",
                                "target_lang_sense_clarification": "que se preocupa por el bienestar de los demás"
                            },
                            {
                                "target_lang_word": "cariñoso",
                                "target_lang_sense_clarification": "afectuoso y comprensivo"
                            },
                            {
                                "target_lang_word": "solícito",
                                "target_lang_sense_clarification": "dispuesto a ayudar y cuidar"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "attentionné",
                                "target_lang_sense_clarification": "qui a des égards et prend soin des autres"
                            },
                            {
                                "target_lang_word": "bienveillant",
                                "target_lang_sense_clarification": "qui montre de la bonté et de la compréhension"
                            },
                            {
                                "target_lang_word": "prévenant",
                                "target_lang_sense_clarification": "qui devance les besoins ou désirs d'autrui"
                            }
                        ]
                    }
                }
            ]
        },
