                    },
                    {
                        "translation_id": "2b949b5a-6896-4fbf-87bd-b06d6d66ffd2",
                        "source_entry_id": "ac39ee7e-3cc2-36cb-9690-b866c0c0f524",
                        "source_sense_id": "5c4a4a88-ab1e-36ec-b7e9-684ceb0a64f9",
                        "target_lang_word": "stramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6857342e-c718-3ac3-b092-913fa9ad64f9",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "den Körper fest umschließend, sehr eng anliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe58c8a-475f-4dda-8bdc-3ddee9bec6fc",
                                                "sense_id": "6857342e-c718-3ac3-b092-913fa9ad64f9",
                                                "text": "„Bei sehr schlanken Beinen kann eine Strumpfhose Falten werfen, kaufe Dir dann eine Stützstrumpfhose. Die sitzen an den Beinen ohnehin etwas strammer.“"
                                            },
                                            {
                                                "example_id": "d9161803-d91a-43ba-9b00-09d7781b3ff6",
                                                "sense_id": "6857342e-c718-3ac3-b092-913fa9ad64f9",
                                                "text": "Frühmorgens geht das Kleid bis zum Knie - und das Fräulein ins Büro. - Das Kleid sitzt stramm auf der Anatomie - und läßt keinen Raum für die Phantasie. - Man sieht den Bestand ja auch so. […]"
                                            },
                                            {
                                                "example_id": "952e6bf7-06b7-417c-aaa4-5f14b1d9bfa7",
                                                "sense_id": "6857342e-c718-3ac3-b092-913fa9ad64f9",
                                                "text": "„Um die richtige BH-Größe heraus zu finden muß man stramm unter der Brust messen. Die Wahl des richtigen Unterbrustmaßes stellt sicher, dass der BH weder zu stramm, noch zu lose sitzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2b6ecb2-5048-3ab6-acde-74582c88f66a",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "nicht locker, nicht lose, nicht durchhängend; aufrecht, straff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce6130a-8093-4ec2-a5cb-d296b3d487eb",
                                                "sense_id": "c2b6ecb2-5048-3ab6-acde-74582c88f66a",
                                                "text": "„Um die richtige BH-Größe heraus zu finden muß man stramm unter der Brust messen. Die Wahl des richtigen Unterbrustmaßes stellt sicher, dass der BH weder zu stramm, noch zu lose sitzt.“"
                                            },
                                            {
                                                "example_id": "6ea263c6-1ad6-48e1-a6b7-12886d24b388",
                                                "sense_id": "c2b6ecb2-5048-3ab6-acde-74582c88f66a",
                                                "text": "Die Slackline muß stramm gespannt werden, dann balanciert es sich leichter."
                                            },
                                            {
                                                "example_id": "9cf80239-6b83-4979-8a99-a7621b25f22a",
                                                "sense_id": "c2b6ecb2-5048-3ab6-acde-74582c88f66a",
                                                "text": "Der Bowdenzug [für das Schaltwerk des Fahrrades] wird stramm gehalten und wieder mit der Klemmschraube befestigt."
                                            },
                                            {
                                                "example_id": "82482e85-e442-4d04-ad12-c9e2565cec8f",
                                                "sense_id": "c2b6ecb2-5048-3ab6-acde-74582c88f66a",
                                                "text": "[…] die zukünftigen Soldaten lernen stramm zu stehen und zu gehorchen. Bei Geländespielen und Wehrsport – so wird den meisten noch bis 1945 klar – trainieren sie für den Einmarsch in fremde Länder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e6ce54bc-b2f1-3d95-9357-effb5fc7e168",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "kräftig gebaut und gesund, kraftvoll aussehend"
                                        ],
                                        "tags": [
                                            "menschlicher Körper"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7f89637-ff08-452e-961e-954b260ea887",
                                                "sense_id": "e6ce54bc-b2f1-3d95-9357-effb5fc7e168",
                                                "text": "„Sie hat einen strammen Jungen bekommen. Kein Wunder bei dem großen Vater!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3d8e0dba-f38b-3858-8d12-9de329edc74e",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "anstrengend, tüchtig, fest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25654bec-9e7d-4480-bade-aa36cfd85367",
                                                "sense_id": "3d8e0dba-f38b-3858-8d12-9de329edc74e",
                                                "text": "Sein [des United-Verteidigers Patrice Evra] strammer Schuss landete unhaltbar für Manuel Neuer im rechten oberen Winkel des Münchener Tors (57.)."
                                            },
                                            {
                                                "example_id": "7586e469-368b-446e-a01c-e967a6258153",
                                                "sense_id": "3d8e0dba-f38b-3858-8d12-9de329edc74e",
                                                "text": "Der stramme und eisige Nordostwind wird über Norddeutschland mindestens bis Anfang nächster Woche wehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e58ea7ef-3014-346f-8969-62994f5ffc86",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "straff durchorganisiert, in einem engen Zeitplan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a629a3e-ce1c-4842-8138-5b9b451efe21",
                                                "sense_id": "e58ea7ef-3014-346f-8969-62994f5ffc86",
                                                "text": "Das strammste Programm bei diesem Schwimmwettbewerb hat Vielstarter Max Müller mit 3 Freistil- und 2 Rückenstarts."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "87eab318-bede-3601-8276-e3d349d7f327",
                                        "entry_id": "ffdccc92-646e-3cb7-9a5b-7002dc3dfbd9",
                                        "glosses": [
                                            "stur, unbelehrbar"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b49b90f-2687-4b6b-a46b-7c8ebff877f7",
                                                "sense_id": "87eab318-bede-3601-8276-e3d349d7f327",
                                                "text": "Er ist ein strammer Vertreter des Neoliberalismus."
                                            },
                                            {
                                                "example_id": "c3bcc3c9-2d1b-4576-8ab8-9785eda40b42",
                                                "sense_id": "87eab318-bede-3601-8276-e3d349d7f327",
                                                "text": "Die heute 25 Jahre alte Nichte von Marine Le Pen [, Marion Maréchal-Le Pen,] polemisiert deutlich radikaler als die aktuelle Parteichefin, nimmt weniger Rücksicht und kommt bei stramm nationalen Wählern in Südfrankreich gut an."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
