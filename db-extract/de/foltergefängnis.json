                "senses": [
                    {
                        "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                        "entry_id": "e457a0be-c88c-3bcb-884a-249ba52ff05b",
                        "glosses": [
                            "Ort, an dem Leute gefangen gehalten und (physisch sowie psychisch) gequält werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b0981b-22b1-41f0-a450-213933d98d75",
                                "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                                "text": "„Weil ich gegen einen Mann ermittelte, der dem Regime wohl nahestand, wurde ich nachts überfallen und in das Foltergefängnis verschleppt.“"
                            },
                            {
                                "example_id": "79e44f74-0116-4b6d-9ba6-e92e63f546c9",
                                "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                                "text": "„Kaing Guek Eav, Chef des Foltergefängnisses Tuol Sleng, war bereits zu lebenslanger Haft verurteilt worden.“"
                            },
                            {
                                "example_id": "5c462e2a-9542-4a8f-8643-25f43e7cec45",
                                "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                                "text": "„Körperverletzung, unzüchtige Handlungen und Pflichtversäumnis lautete die Anklage gegen den Reservisten Charles Graner vor einem amerikanischen Militärgericht. Der ehemalige US-Soldat hatte im Foltergefängnis Abu Ghuraib im Irak unter anderem als Aufseher vor einer Pyramide nackter Gefangener posiert und sich dabei fotografieren lassen.“"
                            },
                            {
                                "example_id": "1670ab6c-3440-4ab2-83fc-92f30d2f2744",
                                "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                                "text": "„Yonas landete im Foltergefängnis, weil er nach 14 Jahren Wehrdienst desertiert war und versucht hatte, in den Sudan zu fliehen.“"
                            },
                            {
                                "example_id": "5f68b06d-727b-4486-9079-5d078b3dca6b",
                                "sense_id": "4ffa68c0-5b44-3304-b79a-90578201e613",
                                "text": "„Das Foltergefängnis Tuol-Sleng ist heute ein Museum, in dem auch Vann Naths Werke ausgestellt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
