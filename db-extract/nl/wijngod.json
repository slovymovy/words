                            {
                                "example_id": "bd3a834e-3b75-4d11-aab7-cd9c500ea09a",
                                "sense_id": "8f429f0d-945a-36aa-b4ad-2038a3fa84b6",
                                "text": "Elk jaar wordt in juni een feestelijk kunstfestival ter ere van de wijngod Dionysos gehouden. Perperikon wordt door de oude Grieken nog steeds als het heiligdom van deze wijngod gezien."
                            },
                            {
                                "example_id": "4d0cffc8-6190-4b7c-9a1e-b27115dacede",
                                "sense_id": "8f429f0d-945a-36aa-b4ad-2038a3fa84b6",
                                "text": "Dat voel ik. Dion Graus gaat doorbreken.’ En dat gebeurde: exact vier jaar later vergelijkt hij zichzelf in een interview met Koning Midas, want: ‘Alles wat ik heb aangeraakt is in goud veranderd.’ En hoe kan het ook anders met zo’n naam. Was het niet wijngod Dionysos die Midas de kracht verleende om alles in goud te veranderen?"
                            }
                        ]
