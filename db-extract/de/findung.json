                        "entry_id": "6c8d740b-6e43-3666-90a2-4948cf38a7c0",
                        "glosses": [
                            "Découverte, détermination, établissement, recherche ; action de rechercher quelque chose, avec l’idée que l’on est parvenu à un résultat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db8322b-b830-439d-b4d2-fad4a9552941",
                                "sense_id": "e7c8c318-456c-3e83-b47e-1113202e81f1",
                                "text": "Viele Menschen halfen bei der Findung des Goldschatzes mit.",
                                "translation": "Beaucoup de personnes aidèrent à la découvertes du trésor en or."
                            },
                            {
                                "example_id": "259fc818-33fb-45ba-a8da-08bec148f541",
                                "sense_id": "e7c8c318-456c-3e83-b47e-1113202e81f1",
                                "text": "Die Findung eines für alle annehmbaren Kompromisses dauerte länger als geplant.",
                                "translation": "La recherche et l’établissement d’un compromis acceptable pour tous dura plus longtemps que prévu."
                            }
                        ]
                    }
