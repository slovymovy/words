                "senses": [
                    {
                        "sense_id": "93e969db-d5fd-3b45-b93f-9f72880a9b79",
                        "entry_id": "0f7fdeab-55d4-3b9b-aacb-b07cb686e2cf",
                        "glosses": [
                            "уменьш. к рыба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfeca656-d981-4214-8048-70718755eebf",
                                "sense_id": "93e969db-d5fd-3b45-b93f-9f72880a9b79",
                                "text": "— Я так люблю рыбку — привыкла. Папа капитанил на Иртыше, дома у нас всегда была разная рыбка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3072e5a-90be-408d-9e52-428024241542",
                        "source_entry_id": "0f7fdeab-55d4-3b9b-aacb-b07cb686e2cf",
                        "source_sense_id": "93e969db-d5fd-3b45-b93f-9f72880a9b79",
