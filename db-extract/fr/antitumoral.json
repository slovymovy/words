                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf5c256-f61f-4732-8a5a-6d1f2a95baf7",
                                "sense_id": "37548938-0641-3286-8ebd-f2215bfec6d3",
                                "text": "Les antitumoraux néphrotoxiques relèvent d'une toxicité directe dose-dépendante d'expression souvent retardée."
                            },
                            {
                                "example_id": "c72ef3ea-accb-4b27-a37f-08db920397c1",
                                "sense_id": "37548938-0641-3286-8ebd-f2215bfec6d3",
                                "text": "Pour un antitumoral donné, la toxicité dépend de la dose, de la voie d’administration, et du temps d’exposition."
                            }
                        ]
