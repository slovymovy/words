                                "example_id": "06c8fb6b-8f87-4ff0-a806-944f6b535717",
                                "sense_id": "2b551ae2-4250-3e9d-9532-20246e374479",
                                "text": "„Im Januar 1822 bat Naumann um das Bürgerrecht der Freien Stadt Frankfurt, im März 1822 leistete er den Bürgereid und als anerkannter Bürger heiratete er einen Monat später Eleonora Susanna Ochs, Tochter des verstorbenen Frankfurter Buch- und Papierhändlers Johannes Ochs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
