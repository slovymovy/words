                        "sense_id": "69575327-0af9-36d6-849f-3f5a7ef74114",
                        "entry_id": "a3032eca-afa3-3bbc-81f1-9cb37e263d20",
                        "glosses": [
                            "pismo zawierające zbiorową prośbę, kierowane najczęściej do organów władzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3dabf6-ffd6-40c0-a681-b60bfa9d950d",
                                "sense_id": "69575327-0af9-36d6-849f-3f5a7ef74114",
                                "text": "Wpływanie na decyzje polityczne we własnym interesie, często mylone z lobbingiem to w rzeczywistości wykonywanie obywatelskiego prawa petycji do władz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2dfe354-d2dd-4132-a58b-c3b0f8fd0f12",
                        "source_entry_id": "a3032eca-afa3-3bbc-81f1-9cb37e263d20",
                        "source_sense_id": "69575327-0af9-36d6-849f-3f5a7ef74114",
                        "target_lang_word": "petition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af107bdb-9e92-39c7-a5fc-f94d2b734b7b",
                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A formal written request made by an individual or a group of people to a sovereign or political authority, often containing many signatures, soliciting some grace, right, mercy, or the redress of some wrong or grievance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497e8dcd-830e-45fc-ba69-912b5eb2487f",
                                                "sense_id": "af107bdb-9e92-39c7-a5fc-f94d2b734b7b",
                                                "text": "We're looking to get 10,000 people to sign the petition to have the bird colony given legal protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c06fa5-0915-38a9-a112-c72f99764057",
                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A formal written application made to a magistrate or court for an order or a suit for divorce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                        "entry_id": "0041966c-d0b2-341b-a79c-d013dacef71b",
                                        "glosses": [
                                            "A prayer or supplication, especially of which is formal or humble and made to a deity, a sovereign, or an authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b398aa96-5c75-4d1f-8ea5-7309e30aeed5",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "a petition to aid"
                                            },
                                            {
                                                "example_id": "b07fb6c1-f7ec-4c48-8b7d-74933105d942",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "a petition to God for courage and strength"
                                            },
                                            {
                                                "example_id": "77c55d0f-5b29-4c46-8c7a-0b2f2999c8ae",
                                                "sense_id": "6ba851c2-78c1-3bda-8451-303c94d9376b",
                                                "text": "A house of prayer and petition for thy people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "petition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                        "entry_id": "9d955d33-e704-3ac1-9687-f8d9d7d15810",
                                        "glosses": [
                                            "To make a petition to (a sovereign or political authority)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c6d81b-1454-42ff-b0bb-7c006c699787",
                                                "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                                "text": "The villagers petitioned the council to demolish the dangerous building."
                                            },
                                            {
                                                "example_id": "f4b18f2e-eb53-4980-9b90-fbb8f892dcb7",
                                                "sense_id": "75719f57-6ffd-37b5-b210-a4377a4e2295",
                                                "text": "The company, appreciating the crippling affect ^([sic]) that this scheme will have on its activities unless the railway is diverted, has petitioned against the North Wales Hydro-Electric Power Bill at present before the House of Lords."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d179b895-5e12-4854-a37d-508260b68084",
                        "source_entry_id": "a3032eca-afa3-3bbc-81f1-9cb37e263d20",
                        "source_sense_id": "69575327-0af9-36d6-849f-3f5a7ef74114",
                        "target_lang_word": "pétition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "464dc27e-d7fc-3067-8439-ad837c0df762",
                                        "entry_id": "7e855a92-4236-32bd-8ac7-cf6533b5074e",
                                        "glosses": [
                                            "Action de demander."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                        "entry_id": "7e855a92-4236-32bd-8ac7-cf6533b5074e",
                                        "glosses": [
                                            "Demande par écrit adressée à une autorité administrative ou politique."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25023c05-685e-4be5-9f70-20fe357a8b1f",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "Les négocians et marchands protestans de Dublin et des principales villes commerçantes de l’Irlande, avaient adressé des pétitions aux deux chambres du parlement, contre l’émancipation catholique. Ces pétitions excitèrent un vif mouvement d’indignation, au moment où le mécontentement public était déjà porté au plus haut degré."
                                            },
                                            {
                                                "example_id": "669fbf17-52de-45a8-bade-13f3fcbff07c",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "M. Jules Simon, par une circulaire aux préfets, interdit le colportage de la pétition réclamant une intervention de la France en faveur du Saint-Siège."
                                            },
                                            {
                                                "example_id": "4b898381-da24-4c3d-bf1e-d14fdc3a4c15",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "[…], et le lendemain il faisait signer à son Conseil municipal d’abord, à ses administrés ensuite, une pétition contre cet imbécile de maître d’école qu’il fallait absolument et au plus vite faire f… le camp du pays."
                                            },
                                            {
                                                "example_id": "409f1fe4-165c-4b62-9be3-d08c57471897",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "Un mot l’avait frappé. Il faudrait faire circuler une pétition à travers tout le pays, de village en village."
                                            },
                                            {
                                                "example_id": "efbd1e47-0ecc-403f-b3c0-63fab912a947",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "Avec ce rapport, l'association souhaite interpeller les candidats aux élections européennes, puisqu'un règlement sera soumis au vote une fois le scrutin passé. Une pétition est mise en ligne mercredi 17 avril, sur le site de l'association HOP."
                                            },
                                            {
                                                "example_id": "dffe5090-bee7-42ca-aeb7-3b735dcf78f9",
                                                "sense_id": "4fb9d3db-734d-3a19-943b-a419cc34a131",
                                                "text": "La Prévention routière a lancé jeudi 23 mai 2024 une pétition pour la généralisation de l’abaissement à 30 km/h de la vitesse maximale en ville, pour favoriser la \"sécurité routière\" comme le développement des mobilités \"bonnes pour la santé et la planète\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d3b247-dcd6-3a48-a075-30bf403f976e",
                                        "entry_id": "7e855a92-4236-32bd-8ac7-cf6533b5074e",
                                        "glosses": [
                                            "pétition internet: Demande par internet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae80dcdd-c166-480a-9689-09bd2fea208e",
                                                "sense_id": "41d3b247-dcd6-3a48-a075-30bf403f976e",
                                                "text": "Avec ce rapport, l'association souhaite interpeller les candidats aux élections européennes, puisqu'un règlement sera soumis au vote une fois le scrutin passé. Une pétition est mise en ligne mercredi 17 avril, sur le site de l'association HOP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
