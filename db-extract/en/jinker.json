                    {
                        "sense_id": "623812ac-a0d3-31cb-9b8e-482f2e0531eb",
                        "entry_id": "b371918c-0e54-32af-9014-3e19dec0997f",
                        "glosses": [
                            "A high wheeled wagon designed to carry lumber suspended under the body of the vehicle."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "79eefe35-8fff-429f-b8e4-e12dc5e12094",
                                "sense_id": "623812ac-a0d3-31cb-9b8e-482f2e0531eb",
                                "text": "[…] exhibited was a newly designed jinker, invented by Mr. John Allan.[…] can load a tree weighing 1½ tons with the greatest ease."
                            }
                        ]
                    },
                    {
                        "sense_id": "01edaa24-c493-3bd2-814d-4f4d0618a0d6",
                        "entry_id": "b371918c-0e54-32af-9014-3e19dec0997f",
                        "glosses": [
                            "A specialised trailer for carrying long loads such as logs or other large loads such as when moving buildings."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "3a6fc731-dc67-4ae7-b0e2-c9ab0e6cbde9",
                                "sense_id": "01edaa24-c493-3bd2-814d-4f4d0618a0d6",
                                "text": "The contractor, Mr. A. F. Pincombe, who moved the building intact on a jinker..."
                            },
                            {
                                "example_id": "33b2a825-f7d5-4eae-8449-f83f1ef9c548",
                                "sense_id": "01edaa24-c493-3bd2-814d-4f4d0618a0d6",
                                "text": "A Jinker trailer is a trailer designed to transport long logs or other long pieces of material/blocks."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f5dd5b4-1abd-371f-a761-1be2d736758d",
                        "entry_id": "b371918c-0e54-32af-9014-3e19dec0997f",
                        "glosses": [
                            "A two-wheeled open horse drawn carriage. A sulky, trap, road cart or gig."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "aa3e857b-8564-4fed-ae6f-5fdc5810d93f",
                                "sense_id": "4f5dd5b4-1abd-371f-a761-1be2d736758d",
                                "text": "I fell out of the jinker and it ran over me but again I survived that without too much trouble."
                            },
                            {
                                "example_id": "faf4fda6-a38d-4aac-bc9e-8a91a692835e",
                                "sense_id": "4f5dd5b4-1abd-371f-a761-1be2d736758d",
                                "text": "He stood in the jinker and gave the horse a great thwack on the backside with the end of the reins."
                            },
                            {
                                "example_id": "05e187d9-c2fc-4dec-957d-1ac7609f5318",
                                "sense_id": "4f5dd5b4-1abd-371f-a761-1be2d736758d",
                                "text": "These two-wheeled passenger vehicles [sulkies], also known as gigs or jinkers in Victoria, could be found in every town and country district [quoting from \"Sulkies, Whiskeys and Gigs\" by Jeff Powell]....Not to be confused with a timber-hauling jinker, which has little in common."
                            },
                            {
                                "example_id": "285322d5-8ecd-43d9-b6cc-8027f3684e7b",
                                "sense_id": "4f5dd5b4-1abd-371f-a761-1be2d736758d",
                                "text": "Near the homestead they came upon Peter sitting on the shaft of a jinker, crooning a corroboree song and gazing so intently at the coffin-like ridge that he did not see them."
                            }
                        ]
                    }
