                ],
                "senses": [
                    {
                        "sense_id": "8de13069-2a15-39e8-a7c6-ff1d9aefed0c",
                        "entry_id": "69b55f15-3c7b-3349-bb88-8df87465f533",
                        "glosses": [
                            "An economic system under which a few private individuals (landlords) own property, and rent it to tenants."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b1ddcc35-450d-48fb-8044-1ddca9bb431e",
                                "sense_id": "8de13069-2a15-39e8-a7c6-ff1d9aefed0c",
                                "text": "What if all the poor people should refuse to pay rent and shelter themselves under the American flag? Landlordism would go crumbling."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c87b7f5-bafe-3ea7-a04b-f1fc746f26dd",
                        "entry_id": "69b55f15-3c7b-3349-bb88-8df87465f533",
                        "glosses": [
                            "A specific variation or implementation of such a system."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "db1c3433-11bd-4514-861a-b4a3d288b529",
                                "sense_id": "8c87b7f5-bafe-3ea7-a04b-f1fc746f26dd",
                                "text": "[…] including the racialized landlordisms to which it gives rise."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a7a1210-2470-343b-a75c-11edb567928e",
                        "entry_id": "69b55f15-3c7b-3349-bb88-8df87465f533",
                        "glosses": [
                            "The actions and behavior of a landlord."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f51ab90c-29a1-4166-a4d8-4b34a6ff9136",
                                "sense_id": "0a7a1210-2470-343b-a75c-11edb567928e",
                                "text": "Yet his account also implies the carelessness of his landlordism before now and the invisibility to him of those beneath his social horizon (even if they are paying him rent)."
                            }
                        ]
                    }
                ],
