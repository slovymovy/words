    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "84943064-102d-3332-a5c9-bdab57ccf2a3",
                    "sense_definition": "Pousser une expiration prolongée et audible sous l'effet de la tristesse, de la fatigue ou du soulagement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par cette longue journée de travail, il <w>soupira</w> profondément avant de s'asseoir."
                        },
                        {
                            "text": "Elle <w>soupira</w> de soulagement en apprenant que son fils était enfin rentré sain et sauf."
                        }
                    ],
                    "synonyms": [
                        "souffler"
                    ],
                    "common_phrases": [
                        "soupirer d'aise",
                        "soupirer de soulagement",
                        "soupirer de lassitude"
                    ]
                },
                {
                    "sense_id": "ebded9a1-8b31-3b20-a380-569d86231c41",
                    "sense_definition": "Désirer ardemment quelque chose, attendre un événement ou une situation avec une vive impatience.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Enfermé dans ce bureau sans fenêtre, le jeune homme <w>soupirait</w> après les vacances d'été."
                        },
                        {
                            "text": "Après des mois d'efforts intenses, tous les membres de l'équipe <w>soupirent</w> après un peu de repos."
                        }
                    ],
                    "synonyms": [
                        "aspirer",
                        "languir"
                    ],
                    "common_phrases": [
                        "soupirer après la liberté",
                        "soupirer après le repos"
                    ]
                },
                {
                    "sense_id": "d6517fdf-3428-3cc0-af0f-2f472448288a",
                    "sense_definition": "Éprouver un amour passionné ou secret pour une personne, languir d'amour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce roman classique, le jeune poète <w>soupire</w> pour une femme qu'il ne peut approcher."
                        },
                        {
                            "text": "Il a longtemps <w>soupiré</w> pour sa cousine avant d'oser lui déclarer sa flamme."
                        }
                    ],
                    "synonyms": [
                        "brûler",
                        "languir"
                    ],
                    "common_phrases": [
                        "soupirer pour une femme"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "S'emploie surtout dans la littérature galante ou d'époque."
                        }
                    ]
                },
                {
                    "sense_id": "b7ec533f-2648-3eee-9e7f-7afc23a97ebc",
                    "sense_definition": "Exprimer ou chanter de manière plaintive un sentiment, une peine ou un tourment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Assis au bord de la rivière, le troubadour <w>soupirait</w> ses peines au son de son luth."
                        },
                        {
                            "text": "Les vers délicats que le poète <w>soupirait</w> ont ému toute l'assemblée réunie dans le salon."
                        }
                    ],
                    "synonyms": [
                        "exhaler",
                        "gémir"
                    ],
                    "common_phrases": [
                        "soupirer ses peines",
                        "soupirer son amour"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Usage poétique et rare."
                        }
                    ]
                }
            ]
