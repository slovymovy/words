{
    "word_family": [
        "wind",
        "shield"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e842380c-3363-32e8-a969-f104a3623b1d",
                    "sense_definition": "A transparent glass screen at the front of a vehicle that protects occupants from wind and weather.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The freezing rain covered our <w>windshield</w> with ice and we could not see a thing.",
                            "target_lang_translations": {
                                "zh": "冻雨在我们的<w>挡风玻璃</w>上结了冰，我们什么也看不见。"
                            }
                        },
                        {
                            "text": "She used her hands like <w>windshield</w> wipers to clear the snow from the glass.",
                            "target_lang_translations": {
                                "zh": "她像使用<w>挡风玻璃</w>雨刷一样用手扫去玻璃上的积雪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "windscreen"
                    ],
                    "common_phrases": [
                        "clean the windshield",
                        "cracked windshield",
                        "windshield wipers"
                    ],
                    "target_lang_definitions": {
                        "zh": "汽车前部的透明玻璃屏，用于保护车内人员免受风雨侵袭。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挡风玻璃",
                                "target_lang_sense_clarification": "汽车前窗的玻璃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c136a6-655d-39d3-b89a-abbdcca5ba3d",
                    "sense_definition": "A protective cover placed over a microphone to reduce noise from wind or breathing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reporter put a foam <w>windshield</w> on the microphone before recording outside.",
                            "target_lang_translations": {
                                "zh": "记者在户外录音前给麦克风套上了一个泡沫<w>防风罩</w>。"
                            }
                        },
                        {
                            "text": "Without a <w>windshield</w>, the recording was ruined by the loud gusts of air.",
                            "target_lang_translations": {
                                "zh": "没有<w>防风罩</w>，录音被强烈的阵风毁了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "microphone windshield"
                    ],
                    "target_lang_definitions": {
                        "zh": "套在麦克风上的保护罩，用于减少风声或呼吸声带来的噪音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "防风罩",
                                "target_lang_sense_clarification": "麦克风的防风设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a766aa-4be1-356d-ac78-cf75c5f5e3c3",
                    "sense_definition": "A small aerodynamic cover on the tip of a shell to improve its flight range.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>windshield</w> on the projectile helps it cut through the air more efficiently.",
                            "target_lang_translations": {
                                "zh": "弹体上的<w>风帽</w>有助于它更高效地穿过空气。"
                            }
                        },
                        {
                            "text": "Engineers designed a special <w>windshield</w> to increase the shell's velocity.",
                            "target_lang_translations": {
                                "zh": "工程师设计了一种特殊的<w>风帽</w>来提高炮弹的速度。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "安装在弹头尖端的小型空气动力学罩，旨在提高飞行距离。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "风帽",
                                "target_lang_sense_clarification": "弹药或炮弹的空气动力学罩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c84a3496-3666-3b45-a67f-a3cf3fbd8ba2",
                    "sense_definition": "To attach a protective screen to a vehicle or device.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "installation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory workers <w>windshield</w> the new cars on the assembly line.",
                            "target_lang_translations": {
                                "zh": "工厂工人在装配线上为新车<w>安装挡风玻璃</w>。"
                            }
                        },
                        {
                            "text": "They had to <w>windshield</w> the equipment to protect it from the harsh outdoor conditions.",
                            "target_lang_translations": {
                                "zh": "他们必须为设备<w>安装防风屏</w>，以保护其免受恶劣户外环境的影响。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为车辆或设备安装保护屏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "安装挡风玻璃",
                                "target_lang_sense_clarification": "给车辆装配挡风玻璃"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}