                "senses": [
                    {
                        "sense_id": "797c2593-fd6a-3947-b9ce-1c5119147843",
                        "entry_id": "3aa1851b-c531-3f6a-8227-12e2ff584b91",
                        "glosses": [
                            "Se décorer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f476204-4b9e-4bdc-a233-ce9e984e5cf7",
                                "sense_id": "797c2593-fd6a-3947-b9ce-1c5119147843",
                                "text": "Pas très loin du sapin, une autre plante s'est chargée de s'auto-décorer de superbes petites boules rouges."
                            },
                            {
                                "example_id": "e65f4d8b-3d9f-4df4-b2b8-7f15af5bc85e",
                                "sense_id": "797c2593-fd6a-3947-b9ce-1c5119147843",
                                "text": "tous les frères de la Loge pourront donc s'asseoir à l'orient, et vont pouvoir, à satiété, s'auto-décorer et se couvrir de titres honorifiques."
                            },
                            {
                                "example_id": "070c08f6-02b6-43e5-9384-30d0b2ec580d",
                                "sense_id": "797c2593-fd6a-3947-b9ce-1c5119147843",
                                "text": "Et qu'ils arrêtent de s'auto-décorer entre eux !"
                            }
                        ]
                    }
