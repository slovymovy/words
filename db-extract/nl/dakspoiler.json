                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e709634a-83bc-4f8c-9d41-bfeb31bef7f3",
                                "sense_id": "75de1293-5295-3425-a6fe-18f5674aaef1",
                                "text": "De dakspoiler. De dakspoiler heeft dezelfde functie als de vleugel: nl. het verbeteren van de wegligging. Hij is echter niet op de kofferbak, maar vlak boven de achterruit gemonteerd. Dit is een wat subtieler element. Hij kan echter het uiterlijk iets agressiefs geven. Dit onderdeel is vaak te vinden op hatchbacks, SUVs en sportwagens."
                            }
                        ]
