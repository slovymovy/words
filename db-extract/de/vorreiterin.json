                "senses": [
                    {
                        "sense_id": "adbcb77c-29db-3de6-88af-faf88b860a53",
                        "entry_id": "e3436b69-d35e-37da-a8ab-a7ac5d2f6deb",
                        "glosses": [
                            "weibliche Person, Unternehmen, Institution oder dergleichen, die etwas Neues als erste tut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b364880d-5908-41cb-beb8-6a18099c6dbe",
                                "sense_id": "adbcb77c-29db-3de6-88af-faf88b860a53",
                                "text": "„Die Gewerkschaft IG Metall gilt als Vorreiterin für neue Arbeitszeitmodelle.“"
                            },
                            {
                                "example_id": "56881617-0637-4fef-9a79-c4802dd1caa5",
                                "sense_id": "adbcb77c-29db-3de6-88af-faf88b860a53",
                                "text": "„London war in der frühen Neuzeit nicht nur eine der am schnellsten wachsenden Städte der Welt, sondern wohl auch die dreckigste. Sie wurde zur Vorreiterin in Sachen Vermüllung – aber auch zu einer Pionierin moderner Abfallbeseitigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
