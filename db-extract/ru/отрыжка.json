                "senses": [
                    {
                        "sense_id": "70eb66b1-2c5e-3f90-97af-58e07b72b513",
                        "entry_id": "0e31ff73-aaa7-3b4f-9f97-76c28904a44e",
                        "glosses": [
                            "мед. выход газов или пищи из желудочно-кишечного тракта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ae892d-d11e-46cb-818d-fe369f4b365c",
                                "sense_id": "70eb66b1-2c5e-3f90-97af-58e07b72b513",
                                "text": "Наименее частый вид судорог, это ― крик, хохот, всхлипывание, судорожные слезы, икота, отрыжка и иные судорожные формы, свойственные малой истерии."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ea83cab-8190-3f53-a1e5-4d9de237dac6",
                        "entry_id": "0e31ff73-aaa7-3b4f-9f97-76c28904a44e",
                        "glosses": [
                            "разг. характерный звук, сопровождающий отрыжку [1]"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "55f7ca3c-86d0-38f0-81a0-67958c00da93",
                        "entry_id": "0e31ff73-aaa7-3b4f-9f97-76c28904a44e",
                        "glosses": [
                            "разг. характерный запах, сопровождающий отрыжку [1]"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c39714c9-5a42-3150-a4c4-50803bbf1956",
                        "entry_id": "0e31ff73-aaa7-3b4f-9f97-76c28904a44e",
                        "glosses": [
                            "перен., пренебр. порождение, пережиток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9208acce-3d41-431d-8888-719fce1d9db4",
                                "sense_id": "c39714c9-5a42-3150-a4c4-50803bbf1956",
                                "text": "А эгоизм ― самая отвратительная отрыжка буржуазной идеологии."
                            },
                            {
                                "example_id": "1aba635d-6f27-4ef4-82c5-207fa50ab2c2",
                                "sense_id": "c39714c9-5a42-3150-a4c4-50803bbf1956",
                                "text": "Двое гениальные кадета, завязавшие международные сношения с польскою эмиграцией, суть ваш князь Орлов и любезнейший граф Левашев ― чудище и гнуснейшая отрыжка Аракчеевых времен."
                            }
                        ]
                    }
                ],
