                "senses": [
                    {
                        "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                        "entry_id": "240e7dcf-5f37-3cc3-baa5-3d1656e3e8ca",
                        "glosses": [
                            "Unternehmen eines Fachingenieurs, in dem er als Fachplaner und Fachberater tätig ist und Ingenieurleistungen erbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4034ad1b-6c69-4c45-ae7a-9022d40c5b53",
                                "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                                "text": "„Der Gemeinderat hat im April ein Fachingenieurbüro aus Bammental zur Erstellung eines Klimaschutzteilkonzeptes für die kommunalen Liegenschaften beauftragt.“"
                            },
                            {
                                "example_id": "8a22175a-9456-4c10-be36-cf0d8af9e6c3",
                                "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                                "text": "„Der Planungsmangel offenbarte sich vielmehr in den Leistungen des Fachingenieurbüros.“"
                            },
                            {
                                "example_id": "79630aa6-cfa1-42e2-8fad-9c9c45a2a14a",
                                "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                                "text": "„Derzeit ist sie noch in einem Fachingenieurbüro für Brandschutz in Schaffhausen beschäftigt.“"
                            },
                            {
                                "example_id": "a0b947dd-95cb-4eb1-abbe-ece83c38bd60",
                                "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                                "text": "„Die Auswahl der Strahler erfolgte durch ein Fachingenieurbüro für Elektrotechnik, also nicht durch uns!“"
                            },
                            {
                                "example_id": "806da741-7089-4e98-9429-8e1501f9e8ce",
                                "sense_id": "84dc88ac-db59-3c43-8d42-82e60735718d",
                                "text": "„Ein Fachingenieurbüro wurde umgehend beauftragt, die Entwässerungssituation im Städtchen zu überprüfen und geeignete Sofortmassnahmen zu erarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
