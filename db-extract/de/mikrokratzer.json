                "senses": [
                    {
                        "sense_id": "1000fced-9ee3-3a9c-b861-6e44914fe833",
                        "entry_id": "7defe70e-9cdf-376f-9b63-854cd57095df",
                        "glosses": [
                            "sehr kleiner Kratzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748e0201-96b1-43cc-b5fd-470bf677c8f2",
                                "sense_id": "1000fced-9ee3-3a9c-b861-6e44914fe833",
                                "text": "„Logitech nutzt in seinen neuen Mäusen Dunkelfeldmikroskopie. Damit werden auch mikroskopische Partikel und Mikrokratzer auf glatten Oberflächen erkannt.“"
                            },
                            {
                                "example_id": "1188965a-31dd-4b50-9ba5-7a86d8a95fd2",
                                "sense_id": "1000fced-9ee3-3a9c-b861-6e44914fe833",
                                "text": "„Mikrokratzer zeigen sich dennoch, wenn zum Beispiel eine Uhr mit Saphirdeckglas über einen Stein gezogen wird.“"
                            },
                            {
                                "example_id": "440096e7-1823-4752-b3b7-905ec4e84159",
                                "sense_id": "1000fced-9ee3-3a9c-b861-6e44914fe833",
                                "text": "„Auf keinen Fall darf der Schmutz trocken abgekratzt oder abgerieben werden, da hierdurch Mikrokratzer entstehen.“"
                            },
                            {
                                "example_id": "2deb0ef5-265d-460a-b89a-37e7f7de35f5",
                                "sense_id": "1000fced-9ee3-3a9c-b861-6e44914fe833",
                                "text": "„Wenn beispielsweise in der Waschanlage die Borsten bzw. Textilfasern auf den Klarlack treffen, werden Mikrokratzer zu etwa 90 Prozent wieder zurückgebildet […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
