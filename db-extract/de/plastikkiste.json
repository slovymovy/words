                        "examples": [
                            {
                                "example_id": "8e36f62e-f5fe-4176-bcee-09e337dc5837",
                                "sense_id": "32305975-d414-3a79-ad20-d1766a492206",
                                "text": "„Kate half Petula, ihre Siebensachen in die Plastikkisten ihres Rollwagens zu packen.“"
                            },
                            {
                                "example_id": "d49a9fac-254d-4c9d-bc9f-f375373f0fd2",
                                "sense_id": "32305975-d414-3a79-ad20-d1766a492206",
                                "text": "„Die Flaschen mit Essig und Öl stehen auf der Fensterbank, die Tütchen mit den Gewürzen in einer schlichten Plastikkiste.“"
                            },
                            {
                                "example_id": "7540fa10-d079-47ab-9ce0-6d31c405d3ae",
                                "sense_id": "32305975-d414-3a79-ad20-d1766a492206",
                                "text": "„In der Hand hatte sie eine Plastikkiste mit daumengroßen Metallröhrchen.“"
                            }
                        ],
