            {
                "entry_id": "958e430c-a5b2-3b8d-9889-d784a6bcc39b",
                "word": "multirécidiviste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef65d479-c754-49ca-a88a-44c72d2d2f50",
                        "entry_id": "958e430c-a5b2-3b8d-9889-d784a6bcc39b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multirécidivistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                        "entry_id": "958e430c-a5b2-3b8d-9889-d784a6bcc39b",
                        "glosses": [
                            "Personne ayant été condamnée à plusieurs reprises pour des crimes ou délits ou contraventions et pour des faits de même nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd0f444-3579-4bae-8a5d-fd22ff6ab09f",
                                "sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                                "text": "On n’aborde pas l’interrogatoire d’un multirécidiviste comme celui d’un primo délinquant."
                            },
                            {
                                "example_id": "56a41280-41eb-4406-a8cc-d3dd45f4706f",
                                "sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                                "text": "Les multirécidivistes sont paranos, ils connaissent le travail de la police et font des contre-observations. À chaque fois qu'ils tombent, ils analysent en détail le dossier judiciaire pour connaître ce qui leur a été fatal, apprenant de leurs maladresses."
                            },
                            {
                                "example_id": "6ca1baf7-061b-456e-8037-bfa27f21eb94",
                                "sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                                "text": "Le ministre libéral de la Justice, Lametti, a déposé le projet de loi en mai pour rendre plus difficile l'octroi d'une libération sous caution aux multirécidivistes violents."
                            },
                            {
                                "example_id": "e24cf8e7-e92e-467c-9a72-354d4e12ad12",
                                "sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                                "text": "Les personnes qui enfreignent plus souvent le code de la route, sont également plus souvent impliquées dans des accidents de la route. Pour lutter adéquatement contre la récidive, il convient donc d'identifier mieux et plus rapidement les multirécidivistes"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df958e7c-310a-47de-b48a-1439b0f5ccdb",
                        "source_entry_id": "958e430c-a5b2-3b8d-9889-d784a6bcc39b",
                        "source_sense_id": "d7e4a323-de5f-3afa-9326-299487015637",
                        "target_lang_word": "Intensivtäter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
