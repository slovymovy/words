                                            {
                                                "example_id": "be5e4d00-7ec2-460c-a87d-d1cb4e66c25b",
                                                "sense_id": "bfbaf0c0-8a9b-361a-8c9c-6ca699e740bd",
                                                "text": "On a indument procédé contre lui."
                                            },
                                            {
                                                "example_id": "4c969f5a-e539-49b0-bc28-aafde89d9d8c",
                                                "sense_id": "bfbaf0c0-8a9b-361a-8c9c-6ca699e740bd",
                                                "text": "Il a reçu, il a payé cette somme indument."
                                            }
