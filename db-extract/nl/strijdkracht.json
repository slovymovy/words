                "senses": [
                    {
                        "sense_id": "7d71dce8-66e2-3e09-85d0-d486ce6cddb9",
                        "entry_id": "f33e3bd3-0de5-30a3-8771-345ac6921aa9",
                        "glosses": [
                            "vermogen om een gevecht aan te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25065f63-bcce-4219-b0e1-a01fe15d7503",
                                "sense_id": "7d71dce8-66e2-3e09-85d0-d486ce6cddb9",
                                "text": "Generaal Bosco Ntaganda, hoofd van de militaire vleugel van de rebellengroep, zei zondag Nkunda te hebben afgezet. De machtsstrijd lijkt vooralsnog te zijn gewonnen door Nkunda, leiders van de rebellengroep staan achter hem. De generaal is populair onder lager soldaten en zijn actie kan daarom gevolgen hebben voor de strijdkracht van de rebellengroep."
                            },
                            {
                                "example_id": "01a642e3-c345-4b75-909e-0f38d1f198e7",
                                "sense_id": "7d71dce8-66e2-3e09-85d0-d486ce6cddb9",
                                "text": "Het Kosovo Bevrijdingsleger UÇK heeft zijn militaire strijdkracht overschat. Het kon alleen zo'n groot deel van Kosovo beheersen, omdat de Serviërs het ongemoeid lieten."
                            }
                        ]
                    },
                    {
                        "sense_id": "507885b1-894f-3449-9b18-c55f92696050",
                        "entry_id": "f33e3bd3-0de5-30a3-8771-345ac6921aa9",
                        "glosses": [
                            "bewapende organisatie om oorlog te voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ed4c88a-a639-410f-bd67-eaa992ac5ccd",
                                "sense_id": "507885b1-894f-3449-9b18-c55f92696050",
                                "text": "Tijdens de top zal de NATO Response Force worden gelanceerd, een snel inzetbare strijdkracht van 21.000 militairen die uit een pool van eenheden van marine, land- en luchtmacht al naar gelang die missie wordt samengesteld en in 2006 volledig operationeel moet zijn."
                            },
                            {
                                "example_id": "9aedb295-5cfc-4075-96a9-ec86102d7c2e",
                                "sense_id": "507885b1-894f-3449-9b18-c55f92696050",
                                "text": "In Rastan kwam zij in contact met gedeserteerde legerofficieren die een eigen strijdkracht tegen het regime opbouwen."
                            }
                        ]
                    }
