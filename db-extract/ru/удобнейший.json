                "senses": [
                    {
                        "sense_id": "d9f9dd40-bcfb-3875-9bdc-711e9af14fab",
                        "entry_id": "4e464966-053b-3078-a013-309e6b4a212c",
                        "glosses": [
                            "превосх. ст. к прил. удобный"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "3cbde33f-0733-4cd8-9256-22031a8a92a7",
                                "sense_id": "d9f9dd40-bcfb-3875-9bdc-711e9af14fab",
                                "text": "Пришлось, сберегая людей, ограничиться перестрелкою, ожидая удобнейшего местоположения или времени."
                            },
                            {
                                "example_id": "64ba9c77-e53e-4058-b1ad-981165245107",
                                "sense_id": "d9f9dd40-bcfb-3875-9bdc-711e9af14fab",
                                "text": "Немудрено, что их такое множество: верно, во всей губернии не найдется для них удобнейшего помещения."
                            },
                            {
                                "example_id": "4a3f793e-d9db-4690-8423-4f27f2e9fb80",
                                "sense_id": "d9f9dd40-bcfb-3875-9bdc-711e9af14fab",
                                "text": "Рыжий принялся аккуратно натягивать свою удобнейшую дубленку."
                            }
                        ]
                    }
                ],
