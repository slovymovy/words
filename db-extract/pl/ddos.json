                                "target_senses": [
                                    {
                                        "sense_id": "f492c155-e7b7-3ec5-98dc-0df335adc243",
                                        "entry_id": "c8c0baac-38c5-3be8-a980-8a9660f0385a",
                                        "glosses": [
                                            "A distributed denial-of-service attack, one that originates from many different (geographically and network topographically) sources, on a network of networks such as the Internet."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb47d6d4-0ccb-4d49-ab0c-773151be9f94",
                                                "sense_id": "f492c155-e7b7-3ec5-98dc-0df335adc243",
                                                "text": "Some bots help refresh your Facebook feed or figure out how to rank Google search results; other bots impersonate humans and carry out devastating DDoS attacks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DDoS",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30612d4c-7fe3-396d-b877-342f3aa2dd3f",
                                        "entry_id": "2eb945bf-29fb-3d20-85d9-c0237dcaafbe",
                                        "glosses": [
                                            "To attack by DDoS."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d675a66-f66d-4b11-803a-cd8b8cf7fdca",
                                                "sense_id": "30612d4c-7fe3-396d-b877-342f3aa2dd3f",
                                                "text": "Stuart Staniford, president of Silicon Defense in Eureka, Calif., notes, however, that if the zombie computers “had a long target list and a control mechanism to allow dynamic retargeting, [they] could have DDoSed servers used to map addresses to contact information, the ones used to distribute patches, the ones belonging to companies that analyze worms or distribute incident response information.[…]”"
                                            },
                                            {
                                                "example_id": "b463a31d-e5ff-49f7-9eb6-3c50f042e97a",
                                                "sense_id": "30612d4c-7fe3-396d-b877-342f3aa2dd3f",
                                                "text": "On February 9, 2000, web sites such as Yahoo! and CNN were DDoSed off the Internet, mostly by spoofed smurf attacks."
                                            },
                                            {
                                                "example_id": "85a750f5-3655-4c50-8ab5-10588bf05be9",
                                                "sense_id": "30612d4c-7fe3-396d-b877-342f3aa2dd3f",
                                                "text": "The system got DDoSed (knocked out of commission by many distributed denial of service attacks), many lawsuits were threatened, and at one point power was even mysteriously lost to the facility, bringing the list down for days (and causing many network interruptions in the process)."
                                            },
                                            {
                                                "example_id": "86504624-b39e-4343-87e7-73021f55fd7d",
                                                "sense_id": "30612d4c-7fe3-396d-b877-342f3aa2dd3f",
                                                "text": "In posts on his account, Hunt gave further details on the timeline, including contacting the Internet Archive about the breach on October 6th and moving forward with the disclosure process to today, when the site was defaced and DDoS’d at the same time they were loading the data into HIBP to begin notifying affected users."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
