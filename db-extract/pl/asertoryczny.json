                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assertoric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e05d058c-0fd5-3990-a817-2a87d7237e96",
