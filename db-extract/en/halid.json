                    {
                        "sense_id": "41430683-52aa-3958-a4b5-a34659353556",
                        "entry_id": "06221809-63ff-3d5f-b107-91dc5b675691",
                        "glosses": [
                            "Archaic form of halide."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d56111c4-ead5-419b-b7bf-3bb3036243a9",
                                "sense_id": "41430683-52aa-3958-a4b5-a34659353556",
                                "text": "These compounds,^([the alkyl halids]) also known as halid anhydrids, are the halogen compounds of the acidyls."
                            },
                            {
                                "example_id": "18f5277c-ed3e-4cd0-9a0b-7fae36dc1696",
                                "sense_id": "41430683-52aa-3958-a4b5-a34659353556",
                                "text": "The process of liquid separation of solids, which consists in separating the solids in a liquid which is the halid of a metal, whose halids are volatilizable, conveying the separated ingredients produced by the separation from the liquid and subjecting the same to a heat sufficient to volatilize, and adding to the liquid a halid of ammonia prior to said volatilization."
                            },
                            {
                                "example_id": "cd99b8d1-e36a-47cf-9fb6-462cc29b184d",
                                "sense_id": "41430683-52aa-3958-a4b5-a34659353556",
                                "text": "All the mercury halids show a great tendency toward the formation of complex ions of this same type with the halids of other metallic elements."
                            }
                        ]
                    }
                ],
