                "senses": [
                    {
                        "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                        "entry_id": "122fd0ab-e829-30f8-8750-b69133be111b",
                        "glosses": [
                            "Hauptverkehrsstraße im Berliner Bezirk Charlottenburg-Wilmersdorf und einer der touristischen Anlaufpunkte in Berlin, regional und umgangssprachlich als Kudamm, Kuhdamm oder auch Bulettenboulevard bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1894fb4-ae3b-4c68-8d67-657f09c8456a",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "„Der Breitscheidplatz liegt in Charlottenburg im Berliner Bezirk Charlottenburg-Wilmersdorf zwischen Kurfürstendamm, Budapester Straße und Tauentzienstraße.“"
                            },
                            {
                                "example_id": "2e47fd78-b3c9-446f-9d7c-439c8a4a5f8c",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "„1542 begann Joachim II. mit dem Bau des Jagdschlosses ‚Zum grünen Walde‘ und ließ einen Dammweg vom Berliner Stadtschloss dorthin errichten. Dieser ursprüngliche Dammweg sollte später Kurfürstendamm genannt werden und Jahrhunderte danach in ganz anderer Gestaltung Weltruhm erlangen.“"
                            },
                            {
                                "example_id": "0f3192ac-bb4d-4e12-9af7-142aef2f8329",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "„Es gab da die jüdische Dichterin Else Lasker-Schüler, die als arabischer Prinz kostümiert über den Kurfürstendamm spazierte; in ihren Texten verwandelte sie sich in Yusuf, den Flötenspieler.“"
                            },
                            {
                                "example_id": "d22eabd7-ad2b-4038-9f9d-45a693e280ce",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "Der Kurfürstendamm ist einen halben Kilometer lang."
                            },
                            {
                                "example_id": "6782dc0c-6633-4ffc-9e7c-2d530f6d4c22",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "Familie Mustermann wohnt im Kurfürstendamm 66."
                            },
                            {
                                "example_id": "30a14ab2-8343-4833-bdef-f627493f2aed",
                                "sense_id": "82fd6c2b-235b-349c-8d85-4b09c30da73b",
                                "text": "Der Kurfürstendamm ist wegen Bauarbeiten gesperrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
