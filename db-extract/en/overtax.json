                    },
                    {
                        "sense_id": "ee988209-ca44-318f-9334-bfbb858e282e",
                        "entry_id": "edb6adca-8587-3d6a-9c06-5788cd530c6b",
                        "glosses": [
                            "To overburden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c8984a-64f6-4d52-ae32-62343fdf5e98",
                                "sense_id": "ee988209-ca44-318f-9334-bfbb858e282e",
                                "text": "The overtaxed shaft snapped."
                            },
                            {
                                "example_id": "0ebc534c-f5dc-4163-b8ee-d4550ea91f72",
                                "sense_id": "ee988209-ca44-318f-9334-bfbb858e282e",
                                "text": "Again, that lonely taper, how often is it the companion and sign of studies for which the day is too short—studies that steal the gloss from the sunny hair, and the light from the over-taxed eye!"
                            },
                            {
                                "example_id": "e346be03-dc01-432d-8ede-227912690684",
                                "sense_id": "ee988209-ca44-318f-9334-bfbb858e282e",
                                "text": "The 310-mile Tokaido line is being built from Tokyo to Osaka, through the most densely populated and heavily industrialised area of the country, to relieve the existing 340-mile 3ft 6in gauge line, which is overtaxed by continually increasing traffic."
                            }
                        ]
                    }
