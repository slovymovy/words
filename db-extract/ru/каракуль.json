                    },
                    {
                        "translation_id": "b1547ea0-6255-4824-a267-70798e120fef",
                        "source_entry_id": "86495cdf-f260-363b-a1e5-2ba30fecf998",
                        "source_sense_id": "696b858f-2cce-35fc-8764-a859f12e721a",
                        "target_lang_word": "astrakan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astrakan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "470ce1ca-4113-33ba-acde-6ed870109159",
                                        "entry_id": "6fbb86bf-3fec-37cc-8c0a-d69361fdc61e",
                                        "glosses": [
                                            "Fourrure d’agneau caracul à laine frisée, mort-né, ou abattu très jeune."
                                        ],
                                        "tags": [
                                            "Zootechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5164744a-b728-4348-9e3f-8156aad735e2",
                                                "sense_id": "470ce1ca-4113-33ba-acde-6ed870109159",
                                                "text": "Un bonnet d’astrakan."
                                            },
                                            {
                                                "example_id": "83a813b3-4724-4f3b-be71-a14e5a946063",
                                                "sense_id": "470ce1ca-4113-33ba-acde-6ed870109159",
                                                "text": "À sa mère : – « Viens plutôt nous voir l’hiver. – Pourquoi l’hiver ? – À cause de ton astrakan. Ça nous posera. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c21f584-5b95-3914-9410-944c2860c373",
                                        "entry_id": "6fbb86bf-3fec-37cc-8c0a-d69361fdc61e",
                                        "glosses": [
                                            "Tissu qui imite le toucher de cette fourrure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e018c472-6c3c-4689-8b59-1c1671b3c45d",
                                                "sense_id": "2c21f584-5b95-3914-9410-944c2860c373",
                                                "text": "Les fils de mohair seuls ou mélangés […] servent à la production d’étoffes très jolies […] ; mais c’est surtout dans les tissus zibelinés et satinés, dans la peluche, le velours d’Utrecht, l’astrakan, l’alpaga, les articles moirés, que se révèlent les qualités de brillant et de soyeux de cette fibre textile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd9288a7-3657-429d-834b-14086326a776",
                        "source_entry_id": "86495cdf-f260-363b-a1e5-2ba30fecf998",
                        "source_sense_id": "696b858f-2cce-35fc-8764-a859f12e721a",
                        "target_lang_word": "caracul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caracul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72857322-37e5-39ac-91cb-d7098e2e200e",
                                        "entry_id": "1c611dfd-1066-321e-be59-318a85e5f0b6",
                                        "glosses": [
                                            "Race de mouton d’Asie centrale élevé pour sa fourrure et dont les agneaux à la toison bouclée fournissent l’astrakan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbef001e-6659-45c1-8803-6d1aa6db00a9",
                                                "sense_id": "72857322-37e5-39ac-91cb-d7098e2e200e",
                                                "text": "Il était en astrakan, c’est à dire en agneau caracul tué très jeune pour ses poils bouclés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd877bb3-4d89-3d9d-8dea-a778bb0257c2",
                                        "entry_id": "1c611dfd-1066-321e-be59-318a85e5f0b6",
                                        "glosses": [
                                            "Fourrure de cet animal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67976ea1-6e3a-4629-ba1d-74d16afad8cd",
                                                "sense_id": "cd877bb3-4d89-3d9d-8dea-a778bb0257c2",
                                                "text": "Avec le petit paletot droit en caracul, deux chapeaux et la lingerie, il y en avait, s’il vous plaît, pour quinze cent francs."
                                            },
                                            {
                                                "example_id": "01c019eb-3ffe-4f25-9944-b9be959474c8",
                                                "sense_id": "cd877bb3-4d89-3d9d-8dea-a778bb0257c2",
                                                "text": "Un jour Kiki la cocotte demande à Coco le concasseur de cacao de lui offrir un caraco kaki avec un col de caracul. Coco le concasseur de cacao voulut bien offrir à Kiki la cocotte le caraco kaki mais sans col de caracul. Or vint un coquin qui conquit le cœur de Kiki la cocotte. Il offrit à Kiki la cocotte le caraco kaki avec le col de caracul ! Conclusion : Coco le concasseur de cacao fut cocu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
