                        "examples": [
                            {
                                "example_id": "16d4a4d8-47f5-433e-99f3-5ad3cda4f737",
                                "sense_id": "db209a8f-d830-35be-bffe-fae3c1aefeb1",
                                "text": "Der Unterricht war nach den Osterferien in diesem Schuljahr am 2. April wieder aufgenommen worden, einen Tag später versammelten sich die neuen Sextaner der Lichtwarkschule zu einer kleinen Aufnahmefeier in dem am Rande des Stadtparks gelegenen, prachtvollen Schulgebäude in Hamburg-Winterhude."
                            }
                        ]
                    }
