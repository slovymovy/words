                "senses": [
                    {
                        "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                        "entry_id": "a5e8fb3e-4970-3283-8c21-bda3e3b822ad",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b4623a-9a5c-484a-bf8d-45d560c565cb",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Frau Bauchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4d7211b-e399-4226-aba5-e12d2032176e",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Herr Bauchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dc611838-f087-476b-87ed-d85f8d536764",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Die Bauchles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "d8442ba7-5989-4269-84d6-18d256ba8001",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Der Bauchle trägt nie die Pullover, die die Bauchle ihm strickt."
                            },
                            {
                                "example_id": "658ce8b1-99d6-4f59-8d4c-7255dc1aa9f9",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bauchle kommt, geht der Herr Bauchle.“"
                            },
                            {
                                "example_id": "b105c91a-c874-4d59-9b91-07c4494a726e",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Bauchle kommt und geht."
                            },
                            {
                                "example_id": "695577c9-9407-42e2-8eab-ff628c3a8c33",
                                "sense_id": "a75894cb-c153-39d5-940c-39306e84746f",
                                "text": "Bauchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
