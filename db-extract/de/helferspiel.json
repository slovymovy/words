                "senses": [
                    {
                        "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                        "entry_id": "290027a8-2318-32d9-932d-eb549b89e135",
                        "glosses": [
                            "Spielart, bei der das Miteinander, die Kooperation, gegenseitiges Unterstützen das Spielgeschehen bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e15ab2-d10d-4481-bd43-5c69f11af9d6",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„Aber auch für den sozialen Bereich wurden Materialien entwickelt wie das Helferspiel von Tausch und Tausch, in dem zu abgebildeten Konfliktsituationen sogenannte Helferkärtchen vergeben werden.“"
                            },
                            {
                                "example_id": "466398da-e3c6-4854-a89b-6fa881193765",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„Im Mittelpunkt der sogenannten ‚New Games’, der ‚Neuen Spiele’, der ‚Alternativen Spiele’, der ‚Kooperativen Spiele’, der ‚Helferspiele’, der ‚Spiele ohne Tränen’, der ‚Spiele ohne Sieger und Verlierer’ sollten Kommunikation und Kooperation stehen.“"
                            },
                            {
                                "example_id": "fa84a0fe-3861-41bc-9ec4-6167c4b521c1",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„Wie wäre ein Helferspiel für einen Vormittag?“"
                            },
                            {
                                "example_id": "d235dcc5-7359-4fc6-8d74-84801a929699",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„Das Helferspiel ist anders als die traditionellen Kinderspiele, denn hier gibt es statt Siegern und Besiegten ein wirkliches Zusammenspiel.“"
                            },
                            {
                                "example_id": "5cc96dd6-d7c0-4684-b0ae-6e0e008b3c12",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„Der Spieler gibt in einem Helferspiel auf der sozialen Ebene zu verstehen, daß er Hilfe benötigt, auf der psychologischen Ebene würde er sagen, daß er sich nicht helfen läßt.“"
                            },
                            {
                                "example_id": "23034276-e8ae-4f5f-a5b7-9d177e5bb238",
                                "sense_id": "a2e9a451-6d87-3675-8fe7-8e9880c17b12",
                                "text": "„1975 wurden vom Verlag Maier Ravensburg die ersten kooperativen Spiele als Spiele neuer Art vermarktet: Vertragen und nicht schlagen und das Helferspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
