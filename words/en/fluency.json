{
    "word_family": [
        "fluent",
        "fluently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87679316-948e-3e60-be61-a8a0d71e0544",
                    "sense_definition": "The ability to speak or write a language easily and accurately.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "language_skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She achieved <w>fluency</w> in Spanish after living in Madrid for two years.",
                            "target_lang_translations": {
                                "ru": "Она достигла <w>свободного владения</w> испанским языком, прожив в Мадриде два года."
                            }
                        },
                        {
                            "text": "The job requires professional <w>fluency</w> in both English and French.",
                            "target_lang_translations": {
                                "ru": "Работа требует профессионального <w>свободного владения</w> английским и французским языками."
                            }
                        }
                    ],
                    "synonyms": [
                        "proficiency"
                    ],
                    "common_phrases": [
                        "achieve fluency",
                        "native fluency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность говорить или писать на языке легко и грамотно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свобо́дное владе́ние",
                                "target_lang_sense_clarification": "использование языка на высоком уровне"
                            },
                            {
                                "target_lang_word": "бе́глость",
                                "target_lang_sense_clarification": "способность говорить без запинок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "733b8946-f4e7-3396-8e2c-536ba324e2a0",
                    "sense_definition": "The ability to perform a task smoothly and skillfully without needing to think about every step.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played the complex piece with remarkable <w>fluency</w> and grace.",
                            "target_lang_translations": {
                                "ru": "Пианист исполнил сложное произведение с удивительной <w>беглостью</w> и изяществом."
                            }
                        },
                        {
                            "text": "The team struggled to find their <w>fluency</w> during the first half of the game.",
                            "target_lang_translations": {
                                "ru": "Команде было трудно обрести <w>слаженность</w> в первой половине игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "ease",
                        "smoothness"
                    ],
                    "antonyms": [
                        "awkwardness"
                    ],
                    "common_phrases": [
                        "find fluency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность выполнять задачу плавно и умело, не задумываясь о каждом шаге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бе́глость",
                                "target_lang_sense_clarification": "легкость и быстрота выполнения действий"
                            },
                            {
                                "target_lang_word": "пла́вность",
                                "target_lang_sense_clarification": "отсутствие резких переходов или затруднений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27f107d4-1ce5-3c4b-a080-cacba29b3f4c",
                    "sense_definition": "The quality of moving or flowing in a smooth, continuous way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer moved with a natural <w>fluency</w> that captivated the entire audience.",
                            "target_lang_translations": {
                                "ru": "Танцор двигался с естественной <w>плавностью</w>, которая очаровала всю аудиторию."
                            }
                        },
                        {
                            "text": "The architect designed the building to emphasize the <w>fluency</w> of the curved lines.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал здание так, чтобы подчеркнуть <w>плавность</w> изогнутых линий."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluidity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество движения или течения в плавном, непрерывном виде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пла́вность",
                                "target_lang_sense_clarification": "непрерывность и грациозность движения"
                            },
                            {
                                "target_lang_word": "теку́честь",
                                "target_lang_sense_clarification": "свойство линий или форм плавно переходить одна в другую"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}