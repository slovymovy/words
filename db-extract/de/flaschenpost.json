                        "cross_references": [
                            {
                                "target_word": "message in a bottle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b5186b-53d4-36a0-bd4e-468465f3174c",
                                        "entry_id": "f2d0fcc0-5521-38e4-a662-e57a2bd8f5ef",
                                        "glosses": [
                                            "A message written on a scrap of paper, rolled up and put in an empty bottle and set adrift on the ocean; traditionally, a method used by castaways to advertise their distress to the outside world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9d9eda1-6000-48eb-b63b-fa2c24778dca",
                                                "sense_id": "02b5186b-53d4-36a0-bd4e-468465f3174c",
                                                "text": "I'll send an SOS to the world / I hope that someone gets my / Message in a bottle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456580ab-5ad0-32fa-a7ee-29d483bdf17f",
                                        "entry_id": "f2d0fcc0-5521-38e4-a662-e57a2bd8f5ef",
                                        "glosses": [
                                            "An analogous message sent off into the world or universe without knowledge of who the recipient will be: plaques on craft launched into outer space, interstellar radio messages, stationary time capsules, balloon mail, and so on."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993b7683-98d0-4664-abd8-f5a16acccd01",
                                                "sense_id": "456580ab-5ad0-32fa-a7ee-29d483bdf17f",
                                                "text": "'Cause you could be the one that I love, oh, oh, oh / I could be the one that you dream of, of, of / A message in a bottle is all I can do-oo / Standin' here, hopin' it gets to you"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "340993ed-826d-4ffc-9c2b-200771e5af21",
                        "source_entry_id": "df21612a-1e0f-3dff-8d60-55873b674741",
                        "source_sense_id": "d4fda4d6-e16f-3291-b60e-7ee0bb298a87",
