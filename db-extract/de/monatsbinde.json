                        "source_entry_id": "52e3b95b-7802-3599-b700-7d35e02c44c3",
                        "source_sense_id": "0257c42c-5e77-39b4-b290-ef168d96a4f7",
                        "source_sense_description": "aus saugfähigen Materialien bestehende Einlage für die Unterhose zur Aufnahme des Menstruationsblutes",
                        "target_lang_word": "serviette hygiénique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serviette hygiénique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "faa9f6cd-0d34-3887-ba2c-2d066ca6355b",
                                        "entry_id": "231f1a4e-c723-3a5a-8f7b-8cffe81b12dc",
                                        "glosses": [
                                            "Petite couche absorbante que les personnes menstruées placent à l’intérieur de leurs sous-vêtements lors des menstruations afin d’absorber le sang qui s’écoule alors de la vulve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585616e3-0ed5-4b56-b32c-3c6cb9f9dd46",
                                                "sense_id": "faa9f6cd-0d34-3887-ba2c-2d066ca6355b",
                                                "text": "Les tampons, serviettes hygiéniques et autres produits seraient offerts de façon anonyme dans quatre types d’établissements: les lieux d’enseignements publics et privés, les édifices gouvernementaux, les refuges et les prisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7fbdcc-14b3-393a-bc56-6716b1204b5d",
                                        "entry_id": "231f1a4e-c723-3a5a-8f7b-8cffe81b12dc",
                                        "glosses": [
                                            "Serviette utilisée pour les soins du visage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d04ddae6-1c5c-4b92-af02-55f876cfc7d1",
                                                "sense_id": "bc7fbdcc-14b3-393a-bc56-6716b1204b5d",
                                                "text": "La serviette hygiénique conserve au teint sa fraîcheur, efface les rides, donne du velouté a la peau, parfume et la rend antiseptique; préserve du hile, de l'acné, des dartres, rugosités, boutons et éruptions dé toute sortes, et est indispensable à toute personne qui voyage."
                                            },
                                            {
                                                "example_id": "23e55cf1-419d-417f-ad41-8308c66b2f5c",
                                                "sense_id": "bc7fbdcc-14b3-393a-bc56-6716b1204b5d",
                                                "text": "N’employez, pour les soins du visage, que la « serviette hygiénique » approuvée par les autorités médicales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
