                        "examples": []
                    },
                    {
                        "sense_id": "8440d5f5-c5f1-32c0-9d3e-4894026628a9",
                        "entry_id": "5da09330-7ed9-3a92-ab1a-9ca6eb32520e",
                        "glosses": [
                            "An association or institution for the advancement of learning, particularly in science or literature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e77109d-92ca-4f14-b931-3b77b6fa74c1",
                                "sense_id": "8440d5f5-c5f1-32c0-9d3e-4894026628a9",
                                "text": "A panel of architects who might loosely be described as the local athenaeum of their profession are awaiting, anxiously, the next edition of the bimonthly journal that bears their names."
                            }
                        ]
                    },
                    {
                        "sense_id": "1eed9986-5b2c-3379-818f-ee78418fa199",
                        "entry_id": "5da09330-7ed9-3a92-ab1a-9ca6eb32520e",
                        "glosses": [
                            "The reading room or library of such an association; (by extension) any reading room or library."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb4e73a-9835-4451-ba23-3cbba22a6a5d",
                                "sense_id": "1eed9986-5b2c-3379-818f-ee78418fa199",
                                "text": "And this, too, may have been not unconnected with the gracious influence of the other sex as exhibited in a neighbouring athenaeum; and was accompanied by a gruesome spate of florid lyrics: some (happily) secret, and some exposed with needless hardihood in a college magazine."
                            }
                        ]
                    },
                    {
                        "sense_id": "3639e589-7afe-37ac-9b5b-295080663dbd",
                        "entry_id": "5da09330-7ed9-3a92-ab1a-9ca6eb32520e",
                        "glosses": [
                            "A literary or scientific periodical, especially one similar to the London Athenaeum."
                        ],
                        "tags": [],
                        "examples": []
                    }
