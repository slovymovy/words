                        "source_sense_id": "1373839b-08f9-34d9-80a5-b1faa9ed3b84",
                        "source_sense_description": "schnelle, überstürzende Entwicklung im Bereich der Kultur",
                        "target_lang_word": "культурная революция",
                        "target_lang_code": "ru",
