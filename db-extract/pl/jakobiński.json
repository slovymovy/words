                                        "sense_id": "5f010204-373a-3639-8160-cf27edf0f9b5",
                                        "entry_id": "3ff7c274-acdc-3b42-9705-ed07dea21fce",
                                        "glosses": [
                                            "A member of the Jacobin Club, a radical political club prominent during the French Revolution."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e44b73a-c35e-4448-91d0-b0aede1eb527",
                                                "sense_id": "5f010204-373a-3639-8160-cf27edf0f9b5",
                                                "text": "The Jacobins acted as a left-of-centre parliamentary pressure group, spending much of their time in coordinating the following day's business in the Assembly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b5247e1-4dfd-36f1-825b-ec7f7aa5b95f",
                                        "entry_id": "3ff7c274-acdc-3b42-9705-ed07dea21fce",
                                        "glosses": [
                                            "A sympathizer or supposed sympathizer with the French political club or its aims of democracy and social equality."
                                        ],
                                        "tags": [
