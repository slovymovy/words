                "senses": [
                    {
                        "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                        "entry_id": "751a4de4-5f3e-333d-9736-c32be969d700",
                        "glosses": [
                            "der letzte Abend des Jahres am 31. Dezember"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ee5027-eae8-428c-9a6c-1ab91e05d1cf",
                                "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                                "text": "Am Silvesterabend gibt es jedes Jahr Fondue."
                            },
                            {
                                "example_id": "1a02c356-2a02-480e-b679-f39b1210c9b9",
                                "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                                "text": "„Vielleicht ist sie am Silvesterabend einfach durchgedreht, weil sie zu elend und verängstigt war, um auf die Party zu gehen, zu der sie eingeladen war, und zu elend und verängstigt, um allein zu sein.“"
                            },
                            {
                                "example_id": "082a89cd-b333-4b80-ae01-fdbe4bb372b2",
                                "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                                "text": "„An Silvesterabend gehen wir früh ins Bett.“"
                            },
                            {
                                "example_id": "4d54681a-6056-4c22-9fd4-16bfcefc2f65",
                                "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                                "text": "„Der Kremlherr verbrachte den Silvesterabend in seiner Datscha bei Kunzewo, 32 Kilometer von Moskau entfernt.“"
                            },
                            {
                                "example_id": "a76ac579-0114-4b54-a24f-11a814cfd028",
                                "sense_id": "b6dad10c-1a2f-3dec-a55f-f04e3106c3d3",
                                "text": "„Zum erstenmal seit Jahren hat Remarque den Silvesterabend 1951 allein verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
