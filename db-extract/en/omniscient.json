                    {
                        "translation_id": "a015099e-6fa8-4c00-95f2-64610f95ac87",
                        "source_entry_id": "e498161d-7791-30a6-b4f1-732cb4a4d38f",
                        "source_sense_id": "61f5876f-42f2-38a1-9923-bf1ae76e55ca",
