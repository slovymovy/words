                "senses": [
                    {
                        "sense_id": "2bbbb473-82ab-3a9d-bb73-1ed229126973",
                        "entry_id": "a69afdde-aeb3-3aff-bd5e-91207b256011",
                        "glosses": [
                            "To backtrack along a trail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff63c9f2-a96a-4d15-9499-cf1ed02c4902",
                                "sense_id": "2bbbb473-82ab-3a9d-bb73-1ed229126973",
                                "text": "If they didn't, they would then have to backtrail to try to pick it up"
                            },
                            {
                                "example_id": "acff5ed1-9048-4033-a3a5-f4323dd881b0",
                                "sense_id": "2bbbb473-82ab-3a9d-bb73-1ed229126973",
                                "text": "He reshouldered his rifle. \"Want to backtrail with me?\""
                            },
                            {
                                "example_id": "f7f82aeb-9c8f-45fb-9236-1915fe4de77a",
                                "sense_id": "2bbbb473-82ab-3a9d-bb73-1ed229126973",
                                "text": "I hoped Carson knew where he was going, because there was no room to backtrail here."
                            }
                        ]
                    }
