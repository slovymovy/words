                    {
                        "sense_id": "9a02541a-4f68-3124-864c-58ee79061cd5",
                        "entry_id": "717bbc2f-5986-3b7f-a8bc-18d443a61cae",
                        "glosses": [
                            "A bundle carried by a hobo (usually containing his possessions), often on a stick slung over the shoulder; a blanket roll."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7ddb7c95-626b-4514-b3e6-1ffd76ac9364",
                                "sense_id": "9a02541a-4f68-3124-864c-58ee79061cd5",
                                "text": "[L]astly he made a bindle in a plastic tarp of some cans of juice and cans of fruit and cans of vegetables […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "3eb5a35e-5a69-3e22-b415-4d8065c7b619",
                        "entry_id": "717bbc2f-5986-3b7f-a8bc-18d443a61cae",
                        "glosses": [
                            "Any bundle or package; specifically one containing narcotics such as cocaine, heroin, or morphine."
                        ],
