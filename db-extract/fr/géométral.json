                "senses": [
                    {
                        "sense_id": "4767df1a-a1d6-38c4-8d71-925d58c8b357",
                        "entry_id": "d359cf39-a14f-35c5-85ce-35bb4de6791c",
                        "glosses": [
                            "Qui restitue les formes et distances réelles, mais ne tient pas compte de la perspective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249c0a7e-b17b-49d6-a40b-f02e41eb839c",
                                "sense_id": "4767df1a-a1d6-38c4-8d71-925d58c8b357",
                                "text": "Toutes ces positions sont indiquées que le plan géométral dressé par l’ingénieur du cadastre et joint aux pièces."
                            },
                            {
                                "example_id": "179ca25a-cf6c-4dbf-8d9d-b4862489fb10",
                                "sense_id": "4767df1a-a1d6-38c4-8d71-925d58c8b357",
                                "text": "Quelque chose de ce plan géométral subsiste encore aujourd’hui."
                            },
                            {
                                "example_id": "f2f8c875-4d41-4da4-b700-cc320bd00b45",
                                "sense_id": "4767df1a-a1d6-38c4-8d71-925d58c8b357",
                                "text": "Elle se débattait parmi les angles visuels et les cônes optiques. Un observateur idéal, dont l’œil était placé en O, la terrorisait. Ce monstre sans chair posait ses pieds sans poids sur le plan géométral G. À travers un plan vertical T, qu’on pouvait imaginer comme une vitre, son œil sans pupille regardait."
                            }
                        ]
                    }
