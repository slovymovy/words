                        "glosses": [
                            "een ruimte waar men zich omkleden kan, zoals bij sport, toneel e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328aa28a-a317-45ce-9d93-203235019614",
                                "sense_id": "50e6c50b-affb-3c0f-bec2-cfd6e2b8815a",
