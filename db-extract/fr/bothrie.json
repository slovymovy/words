                    {
                        "sense_id": "5a52f6a7-3b8d-3ed3-9683-b01c31586538",
                        "entry_id": "2ba270d1-d5ff-34eb-b024-75a22d466354",
                        "glosses": [
                            "Fausse ventouse consistant en une fente longitudinale munie de muscles lisses en paires dans le scolex (ou tête) des cestodes de l'ordre des Pseudophyllidea, et qui permet l'attachement du ver à son hôte par pincement du tissu servant d'ancrage chez ce dernier."
                        ],
                        "tags": [
                            "Helminthologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0f1dc79c-54e5-4131-a73b-8dc02a3e5727",
                                "sense_id": "5a52f6a7-3b8d-3ed3-9683-b01c31586538",
                                "text": "La bothrie se distingue de la bothridie en ce que cette dernière est une ventouse véritable effectuant une suction permettant la fixation du ver à son hôte, présente chez l'ordre des Tetraphyllidea, tandis que la bothrie n'exerce pas de suction, mais plutôt un pincement du point d'ancrage sur l'hôte des cestodes qui en sont pourvus, lesquels appartiennent à l'ordre des Pseudophyllidea."
                            }
                        ]
                    }
                ],
