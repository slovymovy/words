                                        "glosses": [
                                            "Gelb-Schwarzer Singvogel der Art Oriolus oriolus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45869e05-e0db-4d56-afae-542f6d0172e7",
                                                "sense_id": "24098d93-19d6-39a8-bfb4-0fe1c97953a8",
                                                "text": "Der Pirol ruft im grünen Hag,…"
                                            },
                                            {
                                                "example_id": "b22581f2-6783-4f58-86c6-7cd1a251d4f5",
                                                "sense_id": "24098d93-19d6-39a8-bfb4-0fe1c97953a8",
                                                "text": "„Ein Pirol flötete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7f92360-5cf5-3e96-a0b5-946471fe2d47",
