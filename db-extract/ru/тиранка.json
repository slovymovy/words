                "senses": [
                    {
                        "sense_id": "8f20d69e-1d8f-3257-a171-6353f34ca850",
                        "entry_id": "5384d22a-67b9-3ecb-be31-56dbed89bc1f",
                        "glosses": [
                            "female tyrant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0691eceb-f4cc-4ddd-bd98-c3ba843e723f",
                                "sense_id": "8f20d69e-1d8f-3257-a171-6353f34ca850",
                                "text": "В припа́дке соверше́нного отча́яния на́чал я наконе́ц борьбу́ и принялся́ из всех сил тяну́ть к себе́ свою́ со́бственную ру́ку, но тира́нка моя́ была́ гора́здо меня́ сильне́е.",
                                "translation": "In utter despair I began at last struggling with her, trying with all my might to pull away my hand, but my persecutor was much stronger than I was.",
                                "english": "In utter despair I began at last struggling with her, trying with all my might to pull away my hand, but my persecutor was much stronger than I was."
                            }
                        ]
                    }
                ],
