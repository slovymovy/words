                "senses": [
                    {
                        "sense_id": "5a090799-7fe5-323f-aba0-bdcadec4bb66",
                        "entry_id": "376e56b3-591b-341e-b43f-ffba9a3708bd",
                        "glosses": [
                            "Stiefel, die bei der Arbeit getragen werden, Teil einer Arbeitskleidung sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c9b1d9e-643c-4a6d-9ab5-53afe449802d",
                                "sense_id": "5a090799-7fe5-323f-aba0-bdcadec4bb66",
                                "text": "„Eine haarige Hand rafft die Schleppe, unter der schmutzige Arbeitsstiefel zu sehen sind.“"
                            },
                            {
                                "example_id": "db1a7cce-ed76-4c82-afe4-72a41ffd368b",
                                "sense_id": "5a090799-7fe5-323f-aba0-bdcadec4bb66",
                                "text": "„Der Mann, noch immer fuchtelnd, schritt auf ihn zu, seine Arbeitsstiefel lautlos auf einer Schicht aus Kiefernnadeln, das einzige Geräusch auf der Lichtung das blecherne Klappern der auspendelnden Eimer am Karren.“"
                            }
                        ],
