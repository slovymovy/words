                ],
                "senses": [
                    {
                        "sense_id": "bc941505-a947-39ac-b2ac-c9cbeb0393df",
                        "entry_id": "af6ff27d-60f6-3271-b9c2-6d429f8b4d74",
                        "glosses": [
                            "разг., шутл. человек, много читающий, любитель книг, всегда сидящий за книгами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b61828e-09d0-41b7-b072-b59f81892869",
                                "sense_id": "bc941505-a947-39ac-b2ac-c9cbeb0393df",
                                "text": "Он ведь сумасшедший книжник, страстный библиофил."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9aad3d2-1f8e-34c9-bd18-66ef8c9292f8",
                        "entry_id": "af6ff27d-60f6-3271-b9c2-6d429f8b4d74",
                        "glosses": [
                            "разг. работник книжной торговли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e95a4d-1ffe-4c6b-9aed-96f60b7f1147",
                                "sense_id": "b9aad3d2-1f8e-34c9-bd18-66ef8c9292f8",
                                "text": "Вышел в фойе, сидит старик книжник. Купил у него «Одиссею» в переводе Жуковского."
                            }
                        ]
                    },
                    {
                        "sense_id": "558e39a6-fdab-312e-a9a4-5857695e9aae",
                        "entry_id": "af6ff27d-60f6-3271-b9c2-6d429f8b4d74",
                        "glosses": [
                            "старин. начётчик, знаток священных книг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ecba041-2825-45f4-969f-86424a93d334",
                                "sense_id": "558e39a6-fdab-312e-a9a4-5857695e9aae",
                                "text": "Он был книжник, сведущий в законе Моисеевом, который дал Господь Бог Израилев."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5f990c7-c5a1-354c-8c28-3cb309e06d83",
                        "entry_id": "af6ff27d-60f6-3271-b9c2-6d429f8b4d74",
                        "glosses": [
                            "старин. бумажник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87baa34-6c99-4d82-b3f6-7d2e2eb20401",
                                "sense_id": "d5f990c7-c5a1-354c-8c28-3cb309e06d83",
                                "text": "Только что разошлись они, его превосходительство поспешно вынимают книжник и из него сторублёвую."
                            }
                        ]
                    }
                ],
