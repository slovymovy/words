                "senses": [
                    {
                        "sense_id": "fbf7c8c0-a427-3f2a-8ff1-9e87aea2456d",
                        "entry_id": "eede2754-a510-3e05-b812-f4b4812ac06e",
                        "glosses": [
                            "A solution of formaldehyde in water; used as a disinfectant and to preserve biological specimens."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bdd082ad-b68b-4d3f-b68a-cebfb3903fa6",
                                "sense_id": "fbf7c8c0-a427-3f2a-8ff1-9e87aea2456d",
                                "text": "If you failed to bathe it in the formalin solution every time, its flesh might cross the precipitous border into decay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d2d252a-9708-472e-b978-af98286964e2",
                        "source_entry_id": "eede2754-a510-3e05-b812-f4b4812ac06e",
                        "source_sense_id": "fbf7c8c0-a427-3f2a-8ff1-9e87aea2456d",
