                            {
                                "example_id": "e8f8b335-2e97-4edb-981d-3ee720051f06",
                                "sense_id": "9c3e519e-3b49-3e64-b2aa-092027f35cf8",
                                "text": "In Edmunds Haus gibt es zahllose Fotografien von Überlandleitungen zu bestaunen."
