                    {
                        "translation_id": "3f251e53-79b6-4ed1-968d-2d4996a48a53",
                        "source_entry_id": "44035460-3904-3e87-8a73-30ddf8e928dd",
                        "target_lang_word": "zone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bf3dbce-ea0f-32c9-8336-406e4efbbd0f",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Bande ou marque plus ou moins circulaire."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "342a449e-dc37-385d-bb84-614a0e197925",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Chacune des cinq grandes divisions du globe terrestre, que l’on conçoit séparées par des cercles parallèles à l’équateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1307ce8f-7459-4f7e-bea9-cd3a56cbd928",
                                                "sense_id": "342a449e-dc37-385d-bb84-614a0e197925",
                                                "text": "La zone équatoriale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30ffd2f-183d-3b23-92de-f0336cdfa4d0",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Bande claire qui traverse les disques planétaires de Jupiter et de Saturne, par opposition aux bandes, plus sombres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1cd0bbd-c106-35dc-a704-855dd24af47f",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Partie visible des couches superposées dont certains terrains, certaines pierres, sont formées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be4c4ea6-3b95-4cce-9199-ce89fc90f1d3",
                                                "sense_id": "b1cd0bbd-c106-35dc-a704-855dd24af47f",
                                                "text": "Des zones concentriques."
                                            },
                                            {
                                                "example_id": "b9b58473-f36e-4ea7-91c2-47b005d50d93",
                                                "sense_id": "b1cd0bbd-c106-35dc-a704-855dd24af47f",
                                                "text": "Dans l’onyx on voit plusieurs zones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e54a2e-50d1-357a-93fb-3543073b67b6",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Portion de la surface d’une sphère comprise entre deux plans parallèles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "480e755d-95eb-367b-8e4f-96d523bb007e",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Partie d'une mémoire (morte ou vive), distinguée par sa fonction, son appartenance, ou d'autres de ses propriétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a392427-7092-4813-bd37-b4fe4bdff0fd",
                                                "sense_id": "480e755d-95eb-367b-8e4f-96d523bb007e",
                                                "text": "Zone d'espace-disque réservé aux i-nodes, dans lesquels sont notés les positions des fichiers sur le disque."
                                            },
                                            {
                                                "example_id": "bc63ed5b-793e-4760-99d7-f47d04787007",
                                                "sense_id": "480e755d-95eb-367b-8e4f-96d523bb007e",
                                                "text": "Zone de mémoire réservée aux pilotes matériels dans le noyau."
                                            },
                                            {
                                                "example_id": "05ec9956-a348-48f6-848a-5dae6b3afc56",
                                                "sense_id": "480e755d-95eb-367b-8e4f-96d523bb007e",
                                                "text": "Zone de mémoire partagée entre un client X11 et un serveur situé sur la même machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Espace quelconque qui se distingue par un trait particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3efe086-7e62-4e91-b926-adbf87c1ba4c",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "Zone érogène."
                                            },
                                            {
                                                "example_id": "7fe7fb95-4b90-4c34-8fa7-8682779beb4a",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            },
                                            {
                                                "example_id": "fe632f68-bfbb-4233-96b3-b807a851233d",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "En réalité, au delà de l’octroi, sans interruption perceptible, s’étale une zone de grosses communes industrielles où la population est de 65 000 âmes."
                                            },
                                            {
                                                "example_id": "608fcd3f-1217-47db-a909-f536156b39d6",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "Sur les 106 Junkers et Blohm-Voss transporteurs qui avaient pris l’air dans la nuit du 16 décembre, 35 seulement avaient atteint la zone de parachutage prévue entre Eupen et Malmédy."
                                            },
                                            {
                                                "example_id": "6b58e81c-eaee-49d0-8166-9b2845760af0",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "L’autécologie des mélèzes est assez mal connue, tout du moins dans les zones où ils ont été et sont introduits comme essence de reboisement."
                                            },
                                            {
                                                "example_id": "af15db70-eeb1-4f8e-9b25-b3239dcf8d26",
                                                "sense_id": "ad32cb8e-80a9-3af0-bf4a-359736ebc8c7",
                                                "text": "Mais il a aussi la propriété de diminuer le mouvement des vagues à la surface, ce qui explique l’apaisement des flots dans cette zone qui est une aire de repos pour les bateaux en difficulté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdaad133-2763-35e4-80aa-cb307c604cbf",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Quartier pauvre, banlieue, ceinture d’une agglomération."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463c6b6a-39cf-438e-8f1f-baf3f60221cc",
                                                "sense_id": "fdaad133-2763-35e4-80aa-cb307c604cbf",
                                                "text": "Casse-toi d’là, blaireau, t’es pas d’ma zone."
                                            },
                                            {
                                                "example_id": "52979e0a-aa36-4a1f-9487-13804efdd3ad",
                                                "sense_id": "fdaad133-2763-35e4-80aa-cb307c604cbf",
                                                "text": "Ils vécurent dans une grande misère sur la barrière de Clichy, qu’on appelait alors « la zone »."
                                            },
                                            {
                                                "example_id": "ce47b264-d600-4d14-9658-ddc45c12569b",
                                                "sense_id": "fdaad133-2763-35e4-80aa-cb307c604cbf",
                                                "text": "– Ce qu’on appelle la Zone, m’explique Lélia, était à l’origine un grand terrain vague qui encerclait Paris. Une zone de tir… réservée au canon pour l’artillerie française. Non aedificandi. Mais y poussa peu à peu toute la pauvreté des rejetés de la capitale, des misérables hugoliens, des familles aux mille enfants, tous ceux que les grand travaux du baron Haussmann avaient chassés du centre de Paris s’y entassèrent dans des baraques, dans des cabanons de bois ou des roulottes, des cahutes qui baignaient dans la boue et l’eau croupie, dans des bicoques rafistolées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4024e32d-1ff5-399d-b956-6c2ab91bd6bb",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Exprime un désordre, le bazar, le bordel."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ac39d17-ed65-45a1-96f8-13c61367f470",
                                                "sense_id": "4024e32d-1ff5-399d-b956-6c2ab91bd6bb",
                                                "text": "C’est la zone ici !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dda99791-3e1f-3136-a3a4-5a754412807c",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Partie d'un domaine ou d'un sous-domaine gérée par un serveur autoritaire."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6f20ac5-6333-4873-a4e3-29dcd0fab0db",
                                                "sense_id": "dda99791-3e1f-3136-a3a4-5a754412807c",
                                                "text": "Le domaine fr.wiktionary.org fait partie de la zone DNS wiktionary.org, et par conséquent, il n’a pas son propre SOA, tandis que le domaine wiktionary.org en a un, parce qu’il est aussi le nom d’une zone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb7f8840-6d0a-3960-99f6-271582aba22b",
                                        "entry_id": "9d84320d-35d7-3b8c-bca4-494fb1668eef",
                                        "glosses": [
                                            "Mot utilisé pour décrire l'état de concentration ultime."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c8c4f7-f00a-4bed-a821-7a6fef833166",
                                                "sense_id": "eb7f8840-6d0a-3960-99f6-271582aba22b",
                                                "text": "C'est bon, il est dans la zone, ne le perturbe pas!"
                                            }
                                        ]
                                    }
                                ]
