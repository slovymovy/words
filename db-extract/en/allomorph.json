                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "700d58a5-b87c-38b2-96e5-f91db24604f5",
                                        "entry_id": "cc22f82e-c0c6-3b28-a855-aef121352a99",
                                        "glosses": [
                                            "Variante de forme d’un même morphème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f875a878-07af-426e-9e5d-b1e8fd5d63d8",
                                                "sense_id": "700d58a5-b87c-38b2-96e5-f91db24604f5",
                                                "text": "in- (à l'oral \\ɛ̃\\) dans incorrect et i- dans illégal sont des allomorphes."
                                            },
                                            {
                                                "example_id": "f237a160-d8ef-4c9a-b61b-d7e3acd5517d",
                                                "sense_id": "700d58a5-b87c-38b2-96e5-f91db24604f5",
                                                "text": "L’allomorphe est un membre de phonème dont la position est déjà fixée, par un autre morphe qu’on appelle aussi un morphème variant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a5fc40e-e9f9-406c-8e01-49fc1edccdca",
                        "source_entry_id": "ee5edbcf-2acf-3860-a2b6-63022e70a011",
                        "source_sense_description": "phonological representation of a morpheme",
                        "target_lang_word": "Allomorph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allomorph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5252308c-736d-3f72-bc0d-9022660bc0d6",
                                        "entry_id": "94b4b199-578e-3294-ac9d-e28f28245bbe",
                                        "glosses": [
                                            "Variante der kleinsten bedeutungstragenden Einheit einer Sprache, des Morphems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd08f7d-df1f-4603-b011-fc6719ff3039",
                                                "sense_id": "5252308c-736d-3f72-bc0d-9022660bc0d6",
                                                "text": "Es gibt zum Teil phonetische Bedingungen dafür, wann welches Allomorph gesetzt werden kann (phonetisch determiniert): -st (geh-st), -est (rechn-est) und -t (heiß-t) sind phonetisch bedingte Allomorphe des Morphems „2. Person Singular“."
                                            },
                                            {
                                                "example_id": "530f2110-4b27-4ed1-8388-7134ec7d6f41",
                                                "sense_id": "5252308c-736d-3f72-bc0d-9022660bc0d6",
                                                "text": "„Ein Allomorph ist eine durch die Stellung der Morpheme im Wortganzen bedingte phonemische Variante.“"
                                            },
                                            {
                                                "example_id": "3b2c0032-a51b-4ec9-92c1-bff60b6f2ca8",
                                                "sense_id": "5252308c-736d-3f72-bc0d-9022660bc0d6",
                                                "text": "„Ein Morphem kann also unter Umständen durch mehrere verschieden lautende Allomorphe realisiert werden.“"
                                            },
                                            {
                                                "example_id": "8fd5e914-b4c9-4075-85aa-3b3a7c371ac3",
                                                "sense_id": "5252308c-736d-3f72-bc0d-9022660bc0d6",
                                                "text": "„Die kontextabhängigen lautliche Realisierungen dieses Morphems, die sogenannten Allomorphe des Pluralmorphems, leiten wir durch morphophonologische Regeln ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
