{
    "word_family": [
        "blot",
        "blotter",
        "blotchy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7eb9f236-6d37-3c83-8fa6-88ace0a32529",
                    "sense_definition": "present participle and gerund of <w>blot</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_of_blotting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was carefully <w>blotting</w> the spilled ink with a dry paper towel.",
                            "target_lang_translations": {
                                "ru": "Она осторожно <w>промакивала</w> пролитые чернила сухим бумажным полотенцем."
                            }
                        },
                        {
                            "text": "Thick clouds were rapidly <w>blotting</w> out the afternoon sun.",
                            "target_lang_translations": {
                                "ru": "Густые тучи быстро <w>заслоняли</w> дневное солнце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blotting out"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола blot: промокать, осушать или заслонять, стирать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промакивающий",
                                "target_lang_sense_clarification": "о действии впитывания излишков жидкости"
                            },
                            {
                                "target_lang_word": "промакивание",
                                "target_lang_sense_clarification": "процесс впитывания жидкости"
                            },
                            {
                                "target_lang_word": "заслоняющий",
                                "target_lang_sense_clarification": "в контексте blot out — закрывающий свет или обзор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39668830-3d58-318f-a713-f6bcfb43d52d",
                    "sense_definition": "The act or process of absorbing liquid or transferring material by blotting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "process_of_blotting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful <w>blotting</w> of the surface prevented excess liquid from damaging the canvas.",
                            "target_lang_translations": {
                                "ru": "Тщательное <w>промакивание</w> поверхности предотвратило повреждение холста излишками жидкости."
                            }
                        },
                        {
                            "text": "Southern <w>blotting</w> is a routine molecular biology method for detecting specific DNA sequences.",
                            "target_lang_translations": {
                                "ru": "Саузерн-<w>блоттинг</w> — это стандартный метод молекулярной биологии для обнаружения специфических последовательностей ДНК."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Southern blotting",
                        "Western blotting",
                        "blotting paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс промокания, впитывания жидкости или блоттинг (метод переноса макромолекул в молекулярной биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промокание",
                                "target_lang_sense_clarification": "впитывание влаги промокательной бумагой"
                            },
                            {
                                "target_lang_word": "промакивание",
                                "target_lang_sense_clarification": "действие по удалению влаги или чернил"
                            },
                            {
                                "target_lang_word": "блоттинг",
                                "target_lang_sense_clarification": "в биологии и биохимии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e775d250-e904-3393-9ec2-80aee01e2162",
                    "sense_definition": "A blot, mark, or stain on a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mark_or_stain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark <w>blottings</w> of grease disfigured the margins of the manuscript.",
                            "target_lang_translations": {
                                "ru": "Тёмные жирные <w>пятна</w> уродовали поля рукописи."
                            }
                        },
                        {
                            "text": "The artist regretted the accidental <w>blottings</w> on the delicate paper.",
                            "target_lang_translations": {
                                "ru": "Художник сокрушался из-за случайных <w>клякс</w> на тонкой бумаге."
                            }
                        }
                    ],
                    "synonyms": [
                        "blot",
                        "stain",
                        "smudge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Клякса, пятно или след на поверхности (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятно",
                                "target_lang_sense_clarification": "загрязнение на поверхности"
                            },
                            {
                                "target_lang_word": "клякса",
                                "target_lang_sense_clarification": "чернильное или жидкое пятно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}