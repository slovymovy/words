{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8eabf448-4882-37c9-bd19-67c8ca66bf71",
                    "sense_definition": "A rabbit, especially a juvenile one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>bunny</w> hopped across the green grass.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>зайчик</w> прыгал по зеленой траве.",
                                "zh": "小<w>兔子</w>蹦蹦跳跳地穿过绿色的草地。"
                            }
                        },
                        {
                            "text": "Every child looks forward to a visit from the Easter <w>bunny</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый ребенок с нетерпением ждет визита Пасхального <w>кролика</w>.",
                                "zh": "每个孩子都期待复活节<w>兔子</w>来造访。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rabbit"
                    ],
                    "common_phrases": [
                        "Easter bunny",
                        "dust bunny",
                        "bunny hop",
                        "cuddle bunny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кролик, особенно молодой или маленький; часто используется как ласковое название.",
                        "zh": "兔子，尤指幼小的兔子；也常作亲昵说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за́йчик",
                                "target_lang_sense_clarification": "ласковое название, часто используется в детской речи"
                            },
                            {
                                "target_lang_word": "кро́лик",
                                "target_lang_sense_clarification": "общее название животного"
                            },
                            {
                                "target_lang_word": "крольчо́нок",
                                "target_lang_sense_clarification": "детёныш кролика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兔子",
                                "target_lang_sense_clarification": "一般说法，可指兔子，尤指小兔子时也常用"
                            },
                            {
                                "target_lang_word": "小兔子",
                                "target_lang_sense_clarification": "强调年幼、小巧或带亲昵语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f7181a0-3719-33d1-8c9c-785e8e1fe7e4",
                    "sense_definition": "A nightclub waitress who wears a costume having rabbit ears and a tail.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She worked as a <w>bunny</w> at the famous club in the city.",
                            "target_lang_translations": {
                                "ru": "Она работала <w>банни</w> в известном городском клубе.",
                                "zh": "她在城里那家有名的俱乐部当<w>兔女郎</w>。"
                            }
                        },
                        {
                            "text": "The costume for a <w>bunny</w> usually includes satin ears and a fluffy tail.",
                            "target_lang_translations": {
                                "ru": "Костюм <w>банни</w> обычно включает атласные уши и пушистый хвост.",
                                "zh": "<w>兔女郎</w>的服装通常包括缎面的兔耳朵和毛茸茸的尾巴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bunny girl"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "associated with mid-20th century clubs"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официантка ночного клуба, носящая костюм с кроличьими ушами и хвостом.",
                        "zh": "穿着带兔耳朵和尾巴服装的夜总会女招待。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банни",
                                "target_lang_sense_clarification": "заимствование, часто о клубах Playboy"
                            },
                            {
                                "target_lang_word": "зайчик",
                                "target_lang_sense_clarification": "о девушке в костюме кролика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兔女郎",
                                "target_lang_sense_clarification": "指穿兔耳和尾巴服装的夜总会女招待"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "615a5569-b50d-3760-80e6-c5866a42da93",
                    "sense_definition": "In basketball, an easy shot close to the basket that is missed.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd groaned when he missed a <w>bunny</w> right under the hoop.",
                            "target_lang_translations": {
                                "ru": "Толпа застонала, когда он промазал <w>лёгкий мяч</w> прямо под кольцом.",
                                "zh": "当他在篮筐下连<w>空篮</w>都没投进时，观众都发出了叹息。"
                            }
                        },
                        {
                            "text": "It should have been an easy score, but he blew the <w>bunny</w>.",
                            "target_lang_translations": {
                                "ru": "Это должны были быть легкие очки, но он упустил <w>верняк</w>.",
                                "zh": "这本来应该是轻松得分，但他却失手丢了这个<w>空篮</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В баскетболе: легкий бросок из-под кольца, который часто выполняется без сопротивления.",
                        "zh": "篮球中指篮下很容易投进却没进的球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верняк",
                                "target_lang_sense_clarification": "сленг: стопроцентный момент"
                            },
                            {
                                "target_lang_word": "лёгкий мяч",
                                "target_lang_sense_clarification": "спортивный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空篮",
                                "target_lang_sense_clarification": "篮球中无人严密防守、理应投进的近距离投篮机会"
                            },
                            {
                                "target_lang_word": "轻松球",
                                "target_lang_sense_clarification": "强调很容易得分的近筐投篮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3551bc8a-a56d-3ec7-8db5-02635496b06c",
                    "sense_definition": "A snack consisting of a hollowed-out loaf of bread filled with curry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped at a street stall to buy a spicy <w>bunny</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы остановились у уличного ларька, чтобы купить острый <w>банни</w> на обед.",
                                "zh": "我们在街边摊停下来，买了一份辣味<w>班尼乔</w>当午饭。"
                            }
                        },
                        {
                            "text": "A <w>bunny</w> is a popular fast food dish in Durban.",
                            "target_lang_translations": {
                                "ru": "<w>Банни</w> — популярное блюдо фаст-фуда в Дурбане.",
                                "zh": "<w>班尼乔</w>是德班很受欢迎的一种快餐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bunny chow"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South Africa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Закуска, состоящая из выдолбленной буханки хлеба, наполненной карри (южноафриканская кухня).",
                        "zh": "一种南非小吃：把面包掏空，里面填入咖喱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банни",
                                "target_lang_sense_clarification": "сокращение от банни-чау"
                            },
                            {
                                "target_lang_word": "банни-чау",
                                "target_lang_sense_clarification": "название блюда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "班尼乔",
                                "target_lang_sense_clarification": "南非菜名，bunny chow 的音译简称"
                            },
                            {
                                "target_lang_word": "咖喱面包盅",
                                "target_lang_sense_clarification": "解释性说法，指掏空面包后填入咖喱的食物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a634c98f-02e4-358b-ba88-e708358600a5",
                    "sense_definition": "A chine or gully formed by water running over the edge of a cliff.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geological_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smugglers used the <w>bunny</w> to transport goods from the beach.",
                            "target_lang_translations": {
                                "ru": "Контрабандисты использовали <w>овраг</w> для переправки товаров с пляжа.",
                                "zh": "走私者利用这条<w>冲沟</w>把货物从海滩运上去。"
                            }
                        },
                        {
                            "text": "Rainwater rushed down the <w>bunny</w> and into the sea.",
                            "target_lang_translations": {
                                "ru": "Дождевая вода устремилась вниз по <w>оврагу</w> в море.",
                                "zh": "雨水顺着<w>冲沟</w>急流而下，汇入大海。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Hampshire and Isle of Wight"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Овраг или ущелье, образованное водой, стекающей с края обрыва (диалектизм).",
                        "zh": "由水从悬崖边冲刷形成的沟谷或冲沟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овраг",
                                "target_lang_sense_clarification": "геологическое образование"
                            },
                            {
                                "target_lang_word": "балка",
                                "target_lang_sense_clarification": "геологическое образование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲沟",
                                "target_lang_sense_clarification": "被流水冲刷形成的沟状地形"
                            },
                            {
                                "target_lang_word": "沟谷",
                                "target_lang_sense_clarification": "较书面的地貌说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78dc8659-99b7-31c6-8dc5-329f82eaf4cd",
                    "sense_definition": "Easy or unchallenging.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since it is your first time skiing, we should start on the <w>bunny</w> slope.",
                            "target_lang_translations": {
                                "ru": "Раз ты катаешься на лыжах впервые, нам стоит начать с <w>учебного</w> склона.",
                                "zh": "既然你是第一次滑雪，我们应该先从<w>初级</w>雪道开始。"
                            }
                        },
                        {
                            "text": "This level of the game is quite <w>bunny</w> compared to the final boss.",
                            "target_lang_translations": {
                                "ru": "Этот уровень игры довольно <w>лёгкий</w> по сравнению с финальным боссом.",
                                "zh": "和最终头目相比，这一关相当<w>简单</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nursery"
                    ],
                    "common_phrases": [
                        "bunny slope",
                        "bunny hill"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий, не требующий усилий или предназначенный для новичков.",
                        "zh": "容易的；没有什么挑战性的；也可指适合初学者的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учебный",
                                "target_lang_sense_clarification": "о склоне или трассе для новичков"
                            },
                            {
                                "target_lang_word": "детский",
                                "target_lang_sense_clarification": "очень легкий"
                            },
                            {
                                "target_lang_word": "лёгкий",
                                "target_lang_sense_clarification": "простой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初级的",
                                "target_lang_sense_clarification": "多指适合初学者的坡道、路线等"
                            },
                            {
                                "target_lang_word": "简单的",
                                "target_lang_sense_clarification": "一般指容易、无难度的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23599c2c-d58f-3b00-89ff-ea068d81541a",
                    "sense_definition": "Resembling a small bread roll (bun).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The texture of the cake was dense and <w>bunny</w>.",
                            "target_lang_translations": {
                                "ru": "Текстура торта была плотной и <w>похожей на кекс</w>.",
                                "zh": "这块蛋糕的口感很扎实，而且有点<w>像小圆面包的</w>感觉。"
                            }
                        },
                        {
                            "text": "These pastries look rather <w>bunny</w> and round.",
                            "target_lang_translations": {
                                "ru": "Эти пирожные выглядят довольно <w>пухлыми</w> и круглыми.",
                                "zh": "这些点心看起来相当<w>圆墩墩的</w>，而且圆圆的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bunlike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий маленькую булочку по форме или текстуре.",
                        "zh": "形状或口感像小圆面包的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похожий на булочку",
                                "target_lang_sense_clarification": "описательный перевод"
                            },
                            {
                                "target_lang_word": "пухлый",
                                "target_lang_sense_clarification": "о форме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像小圆面包的",
                                "target_lang_sense_clarification": "指外形或口感像小圆面包"
                            },
                            {
                                "target_lang_word": "圆墩墩的",
                                "target_lang_sense_clarification": "强调圆鼓鼓、像面包卷的外形"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a637d937-6911-328b-b9e5-aead5ec92298",
                    "sense_definition": "A village and civil parish in Rushcliffe borough, Nottinghamshire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the small village of <w>Bunny</w> on our way north.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через маленькую деревню <w>Банни</w> по пути на север.",
                                "zh": "我们北上的路上开车经过了小村庄<w>巴尼</w>。"
                            }
                        },
                        {
                            "text": "The history of <w>Bunny</w> dates back many centuries.",
                            "target_lang_translations": {
                                "ru": "История <w>Банни</w> насчитывает много веков.",
                                "zh": "<w>巴尼</w>的历史可以追溯到许多个世纪以前。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня и гражданский приход в районе Рашклифф, Ноттингемшир, Англия.",
                        "zh": "巴尼：英国英格兰诺丁汉郡拉什克利夫区的一个村庄和民政教区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Банни",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴尼",
                                "target_lang_sense_clarification": "英国英格兰诺丁汉郡的地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}