                        "glosses": [
                            "een gebouw (of complex van gebouwen), dat gelegenheid biedt voor het organiseren van congressen en vaak ook andere grootschalige evenementen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "031d611c-bd70-44a7-872c-1b9de5051062",
                                "sense_id": "057a606f-8d96-3e64-a766-5711492450f3",
                                "text": "Sergej vertelt ook dat het in Vladivostok krioelt van de illegale Chinese gastarbeiders die op het Russische Eiland een megalomaan conferentiecentrum voor een economische top bouwen."
                            },
                            {
                                "example_id": "9511113d-513e-424c-bacd-bcfd08ec4121",
                                "sense_id": "057a606f-8d96-3e64-a766-5711492450f3",
                                "text": "In het conferentiecentrum zou een woordenwisseling zijn ontstaan tussen twee groepen. Die ruzie werd buiten voortgezet en toen zou de jongen meermaals zijn gestoken."
                            }
                        ]
                    }
