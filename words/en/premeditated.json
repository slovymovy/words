{
    "word_family": [
        "premeditate",
        "premeditation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2fdf5447-e8ff-3f1c-acbb-4876c1cce7af",
                    "sense_definition": "Planned, considered, or thought out beforehand; deliberate rather than impulsive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution argued that the attack was a <w>premeditated</w> murder rather than an accident.",
                            "target_lang_translations": {
                                "nl": "Het openbaar ministerie betoogde dat de aanval een moord <w>met voorbedachte rade</w> was en geen ongeluk."
                            }
                        },
                        {
                            "text": "Detectives found evidence indicating a carefully <w>premeditated</w> crime planned weeks in advance.",
                            "target_lang_translations": {
                                "nl": "Rechercheurs vonden bewijsmateriaal dat wees op een zorgvuldig <w>voorbedacht</w> misdrijf dat weken van tevoren was gepland."
                            }
                        }
                    ],
                    "synonyms": [
                        "preconceived",
                        "preplanned"
                    ],
                    "antonyms": [
                        "unpremeditated",
                        "spontaneous",
                        "improvised"
                    ],
                    "common_phrases": [
                        "premeditated murder",
                        "premeditated crime"
                    ],
                    "target_lang_definitions": {
                        "nl": "Van tevoren gepland, overwogen of overdacht; opzettelijk en bewust uitgevoerd in plaats van impulsief."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "met voorbedachte rade",
                                "target_lang_sense_clarification": "juridisch of formeel, vooraf gepland"
                            },
                            {
                                "target_lang_word": "voorbedacht",
                                "target_lang_sense_clarification": "als bijvoeglijk naamwoord, vooraf beraamd"
                            },
                            {
                                "target_lang_word": "opzettelijk",
                                "target_lang_sense_clarification": "bewust gedaan, niet per ongeluk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "024a63f0-24bc-3597-8457-76d0afff65a1",
