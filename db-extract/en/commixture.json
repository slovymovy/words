                        "entry_id": "06c796df-9125-3fa6-9732-0c0a79611329",
                        "glosses": [
                            "The act or state of being mixed together; a union or mingling of constituents; commixtion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cce27c59-7101-4166-b384-a4d639b89b46",
                                "sense_id": "918bace6-5f75-3c07-b869-019ef13a924f",
                                "text": "Some apprehended a purifying virtue in fire, refining the grosser commixture, and firing out the Æthereall particles so deeply immersed in it."
                            },
                            {
                                "example_id": "e11e558d-0168-424a-a0b6-0539b9675206",
                                "sense_id": "918bace6-5f75-3c07-b869-019ef13a924f",
                                "text": "Of these gases the former become less and less noxious in proportion to their commixture with atmospheric air; the latter more and more dangerous, and liable to explosion, in proportion to the same commixture, in quantities limited to six parts and 12 parts of atmospheric air. No commixture of these different noxious gases will explode."
                            },
                            {
                                "example_id": "319c8ae9-9093-4238-926a-f2350e281142",
                                "sense_id": "918bace6-5f75-3c07-b869-019ef13a924f",
                                "text": "They are the various forms of narrative, the forms in which a story may be told; and while they are many, they are not indeed so very many, though their modifications and their commixtures are infinite."
                            }
                        ]
                    }
