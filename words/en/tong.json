{
    "word_family": [
        "tongue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0fbfef39-b2ce-3bf9-9dfe-4f8b64e1b417",
                    "sense_definition": "An instrument or tool used for manipulating things in a fire or hot environment without touching them with the hands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the <w>tongs</w> to move the burning logs in the fireplace.",
                            "target_lang_translations": {
                                "zh": "用<w>火钳</w>把壁炉里燃烧的木头挪一挪。"
                            }
                        },
                        {
                            "text": "He picked up the hot coal with a pair of <w>tongs</w>.",
                            "target_lang_translations": {
                                "zh": "他用一把<w>火钳</w>夹起了炽热的煤块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pincers"
                    ],
                    "common_phrases": [
                        "pair of tongs"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种工具，用来在火中或高温环境里夹取、移动物体，而不用手直接接触。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火钳",
                                "target_lang_sense_clarification": "用于在火中或高温环境里夹取、移动物体的工具"
                            },
                            {
                                "target_lang_word": "夹钳",
                                "target_lang_sense_clarification": "泛指可夹取高温物体的钳状工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef5c48a0-d335-3e66-9e6f-e16c9c8450da",
                    "sense_definition": "A Chinese secret society or criminal gang.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical novel describes the power struggles between rival <w>tongs</w> in the city.",
                            "target_lang_translations": {
                                "zh": "这部历史小说描写了城里敌对<w>堂口</w>之间的权力斗争。"
                            }
                        },
                        {
                            "text": "Police investigated the activities of the local <w>tong</w>.",
                            "target_lang_translations": {
                                "zh": "警方调查了当地这个<w>堂口</w>的活动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gang",
                        "syndicate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指华人秘密社团或犯罪帮派。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "堂口",
                                "target_lang_sense_clarification": "旧时海外华人社会中的秘密会党或犯罪帮派"
                            },
                            {
                                "target_lang_word": "华人帮会",
                                "target_lang_sense_clarification": "强调其犯罪性质时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dea5609-423d-3c94-9798-aa6b77f8b1a1",
                    "sense_definition": "A Chinese lineage organization responsible for managing ancestral land or property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancestral land is managed by the family <w>tong</w>.",
                            "target_lang_translations": {
                                "zh": "祖产由家族的<w>宗族组织</w>管理。"
                            }
                        },
                        {
                            "text": "Legal documents confirm the <w>tong</w> owns the property.",
                            "target_lang_translations": {
                                "zh": "法律文件证实这家<w>宗族组织</w>拥有这处房产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clan",
                        "lineage"
                    ],
                    "target_lang_definitions": {
                        "zh": "指负责管理祖传土地或家族财产的华人宗族组织。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宗族组织",
                                "target_lang_sense_clarification": "负责管理祖产、族产等事务的家族组织"
                            },
                            {
                                "target_lang_word": "家族公产管理组织",
                                "target_lang_sense_clarification": "强调其管理祖产或共有财产的职能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d75fb7-57b0-3646-8dcb-f418c5fc1079",
                    "sense_definition": "An obsolete spelling of <w>tongue</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old manuscript refers to the Latin <w>tong</w>.",
                            "target_lang_translations": {
                                "zh": "这份古老手稿里提到了拉丁语中的<w>tong</w>这个古拼法。"
                            }
                        },
                        {
                            "text": "In archaic texts, one might find the word written as <w>tong</w>.",
                            "target_lang_translations": {
                                "zh": "在古旧文献中，你可能会看到这个词写作<w>tong</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This spelling is no longer in standard use."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "tongue 的过时拼写。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "tong",
                                "target_lang_sense_clarification": "tongue 的古旧拼写形式"
                            },
                            {
                                "target_lang_word": "tongue的古拼写",
                                "target_lang_sense_clarification": "所对应的现代词义是“舌头；语言”"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e476f699-99f2-351a-801f-cf5aa0e114e6",
                    "sense_definition": "To grab, manipulate or transport something using tongs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carefully <w>tong</w> the hot charcoal into the grill.",
                            "target_lang_translations": {
                                "zh": "小心地<w>用火钳夹</w>起热木炭，放进烤架里。"
                            }
                        },
                        {
                            "text": "The chef <w>tonged</w> the meat onto the serving plate.",
                            "target_lang_translations": {
                                "zh": "厨师把肉<w>用夹钳夹</w>到了上菜盘里。"
                            }
