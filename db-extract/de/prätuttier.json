                        "glosses": [
                            "Angehöriger des gleichnamigen, antiken italischen Stammes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20eec4a-edc3-4bdc-b2a1-375d015eedfc",
                                "sense_id": "b2f5dd09-a9fc-3952-82cf-b1de1766497c",
                                "text": "„Dasselbe geschah mit den ihnen wohl zuletzt verbündeten Prätuttiern, die den größten Teil ihres Bodens für römische Koloniegründung […] abtreten mußten (290 v. Chr.).“"
                            },
                            {
                                "example_id": "545abd17-3fd3-4e84-a01c-9cb28ba195d4",
                                "sense_id": "b2f5dd09-a9fc-3952-82cf-b1de1766497c",
                                "text": "„Das daran südlich anschließende teramanische Gebiet gehörte schon zu den Prätuttiern, die zur mitteladriatischen Kultur gerechnet werden.“"
                            },
                            {
                                "example_id": "74726f36-98d3-41ff-9464-2ef8fa527a32",
                                "sense_id": "b2f5dd09-a9fc-3952-82cf-b1de1766497c",
                                "text": "„Einige Studien erforschten die römische Eroberung der Gebiete der Sabiner und Prätuttier in den letzten Jahren des 3. Samnitenkrieges […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
