                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "of unsound mind or out of control"
                            },
                            {
                                "target_lang_word": "demented",
                                "target_lang_sense_clarification": "suffering from mental confusion or derangement"
                            }
