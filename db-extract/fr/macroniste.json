                        "entry_id": "5e6ca4f0-54a3-3fb4-9f35-9426f0ca077b",
                        "glosses": [
                            "macronovský, macronistický, související s Macronem či macronismem"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c22243fd-675f-4616-88c3-1cc4e291411b",
                                "sense_id": "fa9d4ee0-1aa4-30d6-8a66-5827c178f68b",
                                "text": "L’élu macroniste, fidèle de Valérie Pécresse, a annoncé sa décision lors de la dernière séance budgétaire de l’année."
                            },
                            {
                                "example_id": "847a85fe-a496-4417-bdee-245f519b620d",
                                "sense_id": "fa9d4ee0-1aa4-30d6-8a66-5827c178f68b",
                                "text": "Le groupe macroniste présente toutefois un caractère inédit en ce qu’il se proclame temporaire et tire son origine d’une querelle interne à un parti politique."
                            }
                        ]
                    }
