                "senses": [
                    {
                        "sense_id": "5f64d709-fd14-3e60-8658-2bb189b67e44",
                        "entry_id": "f7ec2c74-1391-3da8-9993-c859f2e807b2",
                        "glosses": [
                            "furchterregende, aber gerechte Rächerin, die Verbrecher hartnäckig verfolgt, bis diese ihre verdiente Strafe bekommen haben"
                        ],
                        "tags": [
                            "griechische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d53e1422-4b1c-4626-9fd0-435f016d6d68",
                                "sense_id": "5f64d709-fd14-3e60-8658-2bb189b67e44",
                                "text": "„In Kunst und Literatur werden die Erinyen stets als Furcht erregende Wesen dargestellt, von grimmigem Aussehen, Fackeln und Geißeln tragend, meist mit Schlagen bekränzt oder mit Schlangen im Haar oder sie in den Händen haltend.“"
                            },
                            {
                                "example_id": "5850f89b-ee55-4718-b4b8-4fea79fc47e0",
                                "sense_id": "5f64d709-fd14-3e60-8658-2bb189b67e44",
                                "text": "„Die Erinyen hefteten sich an die Fersen von Mördern und Meineidigen und trieben sie durch ihren fürchterlichen Anblick in den Wahnsinn […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
