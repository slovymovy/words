                        "entry_id": "83389fdc-5968-3ec9-942c-9c5f6b8be309",
                        "glosses": [
                            "Tissu de laine sur lequel il est possible d’imprimer des motifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697241a0-ee0e-48d1-96e1-6a92f26fc1bb",
                                "sense_id": "b75569cf-91fb-34b7-8fbb-d796087985fe",
                                "text": "Ces admirables tissus destinés aux vêtements des femmes, tels que thibets, cachemires et mérinos, qui constituent les produits caractéristiques du siècle présent."
                            },
                            {
                                "example_id": "c87e7278-a02e-4928-b369-fe61c7f9615a",
                                "sense_id": "b75569cf-91fb-34b7-8fbb-d796087985fe",
                                "text": "Tailleur simple d'après-midi en Thibet noir garni de taupe Ecosse."
                            }
                        ]
                    }
