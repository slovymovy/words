                "entry_id": "43c588a8-0822-3c1c-9996-3f9307d7b6ee",
                "word": "miesiącami",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9b52968-e4c9-3b7d-b9b5-e5b67460f3fc",
                        "entry_id": "43c588a8-0822-3c1c-9996-3f9307d7b6ee",
                        "glosses": [
                            "ileś miesięcy, przez wiele miesięcy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19afdc1-b324-4345-bf7b-df7903162210",
                                "sense_id": "f9b52968-e4c9-3b7d-b9b5-e5b67460f3fc",
                                "text": "Towarzyszył mi dreszcz emocji, spora radocha, że oto nadeszła chwila, o której marzyłem miesiącami, może nawet latami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bce814d-8d54-459d-b76e-51bfef85cbac",
                        "source_entry_id": "43c588a8-0822-3c1c-9996-3f9307d7b6ee",
                        "source_sense_id": "f9b52968-e4c9-3b7d-b9b5-e5b67460f3fc",
                        "target_lang_word": "monatelang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monatelang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5664212-0903-3045-8c1f-d645e12a6208",
                                        "entry_id": "a760383c-bc43-3eb2-a17b-5d5fdd2b5ca0",
                                        "glosses": [
                                            "mehrere Monate dauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167c817e-befb-4b77-976f-2908fafe5650",
                                                "sense_id": "c5664212-0903-3045-8c1f-d645e12a6208",
                                                "text": "Wir warteten monatelang auf die Ausreisegenehmigung."
                                            },
                                            {
                                                "example_id": "fc9bb938-bac5-4512-9762-c812d4e54b8e",
                                                "sense_id": "c5664212-0903-3045-8c1f-d645e12a6208",
                                                "text": "„Nach seiner Heimkehr lag er monatelang im Bett, litt an Alpträumen, an ausgeprägten Ängsten vor engen Räumen, der Dunkelheit, dem Keller.“"
                                            },
                                            {
                                                "example_id": "ddbe0e58-77d6-4570-9832-ea4279259b70",
                                                "sense_id": "c5664212-0903-3045-8c1f-d645e12a6208",
                                                "text": "„Als ich mit Gefängnisinsassen monatelang ein Stück einstudierte, habe ich Menschen kennengelernt, die mir den Glauben an die unendlichen Möglichkeiten der Resozialisierung genommen haben.“"
                                            },
                                            {
                                                "example_id": "bc4fbf6c-b743-42b5-ac6a-432a4aff723d",
                                                "sense_id": "c5664212-0903-3045-8c1f-d645e12a6208",
                                                "text": "„Monatelang hatte Wörle den Stunt vorbereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
