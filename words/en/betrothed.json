{
    "word_family": [
        "betroth",
        "betrothal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2251f931-f0c9-3c68-acaa-277708d56488",
                    "sense_definition": "Engaged to be married.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>betrothed</w> couple walked hand in hand through the park.",
                            "target_lang_translations": {
                                "de": "Das <w>verlobte</w> Paar ging Hand in Hand durch den Park."
                            }
                        },
                        {
                            "text": "They were publicly <w>betrothed</w> during the ceremony last weekend.",
                            "target_lang_translations": {
                                "de": "Sie haben sich am vergangenen Wochenende während der Zeremonie öffentlich <w>verlobt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "engaged",
                        "affianced"
                    ],
                    "common_phrases": [
                        "betrothed couple"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem versprochen, um ihn zu heiraten; verlobt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlobt",
                                "target_lang_sense_clarification": "Adjektiv, das den Beziehungsstatus beschreibt."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d809d2c2-44f7-36c6-ad45-d68a9b9d4077",
                    "sense_definition": "A person to whom one is engaged to be married.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She proudly introduced him to her parents as her <w>betrothed</w>.",
                            "target_lang_translations": {
                                "de": "Sie stellte ihn ihren Eltern stolz als ihren <w>Verlobten</w> vor."
                            }
                        },
                        {
                            "text": "He bought a beautiful ring for his <w>betrothed</w> before the wedding.",
                            "target_lang_translations": {
                                "de": "Er kaufte vor der Hochzeit einen wunderschönen Ring für seine <w>Verlobte</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiancé",
                        "fiancée"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, mit der man verlobt ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verlobter",
                                "target_lang_sense_clarification": "Männliche Person, mit der man verlobt ist."
                            },
                            {
                                "target_lang_word": "Verlobte",
                                "target_lang_sense_clarification": "Weibliche Person, mit der man verlobt ist."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5da75549-55a0-3e29-98a5-8cb303682a6f",
                    "sense_definition": "Simple past and past participle of <w>betroth</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young woman was <w>betrothed</w> to a wealthy merchant by her father.",
                            "target_lang_translations": {
                                "de": "Die junge Frau wurde von ihrem Vater einem wohlhabenden Kaufmann <w>versprochen</w>."
                            }
                        },
                        {
                            "text": "They had been <w>betrothed</w> since childhood according to local tradition.",
                            "target_lang_translations": {
                                "de": "Sie waren nach lokaler Tradition schon seit ihrer Kindheit <w>verlobt</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Verlobung eingehen oder jemandem versprechen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlobt",
                                "target_lang_sense_clarification": "Partizip II des Verbs 'verloben'."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}