                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de512aff-d01e-4e1e-af60-a0121ea70558",
                        "source_entry_id": "8894c745-cb90-31aa-8161-a602246e080d",
                        "source_sense_id": "1fcafe75-45cd-3faf-b66c-139b7de2fae7",
                        "source_sense_description": "Chemie: zwiebelförmiger Destillierkolben, der der Trennung von Stoffen dient",
                        "target_lang_word": "alembik",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alembik",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "01232f94-02be-3fca-b1a3-94992dccf671",
                                        "entry_id": "4fe2f2f9-eb9d-32ca-b766-edb406b045d9",
                                        "glosses": [
                                            "sprzęt laboratoryjny w postaci szklanego lub metalowego naczynia – zbiornika, zakończonego szyjką, w której osadzano korek lub specjalną głowicę z wychodzącą z niej zagiętą rurką; służy do destylacji; ; zob. też alembik w Encyklopedii staropolskiej"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "130ca829-99a8-4611-b98b-5448f40cfc08",
                                                "sense_id": "01232f94-02be-3fca-b1a3-94992dccf671",
                                                "text": "W tej apteczce całą jedną połać przeznaczyła „szacownemu zdrowiu”. Tam stały gąsiory z różnemi wódkami naciąganemi na słońcu albo przepuszczanemi przez alembik na suche bóle, paraliże, na słabości wewnętrzne; były tam wódki z szyszek młodych, z glist kopanych na wiosnę, a nawet gadzin różnych."
                                            },
                                            {
                                                "example_id": "a525f50d-c47c-4df8-b13e-6906e177a225",
                                                "sense_id": "01232f94-02be-3fca-b1a3-94992dccf671",
                                                "text": "Mleko krowie raz przepędzone przez alembik daje wódkę słabą i cierpką; dwa razy przepędzone zbliża się smakiem do kartoflanej wódki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
