                "senses": [
                    {
                        "sense_id": "b1b2671e-ff36-31a0-98cf-747b1fd8997c",
                        "entry_id": "6fb1fbff-4be4-3cc6-ad6b-704409aa24e8",
                        "glosses": [
                            "Geruchswahrnehmung, die von Alkohol herrührt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e569be3a-897f-48c0-8bb9-a4692086991a",
                                "sense_id": "b1b2671e-ff36-31a0-98cf-747b1fd8997c",
                                "text": "„Die Beamten stellten vor Ort bei dem 61-Jährigen Alkoholgeruch fest.“"
                            },
                            {
                                "example_id": "3f4483cc-dce0-4110-9c60-77450dfae723",
                                "sense_id": "b1b2671e-ff36-31a0-98cf-747b1fd8997c",
                                "text": "„Sie versuchte den deutlichen Alkoholgeruch mit Parfum zu überdecken – was allerdings nicht half.“"
                            },
                            {
                                "example_id": "26aca07b-22d6-4049-b9c4-1f81f243099c",
                                "sense_id": "b1b2671e-ff36-31a0-98cf-747b1fd8997c",
                                "text": "„Aus dem Wagen schlug ihnen dann ein starker Alkoholgeruch entgegen.“"
                            },
                            {
                                "example_id": "ff3d553e-9d24-46b5-90ee-162b29a34920",
                                "sense_id": "b1b2671e-ff36-31a0-98cf-747b1fd8997c",
                                "text": "„Deutlicher Alkoholgeruch zog einen Alcotest nach sich, mit dessen Ergebnis sich der Mann für die folgende Blutprobe „qualifizierte”.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
