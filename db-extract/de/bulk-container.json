                "senses": [
                    {
                        "sense_id": "6e6addb7-0535-32b7-87ab-fc3040256f76",
                        "entry_id": "4bc5d30c-2cb9-35af-aac1-d0b5de2dfc8b",
                        "glosses": [
                            "speziell für Schüttgut gedachter Container, der oben mit drei Luken zum Befüllen versehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982e7829-36a3-4dbc-8b13-4411d69fd62b",
                                "sense_id": "6e6addb7-0535-32b7-87ab-fc3040256f76",
                                "text": "„Der Bulk-Container wird speziell für den Transport von Schüttgut, wie z.B. Getreide, Futtermittel, Gewürze etc., verwendet.“"
                            },
                            {
                                "example_id": "a15bd881-8c43-4a19-961e-7a347dbcc3e8",
                                "sense_id": "6e6addb7-0535-32b7-87ab-fc3040256f76",
                                "text": "„Der Bulk-Container, auch bekannt als Schüttgutcontainer, zeichnet sich durch die drei Einfüllöffnungen im Dach sowie die Ausschüttöffnungen an der Türseite aus.“"
                            },
                            {
                                "example_id": "d0ba59eb-7b00-4838-8fa7-570fbf5d5529",
                                "sense_id": "6e6addb7-0535-32b7-87ab-fc3040256f76",
                                "text": "„Im folgenden sind für den Bulk-Container beispielhaft die wichtigsten Daten zusammengefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
