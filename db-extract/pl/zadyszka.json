                                        "examples": [
                                            {
                                                "example_id": "5ba9083e-07b3-4d19-9fb1-7c485e920ac2",
                                                "sense_id": "fc03151a-2379-3947-9469-3a058468bc1c",
                                                "text": "Now here, now there, moved by the straggling wind, / Came ever and anon a breathlike sound, / Quick as the pantings of the faithful dog […]"
