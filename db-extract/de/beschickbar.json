                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bb3b4aa-4e0c-3b8a-9247-ef18d98917fc",
                        "entry_id": "c4c16280-cf38-3917-83cd-6c8f07f87c3a",
                        "glosses": [
                            "so, dass es beschickt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a618f2c7-37d5-4a19-a794-d38b92513ba0",
                                "sense_id": "0bb3b4aa-4e0c-3b8a-9247-ef18d98917fc",
                                "text": "„Für eine Hochleistungsanlage wurde eine Haspel benötigt, die während des Ablaufs wechselseitig beschickbar sein soll.“"
                            },
                            {
                                "example_id": "292cb0af-1c2d-4443-a9f4-9c71367b4279",
                                "sense_id": "0bb3b4aa-4e0c-3b8a-9247-ef18d98917fc",
                                "text": "„[Die Maschine] ist universell beschickbar ob aus Eimer, Silo oder Horizontalmischer. “"
                            },
                            {
                                "example_id": "a8109fc3-939f-450c-8250-25939fccdb82",
                                "sense_id": "0bb3b4aa-4e0c-3b8a-9247-ef18d98917fc",
                                "text": "„[Dieses Modell] bietet 35 Liter Kammervolumen, der Nutzraum ist mit einem Durchmesser von 305 mm und einer Höhe von 410 mm mit diversen Körben und Trommeln beschickbar.“"
                            },
                            {
                                "example_id": "d379dfb8-f601-4edd-b872-0d36148db5df",
                                "sense_id": "0bb3b4aa-4e0c-3b8a-9247-ef18d98917fc",
                                "text": "„Eine mobile Siebanlage, die grobe, feine und bindige Materialien verarbeiten kann und zudem bequem mit einer 4-m³-Radladerschaufel beschickbar sein sollte.“"
                            },
                            {
