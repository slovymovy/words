                ],
                "senses": [
                    {
                        "sense_id": "3cc820d7-6b16-3a9d-a1d7-2e4929cba534",
                        "entry_id": "ac8ee675-859c-3dad-924e-827dc18935b7",
                        "glosses": [
                            "Voiture de location."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ce4231-30dd-4b1c-ab69-7750fe054e05",
                                "sense_id": "3cc820d7-6b16-3a9d-a1d7-2e4929cba534",
                                "text": "Wir werden einen Mietwagen haben, um zum Flughafen zu fahren.",
                                "translation": "Nous aurons une voiture de location pour aller jusqu'à l'aéroport."
                            },
                            {
                                "example_id": "f336ddf6-834f-4070-8877-0974ec049c28",
                                "sense_id": "3cc820d7-6b16-3a9d-a1d7-2e4929cba534",
                                "text": "Wie vereinbart stellen wir Ihnen den Mietwagen auf dem Parkplatz des Flughafens bereit.",
                                "translation": "Comme convenu, nous mettons la voiture de location à votre disposition sur le parking de l'aéroport."
                            },
                            {
                                "example_id": "c48130c1-268e-4f9f-b64f-d452ba9b346b",
                                "sense_id": "3cc820d7-6b16-3a9d-a1d7-2e4929cba534",
                                "text": "„Die Touristen haben alle Mietwagen, die wollen nur den billigsten Sprit“, erzählt (der Tankstellenbetreiber) am Telefon.",
                                "translation": "« Les touristes ont tous des voitures de location, ils ne veulent que l’essence la moins chère », raconte (le gérant de la station-service) au téléphone."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c47b1df-6a9a-3e5b-a4aa-27013bf10727",
                        "entry_id": "ac8ee675-859c-3dad-924e-827dc18935b7",
                        "glosses": [
                            "Fiacre, taxi."
                        ],
