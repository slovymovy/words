                                "example_id": "0afd3647-10ba-4eb8-bfc2-20494e7b6c9e",
                                "sense_id": "67a6e49b-9ffe-34b5-8f7a-8094becc7067",
                                "text": "„Im Fundus des United States National Museum in Washington lagert eine vor knapp hundert Jahren entstandene Sammlung präkolumbischer Steinschleudern.“"
                            },
                            {
                                "example_id": "2eb78cc7-d279-4240-9115-b8f7ee546f3e",
                                "sense_id": "67a6e49b-9ffe-34b5-8f7a-8094becc7067",
                                "text": "„Mit ihren Steinschleudern haben sie die Affen vertrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
