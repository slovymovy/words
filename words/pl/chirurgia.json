                        "chirurgia ogólna",
                        "chirurgia dziecięca",
                        "chirurgia naczyniowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "раздел медицины, изучающий и занимающийся оперативным лечением заболеваний и травм"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хирургия",
