                "translations": [
                    {
                        "translation_id": "95406e2f-59c0-44b2-b7c2-941fcd6277f7",
                        "source_entry_id": "1a99fbc8-d390-3b1c-874c-abeac0b230dc",
                        "source_sense_id": "9eb20c95-21ca-3251-8fa1-1c78f6692df6",
                        "source_sense_description": "Beruf: weibliche Person, die Backwaren herstellt",
                        "target_lang_word": "Bäckerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bäckerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                        "entry_id": "04e0a886-b80e-38f7-8716-9a4364eaf604",
                                        "glosses": [
                                            "weibliche Person, die berufsmäßig Backwaren wie Brot und Brötchen herstellt beziehungsweise bäckt. Auch situativ bewundernd oder ironisch für eine weibliche Person, die das Backen nicht berufsmäßig betreibt."
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53cbb4f1-33f3-435e-a78b-4bbc5827d8ca",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "Als Bäckerin muss sie früh aufstehen."
                                            },
                                            {
                                                "example_id": "f6097d09-5ff6-45de-97b6-5e116f5e408a",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "„‚Ich bin verheiratet, habe zwei kleine Kinder, meine Frau ist Bäckerin, mit ihrem Gehalt allein kommen wir nicht über die Runden‘, sagt Günthner, der an der Realschule in Trossingen sogar Klassenlehrer gewesen ist - 500 Euro weniger hat er verdient als die im Beamtenverhältnis beschäftigten Kollegen.“"
                                            },
                                            {
                                                "example_id": "ad8882d7-84d9-4c5a-a9c6-f440b9f322d5",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "Meine Tante ist eine hervorragende Bäckerin."
                                            },
                                            {
                                                "example_id": "eecbf7de-c1cf-4501-b46b-ebf344b0fe83",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "„Mit dabei in der Sammlung neuer, origineller Backideen sind auch wieder begeisterte Bäckerinnen aus dem Ries.“"
                                            },
                                            {
                                                "example_id": "8c4bc6a6-bd6b-4e5b-a11a-f787c4a171e2",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "„Bei ihren Freunden ist sie als leidenschaftliche Bäckerin bekannt.“"
                                            },
                                            {
                                                "example_id": "98e653a7-8f8b-4077-8c06-bda8897d3d09",
                                                "sense_id": "2d4873a6-b214-38f8-a6af-9cda1a5cbf20",
                                                "text": "„Die alte Dame musste alles aufzählen, was sie dabeihatte, was Dóra daran erinnerte, was für eine schlechte Köchin und Bäckerin sie selbst abgab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dccc15a2-8e48-4ec8-8315-81c17c6d2cab",
                        "source_entry_id": "1a99fbc8-d390-3b1c-874c-abeac0b230dc",
                        "source_sense_id": "9eb20c95-21ca-3251-8fa1-1c78f6692df6",
