                                            {
                                                "example_id": "01b425fa-0c48-4cbf-b13f-1627b0c53b7b",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "И по ковру скользит, плывет // Ее божественная ножка; // И улыбается она, // Веселья детского полна."
                                            },
                                            {
                                                "example_id": "4a182cbb-b858-40cc-a3ae-c49d4cd59f73",
                                                "sense_id": "f9d61126-d2da-3c99-af9e-8128bee4341e",
                                                "text": "Чьей лёгкой ножки при реке // Следы остались на песке?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380c4b37-9999-39da-b67d-f042c22a5530",
