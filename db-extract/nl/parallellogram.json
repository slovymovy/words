                                    {
                                        "sense_id": "aa7134ab-7725-3e8d-b6a9-bef290aa2860",
                                        "entry_id": "62b70b3a-d93a-399a-b710-39a4897cb0b1",
                                        "glosses": [
                                            "Le rectangle et le losange sont des parallélogrammes."
                                        ],
                                        "tags": [],
