                        ]
                    },
                    {
                        "translation_id": "fe656688-9268-41af-8297-fd2766695f58",
                        "source_entry_id": "6b1698ff-e92d-3f08-b423-54b857a0f444",
                        "source_sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
                        "target_lang_word": "apparently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "Plainly; clearly; manifestly; evidently."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845e893b-9f78-4967-96af-b5e2e7c19f22",
                                                "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                                "text": "If he should scorn me so apparently."
                                            },
                                            {
                                                "example_id": "02e20786-fa66-44bf-ac80-8e74a76db730",
                                                "sense_id": "6236f0d2-3b0e-3ca1-a4a9-45cbc3e84a81",
                                                "text": "One, my lord, that doth so palpably, so apparently make her adulteries a trophy, whiles the poting-stick to her unsatiate goatish abomination jeers at, and flouts your sleepish, and more than sleepish, security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "Seemingly; in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17632980-be42-46b4-a213-808792486d5e",
                                                "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                                "text": "A man may be apparently friendly, yet malicious in heart."
                                            },
                                            {
                                                "example_id": "2ac21fa0-00c6-459f-a706-b6d1902c7958",
                                                "sense_id": "02b9a4ee-57cd-3cff-9b0e-93147c4164af",
                                                "text": "The r-stems had apparently been reduced to the five nuclear kinship terms that still survive in Modern English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "According to what the speaker has read or heard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdde7d89-130b-463c-8181-2f82c36e5898",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "Apparently you are quite a good dancer."
                                            },
                                            {
                                                "example_id": "936d47ec-319e-46af-a3a2-d672a2c9010e",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "\"[…] Apparently they are going to contact the adoption agency and see if they can locate that child. […]\""
                                            },
                                            {
                                                "example_id": "a5ddb8ab-e3de-4f76-83d1-45bc078298d8",
                                                "sense_id": "d44f1e54-3d7e-3612-81f9-bb342fa379c5",
                                                "text": "Similarly, the new move to apparently involve the National Guard in ICE operations could rub people the wrong way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7256d8-ee5b-3dd6-ab02-b8577ada3865",
                                        "entry_id": "dacc25af-db06-3a95-a9c0-46b4529e42cf",
                                        "glosses": [
                                            "According to what one can deduce."
                                        ],
                                        "tags": [
                                            "often",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a634ca1-de4b-4b9d-a5c8-24f6cbfd5965",
                                                "sense_id": "7d7256d8-ee5b-3dd6-ab02-b8577ada3865",
                                                "text": "Peridot: I can tell you with certainty that there are things on this planet worth protecting!\nYellow Diamond: What do you know about the Earth?!\nPeridot: Apparently more than you, you clod!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be1974a-4e7d-4fa8-bcb7-f6dc590ad152",
                        "source_entry_id": "6b1698ff-e92d-3f08-b423-54b857a0f444",
                        "source_sense_id": "cfcd22ff-c395-3a1e-8bc6-8d4d30255b04",
                        "target_lang_word": "seemingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seemingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                        "entry_id": "d240aed7-ebe6-3831-ab06-49d70ddded36",
                                        "glosses": [
                                            "As it appears; apparently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a618d20f-9688-444f-bdc4-0c9f9814d215",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "[…] an object, seemingly like those which we have experienced, may be attended with different or contrary effects."
                                            },
                                            {
                                                "example_id": "7ff9513f-20c2-4c90-91b8-1889dff1857e",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "Mr. Woodhouse at last was off; but Mr. Knightley, instead of being immediately off likewise, sat down again, seemingly inclined for more chat. He began speaking of Harriet, and speaking of her with more voluntary praise than Emma had ever heard before."
                                            },
                                            {
                                                "example_id": "e1ebc234-cca5-4c9c-a7ef-69d1f040f91f",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "76512fff-a8d9-49be-a5b2-fca5daa40ea8",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "He sacrificed nothing, laboring to get even the most seemingly insignificant element of every record perfect."
                                            },
                                            {
                                                "example_id": "d7a241fc-23a5-4542-af32-c3eeca7d604f",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "With rain lashing across the ground at kick-off and every man in Auckland seemingly either English-born or supporting Scotland, Eden Park was transformed into Murrayfield in March."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                        "entry_id": "d240aed7-ebe6-3831-ab06-49d70ddded36",
                                        "glosses": [
                                            "In a seemly manner; decorously; with propriety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d89a1f-5616-487a-8e50-635d58532bac",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "It was possibly chagrin at this neglect that caused James to omit the most ordinary courtesies to the few gentlemen who had behaved seemingly:[…]."
                                            },
                                            {
                                                "example_id": "ee856ef2-259a-4166-9a60-010bb1315360",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "[…]was restored to his throne but only on the understanding that he behave seemingly."
                                            },
                                            {
                                                "example_id": "9e646204-448f-480c-8a08-d9aade1a7220",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "[…]they know the roles and statuses of deities, ancestral spirits, and men, and how to behave seemingly in their presence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
