                    "sense_definition": "Apparaître ou se manifester brusquement et de manière inattendue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un animal sauvage a <w>surgi</w> de nulle part et a traversé la route."
                        },
                        {
                            "text": "Une difficulté imprévue vient de <w>surgir</w> au milieu des négociations."
                        }
                    ],
                    "synonyms": [
