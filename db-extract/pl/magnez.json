                                        "entry_id": "7ef1934b-86c5-3d0f-9159-3e76a24a151e",
                                        "glosses": [
                                            "scheikundig element met symbool Mg en atoomnummer 12. Het is een zilverwit aardalkalimetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb4803f8-9257-4729-b84f-4aa66a6509fa",
                                                "sense_id": "1a6e882c-e4f6-3948-9311-7e984f1b022c",
                                                "text": "Vroeger werd magnesium gebruikt als flitslicht voor de fotografie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca1d6f9d-b38e-48b0-9ffe-56e2247a7865",
                        "source_entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
                        "source_sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                        "target_lang_word": "Magnesium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnesium",
