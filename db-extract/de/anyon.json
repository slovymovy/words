                                "target_senses": [
                                    {
                                        "sense_id": "73ecdd0c-2c71-3913-a424-26600037b958",
                                        "entry_id": "82ede3a3-3eb2-38a5-a6d3-40a43bf3bfd3",
                                        "glosses": [
                                            "Any particle that obeys a continuum of quantum statistics, only two of which are the standard Bose-Einstein and Fermi-Dirac statistics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e166d6-0e2b-427e-ac41-c3ae47a59e00",
                                                "sense_id": "73ecdd0c-2c71-3913-a424-26600037b958",
                                                "text": "The anyon concept has been used to describe phenomena in connection with the fractional quantum Hall effect (FOHE)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
