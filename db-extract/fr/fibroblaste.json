                "senses": [
                    {
                        "sense_id": "59bc9f33-aef5-3aff-bfd3-1f695831dc23",
                        "entry_id": "9275c62b-9438-36c8-b242-da9841e7d99e",
                        "glosses": [
                            "Cellule présente dans le tissu conjonctif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9611a54e-8d78-453f-abdd-0ee387caefeb",
                                "sense_id": "59bc9f33-aef5-3aff-bfd3-1f695831dc23",
                                "text": "En microscopie électronique, le fibroblaste exprime les caractéristiques essentielles d’une cellule sécrétrice de protéine : un réticulum endoplasmique rugueux bien développé et un appareil de Golgi."
                            },
                            {
                                "example_id": "ad5816fe-06af-465b-9b5d-ea5087e2573f",
                                "sense_id": "59bc9f33-aef5-3aff-bfd3-1f695831dc23",
                                "text": "Ils ont alors constaté que les fibroblastes cultivés sur le gel sans tension n'ont pas exprimé le gène engrailed, mais que les fibroblastes cultivés sur le plastique induisant un stress l'ont exprimé."
                            },
                            {
                                "example_id": "81c97a94-bafc-4b45-812b-0f45faf0a9ca",
                                "sense_id": "59bc9f33-aef5-3aff-bfd3-1f695831dc23",
                                "text": "Les FGF constituent une famille de sept polypeptides (FGF1 à FGF7) mitogènes pour les fibroblastes, sauf FGF 7."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10c42e19-b5d9-4e84-bdb2-dd490e07006b",
                        "source_entry_id": "9275c62b-9438-36c8-b242-da9841e7d99e",
                        "source_sense_id": "59bc9f33-aef5-3aff-bfd3-1f695831dc23",
