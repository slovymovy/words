                {
                    "sense_id": "b5629f06-4118-3ebb-8138-24c8b338eef4",
                    "sense_definition": "een beschadiging van het levende weefsel van een lichaam",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichamelijk letsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door zijn val had hij een diepe <w>wond</w> in zijn been.",
                            "target_lang_translations": {
                                "en": "Because of his fall, he had a deep <w>wound</w> in his leg.",
                                "ru": "Из-за падения у него была глубокая <w>рана</w> на ноге."
                            }
                        },
                        {
                            "text": "De verpleegster maakte de <w>wond</w> voorzichtig schoon met een ontsmettend middel.",
                            "target_lang_translations": {
                                "en": "The nurse carefully cleaned the <w>wound</w> with a disinfectant.",
                                "ru": "Медсестра осторожно промыла <w>рану</w> антисептиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonde",
                        "verwonding"
                    ],
                    "common_phrases": [
                        "diepe wond",
                        "open wond",
                        "wond verzorgen"
                    ],
                    "target_lang_definitions": {
                        "en": "damage to the living tissue of a body",
                        "ru": "повреждение живой ткани тела"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wound",
                                "target_lang_sense_clarification": "a physical injury, especially one where the skin is broken"
                            },
                            {
                                "target_lang_word": "injury",
                                "target_lang_sense_clarification": "general damage to the body"
                            },
                            {
                                "target_lang_word": "sore",
                                "target_lang_sense_clarification": "a raw or painful place on the body"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рана",
                                "target_lang_sense_clarification": "физическое повреждение тканей с нарушением целостности кожи"
                            },
                            {
                                "target_lang_word": "ранение",
                                "target_lang_sense_clarification": "повреждение организма, полученное в результате внешнего воздействия"
                            }
                        ]
