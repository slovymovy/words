                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9252a9a4-b3eb-392f-9ea5-13edba8f1414",
                                        "entry_id": "e3776985-79d2-3a3a-9fd8-3801c0eccb1c",
                                        "glosses": [
                                            "zur Mafia gehörig; nach Art der Mafia, strukturiert wie die Mafia"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5316a16-61f9-4570-8c7e-797f9ed3993b",
                                                "sense_id": "9252a9a4-b3eb-392f-9ea5-13edba8f1414",
                                                "text": "„Zu tief ist die Korruption, zu mafiös sind die Machtstrukturen in vielen Teilen des Landes.“"
                                            },
                                            {
                                                "example_id": "d5aeacec-64bd-4112-b1b9-68fe637f30d1",
                                                "sense_id": "9252a9a4-b3eb-392f-9ea5-13edba8f1414",
                                                "text": "„Die Sicherung der Wasserversorgung, die Bereitstellung von Trinkwasser ist in Kibera in vielen Fällen ein mafiöses Geschäft.“"
                                            },
                                            {
