                "senses": [
                    {
                        "sense_id": "f0b8e9ed-f228-38dc-99d2-38a247b55e89",
                        "entry_id": "f4af507e-3bb0-3e28-8760-b079a792032b",
                        "glosses": [
                            "farblose, stechend riechende Flüssigkeit, deren Moleküle aus vier Kohlenstoffatomen und einer Aldehydgruppe bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1e4cba-c7bb-445b-afd7-2c7e71b23867",
                                "sense_id": "f0b8e9ed-f228-38dc-99d2-38a247b55e89",
                                "text": "„Natürlich kommt Butanal in Echtem Lorbeer, Äpfeln, Reis (Oryza sativa), Pelargonien (Pelargonium graveolens) und Echter Guave vor.“"
                            },
                            {
                                "example_id": "db8dd2ca-3328-40e7-bfd9-75dbefb9da79",
                                "sense_id": "f0b8e9ed-f228-38dc-99d2-38a247b55e89",
                                "text": "„Die partielle Oxidation der primären Butanole (n-Butanol und Isobutanol) führt über die Butanale zu den Butansäuren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
