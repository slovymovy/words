                                    {
                                        "sense_id": "a9356db4-6e14-399a-8ff0-7bbddc9c381a",
                                        "entry_id": "7db580cd-af6f-3ce0-8eee-57b626ba1c99",
                                        "glosses": [
                                            "unterschiedliche Meinungen, Auseinandersetzung"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "613ae803-3683-49d5-a275-424946b95f4b",
                                                "sense_id": "a9356db4-6e14-399a-8ff0-7bbddc9c381a",
                                                "text": "Der Verkauf von Opel wird durch Unstimmigkeiten zwischen Deutschland und anderen EU-Staaten weiter verzögert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3c10d0a-6440-3d51-b9df-dcf0811ba229",
                                        "entry_id": "7db580cd-af6f-3ce0-8eee-57b626ba1c99",
                                        "glosses": [
                                            "Abweichung, Fehler"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5680724-5c0a-4aa9-bacb-05bca58fbcb6",
                                                "sense_id": "c3c10d0a-6440-3d51-b9df-dcf0811ba229",
                                                "text": "Ich habe mir die Messwerte angeschaut und einige Unstimmigkeiten entdeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a57fffbe-308a-4dd1-b708-944dde78ed14",
                        "source_entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "source_sense_id": "9504ac5b-ab4a-3c9c-8996-bed08f0b88d3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Uneinigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uneinigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                        "entry_id": "049d43de-819c-3c32-bc43-f196cfefe573",
                                        "glosses": [
                                            "keine Übereinstimmung in einer bestimmten Frage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1337a04a-8aa4-49f7-9602-5d8854a8520a",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "Zwischen den Sunniten und den Schiiten herrschten Uneinigkeiten."
                                            },
                                            {
                                                "example_id": "e8e2a783-7e1f-46b2-92a3-3c5b55acd055",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "„Der Speiseplan der Neandertaler sorgt schon seit längerem für Uneinigkeit und kontroverse Diskussionen unter Anthropologen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95feff17-54bc-43c7-a34b-65c10014547d",
                        "source_entry_id": "bd8bcffc-391f-39e3-af3a-e50804d94e39",
                        "source_sense_id": "9504ac5b-ab4a-3c9c-8996-bed08f0b88d3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Dissonanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dissonanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba034bd3-6f6c-3468-bb34-a79f483cf8e3",
                                        "entry_id": "7ca62dde-58ee-32ed-814d-b1563df42330",
                                        "glosses": [
                                            "Missklang, das heißt Intervall oder Akkord, der als „auflösungsbedürftig“ empfunden wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60a4abae-94c4-4917-b239-90ffeb91c7a0",
                                                "sense_id": "ba034bd3-6f6c-3468-bb34-a79f483cf8e3",
                                                "text": "Als sie der Probe des Streichorchesters lauschte, musste sie bei einigen Dissonanzen das Gesicht verziehen. Es tat körperlich weh."
                                            },
                                            {
                                                "example_id": "8a2f23a7-b7c5-44f6-b923-a732eb6b5fa8",
                                                "sense_id": "ba034bd3-6f6c-3468-bb34-a79f483cf8e3",
                                                "text": "„Und plötzlich macht sich direkt hinter mir eine Dissonanz bemerkbar.“"
                                            },
                                            {
                                                "example_id": "17574e49-5aa3-4d24-b296-1c04d65c54f1",
                                                "sense_id": "ba034bd3-6f6c-3468-bb34-a79f483cf8e3",
                                                "text": "„Und sie droht sogar mit Kündigung, als Kant von ihr noch sechzehn weitere Gläser und Schalen für seine Experimente verlangt und entschuldigend von gekoppelten Tonfolgen und Dissonanzen murmelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14e05c3c-a913-302e-9b8a-06cac7e4d027",
                                        "entry_id": "7ca62dde-58ee-32ed-814d-b1563df42330",
                                        "glosses": [
                                            "eine aus dem Widerspruch von Entscheidung und Wahrnehmung folgende innere Spannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1d4e63-0644-4758-9f79-49a565696f5b",
                                                "sense_id": "14e05c3c-a913-302e-9b8a-06cac7e4d027",
                                                "text": "„Je veränderungsbereiter ein Mensch ist, desto geringer sind die durch neue Informationen erzeugten Spannungen, d. h. die empfundene Dissonanz.“"
                                            },
                                            {
                                                "example_id": "17b8f10a-df92-4af9-b22f-e97d0acfeb6d",
                                                "sense_id": "14e05c3c-a913-302e-9b8a-06cac7e4d027",
                                                "text": "„Es gab dieselbe Dissonanz: nah an der Vergangenheit und doch an einem Ort ohne erkennbare Verbindungslinien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be61aa39-74d8-32cd-b953-2f5b1a0d6386",
                                        "entry_id": "7ca62dde-58ee-32ed-814d-b1563df42330",
                                        "glosses": [
                                            "Uneinigkeit, Meinungsverschiedenheit in einer Gruppe"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde07073-0b96-48e2-895d-26a78bf71e55",
                                                "sense_id": "be61aa39-74d8-32cd-b953-2f5b1a0d6386",
                                                "text": "Die Dissonanzen innerhalb des Kollegiums wurden immer krasser."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
