                        ]
                    },
                    {
                        "sense_id": "53b37511-f698-3ff5-907c-629a8656d132",
                        "entry_id": "e232ac04-b815-30a7-9886-a49d26e6c211",
                        "glosses": [
                            "de gebouwen op een stuk grond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6dd249-a911-4eed-8b48-a972ed2b2ea4",
                                "sense_id": "53b37511-f698-3ff5-907c-629a8656d132",
                                "text": "Op rijksniveau wordt in de Nota Ruimte 2006 een paragraaf gewijd aan 'Optimale benutting van de bestaande bebouwing en ruimte voor nieuwbouw'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f10d31f3-7f4e-45e9-ad18-dc01df76bcb1",
                        "source_entry_id": "e232ac04-b815-30a7-9886-a49d26e6c211",
                        "source_sense_id": "d6eb5377-b261-342b-a2f9-d6195f7b42b7",
                        "source_sense_description": "het construeren van een gebouw op een stuk land",
