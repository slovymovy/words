                            "future"
                        ],
                        "form": "буду/будешь… просма́триваться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b4c0d9d-5c12-3f4f-a1a2-81246af49a28",
                        "entry_id": "f56d9b46-27d8-34cf-9b49-c3dc7aeb8dbb",
                        "glosses": [
                            "быть видимым, доступным для наблюдения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24372161-9363-47dd-a19b-b2baf177530f",
                                "sense_id": "4b4c0d9d-5c12-3f4f-a1a2-81246af49a28",
                                "text": "При хорошей маскировке должны отчетливо просматриваться позиции врага, а ты должен быть незаметен."
                            },
                            {
                                "example_id": "b7d394e2-71b8-4a2d-9827-42f037745dd6",
                                "sense_id": "4b4c0d9d-5c12-3f4f-a1a2-81246af49a28",
                                "text": "От поворота хорошо просматривались все три ряда гаражей."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b7fbe2a-0f57-361c-ae8e-97cd178e4de1",
                        "entry_id": "f56d9b46-27d8-34cf-9b49-c3dc7aeb8dbb",
                        "glosses": [
                            "перен. быть различимым; иметь место; обнаруживаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2898833-2d02-43fa-8589-9bd29eea7440",
                                "sense_id": "1b7fbe2a-0f57-361c-ae8e-97cd178e4de1",
                                "text": "Потому что это — мемуарный поток сознания и явной логики здесь просматриваться не может."
                            },
                            {
                                "example_id": "dd6232f1-00aa-472b-9217-e7aeb0bc9b58",
                                "sense_id": "1b7fbe2a-0f57-361c-ae8e-97cd178e4de1",
                                "text": "Через озорство и разухабистость песни на полном серьезе должны просматриваться национальное самосознание и гордость народа, впервые выходящего на морской простор."
                            }
                        ]
                    },
                    {
                        "sense_id": "81a116a9-f01e-3789-a31c-c6328e249973",
                        "entry_id": "f56d9b46-27d8-34cf-9b49-c3dc7aeb8dbb",
                        "glosses": [
                            "страд. к просматривать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "e45ea618-f39d-40c7-96af-a20e67840f0c",
                                "sense_id": "81a116a9-f01e-3789-a31c-c6328e249973",
                                "text": "Бумаги из портфеля явно вынимались и просматривались."
                            }
                        ]
                    }
                ],
