    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "526bdc81-4d38-3000-86eb-11da323a1268",
                "word": "krait",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "147bd185-63c7-4634-951e-b0f07df2e339",
                        "entry_id": "526bdc81-4d38-3000-86eb-11da323a1268",
                        "tags": [
                            "plural"
                        ],
                        "form": "kraits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                        "entry_id": "526bdc81-4d38-3000-86eb-11da323a1268",
                        "glosses": [
                            "Any of several brightly-coloured, venomous snakes, of the genus Bungarus, of southeast Asia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079cd2ee-4f71-445d-b4fa-f7c8ddef5bf2",
                                "sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                                "text": "On visiting the General Hospital, on the morning of the 22nd of August, I was informed that one of the punkah coolies had been bitten about 8.30 p.m., the night before, by a krait, whose venom is virulently poisonous."
                            },
                            {
                                "example_id": "4ca2331f-956a-4a27-b88b-db664305b00c",
                                "sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                                "text": "Now, if you run into one of these kraits, you better NOT run away else you're a goner. It'll catch you for sure and you will die in your tracks."
                            },
                            {
                                "example_id": "cfabe284-5e3f-4bc5-a091-30cb2ec745a3",
                                "sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                                "text": "Very much in my thoughts is Joe Slowinski, a herpetologist killed a few years earlier by a misidentified juvenile krait, a snake so small that he couldn't tell if the fang had punctured the skin."
                            },
                            {
                                "example_id": "b0ae3e0a-d229-4fb1-a113-b475d01f5f30",
                                "sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                                "text": "India has a healthy share of poisonous snakes, including kraits, cobras, and two species of vipers, yet Hindu traditions are overwhelmingly snake-friendly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830f0bbd-c879-41cb-aa23-b1b05b09a793",
                        "source_entry_id": "526bdc81-4d38-3000-86eb-11da323a1268",
                        "source_sense_id": "a8e0b56a-086f-388b-8d37-ef3f332a263c",
                        "source_sense_description": "snake",
                        "target_lang_word": "bongare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bongare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46db728c-01c5-3474-97a7-0c36f3e745ed",
                                        "entry_id": "b290ec7f-6706-32bd-b6b7-82d7be96d394",
                                        "glosses": [
                                            "Serpent très venimeux d’Inde."
                                        ],
                                        "tags": [
                                            "Ophiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0701e279-2d69-4990-88d4-614e18a954ba",
                                                "sense_id": "46db728c-01c5-3474-97a7-0c36f3e745ed",
                                                "text": "Une bigote qui jase d’une dévote est plus venimeuse que l’aspic et le bongare bleu."
                                            },
                                            {
                                                "example_id": "1a5854dd-3ede-4812-9c20-28532d702fe2",
                                                "sense_id": "46db728c-01c5-3474-97a7-0c36f3e745ed",
                                                "text": "Sur la standardisation du sérum antivenimeux polyvalent préparé par l’Institut Haffkine contre les venins des quatre serpents les plus communs dans l’Inde (cobra, bongare bleu, vipère de Russell et échide carénée)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
