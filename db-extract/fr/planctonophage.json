                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7197cff9-fc32-47c2-9b17-33f3cdc73da0",
                                "sense_id": "34bde8dc-2b46-305c-add9-113944e30e1b",
                                "text": "Tout alevin, quel que soit le régime alimentaire de l’adulte, commence par être planctonophage."
                            },
                            {
                                "example_id": "75cd0278-0e37-4ef1-906e-e14a9c8dae3e",
                                "sense_id": "34bde8dc-2b46-305c-add9-113944e30e1b",
                                "text": "Si tout jeune notre poisson est planctonophage, en grandissant il devient rapidement carnivore très opportuniste et se nourrit de poissons, d’écrevisses, de moules, d’escargots d'eau, de grenouilles et autres rongeurs qui se hasardent au-dessus de ses postes."
                            }
                        ]
                    }
