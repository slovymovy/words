            "senses": [
                {
                    "sense_id": "5b510653-7732-3e45-aefc-01debdcb210f",
                    "sense_definition": "Characterized by very precise, conscientious attention to details.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "precise attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective conducted a <w>meticulous</w> search of the crime scene to ensure no evidence was missed.",
                            "target_lang_translations": {
                                "ru": "Детектив провел <w>тщательный</w> осмотр места преступления, чтобы убедиться, что ни одна улика не была упущена."
                            }
                        },
                        {
                            "text": "She is known for her <w>meticulous</w> attention to detail when editing complex legal documents.",
                            "target_lang_translations": {
                                "ru": "Она известна своим <w>скрупулёзным</w> вниманием к деталям при редактировании сложных юридических документов."
                            }
                        }
                    ],
                    "synonyms": [
                        "painstaking",
                        "fastidious",
                        "scrupulous",
                        "punctilious",
                        "thorough",
                        "precise"
                    ],
                    "antonyms": [
                        "sloppy",
                        "careless",
                        "slapdash",
                        "perfunctory",
                        "haphazard",
                        "slipshod"
                    ],
                    "common_phrases": [
                        "meticulous attention to detail",
                        "meticulous planning",
                        "meticulous research",
                        "meticulous preparation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся очень точным, добросовестным вниманием к деталям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрупулёзный",
                                "target_lang_sense_clarification": "чрезвычайно тщательный и точный до мелочей"
                            },
                            {
                                "target_lang_word": "тщательный",
                                "target_lang_sense_clarification": "очень подробный и аккуратный"
                            },
                            {
                                "target_lang_word": "дотошный",
                                "target_lang_sense_clarification": "вникающий во все подробности, часто в разговорном контексте"
                            },
                            {
                                "target_lang_word": "педантичный",
                                "target_lang_sense_clarification": "строго следующий правилам и деталям"
                            }
                        ]
