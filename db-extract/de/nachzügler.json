                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latecomer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0055a39-0f0c-355b-af20-28928d0e5491",
                                        "entry_id": "d1496c48-21b1-3c2c-9f2c-9741301f4500",
                                        "glosses": [
                                            "One who has arrived comparatively recently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf997e67-51a4-44e7-9754-833fe26b5008",
                                                "sense_id": "e0055a39-0f0c-355b-af20-28928d0e5491",
                                                "text": "The old families in the neighborhood look down on him as a latecomer, his family only arrived in the 18th century, too nouveau for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b715c9af-68c0-33b8-bfd5-194167f93511",
                                        "entry_id": "d1496c48-21b1-3c2c-9f2c-9741301f4500",
                                        "glosses": [
                                            "One who arrived late."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517b4538-3b9d-47d1-bce6-7c88622c82ec",
                                                "sense_id": "b715c9af-68c0-33b8-bfd5-194167f93511",
                                                "text": "At the party the host made a point of greeting all the latecomers he missed in the first pass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2904fce9-acb4-4529-ba52-17ec0c171a5e",
                        "source_entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "source_sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                        "source_sense_description": "eine Person, die mit Abstand als letzte oder sehr spät an einem Treffpunkt erscheint",
                        "target_lang_word": "straggler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straggler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1755c58b-cd8e-347f-a46f-f45bab8d0cbf",
                                        "entry_id": "31dccc53-01c5-3926-aa9c-03467b702a90",
                                        "glosses": [
                                            "Someone who goes against the direct or proper course, or from the company to which they belong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e548dbb-4dad-4896-8052-9b85f14d7fe3",
                                                "sense_id": "1755c58b-cd8e-347f-a46f-f45bab8d0cbf",
                                                "text": "She recounted her life in pre-World War II Eastern Europe and how a ragtag band of Red Army stragglers, escaped prisoners of war and Jewish and gentile Resistance fighters — including some women — harassed the Germans behind the Wehrmacht’s front lines in the forests and swamps of what is now Belarus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c4f8ac-9223-30c6-86f8-cece1a4cbe63",
                                        "entry_id": "31dccc53-01c5-3926-aa9c-03467b702a90",
                                        "glosses": [
                                            "One who falls behind the rest, for example in a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d882e30-da4a-41ef-b891-25c790ad1aeb",
                                                "sense_id": "e9c4f8ac-9223-30c6-86f8-cece1a4cbe63",
                                                "text": "This isn't the 1970s, when the UK stood out as the European straggler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89697075-520c-3b32-81bb-1df0f204d02c",
                                        "entry_id": "31dccc53-01c5-3926-aa9c-03467b702a90",
                                        "glosses": [
                                            "One who roams without any settled direction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "183b4c56-c3c4-325a-a07f-4012f049efb7",
                                        "entry_id": "31dccc53-01c5-3926-aa9c-03467b702a90",
                                        "glosses": [
                                            "A migratory animal found away from its usual range."
                                        ],
