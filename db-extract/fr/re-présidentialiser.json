                "senses": [
                    {
                        "sense_id": "b60e21ad-31a3-39ac-bdb3-d76d6db9982c",
                        "entry_id": "ed7bdc1d-9a21-337a-a47f-80c045e08194",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de représidentialiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a7a2f5-2b2e-4de7-9710-17cc6d86fedc",
                                "sense_id": "b60e21ad-31a3-39ac-bdb3-d76d6db9982c",
                                "text": "C'est encore plus vrai dans un régime semi-présidentiel comme celui de la France qui s'est fortement re-présidentialisé et dont le système de partis s'oriente vers un bipartisme imparfait comme l'ont montré les scrutins de 2007."
                            },
                            {
                                "example_id": "4ee574a3-e3db-4e57-8b5e-67328eb4402f",
                                "sense_id": "b60e21ad-31a3-39ac-bdb3-d76d6db9982c",
                                "text": "En novlangue sarkozyenne, on appelle cela se « re-présidentialiser »."
                            },
                            {
                                "example_id": "16f2f729-8da3-480f-a057-8055df8461ba",
                                "sense_id": "b60e21ad-31a3-39ac-bdb3-d76d6db9982c",
                                "text": "Comme si elle s'était « re-présidentialisée », dit un juré."
                            },
                            {
                                "example_id": "782da4bf-d46e-4699-b8c4-f43595a93d79",
                                "sense_id": "b60e21ad-31a3-39ac-bdb3-d76d6db9982c",
                                "text": "Comment Nicolas Sarkozy peut-il se \"re-présidentialiser\"?"
                            }
                        ]
                    }
