                "senses": [
                    {
                        "sense_id": "b8004a57-837d-32b3-8c78-f17a2d32a646",
                        "entry_id": "f82f57d2-485c-3cfc-83df-80c32cf821ce",
                        "glosses": [
                            "To reduce (something) to its essence."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1005e0ac-a7d4-37eb-8319-245962468fe8",
                        "entry_id": "f82f57d2-485c-3cfc-83df-80c32cf821ce",
                        "glosses": [
                            "To misrepresent (something) by oversimplifying a summary of its essence."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "737bb698-7cbd-4077-8235-0caef97a6a00",
                                "sense_id": "1005e0ac-a7d4-37eb-8319-245962468fe8",
                                "text": "“This is an essentializing of Hinduism,” Ms. Narayanan said, “and the diversity of Hinduism in India is lost here.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "acbcb804-063b-3575-b223-d33cf4a7d9ed",
                        "entry_id": "f82f57d2-485c-3cfc-83df-80c32cf821ce",
                        "glosses": [
                            "To misrepresent (a characteristic of something) by falsely portraying it as essential to the whole (that is, implying that it defines the whole's essence)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c63df49f-895c-4b51-bf45-9cf9fc800ac2",
                                "sense_id": "acbcb804-063b-3575-b223-d33cf4a7d9ed",
                                "text": "to essentialize race by stereotyping \"what Whites do\" or \"how Blacks think\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "582bbb1f-adbd-4103-b4e3-21bc6dc9f169",
                        "source_entry_id": "f82f57d2-485c-3cfc-83df-80c32cf821ce",
                        "source_sense_description": "to reduce to its essence",
                        "target_lang_word": "essentialiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essentialiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1f368e-1c71-394e-a33e-3b5edb00c292",
                                        "entry_id": "ca6c2355-e746-39b1-9277-e668af953647",
                                        "glosses": [
                                            "Considérer du point de vue essentialiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce91d0e-c429-43a5-81d3-5502f4b54dfa",
                                                "sense_id": "0a1f368e-1c71-394e-a33e-3b5edb00c292",
                                                "text": "L'activité qui consiste à essentialiser n'est donc pas l'apanage de l'État."
                                            },
                                            {
                                                "example_id": "2ad691a3-71e7-4c4e-9475-6aeed4cf72d5",
                                                "sense_id": "0a1f368e-1c71-394e-a33e-3b5edb00c292",
                                                "text": "Le tort de la philosophie, depuis Platon, est d'avoir cru pouvoir essentialiser le réel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ed0fe4-1e7f-3891-9856-2ce2972f1d5b",
                                        "entry_id": "ca6c2355-e746-39b1-9277-e668af953647",
                                        "glosses": [
                                            "Réduire un individu, une entité, à une seule de ses dimensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b21860ce-9454-4d3a-a66f-d308ce4ced59",
                                                "sense_id": "89ed0fe4-1e7f-3891-9856-2ce2972f1d5b",
                                                "text": "Les idéologues du choc des civilisations, qui essentialisent les identités, les cultures et les religions, n’ont que faire des incertitudes et des précautions d’une pensée complexe de cette crise multiforme, où les sursauts démocratiques côtoient des précipices sanglants."
                                            },
                                            {
                                                "example_id": "4b656d4f-b73f-413f-9b7b-b1d7da510555",
                                                "sense_id": "89ed0fe4-1e7f-3891-9856-2ce2972f1d5b",
                                                "text": "Ettore Majorana… Ce nom sonne d’abord comme le surgissement d’une absence. Car cet homme-là a fini par s’essentialiser dans sa disparition, qu’il a orchestrée d’une façon telle qu’elle a éclipsé son existence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
