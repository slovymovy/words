                "senses": [
                    {
                        "sense_id": "655b83c8-0a43-3f59-9a14-752342564c86",
                        "entry_id": "91762aff-10ff-3c68-a466-a2f0015ae14a",
                        "glosses": [
                            "Manque de produit dans une terre, dans une ferme, dans une maison."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "f252cf5d-dbf0-49d5-92df-b4b01906a720",
                                "sense_id": "655b83c8-0a43-3f59-9a14-752342564c86",
                                "text": "En enfance depuis la Révolution, ce vieillard est mort en 1832, à quatre-vingt-seize ans, et Madame n’a pu se décider à y mettre aussitôt un étranger, mais elle ne peut plus supporter de non-valeurs."
                            },
                            {
                                "example_id": "a62622ac-1c92-48d3-b85f-d55cb585dfb4",
                                "sense_id": "655b83c8-0a43-3f59-9a14-752342564c86",
                                "text": "Cette terre était affermée trente mille francs, mais elle a fort diminué à cause des non-valeurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "30e1a59c-ea6b-3f05-bb1d-929db2661603",
                        "entry_id": "91762aff-10ff-3c68-a466-a2f0015ae14a",
                        "glosses": [
                            "Partie d’impositions qu’on n’a pu lever, créances qu’on n’a pu recouvrer."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "6cdd333a-df7e-4667-ad7c-76bf9171eda6",
                                "sense_id": "30e1a59c-ea6b-3f05-bb1d-929db2661603",
                                "text": "Lors du dernier conseil municipal de Gourdon-Murat, les élus ont voté l’admission en non-valeur de produits irrécouvrables sur le budget principal."
                            }
                        ]
                    },
                    {
                        "sense_id": "159c81a4-4c6e-366e-a48d-989781740078",
                        "entry_id": "91762aff-10ff-3c68-a466-a2f0015ae14a",
                        "glosses": [
                            "Homme qu’on ne peut compter ni pour le service de campagne ni pour le combat."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b69e2fe-cd21-3fc4-a9bd-0953bfd60c7f",
                        "entry_id": "91762aff-10ff-3c68-a466-a2f0015ae14a",
                        "glosses": [
                            "Personne incapable dans une profession quelconque."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a018b841-6159-4f67-a5fd-27e518923783",
                                "sense_id": "3b69e2fe-cd21-3fc4-a9bd-0953bfd60c7f",
                                "text": "On n’a pu garder cet employé, c’était une non-valeur."
                            }
                        ]
                    }
