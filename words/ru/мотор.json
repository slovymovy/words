    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f2b8867-f3be-39c8-ba46-4e8cacd2218b",
                    "sense_definition": "Устройство, преобразующее какой-либо вид энергии (тепловую, электрическую и др.) в механическую работу; двигатель.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "engine_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель попытался завести <w>мотор</w>, но машина не реагировала.",
                            "target_lang_translations": {
                                "en": "The driver tried to start the <w>engine</w>, but the car didn't react.",
                                "fr": "Le conducteur a essayé de démarrer le <w>moteur</w>, mais la voiture n'a pas réagi."
                            }
                        },
                        {
                            "text": "Мощный <w>мотор</w> позволял лодке быстро набирать скорость.",
                            "target_lang_translations": {
                                "en": "The powerful <w>motor</w> allowed the boat to pick up speed quickly.",
                                "fr": "Le puissant <w>moteur</w> permettait au bateau de prendre rapidement de la vitesse."
                            }
                        }
                    ],
                    "synonyms": [
                        "двигатель",
                        "движок"
                    ],
                    "common_phrases": [
                        "завести мотор",
                        "заглушить мотор",
                        "шум мотора",
                        "рев мотора"
                    ],
                    "target_lang_definitions": {
                        "en": "A machine that converts energy into mechanical force or motion.",
                        "fr": "Appareil qui transforme une forme quelconque d'énergie (thermique, électrique, etc.) en travail mécanique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "engine",
                                "target_lang_sense_clarification": "internal combustion"
                            },
                            {
                                "target_lang_word": "motor",
                                "target_lang_sense_clarification": "electric or general device"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "moteur",
                                "target_lang_sense_clarification": "appareil ou dispositif mécanique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb1674eb-8819-3e33-a824-209e3a82be93",
                    "sense_definition": "Такси или частный автомобиль, занимающийся извозом.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы опаздывали на встречу и решили поймать <w>мотор</w>.",
                            "target_lang_translations": {
                                "en": "We were late for the meeting and decided to catch a <w>cab</w>.",
                                "fr": "Nous étions en retard pour le rendez-vous et avons décidé de prendre un <w>taxi</w>."
                            }
                        },
                        {
                            "text": "Водитель <w>мотора</w> хорошо знал город и быстро довёз нас до места.",
                            "target_lang_translations": {
                                "en": "The <w>cab</w> driver knew the city well and quickly got us to the place.",
                                "fr": "Le chauffeur de <w>taxi</w> connaissait bien la ville et nous a rapidement conduits à destination."
                            }
                        }
                    ],
                    "synonyms": [
                        "такси",
                        "частник",
                        "бомбила"
                    ],
                    "common_phrases": [
                        "поймать мотор",
                        "взять мотор"
                    ],
