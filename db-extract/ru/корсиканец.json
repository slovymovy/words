                                    {
                                        "sense_id": "0566141e-0773-3243-81c0-db635345f1cd",
                                        "entry_id": "fc5ce7fe-5eb8-3c87-ac7b-12d534c58d08",
                                        "glosses": [
                                            "Bewohner der Insel Korsika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f211a2f-c4da-4e1f-8cb8-a1a6c71e5f1b",
                                                "sense_id": "0566141e-0773-3243-81c0-db635345f1cd",
                                                "text": "„Auch der berühmte Kaiser Napoléon Bonaparte war Korse.“"
                                            },
                                            {
                                                "example_id": "d0094956-2274-4996-96be-39cd1cff9012",
                                                "sense_id": "0566141e-0773-3243-81c0-db635345f1cd",
                                                "text": "„Die Kreter sind ein wenig wie die Korsen in Frankreich. Wie diese Insulaner pflegen sie eine kritische Distanz zur Zentralregierung auf dem Festland.“"
                                            },
                                            {
                                                "example_id": "d00d2efd-176e-4ee9-8a91-34f5cd6ffa06",
                                                "sense_id": "0566141e-0773-3243-81c0-db635345f1cd",
                                                "text": "„Unten reden die Korsen miteinander.“"
                                            },
                                            {
                                                "example_id": "650ed15c-329a-4f83-b1f6-f0b2dc56f1f1",
                                                "sense_id": "0566141e-0773-3243-81c0-db635345f1cd",
                                                "text": "„Der Korse nahm gähnend zur Kenntnis, daß Weidel gleich Seidler sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
