                        "sense_id": "5d01038b-ba97-3409-a17a-951269bba688",
                        "entry_id": "ae1a2a2c-8e3e-30f3-bb34-6594432f6607",
                        "glosses": [
                            "Action de fleurir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa3c241-3c70-4170-a7d5-fedcb02af547",
                                "sense_id": "5d01038b-ba97-3409-a17a-951269bba688",
                                "text": "Mardi 12 mai. Journée passée au jardin, dans le fleurissement des roses, le chant des oiseaux, la lumière printanière."
                            },
                            {
                                "example_id": "f6d21614-c213-4cb3-957e-7c26828e95bd",
                                "sense_id": "5d01038b-ba97-3409-a17a-951269bba688",
                                "text": "Le fleurissement des magnolias sera ce soir achevé.\nSauf celui-ci, qu’elle cueillit ce soir en revenant du port. Le temps fuit, égal à lui-même, sur ce fleurissement oublié."
                            }
                        ]
