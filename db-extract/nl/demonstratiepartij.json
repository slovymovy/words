                        "glosses": [
                            "wedstrijd tussen twee sporters waarbij het gaat om te laten zien hoe men de sport dient te spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e2d29c-1664-451e-ab43-1809fbc2fd7f",
                                "sense_id": "e6e146a1-ac13-3adb-bf9a-46c4746304f8",
                                "text": "Federer zou het in de eindstrijd opnemen tegen Novak Djokovic, die het toernooi nu voor de derde keer op zijn naam schrijft. Djokovic speelt nu, als pleister op de wonde voor het publiek, een demonstratiepartij tegen Andy Murray."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b964b6b-4088-34ed-afb6-0994bb623413",
                        "entry_id": "e81177b2-482c-3bf0-bb32-1eac8394d8d6",
                        "glosses": [
                            "experimentele wedstrijd tussen twee sporters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f34679-a98d-4934-abe1-b944b2c96ff4",
                                "sense_id": "3b964b6b-4088-34ed-afb6-0994bb623413",
                                "text": "Federer is sowieso niet vies om nieuwe dingen uit te proberen. Zo speelt hij in januari een demonstratiepartij met Lleyon Hewitt, eveneens met aangepaste regels. Toch is hij er niet voor om het tennis radicaal te veranderen. \"Ik ben zeer traditioneel en daarnaast tevreden hoe onze sport er momenteel voor staat. Er is niets mis met ons huidige scoringssysteem.\""
                            }
                        ]
                    }
