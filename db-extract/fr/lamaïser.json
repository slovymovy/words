                "senses": [
                    {
                        "sense_id": "08b54ad5-1f94-3d6d-bac1-956c1899d5ac",
                        "entry_id": "8f648218-6f76-32db-9357-6ea523c8b23c",
                        "glosses": [
                            "Donner un caractère lamaïque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7953a9c9-b1a2-42a0-aafc-3634b740068d",
                                "sense_id": "08b54ad5-1f94-3d6d-bac1-956c1899d5ac",
                                "text": "Cette catégorie de dieux tibétains, qui trouve son origine dans les croyances indigènes prébouddhiques, a été largement mise à contribution pour lamaïser les lieux funéraires chamaniques en Mongolie et en Bouriatie (Lamaizm v Burjatii..., 155; cf. ci-dessous le commentaire du texte 27.2)."
                            },
                            {
                                "example_id": "5e12f5bf-58e5-430d-b795-fb013f6461ea",
                                "sense_id": "08b54ad5-1f94-3d6d-bac1-956c1899d5ac",
                                "text": "Le morceau du jour qui lamaïse les métalleux"
                            },
                            {
                                "example_id": "8cdfd646-29a7-499e-ae2a-4e417e009122",
                                "sense_id": "08b54ad5-1f94-3d6d-bac1-956c1899d5ac",
                                "text": "Si tu pouvais lamaïser le gros Pierre Ménès un de ces jours"
                            }
                        ]
                    }
