                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rembarquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec5e160-f6e4-3598-a58b-4ed528317cc4",
                                        "entry_id": "65c5f15f-43c5-3eac-a43f-d8a047164186",
                                        "glosses": [
                                            "Embarquer de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818c5abf-9c33-4f33-9bd2-e53f84a2db67",
                                                "sense_id": "6ec5e160-f6e4-3598-a58b-4ed528317cc4",
                                                "text": "L'Islande me paraissait un pays affreux ; je regrettais la folle inspiration qui m'y avait conduit, et me promettais, ô faiblesse et inconstance humaines ! de me rembarquer au plus tôt pour l'Europe."
                                            },
                                            {
                                                "example_id": "da830dd0-5016-4f85-91fc-cd071009f6b7",
                                                "sense_id": "6ec5e160-f6e4-3598-a58b-4ed528317cc4",
                                                "text": "On a rembarqué les troupes qu’on avait été obligé de débarquer à cause du mauvais temps. — Rembarquer des marchandises."
                                            },
                                            {
                                                "example_id": "4e6a12de-027c-4a60-a754-2a2b1c0c1bd4",
                                                "sense_id": "6ec5e160-f6e4-3598-a58b-4ed528317cc4",
                                                "text": "Le soleil déclinait et les lancinants symphonistes du soir accordaient flûtes et chachas, lorsque les policiers se rembarquèrent avec Marie-Socrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4afb02c8-0283-3a65-8954-fd1933f98f6f",
                                        "entry_id": "65c5f15f-43c5-3eac-a43f-d8a047164186",
                                        "glosses": [
                                            "Entraîner, engager de nouveau."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a603844-3694-4e97-894a-c575294409ea",
                                                "sense_id": "4afb02c8-0283-3a65-8954-fd1933f98f6f",
                                                "text": "Une façon pour Benjamin Griveaux et LaREM de ne pas insulter l’avenir, explique son entourage. \"L’espoir, explique-t-on chez Benjamin Griveaux, reste de le rembarquer dans l’aventure commune\"."
                                            },
                                            {
                                                "example_id": "9f80c964-5484-4f57-8b69-a81ad18e499b",
                                                "sense_id": "4afb02c8-0283-3a65-8954-fd1933f98f6f",
                                                "text": "Il s’est rembarqué avec ces gens-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "072205d8-6515-33d9-b9c1-253a70e8ac7b",
                                        "entry_id": "65c5f15f-43c5-3eac-a43f-d8a047164186",
                                        "glosses": [
                                            "S’embarquer de nouveau."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558c9876-449d-48c5-8ca7-90cd90ef0e95",
                                                "sense_id": "072205d8-6515-33d9-b9c1-253a70e8ac7b",
                                                "text": "Par le regard ciblé d’une poignée de protagonistes, une nouvelle évocation de la fameuse « Opération Dynamo » qui, en juin 1940, a permis à ce qu’il restait du corps expéditionnaire britannique de rembarquer en pleine débâcle…"
                                            },
                                            {
                                                "example_id": "1b13a3c5-a624-4e93-845d-e58b5597ea4c",
                                                "sense_id": "072205d8-6515-33d9-b9c1-253a70e8ac7b",
                                                "text": "La ville n’était pas fortifiée, les pirates, les Anglais, les Espagnols descendaient, pillaient, brûlaient et rembarquaient pour bientôt revenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
