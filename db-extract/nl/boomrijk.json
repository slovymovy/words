                "senses": [
                    {
                        "sense_id": "ad6d317d-856d-358d-8cac-cdd5eb64130c",
                        "entry_id": "38393a32-c883-3f14-86a4-1081a869398d",
                        "glosses": [
                            "rijk aan bomen en bossen, dicht met bomen beplant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a839d102-4f80-492d-bde3-401f339d1782",
                                "sense_id": "ad6d317d-856d-358d-8cac-cdd5eb64130c",
                                "text": "De aanhef van de bundel neemt je mee in een van de vele meanders van de Schelde, met zijn typisch boomrijk landschap, zijn watergronden, het trompen van de boten, het water dat de landschappen scheidt en onbereikbaar maakt, de waterkant, de geur van teer en slijk, de fauna en de flora in de dagen van mist en isolatie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b41263c-6b25-4b81-b54b-7975bb2251e1",
                        "source_entry_id": "38393a32-c883-3f14-86a4-1081a869398d",
                        "source_sense_id": "ad6d317d-856d-358d-8cac-cdd5eb64130c",
                        "source_sense_description": "rijk aan boomen en bosschen, dicht met bomen beplant",
                        "target_lang_word": "baumreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baumreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c22475f8-5f91-3fe6-97ad-bda16f383fc3",
                                        "entry_id": "9f68e8cc-356f-3b31-b687-5b6fa067d45e",
                                        "glosses": [
                                            "mit vielen Bäumen versehen; die Eigenschaft des Baumbestandes für ein bestimmtes Gebiet oder Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1461d8-8dc3-42d6-b850-001cd3c8bede",
                                                "sense_id": "c22475f8-5f91-3fe6-97ad-bda16f383fc3",
                                                "text": "„Zu Lesbos auf der Jagd, in einem Haine der Nymphen, sah ich den schönsten Gegenstand, den ich je gesehen, ein Werk der Malerei, eine Geschichte der Liebe. Schön war wohl auch der Hain, baumreich, blumengeschmückt und wohlbewässert: eine Quelle nährte alles, so die Blumen als die Bäume.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d36e54f-74f5-4ca6-b38f-f9c8025894cb",
                        "source_entry_id": "38393a32-c883-3f14-86a4-1081a869398d",
