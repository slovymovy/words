                ],
                "senses": [
                    {
                        "sense_id": "b58ecdee-cb85-3f9a-b85a-27ded7fbeb45",
                        "entry_id": "49e9447b-e966-388d-aa0a-e8ac69ba2333",
                        "glosses": [
                            "Engager quelqu’un par des promesses, par des cajoleries, à faire ce qu’on souhaite de lui."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b869a52c-2bb1-4461-bff2-8bde267675fd",
                                "sense_id": "b58ecdee-cb85-3f9a-b85a-27ded7fbeb45",
                                "text": "Mais fût-elle comtesse ou baronne, cette dame ne saurait nous tirer du traquenard où nous seront tôt ou tard emboisés.' — (Honoré de Balzac, Les Proscrits, 1831)"
                            },
                            {
                                "example_id": "85748144-6cfe-46c0-b9c3-6902dbf36baa",
                                "sense_id": "b58ecdee-cb85-3f9a-b85a-27ded7fbeb45",
                                "text": "Est-ce ma faute à moi, si madame l’emboise ?"
                            },
                            {
                                "example_id": "b8d9123b-22d3-4b08-adb5-4450ce40a09f",
                                "sense_id": "b58ecdee-cb85-3f9a-b85a-27ded7fbeb45",
                                "text": "J’aime Modeste, elle est mon élève, elle doit faire un beau mariage… Et j’emboiserais le duc, s’il le fallait."
                            }
                        ]
                    }
                ],
