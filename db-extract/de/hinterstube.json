                ],
                "senses": [
                    {
                        "sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                        "entry_id": "86a0bf56-9e02-3f55-9f5d-5b6fb940946b",
                        "glosses": [
                            "Nebenzimmer, auf der Rückseite eines Hauses gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568fe7d5-88a1-4d53-8670-a27aaede527b",
                                "sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                                "text": "Aus der Hinterstube kamen Geräusche."
                            },
                            {
                                "example_id": "45af9a7e-468f-4b88-be36-dc761696bc30",
                                "sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                                "text": "„Der Raum ist voll; der Kellner macht eine Tür auf, eine enge Hinterstube ist frei.“"
                            },
                            {
                                "example_id": "973ff057-cffc-4842-8f4f-d0932e0fb25b",
                                "sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                                "text": "„Er spielt auf seinem Tenorhorn, sommers am Waldrand, winters in der Hinterstube bei Kerzenlicht.“"
                            },
                            {
                                "example_id": "33bb5ff8-1770-4fc4-ad4e-05ee3d596a18",
                                "sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                                "text": "„Ja, Ruhe, danach verlangte Cécile, die sich denn auch unverweilt in eine nach einem Gärtchen hinaus gelegene Hinterstube zurückzog, wo die Fenster aufstanden und die kleinen gelben Gardinen im Luftzuge wehten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8a1d945-a1ea-49d9-a07d-cfd86cbe5a83",
                        "source_entry_id": "86a0bf56-9e02-3f55-9f5d-5b6fb940946b",
                        "source_sense_id": "43c06df2-fe85-37ee-94d9-648c5bc273cc",
                        "source_sense_description": "Nebenzimmer, auf der Rückseite eines Hauses gelegen",
                        "target_lang_word": "arrière-salle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-salle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                        "entry_id": "f7197311-3c01-35d9-ba77-ee4c41030d9f",
                                        "glosses": [
                                            "Salle secondaire séparée de la salle principale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e139f8-2d5b-40f5-8280-468c24e60b09",
                                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                                "text": "Comme tout bistro qui se respecte, celui-ci réservait aux habitués une arrière-salle et deux étages de chambres meublées […]."
                                            },
                                            {
                                                "example_id": "b883558f-92ad-4a0a-a265-44962c5d5519",
                                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                                "text": "Et il faut que notre expérience s'incline devant les idées préconçues et les principes d'un tas de crétins, envoyés à la Chambre parce qu'ils ont bien déliré pendant les trois semaines d'une période électorale dans les arrière-salles de café."
                                            },
                                            {
                                                "example_id": "c34a052c-52cc-46a3-ab1d-5b9ce61bc3f3",
                                                "sense_id": "8bcc5e8c-816b-3c4b-af35-ab3670e85bf8",
                                                "text": "Gabriel Morange désigna celle de droite, à la poitrine plus opulente. Elle lui adressa un sourire noirci par la noix d'arec et l'attira vers l'arrière-salle où elle s'allongea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
