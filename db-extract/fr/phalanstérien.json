            {
                "entry_id": "6e3859fa-704d-37ec-a519-9c936f083063",
                "word": "phalanstérien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b755afc-8fea-4edf-a326-1b319309ac64",
                        "entry_id": "6e3859fa-704d-37ec-a519-9c936f083063",
