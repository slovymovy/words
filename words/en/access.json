{
    "word_family": [
        "accessible",
        "accessibility",
        "inaccessible",
        "accession",
        "accessory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c43186b3-f1ab-3871-b723-a336965fc1e7",
                    "sense_definition": "The right, opportunity, or ability to enter a place, use something, or see someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "entry_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students have free <w>access</w> to the library resources during the weekend.",
                            "target_lang_translations": {
                                "ru": "Студенты имеют свободный <w>доступ</w> к библиотечным ресурсам в выходные дни."
                            }
                        },
                        {
                            "text": "The security guard denied <w>access</w> to anyone without a valid ID card.",
                            "target_lang_translations": {
                                "ru": "Охранник запретил <w>вход</w> всем, у кого не было действующего удостоверения личности."
                            }
                        }
                    ],
                    "synonyms": [
                        "admission",
                        "admittance",
                        "entry",
                        "entrance"
                    ],
                    "antonyms": [
                        "exclusion"
                    ],
                    "common_phrases": [
                        "gain access",
                        "have access to",
                        "deny access",
                        "unauthorized access",
                        "easy access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право, возможность или способность войти в какое-либо место, использовать что-либо или увидеть кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доступ",
                                "target_lang_sense_clarification": "возможность пользоваться или входить"
                            },
                            {
                                "target_lang_word": "допуск",
                                "target_lang_sense_clarification": "официальное разрешение на вход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "464fd6c6-0bb1-36af-a676-f1c9dc8d0a67",
                    "sense_definition": "The means or opportunity to connect to the Internet or retrieve data from a computer system.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel provides high-speed internet <w>access</w> in all guest rooms.",
                            "target_lang_translations": {
                                "ru": "Отель предоставляет высокоскоростной <w>доступ</w> в интернет во всех гостевых номерах."
                            }
                        },
                        {
                            "text": "We need immediate <w>access</w> to the database to fix the error.",
                            "target_lang_translations": {
                                "ru": "Нам нужен немедленный <w>доступ</w> к базе данных, чтобы исправить ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "connection",
                        "connectivity"
                    ],
                    "common_phrases": [
                        "internet access",
                        "data access",
                        "remote access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средства или возможность подключения к Интернету или получения данных из компьютерной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доступ",
                                "target_lang_sense_clarification": "к интернету или базе данных"
                            },
                            {
                                "target_lang_word": "подключение",
                                "target_lang_sense_clarification": "соединение с сетью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c1929dc-29cf-39e6-91b1-12712e385e68",
                    "sense_definition": "A physical way of entering or reaching a place, such as a path, door, or passage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entry_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The only <w>access</w> to the remote farmhouse is via a narrow dirt road.",
                            "target_lang_translations": {
                                "ru": "Единственный <w>подъезд</w> к удаленной ферме — по узкой грунтовой дороге."
                            }
                        },
                        {
                            "text": "Firefighters needed direct <w>access</w> to the back of the burning building.",
                            "target_lang_translations": {
                                "ru": "Пожарным был необходим прямой <w>доступ</w> к задней части горящего здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "entrance",
                        "passage",
                        "way in",
                        "approach"
                    ],
                    "antonyms": [
                        "exit"
                    ],
                    "common_phrases": [
                        "direct access",
                        "wheelchair access",
                        "rear access"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический путь входа или достижения места, такой как тропа, дверь или проход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъезд",
                                "target_lang_sense_clarification": "путь для транспорта"
                            },
                            {
                                "target_lang_word": "подход",
                                "target_lang_sense_clarification": "путь для пешеходов"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "путь внутрь чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6972e2d-5713-3b8c-8b19-ce12b26a3a0f",
                    "sense_definition": "The legal right of a noncustodial parent to visit and spend time with their child.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court granted the father weekend <w>access</w> to his children after the divorce.",
                            "target_lang_translations": {
                                "ru": "После развода суд предоставил отцу <w>право посещения</w> детей по выходным."
                            }
                        },
                        {
                            "text": "Disputes over child <w>access</w> can be emotionally difficult for the whole family.",
                            "target_lang_translations": {
                                "ru": "Споры о <w>порядке общения</w> с ребенком могут быть эмоционально тяжелыми для всей семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "visitation"
                    ],
                    "common_phrases": [
                        "right of access"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in British English legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законное право родителя, не проживающего с ребенком, посещать его и проводить с ним время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "право на посещение",
                                "target_lang_sense_clarification": "родительские права"
                            },
                            {
                                "target_lang_word": "право на общение",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebf17eea-1cf5-3dc0-8197-31f666db5dde",
                    "sense_definition": "A sudden and strong outburst of an emotion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He threw the vase against the wall in a sudden <w>access</w> of fury.",
                            "target_lang_translations": {
                                "ru": "Внезапном <w>приступе</w> ярости он швырнул вазу об стену."
                            }
                        },
                        {
                            "text": "She felt an overwhelming <w>access</w> of despair when she heard the tragic news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала непреодолимый <w>прилив</w> отчаяния, когда услышала трагические новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "fit",
                        "paroxysm",
                        "surge"
                    ],
                    "common_phrases": [
                        "access of rage",
                        "access of fury"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная и сильная вспышка эмоций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "внезапное проявление чувства"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "резкое проявление гнева или ярости"
                            },
                            {
                                "target_lang_word": "пароксизм",
                                "target_lang_sense_clarification": "книжный термин для сильного приступа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a40c2814-aa70-3ccf-a066-311915ab9b6c",
                    "sense_definition": "To be able to enter, reach, open, or retrieve something, especially data on a computer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot <w>access</w> my email account because I have forgotten the password.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>войти</w> в свою электронную почту, потому что забыл пароль."
                            }
                        },
                        {
                            "text": "Employees can <w>access</w> the secure server from their home computers using a VPN.",
                            "target_lang_translations": {
                                "ru": "Сотрудники могут <w>получать доступ</w> к защищенному серверу со своих домашних компьютеров через VPN."
                            }
                        }
                    ],
                    "synonyms": [
                        "enter",
                        "open",
                        "retrieve",
                        "reach"
                    ],
                    "common_phrases": [
                        "access the internet",
                        "access information",
                        "access a file",
                        "access data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь возможность войти, достичь, открыть или извлечь что-либо, особенно данные на компьютере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать доступ",
                                "target_lang_sense_clarification": "к информации или системе"
                            },
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "к памяти или данным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}