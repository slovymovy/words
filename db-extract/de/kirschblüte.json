                                        "sense_id": "8a146b2f-828b-3ccc-a346-63656fa0494a",
                                        "entry_id": "f446ab9f-64b0-3868-8713-40d45563b33a",
                                        "glosses": [
                                            "A stylized depiction of the blossom of the cherry tree, as used in Japanese mon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f0ddb7-d602-4c02-9881-2f74b307c7dc",
                                                "sense_id": "8a146b2f-828b-3ccc-a346-63656fa0494a",
                                                "text": "The cherry blossom was in use in Heian times...For obvious reasons it become the mon of the Sakurai family."
                                            }
                                        ]
                                    }
                                ]
