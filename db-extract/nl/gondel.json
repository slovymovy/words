                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f9ccd5-fdd8-4bf3-94b8-89954eceb5a2",
                                                "sense_id": "9b7341d7-d253-3f6f-8a15-d901c2824b3e",
