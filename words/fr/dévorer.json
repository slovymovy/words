                    "sense_definition": "Manger goulûment, avec voracité et rapidité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, les randonneurs ont <w>dévoré</w> leur repas en quelques minutes."
                        },
                        {
                            "text": "Le loup affamé <w>dévore</w> sa proie sans laisser le moindre morceau."
                        }
                    ],
                    "synonyms": [
