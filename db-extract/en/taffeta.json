                    },
                    {
                        "translation_id": "d2e8965a-2e6a-478d-bd90-077e45c6d9fa",
                        "source_entry_id": "317efbb3-a181-33db-b649-684b0bb905b9",
                        "source_sense_id": "df15a160-7a16-39cf-88cb-0e460a77e4d9",
