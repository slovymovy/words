                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17bf8fb6-1a4a-3e32-9ad7-b55019b06b5f",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A fruit of the coconut palm (not a true nut), Cocos nucifera, having a fibrous husk surrounding a large seed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98f9f38-a02b-4d96-b946-67dc0e211d96",
                                                "sense_id": "17bf8fb6-1a4a-3e32-9ad7-b55019b06b5f",
                                                "text": "The Coco-nut Trees grow by the Sea, on the Weſtern ſide in great Groves, 3 or 4 Miles in length, and a Mile or two broad. This tree is in ſhape like the Cabbage-tree, and at a diſtance they are not to be known each from other, only the Coco-nut Tree is fuller of Branches ; but the Cabbage-tree generally is much higher, tho' the Coco-nut Trees in ſome places are very high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62309fe7-e3b0-3af5-9b44-1d5f2d39843b",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A hard-shelled seed of this fruit, having white flesh and a fluid-filled central cavity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4994460-f521-3d39-a320-67e8df02afc1",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "The edible white flesh of this fruit."
                                        ],
                                        "tags": [
