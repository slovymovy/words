                        "translation_id": "ea8eecda-023b-4acb-a314-5c2e0df225c6",
                        "source_entry_id": "5ee74647-8290-3833-9114-b874c8c3b159",
                        "source_sense_id": "819ce7f9-5482-376d-bd1e-0fd3bb910f34",
                        "target_lang_word": "смышлёный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "смышлёный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "78568ddd-5500-3bc0-a945-a584a9cb54b6",
                                        "entry_id": "859ea705-3c12-39db-9ab1-1d2d7a48d877",
                                        "glosses": [
                                            "сообразительный, понятливый, сметливый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495b329d-ce40-404c-887f-fe2d0f906355",
                                                "sense_id": "78568ddd-5500-3bc0-a945-a584a9cb54b6",
                                                "text": "Ты человек смышлёный: ты сам увидел бы, что я лукавствую."
                                            },
                                            {
                                                "example_id": "b8e07abc-d272-46a0-b53d-fe7a8d2f8976",
                                                "sense_id": "78568ddd-5500-3bc0-a945-a584a9cb54b6",
                                                "text": "Русский мужик очень смышлён, очень понятлив, я уважаю русского мужика… а между тем иногда говоришь ему, говоришь, толкуешь, толкуешь…"
                                            },
                                            {
                                                "example_id": "ccb771c3-8b09-4d76-a2d7-9847cbae70d4",
                                                "sense_id": "78568ddd-5500-3bc0-a945-a584a9cb54b6",
                                                "text": "Эти унтер-офицеры оказались большею частью людьми порядочными и смышлёными, понимающими своё положение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc254fb4-8504-34a6-bed6-12036e048535",
                                        "entry_id": "859ea705-3c12-39db-9ab1-1d2d7a48d877",
                                        "glosses": [
                                            "выражающий сообразительность, понятливость, сметливость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d07b7450-5daa-43e2-bbb2-019fa0151f8f",
                                                "sense_id": "fc254fb4-8504-34a6-bed6-12036e048535",
                                                "text": "Горданов вообще человек не особенно представительный: он не высок ростом, плечист, но не толст, ему тридцать лет от роду и столько же и по виду; у него правильный, тонкий нос; высокий, замечательно хорошо развитый смелый лоб; чёрные глаза, большие, бархатные, совсем без блеска, очень смышлёные и смелые."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
