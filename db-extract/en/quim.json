                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09786e7a-0a03-495a-84b8-c77002d8ee0d",
                                                "sense_id": "d66d5c17-766a-3f9a-ab02-457b30e60c6f",
