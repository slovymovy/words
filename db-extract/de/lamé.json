                        "entry_id": "d415e3f9-65c6-391a-bf67-9dc5ea00de6b",
                        "glosses": [
                            "Gewebe aus Seide oder Kunstseide in Atlasbindung, das mit metallenen Fäden übersponnen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc79fe68-25c1-4eed-b37e-39d1b889e5aa",
                                "sense_id": "50bef366-f45e-3fea-b70f-c28ab7062192",
                                "text": "Sie trug ein wunderschönes Abendkleid aus Lamé."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cba2bf90-7ec9-4a9c-ba1d-565b893dd947",
                        "source_entry_id": "d415e3f9-65c6-391a-bf67-9dc5ea00de6b",
                        "source_sense_id": "50bef366-f45e-3fea-b70f-c28ab7062192",
                        "source_sense_description": "Gewebe aus Seide oder Kunstseide in Atlasbindung, das mit metallenen Fäden übersponnen ist",
                        "target_lang_word": "lamé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                        "entry_id": "8c806c06-eb14-3e94-8012-b101ca991a0d",
                                        "glosses": [
                                            "Qui est enrichi de lames d’or ou d’argent, en parlant de certaines étoffes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa9f009d-f30c-4850-bbdd-655403f17be9",
                                                "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                                "text": "Étoffe lamée, lamée d’or, lamée d’argent."
                                            },
                                            {
                                                "example_id": "6f3596ec-fcef-44dc-9ff9-10564481e841",
                                                "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                                "text": "Elle portait ce jour-là une robe lamée d’or."
                                            },
                                            {
                                                "example_id": "23342220-f7d4-472e-968f-cc7312091858",
                                                "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                                "text": "Gilet lamé."
                                            },
                                            {
                                                "example_id": "680b0331-5f4e-4720-a880-aa8f4e2f1f8c",
                                                "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                                "text": "Cette neige n’était pas compacte, mais divisée en minces filons, comme les côtes d’argent d’une gaze lamée, ce qui augmentait sa blancheur par le contraste avec les teintes d’azur et de lilas des escarpements."
                                            },
                                            {
                                                "example_id": "e345e86a-0811-415e-805e-a824454355bc",
                                                "sense_id": "389352c7-37b0-3fbb-956c-ffddc833f9d4",
                                                "text": "Amélie dont les doux nénés\n Doux nénés de nounou moulés\n Dans de molles laines lamées\n Et mêlées de lin milanais..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bb976a5-a3fd-305b-8d86-e0bb6274b1be",
                                        "entry_id": "8c806c06-eb14-3e94-8012-b101ca991a0d",
                                        "glosses": [
                                            "Métallique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c63d39c-531c-4f04-ba2e-e15f786aa41a",
                                                "sense_id": "4bb976a5-a3fd-305b-8d86-e0bb6274b1be",
                                                "text": "Le brouillard qui, deux heures auparavant, flottait sur l’eau, s’était peu à peu retiré et ramassé sur les rives. Laissant le fleuve absolument libre, il avait formé sur chaque berge une colline ininterrompue, haute de six ou sept mètres, qui brillait sous la lune avec l’éclat superbe des neiges. De sorte qu’on ne voyait rien autre chose que cette rivière lamée de feu entre ces deux montagnes blanches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lamé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92093e78-72d0-3d01-ba07-22d6b655aca6",
                                        "entry_id": "2bdd0c10-388e-3eb5-b843-9e881a81075c",
                                        "glosses": [
                                            "Tissu lamé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6c74056-c8e6-4ecf-ac19-501e01896948",
                                                "sense_id": "92093e78-72d0-3d01-ba07-22d6b655aca6",
                                                "text": "Elle porte une robe en lamé argent, style Jeanne-d’Arc-en-tenue-de-travail."
                                            },
                                            {
                                                "example_id": "dbb4cc05-11ef-4782-9291-03e1b881df81",
                                                "sense_id": "92093e78-72d0-3d01-ba07-22d6b655aca6",
                                                "text": "Des sikhs enturbannés, portant des ombrelles brodées d’or, jalonnaient un tapis à motifs persans qui menait, à travers la cour d’honneur, au grand escalier, le long duquel se répartissaient, jusqu’au premier palier, de sombres Nubiens, vêtus de sarouels en lamé or, leurs torses nus constellés de pierreries."
                                            }
                                        ]
                                    }
                                ]
                            },
