                                        "entry_id": "0578a05f-792a-3d97-92cb-644699ca36a5",
                                        "glosses": [
                                            "die christliche Glaubensbotschaft (das Evangelium) verbreiten; zum Evangelium bekehren; Menschen zu Gott führen"
                                        ],
                                        "tags": [],
