                    },
                    {
                        "translation_id": "c785364a-7d42-49a1-abff-b149b97f0eb1",
                        "source_entry_id": "e2e8355c-3823-36e4-85c6-ed07cde4932f",
                        "source_sense_id": "602975d3-1167-3bdb-8451-a0c39309f253",
                        "target_lang_word": "bonnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b88d6bea-e539-3918-961d-7aa2cf4ef5d3",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "A type of hat, once worn by women or children, held in place by ribbons tied under the chin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0d6e0e-8d99-4bb6-9655-a3c09bf96bc5",
                                                "sense_id": "b88d6bea-e539-3918-961d-7aa2cf4ef5d3",
                                                "text": "In the hall, Scarlett saw a bonnet and put it on hurriedly, tying the ribbons under her chin. It was Melanie's black mourning bonnet and it did not fit Scarlett's head but she could not recall where she had put her own bonnet."
                                            },
                                            {
                                                "example_id": "d947e9df-119c-46e9-834d-a355dad34861",
                                                "sense_id": "b88d6bea-e539-3918-961d-7aa2cf4ef5d3",
                                                "text": "“Now,” said he, “put such a bonnet as that in the show window.” He did not fill his show-window up town with a lot of hats and bonnets to drive people away, and then sit on the back stairs and bawl because people went to Wanamaker's to trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d19889f-31bf-3970-bdea-676b7c1cce91",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "A traditional Scottish woollen brimless cap; a bunnet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991c0873-7809-41d3-9796-396012f37aa1",
                                                "sense_id": "6d19889f-31bf-3970-bdea-676b7c1cce91",
                                                "text": "A shock-head of red hair, which the hat and periwig of the Lowland costume had in a great measure concealed, was seen beneath the Highland bonnet, and verified the epithet of Roy, or Red, by which he was much better known in the low country than by any other, and is still, I suppose, best remembered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e60a1cf3-6af3-3719-a2e5-3a3e17fc44fe",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "The polishing head of a power buffer, often made of wool."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855ac10f-26df-4410-9df3-aefe87e4e791",
                                                "sense_id": "e60a1cf3-6af3-3719-a2e5-3a3e17fc44fe",
                                                "text": "Make sure that the power buffer's lamb's-wool bonnet is clean. Change or rinse the bonnet frequently to avoid scratching the finish. Use the bonnet as a mitten to buff in the crevices and other areas that the power buffer can't reach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad579bd6-204e-35ee-91d5-bad10afc885a",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "The hinged cover over the engine of a motor car, also known as a hood in chiefly Canada and the US."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Commonwealth",
                                            "New-Zealand",
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b25e3752-f6f5-4f9e-b436-6ab3a2b78f98",
                                                "sense_id": "ad579bd6-204e-35ee-91d5-bad10afc885a",
                                                "text": "The car is burgundy red, wide and elegant, ten years old but still the boys are impressed and they run to touch it, pressing sticky handprints against the polished bodywork and trying to climb up onto the bonnet."
                                            },
                                            {
                                                "example_id": "9d3c60de-9f7f-43f8-8b50-fceafa746e0f",
                                                "sense_id": "ad579bd6-204e-35ee-91d5-bad10afc885a",
                                                "text": "People were reluctant to slam a bonnet shut in those days. One just did not slam bonnets and doors."
                                            },
                                            {
                                                "example_id": "8cb5ec57-9b93-4443-ad08-d5c268213cc9",
                                                "sense_id": "ad579bd6-204e-35ee-91d5-bad10afc885a",
                                                "text": "By about 20 ms, there is contact between the bonnet leading edge and the pedestrian upper leg/pelvis on the struck side, the severity of which depends on the vehicle shape."
                                            },
                                            {
                                                "example_id": "bcd6128f-07fe-43ed-9528-8b58a95eec6c",
                                                "sense_id": "ad579bd6-204e-35ee-91d5-bad10afc885a",
                                                "text": "Stoll was still standing on the car bonnet with the catch of his large-calibre repeating rifle off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fad1c59-2680-3313-aad1-c440fa5545b7",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "A length of canvas attached to a fore-and-aft sail to increase the pulling power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e4d8872-f03f-4068-8e93-b989923abfd2",
                                                "sense_id": "8fad1c59-2680-3313-aad1-c440fa5545b7",
                                                "text": "And standing along to the Westward, this night we tryed with our mayne coarse and bonnet. On Saturday night we came to an anker, in three fathomes against Sewramo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77db9b52-0178-3ccc-ba35-65ef35e92a63",
                                        "entry_id": "4e5e49b5-1cd7-33cc-a6fa-31ec9505cf29",
                                        "glosses": [
                                            "An accomplice of a gambler, auctioneer, etc., who entices others to bet or to bid."
                                        ],
                                        "tags": [
