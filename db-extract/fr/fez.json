                "forms": [
                    {
                        "form_id": "9cdb79a0-f509-4a76-a8da-1a2895e6cef7",
                        "entry_id": "a2279c4a-0aea-3d77-91bb-4a87934648f7",
                        "tags": [],
                        "form": "Fès"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea894c3c-8a66-317f-955c-f825536d034d",
                        "entry_id": "a2279c4a-0aea-3d77-91bb-4a87934648f7",
                        "glosses": [
                            "Ville du Maroc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f15c83a3-c5e4-4352-a183-52ff36c73a2b",
                                "sense_id": "ea894c3c-8a66-317f-955c-f825536d034d",
                                "text": "Un jour dans Fez, le Capitaine de Lattre s’arrête à l’éventaire d’un marchand de sucreries arabes."
                            },
                            {
                                "example_id": "aadf233e-e83a-4f81-8a15-608fe8980575",
                                "sense_id": "ea894c3c-8a66-317f-955c-f825536d034d",
                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech. Je n’ai vu que ce dernier."
                            },
                            {
                                "example_id": "534d9f45-7545-4ccf-beee-f1b34a158219",
                                "sense_id": "ea894c3c-8a66-317f-955c-f825536d034d",
                                "text": "Les parents de mon camarade habitaient Fez et nous nous rendîmes chez eux en autocar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4922d1ad-60ac-4ceb-b01c-a1a4f1a82f75",
                        "source_entry_id": "a2279c4a-0aea-3d77-91bb-4a87934648f7",
