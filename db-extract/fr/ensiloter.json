                "senses": [
                    {
                        "sense_id": "7160aa3f-66a2-356f-b3c7-6b50c210f90f",
                        "entry_id": "a3868b94-7dfd-30c3-bf05-7347a7c9d7d6",
                        "glosses": [
                            "Mettre en silo, ensiler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50470566-74d1-4a38-8815-87af9567bec0",
                                "sense_id": "7160aa3f-66a2-356f-b3c7-6b50c210f90f",
                                "text": "Là, il s'agissait d'ensiloter le charbon."
                            },
                            {
                                "example_id": "a6c407a4-b4f2-414a-8c68-1816dd97b1d7",
                                "sense_id": "7160aa3f-66a2-356f-b3c7-6b50c210f90f",
                                "text": "On peut ensiloter les feuilles de la même manière que la pulpe et donner au gros bétail de 15 à 25 k. de feuilles par tête et par jour.' — (Industries Agricoles et Alimentaires, 1887)"
                            },
                            {
                                "example_id": "acc9cc68-6a9a-498c-9f3d-05d9e9f51310",
                                "sense_id": "7160aa3f-66a2-356f-b3c7-6b50c210f90f",
                                "text": "A propos de mettre en tas dans la terre des betteraves pour les conserver et les préserver du froid, plusieurs hommes du métier disent : les uns, ENSILOTER, ENSILOTAGE ; les autres ENSILER, ENSILAGE."
                            }
                        ]
                    }
