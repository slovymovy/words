                "forms": [
                    {
                        "form_id": "8d27b546-2ad7-4b41-904f-4d3f0482e67e",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "tags": [
                            "plural"
                        ],
                        "form": "fossoyeuses"
                    },
                    {
                        "form_id": "db11ead1-a08f-4954-82e4-eb57ba657ea8",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "tags": [
                            "masculine"
                        ],
                        "form": "fossoyeur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "270d605c-750b-330d-af0a-af84f220786f",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "glosses": [
                            "Celle qui creuse les fosses pour enterrer les morts."
                        ],
                        "tags": [
                            "Métier",
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "2ff9e129-a51f-4cd2-9041-640ffba9551c",
                                "sense_id": "270d605c-750b-330d-af0a-af84f220786f",
                                "text": "Les femmes égyptiennes en voiles bleus ou noirs de fossoyeuses, avec leurs pieds nus sales, ou coquettement chaussées d’affreux souliers à hauts talons quand il s’agit de femmes un peu plus riches."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b4a64c3-58c5-31a2-9495-48ec81662ff3",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "glosses": [
                            "Épouse d’un fossoyeur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "70686f98-e4e8-4d67-b7eb-27ccf38e92ea",
                                "sense_id": "2b4a64c3-58c5-31a2-9495-48ec81662ff3",
                                "text": "Quelle est cette grande femme rigide ? C’est Marthe la fossoyeuse, femme de Pierre le fossoyeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "01cc5537-493c-36f1-b317-183d80bd86c5",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "glosses": [
                            "La mort."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "443b8806-5b20-46c7-8686-ac3e1e7bb6b9",
                                "sense_id": "01cc5537-493c-36f1-b317-183d80bd86c5",
                                "text": "Ciel ! j’entends la mort qui, joyeuse,\nArrive en se frottant les mains.\nÀ ma porte, la fossoyeuse\nFrappe ; adieu, messieurs les humains !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8f7581e-3a33-3ea4-a76e-a1b6be064c9c",
                        "entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "glosses": [
                            "Celle qui met fin à quelque chose déjà en déliquescence."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "16b04583-9b36-4f90-93b5-d778544dc533",
                                "sense_id": "a8f7581e-3a33-3ea4-a76e-a1b6be064c9c",
                                "text": "Ces exemples montrent que sa disparition est bien plus récente qu’on ne le croit, et que l’Académie française n’est pas l’unique fossoyeuse du féminin."
                            },
                            {
                                "example_id": "72d55ac1-11b2-49ba-a6ae-3378b2c68e12",
                                "sense_id": "a8f7581e-3a33-3ea4-a76e-a1b6be064c9c",
                                "text": "Voulait-elle casser l’image d’une ministre rigide, accusée par la gauche d’être la fossoyeuse du code du Travail ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "846021b4-632f-4e01-8429-ffbef90bf8de",
                        "source_entry_id": "2d8e5a64-4e42-364e-89ca-2dc24ee3f460",
                        "source_sense_id": "270d605c-750b-330d-af0a-af84f220786f",
                        "source_sense_description": "Celle qui creuse les fosses",
                        "target_lang_word": "Totengräberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totengräberin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2279e821-732e-3346-9224-d8787c3d987d",
                                        "entry_id": "0b57bff5-f26e-3c23-8889-1429d9d3f5f8",
                                        "glosses": [
                                            "weibliche Person, die auf dem Friedhof die Gräber aushebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51038cc2-a9aa-4420-8a64-fad25dbc37f8",
                                                "sense_id": "2279e821-732e-3346-9224-d8787c3d987d",
                                                "text": "Die Totengräberin hatte schon drei Gräber ausgehoben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4827fd3-295e-3e92-ad07-26c7e8ffca0a",
                                        "entry_id": "0b57bff5-f26e-3c23-8889-1429d9d3f5f8",
                                        "glosses": [
                                            "weibliche Person, die einen schlechten Einfluss ausübt, eine Sache ins Grab bringt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c5ee3d-9770-4781-8d8e-5a8d661979dd",
                                                "sense_id": "e4827fd3-295e-3e92-ad07-26c7e8ffca0a",
                                                "text": "„Sie ist aber auch die Totengräberin der Dynastie Romanow, denn wegen Rasputin hat sie den allgemeinen Haß und die Verachtung auf den Kaiser und die Dynastie herabgerufen, selbst jener, die von Rasputin Rang, Ehren und Ämter erhalten hatten, weil sie es ihm nicht verzeihen konnten, daß sie sich vor einem solchen Bauern erniedrigen und um Gnaden bitten mußten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
