{
    "word": "damages",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                "word": "damages",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                        "entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                        "glosses": [
                            "The money paid or awarded to a claimant (in England), a pursuer (in Scotland) or a plaintiff (in the US) in a civil action as compensation for a loss suffered by the same."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "e59631c4-af8a-4932-8bde-a05e580c02b6",
                                "sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                                "text": "The WTO dispute settlement mechanism is characterized by weaknesses such as non-retroactive damages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "502016f4-41aa-4c77-897c-59b720718d78",
                        "source_entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                        "source_sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                        "source_sense_description": "money awarded to a claimant",
                        "target_lang_word": "schadevergoeding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schadevergoeding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "65d5ae6c-1716-3361-b82d-ac573e736331",
                                        "entry_id": "b2423ac2-e982-33bf-84df-c09987a38466",
                                        "glosses": [
                                            "compensatie van schade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2271ff-be92-4973-95e2-3d605fdd7fd9",
                                                "sense_id": "65d5ae6c-1716-3361-b82d-ac573e736331",
                                                "text": "De vijf grootste Amerikaanse banken en de twintig grootste in Europa hebben sinds de kredietcrisis al in totaal ruim 260 miljard dollar (228 miljard euro) aan boetes en schadevergoedingen betaald."
                                            },
                                            {
                                                "example_id": "1343ac0e-a7ab-428b-a7c7-20837b59383e",
                                                "sense_id": "65d5ae6c-1716-3361-b82d-ac573e736331",
                                                "text": "Zijn advocaten hebben een gratieverzoek ingediend en willen Nederland ervoor aansprakelijk stellen dat Van Laarhoven is opgepakt in Thailand. Advocaat Spong wil dat Van Laarhoven een schadevergoeding krijgt voor de rol van het Nederlandse OM bij zijn arrestatie. \"Het zal vele nullen hebben, die schadevergoeding\", zei hij daarover."
                                            },
                                            {
                                                "example_id": "255d69de-0f50-4f6a-96d1-f8e7100c47f0",
                                                "sense_id": "65d5ae6c-1716-3361-b82d-ac573e736331",
                                                "text": "De broers maakten deel uit van een groep van zeven Nederlandse toeristen die op een caféterras in het centrum van Praag een ober in elkaar sloegen. Het slachtoffer hield ernstige verwondingen over aan de mishandeling, waaronder een gebroken kaak en een gebroken oogkas. Hij lag drie weken in het ziekenhuis en eist een schadevergoeding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eff0846a-c9a4-4bdb-a304-239bd9993783",
                        "source_entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                        "source_sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                        "source_sense_description": "money awarded to a claimant",
                        "target_lang_word": "dommages-intérêts",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dommages-intérêts",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7754c1-f3b5-3828-921f-ee03ff181c3f",
                                        "entry_id": "281bedf4-5567-3ba4-aeae-0fb29126cb5b",
                                        "glosses": [
                                            "Indemnité qui est due à quelqu’un pour le préjudice qu’on lui a causé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbf968d6-ea18-404a-9ba5-acc2d6d5749b",
                                                "sense_id": "bd7754c1-f3b5-3828-921f-ee03ff181c3f",
                                                "text": "Ces gens-là savent bien qu’ils sont exposés à des dommages-intérêts et même à la prison ; mais que leur importe ? ils ont changé d’habit, donné un faux nom et une fausse adresse et par-dessus tout ils sont insolvables."
                                            },
                                            {
                                                "example_id": "ff839246-2504-4415-96d0-6183ebfb2aa2",
                                                "sense_id": "bd7754c1-f3b5-3828-921f-ee03ff181c3f",
                                                "text": "Adjuger, se faire adjuger des dommages-intérêts."
                                            },
                                            {
                                                "example_id": "2165f66c-b3a2-4322-a586-27ef5e6b4263",
                                                "sense_id": "bd7754c1-f3b5-3828-921f-ee03ff181c3f",
                                                "text": "La liquidation des dommages-intérêts."
                                            },
                                            {
                                                "example_id": "53243da3-0b9c-404e-b7a1-9a98e16c0f1e",
                                                "sense_id": "bd7754c1-f3b5-3828-921f-ee03ff181c3f",
                                                "text": "La satisfaction pécuniaire se présente sous la même forme que les dommages-intérêts. Fondamentalement, elle ne peut s’en distinguer. Comme le dommage-intérêt, elle compense un préjudice évalué en argent. Toute indemnité computée sur l’étendue d’un préjudice moral ou matériel est par définition un dommage-intérêt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "812d3ff1-3f39-411b-a314-339f41c0613b",
                        "source_entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                        "source_sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                        "source_sense_description": "money awarded to a claimant",
                        "target_lang_word": "Schadenersatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadenersatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                        "entry_id": "8b3ea802-6ad8-36a2-9b1f-eda527273afe",
                                        "glosses": [
                                            "Ausgleich/Kompensation für einen entstandenen Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb3fc0b-f92b-46bc-8385-1517e7b4f78f",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "Sie konnten keinen Schadenersatz erreichen, der die Verluste auch nur annähernd ausgeglichen hätte."
                                            },
                                            {
                                                "example_id": "56273763-553d-43ea-af7d-01fa75de6551",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Dem nach dieser Bestimmung anzuwendenden Grundsatz des billigen richterlichen Ermessens und Ausgleichsgedankens entspreche eine gleichteilige Verpflichtung zum Schadenersatz.“"
                                            },
                                            {
                                                "example_id": "05b24d7c-e595-4e72-92b9-9397fc32a5e2",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Während des dortigen Sezessionskriegs (1861-1865) war [Anton Schütte] Quartiermeister einer Division der Nordstaaten, wurde jedoch 1862 wegen Unterschlagungen abgesetzt und zu Schadenersatz verurteilt.“"
                                            },
                                            {
                                                "example_id": "a548875c-6e31-4e5a-be80-e9c01c18d064",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Die Versicherung gewährt ihm aber allenfalls Schadenersatz.“"
                                            },
                                            {
                                                "example_id": "643c76dc-d456-4931-b2b7-77c8f4f0b131",
                                                "sense_id": "40b08594-86f2-39f0-8bfb-2ded3196ab84",
                                                "text": "„Davon abgesehen, kann der Endverbraucher unter Umständen Schadenersatz geltend machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9afc229-253c-4bd1-89ae-816f2c18e08e",
                        "source_entry_id": "82a542de-f444-3500-b9ee-26bde8688d6d",
                        "source_sense_id": "4f729915-e7d3-3193-886e-eec3bc842d02",
                        "source_sense_description": "money awarded to a claimant",
                        "target_lang_word": "Schadensersatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadensersatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                        "entry_id": "e88c5e6b-d733-36dd-a8a2-f86c8e6412c7",
                                        "glosses": [
                                            "Ausgleich/Kompensation für einen entstandenen Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c818effb-1897-42bc-a0e6-e0dafe26edc0",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Vier Ex-Fahnder verlangen Schadensersatz, weil sie aufgrund unlauterer Gutachten zwangspensioniert wurden.“"
                                            },
                                            {
                                                "example_id": "44183b8a-f0d4-4dd3-83b1-7b6906378a39",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„In dem Fall hatte die Klägerin Schadensersatz für Schmuck verlangt, der aus ihrem Reisegepäck verschwunden war.“"
                                            },
                                            {
                                                "example_id": "1eeabdd8-0a45-4470-9cf7-5a936a35cd63",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Erst am Donnerstag kündigte Stöckl an, erstmals eine Bank auf Schadensersatz zu klagen.“"
                                            },
                                            {
                                                "example_id": "acdc904f-ce49-4911-b36f-75062b53dc62",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Ein nach sonstigen Vorschriften begründeter Anspruch auf Schadensersatz bleibt unberührt.“"
                                            },
                                            {
                                                "example_id": "df7c590d-38a8-49e4-abbb-f900a6843fbf",
                                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                                "text": "„Wer schuldlos in einen Unfall verwickelt wird, hat in der Regel Anspruch auf Schadensersatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
