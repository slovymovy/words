                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3f447f0f-1d78-32cc-ac2d-9ef14723eb8f",
                        "entry_id": "acfab3b0-c68c-3e05-8dcd-8687abd99135",
                        "glosses": [
                            "в одно целое, вместе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b2cea3-46ee-48f3-ada8-e24253e72596",
                                "sense_id": "3f447f0f-1d78-32cc-ac2d-9ef14723eb8f",
                                "text": "Их души были связаны воедино, теперь сложно представить их врознь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a64cb3b5-d107-4770-836b-45944ba6afa1",
                        "source_entry_id": "acfab3b0-c68c-3e05-8dcd-8687abd99135",
                        "source_sense_id": "3f447f0f-1d78-32cc-ac2d-9ef14723eb8f",
                        "target_lang_word": "together",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed939787-1096-3651-b6e6-2ec766f030ae",
                                        "entry_id": "cd962b91-08f7-3cfb-8b5a-36d5ae64d346",
                                        "glosses": [
                                            "At the same time, in the same place; in close association or proximity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab1589d3-7690-4e23-ab8b-67ee9fd2fd3e",
                                                "sense_id": "ed939787-1096-3651-b6e6-2ec766f030ae",
                                                "text": "We went to school together."
                                            },
                                            {
                                                "example_id": "ddc4788d-3777-48b8-9b42-9f45d0af314d",
                                                "sense_id": "ed939787-1096-3651-b6e6-2ec766f030ae",
                                                "text": "We can't all talk together; let's take turns politely."
                                            },
                                            {
                                                "example_id": "e1a24e8f-bb24-4898-87f7-7169e4de42a4",
                                                "sense_id": "ed939787-1096-3651-b6e6-2ec766f030ae",
                                                "text": "[…]purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                                            },
                                            {
                                                "example_id": "7666a4ee-fd5d-4b34-93b2-0b3478ce9ee4",
                                                "sense_id": "ed939787-1096-3651-b6e6-2ec766f030ae",
                                                "text": "“[…] This is Mr. Churchill, who, as you are aware, is good enough to come to us for his diaconate, and, as we hope, for much longer; and being a gentleman of independent means, he declines to take any payment.” Saying this Walden rubbed his hands together and smiled contentedly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9da1b39-286d-326e-8f58-14b97c834370",
                                        "entry_id": "cd962b91-08f7-3cfb-8b5a-36d5ae64d346",
                                        "glosses": [
                                            "Into one place; into a single thing; combined."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d8f8185-411e-4299-9ffe-651524d8104d",
                                                "sense_id": "c9da1b39-286d-326e-8f58-14b97c834370",
                                                "text": "He put all the parts together."
                                            },
                                            {
                                                "example_id": "32080509-9571-49f2-bc11-a2d65535df41",
                                                "sense_id": "c9da1b39-286d-326e-8f58-14b97c834370",
                                                "text": "Ne take noon hede to brynge togidere þe parties of þe boon þat is to-broken or dislocate, til viij. daies ben goon in þe wyntir, & v. in þe somer; for þanne it schal make quytture, and be sikir from swellynge; & þanne brynge togidere þe brynkis eiþer þe disiuncture after þe techynge þat schal be seid in þe chapitle of algebra."
                                            },
                                            {
                                                "example_id": "c3c23c7b-3758-4b1c-8b88-a05e051232c4",
                                                "sense_id": "c9da1b39-286d-326e-8f58-14b97c834370",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. […] A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35aa4cfb-c48e-37ef-a9cf-19b4a47c9187",
                                        "entry_id": "cd962b91-08f7-3cfb-8b5a-36d5ae64d346",
                                        "glosses": [
                                            "In a relationship or partnership, for example a business relationship or a romantic partnership."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a78ae0-e80c-4dce-bba4-a69c40188288",
                                                "sense_id": "35aa4cfb-c48e-37ef-a9cf-19b4a47c9187",
                                                "text": "Bob and Andy went into business together.  Jenny and Mark have been together since they went on holiday to Mexico."
                                            },
                                            {
                                                "example_id": "58bb536e-15af-4a35-adb0-465ebb9adcf2",
                                                "sense_id": "35aa4cfb-c48e-37ef-a9cf-19b4a47c9187",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f80b30e-c523-37fd-9308-922c1950bf09",
                                        "entry_id": "cd962b91-08f7-3cfb-8b5a-36d5ae64d346",
                                        "glosses": [
                                            "Without intermission or interruption; continuously; uninterruptedly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59fbd4c5-b860-4a3b-b457-96944f31defa",
                                                "sense_id": "4f80b30e-c523-37fd-9308-922c1950bf09",
                                                "text": "It has been raining four days together"
                                            },
                                            {
                                                "example_id": "0f304dc4-c5fe-4856-aed2-b61b247c82f2",
                                                "sense_id": "4f80b30e-c523-37fd-9308-922c1950bf09",
                                                "text": "He would weep for hours together, and I verily believe that to the very end this spoilt child of life thought his weak tears in some way efficacious."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "together",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1ce5039-6b6b-335c-acb2-89857095ef7c",
                                        "entry_id": "f5baff9f-30e6-376f-b420-572751100c33",
                                        "glosses": [
                                            "Coherent; well-organized."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee0aed9-d216-4ec8-aec7-32263d496a37",
                                                "sense_id": "b1ce5039-6b6b-335c-acb2-89857095ef7c",
                                                "text": "He’s really together."
                                            },
                                            {
                                                "example_id": "0be7db84-b1f9-4b51-bde4-29958ed19e67",
                                                "sense_id": "b1ce5039-6b6b-335c-acb2-89857095ef7c",
                                                "text": "Youthful, former fashion model & dancer needs to find a serious, together individual to call his own."
                                            }
                                        ]
                                    }
                                ]
                            }
