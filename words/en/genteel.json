{
    "word_family": [
        "gentility",
        "genteelly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1b7da8bc-6ab8-3dab-acd5-d0aab583fd90",
                    "sense_definition": "Polite, refined, and respectable, often in a way that suggests a high social class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite their financial struggles, the family maintained a <w>genteel</w> lifestyle.",
                            "target_lang_translations": {
                                "ru": "Несмотря на финансовые трудности, семья сохраняла <w>благородный</w> уклад жизни.",
                                "nl": "Ondanks hun financiële problemen behield het gezin een <w>beschaafde</w> levensstijl."
                            }
                        },
                        {
                            "text": "She was known for her <w>genteel</w> manners and ability to host elegant dinner parties.",
                            "target_lang_translations": {
                                "ru": "Она была известна своими <w>утонченными</w> манерами и умением устраивать элегантные званые ужины.",
                                "nl": "Ze stond bekend om haar <w>verfijnde</w> manieren en haar vermogen om elegante diners te organiseren."
                            }
                        }
                    ],
                    "synonyms": [
                        "refined",
                        "polite",
                        "cultured",
                        "courteous",
                        "well-bred"
                    ],
                    "antonyms": [
                        "uncouth",
                        "vulgar",
                        "coarse",
                        "rude"
                    ],
                    "common_phrases": [
                        "genteel poverty",
                        "genteel manners",
                        "genteel society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый, утонченный и респектабельный, часто указывающий на принадлежность к высшему классу.",
                        "nl": "Beleefd, verfijnd en respectabel, vaak op een manier die wijst op een hogere sociale klasse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "обладающий высокими нравственными качествами и безупречными манерами"
                            },
                            {
                                "target_lang_word": "утонченный",
                                "target_lang_sense_clarification": "изысканный, лишенный грубости"
                            },
                            {
                                "target_lang_word": "воспитанный",
                                "target_lang_sense_clarification": "умеющий хорошо вести себя в обществе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "beschaafd",
                                "target_lang_sense_clarification": "met goede manieren en een verfijnde levensstijl"
                            },
                            {
                                "target_lang_word": "verfijnd",
                                "target_lang_sense_clarification": "met een elegante en gecultiveerde uitstraling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253f7eb5-16b6-3a36-befe-e791eb4cd1bd",
                    "sense_definition": "Relating to or typical of the aristocracy or upper social classes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel retains the <w>genteel</w> charm of the Victorian era.",
                            "target_lang_translations": {
                                "ru": "Отель сохраняет <w>аристократический</w> шарм викторианской эпохи.",
                                "nl": "Het hotel behoudt de <w>aristocratische</w> charme van het victoriaanse tijdperk."
                            }
                        },
                        {
                            "text": "He was born into a <w>genteel</w> family with a long history of public service.",
                            "target_lang_translations": {
                                "ru": "Он родился в <w>знатной</w> семье с давней историей государственной службы.",
                                "nl": "Hij werd geboren in een <w>voorname</w> familie met een lange geschiedenis van openbare dienstverlening."
                            }
                        }
                    ],
                    "synonyms": [
                        "aristocratic",
                        "upper-class",
                        "patrician",
                        "noble"
                    ],
                    "antonyms": [
                        "plebeian",
                        "common",
                        "working-class"
                    ],
                    "common_phrases": [
                        "genteel birth",
                        "genteel tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к аристократии или высшим слоям общества.",
                        "nl": "Betrekking hebbend op of typerend voor de aristocratie of de hogere sociale klassen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аристократический",
                                "target_lang_sense_clarification": "свойственный высшему сословию"
                            },
                            {
                                "target_lang_word": "знатный",
                                "target_lang_sense_clarification": "принадлежащий к родовитой семье"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "aristocratisch",
                                "target_lang_sense_clarification": "behorend tot of passend bij de adel of hogere stand"
                            },
                            {
                                "target_lang_word": "voornaam",
                                "target_lang_sense_clarification": "van hoge afkomst of status"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4c58fc3-bc6b-3b8a-8ca7-01fe7882edfe",
                    "sense_definition": "Excessively polite or refined in an artificial or prudish way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manners",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>genteel</w> accent sounded forced and unnatural to the locals.",
                            "target_lang_translations": {
                                "ru": "Его <w>манерный</w> акцент казался местным жителям наигранным и неестественным.",
                                "nl": "Zijn <w>gekunstelde</w> accent klonk voor de lokale bevolking geforceerd en onnatuurlijk."
                            }
                        },
                        {
                            "text": "The critic mocked the <w>genteel</w> hypocrisy of the characters in the play.",
                            "target_lang_translations": {
                                "ru": "Критик высмеял <w>чопорное</w> лицемерие персонажей пьесы.",
                                "nl": "De criticus bespotte de <w>aanstellerige</w> hypocrisie van de personages in het toneelstuk."
                            }
                        }
                    ],
                    "synonyms": [
                        "affected",
                        "pretentious",
                        "prim",
                        "artificial"
                    ],
                    "antonyms": [
                        "natural",
                        "genuine",
                        "unpretentious"
                    ],
                    "common_phrases": [
                        "genteel affectation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно вежливый или утонченный, часто неестественным или ханжеским образом.",
                        "nl": "Overdreven beleefd of verfijnd op een kunstmatige of preutse manier."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чопорный",
                                "target_lang_sense_clarification": "чрезмерно строгий в соблюдении приличий"
                            },
                            {
                                "target_lang_word": "манерный",
                                "target_lang_sense_clarification": "лишенный простоты и естественности"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "gekunsteld",
                                "target_lang_sense_clarification": "niet natuurlijk, gemaakt of overdreven"
                            },
                            {
                                "target_lang_word": "aanstellerig",
                                "target_lang_sense_clarification": "zich op een onnatuurlijke, verfijnde manier gedragend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}