                ],
                "senses": [
                    {
                        "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                        "entry_id": "58686585-b667-323b-9d7a-dad34f470947",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fa5b7c-9f04-49e2-926c-281e1a9814ea",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Frau Weckerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0343d120-6c2b-402c-9dfe-8d6bf33f82da",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Herr Weckerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "267e603c-ffd5-4a1e-adf3-8488c292d732",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Die Weckerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "96fefc78-dc04-41f7-b9bd-49981243cb6c",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Der Weckerle trägt nie die Schals, die die Weckerle ihm strickt."
                            },
                            {
                                "example_id": "e4c0b7b1-82aa-481c-8a39-d162c16e512e",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weckerle kommt, geht der Herr Weckerle.“"
                            },
                            {
                                "example_id": "666f0770-1141-41e7-89fd-90c0ae8ea0ae",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Weckerle kommt und geht."
                            },
                            {
                                "example_id": "fb2ed271-794a-40df-9019-42103268648a",
                                "sense_id": "2dd6e7ee-b075-3338-a502-6bd442cbfaac",
                                "text": "Weckerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
