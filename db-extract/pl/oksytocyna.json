                "senses": [
                    {
                        "sense_id": "5477687d-49c8-3588-a1c2-749329e94a03",
                        "entry_id": "009f9741-aa6f-3d69-8603-9d607c5ad54a",
                        "glosses": [
                            "hormon powodujący skurcze mięśni gładkich, będący fizjologicznym bodźcem do rozpoczęcia porodu"
                        ],
                        "tags": [],
                        "examples": [],
