    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6a34224-c2cb-337c-bdee-df58a7fee972",
                    "sense_definition": "Grand arbre des régions tempérées, au feuillage souvent découpé, qui produit des glands.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un vieux <w>chêne</w> majestueux s'élève au beau milieu du parc municipal."
                        },
                        {
                            "text": "Les enfants s'amusent à ramasser chaque feuille de <w>chêne</w> tombée au sol."
                        }
                    ],
                    "common_phrases": [
                        "feuille de chêne",
                        "chêne centenaire"
                    ]
                },
                {
                    "sense_id": "fa6dc8cc-86e8-312a-85f4-c42afe947966",
                    "sense_definition": "Bois dur et résistant issu de cet arbre, couramment employé en menuiserie et en ébénisterie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "materiau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont acheté une belle table en <w>chêne</w> massif pour leur séjour."
                        },
                        {
                            "text": "Ce vin rouge d'exception vieillit lentement dans un fût de <w>chêne</w>."
                        }
                    ],
                    "common_phrases": [
                        "table en chêne",
                        "fût de chêne"
                    ]
                },
                {
                    "sense_id": "2debac79-18eb-37ca-a3b5-4ada0e83a409",
                    "sense_definition": "Figure représentant cet arbre dans les armoiries, fréquemment représenté avec des glands imposants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason officiel de la commune porte un <w>chêne</w> aux glands d'or."
                        },
                        {
                            "text": "Les armoiries familiales affichent fièrement un grand <w>chêne</w> sur fond d'argent."
                        }
                    ]
                }
            ]
        }
    ]
