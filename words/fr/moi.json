                    "frequency": "High",
                    "semantic_group_id": "pronom_premiere_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux venir dîner chez <w>moi</w> ce soir si tu n'as rien de prévu."
                        },
                        {
                            "text": "Quant à <w>moi</w>, je préfère partir tôt pour éviter les embouteillages du matin."
                        }
                    ],
                    "common_phrases": [
