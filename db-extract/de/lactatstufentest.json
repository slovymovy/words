                "senses": [
                    {
                        "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                        "entry_id": "d6d9103c-5926-3091-a4db-9a3d5cb14075",
                        "glosses": [
                            "Test zur Bestimmung der individuellen Ausdauerleistungsfähigkeit durch schrittweise Belastungssteigerung und gleichzeitige Messung der Lactatkonzentration im Blut nach jeder Belastungsstufe"
                        ],
                        "tags": [
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "03e8f400-1203-4b50-88b8-173d51ebd515",
                                "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                                "text": "„Erweitert um moderne softwarebasierte Trainingsplangestaltung (LINK Mesics Winlactat), lässt diese Untersuchung hierbei nicht nur Profis profitieren, sondern erlaubt neben einem Lactatstufentest auch zusätzliche Aussagen über Lungen- und Herzfunktion unter Belastung.“"
                            },
                            {
                                "example_id": "3bb2c614-85a7-425c-a12f-4ca7ccfbfa4f",
                                "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                                "text": "„Diese Methode ist der verbreiteten Ermittlung über einen Lactatstufentest weit überlegen.“"
                            },
                            {
                                "example_id": "7cc92d98-7644-4e32-8d19-3e3149cc18d6",
                                "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                                "text": "„Um solche Bereiche individuell festlegen zu können und ein Training zu optimieren steht als ideales Instrument ein Lactatstufentest zur Verfügung.“"
                            },
                            {
                                "example_id": "2361ed88-5e6a-4d86-b770-34552355cc7d",
                                "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                                "text": "„Der Lactatstufentest ist eine Basismethode in der metabolischen Leistungsdiagnostik.“"
                            },
                            {
                                "example_id": "d9db5a8d-0ac5-4200-a7c3-4664c2cb376e",
                                "sense_id": "f36cb9f2-f43f-3ee4-8c31-ca2d71c2fd31",
                                "text": "„Für den Ausdauerbereich bietet sich zur Bestimmung der persönlichen Leistungsfähigkeit und des idealen Trainingsbereiches idealerweise der Lactatstufentest an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
