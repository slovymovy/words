    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "602e3ab5-8353-3f9b-b451-27df21b5b23f",
                    "sense_definition": "Revenir chez soi, regagner son domicile.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>rentrer</w> chez moi avant la tombée de la nuit."
                        },
                        {
                            "text": "Nous sommes fatigués et nous voulons <w>rentrer</w> à la maison immédiatement."
                        }
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "rentrer chez soi",
                        "rentrer à la maison",
                        "rentrer tard"
                    ]
                },
                {
                    "sense_id": "9099093c-74bf-32cd-8310-e456d82f81cc",
                    "sense_definition": "Entrer de nouveau dans un lieu ou y pénétrer pour s'abriter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la récréation, tous les élèves doivent <w>rentrer</w> dans la classe."
                        },
                        {
                            "text": "Il s'est mis à pleuvoir et les gens ont voulu <w>rentrer</w> dans l'immeuble."
                        }
                    ],
                    "synonyms": [
                        "entrer"
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "rentrer dans la pièce"
                    ]
                },
                {
                    "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                    "sense_definition": "Mettre ou ranger à l'abri, faire passer quelque chose de l'extérieur vers l'intérieur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent se lève, il faut vite <w>rentrer</w> le linge qui sèche dehors."
                        },
                        {
                            "text": "Mon père a préféré <w>rentrer</w> la voiture dans le garage ce soir."
                        }
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "rentrer le linge",
                        "rentrer la voiture"
                    ]
                },
                {
                    "sense_id": "eab1db1b-1e99-38c6-99a3-40aedf2dd422",
                    "sense_definition": "Pouvoir être contenu ou logé dans un espace donné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces livres volumineux ne peuvent absolument pas <w>rentrer</w> dans mon sac."
                        },
                        {
                            "text": "Cette grande armoire en bois ne pourra jamais <w>rentrer</w> dans la chambre."
                        }
                    ],
                    "common_phrases": [
                        "rentrer dans la valise"
                    ]
                },
                {
                    "sense_id": "a1c76faa-7c38-389c-b9a1-a3977ed2465a",
                    "sense_definition": "Reprendre ses cours ou son travail après une période de vacances ou de congé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants vont <w>rentrer</w> à l'université au début du mois de septembre."
                        },
                        {
                            "text": "Après deux semaines de vacances, je vais enfin <w>rentrer</w> au bureau lundi."
                        }
                    ],
                    "common_phrases": [
                        "rentrer en classe",
                        "rentrer au bureau"
                    ]
                },
                {
                    "sense_id": "3abaffc8-d272-3375-ae4a-81886af23959",
                    "sense_definition": "Percuter ou heurter violemment un obstacle ou un autre véhicule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "choc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a perdu le contrôle et a failli <w>rentrer</w> dans un arbre."
                        },
                        {
                            "text": "En reculant sans faire attention, cette camionnette est <w>rentrée</w> dans ma portière."
                        }
                    ],
                    "common_phrases": [
                        "rentrer dans le mur",
                        "rentrer dedans"
                    ]
                },
                {
                    "sense_id": "b2a525f7-fe42-3fe1-a643-9ce89414e249",
                    "sense_definition": "Recouvrer ou récupérer des sommes engagées ou des droits.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les investissements importants, nous espérons <w>rentrer</w> dans nos frais rapidement."
                        },
                        {
                            "text": "Grâce à cette vente exceptionnelle, le commerçant a pu <w>rentrer</w> dans son argent."
                        }
                    ],
                    "common_phrases": [
                        "rentrer dans ses frais",
                        "rentrer dans son argent"
                    ]
                }
            ]
        }
    ]
