                "senses": [
                    {
                        "sense_id": "d47d2feb-ce75-3d26-ba11-7156e9fef936",
                        "entry_id": "428eac86-5c27-33b6-9637-d9d995bf40e8",
                        "glosses": [
                            "Qui sert à illustrer, explicatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1a1432-e1b6-4ed1-9be0-62072708dd98",
                                "sense_id": "d47d2feb-ce75-3d26-ba11-7156e9fef936",
                                "text": "Les panneaux illustratifs restent, pour l'instant, peu nombreux et le public aimerait en savoir un peu plus sur chaque console, ou apprendre des anecdotes qui font l'histoire du jeu vidéo."
                            },
                            {
                                "example_id": "19fdf560-7a38-4652-849e-46ee4627a80b",
                                "sense_id": "d47d2feb-ce75-3d26-ba11-7156e9fef936",
                                "text": "Comme les jugements analytiques ne font que développer, expliquer, éclaircir une connaissance que nous avions déjà sans y rien ajouter réellement, il [Kant] les appelle aussi jugements explicatifs ou illustratifs."
                            },
                            {
                                "example_id": "68f897a0-7c10-4f36-ab0e-5aaaf929123d",
                                "sense_id": "d47d2feb-ce75-3d26-ba11-7156e9fef936",
                                "text": "Comme l’emoji, le gif peut servir de réaction à un message autant que de signal d'un double sens. Il a une fonction illustrative, mimant de façon caricaturale et hyperbolique nos attitudes et notre état d'esprit."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2e17091-bba3-3823-a846-162fc0ff4c66",
                        "entry_id": "428eac86-5c27-33b6-9637-d9d995bf40e8",
                        "glosses": [
                            "Qui sert d’illustration, décoratif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8c384c-5105-499e-982b-846091779514",
                                "sense_id": "c2e17091-bba3-3823-a846-162fc0ff4c66",
                                "text": "Le Jannissaire de Girodet (…) fournit le second exemple de dessin illustratif, il est d'ailleurs exécrable."
                            }
                        ]
                    }
                ],
