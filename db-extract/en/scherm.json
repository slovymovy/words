                        "examples": [
                            {
                                "example_id": "6b1b5895-022a-45bb-aeb2-559f8f24de99",
                                "sense_id": "77c272bb-73ff-370b-a91b-0fdae8384b28",
                                "text": "[W]e went to work to build a \"scherm\" near one of the pools and about a hundred yards to the right of it. This is done by cutting a quantity of thorn bushes and piling them in the shape of a circular hedge. Then the space enclosed is smoothed, and dry tambouki grass, if obtainable, is made into a bed in the centre, and a fire or fires lighted."
                            }
                        ]
