                    {
                        "translation_id": "d34de812-1e82-43a2-926e-d0cdb39d5bb0",
                        "source_entry_id": "f3d68bc8-885f-38f6-9c7e-87181be7a31e",
                        "source_sense_id": "2ed1daf9-c425-337b-913f-b2fd6c2ec50a",
                        "target_lang_word": "cambium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cambium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                        "entry_id": "a2464bc3-3620-3aaf-b2e2-217426767aed",
                                        "glosses": [
                                            "Méristème secondaire formant une fine couche de cellules indifférenciées entre le xylème secondaire et le phloème secondaire, responsable de la croissance en épaisseur des tiges et des racines chez les plantes ligneuses.  Il produit vers l’intérieur le xylème secondaire et vers l’extérieur le phloème secondaire."
                                        ],
                                        "tags": [
                                            "Histologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2397e68-7235-430c-b520-1d2f4c444052",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Le cambium est une couche de cellules intermédiaire entre le xylème et le phloème, qui a pour rôle de produire des cellules pour ces deux tissus transporteurs de sève, à la demande."
                                            },
                                            {
                                                "example_id": "170024ba-93d9-42c9-815c-b8c3ec6b3e21",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Le cambium est à l’origine des fibres et des vaisseaux du bois, mais aussi du liber, tissu dans lequel circule la sève élaborée."
                                            },
                                            {
                                                "example_id": "b350258f-ec85-48b9-a60e-bc48cb048478",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "On donne, en effet, comme une règle générale, que le lieu d’apparition des premières formations libéroligneuses secondaires est en relation étroite avec l’emplacement du liber primaire : le cambium se constitue d’abord au niveau des tubes criblés […]."
                                            },
                                            {
                                                "example_id": "45007b33-ff3b-4ff9-8aa0-552ac2b46279",
                                                "sense_id": "c2e3573a-0756-352c-83ed-8aa47c6d9157",
                                                "text": "Incessamment ils parlaient de la sève et du cambium, du palissage, du cassage, de l’éborgnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
