                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae7ba25-e9b5-3527-91da-eb3a0dc04fe8",
                                        "entry_id": "c1c0e9c4-b183-3c97-bda2-4034e44e0819",
                                        "glosses": [
                                            "A late Bronze Age polity in Northern Anatolia on the border of the Hittite Empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63280001-9ba0-4c9b-ad22-505bb212fcf5",
                                                "sense_id": "0ae7ba25-e9b5-3527-91da-eb3a0dc04fe8",
                                                "text": "How closely the language of Kalasma is related to the other Luwian dialects of Late Bronze Age Anatolia will be the subject of further investigation."
                                            },
                                            {
                                                "example_id": "a1c041d5-7aaf-4198-879b-5b400e9e1daf",
                                                "sense_id": "0ae7ba25-e9b5-3527-91da-eb3a0dc04fe8",
                                                "text": "The most recently discovered minority language, recorded by government scribes (and previously unknown to modern scholars) is being called Kalasmaic – because it seems to have been spoken by a subject people in an area called Kalasma on the empire's northwestern fringe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ecc872-98a1-347e-b6de-f36266596f9b",
                                        "entry_id": "c1c0e9c4-b183-3c97-bda2-4034e44e0819",
                                        "glosses": [
                                            "An extinct Indo-European language spoken in the ancient state of Kalašma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c88e7e08-6070-4a94-9f75-60256e72ebee",
