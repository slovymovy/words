                    {
                        "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                        "entry_id": "c74058ac-c6b4-3d41-bd16-124b14387b70",
                        "glosses": [
                            "Motte de terre ou de gazon enlevée par la tête de la canne au moment de l’impact."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb172f99-aabf-4368-83fa-9ddc18007834",
                                "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                                "text": "Il avait ramassé son divot et il le brandissait comme un trophée. Puis il revint sur ses pas pour le replacer à l'endroit où il l'avait arraché."
                            },
                            {
                                "example_id": "0315a263-0923-490d-9e99-3680bdba6866",
                                "sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                                "text": "[…], ce qui l'emportait chez Sebby, c'était toujours ce sentiment de faire corps avec son élément, au point de ressentir personnellement la blessure d'un terrain maltraité par des vandales, écorché de divots, morceaux de gazon arrachés comme des lambeaux de chair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00960ed7-cb89-4ed5-bd67-5cae32c64146",
                        "source_entry_id": "c74058ac-c6b4-3d41-bd16-124b14387b70",
                        "source_sense_id": "a679ea28-885e-3a56-af39-5d0037839b2e",
                        "target_lang_word": "divot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19ea7f00-1832-3cf8-88ed-1367234e3b88",
                                        "entry_id": "b95fee52-5d6c-3b7c-a000-0983cfa52831",
                                        "glosses": [
                                            "A torn-up piece of turf, especially by a golf club in making a stroke or by a horse's hoof."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a481bbd4-a023-49a3-b8b1-d6799d36d759",
                                                "sense_id": "19ea7f00-1832-3cf8-88ed-1367234e3b88",
                                                "text": "Usually her voice came over the wire as something fresh and cool, as if a divot from a green golf-links had come sailing in at the office window, but this morning it seemed harsh and dry."
                                            },
                                            {
                                                "example_id": "620f0d36-6f61-487f-8d77-ef4acdc02f26",
                                                "sense_id": "19ea7f00-1832-3cf8-88ed-1367234e3b88",
                                                "text": "Soon, thick dark tufts of hair began to spread across his scalp, hanging over his ears, a moor of unruly divots which he was first unable to tame and with time willingly cultivated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f8ecd0-26bb-3969-985e-59c6b237a825",
                                        "entry_id": "b95fee52-5d6c-3b7c-a000-0983cfa52831",
                                        "glosses": [
                                            "A disruption in an otherwise smooth contour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a5a691-7aaf-4b38-ba7f-3ddc16898774",
                                                "sense_id": "a2f8ecd0-26bb-3969-985e-59c6b237a825",
                                                "text": "In these coldest hours before dawn, from three until six, I take up my knife again and hack at the chockstone. I continue to make minimal but visible progress in the divot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf8fd9b-c09e-3d66-9f6a-84d3b28fc504",
