                "senses": [
                    {
                        "sense_id": "11336c49-46e3-3fb3-b149-f1ae5c83cc87",
                        "entry_id": "f0898497-c9c1-36d1-95f7-2e471e050da5",
                        "glosses": [
                            "een dunne beschermende laag was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff255ed-73e9-447e-8538-0d23ce0af046",
                                "sense_id": "11336c49-46e3-3fb3-b149-f1ae5c83cc87",
                                "text": "Wanneer alle lagen zijn verwerkt blijft er een bak poeder over waarin het beeldje zich bevindt. Na het schoonmaken wordt het beeldje voor meer stevigheid voorzien van een lijm of waslaag."
                            },
                            {
                                "example_id": "14798331-a890-4f37-bc1d-7ab3b9a70bf1",
                                "sense_id": "11336c49-46e3-3fb3-b149-f1ae5c83cc87",
                                "text": "Remyelenisering is het vermogen van het lichaam om de door MS aangetaste zenuwen zelf te voorzien van een nieuwe stroomgeleidende waslaag. Wanneer je, zoals de meeste MS-patienten, lijdt aan de zogeheten Relapsing-Remmiting vorm is het lichaam zelf in staat om de zenuwen geheel of gedeeltelijk te herstellen. Dat ging bij mij jaren goed, al merkte ik wel dat ik na iedere opdonder moest inleveren. Krijg ik nu een fikse schub voor mijn kiezen, dan ben ik een functie kwijt. De kans dat deze nog terugkomt is klein."
                            },
                            {
                                "example_id": "e63adaad-6e55-41ea-b1ab-1b02cd179abf",
                                "sense_id": "11336c49-46e3-3fb3-b149-f1ae5c83cc87",
                                "text": "Op verschillende plekken rondom het brandende gebouw zijn roetdeeltjes neergekomen. Volgens een bericht van de gemeente zullen de deeltjes bij de eerste regenbui wegspoelen. Verder kan er een laagje paraffine op auto's liggen. Net als de roetdeeltjes levert het waslaagje geen risico geen voor de volksgezondheid op. ,,U kunt de was gewoon van uw auto wassen\", zegt de gemeente."
                            }
                        ]
                    }
