        "fr-extract.jsonl": [
            {
                "entry_id": "768330e3-b23b-3be6-a42c-e5be3d20284e",
                "word": "contrepoison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fab9d186-ed52-41ea-a106-29d0476ad3be",
                        "entry_id": "768330e3-b23b-3be6-a42c-e5be3d20284e",
                        "tags": [
                            "plural"
                        ],
                        "form": "contrepoisons"
                    },
                    {
                        "form_id": "080f59cf-c786-42de-a730-6a62215a1a01",
                        "entry_id": "768330e3-b23b-3be6-a42c-e5be3d20284e",
                        "tags": [],
                        "form": "contre-poison"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                        "entry_id": "768330e3-b23b-3be6-a42c-e5be3d20284e",
                        "glosses": [
                            "Remède qui empêche l’effet du poison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e22088f-94fa-4be8-b338-2a6c0ce1b58a",
                                "sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                                "text": "— Vous ne connaissez pas d’autre contrepoison ?\n— Je n’en connais pas."
                            },
                            {
                                "example_id": "d9415a78-61c8-4012-a3e7-bfc03b3c8be7",
                                "sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                                "text": "Et pourtant cette Odette d’où lui venait tout ce mal, ne lui était pas moins chère, bien au contraire plus précieuse, comme si au fur et à mesure que grandissait la souffrance, grandissait en même temps le prix du calmant, du contrepoison que seule cette femme possédait."
                            },
                            {
                                "example_id": "266bd4de-b6d9-454e-a205-2f72289eab70",
                                "sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                                "text": "On courut chez l’apothicaire et de force on l’amena pour qu’il donnât un contrepoison à la malheureuse femme qui déjà n’avait plus l’usage de ses jambes."
                            },
                            {
                                "example_id": "af45f753-5256-4932-aed7-d5f75a6595c6",
                                "sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                                "text": "Ce livre est le contrepoison des nouvelles doctrines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2cbe6ae-41e3-4d5c-9450-e2b99476411b",
                        "source_entry_id": "768330e3-b23b-3be6-a42c-e5be3d20284e",
                        "source_sense_id": "96d363bd-3162-3225-a506-d4cc32b1d2e0",
                        "target_lang_word": "antidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "A remedy to counteract the effects of poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b7735c-1257-4918-9383-3c93a9d7d028",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "She reached the hospital in time to receive the antidote for the snake venom."
                                            },
                                            {
                                                "example_id": "5aac5a50-1006-4105-9e7a-2e3f1ad27857",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "Can'ſt thou not Miniſter to a minde diſeas'd, / Plucke from the Memory a rooted Sorrow, / Raze out the written troubles of the Braine, / And with ſome ſweet Obliuious Antidote / Cleanſe the ſtufft boſome, of that perillous ſtuffe / Which weighes vpon the heart?"
                                            },
                                            {
                                                "example_id": "cdf4ea79-5fc4-4469-b790-6be4dc7f2024",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "The druids […] believed that mistletoe could make barren animals fecund, and that it was an antidote to all poisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "Something that counteracts or prevents something harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2f5e10-8245-404b-ba50-51fbf1181644",
                                                "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                                "text": "We need an antidote for this misinformation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                        "entry_id": "cae26b1b-59de-3f2f-b169-165bfb9a4c1d",
                                        "glosses": [
                                            "To counteract as an antidote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e55f23-4124-4643-963c-6d68923f9409",
                                                "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                                "text": "For his part, the patient must avoid some commonplace substances in order to avoid antidoting or stopping the action of the homeopathic remedy[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
