                    {
                        "translation_id": "2532fb21-5908-4af7-ab01-a8db702a9b44",
                        "source_entry_id": "8bafeb0a-c584-3dd0-b1f1-e041e43b68c7",
                        "source_sense_id": "9ef05ae8-2384-3452-a964-42fe32a3d378",
                        "source_sense_description": "Deckschicht einer Straße",
                        "target_lang_word": "chaussée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaussée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a93911-dee1-34aa-a6e0-2e0a34f4096c",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Sorte de talus qu’on fait au bord d’une rivière, d’un étang, pour retenir l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876a88ec-443a-42a1-b775-fc9972c5a9af",
                                                "sense_id": "c2a93911-dee1-34aa-a6e0-2e0a34f4096c",
                                                "text": "La chaussée d’un étang. La chaussée d’une rivière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2057549-7026-3cde-b21d-bdfbceedd65c",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Talus que l’on élève dans les lieux bas, humides et marécageux, pour servir de chemin de passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcda2ed-c478-4801-9018-41adafa81c2c",
                                                "sense_id": "d2057549-7026-3cde-b21d-bdfbceedd65c",
                                                "text": "Chaussée soutenue de maçonnerie, de pilotis, etc. Faire une chaussée dans un marais."
                                            },
                                            {
                                                "example_id": "fb88acd8-c8e9-4898-b8a9-bff51ebe29ab",
                                                "sense_id": "d2057549-7026-3cde-b21d-bdfbceedd65c",
                                                "text": "Les Romains ont fait la plupart des grands chemins dans les Gaules en manière de chaussées."
                                            },
                                            {
                                                "example_id": "73f5ba30-b1c9-4412-8947-1a45d10b2e46",
                                                "sense_id": "d2057549-7026-3cde-b21d-bdfbceedd65c",
                                                "text": "Un chemin sablé laissait à gauche la route de Tralee pour se diriger vers l’Océan. Il filait, en chaussée, au milieu des prairies marécageuses, parsemées de petits étangs d’un vert plus sombre, sur lesquels des patrouilles d’oiseaux sauvages flottaient avec gravité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Partie médiane d’une rue ou d’une route où passent les véhicules, par contraste avec les trottoirs, bas-côtés, ou bermes, réservés aux piétons."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21bab46-da3a-4b12-a9f1-75a5e98afdf4",
                                                "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                                "text": "Ils cheminaient donc en silence et ils allaient traverser la chaussée pour remonter le côté gauche du boulevard Malesherbes, lorsque le financier s'arrêta."
                                            },
                                            {
                                                "example_id": "a718f963-c6ca-4e64-b043-c3bdf1da8faa",
                                                "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                                "text": "Topographiquement parlant, nous avons peu d’observations à faire sur cette chaussée à peu près rectilinéaire de six grandes lieues qui nous reste à parcourir de Thonon à Genève."
                                            },
                                            {
                                                "example_id": "99302fa5-2f1d-4b3e-b4c2-a6c07648c537",
                                                "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s'écrasait contre une devanture ; […]."
                                            },
                                            {
                                                "example_id": "89417db4-1aec-49d4-9390-d9fd15dda0b0",
                                                "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                                "text": "De l’autre côté de la chaussée, le poste de police […] avait un air peu engageant."
                                            },
                                            {
                                                "example_id": "d100c6be-ab9e-4231-9cf9-19d2685e9c60",
                                                "sense_id": "d8a4a3c9-488a-3ba9-a802-e60383d6fdc9",
                                                "text": "Le vélo, considéré, par la loi, comme un véhicule à cause de ses dimensions, est autorisé à circuler sur la chaussée des routes communales et départementales, mais pas sur les voies rapides (autoroute, routes nationales, boulevards périphériques)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6649bb4d-0ca4-311c-acc5-380d8e747d75",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Ouvrage artificiel transversal présent dans le lit d’un cours d’eau permettant de réguler l’écoulement de l’eau en formant un barrage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dd93827-9646-395f-8597-bc44676f01c3",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Voie de circulation reliant généralement deux villes, deux bourgs."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d99ff94a-b2c1-4066-b3b0-634cce35d668",
                                                "sense_id": "9dd93827-9646-395f-8597-bc44676f01c3",
                                                "text": "Jef Van Willebroeck était un homme heureux, et pour cause. D’abord il était Bruxellois, ce qui n’est pas donné à tout le monde. Ensuite, il possédait au numéro 233 de la chaussée d’Etterbeek, le plus charmant estaminet qui se pût voir."
                                            },
                                            {
                                                "example_id": "c1b6a9ce-c7a3-4543-b144-0750e33c0dbf",
                                                "sense_id": "9dd93827-9646-395f-8597-bc44676f01c3",
                                                "text": "Un regard qui eût sondé attentivement toute cette brume eût pu remarquer, à quelque distance, arrêté et comme caché derrière la masure qui borde sur la chaussée de Nivelles l’angle de la route de Mont-Saint-Jean à Braine-l’Alleud, une façon de petit fourgon de vivandier à coiffe d’osier goudronnée, attelé d’une haridelle affamée broutant l’ortie à travers son mors, et dans ce fourgon une espèce de femme assise sur des coffres et des paquets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb93075-1a04-3b98-957d-812f9a8ff54c",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Sac de la huche du moulin."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "200d4534-e0a7-3942-ad56-46b7f8cd33d6",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Écueil allongé dépassant légèrement le niveau de la mer. — (IHO SP-23, 4ᵉ édition (en préparation), Nomenclature des espaces maritimes au 01.01.2004, Commission nationale de toponymie [de France] (CNT), Service hydrographique et océanographique de la Marine (SHOM), au nom de l’OHI (Organisation hydrographique internationale), 2004)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "907969f2-72f2-3936-b5ca-78630237e5c8",
                                        "entry_id": "2af7d73c-4eb9-339e-8418-889ab4b41b46",
                                        "glosses": [
                                            "Pièce de la cadrature d’une montre."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
