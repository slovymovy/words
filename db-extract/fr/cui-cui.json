                                    {
                                        "sense_id": "e410aa9b-79bb-3b97-8175-094a034ae667",
                                        "entry_id": "de4a6518-3769-3eed-a96f-c113c778dd65",
                                        "glosses": [
                                            "Of a small bird, to make short, high-pitched sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f72330-b7ba-401d-bb98-4e800c9ad164",
                                                "sense_id": "e410aa9b-79bb-3b97-8175-094a034ae667",
                                                "text": "[…] a brood of ducklings, which had lost their mother, filed into the barn, cheeping feebly and wandering from side to side […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90f8245d-ac37-319e-97a3-244249a8dcfc",
                                        "entry_id": "de4a6518-3769-3eed-a96f-c113c778dd65",
                                        "glosses": [
                                            "To express in a chirping tone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f75ab26-9e7a-47a0-9d84-2582b4dd2e4e",
                                                "sense_id": "90f8245d-ac37-319e-97a3-244249a8dcfc",
                                                "text": "O Swallow, Swallow, if I could follow, and light / Upon her lattice, I would pipe and trill, / And cheep and twitter twenty million loves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cheep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fb75317-18e4-3f94-8903-377211f7c410",
                                        "entry_id": "ec36eb7f-08cf-3572-8d30-bfde20e8afc2",
