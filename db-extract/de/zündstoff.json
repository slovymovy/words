                "senses": [
                    {
                        "sense_id": "c33a10ee-ff79-37dd-9929-e6605a7693f9",
                        "entry_id": "e2545138-f4be-39de-88e0-20ec7b01633d",
                        "glosses": [
                            "Substanz, die sich leicht entzünden lässt, um etwas zur Explosion zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f260b3a0-452e-4a0e-9b85-2c4035681d40",
                                "sense_id": "c33a10ee-ff79-37dd-9929-e6605a7693f9",
                                "text": "„Der Zündstoff besteht aus Kaliumchlorat und Pflanzengummi mit einem starken Zusatz von feinem Sand, der die Heftigkeit des Abbrennens mindern soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                        "entry_id": "e2545138-f4be-39de-88e0-20ec7b01633d",
                        "glosses": [
                            "etwas, das eine Auseinandersetzung, eine heftige Diskussion, einen Konflikt auslöst"
                        ],
                        "tags": [
                            "meist übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "69a91a19-ee90-4dfd-8825-5f24337ad9e4",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "„Hunger, Krankheit und Armut produzieren nicht nur Leid, sie sind auch Zündstoff für soziale Konflikte.“"
                            },
                            {
                                "example_id": "a0531ee3-c676-44f8-9a8d-a8aa278700a1",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "[COVID-19-Pandemie:] „Das ist die Nachricht, auf die viele Eltern gewartet haben: Schon im Sommer könnten zumindest auch ältere Kinder geimpft werden. Doch dies birgt schon neuen Zündstoff in der Impfdebatte.“"
                            },
                            {
                                "example_id": "a9168443-ea3d-411d-b777-652512c34968",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "„Für Zündstoff sorgen neue Zahlen über die Höhe der griechischen Renten.“"
                            },
                            {
                                "example_id": "03c40b92-37d0-40bc-9601-83a737f1e9e4",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "„Trotz erheblichen Zündstoffs, trotz unterschiedlicher Standpunkte und Stellungnahmen pegelte die Erregungsnadel nie in den Rotbereich.“"
                            },
                            {
                                "example_id": "1d5ba3f9-8de3-41e7-90e1-d49ffddb06e0",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "„Es genügt oftmals ein hartes Wort, um den angehäuften Zündstoff des Zornes zur Explosion zu bringen.“"
                            },
                            {
                                "example_id": "188353dc-3f65-4941-9d9a-b4bdf3841fb3",
                                "sense_id": "b670c464-3025-3203-9c4b-517b440c00ee",
                                "text": "„Die Veränderung der ethnischen Zusammensetzung birgt erheblichen Zündstoff für politische Konflikte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
