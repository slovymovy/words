                    },
                    {
                        "translation_id": "d8e7e8b5-1cb7-4dce-b575-3076b9a2f28e",
                        "source_entry_id": "44878849-c3f6-3bfb-ab5a-f2dff71cc9cf",
                        "source_sense_id": "3cb86d03-6c52-3201-bd2c-841766311bdd",
                        "source_sense_description": "een woord om aan te duiden dat iets zich in het verleden af heeft gespeeld",
                        "target_lang_word": "il y a",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "il y a",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba919541-2ba4-3569-99f3-34cdfc95b164",
                                        "entry_id": "081b968e-f334-354f-8fac-687904be0bd2",
                                        "glosses": [
                                            "Présent de l’indicatif de y avoir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "note": "Les formes interrogatives sont : y a-t-il ou est-ce qu’il y a",
                                        "examples": [
                                            {
                                                "example_id": "55506e4c-7506-4ba9-ad58-8f4322f7ce77",
                                                "sense_id": "ba919541-2ba4-3569-99f3-34cdfc95b164",
                                                "text": "Il y avait des curieux à toutes les fenêtres et des sonneurs de trompe à toutes les encoignures occupées par des cabarets."
                                            },
                                            {
                                                "example_id": "bac73c9d-3f99-45ea-b39f-709b5be4f59a",
                                                "sense_id": "ba919541-2ba4-3569-99f3-34cdfc95b164",
                                                "text": "« Ils deviennent des acteurs de la conservation de la nature, reconnaît Florian Kirchner. Il y a quelques espèces qui ont pu être sauvées grâce à la captivité, comme le cheval de Przewalski ou la perruche de Maurice. Reste qu’il y a énormément d’échecs. »"
                                            },
                                            {
                                                "example_id": "7a28a91d-7fce-4dfb-b10c-9518bc82acc7",
                                                "sense_id": "ba919541-2ba4-3569-99f3-34cdfc95b164",
                                                "text": "120 femmes sont tuées chaque année par leur conjoint, leur mari ou leur ex. Derrière cette statistique, il y a des prénoms, des histoires, des vies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "il y a",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                        "entry_id": "70f78e0f-49da-389c-8423-742c5116c200",
                                        "glosses": [
                                            "Indique un moment antérieur au moment de l’énonciation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312a9581-d119-4ef8-8a17-11c91711a115",
                                                "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                                "text": "Il y avait quatre ans, le duc d’Épernon, alors gouverneur de la Guyenne, suivi de tous ses gentilshommes et de ses troupes, le rencontrant au milieu de son clergé dans une procession, l’appela insolent, et lui donna deux coups de canne très-vigoureux ; sur quoi l’archevêque l’excommunia."
                                            },
                                            {
                                                "example_id": "b58c4b9a-6125-4873-aca9-4cc4fab2385d",
                                                "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                                "text": "Bob Marley est mort un lundi. C’était il y a exac­te­ment 35 ans, le 11 mai 1981. Depuis, le monde de la musique ne peut oublier l’hé­ri­tage que lui a laissé Robert Nesta Marley, qui a véri­ta­ble­ment trans­formé le reggae et influencé bien d’autres genres musi­caux."
                                            },
                                            {
                                                "example_id": "e14c5bde-91b0-4bda-ba8a-c4967de18c51",
                                                "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                                "text": "Selon les archéologues, il s’agit d’un Russe, mort il y a cent ans, le 19 avril 1917, durant la fameuse offensive Nivelle."
                                            },
                                            {
                                                "example_id": "a99e71d6-0873-4a05-a8c6-7263b26ffefe",
                                                "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                                "text": "Ces travaux apportent de nouveaux résultats quant à la structure des fleurs les plus anciennes, datant d’il y a 140 millions d’années."
                                            },
                                            {
                                                "example_id": "a8eafc32-9eed-457e-b49b-55787d3e5040",
                                                "sense_id": "79e036dd-e6bb-3afb-a9e0-df7779beba5a",
                                                "text": "Il y a trois mois, Marcus Hutchins a connu son moment de gloire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
