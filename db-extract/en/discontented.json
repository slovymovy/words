                    },
                    {
                        "form_id": "1d069bdd-012a-46ca-b6ce-e949d5790c4f",
                        "entry_id": "2aa6217f-ea0b-3603-8a57-80b0b60067ad",
                        "tags": [],
                        "form": "most discontented"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                        "entry_id": "2aa6217f-ea0b-3603-8a57-80b0b60067ad",
                        "glosses": [
                            "（人が）不満のある。不平のある、不満気な、不満足でおもしろくない。（discontented with ... で）... に不満のある。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4357ddf-51cc-4324-816a-f8cce0df9750",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "Often when he was discontented with his own labour, or bad news just received, he would jump up and say something unkind to her, who was not to blame for his discontent.",
                                "translation": "彼はよく、自分が有する労働者に不満があったり、何か悪いニュースを受け取ったりすると、飛び上って、彼女には責任がない不満であっても彼女へ向かって意地の悪いことを言うのでした。"
                            },
                            {
                                "example_id": "16c3b92c-f5a8-4f35-92ff-8d05c2cc80e7",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "彼はよく、自分が有する労働者に不満があったり、何か悪いニュースを受け取ったりすると、飛び上って、彼女には責任がない不満であっても彼女へ向かって意地の悪いことを言うのでした。"
                            },
                            {
                                "example_id": "0dbdfae0-0117-4e06-a315-972d0f53a514",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "All this time Harry was crying in the most discontented way, although we were doing all we could for him.",
                                "translation": "このあいだ中、ハリーはこの上なく不満気に泣いていた。ぼくたちは彼のためにできることを全部やっていたんだけれども。"
                            },
                            {
                                "example_id": "8bcde027-1d3f-4442-96c1-9f9477f1921a",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "このあいだ中、ハリーはこの上なく不満気に泣いていた。ぼくたちは彼のためにできることを全部やっていたんだけれども。"
                            },
                            {
                                "example_id": "ef15c1aa-779a-443f-a85d-b4e46a267055",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "He was not discontented till he met you. You have made him so.",
                                "translation": "あなたに会うまで彼に不平などなかったのよ。あなたが彼をそうさせたんでしょう。"
                            },
                            {
                                "example_id": "8c1c6a88-3bcb-4f88-92df-441dc1a82b2f",
                                "sense_id": "619ea1c2-2e25-3109-84e1-bf6d9f58ca3d",
                                "text": "あなたに会うまで彼に不平などなかったのよ。あなたが彼をそうさせたんでしょう。"
                            }
                        ]
                    }
                ],
