                "forms": [],
                "senses": [
                    {
                        "sense_id": "61fabdc3-1589-3f6a-91cd-1f91ce12377c",
                        "entry_id": "afc84ef2-935f-37ac-b599-c600db656a6a",
                        "glosses": [
