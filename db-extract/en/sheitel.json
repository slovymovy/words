                        "entry_id": "f92796c8-241a-3d27-85a9-ee8f3d6c168a",
                        "glosses": [
                            "A wig worn by married Orthodox Jewish women."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "199fe982-ac09-49d4-be22-010ad310d559",
                                "sense_id": "9cef7b87-0281-3e94-9a94-e6ae9db5d15f",
                                "text": "I keep wanting to put her in a sheitel, the wig that every Orthodox Jewish wife is supposed to wear in order to prevent a man not her husband from lusting after her in his heart."
                            },
                            {
                                "example_id": "639ccd04-b740-49d9-a660-0a025961d7bd",
                                "sense_id": "9cef7b87-0281-3e94-9a94-e6ae9db5d15f",
                                "text": "Many even have their sheitel professionally styled: according to the New York Times, a Madison Avenue salon that specializes in sheitel grooming charges at least $600 for the service: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "db5be07a-6195-363a-b77b-519c2eeff12c",
                        "entry_id": "f92796c8-241a-3d27-85a9-ee8f3d6c168a",
                        "glosses": [
                            "A wig (of any kind)."
                        ],
                        "tags": [
                            "Polari"
                        ],
                        "examples": [
                            {
                                "example_id": "3d282672-56be-4750-ace1-46171bc3e979",
                                "sense_id": "db5be07a-6195-363a-b77b-519c2eeff12c",
                                "text": "Will you take a varder at the cartz on the feely-omi in the naf strides: the one with the bona blue ogles polarying the omi-palone with a vogue on and a cod sheitel."
                            }
                        ]
                    }
