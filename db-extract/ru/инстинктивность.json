                                        "entry_id": "8c1df5ad-9daa-3b4d-9cbe-b5dbe53cec1a",
                                        "glosses": [
                                            "The quality of being instinctive, or prompted by instinct."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3957e3cd-d5d2-45d2-ac3d-fb0725424809",
                                                "sense_id": "57f0c24c-96b2-31af-bcc9-594290ab27f4",
                                                "text": "There is growth only in plants; but there is irritability, or, a better word, instinctivity, in insects."
                                            }
                                        ]
                                    }
                                ]
                            }
