                "senses": [
                    {
                        "sense_id": "afd28cb7-99a2-3370-bbc9-5c72dc0ecd2a",
                        "entry_id": "2aa77e9d-a216-3430-a815-79ee007a1af2",
                        "glosses": [
                            "Ruiner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8229c279-b7ff-4fce-b3d2-cde843d1f38b",
                                "sense_id": "afd28cb7-99a2-3370-bbc9-5c72dc0ecd2a",
                                "text": "Ouais je vais me reruiner alors que j'avais de nouveau un peu de quoi survivre; tant pis."
                            },
                            {
                                "example_id": "048fa66d-76b6-4cf6-9ee4-dd5a9c561a8d",
                                "sense_id": "afd28cb7-99a2-3370-bbc9-5c72dc0ecd2a",
                                "text": "Comme j'ai pas envie de me reruiner, je laisse moisir ça dans un tiroir..."
                            },
                            {
                                "example_id": "5ca25ce5-72ef-44b5-bcb1-3a2797c37f3a",
                                "sense_id": "afd28cb7-99a2-3370-bbc9-5c72dc0ecd2a",
                                "text": "Et tenter de faire marcher le mieux possible la machine pour laquelle on s'est ruiné en attendant de se reruiner !"
                            }
                        ]
                    }
