                "senses": [
                    {
                        "sense_id": "4d77be7e-7e73-339a-a5b1-903376e2cf98",
                        "entry_id": "d05e10e6-243b-3e6f-8ac8-9ab8f169df91",
                        "glosses": [
                            "(durch bestimmte Eigenschaften abzugrenzender/gekennzeichneter) Teil einer Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "975e755f-4979-4c9c-84fa-4663f1e9a0df",
                                "sense_id": "4d77be7e-7e73-339a-a5b1-903376e2cf98",
                                "text": "„Wenn einzelne Straßenabschnitte umgebaut oder eine komplette Straße verändert werden sollen, ist das ein Job für Verkehrsplaner.“"
                            },
                            {
                                "example_id": "580ab68b-5655-46cf-af5a-eef42b603bb8",
                                "sense_id": "4d77be7e-7e73-339a-a5b1-903376e2cf98",
                                "text": "„Zudem sollen besonders unfallträchtige Straßenabschnitte gesichert werden, ein neues Koala-Hospital soll sich um erkrankte Tiere kümmern, und über eine neue Telefon-Hotline sollen Bürger Informationen über Koalas in Not übermitteln können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
