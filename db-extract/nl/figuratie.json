                                    },
                                    {
                                        "sense_id": "5b146028-7b06-347b-bf07-f5a72a0f98c3",
                                        "entry_id": "28f4af18-adbc-3403-a4d8-ba0748d3aba4",
                                        "glosses": [
                                            "Form, outline or boundaries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c89668f-41c9-3f63-b771-51967dcf942a",
                                        "entry_id": "28f4af18-adbc-3403-a4d8-ba0748d3aba4",
                                        "glosses": [
                                            "Ornamentation or decoration, especially by the addition of figures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "003b3164-ef55-4ad4-8602-a9beb476cdab",
                                                "sense_id": "9c89668f-41c9-3f63-b771-51967dcf942a",
                                                "text": "[…]a shift to modernist building typologies in the early 1950s led to the abandonment of symmetry, centrality, and figuration. Since the 1980s, big-box typologies, frosted with postmodern architectural veneer, have dominated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82a7fdff-d8f6-3f2d-8325-3d5ac9314c05",
                                        "entry_id": "28f4af18-adbc-3403-a4d8-ba0748d3aba4",
                                        "glosses": [
                                            "Mixture of concords and discords."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab448f26-8c9f-4b6d-8e8f-2ab57384676d",
                                                "sense_id": "82a7fdff-d8f6-3f2d-8325-3d5ac9314c05",
                                                "text": "Here and throughout, variation infuses the music, Chopin’s innovative, elastic figuration masking the underlying similarity of bars 23 and 25."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a7b419e-2ac6-395c-adf7-90f775ef221a",
                                        "entry_id": "28f4af18-adbc-3403-a4d8-ba0748d3aba4",
                                        "glosses": [
                                            "Representation through visual forms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666dff53-84ce-4bd9-9460-fe43a805a11c",
                                                "sense_id": "8a7b419e-2ac6-395c-adf7-90f775ef221a",
                                                "text": "To recapitulate: consider the human form—skin, bone, and flesh. Consider the painting—surface, structure, and pigment. With a little license, the first gives us the ingredients for what might be called human or “figurative” figuration; the second gives us the ingredients for abstract or “nonfigurative” figuration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f8e806-ffd1-33eb-a011-460ad763f2d7",
                                        "entry_id": "28f4af18-adbc-3403-a4d8-ba0748d3aba4",
                                        "glosses": [
                                            "A structure through which people are joined, or the process of constructing such structures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7924abea-7c4f-48fb-8584-5bbeb98f996a",
                                                "sense_id": "70f8e806-ffd1-33eb-a011-460ad763f2d7",
                                                "text": "Figurations of interdependent people make up many webs of interdependence, which are characterized in part by different balances of power of many sorts, such as families, states, towns or simply groups."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ab9b947-3c08-47d5-92d4-e83db83ca32a",
                        "source_entry_id": "fe0db49b-d2ef-3b6c-898a-491997e9ad34",
                        "target_lang_word": "figuration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figuration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f89bcc42-78ce-3f19-9323-2d34f28a38b2",
                                        "entry_id": "18c297ff-745a-3d72-acd4-41231913e66c",
                                        "glosses": [
                                            "Formation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a89da20-cc44-4534-b0e6-df6dd1e02c1b",
                                                "sense_id": "f89bcc42-78ce-3f19-9323-2d34f28a38b2",
                                                "text": "Et si cette colline d'argile est couronnée de rochers calcaires, la durée du temps, que je réduis à quatorze mille ans, ne doit-elle pas être augmentée de celui qui a été nécessaire pour le transport des coquillages dont la colline est surmontée, et cette durée si longue n'a-t-elle pas encore été suivie du temps nécessaire à la pétrification et au dessèchement de ces sédiments, et encore d'un temps tout aussi long pour la figuration de la colline par angles saillants et rentrants ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd74f8f-4961-3a82-8594-2446dbbfcef6",
                                        "entry_id": "18c297ff-745a-3d72-acd4-41231913e66c",
                                        "glosses": [
                                            "Ensemble des figurants ou figurantes d’un théâtre ou d’une pièce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b78f41a-02ad-411b-a766-d1083501f66d",
                                                "sense_id": "dbd74f8f-4961-3a82-8594-2446dbbfcef6",
                                                "text": "Je gagerais que le chef de la figuration du Châtelet ne me reconnaitrait pas, s'il passait à côté de moi dans la rue, reprit Alain."
                                            },
                                            {
                                                "example_id": "8b4f7929-5be9-4ae1-8efb-e672673feabc",
                                                "sense_id": "dbd74f8f-4961-3a82-8594-2446dbbfcef6",
                                                "text": "Demain, je demanderai à Bourdaloux qu’il vous inscrive au maximum sur les feuilles de figuration. Comme ça, vous ne crèverez pas de faim complètement…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc1eddf-288a-37cd-9761-6e520c8c6e30",
                                        "entry_id": "18c297ff-745a-3d72-acd4-41231913e66c",
                                        "glosses": [
                                            "La partie du spectacle dont sont chargés les figurants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5819b3c-f7ee-34b0-97f8-083e28af0907",
                                        "entry_id": "18c297ff-745a-3d72-acd4-41231913e66c",
                                        "glosses": [
                                            "Situation de celle ou de celui qui n'a aucun rôle dans un groupe humain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c51bcfe-9b25-4117-a463-620ec828a853",
                                                "sense_id": "b5819b3c-f7ee-34b0-97f8-083e28af0907",
                                                "text": "— Je ne cause pas avec la figuration. Qu’on m’amène un flic avec du galon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27a5abd3-6811-3e0e-bec0-8349010b52d8",
                                        "entry_id": "18c297ff-745a-3d72-acd4-41231913e66c",
                                        "glosses": [
                                            "Action de rendre visible par une figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff825052-8e6b-4a79-8b34-c3e2e7a38817",
                                                "sense_id": "27a5abd3-6811-3e0e-bec0-8349010b52d8",
                                                "text": "La mappemonde est une figuration de la terre."
                                            },
                                            {
                                                "example_id": "2a22a692-165b-4fed-9667-476a10cbc500",
                                                "sense_id": "27a5abd3-6811-3e0e-bec0-8349010b52d8",
                                                "text": "Ce n'est pas la simple référence à l'espace, ni même à la figuration ou à la visualisation qui fait la géométrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
