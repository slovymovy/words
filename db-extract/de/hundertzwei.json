                "forms": [],
                "senses": [
                    {
                        "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                        "entry_id": "7d66e7d6-d534-39ad-bf81-a5e432890364",
                        "glosses": [
                            "die Kardinalzahl zwischen 101 und 103; hundert und zwei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d2dae7-93dc-4467-a064-622dd2ac2563",
                                "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                                "text": "„Hundertzwei Minuten sind eine spärliche Zeitspanne. Kein Kinofilm passt in sie, kein gutes Baseballspiel.“"
                            },
                            {
                                "example_id": "bf720529-6168-44ba-bc8a-b9ef2803dc09",
                                "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                                "text": "„Wie sich herausstellt, war mein Vater zu jener Zeit nebenbei Autohändler. Innerhalb von sechs Monaten hatte er hundertzwei Autos zugelassen.“"
                            },
                            {
                                "example_id": "026fa134-035a-4d2f-80ca-90d2009f3b13",
                                "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                                "text": "„Es beteiligten sich fünftausend Personen mit fünfzehntausend Vorschlägen. Hundertzwei Vorschläge lauteten auf ›Knusperchen‹.“"
                            },
                            {
                                "example_id": "d2c01022-4043-48b3-827b-daf546b84645",
                                "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                                "text": "„Überhaupt war er ebenso eifrig im Lehren wie begierig im Lernen, und wenn Dauletschah bemerkt, daß er dreißig von den hundertzwei Jahren seines Lebens damit beschäftigt war, sich Kenntnisse zu erwerben, so ist das zu wenig[…]“"
                            },
                            {
                                "example_id": "d68bc645-7a31-400f-bcbf-2dad722cdcf4",
                                "sense_id": "80b247f9-8ab4-35e8-88a2-775195c7ac15",
                                "text": "„Im Jahre 1620 kamen hundertzwei alte Puritaner nach Amerika, die hatten sich in England unbeliebt gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
