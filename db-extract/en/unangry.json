                        "glosses": [
                            "Not angry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62dbb98b-ce15-403b-9643-190801e76adf",
                                "sense_id": "4f205b42-48fb-3c1d-a1ff-839249240213",
                                "text": "She would have given anything to lighten her mind of its burdens and to be able to think of her husband without suspicion. Just a word from him would do, just an unangry word; even a lie, a soothing lie."
                            },
                            {
                                "example_id": "245eedbd-8221-426c-821f-eb7d9a6d2c49",
                                "sense_id": "4f205b42-48fb-3c1d-a1ff-839249240213",
                                "text": "Thro’ peaceful Orbits these unangry glide."
                            },
                            {
                                "example_id": "191aff71-e39b-4441-a18c-a92fb7e8f414",
                                "sense_id": "4f205b42-48fb-3c1d-a1ff-839249240213",
                                "text": "His eyes had become unangry and wary."
                            },
                            {
                                "example_id": "02276016-3dda-40ac-be21-27ff6a5d4f33",
                                "sense_id": "4f205b42-48fb-3c1d-a1ff-839249240213",
                                "text": "“I think it’s anger, Jana.” (Cooper says this in such an exquisitely unangry way.) “Anger at you.”"
                            }
                        ]
                    }
