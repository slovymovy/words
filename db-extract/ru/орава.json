        "fr-extract.jsonl": [
            {
                "entry_id": "ce5d73be-188d-346e-b62f-7a8ef82d819c",
                "word": "орава",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "a3838646-94c2-45b3-a0e0-81497b2940a5",
                        "entry_id": "ce5d73be-188d-346e-b62f-7a8ef82d819c",
                        "tags": [],
                        "form": "арава"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4de3d2de-d7e1-3030-abbc-5c672f7402a1",
                        "entry_id": "ce5d73be-188d-346e-b62f-7a8ef82d819c",
                        "glosses": [
                            "Foule bruyante, horde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf942b3c-ceb3-4a67-9a21-8bab42bce489",
                                "sense_id": "4de3d2de-d7e1-3030-abbc-5c672f7402a1",
                                "text": "Ты сообрази, сколько в Петербурге чиновников-то — и вдруг всю эту ораву, за неимением дел, упразднить!",
                                "translation": "Pensez simplement au nombre de fonctionnaires qu'il y a à Saint-Pétersbourg - d'un coup, toute cette horde, faute de choses à faire, devrait être abolie !"
                            },
                            {
                                "example_id": "9b81ced4-60e9-4646-a0b2-af37161739d4",
                                "sense_id": "4de3d2de-d7e1-3030-abbc-5c672f7402a1",
                                "text": "Семьдесят два судьи, а за ними стража, свидетели, секретари, служки, в общем, человек сто, вся орава их торжественно выводит его на площадь.",
                                "translation": "Soixante-douze juges, et derrière eux des gardes, des témoins, des secrétaires, des domestiques, en tout une centaine de personnes, toute une foule le conduit solennellement sur la place."
                            },
                            {
                                "example_id": "ce025810-ead5-4e8c-9b1d-fc9e6b5db2c7",
                                "sense_id": "4de3d2de-d7e1-3030-abbc-5c672f7402a1",
                                "text": "Мысли вертелись в голове ураганом, и разветвлялись, и порождали новые мысли; и было совершенно непонятно, что со всей этой оравой мыслей делать…",
                                "translation": "Les pensées tourbillonnaient dans ma tête comme un ouragan, se ramifiaient et donnaient naissance à de nouvelles pensées ; et je ne savais absolument pas quoi faire de toute cette horde de pensées…"
                            }
                        ]
                    }
                ],
