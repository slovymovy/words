                "senses": [
                    {
                        "sense_id": "d0e6a468-ee30-39ae-b214-4595ba803636",
                        "entry_id": "c0cbfb27-afd0-3625-a87f-c1bbcdce158c",
                        "glosses": [
                            "Weg abseits des Hauptweges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc4919b-ed7b-4810-a6e9-c4eccc022412",
                                "sense_id": "d0e6a468-ee30-39ae-b214-4595ba803636",
                                "text": "„Einmal begegnete Luise ihm, als er durch das Dorf ging, tat aber so, als sähe sie ihn nicht und bog in einen Nebenweg ein.“"
                            },
                            {
                                "example_id": "f2957cec-0ee5-40fe-a30a-c0694397f647",
                                "sense_id": "d0e6a468-ee30-39ae-b214-4595ba803636",
                                "text": "„Am 10. August kam das dem Fürsten Andrej unterstellte Regiment auf der Heerstrasse an der Abzweigung des nach Lysyja Gory führenden Nebenweges vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
