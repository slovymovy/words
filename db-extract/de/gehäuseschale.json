                "senses": [
                    {
                        "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                        "entry_id": "fcbd3fb7-1489-3899-b7e8-eb9abb845503",
                        "glosses": [
                            "eine schützende, äußere Wandung bei technischen Konstruktionen, Geräten oder Hohlkörpern"
                        ],
                        "tags": [
                            "Mechanik"
                        ],
                        "examples": [
                            {
                                "example_id": "7f15e982-b4ec-41ff-a743-a2276afdce97",
                                "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                                "text": "„Die Gehäuseschale besteht aus Feinsilber. Wickelkerne und Band dieses Exemplars sind nicht mehr original.“"
                            },
                            {
                                "example_id": "9e6b2526-1116-4d11-9950-6c31fb2c8bc9",
                                "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                                "text": "„Die etwa 140 Gramm leichten Kopfhörer besitzen eine mit geflochtenem Carbon verstärkte Gehäuseschale, sie sehen sehr edel aus und sind erstklassig verarbeitet.“"
                            },
                            {
                                "example_id": "887fb94a-a74a-4448-9c35-bd68b18760ef",
                                "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                                "text": "„Die starken Rundungen an der hinteren Gehäuseschale tragen ihren Teil dazu bei, dass das Gerät ein Stück dicker wirkt, als es eigentlich ist.“"
                            },
                            {
                                "example_id": "e525e9da-9bda-44f8-bc96-45f3abba28dd",
                                "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                                "text": "„Dieses topex Kennzeichnungssystem besteht aus einem separaten Platz zur Montage des Handsenders vor dem Rundtisch zum manuellen Einlegen/Entnehmen der Gehäuseschale.“"
                            },
                            {
                                "example_id": "889f560e-df42-4261-9a49-b4d670942afc",
                                "sense_id": "a199b64b-942f-399c-8fe8-5abbcb76fb26",
                                "text": "„Wie beim Aluminium gießen wird das Design der Gehäuseschalen in der Form hinterlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
