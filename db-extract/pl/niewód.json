                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8bfdac3-18e2-333f-af9e-2b742782170b",
                                        "entry_id": "12095164-24e6-33c2-bd7a-0d885df81e15",
                                        "glosses": [
                                            "ein von einem oder zwei Booten gezogener, großer, trichterförmiger Netzsack als Fischfanggerät in der Seefischerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36127fe1-5d0a-486b-af5c-6d91c74dd4f3",
                                                "sense_id": "a8bfdac3-18e2-333f-af9e-2b742782170b",
                                                "text": "„Das pelagische Schleppnetz ist heute neben dem Grundschleppnetz das meistverwendete Fanggerät in der Hochseefischerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11a749c7-74d2-4cf3-92b0-0d3d663597bb",
                        "source_entry_id": "343dea67-0db6-3b36-8d6d-4dd84bce47a3",
