                                                "example_id": "1c17a4c8-f696-4383-8d91-e4483a320c12",
                                                "sense_id": "023a60d8-6d1c-3bd6-96d8-393ae3f187d4",
                                                "text": "Toute cette végétation disparaît peu à peu devant l'envahissement des cépées de plus en plus touffues."
                                            },
                                            {
                                                "example_id": "6e60e621-133d-4a41-9192-fe86a9c17d6e",
                                                "sense_id": "023a60d8-6d1c-3bd6-96d8-393ae3f187d4",
                                                "text": "Une barbe touffue."
                                            }
                                        ]
                                    },
                                    {
