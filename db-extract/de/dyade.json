                "translations": [
                    {
                        "translation_id": "1c0e4ab5-37e7-4c8f-a9a8-2bbd631c2f78",
                        "source_entry_id": "84f6c933-0fee-3045-8710-862018e19760",
                        "source_sense_id": "049ba8cf-4081-3b0f-be91-52c8fe047038",
                        "source_sense_description": "Mathematik, Vektorrechnung: Zusammenfassung zweier Einheiten",
