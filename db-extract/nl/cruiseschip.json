                            {
                                "example_id": "1e5515d5-6fd3-4178-87d7-ba2fcdcc1010",
                                "sense_id": "c93d6dae-11b0-36fd-96f0-643cf589c665",
                                "text": "Een luxe cruiseschip."
                            },
                            {
                                "example_id": "4fb81e83-8c8b-4801-aaa2-d3cbef4342fe",
                                "sense_id": "c93d6dae-11b0-36fd-96f0-643cf589c665",
                                "text": "Toen ik veertien was maakte ons gezin een reis naar Egypte. We voeren met een cruiseschip over de Nijl, bezochten de piramiden van Gizeh en de tempels van Karnak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54634c89-bbc9-42b4-b427-2aa373deae1e",
                        "source_entry_id": "11946603-bf53-308a-8479-059d50d217c5",
                        "source_sense_id": "c93d6dae-11b0-36fd-96f0-643cf589c665",
                        "source_sense_description": "een passagierschip dat gebouwd en uitgerust wordt om er cruises mee te maken.",
                        "target_lang_word": "Kreuzfahrtschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzfahrtschiff",
