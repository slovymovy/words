                "senses": [
                    {
                        "sense_id": "43407da8-b8f6-32a3-9327-aa8d34a7d644",
                        "entry_id": "a6622ad9-8dfc-37fe-b628-8e4dce206134",
                        "glosses": [
                            "разг. ласк. к блондинка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d7c0a5-b00b-4d1f-a3cc-023c517c7f41",
                                "sense_id": "43407da8-b8f6-32a3-9327-aa8d34a7d644",
                                "text": "В его воображении мелькнула стройная блондиночка в светло-голубом платье и с вздёрнутым носиком…"
                            },
                            {
                                "example_id": "2faddddc-ba9d-4311-81bf-8f4c12d1b097",
                                "sense_id": "43407da8-b8f6-32a3-9327-aa8d34a7d644",
                                "text": "Первой начала́ своё «письмо» семнадцатилетняя Кристин — хорошенькая блондиночка с широко раскрытыми голубыми глазами."
                            }
                        ]
                    }
                ],
