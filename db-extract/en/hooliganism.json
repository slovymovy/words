                        ]
                    },
                    {
                        "translation_id": "785889b1-33e2-4411-9334-f5695c45d2f4",
                        "source_entry_id": "343591b9-61ee-3184-ba1f-c7901bf1390a",
                        "source_sense_id": "a5f02120-8f30-3e00-8ba2-5fe994d60e19",
