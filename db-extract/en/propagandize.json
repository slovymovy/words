                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5223efe9-592d-438e-a1c9-30a948ef3c60",
                                "sense_id": "b59c7c57-9d8e-353c-a753-8cb011749e20",
                                "text": "After we'd managed to make ourselves comfortable in this garret, my new friends began to propagandize me. All they knew about me was that I was a student […]"
                            }
