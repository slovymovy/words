            "senses": [
                {
                    "sense_id": "df59afc8-ac31-3d57-ad05-679db63bd734",
                    "sense_definition": "humeur of gemoedstoestand, voornamelijk gebruikt in vaste uitdrukkingen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is vandaag helemaal niet in zijn <w>hum</w> door de slechte nachtrust."
                        },
                        {
                            "text": "Let maar niet op haar opmerking, ze is een beetje uit haar <w>hum</w>."
                        }
                    ],
                    "synonyms": [
                        "humeur",
                        "stemming"
                    ],
                    "common_phrases": [
                        "in zijn hum zijn",
                        "uit zijn hum zijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vooral gebruikelijk in vaste verbindingen"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "b4e89f9d-845f-3ed6-91f3-30003b38d4e3",
                    "sense_definition": "uitroep waarmee men aarzeling, twijfel, bedenking of lichte afkeuring uitdrukt",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "tussenwerpsel_twijfel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Hum</w>, ik weet niet zeker of dat wel zo'n goed idee is,\" mompelde hij."
                        },
                        {
                            "text": "\"<w>Hum</w>, daar vraag je me wat,\" antwoordde de leraar bedachtzaam."
                        }
                    ],
                    "synonyms": [
                        "hm"
                    ]
                },
                {
                    "sense_id": "7b79447e-c488-33dd-a22d-82da3c9a5123",
                    "sense_definition": "kuchje of klank gebruikt om iemands aandacht te trekken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tussenwerpsel_aandacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Hum</w>! Mag ik even jullie aandacht voor een korte mededeling?\" riep hij door de zaal."
                        },
                        {
                            "text": "Ze kuchte zachtjes en zei: \"<w>Hum</w>, we moeten nu echt vertrekken.\""
                        }
                    ],
                    "synonyms": [
                        "kuch"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07488a84-3c5a-363d-b50b-77a96781ec35",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>hummen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging_hummen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik diep nadenk over een vraag, <w>hum</w> ik vaak ongemerkt."
                        },
                        {
                            "text": "Ik <w>hum</w> bevestigend om te laten horen dat ik nog steeds luister."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm van hummen"
                        }
                    ]
                },
                {
                    "sense_id": "dee83eba-36ee-36ef-a36d-55af38b7a5d1",
                    "sense_definition": "gebiedende wijs van <w>hummen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging_hummen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hum</w> niet steeds zo irritant als ik tegen je praat!"
                        },
                        {
                            "text": "<w>Hum</w> gewoon even als je het met me eens bent."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs van hummen"
                        }
                    ]
                },
                {
                    "sense_id": "ad4e8681-bc2b-36e0-a27a-193d00a8a002",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>hummen</w> bij inversie",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging_hummen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>hum</w> je steeds als ik iets probeer uit te leggen?"
                        },
                        {
                            "text": "<w>Hum</w> je nu omdat je twijfelt of begrijp je het echt niet?"
                        }
                    ],
                    "traits": [
