                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f199c7b-9280-456e-a01a-54daa342da48",
                                "sense_id": "ca4845c5-fc5e-383d-9715-78b9608e0e47",
                                "text": "W ostatnich wyborach prezydenckich prawybory w Partii Demokratycznej odbyły się w 39 stanach, zaś w Partii Republikańskiej w 38 stanach."
                            }
                        ],
