                "senses": [
                    {
                        "sense_id": "ed947761-56c8-3c58-81fc-44fafc805377",
                        "entry_id": "40a01e8d-af20-3e6a-811c-d9cab72648a2",
                        "glosses": [
                            "Donner un caractère allodial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a332f024-a4e3-4218-b3e4-ff1d3238f172",
                                "sense_id": "ed947761-56c8-3c58-81fc-44fafc805377",
                                "text": "Ils pouvoient enfin faire des lois, accorder des octrois, affranchir des villes et districts, tailler leurs sujets, allodialiser des fiefs et ériger des alleus en fiefs, sauf néanmoins en tout les droits d'autrui."
                            },
                            {
                                "example_id": "e1942c86-7c99-42ce-831b-37de222304ae",
                                "sense_id": "ed947761-56c8-3c58-81fc-44fafc805377",
                                "text": "Comme les 22 bonniers seront possédés par elles à titre de franc-alleu, et qu'ils étaient tenus en fief par Gautier d'Heppignies, il fallait les allodialiser."
                            }
                        ]
                    }
                ],
