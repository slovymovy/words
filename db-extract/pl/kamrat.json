                        "source_sense_id": "7ecda8a4-e3d1-3a14-ab6a-1f08bff45b56",
                        "target_lang_word": "Kamerad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamerad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ac4a4f-39c4-385c-8d8c-79d435513109",
                                        "entry_id": "80b47e84-2dff-3505-b922-96bbdd289724",
                                        "glosses": [
                                            "Soldat, mit dem man die Stube teilt; Soldat in der eigenen Armee"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b04e68-f1b3-4329-9283-5f0b3be4e4c2",
                                                "sense_id": "a8ac4a4f-39c4-385c-8d8c-79d435513109",
                                                "text": "Ich hatt' einen Kameraden, einen bessern findst du nit. (Lied)"
                                            },
                                            {
                                                "example_id": "2c06e3dd-e86d-4fb3-9e74-52df05d5573b",
                                                "sense_id": "a8ac4a4f-39c4-385c-8d8c-79d435513109",
                                                "text": "„Im Quartier saßen die Kameraden und rauchten und schwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cc87273-0cf8-33a8-9f70-e5e468b5c4c5",
                                        "entry_id": "80b47e84-2dff-3505-b922-96bbdd289724",
                                        "glosses": [
                                            "Person, mit der man auf eine bestimmte Art (Sport, Schule, Beruf, Freundschaft oder Ähnliches) verbunden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcb701e-d4a7-4160-a64f-63e4ea104a16",
                                                "sense_id": "3cc87273-0cf8-33a8-9f70-e5e468b5c4c5",
                                                "text": "Auf der Reise war er immer ein guter Kamerad."
                                            },
                                            {
                                                "example_id": "6704663f-2846-4d2f-8c9f-d9ec5d3aa931",
                                                "sense_id": "3cc87273-0cf8-33a8-9f70-e5e468b5c4c5",
                                                "text": "„Von der Odyssee, die die Kameraden der Schönheider Feuerwehr hinter sich haben, können viele Retter ein Lied singen.“"
                                            },
                                            {
                                                "example_id": "38745269-e426-448b-ba77-43a7ba0d3eb8",
                                                "sense_id": "3cc87273-0cf8-33a8-9f70-e5e468b5c4c5",
                                                "text": "„Beim Extrembergsteigen vertraut der Kletterer den Kameraden seiner Seilschaft, die ihn sichern.“"
                                            },
                                            {
                                                "example_id": "1ee874a6-9034-4621-b53d-e5a956d198b1",
                                                "sense_id": "3cc87273-0cf8-33a8-9f70-e5e468b5c4c5",
                                                "text": "„Ja, meine hingebende Herzlichkeit trat so offen hervor, daß sie oft den Spott meiner Kameraden herausforderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
