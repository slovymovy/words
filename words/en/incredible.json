{
    "word_family": [
        "credible",
        "credibility",
        "incredibly",
        "incredibility",
        "incredulous",
        "noncredible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b2a5f6b-0ce3-3cfa-b757-89b21a62fbd3",
                    "sense_definition": "Marvellous, wonderful, or excellent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "positive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had an <w>incredible</w> time at the party last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>потрясающе</w> провели время на вечеринке вчера вечером.",
                                "zh": "昨晚我们在派对上玩得<w>非常开心</w>。"
                            }
                        },
                        {
                            "text": "That was an <w>incredible</w> meal you cooked for us.",
                            "target_lang_translations": {
                                "ru": "Ты приготовил для нас <w>изумительную</w> еду.",
                                "zh": "你为我们做的这顿饭真是<w>太棒了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awesome",
                        "amazing",
                        "great"
                    ],
                    "common_phrases": [
                        "incredible job",
                        "incredible feeling",
                        "incredible opportunity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхитительный, чудесный или превосходный.",
                        "zh": "极好的，美妙的，非常棒的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потряса́ющий",
                                "target_lang_sense_clarification": "вызывающий восхищение"
                            },
                            {
                                "target_lang_word": "изуми́тельный",
                                "target_lang_sense_clarification": "восхитительный"
                            },
                            {
                                "target_lang_word": "чуде́сный",
                                "target_lang_sense_clarification": "прекрасный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "形容事物非常出色"
                            },
                            {
                                "target_lang_word": "美妙的",
                                "target_lang_sense_clarification": "形容体验或感觉非常好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5cab61d-23a0-333e-b760-a2e9848df86b",
                    "sense_definition": "Amazing, astonishing, or awe-inspiring.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "positive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was <w>incredible</w>.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был <w>невероятным</w>.",
                                "zh": "从山顶看到的景色<w>令人惊叹</w>。"
                            }
                        },
                        {
                            "text": "She showed <w>incredible</w> speed during the final race.",
                            "target_lang_translations": {
                                "ru": "Она показала <w>невероятную</w> скорость в финальном забеге.",
                                "zh": "她在决赛中展现出了<w>不可思议的</w>速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unbelievable",
                        "awesome",
                        "amazing",
                        "extraordinary"
                    ],
                    "common_phrases": [
                        "incredible speed",
                        "incredible view",
                        "incredible power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удивительный, поразительный или впечатляющий.",
                        "zh": "令人惊叹的，不可思议的，令人敬畏的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероя́тный",
                                "target_lang_sense_clarification": "очень сильный, чрезвычайный"
                            },
                            {
                                "target_lang_word": "порази́тельный",
                                "target_lang_sense_clarification": "вызывающий изумление"
                            },
                            {
                                "target_lang_word": "ошеломи́тельный",
                                "target_lang_sense_clarification": "производящий сильное впечатление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人惊叹的",
                                "target_lang_sense_clarification": "形容程度极高，让人赞叹"
                            },
                            {
                                "target_lang_word": "不可思议的",
                                "target_lang_sense_clarification": "形容程度超乎寻常"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                    "sense_definition": "Too implausible to be credible; beyond belief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It seems <w>incredible</w> that he survived the fall without a scratch.",
                            "target_lang_translations": {
                                "ru": "Кажется <w>невероятным</w>, что он пережил падение без единой царапины.",
                                "zh": "他从那么高的地方摔下来竟然毫发无伤，这简直<w>难以置信</w>。"
                            }
                        },
                        {
                            "text": "The witness told an <w>incredible</w> story about what happened that night.",
                            "target_lang_translations": {
                                "ru": "Свидетель рассказал <w>невероятную</w> историю о том, что случилось той ночью.",
                                "zh": "目击者讲述了一个关于那天晚上发生之事的<w>难以置信的</w>故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unbelievable",
                        "noncredible"
                    ],
                    "antonyms": [
                        "believable",
                        "credible"
                    ],
                    "common_phrases": [
                        "incredible coincidence",
                        "seem incredible",
                        "incredible story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправдоподобный; такой, в который трудно поверить.",
                        "zh": "难以置信的，无法相信的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероя́тный",
                                "target_lang_sense_clarification": "в который трудно поверить"
                            },
                            {
                                "target_lang_word": "неимове́рный",
                                "target_lang_sense_clarification": "чрезвычайный, трудно вообразимый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难以置信的",
                                "target_lang_sense_clarification": "形容事情不合常理，让人无法相信"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}