                            },
                            {
                                "target_lang_word": "colza",
                                "target_lang_sense_clarification": "plante cultivée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "806f8cc9-5ddf-37c1-b22e-bf30d0b70b39",
                    "sense_definition": "A stack or stook of hay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers gathered the dried grass into a <w>cole</w> before the rain started.",
                            "target_lang_translations": {
                                "ru": "Рабочие собрали сухую траву в <w>стог</w> до того, как начался дождь.",
                                "fr": "Les ouvriers ont rassemblé l'herbe séchée en une <w>meule de foin</w> avant que la pluie ne commence."
                            }
                        },
                        {
                            "text": "We sat by the <w>cole</w> in the field to rest after a long day of work.",
                            "target_lang_translations": {
                                "ru": "Мы сидели у <w>стога</w> в поле, чтобы отдохнуть после долгого рабочего дня.",
                                "fr": "Nous nous sommes assis près de la <w>meule de foin</w> dans le champ pour nous reposer après une longue journée de travail."
                            }
                        }
                    ],
                    "synonyms": [
                        "haystack",
                        "rick"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стог или скирда сена.",
                        "fr": "Un tas ou une meule de foin."
                    },
