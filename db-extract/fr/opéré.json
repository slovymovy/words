                    {
                        "sense_id": "c7f7f6ed-1d01-321d-ba30-2b128bcc8f49",
                        "entry_id": "2a03f047-87dc-3e5a-baf5-0a89da2ff662",
                        "glosses": [
                            "Patient qui a subi une opération chirurgicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb61d3e-41a7-4b36-97e6-770ae54284c6",
                                "sense_id": "c7f7f6ed-1d01-321d-ba30-2b128bcc8f49",
                                "text": "C’est un opéré du cœur."
                            },
                            {
                                "example_id": "d1123e67-181b-44c9-bca1-f364e04f1fd1",
                                "sense_id": "c7f7f6ed-1d01-321d-ba30-2b128bcc8f49",
                                "text": "Mais ma propre indifférence m’étonnait. Je ressemblais à l’opéré qui se réveille et qui dit qu’il n’a rien senti."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ac9d1511-61d8-359f-92b2-3a3cba18c6a1",
                "word": "opéré",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d360e57-952f-39a6-8e06-3c679afacd4d",
                        "entry_id": "ac9d1511-61d8-359f-92b2-3a3cba18c6a1",
                        "glosses": [
                            "Participe passé masculin singulier de opérer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "71a1324e-3c9a-4775-ac55-bd8a41d8e0e7",
                                "sense_id": "6d360e57-952f-39a6-8e06-3c679afacd4d",
                                "text": "APPELMANS (Louvain, Belgique). — N’a pas opéré de gastrite, mais a dégastro-entérostomisé et opéré des gastrites sans ulcère avec gastro-entérostomie."
                            },
                            {
                                "example_id": "cf257a02-d5d4-45af-91dd-3eef39a44ed2",
                                "sense_id": "6d360e57-952f-39a6-8e06-3c679afacd4d",
                                "text": "L’immense répartition du conte 425 et des formes associées interdit de même toute localisation pour le passage du mythe au conte, en admettant même - ce que je tiens pour probable - qu’il se soit opéré une seule fois, et de là diffusé, puis re-partagé en variantes."
                            }
                        ]
                    }
