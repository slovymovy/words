                                        "examples": [
                                            {
                                                "example_id": "a8c727f3-7b3c-4c99-b9ee-c0c86ebb6ae8",
                                                "sense_id": "ad20b98e-a4d6-39ef-bcbb-7c711866da80",
                                                "text": "Un jour, des malfaiteurs, enhardis par ce silence, crurent assez légèrement pouvoir rincer la caisse de ce Juif."
                                            },
                                            {
                                                "example_id": "96951002-d3ba-4aef-9cad-d759fcdd7721",
                                                "sense_id": "ad20b98e-a4d6-39ef-bcbb-7c711866da80",
                                                "text": "Rincer une cabriole veut dire dévaliser une chambre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add70cfb-f828-3f78-9424-936e9f7e9dd6",
                                        "entry_id": "d0e8523c-850b-331e-8656-b1e184a0421e",
                                        "glosses": [
