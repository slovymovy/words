                "senses": [
                    {
                        "sense_id": "13084ddd-3f9d-3db1-a50c-cba478e5442a",
                        "entry_id": "1656ff9d-6b75-3fd8-8ad9-770a55b09b93",
                        "glosses": [
                            "Enlever son caractère gouvernemental à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e30adfa-3257-4101-a3ae-654fbc091259",
                                "sense_id": "13084ddd-3f9d-3db1-a50c-cba478e5442a",
                                "text": "Que la santé se dépolitise, se dégouvernementalise, qu’elle soit gérée par ceux qui s’y connaissent le mieux, les professionnels de la santé, proches des patients, appréciés de ceux-ci et de leurs pairs, et que ces professionnels amenés naturellement à être des leaders soient aussi formés en gestion pour augmenter leur pouvoir de mobilisation et l’efficience créative des services qu’ils chapeautent."
                            }
                        ]
                    }
