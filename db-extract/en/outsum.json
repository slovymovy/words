                "senses": [
                    {
                        "sense_id": "a4a67cc7-eb94-30de-9af0-c24e639f33dc",
                        "entry_id": "182cf021-aabe-3117-b6e9-f28cd541d22b",
                        "glosses": [
                            "To exceed in number or quantity."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "684c4526-78c9-440e-893e-4d79228709bd",
                                "sense_id": "a4a67cc7-eb94-30de-9af0-c24e639f33dc",
                                "text": "She kept her faith; though Odo came by day With missions from the castle that outsummed\nHis several hairs, and were of less respect; […]"
                            },
                            {
                                "example_id": "fe927a16-c696-4c7d-b0f7-13eb10be5c14",
                                "sense_id": "a4a67cc7-eb94-30de-9af0-c24e639f33dc",
                                "text": "May thirtieth — I thank thee O Lord, in that thou hast made our support fund to outsum the preceding year by $2500. We received thru thy graciousness, $34,800."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec222b57-c3f3-3120-a4f9-28ebf5ad2d1a",
                        "entry_id": "182cf021-aabe-3117-b6e9-f28cd541d22b",
                        "glosses": [
                            "To exceed in total; outweigh"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "978613ca-9ef6-4b2d-abe8-f7c75cb8ff86",
                                "sense_id": "ec222b57-c3f3-3120-a4f9-28ebf5ad2d1a",
                                "text": "No one else cared for him; but he had an instinct that her great love for him outsummed all he could hope from others."
                            },
                            {
                                "example_id": "7a98504d-6c21-4ab4-9c5b-3685c4e104df",
                                "sense_id": "ec222b57-c3f3-3120-a4f9-28ebf5ad2d1a",
                                "text": "Nicholas quickly snatched it from the boy and returned it to its place. \"Its value outsums any amount you can imagine.\""
                            }
                        ]
                    }
                ],
