                "senses": [
                    {
                        "sense_id": "6c7c251c-84eb-362d-b962-2404e4c3745e",
                        "entry_id": "fc858c6d-d961-3bef-8143-d49b35487a2d",
                        "glosses": [
                            "Cor des Alpes, mesurant de 1,50 mètre à 2 mètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8469ce48-adc4-476f-adbe-d93af7e482e8",
                                "sense_id": "6c7c251c-84eb-362d-b962-2404e4c3745e",
                                "text": "Das Alphorn gilt als typisches Instrument der Schweiz. — Le cor des Alpes passe pour l’instrument typique de Suisse."
                            },
                            {
                                "example_id": "94516179-e523-4af1-964f-410367de802e",
                                "sense_id": "6c7c251c-84eb-362d-b962-2404e4c3745e",
                                "text": "Um ein Alphorn zum Klingen zu bringen, bläst man Atemluft mit Hilfe des Zwerchfells in das Instrument und versetzt dabei die Luft in Schwingungen.",
                                "translation": "Pour faire sonner un cor des Alpes, on souffle l’air expiré dans l’instrument à l’aide du diaphragme et on fait ainsi vibrer l’air."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
