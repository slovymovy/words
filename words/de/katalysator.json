                {
                    "sense_id": "561bc6fe-ff56-3de2-b795-ae499b56abf5",
                    "sense_definition": "Person, Ereignis oder Umstand, wodurch eine gesellschaftliche oder persönliche Entwicklung ausgelöst oder beschleunigt wird",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uebertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die plötzliche Wirtschaftskrise wirkte als <w>Katalysator</w> für tiefgreifende politische Reformen im Land."
                        },
                        {
                            "text": "Neue digitale Technologien fungieren oft als <w>Katalysator</w> für den gesellschaftlichen Wandel."
