{
    "word_family": [
        "buff"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36d409bf-8b58-3422-9efd-d0ff356d04ac",
                    "sense_definition": "A blunt or sudden refusal or rejection of an offer, request, or person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was surprised by her quick <w>rebuff</w> to his proposal.",
                            "target_lang_translations": {
                                "nl": "Hij was verrast door haar snelle <w>afwijzing</w> van zijn voorstel."
                            }
                        },
                        {
                            "text": "The government issued a firm <w>rebuff</w> to the protesters' demands.",
                            "target_lang_translations": {
                                "nl": "De regering gaf een krachtige <w>afwijzing</w> aan de eisen van de demonstranten."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "refusal",
                        "repulse"
                    ],
                    "antonyms": [
                        "acceptance",
                        "welcome"
                    ],
                    "common_phrases": [
                        "sharp rebuff",
                        "blunt rebuff"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een botte of plotselinge afwijzing van een aanbod, verzoek of persoon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afwijzing",
                                "target_lang_sense_clarification": "algemene term voor het afwijzen van een verzoek of aanbod"
                            },
                            {
                                "target_lang_word": "afpoeiering",
                                "target_lang_sense_clarification": "informele term voor een botte of korte afwijzing"
                            },
                            {
                                "target_lang_word": "koude douche",
                                "target_lang_sense_clarification": "figuurlijke uitdrukking voor een onverwachte en onaangename afwijzing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33beb403-0e47-3ebc-9fa5-bf0192077cea",
                    "sense_definition": "The act of beating back or driving away something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers managed a strong <w>rebuff</w> of the enemy attack.",
                            "target_lang_translations": {
                                "nl": "De soldaten slaagden erin een sterke <w>afweer</w> te bieden tegen de vijandelijke aanval."
                            }
                        },
                        {
                            "text": "The wall provided a sturdy <w>rebuff</w> to the crashing waves.",
                            "target_lang_translations": {
                                "nl": "De muur bood een stevige <w>weerstand</w> tegen de beukende golven."
                            }
                        }
                    ],
                    "synonyms": [
                        "repulsion",
                        "repulse"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het terugslaan of afweren van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afweer",
                                "target_lang_sense_clarification": "het actief tegenhouden of afslaan van een aanval"
                            },
                            {
                                "target_lang_word": "terugslaan",
                                "target_lang_sense_clarification": "het fysiek afweren of beantwoorden van een aanval"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f29fca7-aff0-3f8c-816e-795b86b488fc",
                    "sense_definition": "To reject someone or something in an abrupt or unkind manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>rebuffed</w> all his attempts to apologize for the mistake.",
                            "target_lang_translations": {
                                "nl": "Ze <w>wees</w> al zijn pogingen om zich te verontschuldigen voor de fout botweg <w>af</w>."
                            }
                        },
                        {
                            "text": "The company <w>rebuffed</w> the takeover bid from its competitor.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf <w>wees</w> het overnamebod van zijn concurrent <w>af</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "spurn",
                        "snub"
                    ],
                    "antonyms": [
                        "accept",
                        "welcome"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets op een botte of onvriendelijke manier afwijzen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afwijzen",
                                "target_lang_sense_clarification": "iemand of iets formeel of direct weigeren"
                            },
                            {
                                "target_lang_word": "afpoeieren",
                                "target_lang_sense_clarification": "iemand op een onvriendelijke manier wegsturen"
                            },
                            {
                                "target_lang_word": "de deur wijzen",
                                "target_lang_sense_clarification": "iemand resoluut afwijzen of wegsturen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6407288b-1aab-32d5-a1af-b0775afa5563",
                    "sense_definition": "To polish or shine something again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>rebuff</w> the old silver coins to make them shine.",
                            "target_lang_translations": {
                                "nl": "Hij besloot de oude zilveren munten <w>opnieuw op te poetsen</w> om ze te laten glanzen."
                            }
                        },
                        {
                            "text": "You should <w>rebuff</w> the leather shoes after cleaning them.",
                            "target_lang_translations": {
                                "nl": "Je moet de leren schoenen <w>opnieuw oppoetsen</w> nadat je ze hebt schoongemaakt."
                            }
                        }
                    ],
                    "synonyms": [
                        "repolish"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets opnieuw oppoetsen of laten glanzen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opnieuw oppoetsen",
                                "target_lang_sense_clarification": "het proces van opnieuw glans aanbrengen"
                            },
                            {
                                "target_lang_word": "bijpoetsen",
                                "target_lang_sense_clarification": "het bijwerken van de glans van een voorwerp"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}