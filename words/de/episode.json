    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47387278-5fda-3976-adbf-033e2abc96ff",
                    "sense_definition": "einzelne Folge oder abgeschlossener Teil einer Fernsehserie, eines Podcasts oder eines mehrteiligen Films",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gestern Abend haben wir uns die neueste <w>Episode</w> unserer Lieblingsserie angesehen."
                        },
                        {
                            "text": "In der letzten <w>Episode</w> stirbt die junge Heldin einen völlig unerwarteten Tod."
                        }
                    ],
                    "synonyms": [
                        "Folge",
                        "Teil"
                    ],
                    "common_phrases": [
                        "neue Episode",
                        "letzte Episode"
                    ]
                },
                {
                    "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                    "sense_definition": "zeitlich begrenztes Ereignis oder kurzer Abschnitt innerhalb eines längeren Geschehens oder Lebenslaufs",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlauf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Streit war zum Glück nur eine kurze <w>Episode</w> in ihrer langen Freundschaft."
                        },
                        {
                            "text": "Er betrachtet seine Studienzeit im Ausland heute als eine sehr lehrreiche <w>Episode</w>."
                        }
                    ],
                    "synonyms": [
                        "Intermezzo",
                        "Zwischenspiel"
                    ],
                    "common_phrases": [
                        "kurze Episode",
                        "eine Episode im Leben"
                    ]
                },
                {
                    "sense_id": "9122fc58-f38b-3715-a44c-2cfb9b39afd2",
                    "sense_definition": "in eine literarische Haupterzählung eingeschobene Nebenhandlung oder Begebenheit",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "literatur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Autor unterbricht die Haupterzählung gern durch kleine heitere <w>Episoden</w>."
                        },
                        {
                            "text": "In diesem Roman wirkt die eingeschobene <w>Episode</w> wie ein eigener kleiner Text."
                        }
                    ],
                    "synonyms": [
                        "Nebenhandlung",
                        "Zwischenspiel"
                    ],
                    "common_phrases": [
                        "eingeschobene Episode"
                    ]
                },
                {
                    "sense_id": "5e227822-0cdb-34e4-b89e-4e1f445f2e24",
                    "sense_definition": "zeitlich abgrenzbare Krankheitsphase oder vorübergehender Krankheitsschub im Verlauf einer Erkrankung",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer schweren depressiven <w>Episode</w> erholte sich der Patient allmählich wieder."
                        },
                        {
                            "text": "Im Verlauf der chronischen Krankheit traten solche <w>Episoden</w> glücklicherweise nur selten auf."
                        }
                    ],
                    "common_phrases": [
                        "depressive Episode"
                    ]
                },
                {
                    "sense_id": "df60162e-1b52-308d-a7b3-da8afa117953",
                    "sense_definition": "themenfreies Zwischenspiel oder modulierender Zwischensatz zwischen Themendurchführungen in einer Fuge",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwischen den Themeneinsätzen der Fuge steht eine kurze <w>Episode</w>, die in eine neue Tonart moduliert."
                        },
                        {
                            "text": "In dieser barocken Komposition leitet eine kurze <w>Episode</w> zur nächsten Tonart über."
                        }
                    ],
                    "synonyms": [
                        "Zwischenspiel"
                    ]
                }
            ]
        }
    ]
}