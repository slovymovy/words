                                "target_senses": [
                                    {
                                        "sense_id": "bc71ea64-3a57-3d3a-97b2-f4dceb4c8df2",
                                        "entry_id": "11e2bb77-ee88-3cbd-a3a9-13464203c094",
                                        "glosses": [
                                            "Habitant du Pays basque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f18296e1-ac83-4bd7-9fd7-cd605ee022e9",
                                                "sense_id": "bc71ea64-3a57-3d3a-97b2-f4dceb4c8df2",
                                                "text": "Cette frontière qu'il fallait défendre contre les Goths et contre les Basques appartenait alors toute entière au roi d’Austrasie, au nom duquel le ban de guerre fut publié sur les deux rives de l’Adour."
                                            },
                                            {
                                                "example_id": "2357612c-a84c-488f-b2ad-eace2d9225d4",
                                                "sense_id": "bc71ea64-3a57-3d3a-97b2-f4dceb4c8df2",
                                                "text": "Vous conviendrez qu'une maison sans chat, c'est comme un curé sans sa soutane ou un Basque sans son béret : inconcevable! Les souris, ces amies de l'homme, risquent de pulluler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b90b7b5-1734-4aa8-ad9d-42166b9341c4",
                        "source_entry_id": "ae5c681d-75d9-32c8-bf3e-5ba670ca04c8",
                        "source_sense_id": "b263ed8b-28a9-3398-a267-8858b0ab3c99",
