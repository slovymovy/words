                    {
                        "sense_id": "2b9e705f-03a8-3cfe-8f47-fc6287597ad7",
                        "entry_id": "b37a989f-6746-34a1-b33b-908a7aafaf25",
                        "glosses": [
                            "Benêt."
                        ],
                        "tags": [
