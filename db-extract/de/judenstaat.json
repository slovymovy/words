                "senses": [
                    {
                        "sense_id": "6b489474-8d51-3190-9d1a-5f5b1e64382b",
                        "entry_id": "0376f74e-0165-32d2-a976-15bf44a7bfb9",
                        "glosses": [
                            "Staat, der den Juden gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088d3163-c920-47d2-b92b-0f0b955d932e",
                                "sense_id": "6b489474-8d51-3190-9d1a-5f5b1e64382b",
                                "text": "„Wir unterhalten uns oft über den zukünftigen Judenstaat.“"
                            },
                            {
                                "example_id": "9d3c3dbf-53ed-4cfd-8ff8-8a60743edc77",
                                "sense_id": "6b489474-8d51-3190-9d1a-5f5b1e64382b",
                                "text": "„Die strategische Grundannahme lautete, dass nur ein starkes Israel die arabischen Staaten daran hindern könne, es zu vernichten, und dass man sie vielleicht sogar dazu bringen würde, Israel anzuerkennen und Frieden mit ihm zu schließen, wenn der Judenstaat über Atomwaffen verfügte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
