                "senses": [
                    {
                        "sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                        "entry_id": "402b31a4-f53d-30fd-9707-f83e1def75ae",
                        "glosses": [
                            "de man van een dochter of zoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9bd41b7-17c4-4d8e-9252-c237b0bcc1a0",
                                "sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                                "text": "De waarde van de Turkse lira is naar een nieuw dieptepunt gedaald. De daling werd deze week ingezet na het nieuws dat de Turkse president Recep Tayyip Erdogan zijn schoonzoon tot nieuwe minister van Financiën heeft benoemd."
                            },
                            {
                                "example_id": "601da0df-7023-4ba0-a7ed-082b5c140344",
                                "sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                                "text": "Owens speelde in de jaren 80 schoonzoon Elvin in de hitserie. Alhoewel hij in de jaren daarna geregeld kleine gastrolletjes had in televisieseries, bleef het grote werk uit voor de inmiddels 57-jarige. Hij ging daardoor werken buiten de entertainmentindustrie, en werd afgelopen week door een klant gefotografeerd in de supermarkt waar hij een baan heeft. De foto kwam online te staan, waar veel mensen honend reageerden."
                            },
                            {
                                "example_id": "d90876f4-b08f-4bb7-8574-ac39f0cfd5ca",
                                "sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                                "text": "Haar vader de baron verlangde een welgestelde schoonzoon en dat was een onmogelijke eis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d024b50-9953-441c-bcd5-878215e5d215",
                        "source_entry_id": "402b31a4-f53d-30fd-9707-f83e1def75ae",
                        "source_sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                        "source_sense_description": "de man van een dochter of zoon",
                        "target_lang_word": "Schwiegersohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiegersohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                        "entry_id": "89208fcb-94f7-38b6-a4c9-38e1a1e2169b",
                                        "glosses": [
                                            "Ehemann der Tochter (oder bei Homosexualität auch des Sohnes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71737ee9-fa41-431c-929c-914cc51a8e99",
                                                "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                                "text": "„Franz Hundinger bewilligte seinem Schwiegersohn nach der Hochzeit ein eigenes Pferd, das sich Peter mit Bedacht aussuchte.“"
                                            },
                                            {
                                                "example_id": "e7466719-78e6-4042-820a-32ce0a0961a7",
                                                "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                                "text": "„Der lange Mörschel hat den Kopf ganz auf die Seite gelegt und besieht seinen künftigen Schwiegersohn mit eingekniffenen Augen.“"
                                            },
                                            {
                                                "example_id": "f7655238-d32d-4452-910a-4aaa5dd6fda5",
                                                "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                                "text": "„Zudem ist er der Schwiegersohn eines respektierten Großfürsten.“"
                                            },
                                            {
                                                "example_id": "b102b07d-3789-4da8-b5ed-cc21e6a8f6cc",
                                                "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                                "text": "„Lea stand mit verstörtem Gesicht vor dem Baum, an dem schon etliche Lichter brannten, und Recha schüttelte dem flüchtigen Schwiegersohn die geballte Faust nach.“"
                                            },
                                            {
                                                "example_id": "1b0eab7b-7942-499f-a218-24c7877639d3",
                                                "sense_id": "685ce39f-d81d-39b3-9c67-c4cbca4996d0",
                                                "text": "„Sein Vater, Prinz Alexander von Battenberg, hatte diesen Posten zu Beginn des Ersten Weltkriegs inne und musste ihn wegen seiner deutschen Abstammung aufgeben, obwohl er ein Schwiegersohn Königin Victorias war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37a0dad2-7943-4097-9b68-a80df0c4ca4d",
                        "source_entry_id": "402b31a4-f53d-30fd-9707-f83e1def75ae",
                        "source_sense_id": "2aa56728-ddb5-3e98-8f9c-dd42ac9d65c6",
                        "source_sense_description": "de man van een dochter of zoon",
                        "target_lang_word": "son-in-law",
