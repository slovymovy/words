                    {
                        "translation_id": "88cfd9d2-2925-4305-a07c-05baa6ac9729",
                        "source_entry_id": "b8848bed-ace4-3e61-bdb3-662ef9e74ab7",
                        "source_sense_id": "8b905a8e-20eb-3680-9c78-791c4ca8947e",
