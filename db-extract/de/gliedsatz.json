                "senses": [
                    {
                        "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                        "entry_id": "2aecd980-ef79-3eab-9441-8a7edea9608d",
                        "glosses": [
                            "Teilsatz eines Satzes, der ein Satzglied ersetzt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "74e5a59d-0ec5-4c3e-88b1-92b2cb2357b2",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "In dem Satz: \"Es ist beruhigend, dass du da bist\" ist \"Es ist beruhigend\" der Hauptsatz und \"dass du da bist\" der Gliedsatz."
                            },
                            {
                                "example_id": "2b54916f-3532-4569-91c7-e8734c65e271",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "Die Begriffe Gliedsatz und Nebensatz bezeichnen nicht ganz dasselbe: Die weiterführenden Nebensätze sind keine Gliedsätze, da sie kein Satzglied vertreten."
                            },
                            {
                                "example_id": "8763b5c6-3c58-4836-abdc-3c3a03dc2830",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "„Außer den verbalen Satzgliedern und damit der Verbalgruppe können alle anderen Satzglieder, also alle nominalen Satzglieder, durch Gliedsätze wiedergegeben werden.“"
                            },
                            {
                                "example_id": "d9d58146-af9f-48cd-8e55-f3091dd3353b",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "„Wenn ein Nebensatz einem Satzglied entspricht, liegt ein Gliedsatz vor; wenn er einem Gliedteil entspricht, handelt es sich um einen Gliedteilsatz.“"
                            },
                            {
                                "example_id": "7f59e472-0b7a-4283-9c44-b278ecfa8918",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "„Die bekannteste alternative Bezeichnung für den Nebensatz ist im deutschsprachigen Raum der Terminus Gliedsatz.“"
                            },
                            {
                                "example_id": "8b7710b5-be92-4602-8767-662253a0d90d",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "„Der Indikativ eines beliebigen Gliedsatzes geht ebenfalls in den Konjunktiv über (Angleichung).“"
                            },
                            {
                                "example_id": "f9acd34f-01d3-40d7-b94e-d7a42984af2c",
                                "sense_id": "5a669656-c0cc-380a-99b0-aab800cae67a",
                                "text": "„Gliedsätze werden durch Komma vom Hauptsatz abgetrennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
