    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34f60848-1cbb-35ef-a4bb-3e3f0a9966e8",
                    "sense_definition": "połączyć ze sobą różne składniki lub substancje za pomocą mieszania",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laczenie_substancji",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharka starannie <w>zmieszała</w> mąkę, cukier oraz mleko w dużej misce.",
                            "target_lang_translations": {
                                "ru": "Повариха тщательно <w>смешала</w> муку, сахар и молоко в большой миске."
                            }
                        },
                        {
                            "text": "Musisz dokładnie <w>zmieszać</w> składniki, aby uzyskać gładkie ciasto bez grudek.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно тщательно <w>перемешать</w> ингредиенты, чтобы получить однородное тесто без комочков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dokładnie zmieszać składniki",
                        "zmieszać ze sobą"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединить друг с другом различные ингредиенты или вещества путём перемешивания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешать",
                                "target_lang_sense_clarification": "соединить ингредиенты или вещества"
                            },
                            {
                                "target_lang_word": "перемешать",
                                "target_lang_sense_clarification": "тщательно смешать между собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6bdb721-e69e-335c-9fb9-c12c55e6d7d1",
                    "sense_definition": "wprawić kogoś w zakłopotanie lub niepewność, sprawić, że poczuje się nieswojo",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaklopotanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niespodziewane pytanie dziennikarza zupełnie <w>zmieszało</w> młodego polityka podczas konferencji.",
                            "target_lang_translations": {
                                "ru": "Неожиданный вопрос журналиста совершенно <w>смутил</w> молодого политика во время конференции."
                            }
                        },
                        {
                            "text": "Jej bezpośrednia uwaga wyraźnie go <w>zmieszała</w> i odebrała mu pewność siebie.",
                            "target_lang_translations": {
                                "ru": "Её прямое замечание явно <w>обескуражило</w> его и лишило уверенности в себе."
                            }
                        }
                    ],
                    "synonyms": [
                        "speszyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "привести кого-либо в замешательство, неловкость или неуверенность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутить",
                                "target_lang_sense_clarification": "вызвать замешательство или неловкость"
                            },
                            {
                                "target_lang_word": "обескуражить",
                                "target_lang_sense_clarification": "лишить уверенности, озадачить"
                            },
                            {
                                "target_lang_word": "замешать",
                                "target_lang_sense_clarification": "привести в замешательство (устар./книжн.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bd01e1f-2ca3-3723-8203-2089ef8171e7",
                    "sense_definition": "o substancjach: połączyć się ze sobą w jedną całość (w formie zwrotnej)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "laczenie_substancji",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oliwa nie <w>zmieszała</w> się z wodą i unosiła się na jej powierzchni.",
                            "target_lang_translations": {
                                "ru": "Оливковое масло не <w>смешалось</w> с водой и плавало на её поверхности."
                            }
                        },
                        {
                            "text": "Kiedy barwy na obrazie <w>zmieszały</w> się, powstał zupełnie nowy odcień.",
                            "target_lang_translations": {
                                "ru": "Когда краски на картине <w>смешались</w>, получился совершенно новый оттенок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmieszać się z wodą"
                    ],
                    "target_lang_definitions": {
                        "ru": "о веществах или красках: соединиться друг с другом в единое целое (возвратная форма)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешаться",
                                "target_lang_sense_clarification": "соединиться в одно целое о веществах или цветах"
                            },
                            {
                                "target_lang_word": "перемешаться",
                                "target_lang_sense_clarification": "соединиться между собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22141018-c7bf-3604-8b4b-5c7642849a4c",
                    "sense_definition": "poczuć zakłopotanie, onieśmielenie lub wstyd (w formie zwrotnej)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaklopotanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopiec bardzo się <w>zmieszał</w>, gdy nauczyciel zwrócił mu uwagę przy całej klasie.",
                            "target_lang_translations": {
                                "ru": "Мальчик очень <w>смутился</w>, когда учитель сделал ему замечание перед всем классом."
                            }
                        },
                        {
                            "text": "Usłyszawszy nieoczekiwany komplement, od razu się <w>zmieszała</w> i oblała rumieńcem.",
                            "target_lang_translations": {
                                "ru": "Услышав неожиданный комплимент, она тут же <w>замялась</w> и залилась румянцем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmieszać się i zaczerwienić"
                    ],
                    "target_lang_definitions": {
                        "ru": "почувствовать неловкость, смущение или стыд (возвратная форма)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутиться",
                                "target_lang_sense_clarification": "почувствовать неловкость или застенчивость"
                            },
                            {
                                "target_lang_word": "замяться",
                                "target_lang_sense_clarification": "прийти в нерешительность от смущения"
                            },
                            {
                                "target_lang_word": "растеряться",
                                "target_lang_sense_clarification": "потерять уверенность и самообладание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "727192a3-e7f7-3e53-8924-e8e83a28aa68",
                    "sense_definition": "dołączyć do grupy ludzi, stając się jej częścią i nie wyróżniając się z niej",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej szybko <w>zmieszał</w> się z gęstym tłumem na stacji kolejowej i zniknął.",
                            "target_lang_translations": {
                                "ru": "Вор быстро <w>смешался</w> с густой толпой на вокзале и исчез."
                            }
                        },
                        {
                            "text": "Turysta <w>zmieszał</w> się z grupą zwiedzających, aby wejść do muzeum bez kolejki.",
                            "target_lang_translations": {
                                "ru": "Турист <w>затерялся</w> среди экскурсионной группы, чтобы пройти в музей без очереди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zmieszać się z tłumem"
                    ],
                    "target_lang_definitions": {
                        "ru": "влиться в группу людей, став её частью и не выделяясь из неё"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешаться",
                                "target_lang_sense_clarification": "влиться в толпу или группу людей"
                            },
                            {
                                "target_lang_word": "затеряться",
                                "target_lang_sense_clarification": "стать незаметным среди людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9168bec7-272f-325a-82d2-39c2f1360e97",
                    "sense_definition": "dokonana forma od czasownika <w>mieszać</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten słownik gramatyczny precyzuje, że czasownik ten <w>zmieszał</w> znaczenia aspektowe.",
                            "target_lang_translations": {
                                "ru": "Этот грамматический словарь уточняет, что данный глагол <w>смешал</w> видовые значения."
                            }
                        },
                        {
                            "text": "Kiedy z powodzeniem <w>zmieszasz</w> obie substancje, zakończysz ten etap procedury chemicznej.",
                            "target_lang_translations": {
                                "ru": "Когда ты успешно <w>смешаешь</w> оба вещества, ты завершишь этот этап химической процедуры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид от глагола mieszać"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешать",
                                "target_lang_sense_clarification": "глагол совершенного вида"
                            },
                            {
                                "target_lang_word": "перепутать",
                                "target_lang_sense_clarification": "спутать одно с другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00408515-8238-32f0-a0a7-b78222040402",
                    "sense_definition": "dokonana forma od czasownika zwrotnego <w>mieszać</w> się",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas eksperymentu ciecze <w>zmieszały</w> się bez konieczności podgrzewania całego roztworu.",
                            "target_lang_translations": {
                                "ru": "Во время эксперимента жидкости <w>смешались</w> без необходимости нагревать весь раствор."
                            }
                        },
                        {
                            "text": "Świadek zeznał, że podejrzany natychmiast <w>zmieszał</w> się z przechodniami na ulicy.",
                            "target_lang_translations": {
                                "ru": "Свидетель показал, что подозреваемый немедленно <w>смешался</w> с прохожими на улице."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид от возвратного глагола mieszać się"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешаться",
                                "target_lang_sense_clarification": "возвратный глагол совершенного вида"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}