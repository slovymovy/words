                        ],
                        "form": "die Druckknöpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5daed087-359a-3ea8-89e4-e83a42ff1328",
                        "entry_id": "4fc38275-8bce-3fa2-8611-b34fd65bd7fe",
                        "glosses": [
                            "Verschluss für Kleidungsstücke oder Taschen, der aus zwei Metallteilen besteht, die durch Drücken zusammengefügt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eff8f27-d21b-4177-9159-caf142da7ca0",
                                "sense_id": "5daed087-359a-3ea8-89e4-e83a42ff1328",
                                "text": "„Druckknöpfe sind praktisch und stabil, auch das Anbringen geht ohne Probleme.“"
                            },
                            {
                                "example_id": "25da4a83-33a3-49e9-8269-d8d4d5e5765d",
                                "sense_id": "5daed087-359a-3ea8-89e4-e83a42ff1328",
                                "text": "„15 Millionen Druckknöpfe verkauft die Stolberger Firma Prym an Modelabels in aller Welt - jeden Tag. Erfunden hat's ein Kupfermeister vor über 100 Jahren.“"
                            },
                            {
                                "example_id": "b515d8d2-8c0b-4a28-87c1-66b610eed83d",
                                "sense_id": "5daed087-359a-3ea8-89e4-e83a42ff1328",
                                "text": "„Patrick Strosche öffnet den Druckknopf des schwarzen Etuis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e81c8cc5-be4c-376f-b4bf-5fe31a66c0c3",
                        "entry_id": "4fc38275-8bce-3fa2-8611-b34fd65bd7fe",
                        "glosses": [
                            "Element zur Bedienung eines technischen Gerätes oder Anlage, das durch Drücken betätigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0279e89-c2ac-466f-9f0a-7bcc6f0fb5a2",
                                "sense_id": "e81c8cc5-be4c-376f-b4bf-5fe31a66c0c3",
                                "text": "„Sobald das Gerät am großen Druckknopf unten vor der Lenkstange angeschaltet ist, die blauen Balken für die Batterieanzeige leuchten und der Hebel betätigt wird, passiert - nichts.“"
                            },
                            {
                                "example_id": "c22e67dc-4bf0-45b6-9e0d-6cefc9bd3592",
                                "sense_id": "e81c8cc5-be4c-376f-b4bf-5fe31a66c0c3",
                                "text": "„Mit einem Druckknopf wird der sogenannte S-Mode für Antrieb und Schaltung aktiviert, der zum Beispiel beim Wechsel in die niedrigere Schaltstufe für Zwischengas sorgt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
