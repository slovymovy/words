                                "target_senses": [
                                    {
                                        "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                        "entry_id": "5631d05d-6b1c-345a-ba16-bebccfae1a28",
                                        "glosses": [
                                            "A female donkey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebce580-a35e-4e8d-8584-be306fa77a3f",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "c. 1849, G. Herbert Rodwell, Old London Bridge, London: Henry Lea, Chapter 15, p. 158,\n[…] this little donkey could not be trusted in the road, for it was always getting under the wheels, because it would not let its mother, a fine fat old jenny ass in the shafts, alone."
                                            },
                                            {
                                                "example_id": "4d1cd852-a87e-4031-ba7f-395b3c8b3030",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "But a man who holds so tightly to what he calls his rights over what he calls his debts will hold tightly also to what he calls his rights over her whom he calls his wife. No sir smile neighbour shall covet his ox or his wife or his manservant or his maidservant or his jackass. / —Or his jennyass, Buck Mulligan antiphoned."
                                            },
                                            {
                                                "example_id": "c3fdfb28-8671-4c05-865e-6c523a5d733f",
                                                "sense_id": "a239759f-111b-3e06-8a81-b8c0f6b90976",
                                                "text": "[…] old rope is for tethering your jennyass […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b18473-c457-4204-a064-d075fd8734fc",
                        "source_entry_id": "6183e988-af9a-3a4f-b6e6-1a922d885ed0",
                        "source_sense_id": "20e6652c-eaf7-3962-b511-8fb4e22af81a",
                        "source_sense_description": "vrouwelijke ezel",
                        "target_lang_word": "ânesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ânesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                        "entry_id": "0a10e923-67fb-3013-a5ae-0dea40c49ce4",
                                        "glosses": [
                                            "Femelle de l’âne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d614c5c-3afe-4f5d-85b3-cebfe36b05cc",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "En longeant le faîte des murailles épaisses qui entourent la ville, de la terrasse où croît la jusquiame blanche, je vois des ânesses paisibles couchées sur la paille chaude, les troupeaux serrés que ramènent les pasteurs et les fours flambants où les ménagères apprêtent le repas du soir."
                                            },
                                            {
                                                "example_id": "b04ea8d4-e5e0-4585-ac8f-5943b2dc5d41",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "Sitôt levé, Balaam sella son ânesse et partit avec les princes de Moab."
                                            },
                                            {
                                                "example_id": "cef8d3c0-7020-4132-9dc9-680eed494d07",
                                                "sense_id": "30442600-cf2d-3f4e-8a1c-f500bab35339",
                                                "text": "Lait d’ânesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
