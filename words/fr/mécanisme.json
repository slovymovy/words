            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c37e71ff-a5b4-3982-a351-8f6b6231aaeb",
                    "sense_definition": "Ensemble de pièces agencées qui assurent le fonctionnement d'un appareil ou d'une machine.",
