                                    {
                                        "sense_id": "d8323c14-bcd2-3bbe-b75b-3ae9c450a5b5",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "The act of surveying; a general view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b29df01-de45-4954-8c2b-3225831ffde2",
                                                "sense_id": "d8323c14-bcd2-3bbe-b75b-3ae9c450a5b5",
                                                "text": "Under his proud survey the city lies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ce41324-0506-3db2-a369-bac409f53dba",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "A particular view; an examination, especially an official examination, of a particular group of items, in order to ascertain the condition, quantity, or quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52adf26a-8816-4358-a541-badf29b0231c",
                                                "sense_id": "0ce41324-0506-3db2-a369-bac409f53dba",
                                                "text": "A survey of the stores of a ship; a survey of roads and bridges; a survey of buildings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16ace76-0d39-3522-9514-5ff7c2c51aff",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "The operation of finding the contour, dimensions, position, or other particulars of any part of the Earth's surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5ba971b-a8fb-33b0-b8f1-94ad2fcdbd8b",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "A measured plan and description of any portion of country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd0cf6a0-eae9-4adb-9205-a9050302fc0e",
                                                "sense_id": "c5ba971b-a8fb-33b0-b8f1-94ad2fcdbd8b",
                                                "text": "The owners of the adjoining plots had conflicting surveys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c265468a-796e-3643-afbb-7a9984dde3f5",
                                        "entry_id": "f56e2672-4cbd-3d42-adaa-98bbc9c23339",
                                        "glosses": [
                                            "An examination of the opinions of a group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
