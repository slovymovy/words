                                                "example_id": "072b6feb-efed-470f-8dc6-497f39d1f598",
                                                "sense_id": "32c61df0-e4ed-3f7b-807d-2484da011ad4",
                                                "text": "De Gelderse hertog Reinald II verwierf de heerlijkheid Bredevoort in 1326."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43713b83-dd94-3f22-a868-8675dba8c51c",
                                        "entry_id": "8e6fbce4-4485-3cca-87c6-555b79f1ac79",
                                        "glosses": [
                                            "adellijke legereenheid"
