                                    {
                                        "sense_id": "073fe2e3-2745-379f-a306-e2d4a78b9a08",
                                        "entry_id": "604a0b3b-6bfa-3b44-8da1-067c5a8ecad6",
                                        "glosses": [
                                            "In a state of marriage; having a wife or a husband."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a56bbe-b8d4-4e37-87c2-7e9d85fdead4",
                                                "sense_id": "073fe2e3-2745-379f-a306-e2d4a78b9a08",
                                                "text": "Are you married or single?"
                                            },
                                            {
                                                "example_id": "07291955-3c5f-4c4a-ac83-16f5b1654830",
                                                "sense_id": "073fe2e3-2745-379f-a306-e2d4a78b9a08",
                                                "text": "My mom got married to her childhood sweetheart."
                                            },
                                            {
                                                "example_id": "f620bd0c-2216-44d8-86df-b1f57de0d565",
                                                "sense_id": "073fe2e3-2745-379f-a306-e2d4a78b9a08",
                                                "text": "Middle-aged, married fathers make up the bulk of those who have gotten vasectomies, with less than two percent of unmarried men relying on vasectomy for contraception, according to one analysis of data between 2002 and 2015 by the Department of Health and Human Services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d012f930-56ea-39b4-9bba-d0c41e674b0e",
                                        "entry_id": "604a0b3b-6bfa-3b44-8da1-067c5a8ecad6",
                                        "glosses": [
                                            "Showing commitment or devotion normally reserved for a spouse; strongly committed or attached to something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156248ea-4af5-4384-acad-4d2f216b95f2",
                                                "sense_id": "d012f930-56ea-39b4-9bba-d0c41e674b0e",
                                                "text": "married to one's work"
                                            },
                                            {
                                                "example_id": "d69c1248-e758-40b6-896a-3f118c46b48e",
                                                "sense_id": "d012f930-56ea-39b4-9bba-d0c41e674b0e",
                                                "text": "married to an idea"
                                            },
                                            {
                                                "example_id": "215c901d-b784-479b-a93f-bef8bfc081f8",
                                                "sense_id": "d012f930-56ea-39b4-9bba-d0c41e674b0e",
                                                "text": "Yes, I drafted the business proposal, but I'm not married to it, so it's okay if the board doesn't approve it."
                                            }
                                        ]
                                    }
                                ]
                            },
