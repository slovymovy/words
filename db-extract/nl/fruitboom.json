                "translations": [
                    {
                        "translation_id": "2a698856-3cb3-4b3b-b0ea-4328f18a3d2f",
                        "source_entry_id": "2c13a7de-bedb-3ee4-8dc4-6f595265c3e9",
                        "source_sense_id": "fd22eed0-ca7d-311e-87f6-b6b828c3fac6",
                        "target_lang_word": "Obstbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obstbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                        "entry_id": "6a54b4a1-cd0b-358c-ac31-0752e2445dd5",
                                        "glosses": [
                                            "Baum an dem Obst wächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7578f3e7-0055-4798-b20a-b17cf9e2dc75",
                                                "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                                "text": "Ich liebe die Streuobstwiesen mit ihren unzähligen Obstbäumen."
                                            },
                                            {
                                                "example_id": "5ef503df-b356-49e7-85e1-4848512e1f72",
                                                "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                                "text": "„Hatte er weiter nichts zu tun, so bastelte er in dem Garten herum, beschnitt die Rosen und band die Obstbäume auf.“"
                                            },
                                            {
                                                "example_id": "54f83f4f-ebcb-4c55-97ee-3510386e1d6a",
                                                "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                                "text": "„Sie sind von grünen Oasen umgeben, die mit Weinhängen und Obstbäumen bewachsen sind.“"
                                            },
                                            {
                                                "example_id": "644fb8be-895b-46da-a749-54d7272ea09d",
                                                "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                                "text": "„Da hatte Dorothea Claus sich nämlich im Dorf einen Motorrasenmäher ausgeliehen und damit die Wiese unter den Obstbäumen gemäht.“"
                                            },
                                            {
                                                "example_id": "0440d8c2-e4ab-4390-9cce-d4e02016ca3d",
                                                "sense_id": "187fcf35-6098-3dfe-8227-a1a76729c999",
                                                "text": "„Mollenhauer besitzt ein zweitausend Quadratmeter großes Grundstück am Ortsrand, das mit Obstbäumen bestanden und Bauerwartungsland ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a7bd227-8abb-470d-b056-dfbb4311d509",
                        "source_entry_id": "2c13a7de-bedb-3ee4-8dc4-6f595265c3e9",
                        "source_sense_id": "fd22eed0-ca7d-311e-87f6-b6b828c3fac6",
                        "target_lang_word": "fruit tree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruit tree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca766c8a-8264-36c8-87f7-1bcea175b203",
                                        "entry_id": "02f80767-483f-30a5-96d7-6e4d84ed0d83",
                                        "glosses": [
                                            "A tree that bears a crop of edible fruit on a regular basis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d131e3fd-09c6-4dfb-a630-965d474aca3a",
                                                "sense_id": "ca766c8a-8264-36c8-87f7-1bcea175b203",
                                                "text": "The countryside of eastern Bohemia is cultivated intensely. Fruit trees grow thickly alongside the roads instead of the hawthorn hedges common in England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97de1fb4-0a85-449d-89d6-97323f326fc4",
                        "source_entry_id": "2c13a7de-bedb-3ee4-8dc4-6f595265c3e9",
                        "source_sense_id": "fd22eed0-ca7d-311e-87f6-b6b828c3fac6",
                        "target_lang_word": "fruiter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98ca42db-fc14-3698-87c7-ab78aebd9c64",
                                        "entry_id": "d017f9e0-4c33-3b64-9193-42516d605660",
                                        "glosses": [
                                            "Any organism that fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606ebafe-f594-433c-ba9d-0bcba4fb834f",
                                                "sense_id": "98ca42db-fc14-3698-87c7-ab78aebd9c64",
                                                "text": "Hypholoma mushrooms are very prolific fruiters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda2ff6e-8adf-3579-9bad-bcc0b49f78d4",
                                        "entry_id": "d017f9e0-4c33-3b64-9193-42516d605660",
                                        "glosses": [
                                            "A ship for transporting fruit."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "708ae956-af77-3b01-b978-977938fecb3c",
                                        "entry_id": "d017f9e0-4c33-3b64-9193-42516d605660",
                                        "glosses": [
                                            "A homosexual man."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6892f8f9-7e0e-4e3e-8342-71cbe18b5d96",
                                                "sense_id": "708ae956-af77-3b01-b978-977938fecb3c",
                                                "text": "Because of increasing awareness during the 1930s, the police department added plainclothes officers to its parks and squares unit to keep the \"fruiters\" in check. They began surveillance of the known places where gay men might go to meet each other […]"
                                            },
                                            {
                                                "example_id": "2a72bb3a-c15d-460e-8e72-46f38a12343c",
                                                "sense_id": "708ae956-af77-3b01-b978-977938fecb3c",
                                                "text": "They already had some gay friends, though I can't say I liked them very much. My Dad just took it in stride. It'd didn't make any difference between us. My Mom, after about fifteen minutes of silence, said, 'Oh, good, a fruiter—a funny boy. My sister has one."
                                            },
                                            {
                                                "example_id": "f40a7016-b5a1-45e9-ab43-ef209706d2ff",
                                                "sense_id": "708ae956-af77-3b01-b978-977938fecb3c",
                                                "text": "'Maybe he's a fruiter,' remarked Tracey in her infuriating accent.\n'Now that would be a turn-up for the books, wouldn't it Mike? I have to say I've never warmed to the homosexual community. I'm not what you'd call a bender-befriender. Still, live and let live, I say.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cfe3ec6-6156-487e-8414-19a22d4fbdf7",
                        "source_entry_id": "2c13a7de-bedb-3ee4-8dc4-6f595265c3e9",
                        "source_sense_id": "fd22eed0-ca7d-311e-87f6-b6b828c3fac6",
                        "target_lang_word": "arbre fruitier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arbre fruitier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                        "entry_id": "575db503-1d1f-3080-b145-49a41d16ed93",
                                        "glosses": [
                                            "Arbre cultivé pour ses fruits comestibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94708318-e645-4b79-801d-ac65176b2cfa",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "La plupart des montagnes de Walachie sont garnies de bois composés de poiriers, de cerisiers, d’abricotiers et autres arbres fruitiers qui donnent aux forêts l’aspect d’immenses vergers."
                                            },
                                            {
                                                "example_id": "6a433f3f-a59b-45c0-8b87-71965a36f865",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "Mais revenons à notre pays pour parler des intéressantes observations faites par un de nos pomiculteurs les plus habiles, M. Camuzet, chef de carré au Muséum dans la section des arbres fruitiers."
                                            },
                                            {
                                                "example_id": "49872415-d7fc-45c0-ab7d-19d3a7c027d3",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "Ce sont les larves des pucerons qui, réunies en familles innombrables, recouvrent quelquefois des branches entières de nos arbres fruitiers, la tige de nos fleurs, de nos légumes."
                                            },
                                            {
                                                "example_id": "272d80be-99d9-40da-a69f-87471323dffb",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "Nous nous élevons rapidement et ne tardons pas à quitter la zone des cultures tropicales et subtropicales des terres basses. […] ; aux dattiers, aux dragonniers, aux manguiers, aux anoniers, aux avocatiers, aux goyaviers succèdent les arbres fruitiers des régions méditerranéennes, puis de l'Europe centrale. Nous montons toujours."
                                            },
                                            {
                                                "example_id": "fd43bda5-d593-4db2-b93b-c68d4cf24b21",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "Autrefois appelées « le jardin de Melboune », on y cultivait de nombreux arbres fruitiers dont on exportait les conserves sur le marché de Victoria."
                                            },
                                            {
                                                "example_id": "192ff39c-9066-4b9c-81e7-f4f7b98b9c6b",
                                                "sense_id": "1ff325d0-f015-3c2d-8947-d20962fa454d",
                                                "text": "Il a modifié en partie les paysages du domaine en plantant beaucoup d’arbres dans les creux en particulier des peupliers blancs appelés piboules, des micocouliers que Florian traite d’alisiers, et probablement quelques ormeaux et arbres fruitiers autour de château."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
