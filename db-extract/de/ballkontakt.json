                "senses": [
                    {
                        "sense_id": "540591ef-99f6-3429-b58a-8ba9d720b8cd",
                        "entry_id": "03f36942-323b-3650-b24f-4295fa04a91f",
                        "glosses": [
                            "Berührung des Spielballs"
