                "senses": [
                    {
                        "sense_id": "f52e4636-f4e3-351e-a9a7-c549dfd3deab",
                        "entry_id": "7dc858a7-b658-3564-8368-6f1ad5df5424",
                        "glosses": [
                            "het verkopen (voor geld aan een ander geven)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "366422a9-8c83-43e8-b012-a9fa1c3563b3",
                                "sense_id": "f52e4636-f4e3-351e-a9a7-c549dfd3deab",
                                "text": "Ze haalt alle kleren uit haar kast en stopt ze in een linnen zak, samen met de overgebleven guldens van de verkoop van de kaart."
                            },
                            {
                                "example_id": "9e305b01-0fa9-401c-937c-7338fc5b84cc",
                                "sense_id": "f52e4636-f4e3-351e-a9a7-c549dfd3deab",
                                "text": "Voor Nella is het alsof ze vliegt, alsof deze merrie geen vlugge verkoop is van een vermoeide stalknecht die de hele nacht bier heeft geserveerd aan treurige oude mannen, maar Pegasus zelf, geboren uit het gespleten lichaam van Medusa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81f44cef-0970-44fa-acb6-1e192bae2053",
                        "source_entry_id": "7dc858a7-b658-3564-8368-6f1ad5df5424",
                        "source_sense_id": "f52e4636-f4e3-351e-a9a7-c549dfd3deab",
                        "source_sense_description": "het verkopen (voor geld aan een ander geven)",
                        "target_lang_word": "Verkauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06b7508b-bda7-37a1-87a1-031492864865",
                                        "entry_id": "e38a69f5-9429-3329-985b-929d224bba16",
                                        "glosses": [
                                            "der Akt des Verkaufens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd5a0d1-96cc-4f7b-8b6c-42a7fa1ad0fe",
                                                "sense_id": "06b7508b-bda7-37a1-87a1-031492864865",
                                                "text": "Der Verkauf seines Hauses brachte ihm etwas Geld ein."
                                            },
                                            {
                                                "example_id": "40a61c76-f0c3-4e3f-97a3-35de60fb0897",
                                                "sense_id": "06b7508b-bda7-37a1-87a1-031492864865",
                                                "text": "Einige Hersteller bieten auch für Privatkunden Verkauf ab Werk an."
                                            },
                                            {
                                                "example_id": "4d2e964e-2a66-4098-894e-a5db516b9554",
                                                "sense_id": "06b7508b-bda7-37a1-87a1-031492864865",
                                                "text": "Die Meisten verlangen im Verkauf das Doppelte."
                                            },
                                            {
                                                "example_id": "2c3423ff-0742-4beb-8289-cb3b6ef8dee4",
                                                "sense_id": "06b7508b-bda7-37a1-87a1-031492864865",
                                                "text": "„Der große Wuh verduftete, als ob er einen Rundgang zum Verkaufe machte, und kehrte dann zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a7a1435-927f-39b7-bde0-f866db95dcc2",
                                        "entry_id": "e38a69f5-9429-3329-985b-929d224bba16",
                                        "glosses": [
                                            "Einrichtung oder Abteilung zum Verkaufen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d581bf-7204-409f-9a21-7861af468ae5",
                                                "sense_id": "4a7a1435-927f-39b7-bde0-f866db95dcc2",
                                                "text": "Sie arbeitet bei uns im Verkauf."
                                            },
                                            {
                                                "example_id": "9e2013e7-e5d2-4137-99a9-20e08fac498a",
                                                "sense_id": "4a7a1435-927f-39b7-bde0-f866db95dcc2",
                                                "text": "Sie können ihn jetzt nicht sprechen, er ist vorne im Verkauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
