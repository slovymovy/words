                "translations": [
                    {
                        "translation_id": "0aa77408-d150-40bd-abac-88c74f92b347",
                        "source_entry_id": "0f111a96-ef94-3fb6-ad3b-0a214d447090",
                        "source_sense_id": "0884f181-44cf-36eb-b5fc-d4b150d2e413",
                        "source_sense_description": "oberdeutsch, von Hunden: weibliches Tier",
                        "target_lang_word": "chienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c91b312a-6d83-3c2a-8164-5e7ba6f4368d",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Animal femelle de l’espèce Canis lupus familiaris."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4e6566a-d655-4535-b789-fe9500af01b6",
                                                "sense_id": "c91b312a-6d83-3c2a-8164-5e7ba6f4368d",
                                                "text": "La reine mère se leva, prit la petite chienne par son collier et la retint, […]."
                                            },
                                            {
                                                "example_id": "2a02bc54-97fa-4498-a07e-4f52fdb9e4aa",
                                                "sense_id": "c91b312a-6d83-3c2a-8164-5e7ba6f4368d",
                                                "text": "Or le bar était vide. Léon, à son comptoir dormassait, en chandail, tandis que sa chienne, près de lui, sur une chaise, veillait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ee2371-5297-34c2-ade6-15ba6dfbb96a",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "En parlant des choses : très mauvais, exécrable."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c57bd5b-582e-4fb0-8d64-bbf0a70190db",
                                                "sense_id": "39ee2371-5297-34c2-ade6-15ba6dfbb96a",
                                                "text": "Il m’a dit son nom; mais sa chienne de voix était si faible que je ne l’ai pas entendu."
                                            },
                                            {
                                                "example_id": "cd8fa4dd-69b8-4a38-b2b3-7402b7489996",
                                                "sense_id": "39ee2371-5297-34c2-ade6-15ba6dfbb96a",
                                                "text": "Elle avait eu deux beaux enfants de ce matelot, la Clémence, puis la chienne de guerre, la grande, était arrivée, expédiant le Paul aux Dardanelles, dans les pays là-bas comme on disait, aux cinq cents diables quoi !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e9c663-1d01-3eb6-8b3a-fde50ea9d530",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Femme au fort appétit sexuel ; femme délurée et lubrique."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b7fb00-8341-4fea-b7d4-7099ff67d400",
                                                "sense_id": "e7e9c663-1d01-3eb6-8b3a-fde50ea9d530",
                                                "text": "Elle fut une chienne dont les chiens sentaient la cuisse, se pressant l’un l’autre, avec des choses dressées et des gueules folles de chiens chauds."
                                            },
                                            {
                                                "example_id": "541b067f-87d8-4007-8fe2-c95f85b6256c",
                                                "sense_id": "e7e9c663-1d01-3eb6-8b3a-fde50ea9d530",
                                                "text": "L’inspecteur vous aura dit que j’étais une fille de rien, est-ce vrai ? Que je courais les hommes comme une chienne ? Oui ? Que je vous empaumais sans doute ? Consciente de l’impasse où je vous acculais ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f6ff12e-2ae9-3655-9937-abbb563a6ca7",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Cheveux formant une sorte de frange sur le front."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Vosges"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148582ef-dae3-43fa-9caf-44d39c6350f3",
                                                "sense_id": "5f6ff12e-2ae9-3655-9937-abbb563a6ca7",
                                                "text": "Se rassoyait, supérieure, en faisant bouffer sa chienne blonde sur le front d’un doigt nonchalant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1332ec-6500-30da-8b29-07e38811967e",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Masse de glace qui, sur un cours d’eau, bloque les billots de bois que l’on veut faire transporter par le courant."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Drave"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d6c08b-d552-4d20-ae3c-96e8f3d70efd",
                                                "sense_id": "5f1332ec-6500-30da-8b29-07e38811967e",
                                                "text": "Les draveurs appellent « chienne » la glace qui prend les billots en serre et les immobilisent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2181b38e-c144-39f9-97fd-6645190fc41f",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Vêtement de travail souvent ignifuge."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58a23ab8-9f2c-3e49-9de8-cda13a13df2b",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Grosse bouteille de bière, normalement de 40 oz (1,18 litres)."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "555602e2-5d07-3ed3-b32f-5d308706b20f",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Peur."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9757cdc-2875-408b-a7a0-9314b96901d1",
                                                "sense_id": "555602e2-5d07-3ed3-b32f-5d308706b20f",
                                                "text": "Tu sais, quand tu découvres une petite tache brune sur ton coude et que la chienne te pogne…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d5a0cd-8bfd-35e8-97a6-a432b29fbb06",
                                        "entry_id": "25435931-3ed6-3426-be8f-7e4490153174",
                                        "glosses": [
                                            "Autre nom de la tiretoire, car cet outil mord le bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
