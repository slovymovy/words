        "pl-extract.jsonl": [
            {
                "entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                "word": "nicość",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ef144762-ba8e-325e-847c-1d03617d5a49",
                        "entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                        "glosses": [
                            "pustka, brak, nieistnienie czegoś"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39e4ed97-6658-42bc-9682-15b19198bfa8",
                        "source_entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                        "source_sense_id": "ef144762-ba8e-325e-847c-1d03617d5a49",
                        "target_lang_word": "nothingness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nothingness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cccb71e-2186-3df4-82f7-d53c9e84075d",
                                        "entry_id": "5b9e1f15-7ca0-3c96-b7ba-cbc32a220045",
                                        "glosses": [
                                            "The state of nonexistence; the condition of being nothing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eb5c233-c50c-4042-b0c9-2a3dd6cb5efc",
                                                "sense_id": "4cccb71e-2186-3df4-82f7-d53c9e84075d",
                                                "text": "In 1928 [Martin] Heidegger succeeded [Edmund] Husserl to take a chair at Freiburg and in his inaugural lecture made a pronouncement that earned him a reputation as an archetypal metaphysician with his claim that our awareness of people as a whole depends on our experience of dread in the face of nothingness."
                                            },
                                            {
                                                "example_id": "b0bb471d-9f58-430e-b4dc-c6e0c19258ec",
                                                "sense_id": "4cccb71e-2186-3df4-82f7-d53c9e84075d",
                                                "text": "A thing of beauty is a joy for ever: / Its loveliness increases; it will never / Pass into nothingness; but still will keep / A bower quiet for us, and a sleep / Full of sweet dreams, and health, and quiet breathing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a447b0-41c3-390f-8f73-00deb8e00bd2",
                                        "entry_id": "5b9e1f15-7ca0-3c96-b7ba-cbc32a220045",
                                        "glosses": [
                                            "A void; an emptiness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb378461-7f06-317f-80b1-3ebe28234054",
                                        "entry_id": "5b9e1f15-7ca0-3c96-b7ba-cbc32a220045",
                                        "glosses": [
                                            "The quality of inconsequentiality; the lack of significance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82f7c3cf-2fa9-45dd-916e-34fa84d3b09d",
                        "source_entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                        "source_sense_id": "ef144762-ba8e-325e-847c-1d03617d5a49",
                        "target_lang_word": "néant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1284f4da-89e3-3558-902e-a40e3af1d240",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "État d’inexistence des êtres et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a3d4ad-02e2-43a2-adcb-5a10fb12d0f7",
                                                "sense_id": "1284f4da-89e3-3558-902e-a40e3af1d240",
                                                "text": "Dieu a tiré toutes choses du néant."
                                            },
                                            {
                                                "example_id": "67eb4550-3480-40b4-82d6-c21dfa664a30",
                                                "sense_id": "1284f4da-89e3-3558-902e-a40e3af1d240",
                                                "text": "Dieu peut réduire les êtres au néant, les faire rentrer dans le néant d’où ils sont sortis."
                                            },
                                            {
                                                "example_id": "7b2070ef-3bf6-4349-88b0-a41f017d8b10",
                                                "sense_id": "1284f4da-89e3-3558-902e-a40e3af1d240",
                                                "text": "La vie a cent aspects, le néant n’a qu’un moule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef3aa9f-f38d-3e11-9b55-64fd3322aec6",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe3c746-39d3-4feb-9841-d732625d9066",
                                                "sense_id": "0ef3aa9f-f38d-3e11-9b55-64fd3322aec6",
                                                "text": "On l’a fait rentrer dans le néant d’où on l’avait tiré."
                                            },
                                            {
                                                "example_id": "3ce0916a-1049-4f40-9b4c-95192ef0dc73",
                                                "sense_id": "0ef3aa9f-f38d-3e11-9b55-64fd3322aec6",
                                                "text": "Ce sont deux néants entre lesquels je me trouve en équilibre comme sur le tranchant d’une lame."
                                            },
                                            {
                                                "example_id": "0203205a-79db-4508-befc-4d3eb4adccb1",
                                                "sense_id": "0ef3aa9f-f38d-3e11-9b55-64fd3322aec6",
                                                "text": "En un peu moins de deux ans il était retombé dans cette solitude accablante, mais à ses yeux indispensable et riche, un peu comme le néant « riche de possibilités innombrables » de la pensée bouddhiste. Sauf que pour l’instant le néant n’engendrait que le néant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d183a77-a04b-3058-af3a-37730b3d2f05",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "Personne jugée sans valeur et sans intérêt."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f211882c-364c-421c-9c0c-06134eaa8faf",
                                                "sense_id": "8d183a77-a04b-3058-af3a-37730b3d2f05",
                                                "text": "Je l’ai connu, ton Phili, un de ces néants que la jeunesse rapide revêt un instant de rayons. À cet enfant gâté, caressé, défrayé de tout, tu prêtes des intentions délicates ou scélérates, des perfidies méditées ; mais il n’a que des réflexes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c101577-3a66-3e64-8bc9-b83ed369de33",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "Ce qui, par soi-même, n’a aucune valeur réelle."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10bd12d3-78c6-4444-b893-438e2a50a5ad",
                                                "sense_id": "0c101577-3a66-3e64-8bc9-b83ed369de33",
                                                "text": "[…] qui empêchera que l’attention ne soit sollicitée et retenue par des objets indignes ou absurdes, que l’on ne réfléchisse dans le vide, que l’on ne médite la sottise, la vésanie ou le néant ?"
                                            },
                                            {
                                                "example_id": "371310bd-e620-4739-80c3-97472cbae23c",
                                                "sense_id": "0c101577-3a66-3e64-8bc9-b83ed369de33",
                                                "text": "Le néant des grandeurs humaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2349344-d982-34b5-98b0-8eb31d3d553e",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "Rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254ca41a-cf3c-4337-a45c-ed19da93bc98",
                                                "sense_id": "a2349344-d982-34b5-98b0-8eb31d3d553e",
                                                "text": "— Ma fortune ! gronda amèrement Concini. Tu as soufflé dessus. Ma grandeur, tu l’as réduite à néant."
                                            },
                                            {
                                                "example_id": "73b3ad5c-ae43-4168-8b95-2139e9ae35f1",
                                                "sense_id": "a2349344-d982-34b5-98b0-8eb31d3d553e",
                                                "text": "S’exaltant un peu, elle en venait à demander à Dieu non pas essentiellement de me faire revenir, ni de me donner une belle vie selon le monde, mais de faire en sorte que les dons que je pouvais avoir ne tournent pas à néant, comme chez l’oncle Octave, mais servent à la cause de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c197804-21ac-3d15-9d35-1583a4f3c3a1",
                                        "entry_id": "d45a4eb9-a319-32e7-8c5b-7fc310a5e071",
                                        "glosses": [
                                            "S’emploie spécialement dans des formules administratives ou médicales, dans des expressions elliptiques, telles que :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b8fb30-1aaa-4b8f-a06f-089bf2efb09b",
                                                "sense_id": "1c197804-21ac-3d15-9d35-1583a4f3c3a1",
                                                "text": "Signes particuliers : néant."
                                            },
                                            {
                                                "example_id": "7f8b3d3a-430a-4484-a4ff-4d9c3dbbbe82",
                                                "sense_id": "1c197804-21ac-3d15-9d35-1583a4f3c3a1",
                                                "text": "Albumine, Sucre : néant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57d560f6-5dd4-42b4-a210-47df7687b339",
                        "source_entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                        "source_sense_id": "ef144762-ba8e-325e-847c-1d03617d5a49",
                        "target_lang_word": "inexistence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexistence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21cc31b3-2a43-34f3-b800-90c97b5b0a89",
                                        "entry_id": "185f0c44-2c03-3487-bbdf-04767def2686",
                                        "glosses": [
                                            "Fait de ne pas exister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1f8529b-8391-4201-b607-e9bd09191dd8",
                                                "sense_id": "21cc31b3-2a43-34f3-b800-90c97b5b0a89",
                                                "text": "Déjà il y avait entre eux d’importantes divergences ; on reprochait à Aron sa complaisance pour l’idéalisme de Brunschvicg ; mais tous avaient tiré beaucoup plus radicalement que moi les conséquences de l’inexistence de Dieu et ramené la philosophie du ciel sur terre."
                                            },
                                            {
                                                "example_id": "e581812d-8d58-4595-a6ec-f990405cf487",
                                                "sense_id": "21cc31b3-2a43-34f3-b800-90c97b5b0a89",
                                                "text": "C’était le seul endroit de l’univers où je pouvais m’approcher de ce que je recherchais par-dessus tout : l’inexistence."
                                            },
                                            {
                                                "example_id": "3e02b501-43a6-4d96-85f8-28f079753645",
                                                "sense_id": "21cc31b3-2a43-34f3-b800-90c97b5b0a89",
                                                "text": "Finalement, ils défendent l’idée de l’inexistence d’un parti anti-germanique, vu qu’il n’existait pas non plus de parti pro-germanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90528b81-2b43-4a6a-8fcc-c26671bd989c",
                        "source_entry_id": "c45f88b5-9b78-39ad-83cc-d94e3834e9a5",
                        "source_sense_id": "ef144762-ba8e-325e-847c-1d03617d5a49",
                        "target_lang_word": "Nichts",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichts",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                        "entry_id": "7ac9550a-336f-3dd4-a1b4-97ad9f9e06f5",
                                        "glosses": [
                                            "Ort, an dem nichts existiert, Raum, der leer ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29cc83d-8828-4950-aef8-0c289fb1432a",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "„Grenfeld öffnete die Augen und sah Magnusson ins Nichts starren.“"
                                            },
                                            {
                                                "example_id": "a554e1f9-78c7-4dc7-9af3-ac3515ac6f3d",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "Es verschwand im Nichts."
                                            },
                                            {
                                                "example_id": "a304bb2f-57c7-4e79-924d-19448906aa3e",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "Alle Vorwürfe lösten sich in einem Nichts auf."
                                            },
                                            {
                                                "example_id": "e79969e5-2764-4891-b860-26e598dcc757",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "Das Auto auf der Gegenfahrbahn tauchte wie aus dem Nichts auf."
                                            },
                                            {
                                                "example_id": "8812254c-3ff5-4886-909d-33340cd3013e",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "„Es verdrängt das Nichts, indem es sich Bahn bricht und durch die Ritzen der schwarzen Schraffur zum Vorschein tritt.“"
                                            },
                                            {
                                                "example_id": "2d38cf47-497f-487f-8201-4a0c0dfc2b0d",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "„Ich raste gegen Nichts und Niemand.“"
                                            },
                                            {
                                                "example_id": "2003a575-cac5-4741-8da8-50094a013008",
                                                "sense_id": "1385e211-22db-373e-ac69-695c6625a23b",
                                                "text": "„Wir sind einfach nur ein paar Männer sehr unterschiedlichen Alters im Nichts einer einsamen Landschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                        "entry_id": "7ac9550a-336f-3dd4-a1b4-97ad9f9e06f5",
                                        "glosses": [
                                            "Gegenteil von Sein"
                                        ],
                                        "tags": [
                                            "abstract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f4a60e-02b4-4455-984c-cc23b78c3c19",
                                                "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                                "text": "Entweder wir sind da, oder wir sind ein Nichts."
                                            },
                                            {
                                                "example_id": "8e84cd42-45f2-432c-9041-23e1971448c3",
                                                "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                                "text": "Das Nichts ist für den Menschen schwer zu ertragen."
                                            },
                                            {
                                                "example_id": "b9f1199d-00e8-423c-b8b8-9996883b422d",
                                                "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                                "text": "„Unter dem Eindruck der gesamten Maschinerie, den das Erlebnis der Fabriken mit den hilflosen Massen der um ein Nichts sich Mühenden und Fronenden in ihm hinterlassen hatte, kam ihm das persönliche Leben mit Anna nicht weniger gespentisch und gleichgültig vor.“"
                                            },
                                            {
                                                "example_id": "91496fce-a474-4b67-b77c-e244bed4e2f4",
                                                "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                                "text": "„Ich sah, daß sie selbst einen Hut trug; es war eher eine kleine Kappe, ein schwarzes Nichts, das schief in ihrem Haar saß.“"
                                            },
                                            {
                                                "example_id": "6bbf2a27-6d23-4e58-99e5-ba1ce284e92c",
                                                "sense_id": "c723eba7-294c-340a-a8fb-1cd5827ee0f6",
                                                "text": "„Megafaszinierend ist für mich daher, dass so etwas ›Nichtiges‹ wie die ›partiellen Nichtse‹ in sich noch einmal in unendlich viele ›Unter-Nichtse‹ gegliedert sind, von denen jedes gegenüber dem nächsthöheren (oder höherdimensionalen) wiederum wie nichts anmutet, weil es von ihm nur null Ausdehnung hat!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "272c087c-f2a8-327f-a4c5-7f1e7f36625c",
                                        "entry_id": "7ac9550a-336f-3dd4-a1b4-97ad9f9e06f5",
                                        "glosses": [
                                            "jemand ohne Rang und Ansehen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8767cfd2-54ed-42c0-a103-ba7d68e2a0e7",
                                                "sense_id": "272c087c-f2a8-327f-a4c5-7f1e7f36625c",
                                                "text": "Hier sind Sie ein Nichts, Herr Baron!"
                                            },
                                            {
                                                "example_id": "2acffc21-3791-47de-bd9a-02a3ed810249",
                                                "sense_id": "272c087c-f2a8-327f-a4c5-7f1e7f36625c",
                                                "text": "Sprich nicht mehr von ihr! Sie ist ein Nichts, ohne jegliche Relevanz."
                                            },
                                            {
                                                "example_id": "47d53261-2f2b-4d18-a336-2fd257e169c8",
                                                "sense_id": "272c087c-f2a8-327f-a4c5-7f1e7f36625c",
                                                "text": "„Sie haben mich gereizt durch einen Nicht-Gott, beleidigt durch ihre Nichtse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
