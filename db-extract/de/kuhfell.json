                "senses": [
                    {
                        "sense_id": "e1e7b4a4-af05-3464-9811-50f513736a33",
                        "entry_id": "58bbf5ff-2a1b-3eac-9312-0ae971c4229a",
                        "glosses": [
                            "(abgezogenes) Fell einer Kuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c91b109e-77b4-454f-ab2c-741393c1307b",
                                "sense_id": "e1e7b4a4-af05-3464-9811-50f513736a33",
                                "text": "„Das Winterfell eines Bisons hat zehnmal mehr Haare als ein Kuhfell und schützt vor dem Erfrieren.“"
                            },
                            {
                                "example_id": "d6c48b6d-9752-4a50-b0c8-39798a2c90b2",
                                "sense_id": "e1e7b4a4-af05-3464-9811-50f513736a33",
                                "text": "„Der Unterschlupf war so kurz, daß die Männer nicht mit dem ganzen Körper auf den harten Jaguar- und Kuhfellen liegen konnten, sondern ihre Beine in die glühende Sonne oder in den Regen hinausragten.“"
                            },
                            {
                                "example_id": "1205fe8e-6b28-479b-8dc0-62969336335a",
                                "sense_id": "e1e7b4a4-af05-3464-9811-50f513736a33",
                                "text": "„In der dritten Episode gibt das Bürle, nach seinem vielen Geld gefragt, an, dies sei der Erlös aus dem Verkauf des Kuhfells.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
