                        "examples": [
                            {
                                "example_id": "a9c502fa-5c74-4a06-a035-d3a7d9b4fbc0",
                                "sense_id": "f14bbf12-d512-34ef-aadd-ce04ef8af4fa",
                                "text": "‘But go thy waies to him, and fro me say, / That here is at his gate an errant Knight, / That house-room craves […].’"
                            },
                            {
                                "example_id": "1f08bb2a-5eb5-4095-b23e-6402ae8693ff",
                                "sense_id": "f14bbf12-d512-34ef-aadd-ce04ef8af4fa",
                                "text": "[…] it would make a man mad of our profession, especially to be buz’d in the Ears with your Honesty or Plain-dealing, as if you were turned their Advocate, and went about to perswade us to give them House room."
                            },
                            {
                                "example_id": "ff3566df-32e1-4c60-b6fe-808a61e31585",
                                "sense_id": "f14bbf12-d512-34ef-aadd-ce04ef8af4fa",
                                "text": "1786, Frederick Pilon, He Would Be a Soldier, London: G.G.J. & J. Robinson, Act III, p. 38,\n[…] she has more old figures than is worth house room."
                            },
                            {
                                "example_id": "73d6a39a-0d0e-4ec1-9c7b-b526228c6989",
                                "sense_id": "f14bbf12-d512-34ef-aadd-ce04ef8af4fa",
                                "text": "And, Mr. Farfrae, as you provide so much, and houseroom, and all that, I’ll do my part in the drinkables, and see to the rum and schiedam—maybe a dozen jars will be sufficient?"
                            }
                        ]
                    },
