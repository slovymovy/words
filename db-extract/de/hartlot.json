                "senses": [
                    {
                        "sense_id": "43399b93-c232-3108-8748-2f0cffd41721",
                        "entry_id": "1622ad39-54e6-33c7-b102-a4362fd0680b",
                        "glosses": [
                            "Brasure forte (matériau)."
                        ],
                        "tags": [
                            "Électrotechnique"
                        ],
                        "examples": [
                            {
                                "example_id": "32bfa17a-bbf7-4c2f-8bbd-ca861b2d1c9c",
                                "sense_id": "43399b93-c232-3108-8748-2f0cffd41721",
                                "text": "Die Festigkeit der verwendeten Hartlote ist in jedem Fall höher als die des geglühten Kupfers.",
                                "translation": "La résistance des brasures fortes utilisées est dans tous les cas supérieure à celle du cuivre recuit."
                            },
                            {
                                "example_id": "f1ecb28a-e928-4161-aa40-586f82c6592f",
                                "sense_id": "43399b93-c232-3108-8748-2f0cffd41721",
                                "text": "Hartlote zum Löten von Kupferwerkstoffen sind meist Legierungen auf Kupfer-, Silber- oder Messingbasis und eignen sich für mechanisch stärker beanspruchte Verbindungen. Die Verarbeitungstemperaturen liegen zwischen ca. 500 – 1000 °C.",
                                "translation": "Les brasures fortes pour le brasage de matériaux cuivreux sont généralement des alliages à base de cuivre, d’argent ou de laiton et conviennent aux assemblages fortement sollicités mécaniquement. Les températures de mise en œuvre se situent entre env. 500 et 1000 °C."
                            }
                        ]
                    }
