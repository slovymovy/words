                ],
                "senses": [
                    {
                        "sense_id": "ccb21b5f-eed2-3952-98c2-e4976381c053",
                        "entry_id": "12c9de1e-91a0-39cf-8679-26367f9b7f0c",
                        "glosses": [
                            "sich vom Kot pflanzenfressender Säugetiere ernährender Käfer, der nach der Paarung eine Kugel aus Dung formt, diese fortrollt und anschließend vergräbt"
                        ],
                        "tags": [
                            "Entomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4b5d5e00-07d9-4781-bb9c-ccc71a42c17b",
                                "sense_id": "ccb21b5f-eed2-3952-98c2-e4976381c053",
                                "text": "Im Alten Ägypten galt der Skarabäus als sich im Nilschlamm fortpflanzungslos vermehrender Käfer und war Symbol der Schöpferkraft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9450d02-2d0b-3d0d-bc86-c6c8c8dacc88",
                        "entry_id": "12c9de1e-91a0-39cf-8679-26367f9b7f0c",
                        "glosses": [
                            "aus einem bestimmten Material hergestellte Nachbildung des Käfers [1] als Sinnbild zur Verehrung des Sonnengottes Re im alten Ägypten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b60e754-e151-45aa-9a20-41e41b7fa9e6",
                                "sense_id": "f9450d02-2d0b-3d0d-bc86-c6c8c8dacc88",
                                "text": "Er kaufte sich in Ägypten einen Skarabäus als Andenken."
                            },
                            {
                                "example_id": "4ebf81c9-182b-4b45-8f37-2f1acb6d8e8c",
                                "sense_id": "f9450d02-2d0b-3d0d-bc86-c6c8c8dacc88",
                                "text": "„Den Skarabäus schenkte er mir erst zehn Jahre später, als ich zum zweiten Mal in der Pension »Suisse« abstieg und Ibrahim noch immer hinter der Rezeption saß.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
