                        "sense_id": "5425b2c4-15bb-33d9-b787-2b82acc8e77a",
                        "entry_id": "46cb64f1-b401-322f-bcdb-782367c2ab99",
                        "glosses": [
                            "не подвергшийся косьбе; такой, на котором оставлены трава, злаки и т. п."
                        ],
                        "tags": [],
