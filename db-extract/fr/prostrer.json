                "senses": [
                    {
                        "sense_id": "7182d17e-bcd1-3057-9d28-628e3cd25be1",
                        "entry_id": "e9f0a808-428d-3f40-8ba5-7c8b1e99930d",
                        "glosses": [
                            "Affaiblir, mettre dans un état de prostration."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ab579d76-3463-427a-bf5b-374c3e7f0283",
                                "sense_id": "7182d17e-bcd1-3057-9d28-628e3cd25be1",
                                "text": "Aimer, pour prostrer la fatalité."
                            },
                            {
                                "example_id": "0ac0347e-bdea-424b-92e0-0da6f1cb8800",
                                "sense_id": "7182d17e-bcd1-3057-9d28-628e3cd25be1",
                                "text": "La peur passive nous prostre, fait échec à toutes les représentations motrices, relâche les sphincters, ralentit les mouvements du cœur et la respiration."
                            },
                            {
                                "example_id": "ed27a4b5-4a93-4abf-86a6-575f0f3a8ff9",
                                "sense_id": "7182d17e-bcd1-3057-9d28-628e3cd25be1",
                                "text": "Je restais convaincue que le péché est la place béante de Dieu et je me perchais sur mon tabouret avec la ferveur qui me prostrait, enfant, au pied du Saint-Sacrement : […]"
                            }
                        ]
                    }
