                "senses": [
                    {
                        "sense_id": "f88b3da7-27d8-3af9-a057-c6faa8aa4945",
                        "entry_id": "4448d4df-f14a-38ad-a74d-1be9e5161a5e",
                        "glosses": [
                            "Gruppe von Krankheitsauslösern (Erregern) mit gleichen Merkmalen"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ba00d0-3c63-4898-9129-6a4993cd9c43",
                                "sense_id": "f88b3da7-27d8-3af9-a057-c6faa8aa4945",
                                "text": "„Umgekehrt steuert die angeborene die erworbene Immunität, indem sie den eingedrungenen Erregertyp einordnet und die erworbene Immunantwort entsprechend instruiert.“"
                            },
                            {
                                "example_id": "9c025628-339d-47e3-a65d-58d2dd6e63aa",
                                "sense_id": "f88b3da7-27d8-3af9-a057-c6faa8aa4945",
                                "text": "„Da es jedoch zwei unterschiedliche Erregertypen gibt, kann ein Kind auch zweimal an Dreitagefieber erkranken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
