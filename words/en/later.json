                {
                    "sense_id": "87d56250-1672-3ea1-8dc8-d546152457a6",
                    "sense_definition": "Comparative form of <w>late</w>: more late.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparative_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the party <w>later</w> than everyone else.",
