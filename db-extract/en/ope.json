                    {
                        "sense_id": "1f9936a5-bab4-3b03-a82f-6e94d10d3039",
                        "entry_id": "75319401-f2f8-3b8f-92aa-e9cdc1756eef",
                        "glosses": [
                            "Open."
                        ],
                        "tags": [
                            "dialectal",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "fb0885fd-d6bb-4eff-85f8-32cb95b42086",
                                "sense_id": "1f9936a5-bab4-3b03-a82f-6e94d10d3039",
                                "text": "Arriving there, as did by chaunce befall, / He found the gate wyde ope […]."
                            },
                            {
                                "example_id": "83b031d8-2e45-4fe6-9390-c42d62474c7c",
                                "sense_id": "1f9936a5-bab4-3b03-a82f-6e94d10d3039",
                                "text": "We are all weary — faint — set ope the doors —\nI will to bed! — To-morrow —"
                            },
                            {
                                "example_id": "6403bc8e-8e04-4a62-bede-6fe8683ea6e6",
                                "sense_id": "1f9936a5-bab4-3b03-a82f-6e94d10d3039",
                                "text": "On Sunday heaven's gate stands ope."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c649c518-f870-313c-8cc8-974645157f70",
