                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вакка",
                                "target_lang_sense_clarification": "геологический термин для обозначения горной породы"
                            },
                            {
                                "target_lang_word": "граувакка",
                                "target_lang_sense_clarification": "разновидность песчаника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
