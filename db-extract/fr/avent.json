        "fr-extract.jsonl": [
            {
                "entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                "word": "Avent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "271167f8-865c-41d1-92b0-70fd505f8e4e",
                        "entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                        "tags": [
                            "mais Avent est désormais beaucoup plus courant"
                        ],
                        "form": "avent"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                        "entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                        "glosses": [
                            "Temps pendant lequel les chrétiens se préparent à célébrer la fête de Noël."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472cf63b-919f-4929-bc5b-a6147a9291cc",
                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                "text": "Nous vîmes bien qu’elle ne pouvait se passer de lui ; elle n’y consentait que durant l’année scolaire qui était pour elle, j’imagine, un Avent liturgique, un temps de préparation à la venue de Simon…"
                            },
                            {
                                "example_id": "a6126c78-79ac-4747-b024-bc1cf67a6056",
                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                "text": "Cette psalmodie parvint aux oreilles d’un petit campement de métis convertis, qui abattaient du bois. […] ils sortirent tout joyeux, s’attendant à un second Avent."
                            },
                            {
                                "example_id": "5199aac1-a094-4aed-a6d4-3e1a15ec259f",
                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                "text": "La nouvelle « Traduction officielle liturgique » des textes bibliques est disponible depuis le mois de novembre 2013. Mais il a fallu attendre le premier dimanche de l’Avent pour disposer des lectionnaires, c’est-à-dire les livres qui donnent pour chaque dimanche ou pour chaque jour de la semaine, les textes choisis pour la liturgie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5be49a23-178b-4adc-9a8a-3fe53c7d3969",
                        "source_entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                        "source_sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                        "target_lang_word": "Advent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Advent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                        "entry_id": "3091f4a4-531d-3619-8d94-9d8b2e525741",
                                        "glosses": [
                                            "der Zeitraum von zirka vier Wochen vom 1. Advent bis Weihnachten, durch den das Kirchenjahr mit der Vorbereitung auf Weihnachten beginnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9bdb8f-5805-4113-80cb-d80f0d35fdd0",
                                                "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                                "text": "Der erste Advent ist am Sonntag zwischen dem 27. November und dem 3. Dezember."
                                            },
                                            {
                                                "example_id": "bd2f0534-a81d-45e7-892a-e7610f39d3fd",
                                                "sense_id": "e3ea4839-13e1-3a45-b908-0cc659cd457c",
                                                "text": "„Drei Tage vor dem ersten Advent ging der Direktor nach Schulschluss durchs Viertel, um im Auftrag seiner Frau einen Adventskranz zu kaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a8a45e6-09aa-4122-bb92-775cf8a2c223",
                        "source_entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                        "source_sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                        "target_lang_word": "Adventszeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adventszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "525767e1-8cda-3dde-b8db-41f5af11915d",
                                        "entry_id": "8e67a84a-b8cb-34f4-a2ec-897c322773fe",
                                        "glosses": [
                                            "Zeit des Advent, circa vier Wochen vor Weihnachten, in denen Christen die bevorstehende Ankunft des Herrn feiern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289e6666-c271-40cb-b179-3b4742f391e7",
                                                "sense_id": "525767e1-8cda-3dde-b8db-41f5af11915d",
                                                "text": "„Besonders stark empfand ich dies in der Adventszeit von 1943.“"
                                            },
                                            {
                                                "example_id": "a30e4ca9-2566-4b14-a1bd-870f2f468f1b",
                                                "sense_id": "525767e1-8cda-3dde-b8db-41f5af11915d",
                                                "text": "„Über den Zeitpunkt werden wir natürlich nicht informiert, aber das macht ja nichts, weil wir gerade in der Adventszeit für den prickelnden Reiz des Überraschungsmoments besonders empfänglich sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b3568a-ffb2-4484-b76f-2c64f6686cf0",
                        "source_entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
