                    {
                        "sense_id": "fbedf6bf-73c1-352c-bdf1-ccca6f66990e",
                        "entry_id": "e34ee004-f387-383a-8227-c7b62ef3b385",
                        "glosses": [
                            "weibliche Person mit viel Erfahrung beim Klettern"
