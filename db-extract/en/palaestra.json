                "senses": [
                    {
                        "sense_id": "e0b68474-5311-3089-9610-a72db3c457cf",
                        "entry_id": "4d71fadb-d828-31d1-94b6-6adbf04a2029",
                        "glosses": [
                            "A public area in ancient Greece and Rome dedicated to the teaching and practice of wrestling and other sports; a wrestling school, a gymnasium."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "abbf7b51-75de-405a-8318-dfa4dbff3284",
                                "sense_id": "e0b68474-5311-3089-9610-a72db3c457cf",
                                "text": "Athenian culture flourished in externalities, the open air of the agora and the nudity of the palestra."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b018ea8-5ef9-3e00-aa93-35e7856abff5",
                        "entry_id": "4d71fadb-d828-31d1-94b6-6adbf04a2029",
                        "glosses": [
                            "An arena for literal or figurative combat; a battlefield."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c44e8367-465c-4544-b4b8-cd789e6c7ae2",
                        "source_entry_id": "4d71fadb-d828-31d1-94b6-6adbf04a2029",
                        "source_sense_description": "ancient wrestling area",
                        "target_lang_word": "palestre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palestre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                        "entry_id": "305c9ac9-a899-3a41-9991-c2491a99cba6",
                                        "glosses": [
                                            "Lieu public, chez les Grecs, où les jeunes gens se formaient aux différents exercices du corps."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4b51d6-e2d3-4e91-9869-ea55b5fd5df6",
                                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                                "text": "Le sable des palestres était toujours aussi blond qu’autrefois ; Phidias et Socrate ne les fréquentaient plus , mais les jeunes hommes qui s’y exerçaient ressemblaient encore au délicieux Charmide."
                                            },
                                            {
                                                "example_id": "9d79957f-19a6-4688-bfdf-b5ab69f7f6be",
                                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                                "text": "Il y avait dans les palestres des portiques, des bains chauds et froids, et même des salles pour les leçons de philosophie et de grammaire."
                                            },
                                            {
                                                "example_id": "88d2b29b-2a55-4e8e-b5e2-32853a6ec341",
                                                "sense_id": "fb32703f-5769-3333-8750-b6868837c98a",
                                                "text": "Vitruve a laissé le plan d’une palestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d8ded6-b461-3a3d-9232-083208e5330d",
                                        "entry_id": "305c9ac9-a899-3a41-9991-c2491a99cba6",
                                        "glosses": [
                                            "Les exercices mêmes, c’est-à-dire la lutte, le pugilat, la course, le saut, le disque, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
