                                    {
                                        "sense_id": "88278991-246e-39a9-a59f-f1256dfcc607",
                                        "entry_id": "655daa00-9c72-3ecd-9d78-1508f8c824c9",
                                        "glosses": [
                                            "A type of small boat, covered over by a surface deck, powered by the occupant or occupants using a double-bladed paddle in a sitting position, from a hole in the surface deck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90489fe6-243e-43da-8dda-2910ea1d283d",
                                                "sense_id": "88278991-246e-39a9-a59f-f1256dfcc607",
                                                "text": "It’s just offshore from private property inaccessible to the general public, so a good way to approach the rock is by kayak, which can be rented in the small village of Port Austin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kayak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc3b1e5-4af9-33d4-bf68-1b8a05cea04c",
                                        "entry_id": "fdb14f83-363c-3d43-a540-b832fe8524d5",
                                        "glosses": [
                                            "To use a kayak, to travel or race in a kayak."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5f36f9-3bd8-4737-a075-5c4d620a60de",
                                                "sense_id": "acc3b1e5-4af9-33d4-bf68-1b8a05cea04c",
                                                "text": "Kayaking is an Olympic sport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9170287d-0d2b-3c10-ada8-a3e4a18b93a5",
                                        "entry_id": "fdb14f83-363c-3d43-a540-b832fe8524d5",
                                        "glosses": [
                                            "To traverse (a body of water) by kayak."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10815e4b-28c0-46b8-8c73-7b6c0ee4d428",
                                                "sense_id": "9170287d-0d2b-3c10-ada8-a3e4a18b93a5",
                                                "text": "On a dare, he kayaked the Harlem River in New York from Hell's Gate to Spyten Duyvil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
