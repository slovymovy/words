                        "examples": [
                            {
                                "example_id": "c2e604fd-48ce-4426-9951-670de2ead839",
                                "sense_id": "96248b1d-dd79-3233-9ebc-c9582f2c3881",
                                "text": "Vlooienkruid, n. [H n.] Herbe aux puces f., plantain pucier ou pulicaire, psyllion m. (Plantago psyllium) ; aunée ou inule pulicaire (Inula pulicaria) ; — pulicaire f. (Pulicaria) ; persicaire f., curage, piment ou poivre d’eau m. (Polygonum hydropiper), herbe au cancer, dentelaire f. (Plumbago europæa), conise ou conyze f. (Conyza). — Chasse-puce, pouliot sauvage m. (Mentha puligium ^([sic]))."
                            },
                            {
                                "example_id": "6b645daa-1934-4bdb-a849-515e10bdf2a9",
                                "sense_id": "96248b1d-dd79-3233-9ebc-c9582f2c3881",
                                "text": "La conyze a été réputée sudorifique, emménagogue, vulnéraire et insecticide par son odeur."
                            }
                        ]
