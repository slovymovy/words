                "senses": [
                    {
                        "sense_id": "123f2f6f-69f4-34f9-ab6e-9ea34d013855",
                        "entry_id": "73db7382-31b6-3624-add3-f486dbb00e5f",
                        "glosses": [
                            "Dans le cadre de l’algèbre générale ou de l’algèbre universelle, homomorphisme injectif; dans le cadre de la théorie des catégories, un monomorphisme simplifiable à gauche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3481fb3e-4a96-361a-b744-7e8105d1edb2",
                        "entry_id": "73db7382-31b6-3624-add3-f486dbb00e5f",
                        "glosses": [
                            "Uniformité dans la morphologie ou le comportement des cellules, des microbes, des membres de l’espèce, etc."
                        ],
                        "tags": [
                            "Éthologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d567f438-b219-4f35-bb75-2731cc29aa0f",
                                "sense_id": "3481fb3e-4a96-361a-b744-7e8105d1edb2",
                                "text": "Monomorphisme : Uniformité dans la morphologie et/ou le comportement d’une espèce. On appelle monomorphes les espèces qui ne connaissent ni → dimorphisme sexuel, ni → castes, ni → rôles comportementaux (→ polymorphisme)."
                            },
                            {
                                "example_id": "df723c7a-fa6f-4405-bba7-fb6213481342",
                                "sense_id": "3481fb3e-4a96-361a-b744-7e8105d1edb2",
                                "text": "Le diagnostic est assuré par le polymorphisme lymphocytaire caractéristique qui s’oppose au monomorphisme des cellules blastiques."
                            }
                        ]
                    }
                ],
