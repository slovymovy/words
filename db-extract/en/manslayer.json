                "senses": [
                    {
                        "sense_id": "69574207-8900-37c1-a557-347789a37976",
                        "entry_id": "b336f938-5fd0-364f-ad9f-60c26766ec95",
                        "glosses": [
                            "One who commits homicide or manslaughter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e72c0c-0947-423c-ab97-01649c7edbea",
                                "sense_id": "69574207-8900-37c1-a557-347789a37976",
                                "text": "The right of an accidental manslayer to flee to the protective custody of a city of refuge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a246ee0-95a1-4fe5-9d6a-f946cad67d90",
                        "source_entry_id": "b336f938-5fd0-364f-ad9f-60c26766ec95",
                        "source_sense_id": "69574207-8900-37c1-a557-347789a37976",
                        "source_sense_description": "one who commits manslaughter",
                        "target_lang_word": "Totschläger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totschläger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6b2790-8fd3-3949-9968-90f2b4700712",
                                        "entry_id": "fdce3b1b-6e7f-3b4d-be79-695592e6cdd7",
                                        "glosses": [
                                            "Schlagwaffe, die biegsam und am Ende beschwert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1b55ad-4adb-4e99-8996-0866dc7794f7",
                                                "sense_id": "7c6b2790-8fd3-3949-9968-90f2b4700712",
                                                "text": "Bei der Razzia fanden die Polizisten mehrere illegale Totschläger, Messer und Pistolen."
                                            },
                                            {
                                                "example_id": "6897d4e1-1dab-414c-b52f-2add03eca14f",
                                                "sense_id": "7c6b2790-8fd3-3949-9968-90f2b4700712",
                                                "text": "„Mithilfe des Fernrohrs verschaffte ich mir Gewissheit, dass die Gruppe vor allem aus Frauen und Jugendlichen bestand und dass niemand Stöcke oder Totschläger dabeihatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cd955b3-b006-3181-9704-61ccf5491864",
                                        "entry_id": "fdce3b1b-6e7f-3b4d-be79-695592e6cdd7",
                                        "glosses": [
                                            "Person, die einen Totschlag begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bf41f7-64f4-4333-8788-7a67462a0bfc",
                                                "sense_id": "3cd955b3-b006-3181-9704-61ccf5491864",
                                                "text": "Der Totschläger wurde zu zehn Jahren Haft verurteilt."
                                            },
                                            {
                                                "example_id": "068c0044-8917-4ec2-a8a1-242e26b26c5b",
                                                "sense_id": "3cd955b3-b006-3181-9704-61ccf5491864",
                                                "text": "„Der auf Island verurteilte Totschläger ist nun ein geachteter Anführer der Pioniere, seine Kinder könnten auf Grönland für alle ihre Tage Ansehen und Land beanspruchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
