                ],
                "senses": [
                    {
                        "sense_id": "2bf3dd49-cd30-3bf2-ab98-66cc896a3bc0",
                        "entry_id": "9399f85b-1432-301d-bc9d-48063a456699",
                        "glosses": [
                            "moralisches Gebot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1c2771-1b99-4fd6-8f9a-1b3f00929837",
                                "sense_id": "2bf3dd49-cd30-3bf2-ab98-66cc896a3bc0",
                                "text": "Der kategorische Imperativ Immanuel Kants ist ein Beispiel für ein Sittengesetz."
                            },
                            {
                                "example_id": "aad32520-dbcd-436d-830f-55b7938efce9",
                                "sense_id": "2bf3dd49-cd30-3bf2-ab98-66cc896a3bc0",
                                "text": "„Jeder hat das Recht auf die freie Entfaltung seiner Persönlichkeit, soweit er nicht die Rechte anderer verletzt und nicht gegen die verfassungsmäßige Ordnung oder das Sittengesetz verstößt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3900199c-c17e-4f04-8c90-fc6db46b1429",
                        "source_entry_id": "9399f85b-1432-301d-bc9d-48063a456699",
                        "source_sense_id": "2bf3dd49-cd30-3bf2-ab98-66cc896a3bc0",
                        "source_sense_description": "Philosophie: moralisches Gebot",
                        "target_lang_word": "мораль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мораль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f722ee95-1b16-323e-84d9-8996034daba2",
                                        "entry_id": "54c6a139-c5e5-36f9-97b4-a7239ef67f67",
                                        "glosses": [
                                            "неисч., книжн. нравственное учение; свод правил нравственности, этики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a3d755f-cbb3-4fa2-aef4-c032ce68fcb2",
                                                "sense_id": "f722ee95-1b16-323e-84d9-8996034daba2",
                                                "text": "Сегодня в нашем обществе насаждается потребительское мировоззрение, поощряются эгоистические устремления человека, попирается христианская мораль с её жертвенностью и устремленностью к высшим идеалам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e8a818-0783-35c6-b437-b8b4b62c155f",
                                        "entry_id": "54c6a139-c5e5-36f9-97b4-a7239ef67f67",
                                        "glosses": [
                                            "неисч. нравственность, поведение с точки зрения правил нравственности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a086fc19-935a-408b-9ff0-464596bfc161",
                                                "sense_id": "02e8a818-0783-35c6-b437-b8b4b62c155f",
                                                "text": "Человек невысокой морали."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d94f86e-c75e-34a0-95a5-5610b5b820de",
                                        "entry_id": "54c6a139-c5e5-36f9-97b4-a7239ef67f67",
                                        "glosses": [
                                            "исч. вывод из чего-нибудь; нравственный урок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fa64b1-ecd2-4d56-aed9-3e4bbd2ec5d5",
                                                "sense_id": "8d94f86e-c75e-34a0-95a5-5610b5b820de",
                                                "text": "Мораль сей басни проста как правда: такое в жизни бывает, что ни в сказке сказать, ни пером описать!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "925c66e8-bee8-31b4-b46a-9036820c9f9f",
                                        "entry_id": "54c6a139-c5e5-36f9-97b4-a7239ef67f67",
                                        "glosses": [
                                            "исч., разг. нравоучение, наставление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4c3569-e9a6-4c8c-845f-770a0fb64de9",
                                                "sense_id": "925c66e8-bee8-31b4-b46a-9036820c9f9f",
                                                "text": "Выглянула из двери, повиснув на костылях, пожилая, встрёпанная, читает мораль."
                                            },
                                            {
                                                "example_id": "ca7102f1-5639-4d66-9111-16ccf7894c71",
                                                "sense_id": "925c66e8-bee8-31b4-b46a-9036820c9f9f",
                                                "text": "Она была их утешительницей, душеприказчицей, казначеем, лекарем и духовною матерью: ей первой бежал солдатик открыть свое горе, заключавшееся в потере штыка, или в иной подобной беде, значения которой не понять тому, кто не носил ранца за плечами, — и Катерина Астафьевна не читала никаких моралей и наставлений, а прямо помогала, как находила возможным."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41cf9074-af46-4a35-9ce1-c9e0f8d3985a",
                        "source_entry_id": "9399f85b-1432-301d-bc9d-48063a456699",
                        "source_sense_id": "2bf3dd49-cd30-3bf2-ab98-66cc896a3bc0",
                        "source_sense_description": "Philosophie: moralisches Gebot",
                        "target_lang_word": "нравственность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нравственность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "29758294-e838-3ec0-b75d-d4ccb0a03a3e",
                                        "entry_id": "f2d34337-7693-31aa-bba9-e97523cc565a",
                                        "glosses": [
                                            "совокупность норм поведения человека в обществе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93610bc-8c9f-4d33-8fc9-7564c4d15ca3",
                                                "sense_id": "29758294-e838-3ec0-b75d-d4ccb0a03a3e",
                                                "text": "Сколько гляжу, ― всё больше убеждаюсь, что общественная нравственность и нравственность личная очень редко совпадают."
                                            },
                                            {
                                                "example_id": "66aee714-d767-4608-b23e-28cde5c83041",
                                                "sense_id": "29758294-e838-3ec0-b75d-d4ccb0a03a3e",
                                                "text": "Дежурная горничная в гостинице следит за нашей нравственностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a541b59-68e5-369c-90ee-3df39261fdfd",
                                        "entry_id": "f2d34337-7693-31aa-bba9-e97523cc565a",
                                        "glosses": [
                                            "свойство по значению прилагательного нравственный; внутренние качества человека, определяющие соответствие его поведения этим нормам; также выражение таких качеств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38241ac0-dd5c-4309-84cc-a8793d0a0082",
                                                "sense_id": "7a541b59-68e5-369c-90ee-3df39261fdfd",
                                                "text": "Анна Ивановна прекрасная, благородная девушка, самой высокой нравственности, она не способна ни на что дурное."
                                            },
                                            {
                                                "example_id": "8981fc7b-3f78-4622-9e3b-eca6cba15fdd",
                                                "sense_id": "7a541b59-68e5-369c-90ee-3df39261fdfd",
                                                "text": "Это был храбрый и толковый начальник, но нравственности низкой ― сухой и беспринципный, эгоист, не брезговавший ничем ради карьеры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
