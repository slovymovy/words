                                                "example_id": "2c257774-23db-4c68-b70a-de8abaf7136b",
                                                "sense_id": "b2cdb01e-d03d-32c9-a873-f3225ede7e68",
                                                "text": "Wenn es etwas gibt, das ein Pfiffikus gut kann, dann ist es, schlau und listig zu sein."
                                            },
