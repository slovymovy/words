                                    {
                                        "sense_id": "33ef4303-c908-34b1-8b7d-f5926d8c6e34",
                                        "entry_id": "9203a7e4-fef2-344e-8fcb-a9ed5fdb93eb",
                                        "glosses": [
                                            "Qui dépasse en largeur et en longueur la mesure ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9843dbc3-1efb-457a-b229-cc19cbb7ba1b",
                                                "sense_id": "33ef4303-c908-34b1-8b7d-f5926d8c6e34",
                                                "text": "J’ai fait un grand pas dans l’adaptation au milieu : j’ai adopté le costume indigène. C’est avec un vrai plaisir que j’ai échangé le complet européen étriqué contre ces amples vêtements, chauds en hiver et frais en été; […]."
                                            },
                                            {
                                                "example_id": "66f6f194-2ab5-46db-be21-1308f7dcb73d",
                                                "sense_id": "33ef4303-c908-34b1-8b7d-f5926d8c6e34",
                                                "text": "Pendant les premiers jours de cette traversée, Mrs. Aouda fit plus ample connaissance avec Phileas Fogg"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                        "entry_id": "9203a7e4-fef2-344e-8fcb-a9ed5fdb93eb",
                                        "glosses": [
                                            "Qui est abondant, considérable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc044577-d509-4688-b4f2-fe3e35fcd84e",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Ample provision."
                                            },
