                "senses": [
                    {
                        "sense_id": "728cec4d-42ef-3bad-8412-91ddeb87c604",
                        "entry_id": "66770ee7-0484-386f-9ddc-acbc6fcb00a8",
                        "glosses": [
                            "Kirche, die in Fachwerkbauweise errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d5e5dd2-f32e-4394-bf1c-876e8b708008",
                                "sense_id": "728cec4d-42ef-3bad-8412-91ddeb87c604",
                                "text": "„Den Grundriss der Fachwerkkirche bildete ein lateinisches Kreuz.“"
                            },
                            {
                                "example_id": "f26ec9e3-9cdf-477b-b404-1439dc21cee1",
                                "sense_id": "728cec4d-42ef-3bad-8412-91ddeb87c604",
                                "text": "„Das Schmuckstück des unweit Potsdams gelegenen Dörfchens Priort ist eine in der Mitte des 18. Jahrhunderts errichtete kleine Fachwerkkirche.“"
                            },
                            {
                                "example_id": "d06693d1-8bba-4795-a73a-bc3b0793e401",
                                "sense_id": "728cec4d-42ef-3bad-8412-91ddeb87c604",
                                "text": "„Vergleichbar sind die Stadtkirche in Neustadt (Bezirk Potsdam, 1673 — 1696) vom selben Architekten und die Fachwerkkirche in Pawellau (Schlesien, 1709).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
