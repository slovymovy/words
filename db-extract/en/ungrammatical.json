                "forms": [
                    {
                        "form_id": "f3cd2271-5732-4012-99f4-82d15aa12cc8",
                        "entry_id": "0cf0f9cf-6908-33c7-879b-984b72e5c065",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ungrammatical"
                    },
                    {
                        "form_id": "d11fd5cd-971b-4f86-967a-2ac8e53f25a9",
                        "entry_id": "0cf0f9cf-6908-33c7-879b-984b72e5c065",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ungrammatical"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e433ee13-22b6-3890-879c-0f0fd5674180",
                        "entry_id": "0cf0f9cf-6908-33c7-879b-984b72e5c065",
                        "glosses": [
                            "In violation of one or more of the rules and conventions of a language as defined by the grammar, resulting in unacceptable or incorrect usage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5eca06-a556-4275-ac87-b22fcf5473f7",
                                "sense_id": "e433ee13-22b6-3890-879c-0f0fd5674180",
                                "text": "My Greek is not the tongue of Homer or Aeschylus but a sloppy ungrammatical sabir lacking Attic salt and tending to a saccharinity which sets my teeth on edge."
                            },
                            {
                                "example_id": "7304360c-242a-48ea-ace4-1a8e16267fd2",
                                "sense_id": "e433ee13-22b6-3890-879c-0f0fd5674180",
                                "text": "That comment seemed to anger Ingraham, who called James’ view a “barely intelligible, not to mention ungrammatical take on President Trump.”"
                            },
                            {
                                "example_id": "3efa1057-3cc3-4377-aff8-c26610701e34",
                                "sense_id": "e433ee13-22b6-3890-879c-0f0fd5674180",
                                "text": "While adopting the pronoun as a nonbinary description is vastly preferable for some, Merriam-Webster says, there has also been some debate that it is ungrammatical."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8e94ee8-28f4-4876-81a2-ce181cb692ef",
                        "source_entry_id": "0cf0f9cf-6908-33c7-879b-984b72e5c065",
                        "source_sense_id": "e433ee13-22b6-3890-879c-0f0fd5674180",
                        "source_sense_description": "in violation of one or more of the rules and conventions of a language",
                        "target_lang_word": "agrammatical",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agrammatical",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                        "entry_id": "604a3620-7da0-3bae-9483-a9129cf05a04",
                                        "glosses": [
                                            "Qui ne respecte pas la grammaire considérée comme l’ensemble des règles définissant le discours correct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87fd61d0-bd61-4886-910a-08f13d947c46",
                                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                                "text": "« En descendant de vélo, une vache me regardait. » Cette phrase est agrammaticale, sauf si l’on considère que c’est la vache qui descendait du vélo."
                                            },
                                            {
                                                "example_id": "0a4c07cc-f87d-4263-b20a-9102095502dc",
                                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                                "text": "L’emploi du mode subjonctif derrière la locution conjonctive « après que » est agrammatical."
                                            },
                                            {
                                                "example_id": "51b14bde-898a-4fe0-b05d-f68b3605d58d",
                                                "sense_id": "10c5a6de-0687-38fe-9398-f3496a734d17",
                                                "text": "Sous l’influence grandissante de l’anglais, un certain nombre de tournures agrammaticales, quoique parfaitement comprises, fleurissent dans le français commun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5de0b2-435c-344c-bbd1-1f2b6d6728b8",
                                        "entry_id": "604a3620-7da0-3bae-9483-a9129cf05a04",
                                        "glosses": [
                                            "Qui ne respecte pas les règles de production d’un énoncé propres à une langue donnée. Noam Chomsky a montré que la phrase « d’incolores idées vertes dorment furieusement » n’est pas agrammaticale mais inacceptable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
