                "senses": [
                    {
                        "sense_id": "83c20e38-9a52-3625-8515-f797037cc1bc",
                        "entry_id": "09fb3bb3-fba3-3ec3-ba84-9f30a018a49b",
                        "glosses": [
                            "Donner le titre de docteur, faire docteur."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7d00464f-64dd-4caf-ad0c-7e943a2a07d7",
                                "sense_id": "83c20e38-9a52-3625-8515-f797037cc1bc",
                                "text": "Professionnellement, ils sont en général formés à des disciplines traditionnelles, bien que depuis peu ils aient la possibilité de se faire doctorifier en traductologie."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb895867-7325-3d46-8396-2200f26bbcb5",
                        "entry_id": "09fb3bb3-fba3-3ec3-ba84-9f30a018a49b",
                        "glosses": [
                            "S’attribuer le titre de docteur."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "85126220-fa92-46e1-9cb2-efc99f4d8482",
                                "sense_id": "eb895867-7325-3d46-8396-2200f26bbcb5",
                                "text": "Mais à Nice, la facilité avec laquelle le collège des docteurs admet les candidats à « la laurea », pousse toute la jeunesse à se doctorifier par ambition."
                            }
                        ]
                    }
