                                "sense_id": "7417bd94-c687-36d6-a417-db145a2ff228",
                                "text": "Brandt!"
                            },
                            {
                                "example_id": "a543b109-2204-4119-af4e-e268c6f9c631",
                                "sense_id": "7417bd94-c687-36d6-a417-db145a2ff228",
                                "text": "Hij vertelde dat u afkomstig bent uit het land van de Moren, van eindeloze sterrenluchten, van Arabische paleizen en katholieke forten, land met bloed in zijn bodem, waar de zon ongenadig op de siërra brandt."
                            },
                            {
                                "example_id": "b8980198-e92a-4a45-870d-95f14832dd73",
                                "sense_id": "7417bd94-c687-36d6-a417-db145a2ff228",
                                "text": "De zon brandt keihard op mijn blote schouders."
                            },
                            {
                                "example_id": "43eac213-5db9-473a-8406-3af25bc84184",
                                "sense_id": "7417bd94-c687-36d6-a417-db145a2ff228",
                                "text": "En dat is precies wat ik voel, sinds ik hier ben: het vuurtje brandt weer."
                            }
                        ]
                    }
