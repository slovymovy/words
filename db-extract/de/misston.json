                "senses": [
                    {
                        "sense_id": "3a0c755b-ed72-3557-a694-bad06d3d47e4",
                        "entry_id": "7be21b6a-01ce-3252-96ae-b9bce5c23eb6",
                        "glosses": [
                            "falscher, unharmonischer, unschöner Klang"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                        "entry_id": "7be21b6a-01ce-3252-96ae-b9bce5c23eb6",
                        "glosses": [
                            "schlechte Stimmung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3dd8ae20-1e93-4e92-b614-2dd021aac198",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„Mit dem Jahr 2011 aber begannen zum ersten Mal Misstöne aus dem Inneren der Gruppe laut zu werden: die drei waren sich nicht mehr einig, wie es weitergehen sollte.“"
                            },
                            {
                                "example_id": "22443c67-bd8d-422b-8900-1a5073580bcd",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„So manche Misstöne, die Bush aus dem Plenum entgegenschlugen, wurden durch seine klaren Worte in ihrer Bedeutung relativiert.“"
                            },
                            {
                                "example_id": "2a2420f1-8978-427d-b99e-5ea0afc2d3cb",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„Die meisten Team-Mitglieder sind bereits am Wochenende angekommen, darunter auch die deutsche Co-Fahnenträgerin Claudia Pechstein. Und die sorgte für Misstöne – denn sie verweigerte der ARD ein Interview.“"
                            },
                            {
                                "example_id": "206f6dd6-941d-4091-8037-90ca20ea4331",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„Obwohl die Bedeutung des Konfuzianismus in Südkorea abgenommen hat, scheinen etliche Männer ihre privilegierte Position in der Gesellschaft nicht aufgeben zu wollen. Das führt inzwischen vermehrt zu Misstönen, mit denen sich einige Autorinnen immer wieder befassen.“"
                            },
                            {
                                "example_id": "c67a1bb2-8b05-4018-af8c-fa4d055144a2",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„Francis ließ sich einen deutschen Text schreiben, und nach einigen Misstönen zwischen Francis selber und den verantwortlichen Managern auf beiden Seiten des Atlantiks“ […] „wurde die deutsche Aufnahme“ […] „schließlich veröffentlicht und avancierte zu Deutschlands erfolgreichster Single des Jahres.“"
                            },
                            {
                                "example_id": "12f11622-9561-4119-a003-d137283b75b4",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„Im Frühjahr kam es unterdessen zu den ersten Misstönen, als Balakow nach einer Niederlagenserie mit einem Abschied im Sommer kokettierte, während parallel herauskam, dass er im Dezember zu weit besseren Konditionen seinen Vertrag verlängert hatte.“"
                            },
                            {
                                "example_id": "c6e605eb-aa2f-424c-94f5-47166a16e2c1",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "[Zusammenarbeit Deutschland – Frankreich:] „Es gab Misstöne über die Jahre in der Rüstungsexportpolitik, in der Sicherheitspolitik, was militärische Auslandseinsätze angeht.“"
                            },
                            {
                                "example_id": "4c39479f-c083-4ab8-ab34-8afcbb982358",
                                "sense_id": "ef68aee5-4ec5-327a-8b6f-cda295c1c07c",
                                "text": "„»Rund um Ihre Wahl gab es Misstöne. Die Parteien haben Sie nicht unterstützt, nach der Wahl wurde Ihr Lohn gekürzt. Spüren Sie diese Misstöne noch?«“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
