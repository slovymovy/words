{
    "word_family": [],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                    "sense_definition": "Not one nor the other of two people or things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "binary_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the end, <w>neither</w> side won the game.",
                            "target_lang_translations": {
                                "ru": "В конце концов, <w>ни одна</w> из сторон не выиграла игру.",
                                "tr": "Sonunda <w>hiçbir</w> taraf oyunu kazanamadı.",
                                "zh": "最终，<w>两</w>方<w>都</w>没赢得比赛。"
                            }
                        },
                        {
                            "text": "<w>Neither</w> answer seems to be correct.",
                            "target_lang_translations": {
                                "ru": "<w>Ни один</w> ответ не кажется правильным.",
                                "tr": "İki cevaptan <w>hiçbiri</w> doğru görünmüyor.",
                                "zh": "<w>两</w>个答案<w>都</w>不正确。"
                            }
                        }
                    ],
                    "antonyms": [
                        "both"
                    ],
                    "common_phrases": [
                        "neither one",
                        "neither side",
                        "neither way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один и ни другой из двух людей или предметов.",
                        "tr": "İki kişi veya şeyden ne biri ne de diğeri.",
                        "zh": "指两者都不。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни оди́н",
                                "target_lang_sense_clarification": "ни один из двух"
                            },
                            {
                                "target_lang_word": "ни тот, ни друго́й",
                                "target_lang_sense_clarification": "отрицание обоих вариантов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hiçbir",
                                "target_lang_sense_clarification": "iki seçenekten hiçbiri"
                            },
                            {
                                "target_lang_word": "ne ... ne de",
                                "target_lang_sense_clarification": "iki şeyi birden reddederken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两……都不",
                                "target_lang_sense_clarification": "用于限定两个名词"
                            },
                            {
                                "target_lang_word": "没有一个",
                                "target_lang_sense_clarification": "强调两者皆非"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                    "sense_definition": "Not one nor the other of two people or things.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "binary_negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have two brothers, but <w>neither</w> lives nearby.",
                            "target_lang_translations": {
                                "ru": "У меня два брата, но <w>ни один</w> не живёт поблизости.",
                                "tr": "İki erkek kardeşim var ama <w>hiçbiri</w> yakında yaşamıyor.",
                                "zh": "我有两个兄弟，但他们<w>都</w>不住在附近。"
                            }
                        },
                        {
                            "text": "<w>Neither</w> of us wants to go out tonight.",
                            "target_lang_translations": {
                                "ru": "<w>Никто</w> из нас не хочет идти гулять сегодня вечером.",
                                "tr": "İkimizden <w>hiçbiri</w> bu akşam dışarı çıkmak istemiyor.",
                                "zh": "我们两个今晚<w>都</w>不想出去。"
                            }
                        }
                    ],
                    "antonyms": [
                        "both"
                    ],
                    "common_phrases": [
                        "neither of them",
                        "neither of us",
                        "neither of which"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один и ни другой из двух людей или предметов.",
                        "tr": "İki kişi veya şeyden ne biri ne de diğeri.",
                        "zh": "指两者中的任何一个都不。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни оди́н",
                                "target_lang_sense_clarification": "ни один из группы"
                            },
                            {
                                "target_lang_word": "никто́",
                                "target_lang_sense_clarification": "ни один человек"
                            },
                            {
                                "target_lang_word": "ничто́",
                                "target_lang_sense_clarification": "ни один предмет"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hiçbiri",
                                "target_lang_sense_clarification": "iki kişiden/şeyden hiçbiri"
                            },
                            {
                                "target_lang_word": "ne biri ne diğeri",
                                "target_lang_sense_clarification": "her ikisi de değil"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "两者都不",
                                "target_lang_sense_clarification": "代词用法"
                            },
                            {
                                "target_lang_word": "谁也不",
                                "target_lang_sense_clarification": "指代人时"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                    "sense_definition": "Similarly not; used to indicate that a negative statement also applies to another person or thing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never been to Paris, and <w>neither</w> has she.",
                            "target_lang_translations": {
                                "ru": "Я никогда не был в Париже, и она <w>тоже не</w> была.",
                                "tr": "Ben Paris'te hiç bulunmadım, o <w>da</w> bulunmadı.",
                                "zh": "我从没去过巴黎，她<w>也</w>没去过。"
                            }
                        },
                        {
                            "text": "\"I don't like spinach.\" — \"<w>Neither</w> do I.\"",
                            "target_lang_translations": {
                                "ru": "«Я не люблю шпинат». — «Я <w>тоже не</w> люблю».",
                                "tr": "\"Ispanak sevmem.\" — \"Ben <w>de</w>.\"",
                                "zh": "“我不喜欢菠菜。”——“我<w>也</w>不喜欢。”"
                            }
                        }
                    ],
                    "common_phrases": [
                        "me neither",
                        "neither do I",
                        "neither can I"
                    ],
                    "target_lang_definitions": {
                        "ru": "Также не; используется для указания, что отрицательное утверждение относится и к другому лицу или предмету.",
                        "tr": "Benzer şekilde değil; olumsuz bir ifadenin başka bir kişi veya şey için de geçerli olduğunu belirtmek için kullanılır.",
                        "zh": "也（不）；用于表示对前述否定陈述的认同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то́же не",
                                "target_lang_sense_clarification": "согласие с отрицанием"
                            },
                            {
                                "target_lang_word": "та́кже не",
                                "target_lang_sense_clarification": "формальное согласие с отрицанием"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "de",
                                "target_lang_sense_clarification": "olumsuz cümlelere katılma anlamında (ben de)"
                            },
                            {
                                "target_lang_word": "da",
                                "target_lang_sense_clarification": "olumsuz katılım gösterirken"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "也不",
                                "target_lang_sense_clarification": "表示否定认同"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                    "sense_definition": "Used before the first of two (or more) alternatives to indicate that none of them is true (used with 'nor').",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Neither</w> the blue dress nor the red one fits me.",
                            "target_lang_translations": {
                                "ru": "<w>Ни</w> синее платье, ни красное мне не подходят.",
                                "tr": "Bana <w>ne</w> mavi elbise ne de kırmızı olanı uyuyor.",
                                "zh": "<w>既</w>不是那件蓝裙子，<w>也</w>不是那件红裙子，都不合身。"
                            }
                        },
                        {
                            "text": "He speaks <w>neither</w> French nor German.",
                            "target_lang_translations": {
                                "ru": "Он не говорит <w>ни</w> по-французски, ни по-немецки.",
                                "tr": "O <w>ne</w> Fransızca ne de Almanca konuşuyor.",
                                "zh": "他<w>既</w>不会说法语，<w>也</w>不会说德语。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "neither ... nor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется перед первым из двух (или более) вариантов для указания, что ни один из них не подходит (используется с 'nor').",
                        "tr": "İki (veya daha fazla) seçenekten hiçbirinin doğru veya geçerli olmadığını belirtmek için ilkinden önce kullanılır ('nor' ile birlikte).",
                        "zh": "用于“既……又不……”结构中，表示两者皆非。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни",
                                "target_lang_sense_clarification": "первая часть союза 'ни... ни...'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ne",
                                "target_lang_sense_clarification": "'ne ... ne de' bağlacının ilk kısmı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "既不……也不……",
                                "target_lang_sense_clarification": "连词结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "646a8ec3-e2d5-309d-89bf-2ffd234c5983",
                    "sense_definition": "Nor; and not.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke not, <w>neither</w> did he move.",
                            "target_lang_translations": {
                                "ru": "Он не говорил, <w>также не</w> двигался.",
                                "tr": "Konuşmadı, <w>ne de</w> hareket etti.",
                                "zh": "他没说话，<w>也</w>没动。"
                            }
                        },
                        {
                            "text": "They toil not, <w>neither</w> do they spin.",
                            "target_lang_translations": {
                                "ru": "Они не трудятся, <w>также не</w> прядут.",
                                "tr": "Çalışmazlar, <w>ne de</w> iplik eğirirler.",
                                "zh": "他们不劳作，<w>也</w>不纺纱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "И не; также не.",
                        "tr": "Ve değil; ne de (eski/edebi kullanım).",
                        "zh": "也不；且不（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "та́кже не",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "и не",
                                "target_lang_sense_clarification": "соединительный союз"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ne de",
                                "target_lang_sense_clarification": "ve de ... değil"
                            },
                            {
                                "target_lang_word": "ne",
                                "target_lang_sense_clarification": "olumsuz bağlaç"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "也不",
                                "target_lang_sense_clarification": "书面语或古语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}