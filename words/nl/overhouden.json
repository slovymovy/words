            "senses": [
                {
                    "sense_id": "f4b1de94-8180-3262-93ed-249c96e0b581",
                    "sense_definition": "nog hebben nadat al het nodige is verdeeld of gebruikt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>hield</w> nog één plank <w>over</w> nadat hij de kast in elkaar had gezet.",
                            "target_lang_translations": {
                                "en": "He <w>had</w> one plank <w>left</w> after he had put the cupboard together."
                            }
                        },
                        {
                            "text": "Als we zuinig zijn, kunnen we aan het eind van de maand wat geld <w>overhouden</w>.",
                            "target_lang_translations": {
                                "en": "If we are frugal, we can <w>save</w> some money at the end of the month."
                            }
                        }
                    ],
                    "synonyms": [
