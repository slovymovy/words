                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The doctrine of the oneness and unity of reality, despite the appearance of diversity in the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cb5e25c-7da8-365d-8d7c-2b2bfdb0bfef",
                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The doctrine that there is a single source of political authority, especially that the church is subordinate to the state or vice versa."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b271ee-08aa-429d-8e91-f08e6afc4bbb",
                                                "sense_id": "2cb5e25c-7da8-365d-8d7c-2b2bfdb0bfef",
                                                "text": "The same conflict between the monism of temporal theorists and the dualism of ecclesiastical thinkers—the same opposition of organic to symbiotic union—occurred in the ninth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3ea4e9a-e57a-3689-b9a0-510ae2977ee6",
                                        "entry_id": "f4bb75d6-28ec-3ca2-8af2-e125e323c631",
                                        "glosses": [
                                            "The legal doctrine that international law forms part of domestic law automatically after ratification or accession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
