    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32cbcc0a-ccaf-3381-badb-43a599cbb8a8",
                    "sense_definition": "The activity of visiting famous or interesting places as a tourist.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tourism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the entire afternoon <w>sightseeing</w> in the historic center of the city.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, <w>осматривая достопримечательности</w> в историческом центре города."
                            }
                        },
                        {
                            "text": "Many people enjoy <w>sightseeing</w> tours because they cover all the major landmarks quickly.",
                            "target_lang_translations": {
                                "ru": "Многим нравятся <w>экскурсионные</w> туры, потому что они позволяют быстро увидеть все основные достопримечательности."
                            }
                        }
                    ],
                    "synonyms": [
                        "tourism",
                        "touring"
                    ],
                    "common_phrases": [
                        "go sightseeing",
                        "sightseeing tour",
                        "sightseeing bus",
                        "day of sightseeing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по посещению известных или интересных мест в качестве туриста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотр достопримечательностей",
                                "target_lang_sense_clarification": "процесс посещения интересных мест"
                            },
                            {
                                "target_lang_word": "экскурсии",
                                "target_lang_sense_clarification": "посещение достопримечательностей с целью ознакомления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4663ad2-ac77-340f-b4e8-89fd507bdf35",
                    "sense_definition": "The present participle and gerund of <w>sightsee</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tourism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>sightseeing</w> in London this week before heading to Paris.",
                            "target_lang_translations": {
                                "ru": "На этой неделе они <w>осматривают достопримечательности</w> в Лондоне, прежде чем отправиться в Париж."
                            }
                        },
                        {
                            "text": "After <w>sightseeing</w> all day, we were too tired to go out for dinner.",
                            "target_lang_translations": {
                                "ru": "После целого дня <w>осмотра достопримечательностей</w> мы слишком устали, чтобы идти куда-то ужинать."
                            }
                        }
                    ],
