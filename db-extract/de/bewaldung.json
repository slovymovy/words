                ],
                "senses": [
                    {
                        "sense_id": "2124a89b-89b4-3db9-9e8e-9c5543a515f4",
                        "entry_id": "3a5416fa-40e0-3cad-bf72-c3256430bd87",
                        "glosses": [
                            "von Wald bedeckte Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5075fd56-4dc2-4614-a792-428c3ca84bbf",
                                "sense_id": "2124a89b-89b4-3db9-9e8e-9c5543a515f4",
                                "text": "„Einen Beweis dafür, daß die Bewaldung keinen wesentlichen Einfluß auf die Quellen ausübe, liefern indessen diese Messungsergebnisse nicht.“"
                            },
                            {
                                "example_id": "6f9caa97-2f7d-4540-a218-d28c9d506003",
                                "sense_id": "2124a89b-89b4-3db9-9e8e-9c5543a515f4",
                                "text": "„Der Wasserstand der Gewässer des Hügellandes steht mittelbar allerdings in Beziehungen zur Bewaldung des Hochgebirges, zunächst aber denn doch zu derjenigen des Hügellandes selbst.“"
                            },
                            {
                                "example_id": "2eb60267-d055-41ad-9b81-ca098760f6ba",
                                "sense_id": "2124a89b-89b4-3db9-9e8e-9c5543a515f4",
                                "text": "„Dichtere Bewaldungen oder hohe Baumgruppen gab es nicht. Alles wuchs mehr strauchartig, hier und da gesäumt von niedrigen Akazien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "68aa077e-45d0-3242-a575-786cd37f2640",
                        "entry_id": "3a5416fa-40e0-3cad-bf72-c3256430bd87",
                        "glosses": [
                            "Anpflanzung von Bäumen in größerem Umfang, auf größerer Fläche, damit neuer Wald nachwächst"
                        ],
                        "tags": [
                            "Waldwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d415c405-4b3e-402f-8323-7062ec4fb651",
                                "sense_id": "68aa077e-45d0-3242-a575-786cd37f2640",
                                "text": "„Die Erweiterung des Naturreservats hat die Verhinderung einer weiteren Verbuschung und Bewaldung des Gebiets zum Ziel.“"
                            },
                            {
                                "example_id": "310eb99e-d179-4b21-a394-0f82d3556c3b",
                                "sense_id": "68aa077e-45d0-3242-a575-786cd37f2640",
                                "text": "„Um sowohl eine Verbesserung des Bodens herbeizuführen, als auch die gefährlichen klimatischeu Einflüsse auf die Dauer zu beseitigen, ist die Bewaldung des Venns unbedingt erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
