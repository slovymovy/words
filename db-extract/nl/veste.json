                        "translation_id": "3ad208dd-46a3-408f-b560-ae806aed2303",
                        "source_entry_id": "b350dbe6-10e9-3374-9458-19a98defc57d",
                        "source_sense_id": "25727ac2-624e-34d6-9043-c79f241ece71",
                        "source_sense_description": "een met muren beschermde plaats; de muren van een vesting",
                        "target_lang_word": "fortification canal",
