                        ],
                        "examples": [
                            {
                                "example_id": "f0255350-d58d-4886-acaa-a1c0a7009a2a",
                                "sense_id": "69b6a23d-d3f3-3a7c-93cb-ecf073119430",
                                "text": "GCs prove everyday they're actually just critical of trans people, not critical of gender"
                            },
                            {
                                "example_id": "d769cf6a-5387-4b5a-931c-1c4cfabbcc69",
                                "sense_id": "69b6a23d-d3f3-3a7c-93cb-ecf073119430",
                                "text": "That’s LITERALLY what trans activists say and what GCs are fighting against."
                            },
                            {
                                "example_id": "560b7871-f985-4ec2-99c6-d2ef9558285a",
                                "sense_id": "69b6a23d-d3f3-3a7c-93cb-ecf073119430",
                                "text": "When I pointed out the other day that prominent GCs had been pretty silent on #RoeVsWade or had tried deflecting onto trans people, I had this response from a GC."
                            }
                        ]
                    },
                    {
                        "sense_id": "210b0028-b1b5-3067-b92d-a64246d77a65",
                        "entry_id": "896e903f-a036-30e7-ba7b-f9115c0cf632",
                        "glosses": [
                            "Abbreviation of gonococcus; gonorrhea."
                        ],
                        "tags": [
