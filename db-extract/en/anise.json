                                                "example_id": "5a5087ef-7144-470c-9f2c-b069361cfe55",
                                                "sense_id": "cf7405f2-bebb-3bc5-813d-20752ea180ab",
                                                "text": "Anis stammt ursprünglich aus dem Mittelmeerraum."
                                            },
                                            {
                                                "example_id": "322badc1-8ca5-4f0f-b319-53ea6bd8cc66",
                                                "sense_id": "cf7405f2-bebb-3bc5-813d-20752ea180ab",
                                                "text": "„Gegen Blähungen helfen zum Beispiel Fenchel oder Anis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27383dac-33a9-3fb8-a049-72789f01a75d",
                                        "entry_id": "3d3136c9-67b1-34ee-85bf-1cefbe0aea23",
                                        "glosses": [
                                            "Frucht der Pflanze,^([1]) die als Gewürz verwendet wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b3220d-d58f-49d3-a388-701f16bad329",
                                                "sense_id": "27383dac-33a9-3fb8-a049-72789f01a75d",
                                                "text": "Vor allem in der Weihnachtsbäckerei spielt Anis eine große Rolle."
                                            },
                                            {
                                                "example_id": "27f08648-29fb-4453-9ca3-73d3b0acd9bc",
                                                "sense_id": "27383dac-33a9-3fb8-a049-72789f01a75d",
                                                "text": "„Man brachte uns einen Tee, der nicht übel nach Anis schmeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
