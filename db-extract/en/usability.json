                                        "entry_id": "75e8902e-c435-36b3-97db-98db5ebb77d4",
                                        "glosses": [
                                            "Qualité de ce qui est convivial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028145f9-a456-461f-94a7-c4f35b3f4d70",
                                                "sense_id": "b22622d1-819d-3c0d-ab01-94e9e1ab51dc",
                                                "text": "Kousseila participe aux marches nocturnes pour leur convivialité."
                                            },
                                            {
                                                "example_id": "35bb7266-5dea-4f44-99a2-d8d63ff659f3",
                                                "sense_id": "b22622d1-819d-3c0d-ab01-94e9e1ab51dc",
                                                "text": "Le football étant une pratique sportive qui mêle à la fois technicité et convivialité, le but d’Adidas est de jouer sur les deux tableaux, afin de promouvoir sa nouvelle offre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c14196-5a86-3f94-a93d-0020a19af233",
                                        "entry_id": "75e8902e-c435-36b3-97db-98db5ebb77d4",
                                        "glosses": [
                                            "Qualité de ce qui est au service de l'être humain, adapté à la nature humaine, à dimension humaine, en particulier un outil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dddaf9d-e021-44e6-b3c5-c4890e7bf2a5",
                                                "sense_id": "03c14196-5a86-3f94-a93d-0020a19af233",
                                                "text": "Le dogme de la croissance accélérée justifie la sacralisation de la productivité industrielle, aux dépens de la convivialité"
                                            },
                                            {
                                                "example_id": "15437096-6a01-4180-9492-b73b02d5c8a7",
                                                "sense_id": "03c14196-5a86-3f94-a93d-0020a19af233",
                                                "text": "La notion de convivialité reste au centre du débat écologique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "251ace29-0e62-3ada-b711-885914577a50",
                                        "entry_id": "75e8902e-c435-36b3-97db-98db5ebb77d4",
                                        "glosses": [
                                            "Qualité de l'interface utilisateur d’un outil informatique dont l'usage est aisé et plaisant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
