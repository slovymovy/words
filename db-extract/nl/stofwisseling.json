                "translations": [
                    {
                        "translation_id": "f47c817e-12bf-42cd-84af-22f375148be0",
                        "source_entry_id": "e123319f-46dc-3918-b7d3-1fceb84203cd",
                        "source_sense_id": "26ac1ad2-5982-3006-997c-a4edf79d7abe",
