                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93b2b42-e778-47e0-99b1-d332ec0b41f9",
                                "sense_id": "de6b9ec9-5faa-3e9c-9269-6c5e57dbe970",
                                "text": "„Den Rucksack hatte mir Claude zum Collegeabschluss geschenkt.“"
                            },
                            {
                                "example_id": "e8c19750-baed-43ba-b838-6816d7c18c85",
                                "sense_id": "de6b9ec9-5faa-3e9c-9269-6c5e57dbe970",
                                "text": "„Ich denke: Diese Offiziere fliegen nach Vietnam und lassen sich abschießen, und ich trage ihren koketten Frauen Stühle und Handtücher hinterher, bringe ihren Kindern das Schwimmen bei, und sie geben mir noch Geld dafür, dass ich meinen Collegeabschluss mache?“"
                            },
                            {
                                "example_id": "70e8a3fe-d70b-4a9f-8bd9-a29aa59fd2e2",
                                "sense_id": "de6b9ec9-5faa-3e9c-9269-6c5e57dbe970",
                                "text": "„Unsere umfassende Ausbildung, all unsere Intelligenz, unsere Collegeabschlüsse, unser intellektuelles Niveau und unsere stete Suche nach Wissen und Weisheit haben uns letzten Endes doch nur hierher geführt.“"
                            },
                            {
                                "example_id": "753ca4cb-f96c-4dd6-a4c1-6a0b46828dd8",
                                "sense_id": "de6b9ec9-5faa-3e9c-9269-6c5e57dbe970",
                                "text": "„2008, kurz nach ihrem Collegeabschluss, war Cindy zur Army gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
