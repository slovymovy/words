                ],
                "senses": [
                    {
                        "sense_id": "f073e67d-d807-3e37-ad8e-71e0f5201407",
                        "entry_id": "89ee8ff7-cbf3-36ff-a57e-237ec4293a50",
                        "glosses": [
                            "eine 1903 von dem Mathematiker Giuseppe Peano auf der Grundlage des Lateinischen geschaffene Welthilfssprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb29b493-2cd9-40a5-b97b-001ff999a0c5",
                                "sense_id": "f073e67d-d807-3e37-ad8e-71e0f5201407",
                                "text": "„In diesem Sinne hat der italienische Mathematiker G. Peano (seit 1903) das Lateinische umgestaltet, um es als internationale Verkehrssprache brauchbar zu machen…Auf diese Weise wird erreicht, daß einem beim Lernen dieser Sprache, die ihr Erfinder erst »Latino sine flexione« und später Interlingua nannte, die meisten Wörter schon bekannt und also leicht zu merken sind…“"
                            },
                            {
                                "example_id": "02a14c9a-27f3-449e-a678-1e03718a32a0",
                                "sense_id": "f073e67d-d807-3e37-ad8e-71e0f5201407",
                                "text": "„Der kennzeichnender ursprüngliche Name ‚Latino sine flexione‘ wurde später durch Interlingua ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20bbf731-01a9-3c04-a5bc-d2981c63ef17",
                        "entry_id": "89ee8ff7-cbf3-36ff-a57e-237ec4293a50",
                        "glosses": [
                            "eine 1951 von Alexander Gode geschaffene Plansprache als vereinfachte Version des Latein, deren Grammatik und Wortschatz vollständig aus Englisch, Französisch, Italienisch, Spanisch und Portugiesisch entstammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc8e6c0b-7732-4e5b-96a6-54721c2e6055",
                                "sense_id": "20bbf731-01a9-3c04-a5bc-d2981c63ef17",
                                "text": "„Es gibt noch ein System, das ebenfalls den Namen Interlingua führt."
                            },
                            {
                                "example_id": "161f504d-901b-4a25-93ec-75ac7d97864a",
                                "sense_id": "20bbf731-01a9-3c04-a5bc-d2981c63ef17",
                                "text": "Interlingua ist nicht mit Interlingue zu verwechseln."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "27af3531-6dd5-32bd-8414-5fb7a059849d",
                        "entry_id": "89ee8ff7-cbf3-36ff-a57e-237ec4293a50",
                        "glosses": [
                            "eine Sprachform, die eine Zwischenstufe vor dem vollständigen Erwerb einer Sprache ist (nach: Helmut Glück)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2987c509-1851-456f-a4a7-234f84cb16e6",
                                "sense_id": "27af3531-6dd5-32bd-8414-5fb7a059849d",
                                "text": "In der Fremdsprachenforschung und in der Spracherwerbsforschung ist Interlingua (= Interimsprache) die Bezeichnung für die Zwischenstadien, die der Lerner beim Erwerb der Zielsprache durchläuft."
                            },
                            {
                                "example_id": "50526d02-9e37-4f04-8f4c-bc9fb847a3bd",
                                "sense_id": "27af3531-6dd5-32bd-8414-5fb7a059849d",
                                "text": "„Andere vergleichbare Konzepte unter verschiedenen Namen für diesen Begriff sind z. B. Interlingua, Interimsprache, Interlanguage und Übergangssprache (…).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
