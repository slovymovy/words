                    {
                        "sense_id": "03169aba-b7bd-3cb4-a3ad-9b755c155d57",
                        "entry_id": "a105a8ea-8985-3a99-8173-a5bffa9ed8e0",
                        "glosses": [
                            "die Vorderseite einer Münze, Medaille oder Ähnlichem"
                        ],
                        "tags": [
                            "Numismatik"
                        ],
                        "examples": [
                            {
                                "example_id": "50f388a0-aaf2-421b-9e26-7f5a8825263a",
                                "sense_id": "03169aba-b7bd-3cb4-a3ad-9b755c155d57",
                                "text": "„In der Numismatik wird unter dem Begriff Avers immer die Vorderseite einer Münze verstanden. Darüber aber, welche Seite einer Münze Vorderseite und welche Rückseite ist, bestehen unterschiedliche Auffassungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74b6c6d8-0e7d-4752-a84a-f561fef9c718",
                        "source_entry_id": "a105a8ea-8985-3a99-8173-a5bffa9ed8e0",
                        "source_sense_id": "03169aba-b7bd-3cb4-a3ad-9b755c155d57",
