                        "examples": [
                            {
                                "example_id": "569db875-4f5e-45de-8ef7-42d38a4760d8",
                                "sense_id": "e829143b-ec48-3e6e-9ccf-884de1bfdc54",
                                "text": "“Knowest thou,” said the Jester, “my good friend Gurth, that thou art strangely courteous and most unwontedly pious on this summer morning? […]”"
                            },
                            {
                                "example_id": "7a5996a0-7423-424e-8ba9-2ea33f27a8b3",
                                "sense_id": "e829143b-ec48-3e6e-9ccf-884de1bfdc54",
                                "text": "Yes. I remember Adlestrop—\nThe name, because one afternoon\nOf heat the express-train drew up there\nUnwontedly. It was late June."
                            }
                        ]
                    }
