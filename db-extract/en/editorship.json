                                                "sense_id": "0b833ae8-8ee0-3d54-b126-3ec77f907b63",
                                                "text": "Редакция уважает мнение авторов, но не всегда разделяет его."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5454283b-2d65-3c2c-ab67-990ff5b543cd",
