                ],
                "senses": [
                    {
                        "sense_id": "795e80bb-37f6-30d2-8f08-c8ce34e01996",
                        "entry_id": "a6009bbb-9577-3d4b-9333-0e945702ab65",
                        "glosses": [
                            "Fruchtbarkeitsgott der ägyptischen Religion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9361b60-f7e9-4f9a-821e-1df9d9f20411",
                                "sense_id": "795e80bb-37f6-30d2-8f08-c8ce34e01996",
                                "text": "Der Hoherpriester des Amun […] war ein wichtiges religiöses Amt im Alten Ägypten."
                            },
                            {
                                "example_id": "644ac953-d401-427f-8a86-08a83ce9b36b",
                                "sense_id": "795e80bb-37f6-30d2-8f08-c8ce34e01996",
                                "text": "„So gilt der Widder als Symboltier des Amun, und zu den großen Amun-Tempeln von Karnak und Luxor führen heute zum Teil noch gut erhaltene steinerne Alleen von widdergestaltigen Sphingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ce506d0-fec5-4c89-b5a6-25866bcd60de",
                        "source_entry_id": "a6009bbb-9577-3d4b-9333-0e945702ab65",
                        "source_sense_id": "795e80bb-37f6-30d2-8f08-c8ce34e01996",
                        "source_sense_description": "Mythologie: Fruchtbarkeitsgott der ägyptischen Religion",
                        "target_lang_word": "Amun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1997b66-e5b0-3a2b-a23a-d1d69a441056",
                                        "entry_id": "767d1529-df20-384e-9932-a5864e2ad0a0",
                                        "glosses": [
                                            "An Egyptian wind deity associated with the town of Thebes; later (post-16th century BCE) the creator deity, often depicted with curling ram horns."
                                        ],
                                        "tags": [
                                            "Egyptian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca656c21-ca10-4273-be61-00bf37dc8e12",
                                                "sense_id": "c1997b66-e5b0-3a2b-a23a-d1d69a441056",
                                                "text": "The hornèd patriarch of the sheep,\n Like Egypt's Amun roused from sleep,\n Shook his sage head with gesture mute,\n And emphasized with stamp of foot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec526ee8-4611-4612-9448-facd3cb877ea",
                        "source_entry_id": "a6009bbb-9577-3d4b-9333-0e945702ab65",
                        "source_sense_id": "795e80bb-37f6-30d2-8f08-c8ce34e01996",
                        "source_sense_description": "Mythologie: Fruchtbarkeitsgott der ägyptischen Religion",
                        "target_lang_word": "Amon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                        "entry_id": "ca2919a2-d393-3610-aae7-b4a2da90bd8a",
                                        "glosses": [
                                            "Dieu roi de la mythologie égyptienne."
                                        ],
                                        "tags": [
                                            "Mythologie égyptienne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51e576e-3211-4379-8932-caae381d7985",
                                                "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                                "text": "Dix prêtres, du Nil clair suivant la haute berge,\nD’un pas égal, le front incliné vers le sol,\nPortent la barque peinte où, sous un parasol,\nSiège le fils d’Amon, Khons, le Dieu calme et vierge."
                                            },
                                            {
                                                "example_id": "422d35d2-47a3-4ab3-95ca-1fd82bb43ffb",
                                                "sense_id": "d667d86a-59a4-36ec-af92-040f2cefa673",
                                                "text": "Il a été commandé par Ahmosis, le roi de Thèbes, pour le temple du dieu Amon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
