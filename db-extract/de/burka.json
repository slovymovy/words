                            {
                                "example_id": "4b1ea5dc-49d6-4ced-99cf-0c5bba519dcd",
                                "sense_id": "2dd0be80-b0db-3953-b721-5e3ef58988c0",
                                "text": "In einigen europäischen Ländern ist das Tragen der Burka in der Öffentlichkeit verboten.",
                                "translation": "Dans certains pays européens, le port de la burqa est interdit en public."
                            },
                            {
                                "example_id": "5e499bab-be17-4114-8609-f5db138ab1f8",
                                "sense_id": "2dd0be80-b0db-3953-b721-5e3ef58988c0",
                                "text": "Die pakistanische Burka bezeichnet ein anderes Kleidungsstück, das nicht mit der afghanischen Burka verwechselt werden darf.",
                                "translation": "La burqa pakistanais désigne un autre vêtement qui ne peut être pas confondue avec la burqa afghane."
                            }
                        ]
                    }
