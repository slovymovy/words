                                    {
                                        "sense_id": "77302e3a-df76-3f5f-9985-cd0e230352d0",
                                        "entry_id": "1d9634f3-1340-3b28-85de-37b102d111d9",
                                        "glosses": [
                                            "Lerntechnik zur aktiven Aneignung einer bestimmten Fertigkeit, das praktische Üben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd45683-4d76-4108-a07c-a147a4dc2232",
                                                "sense_id": "77302e3a-df76-3f5f-9985-cd0e230352d0",
                                                "text": "Die Übungen in Turnen entspannen sehr."
                                            },
                                            {
                                                "example_id": "60ae2b80-d449-49fb-8dc1-5d1da6019ee6",
                                                "sense_id": "77302e3a-df76-3f5f-9985-cd0e230352d0",
                                                "text": "Mit etwas mehr Übung klappt das bestimmt hervorragend!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8277aa51-0d7d-36e5-88e4-28cc5bc563c4",
                                        "entry_id": "1d9634f3-1340-3b28-85de-37b102d111d9",
                                        "glosses": [
                                            "Anschauungsmaterial, Text oder Aufgabe zum Trainieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4969e657-95fd-48ac-bacd-ef6898cc07e8",
                                                "sense_id": "8277aa51-0d7d-36e5-88e4-28cc5bc563c4",
                                                "text": "Übung Nummer 5 war richtig schwer!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c14ee794-7cee-3ba4-8274-46ff3b0c6c57",
                                        "entry_id": "1d9634f3-1340-3b28-85de-37b102d111d9",
                                        "glosses": [
                                            "das übliche Vorgehen in einem bestimmten Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90027b8d-3a52-4feb-a408-2d70d0a0c06d",
                                                "sense_id": "c14ee794-7cee-3ba4-8274-46ff3b0c6c57",
                                                "text": "„Arbeitgeberleistungen auf Grund betrieblicher Übung sind z.B. die betriebliche Altersversorgung, Gratifikationen, die Nichtanrechnung von Tariflohnerhöhungen auf Zulagen, die Anwendung eines Tarifvertrages auf Nichtgewerkschaftsmitglieder, die Zahlung einer Heimzulage trotz Fehlens der tariflichen Voraussetzungen, Brauchtumstage wie Wäldchestag oder bezahlte Freizeit an Rosenmontag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b6ab75f5-3e32-3e9d-bb8d-b6f16a5f4f66",
                                        "entry_id": "1d9634f3-1340-3b28-85de-37b102d111d9",
                                        "glosses": [
                                            "Lehrveranstaltung, in der die Anwendung theoretischer Kenntnisse auf praxisnahe und spezifische Problemstellungen erfolgt"
                                        ],
                                        "tags": [
                                            "Hochschule"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b83e2e3-43d0-42d5-a6cb-f6957a8bd4bb",
                                                "sense_id": "b6ab75f5-3e32-3e9d-bb8d-b6f16a5f4f66",
                                                "text": "Meist wird eine akademische Übung im Unterschied zum Tutorium von einem Professor oder einem Mitarbeiter eines Lehrstuhls abgehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
