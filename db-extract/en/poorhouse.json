                "translations": [
                    {
                        "translation_id": "e7928738-310a-4111-9f8e-f405f6d71245",
                        "source_entry_id": "c1a1c8af-856e-3368-bad9-5f11efed12ff",
                        "source_sense_description": "charitable institution where poor or homeless people are lodged",
                        "target_lang_word": "armenhuis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armenhuis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c569fddc-454b-3b42-8c3b-a9708ae4b0d4",
                                        "entry_id": "9e872503-6f6f-35f8-a151-d1d1d017947d",
                                        "glosses": [
                                            "een tehuis voor een aantal minvermogende mensen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd532905-ad80-4479-8a10-4c0a508add67",
                                                "sense_id": "c569fddc-454b-3b42-8c3b-a9708ae4b0d4",
                                                "text": "Naast de villa staat een studio, waarin het vooral om zijn filmleven draait. Ook hier in wassen beelden uitgevoerde scènes en droevige taferelen van zijn armoedige jeugd in de sloppen van Londen. Tikkie Efteling meets Oliver Twist. Maar de realiteit was ook sneu. Chaplins vader was alcoholist, zijn moeder stuurde hem naar het armenhuis en stierf uiteindelijk in een gekkenhuis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd793f60-c6a1-473b-9d39-2b325b4db362",
                        "source_entry_id": "c1a1c8af-856e-3368-bad9-5f11efed12ff",
                        "source_sense_description": "charitable institution where poor or homeless people are lodged",
                        "target_lang_word": "hospice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1296e2c-ee53-389b-a49e-8912627c031e",
                                        "entry_id": "1e3eee68-472a-316e-8fb7-2b26d6023fa9",
                                        "glosses": [
                                            "Établissement public ou privé où l’on reçoit et entretient, soit gratuitement, soit pour une rétribution peu élevée, des enfants, des infirmes ou des vieillards hors d’état de subvenir à leurs propres besoins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad26d7fd-a8ec-4d50-b188-89cd0c36bd54",
                                                "sense_id": "c1296e2c-ee53-389b-a49e-8912627c031e",
                                                "text": "Il y avait au village deux enfants qu’on appelait « les enfants de l’hospice » ; ils avaient une plaque de plomb au cou avec un numéro ; ils étaient mal habillés et sales ; on se moquait d’eux ; on les battait ; les autres enfants les poursuivaient souvent comme on poursuit un chien perdu pour s’amuser, et aussi parce qu’un chien perdu n’a personne pour le défendre.\nAh ! je ne voulais pas être comme ces enfants ; je ne voulais pas avoir un numéro au cou, je ne voulais pas qu’on courût après moi en criant : « À l’hospice ! à l’hospice ! »"
                                            },
                                            {
                                                "example_id": "269f1fcc-b758-4293-a3e9-5f26465241af",
                                                "sense_id": "c1296e2c-ee53-389b-a49e-8912627c031e",
                                                "text": "Je ne puis voir un pauvre sans lui donner ma bourse. J’ai doté des orphelines, établi des jeunes gens méritants, nourri des vieillards, fondé des hospices."
                                            },
                                            {
                                                "example_id": "39b9b736-41c1-4a30-8586-9ce55c564180",
                                                "sense_id": "c1296e2c-ee53-389b-a49e-8912627c031e",
                                                "text": "Hospice de la vieillesse, des incurables, des enfants trouvés, des aliénés, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31769afa-e088-3be8-a385-e5e9d4a43d42",
                                        "entry_id": "1e3eee68-472a-316e-8fb7-2b26d6023fa9",
                                        "glosses": [
                                            "Ce type d'établissement pour les vieillards."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7117fe90-ac81-3b1f-bcc7-184c7ac662ad",
                                        "entry_id": "1e3eee68-472a-316e-8fb7-2b26d6023fa9",
                                        "glosses": [
                                            "Maison où des religieux donnent l’hospitalité aux pèlerins, aux voyageurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d1afed-da41-421a-81b0-c4028cfb022c",
                                                "sense_id": "7117fe90-ac81-3b1f-bcc7-184c7ac662ad",
                                                "text": "L’hospice du mont Saint-Bernard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99575798-140c-4367-81b1-471c6e5e4914",
                        "source_entry_id": "c1a1c8af-856e-3368-bad9-5f11efed12ff",
                        "source_sense_description": "charitable institution where poor or homeless people are lodged",
                        "target_lang_word": "Armenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                        "entry_id": "4f36232e-59e0-3cae-b44d-611c08f51fbc",
                                        "glosses": [
                                            "Unterkunft für Bedürftige"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4672b78b-e85f-4c42-9974-9da2cb51f8c5",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "Sie brachten die Familie im Armenhaus unter."
                                            },
                                            {
                                                "example_id": "7eeaf40f-0fce-4378-af8e-4e4f5b1bf4d4",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "„So als habe man sie gerade aus dem Kittchen oder dem Armenhaus entlassen.“"
                                            },
                                            {
                                                "example_id": "8340ff37-e88f-41cc-876a-52520c20604b",
                                                "sense_id": "32412dc8-206b-39ec-821f-afd3419ef757",
                                                "text": "„Nur an seinem Ende, beim Armenhause und der Irrenanstalt standen einige kleine Gruppen in weissen Kitteln herum, und einige ebenso gekleidete Leute gingen über das Feld, schrien und fuchtelten mit den Armen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                        "entry_id": "4f36232e-59e0-3cae-b44d-611c08f51fbc",
                                        "glosses": [
                                            "Gebiet eines Landes/Kontinents/einer Region, das/die sich wirtschaftlich unterdurchschnittlich entwickelt (beispielsweise könnte es ein geringes Wachstum/BIP haben)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932d31a0-750a-4676-8e48-7a180d46ae99",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Trotzdem bleibt Süditalien lange Zeit das Armenhaus des Landes, und viele wandern nach Amerika aus.“"
                                            },
                                            {
                                                "example_id": "0c8c0b1d-0cda-4e3d-8b93-cd53c1624435",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Kaum eine Gegend in Europa hat in den vergangenen Jahrzehnten einen derartigen Aufstieg erlebt wie Südtirol - vom einstigen Armenhaus zur prosperierenden Region.“"
                                            },
                                            {
                                                "example_id": "30827b7b-b4ff-4916-8e5f-52398176038c",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "[Schlagzeile:] „Vietnam: Vom Armenhaus zum Wirtschaftswunder“"
                                            },
                                            {
                                                "example_id": "c02a5298-ed69-4b7f-b163-7644de9b3465",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Haiti ist ein Armenhaus.“"
                                            },
                                            {
                                                "example_id": "f8e6f6c2-47b2-4830-b176-51a413e2c2cd",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "Wenig Industrie, schlechte Böden: Der Landesteil [Anmerkung: Wales] mit seinen etwa drei Millionen Einwohnern wird auch Armenhaus des Vereinigten Königreichs genannt […]."
                                            },
                                            {
                                                "example_id": "2db11e1e-dce5-4438-8fc3-b2aea72da007",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„In Libyen droht der Staatszerfall, im Jemen, dem arabischen Armenhaus, sprechen die Vereinten Nationen heute von der größten humanitären Katastrophe der Welt.“"
                                            },
                                            {
                                                "example_id": "dfa496fe-eba5-4787-858c-7b579106db56",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Das von Maduro mit harter Hand regierte Venezuela hat zwar die größten Ölreserven der Welt, ist aber zum Armenhaus Südamerikas mutiert.“"
                                            },
                                            {
                                                "example_id": "2cd924b8-a936-41d3-8c0b-08d5bb833772",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "[Simbabwe und sein Ex-Staatschef Robert Mugabe:] „Unter seiner Führung war aus der einstigen Kornkammer der Region ein Armenhaus geworden.“"
                                            },
                                            {
                                                "example_id": "ac959c13-1de6-4353-8f7e-5864ac8a9a42",
                                                "sense_id": "24c7c21d-367d-3de1-8a82-efc0d1535443",
                                                "text": "„Früher galt Puerto Rico als Juwel der Karibik, als Sehnsuchtsort. Diese Zeiten sind vorbei. Heute ist die Insel ein Armenhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
