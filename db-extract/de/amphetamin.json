                                        "entry_id": "e70d4f10-01e8-3b97-bede-43fb8eda2e09",
                                        "glosses": [
                                            "Amphétamine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132953f8-316d-4e0f-b142-a7bcb1f6f642",
                                                "sense_id": "da34372a-2f6a-3e3c-b0c6-d2293bb9c6a0",
                                                "text": "Le khat une amphé déguisée en salade ; des records de saisie, pour ce psychotrope traditionnel des tropiques arabo-africains."
                                            },
                                            {
                                                "example_id": "3fe2e875-72cb-4aa4-ada0-1ea748e46475",
                                                "sense_id": "da34372a-2f6a-3e3c-b0c6-d2293bb9c6a0",
                                                "text": "En descente d’amphé."
                                            },
                                            {
                                                "example_id": "03b00f9f-607b-466f-be19-39ee51e17352",
                                                "sense_id": "da34372a-2f6a-3e3c-b0c6-d2293bb9c6a0",
                                                "text": "En 1993, c’était pareil, je n'ai pas touché à une amphé, je crois que j’en ai même pas touché de l’année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9542fcb-dbe7-4c84-85d2-961a807e0226",
                        "source_entry_id": "66b18fd3-1b6a-3b1b-b9ff-dda1e7430fd1",
                        "source_sense_id": "348265e2-1814-345e-899a-588289797d09",
