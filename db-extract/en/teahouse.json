                                "target_senses": [
                                    {
                                        "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                        "entry_id": "1fc68e72-7917-33db-a05a-e0b7d7e6444f",
                                        "glosses": [
                                            "Raum, in dem Tee serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e94be37-c25e-49ba-b53b-e86eb44f56c0",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "In der Teestube gab es nicht nur Tee, sondern auch Kekse."
                                            },
                                            {
                                                "example_id": "6d081ef7-df0f-4a13-ba06-fa688c2c379e",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "Sie trafen sich jeden Mittwoch zum Kartenspielen und Reden in der Teestube."
                                            },
                                            {
                                                "example_id": "8680e822-cca4-4239-9b91-cf12aee5b9cf",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "Teestuben haben im türkischen Kulturkreise die Bedeutung des europäischen Cafés."
                                            },
                                            {
                                                "example_id": "555a3ee3-5da3-4bd0-8223-566709fe3af1",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Val sah, wie die Touristen im Innern der Teestube sie anstarrten.“"
                                            },
                                            {
                                                "example_id": "55d18e87-94d1-4355-9e62-d0ac735d4c49",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Es war Zeit für eine Pause und ich steuerte mein beladenes Rad durch das Gewirr an Menschen und Autos zu einer Teestube.“"
                                            },
                                            {
                                                "example_id": "4d833475-f4b9-4d8d-8eec-16c1e43ec98f",
                                                "sense_id": "8bb53578-612f-3145-8765-ce34470f4c2d",
                                                "text": "„Er verabschiedete sich darauf von ihr und verließ die Teestube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
