                    {
                        "sense_id": "39bdafe7-f04f-3268-a663-2cc7c309abe6",
                        "entry_id": "0d3b7a37-d322-3a53-8293-3535f3fd3fd5",
                        "glosses": [
                            "Lack of esteem; disrespect."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7fe1dede-aed2-437a-a776-216a41ea6eae",
                                "sense_id": "39bdafe7-f04f-3268-a663-2cc7c309abe6",
                                "text": "The daily sight of this my sovereign's sweet humility, and his detachment from earthly things, works in me a contagious misesteem for this brief life […]"
                            },
                            {
                                "example_id": "05031723-0dc6-4178-9386-4cdd5f39afb6",
                                "sense_id": "39bdafe7-f04f-3268-a663-2cc7c309abe6",
                                "text": "Not but that his Lordship, what with his own wide reading of the ancients, his soldier's life, and therefore constant listening in the camp and at the mess to the just defamation of the sex by honest fellows by it cajoled, and as an effect of my own constant hortations in season and out, had arrived at such a misesteem and despizal of womankind as even I could scarce wish made stronger."
                            },
                            {
                                "example_id": "46b46efb-58a9-4a79-a04a-6fe1cd6f4896",
                                "sense_id": "39bdafe7-f04f-3268-a663-2cc7c309abe6",
                                "text": "The years after the war mark the lowest depths of misesteem attached to the Napoleonic legend since Las Cases published the Memorial."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
