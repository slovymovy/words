                                                "example_id": "c26822f1-5708-42bb-958c-f8244eefd651",
                                                "sense_id": "1ae48cf8-6ca5-3969-8490-9c23278bd23d",
                                                "text": "It is noted that vicarious embarrassment does not necessarily indicate the presence of an embarrassed other."
                                            },
                                            {
                                                "example_id": "be43b899-f142-496c-b7e8-e1a238f1f53a",
                                                "sense_id": "1ae48cf8-6ca5-3969-8490-9c23278bd23d",
                                                "text": "The same brain regions, the study found, are implicated in vicarious embarrassment – watching President Obama give an awkward hug of his own to departing press secretary Jay Carney, say – as they are when empathizing with the physical pain of others."
                                            }
