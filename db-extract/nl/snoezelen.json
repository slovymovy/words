        "nl-extract.jsonl": [
            {
                "entry_id": "f9bbe199-7757-3172-8965-d992785bc35e",
                "word": "snoezelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "411a3862-90f0-34c5-b3e5-4d0b9be91914",
                        "entry_id": "f9bbe199-7757-3172-8965-d992785bc35e",
                        "glosses": [
                            "combinatie van snuffelen en doezelen een activiteit die prettig zou zijn voor dementerenden en verstandelijk gehandicapten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9849e62-e232-4e3c-a84c-be3344af7ca5",
                                "sense_id": "411a3862-90f0-34c5-b3e5-4d0b9be91914",
                                "text": "Hij raadde mij plekken aan om te bezoeken. Ik ging ook boeken lezen over snoezelen: wat is daar nou precies de bedoeling van. Zo kwam ik uit op zachte, warme knuffels die lekker ruiken. En toen ik daar op uit was gekomen dacht ik: dan zou ik ze ook wel willen produceren."
                            },
                            {
                                "example_id": "7093e5ed-a803-4482-8d8a-17cb0604a131",
                                "sense_id": "411a3862-90f0-34c5-b3e5-4d0b9be91914",
                                "text": "Bult wijkt de afgelopen dagen niet van zijn zijde, vrijdag had ze een gesprek met zijn arts en donderdag twitterde ze: \"Middag bij papa aan bed, omarmen, strelen, muziek luisteren en veel snoezelen...wat 'n held!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "718990ee-83db-3641-b03d-152d5f55cbcd",
                        "entry_id": "f9bbe199-7757-3172-8965-d992785bc35e",
                        "glosses": [
                            "combinatie van knuffelen en dommelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d7595a-c566-436c-ac1e-f8d12999c371",
                                "sense_id": "718990ee-83db-3641-b03d-152d5f55cbcd",
                                "text": "Om zeven uur mag je me komen wekken. Of, om zeven uur mag je nog even lekker bij me komen snoezelen. Want dat soort momenten moet je natuurlijk wel blijven koesteren zolang het kan!\""
                            }
                        ]
                    }
                ],
