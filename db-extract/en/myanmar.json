                        ]
                    },
                    {
                        "translation_id": "d22bde77-eeae-4de6-b3c7-b6e901d2317e",
                        "source_entry_id": "e5096497-3795-338d-8b4d-a30b9ca4994a",
                        "source_sense_description": "Southeast Asian country — see also Burma",
