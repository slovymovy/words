                    {
                        "translation_id": "d88a02ad-107e-4dcb-8691-c88a56d6b220",
                        "source_entry_id": "4fbb753e-a715-3023-a9d0-00ea57f95a39",
                        "source_sense_id": "bfe49657-ca19-31ed-a681-83eefd255243",
                        "source_sense_description": "science of metals",
                        "target_lang_word": "métallurgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métallurgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                        "entry_id": "779e13bf-8d07-3058-8b82-93731f5b073c",
                                        "glosses": [
                                            "Industrie qui a pour objet l’extraction et la purification des métaux, de leurs alliages, et leur emploi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b8a40a-66cb-44c9-896c-1f71045f0e9a",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "À une période où la métallurgie constitue une innovation majeure, les élites qui contrôlent les circuits d’approvisionnement et d’échanges maîtriseraient également tout le processus de thésaurisation volontaire des richesses, depuis la sélection intentionnelle et codifiée des objets jusqu’aux cérémonies et rituels d’enfouissement."
                                            },
                                            {
                                                "example_id": "da09eb08-5859-4461-8c0b-2cf02ddbe2f6",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "Comme son nom l’indique, cet ouvrage traite de la métallurgie du fer au point de vue théorique et au point de vue pratique."
                                            },
                                            {
                                                "example_id": "45132dab-9e0a-419b-a46d-26f57d3fa7a6",
                                                "sense_id": "bd81647c-9434-39c2-8b02-9c5a1a4f352e",
                                                "text": "Le minerai de fer a donné naissance à l’une des principales et des plus anciennes industries des Ardennes, la métallurgie du fer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca3f0ab0-5560-4cf5-856e-fee4b04418e2",
                        "source_entry_id": "4fbb753e-a715-3023-a9d0-00ea57f95a39",
                        "source_sense_id": "bfe49657-ca19-31ed-a681-83eefd255243",
                        "source_sense_description": "science of metals",
                        "target_lang_word": "Metallurgie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metallurgie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                        "entry_id": "edbb3f12-dc4d-3131-b9ea-dfa1cebcd367",
                                        "glosses": [
                                            "Gesamtheit der Verfahren zur Herstellung von Metallen oder bestimmten Legierungen aus Erzen oder metallhaltigen Abfällen"
                                        ],
                                        "tags": [
                                            "Wertstoffkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee4574c4-8da2-49b6-bfe0-44af25a9f41f",
                                                "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                                "text": "Die Metallurgie nutzt Ergebnisse aus der Metallkunde."
                                            },
                                            {
                                                "example_id": "0a83a8f2-7645-44b3-8f2d-111ae5bd493f",
                                                "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                                "text": "„Die junge Aurelia erlernt von ihrem Vater, dem Alchemisten Meliorus, endlich die letzten Geheimnisse der Metallurgie und Giftkunst.“"
                                            },
                                            {
                                                "example_id": "d762e3dc-7b07-4255-9854-980c2afc1286",
                                                "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                                "text": "„Ein Schwerpunkt der Arbeit liegt auf der Herstellung und Metallurgie der Bronzeschwerter.“"
                                            },
                                            {
                                                "example_id": "1ac60f05-0fd6-45b0-8293-ee7e974ba427",
                                                "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                                "text": "„Die Metallurgie behandelt nicht allein die chemischen, sondern auch die mechanischen Processe, durch welche nutzbare Metalle oder ihre Verbindungen aus den natürlichen Vorkommnissen derselben, den Erzen, im Grossen gewonnen werden.“"
                                            },
                                            {
                                                "example_id": "31366ef2-cf11-4445-b6a1-d06502bba865",
                                                "sense_id": "3bc5329e-d8ca-3830-9906-95174e92a7da",
                                                "text": "„Ich begriff, dass er ein vielseitiger Mann gewesen war, denn er hatte auch eine Menge Artikel über Mineralogie, Metallurgie, Umweltschutz und Geopolitik geschrieben, ehe er 1989 verstorben war, wie der Nachruf mitteilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
