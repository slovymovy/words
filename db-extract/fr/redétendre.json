                "senses": [
                    {
                        "sense_id": "8ca204bc-7595-3e0d-bd58-aa2a132249e8",
                        "entry_id": "2e4d3502-6f9f-39c4-a39f-85f6584cdbdf",
                        "glosses": [
                            "Provoquer une nouvelle détente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8282620-9a63-4338-8d61-b56d5ccb6f38",
                                "sense_id": "8ca204bc-7595-3e0d-bd58-aa2a132249e8",
                                "text": "Afin d’économiser le gaz dans le circuit, celui-ci est recomprimé puis redétendu ensuite."
                            },
                            {
                                "example_id": "96256f27-5625-4b97-857f-771b5e48ba21",
                                "sense_id": "8ca204bc-7595-3e0d-bd58-aa2a132249e8",
                                "text": "Malgré la colère qui montait, il a pu redétendre l’atmosphère avec sa bonne humeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4940576-f1be-3fd8-a1c9-81c118cc0a3b",
                        "entry_id": "2e4d3502-6f9f-39c4-a39f-85f6584cdbdf",
                        "glosses": [
                            "Se détendre à nouveau."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "50e5b520-4ffb-46b9-a157-c386dfbafac6",
                                "sense_id": "c4940576-f1be-3fd8-a1c9-81c118cc0a3b",
                                "text": "Après chaque sauna, mon corps se redétendait et je retrouvais toutes mes sensations."
                            }
                        ]
                    }
