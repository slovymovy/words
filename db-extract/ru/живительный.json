                                        "sense_id": "0c8eb0b9-86dd-380a-8de7-03717d86b30e",
                                        "entry_id": "5f21b19a-ff37-33e4-b915-3d78dfbf7f13",
                                        "glosses": [
                                            "Qui excite la tonicité, qui fortifie l’organisme, le rend plus ferme, plus alerte."
