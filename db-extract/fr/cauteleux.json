                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64cbda4d-6189-4bc8-a854-7340219643b0",
                                                "sense_id": "edc9080e-b18e-3ee3-9167-fea7b6e00df2",
                                                "text": "Der kleine Raum auf dem Dachboden war mit einfachen Fichtenbrettern verschlagen."
                                            }
                                        ],
