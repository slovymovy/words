                        "entry_id": "c40f8c3f-2265-3bbf-aba2-612162d04448",
                        "glosses": [
                            "met grote kracht, heel snel, met hoge intensiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6367a460-2825-4ce5-92ab-b60e1b694a67",
                                "sense_id": "de3f30fe-e59b-3117-8c6d-283dbad8fac0",
                                "text": "Maar ook al is het zwaar en knoerthard werken, we kunnen ervan leven dus je hoort me niet klagen."
                            },
                            {
                                "example_id": "1308090b-45c7-490f-8a92-24eed42c5854",
                                "sense_id": "de3f30fe-e59b-3117-8c6d-283dbad8fac0",
                                "text": "Verder reden de taxi’s, auto’s en vrachtauto’s er nog even knoerthard als vroeger."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9bdafcf-3d0c-3532-9f8d-024ff067e02e",
                        "entry_id": "c40f8c3f-2265-3bbf-aba2-612162d04448",
                        "glosses": [
                            "met heel luide toon, met een groot volume aan geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1b67f1-146e-4970-97ce-86090e7be62e",
                                "sense_id": "d9bdafcf-3d0c-3532-9f8d-024ff067e02e",
                                "text": "Met Ajax aan kop in de eredivisie is de Johan Cruijff Arena een bastion van blije mensen. Ajacieden, jong en oud, in colbert of jurk, met of zonder rood-witte sjaal, deinen op knoertharde beats en het aloude Amsterdamse repertoire, met Danny de Munk en zijn ode aan Mokum."
                            },
                            {
                                "example_id": "e0138b91-fe8b-441e-b8e1-afce1727cdf0",
                                "sense_id": "d9bdafcf-3d0c-3532-9f8d-024ff067e02e",
                                "text": "Bas Heijne gaat achter zijn schrijftafel zitten, doet een koptelefoon op, kiest een disconummer, zet het volume op knoerthard en drukt op de knop repeat."
                            }
                        ]
                    },
                    {
                        "sense_id": "674d7a53-c442-380d-b763-504d17223bd8",
                        "entry_id": "c40f8c3f-2265-3bbf-aba2-612162d04448",
                        "glosses": [
                            "heel stevig, niet meegevend met een kracht van buiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d0145e-8293-40bc-a8c8-20e901c33520",
                                "sense_id": "674d7a53-c442-380d-b763-504d17223bd8",
                                "text": "Voor een kok is een mes de verlenging van zijn hand, mijmert Van Greuningen. „Neem deze” – hij trekt iets blinkends te voorschijn – „twintig centimeter knoerthard staal.”"
                            },
                            {
                                "example_id": "abada696-17c9-47ef-97cc-0c214ee2f845",
                                "sense_id": "674d7a53-c442-380d-b763-504d17223bd8",
                                "text": "De drollen zijn gelukkig versteend, dus ze zijn knoerthard en ze stinken ook niet meer."
                            }
                        ]
                    }
