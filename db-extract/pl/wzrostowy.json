                    }
                ],
                "senses": [
                    {
                        "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                        "entry_id": "780cfdd7-b00e-3695-beab-252495dca6c6",
                        "glosses": [
                            "odnoszący się do wzrostu (organizmu), związany ze wzrostem – procesem wytwarzania przez organizm nowych komórek; wpływający, oddziałujący na wzrost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a41104e-90a3-4012-82dd-38526fce3890",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "Niekiedy w wieku młodzieńczym występuje niedobór hormonu wzrostowego"
                            },
                            {
                                "example_id": "130c4d35-2949-44eb-a6e9-8e12ebb1d5f2",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "Wyciągi z grasicy stosowane są przy zaburzeniach wzrostowych"
                            },
                            {
                                "example_id": "2e2387c9-845a-4370-abbc-4f03dc0bfd5a",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "Bawełna wartość swą jako surowiec włókienniczy zawdzięcza w dużym stopniu niezwykłej zdolności wzrostowej włosków pokrywających nasiona"
                            },
                            {
                                "example_id": "986f93ee-4808-43c7-b44f-610de842c768",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "W okresie pokwitania tym szybciej rozwijają się zniekształcenia, im szybciej przebiega tzw. skok wzrostowy"
                            },
                            {
                                "example_id": "65d90046-4644-46d3-8188-f216f3737b3a",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "Ruch powoduje to, że nasz organizm wytwarza specjalne czynniki wzrostowe, które chronią komórki nerwowe przed zniszczeniem"
                            },
                            {
                                "example_id": "008649bd-4815-4ca1-8ae6-a2f7fb4abdbd",
                                "sense_id": "acfe1d4d-c641-3b0d-b9b9-6d3625773a09",
                                "text": "Nie wiemy, dlaczego rośliny mają tyle sposobów produkcji hormonu wzrostowego, i jak roślina reguluje biosyntezę IAA, mając tyle „możliwości” do wyboru"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c2d8d878-486a-3c9a-b1d1-9056647a5859",
                        "entry_id": "780cfdd7-b00e-3695-beab-252495dca6c6",
                        "glosses": [
                            "związany ze wzrostem – procesem, w którym coś staje się coraz większe liczbowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f682eff2-bd56-4890-9921-8fdf7e283ecd",
                                "sense_id": "c2d8d878-486a-3c9a-b1d1-9056647a5859",
                                "text": "Badania J. Gwartneya i in. sugerują, że zbyt duży sektor publiczny stanowi obciążenie dla gospodarki i prowadzi do zmniejszenia jej potencjału wzrostowego"
                            },
                            {
                                "example_id": "3ce5958a-e312-43d0-9c68-8b5f501a9d02",
                                "sense_id": "c2d8d878-486a-3c9a-b1d1-9056647a5859",
                                "text": "Spadające ceny ropy — wczoraj baryłka kosztowała 118 dolarów — spowodowały wzrosty na niemal wszystkich parkietach. Również Warszawa nie oparła się wzrostowemu trendowi"
                            },
                            {
                                "example_id": "afd81a3d-7962-4549-a56b-16cf58f50cda",
                                "sense_id": "c2d8d878-486a-3c9a-b1d1-9056647a5859",
                                "text": "Mimo lekkiego sezonowego wahnięcia produkcji w dół w październiku [produkcja, spadek](sic!) (o 0,3 proc. w stosunku do września) ogólny trend nadal ma charakter wzrostowy i pod koniec roku produkcja będzie o 7 proc. większa niż rok temu [produkcja, wzrost](sic!), a dochód narodowy o 4,5 proc."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
