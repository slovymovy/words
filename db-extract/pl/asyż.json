                "senses": [
                    {
                        "sense_id": "1bd9def8-e9ab-3f3f-a458-c4ba7a0c20d9",
                        "entry_id": "f47a0870-fe98-3480-8713-3acf247f47c8",
                        "glosses": [
                            "miasto i gmina we Włoszech, w Umbrii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63ac95c-ce8e-4c52-9539-cf6b3bd7b951",
                                "sense_id": "1bd9def8-e9ab-3f3f-a458-c4ba7a0c20d9",
                                "text": "Najbardziej znanym mieszkańcem Asyżu jest niewątpliwie św. Franciszek, przez wielu kojarzony z założycielem zakonu franciszkanów."
                            },
                            {
                                "example_id": "55974aed-a087-4f78-9319-a5c493beb53c",
                                "sense_id": "1bd9def8-e9ab-3f3f-a458-c4ba7a0c20d9",
                                "text": "Wojtek z Adamem znaleźli nocleg w jakiejś wiosce pod Asyżem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
