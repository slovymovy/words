                                        "examples": [
                                            {
                                                "example_id": "56a64aa5-72bb-4bbf-9791-1b46a1d3c791",
                                                "sense_id": "a823a241-2efb-359c-b15d-1ad6fff492dd",
                                                "text": "Het aantal boekingen van coverband Nightwind is de afgelopen jaren gehalveerd, denkt bandleider Kees van Langen. Hij klust dan ook regelmatig bij als dj: \"Dat vind ik leuk om te doen, maar het is wel noodzakelijk kwaad. Uiteindelijk ben ik muzikant in hart en nieren.\""
                                            },
                                            {
                                                "example_id": "e1d7a20b-0f5f-4e57-add6-820e4d99659b",
                                                "sense_id": "a823a241-2efb-359c-b15d-1ad6fff492dd",
                                                "text": "In München is de Duitse saxofonist en bandleider Max Greger (89) na een kort ziekbed overleden. In zijn 70-jarige carrière nam hij ruim 3000 nummers op en bracht hij meer dan 150 albums uit."
                                            }
                                        ]
                                    }
