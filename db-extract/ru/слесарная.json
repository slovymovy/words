                        "sense_id": "57f527e6-4265-311b-931d-21fbe374c167",
                        "entry_id": "2f26491b-701f-3595-9a3d-af4d09308bac",
                        "glosses": [
                            "мастерская по ручной обработке металла, сборке машин и оборудования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c48bab-9e00-4af0-84e2-e8a27bfd7c5a",
                                "sense_id": "57f527e6-4265-311b-931d-21fbe374c167",
                                "text": "Средину двора занимали два кирпичных корпуса, кузницы, листокатальная и слесарная, а дальний конец был застроен амбарами и складами."
                            },
                            {
                                "example_id": "f535cd63-fdfa-458f-b8bd-f9ed1c2db167",
                                "sense_id": "57f527e6-4265-311b-931d-21fbe374c167",
                                "text": "Есть своя портняжная, прачечная, столовая, парикмахерская, сапожная, слесарная и пр. и пр."
                            }
                        ]
                    }
