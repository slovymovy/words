                "senses": [
                    {
                        "sense_id": "4210578e-011d-3c9a-a42a-7dab099850c7",
                        "entry_id": "7a1a2498-52bc-3008-8111-6bc660398c6f",
                        "glosses": [
                            "имеющий отношение, относящийся к творчеству, созиданию нового на основе интеллектуального и эстетического выбора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7646c296-69f7-4c58-80ca-3c31621b0be7",
                                "sense_id": "4210578e-011d-3c9a-a42a-7dab099850c7",
                                "text": "Своеобразным руководством к действию всего творческого коллектива становится режиссерская разработка сценария — режиссерская экспликация."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7726afe-708c-499d-b334-ee4f8cfb8dda",
                        "source_entry_id": "7a1a2498-52bc-3008-8111-6bc660398c6f",
                        "source_sense_id": "4210578e-011d-3c9a-a42a-7dab099850c7",
                        "target_lang_word": "creative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7342b70e-9e1a-3499-84a0-ea0eff3a809b",
                                        "entry_id": "94a83de3-04d0-3739-84c1-f97c73d94ca0",
                                        "glosses": [
                                            "Tending to create things, or having the ability to create; often, excellently, in a novel fashion, or any or all of these."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eba50ce-e310-43aa-bf2b-ee997bd8dbd1",
                                                "sense_id": "7342b70e-9e1a-3499-84a0-ea0eff3a809b",
                                                "text": "a creative dramatist who avoids cliche"
                                            },
                                            {
                                                "example_id": "e9a0d51b-0980-41b6-8dd7-d180f0eb4aa3",
                                                "sense_id": "7342b70e-9e1a-3499-84a0-ea0eff3a809b",
                                                "text": "The future belongs to those aware enough to see the system, brave enough to reject it, and creative enough to build something better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa56819b-db5b-3bcb-b7d4-30b43f908e0c",
                                        "entry_id": "94a83de3-04d0-3739-84c1-f97c73d94ca0",
                                        "glosses": [
                                            "Original, expressive and imaginative."
                                        ],
                                        "tags": [
                                            "of a created thing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79be314b-2d4a-4a4c-9053-4c69cc97cb2a",
                                                "sense_id": "fa56819b-db5b-3bcb-b7d4-30b43f908e0c",
                                                "text": "a creative new solution to an old problem"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4e3c4c-d1da-3ec0-b42d-d9c870d6adbd",
                                        "entry_id": "94a83de3-04d0-3739-84c1-f97c73d94ca0",
                                        "glosses": [
                                            "A type of set of natural numbers, related to mathematical logic."
