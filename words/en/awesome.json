                {
                    "sense_id": "2bbd74a6-e550-3afa-b62d-21e9070fdafd",
                    "sense_definition": "Extremely good, enjoyable, or impressive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "excellent_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a totally <w>awesome</w> time at the rock concert last night.",
                            "target_lang_translations": {
