                "senses": [
                    {
                        "sense_id": "cb786dbc-684e-3b89-adfd-1d2229bf74ca",
                        "entry_id": "6e010720-ed50-3834-8e69-bd52a4bf4a52",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße anständiges und ehrliches (reelles) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5756c2fd-f7d0-48f6-b93d-2efe81e6ad44",
                                "sense_id": "cb786dbc-684e-3b89-adfd-1d2229bf74ca",
                                "text": "„Ins Ethische übertragen finden wir hier die Wendung zum Ernst und zur Wahrhaftigkeit. ‚Reell sein‘ ist die Ehre des Kaufmanns. Für ihn bedeutet diese ‚Reellität‘ eine große Kunst, weil er eben aus der Kenntnis der Menschen und Dinge heraus alle jene Umwege und Schliche weiß, mit welchen man die Dinge und die Menschen betrügerisch formt, so wie man will.“"
                            },
                            {
                                "example_id": "8945570e-e4c2-4679-931d-14da1b6ac76a",
                                "sense_id": "cb786dbc-684e-3b89-adfd-1d2229bf74ca",
                                "text": "„Nichts schädigt den Handel so sehr wie der Mangel an Reellität, falsches Ellenmaß und dergleichen Schwindeleien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
