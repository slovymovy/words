                        "glosses": [
                            "in eine Brust operativ eingepflanztes Implantat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0902b7ec-c998-4b32-8e4a-4cad38477555",
                                "sense_id": "f3c63b67-ef89-3c0e-9dcf-7099d040e215",
                                "text": "„Die Food and Drug Administration (FDA), die dem Gesundheitsministerium unterstellte Lebensmittelüberwachung und Arzneimittelzulassungsbehörde der Vereinigten Staaten, hat schon im Jahr 2000 den Import von Brustimplantaten der Firma PIP in die USA gestoppt.“"
                            },
                            {
                                "example_id": "b8dbb910-9169-403f-b368-e3fccb1c1d85",
                                "sense_id": "f3c63b67-ef89-3c0e-9dcf-7099d040e215",
                                "text": "„Es werden in Deutschland jährlich mehr als 25.000 Brustimplantate eingesetzt.“"
                            }
                        ],
