                "senses": [
                    {
                        "sense_id": "7fb6cd65-43fe-3cd1-94f8-699d3d7383d9",
                        "entry_id": "64b4031e-4866-3af3-a3ba-4b57862584fb",
                        "glosses": [
                            "анат., уменьш. роговые или костяные пластинки, образующие наружный покров некоторых позвоночных животных"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea88c6f7-4200-4233-9db7-07f442861efe",
                        "source_entry_id": "64b4031e-4866-3af3-a3ba-4b57862584fb",
                        "source_sense_id": "7fb6cd65-43fe-3cd1-94f8-699d3d7383d9",
                        "target_lang_word": "écaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f13ed057-b41d-32f3-bd7b-363f06d83fc8",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Petites lames minces et plates qui couvrent la peau de certains poissons et de certains reptiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47a529a-41de-4e14-9ae2-fde771e7ec5e",
                                                "sense_id": "f13ed057-b41d-32f3-bd7b-363f06d83fc8",
                                                "text": "Les écailles d’une carpe, d’un saumon, d’une morue."
                                            },
                                            {
                                                "example_id": "96d548a0-578d-4189-a23a-f30449c5c616",
                                                "sense_id": "f13ed057-b41d-32f3-bd7b-363f06d83fc8",
                                                "text": "Des écailles dures, rondes, transparentes."
                                            },
                                            {
                                                "example_id": "814012be-83b5-4b1d-9eb2-58e3327d295c",
                                                "sense_id": "f13ed057-b41d-32f3-bd7b-363f06d83fc8",
                                                "text": "Rentrés au logis, les deux hommes raclaient les poissons, mettant de côté les écailles qui luisaient comme des piécettes d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0514f3cc-a310-33aa-b1c0-1b6bd30c1073",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Enveloppe dure et calcaire qui couvre et protège le corps des mollusques bivalves, notamment les huîtres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15bba18a-aad2-38ed-84ed-ffc127e62819",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Nom vernaculaire de plusieurs espèces de lépidoptères de la famille des arctidés (Arctiidae)."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96f6f278-2b0a-40b8-b1d9-891feb2f4176",
                                                "sense_id": "15bba18a-aad2-38ed-84ed-ffc127e62819",
                                                "text": "Certaines espèces d’écailles s’attaquent aux vignes, telle l’écaille martre (Arctia caja)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73105d73-e3ac-3193-a5a9-fcab182f1f84",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Enveloppe dure qui couvre le dos de la tortue et dont on faisait de petits objets précieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d82e899-36d1-4cca-9abd-037741640492",
                                                "sense_id": "73105d73-e3ac-3193-a5a9-fcab182f1f84",
                                                "text": "La veille, j’avais vu dans les mains d’une dame, sur une boîte d’écaille, le portrait peint à la miniature du chevalier de Saint-Ange, en costume de dragon."
                                            },
                                            {
                                                "example_id": "b50f680f-45d3-4955-9699-9dc135fef048",
                                                "sense_id": "73105d73-e3ac-3193-a5a9-fcab182f1f84",
                                                "text": "J’avais acheté des malles. Elles étaient remplies de souvenirs : coffrets, tapis d’aloès, cannes en bois d’amourette, écaille travaillée par Belon, de Marseille."
                                            },
                                            {
                                                "example_id": "c97eb2d1-9515-42c1-9f53-826dd9a837aa",
                                                "sense_id": "73105d73-e3ac-3193-a5a9-fcab182f1f84",
                                                "text": "Sur la cheminée, dans un triple cadre de fausse écaille, des photographies étaient pâles comme si les morts qu’elles représentaient y fussent morts une seconde fois."
                                            },
                                            {
                                                "example_id": "39c268fd-c782-4666-b46d-d0ce961f33b9",
                                                "sense_id": "73105d73-e3ac-3193-a5a9-fcab182f1f84",
                                                "text": "Par une fenêtre ouverte, elle aperçut un piano sur lequel jouaient à quatre mains deux filles portant les mêmes lunettes à monture d’écaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf2b7781-f640-3cfb-b698-90ecc3c9c485",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Lamelle microscopique qui couvre les poils et les cheveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9b916f-56be-4a25-94e2-f57942b6e197",
                                                "sense_id": "cf2b7781-f640-3cfb-b698-90ecc3c9c485",
                                                "text": "Vu au microscope, le poil se présente sous la forme d’un canal médullaire sur lequel on ne peut voir les écailles qu’en les observant avec beaucoup de soin […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a54d8170-84af-3976-85a5-fd9b5c7ad03e",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Partie des os du crâne formant la cavité crânienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae4f1b5-b877-4d85-8a5c-bbdc47fbed8f",
                                                "sense_id": "a54d8170-84af-3976-85a5-fd9b5c7ad03e",
                                                "text": "L’écaille de l’os frontal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d584da-ff7c-3d49-85b0-759ade84ce8f",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Productions plates et plus ou moins sèches, qui composent ou accompagnent certaines parties des végétaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed450aa3-62ea-4b7f-a855-4758ee53ed97",
                                                "sense_id": "f9d584da-ff7c-3d49-85b0-759ade84ce8f",
                                                "text": "Les bulbes du lis, les cônes du sapin sont formés d’écailles."
                                            },
                                            {
                                                "example_id": "94dd692e-2cca-4166-90f9-a300bf3018ba",
                                                "sense_id": "f9d584da-ff7c-3d49-85b0-759ade84ce8f",
                                                "text": "Les boutons du marronnier d’Inde, la tige de l’orobanche sont garnis d’écailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe74f249-7166-3346-bf7f-f7650537e60f",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Lamelles minces et légères qui se détachent de la peau dans certaines affections cutanées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "389f8acc-f2f7-463a-b2d8-e406e66c830a",
                                                "sense_id": "fe74f249-7166-3346-bf7f-f7650537e60f",
                                                "text": "Sa peau se soulevait par écailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb46af7-3d17-385a-b0c4-f53ba8e3080f",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Nom des ardoises étroites et arrondies dans le bout de la partie visible servant à la couverture des dômes."
                                        ],
                                        "tags": [
                                            "Couvertures"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49c7c233-2578-3128-a83a-8ac075384f7c",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Croûte qui se produit sur le fer trop chauffé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07de9d55-0a33-3d5a-ba5b-78c05e440094",
                                        "entry_id": "99eefe80-6c24-3935-a329-67ecb4eb3cd0",
                                        "glosses": [
                                            "Plaque de cuivre utilisée par les émailleurs pour faire du Bleu de Turquie."
                                        ],
                                        "tags": [],
