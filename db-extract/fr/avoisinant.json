                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d148c2-980c-42d5-9dc1-0810b0ae2168",
                                                "sense_id": "78806458-85ed-3e9f-af4c-7a5c3dd34bbd",
                                                "text": "Die angrenzenden Häuser konnten vor dem Übergreifen der Flammen geschützt werden."
                                            },
                                            {
                                                "example_id": "a2124da4-a632-458c-8d48-6fead2165be0",
                                                "sense_id": "78806458-85ed-3e9f-af4c-7a5c3dd34bbd",
                                                "text": "„Nach einer Explosion auf einem Sprengplatz der Polizei im Berliner Grunewald ist der angrenzende Wald in Flammen geraten.“"
                                            },
                                            {
                                                "example_id": "414ce50b-927f-47db-ae40-9f40763d14c3",
                                                "sense_id": "78806458-85ed-3e9f-af4c-7a5c3dd34bbd",
                                                "text": "„Die an die Ukraine angrenzende Konfliktregion Transnistrien in der Republik Moldau hat von erneuten Angriffen auf ihr Territorium gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
