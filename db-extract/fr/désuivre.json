                "senses": [
                    {
                        "sense_id": "47e92675-7c67-3e72-bdf8-22d14e1f8c19",
                        "entry_id": "5a265237-881a-34a3-968a-9bb60dcfafd7",
                        "glosses": [
                            "Ne plus suivre, se désabonner, en parlant d’un fil d’actualité lié à un compte utilisateur."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "6e10323a-7201-4cbb-91a9-4b1352f58fd2",
                                "sense_id": "47e92675-7c67-3e72-bdf8-22d14e1f8c19",
                                "text": "Désuivre quelqu’un sur Twitter."
                            },
                            {
                                "example_id": "1245e95f-1231-4bd2-8e4d-38d3535fc8f9",
                                "sense_id": "47e92675-7c67-3e72-bdf8-22d14e1f8c19",
                                "text": "Il est donc important de « désuivre » les personnes qui ne vous suivent pas en retour afin d'augmenter votre « crédit » de personnes à suivre."
                            },
                            {
                                "example_id": "116ab858-56a3-4e2b-86b1-ff64d3dfd5d3",
                                "sense_id": "47e92675-7c67-3e72-bdf8-22d14e1f8c19",
                                "text": "Pour une communauté au top sur les réseaux sociaux, je vous conseille également de mettre en place un système qui vous permettra d’automatiser vos échanges sur Twitter. Cela vous permettra ainsi de rester au plus près de ceux qui décident de vous suivre, de leur envoyer des messages de bienvenus, mais aussi de suivre ou désuivre des comptes."
                            }
                        ]
                    }
