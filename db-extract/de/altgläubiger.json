                "senses": [
                    {
                        "sense_id": "01c7d223-8959-3d23-bf31-445f05b0af2b",
                        "entry_id": "cf0a6ecf-0914-3f6c-a8b0-9f57ca473bfc",
                        "glosses": [
                            "Anhänger einer christlichen Glaubensrichtung in Russland, die nicht mehr zur Russisch-Orthodoxen Kirche gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9b4346-73b9-43c3-8311-2442fb7c31d4",
                                "sense_id": "01c7d223-8959-3d23-bf31-445f05b0af2b",
                                "text": "„Wir hatten in unserm Zuchthause auch andere Altgläubige, zum größten Teil Sibirier. Es waren geistig hochentwickelte, schlaue Bauern, außerordentlich bibelkundig, am Buchstaben zäh festhaltend und in ihrer Art tüchtige Dialektiker; hochmütige, eingebildete, listige und im höchsten Grade intolerante Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
