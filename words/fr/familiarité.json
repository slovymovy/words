                        "se permettre des familiarités"
                    ]
                },
                {
                    "sense_id": "2513cd34-fa47-333e-affb-e6c441ea26b1",
                    "sense_definition": "Connaissance approfondie ou pratique régulière d'une matière, d'un lieu ou d'une langue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grande <w>familiarité</w> avec les outils informatiques lui a permis de résoudre le problème très vite."
                        },
                        {
                            "text": "Elle a développé une véritable <w>familiarité</w> avec la culture locale au cours de son long séjour."
