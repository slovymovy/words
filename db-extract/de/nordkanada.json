                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a71990-0436-4501-99c8-d61360e1b22e",
                                "sense_id": "8acc1bcb-2ebc-3b27-b29f-dd30281f790f",
                                "text": "„Der magnetische Südpol, heute in Nordkanada, wird z. B. in etwa 50 Jahren die sibirische Küste erreichen.“"
                            },
                            {
                                "example_id": "277ae3ea-67eb-46ba-99cb-9ddf5174003c",
                                "sense_id": "8acc1bcb-2ebc-3b27-b29f-dd30281f790f",
                                "text": "„Über die Bering-Straße aus Sibirien vor vielleicht 8000 Jahren eingewandert, besiedelten die Inuit weite Regionen in Alaska, Nordkanada und Grönland und lernten dabei, mit dem rauen Klima der Arktis fertig zu werden.“"
                            }
                        ],
