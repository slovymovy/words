                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d982965e-14cc-4806-9502-5662c00b075f",
                                "sense_id": "a3fa8db7-65c9-3e95-bf5b-27b6d0ee2c63",
                                "text": "Alors [à la naissance d'un enfant royal en France], s'ouvraient des concours d'emmailloteuses, puis des concours de berceuses."
                            },
                            {
                                "example_id": "8d61922a-5f53-41ae-87cc-9cb89b50514d",
                                "sense_id": "a3fa8db7-65c9-3e95-bf5b-27b6d0ee2c63",
                                "text": "Messieurs, vous n'êtes point des guérisseurs d'amour-propre en souffrance, des emmailloteurs de vanité blessée, des Pères de la Merci, des Frères de la Miséricorde ; vous êtes des législateurs."
                            }
                        ]
                    }
