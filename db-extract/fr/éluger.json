                "senses": [
                    {
                        "sense_id": "9a0fe1dc-6b71-3491-9b84-10a23c665e49",
                        "entry_id": "5ff58e1a-ea78-32c9-ae95-e71ca4c8e460",
                        "glosses": [
                            "Ennuyer, énerver."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "90b58c06-982c-43e8-a6f1-ec5c3a7846a7",
                                "sense_id": "9a0fe1dc-6b71-3491-9b84-10a23c665e49",
                                "text": "« Voir Rosalie, pour quoi faire ? Le médecin a dit qu’il ne fallait pas l’éluger »."
                            },
                            {
                                "example_id": "0d2e5fea-ee83-486b-978a-aa6eb8bee878",
                                "sense_id": "9a0fe1dc-6b71-3491-9b84-10a23c665e49",
                                "text": "Tu m’éluges, crois-tu que j’aie retenu ces choses-là par cœur ?"
                            },
                            {
                                "example_id": "a422451d-c8f3-4beb-8c94-474ab5f40515",
                                "sense_id": "9a0fe1dc-6b71-3491-9b84-10a23c665e49",
                                "text": "Tu m’éluges !"
                            }
                        ]
                    },
                    {
                        "sense_id": "a28fd2f9-45ae-367d-a861-0ba47c510849",
                        "entry_id": "5ff58e1a-ea78-32c9-ae95-e71ca4c8e460",
                        "glosses": [
                            "Se faire du tracas."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c5217446-5a64-4895-9ae2-5f1f26831a39",
                                "sense_id": "a28fd2f9-45ae-367d-a861-0ba47c510849",
                                "text": "— Eh bien, ne vous élugez point, vous trouverez du travail aux usines."
                            }
                        ]
