                "senses": [
                    {
                        "sense_id": "245d927e-0666-369b-bd09-21dc10f64556",
                        "entry_id": "388b31bc-92cc-3431-8714-b93c0366a0a1",
                        "glosses": [
                            "Währung der Bundesrepublik Deutschland und West-Berlins, im Unterschied zur Währung der DDR"
                        ],
                        "tags": [
                            "inoffiziell"
                        ],
                        "examples": [
                            {
                                "example_id": "0eb50dd6-079c-42cd-89c7-9261cb08b270",
                                "sense_id": "245d927e-0666-369b-bd09-21dc10f64556",
                                "text": "„Aber auch viele andere Waren und vor allem Handwerkerleistungen waren nur mit Westmark zu bekommen.“"
                            },
                            {
                                "example_id": "a876d372-326a-4dbf-a2cf-dc41d50cd78b",
                                "sense_id": "245d927e-0666-369b-bd09-21dc10f64556",
                                "text": "„Sie hatten befürchtet, dass ihr Verlag nicht überleben würde, hatte er doch die Jahre zuvor nur von den unterschiedlichen Währungen in Ost und West gelebt, hatte mit Ostmark die Bücher produziert, um sie für Westmark zu verkaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
