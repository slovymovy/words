                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb71caef-c323-4a38-8fe7-f55a258059d5",
                        "source_entry_id": "9befd7ad-d34b-39be-b7f0-e7feab03d7f7",
                        "target_lang_word": "wail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a2add35-b483-3b50-b5f1-a4986d78c41f",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To cry out, as in sorrow or anguish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "954d5a84-6f88-3573-93c4-dd560c7f5329",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To weep, lament persistently or bitterly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ed70fe8-c3a1-3b83-8b66-fb6341a67077",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To make a noise like mourning or crying."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c04b6aa-4936-44dd-942f-802531a5e1af",
                                                "sense_id": "6ed70fe8-c3a1-3b83-8b66-fb6341a67077",
                                                "text": "The wind wailed and the rain streamed down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a302c16-0f6e-3748-99c9-55e7a12fa4c3",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To lament; to bewail; to grieve over."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4130d2-bccb-4880-b1de-a9ca3b79668b",
                                                "sense_id": "0a302c16-0f6e-3748-99c9-55e7a12fa4c3",
                                                "text": "to wail one's death"
                                            },
                                            {
                                                "example_id": "20492b7d-b328-49c5-9a59-3d9c92befef9",
                                                "sense_id": "0a302c16-0f6e-3748-99c9-55e7a12fa4c3",
                                                "text": "My lord, wise men ne'er sit and wail their woes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                                        "entry_id": "c2e8cc1e-6934-383a-a514-3fd6be132253",
                                        "glosses": [
                                            "To perform with great liveliness and force."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb1f687-1114-4503-add1-34020eccc57a",
                                                "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                                                "text": "Another outstanding surfer from Hawaii - Fred Hemmings. Fred only stands up on alternate Wednesdays, but when he does, he really wails."
                                            },
                                            {
                                                "example_id": "c2c2944b-192d-4fa5-950f-b7594b32c8a7",
                                                "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                                                "text": "At Boston's Roseland, as \"the Count's band was wailing,\" he grabbed Mamie, an avid dancer. The \"band was screaming when she kicked off her shoes and got barefooted"
                                            },
                                            {
                                                "example_id": "2e5e9af0-2b0f-454c-b332-abaed3d9d1e8",
                                                "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                                                "text": "The band was really wailing as we quickly made our dance moves in a most provocative manner."
                                            },
                                            {
                                                "example_id": "7b818711-759b-4077-b53b-be91b5c8b1cc",
                                                "sense_id": "8d942d50-299c-3fff-bd1a-47072d3f071a",
                                                "text": "We had a nondenominational wedding, with a bunch of great Sufi musicians really wailing, and my wildly enthusiastic mother in attendance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4295b66-6c47-3da2-b859-f8113b093a4a",
                                        "entry_id": "5cb7decf-2e26-30de-a934-a252050a7c6b",
                                        "glosses": [
                                            "A prolonged cry, usually high-pitched, especially as of grief or anguish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee03ef8a-c4d3-43a8-9bfe-c6082068e4d4",
                                                "sense_id": "a4295b66-6c47-3da2-b859-f8113b093a4a",
                                                "text": "She let out a loud, doleful wail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f040fae-360f-354c-9e6e-bf4e8dee47b2",
                                        "entry_id": "5cb7decf-2e26-30de-a934-a252050a7c6b",
                                        "glosses": [
                                            "Any similar sound as of lamentation; a howl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "301da0bd-1a09-4e85-8d49-959964fa05c2",
                                                "sense_id": "5f040fae-360f-354c-9e6e-bf4e8dee47b2",
                                                "text": "The wail of snow-dark winter winds."
                                            },
                                            {
                                                "example_id": "af0a4f87-7706-476c-9d9f-390246d855a4",
                                                "sense_id": "5f040fae-360f-354c-9e6e-bf4e8dee47b2",
                                                "text": "A bird's wail in the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dccdc18-7e35-3b8d-b8b1-d500d0084955",
                                        "entry_id": "5cb7decf-2e26-30de-a934-a252050a7c6b",
