                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk eens naar mijn nieuwe fiets, <stoer> hè?",
                            "target_lang_translations": {
                                "en": "Look at my new bike, <cool> huh?",
