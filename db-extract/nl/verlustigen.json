                                                "sense_id": "7300877a-84f3-34d1-b99e-faffcf33d438",
                                                "text": "to entertain friends with lively conversation"
                                            },
                                            {
                                                "example_id": "00a04994-a87f-464f-8659-93c1bc3b77eb",
