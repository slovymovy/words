{
    "word_family": [
        "clipper",
        "clipping",
        "clipboard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13061009-2f17-3f3e-982f-b1304a6cc633",
                    "sense_definition": "A small device, usually made of metal or plastic, used for holding things together or attaching one object to another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use this <w>clip</w> to keep the papers organized.",
                            "target_lang_translations": {
                                "ru": "Используй эту <w>скрепку</w>, чтобы привести бумаги в порядок.",
                                "zh": "用这个<w>夹子</w>把文件整理好。"
                            }
                        },
                        {
                            "text": "She put a silver <w>clip</w> in her hair to hold it back.",
                            "target_lang_translations": {
                                "ru": "Она заколола волосы серебряным <w>зажимом</w>, чтобы убрать их назад.",
                                "zh": "她把一个银色<w>发夹</w>别在头发上，把头发夹到后面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "paper clip",
                        "hair clip",
                        "bulldog clip",
                        "binder clip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое приспособление, обычно из металла или пластика, используемое для скрепления вещей или прикрепления одного предмета к другому.",
                        "zh": "一种小型夹具，通常由金属或塑料制成，用来把东西夹在一起，或把一个物体固定到另一个物体上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрепка",
                                "target_lang_sense_clarification": "канцелярская"
                            },
                            {
                                "target_lang_word": "зажим",
                                "target_lang_sense_clarification": "для бумаг, волос или денег"
                            },
                            {
                                "target_lang_word": "клипса",
                                "target_lang_sense_clarification": "крепление или украшение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夹子",
                                "target_lang_sense_clarification": "泛指用来夹住、固定物品的小夹具"
                            },
                            {
                                "target_lang_word": "发夹",
                                "target_lang_sense_clarification": "夹头发用"
                            },
                            {
                                "target_lang_word": "回形针",
                                "target_lang_sense_clarification": "夹纸用的金属小夹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72f43729-2295-331f-9916-808b541679c4",
                    "sense_definition": "A short section of video or audio taken from a longer recording, film, or broadcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cutting_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher showed a short <w>clip</w> from the documentary.",
                            "target_lang_translations": {
                                "ru": "Учитель показал короткий <w>отрывок</w> из документального фильма.",
                                "zh": "老师放了一小段纪录片<w>片段</w>。"
                            }
                        },
                        {
                            "text": "I sent him a funny video <w>clip</w> from the internet.",
                            "target_lang_translations": {
                                "ru": "Я отправил ему смешной видео<w>ролик</w> из интернета.",
                                "zh": "我给他发了一个网上的搞笑视频<w>片段</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snippet",
                        "video clip",
                        "audio clip",
                        "sound bite",
                        "fragment",
                        "piece",
                        "segment",
                        "extract"
                    ],
                    "common_phrases": [
                        "movie clip",
                        "news clip",
                        "sound clip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий отрывок видео или аудио, взятый из более длинной записи, фильма или передачи.",
                        "zh": "从较长的录音、影片或节目中截取出来的一小段视频或音频。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клип",
                                "target_lang_sense_clarification": "видеоролик"
                            },
                            {
                                "target_lang_word": "отрывок",
                                "target_lang_sense_clarification": "фрагмент записи"
                            },
                            {
                                "target_lang_word": "ролик",
                                "target_lang_sense_clarification": "короткое видео"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "片段",
                                "target_lang_sense_clarification": "从较长视频或音频中截出的一小段"
                            },
                            {
                                "target_lang_word": "视频片段",
                                "target_lang_sense_clarification": "短视频片段"
                            },
                            {
                                "target_lang_word": "音频片段",
                                "target_lang_sense_clarification": "短音频片段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c815a436-93bb-36ad-8eb5-98cddbe16dc3",
                    "sense_definition": "A speed or pace, usually a fast one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is moving along at a good <w>clip</w>.",
                            "target_lang_translations": {
                                "ru": "Проект движется в хорошем <w>темпе</w>.",
                                "zh": "这个项目正以很快的<w>速度</w>推进。"
                            }
                        },
                        {
                            "text": "He was walking at such a fast <w>clip</w> that I struggled to keep up.",
                            "target_lang_translations": {
                                "ru": "Он шел с такой высокой <w>скоростью</w>, что я с трудом поспевал за ним.",
                                "zh": "他走路的<w>节奏</w>太快了，我都快跟不上了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at a good clip",
                        "at a fast clip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in phrases describing speed"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скорость или темп движения, обычно быстрый.",
                        "zh": "速度或步调，通常指较快的速度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темп",
                                "target_lang_sense_clarification": "скорость движения"
                            },
                            {
                                "target_lang_word": "скорость",
                                "target_lang_sense_clarification": "быстрота"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "速度",
                                "target_lang_sense_clarification": "行进或进行的快慢"
                            },
                            {
                                "target_lang_word": "节奏",
                                "target_lang_sense_clarification": "行动或推进的节律快慢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a437b8d1-7b69-3549-8969-df5c9faa85c1",
                    "sense_definition": "A metal container or frame that holds ammunition for a firearm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier loaded a fresh <w>clip</w> into the rifle.",
                            "target_lang_translations": {
                                "ru": "Солдат зарядил в винтовку новую <w>обойму</w>.",
                                "zh": "士兵往步枪里装上了一个新的<w>弹夹</w>。"
                            }
                        },
                        {
                            "text": "He checked his belt to see how many <w>clips</w> he had left.",
                            "target_lang_translations": {
                                "ru": "Он проверил пояс, чтобы узнать, сколько <w>обойм</w> у него осталось.",
                                "zh": "他检查了一下腰带，看自己还剩多少个<w>弹夹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ammo clip",
                        "rifle clip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический контейнер или рамка для патронов к огнестрельному оружию.",
                        "zh": "用于装载枪支弹药的金属夹具或容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обойма",
                                "target_lang_sense_clarification": "для патронов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹夹",
                                "target_lang_sense_clarification": "装子弹的夹具或容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120bb96d-8912-3dc9-949e-8d7b283b1299",
                    "sense_definition": "A quick, sharp blow with the hand, often given as a minor punishment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hitting_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mother gave him a <w>clip</w> round the ear for being rude.",
                            "target_lang_translations": {
                                "ru": "Мать дала ему <w>подзатыльник</w> за грубость.",
                                "zh": "因为他没礼貌，妈妈给了他一<w>巴掌</w>。"
                            }
                        },
                        {
                            "text": "He got a painful <w>clip</w> on the head during the game.",
                            "target_lang_translations": {
                                "ru": "Он получил болезненный <w>удар</w> по голове во время игры.",
                                "zh": "比赛时他头上挨了疼痛的一<w>击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whack"
                    ],
                    "common_phrases": [
                        "clip round the ear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, резкий удар рукой, часто в качестве легкого наказания.",
                        "zh": "用手快速而利落地打的一下，常作为轻微惩罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзатыльник",
                                "target_lang_sense_clarification": "удар по затылку"
                            },
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "резкий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴掌",
                                "target_lang_sense_clarification": "用手打的一下，较口语"
                            },
                            {
                                "target_lang_word": "一击",
                                "target_lang_sense_clarification": "快速而利落的一下打击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54ef6efa-7714-337c-bb56-a1b93aca0362",
                    "sense_definition": "To cut something short or trim it, usually with scissors or shears.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cutting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>clipped</w> the coupon out of the newspaper.",
                            "target_lang_translations": {
                                "ru": "Она <w>вырезала</w> купон из газеты.",
                                "zh": "她把优惠券从报纸上<w>剪下</w>来了。"
                            }
                        },
                        {
                            "text": "You should <w>clip</w> the hedges before they grow too wild.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>постричь</w> живую изгородь, пока она не разрослась слишком сильно.",
                                "zh": "你应该在树篱长得太乱之前把它<w>修剪</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clip wings",
                        "clip coupons",
                        "clip nails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрезать или подравнивать что-либо, обычно ножницами или секатором.",
                        "zh": "把某物剪短或修整，通常用剪刀或大剪子进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "ножницами из бумаги"
                            },
                            {
                                "target_lang_word": "стричь",
                                "target_lang_sense_clarification": "волосы или кусты"
                            },
                            {
                                "target_lang_word": "подрезать",
                                "target_lang_sense_clarification": "укорачивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剪下",
                                "target_lang_sense_clarification": "把纸上的一部分剪出来"
                            },
                            {
                                "target_lang_word": "修剪",
                                "target_lang_sense_clarification": "把过长的部分剪短或整理整齐"
                            },
                            {
                                "target_lang_word": "剪短",
                                "target_lang_sense_clarification": "剪短一些"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff9298ff-4d9c-34d8-8228-e7f42cd4d6f0",
                    "sense_definition": "To fasten or attach one thing to another using a clip.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>clip</w> the microphone to your shirt collar.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>прикрепите</w> микрофон к воротнику рубашки.",
                                "zh": "请把麦克风<w>夹在</w>衬衫领子<w>上</w>。"
                            }
                        },
                        {
                            "text": "He <w>clipped</w> the papers together so they wouldn't get lost.",
                            "target_lang_translations": {
                                "ru": "Он <w>скрепил</w> бумаги вместе, чтобы они не потерялись.",
                                "zh": "他把文件<w>夹在一起</w>，免得弄丢了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clip on",
                        "clip together",
                        "clip onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скреплять или прикреплять что-либо с помощью зажима или скрепки.",
                        "zh": "用夹子或类似的东西把一个物体固定到另一个物体上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикреплять",
                                "target_lang_sense_clarification": "присоединять"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "соединять вместе"
                            },
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "фиксировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夹在……上",
                                "target_lang_sense_clarification": "把某物夹到另一物上"
                            },
                            {
                                "target_lang_word": "夹在一起",
                                "target_lang_sense_clarification": "把几样东西夹到一起"
                            },
                            {
                                "target_lang_word": "别上",
                                "target_lang_sense_clarification": "别到衣服、头发等上面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d47dcf-27fa-3966-981d-c5a3d04139ad",
                    "sense_definition": "To hit or strike something lightly or at an angle while passing it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hitting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car skidded and <w>clipped</w> the side of the bridge.",
                            "target_lang_translations": {
                                "ru": "Машину занесло, и она <w>задела</w> край моста.",
                                "zh": "车打滑后<w>擦到</w>了桥边。"
                            }
                        },
                        {
                            "text": "He <w>clipped</w> the hurdle but managed to stay on his feet.",
                            "target_lang_translations": {
                                "ru": "Он <w>задел</w> барьер, но сумел устоять на ногах.",
                                "zh": "他<w>擦到</w>了栏架，但还是站稳了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clip the edge",
                        "clip the curb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задеть или ударить что-либо по касательной при движении мимо.",
                        "zh": "在经过时轻轻碰到或斜着擦到某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задеть",
                                "target_lang_sense_clarification": "коснуться при движении"
                            },
                            {
                                "target_lang_word": "зацепить",
                                "target_lang_sense_clarification": "ударить по касательной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦到",
                                "target_lang_sense_clarification": "移动时轻轻碰到或擦到"
                            },
                            {
                                "target_lang_word": "蹭到",
                                "target_lang_sense_clarification": "从一侧轻微碰到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fb6623-14ef-3071-a9ee-440429664625",
                    "sense_definition": "To create a short video segment from a longer broadcast or stream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>clipped</w> the best part of the game to share with friends.",
                            "target_lang_translations": {
                                "ru": "Я <w>вырезал</w> лучшую часть игры, чтобы поделиться с друзьями.",
                                "zh": "我<w>截取</w>了比赛里最精彩的一段，分享给朋友。"
                            }
                        },
                        {
                            "text": "Fans <w>clipped</w> the moment the streamer won the match.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>сделали клип</w> момента, когда стример выиграл матч.",
                                "zh": "粉丝们<w>截取</w>了主播赢下比赛的那一刻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clip that"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in internet and gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать короткий видеофрагмент из длинной трансляции или записи.",
                        "zh": "从较长的直播或视频中截出一小段，做成短视频片段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарезать",
                                "target_lang_sense_clarification": "делать клипы"
                            },
                            {
                                "target_lang_word": "сделать клип",
                                "target_lang_sense_clarification": "сохранить момент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "截取",
                                "target_lang_sense_clarification": "从较长视频或直播中截出一小段"
                            },
                            {
                                "target_lang_word": "剪辑成片段",
                                "target_lang_sense_clarification": "把长视频剪成可分享的短片段"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}