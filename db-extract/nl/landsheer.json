                        "entry_id": "0a61e5c3-34e6-3263-951d-01c990b10239",
                        "glosses": [
                            "een algemene benaming voor een vorst die in een bepaald gebied de territoriale soevereiniteit bezat."
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "61b7d7a8-ec8d-401a-9279-c25be49dfca6",
                                "sense_id": "84c2beb0-bb96-3171-8601-8f632a3f1243",
                                "text": "Tot 1522 was de bisschop van Utrecht de landsheer van Drenthe."
                            },
                            {
                                "example_id": "1abded8d-fee3-4a7f-9377-fd1ceec5a6ac",
                                "sense_id": "84c2beb0-bb96-3171-8601-8f632a3f1243",
                                "text": "Koning Willem I was landsheer van het Koninkrijk der Nederlanden."
                            },
                            {
                                "example_id": "94d6735b-f2a1-45e0-9256-cd19e48e2bd4",
                                "sense_id": "84c2beb0-bb96-3171-8601-8f632a3f1243",
                                "text": "Toen hoorde hij tot zijn angst en vreugde de stem van de aartsengel Gabriel als een lied van binnen uit de klif komen, een stil lied dat hem aanmaande zijn landsheer te halen want die had een nog grotere zorg."
                            }
                        ]
                    }
