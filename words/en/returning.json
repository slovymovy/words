                    "sense_id": "68786ca4-b778-300f-bf3b-1859874d186a",
                    "sense_definition": "The act of one who returns; a coming back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "return_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a time of <w>returning</w> for the soldiers who had been away for years.",
                            "target_lang_translations": {
                                "ru": "Это было время <w>возвращений</w> для солдат, которые годами не бывали дома.",
                                "pl": "To był czas <w>powrotów</w> dla żołnierzy, którzy byli z dala od domu przez całe lata."
                            }
                        },
                        {
                            "text": "The constant <w>returning</w> of the tide shaped the coastline over centuries.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>возвращение</w> прилива веками формировало береговую линию.",
                                "pl": "Nieustanne <w>powracanie</w> przypływu przez stulecia kształtowało linię brzegową."
                            }
                        }
                    ],
                    "synonyms": [
                        "return",
                        "homecoming",
                        "arrival"
                    ],
                    "antonyms": [
                        "departure",
                        "leaving"
                    ],
                    "common_phrases": [
                        "happy returnings",
                        "constant returnings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие того, кто возвращается; возвращение.",
