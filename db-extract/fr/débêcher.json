                ],
                "senses": [
                    {
                        "sense_id": "2b8c6cbf-8b17-31e0-9396-8b6fd8261c15",
                        "entry_id": "468ee353-f460-3961-b78d-8e7a8de9da7e",
                        "glosses": [
                            "Déterrer à la bêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25914699-16cc-46f4-bb2d-96e3766f4f01",
                                "sense_id": "2b8c6cbf-8b17-31e0-9396-8b6fd8261c15",
                                "text": "Ce fut mon argument quand, à la cueillette, je suis allée débêcher toute seule des Bleues d’Artois, des pommes de terre plutôt pour purée et qui sont d’une magnifique couleur violette."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0ecf424-0278-3b95-80fd-00b942c1561c",
                        "entry_id": "468ee353-f460-3961-b78d-8e7a8de9da7e",
                        "glosses": [
                            "Déterrer la bêche d’un canon pour pouvoir modifier sa direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9f964c-f39e-48c0-8aa8-0e63054f13ac",
                                "sense_id": "f0ecf424-0278-3b95-80fd-00b942c1561c",
                                "text": "Il importe donc que celles-ci puissent ouvrir le feu rapidement sur des chars qui auraient progressé sur leurs flancs ou même les attaqueraient par l’arrière sans avoir à débêcher et à changer leur affût de place, quelque rapide que puisse être cette manœuvre."
                            },
                            {
                                "example_id": "b5c697d4-e52f-4526-b1fa-477c0e35bb92",
                                "sense_id": "f0ecf424-0278-3b95-80fd-00b942c1561c",
                                "text": "Ses flèches ouvrantes lui permettent, sans débêcher de battre un front égal à sa portée."
                            },
                            {
                                "example_id": "b0ee8e12-d228-4821-8634-d67cd7129286",
                                "sense_id": "f0ecf424-0278-3b95-80fd-00b942c1561c",
                                "text": "Champ de tir en direction sans débêcher : 100 millièmes par coulissement sur l’essieu."
                            }
                        ]
                    }
                ],
