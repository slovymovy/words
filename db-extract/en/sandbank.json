                        ]
                    },
                    {
                        "translation_id": "80dc8996-af23-4025-8cf5-df6ae03b6aa6",
                        "source_entry_id": "6befb20a-c680-35f3-a171-b74786704f9d",
                        "source_sense_id": "75faaf60-3b15-3c3e-bfcb-58773bc14b0b",
                        "source_sense_description": "ridge of sand",
                        "target_lang_word": "ба́нка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ба́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e9a783cd-28cf-31d4-b572-ca2a0db41951",
                                        "entry_id": "3ea7691b-d8ae-3e36-9d32-949e5bffc461",
                                        "glosses": [
                                            "стеклянный или металлический, жестяной, реже керамический сосуд цилиндрической формы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c6a552-afad-4721-b6f5-a6f074aba13b",
                                                "sense_id": "e9a783cd-28cf-31d4-b572-ca2a0db41951",
                                                "text": "Небольшая комната — … логовище … — было почти всё заставлено всевозможными предметами, начиная от разбитых ваз и кончая пустыми жестяными банками, пустыми бутылками, колченогими табуретами, кусками материи."
                                            },
                                            {
                                                "example_id": "e613a010-624e-4d2b-bb30-30a825cefa61",
                                                "sense_id": "e9a783cd-28cf-31d4-b572-ca2a0db41951",
                                                "text": "На антресолях я нашла просто бессчётное количество банок с вареньем и соленьями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87471bc9-8959-3970-8fee-ab287189acdf",
                                        "entry_id": "3ea7691b-d8ae-3e36-9d32-949e5bffc461",
                                        "glosses": [
                                            "мед. стеклянный сосуд специальной формы, используемый в медицине для вакуумного воздействия на кожу"
                                        ],
                                        "tags": [
                                            "чаще мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e30716-7333-4b6f-ad1c-a4a362692252",
                                                "sense_id": "87471bc9-8959-3970-8fee-ab287189acdf",
                                                "text": "Эти самые люди, которые были так терпеливы в перенесении мучительнейших болей от палок и розог, нередко жаловались, кривлялись и даже стонали от каких-нибудь банок."
                                            },
                                            {
                                                "example_id": "a04beafd-cc0b-4032-9e7e-11fd0a6ed4ef",
                                                "sense_id": "87471bc9-8959-3970-8fee-ab287189acdf",
                                                "text": "Засим Риголетто погладил ладонью широкую грудь благородного отца и покрыл её всю кровососными банками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683521c6-78e2-32c1-8966-e86d548c2004",
                                        "entry_id": "3ea7691b-d8ae-3e36-9d32-949e5bffc461",
                                        "glosses": [
                                            "перен., жарг. бутылка вина, водки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afd2f77f-1c17-4a06-85ca-af40d618c6c7",
                                                "sense_id": "683521c6-78e2-32c1-8966-e86d548c2004",
                                                "text": "В общем-то, никто из нашей компании апельсинами по-настоящему не интересовался, но Вовик обещал выставить каждому по банке за общее дело."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d95308b-5f37-39c1-800c-07980b90299f",
                                        "entry_id": "3ea7691b-d8ae-3e36-9d32-949e5bffc461",
                                        "glosses": [
                                            "мн. ч., перен., сленг бицепсы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699125d9-6149-4de3-8a61-21bd0526f1dd",
                                                "sense_id": "0d95308b-5f37-39c1-800c-07980b90299f",
                                                "text": "Нам нужна сила, а не красота тела. Если вам нужно второе, то ваше место в бодибилдинге, а не в школе единоборств. Запомните: чем больше мышцы, тем вы неуклюжей. Вспомните хотя бы Брюса Ли: были у него банки, как у Шварца [Арнольда Шварценеггера], или грудак размером с гору?"
                                            },
                                            {
                                                "example_id": "b89c0ff1-f22a-4ee0-aa48-991d17c75479",
                                                "sense_id": "0d95308b-5f37-39c1-800c-07980b90299f",
                                                "text": "В первый год тренировок можно и побольше нарастить: 3–4 кг (примерно 1 см на бицепс), только в натураху такие банки не раскачаешь."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ба́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d68f0b8a-c0e0-399b-9829-9abf65260a13",
                                        "entry_id": "0cc9d68c-2f9e-3373-a4ef-fed23ba297db",
                                        "glosses": [
                                            "морск. возвышенный участок морского дна; подводная отмель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be301ca8-12f9-403f-a08c-a4885394314d",
                                                "sense_id": "d68f0b8a-c0e0-399b-9829-9abf65260a13",
                                                "text": "Мелководный Татарский пролив, отделяющий остров Сахалин от берегов Советского Приморья, тоже был мало соблазнителен со своими бесчисленными мелями, банками и перекатами."
                                            },
                                            {
                                                "example_id": "43806ed8-fb78-45bc-bf11-76cf0bfcc7df",
                                                "sense_id": "d68f0b8a-c0e0-399b-9829-9abf65260a13",
                                                "text": "Заблудившись в тумане, «Ладога» наскочила на банку."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ба́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "378f2a66-4de2-3809-8f90-587fcad20743",
                                        "entry_id": "9e15b2a0-3b0e-38bf-b19e-fbb0c44b52cc",
                                        "glosses": [
                                            "морск. сиденье для гребцов в виде поперечной доски в лодке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1501d9-cd9f-4001-9166-ad3469db6abc",
                                                "sense_id": "378f2a66-4de2-3809-8f90-587fcad20743",
                                                "text": "Другой достал из-под кормовой банки какой-то свёрток и стал развёртывать его. … Сейчас же и сам Нозиков, получивший в плечо удар ружейным прикладом, свалился на банку и стиснул от боли зубы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be286df-5333-3f9d-9291-888407c5d7fe",
                                        "entry_id": "9e15b2a0-3b0e-38bf-b19e-fbb0c44b52cc",
                                        "glosses": [
                                            "перен., спорт., жарг. скамейка запасных"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ба́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "457b24a0-7844-39c6-9351-b653c5babc1a",
                                        "entry_id": "b10d5482-6e6f-3772-950b-0267644da54c",
                                        "glosses": [
                                            "перен., жарг. удар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aca28f8-9d3c-40e5-a72c-44cbfc123e21",
                                                "sense_id": "457b24a0-7844-39c6-9351-b653c5babc1a",
                                                "text": "— Пусть врежет ей как следует! Этой подлюке давно пора надавать банок!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef2e2c4-783b-31dc-a1ff-f140701c51d7",
                                        "entry_id": "b10d5482-6e6f-3772-950b-0267644da54c",
                                        "glosses": [
                                            "перен., спорт., жарг. гол, очко"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ба́нка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75a057e9-98fe-3755-905a-316d0ada4206",
                                        "entry_id": "86a9e5a8-01e9-3fd0-9fef-161216492fe7",
                                        "glosses": [
                                            "форма родительного падежа единственного числа существительного банк"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
