                "senses": [
                    {
                        "sense_id": "4bf7c74b-9c1e-3ce9-b99a-9969ff1e0d00",
                        "entry_id": "4683763a-28ae-3415-abf3-dc921bf273d4",
                        "glosses": [
                            "een heel lief, aardig en mooi meisje of huisdier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25733614-4d6e-4120-90eb-99a662e11d69",
                                "sense_id": "4bf7c74b-9c1e-3ce9-b99a-9969ff1e0d00",
                                "text": "De Ieperse Snoezepoezen zijn 45 jaar jong. Dat werd gisteren al dansend gevierd in de stad. Na een eucharistieviering in de Sint-Pieterskerk trokken ze naar de Lakenhalle, begeleid door de fanfare van Elverdinge."
                            },
                            {
                                "example_id": "9fc78f7c-fb7c-41ba-90f6-bb39058d4a5c",
                                "sense_id": "4bf7c74b-9c1e-3ce9-b99a-9969ff1e0d00",
                                "text": "“Stil maar snoezepoes, stil maar.” Normaal noem ik nooit iemand snoezepoes. Maar in bijzijn van twee dames die kort daarvoor nog korte hoge gilletjes hadden geslaakt werd een oude behoefte weer in mij wakker. De behoefte om macho te zijn."
                            }
                        ]
                    }
                ],
