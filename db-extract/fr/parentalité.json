                        "source_entry_id": "83de4202-0cf6-3097-991c-0013197b0787",
                        "source_sense_id": "f116a139-8e96-3c78-8277-75ac00d2cd05",
                        "source_sense_description": "Soziologie, Recht: Elternschaft",
                        "target_lang_word": "Elternschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elternschaft",
