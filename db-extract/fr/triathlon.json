                                "target_senses": [
                                    {
                                        "sense_id": "b01a422a-39b3-3969-9e9f-954fa9af7993",
                                        "entry_id": "79717aca-7fe8-3642-876f-64fd7205c4e8",
                                        "glosses": [
                                            "Wettkampf, bei dem an einem Tag nacheinander lange Strecken in den Disziplinen Schwimmen, Radfahren und Laufen zu absolvieren sind"
                                        ],
                                        "tags": [
                                            "im Sommer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe29513-f453-4a39-baa3-1cb7c1136ed0",
                                                "sense_id": "b01a422a-39b3-3969-9e9f-954fa9af7993",
                                                "text": "Im Triathlon gingen über 70 Athleten an den Start."
                                            },
                                            {
                                                "example_id": "98428bb7-b12f-484d-8c6c-7b2b1076a837",
                                                "sense_id": "b01a422a-39b3-3969-9e9f-954fa9af7993",
                                                "text": "Der/Das Triathlon stellt hohe Anforderungen an die Teilnehmer."
                                            },
                                            {
                                                "example_id": "5b987350-3be2-4b7a-bf49-4ef70541a36e",
                                                "sense_id": "b01a422a-39b3-3969-9e9f-954fa9af7993",
                                                "text": "Durch die Erfolge der deutschen Triathleten Jan Frodeno und Anne Haug interessieren sich immer mehr Deutsche für Triathlon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "887f3830-c974-3c91-9e30-9d43424f4362",
                                        "entry_id": "79717aca-7fe8-3642-876f-64fd7205c4e8",
                                        "glosses": [
                                            "Wettkampf, der aus Skilanglauf, Scheibenschießen und Riesenslalom besteht"
                                        ],
                                        "tags": [
                                            "im Winter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1a7242-9f28-4f5b-bfe9-ba0cca4ea4dc",
                                                "sense_id": "887f3830-c974-3c91-9e30-9d43424f4362",
                                                "text": "Bei der winterlichen Variante des Triathlons gefällt Nico vor allem der Riesenslalom gut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
