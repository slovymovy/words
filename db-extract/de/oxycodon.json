                "senses": [
                    {
                        "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                        "entry_id": "e344acd4-d396-3a7c-824a-92357585c478",
                        "glosses": [
                            "stark wirkendes semisynthetisches Opioid mit hohem Suchtpotenzial, das vor allem als Schmerzmittel bei starken Schmerzen des Menschen angewendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af342ca-5326-49c4-a901-5571d01c522c",
                                "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                                "text": "„Court war inzwischen regelrecht abhängig von Medikamenten: Vicodin und Oxycodon, Demerol und Dilaudid.“"
                            },
                            {
                                "example_id": "e744516b-fcea-4f81-8810-f93ec33e8aea",
                                "sense_id": "83521dd2-7645-324b-bbd5-9fab47f7b47d",
                                "text": "„Der größere der Transporter-Männer gab einem der BNGs ein Zeichen, woraufhin dieser einige Päckchen Oxycodon oder Fentanyl aus der Tüte fischte und den Polizisten gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
