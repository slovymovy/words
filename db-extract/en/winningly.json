                                "example_id": "6c46f74f-6bbe-4c37-b4d4-8937110b6e6f",
                                "sense_id": "d952916e-857a-3d7e-b4f9-fedff2f4bea5",
                                "text": "The preteen stars develop an organic and winningly uncool rapport, that shared language of misfit middle-school camaraderie."
                            },
                            {
