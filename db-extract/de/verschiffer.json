                ],
                "senses": [
                    {
                        "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                        "entry_id": "bf7a3906-d3e5-3c77-8867-b46a2acf0044",
                        "glosses": [
                            "jemand, der etwas verschifft (mit einem Schiff transportieren lässt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9ab680-13fc-4099-be86-374dd60d3e58",
                                "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                                "text": "„Der vom Verschiffer eingesetzte Agent in den USA nimmt später das Auto entgegen und kümmert sich um die Ausfuhrverzollung.“"
                            },
                            {
                                "example_id": "9cc0ae5d-50f2-4e59-a853-99facd16d57b",
                                "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                                "text": "„Den Löwenanteil dessen, was ein deutscher Verbraucher für den Röstkaffee zahlt, kassieren nämlich mit glatt 75 Prozent die Verschiffer, Händler, Röster, Distributeure und der Fiskus.“"
                            },
                            {
                                "example_id": "8a7e3e92-52b8-4b3b-8dc1-af6439fa0156",
                                "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                                "text": "„Man hat heute in der Welt der Reeder und Verschiffer nicht mehr Angst vor den Schiffsfriedhöfen, in denen Schiffe arbeitslos, aus Mangel an Fracht, Monate oder gar Jahre hindurch aufgelegt wären.“"
                            },
                            {
                                "example_id": "fd4d6501-8e70-406d-b12a-7601135d3d04",
                                "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                                "text": "„Die Verschiffer bringen Autos von Berlin über Hamburg in den Nahen Osten oder nach Afrika, nach Benin, Togo, Südafrika, Nigeria.“"
                            },
                            {
                                "example_id": "6eb300ec-ecf5-4e72-91c7-825567ccc63d",
                                "sense_id": "f85cf9b2-a239-3f3b-a0a1-c5f7354d5b71",
                                "text": "„Auf der Anlage bestehe ein EDI Daten-Link zwischen Terminal und Verschiffer, die Coils würden noch auf dem Trailer oder im Binnenschiff gescannt und dann entsprechend ihrer Bestimmung und je nach Abmessung eingelagert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
