                "senses": [
                    {
                        "sense_id": "0d84b15d-23f3-33c8-ad7e-02e1dbd3d24d",
                        "entry_id": "3680be73-6db9-3d06-9dec-311552c935c9",
                        "glosses": [
                            "rijksvorst in het Heilige Roomse Rijk die het recht had om de Rooms-koning, of later de keizer, te kiezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc18aa7-c875-4ae5-b4eb-bfffffe9a797",
                                "sense_id": "0d84b15d-23f3-33c8-ad7e-02e1dbd3d24d",
                                "text": "De keurvorst van Saksen voerde al jaren oorlog met de koning van Zweden om de Poolse troon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55532730-9be5-4644-aae3-36b685e5cd4e",
                        "source_entry_id": "3680be73-6db9-3d06-9dec-311552c935c9",
                        "source_sense_id": "0d84b15d-23f3-33c8-ad7e-02e1dbd3d24d",
                        "target_lang_word": "Kurfürst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurfürst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                        "entry_id": "328e34e8-d1be-3fe6-a753-c2de7cdb3a4c",
                                        "glosses": [
                                            "ein Reichsfürst des Heiligen Römischen Reiches Deutscher Nation, der das Recht hatte, an der Wahl des römisch-deutschen Königs teilzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8695ddca-b908-4747-b5fb-e2782a266209",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„In § 1 werden zunächst die Kurfürsten verpflichtet, ihren Mitkurfürsten oder deren Wahlgesandten auf Verlangen sicheres Geleit durch ihr Gebiet und, sofern sie dazu imstande sind, auch darüber hinaus zu gewähren.“"
                                            },
                                            {
                                                "example_id": "1abc5334-8701-4461-bfbf-af9bdd4a6698",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„So sehr Kurfürst Friedrich Wilhelm nun auch bestrebt war, die durch den Krieg verursachten wirtschaftlichen Schäden zu heilen, konnte er doch dem Lande neue Lasten nicht ersparen.“"
                                            },
                                            {
                                                "example_id": "3ec1a8cb-6203-412b-a6c9-07017d9f263a",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„Jedenfalls musste der Kurfürst Truppen einsetzen, um die Rebellion niederzuschlagen.“"
                                            },
                                            {
                                                "example_id": "03e0c0cd-20e7-465e-9375-6ef1ae0f7f4e",
                                                "sense_id": "9301985c-2456-3627-8376-efeb37f27934",
                                                "text": "„Die Erzbischöfe von Köln waren mächtige Leute, Kanzler und Kurfürsten des Heiligen Römischen Reiches Deutscher Nation.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "334cdc58-3a6b-48d1-8671-21964b35a8c5",
                        "source_entry_id": "3680be73-6db9-3d06-9dec-311552c935c9",
                        "source_sense_id": "0d84b15d-23f3-33c8-ad7e-02e1dbd3d24d",
                        "target_lang_word": "Elector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c85eaf0c-1795-339f-89f1-b5a706ced73b",
                                        "entry_id": "4a87c104-932e-30cc-8c3f-e07e2cfa7c3c",
                                        "glosses": [
                                            "A German prince entitled to elect the emperor of the Holy Roman Empire; a prince-elector."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731003a9-501a-4136-b2fa-35526f8d2bce",
                                                "sense_id": "c85eaf0c-1795-339f-89f1-b5a706ced73b",
                                                "text": "In one of the conflicts, the [Holy Roman] emperor himſelf was put to flight, and very near being made priſoner by the elector of Saxony."
                                            },
                                            {
                                                "example_id": "f9836854-7f55-4239-8e13-b5eec47029f2",
                                                "sense_id": "c85eaf0c-1795-339f-89f1-b5a706ced73b",
                                                "text": "[T]he seven Imperial electors who chose the [Holy Roman] emperor controlled him by the pledges exacted from him as the price of his election. These electors were the king of Bohemia, the rulers of Saxony, Brandenburg, and the Palatinate, and the \"spiritual electors\"—the archbishops of Cologne, Trier, and Mainz."
                                            },
                                            {
                                                "example_id": "f549f9c5-f087-4819-8ca9-98679801507c",
                                                "sense_id": "c85eaf0c-1795-339f-89f1-b5a706ced73b",
                                                "text": "Hanover, seat of the electors, was an attractive small town set on the River Leine. [...] The electoral court was in residence at Herrenhausen only between May and October, so that by the beginning of November 1709 the only activity was in one of the private wings where Caroline of Ansbach, wife of the elector’s heir, had chosen to give birth to her second child."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2973e994-1bd5-44be-a816-a330f07332f6",
                        "source_entry_id": "3680be73-6db9-3d06-9dec-311552c935c9",
