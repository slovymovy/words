                        "source_entry_id": "bc13efdc-6e18-3b1a-976e-340a2e2f8946",
                        "source_sense_id": "cd90a791-8665-3e87-9bdd-e9392c4d83ec",
                        "target_lang_word": "tribunal correctionnel",
