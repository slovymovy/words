{
    "word_family": [
        "play",
        "player",
        "playfully",
        "playfulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c39b799c-710d-3966-a1fd-abce876fdec1",
                    "sense_definition": "Fond of games and amusement; prone to play frequently and lightheartedly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>playful</w> puppy chased after the tennis ball across the green lawn.",
                            "target_lang_translations": {
                                "pl": "<w>Skory do zabawy</w> szczeniak gonił piłkę tenisową po zielonym trawniku.",
                                "tr": "<w>Oyuncu</w> yavru köpek yeşil çimlerin üzerinde tenis topunun peşinden koştu."
                            }
                        },
                        {
                            "text": "Her kitten is especially <w>playful</w> in the morning when everyone wakes up.",
                            "target_lang_translations": {
                                "pl": "Jej kotek jest szczególnie <w>chętny do zabawy</w> rano, gdy wszyscy wstają.",
                                "tr": "Kedi yavrusu, özellikle sabahları herkes uyandığında çok <w>oyuncu</w> oluyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "frisky",
                        "frolicsome",
                        "lively"
                    ],
                    "common_phrases": [
                        "playful puppy",
                        "playful kitten",
                        "playful mood"
                    ],
                    "target_lang_definitions": {
                        "pl": "Lubiący zabawy, ruch i psoty; skłonny do częstego i beztroskiego bawienia się.",
                        "tr": "Oyun oynamayı ve eğlenmeyi seven; sık sık ve neşeyle oynamaya yatkın."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "skory do zabawy",
                                "target_lang_sense_clarification": "o zwierzęciu lub osobie chętnej do igraszek"
                            },
                            {
                                "target_lang_word": "swawolny",
                                "target_lang_sense_clarification": "lubiący psoty, beztroski"
                            },
                            {
                                "target_lang_word": "figlarny",
                                "target_lang_sense_clarification": "pełen energii do zabawy i psot"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "oyuncu",
                                "target_lang_sense_clarification": "oyun oynamayı seven hayvan veya çocuk"
                            },
                            {
                                "target_lang_word": "oyunbaz",
                                "target_lang_sense_clarification": "oynamaya ve eğlenmeye düşkün"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee3bf4d-478d-39e0-af96-85ef085baeb3",
                    "sense_definition": "Humorous, teasing, or jesting rather than serious.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his friend a <w>playful</w> nudge to show he was only joking.",
                            "target_lang_translations": {
                                "pl": "Trącił przyjaciela <w>żartobliwie</w> łokciem, by pokazać, że tylko żartuje.",
                                "tr": "Sadece şaka yaptığını göstermek için arkadaşını <w>şakacı bir tavırla</w> dirseğiyle dürttü."
                            }
                        },
                        {
                            "text": "She responded to the teasing question with a <w>playful</w> smile.",
                            "target_lang_translations": {
                                "pl": "Odpowiedziała na to uszczypliwe pytanie <w>figlarnym</w> uśmiechem.",
                                "tr": "Bu takılmalı soruya <w>muzip</w> bir gülümsemeyle yanıt verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "jocular",
                        "teasing"
                    ],
                    "antonyms": [
                        "serious"
                    ],
                    "common_phrases": [
                        "playful banter",
                        "playful smile",
                        "playful tease"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pełen humoru, droczący się lub żartobliwy, a nie poważny.",
                        "tr": "Ciddi olmaktan ziyade şakacı, takılmayı seven veya alaycı."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "żartobliwy",
                                "target_lang_sense_clarification": "mający charakter żartu, niepoważny"
                            },
                            {
                                "target_lang_word": "figlarny",
                                "target_lang_sense_clarification": "drobiazgowo kpiący, droczący się"
                            },
                            {
                                "target_lang_word": "filuterny",
                                "target_lang_sense_clarification": "zalotny, psotliwy"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şakacı",
                                "target_lang_sense_clarification": "ciddi olmayan, şaka yollu"
                            },
                            {
                                "target_lang_word": "muzip",
                                "target_lang_sense_clarification": "takılmayı ve şakalaşmayı seven"
                            },
                            {
                                "target_lang_word": "oyunbaz",
                                "target_lang_sense_clarification": "şaka ve yaramazlık içeren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8086900b-981b-36ff-b11c-d146fad14304",
                    "sense_definition": "Lighthearted, fun, or recreational in design or spirit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The café uses bright colors and funny signs to create a <w>playful</w> atmosphere.",
                            "target_lang_translations": {
                                "pl": "Kawiarnia wykorzystuje jasne kolory i zabawne napisy, aby stworzyć <w>wesołą</w> atmosferę.",
                                "tr": "Kafe, <w>neşeli</w> bir atmosfer yaratmak için parlak renkler ve komik tabelalar kullanıyor."
                            }
                        },
                        {
                            "text": "They solved a <w>playful</w> riddle together while waiting for the train.",
                            "target_lang_translations": {
                                "pl": "Czekając na pociąg, wspólnie rozwiązali <w>zabawną</w> zagadkę.",
                                "tr": "Treni beklerken birlikte <w>eğlenceli</w> bir bilmece çözdüler."
                            }
                        }
                    ],
                    "synonyms": [
                        "fun",
                        "whimsical"
                    ],
                    "antonyms": [
                        "somber"
                    ],
                    "common_phrases": [
                        "playful design",
                        "playful atmosphere"
                    ],
                    "target_lang_definitions": {
                        "pl": "Lekki, radosny, wesoły w formie, nastroju lub wyglądzie.",
                        "tr": "Tasarım veya ruh olarak neşeli, eğlenceli ve keyifli."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zabawny",
                                "target_lang_sense_clarification": "lekki, wywołujący uśmiech"
                            },
                            {
                                "target_lang_word": "wesoły",
                                "target_lang_sense_clarification": "pogodny, wprowadzający dobry nastrój"
                            },
                            {
                                "target_lang_word": "figlarny",
                                "target_lang_sense_clarification": "dowcipny w formie lub designie"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "neşeli",
                                "target_lang_sense_clarification": "canlı ve keyifli bir hava katan"
                            },
                            {
                                "target_lang_word": "eğlenceli",
                                "target_lang_sense_clarification": "tasarımı veya yapısı keyif veren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9f55a34-6904-377e-850a-8021e8a2ee5e",
                    "sense_definition": "Willing to experiment freely and creatively without strict adherence to rules.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect took a <w>playful</w> approach to combining traditional stone with glass.",
                            "target_lang_translations": {
                                "pl": "Architekt podszedł z dużą <w>swobodą</w> do łączenia tradycyjnego kamienia ze szkłem.",
                                "tr": "Mimar, geleneksel taş ile camı bir araya getirirken <w>özgür</w> bir yaklaşım benimsedi."
                            }
                        },
                        {
                            "text": "Her latest novel demonstrates a <w>playful</w> disregard for conventional narrative structures.",
                            "target_lang_translations": {
                                "pl": "Jej najnowsza powieść wykazuje <w>swobodne</w> lekceważenie konwencjonalnych struktur narracyjnych.",
                                "tr": "Son romanı, geleneksel anlatı yapılarına karşı <w>umursamaz</w> bir serbestlik sergiliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "experimental",
                        "unconventional"
                    ],
                    "antonyms": [
                        "rigid"
                    ],
                    "common_phrases": [
                        "playful approach"
                    ],
                    "target_lang_definitions": {
                        "pl": "Otwarty na swobodne i twórcze eksperymentowanie, bez sztywnego trzymania się reguł.",
                        "tr": "Kurallara katı bir şekilde bağlı kalmadan, özgürce ve yaratıcı bir şekilde denemeler yapmaya açık."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "swobodny",
                                "target_lang_sense_clarification": "nieograniczony sztywnymi regułami, twórczy"
                            },
                            {
                                "target_lang_word": "niekonwencjonalny",
                                "target_lang_sense_clarification": "twórczy, przełamujący schematy w luźny sposób"
                            },
                            {
                                "target_lang_word": "lekki",
                                "target_lang_sense_clarification": "pozbawiony powagi czy rygoru, otwarty"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "özgür",
                                "target_lang_sense_clarification": "katı kurallara bağlı kalmayan yaratıcı yaklaşım"
                            },
                            {
                                "target_lang_word": "sıra dışı",
                                "target_lang_sense_clarification": "geleneksel kuralları esneten"
                            },
                            {
                                "target_lang_word": "deneysel",
                                "target_lang_sense_clarification": "yaratıcı bir serbestlikle denemeler yapan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}