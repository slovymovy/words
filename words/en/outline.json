{
    "word_family": [
        "outliner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85689d8b-d476-31f7-8a42-6eeddfa15fd7",
                    "sense_definition": "A general description or plan that shows the main points or features of something but not the details.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abstract_summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote a brief <w>outline</w> of the project to show to the manager.",
                            "target_lang_translations": {
                                "ru": "Она написала краткий <w>план</w> проекта, чтобы показать его менеджеру.",
                                "zh": "她写了一份项目<w>大纲</w>给经理看。"
                            }
                        },
                        {
                            "text": "The course <w>outline</w> lists all the topics we will cover this semester.",
                            "target_lang_translations": {
                                "ru": "В <w>программе</w> курса перечислены все темы, которые мы пройдем в этом семестре.",
                                "zh": "课程<w>大纲</w>列出了我们这学期要学习的所有主题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brief outline",
                        "rough outline",
                        "course outline",
                        "project outline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее описание или план, показывающий основные моменты, но без деталей.",
                        "zh": "对某事物的概括性描述或计划，仅展示要点或特征，不包含细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "схема действий или содержания"
                            },
                            {
                                "target_lang_word": "набро́сок",
                                "target_lang_sense_clarification": "предварительный, черновой вариант"
                            },
                            {
                                "target_lang_word": "схе́ма",
                                "target_lang_sense_clarification": "структура или устройство чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大纲",
                                "target_lang_sense_clarification": "文章或计划的结构要点"
                            },
                            {
                                "target_lang_word": "概要",
                                "target_lang_sense_clarification": "内容的简要总结"
                            },
                            {
                                "target_lang_word": "草案",
                                "target_lang_sense_clarification": "初步的计划或方案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f44d40-43f1-379e-b2fd-4fce9340d963",
                    "sense_definition": "A line that marks the outer edge or boundary of an object or figure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the dark <w>outline</w> of the castle against the night sky.",
                            "target_lang_translations": {
                                "ru": "Мы видели темный <w>силуэт</w> замка на фоне ночного неба.",
                                "zh": "我们可以看到夜空中城堡黑色的<w>轮廓</w>。"
                            }
                        },
                        {
                            "text": "The artist drew the <w>outline</w> of the face before adding any details.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал <w>контур</w> лица, прежде чем добавлять детали.",
                                "zh": "艺术家在添加细节之前先画出了脸部的<w>轮廓</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sharp outline",
                        "blurred outline",
                        "draw an outline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия, обозначающая внешнюю границу объекта или фигуры.",
                        "zh": "标示物体或图形外缘或边界的线条。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́нтур",
                                "target_lang_sense_clarification": "внешняя граница предмета"
                            },
                            {
                                "target_lang_word": "очерта́ние",
                                "target_lang_sense_clarification": "вид или форма предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮廓",
                                "target_lang_sense_clarification": "物体的外形线条"
                            },
                            {
                                "target_lang_word": "外形",
                                "target_lang_sense_clarification": "物体的外部形状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f7316cd-cae3-38fd-8d13-e06b3c4b3a0e",
                    "sense_definition": "To give a summary of something, describing the main points but not the details.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor <w>outlined</w> his plans for the new city park during the meeting.",
                            "target_lang_translations": {
                                "ru": "Мэр <w>обрисовал</w> свои планы относительно нового городского парка во время встречи.",
                                "zh": "市长在会议期间<w>概述</w>了他对新城市公园的规划。"
                            }
                        },
                        {
                            "text": "This document <w>outlines</w> the safety procedures that everyone must follow.",
                            "target_lang_translations": {
                                "ru": "В этом документе <w>изложены</w> процедуры безопасности, которые все должны соблюдать.",
                                "zh": "这份文件<w>概述</w>了每个人都必须遵守的安全程序。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "outline a plan",
                        "briefly outline",
                        "outline the reasons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать краткое описание, излагая основные моменты без подробностей.",
                        "zh": "对某事进行总结，描述要点而不涉及细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрисова́ть",
                                "target_lang_sense_clarification": "описать в общих чертах"
                            },
                            {
                                "target_lang_word": "изложи́ть",
                                "target_lang_sense_clarification": "последовательно описать суть"
                            },
                            {
                                "target_lang_word": "очерти́ть",
                                "target_lang_sense_clarification": "обозначить круг вопросов или ситуацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "概述",
                                "target_lang_sense_clarification": "简要地叙述"
                            },
                            {
                                "target_lang_word": "勾勒",
                                "target_lang_sense_clarification": "用简练的语言描述大体情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf8ffdf-c4a6-34b0-91b2-8ac29376567f",
                    "sense_definition": "To draw the outer edge or shape of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall trees were <w>outlined</w> clearly against the bright orange sunset.",
                            "target_lang_translations": {
                                "ru": "Высокие деревья четко <w>вырисовывались</w> на фоне ярко-оранжевого заката.",
                                "zh": "高大的树木在橙红色的夕阳下清晰地<w>勾勒</w>出轮廓。"
                            }
                        },
                        {
                            "text": "She <w>outlined</w> the figures in black ink to make them stand out.",
                            "target_lang_translations": {
                                "ru": "Она <w>обвела</w> фигуры черными чернилами, чтобы выделить их.",
                                "zh": "她用黑墨水<w>勾勒</w>出这些图形，使它们更加突出。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "outlined against",
                        "outlined in black"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рисовать внешнюю границу или форму чего-либо.",
                        "zh": "画出某物的外部边缘或形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очерти́ть",
                                "target_lang_sense_clarification": "провести линию вокруг чего-либо"
                            },
                            {
                                "target_lang_word": "обвести́",
                                "target_lang_sense_clarification": "обрисовать по контуру"
                            },
                            {
                                "target_lang_word": "вы́делить",
                                "target_lang_sense_clarification": "сделать заметным на фоне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勾勒",
                                "target_lang_sense_clarification": "画出轮廓"
                            },
                            {
                                "target_lang_word": "描绘",
                                "target_lang_sense_clarification": "画出物体的外形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "080670c1-8ca1-36fc-9e3d-c13114825bfd",
                    "sense_definition": "To optimize computer code for size by replacing repeated code fragments with function calls.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler automatically <w>outlines</w> repetitive code blocks to save memory.",
                            "target_lang_translations": {
                                "ru": "Компилятор автоматически <w>выносит</w> повторяющиеся блоки кода для экономии памяти.",
                                "zh": "编译器会自动<w>提取</w>重复的代码块以节省内存。"
                            }
                        },
                        {
                            "text": "We decided to <w>outline</w> this function to reduce the overall binary size.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>вынести</w> эту функцию, чтобы уменьшить общий размер бинарного файла.",
                                "zh": "我们决定<w>提取</w>这个函数以减小整体二进制文件的大小。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reverse inline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оптимизировать программный код, вынося повторяющиеся фрагменты в отдельные функции.",
                        "zh": "通过将重复的代码片段替换为函数调用来优化计算机代码的大小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выноси́ть",
                                "target_lang_sense_clarification": "код в отдельную функцию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "将重复代码段移出并封装为函数"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}