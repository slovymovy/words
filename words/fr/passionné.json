    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                    "sense_definition": "Qui éprouve ou manifeste un intérêt ardent, un amour profond ou une vive émotion pour quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est une lectrice très <w>passionnée</w> qui dévore plusieurs romans chaque semaine."
                        },
                        {
                            "text": "Le professeur a prononcé un discours <w>passionné</w> devant des étudiants très attentifs."
                        }
                    ],
                    "synonyms": [
                        "ardent",
                        "fervent",
                        "enthousiaste"
                    ],
                    "antonyms": [
                        "indifférent",
                        "froid",
                        "désintéressé"
                    ],
                    "common_phrases": [
                        "être passionné par",
                        "discours passionné"
                    ]
                },
                {
                    "sense_id": "02be3571-0db8-388a-836d-aebcb2f408e1",
                    "sense_definition": "Qui manque d'objectivité ou de calme sous l'effet d'une vive émotion ou d'un parti pris prononcé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ardeur_immoderee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux ministres ont eu un échange particulièrement <w>passionné</w> sur cette réforme controversée."
                        },
                        {
                            "text": "Son jugement sur cette affaire est trop <w>passionné</w> pour être tout à fait équitable."
                        }
                    ],
                    "synonyms": [
                        "partial",
                        "enflammé",
                        "emporté"
                    ],
                    "antonyms": [
                        "impartial",
                        "neutre",
                        "objectif"
                    ],
                    "common_phrases": [
                        "débat passionné",
                        "discussion passionnée"
                    ]
                }
            ]
        },
        {
