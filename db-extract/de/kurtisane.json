                                    {
                                        "sense_id": "152a9368-a22f-3cbc-a045-23754d3f64e7",
                                        "entry_id": "1cc1aff1-8f50-375c-a973-1650950e5e30",
                                        "glosses": [
                                            "A woman regarded with love and devotion; a sweetheart."
                                        ],
                                        "tags": [],
