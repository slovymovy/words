                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b76e60d8-48f9-3248-b706-60aa66d37d3c",
                        "entry_id": "fefecbe7-f667-3dd4-8bf1-c38b127503ec",
                        "glosses": [
                            "Élément chimique de numéro atomique 66 et de symbole Dy qui fait partie de la série chimique des lanthanides et des terres rares."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e5bb514b-ec97-418c-8476-dd0218df6bf7",
                                "sense_id": "b76e60d8-48f9-3248-b706-60aa66d37d3c",
                                "text": "Le dysprosium, comme tous les lanthanides, est une terre rare."
                            }
                        ]
                    },
                    {
                        "sense_id": "253aed60-ae6b-3b0d-a8cb-b57f6ed6fe84",
                        "entry_id": "fefecbe7-f667-3dd4-8bf1-c38b127503ec",
                        "glosses": [
                            "Métal pur de cet élément, gris-argenté, malléable, ductile, assez mou, relativement stable à l’air à température ambiante."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6fa9b5b1-f491-4d44-a884-b3bfb1bd96b5",
                                "sense_id": "253aed60-ae6b-3b0d-a8cb-b57f6ed6fe84",
                                "text": "Je pense notamment au néodyme et au dysprosium, des éléments qu'on utilise dans les aimants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26280b69-f555-43fc-a2ff-167f95ffbe7d",
                        "source_entry_id": "fefecbe7-f667-3dd4-8bf1-c38b127503ec",
                        "target_lang_word": "Dysprosium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dysprosium",
