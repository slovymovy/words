                ],
                "senses": [
                    {
                        "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                        "entry_id": "037afe11-f8d0-3135-a84b-5da3acc78ea4",
                        "glosses": [
                            "Umgebung, die jemanden in eine angenehme Stimmung versetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f3bbe9-d022-43c7-a509-565bd973d490",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "Eine sanfte Rückenmassage, leise Musik im Hintergrund, Duftkerzen verbreiten angenehme Gerüche: die Betreiber des Spa haben sich um eine echte Wohlfühlatmosphäre bemüht."
                            },
                            {
                                "example_id": "314f9da2-018b-4c18-95f2-87488379cd24",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„In Leukerbad, umgeben von den Walliser Bergen, lasen letztes Wochenende Schriftstellerinnen und Schriftsteller in der Wohlfühlatmosphäre von Thermalkur- und Wellnessoasen.“"
                            },
                            {
                                "example_id": "62d85546-0586-475b-8844-20e2c23152e2",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„In der KurOase im Kloster erwartet Sie die einzigartige Kombination aus wohltuender Stille, klösterlichem Ambiente und moderner Wohlfühlatmosphäre.“"
                            },
                            {
                                "example_id": "d71df17e-3c4f-4130-9841-a44826be9a36",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„Wie schön, wenn Pflegeheime […] für den Lebensabend […] individuelle Versorgung in Wohlfühlatmosphäre versprechen.“"
                            },
                            {
                                "example_id": "90aa21f9-dd4c-4c1c-80a0-f88a302b5454",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„Besonders in der dunklen Jahreszeit schaffen hübsche Pflanzen zu Hause eine Wohlfühlatmosphäre.“"
                            },
                            {
                                "example_id": "9527a6c7-ee5b-4422-aa76-6a367bda7878",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„Viele ältere [Shopping-Center] wurden oder werden modernisiert und auf Wohlfühlatmosphäre getrimmt.“"
                            },
                            {
                                "example_id": "a3fc75a7-67cd-4fea-a07d-37fa2d5a675e",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "[Gasthaus Blumenthal in Aichach-Klingen:] „»Gut hat mir hier gefallen, dass es gelungen ist, mit einfachen Mitteln und vielen kreativen Ideen echte Wohlfühlatmosphäre entstehen zu lassen.«“"
                            },
                            {
                                "example_id": "1fdce244-3947-429d-aba1-a1968a469cf0",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„Was früher Dienstwagen und betriebliche Altersvorsorge waren, ist heute der Trend zum Arbeiten in Wohlfühlatmosphäre: Reisen im Team als Belohnung, großzügige Weihnachtsfeiern oder Yoga-Kurse in der Firma, gemeinsame Pizza-Essen und Tischfußball nach Feierabend.“"
                            },
                            {
                                "example_id": "0a2c29eb-4e04-4e40-8d66-4aab2c58d3a2",
                                "sense_id": "9057668a-7c19-3f4f-8930-d2b0cb9607ed",
                                "text": "„Akribie ist der eine Charakterzug des gebürtigen Greifswalders, auf der anderen Seite setzt der SG-Coach aber auch auf eine Wohlfühlatmosphäre, beispielsweise durch familienfreundliche Trainingszeiten […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
