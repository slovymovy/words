                "senses": [
                    {
                        "sense_id": "d845dc42-8c81-338d-b1a9-3a40a790eee7",
                        "entry_id": "a1673870-551d-3bfa-ba15-0a1b4fb6035a",
                        "glosses": [
                            "Anisette produite par la société Ricard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99daff7a-bf29-4499-a273-ecf47cca45f7",
                                "sense_id": "d845dc42-8c81-338d-b1a9-3a40a790eee7",
                                "text": "Tu penses, ce n’est pas deux ou trois ricards qui pourraient… Tu penses."
                            },
                            {
                                "example_id": "3907a153-e7a8-44ee-9f72-cc6d285aade0",
                                "sense_id": "d845dc42-8c81-338d-b1a9-3a40a790eee7",
                                "text": "Il paraîtrait aussi que les libéraux ne trient pas leurs déchets, coupent le ricard avec de la flotte, et mangent même des enfants."
                            },
                            {
                                "example_id": "ee131ff7-2e80-4176-8b63-79474f13038c",
                                "sense_id": "d845dc42-8c81-338d-b1a9-3a40a790eee7",
                                "text": "Grand merci à la Raya pour les deux, trois ricards du vendredi soir."
                            },
                            {
                                "example_id": "a13ce2d9-b1c8-4e3a-83f8-69ba67a2a55d",
                                "sense_id": "d845dc42-8c81-338d-b1a9-3a40a790eee7",
                                "text": "Alors le soir, quand ils rentrent à l’Ibis, deux, trois Ricard plus tard, ils se tapent leur assistante ou une occasionnelle. C'est glauque, c'est vrai."
                            }
                        ]
                    }
                ],
