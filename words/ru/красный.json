    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c905ee1-b3f6-3dbf-87ed-44c00831d27b",
                    "sense_definition": "Имеющий окраску одного из основных цветов спектра, соответствующий цвету крови, огня или спелой земляники.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне очень нравится этот яркий <w>красный</w> шарф.",
                            "target_lang_translations": {
                                "en": "I really like this bright <w>red</w> scarf.",
                                "de": "Mir gefällt dieser leuchtend <w>rote</w> Schal sehr."
                            }
                        },
                        {
                            "text": "Туристы обязательно посещают место, где находится <w>Красная</w> площадь.",
                            "target_lang_translations": {
                                "en": "Tourists always visit the place where <w>Red</w> Square is located.",
                                "de": "Touristen besuchen auf jeden Fall den Ort, an dem sich der <w>Rote</w> Platz befindet."
                            }
                        },
                        {
                            "text": "Осенью в лесу можно найти <w>красные</w> и жёлтые листья.",
                            "target_lang_translations": {
                                "en": "In autumn, one can find <w>red</w> and yellow leaves in the forest.",
                                "de": "Im Herbst kann man im Wald <w>rote</w> und gelbe Blätter finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "а́лый"
                    ],
                    "common_phrases": [
                        "Красная площадь",
                        "красное вино",
                        "Красная книга",
                        "красный свет"
                    ],
                    "target_lang_definitions": {
                        "en": "Having the color of one of the primary colors of the spectrum, corresponding to the color of blood, fire, or ripe strawberries.",
                        "de": "Von der Farbe Rot; mit einer der Grundfarben des Spektrums, entsprechend der Farbe von Blut, Feuer oder reifen Erdbeeren."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "red",
                                "target_lang_sense_clarification": "color"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rot",
                                "target_lang_sense_clarification": "Farbe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed5c510-f1fe-320f-b4de-2e8bc39bd13f",
                    "sense_definition": "Относящийся к революционной деятельности, к советскому строю или к коммунистической идеологии.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В музее мы видели старый <w>красный</w> флаг советской эпохи.",
                            "target_lang_translations": {
                                "en": "In the museum, we saw an old <w>red</w> flag from the Soviet era.",
                                "de": "Im Museum sahen wir eine alte <w>rote</w> Flagge aus der Sowjetzeit."
                            }
                        },
                        {
                            "text": "Легендарная <w>Красная</w> армия сыграла ключевую роль в истории страны.",
                            "target_lang_translations": {
                                "en": "The legendary <w>Red</w> Army played a key role in the country's history.",
                                "de": "Die legendäre <w>Rote</w> Armee spielte eine Schlüsselrolle in der Geschichte des Landes."
                            }
