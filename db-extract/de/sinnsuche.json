                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bac232-3773-4072-9905-5f443ecd7898",
                                                "sense_id": "bfe00aa4-2069-3a72-8a41-620caff3982d",
                                                "text": "Elbows almost touching they leaned at ease, idly reading the almost obliterated lines engraved there. ¶ \"I never understood it,\" she observed, lightly scornful. \"What occult meaning has a sun-dial for the spooney? I'm sure I don't want to read riddles in a strange gentleman's optics.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea43bc7-b82c-3aaf-b624-f6127631c984",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "The connotation associated with a word, expression, or symbol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "The purpose, value, or significance (of something) beyond the fact of that thing's existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff8a4a0-86b3-4292-b29d-8a862ac5d024",
                                                "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                                "text": "the meaning of life"
                                            },
                                            {
                                                "example_id": "2774dce5-d339-4ea8-83a5-ee6293818ca4",
                                                "sense_id": "92bab1f7-c3fe-3d28-97dc-8aefc90c2434",
                                                "text": "The number of persons attending the vigil had a lot of meaning to the families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                        "entry_id": "228fc7c0-5e83-32d9-a9e6-ecbc1069c52f",
                                        "glosses": [
                                            "Intention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "487d5859-9d00-424e-b951-83ce0cb0eb63",
                                                "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                                "text": "It was their meaning to take what they needed by strong hand."
                                            },
                                            {
                                                "example_id": "bd47323b-8fa6-43bb-ba80-ae8e5e978733",
                                                "sense_id": "58248b57-8bf9-3164-8fd9-87a486636547",
                                                "text": "[…] there was nothing in the house, what there was, was broken, the last people must have lived like pigs, what could the meaning of the landlord be?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
