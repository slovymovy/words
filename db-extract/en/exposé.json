                        "sense_id": "045e2d04-9839-3f61-879c-ba0c5b7c756b",
                        "entry_id": "e197663f-670a-363f-8cc7-7f4f3b534fd2",
                        "glosses": [
                            "The act of exposing somebody or something; a shameful showing up."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43a3fd2d-383e-41ad-8f96-8d8284a3645e",
                                "sense_id": "045e2d04-9839-3f61-879c-ba0c5b7c756b",
                                "text": "\"What shall be said to my sister? We cannot steal from her without saying something, as she would conclude we were murdered, apply to the ambassador, and bring on the very exposé we desire to avoid.\""
                            },
                            {
                                "example_id": "170187b9-4c2a-4b24-9095-4371bbb0d899",
                                "sense_id": "045e2d04-9839-3f61-879c-ba0c5b7c756b",
                                "text": "Just as with other recent reports by various bodies on HS2 and the ticket office closures, the National Audit Office's effort on the rail reform process is a devastating exposé of the failings and floundering of a dying administration that has failed to understand the value of having an efficient rail network."
                            }
                        ]
                    },
