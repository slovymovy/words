                    {
                        "sense_id": "602c94eb-5d12-3468-a955-17fe6fde490e",
                        "entry_id": "21266e7b-095e-3d9b-9242-a07bfa8578c9",
                        "glosses": [
                            "een open ruimte zonder dak, die aan alle kanten wordt omgeven door een gebouw, door muren en/of door een arcade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c75beba-3d6f-4259-bd58-28e5aadbd00a",
                                "sense_id": "602c94eb-5d12-3468-a955-17fe6fde490e",
                                "text": "Het binnenplein, een dakterras boven een lager gelegen afdeling van het ziekenhuis, kaatste de warmte van het middaguur terug."
                            },
                            {
                                "example_id": "abea72d3-6d4a-4bd0-8992-73b7b3036b1d",
                                "sense_id": "602c94eb-5d12-3468-a955-17fe6fde490e",
                                "text": "Het onderzoek richtte zich in de eerste plaats op een binnenplein. De politie kreeg hulp van deskundigen van defensie die gespecialiseerd zijn in het zoeken naar verborgen ruimtes."
                            }
                        ]
                    }
