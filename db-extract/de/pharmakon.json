                ],
                "senses": [
                    {
                        "sense_id": "65538bce-564e-3e5b-b647-f63849831d47",
                        "entry_id": "72a1e4ae-35b7-37b0-8166-c7a1bfa7c0af",
                        "glosses": [
                            "Stoff oder Stoffgemisch, das die Vitalfunktion von Zellgewebe, Organen oder Organismen positiv oder negativ beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762cae0d-12f0-4488-9970-cf5153a867f2",
                                "sense_id": "65538bce-564e-3e5b-b647-f63849831d47",
                                "text": "„Ein Pharmakon mit einer hohen Potenz zeigt auch bei geringer Konzentration bereits eine große Wirkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f6be835-1c61-3a01-b214-5f2724fad474",
                        "entry_id": "72a1e4ae-35b7-37b0-8166-c7a1bfa7c0af",
                        "glosses": [
                            "Stoff, der zu therapeutischen, diagnostischen oder prophylaktischen Zwecken eingesetzt wird; Stoff mit therapeutisch nützlicher Wirkung"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "c716ebab-393c-410c-b21d-fef3b6c7216e",
                                "sense_id": "2f6be835-1c61-3a01-b214-5f2724fad474",
                                "text": "„Die Belastung wird durch die Gabe eines vasodilatativen Pharmakons simuliert, z. B. durch Gabe von Adenosin oder Dipyridamol.“"
                            },
                            {
                                "example_id": "0c74780c-699d-4cf1-afea-813ed01a2df0",
                                "sense_id": "2f6be835-1c61-3a01-b214-5f2724fad474",
                                "text": "„Außerdem ist die Agentur für die Kompensation aller Leidtragenden von Arzneimittelnebenwirkungen sowie Infektionen, die durch die Verabreichung von Pharmaka oder biotechnologischen Produkten entstanden sind, zuständig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "82388a72-0726-3cef-9ab8-e6335f90b48d",
                        "entry_id": "72a1e4ae-35b7-37b0-8166-c7a1bfa7c0af",
                        "glosses": [
                            "Zauber-, Liebestrank"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
