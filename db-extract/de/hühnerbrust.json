                "senses": [
                    {
                        "sense_id": "0c60ccc7-bc18-3754-98dc-ff61dedeff63",
                        "entry_id": "d97563cf-8463-3122-820f-c1f96bf9cba9",
                        "glosses": [
                            "auffallend schmale Brust eines Mannes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7554675a-ea7c-421a-939c-19c9fe7c1c05",
                                "sense_id": "0c60ccc7-bc18-3754-98dc-ff61dedeff63",
                                "text": "Er hat schon eine Hühnerbrust, trainiert sieht anders aus."
                            },
                            {
                                "example_id": "78c66548-e723-4d68-b80a-7c7b1ea48311",
                                "sense_id": "0c60ccc7-bc18-3754-98dc-ff61dedeff63",
                                "text": "„Jemand mit einer Hühnerbrust, der auf Säbelbeinen unruhig durch den Raum wanderte, blieb stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "80813a59-f32b-3c37-8947-6b4da92abfbe",
                        "entry_id": "d97563cf-8463-3122-820f-c1f96bf9cba9",
                        "glosses": [
                            "Kielbrust, Missgestaltung des Brustkorbs (pectus carinatum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7924f9f-2e64-43d2-b31b-1689ac377e51",
                                "sense_id": "80813a59-f32b-3c37-8947-6b4da92abfbe",
                                "text": "Als Hühnerbrust bezeichnet man eine Fehlbildung des knöchernen Thorax, bei der das Brustbein unphysiologisch weit nach vorne reicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1a94b5af-185b-378c-acb8-d214b39eca04",
                        "entry_id": "d97563cf-8463-3122-820f-c1f96bf9cba9",
                        "glosses": [
                            "Brustfleisch vom Haushuhn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4705d81a-db66-43dc-9623-d9e367f141b0",
                                "sense_id": "1a94b5af-185b-378c-acb8-d214b39eca04",
                                "text": "Zum Mittagessen gibt es gebratene Hühnerbrust mit Kartoffeln."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
