                        "glosses": [
                            "Caractère de celui qui est insociable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5662e2c-ecf0-4039-938e-0852b81e7c90",
                                "sense_id": "79cbacbb-54f2-3434-acd2-aaa579a49fea",
                                "text": "Tout se passe comme si notre caractère sociable innervait l’insociabilité comme son reflux naturel, comme sa symétrie."
                            },
                            {
                                "example_id": "73b0ca93-0276-4d0a-8411-f4c9ce25e797",
                                "sense_id": "79cbacbb-54f2-3434-acd2-aaa579a49fea",
                                "text": "Dans la salle à manger […], une douzaine de petites tables égaillées, nappées de grosses toiles basque, rassurèrent mon insociabilité. Point de beurre en coquilles, point de maître d'hôtel en frac noir-verdâtre, point de porte-bouquets parcimonieux comportant une anthémis, une anémone fatiguée, un brin de mimosa."
                            }
                        ]
                    }
