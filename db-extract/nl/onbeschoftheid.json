                "senses": [
                    {
                        "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                        "entry_id": "d355e489-4aab-3086-8f4b-650d0dfd0bb4",
                        "glosses": [
                            "grove, brutale, hinderlijke en beledigende handeling of uiting; een respectloze handeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620799ba-4513-4111-984b-20540a0c2dba",
                                "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                                "text": "Zo gewend zijn wij al aan de onbeschoftheid , de ongrondwettelijkheid, het onversneden racisme, de haat, de vuilspuiterij, dat we pas weer opveren als een buitenlandse verslaggever zich verwondert over de verlegde grenzen in het Nederlandse debat."
                            },
                            {
                                "example_id": "83141daa-93d4-4375-861c-0f484f60d215",
                                "sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                                "text": "Waar in 2008 nog een kwart van de bevolking het gevoel had slecht behandeld te worden door personeel, was dat het afgelopen jaar nog maar 14 procent. Ook ervoeren minder Nederlanders onbeschoftheid door mensen op straat en overheidspersoneel. Het CBS doet de Veiligheidsmonitor jaarlijks in opdracht van het Ministerie van Justitie. Hiervoor houdt het bureau een grootschalige enquête onder tachtigduizend Nederlanders, waarin specifiek wordt gevraagd naar hun beleving van overlast en veiligheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0830dfb-920b-470d-b2ba-04e04246cdda",
                        "source_entry_id": "d355e489-4aab-3086-8f4b-650d0dfd0bb4",
                        "source_sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                        "source_sense_description": "brutaal gedrag",
                        "target_lang_word": "Unverschämtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverschämtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                        "entry_id": "c0f6172c-7979-3e33-af15-40de47641b86",
                                        "glosses": [
                                            "ohne Plural: unverschämte Haltung, unverschämtes Wesen einer Person; das Unverschämtsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84444a48-ce50-4051-801b-e511135af95d",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "Das ist wohl eine Unverschämtheit! Jetzt setzt der Typ schon wieder einen fehlerhaften Artikel ein und hofft auf Verbesserung seiner Fehler."
                                            },
                                            {
                                                "example_id": "ce00e653-6a47-4ae2-9077-37fc0a5d1519",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "Es ist keine Unverschämtheit! Denn ich setzte den Artikel mit gutem Gewissen ein und bin dankbar, dass meine Fehler verbessert werden, die ich aus Unwissenheit machte oder übersah!"
                                            },
                                            {
                                                "example_id": "e5766c9b-b980-4609-91b7-38231632e27a",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "„Er durchbrach in aufreizender Unverschämtheit die über meinem Haus befindliche Schallmauer und verursachte dabei einen Knall, der als überwältigend bezeichnet werden muss.“"
                                            },
                                            {
                                                "example_id": "6e53e29f-f8ee-4609-a33a-6d524e28ecc1",
                                                "sense_id": "fef5f07a-e358-3e39-a383-b9f7f6d1a891",
                                                "text": "„Das halb konfiszierte Schelmengesicht, in dem ein Zug von Gutmütigkeit mit einer derben Portion irischer Unverschämtheit und unbezwingbarer Laune sich spiegelte, hatte die ganze Eskorte allmählich in eine Stimmung versetzt, die, so ernst sie anfangs war, das Lachen kaum mehr unterdrücken konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                        "entry_id": "c0f6172c-7979-3e33-af15-40de47641b86",
                                        "glosses": [
                                            "unverschämte Aussage oder Haltung; etwas Unverschämtes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ca8db3-f1ad-420d-ab9b-a61001f0c857",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "Das ist wohl eine Unverschämtheit! Jetzt setzt der Typ schon wieder einen fehlerhaften Artikel ein und hofft auf Verbesserung seiner Fehler."
                                            },
                                            {
                                                "example_id": "e7500d9c-42b9-4e7a-9ddb-eb998979628a",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "Es ist keine Unverschämtheit! Denn ich setzte den Artikel mit gutem Gewissen ein und bin dankbar, dass meine Fehler verbessert werden, die ich aus Unwissenheit machte oder übersah!"
                                            },
                                            {
                                                "example_id": "e6ec8c37-519b-4190-a899-0cdef72f9afe",
                                                "sense_id": "9978a36e-3452-3da9-aa88-fe0ed408e7fc",
                                                "text": "„Die Schwester ging hinaus, um zu sehen, wer sich diese Unverschämtheit erlaubt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9ff09cb-f648-481b-ab14-95007c78dc0c",
                        "source_entry_id": "d355e489-4aab-3086-8f4b-650d0dfd0bb4",
                        "source_sense_id": "53da229a-ea67-363f-8f6e-9b59dad82ccf",
                        "source_sense_description": "brutaal gedrag",
                        "target_lang_word": "Unverfrorenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unverfrorenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c72bc2e-6b04-3edf-8e16-b7e42601e81a",
                                        "entry_id": "36e1b948-28e1-391d-b73b-b828a2440495",
                                        "glosses": [
                                            "Eigenschaft, ohne Bedenken offen und rücksichtslos zu sprechen oder zu handeln"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ffab105-10bd-4f00-bf4f-f3f67de9751a",
                                                "sense_id": "5c72bc2e-6b04-3edf-8e16-b7e42601e81a",
                                                "text": "„Chomskys Unverfrorenheit und seinen Hang zu solchen exotischen altweltlich-osteuropäischen Lebensanschauungen fanden die meisten amerikanischen Intellektuellen damals charmant.“"
                                            },
                                            {
                                                "example_id": "e07f4670-76e7-4152-b85c-fe6fae939144",
                                                "sense_id": "5c72bc2e-6b04-3edf-8e16-b7e42601e81a",
                                                "text": "„Sicher wußte ich nur, daß Bellino mir im Bett nicht entwischen konnte, selbst wenn er die Unverfrorenheit besitzen sollte, sich nicht entkleiden zu wollen.“"
                                            },
                                            {
                                                "example_id": "82bb0a4a-01fe-4eb4-aef9-f78eb1e89401",
                                                "sense_id": "5c72bc2e-6b04-3edf-8e16-b7e42601e81a",
                                                "text": "„Peinlich, peinlich, denkt so mancher, doch können sich die Anwohner angesichts solcher Unverfrorenheit auch einer gewissen Bewunderung nicht erwehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73f3caab-fd76-3e62-a780-4e762271c9b4",
                                        "entry_id": "36e1b948-28e1-391d-b73b-b828a2440495",
                                        "glosses": [
                                            "einzelne Handlung, ohne Bedenken offen und rücksichtslos zu sprechen oder zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [],
