                                    {
                                        "sense_id": "e61e6758-d830-32bd-b2a8-2484912ccd50",
                                        "entry_id": "20bf1b92-4259-379e-86fb-99938d7542dc",
                                        "glosses": [
                                            "Having possession/ownership of one or more slaves."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "slaveholding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff2d94f-b3c9-335a-89bf-e8b84b57497b",
                                        "entry_id": "080f4eff-7d62-3fde-9c8b-fba19e66c554",
                                        "glosses": [
                                            "The institution or practice of owning slaves."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cadf75e-9287-4959-a4f6-8072cb01048e",
                                                "sense_id": "eff2d94f-b3c9-335a-89bf-e8b84b57497b",
                                                "text": "The slaveholding way of life continued until 1865, when the Thirteenth Amendment to the U.S. Constitution was passed following the end of the Civil War between the Northern and the Southern states"
                                            },
                                            {
                                                "example_id": "e1acfff2-231f-42f7-8e4b-a3edc78bacf7",
                                                "sense_id": "eff2d94f-b3c9-335a-89bf-e8b84b57497b",
                                                "text": "Defenders of Southern slavery employed religious rhetoric to justify the system, selecting biblical passages that appeared to condone the practice of slaveholding and the relation between master and slave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2581fc56-ed0c-3e92-a3b1-dbb25981d019",
                                        "entry_id": "080f4eff-7d62-3fde-9c8b-fba19e66c554",
                                        "glosses": [
                                            "An owning of one or more slaves."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a67514c-04a3-4696-8008-a40944274fef",
                                                "sense_id": "2581fc56-ed0c-3e92-a3b1-dbb25981d019",
                                                "text": "On the other hand, the Mountain South also contained some Lower South counties, thereby permitting internal comparisons between differently sized slaveholdings, between crop specializations, and between agricultural and nonagricultural producers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
