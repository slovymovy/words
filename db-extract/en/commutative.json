                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7080d8e8-b4e0-4a95-87e1-fbec139e5de3",
                                                "sense_id": "cba54c3d-0c7a-3f1d-84fe-da3357cdc52e",
                                                "text": "L’addition et la multiplication des nombres complexes sont des opérations commutatives."
                                            },
                                            {
                                                "example_id": "31c5ca55-ca1a-4c74-a902-63cc1fd75cf0",
                                                "sense_id": "cba54c3d-0c7a-3f1d-84fe-da3357cdc52e",
                                                "text": "La multiplication des quaternions n'est pas commutative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0957b2-b68b-3f90-9226-beea2fdc7281",
                                        "entry_id": "b7502319-5089-3568-9029-2780e4d7c2b8",
                                        "glosses": [
                                            "Qualifie une structure algébrique muni d'une loi de composition interne commutative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b2ef39-9d70-4a9c-b9e8-5dee0a488193",
                                                "sense_id": "db0957b2-b68b-3f90-9226-beea2fdc7281",
                                                "text": "un groupe commutatif est aussi appelé groupe abélien"
                                            },
                                            {
                                                "example_id": "dd22e57b-8be8-47da-9700-6e7d0f2566bc",
                                                "sense_id": "db0957b2-b68b-3f90-9226-beea2fdc7281",
                                                "text": "un anneau intègre est un anneau commutatif unitaire"
                                            }
                                        ]
