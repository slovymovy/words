                    {
                        "translation_id": "36dc162a-95a7-43c0-b77e-b2ca9f67cf69",
                        "source_entry_id": "77aa13a1-91ce-30cc-b4bd-ef8b63b4e80d",
                        "source_sense_id": "1647a2f0-55a8-382e-9a8c-e27ab1a31896",
                        "source_sense_description": "нареч. к грустный",
                        "target_lang_word": "traurig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traurig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5be68b2-d8a4-37f4-861d-2948fdd509af",
                                        "entry_id": "2c49ef2e-e10f-37ea-a9d5-bc2e97ab542b",
                                        "glosses": [
                                            "betrübt, niedergeschlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9b4aa9-10a3-467a-a13a-436cef6a6695",
                                                "sense_id": "f5be68b2-d8a4-37f4-861d-2948fdd509af",
                                                "text": "Warum bist Du heute so traurig?"
                                            },
                                            {
                                                "example_id": "d7b9d346-f42c-43da-82ab-e89cd0dc99ce",
                                                "sense_id": "f5be68b2-d8a4-37f4-861d-2948fdd509af",
                                                "text": "Ich habe neulich einen sehr traurigen Film gesehen."
                                            },
                                            {
                                                "example_id": "8fb5382c-6b8b-467d-852c-d81b4006df78",
                                                "sense_id": "f5be68b2-d8a4-37f4-861d-2948fdd509af",
                                                "text": "Die Menschen die traurig sind, fühlen sich niedergeschlagen, betrübt und haben meistens auch keine Lust auf Unternehmungen."
                                            },
                                            {
                                                "example_id": "577e7588-a6c3-4c83-a475-d61998038eba",
                                                "sense_id": "f5be68b2-d8a4-37f4-861d-2948fdd509af",
                                                "text": "„Wenn ich die Route geschafft habe, bin ich kurz glücklich, bald darauf aber traurig, weil ich einen Traum realisiert habe und dieser somit nicht mehr existiert, zitiert Zak den Freikletterer A. Albert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50347e3b-1ddc-30b5-902f-56b45787149f",
                                        "entry_id": "2c49ef2e-e10f-37ea-a9d5-bc2e97ab542b",
                                        "glosses": [
                                            "erbarmungswürdig, beklagenswert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa5980e-8b1d-4f2c-b7a4-6b73339cf34d",
                                                "sense_id": "50347e3b-1ddc-30b5-902f-56b45787149f",
                                                "text": "„Wenn ich die Route geschafft habe, bin ich kurz glücklich, bald darauf aber traurig, weil ich einen Traum realisiert habe und dieser somit nicht mehr existiert, zitiert Zak den Freikletterer A. Albert.“"
                                            },
                                            {
                                                "example_id": "e84e61ff-ad56-4f43-ab14-580089959612",
                                                "sense_id": "50347e3b-1ddc-30b5-902f-56b45787149f",
                                                "text": "Die Wohnung ist in einem traurigen Zustand: Schimmel an den Wänden, Unordnung und alles total versifft!"
                                            },
                                            {
                                                "example_id": "1b581124-3b81-4421-896d-e1484d07ca9c",
                                                "sense_id": "50347e3b-1ddc-30b5-902f-56b45787149f",
                                                "text": "Die vielen kranken Kinder waren ein sehr trauriger Anblick."
                                            },
                                            {
                                                "example_id": "13ec665d-750c-4531-937d-284ad8a8cf05",
                                                "sense_id": "50347e3b-1ddc-30b5-902f-56b45787149f",
                                                "text": "„Im Spätsommer 2010 erlangte Muzaffargarh als die am schwersten von der Jahrhundertflut betroffene Region traurige Bekanntheit, allerdings nicht nur durch die Naturkatastrophe selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
