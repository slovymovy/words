                        "cross_references": [
                            {
                                "target_word": "houmous",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                        "entry_id": "e4a51fa0-bae2-3b21-a91a-3bfa65a68744",
                                        "glosses": [
                                            "Préparation culinaire du Moyen-Orient, composée notamment de purée de pois chiches et de tahini (aussi appelé « tahina »)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7adf06cc-0e13-4e68-80e1-0ca0153bff6d",
                                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                                "text": "Ce café-bar rétro au style décalé mitonne salades, sandwichs, quiches, houmous, assiettes de fromage et de charcuterie et nombreux plats végétariens pour une clientèle tendance."
                                            },
                                            {
                                                "example_id": "73d480f0-3a7a-4fe1-a8d8-94c9cd8df117",
                                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                                "text": "Je commande toujours la même chose : du houmous allégé avec des graines germées et deux tranches de pain aux flocons d'avoine ([…])."
                                            },
                                            {
                                                "example_id": "adb28d3a-cc70-49bb-a07a-1a1c85e9ad77",
                                                "sense_id": "69182df4-447c-3cd8-8096-771ee7c91186",
                                                "text": "Le rayon oriental […] alignait tout de même huit variétés différentes de houmous dont l’abugosh premium, le misadot, le zaatar et le rarissime mesabecha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a20ac03-955a-4fa0-93bd-e1b2e9f0ad3c",
