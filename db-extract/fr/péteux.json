                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ad1e765-26d8-3b1a-870e-526114ac94ab",
                        "entry_id": "0f16044f-83a7-35b4-b5c1-f0c750b7955b",
                        "glosses": [
                            "Personne pleutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e0f7e6-fa10-4623-a140-76ff380b673d",
                                "sense_id": "3ad1e765-26d8-3b1a-870e-526114ac94ab",
                                "text": "Il s’est laissé chasser comme un péteux."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3898134-25cb-380a-a206-a67922df58d7",
                        "entry_id": "0f16044f-83a7-35b4-b5c1-f0c750b7955b",
                        "glosses": [
                            "Personne prétentieuse et snob, quelqu’un qui se la pète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14df3b1d-ac6f-4923-bcff-4fc7226446d6",
                                "sense_id": "a3898134-25cb-380a-a206-a67922df58d7",
                                "text": "Jed ressentit une déception humaine obscure à l’idée de cet homme abandonnant la plomberie, artisanat noble, pour louer des engins bruyants et stupides à des petits péteux bourrés de fric habitant rue de la Faisanderie."
                            },
                            {
                                "example_id": "9dc2f815-a4bb-4b4c-b2cf-22cec3540d7e",
                                "sense_id": "a3898134-25cb-380a-a206-a67922df58d7",
                                "text": "« Oh la péteuse !\n— Qu’est-ce qu’elle fait vulgaire ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c92db5e-735b-4144-a87d-9e0ff96e9b66",
                        "source_entry_id": "0f16044f-83a7-35b4-b5c1-f0c750b7955b",
                        "target_lang_word": "Scheißer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheißer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "536c7ff1-7a72-3b23-a2b7-1faa6dad192a",
                                        "entry_id": "c44274a9-dda6-3582-a989-6b6094ac23eb",
                                        "glosses": [
                                            "unangenehmer (unaufrichtiger, betrügerischer, widerlicher) Mensch"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c6c2ae-9110-4b06-9788-b098c9ccae0a",
                                                "sense_id": "536c7ff1-7a72-3b23-a2b7-1faa6dad192a",
                                                "text": "Ej, du Scheißer! Zieh Leine!"
                                            },
                                            {
                                                "example_id": "2017f1d0-8696-4164-83b2-f4349b698f4a",
                                                "sense_id": "536c7ff1-7a72-3b23-a2b7-1faa6dad192a",
                                                "text": "Hat der kleine Scheißer mir doch meine Uhr geklaut!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78a4b206-52a0-38c6-b529-94942f907081",
                                        "entry_id": "c44274a9-dda6-3582-a989-6b6094ac23eb",
                                        "glosses": [
                                            "unwichtiger Mensch, der in diesem Zusammenhang keine Rolle spielt"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1be6ff-5c1c-42d5-bcfa-dabbb366ab5f",
                                                "sense_id": "78a4b206-52a0-38c6-b529-94942f907081",
                                                "text": "Jedenfalls habe ich dem Scheißer erzählt, dass er mich mal kann."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "89c67e6e-13ed-3ca8-be07-2324b7581e8c",
                                        "entry_id": "c44274a9-dda6-3582-a989-6b6094ac23eb",
                                        "glosses": [
                                            "kleines Kind (das noch eine Windel trägt)"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a804216-52a5-49f2-8db8-29ad89925ceb",
                                                "sense_id": "89c67e6e-13ed-3ca8-be07-2324b7581e8c",
                                                "text": "Na, mein kleiner Scheißer, nun müssen wir noch brav Bäuerchen machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "49083ded-b420-334d-a40e-4da1eb104112",
                                        "entry_id": "c44274a9-dda6-3582-a989-6b6094ac23eb",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e507360-ae1a-43af-8155-7d34158a5351",
                                                "sense_id": "49083ded-b420-334d-a40e-4da1eb104112",
                                                "text": "Wenn er nicht so ein Scheißer gewesen wären, dann hätte er bei uns mitgemacht und dann hätte er jetzt auch Kohle."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
