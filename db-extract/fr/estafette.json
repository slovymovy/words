                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1b9031-823a-4bdd-8b67-2b98f1f3bf9f",
                                                "sense_id": "12f07518-f161-3d66-b771-7b630a2b8437",
                                                "text": "You can always find musicians. There are more trackers than coders, pixelers, organizers, couriers, and designers combined."
                                            },
                                            {
                                                "example_id": "714eed60-a873-4afd-9d30-121bd1b6c5b0",
                                                "sense_id": "12f07518-f161-3d66-b771-7b630a2b8437",
                                                "text": "These sites have enormous hard drives and bandwidth for couriers to distribute the software from one site to the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "effd5e58-2cdb-3766-a826-b5b6dda5c9ce",
                                        "entry_id": "ac43a92e-1038-3a9f-8bf8-7eae8f2976a6",
                                        "glosses": [
                                            "A person who looks after and guides tourists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1045a4c-c1f8-4840-bdd7-3d832a9b1b87",
                                                "sense_id": "effd5e58-2cdb-3766-a826-b5b6dda5c9ce",
                                                "text": "\"A courier!\" cried Muscari, laughing. \"Is that the last of your list of trades? And whom are you conducting?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b697250-86bc-3d30-8ad9-bdb10c4904d4",
                                        "entry_id": "ab6151fa-03a2-310d-9d4f-92c3a5531bba",
