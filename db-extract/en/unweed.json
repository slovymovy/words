                        "glosses": [
                            "To remove weeds from; to weed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe6a91c-79d8-47b0-af19-ecf9bf41e922",
                                "sense_id": "82c70f5a-cb7d-3713-a789-42570cc30c37",
                                "text": "Then now's the time, while you've a chance Hanging o'er you, To unweed your mind of Ignorance — Look before you !"
                            },
                            {
                                "example_id": "13ff27c9-1b6d-4188-9854-4261ffe2d088",
                                "sense_id": "82c70f5a-cb7d-3713-a789-42570cc30c37",
                                "text": "He is so diligently engaged in unweeding the soil that he has not given a thought to what he will grow there."
                            },
                            {
                                "example_id": "4773ecca-3c94-43ac-8466-52c34a13b2a8",
                                "sense_id": "82c70f5a-cb7d-3713-a789-42570cc30c37",
                                "text": "We need to cultivate our own gardens, to “unweed” our own “seed-beds” before we presume to colonize the world."
                            }
                        ]
                    }
                ],
