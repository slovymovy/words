                "translations": [
                    {
                        "translation_id": "4658144a-0cea-43df-812c-7cd78c72454d",
                        "source_entry_id": "9c201432-326e-3d13-8a6f-601489d5f868",
                        "source_sense_id": "51f5bbfc-ef26-3ce2-b3fd-88753bbe3d1a",
                        "target_lang_word": "disjunctive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disjunctive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4657c06f-ac34-3757-bb2d-a4bb500ac19e",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Not connected; separated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896ab869-8544-485a-9aad-13752d5925e9",
                                                "sense_id": "4657c06f-ac34-3757-bb2d-a4bb500ac19e",
                                                "text": "That broken comb exemplifies the apparently inexhaustible strength of the novel's flotsam, its disjunctive detail which makes nevertheless for tonal coherence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b03ac1-3b4f-3810-90f5-9e9ef56ef48d",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Not used in immediate conjunction with the verb of which the pronoun is the subject."
                                        ],
                                        "tags": [
                                            "of a personal pronoun"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d28c111-4e65-3026-8154-564f907a5918",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Tending to join (two clauses), but in a way that conveys a disjunct within the conjoined relationship."
                                        ],
                                        "tags": [
                                            "of a conjunction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb07835e-548a-47b7-9b82-8304547b7b9d",
                                                "sense_id": "4d28c111-4e65-3026-8154-564f907a5918",
                                                "text": "The words \"but\" and \"or\" are disjunctive conjunctions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6d0876-b711-3025-86b9-043b7ce80bcc",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Tending to disjoin; separating."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22bfcb58-b129-37b9-b905-287618830a93",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Relating to disjunct tetrachords."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4697e2c9-cdf9-45c6-9fd8-b2def2c3880b",
                                                "sense_id": "22bfcb58-b129-37b9-b905-287618830a93",
                                                "text": "[…] that the phrase should be articulated in one breath; failing this, Quantz recommends that breath should be taken wherever possible on tied notes, between disjunctive notes of continuous semiquavers or at other equivalent moments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba19cef6-63f3-35f0-8f83-9493947245f8",
                                        "entry_id": "7cbf368f-19c8-38f8-9f0a-100a832eaf3f",
                                        "glosses": [
                                            "Of or related to a disjunction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b1765a-9ce4-4a09-b173-e5def44c35dd",
                                                "sense_id": "ba19cef6-63f3-35f0-8f83-9493947245f8",
                                                "text": "An opposition of contrariety is not of purely logical concernment; and a disjunctive syllogism with characters opposed in contrariety, in fact, consists of as many pure disjunctive syllogisms as there are opposing predicates."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disjunctive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8780b04-3c81-3be8-904e-ca9d5ec2a88e",
                                        "entry_id": "fb6ed1b1-8880-39fe-a432-1c443e2cd795",
                                        "glosses": [
                                            "A disjunction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d7c9c7-747c-4599-8f1e-3afbe66e133e",
                                                "sense_id": "f8780b04-3c81-3be8-904e-ca9d5ec2a88e",
                                                "text": "L. H. Atwater\nDisjunctives may be turned into conditionals."
                                            }
