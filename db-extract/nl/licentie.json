                                        "entry_id": "87f9253b-faa4-3be2-9358-cfb519907270",
                                        "glosses": [
                                            "UK, Canada, Australia, South Africa, Ireland, New Zealand, Malaysia, and Singapore standard spelling of license."
                                        ],
