                                "text": "De moeder aaide haar zoontje over zijn bolleke."
                            }
                        ]
                    },
                    {
                        "sense_id": "85fb87fd-263f-30da-beb7-ba9a719d208c",
                        "entry_id": "a1c3bbba-5f7c-3890-955b-c6aa312e2b95",
                        "glosses": [
