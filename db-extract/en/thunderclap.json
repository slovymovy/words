                                        "entry_id": "11743d0a-f684-3dc5-9eb3-3c7232231dde",
                                        "glosses": [
                                            "kurzer, sehr heftiger Donner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa5d836-7c78-4916-89a9-42721117379b",
                                                "sense_id": "5b703cce-4922-3005-a480-a2dc78c2871b",
                                                "text": "„Später, im Geschwader, erzählte man mir, es habe fürchterlich gedonnert, aber ich erinnere mich nicht, auch nur einen Donnerschlag gehört zu haben, nachdem ich ins Wasser gesprungen war.“"
                                            },
                                            {
                                                "example_id": "054a551e-3e4b-4431-af13-edbcd22c21c0",
                                                "sense_id": "5b703cce-4922-3005-a480-a2dc78c2871b",
                                                "text": "„Als zu dem Regen noch ein Donnerschlag ertönte, zuckten die Tiere zusammen.“"
                                            },
                                            {
                                                "example_id": "d06064b7-dc5c-4291-bbc6-363a01cc2519",
                                                "sense_id": "5b703cce-4922-3005-a480-a2dc78c2871b",
                                                "text": "„Um 22.30 Uhr beleuchtete ein ungewöhnlich heller Blitz die Palisaden ein kurzes Stück vor ihnen, und sie hatten das Tor noch nicht erreicht, da krachte ein fürchterlicher Donnerschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
