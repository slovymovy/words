                ],
                "senses": [
                    {
                        "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                        "entry_id": "22da432c-ce16-3c84-afbc-fbde401a570e",
                        "glosses": [
                            "Hervorhebung des Wortstamms durch Betonung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4458eb-638b-47cf-a61f-7ab010cfd19d",
                                "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                                "text": "„Die bisher besprochenen Typen von Angloromanismen haben sämtlich Stammbetonung, während bei den Romanismen Suffixbetonung vorliegt.“"
                            },
                            {
                                "example_id": "f6997244-f294-46ed-8c07-e368191bf6a8",
                                "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                                "text": "„Stammbetonung ist Grundregel für deutsche Zeitwörter.“"
                            },
                            {
                                "example_id": "33cf4efc-caf8-455a-bc4a-8e9cc3fb0e71",
                                "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                                "text": "„Bei der Vorverlagerung des Akzentes ergibt sich immer Stammbetonung, wobei die Ausgangsform selbst Stamm- oder aber Suffixbetonung aufweisen kann.“"
                            },
                            {
                                "example_id": "f2fd992b-a008-46e2-813a-fb30e791f393",
                                "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                                "text": "„Andererseits muss aber gerade bei der Derivation mit nichtnativen Affixen, welche i.d.R. die Stammbetonung überschreiben (…), wie unter (69b/c) ein und dieselbe Silbe je nach vorhandener oder fehlender Derivation unterschiedlich betont sein können. “"
                            },
                            {
                                "example_id": "1127e456-b3d6-4bf5-9108-d396104bd672",
                                "sense_id": "cead2703-0cc8-3fb2-a9da-89247637a285",
                                "text": "„In deutschen Wörtern herrscht Stammbetonung vor, das heißt es wird die erste Silbe des Stamms betont: »lehren, Lehrer, Lehrerin, lehrhaft, Lehrerkollegium, belehren.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
