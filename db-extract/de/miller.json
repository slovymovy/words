                ],
                "senses": [
                    {
                        "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                        "entry_id": "73ce2888-741c-352b-947c-0e20fa8c4628",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47507de3-7596-4947-a428-db56fce606b9",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Frau Miller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6df2c55f-a3da-41eb-9ccc-c8292a3dda36",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Herr Miller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "722900e1-bdfa-488f-9e0d-02d68da2bf57",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Die Millers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "3924232f-e665-4406-8589-a8813e341840",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Der Miller trägt nie die Pullover, die die Miller ihm strickt."
                            },
                            {
                                "example_id": "0b1120fc-2884-4ce4-88b6-56468af853cb",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Miller kommt, geht der Herr Miller.“"
                            },
                            {
                                "example_id": "0a3ec7e9-9312-4e5f-9522-5d4fe17ac1de",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Miller kommt und geht."
                            },
                            {
                                "example_id": "ecafd4c4-8fc2-4411-80c9-5e19d5880c8b",
                                "sense_id": "6449e84c-b731-3cce-ae44-ae0559b6cbee",
                                "text": "Millers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
