                    }
                ],
                "senses": [
                    {
                        "sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                        "entry_id": "bcf4113e-d1e0-30dc-9da8-420238151ce0",
                        "glosses": [
                            "mający różne postaci"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109ad87e-075a-424d-8e67-477e5e0b4efc",
                                "sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                                "text": "Odmiany polimorficzne nie są różnymi stanami skupienia, ale są różnymi fazami materii, przejścia z jednej odmiany do drugiej są przemianami fazowymi pierwszego rzędu"
                            },
                            {
                                "example_id": "9765dd78-830f-4876-9228-95d8c99b21ff",
                                "sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                                "text": "W dużym zakresie ciśnień można wyróżnić co najmniej osiemnaście odmian polimorficznych lodu, oznaczanych symbolicznie cyframi rzymskimi"
                            },
                            {
                                "example_id": "13e29c8e-515d-4222-bb02-64de6412d15a",
                                "sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                                "text": "Również może składać się z polimorficznych, wielowodniczkowych lipoblastów z dziwacznymi, hiperchromatycznymi, półokrągłymi jądrami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d062143-17e5-4776-9ddf-d1220144a795",
                        "source_entry_id": "bcf4113e-d1e0-30dc-9da8-420238151ce0",
                        "source_sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                        "target_lang_word": "polymorphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Relating to polymorphism (any sense), able to have several shapes or forms."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b731374c-91be-4e6e-ac67-2e845af49725",
                                                "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                                "text": "I refer to those genera which have sometimes been called \"protean\" or \"polymorphic,\" in which the species present an inordinate amount of variation; and hardly two naturalists can agree which forms to rank as species and which as varieties."
                                            },
                                            {
                                                "example_id": "be3a868f-5346-49e8-8787-d4dbe3bb46af",
                                                "sense_id": "6af85670-dc96-3c54-8958-dcb77ea78418",
                                                "text": "1897, Grant Allen, An African Millionaire\nDr. Beddersley came -- a dapper little man, with pent-house eyebrows, and keen, small eyes, whom I suspected at sight of being Colonel Clay himself in another of his clever polymorphic embodiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Having or relating to the ability to take multiple data types for a single parameter."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c1c14d1-737c-46e8-8db2-755d1a9204c4",
                                                "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                                "text": "Polymorphic redefinition in C++ is achieved by the use of virtual functions."
                                            },
                                            {
                                                "example_id": "828740a3-04cb-4d4f-bcfb-220eb6c1ca56",
                                                "sense_id": "391e234f-0d74-3a78-83af-800f9a52cdfc",
                                                "text": "A polymorphic call looks like a procedural call, but where a procedural call has only one possible target subroutine, a polymorphic call can result in the execution of one of several different subroutines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e337f07-7560-3f18-9035-fbb9096f99b1",
                                        "entry_id": "3efd13ad-8c34-3cec-b5d4-930aae7e13cb",
                                        "glosses": [
                                            "Relating to a compound that can crystallizes into two or more distinct forms (e.g. carbon, which can crystalize into coal, graphite, diamond, etc.)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "042fc606-5a2f-4815-9a80-beb5e5b1d937",
                                                "sense_id": "4e337f07-7560-3f18-9035-fbb9096f99b1",
                                                "text": "The fact that polymorphic equilibrium is not a dynamic equilibrium is significant with respect to the random distribution of velocity of temperature agitation among the molecules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1154d8ca-896f-43da-acf7-248433402df6",
                        "source_entry_id": "bcf4113e-d1e0-30dc-9da8-420238151ce0",
                        "source_sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                        "target_lang_word": "polymorphe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68db5f27-3631-34a1-a835-1847c3b9bc60",
                                        "entry_id": "ba009b34-f06f-388a-b7b2-28e0debc0557",
                                        "glosses": [
                                            "Qui est sujet à changer de forme, qui offre des formes différentes."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2b3cd2-46da-4ee4-a8aa-1a3ac507d11c",
                                                "sense_id": "68db5f27-3631-34a1-a835-1847c3b9bc60",
                                                "text": "Beaucoup d’observateurs admettent l’existence de plusieurs espèces d’hématozoaires du paludisme : hématozoaires des fièvres tropicales, de la tierce et de la quarte. Je pense qu'il s'agit de simples variétés d'une même espèce polymorphe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c32fa38-f080-3add-a2ac-0c68ad2b9710",
                                        "entry_id": "ba009b34-f06f-388a-b7b2-28e0debc0557",
                                        "glosses": [
                                            "Se dit d’une fonction, d’un agent dont le comportement change selon le type d’objet auquel il est appliqué."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c685aa9-8752-3a7b-ba87-f848343dfc1d",
                                        "entry_id": "ba009b34-f06f-388a-b7b2-28e0debc0557",
                                        "glosses": [
                                            "Se dit d’un virus qui change sa méthode de chiffrement à chaque cycle de reproduction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3fa7652-df59-4407-bc95-8fb54606777d",
                                                "sense_id": "5c685aa9-8752-3a7b-ba87-f848343dfc1d",
                                                "text": "Les virus métamorphes sont similaires aux virus polymorphes […] Alors que les différentes formes mutées d’un virus polymorphe partagent le même noyau (en particulier la fonction de mutation), celles d’un virus métamorphe ont chacune un noyau différent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23ce603-9462-3cff-99d6-4978cce0f6a1",
                                        "entry_id": "ba009b34-f06f-388a-b7b2-28e0debc0557",
                                        "glosses": [
                                            "Décrit des minéraux qui, tout en ayant la même composition chimique, cristallisent dans des systèmes différents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374841d2-1cb6-4f79-8b8e-800f2475702a",
                                                "sense_id": "c23ce603-9462-3cff-99d6-4978cce0f6a1",
                                                "text": "La pseudomalachite est polymorphe de la ludjibaite et de la reichenbachite."
                                            },
                                            {
                                                "example_id": "e6d14515-1dc1-41c1-a7bd-239d1500b453",
                                                "sense_id": "c23ce603-9462-3cff-99d6-4978cce0f6a1",
                                                "text": "Le carbone, le soufre et le phosphore sont des éléments polymorphes."
                                            },
                                            {
                                                "example_id": "e4e92efd-4dd6-4a0f-b48e-d67e7427ee1e",
                                                "sense_id": "c23ce603-9462-3cff-99d6-4978cce0f6a1",
                                                "text": "Minéral d’origine sédimentaire par excellence, la calcite se crée par transformation avec le temps de squelettes de mollusques et autres organismes marins originellement constitués d’aragonite (polymorphe orthorhombique de la calcite, d’origine biogénique)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "773a9505-be98-3a56-a582-e0917546dfe1",
                                        "entry_id": "ba009b34-f06f-388a-b7b2-28e0debc0557",
                                        "glosses": [
                                            "Se dit d’un auteur qui écrit dans des styles de littérature différents."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7332cd3b-4c78-4390-b2b0-ae687237e50c",
                                                "sense_id": "773a9505-be98-3a56-a582-e0917546dfe1",
                                                "text": "Daniel PENNAC, auteur à l’écriture polymorphe qui va de la littérature jeunesse au théâtre en passant par l’essai et la bande dessinée […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce5ee4ec-9c0e-4587-a2d2-2187a482e1bf",
                        "source_entry_id": "bcf4113e-d1e0-30dc-9da8-420238151ce0",
                        "source_sense_id": "b81ad22e-3cb0-36da-b214-263e6d65c28f",
                        "target_lang_word": "polymorphique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polymorphique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51e217f1-de01-3da7-b12d-5602e2461c5b",
                                        "entry_id": "24db49f5-c36e-3fe6-9436-e2804350ec35",
                                        "glosses": [
                                            "Relatif au polymorphisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89448bb-0bbb-4861-93df-0475e08227dd",
                                                "sense_id": "51e217f1-de01-3da7-b12d-5602e2461c5b",
                                                "text": "Si la substance n’est pas un corps simple mais un corps composé on dit que le solide existe sous deux formes « polymorphiques ». C’est ainsi que la glace existe sous six formes polymorphiques, c’est-à-dire que la glace existe sous six formes cristallisées différentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
