        "fr-extract.jsonl": [
            {
                "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                "word": "négociable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d95c0dd-1f82-4d86-9853-874c34dcf467",
                        "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "négociables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                        "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                        "glosses": [
                            "Qui peut se négocier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fa7320-33ae-4e1a-a973-b08b5bb79864",
                                "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                                "text": "Mais l’essentiel des difficultés ne tient-il pas, d’une part à une certaine incapacité à inventer un nouveau négociable, et d’autre part, à la crise d’adaptation que connaît aujourd’hui le syndicalisme."
                            },
                            {
                                "example_id": "3c41aecd-98e7-4e89-90e7-6953e0d8b96a",
                                "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                                "text": "Toute la question est là. Qu’est-ce qui est négociable. Qu’est-ce qui n’est pas négociable. […] Le monde sera jugé sur ce qu’il aura considéré comme négociable ou non négociable."
                            }
                        ]
                    },
                    {
                        "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                        "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                        "glosses": [
                            "Qualifie, à la Bourse, une valeur mobilière ou un effet public faisant l’objet de transactions courantes, et qui n’est frappé d’aucune restriction particulière."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "92e192e2-1013-4902-a91f-6b09050bc07b",
                                "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                                "text": "Cet effet, ce billet est négociable, n’est pas négociable."
                            },
                            {
                                "example_id": "df1947fc-0736-490a-b71d-f4bb925f1a2f",
                                "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                                "text": "L’instrument financier est aussi un bien en lui-même, en raison de sa forme instrumentale de titre négociable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dba0f5f-0605-4ffd-92db-8efcda2f018b",
