    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4893017d-a9c2-3753-9408-2f76ed41442a",
                "word": "thereon",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "373afaeb-d170-3aad-a2fe-a2eaa14ec3e3",
                        "entry_id": "4893017d-a9c2-3753-9408-2f76ed41442a",
                        "glosses": [
                            "on that."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b10dee8-c19e-4da8-b6db-6e3db01767f0",
                                "sense_id": "373afaeb-d170-3aad-a2fe-a2eaa14ec3e3",
                                "text": "Whoso therefore shall swear by the altar, sweareth by it, and by all things thereon. And whoso shall swear by the temple, sweareth by it, and by him that dwelleth therein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e71c4181-76aa-479b-99c2-ed946f1a438b",
                        "source_entry_id": "4893017d-a9c2-3753-9408-2f76ed41442a",
                        "source_sense_id": "373afaeb-d170-3aad-a2fe-a2eaa14ec3e3",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "daarop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daarop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                        "entry_id": "6fcc789b-16cc-36b2-88fc-7526b6a5ed3b",
                                        "glosses": [
                                            "op dat, op die"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b988c1aa-9c1d-423d-9670-c38b8c6f4603",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Daarop zet je een vaas met bloemen."
                                            },
                                            {
                                                "example_id": "0654a725-77f2-46f0-bfe5-f56e3020cd67",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Zie je de lijst? Daarop kun je je naam schrijven."
                                            },
                                            {
                                                "example_id": "24201aa1-2abf-4ab6-8ecc-ef99c21710d6",
                                                "sense_id": "e22493eb-2d3a-3b84-90b3-f21dae1fa118",
                                                "text": "Er hingen ook een herdenkingstegeltje van de ramp met daarop het overstroomde eiland Goeree-Overflakkee en het Delfts blauwe bevrijdingsbord Herrijzend Nederland van na de oorlog."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daarop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bd68a1-b027-35f9-87a3-8d53c69668d0",
                                        "entry_id": "21e21f2c-136b-382d-afa4-fd162c1fe54a",
                                        "glosses": [
                                            "op een tijdstip vlak na het genoemde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4a1e39-10d9-48c5-8594-4727d29476d4",
                                                "sense_id": "d3bd68a1-b027-35f9-87a3-8d53c69668d0",
                                                "text": "Na een paar replieken werd het debat gesloten. Daarop kwam 't hoofdpunt ter sprake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0af72100-c434-468a-b3af-a97653cb9f27",
                        "source_entry_id": "4893017d-a9c2-3753-9408-2f76ed41442a",
                        "source_sense_id": "373afaeb-d170-3aad-a2fe-a2eaa14ec3e3",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "jusque-là",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jusque-là",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ea300be-cb1c-394a-832e-4bdbb0afe0ed",
                                        "entry_id": "01076d25-bc3d-3d1d-9e42-6c1e903975e6",
                                        "glosses": [
                                            "Jusqu’à ce lieu-là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e5142c-72d8-4106-bba4-d4e0f7948780",
                                                "sense_id": "1ea300be-cb1c-394a-832e-4bdbb0afe0ed",
                                                "text": "Allez, venez, avancez, reculez jusque-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc10e14-6bb0-3d3c-bf1d-90dbd6111e6a",
                                        "entry_id": "01076d25-bc3d-3d1d-9e42-6c1e903975e6",
                                        "glosses": [
                                            "Jusqu’à ce point-là."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8903c7e7-ea0d-4510-ae93-8267cce31f02",
                                                "sense_id": "7fc10e14-6bb0-3d3c-bf1d-90dbd6111e6a",
                                                "text": "Vous avez poussé jusque-là la patience !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cbb5fd6-9bdd-316a-ae79-d829c0f26471",
                                        "entry_id": "01076d25-bc3d-3d1d-9e42-6c1e903975e6",
                                        "glosses": [
                                            "Jusqu'à cette taille-là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34bc7fe7-8933-436f-9d56-9dac6b10b2bc",
                                                "sense_id": "2cbb5fd6-9bdd-316a-ae79-d829c0f26471",
                                                "text": "Matoussaint a quitté la maison depuis un mois, et l’on ne sait pas où il est allé.\nOn l’a vu partir avec des poètes, me dit le concierge… des gens qui avaient des cheveux jusque-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                        "entry_id": "01076d25-bc3d-3d1d-9e42-6c1e903975e6",
                                        "glosses": [
                                            "Jusqu’à ce temps-là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48f2663-32d4-4462-9757-c7c40f613d6d",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "Jusque-là, Gabriel n’avait jamais vu son étrange compagnon torse nu, et il comprit vite pourquoi Duwault rechignait à s’exhiber ainsi. Son immense carcasse faisait penser à une mante religieuse à l’affût, mais ça n’était pas ça qui attira l’attention de Gabriel. Ce qui le captiva, c’étaient ces entailles en diagonale, profondes comme des ravines, et qui recouvraient son dos. Probablement anciennes, elles avaient cicatrisé en de vilaines boursouflures qui ressemblaient à de grosses lèvres gercées."
                                            },
                                            {
                                                "example_id": "8777dc38-711a-40dc-914e-c18f7bd33045",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "Venez à deux heures, je vous attendrai jusque-là."
                                            },
                                            {
                                                "example_id": "711e46c5-ac70-4480-9e5d-fd471cdfbc48",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "Vous tarderez, vous différerez jusque-là."
                                            },
                                            {
                                                "example_id": "d3a4f556-df8b-4a30-91a7-487c755b12d0",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "Jusque-là, tout va bien !"
                                            },
                                            {
                                                "example_id": "4ad31f2f-359a-4226-b8da-0169fad7b930",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "La vie était bien plus excitante qu’elle n’avait osé le croire jusque-là."
                                            },
                                            {
                                                "example_id": "10b16fe7-f9cc-4f82-99ba-feeb3fb3081c",
                                                "sense_id": "46030afb-ff57-3e6b-b598-c9e5560a80e5",
                                                "text": "Ce fut le premier mot que je prononçai dans la compagnie. Jusque-là, je m'étais contentée d'incliner la tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7942189-8e05-3d60-9793-72f0cafd52d4",
                                        "entry_id": "01076d25-bc3d-3d1d-9e42-6c1e903975e6",
                                        "glosses": [
                                            "(Uniquement avec trait d'union) En se rassasiant plus que de raison."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17cd6869-b951-4ee7-84d9-23f3a55c2cca",
                                                "sense_id": "d7942189-8e05-3d60-9793-72f0cafd52d4",
                                                "text": "« Avalez tous ces menus plaisirs de la renommée ! Mettez-vous en jusque-là ! Et venez les vomir sur mon tapis, lorsque vous en aurez par-dessus la glotte ! »"
                                            },
                                            {
                                                "example_id": "85d21e82-0699-4e9c-ae23-cdfce74e188b",
                                                "sense_id": "d7942189-8e05-3d60-9793-72f0cafd52d4",
                                                "text": "Bien entendu, ils s’en mettent jusque-là, trafiquent, bouffent, fument et jouent au poker, bien à l’abri derrière l’énorme prestige des roulantes et la hautaine protection des Fritz."
                                            },
                                            {
                                                "example_id": "0c3109d3-2248-4dbd-8467-c9968ee020de",
                                                "sense_id": "d7942189-8e05-3d60-9793-72f0cafd52d4",
                                                "text": "Délicieux ma petite fille délicieux. Qu’ils s’en mettent jusque-là, qu’ils me couvent d’un air ravi, elle s’y est bien mise à la cuisine, on n’aurait pas cru, n’avait pas le genre femme d’intérieur, quelle bonne surprise."
                                            },
                                            {
                                                "example_id": "4ae984d3-c0f6-4e32-930f-1646cb741011",
                                                "sense_id": "d7942189-8e05-3d60-9793-72f0cafd52d4",
                                                "text": "Et à l'été de la Saint-Martin, l'oie est à point. Et l'oie, on s'en fourrait jusque-là, même les morceaux honteux. Et pas que l'oie, d'ailleurs. Du potage gras, et des huîtres aux saucisses truffées, et du rôti à la ficelle, et des crèmes fines ! Et des petits choux ! Quel gueuleton !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4b7a7f-3428-4525-a395-bcb08d8e877a",
                        "source_entry_id": "4893017d-a9c2-3753-9408-2f76ed41442a",
                        "source_sense_id": "373afaeb-d170-3aad-a2fe-a2eaa14ec3e3",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "daran",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5897e3c6-5b28-35fd-92b2-135186500057",
                                        "entry_id": "514e03b6-fe1b-3988-957e-af43fe0ef56d",
                                        "glosses": [
                                            "referenziert einen Gegenstand und bezeichnet die unmittelbare Berührung mit diesem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9149e591-843a-42ae-b8d2-86ee3fc13ea5",
                                                "sense_id": "5897e3c6-5b28-35fd-92b2-135186500057",
                                                "text": "Daran hängen sich im Normalfall immer zwei Personen."
                                            },
                                            {
                                                "example_id": "6013657d-4afd-450a-b9db-ef8d540c52b8",
                                                "sense_id": "5897e3c6-5b28-35fd-92b2-135186500057",
                                                "text": "Es dürfen keine Haken an der Wand sein, damit niemand daran hängen bleibt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4bba6913-ad34-3e17-a81b-b232b68153d7",
                                        "entry_id": "514e03b6-fe1b-3988-957e-af43fe0ef56d",
                                        "glosses": [
                                            "referenziert einen Umstand, Zustand, Handlung oder Ereignis, meist in Bezug mit einer geistigen Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f32b671-fa95-4c10-bc90-887bd4362b80",
                                                "sense_id": "4bba6913-ad34-3e17-a81b-b232b68153d7",
                                                "text": "Daran wird die Welt nicht zu Grunde gehen."
                                            },
                                            {
                                                "example_id": "2a2462f5-3935-4179-9f19-ef1c84cc1af5",
                                                "sense_id": "4bba6913-ad34-3e17-a81b-b232b68153d7",
                                                "text": "Je eher daran, desto eher davon. Also los, packen wirs."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
