                ],
                "senses": [
                    {
                        "sense_id": "2a8435b3-8c2e-3b9b-a470-f5564c1a0be4",
                        "entry_id": "fe5641c8-5ee4-3927-8e3d-d0405f6af6b9",
                        "glosses": [
                            "A strong dialectal accent, usually Irish or Scottish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ce6614-079d-4450-addf-9db7feaad6b7",
                                "sense_id": "2a8435b3-8c2e-3b9b-a470-f5564c1a0be4",
                                "text": "I had no doubt he knew where I was from, for I had the brogue, although not much of it."
                            },
                            {
                                "example_id": "1b3b9f8c-bbae-4001-b2e6-98cf97d79b3e",
                                "sense_id": "2a8435b3-8c2e-3b9b-a470-f5564c1a0be4",
                                "text": "“No-man's-land.” The words were spoken in a deep voice filled with salt water and brogue."
                            },
                            {
                                "example_id": "843214ce-8b96-4667-a9ea-5401e675fea6",
                                "sense_id": "2a8435b3-8c2e-3b9b-a470-f5564c1a0be4",
                                "text": "his brooding good looks and distinct Scottish brogue won him legions of fans worldwide."
                            }
                        ]
                    },
                    {
                        "sense_id": "80187a15-dd56-3e00-82a9-c353f47b3745",
                        "entry_id": "fe5641c8-5ee4-3927-8e3d-d0405f6af6b9",
                        "glosses": [
                            "A strong Oxford shoe, with ornamental perforations and wing tips."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa1ccb5-ee23-42ce-9afb-52da7be07478",
                                "sense_id": "80187a15-dd56-3e00-82a9-c353f47b3745",
                                "text": "He had one pair of brogues and the soles were in a miserable state."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6f2af45-7511-3fd6-8fd1-ce63e5337c54",
                        "entry_id": "fe5641c8-5ee4-3927-8e3d-d0405f6af6b9",
