                        "glosses": [
                            "Belgische wet die betrekking heeft op de verdeling van de overheidsfinanciën tussen de verschillende landsdelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8646294b-e7a9-4544-ace1-0017c73cc45c",
                                "sense_id": "26ad1041-a4aa-3a9a-897f-8aa800246e1f",
                                "text": "Vandenbroucke lag al onder vuur doordat hij binnen korte tijd twee grote flaters maakte. Vorige week telefoneerde hij in een treincoupé op veel te luide toon over het voorstel van de Franstalige CDH voor een nieuwe financieringswet. De Vlaamse socialist had niet in de gaten dat de woordvoerder van N-VA-voorzitter Bart De Wever in dezelfde wagon zat en alles kon horen."
                            },
                            {
                                "example_id": "198112e1-8bf6-40be-a87d-0686e717e6c9",
                                "sense_id": "26ad1041-a4aa-3a9a-897f-8aa800246e1f",
                                "text": "De formatie draait vooral om een staatshervorming die Vlaanderen en Wallonië meer financiële autonomie moet geven, de zogenoemde financieringswet. Dat is een grote wens van de Vlamingen. De Franstaligen proberen dat tegen te houden omdat zij bang zijn voor een verdere verarming van Wallonië en Brussel."
                            }
                        ]
                    }
