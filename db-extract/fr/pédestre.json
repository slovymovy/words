        "fr-extract.jsonl": [
            {
                "entry_id": "4a53ed07-4b00-332a-9a01-18469eff375a",
                "word": "pédestre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2a5fef3-eecb-4d27-86d0-d2eb27742640",
                        "entry_id": "4a53ed07-4b00-332a-9a01-18469eff375a",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "pédestres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a3e6ca2-8e64-3a01-a163-04292d826bff",
                        "entry_id": "4a53ed07-4b00-332a-9a01-18469eff375a",
                        "glosses": [
                            "À pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b157a0a-cc66-4557-8d68-875bc18dedd2",
                                "sense_id": "1a3e6ca2-8e64-3a01-a163-04292d826bff",
                                "text": "En moins de dix heures nous avions parcouru 15 milles danois (115 kil.), y compris notre marche pédestre à travers les laves."
                            },
                            {
                                "example_id": "cc2b4966-6b9c-4294-905d-f7bd263d9829",
                                "sense_id": "1a3e6ca2-8e64-3a01-a163-04292d826bff",
                                "text": "Il œuvre dans le domaine du plein air (randonnée pédestre, escalade, vélo, ski de fond, etc.) depuis une quinzaine d'années et a été recherchiste pour l'émission de télévision Oxygène (1992-1993)."
                            }
                        ]
                    },
                    {
                        "sense_id": "aad9024c-d198-363a-a53f-5ff6dc072d95",
                        "entry_id": "4a53ed07-4b00-332a-9a01-18469eff375a",
                        "glosses": [
                            "Qualifie une statue qui représente un personnage en pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0a7b7f-737a-40a6-a3fd-6660800733d8",
                                "sense_id": "aad9024c-d198-363a-a53f-5ff6dc072d95",
                                "text": "Mais on peut diviser commodément les statues antiques en pédestres , équestres , & curules, c'est à dire, à pié, à cheval, & en char."
                            },
                            {
                                "example_id": "ff14bd10-9c9f-45a3-9e6f-4018c1343faf",
                                "sense_id": "aad9024c-d198-363a-a53f-5ff6dc072d95",
                                "text": "Les premières statues triomphales furent par conséquent pédestres , & les statues pédestres furent pendant long-temps en honneur, c'est-à-dire, jusqu'à ce que l’introduction du luxe eut fait perdre le goût de la simplicité."
                            }
                        ]
                    }
                ],
