                                        "glosses": [
                                            "den Preis von etwas herabsetzen, etwas billiger machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a46b69-53c9-4b77-89e2-f0af1664d186",
                                                "sense_id": "90d03d56-1379-3564-95d5-1d0c5e7b0ef6",
                                                "text": "Der neue Anbieter verbilligte die Tickets um 10 %."
                                            },
                                            {
                                                "example_id": "2a27bfac-b30c-4979-a53b-a16b5be9ae8f",
                                                "sense_id": "90d03d56-1379-3564-95d5-1d0c5e7b0ef6",
                                                "text": "„Wird der Kredit erweitert, das Geld verbilligt, dann steigt die Nachfrage nach Arbeit, steigt der Verbrauch, steigt die Erzeugung, werden wieder neue Arbeiter benötigt, steigt der Arbeitslohn und wieder der Verbrauch usw. Es ist nicht mehr nötig, durch Lohndruck die Ausfuhr zu verbilligen, wenn der Exporteur ein Agio von beispielsweise 20 % erhält.“ (1936)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f434526-ffac-3fd8-b112-7209a935c4f0",
                                        "entry_id": "4a7aea10-ca2d-3169-95aa-e2cfcee55c24",
                                        "glosses": [
                                            "billiger werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209f88ff-7a19-4242-b038-9819a7f5000d",
                                                "sense_id": "6f434526-ffac-3fd8-b112-7209a935c4f0",
                                                "text": "Im gleichen Zeitraum verbilligten sich Fernreisen."
                                            },
                                            {
                                                "example_id": "10bc15e4-5e01-45c5-8340-d728a49c6345",
                                                "sense_id": "6f434526-ffac-3fd8-b112-7209a935c4f0",
                                                "text": "Parallel zur Absatzsteigerung verbilligte sich die Herstellung durch günstigere Einkaufskonditionen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
