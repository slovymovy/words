                "senses": [
                    {
                        "sense_id": "f5439799-f3ac-3402-9e48-77fe01ae9a05",
                        "entry_id": "112b3e22-e9ca-36a2-8db0-b564e398e635",
                        "glosses": [
                            "Mischform/Übergangsmundart zwischen dem West- und dem Ostjiddischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d50aa58-ec51-4acc-a4e9-b9e8e29ffefb",
                                "sense_id": "f5439799-f3ac-3402-9e48-77fe01ae9a05",
                                "text": "„Als die wichtigsten sind ein Nördliches Übergangsjiddisch (NÜJ) in den nordöstlichen Provinzen Preußens und ein Südliches Übergangsjiddisch (SÜJ) in den Böhmischen Ländern und in der Westslowakei eingetragen."
                            },
                            {
                                "example_id": "25474c36-79d9-4231-bb58-2f14fc4df4b9",
                                "sense_id": "f5439799-f3ac-3402-9e48-77fe01ae9a05",
                                "text": "„Die Zwischendialekte, die so entstanden sind und sich über Jahrhunderte in erheblichem Maße verfestigt haben, kann man zusammenfassend als Übergangsjiddisch (ÜJ.) bezeichnen.“"
                            },
                            {
                                "example_id": "b79018c3-0c6b-4ce0-b3b6-ec82bcec48d9",
                                "sense_id": "f5439799-f3ac-3402-9e48-77fe01ae9a05",
                                "text": "„Hier weist die Verwendung der Konjunktion in zwei verschiedenen Dialektgebieten, nämlich im Übergangsjiddisch Krakaus und dem Nordwestjiddischen Mindens darauf hin, dass den ursach in der Umgangssprache durchaus verbreitet war.“"
                            },
                            {
                                "example_id": "4067bd75-4712-4abd-a4d8-e9c64363ff6b",
                                "sense_id": "f5439799-f3ac-3402-9e48-77fe01ae9a05",
                                "text": "„Im Bereich des Kasus nach Präposition konnten Daten zu den Varietäten Nordwestjiddisch und nördliches Übergangsjiddisch gewonnen werden. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
