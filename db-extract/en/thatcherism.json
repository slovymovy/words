        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3e933fb3-0cba-3be1-96c2-55f4f6257bee",
                "word": "Thatcherism",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "429e336c-891a-356b-b52a-0408ab71e3db",
                        "entry_id": "3e933fb3-0cba-3be1-96c2-55f4f6257bee",
                        "glosses": [
                            "The political ideology attributed to the governments of British prime minister Margaret Thatcher (1979–1990), characterised by, among other things, a free market economy, privatisation, low taxation, austerity and opposition to unionisation."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "279993a9-273b-4b8f-9430-24831f72b0a7",
                                "sense_id": "429e336c-891a-356b-b52a-0408ab71e3db",
                                "text": "Thus “Thatcherism” is—give or take one or two elements—the corresponding political bedfellow of a period of capitalist recession: the significant differences between this and other variants of Tory “philosophy” being conceived as without any specific pertinent political or ideological effects."
                            }
                        ]
                    }
                ],
