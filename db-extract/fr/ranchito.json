                        "glosses": [
                            "Bidonville, en Amérique latine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc3b35f-8028-4bc8-8298-e65a730f200a",
                                "sense_id": "7945954f-3f3b-36f7-a979-5e71fbd45a7b",
                                "text": "Il vit maintenant dans un ranchito situé dans la parcelle, sur le Cerro Pisirí, à quelque huit cents mètres du foyer familial."
                            },
                            {
                                "example_id": "ce5ab490-82f2-4230-b97e-22d254f3ae3f",
                                "sense_id": "7945954f-3f3b-36f7-a979-5e71fbd45a7b",
                                "text": "Sur les buttes, dispersés dans l’herbe brûlée par le soleil, de pauvres ranchitos sombres, aveugles, cernés de fils accrochés aux arbustes, porteurs de haillons et de robes bariolées, pauvres hardes qui se balancent tristement."
                            },
                            {
                                "example_id": "c581ba70-0c29-4d38-a444-fe8a704ef30d",
                                "sense_id": "7945954f-3f3b-36f7-a979-5e71fbd45a7b",
                                "text": "Caracas est encerclée par les \" ranchitos \", c’est-à-dire les bidonvilles à la vénézuélienne, le même mot désignant la cahute et le quartier."
                            }
                        ]
                    }
