                                        "entry_id": "b0e23594-443f-3c5a-a320-b3a53fda6a44",
                                        "glosses": [
                                            "Großdialekt des Niederdeutschen (genauer: des Westniederdeutschen, beziehungsweise des Niedersächsischen) in Niedersachsen und Sachsen-Anhalt"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ead433-79e7-4472-b76f-7ce99593eb3b",
                                                "sense_id": "b967387d-42b9-3204-91c1-e164016095ea",
                                                "text": "Wer spricht denn hier bei mir schon Ostfälisch, was das auch immer sein soll…?"
                                            },
                                            {
                                                "example_id": "835d55af-7880-4d77-bb0c-6747327c5632",
                                                "sense_id": "b967387d-42b9-3204-91c1-e164016095ea",
                                                "text": "Im Bezug auf deutsche Mundarten spricht man aber auch heute noch vom Ostfälischen."
                                            },
                                            {
                                                "example_id": "1444565f-a3f8-41f4-99f9-60dfa9af3fbb",
                                                "sense_id": "b967387d-42b9-3204-91c1-e164016095ea",
                                                "text": "„Der Gesamtbereich des Ostfälischen ist im Osten begrenzt durch die untere Saale, die mittlere Elbe und Ohre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
