{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "dcb453e9-9fa5-3ca2-a447-60dae0ced19d",
                    "sense_definition": "Вопросительное местоимение, используемое для выяснения личности одушевленного субъекта.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Кто</w> сегодня пришел на урок?",
                            "target_lang_translations": {
                                "cs": "<w>Kdo</w> dnes přišel na hodinu?"
                            }
                        },
                        {
                            "text": "<w>Кто</w> была та женщина в синем платье?",
                            "target_lang_translations": {
                                "cs": "<w>Kdo</w> byla ta žena v modrých šatech?"
                            }
                        }
                    ],
                    "antonyms": [
                        "что"
                    ],
                    "common_phrases": [
                        "кто пришел",
                        "кто это"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tázací zájmeno používané k dotazování na totožnost osoby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kdo",
                                "target_lang_sense_clarification": "tázací zájmeno pro osobu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c304f2d1-228f-39fa-968a-97b3ae7e5e43",
                    "sense_definition": "Относительное местоимение, связывающее придаточное предложение с главным для указания на конкретное лицо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все, <w>кто</w> был там, получили памятные призы.",
                            "target_lang_translations": {
                                "cs": "Všichni, <w>kdo</w> tam byli, dostali pamětní ceny."
                            }
                        },
                        {
                            "text": "Я точно знаю, <w>кто</w> там был вчера вечером.",
                            "target_lang_translations": {
                                "cs": "Přesně vím, <w>kdo</w> tam byl včera večer."
                            }
                        }
                    ],
                    "common_phrases": [
                        "все кто"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vztažné zájmeno, které spojuje vedlejší větu s hlavní a odkazuje na konkrétní osobu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kdo",
                                "target_lang_sense_clarification": "vztažné zájmeno uvozující vedlejší větu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daf3ff76-9d89-3a55-a4a2-119b2cf97b5e",
                    "sense_definition": "Неопределенное местоимение, указывающее на неизвестное или гипотетическое лицо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не знаю, есть ли там <w>кто</w> сейчас.",
                            "target_lang_translations": {
                                "cs": "Nevím, jestli tam teď <w>někdo</w> je."
                            }
                        },
                        {
                            "text": "Если <w>кто</w> позвонит, скажи, что я занят.",
                            "target_lang_translations": {
                                "cs": "Pokud <w>někdo</w> zavolá, řekni, že jsem zaneprázdněn."
                            }
                        }
                    ],
                    "synonyms": [
                        "кто-либо",
                        "кто-нибудь",
                        "кто-то"
                    ],
                    "target_lang_definitions": {
                        "cs": "Neurčité zájmeno označující neznámou nebo hypotetickou osobu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "někdo",
                                "target_lang_sense_clarification": "neurčitá osoba"
                            },
                            {
                                "target_lang_word": "kdokoliv",
                                "target_lang_sense_clarification": "kdokoli bez rozdílu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4834cc02-3ee5-37c5-80e5-25600c08da0a",
                    "sense_definition": "Аббревиатура от <w>контртеррористическая</w> <w>операция</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abbreviation",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Режим <w>КТО</w> предусматривает ряд временных ограничений для населения.",
                            "target_lang_translations": {
                                "cs": "Režim <w>protiteroristické operace</w> předpokládá řadu dočasných omezení pro obyvatelstvo."
                            }
                        },
                        {
                            "text": "В районе была объявлена <w>КТО</w> для обеспечения безопасности граждан.",
                            "target_lang_translations": {
                                "cs": "V oblasti byla vyhlášena <w>protiteroristická operace</w> pro zajištění bezpečnosti občanů."
                            }
                        }
                    ],
                    "synonyms": [
                        "контртеррористическая операция"
                    ],
                    "common_phrases": [
                        "режим кто"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zkratka pro protiteroristickou operaci."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "protiteroristická operace",
                                "target_lang_sense_clarification": "vojenský nebo bezpečnostní termín"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}