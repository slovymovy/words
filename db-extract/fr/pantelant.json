                ],
                "senses": [
                    {
                        "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                        "entry_id": "0ed863a8-f93e-3b71-8448-251c81eaa816",
                        "glosses": [
                            "Qui halète, qui respire avec peine, par secousse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df88a89-8d8e-454c-a739-81a188392c3c",
                                "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                                "text": "La machine cabriola en l'air et retomba, pantelante."
                            },
                            {
                                "example_id": "502fa050-8380-428e-87e7-c970675f096e",
                                "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                                "text": "La chair pantelante d’un animal récemment tué, lorsqu’elle palpite encore."
                            },
                            {
                                "example_id": "b24ca63d-9d2b-47a5-811f-6f0923b451c8",
                                "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                                "text": "Elle retomba sur son matelas, à bout, inerte, mais non syncopée cependant, ainsi que le prouvait sa respiration pantelante."
                            },
                            {
                                "example_id": "3fc30625-b595-43f1-a823-1a300f4c77ff",
                                "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                                "text": "Ces paroles de feu, ce pantelant dilemme\nQue jette à votre amant votre esprit irrité,\nC’est le puissant soupir de l’être, dès qu’il aime."
                            },
                            {
                                "example_id": "48baddb5-4c77-4572-8a44-9274f046a569",
                                "sense_id": "e7f70b17-9234-39b6-b8e0-1d75688be78e",
                                "text": "C'est apparemment dans les Flandres, encore toutes pantelantes, que se manifestèrent à la fin du conflit les premiers symptômes d'une maladie de l'orme qui allait jeter l'émoi parmi les forestiers du monde occidental."
                            }
                        ]
                    }
                ],
