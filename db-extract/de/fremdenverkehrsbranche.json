                "senses": [
                    {
                        "sense_id": "96eeaf63-de2c-341f-9db7-933793383024",
                        "entry_id": "2ad23c8f-a68f-373b-9555-55ee8b0419ce",
                        "glosses": [
                            "Geschäftszweig, der sich vor allem mit der Vermittlung von Reisen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a81c7b-0925-4be6-bfe7-75692679d4e1",
                                "sense_id": "96eeaf63-de2c-341f-9db7-933793383024",
                                "text": "„Zur Umweltbelastung trägt ferner die Fremdenverkehrsbranche bei, die ähnlich wie in Österreich zu einem guten Teil vom alpinen Skitourismus profitiert.“"
                            },
                            {
                                "example_id": "0d4b58f0-0bb9-44ed-9574-b16f27e61691",
                                "sense_id": "96eeaf63-de2c-341f-9db7-933793383024",
                                "text": "„Sechs Monate früher wären die finanziellen Konsequenzen für die Fremdenverkehrsbranche noch desaströser gewesen.“"
                            },
                            {
                                "example_id": "19ca2121-e77f-49ce-b4fd-7a699974be13",
                                "sense_id": "96eeaf63-de2c-341f-9db7-933793383024",
                                "text": "„Ein Positivum ist, daß mit der Fremdenverkehrsbranche hauptsächlich Frauenarbeitsplätze entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
