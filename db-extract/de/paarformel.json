                "senses": [
                    {
                        "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                        "entry_id": "f29f385c-c42a-37c0-b70c-a17bf0fd998f",
                        "glosses": [
                            "feststehende Wortpaare, die meist durch eine Art von Reim miteinander verbunden sind"
                        ],
                        "tags": [
                            "Phraseologie"
                        ],
                        "examples": [
                            {
                                "example_id": "34c8ecfb-dd67-407f-9f0e-c1b3cc5f0520",
                                "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                                "text": "\"Kind und Kegel\", \"Mann und Maus\" sind bekannte, sich reimende Paarformeln."
                            },
                            {
                                "example_id": "ec99e882-9b0e-4f1e-aa3b-5d8b23df55df",
                                "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                                "text": "„In ähnlicher Weise wie die komparativen Phraseologismen sind die phraseologisierten Wortpaare (auch Paarformeln oder Zwillingsformeln genannt…) durch eine charakteristische Struktur gekennzeichnet: zwei (nur selten drei) der gleichen Wortart angehörende Wörter, verknüpft durch eine Konjunktion (…) oder Präposition (…).“"
                            },
                            {
                                "example_id": "28eb8471-62df-4633-8781-cf538c679ba0",
                                "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                                "text": "„Paarformeln stellen sowohl unter historischer wie synchroner Perspektive eine Klasse von Phraseologismen mit spezifischen Eigenschaften dar (…).“"
                            },
                            {
                                "example_id": "505a57a6-3364-472f-9bb4-c30921cbabc4",
                                "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                                "text": "„In diesen Zusammenhang gehört die Bildung von Zwillings- oder Paarformeln aus sinnverwandten Wörtern.“"
                            },
                            {
                                "example_id": "bbf6982f-9a28-4c80-9ba5-20b2f5f0dd52",
                                "sense_id": "34d9ed9f-daaf-328f-a2c5-34e9a08eeb1e",
                                "text": "„Die prototypische Mehrlingsformel ist die Paarformel, auch Binomiale genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
