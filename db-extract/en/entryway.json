                    {
                        "translation_id": "0390c9d2-c9c0-4ca1-86c0-ba7c1b5c73b7",
                        "source_entry_id": "b9dae42f-a37b-31f0-9f05-7750cbc7919d",
                        "source_sense_id": "b5bbcae6-e464-3f37-8aa8-53e499ce6773",
                        "source_sense_description": "opening or hallway allowing entry into a structure",
                        "target_lang_word": "Lobby",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lobby",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8f43486-9f58-310d-a5b8-428de12d3918",
                                        "entry_id": "25994c8a-45de-389a-bc1b-378aa0f30b11",
                                        "glosses": [
                                            "Interessengruppe, die eine Meinung vertritt und diese durchzusetzen versucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78b7231-d91d-4e8b-a260-504e8772d293",
                                                "sense_id": "a8f43486-9f58-310d-a5b8-428de12d3918",
                                                "text": "Der Einfluss der Lobby der Automobilindustrie auf die Politik verhinderte strengere Klimaschutzgesetze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                        "entry_id": "25994c8a-45de-389a-bc1b-378aa0f30b11",
                                        "glosses": [
                                            "Empfangsraum in einem Gebäude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac24fc1f-019c-4859-bc41-7132e85b99a4",
                                                "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                                "text": "Die Lobby meines Hausarztes ist montags immer überfüllt."
                                            },
                                            {
                                                "example_id": "e509cfa6-d41d-40c4-b474-ebe4bafa74bb",
                                                "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                                "text": "„Mir war immer noch schwindlig, und leichtes Seitenstechen ließ mir den Weg von der Toilette durch die Lobby länger erscheinen, als er war.“"
                                            },
                                            {
                                                "example_id": "fb5742fb-8fc5-4652-89bf-6de022d70e69",
                                                "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                                "text": "„Weil ihre in einem großen Wohnhaus eröffnete Herberge keinen Parkplatz hat, besteht sie darauf, dass unser Auto, dessen grüne Farbe unter einer dicken Staubschicht kaum noch zu erkennen ist, in der blank gewienerten Lobby parkt.“"
                                            },
                                            {
                                                "example_id": "ee68b795-e9fe-4265-8c88-af6b73c457f4",
                                                "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                                "text": "„In der Lobby wurden jeden Nachmittag Kaffee und süße Stückchen serviert.“"
                                            },
                                            {
                                                "example_id": "66c63246-f9b3-4317-88e7-0ee29c1b90a5",
                                                "sense_id": "ef711019-1b27-31dd-9e6c-2cd9a0841226",
                                                "text": "„Die Lobby ist dunkel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
