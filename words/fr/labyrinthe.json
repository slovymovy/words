{
    "word_family": [
        "labyrinthique",
        "labyrinthite"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc809a63-24fd-3c7d-8982-79b42063ae2e",
                    "sense_definition": "Réseau complexe de chemins, d'allées ou de couloirs conçu pour égarer ceux qui s'y engagent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants s'amusent à chercher la sortie dans ce grand <w>labyrinthe</w> de buis."
                        },
                        {
                            "text": "Nous nous sommes perdus dans le <w>labyrinthe</w> de ruelles de la vieille ville."
                        }
                    ],
                    "synonyms": [
                        "dédale"
                    ],
                    "common_phrases": [
                        "labyrinthe de buis",
                        "labyrinthe de ruelles"
                    ]
                },
                {
                    "sense_id": "d06d3548-cfa0-30c1-b182-ffe0637f8eeb",
                    "sense_definition": "Situation obscure, confuse ou très compliquée où il est difficile de s'orienter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouveaux créateurs d'entreprise ont du mal à s'orienter dans ce véritable <w>labyrinthe</w> administratif."
                        },
                        {
                            "text": "Il a passé plusieurs mois à tenter de dénouer les fils de ce <w>labyrinthe</w> juridique."
                        }
                    ],
                    "synonyms": [
                        "dédale"
                    ],
                    "common_phrases": [
                        "labyrinthe administratif",
                        "labyrinthe juridique"
                    ]
                },
                {
                    "sense_id": "28694077-ed5a-307f-aabe-87e1d7870778",
                    "sense_definition": "Dans l'Antiquité, grand édifice composé de nombreuses galeries inextricables, comme celui conçu pour enfermer le Minotaure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thésée est parvenu à sortir du <w>labyrinthe</w> de Crète grâce au fil d'Ariane."
                        },
                        {
                            "text": "Le roi Minos avait ordonné la construction d'un immense <w>labyrinthe</w> pour y cacher le monstre."
                        }
                    ],
                    "synonyms": [
                        "dédale"
                    ],
                    "common_phrases": [
                        "labyrinthe de Crète"
                    ]
                },
                {
                    "sense_id": "f7ccfa14-e495-37ce-9d06-a938c098ee96",
                    "sense_definition": "Ensemble des cavités et canaux interconnectés qui composent l'oreille interne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a expliqué que le <w>labyrinthe</w> joue un rôle fondamental dans le maintien de l'équilibre."
                        },
                        {
                            "text": "Une lésion au niveau du <w>labyrinthe</w> osseux peut entraîner de violents vertiges."
                        }
                    ],
                    "common_phrases": [
                        "labyrinthe osseux",
                        "labyrinthe membraneux"
                    ]
                }
            ]
        }
    ]
}