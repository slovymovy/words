                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f58e4ccb-7a45-31b6-963d-be6eac627e4b",
                                        "entry_id": "970dc2fe-30e6-3de8-9469-6c97bb28ef8d",
                                        "glosses": [
                                            "Deducing consequences; reasoning; inferring."
                                        ],
                                        "tags": [
