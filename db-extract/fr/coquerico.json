                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6e265613-268f-4229-a491-5e4774686115",
                                "sense_id": "c81f0cd1-fd55-3db7-81ce-60e58c975f38",
                                "text": "Le coq chanta coquerico."
                            },
                            {
                                "example_id": "8e6a04c9-e335-4ab2-94c8-5ee8139c9720",
                                "sense_id": "c81f0cd1-fd55-3db7-81ce-60e58c975f38",
                                "text": "A cette lumière inattendue , elle reconnut qu’elle n’était qu’a dix pas de la maison de sa mère, et, quand elle entra dans la cour, le coq , croyant saluer l’aurore, battit des ailes et chanta à tue-tête : Coquerico! coquerico! Le jour éclot ! le jour éclot !"
                            },
                            {
                                "example_id": "6f6e4403-4a4d-4649-89a1-8f33941c5e4f",
                                "sense_id": "c81f0cd1-fd55-3db7-81ce-60e58c975f38",
                                "text": "Au moment du passage du convoi, le cocq chante par trois fois coquerico , et la servante du marchand se met à rire."
                            }
                        ]
                    }
                ],
