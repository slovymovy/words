                                "example_id": "9193884b-a7e6-4fb0-af34-8f8a53389ff5",
                                "sense_id": "610ac83e-0138-3daf-89f3-951eeb13235b",
                                "text": "Der Soave \"ist säurearm und hat ein samtig-sanftes Aroma. Der Soave ist einer der bekanntesten Weine aus Italien.\""
                            },
                            {
                                "example_id": "ba0a4ffd-ab4e-4cba-9ff3-6df527fb11d5",
                                "sense_id": "610ac83e-0138-3daf-89f3-951eeb13235b",
                                "text": "\"Der Soave Classico … wird im Westen der Region Venetien angebaut, zwischen den Orten Soave und Monteforte D'Alpone.\""
                            }
