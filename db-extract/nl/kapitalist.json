                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd2e8f39-261d-47d7-9d39-54c652b187fc",
                        "source_entry_id": "698202c3-4b5c-3357-96e8-ce72bd8a8ed3",
                        "source_sense_id": "e2e4e104-89af-33de-ac82-0c9fc705a9d9",
                        "source_sense_description": "persoon die fanatiek met geld bezig is",
                        "target_lang_word": "Kapitalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kapitalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2441f952-6dcc-30c7-942a-29c17e34a37c",
                                        "entry_id": "7dfbf557-2ce8-3bcc-81fe-7b53b532692c",
                                        "glosses": [
                                            "Person, die über Kapital (nennenswerte finanzielle und/oder Produktionsmittel) verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9aabd0-ded3-4605-bb3c-51e988dafee1",
                                                "sense_id": "2441f952-6dcc-30c7-942a-29c17e34a37c",
                                                "text": "„Marx prophezeite den Tod der Kapitalisten, aber wer heute durch London fährt, dieses viktorianische Freilichtmuseum mit Glasgurke und Riesenrad an der Themse, stellt verwundert fest: Nicht der Kapitalist fehlt, sondern die Arbeiterklasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "17218d2e-2bc9-3759-8292-7a100c8a3f60",
                                        "entry_id": "7dfbf557-2ce8-3bcc-81fe-7b53b532692c",
                                        "glosses": [
                                            "Anhänger des Kapitalismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "047066c3-f731-4dd8-bb54-c814a041d228",
                                                "sense_id": "17218d2e-2bc9-3759-8292-7a100c8a3f60",
                                                "text": "Ich habe zwar kein Geld, aber das macht mich nicht zum Kommunisten, ich bin und bleibe ein Kapitalist, der die soziale Marktwirtschaft unterstützt."
                                            },
                                            {
                                                "example_id": "a7d2e6f7-2e2b-4381-8eb5-3d7aba6f677d",
                                                "sense_id": "17218d2e-2bc9-3759-8292-7a100c8a3f60",
                                                "text": "„Man würde, wenn man ihn so sieht, erwarten, daß er Zigarren raucht, keine dicken, sondern leichte, schlanke Zigarren, aber daß er Zigaretten raucht, wirkt bei einem fast siebzigjährigen Kapitalisten überraschend flott und fortschrittlich.“"
                                            },
                                            {
                                                "example_id": "3ca29e6a-b106-4e7f-92e9-0347fc385a19",
                                                "sense_id": "17218d2e-2bc9-3759-8292-7a100c8a3f60",
                                                "text": "„Die Deutschen sind genauso Kapitalisten wie alle anderen auch, sogar die besseren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee7e9b33-3a6f-44d7-a5ee-d182cff4777f",
                        "source_entry_id": "698202c3-4b5c-3357-96e8-ce72bd8a8ed3",
