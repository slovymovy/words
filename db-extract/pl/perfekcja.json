                                            },
                                            {
                                                "example_id": "aa707a8f-8374-4790-847b-8637ed5fd8b8",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "total perfection"
                                            },
                                            {
                                                "example_id": "5f8fa646-4cb1-4530-a10a-e6dcdf58b305",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "aim for perfection"
                                            },
                                            {
                                                "example_id": "e64a1168-d91a-40b7-9ff8-4c55ba7494f1",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "lack perfection"
                                            },
                                            {
                                                "example_id": "99b25b98-0b77-4027-8e48-fb454da11ab9",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "attain perfection"
                                            },
                                            {
                                                "example_id": "edd4114a-1c98-4e57-b849-54f377f3f221",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "be far off perfection"
                                            },
                                            {
                                                "example_id": "1a47f5bb-274f-4858-bd84-aff19f9eca4d",
                                                "sense_id": "0a5562ae-042c-3396-b983-dbec6a6ba8c4",
                                                "text": "Think, think about the way of rejection / You're not the only one reaching for perfection / Think, think about the reason you exist / I got something you might not wanna miss"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2c8bf4-5a4b-33d0-a3d8-faa1ca42c7d2",
                                        "entry_id": "b4bf226e-11e4-3b88-8839-b2bc3f653f1d",
                                        "glosses": [
                                            "A quality, endowment, or acquirement completely excellent; an ideal; faultlessness; especially, the divine attribute of complete excellence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
