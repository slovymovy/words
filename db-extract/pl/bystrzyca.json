                "translations": [
                    {
                        "translation_id": "31c73a55-845d-45b8-9f40-95677f64682a",
                        "source_entry_id": "6cf908b2-5c73-3d49-9a6e-e669cefb16ca",
                        "source_sense_id": "73f2b1fb-7574-3a50-a720-8135c92cd626",
                        "target_lang_word": "Bistrița",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bistrița",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57ea9a61-7d9c-3a6f-a64f-b3592b4806e6",
                                        "entry_id": "461d8f7c-4eec-3f6f-bcdc-cbda9b50f4a9",
                                        "glosses": [
                                            "The capital city of Bistrița-Năsăud County, Romania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc98869-b168-439d-9b38-a380612e5d0b",
                                                "sense_id": "57ea9a61-7d9c-3a6f-a64f-b3592b4806e6",
                                                "text": "Bistrița lies in northern Transylvania on the Bistrița River, in a region of hills covered with orchards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a4d00a-8664-3532-8b7e-4adc8f1f1f9a",
                                        "entry_id": "461d8f7c-4eec-3f6f-bcdc-cbda9b50f4a9",
                                        "glosses": [
                                            "A river in Romania; a tributary of the Siret."
                                        ],
                                        "tags": [
                                            "with the"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec2ef45-7c4f-4d86-8616-b47e8ee0e133",
                                                "sense_id": "e1a4d00a-8664-3532-8b7e-4adc8f1f1f9a",
                                                "text": "One afternoon, while descending the eastern slopes of the Carpathians, following the northern Bistrița River, we came upon a tiny village of three or four houses, where a wedding was being celebrated."
                                            },
                                            {
                                                "example_id": "d92489f7-be69-44f6-b3e3-88efaf655ccb",
                                                "sense_id": "e1a4d00a-8664-3532-8b7e-4adc8f1f1f9a",
                                                "text": "Its white blocks of limestone suggest the ruins of a citadel guarding the narrow valley of the Bistrița. The landscapes here are of great beauty and the traveller can enjoy the comfort of the chalet near Pietrele Doamnei as well."
                                            },
                                            {
                                                "example_id": "0c85771a-5977-438b-a1fe-2b65e699af37",
                                                "sense_id": "e1a4d00a-8664-3532-8b7e-4adc8f1f1f9a",
                                                "text": "Over a pass the road ran down into Moldavia along the course of the Bistrița river."
                                            },
                                            {
                                                "example_id": "4e606866-48ed-4f55-ad73-8b7b468c76e5",
                                                "sense_id": "e1a4d00a-8664-3532-8b7e-4adc8f1f1f9a",
                                                "text": "Bistrița lies in northern Transylvania on the Bistrița River, in a region of hills covered with orchards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
