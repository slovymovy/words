                                        "sense_id": "036437ff-7d45-34d9-9517-3a44cde50276",
                                        "entry_id": "f8896111-1a6f-38a8-b343-72586562d5e0",
                                        "glosses": [
                                            "Megalomaniac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4be926f-ef19-4543-8d22-c194ffc4bdff",
                                                "sense_id": "036437ff-7d45-34d9-9517-3a44cde50276",
                                                "text": "It is Maruyama in the title role who makes this rather silly, overwrought plot work. He is alternately sinister and coy, megalomaniacal and vulnerable. He inhabits the role of a female master criminal effortlessly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
