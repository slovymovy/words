                "senses": [
                    {
                        "sense_id": "90dc4d07-6b78-37a0-9683-8e871891c230",
                        "entry_id": "c6ecbc13-86b0-3a71-92d2-2bfe7150e479",
                        "glosses": [
                            "Ergänzung, Randbemerkung, Nachtrag zu einem literarischen Werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd298f71-1c8c-4975-8a91-31091cfbc70d",
                                "sense_id": "90dc4d07-6b78-37a0-9683-8e871891c230",
                                "text": "Bekannt ist Arthur Schopenhauers Buch „Parerga und Paralipomena.“"
                            },
                            {
                                "example_id": "8de39e6c-01cf-4f6a-9c5b-d4a9121b29b5",
                                "sense_id": "90dc4d07-6b78-37a0-9683-8e871891c230",
                                "text": "Goethe hat mehr als ein Paralipomenon zu „Dichtung und Wahrheit“ geschrieben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da83c723-d480-351b-b2ce-5cd0f1674027",
                        "entry_id": "c6ecbc13-86b0-3a71-92d2-2bfe7150e479",
                        "glosses": [
                            "die Bücher der Chronik im Alten Testament"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f8014ad-bca6-495b-a19a-91f9ecf9e521",
                                "sense_id": "da83c723-d480-351b-b2ce-5cd0f1674027",
                                "text": "Statt „Erstes Buch der Chronik“ heißt es auch „Erstes Paralipomenon.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
