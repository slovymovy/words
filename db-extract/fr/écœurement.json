                "senses": [
                    {
                        "sense_id": "a98d0835-6517-33a8-a242-d1440530dc77",
                        "entry_id": "bf90d166-df00-38ea-886e-25021da6aa1f",
                        "glosses": [
                            "Fait d’être écœuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb7d41e-4525-407f-901b-8c303d3cc075",
                                "sense_id": "a98d0835-6517-33a8-a242-d1440530dc77",
                                "text": "Je ne dirai pas tout ce que l'on réserve d'écœurement aux pauvres consultants que l'on parque dans des salles d'attente [aux consultations gratuites des hôpitaux],"
                            },
                            {
                                "example_id": "ba8fef8b-33ee-461c-a3f1-264569069715",
                                "sense_id": "a98d0835-6517-33a8-a242-d1440530dc77",
                                "text": "D’écœurement, de dégoût et d’indigestion, Tintin vomit tripes et boyaux et faillit en crever pendant la nuit."
                            },
                            {
                                "example_id": "fc754892-0f0e-4a4f-9467-4d59fc76b1ad",
                                "sense_id": "a98d0835-6517-33a8-a242-d1440530dc77",
                                "text": "Mon écœurement ressemble à celui de la satiété, d’une horrible satiété."
                            }
                        ]
                    }
                ],
