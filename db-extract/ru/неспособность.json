                                "target_senses": [
                                    {
                                        "sense_id": "a4475b76-40ce-3b1f-8c89-1093186eb304",
                                        "entry_id": "1391a222-fd20-382f-8566-36da0739299b",
                                        "glosses": [
                                            "cecha tego, co jest nieudolne; cecha tych, którzy są nieudolni"
                                        ],
                                        "tags": [
                                            "deadjectival"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce952e23-849d-4a67-a02c-0afd523695ee",
                                                "sense_id": "a4475b76-40ce-3b1f-8c89-1093186eb304",
                                                "text": "Jerzy oprowadzał pana swego po całej fabryce, pokazał mu swoją machinę, a podniecony pochwałami, mówił z zapałem i z taką pewnością siebie, a wyglądał tak męsko i pięknie, iż pan jego doznał przygnębiającego uczucia własnej nieudolności — wobec niewolnika…"
                                            },
                                            {
                                                "example_id": "a5a8943d-dc9d-4899-a0bd-62a070c19643",
                                                "sense_id": "a4475b76-40ce-3b1f-8c89-1093186eb304",
                                                "text": "Premier usunął ze stanowiska swego sekretarza za jego nieudolność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
