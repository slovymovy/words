                        "source_entry_id": "c2171f02-5c0c-3456-b49b-94d15162b717",
                        "source_sense_description": "имеющий форму пирамиды",
                        "target_lang_word": "piramidaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piramidaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a4fe1ab-7e9f-36d9-b8f5-39260f5920fc",
                                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                                        "glosses": [
                                            "met een vorm die van een breed, wat hoekig grondvlak uitloopt in een punt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0dba6f6-8728-45ca-b907-dc5495e0cd3c",
                                                "sense_id": "5a4fe1ab-7e9f-36d9-b8f5-39260f5920fc",
                                                "text": "Piramidale zeeën hebben golven met puntige, spitse koppen, zoals die in het centrum van tropische orkanen en van sterk ontwikkelde stormcentra op hoge breedte voorkomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02962c10-587e-30b7-b0f2-6ee03c1bd223",
                                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                                        "glosses": [
                                            "behorend tot de getallen die aangeven hoeveel bollen er in een stapel passen als die een veelhoek van een bepaalde omvang als grondvlak heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499656f6-6013-416e-8720-6592b33932a8",
                                                "sense_id": "02962c10-587e-30b7-b0f2-6ee03c1bd223",
                                                "text": "Een driehoekige piramide met een grondvlak van 6 bollen heeft daarop nog twee lagen met 3 en 1 bol: daarom is de som van die getallen, 10 een piramidaal getal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1cd336-2783-3a10-b76b-0e7204ec407b",
                                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                                        "glosses": [
                                            "van een zeer groot formaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ded3e4f-7682-46db-abf6-9d8135466235",
                                                "sense_id": "fe1cd336-2783-3a10-b76b-0e7204ec407b",
                                                "text": "De begroting heeft een piramidaal tekort."
                                            }
                                        ]
                                    }
                                ]
