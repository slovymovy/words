                    "frequency": "Middle",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was een <w>geziene</w> gast op elk formeel evenement in de stad.",
                            "target_lang_translations": {
