                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                        "entry_id": "b3e0bc15-441f-379a-b18a-848437cc6bba",
                        "glosses": [
                            "Petit escabeau sur lequel on s’agenouille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea17b680-e313-4841-9b52-31e71d7bd977",
                                "sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                                "text": "Tous les fidèles se levèrent. Les uns allongeaient le cou, d’autres se tenaient debout sur les agenouilloirs."
                            },
                            {
                                "example_id": "b3f7c721-c9f5-44dd-b676-1ba946c58750",
                                "sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                                "text": "L’agenouilloir d’un prie-Dieu."
                            },
                            {
                                "example_id": "d5245fcc-8e91-4e6d-958a-2f39aea8c93f",
                                "sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                                "text": "Il contient les objets nécessaires à la messe, de l'autel portatif aux chandeliers et aux mouchettes, ainsi que les vêtements et accessoires spécifiques du culte, des aubes au coussin d'agenouilloir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d20a2c-068c-403d-9137-9461a5857e87",
                        "source_entry_id": "b3e0bc15-441f-379a-b18a-848437cc6bba",
                        "source_sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                        "target_lang_word": "reclinatario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bac97604-d349-4dbc-871f-4b654382d5db",
                        "source_entry_id": "b3e0bc15-441f-379a-b18a-848437cc6bba",
                        "source_sense_id": "6fd085a7-f8a0-329f-8a62-17ef8d05735d",
                        "target_lang_word": "kneeler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kneeler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "426414fe-8236-316e-a613-ea0c1c95d539",
                                        "entry_id": "8100c457-d17b-3870-9c01-9977c4b23a8c",
                                        "glosses": [
                                            "A person who kneels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e20aa6-70d5-4b41-b088-49d62efd8ab7",
                                                "sense_id": "426414fe-8236-316e-a613-ea0c1c95d539",
                                                "text": "All the kneelers sighed with relief when they were told it was over and they could finally stand up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d699dba-488c-39bf-ac11-9ea61ad99f66",
                                        "entry_id": "8100c457-d17b-3870-9c01-9977c4b23a8c",
                                        "glosses": [
                                            "A hassock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5410aedb-59fc-49e7-8d26-44263873cdac",
                                                "sense_id": "4d699dba-488c-39bf-ac11-9ea61ad99f66",
                                                "text": "The parish deacon was always pushing to get new kneelers for the church, probably because he was old and his knees were sensitive."
                                            },
                                            {
                                                "example_id": "b5be82f9-9c50-43e0-93e7-7d29ef05c485",
                                                "sense_id": "4d699dba-488c-39bf-ac11-9ea61ad99f66",
                                                "text": "The benches are scuffed Victorian, and lying on them are sets of kneelers embroidered by parishioners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319b4082-4780-3646-870a-9f6e4aeca6ad",
                                        "entry_id": "8100c457-d17b-3870-9c01-9977c4b23a8c",
                                        "glosses": [
                                            "An apparatus that permits the loading door of a bus to decrease in height in order to facilitate boarding of passengers that are seniors and physically disadvantaged"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ecf00b1-35b3-33c7-b7c5-63906a72de72",
                                        "entry_id": "8100c457-d17b-3870-9c01-9977c4b23a8c",
                                        "glosses": [
                                            "On a gable end, the stone (often decorated) at the base of the slope of the gable on either side."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
