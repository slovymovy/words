                    {
                        "sense_id": "1d2fce20-954c-3473-a52f-7e3b6892e475",
                        "entry_id": "eec06e92-fdd0-3877-aa1d-9d9447ff383f",
                        "glosses": [
                            "Relatif au pays de Canaan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5504193d-8c64-459e-beb2-ba32433e3bd6",
                                "sense_id": "1d2fce20-954c-3473-a52f-7e3b6892e475",
                                "text": "Ces résidus d’opium ont été retrouvés dans des vases en céramique découverts à Yehud (centre), dans des tombes cananéennes mises au jour en 2012 et vieilles de plus de 3 500 ans."
                            },
                            {
                                "example_id": "e65677c0-f478-414b-a11e-a5a097210fc6",
                                "sense_id": "1d2fce20-954c-3473-a52f-7e3b6892e475",
                                "text": "Les habitants de Sodome et de Gomorrhe étaient de sang cananéen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef7c8cf-311c-4907-9aaa-3b8c097b4d0a",
                        "source_entry_id": "eec06e92-fdd0-3877-aa1d-9d9447ff383f",
                        "source_sense_id": "1d2fce20-954c-3473-a52f-7e3b6892e475",
                        "target_lang_word": "Canaanite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
