                ],
                "senses": [
                    {
                        "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                        "entry_id": "a95117c9-d5e3-3b2c-a0c1-b78ec5af6732",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c845ef95-839c-4409-97eb-b09f96dabb34",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "Однажды её вызвал к себе директор комбината Борис Андреевич Молодцов."
                            },
                            {
                                "example_id": "03cf5f73-6b66-410f-84a3-a5ec9adb19aa",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "Сегодня ездил к Молодцовым под Тосно — помогал копать траншею для фундамента."
                            },
                            {
                                "example_id": "1554825f-ec88-47bc-a873-437a6e0d6874",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "Работал Андрей Молодцов за 21 руб. 60 коп."
                            },
                            {
                                "example_id": "3769379a-4481-439a-8c80-44edd4768d6c",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "В апреле 1876 года я встретил моего товарища по сцене — певца Петрушу Молодцова .."
                            },
                            {
                                "example_id": "89b87676-1113-414e-90dc-22aa82e0735c",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "Наиболее активными моими оппонентами были мои ближайшие помощники и товарищи Константин Шустин и Владимир Молодцов."
                            },
                            {
                                "example_id": "8f6c2b8e-d851-4f3e-b867-cc43bb1dbe40",
                                "sense_id": "979e5dec-6513-3d8a-a0f5-e1f05f03855f",
                                "text": "Феликс снисходительно покосился на старшего зятя и, придвинувшись к столу, стал объяснять нам с Молодцовым, почему фундамент под дом надо закладывать уже этой осенью."
                            }
                        ]
                    }
                ],
