                        ]
                    },
                    {
                        "translation_id": "8db32958-aecb-48da-9cd9-2d19c150894d",
                        "source_entry_id": "255edfcf-416b-3696-8924-1e85ece24a03",
                        "source_sense_description": "очень круто",
                        "target_lang_word": "à pic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à pic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1a5cb0-20da-33c0-bf44-56ec6ea0b5c9",
                                        "entry_id": "aad82ac5-b357-34cf-a645-f3d741f22fd9",
                                        "glosses": [
                                            "Endroit d’une montagne dont la pente est très escarpée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d82e7b-5aa3-4ad6-9f4b-ee7a0d3af644",
                                                "sense_id": "1f1a5cb0-20da-33c0-bf44-56ec6ea0b5c9",
                                                "text": "Les alpinistes eurent du mal à passer cet à pic rocheux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à pic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c910898e-d9cf-3be7-8fd4-d86aa4b5ca77",
                                        "entry_id": "0d1f3fef-7ffa-328d-a92e-6803761b08e8",
                                        "glosses": [
                                            "Perpendiculaire, vertical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c4b7a2-22f9-4294-897a-ccec2df9ee01",
                                                "sense_id": "c910898e-d9cf-3be7-8fd4-d86aa4b5ca77",
                                                "text": "Ce ne sont que des rochers à pic contre lesquels la mer se brise avec fureur : les vents et les vagues les ont façonnés en pyramides, en tours, en cavernes, en arcades; d'innombrables oiseaux de mer animent le paysage."
                                            },
                                            {
                                                "example_id": "6fa02ceb-9a98-4d9b-8750-9fecb01bcf4b",
                                                "sense_id": "c910898e-d9cf-3be7-8fd4-d86aa4b5ca77",
                                                "text": "Rien d’ailleurs d’étonnant, ces sympathiques pêcheurs férengiens passant une partie de leur vie à gravir des murailles à pic pour chasser des oiseaux."
                                            },
                                            {
                                                "example_id": "d191e2e7-cabe-41ec-a3b2-1fe66d0a2f06",
                                                "sense_id": "c910898e-d9cf-3be7-8fd4-d86aa4b5ca77",
                                                "text": "« Ils l'ont défigurée », dit-il, et il poursuivit sa route, sans être sensible ni au charme des eaux pures et courantes des rapides de Phade, ni au calme harmonieux de la cuvette d’Haulmé où la Semoy divague plus que de raison, entre une terrasse et des versants à pic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à pic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2d7dec-f933-32ab-945d-dbd4278d3e02",
                                        "entry_id": "16f32777-99f5-32ab-93a7-42f6ba9f20fd",
                                        "glosses": [
                                            "Perpendiculairement ; verticalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799ead32-4cab-4f90-8b53-29167b87fb20",
                                                "sense_id": "fe2d7dec-f933-32ab-945d-dbd4278d3e02",
                                                "text": "Le paysage était d'une indicible grandeur. De tous côtés surgissaient des montagnes plongeant à pic dans la mer, tandis que leurs cimes neigeuses se perdaient dans les nuages; […]."
                                            },
                                            {
                                                "example_id": "d4cd9fbc-e6d9-482d-8ae3-7c87b04529c7",
                                                "sense_id": "fe2d7dec-f933-32ab-945d-dbd4278d3e02",
                                                "text": "En un éclair, j’ai vu ma triste adolescence — non pas ainsi que les noyés repassent leur vie, dit-on, avant de couler à pic, car ce n’était sûrement pas une suite de tableaux presque instantanément déroulés — non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
