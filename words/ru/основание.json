                            },
                            {
                                "target_lang_word": "tesis",
                                "target_lang_sense_clarification": "kurma, yapılandırma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0a350b9-be77-3a59-8963-05579873e173",
                    "sense_definition": "Причина или повод, которые объясняют или оправдывают какое-либо действие или вывод.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reason_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У полиции не было никаких законных <w>оснований</w> задерживать водителя.",
                            "target_lang_translations": {
                                "en": "The police had no legal <w>grounds</w> to detain the driver.",
                                "tr": "Polisin sürücüyü gözaltına almak için hiçbir yasal <w>gerekçesi</w> yoktu."
                            }
                        },
                        {
                            "text": "Ваше поведение даёт мне <w>основание</w> думать, что вы говорите неправду.",
                            "target_lang_translations": {
                                "en": "Your behavior gives me <w>reason</w> to think that you are not telling the truth.",
                                "tr": "Davranışınız bana yalan söylediğinizi düşünmek için <w>neden</w> veriyor."
                            }
                        }
                    ],
                    "synonyms": [
