                "senses": [
                    {
                        "sense_id": "d4508484-a45a-3d45-b77c-82213bdf8cb2",
                        "entry_id": "474c0383-f9a9-3ed3-8c28-3f8928934d35",
                        "glosses": [
                            "One who gobbles:",
                            "A turkey."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8c88ae2c-d118-482f-aa30-fd90849a32e2",
                                "sense_id": "d4508484-a45a-3d45-b77c-82213bdf8cb2",
                                "text": "Do you slip back to your truck and find another gobbler to hunt? Trying to outcall the other hunter could work, but it creates a competitive and possibly dangerous situation."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa12519c-fe50-33ce-b4a4-b11032033d10",
                        "entry_id": "474c0383-f9a9-3ed3-8c28-3f8928934d35",
                        "glosses": [
                            "One who gobbles:",
                            "A turkey.",
                            "Especially, a male turkey."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f60df6a5-db2c-3f0e-866b-fadf6fb48661",
                        "entry_id": "474c0383-f9a9-3ed3-8c28-3f8928934d35",
                        "glosses": [
                            "One who gobbles:",
                            "One who eats food very quickly, without decorum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b380a7a3-c227-426e-b130-f5a6bafb1b07",
                                "sense_id": "f60df6a5-db2c-3f0e-866b-fadf6fb48661",
                                "text": "My dog is such a gobbler: she can empty her food dish in less than a minute."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83938838-764b-4a9a-a3ce-6213195ec701",
                        "source_entry_id": "474c0383-f9a9-3ed3-8c28-3f8928934d35",
                        "source_sense_description": "slang: turkey",
                        "target_lang_word": "индю́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "индю́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                        "entry_id": "0e9710a7-9b4f-37b7-be06-d4860ab798de",
                                        "glosses": [
                                            "самец индейки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7e3cfe-cf46-4085-81aa-82311f4be083",
                                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                                "text": "Индюк, распустив хвост и чертя крыльями землю, надменно […] кружил вокруг тонкошеих индюшек."
                                            },
                                            {
                                                "example_id": "2a9381d0-cf90-4847-af01-383e937d1b00",
                                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                                "text": "Индюк завидовал Гусям, / Что могут плавать там и сям."
                                            },
                                            {
                                                "example_id": "40342c98-8508-49b9-a2f2-574e831412dd",
                                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                                "text": "— Цып! Цып! Цып! — раздался её голос. Озарённая солнцем, […] она стояла посреди зелёного двора… и со всех сторон к ней бежали куры, петухи, поспешали, как-бы стесняясь своей тяжеловатой неловкости, индюки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                                        "entry_id": "0e9710a7-9b4f-37b7-be06-d4860ab798de",
                                        "glosses": [
                                            "перен., разг., бран. о глупом, заносчивом, надменном человеке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf57ef3-1b56-486d-b1b3-b7a6255ed068",
                                                "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                                                "text": "— Только мне неудивительно, как это вы курс кончили, образование получили, а вместо того, чтобы этого индюка наставлять, руку его держите."
                                            },
                                            {
                                                "example_id": "3eea5fc5-09b2-4062-9ae5-adc835c52732",
                                                "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                                                "text": "Индюк — одно из выражений Паустовского. Это о тех, что чванливы и глупы, как индюки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2271bfa3-0647-495d-8bc8-65b54d8aedf6",
                        "source_entry_id": "474c0383-f9a9-3ed3-8c28-3f8928934d35",
