                "senses": [
                    {
                        "sense_id": "5b870aec-8577-36b3-af02-c3256af87559",
                        "entry_id": "d99f9d5a-1697-3246-9fac-b933bdff6de1",
                        "glosses": [
                            "An ancient Chinese march during the Zhou dynasty"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c5d2296e-4ce1-408f-b203-0e1db7bea4af",
                                "sense_id": "5b870aec-8577-36b3-af02-c3256af87559",
                                "text": "TO ASSAULT a strong and cohesive enemy head-on is to invite disaster. The stratagem of besieging the kingdom of Wei to save the kingdom of Zhao advocates indirect confrontation."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f4d01c1-019e-3fdc-a2ff-ef11fbcee729",
                        "entry_id": "d99f9d5a-1697-3246-9fac-b933bdff6de1",
                        "glosses": [
                            "Liang, the realm of the earlier march after its elevation to a kingdom"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cefb970f-e8b0-304e-a216-2ff5cf502262",
                        "entry_id": "d99f9d5a-1697-3246-9fac-b933bdff6de1",
                        "glosses": [
                            "A kingdom during the Three Kingdoms interregnum following China's Han dynasty."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a2479915-d830-4290-9ce3-ec6d15ecd784",
                                "sense_id": "cefb970f-e8b0-304e-a216-2ff5cf502262",
                                "text": "After the Empire of Han was taken over by Wei (220) in the fifth year of the Ch’ing-lung period (237), the statue was moved from Ch’ang-an, the capital of Han, to Hsü-ch’ang, the capital of Wei, in modern Honan province."
                            },
                            {
                                "example_id": "e7931ffa-0c69-4c29-9f75-253da2dbc146",
                                "sense_id": "cefb970f-e8b0-304e-a216-2ff5cf502262",
                                "text": "Cao Cao was the final chancellor of the Eastern Han dynasty, who went on to form his own state during the political turmoil of the Three Kingdoms period. He died in 220 AD in Luoyang, the capital of the Eastern Han dynasty, and was posthumously named Emperor of the Wei state that he founded."
                            }
                        ]
                    }
