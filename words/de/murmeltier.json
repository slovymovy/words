                    "sense_id": "af118797-0a30-3ca8-ba11-c0437cc48803",
                    "sense_definition": "ein im Gebirge lebendes, Winterschlaf haltendes Nagetier aus der Familie der Hörnchen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Während unserer Wanderung in den Bergen sahen wir ein kleines <w>Murmeltier</w> auf einem Felsen sitzen.",
                            "target_lang_translations": {
                                "en": "During our hike in the mountains, we saw a small <w>marmot</w> sitting on a rock."
                            }
                        },
                        {
                            "text": "Das <w>Murmeltier</w> verbringt die kalten Wintermonate schlafend in seinem unterirdischen Bau.",
                            "target_lang_translations": {
                                "en": "The <w>marmot</w> spends the cold winter months sleeping in its underground burrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "Alpenmurmeltier",
                        "Marmota marmota"
                    ],
                    "common_phrases": [
                        "Winterschlaf des Murmeltiers"
                    ],
                    "target_lang_definitions": {
                        "en": "a mountain-dwelling, hibernating rodent of the squirrel family"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "marmot",
                                "target_lang_sense_clarification": "rodent"
                            },
                            {
                                "target_lang_word": "alpine marmot",
                                "target_lang_sense_clarification": "European species"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "080c431e-4934-30e7-a80a-0b154d015889",
                    "sense_definition": "eine Person, die sehr gerne, tief oder besonders lange schläft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mensch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am Wochenende schläft mein Bruder wie ein <w>Murmeltier</w> bis zum Mittagessen.",
                            "target_lang_translations": {
                                "en": "On weekends, my brother sleeps <w>like a log</w> until lunchtime."
                            }
                        },
                        {
                            "text": "Wach endlich auf, du faules <w>Murmeltier</w>, sonst verpassen wir unseren Zug!",
                            "target_lang_translations": {
                                "en": "Wake up already, you lazy <w>sleepyhead</w>, or we'll miss our train!"
                            }
                        }
                    ],
                    "synonyms": [
                        "Schlafmütze"
                    ],
                    "common_phrases": [
                        "schlafen wie ein Murmeltier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "übertragen verwendet"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person who likes to sleep deeply, late, or for a long time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleepyhead",
                                "target_lang_sense_clarification": "informal, affectionate"
                            },
                            {
                                "target_lang_word": "dormouse",
                                "target_lang_sense_clarification": "idiomatic, heavy sleeper"
                            },
                            {
                                "target_lang_word": "heavy sleeper",
                                "target_lang_sense_clarification": "person who sleeps deeply"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617e3455-87e3-35d1-a728-9300224dbe6a",
                    "sense_definition": "die zoologische Gattung Marmota innerhalb der Familie der Hörnchen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verschiedene Arten der <w>Murmeltiere</w> sind sowohl in Nordamerika als auch im nördlichen Eurasien beheimatet.",
                            "target_lang_translations": {
                                "en": "Various species of <w>marmots</w> are native to both North America and northern Eurasia."
                            }
                        },
                        {
                            "text": "Die zoologische Gattung der <w>Murmeltiere</w> umfasst rund vierzehn eigenständige Arten.",
                            "target_lang_translations": {
                                "en": "The zoological genus of <w>marmots</w> comprises around fourteen distinct species."
                            }
                        }
                    ],
                    "synonyms": [
                        "Marmota"
