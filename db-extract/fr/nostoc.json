                "senses": [
                    {
                        "sense_id": "7500cfaf-46a5-3a8f-aa2e-0e45c39c99ef",
                        "entry_id": "37de96bb-6dc6-36a1-b4f3-2b04c112f8ba",
                        "glosses": [
                            "Cyanobactérie du genre Nostoc, ressemblant à une algue quand elle forme une masse gélatineuse ; gonflée d'eau en période humide, elle est à peine visible en période sèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f3a96b-34f6-4871-85c8-0bae1fa6428b",
                                "sense_id": "7500cfaf-46a5-3a8f-aa2e-0e45c39c99ef",
                                "text": "Le nostoc n'apparaît que dans les jours pluvieux ; on le trouve en toute saison dans les prairies, le long des chemins et dans les allées sablées des jardins."
                            },
                            {
                                "example_id": "c1297218-4379-4812-8308-9bf0ed326882",
                                "sense_id": "7500cfaf-46a5-3a8f-aa2e-0e45c39c99ef",
                                "text": "Le nostoc permettrait de lutter contre la maladie d’Alzheimer d’après les chercheurs de l’université et de l’école polytechnique de Zurich."
                            }
                        ]
                    }
                ],
