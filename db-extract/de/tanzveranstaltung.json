                "senses": [
                    {
                        "sense_id": "7b264dd1-b27f-33b3-a44e-f60cb54c1c99",
                        "entry_id": "10818e4e-3aab-3f12-9716-d3e08528c717",
                        "glosses": [
                            "gesellschaftliches Ereignis, bei dem Gelegenheit zum Tanzen gegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7462f3b6-8a34-4066-9a16-41bf65221bd6",
                                "sense_id": "7b264dd1-b27f-33b3-a44e-f60cb54c1c99",
                                "text": "„Wenn Elsa von Filmvorführungen, Tanzveranstaltungen oder ihrem Heinz erzählte, war da dieses feine Brennen der Sehnsucht, das immer öfter nach bitterem Neid schmeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32c07c7d-95f5-4741-b37f-2af23577f92f",
                        "source_entry_id": "10818e4e-3aab-3f12-9716-d3e08528c717",
                        "source_sense_id": "7b264dd1-b27f-33b3-a44e-f60cb54c1c99",
                        "source_sense_description": "gesellschaftliches Ereignis, bei dem Gelegenheit zum Tanzen gegeben wird",
                        "target_lang_word": "dance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23ca9631-b828-31ac-8533-d3b646514cb3",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A sequence of rhythmic steps or movements usually performed to music, for pleasure or as a form of social interaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c652df3-7789-4d7c-bcf6-0c92db9c9155",
                                                "sense_id": "23ca9631-b828-31ac-8533-d3b646514cb3",
                                                "text": "I do a dance when she plays the drums!"
                                            },
                                            {
                                                "example_id": "4982198a-0ec4-4a1e-9a51-da2b227591e2",
                                                "sense_id": "23ca9631-b828-31ac-8533-d3b646514cb3",
                                                "text": "He does the Fortnite dance with his friends in school."
                                            },
                                            {
                                                "example_id": "2911439c-9fd5-4411-b636-4a80b5af9e5f",
                                                "sense_id": "23ca9631-b828-31ac-8533-d3b646514cb3",
                                                "text": "\"I ought to arise and go forth with timbrels and with dances; but, do you know, I am not inclined to revels? There has been a little—just a very little bit too much festivity so far …. Not that I don't adore dinners and gossip and dances; not that I do not love to pervade bright and glittering places.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528002de-b3c7-3d84-9764-81b138c39015",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A social gathering where dancing is the main activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ab365a-0fb8-441c-b11f-e7c5a53f7191",
                                                "sense_id": "528002de-b3c7-3d84-9764-81b138c39015",
                                                "text": "The dance we had in August 2008 is one of the greatest moments of my life!"
                                            },
                                            {
                                                "example_id": "48a305f9-4379-4ed6-9b7f-43668ef07b80",
                                                "sense_id": "528002de-b3c7-3d84-9764-81b138c39015",
                                                "text": "\"I ought to arise and go forth with timbrels and with dances; but, do you know, I am not inclined to revels? There has been a little—just a very little bit too much festivity so far …. Not that I don't adore dinners and gossip and dances; not that I do not love to pervade bright and glittering places.[…]\""
                                            },
                                            {
                                                "example_id": "7e5df27d-702a-4d14-afdd-987d57a47d2d",
                                                "sense_id": "528002de-b3c7-3d84-9764-81b138c39015",
                                                "text": "But, he continued, \"the experience of the Peking Municipal Communist Youth League shows that, as long as dance parties are organized and supervised well by the work units concerned and these units organize their own sentries, as long as the people attending these dances are given a little coaching in advance on what is meant by normal socializing and recreation, and as long as these dances are organized, led and guided properly, there will be no incidents.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36158e92-2a12-3aaa-baab-c379cf457177",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "The art, profession, and study of dancing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4626890e-0c95-3e78-a53a-5dd809df99ee",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A genre of modern music characterised by sampled beats, repetitive rhythms and few lyrics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "631781b1-c441-367e-b3c5-c531dc235727",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A piece of music with a particular dance rhythm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cf0832b-aaf1-495a-b40c-5e61d80ef1a7",
                                                "sense_id": "631781b1-c441-367e-b3c5-c531dc235727",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bdb2535-08c6-3e6c-9ea5-127b53bb389f",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A battle of wits, especially one commonly fought between two rivals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3c3f18-ebaa-4bc2-8870-842303da31fe",
                                                "sense_id": "8bdb2535-08c6-3e6c-9ea5-127b53bb389f",
                                                "text": "So how much longer are we gonna do this dance?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16333ff7-439d-3e1e-825b-eea2a62210ec",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "Any strenuous or difficult movement, action, or task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d19f5d4-0165-40f7-a8b0-d3d236f4f5a8",
                                                "sense_id": "16333ff7-439d-3e1e-825b-eea2a62210ec",
                                                "text": "He that would watch the king's hares must not drag himself along as if he was a lazybones with soles of lead to his boots, or like a fly on a tar-brush, for when the hares began to scamper about on the hill-sides it was quite another dance than lying at home and catching fleas with mittens on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f2a6ce-c3ca-304e-b1dd-4f8d3352c915",
                                        "entry_id": "d0102182-4187-30ee-b892-996fcfaf66d3",
                                        "glosses": [
                                            "A repetitive movement used in communication between worker honey bees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ad5d9e-d48a-4ad9-91c6-54445ca6ab3b",
                                                "sense_id": "c4f2a6ce-c3ca-304e-b1dd-4f8d3352c915",
                                                "text": "It was seen that the readiness to dance and intensity of the dance are clearly increased when the temperature in the hive remained between 28-36° C."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11603748-9a1c-36de-87fe-5a09332e800e",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To move with rhythmic steps or movements, especially in time to music."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66bc052e-483b-4f1d-8383-a9b302432064",
                                                "sense_id": "11603748-9a1c-36de-87fe-5a09332e800e",
                                                "text": "I danced with her all night long."
                                            },
                                            {
                                                "example_id": "4aa63127-c4ee-441f-90b4-09d092af83ff",
                                                "sense_id": "11603748-9a1c-36de-87fe-5a09332e800e",
                                                "text": "These drum beats are making me dance!"
                                            },
                                            {
                                                "example_id": "1a64bb6f-d7ac-4042-8495-6713c141930c",
                                                "sense_id": "11603748-9a1c-36de-87fe-5a09332e800e",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb8f99d-f58b-36da-9b40-c16230a85fa8",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To leap or move lightly and rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ec6387-0b0b-463f-830e-dca2c4a8f7ae",
                                                "sense_id": "ffb8f99d-f58b-36da-9b40-c16230a85fa8",
                                                "text": "His eyes danced with pleasure as he spoke. She accused her political opponent of dancing around the issue instead of confronting it."
                                            },
                                            {
                                                "example_id": "ed76b489-f4ad-4c03-814f-320ffc29280f",
                                                "sense_id": "ffb8f99d-f58b-36da-9b40-c16230a85fa8",
                                                "text": "And woods along the banks are waving high, / Whose shadows in the glassy waters dance,"
                                            },
                                            {
                                                "example_id": "a189cfc3-c498-4ff7-aa9f-76aa490fc65b",
                                                "sense_id": "ffb8f99d-f58b-36da-9b40-c16230a85fa8",
                                                "text": "A common and beautiful side-effect of high solar activity is the Aurora Borealis - the northern lights that dance across Arctic skies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197c4341-a615-349e-bbf1-ad6db061cd6a",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To perform the steps to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45bcdd14-5f57-4ee0-bfb4-a3ed00987300",
                                                "sense_id": "197c4341-a615-349e-bbf1-ad6db061cd6a",
                                                "text": "Have you ever danced the tango?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d63da5-7484-3ce6-a37d-e14314686ef2",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To cause to dance, or move nimbly or merrily about."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9182300-3285-47b5-a768-38849c6e34bf",
                                                "sense_id": "93d63da5-7484-3ce6-a37d-e14314686ef2",
                                                "text": "Met we on hill, in dale, forest, or mead,\nBy pavèd fountain, or by rushy brook,\nor in the beachèd margent of the sea,\nTo dance our ringlets to the whistling wind,\nBut with thy brawls thou hast disturbed our sport."
                                            },
                                            {
                                                "example_id": "e56518da-5e6b-43b0-b97e-0e2ae1bc021d",
                                                "sense_id": "93d63da5-7484-3ce6-a37d-e14314686ef2",
                                                "text": "Thy grandsire loved thee well; / Many a time he danced thee on his knee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b71fde-e7f9-33ef-88f0-1c5ae20832e9",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To make love or have sex."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8320913-b799-4314-b695-83d8592af9cf",
                                                "sense_id": "86b71fde-e7f9-33ef-88f0-1c5ae20832e9",
                                                "text": "You make me feel like dancing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "956dc460-6e4b-37b9-b41b-d9f5c644a062",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To make a repetitive movement in order to communicate to other worker honey bees."
                                        ],
                                        "tags": [
                                            "of a worker honey bee"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be53b5d-22c1-4d47-a675-a56ea87862ac",
                                                "sense_id": "956dc460-6e4b-37b9-b41b-d9f5c644a062",
                                                "text": "It was seen that the readiness to dance and intensity of the dance are clearly increased when the temperature in the hive remained between 28-36° C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                        "entry_id": "7d12f4b8-190e-3977-8f42-ff19112992ad",
                                        "glosses": [
                                            "To kick and convulse from the effects of being hanged."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e0257ae-4576-46a3-9b82-391de148339e",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "If that veil can be maintained, if the workers can be kept from knowing the perfidy of officials, the criminality of capitalism, the murderous vengeance that is planned by the plutocratic powers of America, then Charles Moyer, William D. Haywood, and George Pettibone will dance on empty air, while the ghouls of capitalism rejoice because they have landed another blow upon the body of resisting labor."
                                            },
                                            {
                                                "example_id": "d4fd4d8a-73af-4867-96ad-ad4b72e0f58c",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "Beneath the shoulder blades of the limp form lying there lay the heart that had hated him, that had beat high at the thought of seeing him kick at the end of a hangman's rope, that had exulted in the prospect of him dancing a death dance on air."
                                            },
                                            {
                                                "example_id": "ea03a3e2-165b-4fa0-9227-cc650ea4639b",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "Simon had seen other men executed at Berkeley, both in the castle and outside in the village. They were usually strung up like rats, left to dance, their death throes sometimes seeming to last forever."
                                            },
                                            {
                                                "example_id": "c35acdbb-ad2c-4c19-aad8-477585bf2c23",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "'Hats off!' the shout went up, not out of respect for those about to die, but for a better view of their death dance. The hangman, who was as drunk as anyone else, uncoiled the rope's free end from each prisoner in turn and threw it up to an assistant balanced precariously on the beam above. Each was tightly fastened, leaving very little slack. When the moment came, the carts would be driven out from under the prisoners, leaving them dancing the Tyburn jig, their legs paddling helplessly in the air."
                                            },
                                            {
                                                "example_id": "eaf17734-3137-43b2-998e-0b611faec0d5",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "Not only will you be whipped, but Jack Ketch will be displeased. He knows how to attach the rope just so...a man's neck can be snaped in an instant and he feels pain for a moment only. Or, at Ketch's pleasure, the man swings in the air, his legs dance in an ungainly manner, his face turns red, his tongue turns purple and protrudes - a poor devil once bit off the tip and spit it out, and he chocked(sic) to death."
                                            },
                                            {
                                                "example_id": "8e7ce267-0dcd-4efa-a1cd-79c2c3c35db9",
                                                "sense_id": "c9fba363-7a56-3a0d-9c33-33a0f370a9a9",
                                                "text": "Initially, all hanging deaths were by the short rope. The victims strangled as they performed a twitching death dance. Over time there was a move to a longer rope. The extra drop meant the victim's neck snapped, causing a more humane death. For a long time adter the long rope was introduced, stories circulated around Aberdeen of executioners slipping in the short rope for criminals convicted of particularly heinous crimes, especially for crimes against children. No quick end for these devils. A slow dancing death, courtesy of the short rope, brouht in by canny executioners."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04654cba-242b-358b-a954-fa87b4e70dcb",
                                        "entry_id": "7d470d93-013b-3570-b650-4dc9e1c6dbc5",
                                        "glosses": [
                                            "A normally horizontal stripe called a fess that has been modified to zig-zag across the center of a coat of arms from dexter to sinister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc3ce88-1131-418a-a154-992256caf04a",
                                                "sense_id": "04654cba-242b-358b-a954-fa87b4e70dcb",
                                                "text": "The fact appears to have been that Simon de Montacute bore two coats; the one, Argent, three fusils, which it is most probable was a corruption of a fess dancette, or a dance, Gules; and the other, Azure, a griffin segreant[…]"
                                            },
                                            {
                                                "example_id": "db1c0e53-1f3a-4781-bac4-8b66348e5ac6",
                                                "sense_id": "04654cba-242b-358b-a954-fa87b4e70dcb",
                                                "text": "It is as follows - being headed by a shield of arms in colours - gold with a dance gules between three croslets fitchy gules."
                                            },
                                            {
                                                "example_id": "e7ed0bb8-09fb-4f72-990e-bd500b9914bb",
                                                "sense_id": "04654cba-242b-358b-a954-fa87b4e70dcb",
                                                "text": "Or, a dance gules, in chief 3 lions' faces sable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
