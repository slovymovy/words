                        "target_lang_word": "vomit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vomit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef927575-9937-3382-b43f-735dec94e857",
                                        "entry_id": "bea1db3d-f686-3fae-aeb9-4840698a4044",
                                        "glosses": [
                                            "To regurgitate or eject the contents of the stomach through the mouth; puke."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef0b7837-5755-4f91-b543-0a8d2a613d48",
                                                "sense_id": "ef927575-9937-3382-b43f-735dec94e857",
                                                "text": "The fish […] vomited out Jonah upon the dry land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2c6ce2-629b-3ea5-9065-3febc4aca5cd",
                                        "entry_id": "bea1db3d-f686-3fae-aeb9-4840698a4044",
                                        "glosses": [
                                            "To regurgitate and discharge (something swallowed); to spew."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a058ea-b137-411b-9a7a-1509c75655ca",
                                                "sense_id": "9c2c6ce2-629b-3ea5-9065-3febc4aca5cd",
                                                "text": "It is the illicit Christmas pudding an incorrigible servant cooks for the little boy one Christmas Day that sparks Oscar's first crisis of belief, for his father, opposed to Christmas pudding on theological grounds, makes the child vomit his helping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                        "entry_id": "bea1db3d-f686-3fae-aeb9-4840698a4044",
                                        "glosses": [
                                            "To eject from any hollow place; to belch forth; to emit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802607b3-83ed-42e6-b1be-ff6f8d647625",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "She snapped and started vomiting curses at us."
                                            },
                                            {
                                                "example_id": "956e6111-8b8b-4976-b1c3-67247c9ff2d8",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "Like the sons of Vulcan, vomit smoke.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "3134bf07-bcb3-4788-9b88-be4022714cd0",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "[…]a column of smoke, such as might be vomited by a park of artillery, spread noiseless over the fields, the road, the common, and rolled, he said, blue and dim to his very feet."
                                            },
                                            {
                                                "example_id": "8adda788-183d-4808-b741-0923c0f9c1fb",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "There was a chest of drawers with an escrutoire top, for Uriah to read or write at of an evening; there was Uriah’s blue bag lying down and vomiting papers; there was a company of Uriah’s books, commanded by Mr. Tidd; there was a corner cupboard; and there were the usual articles of furniture."
                                            },
                                            {
                                                "example_id": "b1514c7e-3414-47a3-a8f0-71415c7ed03e",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "\"Hullo!\" said the athlete, and vomited with this greeting a cloud of tobacco-smoke. It must have been imprisoned in his mouth some time, for no pipe was visible."
                                            },
                                            {
                                                "example_id": "267bf3ad-0863-4e16-82f6-c331c4605c36",
                                                "sense_id": "4cf9cbe5-17ca-3ec7-ac0d-1e296ac01535",
                                                "text": "After about a minute, the creek bed vomited the debris into a gently sloped meadow. Saugstad felt the snow slow and tried to keep her hands in front of her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vomit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13f3487a-92e1-3365-954f-61c4da44661c",
                                        "entry_id": "ae7bb3b3-f451-3c44-8672-00e2e1005ea9",
                                        "glosses": [
                                            "The regurgitated former contents of a stomach; vomitus."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb0a823-e3a5-4724-9639-a3f91d985fae",
                                                "sense_id": "13f3487a-92e1-3365-954f-61c4da44661c",
                                                "text": "For all tables are full of vomite and filthinesse, so that there is no place cleane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bdb94fc-c981-3812-a93f-f70ff7250f2b",
                                        "entry_id": "ae7bb3b3-f451-3c44-8672-00e2e1005ea9",
                                        "glosses": [
                                            "The act of regurgitating."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b642a9ec-f409-31c0-9524-4f052be8c51c",
                                        "entry_id": "ae7bb3b3-f451-3c44-8672-00e2e1005ea9",
                                        "glosses": [
                                            "The act of vomiting."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e93358-724b-4f41-932d-37ab2541c3fa",
                                                "sense_id": "b642a9ec-f409-31c0-9524-4f052be8c51c",
                                                "text": "He removes his hat without misgiving, he unbuttons his coat and sits down, proffered all pure and open to the long joys of being himself, like a basin to a vomit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764a4040-2b6a-3cf4-91b8-a794e34fd84a",
                                        "entry_id": "ae7bb3b3-f451-3c44-8672-00e2e1005ea9",
                                        "glosses": [
                                            "Anything that is worthless; rubbish; trash."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4fd52af-ce38-4002-bdaf-60a18c777b27",
                                                "sense_id": "764a4040-2b6a-3cf4-91b8-a794e34fd84a",
                                                "text": "\"[Y]ou've spent so much of your life writing romantic vomit for morons that the mushy bit of the brain you did have has gone rancid.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09884beb-b688-3af2-9fa6-6e4ec01219b6",
                                        "entry_id": "ae7bb3b3-f451-3c44-8672-00e2e1005ea9",
                                        "glosses": [
                                            "That which causes vomiting; an emetic."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fd5236-632e-40bb-9e20-3e089710590d",
                                                "sense_id": "09884beb-b688-3af2-9fa6-6e4ec01219b6",
                                                "text": "He gives your Hollander a vomit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
