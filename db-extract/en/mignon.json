                        "tags": [
                            "plural"
                        ],
                        "form": "Mignons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43fa044c-6290-30f8-8a63-71ae59792686",
                        "entry_id": "0a0a307e-2e2e-31e0-8b6b-509aaf2bc8fc",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5e30ce-4e75-482c-ab3d-4e4f1360edfc",
                                "sense_id": "43fa044c-6290-30f8-8a63-71ae59792686",
                                "text": "'Yes,' said Mignon, and stretched out her hand for it, but they would not let her take it back."
                            },
                            {
                                "example_id": "4059f004-b3b9-4182-a56c-4066d69793bb",
                                "sense_id": "43fa044c-6290-30f8-8a63-71ae59792686",
                                "text": "Surprisingly, Mignon Anderson, for all her innocence, was born into a theatrical family–in Baltimore, Maryland, on March 31,1892."
                            },
                            {
                                "example_id": "a1eb70df-9d2c-48bb-b1f3-4841984d5efa",
                                "sense_id": "43fa044c-6290-30f8-8a63-71ae59792686",
                                "text": "\"What will you call yourself? You aren't a Mignon or a Ninette, or anything-ette. […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cf228c2d-3919-33c3-8794-d917138421aa",
                        "entry_id": "0a0a307e-2e2e-31e0-8b6b-509aaf2bc8fc",
