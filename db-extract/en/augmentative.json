                                    {
                                        "sense_id": "f260962a-dd40-33a5-b1be-e43f7b56e849",
                                        "entry_id": "51aa4489-49e1-3392-822b-4fb708ac3977",
                                        "glosses": [
                                            "durch ein Präfix oder ein Suffix gekennzeichnete Vergrößerungsform (Ableitung) eines Substantivs; Gegensatz zum Diminutiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58534e31-75fc-4727-be5e-108d89387aa9",
                                                "sense_id": "f260962a-dd40-33a5-b1be-e43f7b56e849",
                                                "text": "Das Präfix über macht aus dem Wort Größe das Augmentativ Übergröße."
