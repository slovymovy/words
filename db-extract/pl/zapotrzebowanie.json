                    },
                    {
                        "sense_id": "cd1cad93-2d68-3df3-a90a-3f7e3e828f01",
                        "entry_id": "bab0b7f7-0973-3547-9bdd-4b5d752a695a",
                        "glosses": [
                            "druk, dokument z wyszczególnionymi potrzebami, np. w zakresie zakupów"
                        ],
                        "tags": [],
