                    {
                        "translation_id": "14823207-6932-4755-b2d0-77e10b74abc0",
                        "source_entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                        "source_sense_description": "act of treating with contempt",
                        "target_lang_word": "dérision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                        "entry_id": "fd5c8bb7-5545-3c9f-a85a-76bcad3d9678",
                                        "glosses": [
                                            "Moquerie souvent accompagnée de mépris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26891008-9f6f-4cf3-acd6-b961af2c9afb",
                                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                                "text": "Et quand en 1840, notre vin de Moselle ne fut qu'un âpre verjus, nos vignerons, par dérision et par haine du Prussien, donnèrent sarcastiquement à ce vin imbuvable le sobriquet de : Hassenpflug."
                                            },
                                            {
                                                "example_id": "bc2fb4cb-ad44-46cd-a85e-9d582feae729",
                                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                                "text": "C’est un homme qui tourne tout en dérision."
                                            },
                                            {
                                                "example_id": "d1ccaa15-aa4c-4c8e-8119-6dd48aa32e81",
                                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                                "text": "C’est une dérision, une dérision amère que de prêcher l’abstinence aux gens dépourvus de tout."
                                            },
                                            {
                                                "example_id": "5db6d818-9f5b-4268-a828-227fdd3334e9",
                                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                                "text": "C’est une dérision que d’offrir cent francs pour un pareil travail."
                                            },
                                            {
                                                "example_id": "9dcf98c1-7b67-4124-b019-641eded2f67a",
                                                "sense_id": "266c1173-353e-3204-b095-9e613310be74",
                                                "text": "La dérision en toutes choses est l’ultime défi au malheur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6490afd3-903f-403f-9caf-3a9cddd8bc4d",
                        "source_entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                        "source_sense_description": "act of treating with contempt",
                        "target_lang_word": "Hohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                        "entry_id": "db220548-ae48-390c-ad26-5f00b01ce7c8",
                                        "glosses": [
                                            "demütigender, beißender Spott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee37adc6-982c-4946-92e9-58a1d104e900",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "Es hätte genügt zu sagen, der Versuch sei gescheitert; den Hohn dabei hättest du dir ruhig sparen können."
                                            },
                                            {
                                                "example_id": "34916666-4c2f-4a4e-ac99-5b981a222b99",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "Das Interview mit dem Vorsitzenden der Bank war der reinste Hohn."
                                            },
                                            {
                                                "example_id": "0675ccbc-c5f8-4588-89a8-1a33f898f557",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "„Er kommt an den Pranger, wird dem öffentlichen Hohn und Spott ausgesetzt.“"
                                            },
                                            {
                                                "example_id": "7305719a-fea2-4de7-9027-8a444b5e9371",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "„Der Hohn tut Wiegand beinahe körperlich weh.“"
                                            },
                                            {
                                                "example_id": "c375d170-f21b-4a26-8639-789b69452f04",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "„Wir sind die Kinder von Helios,“ schmettert […] ein Chor und verspricht: „Vom Besten zu lernen, ohne Schranken ein Team, bei uns ist jeder Moment Medizin.“ Für die Mitarbeiter klingt das wie Hohn."
                                            },
                                            {
                                                "example_id": "083d640c-c409-4404-9c9d-cec2aec3ad35",
                                                "sense_id": "f60114ca-c5bb-32c0-840c-c247dbbd2a28",
                                                "text": "„Die tiefsten Demütigungen, der schneidendste Hohn dieser Weißen war ebenso spurlos an seinem Gesichte abgeprallt, wie ihre zuvorkommendste Güte, ihre edelmütigsten Aufopferungen ihm kaum ein Lächeln abzwangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "191a281a-190f-4520-879e-08c5a5d5b856",
                        "source_entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                        "source_sense_description": "act of treating with contempt",
                        "target_lang_word": "Spott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                        "entry_id": "58c66ca9-3bc7-3f79-9b92-bf4982277704",
                                        "glosses": [
                                            "schadenfrohes Belustigen über jemanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fefb8c6-830c-499b-9a59-87408517c843",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "Drei Tage lang war der Dieb am Pranger dem Spott und Hohn der Gesellschaft ausgesetzt."
                                            },
                                            {
                                                "example_id": "6d4a4bd3-43dd-4dc2-ae44-de2ed290a331",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "„Ich empfand das nicht als Spott, obwohl jeder ihrer Sätze einen spöttischen Unterton hatte, ich war glücklich, daß sie etwas sagte, das so genau meiner Stimmung entsprach.“"
                                            },
                                            {
                                                "example_id": "51981b18-fcff-4eaf-94a7-93b9e0410a05",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "„Spott und superiore Witzelei waren allein der richtige Ton, und als ihm dies feststand, fiel zum erstenmal der Vorhang.“"
                                            },
                                            {
                                                "example_id": "95c9b4bc-6c1d-4fcb-a8ee-8af48aa2dc6c",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "„Der Blick des Kapitäns fiel mit einem unnennbaren Ausdruck von Spott und Verachtung auf den Mann.“"
                                            },
                                            {
                                                "example_id": "29334a86-9663-4531-9875-b394fe66e02b",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "„Ihn erreicht ihr Spott nicht mehr.“"
                                            },
                                            {
                                                "example_id": "2cfff286-e6b8-4fdd-ab09-3f796bddfb29",
                                                "sense_id": "25078384-e2cb-353e-b272-894f6aad2df9",
                                                "text": "„Ja, meine hingebende Herzlichkeit trat so offen hervor, daß sie oft den Spott meiner Kameraden herausforderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c08c64c5-b375-4c6a-a6e4-fc5b5ec08e35",
                        "source_entry_id": "d9108606-0e15-3221-ab87-8058295261de",
                        "source_sense_description": "act of treating with contempt",
                        "target_lang_word": "Verhöhnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhöhnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "058557c0-015b-3324-9b2a-3ea67633b22c",
                                        "entry_id": "06f364e8-f000-3c4d-836b-2d7dd0127cd9",
                                        "glosses": [
                                            "Handlung, jemanden abfällig/beleidigend zu behandeln und Ergebnis dieser Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa993b8d-e2e6-402e-a65c-a1be7fd8c958",
                                                "sense_id": "058557c0-015b-3324-9b2a-3ea67633b22c",
                                                "text": "„Der Alte hatte das als Verhöhnung aufgefaßt.“"
                                            },
                                            {
                                                "example_id": "c343df14-2704-4d1f-ba6e-4823174d6343",
                                                "sense_id": "058557c0-015b-3324-9b2a-3ea67633b22c",
                                                "text": "„Der Kontinentalverband untersucht die fremdenfeindlichen Verhöhnungen von Frankreichs schwarzen Spielern durch Anhänger des Balkan-Teams im Gruppenspiel am vergangenen Donnerstag (2:2).“"
                                            },
                                            {
                                                "example_id": "224b2f8d-afac-4c3d-b2de-ce178b56250d",
                                                "sense_id": "058557c0-015b-3324-9b2a-3ea67633b22c",
                                                "text": "„In Berlin lief es zweieinhalb Jahre lang, in anderen Städten wurde es als Schweinerei, Verhöhnung der deutschen Frau, der Kriegsverletzten, der deutschen Studenten, des deutschen Beamtentums beschimpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
