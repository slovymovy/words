                        ],
                        "examples": [
                            {
                                "example_id": "ca46bc5f-9a57-4d71-b3f3-9f85172f4483",
                                "sense_id": "9e3e0f62-33d9-356a-8764-0f7713674b0a",
                                "text": "I am going to the Sierra next weekend."
                            },
                            {
                                "example_id": "09e40770-02ac-47ec-be3f-ca091a757e94",
                                "sense_id": "9e3e0f62-33d9-356a-8764-0f7713674b0a",
                                "text": "Most flocks in the Sierra and the Rocky Mountains live above the timber-line and at an altitude of twelve thousand feet."
                            },
                            {
                                "example_id": "81f34b05-4e45-45ba-9938-311ea988a639",
                                "sense_id": "9e3e0f62-33d9-356a-8764-0f7713674b0a",
                                "text": "Los Angeles would still be a piddling little town in a desert if it weren’t for Sierra snowmelt and city officials crafty enough to snooker eastern California farmers out of their water rights."
                            }
                        ]
                    }
