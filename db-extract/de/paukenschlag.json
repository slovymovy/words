                            {
                                "example_id": "3524c5a6-52cc-48c6-b511-74a9a2030536",
                                "sense_id": "05ef5caf-0179-372d-9909-50d4a2d7f7df",
                                "text": "mit einem Paukenschlag",
                                "translation": "with a bang",
                                "english": "with a bang"
                            },
                            {
                                "example_id": "144bb34e-3757-4e43-a773-9f85185f8a85",
                                "sense_id": "05ef5caf-0179-372d-9909-50d4a2d7f7df",
                                "text": "Der Roman beginnt mit einem Paukenschlag, Hamsuns wahrlich makabrem Nekrolog auf Adolf Hitler vom 7.5.1945, dem letzten Kriegstag in Norwegen.",
                                "translation": "The novel begins with a bang, Hamsun's truly macabre obituary of Adolf Hitler from 7 May 1945, the last day of the war in Norway.",
                                "english": "The novel begins with a bang, Hamsun's truly macabre obituary of Adolf Hitler from 7 May 1945, the last day of the war in Norway."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d42e7a1-36f9-30a9-90b6-09cc04e301c3",
                        "entry_id": "39e24404-7654-3152-938f-de5373aee597",
                        "glosses": [
                            "bombshell; a surprising or shocking development"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "42593eed-69d1-4da8-88aa-434293f24371",
                                "sense_id": "2d42e7a1-36f9-30a9-90b6-09cc04e301c3",
                                "text": "Das Urteil ist ein politischer Paukenschlag in Frankreich: Wegen der Veruntreuung von EU-Geldern darf die rechtsnationale Politikerin Le Pen bei der kommenden Präsidentschaftswahl nicht antreten.",
                                "translation": "The judgement is a political bombshell in France: Owing to her embezzlement of EU funds, right-wing nationalist politician Le Pen will not be able to stand for the coming presidential election.",
                                "english": "The judgement is a political bombshell in France: Owing to her embezzlement of EU funds, right-wing nationalist politician Le Pen will not be able to stand for the coming presidential election."
                            }
                        ]
                    }
