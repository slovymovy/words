    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82d41ad6-f581-3f15-9e4e-f04fbe256afe",
                    "sense_definition": "Se faire accorder une chose que l'on désire ou que l'on sollicite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle espère <w>obtenir</w> une bourse pour financer ses études à l'étranger."
                        },
                        {
                            "text": "Après plusieurs appels, il a enfin réussi à <w>obtenir</w> un rendez-vous chez le médecin."
                        }
                    ],
                    "synonyms": [
                        "décrocher",
                        "recevoir"
                    ],
                    "antonyms": [
                        "perdre"
                    ],
                    "common_phrases": [
                        "obtenir un rendez-vous",
                        "obtenir une réponse",
                        "obtenir l'accord"
                    ]
                },
                {
                    "sense_id": "879aa4b3-b255-3f6d-9146-1f6fa22a760d",
                    "sense_definition": "Avoir pour résultat ou produit d'une action, d'une opération ou d'un processus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resultat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En mélangeant ces deux ingrédients, on <w>obtient</w> une préparation très homogène."
                        },
                        {
                            "text": "Cette équipe de chercheurs espère <w>obtenir</w> un bon résultat avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "produire"
                    ],
                    "common_phrases": [
                        "obtenir un résultat",
                        "obtenir satisfaction"
                    ]
                },
                {
                    "sense_id": "9393ef78-ee16-378e-82ac-629de9843d00",
                    "sense_definition": "Parvenir à faire prononcer ou accorder par la justice ce que l'on réclame légalement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a plaidé la cause pour <w>obtenir</w> un jugement favorable devant le tribunal."
                        },
                        {
                            "text": "La victime espère <w>obtenir</w> réparation pour les préjudices subis durant l'incident."
                        }
                    ],
                    "common_phrases": [
                        "obtenir un jugement",
                        "obtenir réparation",
                        "obtenir gain de cause"
                    ]
                }
            ]
        }
    ]
