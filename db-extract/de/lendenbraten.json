                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0907fd6f-13f8-451b-b1fb-f045da1bbed0",
                                "sense_id": "6c17571a-7eaa-3af9-b652-828549f029aa",
                                "text": "„Der Lendenbraten ist das Mürbeste und wird allem andern vorgezogen.“"
                            },
                            {
                                "example_id": "8387ac4e-d767-47da-9f13-555aae3e34e0",
                                "sense_id": "6c17571a-7eaa-3af9-b652-828549f029aa",
                                "text": "„Stellen Sie sich vor, dass eine tschechische Hausfrau Ihnen zarten, mit Speck gespickten Lendenbraten serviert.“"
                            },
                            {
                                "example_id": "e9c7e2f2-be8e-4fd9-b799-6d248998b17b",
                                "sense_id": "6c17571a-7eaa-3af9-b652-828549f029aa",
                                "text": "„Zum Lendenbraten wurde Burgunder gereicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
