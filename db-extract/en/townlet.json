                    {
                        "translation_id": "2ab93d3e-0573-4500-90bd-95202a0bcb7d",
                        "source_entry_id": "5cda1c8b-e032-31c9-b9d7-51c3f8ec3e8e",
                        "source_sense_id": "db54526a-54eb-3687-9a3c-448b476ad4a4",
