{
    "word_family": [
        "vaulter",
        "vaulting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b8b2652-1d8e-32c9-bc2c-ddb480563c3f",
                    "sense_definition": "A secure room with thick walls and a strong door, used to store money or valuables.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves tried to break into the bank <w>vault</w> at night.",
                            "target_lang_translations": {
                                "ru": "Воры пытались проникнуть в банковское <w>хранилище</w> ночью.",
                                "zh": "小偷们试图在夜里闯入银行的<w>金库</w>。",
                                "it": "I ladri hanno tentato di scassinare il <w>caveau</w> della banca durante la notte."
                            }
                        },
                        {
                            "text": "She keeps her expensive jewelry in a secure <w>vault</w>.",
                            "target_lang_translations": {
                                "ru": "Она хранит свои дорогие украшения в надежном <w>сейфе</w>.",
                                "zh": "她把昂贵的珠宝存放在一个安全的<w>保险库</w>里。",
                                "it": "Custodisce i suoi gioielli costosi in una <w>cassaforte</w> sicura."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bank vault",
                        "secure vault",
                        "underground vault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепленное помещение с толстыми стенами и прочной дверью для хранения денег или ценностей.",
                        "zh": "一种带有厚墙和坚固大门的保险室，用于存放金钱或贵重物品。",
                        "it": "Una stanza sicura con pareti spesse e una porta blindata, utilizzata per conservare denaro o oggetti di valore."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хранилище",
                                "target_lang_sense_clarification": "помещение для ценностей"
                            },
                            {
                                "target_lang_word": "сейф",
                                "target_lang_sense_clarification": "укрепленный шкаф или комната"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金库",
                                "target_lang_sense_clarification": "银行等存放贵重物品的保险室"
                            },
                            {
                                "target_lang_word": "保险库",
                                "target_lang_sense_clarification": "存放贵重物品的坚固房间"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "caveau",
                                "target_lang_sense_clarification": "stanza blindata di una banca"
                            },
                            {
                                "target_lang_word": "cassaforte",
                                "target_lang_sense_clarification": "contenitore o stanza blindata per oggetti preziosi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa189d25-b9f6-3193-98da-aba6b66f238c",
                    "sense_definition": "A room, usually underground, where dead people are buried.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was laid to rest in the royal <w>vault</w>.",
                            "target_lang_translations": {
                                "ru": "Король был похоронен в королевском <w>склепе</w>.",
                                "zh": "国王被安葬在皇家<w>墓穴</w>中。",
                                "it": "Il re fu sepolto nella <w>cripta</w> reale."
                            }
                        },
                        {
                            "text": "They visited the family <w>vault</w> in the old cemetery.",
                            "target_lang_translations": {
                                "ru": "Они посетили фамильный <w>склеп</w> на старом кладбище.",
                                "zh": "他们参观了旧墓地里的家族<w>墓穴</w>。",
                                "it": "Hanno visitato la <w>tomba</w> di famiglia nel vecchio cimitero."
                            }
                        }
                    ],
                    "synonyms": [
                        "tomb",
                        "sepulchre"
                    ],
                    "common_phrases": [
                        "family vault",
                        "burial vault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещение, обычно подземное, где хоронят умерших.",
                        "zh": "通常位于地下的埋葬死者的房间。",
                        "it": "Una stanza, solitamente sotterranea, dove vengono sepolti i defunti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склеп",
                                "target_lang_sense_clarification": "усыпальница"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "墓穴",
                                "target_lang_sense_clarification": "埋葬死者的地下室"
                            },
                            {
                                "target_lang_word": "地下墓室",
                                "target_lang_sense_clarification": "用于安葬的地下建筑"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "cripta",
                                "target_lang_sense_clarification": "luogo sotterraneo di sepoltura"
                            },
                            {
                                "target_lang_word": "sepolcro",
                                "target_lang_sense_clarification": "luogo destinato alla sepoltura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0e8938b-2f4f-3cd3-a9fb-4602650d9ae0",
                    "sense_definition": "An arched structure made of stone or brick that forms a ceiling or roof.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral features a magnificent stone <w>vault</w>.",
                            "target_lang_translations": {
                                "ru": "В соборе есть великолепный каменный <w>свод</w>.",
                                "zh": "这座大教堂拥有宏伟的石制<w>拱顶</w>。",
                                "it": "La cattedrale presenta una magnifica <w>volta</w> in pietra."
                            }
                        },
                        {
                            "text": "Painters decorated the <w>vault</w> of the chapel with stars.",
                            "target_lang_translations": {
                                "ru": "Художники украсили <w>свод</w> часовни звездами.",
                                "zh": "画家们在礼拜堂的<w>拱顶</w>上装饰了星星。",
                                "it": "I pittori hanno decorato la <w>volta</w> della cappella con delle stelle."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone vault",
                        "ribbed vault",
                        "barrel vault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Арочная конструкция из камня или кирпича, образующая потолок или крышу.",
                        "zh": "一种由石头或砖块砌成的拱形结构，构成天花板或屋顶。",
                        "it": "Una struttura ad arco in pietra o mattoni che forma un soffitto o una copertura."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свод",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拱顶",
                                "target_lang_sense_clarification": "建筑中的拱形天花板"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "volta",
                                "target_lang_sense_clarification": "elemento architettonico a copertura curva"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1539d905-ed1a-3fdd-8da1-377350470238",
                    "sense_definition": "A jump performed by pushing off an object with the hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast performed a perfect <w>vault</w> to win the competition.",
                            "target_lang_translations": {
                                "ru": "Гимнаст выполнил идеальный <w>опорный прыжок</w>, чтобы выиграть соревнования.",
                                "zh": "体操运动员完成了一个完美的<w>跳马</w>动作，赢得了比赛。",
                                "it": "La ginnasta ha eseguito un <w>volteggio</w> perfetto per vincere la gara."
                            }
                        },
                        {
                            "text": "He is training for the pole <w>vault</w> event.",
                            "target_lang_translations": {
                                "ru": "Он готовится к соревнованиям по <w>прыжкам</w> с шестом.",
                                "zh": "他正在为<w>撑杆跳</w>项目进行训练。",
                                "it": "Si sta allenando per la gara di <w>salto</w> con l'asta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pole vault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прыжок, выполняемый с отталкиванием руками от предмета.",
                        "zh": "通过手部支撑推离物体而完成的跳跃动作。",
                        "it": "Un salto eseguito spingendosi con le mani da un oggetto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорный прыжок",
                                "target_lang_sense_clarification": "гимнастика"
                            },
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳马",
                                "target_lang_sense_clarification": "体操运动项目"
                            },
                            {
                                "target_lang_word": "撑杆跳",
                                "target_lang_sense_clarification": "田径运动项目"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "volteggio",
                                "target_lang_sense_clarification": "specialità della ginnastica"
                            },
                            {
                                "target_lang_word": "salto",
                                "target_lang_sense_clarification": "movimento atletico di elevazione"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cdf6927-5ede-32be-9ae7-61911308d986",
                    "sense_definition": "To jump over something using the hands or a pole for support.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief <w>vaulted</w> over the wall to escape.",
                            "target_lang_translations": {
                                "ru": "Вор <w>перепрыгнул</w> через стену, чтобы сбежать.",
                                "zh": "小偷<w>跃过</w>墙壁逃跑了。",
                                "it": "Il ladro ha <w>scavalcato</w> il muro per scappare."
                            }
                        },
                        {
                            "text": "She <w>vaulted</w> the fence with ease.",
                            "target_lang_translations": {
                                "ru": "Она с легкостью <w>перепрыгнула</w> через забор.",
                                "zh": "她轻松地<w>跃过</w>了栅栏。",
                                "it": "Ha <w>saltato</w> la recinzione con facilità."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vault over",
                        "vault a fence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перепрыгивать через что-либо, опираясь руками или используя шест.",
                        "zh": "利用手部或撑杆支撑跳过某物。",
                        "it": "Saltare sopra qualcosa usando le mani o un'asta come supporto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепрыгивать",
                                "target_lang_sense_clarification": "через препятствие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跃过",
                                "target_lang_sense_clarification": "跳过障碍物"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "saltare",
                                "target_lang_sense_clarification": "superare un ostacolo con un salto"
                            },
                            {
                                "target_lang_word": "scavalcare",
                                "target_lang_sense_clarification": "superare un ostacolo passando sopra"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6eae11e2-a668-3537-ae6b-16aa7c44b044",
                    "sense_definition": "To remove content from a video game so it is no longer available to players.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developers <w>vaulted</w> the weapon to balance the game.",
                            "target_lang_translations": {
                                "ru": "Разработчики <w>убрали</w> это оружие <w>в архив</w> для баланса игры.",
                                "zh": "开发人员为了平衡游戏，将该武器<w>封存</w>了。",
                                "it": "Gli sviluppatori hanno <w>rimosso</w> l'arma per bilanciare il gioco."
                            }
                        },
                        {
                            "text": "Several old maps were <w>vaulted</w> in the latest update.",
                            "target_lang_translations": {
                                "ru": "Несколько старых карт были <w>изъяты</w> в последнем обновлении.",
                                "zh": "在最近的更新中，几张旧地图被<w>封存</w>了。",
                                "it": "Diverse vecchie mappe sono state <w>archiviate</w> nell'ultimo aggiornamento."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять контент из видеоигры, делая его недоступным для игроков.",
                        "zh": "将游戏内容从游戏中移除，使其不再对玩家可用。",
                        "it": "Rimuovere contenuti da un videogioco rendendoli non più disponibili ai giocatori."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убирать в архив",
                                "target_lang_sense_clarification": "игровой контент"
                            },
                            {
                                "target_lang_word": "изымать",
                                "target_lang_sense_clarification": "из игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封存",
                                "target_lang_sense_clarification": "游戏内容暂时下架"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "rimuovere",
                                "target_lang_sense_clarification": "togliere dal gioco"
                            },
                            {
                                "target_lang_word": "archiviare",
                                "target_lang_sense_clarification": "mettere da parte temporaneamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fb25023-51b7-3554-b02f-5181103994b2",
                    "sense_definition": "To build or cover with an arched ceiling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trees <w>vaulted</w> the path, creating a green tunnel.",
                            "target_lang_translations": {
                                "ru": "Деревья <w>смыкались сводом</w> над тропинкой, создавая зеленый туннель.",
                                "zh": "树木在小径上方<w>筑拱</w>，形成了一条绿色的隧道。",
                                "it": "Gli alberi <w>voltavano</w> il sentiero, creando un tunnel verde."
                            }
                        },
                        {
                            "text": "The architect <w>vaulted</w> the main hall to create a sense of space.",
                            "target_lang_translations": {
                                "ru": "Архитектор <w>перекрыл сводом</w> главный зал, чтобы создать ощущение простора.",
                                "zh": "建筑师为大厅<w>筑拱</w>，以营造出空间感。",
                                "it": "L'architetto ha <w>coperto a volta</w> la sala principale per creare un senso di spazio."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строить или покрывать арочным потолком.",
                        "zh": "建造或覆盖拱形天花板。",
                        "it": "Costruire o coprire con un soffitto ad arco."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекрывать сводом",
                                "target_lang_sense_clarification": "архитектура"
                            },
                            {
                                "target_lang_word": "смыкаться сводом",
                                "target_lang_sense_clarification": "о деревьях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筑拱",
                                "target_lang_sense_clarification": "建造拱形结构"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "voltare",
                                "target_lang_sense_clarification": "coprire con una volta"
                            },
                            {
                                "target_lang_word": "coprire a volta",
                                "target_lang_sense_clarification": "realizzare una copertura arcuata"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}