        "fr-extract.jsonl": [
            {
                "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                "word": "richement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dcedc9ea-1cfa-3f4f-9e56-663a9da562d0",
                        "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                        "glosses": [
                            "D’une manière riche ; magnifiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f306e88-5f19-474b-b198-7645623b85d5",
                                "sense_id": "dcedc9ea-1cfa-3f4f-9e56-663a9da562d0",
                                "text": "Ils escortaient une litière richement tapissée, qui s’arrêta en face du roi."
                            },
                            {
                                "example_id": "046d688b-a344-455a-8d64-1f950eeb868c",
                                "sense_id": "dcedc9ea-1cfa-3f4f-9e56-663a9da562d0",
                                "text": "Derrière eux vient une litière fermée recouverte de maroquin et pourvue, devant et derrière, de brancards entre lesquels marchent des mules richement harnachées."
                            }
                        ]
                    },
                    {
                        "sense_id": "c08a1a6c-7cd8-3acc-864b-976986301c99",
                        "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                        "glosses": [
                            "Avec des ressources considérables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b58d95f-cd28-41cc-813e-6eaff037df21",
                                "sense_id": "c08a1a6c-7cd8-3acc-864b-976986301c99",
                                "text": "Marier une fille richement."
                            }
                        ]
                    },
                    {
                        "sense_id": "628490db-ebe9-3411-ac3c-9b82c1ce3921",
                        "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                        "glosses": [
                            "En pourvoyant de ressources considérables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd43b28-524f-4c81-b879-1e9438f47a1e",
                                "sense_id": "628490db-ebe9-3411-ac3c-9b82c1ce3921",
                                "text": "Pourvoir richement ses enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "809e96d9-e412-3595-b062-2f564f42bb23",
                        "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                        "glosses": [
                            "Au delà du suffisant ; d'une façon superflue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847148ad-baf2-4119-bcfe-8f0ae34dff49",
                                "sense_id": "809e96d9-e412-3595-b062-2f564f42bb23",
                                "text": "Ce poète rime richement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed05a56b-8f56-3121-816f-267eb3c0c827",
                        "entry_id": "a453f8ac-a44e-3037-a015-d9f8cd0e0338",
                        "glosses": [
                            "Beaucoup ; très."
