                        "glosses": [
                            "Relatif à la zoogéographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d9df68-20a4-4f7a-8c5e-a5fccb381ba2",
                                "sense_id": "258277a9-ce24-3976-980a-c918586f4871",
                                "text": "Il est donc impossible de trouver un système général de divisions zoogéographiques qui convienne à toutes les espèces animales terrestres."
                            },
                            {
                                "example_id": "32845dc3-c476-4c0e-a262-b0cb95e6904d",
                                "sense_id": "258277a9-ce24-3976-980a-c918586f4871",
                                "text": "La province zoogéographique était définie comme une vaste aire où est présente une faune caractéristique en raison d'une position géographique par rapport à des barrières (y compris climatiques), en excluant ainsi le faciès en tant que facteur de contrôle du provincialisme."
                            }
                        ]
                    }
