                "translations": [
                    {
                        "translation_id": "bcb2150e-f7ea-46f2-9282-d768d99d34ee",
                        "source_entry_id": "09aa19de-f05d-3a32-898f-5afc55c9bebb",
                        "source_sense_id": "1b66701f-2d9b-373e-97ef-32d8848ae3e4",
                        "source_sense_description": "ervandoor gaan",
                        "target_lang_word": "davonmachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "davonmachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4abb308c-f2a5-348b-9b01-fc6cbdb24935",
                                        "entry_id": "e90e5e02-5444-3419-b7ff-bb279d030911",
                                        "glosses": [
                                            "einen Ort verlassen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb2a163-7961-4ab5-ab2f-826d88b68b2d",
                                                "sense_id": "4abb308c-f2a5-348b-9b01-fc6cbdb24935",
                                                "text": "So gegen zehn hat sie sich dann still und heimlich davongemacht."
                                            },
                                            {
                                                "example_id": "be8c14fd-83d5-4295-80b8-d7bbc4d35163",
                                                "sense_id": "4abb308c-f2a5-348b-9b01-fc6cbdb24935",
                                                "text": "Vorsichtig schlichen sie dem sich davonmachenden Pärchen hinterher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "752f5c75-3502-3006-a085-93a0efe5ff2c",
                                        "entry_id": "e90e5e02-5444-3419-b7ff-bb279d030911",
                                        "glosses": [
                                            "sterben"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d854441-1b1f-4a0a-9d52-e976c1398ef6",
                                                "sense_id": "752f5c75-3502-3006-a085-93a0efe5ff2c",
                                                "text": "„Wo bist du jetzt, Ernst? Bist du noch in der Nähe, oder hast du dich schon davongemacht in eine andere Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d991bd67-eb90-4262-8482-bac9204e7a9b",
                        "source_entry_id": "09aa19de-f05d-3a32-898f-5afc55c9bebb",
                        "source_sense_id": "1b66701f-2d9b-373e-97ef-32d8848ae3e4",
                        "source_sense_description": "ervandoor gaan",
                        "target_lang_word": "casser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af011825-e6db-3a72-a2b0-b88bbc8f0570",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Briser ; rompre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cfb715-0ec0-4363-a4b1-8aea2923be53",
                                                "sense_id": "af011825-e6db-3a72-a2b0-b88bbc8f0570",
                                                "text": "M. Eyssette hausse les épaules :\n— Si c’est Jacques qui y va, dit-il, la cruche est cassée, c’est sûr.\n— Tu entends, Jacques, — c’est madame Eyssette qui parle avec sa voix tranquille, — tu entends, ne la casse pas, fais bien attention.\nM. Eyssette reprend :\n— Oh ! tu as beau lui dire de ne pas la casser, il la cassera tout de même.\nIci, la voix éplorée de Jacques :\n— Mais enfin, pourquoi voulez-vous que je la casse ?\n— Je ne veux pas que tu la casses, je te dis que tu la casseras, répond M. Eyssette, et d’un ton qui n’admet pas de réplique."
                                            },
                                            {
                                                "example_id": "ab3d0b36-acc2-4512-a077-839657b74001",
                                                "sense_id": "af011825-e6db-3a72-a2b0-b88bbc8f0570",
                                                "text": "Il y a des engueulades qui rougissent les yeux, bleuissent les joues, crispent les poings, arrachent les cheveux, cassent les œufs, renversent les éventaires, dépoitraillent les matrones, et me remplissent d'une joie pure."
                                            },
                                            {
                                                "example_id": "d2552403-9b5f-4b2c-b022-3132afc69649",
                                                "sense_id": "af011825-e6db-3a72-a2b0-b88bbc8f0570",
                                                "text": "[…], et elle lui fit signe d'attendre qu'elle eût fini de donner à boire à cet affligé, un malheureux couvreur qui s’était cassé les deux bras en tombant d'un toit."
                                            },
                                            {
                                                "example_id": "d39d2156-7a5f-4dcc-b815-714ead53cb46",
                                                "sense_id": "af011825-e6db-3a72-a2b0-b88bbc8f0570",
                                                "text": "Le thermomètre est descendu à -6° ; tout le gréement était couvert de givre et de glace que je dus casser en montant dans la mâture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce1880b-f799-333d-a34e-9be272acc855",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Se dit lorsqu’une mousse retombe après avoir été battue ou remuée trop énergiquement, ce qui la liquéfie en brisant les bulles d’air qu’elle contient et en chassant l’air de l’émulsion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4237376-1b7a-4e79-b7b8-35e520065b99",
                                                "sense_id": "4ce1880b-f799-333d-a34e-9be272acc855",
                                                "text": "Mais ne fouette pas tant les blancs en neige, malheureux ! Tu vas les casser !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381eb69-db83-30b2-8791-6aa36f0f5bb6",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Imprimer un angle à une ligne ou un objet droit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7567b0de-db1e-4b6b-89e9-1e064e60de7a",
                                                "sense_id": "6381eb69-db83-30b2-8791-6aa36f0f5bb6",
                                                "text": "Lorsqu’on manie un fusil il existe quelques règles primordiales. Ainsi, lorsqu’on se déplace il faut toujours casser le fusil, voire le décharger. Lors d’un rassemblement entre chasseurs, casser et décharger sont nécessaires. Ces mesures s’imposent aussi lorsque le chasseur franchit un obstacle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2122c3-eeb6-323a-85d0-0fd031903a4d",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Affaiblir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b771fc26-b775-459c-97cd-95211ad8c4ce",
                                                "sense_id": "ad2122c3-eeb6-323a-85d0-0fd031903a4d",
                                                "text": "Abdu et Hamid font partie des chanceux ; d’autres le sont moins. Les plus fragiles se sont « clochardisés », trop abîmés, cassés au terme de leur périple par l’ultime épreuve de la rue, témoigne une habitante du quartier Jaurès."
                                            },
                                            {
                                                "example_id": "6fc32e62-d8a8-49b1-aa57-11bdc7664630",
                                                "sense_id": "ad2122c3-eeb6-323a-85d0-0fd031903a4d",
                                                "text": "Les fatigues de la guerre, les débauches l’ont bien cassé."
                                            },
                                            {
                                                "example_id": "0eb62ebb-119d-4217-9fd5-4bbcd4078cf1",
                                                "sense_id": "ad2122c3-eeb6-323a-85d0-0fd031903a4d",
                                                "text": "Il a la voix cassée."
                                            },
                                            {
                                                "example_id": "7f3caf7e-a923-447b-a234-272a9f34abcc",
                                                "sense_id": "ad2122c3-eeb6-323a-85d0-0fd031903a4d",
                                                "text": "Après cette séance de musculation, j’étais cassé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbd62dd-4b91-3652-9562-4a4880a6ff4a",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Assouplir une chaussure, souvent par un usage modéré après leur acquisition."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe70891d-c7f7-40cf-b396-8cdf1855ebd5",
                                                "sense_id": "0cbd62dd-4b91-3652-9562-4a4880a6ff4a",
                                                "text": "Si vous songez à vous lancer dans un trek au long cours juste après avoir acheté ces Chameleon, renoncez tout de suite à cette idée. Prenez le temps de les casser lors de petites marches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e45320-3adc-3286-ad78-1f9cf08bb4a4",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Annuler, déclarer nul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8165582-dff4-4c50-9c6b-fd7d7cf676b9",
                                                "sense_id": "37e45320-3adc-3286-ad78-1f9cf08bb4a4",
                                                "text": "Afin d'obtenir la révision du procès, Voltaire publie, en 1763, l’ouvrage Traité sur la tolérance à l'occasion de la mort de Jean Calas, tandis que la famille obtient un entretien à Versailles auprès de Louis XV. Après deux ans d’instruction, le Conseil du roi casse l’arrêt du parlement de Toulouse le 4 juin 1764 pour vice de procédure et renvoie l’affaire devant le tribunal des Requêtes pour qu’il soit statué au fond."
                                            },
                                            {
                                                "example_id": "f4555cae-7a4b-41c5-8c1a-e511c62cfb1e",
                                                "sense_id": "37e45320-3adc-3286-ad78-1f9cf08bb4a4",
                                                "text": "Casser un mariage."
                                            },
                                            {
                                                "example_id": "c99e4333-69f3-434d-8f81-92641213de9f",
                                                "sense_id": "37e45320-3adc-3286-ad78-1f9cf08bb4a4",
                                                "text": "Casser un testament, un contrat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686470cf-4e3c-3190-a3c2-f48afe7a2c78",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Rétrograder ; renvoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "938b3ce1-467c-4e6d-b74a-707c8cfa0cb1",
                                                "sense_id": "686470cf-4e3c-3190-a3c2-f48afe7a2c78",
                                                "text": "À bout de patience, Bïin de Bourdon se rendit chez l'alcade, et le somma de s'occuper immédiatement de cette affaire, criant, tapant sur la table et le menaçant, s'il ne se dépêchait, de le faire casser par son ministre."
                                            },
                                            {
                                                "example_id": "01f338fc-69a6-4960-843b-b58a17b1f8de",
                                                "sense_id": "686470cf-4e3c-3190-a3c2-f48afe7a2c78",
                                                "text": "Ancien sous-off’ de la Légion, il avait d’abord été cassé de son grade, puis ayant « passé au falot », il s’était vu condamner à trente ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f65f8513-c84d-3b36-aba2-7ee5fcdfc3c2",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Humilier, brocarder quelqu’un par des paroles."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab11863-2ec2-4b9c-bab3-a85cfc927e70",
                                                "sense_id": "f65f8513-c84d-3b36-aba2-7ee5fcdfc3c2",
                                                "text": "J’t’ai cassé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7648d75a-cc7e-3c04-ba3e-627dcf1f19e6",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Dire, parler.(Voir casser le morceau)"
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31602bc8-f7b8-4d92-9d06-ab1983c9baec",
                                                "sense_id": "7648d75a-cc7e-3c04-ba3e-627dcf1f19e6",
                                                "text": "Depuis dix secondes qu’il savait, il en cassait plus une, Léo s’inquiétait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edf2975-d0d2-3cb3-97b2-86ac1ef3c7b4",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Cambrioler, faire un casse."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78741c8c-7c79-44ea-9772-f10d4995fe58",
                                                "sense_id": "4edf2975-d0d2-3cb3-97b2-86ac1ef3c7b4",
                                                "text": "Ils vont toujours par trois, soit pour serrer, soit pour casser…\n— Casser ?\n— J’veux dire cambrioler. Comprenez-vous, C’est l’terme. Un casseur, ça signifie un cambrio et son boulot s’appelle un cassement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb34b68-5586-37c6-8ce1-a0eff2b97ef9",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Faire la monnaie d’un billet de banque."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a63f27e-62ff-4f53-ad70-817c36bc422f",
                                                "sense_id": "8cb34b68-5586-37c6-8ce1-a0eff2b97ef9",
                                                "text": "Dix mille francs, c’était donc plus que son butin habituel, mais ce n’était pas assez. Ce n’était rien. Il avait deux cent mille francs de dettes, d’abord ; ‬et puis sa faculté de dépenser, sa brusquerie à casser un billet dans une soirée avait crû d’année en année."
                                            },
                                            {
                                                "example_id": "21b722c2-c6f3-4337-9db2-56550e5af1c8",
                                                "sense_id": "8cb34b68-5586-37c6-8ce1-a0eff2b97ef9",
                                                "text": "Pourrais-tu me casser ce vingt ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f65f549-d731-3d8c-9d0a-dcf96fd0925c",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "ou Se briser, se rompre."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa7b74a-e37a-4ed2-a0bc-8558c9f792a9",
                                                "sense_id": "6f65f549-d731-3d8c-9d0a-dcf96fd0925c",
                                                "text": "La mer est dure et houleuse, le remorquage pénible. À midi, la remorque casse et le motor yacht me quitte fort vite en me saluant, car il désire rentrer avant l’arrivée du grain."
                                            },
                                            {
                                                "example_id": "60fe5e58-3c6b-478f-9f1f-db5e7eb655bc",
                                                "sense_id": "6f65f549-d731-3d8c-9d0a-dcf96fd0925c",
                                                "text": "Soudain, la chaîne du vélo casse alors que je suis tout près du village de Voves en Eure-et-Loir, à une vingtaine de kilomètres de Chartres."
                                            },
                                            {
                                                "example_id": "981e5197-153d-429a-b2e8-fa75fd2deed0",
                                                "sense_id": "6f65f549-d731-3d8c-9d0a-dcf96fd0925c",
                                                "text": "Finalement, les cornes du bouc se cassèrent net et elles restèrent fichées dans la caboche du malin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c4ba0c-d873-351b-acf4-756340728396",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Rompre une relation amoureuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5bdb71-2afc-4729-a04c-5407127cda1d",
                                                "sense_id": "88c4ba0c-d873-351b-acf4-756340728396",
                                                "text": "— Qui gage qu'ils vont casser samedi soir, vers 17h34?"
                                            },
                                            {
                                                "example_id": "67d3febc-0c67-40eb-9b2e-ece6efcb1576",
                                                "sense_id": "88c4ba0c-d873-351b-acf4-756340728396",
                                                "text": "Je pleure parce que je viens de casser avec mon mec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d8979e-a087-32e2-84b5-a0b6a636d14f",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Partir, s’en aller."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff8c782b-84e5-4a91-b194-1e7f2a4357f2",
                                                "sense_id": "14d8979e-a087-32e2-84b5-a0b6a636d14f",
                                                "text": "Casse-toi, pauv’ con !"
                                            },
                                            {
                                                "example_id": "40b01e5b-0eb5-425e-888a-de9d922b920f",
                                                "sense_id": "14d8979e-a087-32e2-84b5-a0b6a636d14f",
                                                "text": "On se casse, les gars ! Les flics se pointent !'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72b2acb-d05d-3dc3-a600-cfd667fa41d4",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Débourrer un cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e7d1e7-07fd-483f-87f3-fbe61d748b72",
                                                "sense_id": "f72b2acb-d05d-3dc3-a600-cfd667fa41d4",
                                                "text": "Pour l’ébahissement de cette famille fermière, nous débourrâmes, ou – pour employer l’argot du cow-boy – nous « cassâmes » les deux rouans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bb83ba-ad35-39cd-9031-2fecd79287db",
                                        "entry_id": "94c9fcf2-f069-392a-a596-7685b9a370b5",
                                        "glosses": [
                                            "Faire la casse, débuter une partie en envoyant la boule blanche dans les autres disposées en triangle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
