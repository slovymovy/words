                "senses": [
                    {
                        "sense_id": "1e5d5176-faef-3a14-8ad5-ef32148125b3",
                        "entry_id": "824c39c8-b5e2-36e7-b75e-86b9c3b20375",
                        "glosses": [
                            "mężczyzna wykonujący zdjęcia na zlecenie redakcji lub agencji prasowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ccfa02-bea5-4560-ab31-0ef4b640acf1",
                                "sense_id": "1e5d5176-faef-3a14-8ad5-ef32148125b3",
                                "text": "Wyrywał się policjantom i próbował kopnąć naszego fotoreportera"
                            },
                            {
                                "example_id": "7f73dcb3-816a-4e89-9cd0-cbdff1c1d1e0",
                                "sense_id": "1e5d5176-faef-3a14-8ad5-ef32148125b3",
                                "text": "Przeszli kilka kroków w stronę recepcji, kiedy dopadł ich jeden z fotoreporterów, obwieszony aż trzema aparatami, fleszem i światłomierzem"
                            },
                            {
                                "example_id": "1750b4b5-c9e0-4628-b30f-707ed7ccaac5",
                                "sense_id": "1e5d5176-faef-3a14-8ad5-ef32148125b3",
                                "text": "Aparaty profesjonalne używane przez fotoreporterów kosztują dziesiątki tysięcy dolarów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
