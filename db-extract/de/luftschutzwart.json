                        "glosses": [
                            "Person, die in der NS-Zeit in Deutschland für Aufsicht und Organisation des Luftschutzes in einem bestimmten Bereich zuständig war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1226d677-7c0f-41d3-b810-65cf78792ea4",
                                "sense_id": "346367f6-c3b5-330c-b423-144f1ba9394a",
                                "text": "„Die Männer drücken sich die Hände, dann gehen die beiden Luftschutzwarte in die Straße hinein.“"
                            },
                            {
                                "example_id": "5093ba7c-c36a-4f24-b3ca-0523d83ecc14",
                                "sense_id": "346367f6-c3b5-330c-b423-144f1ba9394a",
                                "text": "„Ein Luftschutzwart kam heran.“"
                            },
                            {
                                "example_id": "60d5c9e9-bb9b-4c20-b889-ffdd0a62dee3",
                                "sense_id": "346367f6-c3b5-330c-b423-144f1ba9394a",
                                "text": "„Ein Luftschutzwart will mich in einen Bunker winken.“"
                            }
                        ],
