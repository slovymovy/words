                "senses": [
                    {
                        "sense_id": "acc54447-660d-3e63-8eb9-78e09e1367f4",
                        "entry_id": "d468cba6-cb92-3c5c-9df1-c0f80c588372",
                        "glosses": [
                            "Fotografie einer Person, auf der diese barbrüstig beziehungsweise barbusig, allgemein auch kein Oberteil tragend, zu sehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a99634c-6e05-4308-ae5a-5dc7cfeff192",
                                "sense_id": "acc54447-660d-3e63-8eb9-78e09e1367f4",
                                "text": "[26. Mai 1999:] „Das britische Königshaus und die Öffentlichkeit reagieren entrüstet auf die Veröffentlichung eines Oben-ohne-Foto[s] von Sophie Rhys-Jones, der Verlobten von Prinz Edward, im Massenblatt ‚Sun‘. Der Schnappschuss wurde 1988 in Spanien aufgenommen.“"
                            },
                            {
                                "example_id": "e1c2276b-a4c8-4669-b890-d1aceb6b5ed7",
                                "sense_id": "acc54447-660d-3e63-8eb9-78e09e1367f4",
                                "text": "„Der kanadische Premier Justin Trudeau hat wieder einmal mit einem Oben-ohne-Foto sein Land in Aufregung versetzt.“"
                            },
                            {
                                "example_id": "023c2bdc-e2f8-4484-a04e-703a4e89be72",
                                "sense_id": "acc54447-660d-3e63-8eb9-78e09e1367f4",
                                "text": "„Der Wachbeamte, der das Oben-ohne-Foto in der Zeitung anschaute, war klein und sein Haar blass, wie die Champignonsuppe aus der Dose, die man uns dienstags vorsetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
