                        "sense_id": "90ca49c2-e91e-32cd-b001-06e90175dda7",
                        "entry_id": "f3c6daa0-f4d2-3c5b-b35c-5ad40550b5a6",
                        "glosses": [
                            "een snelle, scherpe reactie op een opmerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9cdf2c-350e-4245-8cdd-6bb75ebbff19",
                                "sense_id": "90ca49c2-e91e-32cd-b001-06e90175dda7",
                                "text": "De talkshowhost is heel alert op wat er gezegd wordt en weet als geen ander een snelle riposte te plaatsen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d38f61a6-acfd-421d-8f11-eecc1c17f1ee",
                        "source_entry_id": "f3c6daa0-f4d2-3c5b-b35c-5ad40550b5a6",
                        "source_sense_id": "90ca49c2-e91e-32cd-b001-06e90175dda7",
                        "source_sense_description": "een snelle, scherpe reactie op een opmerking",
                        "target_lang_word": "riposte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riposte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7848e3cb-34fb-3daf-8543-4cebbfffbd8d",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A thrust given in return after parrying an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22c8f44b-05d2-36e8-9754-d554a7af083a",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A counter-attack in any combat or any sport."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c017e21-2339-4ee7-bf79-25521b25b060",
                                                "sense_id": "22c8f44b-05d2-36e8-9754-d554a7af083a",
                                                "text": "Some context is required. Moldova were weak at the back and blunt up front, and have failed to score in six matches stretching back to last October, with only hints at English complacency offering them glimpses of summoning a riposte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "A quick and usually witty response to a taunt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "308cfb6e-80c4-4ca0-a830-edb1c6e9f1a8",
                                                "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                                "text": "This face-saving reminds us of some American ripostes a few months back when their space rockets seemed disinclined to leave the earth very far behind; after all, they said, the Russians are only chucking heavy machinery at the moon, whereas we're trying to be more sophisticated and get a sewing-machine up there."
                                            },
                                            {
                                                "example_id": "129bd7c3-c2a5-4788-98f0-f59d0fd319aa",
                                                "sense_id": "39ef7dbf-7214-37f2-b623-ca8affcf2c6b",
                                                "text": "Watson’s letter was a riposte to the accusation made on Tuesday by Corbyn’s campaign that he was “peddling conspiracy theories” after he said in a Guardian interview that Labour was at risk from “Trotskyist entryists”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d846328b-4e1e-3b41-be42-1c29f489e973",
                                        "entry_id": "f2527259-f936-384c-a948-159921f37060",
                                        "glosses": [
                                            "An answer or reply, rapidly uttered, in response to a question or problem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "riposte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "732b0c57-78da-3f73-8be1-06d67e7b0ba4",
                                        "entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                                        "glosses": [
                                            "To attempt to hit an opponent after parrying an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                                        "entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                                        "glosses": [
                                            "To respond quickly; particularly if the response is humorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03d502f-6bc4-4da3-ba6d-f522a0c0854d",
                                                "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                                                "text": "I left him and went to a tavern by the quays where the college bucks were drinking and singing hymns. There was Giles who invited old men back to his college apartments for games. Members of the rowing club riposted, for God's sake, man, clean up your life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c0a5128-80d4-4688-bc5b-a0040db6855d",
                        "source_entry_id": "f3c6daa0-f4d2-3c5b-b35c-5ad40550b5a6",
                        "source_sense_id": "90ca49c2-e91e-32cd-b001-06e90175dda7",
                        "source_sense_description": "een snelle, scherpe reactie op een opmerking",
                        "target_lang_word": "retort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                        "entry_id": "d11e11d4-f3a3-3cb8-8343-8836282228b0",
                                        "glosses": [
                                            "A sharp or witty reply, or one which turns an argument against its originator; a comeback."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82e37f2-9a50-4d3b-9ad3-e15771d8c180",
                                                "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                                                "text": "He countered her insult with a clever retort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To say something sharp or witty in answer to a remark or accusation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c0699d-c74d-4b31-b8bf-304c4a7b7dad",
                                                "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                                                "text": "“It is a pity,” he retorted with aggravating meekness, “that they do not use a little common sense. The case resembles that of Columbus' egg, and is every bit as simple.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To make a remark which reverses an argument upon its originator; to return, as an argument, accusation, censure, or incivility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab29852a-22be-45ce-bd98-fdfe10114536",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "to retort the charge of vanity"
                                            },
                                            {
                                                "example_id": "12615b7a-dce6-4932-afb0-038280fcc94f",
                                                "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                                                "text": "And with retorted scorn his back he turned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To bend or curve back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fcfa779-28f5-4580-896a-22ff5a13cf42",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "a retorted line"
                                            },
                                            {
                                                "example_id": "06cd211c-7879-4318-8a28-5780e81a0a58",
                                                "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                                                "text": "With retorted head, pruned themselves as they floated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                        "entry_id": "2d32271f-2b1e-36db-b7f9-f14aa58f72fd",
                                        "glosses": [
                                            "To throw back; to reverberate; to reflect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb38f23d-1089-4776-9845-e77c265a0294",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "As when his virtues, shining upon others, / Heat them and they retort that heat again / To the first giver."
                                            },
                                            {
                                                "example_id": "a51b4be5-44cb-45de-8ef7-9aa15b1ab66d",
                                                "sense_id": "e1b451ea-525f-3e46-a16c-9b28efc1cd2e",
                                                "text": "Glasses were filled, arresting the trooper on a theme of passion; the pariahdom of the country cop, whose self-respect is to retort the law's blackmail for blackmail levied on his self-respect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A flask with a rounded base and a long neck that is bent down and tapered, used to heat a liquid for distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435383bd-6d9e-483c-a567-9d6071ea26bc",
                                                "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                                                "text": "A large curved retort was boiling furiously in the bluish flame of a Bunsen burner, and the distilled drops were condensing into a two-litre measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86940d79-253c-33fd-9e57-c0ff054c3cd5",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "An airtight vessel in which material is subjected to high temperatures in the chemical industry or as part of an industrial manufacturing process, especially during the smelting and forging of metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                        "entry_id": "27b58339-5c68-3215-8442-3912ac28573b",
                                        "glosses": [
                                            "A pressure cooker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98dc5a11-ec9c-49af-bd31-2d0e9a9040b6",
                                                "sense_id": "b96d90c2-68fa-314a-aa07-f8947cd588e4",
                                                "text": "The retort is above boiling water. Beneath is a furnace. To the right a man is removing the chips from which the camphor has been extracted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381c185-86e7-3c80-bc14-b51d1bf2b41a",
