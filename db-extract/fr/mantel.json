            {
                "entry_id": "98ae31eb-a77a-356d-a2f6-b194268ec175",
                "word": "Mantel",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67898f0b-06ae-350b-b3da-b121dec5b7fa",
                        "entry_id": "98ae31eb-a77a-356d-a2f6-b194268ec175",
                        "glosses": [
                            "Bourg d’Allemagne, située en Bavière."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4999147c-66ac-413f-99ee-2cb099bb8e7d",
                        "source_entry_id": "98ae31eb-a77a-356d-a2f6-b194268ec175",
                        "source_sense_id": "67898f0b-06ae-350b-b3da-b121dec5b7fa",
                        "target_lang_word": "Mantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                        "entry_id": "0a8561cc-426b-306a-8cab-d1d5bc48a13d",
                                        "glosses": [
                                            "langes, geknöpftes, am Oberkörper getragenes Bekleidungsstück mit Ärmeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a79ad07-3375-4374-b1db-7756c4c1b198",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "„Ich habe mir den Mantel übergezogen und die Holzgitter geöffnet.“"
                                            },
                                            {
                                                "example_id": "89772596-a4d7-4a26-bbef-e8d6f43aba1e",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "Ich brauche für den Winter einen neuen Mantel."
                                            },
                                            {
                                                "example_id": "ddafcd53-ad3a-42a3-b309-f687b8c7ebd2",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "„Der Reiseleiter, schon in Mantel und Mütze, hat seine letzte Ansprache gehalten.“"
                                            },
                                            {
                                                "example_id": "c431ac53-892f-4dad-8609-4ae2f21fd81c",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "„Auf dem Hof holte sie ein Zigarettenetui hervor und durchsuchte ihren Mantel nach einem Feuerzeug.“"
                                            },
                                            {
                                                "example_id": "a9c4d52e-93c5-4826-89f0-56eb99a0cd4b",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "„Sie zieht den guten Mantel und Straßenschuhe an, nimmt ihre Handtasche und heute auch den Schirm.“"
                                            },
                                            {
                                                "example_id": "6f7f79a0-d8f4-45fd-93f3-e3f237599361",
                                                "sense_id": "5ea7bc32-1d39-3703-ba13-ffdb38ab15b5",
                                                "text": "[Jesu Kreuzigung und Tod:] „Und als sie ihn verspottet hatten, zogen sie ihm den Mantel aus und zogen ihm seine Kleider an und führten ihn ab, um ihn zu kreuzigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "500b1353-5097-310e-93c9-2295b9d41b42",
                                        "entry_id": "0a8561cc-426b-306a-8cab-d1d5bc48a13d",
                                        "glosses": [
                                            "schützende Hülle, Umhüllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad77850-b58b-4755-8628-7cfaf421f8f7",
                                                "sense_id": "500b1353-5097-310e-93c9-2295b9d41b42",
                                                "text": "Berechnen Sie den Mantel des Quaders."
                                            },
                                            {
                                                "example_id": "a97d0691-dc1e-4207-abfe-432e43b657b2",
                                                "sense_id": "500b1353-5097-310e-93c9-2295b9d41b42",
                                                "text": "„Mit der Bahn fuhren die Hamsterer weit hinaus aufs Land, zwanzig, dreißig, fünfzig Kilometer, mit dem Fahrrad auch, solange sie genug heile Schläuche und Mäntel hatten, notfalls eben zu Fuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                        "entry_id": "3e0913c7-5e95-35fa-b2bb-1dfedc6b0b20",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31575dfd-29d5-41a0-b088-24b86581e6fb",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Frau Mantel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9a2e4a6c-90fb-4239-b782-ab3dc27bba79",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Herr Mantel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "feac88fe-54c7-4446-8aec-696b40961d7b",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Die Mantels fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "6e50342b-8d8a-4e27-9136-b8a0bf87a078",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Der Mantel trägt nie die Schals, die die Mantel ihm strickt."
                                            },
                                            {
                                                "example_id": "4b54b280-e4f4-4b4d-a6b0-e40ba2586178",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mantel kommt, geht der Herr Mantel.“"
                                            },
                                            {
                                                "example_id": "3be29e62-e889-45bc-8038-c8114b9370c2",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Mantel kommt und geht."
                                            },
                                            {
                                                "example_id": "f62b3af0-1cf1-4ae1-9282-e85a94eb0df7",
                                                "sense_id": "de63806a-7125-3193-a407-f7744ff4746a",
                                                "text": "Mantels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
