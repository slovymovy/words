                "senses": [
                    {
                        "sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                        "entry_id": "3d83edc4-2bb5-3e82-a3db-8cbba3fd86c5",
                        "glosses": [
                            "die neue Gestaltung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1093a9-ac3e-4d04-b286-9a3ed6b77676",
                                "sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                                "text": "„Reengineering meint die völlige Neugestaltung und Umstrukturierung von innerbetrieblichen Arbeitsabläufen mit dem Ziel der Produktivitätssteigerung.“"
                            },
                            {
                                "example_id": "6830a001-e84d-4c01-b211-eff16db1ea08",
                                "sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                                "text": "„Kurzum, aus den gegenwärtigen Neugestaltungen erklären sich die Umwälzungen von einst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e3706e-fb78-422b-991a-deb10fbc6ed6",
                        "source_entry_id": "3d83edc4-2bb5-3e82-a3db-8cbba3fd86c5",
                        "source_sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                        "source_sense_description": "die neue Gestaltung von etwas",
                        "target_lang_word": "redesign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redesign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52862149-f96e-35c5-9fef-a34dd8ad814a",
                                        "entry_id": "79102013-8a7d-349f-9722-d8f0cf1b65e3",
                                        "glosses": [
                                            "A plan for making changes to the structure and functions of an artifact, building or system so as to better serve the purpose of the original design, or to serve purposes different from those set forth in the original design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ac093b-3012-4b8a-91cd-74849399bd3f",
                                                "sense_id": "52862149-f96e-35c5-9fef-a34dd8ad814a",
                                                "text": "No UK company responded, believing that the availability requirement could not be reached in British operating conditions. But General Motors thought otherwise, offering its SD40-2 design. However, to make it fit the UK loading gauge, considerable redesign was required."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "redesign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56c7d99d-bc5e-35ab-9b15-53dcdfaf4f97",
                                        "entry_id": "6a4b0caa-1bb3-34bd-a52b-2041b60a851a",
                                        "glosses": [
                                            "To lay out or plan a new version of something previously laid out or planned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450db2b2-7f69-4865-92cf-61e75370d35e",
                                                "sense_id": "56c7d99d-bc5e-35ab-9b15-53dcdfaf4f97",
                                                "text": "They and the airline itself described an internal process that requires multiple departments to manually redesign the airline’s schedule – a system that works “the vast majority of the time,” Southwest said in a statement."
                                            },
                                            {
                                                "example_id": "163338f7-36a4-474b-8740-04b482f95fe2",
                                                "sense_id": "56c7d99d-bc5e-35ab-9b15-53dcdfaf4f97",
                                                "text": "It became clear at last that the secondary windings were not strong enough to withstand the severe electro-magnetic forces to which they had been subjected and that the transformer would have to be redesigned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1e42b14-53aa-4386-a813-4edfb15ff378",
                        "source_entry_id": "3d83edc4-2bb5-3e82-a3db-8cbba3fd86c5",
                        "source_sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                        "source_sense_description": "die neue Gestaltung von etwas",
                        "target_lang_word": "redevelopment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redevelopment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35740d24-8389-3938-abf7-3fa40fde9965",
                                        "entry_id": "1ae9e03c-8536-394d-b7f7-6681b525f308",
                                        "glosses": [
                                            "The process of developing something anew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b7fc61-3770-4c97-829c-8fca592e4492",
                                                "sense_id": "35740d24-8389-3938-abf7-3fa40fde9965",
                                                "text": "the redevelopment of the hero's character in a comic book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                        "entry_id": "1ae9e03c-8536-394d-b7f7-6681b525f308",
                                        "glosses": [
                                            "The demolition of old, redundant or unfashionable buildings or infrastructure and the construction of new ones on the same site."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da40ba02-06a5-443c-8b67-d9a6456a09d7",
                                                "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                                "text": "The government of New Zealand is looking for a crew to lead the redevelopment of its research headquarters in Antarctica.\nBuilt in the 1980s, the country’s Scott Base consists of 12 structures that officials want replaced by three large, interconnected buildings, plus a separate helicopter hangar."
                                            },
                                            {
                                                "example_id": "7af82b0d-df3f-4ced-b995-a601bb6b1c71",
                                                "sense_id": "93defa1e-435b-3486-a136-86e7fd527a76",
                                                "text": "HS2 Minister Andrew Stephenson added: \"This station will not only benefit the local community by enabling the comprehensive redevelopment of the area, but will serve as a transport superhub acting as a gateway to the Midlands and the North.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "128b5709-d99d-438e-a464-f50bdc8d0757",
                        "source_entry_id": "3d83edc4-2bb5-3e82-a3db-8cbba3fd86c5",
                        "source_sense_id": "fb3dee18-e3ab-3297-bda4-e8eab207dd41",
                        "source_sense_description": "die neue Gestaltung von etwas",
                        "target_lang_word": "remake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b03240f7-1d40-32db-b587-223f01372c8b",
                                        "entry_id": "9ebda9db-c11e-3104-9536-c394e9a5e122",
                                        "glosses": [
                                            "A new version of something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                                        "entry_id": "9ebda9db-c11e-3104-9536-c394e9a5e122",
                                        "glosses": [
                                            "A new, especially updated, version of a film, video game, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ae2f38-68c9-4a03-af91-0a8115d10e5b",
                                                "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                                                "text": "I haven't seen the original film, but the remake was great."
                                            },
                                            {
                                                "example_id": "56044899-2863-403e-adbd-da0e9ff01cb6",
                                                "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                                                "text": "The thing I like most about the Total Recall remake is the—I have to presume ironic—name of its production company. The first words that appear on screen are “Original Film”."
                                            },
                                            {
                                                "example_id": "ddbab8c7-4db4-414f-b9f1-856e2a77af73",
                                                "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                                                "text": "Like Hollywood remakes or remasters old movies, video game publishers are overhauling and rereleasing games to tap into ready-made fan bases for popular franchises like The Legend of Zelda, Crash Bandicoot, Spyro the Dragon and World of Warcraft."
                                            },
                                            {
                                                "example_id": "722668ca-1d9f-4df4-a97c-84e63f89fa87",
                                                "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                                                "text": "The family film is the remake of a remake – the 2022 version puts a new spin on the 2003 movie of the same name, which updated the 1950 movie based on the semi-autobiographical novel by siblings Frank Butler Gilbreth Jr and Ernestine Gilbreth Carey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1176dcfb-3b81-3715-bad1-50ad644c74d3",
                                        "entry_id": "266c85e2-ab7d-3d09-80fe-ec4069a4dd31",
                                        "glosses": [
                                            "To make again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ec482c-d1f7-4df5-aa49-be5789978976",
                                                "sense_id": "1176dcfb-3b81-3715-bad1-50ad644c74d3",
                                                "text": "You'll need to remake that cake, as it's completely burned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5164e0-19da-35ca-83fc-3885a77331b7",
                                        "entry_id": "266c85e2-ab7d-3d09-80fe-ec4069a4dd31",
                                        "glosses": [
                                            "To make a new, especially updated, version of (a film, video game, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6230ca45-4996-4677-abe9-cbbc20d8f166",
                                                "sense_id": "af5164e0-19da-35ca-83fc-3885a77331b7",
                                                "text": "The director wanted to remake some of his favourite films from the Golden Age of Hollywood."
                                            },
                                            {
                                                "example_id": "a38d3d0b-425c-4da9-bc29-b1f9fb881da4",
                                                "sense_id": "af5164e0-19da-35ca-83fc-3885a77331b7",
                                                "text": "Fritz Lang in Hollywood has remade the French \"La Bête Humaine\" story, setting the drama, a little coldly, among the great hooting diesels of the Middle West routes, […]."
                                            },
                                            {
                                                "example_id": "2793722a-152d-401c-87f6-075d7f084420",
                                                "sense_id": "af5164e0-19da-35ca-83fc-3885a77331b7",
                                                "text": "In 1976 and 1977, and the years to follow, as symbolically remade by the Sex Pistols, it was, perhaps, dadaists, lettrists, situationists, and various medieval heretics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
