                                        "glosses": [
                                            "A joke that is understood or meant to be understood only by certain people who are aware of the details (an ingroup)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab1c0a4-20a1-4673-a493-a20d02ce5197",
                                                "sense_id": "39a9fdb2-f136-360a-b60a-148e2cc9c6fd",
                                                "text": "After the incident with the potato peeler, references to potatoes became an inside joke among the witnesses."
                                            }
