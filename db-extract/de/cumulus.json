                            "kompakte, aufgetürmte, scharf begrenzte, massiv wirkende Wolke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddba4bf3-974f-446a-98ac-09c414160ff3",
                                "sense_id": "3bf73559-3ec5-39e1-bf95-5506e009cdd1",
                                "text": "„Über der Kimm lagen schwache Cumuli.“"
                            }
                        ],
