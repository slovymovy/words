                        "glosses": [
                            "истор. воин, вооружённый мечом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f81f241e-d80d-4ec4-8141-2a7e43274f5d",
                                "sense_id": "7dcc3acf-8b6d-3fe9-9ab5-f163f4d1a111",
                                "text": "Здесь точно сих от славян отличает и имена нисколько славянским не подобны, но по сути оба греческие: амаксобы значит извозчики или тележники, аорсы — мечники или мечи имеющие."
                            },
                            {
                                "example_id": "5740048a-360f-4f2c-b4bb-e0fa322eb4f8",
                                "sense_id": "7dcc3acf-8b6d-3fe9-9ab5-f163f4d1a111",
                                "text": "А надумаешь бежать хоть на полудень хоть на полуночь, всё одно найдут тебя княжьи мечники, и будешь ты батогами бит."
                            }
                        ]
                    }
