                    {
                        "translation_id": "b78859d1-f6ea-481f-b389-440a42ae40c3",
                        "source_entry_id": "fb29fffb-26f0-38a6-8cb4-882e074b9b5b",
                        "source_sense_id": "2cb392b0-e8eb-35ea-8727-c5dfa0551008",
                        "target_lang_word": "Streckung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streckung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0a8cd6-82b7-3818-89e3-7acb75459037",
                                        "entry_id": "3913589b-c84d-3cb6-a3c7-95c47700bc50",
                                        "glosses": [
                                            "Herstellung einer größeren Entfernung zwischen (Körper-)Teilen in einer, mehreren oder allen Dimensionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3727a6-321d-4aa2-8d1c-5cf33b0956ab",
                                                "sense_id": "2f0a8cd6-82b7-3818-89e3-7acb75459037",
                                                "text": "„Am Oberarme liegen nur wenige Muskeln, und die hauptsächlichsten sind nicht zur Bewegung dieses Knochens, sondern zur Beugung und Streckung des Vorderarmes im Ellenbogengelenke bestimmt.“"
                                            },
                                            {
                                                "example_id": "a48d431a-85c1-4ea3-a51a-d435a95470f9",
                                                "sense_id": "2f0a8cd6-82b7-3818-89e3-7acb75459037",
                                                "text": "„Die Abbildungen, die die Form einer Figur invariant lassen, sind die Ähnlichkeitsabbildungen mit der zentrischen Streckung als ihrem wichtigsten Vertreter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f30f0999-2a40-3748-a96d-e6b7cfad13e7",
                                        "entry_id": "3913589b-c84d-3cb6-a3c7-95c47700bc50",
                                        "glosses": [
                                            "Wachstumsphase bei Kindern, zum Beispiel eine zwischen dem 4. und 7. Lebensjahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "603ad1cf-f677-4646-b81a-b704f7253850",
                                                "sense_id": "f30f0999-2a40-3748-a96d-e6b7cfad13e7",
                                                "text": "„Es ist, als ob der Körper sich von der ersten Streckung ausruhen und neue Kräfte zu seiner weiteren Ausbildung sammeln wolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e1c53f0-73f7-309e-a65d-c7062ad1f606",
                                        "entry_id": "3913589b-c84d-3cb6-a3c7-95c47700bc50",
                                        "glosses": [
                                            "Verteilung über einen längeren Zeitraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab00ae4-0a17-4108-9b2c-3539db179c8e",
                                                "sense_id": "1e1c53f0-73f7-309e-a65d-c7062ad1f606",
                                                "text": "„Die im Dokument angedeutete Streckung über einen längeren Zeitraum ist bereits Ausdruck eines Kompromisses, eines Zurücksteckens der Befürworter.“"
                                            },
                                            {
                                                "example_id": "e48bc57f-7cc1-4cef-b071-1f71339a9b46",
                                                "sense_id": "1e1c53f0-73f7-309e-a65d-c7062ad1f606",
                                                "text": "„Auf Grund der Anordnung des § 35 UmgrStG gehen bei der spaltenden Gesellschaft angefallene Verluste – in dem vom UmgrStG vorgegebenen Rahmen – auf die übernehmende Gesellschaft über. Teilwertabschreibung und Verlust aus der Veräußerung einer Beteiligung führen insbesondere bei Ausblendung der Streckung auf sieben Jahre […] vielfach zu einem Jahresverlust, der dann auf Grund der Anordnung des § 35 UmgrStG auf die übernehmende Körperschaft übergeht.“"
                                            },
                                            {
                                                "example_id": "ac58c967-b762-43ed-bf2e-905aec980feb",
                                                "sense_id": "1e1c53f0-73f7-309e-a65d-c7062ad1f606",
                                                "text": "„Auch die mögliche Streckung über einen Zeitraum von acht Jahren half den Versicherungsunternehmen, die Anpassung ohne größere Schwierigkeiten zu bewältigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
