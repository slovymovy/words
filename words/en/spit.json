                            {
                                "target_lang_word": "迸出",
                                "target_lang_sense_clarification": "形容愤怒地脱口而出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bdeca86-95d2-3202-8e6d-f2b9a92b0a60",
                    "sense_definition": "To emit or expel small particles or liquid explosively, similar to spitting saliva.",
