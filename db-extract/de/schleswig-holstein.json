                "senses": [
                    {
                        "sense_id": "d5d1e078-f49c-3273-8416-6904c2427e0d",
                        "entry_id": "87e9d669-6968-355f-8069-8c2e765de10a",
                        "glosses": [
                            "ein Bundesland im Norden der Bundesrepublik Deutschland"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "2d0dffbe-0b40-412b-bb57-483ebd807dff",
                                "sense_id": "d5d1e078-f49c-3273-8416-6904c2427e0d",
                                "text": "Schleswig-Holstein liegt sowohl an der Nord- als auch an der Ostseeküste."
                            },
                            {
                                "example_id": "8bcf81b9-bb61-4e84-9467-13284e3170f7",
                                "sense_id": "d5d1e078-f49c-3273-8416-6904c2427e0d",
                                "text": "Schleswig-Holstein liegt im Norden Deutschlands."
                            },
                            {
                                "example_id": "a2ab09b7-ec03-48d9-97ec-b874c53c3170",
                                "sense_id": "d5d1e078-f49c-3273-8416-6904c2427e0d",
                                "text": "Das Schleswig-Holstein der Jahrhundertwende war eine ruhige Gegend."
                            },
                            {
                                "example_id": "c0988d29-c648-4c42-b789-1ccbba36be87",
                                "sense_id": "d5d1e078-f49c-3273-8416-6904c2427e0d",
                                "text": "„Nordniedersachsen, Bremen, Hamburg, Schleswig-Holstein oder Mecklenburg-Vorpommern, überall sieht es ein wenig anders aus. Ostfriesische Inseln sind nicht wie Sylt oder Rügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
