            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c80842c-c338-32b3-a78e-95c4886e29d5",
                    "sense_definition": "Coated with a protective layer of zinc to prevent rusting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew used <w>galvanized</w> steel pipes for the outdoor plumbing system.",
                            "target_lang_translations": {
                                "nl": "Het bouwteam gebruikte <w>gegalvaniseerde</w> stalen buizen voor het buitenleidingsysteem."
                            }
                        },
                        {
                            "text": "These <w>galvanized</w> nails are ideal for building fences because they resist corrosion.",
                            "target_lang_translations": {
                                "nl": "Deze <w>verzinkte</w> spijkers zijn ideaal voor het bouwen van hekken omdat ze bestand zijn tegen corrosie."
                            }
                        }
                    ],
                    "synonyms": [
                        "zinc-coated"
                    ],
                    "common_phrases": [
                        "galvanized steel",
                        "galvanized iron"
                    ],
                    "target_lang_definitions": {
