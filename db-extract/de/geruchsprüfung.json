                "senses": [
                    {
                        "sense_id": "d6811625-162e-3918-bf3f-46c3bcd71917",
                        "entry_id": "e296c256-a428-3ec3-866d-5be820e4f9fe",
                        "glosses": [
                            "Handlung des Kontrollierens; prüfendes Riechen und Bewertung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264995eb-aeb7-44b0-9ecd-6d8490da9ffb",
                                "sense_id": "d6811625-162e-3918-bf3f-46c3bcd71917",
                                "text": "„Die Geruchsprüfung von Innenraummaterialien mit einer Emissionsprüfkammer ist in der DIN ISO 16000-28 festgelegt.“"
                            },
                            {
                                "example_id": "93ed9e8f-dc54-46f9-bc66-79e90317555d",
                                "sense_id": "d6811625-162e-3918-bf3f-46c3bcd71917",
                                "text": "„Die Geruchsprüfungen müssen selbstverständlich in einem geruchsneutralen Bereich durchgeführt werden – im Idealfall ist es ein klimatisierter Raum.“"
                            },
                            {
                                "example_id": "8cdd1ba5-1e66-411c-88f8-a1bd35b0f62d",
                                "sense_id": "d6811625-162e-3918-bf3f-46c3bcd71917",
                                "text": "„Die Geruchsprüfung für textile Beläge arbeitet wie andere olfaktorische Untersuchungen mit einer Gruppe von Probanden, die speziell für diese Methode geschult werden.“"
                            },
                            {
                                "example_id": "05f39afe-9b9d-4ec0-baed-0a725479937e",
                                "sense_id": "d6811625-162e-3918-bf3f-46c3bcd71917",
                                "text": "„Die qualitative Geruchsprüfung sollte in einem geruchsneutralen und gut belüfteten Raum stattfinden.“"
                            }
                        ],
