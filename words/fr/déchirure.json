                    "frequency": "Middle",
                    "semantic_group_id": "rupture_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a remarqué une petite <w>déchirure</w> sur la manche de sa chemise neuve."
                        },
                        {
                            "text": "Une grande <w>déchirure</w> traversait la page du vieux livre qu'elle lisait."
                        }
                    ],
                    "synonyms": [
                        "accroc"
                    ],
                    "common_phrases": [
                        "déchirure dans le tissu"
                    ]
                },
                {
                    "sense_id": "8c05edcc-3302-390a-b65f-29d2ed4723ca",
                    "sense_definition": "Lésion traumatique d'un muscle provoquée par une rupture partielle ou totale de ses fibres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'athlète s'est blessé et souffre d'une <w>déchirure</w> musculaire à la cuisse."
                        },
                        {
                            "text": "Après sa grave <w>déchirure</w>, il a dû observer six semaines de repos complet."
                        }
                    ],
                    "common_phrases": [
                        "déchirure musculaire"
                    ]
                },
                {
                    "sense_id": "a6a94be8-8c53-36bc-9ae3-490a0a824c42",
                    "sense_definition": "Séparation douloureuse, division violente ou rupture au sein d'un groupe ou dans l'esprit de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rupture_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce départ soudain a provoqué une profonde <w>déchirure</w> au sein de leur famille."
                        },
                        {
                            "text": "Le compromis a évité une <w>déchirure</w> politique qui menaçait l'unité du pays."
