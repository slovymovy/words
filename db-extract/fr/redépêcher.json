                "senses": [
                    {
                        "sense_id": "472cdd85-d7ca-3c3e-9cb5-a693bf6b3af5",
                        "entry_id": "d7737fa1-3b20-36aa-a035-9825ec03a8d3",
                        "glosses": [
                            "Dépêcher de nouveau ; renvoyer un homme vers l’endroit d’où il vient."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "826c7f99-8971-465c-821e-255c2c89eb7a",
                                "sense_id": "472cdd85-d7ca-3c3e-9cb5-a693bf6b3af5",
                                "text": "Il y a eu avant-hier un courrier de M. le Prince, qu’on a redépêché aujourd’hui"
                            },
                            {
                                "example_id": "c2d8800b-afc6-412f-a974-7c9a194d4aa9",
                                "sense_id": "472cdd85-d7ca-3c3e-9cb5-a693bf6b3af5",
                                "text": "Oubliez la pièce, renvoyez-la moi ; je vous la redépêcherai sur-le-champ"
                            },
                            {
                                "example_id": "bca932e1-3160-4d44-bc1d-6907f931eb8d",
                                "sense_id": "472cdd85-d7ca-3c3e-9cb5-a693bf6b3af5",
                                "text": "Redépêchez-moi en toute diligence"
                            }
                        ]
                    }
