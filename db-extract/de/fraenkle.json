                ],
                "senses": [
                    {
                        "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                        "entry_id": "6a3ada83-90a0-3e82-a8c8-41ca6cf910c0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab8c08f-c67f-4f97-9f2e-b8d494cf34d1",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Frau Fraenkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c0bd87a9-7d77-45ee-ab8a-adb6f2a48cce",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Herr Fraenkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "795f6db1-8ef8-4cf2-9696-52c6d6d38e68",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Die Fraenkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1f10c271-2ef7-42b4-aa56-8f0ef5a4f696",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Der Fraenkle trägt nie die Schals, die die Fraenkle ihm strickt."
                            },
                            {
                                "example_id": "ecb921ab-4c74-48af-9dc1-ea98bfc35ef4",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fraenkle kommt, geht der Herr Fraenkle.“"
                            },
                            {
                                "example_id": "2843a6bf-33ed-48d9-b720-4e7cf42308c6",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Fraenkle kommt und geht."
                            },
                            {
                                "example_id": "083f7122-543d-493c-8a80-ccb2353b3134",
                                "sense_id": "e41d03ed-a450-3148-902c-3a5bc183a4fa",
                                "text": "Fraenkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
