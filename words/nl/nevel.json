                                "target_lang_word": "brumise",
                                "target_lang_sense_clarification": "avec de l'eau"
                            },
                            {
                                "target_lang_word": "vaporise",
                                "target_lang_sense_clarification": "un liquide ou produit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31665e8b-4469-3a11-9d21-fadee77547b4",
                    "sense_definition": "Gebiedende wijs van <w>nevelen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nevel</w> voorzichtig zodat de verf niet gaat druipen.",
                            "target_lang_translations": {
                                "ru": "<w>Распыляй</w> осторожно, чтобы краска не потекла.",
                                "en": "<w>Mist</w> carefully so the paint doesn't start dripping.",
                                "fr": "<w>Vaporise</w> prudemment pour que la peinture ne se mette pas à couler."
                            }
                        },
                        {
                            "text": "<w>Nevel</w> het water gelijkmatig over de bladeren van de varen.",
                            "target_lang_translations": {
                                "ru": "<w>Распыляй</w> воду равномерно по листьям папоротника.",
                                "en": "<w>Mist</w> the water evenly over the leaves of the fern.",
                                "fr": "<w>Brumise</w> l'eau uniformément sur les feuilles de la fougère."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повелительное наклонение от глагола nevelen.",
                        "en": "Imperative mood of nevelen.",
                        "fr": "Impératif du verbe nevelen (brumiser, vaporiser)."
                    },
