    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
                "word": "approbation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f2d349ad-4345-4e1b-ac04-a9a5f45f1245",
                        "entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
                        "tags": [
                            "plural"
                        ],
                        "form": "approbations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                        "entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
                        "glosses": [
                            "The act of approving; an assenting to the propriety of a thing with some degree of pleasure or satisfaction; approval, sanction, commendation or official recognition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9deaf702-c5dc-4083-8fd5-e24d7ad791d6",
                                "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                                "text": "I am very sensible how much nobler it is to place the reward of virtue in the silent approbation of one's own breast"
                            },
                            {
                                "example_id": "2fc1e458-2a91-4da0-8315-0f853bf8f438",
                                "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                                "text": "As a counsellor she was not wanted; but as an approver, (a much safer character,) she was truly welcome. Her approbation, at once general and minute, warm and incessant, could not but please; and for another half-hour they were all walking to and fro, between the different rooms, some suggesting, some attending, and all in happy enjoyment of the future."
                            },
                            {
                                "example_id": "f3078dba-5fce-44ce-92df-cec7a1925e10",
                                "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                                "text": "[I]t was with the view to judge how far my own desires would act in harmony with the wishes of my family. Such an alliance cannot fail of meeting with their most flattering approbation."
                            },
                            {
                                "example_id": "dd7f5533-187b-4fa1-bbb8-c7fc19f708bb",
                                "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                                "text": "Many, therefore, who did not assent to all that the King had said, joined in a loud hum of approbation when he concluded."
                            },
                            {
                                "example_id": "e788cf0a-a69f-4660-8b66-8d0f96819ec6",
                                "sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                                "text": "[A]nimals not only love, but have the desire to be loved. […] They love approbation or praise; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ce524bc-dea3-4f49-be83-2a7de271d499",
                        "source_entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
                        "source_sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
