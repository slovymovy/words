        "fr-extract.jsonl": [
            {
                "entry_id": "ab8f1b5f-a2a1-3c3c-8cd6-60faeb7163e8",
                "word": "parisianisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "13b429b9-8363-4471-9d56-2a8e0dbda66e",
                        "entry_id": "ab8f1b5f-a2a1-3c3c-8cd6-60faeb7163e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "parisianismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "272813b7-bc1a-3240-b94e-f58680a0848a",
                        "entry_id": "ab8f1b5f-a2a1-3c3c-8cd6-60faeb7163e8",
                        "glosses": [
                            "Qualité de ce qui est parisien."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ffd8abb6-57a1-455e-84ac-e7e9eede59f2",
                                "sense_id": "272813b7-bc1a-3240-b94e-f58680a0848a",
                                "text": "L’éventail corrige un peu cette prétention au parisianisme. Une femme sans éventail est une chose que je n’ai pas encore vue en ce bienheureux pays ; j’en ai vu qui avaient des souliers de satin sans bas, mais elles avaient un éventail."
                            },
                            {
                                "example_id": "9341e705-ba1b-4846-bf1a-e09baf73e631",
                                "sense_id": "272813b7-bc1a-3240-b94e-f58680a0848a",
                                "text": "Et en effet, elle publia livres et chroniques empreints d’un parisianisme outré, si outré que par cela même, il révélait un peu la provinciale."
                            },
                            {
                                "example_id": "b6542f3c-1d68-48a6-954c-e9aa80359c40",
                                "sense_id": "272813b7-bc1a-3240-b94e-f58680a0848a",
                                "text": "Le développement de l’égalité sexuelle par les vagues de sport, la mise à nu des femmes dans les music-halls, la vulgarisation de la poudre de riz, des massages et du bas de soie ont tué le mystère indispensable à la primauté féminine et à l’éclat du Parisianisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed279186-9a56-36da-ba22-fecbacbc88d4",
                        "entry_id": "ab8f1b5f-a2a1-3c3c-8cd6-60faeb7163e8",
                        "glosses": [
                            "Tournure de langage propre aux Parisiens."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2521e5fd-e7de-3490-a89e-11bb08d5cb8e",
                        "entry_id": "ab8f1b5f-a2a1-3c3c-8cd6-60faeb7163e8",
                        "glosses": [
                            "Ensemble d’habitudes sociales propres aux Parisiens ; snobisme parisien."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3b971830-623b-4844-b89b-0027b0d4adc4",
                                "sense_id": "2521e5fd-e7de-3490-a89e-11bb08d5cb8e",
                                "text": "Cela tombe bien parce que, à 60 km de là, à Caen, Onfray, le pourfendeur du parisianisme, le chantre de la décentralisation et du pouvoir régional, ne compte visiblement pas que des amis."
                            },
                            {
                                "example_id": "77c92263-6abd-4548-9d88-e13889d3aead",
                                "sense_id": "2521e5fd-e7de-3490-a89e-11bb08d5cb8e",
                                "text": "Ne poussons pas le mimétisme et le parisianisme à préférer le contre-modèle italien à Marseille."
                            }
                        ]
                    }
                ],
