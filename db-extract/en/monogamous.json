                "translations": [
                    {
                        "translation_id": "b8898a55-d0fe-446f-9451-e4c2e7b8b774",
                        "source_entry_id": "3b586ecd-4034-3b93-88a0-5aeb03cdfc07",
                        "source_sense_description": "being married to one person at a time",
                        "target_lang_word": "monogame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monogame",
