                },
                {
                    "sense_id": "f85faf1b-984e-372a-9c79-2d816a866ddd",
                    "sense_definition": "A person who is younger than another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "age_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although she is my <w>junior</w> by three years, she is very mature.",
                            "target_lang_translations": {
                                "ru": "Хотя она на три года <w>младше</w> меня, она очень зрелая.",
                                "zh": "虽然她比我<w>年幼</w>三岁，但她非常成熟。"
                            }
                        },
                        {
                            "text": "He is four years her <w>junior</w>, but they share many of the same interests.",
                            "target_lang_translations": {
                                "ru": "Он на четыре года <w>младше</w> её, но у них много общих интересов.",
                                "zh": "他比她<w>年幼</w>四岁，但他们有很多共同的兴趣。"
                            }
                        }
                    ],
                    "antonyms": [
                        "senior"
                    ],
                    "common_phrases": [
                        "years my junior",
                        "years his junior",
                        "years her junior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который моложе другого.",
                        "zh": "比另一个人年龄小的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младше",
                                "target_lang_sense_clarification": "в сравнительном значении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "年幼",
                                "target_lang_sense_clarification": "指年龄较小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5019eaca-17a3-3515-8d20-c8a39e5a9305",
                    "sense_definition": "A student in the third year of a four-year high school or university.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "edu_us_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>junior</w>, he has to start thinking seriously about his college applications.",
                            "target_lang_translations": {
                                "ru": "Как <w>старшеклассник</w>, он должен начать серьезно думать о поступлении в колледж.",
                                "zh": "作为一名<w>高三学生</w>，他必须开始认真考虑大学申请了。"
                            }
