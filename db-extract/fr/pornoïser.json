                        "sense_id": "0e4f9a47-e174-3ae3-a030-2886f6891f57",
                        "entry_id": "0d227a65-2d7b-33df-bc8a-48272bb54ce1",
                        "glosses": [
                            "Donner un caractère pornographique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e115710e-d812-4c97-8264-8328f91ff9a3",
                                "sense_id": "0e4f9a47-e174-3ae3-a030-2886f6891f57",
                                "text": "Ce monde, comme je l’ai décrit, a été « pornoïsé »."
                            },
                            {
                                "example_id": "ce15a472-2a65-4cfd-b522-ba18266e79ff",
                                "sense_id": "0e4f9a47-e174-3ae3-a030-2886f6891f57",
                                "text": "Mais sérieux, tu veux pornoïser quoi avec ça."
                            },
                            {
                                "example_id": "87a3d8ec-9ec6-4400-bc55-d2a261b2baef",
                                "sense_id": "0e4f9a47-e174-3ae3-a030-2886f6891f57",
                                "text": "Bof, moi j’apprécie pas trop qu’on fasse de la vulgarité avec Lara, c’est une héroïne de jeu video ^([sic : vidéo]), certes, mais beaucoup de gens y joue ^([sic : jouent]), l’aime ^([sic : aiment]), voir ^([sic : voire]) s’y identifie ^([sic : identifient]), et je trouve qu’il y a un manque de respect flagrant à denuder ^([sic : dénuder]), voir ^([sic : voire]) « pornoïser » Lara."
                            }
                        ]
                    }
                ],
