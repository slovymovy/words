                "senses": [
                    {
                        "sense_id": "010806de-2d23-30ba-8006-b9f84f0bdb6c",
                        "entry_id": "28a7d353-317c-3a0b-84aa-3be93e627cd9",
                        "glosses": [
                            "Sortir (ou jeter) d’un balcon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec6236a-5c96-4b84-aecc-f396177cf2d5",
                                "sense_id": "010806de-2d23-30ba-8006-b9f84f0bdb6c",
                                "text": "Jeanne chasseresse débalconne, empoisonne, transperce, kill, kill, kill, et s’éteint dans un fondu carcéral d’une noirceur désolante."
                            },
                            {
                                "example_id": "9351ff9c-0207-439f-802c-99f9c6aea683",
                                "sense_id": "010806de-2d23-30ba-8006-b9f84f0bdb6c",
                                "text": "En cas de charme agissant, je n’hésiterai pas moi-même à me débalconner et batifoler sur les parterres d’herbes en bas de chez moi."
                            },
                            {
                                "example_id": "483855e7-9b40-4487-aa08-0c03b6473330",
                                "sense_id": "010806de-2d23-30ba-8006-b9f84f0bdb6c",
                                "text": "Je m’embalconne, me débalconne, me déchambranle de visions obsessives. Je m’arabesque et m’encouleuvre de fantasmagories."
                            }
                        ]
                    }
                ],
