{
    "word_family": [
        "illiteracy",
        "literacy",
        "literate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8740357-1a38-3fd9-9c75-5f8b7c7d8a98",
                    "sense_definition": "Unable to read and write.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many adults in the region remain <w>illiterate</w> due to lack of schooling. ",
                            "target_lang_translations": {
                                "tr": "Bölgedeki pek çok yetişkin, okul eksikliği nedeniyle <w>okuma yazma bilmez</w> durumdadır."
                            }
                        },
                        {
                            "text": "Programs are available to help <w>illiterate</w> adults learn basic reading skills.",
                            "target_lang_translations": {
                                "tr": "<w>Okuma yazma bilmeyen</w> yetişkinlerin temel okuma becerilerini öğrenmelerine yardımcı olacak programlar mevcuttur."
                            }
                        }
                    ],
                    "synonyms": [
                        "analphabetic",
                        "unlettered"
                    ],
                    "antonyms": [
                        "literate"
                    ],
                    "common_phrases": [
                        "functionally illiterate",
                        "illiterate adults"
                    ],
                    "target_lang_definitions": {
                        "tr": "Okuma ve yazma bilmeyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "okuma yazma bilmeyen",
                                "target_lang_sense_clarification": "okuma yazması olmayan"
                            },
                            {
                                "target_lang_word": "cahil",
                                "target_lang_sense_clarification": "okumamış, okuma yazması olmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fc62254-a942-3929-a1f1-a695ad52d00e",
                    "sense_definition": "Lacking education or proper knowledge of language and literature.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was considered <w>illiterate</w> despite his practical experience in farming.",
                            "target_lang_translations": {
                                "tr": "Tarımdaki pratik deneyimine rağmen <w>eğitimsiz</w> kabul ediliyordu."
                            }
                        },
                        {
                            "text": "Her writing was criticize for using <w>illiterate</w> constructions.",
                            "target_lang_translations": {
                                "tr": "Yazısı, <w>bozuk</w> yapılar kullandığı için eleştirildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignorant",
                        "unlettered"
                    ],
                    "antonyms": [
                        "literate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Eğitimden veya dil ve edebiyat bilgisinden yoksun olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eğitimsiz",
                                "target_lang_sense_clarification": "yeterli eğitimi olmayan"
                            },
                            {
                                "target_lang_word": "cahil",
                                "target_lang_sense_clarification": "bilgisiz, eğitimsiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "714626c9-8fd2-35b5-af10-eaf4c5dce46e",
                    "sense_definition": "Lacking knowledge or understanding of a particular subject or field.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people are financially <w>illiterate</w> and struggle to manage personal budgets.",
                            "target_lang_translations": {
                                "tr": "Birçok insan finansal açıdan <w>bilgisizdir</w> ve kişisel bütçelerini yönetmekte zorlanır."
                            }
                        },
                        {
                            "text": "The policy was criticized for being economically <w>illiterate</w>.",
                            "target_lang_translations": {
                                "tr": "Politika, ekonomik açıdan <w>mantıksız</w> olduğu gerekçesiyle eleştirildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignorant"
                    ],
                    "common_phrases": [
                        "financially illiterate",
                        "computer illiterate",
                        "scientifically illiterate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir konu veya alan hakkında bilgi veya anlayışa sahip olmayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cahil",
                                "target_lang_sense_clarification": "belirli bir alanda bilgisi olmayan"
                            },
                            {
                                "target_lang_word": "bilgisiz",
                                "target_lang_sense_clarification": "belirli bir konuda yetersiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82b2ef5c-bf01-372b-8f9f-0df012ddf05e",
                    "sense_definition": "Not conforming to the correct or established grammatical standards of speech or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor corrected several <w>illiterate</w> phrases in the draft manuscript.",
                            "target_lang_translations": {
                                "tr": "Editör, taslak metindeki birkaç <w>bozuk</w> ifadeyi düzeltti."
                            }
                        },
                        {
                            "text": "Using those words in that context is seen as <w>illiterate</w> speech.",
                            "target_lang_translations": {
                                "tr": "Bu kelimeleri o bağlamda kullanmak <w>yanlış</w> bir konuşma biçimi olarak görülür."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Konuşma veya yazıda doğru ve kabul görmüş dilbilgisi kurallarına uymayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bozuk",
                                "target_lang_sense_clarification": "dilbilgisi kurallarına uymayan"
                            },
                            {
                                "target_lang_word": "yanlış",
                                "target_lang_sense_clarification": "hatalı kullanılan dil veya ifade"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e7ff095-a2c4-3237-8a56-53b0c244da25",
                    "sense_definition": "A person who is unable to read and write.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government launched an initiative to teach adult <w>illiterates</w> to read.",
                            "target_lang_translations": {
                                "tr": "Hükümet, okuma yazma bilmeyen yetişkin <w>okuma yazma bilmeyenlere</w> okumayı öğretmek için bir girişim başlattı."
                            }
                        },
                        {
                            "text": "In the past century, the number of <w>illiterates</w> in the country has dropped significantly.",
                            "target_lang_translations": {
                                "tr": "Geçtiğimiz yüzyılda, ülkedeki <w>okuma yazma bilmeyenlerin</w> sayısı önemli ölçüde düştü."
                            }
                        }
                    ],
                    "synonyms": [
                        "analphabet"
                    ],
                    "common_phrases": [
                        "adult illiterates"
                    ],
                    "target_lang_definitions": {
                        "tr": "Okuma ve yazma bilmeyen kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "okuma yazma bilmeyen kişi",
                                "target_lang_sense_clarification": "okuma yazması olmayan birey"
                            },
                            {
                                "target_lang_word": "ümmü",
                                "target_lang_sense_clarification": "okuma yazma bilmeyen kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a353b8d-a056-30f1-9257-818f7517a0d9",
                    "sense_definition": "A person who lacks knowledge or understanding of a specified topic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even smart managers can be computer <w>illiterates</w> if they do not practice modern skills.",
                            "target_lang_translations": {
                                "tr": "Akıllı yöneticiler bile modern becerileri pratik etmezlerse bilgisayar <w>cahili</w> olabilirler."
                            }
                        },
                        {
                            "text": "The seminar was designed to help financial <w>illiterates</w> understand the market.",
                            "target_lang_translations": {
                                "tr": "Seminer, finansal <w>bilgisizlerin</w> piyasayı anlamalarına yardımcı olmak için tasarlandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer illiterates",
                        "financial illiterates"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir konuda bilgisi veya anlayışı olmayan kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cahil",
                                "target_lang_sense_clarification": "belirli bir alanda acemi veya bilgisiz kimse"
                            },
                            {
                                "target_lang_word": "bilgisiz kişi",
                                "target_lang_sense_clarification": "konu hakkında bilgisi olmayan kimse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}