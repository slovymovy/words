                    {
                        "sense_id": "b2755681-18ef-3210-b9a8-f3299b7f9ce2",
                        "entry_id": "32361fd5-f906-3901-9364-4439dc82015c",
                        "glosses": [
                            "Aggressively self-confident or assertive; bullheaded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec9745d-9ecb-4fb1-8932-83405d4ebece",
                                "sense_id": "b2755681-18ef-3210-b9a8-f3299b7f9ce2",
                                "text": "He was heavily criticised for his bullish behaviour."
                            },
                            {
                                "example_id": "a6f4c389-d2d2-465b-8d98-cbcc4fd517b2",
                                "sense_id": "b2755681-18ef-3210-b9a8-f3299b7f9ce2",
                                "text": "Sitting on the edge of the stage at the show’s end, draped in a flag and singing You Need Me, a bullish screw-you written when he was 15, he didn’t look much like a man still plagued by nerves over headlining Glastonbury."
                            }
                        ]
                    },
                    {
                        "sense_id": "95cd0864-4278-30de-bb25-eeb80786c0e4",
                        "entry_id": "32361fd5-f906-3901-9364-4439dc82015c",
                        "glosses": [
                            "Optimistic; overly or foolishly optimistic or hopeful."
                        ],
                        "tags": [],
                        "examples": [
                            {
