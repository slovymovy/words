                        "assiéger une forteresse"
                    ]
                },
                {
                    "sense_id": "f42abc83-c280-384c-b3e3-318a919624d1",
                    "sense_definition": "Se presser en grand nombre autour d'un lieu ou d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture des soldes, les clients sont venus <w>assiéger</w> les magasins du centre-ville."
                        },
                        {
                            "text": "De nombreux journalistes <w>assiégeaient</w> la porte de l'hôtel dans l'espoir d'obtenir une déclaration."
                        }
                    ],
                    "synonyms": [
                        "encercler",
                        "entourer",
                        "envahir"
                    ],
                    "common_phrases": [
