                "senses": [
                    {
                        "sense_id": "a5e35e0e-e079-3647-847f-4f8214a064ad",
                        "entry_id": "874cdc09-bfcc-31d2-89d1-13a1497d3c3b",
                        "glosses": [
                            "alle oder viele Optionen aus einer Menge probieren; durchprobieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807faca7-9d0e-4aa3-93e8-dc8057b5084c",
                                "sense_id": "a5e35e0e-e079-3647-847f-4f8214a064ad",
                                "text": "Я уже всё перепробовала — ничего не помогает!",
                                "translation": "Ich habe schon alles durchprobiert, nichts hilft!"
                            },
                            {
                                "example_id": "6c9e05c8-7af6-4877-b1ac-897f456f4a55",
                                "sense_id": "a5e35e0e-e079-3647-847f-4f8214a064ad",
                                "text": "Прежде чем покупать обувь, надо перепробовать всё понравившееся и выбрать самую удобную пару.",
                                "translation": "Bevor man Schuhe einkauft, soll man alle gefallenden Modelle durchprobieren und das bequemste auswählen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e582f91-8934-4ad4-9a30-a25832a6de3e",
                        "source_entry_id": "874cdc09-bfcc-31d2-89d1-13a1497d3c3b",
                        "source_sense_id": "a5e35e0e-e079-3647-847f-4f8214a064ad",
                        "source_sense_description": "alle oder viele Optionen aus einer Menge durchprobieren",
                        "target_lang_word": "durchprobieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchprobieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61d682b6-3635-31a0-ac43-117638e91924",
                                        "entry_id": "5aa672af-3faa-35ce-85df-e8b2f4dab214",
                                        "glosses": [
                                            "eine gewisse Anzahl, oder sogar alle möglichen Varianten (zum Beispiel von Nahrung, Kleidung oder Methoden), testweise ausprobieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe1cd62-da58-404a-851d-795311c7ce99",
                                                "sense_id": "61d682b6-3635-31a0-ac43-117638e91924",
                                                "text": "Ich hätte nicht übel Lust, mich durch die ganze italienische Küche durchzuprobieren."
                                            },
                                            {
                                                "example_id": "a27a839f-cf9c-40dc-9c4a-f55bbe28fa42",
                                                "sense_id": "61d682b6-3635-31a0-ac43-117638e91924",
                                                "text": "Er probierte alle roten Eissorten durch."
