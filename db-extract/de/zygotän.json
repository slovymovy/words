                                        "entry_id": "2f583c16-a781-39c3-a528-dd96f2741a5b",
                                        "glosses": [
                                            "Qualifie la deuxième étape de la prophase I de la méiose, marquée par le début de l'appariement des chromosomes homologues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48cd11b4-db37-4fc8-ba2e-7a35941a22a4",
                                                "sense_id": "ba2b16ec-7817-3d57-a57d-b7f856d05632",
                                                "text": "Ainsi, au début de la phase zygotène, de nouvelles jonctions serrées apparaissent à l’extérieur des spermatocytes."
                                            },
                                            {
                                                "example_id": "1e0411f5-9afd-4d32-bcd0-00eda88c1dca",
                                                "sense_id": "ba2b16ec-7817-3d57-a57d-b7f856d05632",
                                                "text": "Avec la contraction des chromosomes durant les stades zygotène et pachytène, les chromomères deviennent plus gros et leur nombre diminue."
                                            }
                                        ]
                                    }
                                ]
                            },
