                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9476540c-9d54-46be-90e4-b5e9d641ac79",
                                "sense_id": "5ec3e629-3250-33fa-aa38-3d667cf12043",
                                "text": "Now, in the first place, the Poet did not mean we should reconcile our hearts to Bertram, but that he should not unreconcile them to Helena; nay, that her love should appear the nobler for the unworthiness of its object."
                            }
                        ]
