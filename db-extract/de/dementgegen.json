                "forms": [],
                "senses": [
                    {
                        "sense_id": "b72d4920-8391-3d6c-94b6-2ed84c87bf1c",
                        "entry_id": "8f18543f-1f92-329a-8984-82e2de2818ca",
                        "glosses": [
