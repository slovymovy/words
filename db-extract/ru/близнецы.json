                                    {
                                        "sense_id": "cebf95f2-4e68-3059-9668-8fb0837f6b53",
                                        "entry_id": "15300a88-0984-39ee-89f8-b29cbccbbab0",
                                        "glosses": [
                                            "A constellation of the zodiac traditionally taken to represent the pair of twins Castor and Pollux in Greek mythology. It contains the stars Castor, Pollux, and Alhena."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9191157-ab77-3c5b-9bc9-973c469b01a4",
                                        "entry_id": "15300a88-0984-39ee-89f8-b29cbccbbab0",
                                        "glosses": [
                                            "The zodiac sign for the twins, ruled by Mercury and covering May 22 – June 21 (tropical astrology) or June 16 – July 15 (sidereal astrology)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ee239c-20ed-45d1-892a-e9f58817d91a",
                                                "sense_id": "f9191157-ab77-3c5b-9bc9-973c469b01a4",
                                                "text": "Gemini is the third sign of the zodiac, spanning the 60–89th degrees. The Sun is in Gemini from around 21 May to 20 June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c262165-3697-3aaa-ae7a-56a7ad6fe0eb",
                                        "entry_id": "15300a88-0984-39ee-89f8-b29cbccbbab0",
                                        "glosses": [
                                            "The twin brothers Castor and Pollux together."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Gemini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "076b6c79-de2c-3482-9444-221fcb302206",
                                        "entry_id": "bce4ff33-44ff-3eaf-8377-bf30de878cb3",
                                        "glosses": [
                                            "Someone who has the Gemini star sign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5825c51e-a50b-456d-b1f5-2b964aa8f7d4",
                                                "sense_id": "076b6c79-de2c-3482-9444-221fcb302206",
                                                "text": "Danny had decided he was going to try to give things a proper go with Marley’s mum, so was mainly uncontactable because, ironically, as a Gemini, he wasn’t good at focusing on two things at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2ea2e17-7711-32eb-bb05-7948e0b16662",
                                        "entry_id": "bce4ff33-44ff-3eaf-8377-bf30de878cb3",
                                        "glosses": [
                                            "A pair of something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857b1022-c964-4f19-9cd8-bed3cf8ea990",
                                                "sense_id": "b2ea2e17-7711-32eb-bb05-7948e0b16662",
                                                "text": "I haue grated vpon my good friends for three Repreeues for you, and your Coach-fellow Nim; or elſe you had look’d through the grate, like a Geminy of Baboones: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
