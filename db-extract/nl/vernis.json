                                "target_senses": [
                                    {
                                        "sense_id": "89ffc8f8-db66-34b7-bc20-8c73e2c3f03e",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Enduit liquide dont on couvre la surface d’une chose pour la rendre lisse et luisante, ou pour la préserver de l’action de l’air, de l’humidité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdda9324-3cfc-4e8c-882a-21d189fcc506",
                                                "sense_id": "89ffc8f8-db66-34b7-bc20-8c73e2c3f03e",
                                                "text": "Vernis à l’essence, à l’alcool, gras."
                                            },
                                            {
                                                "example_id": "82b53620-ce50-4c8a-88e0-d9547ac43031",
                                                "sense_id": "89ffc8f8-db66-34b7-bc20-8c73e2c3f03e",
                                                "text": "Mettre une couche de vernis."
                                            },
                                            {
                                                "example_id": "24cabdf5-8ff2-450b-af36-3662c383977b",
                                                "sense_id": "89ffc8f8-db66-34b7-bc20-8c73e2c3f03e",
                                                "text": "Passer un vernis sur un tableau, sur un meuble."
                                            },
                                            {
                                                "example_id": "fd0a8e8e-ee97-4c83-a1c5-30086549a47a",
                                                "sense_id": "89ffc8f8-db66-34b7-bc20-8c73e2c3f03e",
                                                "text": "La noblesse de province fait grande attention aux livrées et au vernis des voitures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5edab765-9d4b-3631-807f-141c35e486dc",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Enduit composé de substances vitrifiables, dont on recouvre des vases de terre, de la porcelaine, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12577c00-4b57-3e7a-91d8-e20951213f53",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Ce qui donne une apparence trompeuse ou qui dissimule la nature réelle de quelqu’un ou de quelque chose, le vernis culturel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd950c76-191e-4419-84b7-8c5dd31a70a6",
                                                "sense_id": "12577c00-4b57-3e7a-91d8-e20951213f53",
                                                "text": "On l’avait fait venir de Farreyrolles sous prétexte qu’elle était née avec des manières de dame, et qu’un séjour de quelque temps dans notre famille, ne pouvait manquer de lui donner le vernis et la tournure qu’on gagne dans la compagnie des gens d’éducation et de goût.\nPauvre cousine Marianne !\nOn en fit une domestique, qu’on maltraitait tout comme moi, — moins les coups."
                                            },
                                            {
                                                "example_id": "eaa38d2c-6593-46bf-9cf4-541c6a48060d",
                                                "sense_id": "12577c00-4b57-3e7a-91d8-e20951213f53",
                                                "text": "Au point de vue religieux les Berbères sont des musulmans de surface, dont le vernis islamique ne recouvre que très imparfaitement leurs croyances primitives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64de07b2-ac06-3355-91d3-a932206ce671",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Divers végétaux qui produisent des sucs résineux servant à la fabrication du vernis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74df98f6-a341-4e33-b0b9-5aa3d59316dd",
                                                "sense_id": "64de07b2-ac06-3355-91d3-a932206ce671",
                                                "text": "Vernis du Japon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea733857-cf23-37da-b3c7-3807ec33995d",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Se dit de la surface réfrangible du verre. Verre dépoli - Verre dont on à détruit le vernis en frottant sa surface avec du sable ou de l'émeri et une molette de grès. Dépolir - Frotter une pièce de verre avec un autre verre, ou avec un morceau de grès et du sable pour détruire son vernis naturel."
                                        ],
                                        "tags": [
                                            "Vitrerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34a9692f-c181-3e1c-bb2a-87540a7c8c38",
                                        "entry_id": "854b71a8-7fc7-3b84-9146-945dfe20e8bb",
                                        "glosses": [
                                            "Bivalve comestible, à la coquille lisse et brillante, de la Méditerranée et des côtes atlantiques, du sud des Îles Britanniques au Maroc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba8b981-e97d-4798-9094-294b5b736780",
                                                "sense_id": "34a9692f-c181-3e1c-bb2a-87540a7c8c38",
                                                "text": "Parallèlement à l’étude Manche-Ouest, depuis 1985, l’IFREMER analyse les pêcheries coquillères du sud Bretagne qui depuis 10 ans, exploitent les spisules, palourdes roses, vernis et amandes."
                                            },
                                            {
                                                "example_id": "b96e745f-0dae-44c8-82f6-f1b21ea0ad7c",
                                                "sense_id": "34a9692f-c181-3e1c-bb2a-87540a7c8c38",
                                                "text": "Les vernis fauves (Callista chione) vivent faiblement enfoncés dans le sable, à 150 mètres de profondeur tout au plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
