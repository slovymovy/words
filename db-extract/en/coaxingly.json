                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b56a74ed-7fe6-47f3-9865-82128d20f499",
                                "sense_id": "08735423-1e72-38c3-b9b9-c25921cb5901",
                                "text": "She drew her arm coaxingly through the old man’s, and whispered something in his ear; and do what he would, old Lobbs couldn’t help breaking out into a smile, while a tear stole down his cheek at the same time."
                            },
                            {
                                "example_id": "fc222aba-fef0-435c-bcb1-cbed29f4c30d",
                                "sense_id": "08735423-1e72-38c3-b9b9-c25921cb5901",
                                "text": "Now Barbie took her arm, and said coaxingly, 'You could at least tell me how much of what they say is true.'"
                            },
                            {
                                "example_id": "5dc65334-e4c7-4f52-bc23-6422c5ae1c18",
                                "sense_id": "08735423-1e72-38c3-b9b9-c25921cb5901",
                                "text": "Badger puffed coaxingly for a second or two, and then let out a roguish cloud of smoke."
                            }
                        ]
                    }
