                                                "sense_id": "59e2b2ed-1df1-3aa6-a264-4ee521e2cbe2",
                                                "text": "The new system allows users to tap on and off at a validator with a new MyWay+ transport card or certain contactless bank cards."
                                            },
                                            {
                                                "example_id": "86efaef7-afe0-4017-a30a-b10e40c9f4e7",
                                                "sense_id": "59e2b2ed-1df1-3aa6-a264-4ee521e2cbe2",
                                                "text": "Public Transport Victoria (PTV) has just kicked off a trial of a new contactless payment system in regional Victoria, allowing passengers to tap on with a credit or debit card, as well as with Apple Pay on phones and smart watches."
                                            }
                                        ]
