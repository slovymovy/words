                "senses": [
                    {
                        "sense_id": "5986089a-3bdc-30db-bb47-4732023c3b76",
                        "entry_id": "f9106708-5718-3d17-ba98-75e519bb7a01",
                        "glosses": [
                            "A river in China and Mongolia, periodical tributary of Argun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395af85a-6e43-4ab8-bd7c-e9e0017ffb81",
                                "sense_id": "5986089a-3bdc-30db-bb47-4732023c3b76",
                                "text": "Three principal rivers meander through the area: the Kherlen, Halhaun, and Uldza. Two of these originate in the Kentey Mountains and flow through the lowlands in the northeastern part of the plain; the larger Kherlen empties into Hu-lun-ch'ih (Dalay) Lake in the Chinese People's Republic, while the Uldza, when it does not first dry up, empties into the Tooroy Lake in the Soviet Union."
                            },
                            {
                                "example_id": "96d4b616-dfc3-4f98-a863-ae0fe5a59d49",
                                "sense_id": "5986089a-3bdc-30db-bb47-4732023c3b76",
                                "text": "The Khustyn Bulag site group is located in the upper basin of the Kherlen River in Tuv Aimag in Mongolia. It is located on a wide flat terrace on the northeastern shore of the Zuun Baidlag River, a tributary of the Kherlen River, and consists of many sites from the Paleolithic Age to the nineteenth century."
                            }
                        ]
                    }
