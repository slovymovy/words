                                            {
                                                "example_id": "1fbdf313-8814-4a52-bb86-5f1cc5e1aee6",
                                                "sense_id": "ebbd5fe1-b942-3b15-817f-20c951f288d8",
                                                "text": "Sapho, básnířka, nešťastná, že opustil ji její milenec, plavec Phaon, skočila s Leukadické skály do moře…"
                                            }
                                        ]
