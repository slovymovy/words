        "fr-extract.jsonl": [
            {
                "entry_id": "9e1c3697-4b66-32ac-8228-abecc99130c3",
                "word": "machinalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                        "entry_id": "9e1c3697-4b66-32ac-8228-abecc99130c3",
                        "glosses": [
                            "D’une manière machinale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "678e5c2f-af78-4abe-ba9d-33257e6da7c5",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Il ne faut pas se contenter de comparer toutes les actions des bêtes à ces mouvements que nous faisons, dit-on, machinalement, comme si ce mot machinalement expliquait tout."
                            },
                            {
                                "example_id": "0df7ea84-dc42-4a58-a98a-b88ac6d203a5",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Le peuple, accoutumé par la crainte et par l’exemple des grands à obéir machinalement, ne sait plus s’il est de la même espèce qu’eux, et croit enfin que sa situation déplorable est son état naturel."
                            },
                            {
                                "example_id": "e8d2de9d-721c-423b-9b4f-b0b4b40b03ca",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Elle ne répondit que machinalement et de manière à prouver qu’elle n'avait pas écouté."
                            },
                            {
                                "example_id": "758c6b9a-4da3-42ec-80a5-2888e7019158",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Deux fois même sa main serra machinalement la bride, comme s’il obéissait à une voix secrète qui lui commandait de revenir sur ses pas ; […]."
                            },
                            {
                                "example_id": "f70dc054-a7e1-4e76-b8ec-eec87be20c5f",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Le docteur tapait machinalement, avec sa cuillère à café, sur le bord de la table et la vieille bonne desservait lentement en cherchant à parler avec ses maîtres."
                            },
                            {
                                "example_id": "70bd6553-048f-4de5-9791-be6376b67550",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Maître Sedagne ordonna à Gaspard d’astiquer les cuivres, puis sortit et ferma la porte à clé. Gaspard entreprit machinalement son astiquage."
                            },
                            {
                                "example_id": "7557535a-0ceb-4600-9d6d-e61872400023",
                                "sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                                "text": "Toujours aussi machinalement, Aline allumait quotidiennement son ordinateur. Elle se loguait sur la messagerie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f230512-9911-4982-b64d-723ad01ddca6",
                        "source_entry_id": "9e1c3697-4b66-32ac-8228-abecc99130c3",
                        "source_sense_id": "9963c851-462e-3224-a0d8-7feba9122ca1",
                        "target_lang_word": "mechanically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mechanically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e29108d-131e-3b9a-b1b4-b33a5a2e60fa",
                                        "entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                                        "glosses": [
                                            "From a mechanical point of view."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f21bc4-88d7-4250-9a67-34f75cbfeab7",
                                                "sense_id": "7e29108d-131e-3b9a-b1b4-b33a5a2e60fa",
                                                "text": "mechanically speaking"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                        "entry_id": "43b06ea9-338d-32c0-9f39-1ba346161259",
                                        "glosses": [
                                            "In a mechanical manner, mindlessly, thoughtlessly, automatically, without thinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e6f49a-92af-4c95-9dd0-b23a2e8fd12a",
                                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                                "text": "My fears, however, made me mechanically close my thighs; but the very touch of his hand insinuated between them, disclosed them and opened a way for the main attack.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "33e20d62-7b37-49e6-a904-f1998feb90db",
                                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                                "text": "\"Of what avail,\" and her eyes wandered mechanically round, \"is all the luxury by which I am surrounded, if it serve only as a barrier to all kindly feelings?\""
                                            },
                                            {
                                                "example_id": "311670a5-267d-4537-9c01-2fbf68b830f0",
                                                "sense_id": "b497a6be-58a1-3d95-b5bb-fe9fd1b3f4e7",
                                                "text": "Provided they stick to their legal priors, rather than voting mechanically as Republican appointees, the justices seem likely to split on some of these cases — with real consequences for Trump’s agenda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
