                "senses": [
                    {
                        "sense_id": "aacad5a5-2277-3463-8298-30d53288dc4a",
                        "entry_id": "4ff77ce2-0948-3dc2-86cf-411350bb3525",
                        "glosses": [
                            "Acné liée au port prolongé d’un masque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548d03f8-bdc2-4294-b22b-492ea57c940e",
                                "sense_id": "aacad5a5-2277-3463-8298-30d53288dc4a",
                                "text": "Après quelques heures masquée, des boutons fleurissent sur votre nez, vos joues et votre menton ? Rassurez-vous, vous n'êtes pas seule à avoir 14 ans à nouveau : il s'agit de « maskné », contraction de « mask » et « acné », qui concerne essentiellement les femmes à la peau mixte."
                            },
                            {
                                "example_id": "fc69272f-9eff-41c5-a89f-e3423fcce5d2",
                                "sense_id": "aacad5a5-2277-3463-8298-30d53288dc4a",
                                "text": "Accusé de tous les maux, et même par certains de provoquer des réactions cutanées – un phénomène apparu avec le Covid-19 et promptement surnommé « maskné », contraction entre « masque et acné » –, le masque a indéniablement fait bouger les habitudes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "876f26ef-65b2-48f6-9d26-9458bb89b468",
                        "source_entry_id": "4ff77ce2-0948-3dc2-86cf-411350bb3525",
                        "source_sense_id": "aacad5a5-2277-3463-8298-30d53288dc4a",
                        "target_lang_word": "maskne",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
