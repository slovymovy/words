                {
                    "sense_id": "b631b91b-b767-3a89-8a23-a61a0d8677da",
                    "sense_definition": "S'absorber profondément et se perdre dans une pensée ou un sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Assis près de la fenêtre, le poète s'<w>abîmait</w> dans une profonde mélancolie.",
                            "target_lang_translations": {
                                "en": "Sitting by the window, the poet <w>plunged</w> into deep melancholy.",
                                "ru": "Сидя у окна, поэт <w>погружался</w> в глубокую меланхолию.",
                                "nl": "Bij het raam zittend, <w>verloor</w> de dichter <w>zich</w> in diepe melancholie.",
                                "de": "Am Fenster sitzend, <w>versenkte sich</w> der Dichter in tiefe Melancholie.",
                                "pl": "Siedząc przy oknie, poeta <w>pogrążał się</w> w głębokiej melancholii.",
                                "it": "Seduto vicino alla finestra, il poeta <w>si immergeva</w> in una profonda malinconia.",
                                "cs": "U okna seděl básník a <w>ponořoval se</w> do hluboké melancholie.",
                                "tr": "Pencere kenarında oturan şair derin bir hüzne <w>dalıyordu</w>.",
                                "es": "Sentado junto a la ventana, el poeta <w>se sumergía</w> en una profunda melancolía.",
                                "zh": "诗人靠窗坐着，<w>沉浸</w>在深深的忧郁之中。"
                            }
                        },
                        {
                            "text": "Elle s'est <w>abîmée</w> dans ses pensées et n'a pas remarqué le temps qui passait.",
                            "target_lang_translations": {
                                "en": "<w>She immersed herself</w> in her thoughts and did not notice the time passing.",
                                "ru": "Она <w>углубилась</w> в свои мысли и не заметила, как шло время.",
                                "nl": "Ze heeft <w>zich</w> in haar gedachten <w>verdiept</w> en niet gemerkt hoe de tijd verstreek.",
                                "de": "Sie hat <w>sich</w> in ihre Gedanken <w>versenkt</w> und nicht bemerkt, wie die Zeit verging.",
                                "pl": "<w>Zatopiła się</w> w myślach i nie zauważyła, jak czas mijał.",
                                "it": "<w>Si</w> è <w>immersa</w> nei suoi pensieri e non ha notato il tempo che passava.",
                                "cs": "<w>Zabrala se</w> do svých myšlenek a nevšimla si, jak čas plynul.",
                                "tr": "Düşüncelerine <w>daldı</w> ve geçip giden zamanı fark etmedi.",
                                "es": "<w>Se ensimismó</w> en sus pensamientos y no se dio cuenta de cómo pasaba el tiempo.",
                                "zh": "她<w>陷入</w>了沉思，没有察觉时间的流逝。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become deeply absorbed and lost in a thought or feeling.",
                        "ru": "Глубоко погружаться в мысли или чувство и теряться в них.",
                        "nl": "Zich diep in een gedachte of gevoel verdiepen en er helemaal in opgaan.",
                        "de": "Sich tief in einen Gedanken oder ein Gefühl versenken und darin völlig aufgehen.",
                        "pl": "Głęboko zanurzyć się w myślach lub uczuciach i całkowicie się w nich zatracić.",
                        "it": "Immergersi profondamente in un pensiero o in un sentimento, perdendosi in esso.",
                        "cs": "Hluboce se soustředit na myšlenku nebo cit a zcela se v nich ztratit.",
                        "tr": "Bir düşünceye ya da duyguya derinden dalıp kendini kaybetmek.",
                        "es": "Concentrarse profundamente en un pensamiento o sentimiento, perdiéndose en él.",
                        "zh": "深深陷入某种思绪或情感之中，无暇他顾。"
