                "senses": [
                    {
                        "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                        "entry_id": "530d0881-e052-3b54-8537-774b1bcbbddf",
                        "glosses": [
                            "ein Land auf dem indischen Subkontinent (Vorderindien), am Golf von Bengalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e819b25-e2da-4abc-be09-b5fbf7d872db",
                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                "text": "Warst Du jemals in Bangladesch?"
                            },
                            {
                                "example_id": "b5f951bf-0a8a-4f9c-bc0c-3e3d40eaf83c",
                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                "text": "Der größte Teil Bangladeschs wird von großen Flüssen durchzogen und ist deshalb oft von Überschwemmungen bedroht."
                            },
                            {
                                "example_id": "c87f6473-a611-445a-b639-3e7d136ead91",
                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                "text": "„Denn wenn beispielsweise im Ostseeraum ein Masterplan nicht aufgehe, dann spreche wenig dafür, dass er in Bangladesch sinnvoll ist.“"
                            },
                            {
                                "example_id": "7e4eafb1-690c-419e-82eb-6100d415bf4c",
                                "sense_id": "05bf08c6-a03d-3976-978c-03b2d18ceb91",
                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
