                    },
                    {
                        "translation_id": "01de00d2-f8f4-4d3d-a207-19ff3f63d2c8",
                        "source_entry_id": "7bb7049b-f956-3848-8ceb-27e4647f90fa",
                        "source_sense_id": "db46e835-17f3-39c2-bee4-0440c90571be",
                        "target_lang_word": "néogothique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néogothique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b43a4c-0030-336b-b773-582da91d778e",
                                        "entry_id": "7d09c780-e124-317b-b07d-45dd7d032a44",
                                        "glosses": [
                                            "Se dit du style architectural et ornemental, inspiré du gothique, qui se développa sous la Restauration et resta en vogue jusqu'au début du XXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62af6606-2eff-41bd-9dc4-5890a178eb3c",
                                                "sense_id": "05b43a4c-0030-336b-b773-582da91d778e",
                                                "text": "Les travaux commencent en septembre 1861, sous la conduite de l’architecte Jean-François Delarue, grand spécialiste des églises néogothiques, avec l’entrepreneur Pierre-Isidore Bénézech."
                                            },
                                            {
                                                "example_id": "bbb6e2a0-d7fd-4d3f-a6dd-afedcc63c71c",
                                                "sense_id": "05b43a4c-0030-336b-b773-582da91d778e",
                                                "text": "C'est très intéressant de voir que cela va souvent de pair avec une survalorisation du style néogothique ou néoroman, très en vogue à l'époque du plein épanouissement de la chrétienté."
                                            },
                                            {
                                                "example_id": "8300b4d2-2210-47c1-b730-b7032f72c5ba",
                                                "sense_id": "05b43a4c-0030-336b-b773-582da91d778e",
                                                "text": "Ils sont issus d’un service néogothique unique, Fabergé ayant réalisé très peu d’objets dans ce style encore à la mode à la fin du XIX siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a38421-d4e9-3fad-a93b-dd42c16268a0",
                                        "entry_id": "7d09c780-e124-317b-b07d-45dd7d032a44",
                                        "glosses": [
                                            "Inspiré du gothique (mouvement culturel, notamment musical et vestimentaire, apparu à la fin du XXᵉ siècle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c391ea-b6e3-4c27-8e4a-0ebe506a963b",
                                                "sense_id": "87a38421-d4e9-3fad-a93b-dd42c16268a0",
                                                "text": "J’ai toujours aimé le style néogothique porté par des œuvres comme Frankenstein, de Mary Shelley, racontait à 20 Minutes Tim Burton, honoré le mois dernier au Festival Lumière de Lyon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "néogothique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50774369-6468-310e-8ff4-96bad5f8b826",
                                        "entry_id": "33ba5261-60b8-3650-85f3-0820e4ece7d4",
                                        "glosses": [
                                            "Style architectural né au milieu du XVIIIᵉ siècle en Angleterre et florissant au XIXᵉ siècle dans le cadre du romantisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2fba0e-97a2-4fa0-9a4e-804106e6ac55",
                                                "sense_id": "50774369-6468-310e-8ff4-96bad5f8b826",
                                                "text": "Le néogothique français a ses racines dans un aspect mineur de l’anglomanie, commençant à la fin des années 1780."
                                            },
                                            {
                                                "example_id": "5f4cd272-d2f4-4901-9f0b-aa806e1ced75",
                                                "sense_id": "50774369-6468-310e-8ff4-96bad5f8b826",
                                                "text": "Plus tard, il se repentira de ce genre de déclaration, lorsqu’il aura vu le néogothique appliqué à toutes sortes d’usages, de la gare de chemin de fer à l’immeuble de bureaux et de l’entrepôt à la maison ouvrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
