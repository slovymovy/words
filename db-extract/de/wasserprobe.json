                ],
                "senses": [
                    {
                        "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                        "entry_id": "32258c9e-2a3f-34f2-bd80-bf4e067e5215",
                        "glosses": [
                            "(kleine Menge) Wasser (oft aus einem Gewässer), die zu einer Untersuchung der Inhaltsstoffe gebraucht wird, um beispielsweise Umweltverschmutzungen oder Keimbelastungen zu entdecken"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "5b7c525d-91d4-4553-be69-a4ddf59ee60e",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Die örtlichen Gesundheitsämter nehmen“ […] „mindestens einmal im Monat Wasserproben und untersuchen sie vor allem auf Bakterien wie E.coli und Intestinale Enterokokken,“ […]."
                            },
                            {
                                "example_id": "71b4319e-be05-492f-b470-1c560dadb3a3",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Um sicherzugehen, entnehmen Behörden an Badestellen regelmäßig Wasserproben, um die Konzentration der Bakterien im Wasser zu überprüfen.“"
                            },
                            {
                                "example_id": "d03fd927-7d61-4062-8a22-8764d8c57d4e",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "[Die Mitarbeiter der britischen Umweltstiftung \"Changing Markets\"] „entnahmen Wasserproben an 34 Stellen, immer in der Nähe von Pharmaunternehmen, die Antibiotika produzieren.“"
                            },
                            {
                                "example_id": "2cdf9cfb-4ce0-45ec-ac61-6d707c537633",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Seit 2018 nehmen die Kollegen vom Geomar immer wieder Wasserproben - und weisen in jeder Wasserprobe Sprengstoff nach, wenn auch in geringen Mengen.“"
                            },
                            {
                                "example_id": "531c1ade-9ad5-4607-a917-c84fba631d12",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Eine Analyse der Wasserprobe und verschiedener Tierkadaver bringt eine gefährliche Quecksilber-Verseuchung ans Licht.“"
                            },
                            {
                                "example_id": "0324f8cd-1a53-49ca-b73a-675fdcbb7508",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Um herauszufinden, wo welche Arten der bedrohten Tiere leben, haben die Forscher der Uni Innsbruck eine einfache Methode entwickelt, die anhand einer Wasserprobe aufschlüsselt, welche Organismen und Tiere in einem Gewässer leben. Mithilfe des sogenannten „eDNA-Monitorings“ werden dabei die Umwelt-DNA-Spuren der Tiere analysiert.“"
                            },
                            {
                                "example_id": "894b4cf7-2d5e-4cdb-b0a0-f2f8f2916198",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„An Bord des Begleitschiffes werden täglich Wasserproben analysiert.“"
                            },
                            {
                                "example_id": "f4e97472-823a-4d19-8844-124ddae52847",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Deshalb haben sie Wasserproben aus beiden Gläsern chemisch analysiert und die Leitfähigkeiten gemessen,“ […]."
                            },
                            {
                                "example_id": "5da02fea-5369-4819-bb91-9489fe8e94d4",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„Als Grenzwert laut Trinkwasserverordnung dürfen Coliforme Bakterien in 100 ml Wasserprobe nach einem Anreicherungsverfahren nicht nachweisbar sein.“"
                            },
                            {
                                "example_id": "aa735172-11fa-4dd0-b279-148c02cf1761",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "[22. Juli 1961:] „Wegen der starken Verschmutzung des Rheinwassers muss der Stadtrat von Ludwigshafen das einzige Rhein-Strandbad der Stadt schließen. Bei Wasserproben im September 1959 waren in 100 cm Wasser 60 000 Colikeime (Kot-Bakterien) festgestellt worden. Im Juni 1960 waren es 1,5 Millionen Bakterien.“"
                            },
                            {
                                "example_id": "45020703-71e5-4a30-8973-940634bf4e9f",
                                "sense_id": "bdcf1796-fd4c-3af5-87a8-a8005988ae68",
                                "text": "„»Es ist schlimm«, sagt die 61-jährige Mercedes Noroña, als sie erfährt, dass eine Wasserprobe aus ihrem Haus in Quito in Ecuador Kunststofffasern enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
