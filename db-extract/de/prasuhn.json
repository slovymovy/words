                ],
                "senses": [
                    {
                        "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                        "entry_id": "111cb071-fe57-38e7-9a43-cd5927b4ed9f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a5aab6-2536-41e9-8722-8ee1d9ecd434",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Frau Prasuhn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1fe86bd1-0de5-4bd4-9af7-48843165717e",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Herr Prasuhn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f2d3b051-a400-45c0-8e3d-f13cdb532252",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Die Prasuhns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a791e0e3-f8cd-475e-a5de-95868a777569",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Der Prasuhn trägt nie die Schals, die die Prasuhn ihm strickt."
                            },
                            {
                                "example_id": "dc1444e5-73f7-4072-bd23-f3716f0619fb",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Prasuhn kommt, geht der Herr Prasuhn.“"
                            },
                            {
                                "example_id": "f6dcea08-5be6-4361-b26f-06a58f2ecda2",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Prasuhn kommt und geht."
                            },
                            {
                                "example_id": "04ecb623-2761-4a26-a21d-df5eb99c88ff",
                                "sense_id": "dde34a44-6abe-3228-8513-bc03767ecdd1",
                                "text": "Prasuhns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
