                "senses": [
                    {
                        "sense_id": "32bce1cf-f913-3291-8eab-969dcee0a1b5",
                        "entry_id": "f42c642e-14d1-3430-acd5-a3323ee3bbe8",
                        "glosses": [
                            "Envoyer un message à quelqu’un sur sa boîte de réception Facebook."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94fb1bb8-4282-4f11-94e5-8c76155e7e99",
                                "sense_id": "32bce1cf-f913-3291-8eab-969dcee0a1b5",
                                "text": "Et puis quand je suis allé me plaindre pour demander à l’administratrice de « String & Cie » pourquoi est-ce qu’elle m’avait expulsé alors que je n'avais pourtant rien fait de mal, elle m'a dit que c'est parce que j'avais déjà « inboxé » plus de 53 filles !"
                            },
                            {
                                "example_id": "cab0df7a-7420-4956-ba7c-9603e19e2974",
                                "sense_id": "32bce1cf-f913-3291-8eab-969dcee0a1b5",
                                "text": "Mais aujourd'hui, on n'accorde plus de temps et, dès qu'il y a un accrochage, ils vont voir qui les a inboxé sur Facebook…"
                            },
                            {
                                "example_id": "2ff2854e-c3f4-46e3-8b82-19b210ff3018",
                                "sense_id": "32bce1cf-f913-3291-8eab-969dcee0a1b5",
                                "text": "Du coup j'ai inboxé BB pour lui demander si elle pouvait me descendre une tranche de pain."
                            }
                        ]
                    }
