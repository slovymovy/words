                                "target_lang_word": "zamykać",
                                "target_lang_sense_clarification": "spotkanie, sprawę, listę"
                            },
                            {
                                "target_lang_word": "kończyć",
                                "target_lang_sense_clarification": "działanie, proces"
                            },
                            {
                                "target_lang_word": "domykać",
                                "target_lang_sense_clarification": "interes, transakcję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be2df87-53a0-3619-a92e-2b018b4292f6",
                    "sense_definition": "To stop operating or being open to the public for a period of time or permanently.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supermarket <w>closes</w> at eight o'clock every evening.",
                            "target_lang_translations": {
                                "ru": "Супермаркет <w>закрывается</w> в восемь часов каждый вечер.",
                                "pl": "Supermarket <w>zamyka się</w> o ósmej każdego wieczoru."
                            }
                        },
                        {
                            "text": "Many small shops have <w>closed</w> due to the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Многие небольшие магазины <w>закрылись</w> из-за экономического кризиса.",
                                "pl": "Wiele małych sklepów <w>zamknęło się</w> z powodu kryzysu gospodarczego."
                            }
                        }
                    ],
                    "synonyms": [
                        "shut",
                        "close down"
                    ],
                    "antonyms": [
                        "open"
                    ],
                    "common_phrases": [
                        "close early",
                        "store closes",
                        "close for business"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить работу или доступ для публики на время или навсегда.",
                        "pl": "Przestać działać lub być otwartym dla publiczności na pewien czas lub na stałe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрываться",
                                "target_lang_sense_clarification": "о магазине, учреждении"
                            },
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "бизнес, магазин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zamykać się",
                                "target_lang_sense_clarification": "o sklepie, instytucji"
                            },
                            {
                                "target_lang_word": "zamykać",
                                "target_lang_sense_clarification": "biznes, działalność"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d208bc-31bf-35ac-9918-ac48877539a1",
                    "sense_definition": "To terminate a computer program, window, or file.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to save your work before you <w>close</w> the application.",
                            "target_lang_translations": {
                                "ru": "Не забудьте сохранить работу, прежде чем <w>закрыть</w> приложение.",
                                "pl": "Upewnij się, że zapisałeś swoją pracę, zanim <w>zamkniesz</w> aplikację."
                            }
                        },
                        {
                            "text": "I accidentally <w>closed</w> the tab I was reading.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>закрыл</w> вкладку, которую читал.",
                                "pl": "Przypadkowo <w>zamknąłem</w> kartę, którą czytałem."
                            }
                        }
                    ],
                    "synonyms": [
                        "exit"
                    ],
                    "antonyms": [
                        "open",
                        "launch"
                    ],
                    "common_phrases": [
                        "close the window",
                        "close the app",
                        "close a file"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in computing contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершить работу компьютерной программы, окна или файла.",
                        "pl": "Zakończyć działanie programu komputerowego, okna lub pliku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "программу, окно"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "программу, окно"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zamykać",
                                "target_lang_sense_clarification": "program, kartę, okno"
                            },
                            {
                                "target_lang_word": "zamknąć",
                                "target_lang_sense_clarification": "program, kartę, okno"
                            }
                        ]
                    }
                }
            ]
        },
        {
