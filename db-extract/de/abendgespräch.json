                        "examples": [
                            {
                                "example_id": "b4d940fc-49ed-4754-9749-ed432a5e507e",
                                "sense_id": "132e1539-0821-3c69-afc8-57fa893735e5",
                                "text": "„Aber es war nicht alles: Dieser gesellschaftlichen Mai-Feier war am 10. Juli das heimliche Abendgespräch in der Villa Horten zwischen den beiden Parteivorsitzenden nebst Begleitung als ein zweckgebundener politischer Treff gefolgt.“"
                            },
                            {
                                "example_id": "1e57b6bf-f3a6-4e88-88e7-07a77b3b2e13",
                                "sense_id": "132e1539-0821-3c69-afc8-57fa893735e5",
                                "text": "„Damit Kinder zur Ruhe kommen können, hilft es ebenso kleine, beruhigende Rituale einzuführen, wie eine gemeinsame Gute-Nacht-Geschichte, gemeinsames Aufräumen, Hörspiele anhören oder Abendgespräche.“"
                            }
                        ],
