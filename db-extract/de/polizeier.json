                ],
                "senses": [
                    {
                        "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                        "entry_id": "2ddec0b6-e244-3b97-91a9-f7b67d188324",
                        "glosses": [
                            "bundesdeutsch bisweilen oder selten; bisweilen Namibia bisweilen Angehöriger der Polizei"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "humorous",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "0ffcab74-246d-4162-9ef2-e9d182fbd937",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Verdient hatten sich die helvetischen Polizeier das Lob durch einen exakt getimten Zugriff.“"
                            },
                            {
                                "example_id": "2a9c6ace-06de-4daa-a625-c7dd4ecbec82",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Damals hiess es, der Bürger, der in Genf demonstriere, schätze es gar nicht, von einem Zürcher Polizeier «gestallt» zu werden.“"
                            },
                            {
                                "example_id": "8b4f657d-cd48-4fd5-a4a2-cb5c432ab13c",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Die Polizeier kamen schon und stöberten in den Baracken umher, jeden Dreck schnüffelten sie an.“"
                            },
                            {
                                "example_id": "e345bde8-2c53-48c6-9b76-ffa10a11a26d",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Da er als US-Soldat psychologische Kriegsführung betrieben habe, sei ihm klar gewesen, daß man eine Geheimdienst-Provokation abwehre, indem man ihr die Konspiration nehme. Also habe er sich an die Polizei gewandt, und ‚der einzige Polizeier, den ich kannte, war Herr Heine, der Gatte meiner Sekretärin‘.“"
                            },
                            {
                                "example_id": "74e66047-dfd0-4647-93de-a162cbb743fe",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Die meisten wußten, das die Liane aus der Hoffnungsbay einen »Polizeier« heiratet, »einen aus Stadt«.“"
                            },
                            {
                                "example_id": "d582f9db-c6cd-4824-b3b8-47a2477d8b24",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Vielmehr schätzen die Leute, dass der Polizeier vor Ort präsent ist und ein offenes Ohr für ihre Sorgen und Probleme hat.“"
                            },
                            {
                                "example_id": "8cf7eba9-be82-4852-8a79-6d94219d1c69",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„René W. verlangte, die »lieben Polizeier« als Zeugen zu vernehmen.“"
                            },
                            {
                                "example_id": "b69bf6e3-0f5c-46f5-9c82-ec100c148455",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Anton wird von einer Frauenstimme zum Einsatz gerufen. Polizeier, hier kampeln sich zweie.“"
                            },
                            {
                                "example_id": "2c778309-ed9a-4aae-a45d-79d18c28e77e",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Ein schwieriger Part, Rahbar musste hier noch einen aus dem Text gestrichenen Polizeier mit deus-ex-machina-Effekt spielen.“"
                            },
                            {
                                "example_id": "3c5bf410-a271-4182-b639-741c4a52a04f",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Wegen dieses Auftretens gegen die Bevölkerung hatten sich die Polizeibeamten äußerst verhasst gemacht und die Novemberrevolution zeigte den Massen, dass die ‚Polizeier‘ durchaus auch sehr untertänig sein konnten.“"
                            },
                            {
                                "example_id": "8ccbd991-fde0-416a-98f4-2f3b38758894",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Marcel spürt den eiskalten Wind seit einigen Wochen in dem abgelegenen Jugendwerkhof ‚Willi Gebhardt‘. Er ist der neunte, und es gibt sechs Erzieher, besser Polizeier.“"
                            },
                            {
                                "example_id": "c25e60c7-c081-40cc-93fc-1e48a3609501",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Einer von uns hatte auch bald einen Spruch parat: ‚Was essen die Polizeier?‘ Die prompte Antwort vom höher liegenden Ortsteil Kleinforst war: ‚Eier, Eier, Eier‘!“"
                            },
                            {
                                "example_id": "037b09f8-a5ad-46c0-b2ee-f32febb75091",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„In Dornbirn-Hatlerdorf kam sie 1908 als Tochter des Ferdinand Ölz (‚Polizeier‘) und der Agatha geb. Fussenegger zur Welt.“"
                            },
                            {
                                "example_id": "f885ae94-aa45-4c30-96ca-c7b99559b6a6",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„An einem ſchönen Morgen griff der Polizeier von Körbliwyl eine Frau auf, that als ob er ſie treffen wollte und führte ſie ihrer Heimath Salbinigen zu.“"
                            },
                            {
                                "example_id": "1a6cd2e7-8004-44b3-9896-1c6785a4155b",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Der neue Chef zeige sich zu wenig, heisst es von manchem langgedienten Polizeier.“"
                            },
                            {
                                "example_id": "bd52b72a-ad01-4403-81b1-81a75b5ace64",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Bei so mancher Erzählung aus dem Alltagsdienst des «Polizeiers» glitt er ab und erzählte aus seiner strapazierenden Zeit als Ordnungshüter.“"
                            },
                            {
                                "example_id": "40caa9d4-7995-4a73-9abd-f865d2a85e09",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Jörg Schild hat als höchster ‚Polizeier‘ das Bemühen um möglichste Sicherheit geradezu personifiziert.“"
                            },
                            {
                                "example_id": "b112c3d2-3707-4e68-ba9f-54c11a79c414",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Wenn in den 40er-Jahren einem «Polizeier» ein Arrestant entwischte, gab es eine Busse von 30 Franken, 10 Prozent eines Bruttolohns.“"
                            },
                            {
                                "example_id": "edcafb3b-8429-4910-b98e-b651872b8f19",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Die Moral der Geschicht: Stinkts nach Eier ruf nicht gleich die Polizeier.“"
                            },
                            {
                                "example_id": "0b803465-b8ad-4b2f-aa27-f24d90c26556",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Und wenn die neue Stadtpolizei von Ovenduka Leute rekrutiert, gibt es einen Sturmlauf, dass die Metropole mit den übrigen Anwärtern eigentlich jedes Kaff, jeden Flecken und die letzte Kleinstadt von Schuckmannsburg im Caprivi bis Oranjemund auch noch mit überschüssigen Polizeiern beschicken könnte.“"
                            },
                            {
                                "example_id": "e3af95d7-25a6-4257-9c36-0a75111b2ead",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Da schickt der Richter seinen Polizeier und lässt sich den Handy-Sünder vorführen, direkt vor den Richterstuhl.“"
                            },
                            {
                                "example_id": "688d66d9-c35a-4d49-ad74-d7300c5a5ed9",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Oder umgekehrt, ob der Polizeier, der Magistrat oder andere Oukies, die Du durch Dein Steuergeld moi unterhältst, ‘was von Dir wollen.“"
                            },
                            {
                                "example_id": "ff9f769c-def6-48f1-a39e-be53a002bfa0",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Diesmal müssen die Polizeier nicht gegen Portugiesen eingreifen, die ihr Konsulat besetzen wollen.“"
                            },
                            {
                                "example_id": "8947abe0-46cf-4f03-8429-11d0c8afc8f0",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Vorn an der Straße mit Blick auf den Thüringer Hof, auf den Fiskus und die Turnhalle haben viele Polizeier ihr Quartier und daneben kommt dann die Hauptwache von Ovenduka.“"
                            },
                            {
                                "example_id": "a5aa609a-eb53-43ff-a2eb-6b50ea30b262",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Auch die Shebeens haben die Polizeier noch in Ruhe gelassen.“"
                            },
                            {
                                "example_id": "f36cb24c-c7ee-4bca-96f0-0979d10a5b00",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Die Polizeier haben ein paar von den Waffen beschlagnahmt, denn die sind sichtbar und man kann die anfassen.“"
                            },
                            {
                                "example_id": "2b2bb4df-dcaa-4fc4-80a7-5c9b316aae7f",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Die Polizeier und viele Geschäftsleute orientieren sich eher an Bäumen, Läden, Tankstellen und Supermärkten als an Straßennamen und geben Dir dann auch, wenn überhaupt, entsprechend Auskunft.“"
                            },
                            {
                                "example_id": "0118b19e-9933-4ee8-bd30-61b4ad880528",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Dann kam toch noch ein lediger Polizeier am Vormittag im Unterhemd vom Hinterhof und gab bereitwillig Auskunft.“"
                            },
                            {
                                "example_id": "afb60ed0-59c1-45a8-8e56-df6dc7e61019",
                                "sense_id": "83c25fab-9e2e-37fc-a64c-2c165fe5e3d4",
                                "text": "„Und dann gab’s sowahr wrachtach den einen oder anderen Polizeier, der hat dem nichts ahnenden Touri den Film aus der Kamera gerissen, als wir alle noch mit Zelluloid gespielt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
