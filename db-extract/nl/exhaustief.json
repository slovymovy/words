                "senses": [
                    {
                        "sense_id": "af4635e6-0085-31ee-87f2-df556a692c6b",
                        "entry_id": "19cf85ae-7f72-3f17-a5b4-22d76d48109c",
                        "glosses": [
                            "van een opsomming dat deze compleet is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe30df57-dda0-4e4d-8643-e8bd9be98206",
                                "sense_id": "af4635e6-0085-31ee-87f2-df556a692c6b",
                                "text": "De permanente terreurdreiging van kalifaten in het Midden-Oosten legt een bom onder de wereldvrede. Dat op zijn beurt, remt de bedrijvigheid van de mondiale economie af. De bovenstaande lijst van acht punten is verre van exhaustief."
                            },
                            {
                                "example_id": "2935748a-d432-4ba9-b158-c2461222950c",
                                "sense_id": "af4635e6-0085-31ee-87f2-df556a692c6b",
                                "text": "Net als Glenny’s eerdere boek The Balkans is McMaffia exhaustief, lijvig en rijk aan historische verbanden, achtergrondinformatie en inzicht – soms iets te veel voor een leek. Maar altijd is het vlot leesbaar, dankzij beeldende beschrijvingen, spectaculaire anekdotes en bijzondere personages."
                            }
                        ]
                    }
                ],
