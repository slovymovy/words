                                "target_senses": [
                                    {
                                        "sense_id": "ec2fb7a7-0a58-38dc-b4af-bb0c81e2e375",
                                        "entry_id": "e5037a25-a16b-33f7-85b9-3fe26442d93d",
                                        "glosses": [
                                            "miasto na Ukrainie w obwodzie kijowskim, rejonie iwankowskim"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d0a939-3007-41c9-89cf-d0dea694c2a7",
                                                "sense_id": "ec2fb7a7-0a58-38dc-b4af-bb0c81e2e375",
                                                "text": "W Czarnobylu doszło do największej katastrofy nuklearnej w historii."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "6d7e5e3b-9909-396b-8786-e98f558c7a35",
                                        "entry_id": "e5037a25-a16b-33f7-85b9-3fe26442d93d",
                                        "glosses": [
                                            "katastrofa w elektrowni jądrowej w Czarnobylu (1.1) w 1986 r."
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf98ecc-8f47-429c-8c74-c734f3616049",
                                                "sense_id": "6d7e5e3b-9909-396b-8786-e98f558c7a35",
                                                "text": "W opublikowanym w dziesiątą rocznicę wybuchu raporcie jedynymi ofiarami Czarnobyla są ratownicy, którzy gasili pożar w pierwszej fazie katastrofy i zostali napromieniowani niezwykle wysokimi dawkami"
                                            }
                                        ],
