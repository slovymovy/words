                    "frequency": "Middle",
                    "semantic_group_id": "restituer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de lui <w>redonner</w> ses clés avant de partir ce soir.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>give</w> him <w>back</w> his keys before you leave tonight.",
                                "ru": "Не забудь <w>вернуть</w> ему ключи перед уходом сегодня вечером.",
                                "de": "Vergiss nicht, ihm seine Schlüssel <w>zurückzugeben</w>, bevor du heute Abend gehst.",
                                "es": "No olvides que le <w>devuelvas</w> sus llaves antes de salir esta noche.",
                                "zh": "别忘了今晚离开之前把钥匙<w>还</w>给他。"
                            }
                        },
                        {
                            "text": "Il m'a promis de me <w>redonner</w> mon livre dès la fin de la semaine.",
                            "target_lang_translations": {
                                "en": "He promised to <w>give</w> me <w>back</w> my book as soon as the week is over.",
                                "ru": "Он обещал <w>вернуть</w> мне мою книгу, как только закончится неделя.",
                                "de": "Er hat versprochen, mir mein Buch <w>zurückzugeben</w>, sobald die Woche vorbei ist.",
                                "es": "Me prometió que me <w>devolvería</w> mi libro en cuanto acabe la semana.",
                                "zh": "他答应这周结束后就把我的书<w>还</w>给我。"
