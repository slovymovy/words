                ],
                "senses": [
                    {
                        "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                        "entry_id": "e51face2-f3c2-3260-8e76-cfc52d0c918d",
                        "glosses": [
                            "gewaltsamer Einsatz von Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9841e72-2797-4cf9-a7c3-ce073f5dd508",
                                "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                                "text": "„Die Ukraine hat bisher keine Anstalten gemacht, sich mit Waffengewalt zu wehren.“"
                            },
                            {
                                "example_id": "97765efe-95ef-48a3-835e-3254f85ec2e0",
                                "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                                "text": "„Lokale Stammeskämpfer hatten die Isis-Terroristen zunächst gewährenlassen und sich stattdessen darauf konzentriert, ein Eindringen der Armee in die Stadt mit Waffengewalt zu verhindern.“"
                            },
                            {
                                "example_id": "ef9649c9-e0c8-443e-85f7-eaae0013e5fc",
                                "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                                "text": "„Stirbt ein Drogenhändler im Einsatz, zahlen etliche Drogenbosse eine Art Hinterbliebenenrente; und wird einer verletzt, kapern Banden auch schon mal kleine Privatkliniken mit Waffengewalt und zwingen die dortigen Ärzte zur Operation.“"
                            },
                            {
                                "example_id": "bb718a3e-2eef-42d5-9796-2ad247d2d332",
                                "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                                "text": "„Doch teils mit Waffengewalt, teils über öffentlichen Druck seiner Anhänger auf die Kaiserin bringt der Regent sie zum Schweigen.“"
                            },
                            {
                                "example_id": "ac39efa7-e464-48ec-bd43-eea7340b84a2",
                                "sense_id": "1d218f0e-de18-3479-b684-f2f496db296a",
                                "text": "„Friedliche Demonstrationen werden mit Waffengewalt niedergeschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
