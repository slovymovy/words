                    {
                        "translation_id": "8024984c-7d70-42c9-abaf-6f38d133f4b2",
                        "source_entry_id": "2987af4b-7626-36bc-843a-bd346d7dc72d",
                        "source_sense_description": "of a wetland: deficient in plant nutrients",
                        "target_lang_word": "nährstoffarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nährstoffarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                        "entry_id": "b6a2b36c-0dc0-35ed-a99f-859bfda7f0d6",
                                        "glosses": [
                                            "einen niedrigen Gehalt an Nährstoffen aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93213936-40c8-4409-9e6e-6258a5d55c9c",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "Dieser Boden ist sehr nährstoffarm."
                                            },
                                            {
                                                "example_id": "ad5c66e2-b40c-4950-b7f3-78b5f61af135",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "„Die Suche nach gesundem Hundefutter kann für sie allerdings schwer werden. Wie Stiftung Warentest herausfand, sind viele Sorten zu nährstoffarm.“"
                                            },
                                            {
                                                "example_id": "5d4448cb-e6b7-4288-aa96-f1547de05d3b",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "„Torf ist ein geschätzter Bestandteil vieler Blumenerden. Denn Torf ist nährstoffarm, hat einen sauren pH-Wert und gute physikalische Eigenschaften, die Pflanzen entgegenkommen.“"
                                            },
                                            {
                                                "example_id": "62adb17e-cd7f-4ce0-9074-8b5e0df04036",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "„So sollten zum Beispiel Pflanzen, die man aus Samen zieht, sowie Kräuter grundsätzlich nährstoffarmes, gut durchlässiges Substrat erhalten, raten die Experten des Bundeszentrums für Ernährung.“"
                                            },
                                            {
                                                "example_id": "c91eebd2-6e23-4da7-a43a-9cbe05760915",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "„Längere und bessere Weide, nährstoffreicheres und nährstoffärmeres Heu, höhere oder niedrigere Preise würden verschiedene Leistungen bedingen, ohne daß sie in der Leistungsfähigkeit der Kühe begründet wären.“"
                                            },
                                            {
                                                "example_id": "9730591f-ced5-4bc2-8f61-6649dca895aa",
                                                "sense_id": "55a63dfa-7ea4-3d1d-b4fe-c91273590a4d",
                                                "text": "„Die Bodenvegetation ist äußerst artenreich und zeigt stellenweise eine eigenartige Durchdringung von Elementen nährstoffreicherer und nährstoffärmster, feuchter Standorte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
