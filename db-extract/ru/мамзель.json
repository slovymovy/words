                ],
                "senses": [
                    {
                        "sense_id": "93c4a70c-2708-3449-9381-fe96c3b3b8cd",
                        "entry_id": "74b70921-c7ce-37d4-8df8-a454c289fdb6",
                        "glosses": [
                            "устар., прост., пренебр. то же, что мадемуазель; девушка; молодая незамужняя женщина; гувернантка, приживалка"
                        ],
                        "tags": [
                            "иногда"
                        ],
                        "examples": [
                            {
                                "example_id": "2943cff9-2279-4737-bfef-cedc4cce5c72",
                                "sense_id": "93c4a70c-2708-3449-9381-fe96c3b3b8cd",
                                "text": "Барыня с детями в гости поехали, а барин с мамзелью-гувернанткой рыбу ловят-с."
                            },
                            {
                                "example_id": "05e2d825-fb42-41d1-a19b-0f4dc942b314",
                                "sense_id": "93c4a70c-2708-3449-9381-fe96c3b3b8cd",
                                "text": "Три дня после того, Лизавете Ивановне молоденькая, быстроглазая мамзель принесла записочку из модной лавки."
                            }
                        ]
                    },
                    {
                        "sense_id": "d392a2ba-04c1-3934-bd1d-6c483cac65fc",
                        "entry_id": "74b70921-c7ce-37d4-8df8-a454c289fdb6",
                        "glosses": [
                            "устар., пренебр. девушка или женщина, принадлежащая к театральной богеме"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9550be4a-2763-4d35-8810-20ed9b26745c",
                                "sense_id": "d392a2ba-04c1-3934-bd1d-6c483cac65fc",
                                "text": "У вас тут, говорят, мамзели, стоя на лошадях, ездят… правда?"
                            }
                        ]
                    },
                    {
                        "sense_id": "41134a7c-26a7-34ef-8c48-361dcc623368",
                        "entry_id": "74b70921-c7ce-37d4-8df8-a454c289fdb6",
                        "glosses": [
                            "устар., прост. проститутка, женщина лёгкого поведения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283fbcce-db3b-4a12-a360-e26ac9c0f80e",
                                "sense_id": "41134a7c-26a7-34ef-8c48-361dcc623368",
                                "text": "Захвати музыканта Кузьму горчицей ему голову мазать да мамзелей штуки четыре."
                            }
                        ]
                    }
                ],
