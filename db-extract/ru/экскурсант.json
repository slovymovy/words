                    },
                    {
                        "translation_id": "2ea21698-b12c-4994-8d1f-06888904c9c2",
                        "source_entry_id": "ed909c95-51ea-3d0d-b52a-5e6838f4c82b",
                        "source_sense_id": "08a98fbb-1ac9-30d4-bf4d-58d30575c3e6",
                        "target_lang_word": "excursionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4837eca3-1fcd-3a0b-bc33-c4950467c661",
                                        "entry_id": "0779a6d2-0ebe-313d-a540-a33ae2b7fdac",
                                        "glosses": [
                                            "Celui, celle qui fait une excursion ou qui a le goût des excursions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d18cac-9787-4b4e-81e1-08d7037ac8e8",
                                                "sense_id": "4837eca3-1fcd-3a0b-bc33-c4950467c661",
                                                "text": "De cette façon, les excursionnistes seraient de retour au fort avec le coucher du soleil."
                                            },
                                            {
                                                "example_id": "ce127c04-9cde-4f6f-9e45-3d6f088f91e6",
                                                "sense_id": "4837eca3-1fcd-3a0b-bc33-c4950467c661",
                                                "text": "L’allégresse qu’ils semaient le long de la route affectait diversement, et selon leurs tempéraments, les autres excursionnistes."
                                            },
                                            {
                                                "example_id": "ebd02a34-6433-4c63-96a6-15c780943fb0",
                                                "sense_id": "4837eca3-1fcd-3a0b-bc33-c4950467c661",
                                                "text": "Les excursionnistes continuent leur marche vers Logny-Bogny et visitent deux carrières qui exploitent les calcaires blancs du Bathonien moyen au voisinage du pont où la voie ferrée de Liart à Charleville franchit la route ; […]."
                                            },
                                            {
                                                "example_id": "e44d10df-da64-47cf-bc11-389a13d5310f",
                                                "sense_id": "4837eca3-1fcd-3a0b-bc33-c4950467c661",
                                                "text": "L’enfant a vu son premier burg ; du bateau à vapeur pour excursionnistes, il a contemplé avec un vague émerveillement la Lorelei, où une fée assise au haut du rocher peignait ses cheveux d’or."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
