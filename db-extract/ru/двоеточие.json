                                    }
                                ]
                            },
                            {
                                "target_word": "colon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5abb5af-743b-3149-9304-d29e92f62619",
                                        "entry_id": "e1cefbb1-6d55-3f78-ad24-d35de0ee4495",
                                        "glosses": [
                                            "Part of the large intestine; the final segment of the digestive system, after (distal to) the ileum and before (proximal to) the rectum. (Because the colon is the largest part of the large intestine (constituting most of it), it is often treated as synonymous therewith in broad or casual usage.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1eb1ec-066d-4e24-8801-56f9ef12e5ff",
                                                "sense_id": "f5abb5af-743b-3149-9304-d29e92f62619",
                                                "text": "Colorectal cancer refers to colon cancer, which starts in the colon, and rectal cancer, which starts in the rectum."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ba90d5-8e0f-324d-92a1-033f1b3eb792",
                                        "entry_id": "1c57619a-cdb4-3cdf-85bb-6da8d6ceb9ca",
                                        "glosses": [
                                            "A husbandman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65105553-e50b-3a08-9aee-b1faa4662965",
                                        "entry_id": "1c57619a-cdb4-3cdf-85bb-6da8d6ceb9ca",
                                        "glosses": [
                                            "A European colonial settler, especially in a French colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae63cc4-f8c6-4e1e-86e4-b80fca7899f5",
                                                "sense_id": "65105553-e50b-3a08-9aee-b1faa4662965",
                                                "text": "The reaction of the European colons, a mixture of shock and fear, was to demand further draconian measures and to suspend any suggestion of new reforms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de6535e0-04eb-4b3b-a44a-38c4e1e9a5b2",
