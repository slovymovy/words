                    "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                    "sense_definition": "That smiles or has a smile.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>smiling</w> baby looked happily at her mother.",
                            "target_lang_translations": {
                                "ru": "<w>Улыбающийся</w> ребенок радостно смотрел на маму.",
                                "zh": "那个<w>微笑的</w>婴儿开心地看着她的妈妈。",
                                "nl": "De <w>glimlachende</w> baby keek vrolijk naar haar moeder.",
                                "pl": "<w>Uśmiechnięte</w> niemowlę patrzyło radośnie na swoją matkę.",
                                "de": "Das <w>lächelnde</w> Baby schaute glücklich zu seiner Mutter.",
                                "fr": "Le bébé <w>souriant</w> regardait joyeusement sa mère.",
                                "it": "Il bambino <w>sorridente</w> guardava felicemente sua madre.",
                                "cs": "<w>Usmívající se</w> miminko se šťastně dívalo na svou matku.",
                                "tr": "<w>Gülümseyen</w> bebek annesine mutlulukla baktı.",
                                "es": "El bebé <w>sonriente</w> miraba felizmente a su madre."
                            }
                        },
                        {
                            "text": "He greeted everyone with a warm, <w>smiling</w> face.",
                            "target_lang_translations": {
                                "ru": "Он приветствовал всех с теплым, <w>улыбающимся</w> лицом.",
                                "zh": "他带着温暖、<w>微笑的</w>面容向大家问好。",
                                "nl": "Hij begroette iedereen met een warm, <w>glimlachend</w> gezicht.",
                                "pl": "Witał wszystkich z ciepłą, <w>uśmiechniętą</w> twarzą.",
                                "de": "Er begrüßte jeden mit einem warmen, <w>lächelnden</w> Gesicht.",
                                "fr": "Il a accueilli tout le monde avec un visage chaleureux et <w>souriant</w>.",
                                "it": "Ha salutato tutti con un volto caldo e <w>sorridente</w>.",
                                "cs": "Všechny pozdravil vřelou, <w>usměvavou</w> tváří.",
                                "tr": "Herkesi sıcak ve <w>güler yüzlü</w> bir ifadeyle karşıladı.",
                                "es": "Saludó a todos con un rostro cálido y <w>sonriente</w>."
                            }
                        }
                    ],
