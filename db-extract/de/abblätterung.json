                "senses": [
                    {
                        "sense_id": "23464197-8daf-3b24-8da4-92ed05d56b09",
                        "entry_id": "9e19dbeb-35d2-38bc-b716-f1a15a1d9df9",
                        "glosses": [
                            "Ablösen von dünnen Schichten oder Teilen von etwas, zum Beispiel das Ablösen dünner Betonschichten durch Frost, Tausalzeinsatz oder ähnliche Einwirkungen oder das Ablösen von Gesteinsschichten oder -teilen durch Anhebungen oder Erosion"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7af48ee2-e8e6-3720-b522-4afd0ea07b3e",
                        "entry_id": "9e19dbeb-35d2-38bc-b716-f1a15a1d9df9",
                        "glosses": [
                            "Abfallen/Ablösen von Farbe, Lack, Putz oder ähnlichen Materialien von einer Oberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e2755fb-a32e-4d58-94f8-58936751f946",
                                "sense_id": "7af48ee2-e8e6-3720-b522-4afd0ea07b3e",
                                "text": "„Bei einer thermischen Überbeanspruchung durch einen Heißläufer oder eine dauernd angelegte Bremse verbrennt die Farbe unter deutlicher Rauchentwicklung. Im abgekühlten Zustand zeigen sich danach sichtbare Abblätterungen der Farbe.“"
                            },
                            {
                                "example_id": "e7de236e-ade8-46fc-87f0-c6a7472e3804",
                                "sense_id": "7af48ee2-e8e6-3720-b522-4afd0ea07b3e",
                                "text": "„Die Ausmalung war durch Abblätterung und Verblassen schadhaft geworden.“"
                            },
                            {
                                "example_id": "a4dd213d-ad11-4303-941e-c0ad76d4cfa2",
                                "sense_id": "7af48ee2-e8e6-3720-b522-4afd0ea07b3e",
                                "text": "„Er steht unter Denkmalschutz und wurde im Jahr 2003 saniert, da er Abblätterungen aufwies.“"
                            },
                            {
                                "example_id": "c64766ef-ade8-4a41-a076-fa65cd664a45",
                                "sense_id": "7af48ee2-e8e6-3720-b522-4afd0ea07b3e",
                                "text": "„Leonardo malte das Bild in Tempera auf eine getrocknete Gipswand (Seccomalerei), also weder als Fresko noch in Öl, wie spätere Legenden behauptet haben. Die Tempera-Trägersubstanz hielt nicht lange auf dem Gipsuntergrund und dieser auch nicht auf der Wand. Durch Feuchtigkeit und Schimmelbildung kam es zu Abblätterungen und Schuppenbildung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
