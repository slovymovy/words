                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0afdc1f-9142-4484-bfa0-e4e4e2ded01a",
                                "sense_id": "788b0647-3c01-326b-8a1e-6376b3518a92",
                                "text": "Een grafkist kon ze op internet uitzoeken, evenals een bloemstuk, passende teksten en het ontwerp van de rouwkaarten."
                            },
                            {
                                "example_id": "35770767-7bfa-49f5-84b2-e35a53fa76e0",
                                "sense_id": "788b0647-3c01-326b-8a1e-6376b3518a92",
                                "text": "Die zilveren medaille van Innsbruck ligt in zijn Noorse huis, zonder lint. Het lint is namelijk meegegaan in de grafkist van zijn moeder. Daags na de huldiging van Verkerk in het ouderlijk café in Puttershoek vond Verkerk zijn moeder levenloos in bed."
                            }
                        ]
                    }
