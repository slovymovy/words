                                        "entry_id": "ccfa4e44-248a-3e92-8ef1-25b7461e3b72",
                                        "glosses": [
                                            "Qui a plusieurs maris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012a5324-cd06-4579-984f-80bc7a4acddf",
                                                "sense_id": "b0bbcbaa-a51a-3bb9-8c15-13dce4dde5de",
                                                "text": "Chez certains oiseaux, comme l'accenteur mouchet, certaines femelles sont polyandres : elles s'établissent avec plusieurs mâles pour une saison de reproduction."
                                            }
                                        ]
