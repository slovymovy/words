                                            {
                                                "example_id": "144aaf61-d3d6-4720-8870-355d4640e0a9",
                                                "sense_id": "627a1565-711d-3742-82e0-15d171d5cb51",
                                                "text": "Consentement unanime. — Résolution unanime. — Les opinions furent unanimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                        "entry_id": "03cc9543-240c-30b9-9b57-6bae6434443e",
                                        "glosses": [
                                            "Qualifie les personnes qui sont en complet accord, qui ont le même sentiment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313bb1a2-4560-4379-98c4-55098335d9a2",
                                                "sense_id": "2837330d-aebc-306c-8438-49170700cf2e",
                                                "text": "Nous avons été unanimes sur cette question."
                                            }
                                        ]
