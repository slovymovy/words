                                "sense_id": "834fa918-0d12-356a-938e-ff7c4bced13a",
                                "text": "Morgen komt de kolenboer, sprak moeder, kan ik na afloop weer de hele trap dweilen!"
                            },
                            {
                                "example_id": "9a4540b7-778e-437c-84f7-e48501c05abc",
                                "sense_id": "834fa918-0d12-356a-938e-ff7c4bced13a",
                                "text": "Jan wou kolenboer worden maar kreeg te horen dat dit beroep geen toekomst meer heeft"
                            }
                        ]
