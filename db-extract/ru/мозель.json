                        "cross_references": [
                            {
                                "target_word": "moselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf58b0c3-cb88-3b51-ba2b-69d2299baa40",
                                        "entry_id": "5353795c-a975-3d09-aff6-69db7fe8c6c8",
                                        "glosses": [
                                            "Vin français de la région de Moselle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d761266-86ec-49f5-938c-4ed11d6e0895",
                                                "sense_id": "cf58b0c3-cb88-3b51-ba2b-69d2299baa40",
                                                "text": "– Tu ne vas pas prétendre que ton petit vin m’a tourné la tête !\n– Oh non ! C’est un petit moselle bien loyal."
                                            },
                                            {
                                                "example_id": "80762dfb-b8d6-4aa7-84e8-7bb7a90e9a55",
                                                "sense_id": "cf58b0c3-cb88-3b51-ba2b-69d2299baa40",
                                                "text": "« Deux gâteaux à la crème et des tartes aux prunes pour le chalet, ainsi que six vieilles bouteilles de Moselle. Gredel ira porter le tout en vélo. C’est pressé… »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
