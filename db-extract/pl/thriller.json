                ],
                "senses": [
                    {
                        "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                        "entry_id": "bab8413a-8ab0-3a7f-816d-12459603db90",
                        "glosses": [
                            "thriller (a suspenseful, sensational genre of story, book, play, film)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a4cc0e-fb40-4bce-80f5-ce90934573b2",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "Near-synonym: horror"
                            },
                            {
                                "example_id": "8a4a5665-ba14-4b1d-b3b7-ec59d9f9ee5e",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "thriller opowiada o czymś",
                                "translation": "thriller tells the story of something",
                                "english": "thriller tells the story of something"
                            },
                            {
                                "example_id": "a0ed6b18-a550-40b5-99dd-4bafd4b26aee",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "Jest to „thriller“ w całej rozciągłości i to z rozdaju kryminalno-awanturniczego,[…].",
                                "translation": "It is a “thriller” in its entirety and from the crime-avantage rift, […].",
                                "english": "It is a “thriller” in its entirety and from the crime-avantage rift, […]."
                            },
                            {
                                "example_id": "518d403d-6e12-458f-8ebd-563cfc305083",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "Horrory i thrillery cieszą się nieustającym powodzeniem u publiczności, która niezależnie od panującej aktualnie w kinie mody po prostu lubi się bać.",
                                "translation": "Horror movies and thrillers enjoy continued success with audiences who, regardless of the current fashion in cinema, simply like to be scared.",
                                "english": "Horror movies and thrillers enjoy continued success with audiences who, regardless of the current fashion in cinema, simply like to be scared."
                            },
                            {
                                "example_id": "0d03584a-1a01-46de-801c-6d2734d11042",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "Nowa książka amerykańskiej pisarki. Wielbiciele thrillerów psychologicznych zacierają ręce.",
                                "translation": "A new book by an American writer. Fans of psychological thrillers cherish.",
                                "english": "A new book by an American writer. Fans of psychological thrillers cherish."
                            },
                            {
                                "example_id": "2be99c73-0fd0-48bf-be74-3da3382e005f",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "„Niewidzialny” to anglojęzyczna wersja japońskiego thrillera, który opowiada o... pośmiertnych losach zamordowanego nastolatka.",
                                "translation": "“The Invisible” is an English-language version of a Japanese thriller, that tells the story of... the posthumous fate of a murdered teenager.",
                                "english": "“The Invisible” is an English-language version of a Japanese thriller, that tells the story of... the posthumous fate of a murdered teenager."
                            },
                            {
                                "example_id": "00b9e574-42c3-4d80-a9b6-7c302034dfa4",
                                "sense_id": "7605b1e4-c88d-34c4-8282-f898e369ee03",
                                "text": "Niskonakładowy[,] mroczny thriller science fiction osiągnął zaskakujący sukces i otworzył wrota kariery dla Arnolda Schwarzeneggera i Jamesa Camerona.",
                                "translation": "The low-budget[,] dark science fiction thriller was a surprising success and launched the careers of Arnold Schwarzenegger and James Cameron.",
                                "english": "The low-budget[,] dark science fiction thriller was a surprising success and launched the careers of Arnold Schwarzenegger and James Cameron."
                            }
                        ]
                    }
