                                "example_id": "d34f0c31-fdaf-4dfd-86d2-5729d3da3f8d",
                                "sense_id": "b9daf3f9-c462-357f-a308-5e0bda44ffa4",
                                "text": "Hij rijdt in een dennengroene auto."
