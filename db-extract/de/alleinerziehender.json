                                        "glosses": [
                                            "A parent who is the only guardian of offspring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "single parent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1c60f0-1c49-33cf-9115-66aaee067835",
                                        "entry_id": "c648d69c-770e-34f1-b87d-1f5652027cee",
                                        "glosses": [
                                            "To act as the only guardian of offspring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3267937d-1066-40c8-8887-99a0d03b692c",
                                                "sense_id": "bc1c60f0-1c49-33cf-9115-66aaee067835",
                                                "text": "My husband would, no doubt, be the slightest bit fatigued from having single-parented a precocious preschooler 24/7 for a week."
                                            },
                                            {
                                                "example_id": "c1068dd0-654f-4bf6-8f09-81738ecd618f",
                                                "sense_id": "bc1c60f0-1c49-33cf-9115-66aaee067835",
                                                "text": "My degrees and credentials are largely oriented to working with children and young adults in many different capacities. And I've single parented."
                                            },
                                            {
                                                "example_id": "e036aa6d-fed6-47c2-b245-0c13bfc931b8",
                                                "sense_id": "bc1c60f0-1c49-33cf-9115-66aaee067835",
                                                "text": "I was single parenting and imagined that if this man and I argued or fought there would be a good chance he would be believed, not me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
