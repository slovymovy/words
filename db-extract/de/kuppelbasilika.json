                "senses": [
                    {
                        "sense_id": "17e2f540-9635-3877-8e5d-d839c63d5404",
                        "entry_id": "3f6a966e-6ed4-3361-95b7-57351108906a",
                        "glosses": [
                            "ein byzantinischer Kirchentypus des frühen Mittelalters, der eine Synthese von Zentralbau und Basilika darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ea0c58-5db0-4bd9-9efb-df8dbe348e7e",
                                "sense_id": "17e2f540-9635-3877-8e5d-d839c63d5404",
                                "text": "Die bekannteste Kuppelbasilika ist die Hagia Sophia im heutigen Istanbul."
                            },
                            {
                                "example_id": "9a89e53b-f20d-4135-8048-747b681bfdee",
                                "sense_id": "17e2f540-9635-3877-8e5d-d839c63d5404",
                                "text": "Kaiser Justinian I ließ in den Jahren 532 bis 537 nach Christus die wichtigste byzantinische Kuppelbasilika in Konstantinopel […] anstelle einer gleichgroßen-5-schiffigen Basilika bauen;"
                            },
                            {
                                "example_id": "4acc1228-3de9-4658-ba1f-8454948401cb",
                                "sense_id": "17e2f540-9635-3877-8e5d-d839c63d5404",
                                "text": "Die Kuppelbasilika vereinigt in sich wesentliche Stil- und Strukturelemente der längs ausgerichteten Basilika und des überwölbten Zentralbaus."
                            }
                        ],
                        "sense_index_json": "\"1\""
