                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9900bc-8b29-470b-ba07-aa5277213dda",
                                                "sense_id": "c6d6eff6-6810-3437-b637-4cb4ec6603bc",
                                                "text": "À la carte également : du borsch au chou et betteraves, du tarama, des œufs de saumon, un millefeuille de crabe de Russie, un koulibiac de saumon, un bœuf Stroganoff et plusieurs variétés de zakouskis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62c6d723-46fc-4350-b45b-40bf2757bb9f",
                        "source_entry_id": "5d311f84-99cc-3490-85de-9bfc0ba0df75",
