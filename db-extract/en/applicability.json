                                "target_senses": [
                                    {
                                        "sense_id": "73451494-9bf4-34ba-a73f-90147bf623b7",
                                        "entry_id": "7d507125-1467-3354-a0c4-51bb3ee4aabb",
                                        "glosses": [
                                            "de mate waarin iets praktisch te gebruiken is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f2ecf9-ee8a-4192-8b1d-634cd2f6c3fe",
                                                "sense_id": "73451494-9bf4-34ba-a73f-90147bf623b7",
                                                "text": "De Inspectie Gezondheidszorg en Jeugd en het College ter Beoordeling van Geneesmiddelen onderzoeken op dit moment of het mogelijk is om veterinaire geneesmiddelen in te zetten en of dit voldoende veilig kan. Veterinaire geneesmiddelen worden volgens dezelfde kwaliteitsstandaarden gemaakt als geneesmiddelen voor humane toepassing. Omdat ze mogelijk een andere sterkte en toedieningsvorm hebben onderzoeken we de toepasbaarheid bij mensen."
                                            },
                                            {
                                                "example_id": "d6caa9a4-7115-4f3a-87ee-750122d11768",
                                                "sense_id": "73451494-9bf4-34ba-a73f-90147bf623b7",
                                                "text": "De OPEC en Noorwegen, dat ook veel olie exporteert, vinden dat het rapport positiever moet schrijven over de mogelijkheden om CO2 ondergronds op te slaan. In de eerste versie wordt die techniek genoemd, maar de schrijvers merken meteen op dat er nog onzekerheden zijn over de toepasbaarheid ervan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2f941a-37f2-3ae7-8397-0477c985fd32",
                                        "entry_id": "7d507125-1467-3354-a0c4-51bb3ee4aabb",
                                        "glosses": [
                                            "iets dat praktisch te gebruiken is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79085bae-b34a-4fee-addc-bbab96180cd3",
                        "source_entry_id": "ef2cdab4-273a-3d9c-9dc3-ef767dc3d29c",
                        "source_sense_id": "3b871f12-59ed-3805-a2ed-6936341e731e",
                        "source_sense_description": "relevancy",
                        "target_lang_word": "Anwendbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwendbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                        "entry_id": "d3f4a65d-d31f-39ad-82f5-8a30bef9c948",
                                        "glosses": [
                                            "Möglichkeit, zielführend verwendet zu werden/werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c56bd18-02dc-4326-8e0b-2899fd32b156",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Da über die Anwendbarkeit dieses Düngmittels wohl kein Zweifel mehr bestehen kann, so kommt es darauf an, zu zeigen, welche Pflanzen sich am besten hiezu eignen, welchem Boden die verschiedenen Arten am meisten zusagen, wann sie gesät und untergepflügt, und endlich wie sie behandelt werden müssen.“"
                                            },
                                            {
                                                "example_id": "fa115535-37b3-46b5-92d5-3ea0f945b5cd",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Das Verfassungsgericht hat die vorläufige Anwendbarkeit von Ceta unter Auflage gebilligt.“"
                                            },
                                            {
                                                "example_id": "89e520a7-412e-48ab-8ab4-7520c6fb0131",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„In der Folge wurde die Anwendbarkeit dieser ausgewählten EProcurement-Tools für die elektronische Vergabe solcher Aufträge hinsichtlich rechtlicher, organisatorischer, technischer und ökonomischer Anforderungen untersucht.“"
                                            },
                                            {
                                                "example_id": "7ac53858-09df-4189-89df-15e5970a942b",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Ich fand die Anwendbarkeit der Kontrastbetonung auf alle möglichen Lebensbereiche äußerst amüsant und erhellend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c71b5c6b-978b-45e3-9d7b-55b06bd3ba64",
                        "source_entry_id": "ef2cdab4-273a-3d9c-9dc3-ef767dc3d29c",
                        "source_sense_id": "3b871f12-59ed-3805-a2ed-6936341e731e",
