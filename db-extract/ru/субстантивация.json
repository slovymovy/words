                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf8ac8f9-8d53-49f1-8f82-8aa89d048020",
                        "source_entry_id": "4b8f4f58-1b52-3d8a-b15c-dbe3f85a51e0",
                        "source_sense_id": "d693ad45-96d7-36a9-bf59-81baf8ae4fd8",
                        "target_lang_word": "Substantivierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Substantivierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                        "entry_id": "fc2e9368-9e69-3732-ba77-81c037548474",
                                        "glosses": [
                                            "Ableitung eines Substantivs aus einer anderen Wortart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11c0ca5-e1f8-4308-a662-96b0c334b14e",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "Substantivierung ist die Substantivierung von „substantivieren“."
                                            },
                                            {
                                                "example_id": "6802c96c-fbe7-4ae7-b488-fc8f05316bcb",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "Substantivierung ist auch bei anderen Wortarten als Verben möglich: ein „Mehr“ an Verantwortung; das „Du“ anbieten."
                                            },
                                            {
                                                "example_id": "7fb8cef2-d449-4de7-8150-495161235390",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "„Den meisten europäischen Sprachen scheint die Substantivierung von Farbadjektiven geläufig zu sein […]“"
                                            },
                                            {
                                                "example_id": "6a5c03ff-42e8-4207-9661-e1d9e4b84f7f",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "„Der rationale Kern, aber auch das Überzogene an der Kritik Wustmanns wie überhaupt das Problem der Substantivierungen im Deutschen ist inzwischen vielfältig in der Fachliteratur behandelt worden.“"
                                            },
                                            {
                                                "example_id": "0b401f35-cb5c-4b34-afc4-da32059ba17d",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "„Wir schließen uns dieser Redeweise nicht an, sondern bleiben dabei, daß Substantivierungen abgeleitete Substantive sind, gleichgültig, mit welchen Mitteln die Ableitung erfolgt. Entsprechendes gilt für Adjektivierungen und Verbalisierungen.“"
                                            },
                                            {
                                                "example_id": "38d67858-2b34-4a22-a87a-54a11ac67dcd",
                                                "sense_id": "03902fe1-a55f-3fc5-bc44-5650fe9c754d",
                                                "text": "„Sie reiht eine Substantivierung an die andere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "396c19fe-2aa5-4833-9959-3a2f7f982ae5",
