                "senses": [
                    {
                        "sense_id": "fd06dd2b-3e46-325b-977f-93db49bef37f",
                        "entry_id": "e9efe7d4-8cef-3ccf-9f16-d7101ab7ff70",
                        "glosses": [
                            "Organe de plusieurs tonnes, très riche en lipides, situé dans le crâne des cachalots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3d2398-8d58-48fb-b046-99d1c2e8ce25",
                                "sense_id": "fd06dd2b-3e46-325b-977f-93db49bef37f",
                                "text": "Peu fourni en graisse et sans fanon – le cachalot est un odontocète, une baleine à dents, qui intéressait l’industrie baleinière pour son spermaceti. Il s’agit d’une substance blanche, semi-liquide, cireuse, extraite d’une poche géante située au-dessus de la tête ; un mâle adulte qui pèse entre 30 et 40 tonnes peut en accumuler jusqu’à 5 tonnes."
                            },
                            {
                                "example_id": "acc540e0-49d2-4819-a4f8-8284ecf366e5",
                                "sense_id": "fd06dd2b-3e46-325b-977f-93db49bef37f",
                                "text": "À mesure que le cachalot s’enfonce dans les profondeurs pour chasser, la température diminue et fait cristalliser les lipides du spermaceti."
                            }
                        ]
                    }
                ],
