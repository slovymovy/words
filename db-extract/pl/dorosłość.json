                                                "sense_id": "e5276445-6020-3466-a818-ff2d182be251",
                                                "text": "Meronyms: young adulthood; emerging adulthood (sometimes construed as coordinate)"
                                            },
                                            {
                                                "example_id": "e1d68248-8350-411d-a3a3-4d56da41b252",
                                                "sense_id": "e5276445-6020-3466-a818-ff2d182be251",
                                                "text": "Adulthood enables us to survive in the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                        "entry_id": "95a66ac8-c2ac-360e-9ec4-c04f9765226d",
                                        "glosses": [
                                            "The time period of a person's majority, following puberty and lasting until death."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d8e76f-b8d4-49ce-913c-b514b499de90",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "Meronyms: young adulthood; emerging adulthood (sometimes construed as coordinate)"
                                            },
                                            {
                                                "example_id": "cb1cbf3e-11c7-41cd-9b68-1de9694bf568",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "The boy entered adulthood by undergoing a rite of passage."
                                            },
                                            {
                                                "example_id": "da92da1c-bf27-4c1d-b9a3-285e1902796c",
                                                "sense_id": "6d009dc3-8071-33d7-bd04-288d743302f8",
                                                "text": "The things learned in childhood affect us throughout our adulthood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
