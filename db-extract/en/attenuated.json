                "senses": [
                    {
                        "sense_id": "11d92168-9837-3c70-8581-082d21fa3bae",
                        "entry_id": "6c1c6733-0322-30e9-a9a5-2ea2c8e633f7",
                        "glosses": [
                            "Made, or become weak; subject to attenuation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f42d400-ab52-44fd-b441-8ca840c5f00d",
                                "sense_id": "11d92168-9837-3c70-8581-082d21fa3bae",
                                "text": "attenuated power"
                            },
                            {
                                "example_id": "bd256f7d-0e6d-402f-8846-042be627c7d2",
                                "sense_id": "11d92168-9837-3c70-8581-082d21fa3bae",
                                "text": "He had his tea and hot rolls in a morning, while we were battening upon our quarter of a penny loaf—our crug—moistened with attenuated small beer, in wooden piggins, smacking of the pitched leathern jack it was poured from."
                            },
                            {
                                "example_id": "478aa732-8234-402f-ae2b-1dd0900860e5",
                                "sense_id": "11d92168-9837-3c70-8581-082d21fa3bae",
                                "text": "She had become spiritualized in mind, even as she had grown attenuated in person."
                            },
                            {
                                "example_id": "a3f49ea2-5d1f-4f1a-a72e-065447377303",
                                "sense_id": "11d92168-9837-3c70-8581-082d21fa3bae",
                                "text": "To conclude otherwise requires accepting an attenuated fiction that commingling funds in an account, even if done decades earlier, means the account today still contains funds attributable to the sale of expropriated property."
                            }
                        ]
                    },
                    {
                        "sense_id": "404a6b95-f38d-3272-b510-8afece9046ff",
                        "entry_id": "6c1c6733-0322-30e9-a9a5-2ea2c8e633f7",
                        "glosses": [
                            "Made, or become weak; subject to attenuation.",
                            "Weakened, usually in a way that includes nonreplicating status."
                        ],
                        "tags": [
                            "of pathogens"
                        ],
                        "examples": [
                            {
                                "example_id": "db307af3-409f-41dd-aef5-26353f221294",
                                "sense_id": "404a6b95-f38d-3272-b510-8afece9046ff",
                                "text": "Near-synonym: nonreplicating (often synonymous)"
                            },
                            {
                                "example_id": "fa3fceba-5810-4378-85b0-999f4a5af1f1",
                                "sense_id": "404a6b95-f38d-3272-b510-8afece9046ff",
                                "text": "the live attenuated type of vaccines"
                            }
                        ]
                    },
