                        "entry_id": "dea8b2f3-77cc-38bb-a490-41e13bc8080b",
                        "glosses": [
                            "Qualifie un remède qui cicatrise les plaies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffca6ddc-6210-4ab3-9136-bb60408271d7",
                                "sense_id": "60f3ccd2-6794-3847-90db-590bade0f21e",
                                "text": "Les vertus cicatrisantes et hémostatiques de cette drogue sont bien réelles compte-tenu de sa richesse en allantoïde."
                            },
                            {
                                "example_id": "4af32bbd-97f2-4b3f-9b86-4fc256f03a81",
                                "sense_id": "60f3ccd2-6794-3847-90db-590bade0f21e",
                                "text": "Le premier met une raclée au second, qui profite d’un temps mort pour tartiner ses gants de crème cicatrisante."
                            }
                        ]
                    }
                ],
