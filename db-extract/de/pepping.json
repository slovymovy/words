                "senses": [
                    {
                        "sense_id": "f129eba7-d4cb-3da9-8ee9-9706641b7868",
                        "entry_id": "43cd82c4-e9c6-3a3e-b088-f877ee40713e",
                        "glosses": [
                            "Angehöriger einer Gruppe von Apfelsorten, zum Beispiel Newton Pepping, Ribston Pepping, London Pepping"
                        ],
                        "tags": [
                            "Pomologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b6075f3c-295c-4b48-9400-d036cc1b121c",
                                "sense_id": "f129eba7-d4cb-3da9-8ee9-9706641b7868",
                                "text": "Der Baum wächst wie alle Peppinge nicht stark, erreicht nur eine mittelmäßige Größe, ist aber schon frühzeitig und recht tragbar."
                            },
                            {
                                "example_id": "96f4732a-23f3-4c6b-97d8-ac007ccdd5af",
                                "sense_id": "f129eba7-d4cb-3da9-8ee9-9706641b7868",
                                "text": "Die goldigen Früchte sind eine Zierde für jeden Garten, gerade die in Massen am Baume sitzenden Peppinge lachen einen förmlich an."
                            },
                            {
                                "example_id": "718c5ca7-cb95-4c2b-8dda-b3aa9b38310f",
                                "sense_id": "f129eba7-d4cb-3da9-8ee9-9706641b7868",
                                "text": "Wahrscheinlich eine deutsche Kernfrucht, und gehört in die Familie der Peppinge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
