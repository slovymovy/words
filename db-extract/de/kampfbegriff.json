                    }
                ],
                "senses": [
                    {
                        "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                        "entry_id": "9d307781-3dc3-31a4-af28-54834fc7ce53",
                        "glosses": [
                            "ein Reizwort, das die Gegner in der politischen, gesellschaftlichen oder gewerkschaftlichen Auseinandersetzung provozieren und die Zuhörer für den eigenen Standpunkt einnehmen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "510e190c-ff90-4121-81b4-2290a792e073",
                                "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                                "text": "Heute ist Multikulturalismus zu einem negativen Kampfbegriff geworden: Er steht für eine verfehlte Einwanderungs- und Integrationspolitik."
                            },
                            {
                                "example_id": "bb738b77-6a9a-4e75-b2c5-9636cdd9037c",
                                "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                                "text": "Unserer Meinung nach ist \"Extremismus\" ein Kampfbegriff."
                            },
                            {
                                "example_id": "2964135d-7792-4f84-8a69-5e6f95f454f0",
                                "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                                "text": "Die Häme über den guten Menschen beginnt bei Nietzsche, der Neologismus stammt aus dem Stürmer, Kampfbegriff ist er für die Neue Rechte, und salonfähig wurde er durch die 68er-Kritik im Stil von Klaus Bittermanns Wörterbuch des Gutmenschen."
                            },
                            {
                                "example_id": "7a8ab32e-88c8-4eeb-9fe3-a21283e8fb1c",
                                "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                                "text": "Das Copyright ist drauf und dran, zum schillernden Kampfbegriff des neuen Jahrhunderts zu werden."
                            },
                            {
                                "example_id": "91072d69-f5db-4a0c-ac16-e9534306ebd3",
                                "sense_id": "a781fd4b-49c7-3c8c-a06a-ccee8ca7c6bb",
                                "text": "Denn auch das Schlagwort „kapitalistisch“ ist ja bereits ein Kampfbegriff der Sozialisten, die dann ganz harmlos den „dritten Weg“ fordern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
