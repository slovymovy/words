                ],
                "senses": [
                    {
                        "sense_id": "5911dc48-dd98-34b0-b864-56b3abd556a1",
                        "entry_id": "0bf53f2b-58cd-37db-8eae-f72517006734",
                        "glosses": [
                            "eigenhändig destilliert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1727025-9323-4bc4-86e4-53b295f2bd16",
                                "sense_id": "5911dc48-dd98-34b0-b864-56b3abd556a1",
                                "text": "„Und sie versinken im dunklen Gewühl, der qualmige Saal ein Niemandsland voller gefährlich aussehender Säufer, die mit blutunterlaufenen Augen umhertaumeln und nach selbstgebranntem Whiskey dünsten.“"
                            },
                            {
                                "example_id": "ba7c2bcb-5c0f-410b-96b0-40f9d06aeefb",
                                "sense_id": "5911dc48-dd98-34b0-b864-56b3abd556a1",
                                "text": "„Er hatte scharfen, selbstgebrannten Schnaps dabei, den er ein wenig mit Orangensaft verdünnt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
