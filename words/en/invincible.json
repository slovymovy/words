{
    "word_family": [
        "invincibility",
        "invincibly",
        "vincible",
        "vincibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c86d3442-6aef-3f9b-adae-50e4a25ddc1d",
                    "sense_definition": "Impossible to defeat, destroy, or kill; too powerful to be overcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unbeatable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion athlete felt <w>invincible</w> after winning ten consecutive matches without losing a single set.",
                            "target_lang_translations": {
                                "ru": "Чемпион чувствовал себя <w>непобедимым</w> после десяти побед подряд без единого проигранного сета."
                            }
                        },
                        {
                            "text": "Despite their small size, the army believed they were an <w>invincible</w> force because of their superior strategy.",
                            "target_lang_translations": {
                                "ru": "Несмотря на малую численность, армия верила, что она — <w>непобедимая</w> сила благодаря превосходной стратегии."
                            }
                        }
                    ],
                    "synonyms": [
                        "unconquerable",
                        "undefeatable",
                        "unvanquishable"
                    ],
                    "antonyms": [
                        "conquerable",
                        "defeatable",
                        "vincible",
                        "weak",
                        "vanquishable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кого невозможно победить, уничтожить или убить; слишком могущественный, чтобы быть поверженным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непобедимый",
                                "target_lang_sense_clarification": "о человеке, армии или силе"
                            },
                            {
                                "target_lang_word": "несокрушимый",
                                "target_lang_sense_clarification": "о силе или духе"
                            },
                            {
                                "target_lang_word": "неуязвимый",
                                "target_lang_sense_clarification": "о защите или позиции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62be7bd6-8def-3b21-913e-083a81751a92",
                    "sense_definition": "Someone or something that cannot be defeated, destroyed, or killed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unbeatable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the legends of old, the hero was considered one of the <w>invincibles</w> who could never be harmed in battle.",
                            "target_lang_translations": {
                                "ru": "В древних легендах герой считался одним из <w>неуязвимых</w>, кому в бою невозможно было нанести вред."
                            }
                        },
                        {
                            "text": "The team was known as the <w>invincibles</w> after completing the entire season without a single loss.",
                            "target_lang_translations": {
                                "ru": "Команду прозвали «<w>непобедимыми</w>» после того, как они завершили весь сезон без единого поражения."
                            }
                        }
                    ],
                    "antonyms": [
                        "vincible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто или то, что не может быть побеждено, уничтожено или убито."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непобедимый",
                                "target_lang_sense_clarification": "субъект, которого невозможно одолеть"
                            },
                            {
                                "target_lang_word": "неуязвимый",
                                "target_lang_sense_clarification": "тот, кому невозможно причинить вред"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
