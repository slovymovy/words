                        "form": "ruzzes"
                    },
                    {
                        "form_id": "c743978b-5cdd-4e4c-866f-296e8ad9defe",
                        "entry_id": "bfa00606-16d1-3828-ae08-cc9a91cb5a68",
                        "tags": [
                            "Plus courant"
                        ],
                        "form": "ruZZe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2e5daa5-5048-38e7-9442-e64bfcc42412",
                        "entry_id": "bfa00606-16d1-3828-ae08-cc9a91cb5a68",
                        "glosses": [
                            "Relatif à la Ruzzie, qui est russe."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "27a3f1de-4d60-47d0-a077-d81ced0edc84",
                                "sense_id": "a2e5daa5-5048-38e7-9442-e64bfcc42412",
                                "text": "C’est complètement débil comme raisonnement ! Quel rapport d’être contre l’invasion ruzze et l’agriculture française ???!"
                            },
                            {
                                "example_id": "e76cd8c4-eb75-4413-8591-27d0ab54ccee",
                                "sense_id": "a2e5daa5-5048-38e7-9442-e64bfcc42412",
                                "text": "Et encore, nous considérons des équipages formés comme une grande valeur qu’il faut protéger, prioritaire sur le char.\nCôté ruzze les officiers semblent avoir la trouille que leurs soldat se mettent à réfléchir.\nC’est pas la même culture 😁"
                            },
                            {
                                "example_id": "d5309341-449f-4eee-b43b-9db63d132080",
                                "sense_id": "a2e5daa5-5048-38e7-9442-e64bfcc42412",
                                "text": "Rochebin est somme toute plus que complaisant avec le régime Ruzze..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c0997f-5a30-498c-8308-feb36d937a69",
                        "source_entry_id": "bfa00606-16d1-3828-ae08-cc9a91cb5a68",
                        "source_sense_id": "a2e5daa5-5048-38e7-9442-e64bfcc42412",
                        "target_lang_word": "Ruzzian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruzzian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acaff796-af35-3647-ba18-3ff9309adae6",
                                        "entry_id": "728fb5f3-2957-3ec5-9fce-c606c9d37675",
                                        "glosses": [
                                            "Alternative spelling of Russian."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "derogatory",
                                            "neologism",
                                            "not-comparable",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd025469-4508-4991-a8a7-d959fd237870",
                                                "sense_id": "acaff796-af35-3647-ba18-3ff9309adae6",
                                                "text": "One individual shared the clip via Twitter and said: \"Wow Ruzzian state TV... Gets real\"."
                                            },
                                            {
                                                "example_id": "ce1d15b5-1b98-41d4-affa-930b509b310c",
                                                "sense_id": "acaff796-af35-3647-ba18-3ff9309adae6",
                                                "text": "Anton got custom lettering for the bumper of one of his cars: \"Collector of corpses of Ruzzian soldiers.\""
                                            },
                                            {
                                                "example_id": "0bc97977-b14a-4050-835e-e17a7ee69736",
                                                "sense_id": "acaff796-af35-3647-ba18-3ff9309adae6",
                                                "text": "However, at one rally in Washington D.C., police restrained a woman who spat twice at officers, with a video of the \"Ruzzian Karen\", as she was quickly dubbed by social media users, going viral."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ruzzian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03d175f-bdc9-3905-8aac-4d7f024e20ba",
                                        "entry_id": "bf2285a9-661c-35af-9d3e-158c230d88d1",
                                        "glosses": [
                                            "Alternative spelling of Russian."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "derogatory",
                                            "neologism",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27618e7c-b887-49a9-83bd-602700eb47ab",
                                                "sense_id": "f03d175f-bdc9-3905-8aac-4d7f024e20ba",
                                                "text": "Oh, God! To sound more RUZZIAN: it was exactly for Russiastan who had divided the world for two camps: for those who always support Putler and the rest – Nazzies, of course, according to Ruzzians. What personal opinion can you have if you’ve already been brainwashed to thank your Fuhrer for everything?"
                                            },
                                            {
                                                "example_id": "2d80e1a3-aed6-4f2b-b282-848e90075a00",
                                                "sense_id": "f03d175f-bdc9-3905-8aac-4d7f024e20ba",
                                                "text": "\"Ruzzians tried to hide some ammo in the forest but something went wrong. Belgorod. Filmed by drone with thermal camera,\" the user wrote while sharing the post."
                                            },
                                            {
                                                "example_id": "542936f1-c92f-4695-a645-c9a6a597eefd",
                                                "sense_id": "f03d175f-bdc9-3905-8aac-4d7f024e20ba",
                                                "text": "Ha Ha, ruZZians fleeing to Dan Christensens big foot home:"
                                            },
                                            {
                                                "example_id": "dfb3c33f-e563-4e31-9189-675eb4b92ccf",
                                                "sense_id": "f03d175f-bdc9-3905-8aac-4d7f024e20ba",
                                                "text": "Not to mention her association with Ruzzians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c23c5b4-9b47-4dd5-86b5-32c5594370f1",
                        "source_entry_id": "bfa00606-16d1-3828-ae08-cc9a91cb5a68",
