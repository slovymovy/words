                    {
                        "sense_id": "bbeca5cb-c656-3618-807e-90cbbb424e00",
                        "entry_id": "730f07f1-1d04-3ec1-b2d8-4125dc9e0825",
                        "glosses": [
                            "Viscum album halfparasiet die op een appel-, perenboom of populier kan groeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f2f5aa-7d36-476b-aee8-3055b0ac96ec",
                                "sense_id": "bbeca5cb-c656-3618-807e-90cbbb424e00",
                                "text": "Zelfs bracht Sipkes de maretak of vogellijm naar Voorne, dat dankzij de zwarte lijster en het milde zeeklimaat nu de noordelijkste groeiplaats van de halfparasiet is."
                            }
                        ]
                    },
                    {
                        "sense_id": "a63d3528-89c5-3a70-88b9-18bcce1aaec1",
                        "entry_id": "730f07f1-1d04-3ec1-b2d8-4125dc9e0825",
                        "glosses": [
                            "lijm die men gebruikt om vogels te vangen afkomstig van de maretak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3791e5-d9d1-419a-a9da-a7e9a94724f2",
                                "sense_id": "a63d3528-89c5-3a70-88b9-18bcce1aaec1",
                                "text": "Sijzen zijn beschermde inheemse vogels, die niet mogen worden gevangen. De wilde sijzen zijn vrijgelaten, de goudvink en de putter zitten in een opvangcentrum. Tegen de verdachte is proces-verbaal opgemaakt. Kooien en een tube vogellijm zijn in beslag genomen."
                            }
                        ]
                    }
