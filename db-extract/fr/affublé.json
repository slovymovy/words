                                "text": "Affublé d’une robe."
                            },
                            {
                                "example_id": "ebd0bf95-07f2-4b16-b21f-68d9d9916250",
                                "sense_id": "e5a40862-9caf-346a-9a4d-a6c0b514d97a",
