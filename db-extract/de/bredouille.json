                "senses": [
                    {
                        "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                        "entry_id": "2d1ad509-4c40-3f45-94c9-c1463f5a07eb",
                        "glosses": [
                            "für Verlegenheit, Schwierigkeiten, Bedrängnis; Einengungen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "324ab9c3-d493-4d00-bd6e-f3f3354fe3a0",
                                "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                                "text": "Da war ich ganz schön in der Bredouille."
                            },
                            {
                                "example_id": "bbcc160f-7e6a-487a-aeb3-f05cf64e8386",
                                "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                                "text": "„Eine Aussage, die … nun schwer in die Bredouille bringen könnte…“"
                            },
                            {
                                "example_id": "af90cc04-c7fb-4b2b-b009-2d8488757237",
                                "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                                "text": "„Ohne dieses frische Geld würden die Landesbanken schnell in die Bredouille geraten.“"
                            },
                            {
                                "example_id": "a20f80be-67df-493c-833c-e4fa9943c618",
                                "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                                "text": "„Es war leicht zu sehen, weshalb Grovers in der Bredouille war.“"
                            },
                            {
                                "example_id": "b6b661ca-61cd-4a65-a643-5df3d51c11b1",
                                "sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                                "text": "„Josephson mühte sich noch mit seiner Waffe, als Roth an ihm vorbei hinausrannte, und er wäre wohl in die Bredouille geraten, wenn ihm nicht »einer von den handfesteren Jungs« geholfen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3906d506-45b4-414e-bde2-3c6b4504da75",
                        "source_entry_id": "2d1ad509-4c40-3f45-94c9-c1463f5a07eb",
                        "source_sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                        "source_sense_description": "Verlegenheit, Schwierigkeiten, Bedrängnis",
                        "target_lang_word": "pétrin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63017427-d15b-3025-aa3f-9313ad06cd01",
                                        "entry_id": "06a9e729-e4d0-3b88-bffe-9f80e910aac3",
                                        "glosses": [
                                            "Coffre ou machine dans lesquels on pétrit le pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d82174d-6085-406f-a905-96d43cb6d5b2",
                                                "sense_id": "63017427-d15b-3025-aa3f-9313ad06cd01",
                                                "text": "Dans un coffre en bois de chêne, appelé pétrin, on introduit la quantité de farine que l’on veut convertir en pain, en l’écartant sur les bords, puis on délaye au milieu le levain avec de l’eau chaude et une partie de la farine."
                                            },
                                            {
                                                "example_id": "fc64455b-9a3d-466b-8f67-446273a5dae5",
                                                "sense_id": "63017427-d15b-3025-aa3f-9313ad06cd01",
                                                "text": "Les hommes, y disait-on, ne valent pas mieux que la pâte que tourne et retourne dans le pétrin, la main de la ménagère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a055f310-eb2f-3998-8267-397423240163",
                                        "entry_id": "06a9e729-e4d0-3b88-bffe-9f80e910aac3",
                                        "glosses": [
                                            "Embarras, gêne, dénuement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da6e207-1228-48cd-8a01-f93bd6ee6bc2",
                                                "sense_id": "a055f310-eb2f-3998-8267-397423240163",
                                                "text": "Je vois la douce Mme Favoral et sa fille, si modeste, dans un drôle de pétrin."
                                            },
                                            {
                                                "example_id": "01c2c0f9-66ce-4d10-add0-3a37ed75c992",
                                                "sense_id": "a055f310-eb2f-3998-8267-397423240163",
                                                "text": "Eh bien, ma pauvre femme, tu nous as foutus dans un joli pétrin… Et ce n’est pas toi qui nous en sortiras."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11bff2e5-50a4-46e1-a126-b869c7933848",
                        "source_entry_id": "2d1ad509-4c40-3f45-94c9-c1463f5a07eb",
                        "source_sense_id": "a84f9f69-91aa-371b-8da5-edff8951af48",
                        "source_sense_description": "Verlegenheit, Schwierigkeiten, Bedrängnis",
                        "target_lang_word": "difficulté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "difficulté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f409a08-e413-3be4-b386-3374d4eff0bd",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Ce qui rend une chose difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2210123-4564-486a-a5bb-eb8e1e7152fe",
                                                "sense_id": "7f409a08-e413-3be4-b386-3374d4eff0bd",
                                                "text": "[…], il était inutile de nous adresser au ministère où nous aurions, sans doute, les plus grandes difficultés à nous faire expliquer comment, pour la Gironde, on avait trouvé cette somme de 4.950 francs par kilomètre de routes nationales à départementaliser."
                                            },
                                            {
                                                "example_id": "e8793ae5-848d-4c29-82ed-64b59b136348",
                                                "sense_id": "7f409a08-e413-3be4-b386-3374d4eff0bd",
                                                "text": "La difficulté d’une opération."
                                            },
                                            {
                                                "example_id": "be6ade55-492f-4a0b-b623-c459baa32483",
                                                "sense_id": "7f409a08-e413-3be4-b386-3374d4eff0bd",
                                                "text": "La difficulté des chemins, des passages."
                                            },
                                            {
                                                "example_id": "73ed8ee3-b43b-47f2-89a3-b7b5319d7a79",
                                                "sense_id": "7f409a08-e413-3be4-b386-3374d4eff0bd",
                                                "text": "Ce travail est pour lui sans difficulté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c8faa4-7793-37af-ac30-cf2fb6967271",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Manque de facilité pour quelque action que ce soit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162a2025-f3bd-4664-82dd-6e3afc642485",
                                                "sense_id": "f1c8faa4-7793-37af-ac30-cf2fb6967271",
                                                "text": "Dans ce cauchemar, je ne séparais plus qu’avec difficulté les menaces qu’il fallait prendre au sérieux, du chantage gratuit."
                                            },
                                            {
                                                "example_id": "b69beb48-a6db-4fa1-a03e-60aea56de1f4",
                                                "sense_id": "f1c8faa4-7793-37af-ac30-cf2fb6967271",
                                                "text": "Le général était podagre depuis longtemps et ne pouvait se déplacer qu'avec d'extrêmes difficultés ; aussi se faisait-il porter par ses soldats."
                                            },
                                            {
                                                "example_id": "a4332eb6-0767-4c51-ba83-bf8366f7799f",
                                                "sense_id": "f1c8faa4-7793-37af-ac30-cf2fb6967271",
                                                "text": "À cause des obstacles de chaque côté de la grand-route, il éprouva des difficultés à faire tourner ses chars et half-tracks pour les lancer à l'attaque."
                                            },
                                            {
                                                "example_id": "394b6f1e-86a3-4176-b4e1-73f7e79d8ae8",
                                                "sense_id": "f1c8faa4-7793-37af-ac30-cf2fb6967271",
                                                "text": "Il résume ses deux grandes difficultés actuelles: « J'ai de la difficulté à m’intégrer. J'ai de la misère à approcher les filles. […] J'ai appris une façon de les approcher, mais je ne sais pas si c'est la meilleure. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2254e912-d4f9-3518-ba29-20df35c0e07d",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Misère."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00562ec2-2073-44d0-944a-8db609d9b15f",
                                                "sense_id": "2254e912-d4f9-3518-ba29-20df35c0e07d",
                                                "text": "Les difficultés, les mécomptes, les conséquences de la guerre et de la révolution même se font sentir de plus en plus vivement."
                                            },
                                            {
                                                "example_id": "612d4bff-1048-4357-8c71-cdc6c3eb9a9c",
                                                "sense_id": "2254e912-d4f9-3518-ba29-20df35c0e07d",
                                                "text": "La période du travail au laboratoire fut marquée de grandes privations et de difficultés dans la vie familiale de Pavlov ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Ce qu’il y a de difficile en quelque chose, obstacle, empêchement, traverse, opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e396562a-a803-414f-881b-22d1b6afb73c",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "Si un vol facile, même de longue durée, peut enchanter, donner au pilote l’impression qu’il est un être supraterrestre, la difficulté aiguise l’énergie, accroît la volonté et accorde dans la lutte des satisfactions innombrables et dans la victoire un enivrement qui pousse à croire que l’homme est tout-puissant devant les éléments déchaînés."
                                            },
                                            {
                                                "example_id": "749f6cb2-c429-4122-a66d-bdb653b7f86e",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "Cette affaire est pleine, est hérissée de difficultés."
                                            },
                                            {
                                                "example_id": "2fc917e2-9293-4cc1-90fd-97f38d5afae5",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "Surmonter, vaincre, toutes sortes de difficultés."
                                            },
                                            {
                                                "example_id": "15aef472-a9dd-4ad4-b687-bd6d0882e8a8",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "Examiner, lever, résoudre une difficulté."
                                            },
                                            {
                                                "example_id": "6175c030-dc6a-46f2-a169-9eafa3d86d34",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "— Faire des difficultés. — Elle ne se décida qu’après avoir fait beaucoup de difficultés."
                                            },
                                            {
                                                "example_id": "054656ff-2ed6-4065-8045-cc8c70b0899f",
                                                "sense_id": "0ff11e1d-184e-35e3-9585-1d1fa76ca5dd",
                                                "text": "Cela peut rencontrer, souffrir quelque difficulté, de grandes difficultés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4399c9e2-35e1-36e3-a800-92de99d2b43f",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Pour marquer l’adhésion, le consentement."
                                        ],
                                        "tags": [
                                            "Par antiphrase"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df811a7-85bc-4e07-b480-972fb684653d",
                                                "sense_id": "4399c9e2-35e1-36e3-a800-92de99d2b43f",
                                                "text": "Cela ne fait aucune difficulté."
                                            },
                                            {
                                                "example_id": "ec37c1fd-ad69-4d28-bc64-03d3453deff0",
                                                "sense_id": "4399c9e2-35e1-36e3-a800-92de99d2b43f",
                                                "text": "Je n’y vois pas de difficulté."
                                            },
                                            {
                                                "example_id": "98f8d3c5-e900-4d9d-b1cd-0065ee298991",
                                                "sense_id": "4399c9e2-35e1-36e3-a800-92de99d2b43f",
                                                "text": "Il n’y a pas de difficulté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae41520-a2d0-33c3-878c-a088b54c6c46",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Obscurité d’un texte, passage difficile à comprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b3a523-0e94-44bb-bdc1-602fe0d3546e",
                                                "sense_id": "bae41520-a2d0-33c3-878c-a088b54c6c46",
                                                "text": "La pensée bourgeoise dit toujours au Peuple : « Croyez-moi sur parole ; ce que je vous annonce est vrai. Tous les penseurs que je nourris ont travaillé pour vous. Vous n’êtes pas en état de repenser toutes leurs difficultés, […]. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e545a0-4b27-3c1e-9412-f3fcfc59255f",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Morceaux de musique d’une exécution difficile."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69442dc-1485-4479-9515-a79a1b43df64",
                                                "sense_id": "b5e545a0-4b27-3c1e-9412-f3fcfc59255f",
                                                "text": "Les difficultés d’une sonate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9034a79-4fe5-3dcc-85e2-905c4adb29b3",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Objection, raison alléguée contre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddffff7-9d30-4634-8f44-c8629c908e14",
                                                "sense_id": "e9034a79-4fe5-3dcc-85e2-905c4adb29b3",
                                                "text": "La métaphysique tout entière est attachée à la détermination de l’idée d’infini ; il n’est point de difficulté métaphysique qui ne naisse de l’opposition entre le fini et l’infini ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd3e7ce-c24a-3566-91b0-493cbc74074a",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Problèmes embarrassants."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "788c5892-bfb1-4b6b-aba1-3e03da2bbe37",
                                                "sense_id": "fdd3e7ce-c24a-3566-91b0-493cbc74074a",
                                                "text": "Les difficultés que soulève une question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8f4604a-91ae-36f8-9a23-49a27a1fc3f9",
                                        "entry_id": "3ba3ca83-06e0-32de-a6ba-e11c3c2f7a26",
                                        "glosses": [
                                            "Différend, contestation."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5819646f-2044-4130-a7d8-3affdabc13af",
                                                "sense_id": "d8f4604a-91ae-36f8-9a23-49a27a1fc3f9",
                                                "text": "Les deux frères ont eu entre eux quelques difficultés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
