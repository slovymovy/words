                {
                    "sense_id": "4a696bc2-1685-372c-bf37-b2799a01e0b0",
                    "sense_definition": "A machine used for capital punishment by decapitation, having a heavy blade that drops down an upright frame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The French revolutionaries used the <w>guillotine</w> to execute thousands of political prisoners."
                        },
                        {
                            "text": "King Louis XVI was sentenced to death and sent to the <w>guillotine</w> in 1793."
                        }
                    ],
                    "common_phrases": [
                        "send to the guillotine"
                    ]
                },
                {
                    "sense_id": "ca67bef4-31b8-3dd3-910d-018a7872f6c4",
                    "sense_definition": "A device with a heavy blade used to trim or cut sheets of paper or the edges of books.",
