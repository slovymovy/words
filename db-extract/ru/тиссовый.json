                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e174c249-d718-49f4-bfc1-34a39935649a",
                                "sense_id": "29860aed-6274-3e70-899c-3756e3e428f9",
                                "text": "Он мог одолеть любого человека в Англии, завязав себе одну руку на спину; и попадал из своего тиссового лука в десятицентовую монету за полторы мили."
                            }
                        ]
