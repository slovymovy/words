                ],
                "senses": [
                    {
                        "sense_id": "ab7f4023-1ab5-3178-b386-a04b95166aab",
                        "entry_id": "da73cca5-73bb-3638-afea-5557269261f6",
                        "glosses": [
                            "юр., фин. дополнительное вознаграждение: премия, дополнительная скидка, добавочный дивиденд и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45508208-ed02-4170-b149-8ba5234019f5",
                                "sense_id": "ab7f4023-1ab5-3178-b386-a04b95166aab",
                                "text": "Естественно, были всякие дополнительные бонусы, продавался мерч (футболки, диски с символами группы и тому подобное), но это отдельная тема, она требовала постоянных инвестиций."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a975e6b0-000c-470e-a880-dc13ddc3a5f3",
                        "source_entry_id": "da73cca5-73bb-3638-afea-5557269261f6",
                        "source_sense_id": "ab7f4023-1ab5-3178-b386-a04b95166aab",
                        "target_lang_word": "bonus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec74ef8f-6e1c-38c0-be58-c0f75ca41eec",
                                        "entry_id": "a74cd5f9-f906-3481-817b-adb07ba80d99",
                                        "glosses": [
                                            "Something extra that is good; an added benefit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82216ea5-29e8-3118-8846-3aebdaf7c081",
                                        "entry_id": "a74cd5f9-f906-3481-817b-adb07ba80d99",
                                        "glosses": [
                                            "An extra sum given as a premium, e.g. to an employee or to a shareholder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741c805f-2eb5-4b10-be43-952853a394c7",
                                                "sense_id": "82216ea5-29e8-3118-8846-3aebdaf7c081",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "f01adaf2-7ed7-45cf-9bb9-eae3f30de3e9",
                                                "sense_id": "82216ea5-29e8-3118-8846-3aebdaf7c081",
                                                "text": "The employee of the week receives a bonus for his excellent work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645d6151-d4a5-36d2-b106-9c38e1e8baee",
                                        "entry_id": "a74cd5f9-f906-3481-817b-adb07ba80d99",
                                        "glosses": [
                                            "An addition to the player's score based on performance, e.g. for time remaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53da93d7-c565-47af-8d65-53b5c40b9541",
                                                "sense_id": "645d6151-d4a5-36d2-b106-9c38e1e8baee",
                                                "text": "Spend the time killing things and there's a bonus for each hit - but only for fatalities notched up since the start of your current life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86bcdff9-c117-3250-928b-e80638232f2b",
                                        "entry_id": "a74cd5f9-f906-3481-817b-adb07ba80d99",
                                        "glosses": [
                                            "One or more free throws awarded to a team when the opposing team has accumulated enough fouls."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bonus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2cfdcb-755f-36b7-9c06-4a50b350efd3",
                                        "entry_id": "d9ebd0ab-de64-3f5b-8e49-865c1508ce45",
                                        "glosses": [
                                            "To pay a bonus, premium"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28077812-6efd-474d-b687-18528af6ae91",
                                                "sense_id": "bb2cfdcb-755f-36b7-9c06-4a50b350efd3",
                                                "text": "In its adherence to a system of rating which bonusses the most anti-social owners and penalises those doing something to improve the district, the municipality must accept a large measure of responsibility."
                                            },
                                            {
                                                "example_id": "756ca050-d119-4bbe-a100-2aed344d9552",
                                                "sense_id": "bb2cfdcb-755f-36b7-9c06-4a50b350efd3",
                                                "text": "The main bulk of the piece-workers (71%) are bonussed for fulfillment of the production quotas by the section, shop or plant on condition they fulfill the norms."
                                            },
                                            {
                                                "example_id": "78efc7f4-c779-4d67-af94-c8237fa4ea5c",
                                                "sense_id": "bb2cfdcb-755f-36b7-9c06-4a50b350efd3",
                                                "text": "Extracting grants called bonusses from municipal councils had become a fine art in the hands of railway promoters, and by the 1870s councils were aware that huge municipal debts could be mounted up by bonussing railway lines that as often as not never materialized."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a620a710-5aa4-4ab6-a107-3fab9a001f50",
                        "source_entry_id": "da73cca5-73bb-3638-afea-5557269261f6",
                        "source_sense_id": "ab7f4023-1ab5-3178-b386-a04b95166aab",
                        "target_lang_word": "Bonus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bonus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6e0a6c-c99e-3e89-a40a-69b2456d3e75",
                                        "entry_id": "da68be7b-7e85-3098-8044-faa0c6d9a7d9",
                                        "glosses": [
                                            "einmalige Sonderzahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292075b8-f46f-4dca-b491-c8eaf3ec8c8d",
                                                "sense_id": "6a6e0a6c-c99e-3e89-a40a-69b2456d3e75",
                                                "text": "Und zum Jahresende gibt es einen schönen Bonus."
                                            },
                                            {
                                                "example_id": "2a0ec89f-d43f-449c-a903-a8cf84b900e1",
                                                "sense_id": "6a6e0a6c-c99e-3e89-a40a-69b2456d3e75",
                                                "text": "Auch Führungskräfte aus unteren Hierarchieebenen und einfache Angestellte sollen zusätzlich zum Fixgehalt einen Bonus bekommen, der vom Erfolg des Unternehmens und von der persönlichen Leistung der Angestellten abhängt."
                                            },
                                            {
                                                "example_id": "df156d65-3866-4d07-8cbb-897a84bf01b9",
                                                "sense_id": "6a6e0a6c-c99e-3e89-a40a-69b2456d3e75",
                                                "text": "Die Deutsche Bank schreibt Milliardenverluste - trotzdem zahlt sie ihren Managern Boni in Milliardenhöhe aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7704baee-223b-383d-8a43-ccae1cbcf538",
                                        "entry_id": "da68be7b-7e85-3098-8044-faa0c6d9a7d9",
                                        "glosses": [
                                            "nachträglich gewährter Rabatt eines Lieferanten (oder Händlers), wenn der Kunde eine vorher festgelegte Umsatzhöhe erreicht hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c13635-b4d2-48ce-b183-d53a1a7e6430",
                                                "sense_id": "7704baee-223b-383d-8a43-ccae1cbcf538",
                                                "text": "Wenn Sie das zwanzigste Brot bei uns kaufen, erhalten Sie einen Bonus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3f8aeb0-4a60-36d3-97d6-59f104bf2124",
                                        "entry_id": "da68be7b-7e85-3098-8044-faa0c6d9a7d9",
                                        "glosses": [
                                            "Punktvorteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dca8c18-dfb4-48fd-bde2-00015f6cdff6",
                                                "sense_id": "c3f8aeb0-4a60-36d3-97d6-59f104bf2124",
                                                "text": "Beim Rugby gibt es einen Bonus in Form von Bonuspunkten, die von der Anzahl der Tries abhängen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                        "entry_id": "da68be7b-7e85-3098-8044-faa0c6d9a7d9",
                                        "glosses": [
                                            "etwas Positives, das einem zum Vorteil gereicht, für das man aber oft nichts aufgewendet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6657da-bdb2-4642-b0d8-d52c15a972d0",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "Als Bonus nach Vertragsabschluss gibt es einen Wellness-Gutschein."
                                            },
                                            {
                                                "example_id": "46ce4c7c-eaa9-4129-8cdd-525329e7fca5",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "Der Amtsinhaber hat in der Regel einen Bonus."
                                            },
                                            {
                                                "example_id": "d239e35a-6c2a-49cf-bcf3-b00e5efb9c84",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "Den Bonus von gut isolierten Gebäuden, streichen der Mieter und der Hausbesitzer bei der Heizkostenabrechnung ein."
                                            },
                                            {
                                                "example_id": "a8942471-dc8b-413b-af04-416c687150d6",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "„Die Freikarten fürs Kino wären der Bonus.“"
                                            },
                                            {
                                                "example_id": "08108413-96be-4672-825a-e965ae8d078e",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "„Aber der größte Bonnus, zumindest finanziell, war, dass Sylvia Joyce nicht länger Geld vorstreckte, das sie nie zurückverlangte.“"
                                            },
                                            {
                                                "example_id": "039c7bba-cf51-46e7-adfb-9773fdcc58b3",
                                                "sense_id": "a73cee48-7966-3b3b-bd9c-add6c214afbd",
                                                "text": "„Denn Gustaf Gründgens hatte sich alles selbst erarbeitet, ohne Bonus und Bürde eines berühmten Vaters und, notabene, ohne die Zuhilfenahme von Drogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                        "entry_id": "da68be7b-7e85-3098-8044-faa0c6d9a7d9",
                                        "glosses": [
                                            "Ermäßigung bei Versicherungsprämien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a07e29-4e0f-4224-8d09-7d87d734be51",
                                                "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                                "text": "„Die grundsätzliche Struktur der verschiedenen Systeme sei ähnlich, Unterschiede gibt es aber in den einzelnen Stufen und insbesondere beim maximal zu erreichenden Bonus.“"
                                            },
                                            {
                                                "example_id": "ff42e2fe-743f-4817-8940-f58bfb8a4773",
                                                "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                                "text": "„Anderes hat aber im vorliegenden Rechtsstreit zu gelten, […] grundsätzlich zulässigerweise zu vereinbarenden Bonus-Malus-Systems (gleich der früheren Bonus-Malus-Verordnung) - nicht bloß ein Malus im Falle von Versicherungsleistungen festgesetzt, sondern […] auch ein entsprechender Bonus im Falle der Schadensfreiheit in einem bestimmten Zeitraum statuiert ist.“"
                                            },
                                            {
                                                "example_id": "eaf324b4-aaea-4287-a5ba-4b5b05dbf5a2",
                                                "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                                "text": "„Der Bedarf für tarifliche Zu- und Abschläge (z. B. in Kraftfahrt: Malus und Bonus; in Feuer: Lösch- oder Sprinklerrabatte) kann nur dort genau kalkuliert werden, wo man pro Gruppe den jeweiligen Anteil der Risiken der Untergruppen kennt.“"
                                            },
                                            {
                                                "example_id": "cca31d24-3f59-4355-b484-827193576e1f",
                                                "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                                "text": "„Ein Risiko ohne Schadenerfahrung wird in die neutrale Klasse 0 eingeordnet; dagegen wird einem Risiko mit Schadenerfahrung im Fall der Schadenfreiheit ein Bonus eingeräumt […].“"
                                            },
                                            {
                                                "example_id": "6d90f09e-eb26-4509-b5fc-0c362a97cf03",
                                                "sense_id": "af374d2c-90d3-39b1-9293-81fe575f9a1e",
                                                "text": "„Deshalb gebe man jungen Kunden bis 25 Jahren einen Bonus: Wenn sie in den beiden kritischen Wochenendnächten ihr Auto stehen lassen, bekommen sie pro Tag 10 Freikilometer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
