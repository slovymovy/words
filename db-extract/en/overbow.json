                ],
                "senses": [
                    {
                        "sense_id": "4e72c641-abca-3bff-a192-50802ca3076d",
                        "entry_id": "6cd85e9e-8dbf-396f-80cd-088123797515",
                        "glosses": [
                            "To show excessive deference toward by too much bowing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b92f26f4-e77d-4569-885b-7c8638ec9cb4",
                                "sense_id": "4e72c641-abca-3bff-a192-50802ca3076d",
                                "text": "Russian officers, especially titled ones, and their families, are naturally exempt from such ignominious treatment, and Alain's small party—all excepting Lustrac, of course, who had at once to go and interview the highest authorities present, so as to spare the touch of ill-bred fingers to Sacha's dainty robes and laces—were bowed and rebowed, and in fact quite overbowed, into the aforesaid room, where the ruddiness of a generous fire showed between the half-open brass doors of the gigantic and home-like porcelain stove, and a basket overflowing with enormous Russian violets filled the middle of the well-set table."
                            }
                        ]
                    }
                ],
