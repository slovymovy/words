                "senses": [
                    {
                        "sense_id": "27737131-0730-33bd-aa0a-17dbff61fb12",
                        "entry_id": "86ad0019-4dc6-325e-9ee9-06589464bc71",
                        "glosses": [
                            "umgangssprachlich, salopp, teilweise abwertend gemeint: eine Tätowierung auf dem unteren Rücken, kurz oberhalb des Steißbeins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c72676-f34d-45ce-9dbe-b8e23ff6dea2",
                                "sense_id": "27737131-0730-33bd-aa0a-17dbff61fb12",
                                "text": "„Ich meine, die erste Frau die sich ein Arschgeweih stechen lassen hat, tut mir einfach nur leid. Für sie war es vielleicht eine coole Idee, aber unterdessen hat so etwas jede Frau und es sagt einfach nichts aus.“"
                            },
                            {
                                "example_id": "e23ec7b8-d986-4a11-b4b1-c428b7a0584e",
                                "sense_id": "27737131-0730-33bd-aa0a-17dbff61fb12",
                                "text": "„Und die letzten verbliebenen Arschgeweihe der Jahrtausendwende wirken über dem Hüftspeck mystisch dreidimendional.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dde6af68-9439-4dc3-9d02-3db92756a765",
                        "source_entry_id": "86ad0019-4dc6-325e-9ee9-06589464bc71",
                        "source_sense_id": "27737131-0730-33bd-aa0a-17dbff61fb12",
                        "source_sense_description": "eine Tätowierung auf dem unteren Rücken, kurz oberhalb des Steißbeins",
                        "target_lang_word": "tramp stamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tramp stamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                        "entry_id": "b43fd864-1b82-3bdb-bb18-bee3f2dd07d9",
                                        "glosses": [
                                            "A tattoo on a woman's lower back, stereotypically said to label her as promiscuous."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e7762e9-83b8-4c23-8aff-74d4dc8666ff",
                                                "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                                "text": "That's a text book definition of low-rent hoochie mama if I ever saw it. Guarantee you she's got her tramp stamp across her hips."
                                            },
                                            {
                                                "example_id": "a232d3ce-1224-4976-8f3f-765b07ff5223",
                                                "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                                "text": "2006 May 31, “SyVyN11” (author), “Re: Rihanna's tiny Oz tattoo”, alt.gossip.celebrities and alt.showbiz.gossip, Usenet\nI was hoping for a tramp stamp!"
                                            },
                                            {
                                                "example_id": "87bd8e45-bb63-4416-a19f-d26bfedf0a2d",
                                                "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                                "text": "There's nothing quite like seeing a woman bend over and show her tramp stamp."
                                            },
                                            {
                                                "example_id": "19e85c90-e408-4727-988c-fcc0a58b98a7",
                                                "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                                "text": "the tattoo parlor is across the street. I packed my drawings and am going to go over them with the owner. I want to get my mushroom as a tramp stamp, if it works, but we shall see what he says."
                                            },
                                            {
                                                "example_id": "28f6a5da-d218-4225-bc58-49993c3a44d4",
                                                "sense_id": "dfa8d60d-3100-3264-8916-c55dd9195412",
                                                "text": "This monkey has a thing for blond female zookeepers, but only if they have tattoos.... Sibu the orangutan likes Goldilocks with a tramp stamp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb68959-58a9-357b-b0a4-0e32de8cf8dd",
                                        "entry_id": "b43fd864-1b82-3bdb-bb18-bee3f2dd07d9",
                                        "glosses": [
                                            "A hickey on a woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
