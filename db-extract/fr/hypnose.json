        "fr-extract.jsonl": [
            {
                "entry_id": "eefc9efe-ce14-3d41-a327-43ad500b3327",
                "word": "hypnose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fb6e47dc-1880-4877-9a42-9e5474280b88",
                        "entry_id": "eefc9efe-ce14-3d41-a327-43ad500b3327",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypnoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                        "entry_id": "eefc9efe-ce14-3d41-a327-43ad500b3327",
                        "glosses": [
                            "Procédure au cours de laquelle un professionnel de santé ou un chercheur suggère au patient de vivre ou de faire l’expérience de sensations, perceptions, pensées ou comportements modifiés. — (The Executive Committee of the American Psychological Association, 1994)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31323bc-5cea-4b49-8214-2f3f402fa47f",
                                "sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                                "text": "Un homme de 88 ans opéré du cœur sous hypnose à Lille, sans anesthésie \"lourde\""
                            },
                            {
                                "example_id": "8e5f0414-baab-469e-a05d-2a7f7c0c1141",
                                "sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                                "text": "L’hypnose, la gestalt-thérapie ou l’EMDR sont également des approches intéressantes."
                            },
                            {
                                "example_id": "b378d2a6-d336-4dfe-b884-d6d1af1843ab",
                                "sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                                "text": "On pourrait dire que l'hypnose, ou le principe de changement dû à un échange communicationnel, existe depuis autant de temps que les relations humaines."
                            },
                            {
                                "example_id": "e39d253d-17a4-48d9-835f-80eeb7ec7d27",
                                "sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                                "text": "Ainsi appliquée, l'hypnose ne permet pas une recherche de cause mais bel et bien encore une fois une véritable modification de la perception dans l'optique d'un soulagement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd6e6883-2c8b-43fb-b467-4749fa119ef9",
                        "source_entry_id": "eefc9efe-ce14-3d41-a327-43ad500b3327",
                        "source_sense_id": "0a662c77-cf26-3fde-bd9f-4d93c5e9796f",
                        "target_lang_word": "Hypnose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypnose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                        "entry_id": "fbc180b4-1b27-312b-8f42-5ad2acd2da60",
                                        "glosses": [
                                            "Verfahren, mit dem jemand in einen hypnotischen Zustand versetzt wird"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d04be3-660e-4a91-bf32-9cfebffb9e5e",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "Der Arzt behandelte sie versuchsweise mit einigen Hypnosen, jeweils im Abstand von wenigen Tagen."
                                            },
                                            {
                                                "example_id": "9a340a1e-9452-4755-b80e-d5cf7603eddf",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "Hypnose wird nicht von jeder Krankenkasse als Therapie anerkannt."
                                            },
                                            {
                                                "example_id": "385dff93-ca02-4b71-a5ce-c138d998ab2d",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "„Um sich Mut zu machen, experimentierten die Kampfbündler mit Hypnose und Selbsthypnose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "728b52fe-800d-3547-b113-0284df27215b",
                                        "entry_id": "fbc180b4-1b27-312b-8f42-5ad2acd2da60",
                                        "glosses": [
                                            "Zustand erhöhter Suggestibilität"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850aacde-ade2-474f-a558-05c417abe7c5",
                                                "sense_id": "728b52fe-800d-3547-b113-0284df27215b",
                                                "text": "Innerhalb weniger Minuten befand sie sich in Hypnose."
                                            },
                                            {
                                                "example_id": "29e17da8-2fe2-459d-bf75-5a14797c94c8",
                                                "sense_id": "728b52fe-800d-3547-b113-0284df27215b",
                                                "text": "Er reagierte wie unter Hypnose."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
