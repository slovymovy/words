                        "target_lang_word": "Gebrauchsgegenstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebrauchsgegenstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                        "entry_id": "a2363a47-6d9d-398b-a173-1da26a2f715c",
                                        "glosses": [
                                            "ein Gegenstand für den alltäglichen Gebrauch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80cc0a8-0665-4da1-94af-729b0cbc9cc7",
                                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                                "text": "„Da sind zunächst die Soldaten und Offiziere, die sich mit Gebrauchsgegenständen eindecken, die sie später auf dem sowjetischen Schwarzmarkt tauschen oder zu Geld machen wollen.“"
                                            },
                                            {
                                                "example_id": "059aa8b4-a175-4064-8d82-532b98c73ad3",
                                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                                "text": "„In dem alten Bauernhaus mit seinem begrünten Dach, das vom Anfang des 19. Jahrhunderts bis 1950 bewohnt war, sind Gebrauchsgegenstände und Werkzeuge der Fischer und Bauern aus dem 19. und 20. Jahrhundert ausgestellt.“"
                                            },
                                            {
                                                "example_id": "d2c221f1-060c-4478-ba71-e6d9642ef7d5",
                                                "sense_id": "ff74bba6-6548-3c6c-9668-23a2d1dcc80b",
                                                "text": "„Keine Pelzdecke und keiner unserer Pelzmäntel kam abhanden, denn dafür interessierten sich die Russen nicht; Pelze sind für sie offenbar reine Gebrauchsgegenstände, über die sie selbst reichlich verfügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
