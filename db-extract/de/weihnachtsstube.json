                "senses": [
                    {
                        "sense_id": "819b8be8-44f8-3dc3-b7d2-149b6cbbf26a",
                        "entry_id": "5c10de08-87d4-3b29-9a47-dc9ab4bc6e5f",
                        "glosses": [
                            "Raum, der weihnachtlich geschmückt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b520d8a-d6b2-4b61-baf0-04266d5a0ff1",
                                "sense_id": "819b8be8-44f8-3dc3-b7d2-149b6cbbf26a",
                                "text": "„Wir sagen ihm, daß wir weinen werden wie Hunde, die Musik hören, wenn er nicht mit uns zur Bescherung in die Weihnachtsstube hinuntergeht, und wir reden so lange auf ihn ein, bis er sein Chemisett umtut.“"
                            },
                            {
                                "example_id": "11211747-7ff1-4575-92b7-e765a5a5f69f",
                                "sense_id": "819b8be8-44f8-3dc3-b7d2-149b6cbbf26a",
                                "text": "„Biedermeier war’s, das politisch entmündigte Bürgertum erhob die Familie zur gesellschaftlichen Lebensform schlechthin, da fand der Lichterbaum auch Eingang in die Weihnachtsstube der zwar Nichtadeligen, aber Begüterten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
