                            }
                        },
                        {
                            "text": "He wore his <w>marine</w> uniform with great pride during the national parade.",
                            "target_lang_translations": {
                                "ru": "Он с большой гордостью носил свою форму <w>морского пехотинца</w> во время национального парада.",
                                "zh": "在国庆阅兵期间，他自豪地穿着他的<w>海军陆战队</w>制服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marine corps",
                        "marine base",
                        "marine uniform"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к корпусу морской пехоты или его служащим",
                        "zh": "与海军陆战队或其成员有关的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской пехоты",
                                "target_lang_sense_clarification": "принадлежащий к роду войск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海军陆战队的",
                                "target_lang_sense_clarification": "属于该兵种的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc6f1a15-1e12-3e1a-801a-4bfdb8a667df",
                    "sense_definition": "a soldier trained to serve on board a ship or in amphibious operations",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After completing boot camp, he officially became a <w>marine</w> in the United States military.",
                            "target_lang_translations": {
                                "ru": "После прохождения учебного лагеря он официально стал <w>морским пехотинцем</w> в вооруженных силах США.",
                                "zh": "完成新兵训练营后，他正式成为美国军队的一名<w>海军陆战队员</w>。"
                            }
                        },
                        {
                            "text": "The <w>marine</w> stood guard at the entrance of the embassy all night.",
                            "target_lang_translations": {
                                "ru": "<w>Морпех</w> всю ночь стоял на посту у входа в посольство.",
                                "zh": "这名<w>海军陆战队员</w>整晚都在大使馆门口站岗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "devil dog",
                        "jarhead",
                        "leatherneck"
                    ],
                    "common_phrases": [
                        "former marine",
                        "enlisted marine"
