                "senses": [
                    {
                        "sense_id": "dff926d0-6798-3f0b-98a8-ddd98d87ac61",
                        "entry_id": "f972269c-8adb-3bb0-8eaa-6bab9ae3f6f4",
                        "glosses": [
                            "Süßigkeit, die hauptsächlich aus geschlagenem Eiweiß, Zucker und Geliermittel, ursprünglich aus den Wurzeln des Eibischs, besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c830663-c693-4582-8cff-1da05c452646",
                                "sense_id": "dff926d0-6798-3f0b-98a8-ddd98d87ac61",
                                "text": "Beim Camping rösteten die Kinder ihre Marshmallows über dem Lagerfeuer."
                            },
                            {
                                "example_id": "89280838-1a9d-49f3-b0a0-efe7eaed7057",
                                "sense_id": "dff926d0-6798-3f0b-98a8-ddd98d87ac61",
                                "text": "„Val öffnete eine Packung Marshmallows.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08eeb25a-8b4e-4a3e-ad99-da9242b12c79",
                        "source_entry_id": "f972269c-8adb-3bb0-8eaa-6bab9ae3f6f4",
                        "source_sense_id": "dff926d0-6798-3f0b-98a8-ddd98d87ac61",
                        "target_lang_word": "marshmallow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marshmallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba4ffd33-fa05-3cb6-927d-280848490398",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "Marsh mallow, a species of mallow, Althaea officinalis, that grows in marshy terrain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b4f451-7d1c-4399-968d-e7e43f6a5791",
                                                "sense_id": "ba4ffd33-fa05-3cb6-927d-280848490398",
                                                "text": "Our common Marsh Mallows have diverse soft, hoary white stalks rising to be three or four foot high, spreading forth many branches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "A type of confectionery, originally (since Ancient Egyptian times) made from this plant, but now generally made of sugar or corn syrup, gelatin that has been presoftened in water, gum arabic, flavorings, and sometimes beaten egg whites, all whipped to a spongy consistency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0f3096-2bde-4705-b4f5-effe28f53e28",
                                                "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                                "text": "The Disagreeable Girl is a female of the genus homo persuasion, built around a digestive apparatus that possesses marked marshmallow proclivities."
                                            },
                                            {
                                                "example_id": "28aaa818-b85a-4d12-9f14-3c9e426bbc4f",
                                                "sense_id": "d7c1ac20-53a1-3f2e-ba83-095a61179911",
                                                "text": "It was an apple marshmallow sundae, I recollect. I dug my spoon into it with an assumption of gaiety which I was far from feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                        "entry_id": "c8d0e8c7-85fe-34a7-8988-a00c80840bdc",
                                        "glosses": [
                                            "Someone who is soft and benign."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd84207-571f-40bc-a94c-5c977f9a43e1",
                                                "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                                "text": "He acts like a total badass, but he's really just a marshmallow once you get to know him."
                                            },
                                            {
                                                "example_id": "a85bbcfa-9904-474f-8b6f-b02282144957",
                                                "sense_id": "b59fb6dc-8f23-3e26-92f6-324b7eaa5362",
                                                "text": "You're a marshmallow, Glenn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marshmallow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                        "entry_id": "f572cd9e-bdd2-3373-81dd-4a0428a22108",
                                        "glosses": [
                                            "To soften (literally or figuratively)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79630a52-3502-4452-b1d2-19b74e0c87cd",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "For i could still feel her small face in my hands, her lips marshmallowing under the brushing knuckle of my index, the hard press of her capable contoured body."
                                            },
                                            {
                                                "example_id": "bfe0300b-4640-4ae5-ae19-43b455645ae9",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "He didn't know if touching me meant that I would marshmallow up or if he would have to brace himself for a blow."
                                            },
                                            {
                                                "example_id": "ae33963b-0cd5-4458-a7c0-b3f3ebb36128",
                                                "sense_id": "52350e1e-9abb-388e-b458-5bf18fb9134d",
                                                "text": "Various dishes heaped with food were tucked haphazardly all over: mounds of whipped potatoes, medleys of buttered vegetables, marshmallowed sweet potatoes, oyster stuffing, cranberry sauce (fresh from the can) and even more dishes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e3762e3-3296-499e-a43b-7c50252b1188",
                        "source_entry_id": "f972269c-8adb-3bb0-8eaa-6bab9ae3f6f4",
                        "source_sense_id": "dff926d0-6798-3f0b-98a8-ddd98d87ac61",
                        "target_lang_word": "guimauve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guimauve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12667c09-00b5-3674-b4f6-86f8395f50a6",
                                        "entry_id": "930244aa-84c5-3a60-b690-d23d1d154082",
                                        "glosses": [
                                            "Plante de la famille des Malvacées, qui a la tige plus haute et les feuilles plus petites que les mauves ordinaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09b9614b-a4b0-3673-8f71-ef6f9f33396e",
                                        "entry_id": "930244aa-84c5-3a60-b690-d23d1d154082",
                                        "glosses": [
                                            "Plante de la famille des Malvacées, qui a la tige plus haute et les feuilles plus petites que les mauves ordinaires.",
                                            "Guimauve officinale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bedf9c72-36c9-4221-9465-cbd086d77c15",
                                                "sense_id": "09b9614b-a4b0-3673-8f71-ef6f9f33396e",
                                                "text": "Près de la cheminée on voyait un fauteuil Voltaire et une petite table, avec un pot de tisane de guimauve et un verre ébréché."
                                            },
                                            {
                                                "example_id": "74a38afb-7c9f-41d7-a772-a00c80b143d3",
                                                "sense_id": "09b9614b-a4b0-3673-8f71-ef6f9f33396e",
                                                "text": "— Si on avait de la tisane… dit-elle.\nAlors, lui, prépara cette tisane avec des fleurs de guimauve. Madeleine la fit boire à l’enfant qui, d’ailleurs, venait de se taire subitement."
                                            },
                                            {
                                                "example_id": "380f05b8-6454-420d-943a-5d113a8948de",
                                                "sense_id": "09b9614b-a4b0-3673-8f71-ef6f9f33396e",
                                                "text": "Et comme c’est la guerre, s’éloigner des solidarités villageoises veut dire le froid – je vois encore, sur le papier blanc des copies, les mains gourdes, enflées et craquelées, qu’on soignait tant bien que mal avec des décoctions de racines de guimauve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbf3fae4-e561-3aab-af91-c50e5436228c",
                                        "entry_id": "930244aa-84c5-3a60-b690-d23d1d154082",
                                        "glosses": [
                                            "Confiserie molle à base de sucre, de blanc d’œufs battus, d’extrait de guimauve (de nos jours remplacé par de la gélatine) et de gomme arabique."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5cd9441-8e0a-4194-a5c8-f43ba2c1ea8b",
                                                "sense_id": "cbf3fae4-e561-3aab-af91-c50e5436228c",
                                                "text": "À ses cris ils arrivèrent, ainsi qu’un chiffonnier chargé de sa hotte pleine, qui rentrait dans le clos, et le locataire du wagon dont la profession était d’être marchand de pâte de guimauve et de parcourir les fêtes et les marchés en suspendant à un crochet tournant des tas de sucre fondu, dont il tirait des tortillons jaunes, bleus, rouges, comme l’eût fait une fileuse de sa quenouille."
                                            },
                                            {
                                                "example_id": "5eb15e9f-2a64-49a5-a8a6-e51154c4131e",
                                                "sense_id": "cbf3fae4-e561-3aab-af91-c50e5436228c",
                                                "text": "Ouich, chquand ? a mâchouillonné Guillôme qui finissait un paquet de guimauves roses torsadées."
                                            },
                                            {
                                                "example_id": "c14cb505-e083-4071-a5a9-38f058abd51c",
                                                "sense_id": "cbf3fae4-e561-3aab-af91-c50e5436228c",
                                                "text": "— Un bonbon. Ce sont des guimauves.\nD'un geste timide, Nouillh fouilla dans le sachet et en tira une longue guimauve rouge.\n— Oh, celles-là sont super ! s'exclama Samuel en enfournant une guimauve orange et en la mâchant pensivement."
                                            },
                                            {
                                                "example_id": "83a103f2-cd61-4194-8df3-278b4bb2e3f8",
                                                "sense_id": "cbf3fae4-e561-3aab-af91-c50e5436228c",
                                                "text": "Avec l'aide de Morgan, Julian apprit à griller des guimauves et découvrit qu'il les préférait quand elles étaient brûlées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b59a051-1f8d-38b4-8870-2fb73770c5b3",
                                        "entry_id": "930244aa-84c5-3a60-b690-d23d1d154082",
                                        "glosses": [
                                            "Ce qui est fade, douceâtre, sans expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad736081-6aae-4b3d-bad1-58acfc0d7cff",
                                                "sense_id": "9b59a051-1f8d-38b4-8870-2fb73770c5b3",
                                                "text": "Seulement, le développement comique, vous l'attendez en vain. Il ne vient pas. Ce qui vient, c'est un ramassis de vieilles scènes complètement éculées et de guimauve amoureuse incomestible, le tout entremêlé de pataquès ridicules."
                                            },
                                            {
                                                "example_id": "5a4dc3d6-8879-4b74-8f0c-7fc4b336ba21",
                                                "sense_id": "9b59a051-1f8d-38b4-8870-2fb73770c5b3",
                                                "text": "Jamais on n’attrapera Monk à faire ces arpèges en guimauve dont les pianistes sont si friands, qui se finissent à l’extrémité du clavier, et qui les transforment momentanément en harpistes."
                                            },
                                            {
                                                "example_id": "4f906a92-8c8d-4a17-aa1d-7ad843f1bcf6",
                                                "sense_id": "9b59a051-1f8d-38b4-8870-2fb73770c5b3",
                                                "text": "Maquillé [un acteur de cinéma jouant le Christ] …, dont les gestes étaient de guimauve, onctueusement désossés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9e3ac6-b8d1-36fe-8ad6-9706493e3bfc",
                                        "entry_id": "930244aa-84c5-3a60-b690-d23d1d154082",
                                        "glosses": [
                                            "Chanson sentimentale."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbe71b3-4410-4be3-a91a-5f19e3fa98cf",
                                                "sense_id": "1c9e3ac6-b8d1-36fe-8ad6-9706493e3bfc",
                                                "text": "Le piano du pauvre\nSe noue autour du cou\nLa chanson guimauve\nToscanini s'en fout."
                                            },
                                            {
                                                "example_id": "71711d02-3d05-439e-a770-8b293010fc5f",
                                                "sense_id": "1c9e3ac6-b8d1-36fe-8ad6-9706493e3bfc",
                                                "text": "Tu vois la différence qu’il peut y avoir entre quatre seigneurs de la scène qui donnent dans la guimauve tous les quatre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92e05aee-ea2d-4aea-bb8f-0d8a549b1870",
                        "source_entry_id": "f972269c-8adb-3bb0-8eaa-6bab9ae3f6f4",
