                        ],
                        "form": "spiskowe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dab3eb86-0cad-32b3-afd6-62cbd6098c69",
                        "entry_id": "6d84fcbc-2e7a-3c8d-baf7-a1f84d985cfc",
                        "glosses": [
                            "właściwy spiskowi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50e2234-5a84-4781-869a-c415ec838deb",
                                "sense_id": "dab3eb86-0cad-32b3-afd6-62cbd6098c69",
                                "text": "Stąd funkcjonować tu mogły jedynie tajne organizacje spiskowe, najczęściej o krótkotrwałym żywocie, tropione przez policję"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4501543-7617-424b-9fd0-34738daa0a11",
                        "source_entry_id": "6d84fcbc-2e7a-3c8d-baf7-a1f84d985cfc",
                        "source_sense_id": "dab3eb86-0cad-32b3-afd6-62cbd6098c69",
                        "target_lang_word": "conspiratorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspiratorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                        "entry_id": "c834c714-27ca-3e04-a853-64117f227f5b",
                                        "glosses": [
                                            "Pertaining to conspiracy or conspirators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146ddc22-d00e-4e22-b29a-e441ea6a7778",
                                                "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                                "text": "His conspiratorial whispers were soft, but that just attracted more attention."
                                            },
                                            {
                                                "example_id": "f973d1be-632f-49a4-9805-5fcf0c0bb430",
                                                "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                                "text": "I pressed the button and he appeared, giving me, as he entered, the sort of conspiratorial glance the acting secretary of a secret society would have given a friend on the membership roll. “Oh, Swordfish,” I said, having given him a conspiratorial glance in return, for one always likes to do the civil thing, “this is Mr Herring, who has come to join our little group.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c6fec4-e5cd-3323-a200-0ffbab3c127c",
                                        "entry_id": "c834c714-27ca-3e04-a853-64117f227f5b",
                                        "glosses": [
                                            "Believing in conspiracy theories."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1793e7fb-5bd5-411d-9f64-b2676cce0dc1",
                                                "sense_id": "06c6fec4-e5cd-3323-a200-0ffbab3c127c",
                                                "text": "Conspiratorial thinking is another predictor of vaccine hesitancy, according to the 2018 study."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb673c11-1b72-4760-a0ae-da80400dae01",
                        "source_entry_id": "6d84fcbc-2e7a-3c8d-baf7-a1f84d985cfc",
                        "source_sense_id": "dab3eb86-0cad-32b3-afd6-62cbd6098c69",
                        "target_lang_word": "conspirateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                        "entry_id": "905f292e-d6a8-3765-b9a5-f8e9e8ec7457",
                                        "glosses": [
                                            "Qui conspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953f4699-3c94-416a-8bd5-2bd6c1c045f2",
                                                "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                                "text": "La phalange conspiratrice."
                                            },
                                            {
                                                "example_id": "102e747b-7415-4b54-a390-39f3f2ab88f5",
                                                "sense_id": "032cd077-008b-3ab3-9082-d3e89162bec5",
                                                "text": "Se penchant vers moi avec un air conspirateur, il a murmuré : « Je mets déjà en pratique la plupart de ces principes, mais ma femme avait vraiment besoin d’entendre cela. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conspirateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                        "entry_id": "d13ac5ba-dcbb-3945-8511-a179eb8e31b0",
                                        "glosses": [
                                            "Celui qui conspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403c44e1-ccb6-49bf-a7fd-1b2b3baa313a",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Une prompte enquête, instruite par le coroner Mac-Ma-Hong, révéla que le conspirateur n’était pas le meurtrier ; la machine à désélectrocuter n’étant pas encore inventée, on inhuma le malheureux innocent."
                                            },
                                            {
                                                "example_id": "067d1e9c-90a1-4a5c-8d7f-f9fabddebf0d",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Cette sauvage sortie fut réprimée par Cérizet, qui dit à la revendeuse un de ces chut ! prolongés auxquels obéissent tous les conspirateurs."
                                            },
                                            {
                                                "example_id": "806b43bc-c4e6-4b43-9fc7-ca8e244db3f0",
                                                "sense_id": "ba6581d3-9da5-3803-a532-cd2bb61cbe7a",
                                                "text": "Les sections de la fière cité de Marseille ont bien mérité de la patrie, législateurs; elles ont désagonisé l’esprit public, septembrisé par une faction liberticide; et s’armant de la pique redoutable, elles ont terrassé les insolens conspirateurs qui étaient dans leur sein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
