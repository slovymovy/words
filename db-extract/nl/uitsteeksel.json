                                    },
                                    {
                                        "sense_id": "e70f7eee-e2f5-32ea-b400-e20ed8d355be",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The crisis or decisive point of any process, especially a culinary process."
                                        ],
                                        "tags": [
                                            "archaic",
