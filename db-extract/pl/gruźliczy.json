                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d73a286-324d-36df-9a16-a64a74cba987",
                                        "entry_id": "77fb9b18-ff41-3f72-8876-4f6fc0636b47",
                                        "glosses": [
                                            "Relating to pulmonary tuberculosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366a4b04-3e4d-4436-9719-010ba8920b8e",
                                                "sense_id": "0d73a286-324d-36df-9a16-a64a74cba987",
                                                "text": "consumptive cough"
                                            },
                                            {
                                                "example_id": "50f0ade5-4ff9-4dfe-a065-d7e3f9d782bc",
                                                "sense_id": "0d73a286-324d-36df-9a16-a64a74cba987",
                                                "text": "The lean, conſumptive, wench, with coughs decay'd, / Is call'd a pretty, tight, and ſlender maid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consumptive",
