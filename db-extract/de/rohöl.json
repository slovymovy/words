                "senses": [
                    {
                        "sense_id": "322ef3bd-7ac4-3eb2-bef0-2c7ea7ce6a39",
                        "entry_id": "850c3a22-283b-34d2-aa28-50e2ecae704d",
                        "glosses": [
                            "Pétrole brut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ec789c-f29a-48a2-a371-4ccf769121db",
                                "sense_id": "322ef3bd-7ac4-3eb2-bef0-2c7ea7ce6a39",
                                "text": "Das Rohöl muss erst in einer Raffinerie gereinigt und in die Bestandteile zerlegt werden.",
                                "translation": "Le pétrole brut doit être d’abord raffiné dans une raffinerie et séparé de ses co-produits."
                            },
                            {
                                "example_id": "d48ca395-9072-4606-bcfc-70c814e17d1b",
                                "sense_id": "322ef3bd-7ac4-3eb2-bef0-2c7ea7ce6a39",
                                "text": "Die Vereinten Nationen haben mit einer Mission zur Bergung von über einer Million Barrel Rohöl aus einem schrottreifen Tanker vor der Küste des Jemen begonnen.",
                                "translation": "Les Nations unies ont commencé une mission pour récupérer plus d’un million de barils de pétrole brut d’un pétrolier en perdition au large des côtes du Yémen."
                            }
                        ]
                    }
                ],
