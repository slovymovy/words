                        "examples": [
                            {
                                "example_id": "2fc758c6-e1ee-4d32-a357-b445676167e1",
                                "sense_id": "c5f9f3c2-023c-3212-bdd2-c729241f707a",
                                "text": "Een hertengewei boven de haard of desnoods boven de flatscreen. Staatsbosbeheer in Lelystad verkoopt de geweien die de herten in de Oostvaardersplassen verliezen."
                            },
                            {
                                "example_id": "af35d621-80c3-4faa-bb3b-db6cfd9374db",
                                "sense_id": "c5f9f3c2-023c-3212-bdd2-c729241f707a",
                                "text": "Bij de opbouw van haar huis geeft ze een aantal medewerkers nog wat aanwijzingen. Die lamp met dat hertengewei moet daar hangen, die bank moet nog een beetje verschuiven. Dat schilderij moet anders."
                            }
                        ]
                    }
