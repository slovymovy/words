                ],
                "senses": [
                    {
                        "sense_id": "8274df39-09cc-3849-9547-f94d3d80a723",
                        "entry_id": "6497649f-ed7d-3e1d-a63d-52cc12434615",
                        "glosses": [
                            "A soil type found in volcanic regions, known for hardness, poor drainage, and poor fertility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd625f4-577f-4fc6-a204-44cea1a3d436",
                                "sense_id": "8274df39-09cc-3849-9547-f94d3d80a723",
                                "text": "Where erosion has reduced the soil layer to less than planting depth or to exposed tepetate, farmers may break up and pulverize the tepetate with plows, picks, crowbars, sledgehammers, or even black powder, to form a usable soil layer."
                            },
                            {
                                "example_id": "10861aca-a2a3-471b-a9d0-c7816523dba5",
                                "sense_id": "8274df39-09cc-3849-9547-f94d3d80a723",
                                "text": "Alternating dry and wet periods may favour crystallisation of amorphous aluminium silicates to phyllosilicate clays, so that many tepetates have clay coatings that are due to recrystallisation rather than to clay illuviation (see also Chapter 12)."
                            },
                            {
                                "example_id": "33597350-7d74-4a75-9818-0399263e8424",
                                "sense_id": "8274df39-09cc-3849-9547-f94d3d80a723",
                                "text": "Tepetate is a vernacular Mexican term referring to a hardened land with various degrees of infertility. Tepetates are derived from volcanic material, mainly tuff. The scientific definition reserves the term tepetate for a hardened layer in soils formed from pyroclastic materials. In the Central Valley of Mexico these indurate layers are among the most striking geological features."
                            }
                        ]
                    }
                ],
