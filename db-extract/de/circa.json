                                    {
                                        "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                        "entry_id": "c6dff810-1820-39ba-b23c-0a46281c6c42",
                                        "glosses": [
                                            "Imprecise but close to in quantity or amount."
                                        ],
                                        "tags": [
                                            "not-comparable"
