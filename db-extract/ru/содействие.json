                                        "sense_id": "6521658c-cd66-3341-b8b8-977199d06b74",
                                        "entry_id": "68a304ea-e853-36ad-9c2b-fbd5b2baed34",
                                        "glosses": [
                                            "To climb with the use of aids such as pitons."
                                        ],
