                "senses": [
                    {
                        "sense_id": "37e1fe09-0b8b-304a-9212-68400c4065e4",
                        "entry_id": "7346ccd9-9744-3109-86f9-217cce9eb002",
                        "glosses": [
                            "Morgen im August"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77bd8a3c-cfc7-4b7f-9a5e-483015aaf2c4",
                                "sense_id": "37e1fe09-0b8b-304a-9212-68400c4065e4",
                                "text": "„Ich kam über eine Höhe. Wenige hundert Schritte vor mir lag ein riesiger Waldkomplex von vielen tausend Morgen. Es war ein schöner Augustmorgen. Der Wald lag so friedlich und ruhig, …“"
                            },
                            {
                                "example_id": "1724d064-5bd7-4640-91ea-9730e609fb82",
                                "sense_id": "37e1fe09-0b8b-304a-9212-68400c4065e4",
                                "text": "An einem Augustmorgen klingelte anstatt des Weckers das Mobiltelefon."
                            },
                            {
                                "example_id": "57b108d5-504d-44ad-b6d4-41b3d93cdd25",
                                "sense_id": "37e1fe09-0b8b-304a-9212-68400c4065e4",
                                "text": "„Das sage ich mir, als ich an einem Augustmorgen durch den Schlachtensee schwimme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
