                ],
                "senses": [
                    {
                        "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                        "entry_id": "0345734c-a61f-34a6-b8b0-888242e014e4",
                        "glosses": [
                            "Qui a la rapidité, l’impétuosité d’un torrent."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "201a4e66-b54e-4448-81eb-6c7f2455567a",
                                "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                                "text": "— Il faisait un temps affreux ; la nature, désolée, se fondait en pluie, de cette pluie froide et torrentueuse qui annonce l’hiver."
                            },
                            {
                                "example_id": "48bd24f3-79e1-4f20-a34d-8201936fba97",
                                "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                                "text": "— On académisait les pensées avancées. Le grand Bach, torrentueux, était reçu, assagi, dans le giron de l’Église."
                            },
                            {
                                "example_id": "4a2228f0-9b07-4683-9369-6a386c238d5d",
                                "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                                "text": "En bas, il y a une rivière un peu torrentueuse qui coule en bruissant."
                            },
                            {
                                "example_id": "81cf5313-6779-439e-b0eb-91422211199e",
                                "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                                "text": "Bénéfique pour la vitalité et la pérennité de l’écosystème forestier, la dynamique torrentueuse du Rhin sauvage provoquait, lors d’inondations séculaires, des catastrophes."
                            },
                            {
                                "example_id": "481d6f04-d7dc-43aa-80f9-53644b9bde75",
                                "sense_id": "567abddb-71f4-30a4-b680-8100756941ef",
                                "text": "Certaines de ses amies lui avaient raconté leurs amours torrentueuses, leurs corps exalté[s], leurs jouissances pléthoriques."
                            }
                        ]
                    }
                ],
