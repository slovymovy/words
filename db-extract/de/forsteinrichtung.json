                                        "entry_id": "a88a5a18-94f1-322b-9ab8-d1d3b4fc1793",
                                        "glosses": [
                                            "Document décrivant le mode de gestion d’une forêt et planifiant les opérations, travaux et coupes, à venir."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264f156f-854a-41ca-87b3-c144c71de475",
                                                "sense_id": "43987f23-939f-35ba-903b-334f11578a89",
                                                "text": "Pour répondre à la question, le gestionnaire doit s’appuyer sur le document d’aménagement et sur un diagnostic de terrain pour confirmer d’une part, l’opportunité de planter et d’autre part, l’adaptation des chênes à la station, ou aux stations, aux caractéristique(s) de la zone à planter."
                                            }
                                        ]
                                    }
                                ]
                            }
