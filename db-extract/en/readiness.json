                                "target_senses": [
                                    {
                                        "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Action par laquelle on prépare, on se prépare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71019fbb-6622-41b2-9fd2-f62caa28b892",
                                                "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                                "text": "Entre la poire et le fromage Bianchon arriva, par d’habiles préparations, à parler de la messe, en la qualifiant de momerie et de farce."
                                            },
                                            {
                                                "example_id": "0abdd4a7-6e73-46be-8322-7a906d2cbfc1",
                                                "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                                "text": "Après une minutieuse préparation, tant de la machine que du passager, à 4 heures du matin, je décolle dans les ténèbres, emmenant un solide gaillard Serbe, ex-chef célèbres de comitadjis."
                                            },
                                            {
                                                "example_id": "e795e0ae-f9a6-4084-a670-c7ce56dc4745",
                                                "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                                "text": "Parler, prêcher, plaider sans préparation."
                                            },
                                            {
                                                "example_id": "c864d242-9a19-408c-ae43-040d15f20a83",
                                                "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                                "text": "La préparation d’une conférence, d’une leçon."
                                            },
                                            {
                                                "example_id": "40aa13bc-7189-4453-8500-aa46bb48a903",
                                                "sense_id": "3a01b135-3668-30aa-afa0-fe79c6d53827",
                                                "text": "La préparation d’une offensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c34ba1-a6d7-3269-852f-8901411ceef0",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Action de libérer le terrain des troupes ennemies, avant une d’une attaque, par un tir d’artillerie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c83b1b7-8d8f-34cc-a7cd-7661b206884f",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Méditation, prières par lesquelles on se prépare à dire ou à entendre la messe, à communier, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fefd16be-5f98-343f-8cac-4be2401ab712",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Action d’annoncer quelque chose par degrés et en employant des ménagements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bae2d7f-51b7-40b3-a08e-653f9901e6a7",
                                                "sense_id": "fefd16be-5f98-343f-8cac-4be2401ab712",
                                                "text": "On lui a appris cette triste nouvelle sans préparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Action, de la manière de préparer certaines choses pour les employer ou les garder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f808493-d794-45bf-b5cc-58842c37a3ab",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "La noix verte du cocotier donne une eau rafraîchissante, […]; de l'amande râpée on extraie par compression un lait crémeux qui entre dans la préparation des aliments ; […]."
                                            },
                                            {
                                                "example_id": "ae159622-3053-4e5e-9962-733406f65ed1",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "La préparation des peaux, des laines, des soies."
                                            },
                                            {
                                                "example_id": "ac3342f1-fe1a-42c6-8e21-8ff6d1992b91",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "La préparation de la pâte."
                                            },
                                            {
                                                "example_id": "a1d51237-a33e-4efa-a61a-9efa59b445f3",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "La préparation des mets, des aliments."
                                            },
                                            {
                                                "example_id": "17460a2d-e5a2-432f-9914-7e415ccbaebd",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "La préparation des insectes."
                                            },
                                            {
                                                "example_id": "a342bcb0-e1e4-41c4-963f-df8e8e94559c",
                                                "sense_id": "d52726b9-ec0b-373a-8a44-580fa8a12e55",
                                                "text": "Ils ne faisaient aucune recherche ; leurs préparations les plus complexes étaient le melon au porto, la banane flambée, le concombre à la crème."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82bd7bb-a4c4-3305-8bcb-05b1b74b7802",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Produit résultant de la composition d'un médicament."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec633083-7989-4a12-998a-6591e2114489",
                                                "sense_id": "f82bd7bb-a4c4-3305-8bcb-05b1b74b7802",
                                                "text": "La préparation de ce remède a été mal faite."
                                            },
                                            {
                                                "example_id": "6b03fba9-870c-470a-b41b-75dfd40eb2a7",
                                                "sense_id": "f82bd7bb-a4c4-3305-8bcb-05b1b74b7802",
                                                "text": "Le docteur Léo, de Varsovie, avait aussi recommandé cette préparation dans le choléra de Pologne, et il passait même à ses yeux pour un remède héroïque et presque spécifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Produit phytosanitaire prêt à l’emploi."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5df91f-a9c4-4ff8-aec1-ac7ba3d9c72c",
                                                "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                                "text": "La matière active triasulfuron et la préparation commerciale AMBER® 75WG, utilisées pour lutter contre plusieurs mauvaises herbes latifoliées dans les systèmes de production de blé de printemps au Canada, ont reçu l'homologation complète en août 1992."
                                            },
                                            {
                                                "example_id": "2ac64a71-46c5-406d-81ab-91338e4c81c0",
                                                "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                                "text": "Les produits font l'objet d'un classement en 8 catégories de substances et préparations vénéneuses et 6 catégories de substances et préparations dangereuses, qui en déterminent l’emballage et l’étiquettage commercial sur lequel on peut lire la nature des risques et des conseils de prudence."
                                            },
                                            {
                                                "example_id": "63f5e1fe-7006-4141-bef7-a1ccb1ee4821",
                                                "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                                "text": "Les potions, les pilules, etc., sont des préparations pharmaceutiques."
                                            },
                                            {
                                                "example_id": "9c58c5d0-6c44-4afc-a5b2-7c77e0fd9885",
                                                "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                                "text": "Préparation chimique, Mélange de plusieurs substances en vue d’une expérience."
                                            },
                                            {
                                                "example_id": "743256e7-a94c-4c80-83ae-47a232b6f4fa",
                                                "sense_id": "3b2d20a7-6ab1-311e-ac77-97cd6d217778",
                                                "text": "Préparation anatomique, Pièce de dissection présentant une partie du corps de l’homme ou des animaux préparée de manière à en montrer la structure interne et à en faciliter l’étude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96b8973-5a89-3fe1-8a56-7ce44f32df42",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Application sur la toile de couches de couleur sur lesquelles l’œuvre définitive sera peinte."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46715349-7a93-3e79-a2f2-bd5c80031de3",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Ensemble des opérations permettant d’établir et de rédiger les documents graphiques qui serviront de base à la rédaction définitive d’une carte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9429e9f4-d26e-3668-8b23-bd5ff51d7ef6",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Document qui résulte de l’opération de préparation cartographique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7061d968-7d52-375b-bf4b-92664f1fca18",
                                        "entry_id": "8df06b0d-48ad-3119-815c-e904a68b1dee",
                                        "glosses": [
                                            "Classe préparatoire des grandes écoles."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f510253c-6590-435b-baf1-16c23bb06c58",
                                                "sense_id": "7061d968-7d52-375b-bf4b-92664f1fca18",
                                                "text": "À ce titre, prenez très au sérieux les « khôlles » que vous passez pendant votre préparation, en principe trois en mathématiques supérieures et deux en mathématiques spéciales."
                                            },
                                            {
                                                "example_id": "f6840ec5-058c-45a2-aa6f-a8f2a84c3443",
                                                "sense_id": "7061d968-7d52-375b-bf4b-92664f1fca18",
                                                "text": "Pour ma part, ayant perdu l'année scolaire 1943-1944 à cause des événements dramatiques du Dauphiné à cette époque de guerre, j'ai eu la chance de rentrer directement à l'essai en maths spé au lycée du Parc à Lyon et de ne faire qu'une année de préparation pour rentrer à l’École centrale de Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a78b5e9-6113-4380-bc37-11d1db1fd643",
                        "source_entry_id": "f2cbe200-d30a-3f76-87e0-499a882576ae",
                        "source_sense_description": "state or degree of being ready",
                        "target_lang_word": "Bereitschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bereitschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "das Fertigsein, um etwas zu tun"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0eb7f25-d080-4e60-a98c-2b0d73ce0abe",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "Ich bin in Bereitschaft umzuziehen, sobald ich die Gelegenheit bekomme."
                                            },
                                            {
                                                "example_id": "685de547-017a-4d90-88e0-3d48416d7c09",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "„So auch die Bereitschaft, Sport zu treiben.“"
                                            },
                                            {
                                                "example_id": "68361465-67da-461b-8ae2-e946069e4675",
                                                "sense_id": "7f754d5c-9a08-3373-8dff-a36b9e33e762",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "der Willen, eine anspruchsvolle Aufgabe zu erledigen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec7b065-25b2-4962-8ce1-5971b9d12df6",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Während die Extrembergsteiger sowohl in ihren Veröffentlichungen als auch in ihren Auskünften bei meinen Befragungen eine große Offenheit und ein hohes Reflexionsniveau gegenüber diesen Problemstellungen beweisen, offenbart sich bei vielen anderen Risikogruppen noch ein erheblicher Nachholbedarf an Selbstkritik und Bereitschaft, das Gefahrenpotenzial der eigenen Sportart unvoreingenommen objektivieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "66c219b5-94d6-41b3-afa9-4f783fcb7241",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "Ohne die Bereitschaft, auch mal am Wochenende zu arbeiten, brauchst du dich dort nicht zu bewerben."
                                            },
                                            {
                                                "example_id": "8cca777f-e9e0-4eca-8531-b7f658afa3da",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Zumindest in Österreich-Ungarn und Rußland scheint die dortige innenpolitische Dauerkrise die Bereitschaft unter den Eliten erhöht zu haben, der Endzeitstimmung durch den Schritt zum Krieg zu entkommen.“"
                                            },
                                            {
                                                "example_id": "01506d8b-cbad-4277-8e4e-42b38eecf59a",
                                                "sense_id": "36c4ddc3-2ba9-3219-b4d5-13bcc2812920",
                                                "text": "„Indirekt schlug Traugott von Jagow also vor, die Bereitschaft zur Annahme von Arbeit durch Kürzung von Unterstützungsleistungen zu erhöhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a26c6e52-fa62-3668-a3f7-d289e6905b87",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "Gruppe zum Beispiel von Polizei oder Feuerwehr, die zu einem Einsatz fertig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e5370b-66a9-49d8-9c73-d208d412a914",
                                                "sense_id": "a26c6e52-fa62-3668-a3f7-d289e6905b87",
                                                "text": "Die Bereitschaften von Polizei und Rotem Kreuz waren schnell am Unfallort."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3f16cf27-5aa4-38f6-ada2-d5ed855f9ed8",
                                        "entry_id": "94091ad9-0840-3e56-a25b-43a6bbba7af0",
                                        "glosses": [
                                            "Dienst, bei dem man sich zum Einsatz bereit halten muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556b9b7f-61f6-4414-8b5b-4ab41f417942",
                                                "sense_id": "3f16cf27-5aa4-38f6-ada2-d5ed855f9ed8",
                                                "text": "Ich habe heute Bereitschaft, ich kann nicht in die Kneipe gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
