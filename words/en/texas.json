                {
                    "sense_id": "e895f26c-93c7-3327-84ad-504963707142",
                    "sense_definition": "A former sovereign country in North America that existed from 1836 to 1846.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "places",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The Republic of <w>Texas</w> had its own president and government before joining the Union.",
                            "target_lang_translations": {
                                "ru": "У Республики <w>Техас</w> были свои президент и правительство до вступления в Союз.",
                                "zh": "在加入联邦之前，<w>得克萨斯</w>共和国拥有自己的总统和政府。"
                            }
                        },
                        {
                            "text": "History classes often cover the period when <w>Texas</w> was an independent nation.",
                            "target_lang_translations": {
                                "ru": "На уроках истории часто рассматривают период, когда <w>Техас</w> был независимым государством.",
                                "zh": "历史课通常会讲授<w>得克萨斯</w>作为独立国家的那个时期。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Republic of Texas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшее суверенное государство в Северной Америке, существовавшее с 1836 по 1846 год.",
                        "zh": "得克萨斯共和国，1836年至1846年间存在于北美洲的一个历史主权国家。"
                    },
                    "translations": {
