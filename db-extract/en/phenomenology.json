                                "target_senses": [
                                    {
                                        "sense_id": "c33eaa54-b4d5-3f67-a71c-af34fb7192a0",
                                        "entry_id": "9f12f8f9-fe2b-3e16-b9ec-fded9a97814a",
                                        "glosses": [
                                            "de leer die wil trachten zonder enig vooroordeel de dingen te leren kennen zoals zij zich voordoen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6cc1ae-a48d-37c5-bb0c-347a3eed1cbe",
                                        "entry_id": "9f12f8f9-fe2b-3e16-b9ec-fded9a97814a",
                                        "glosses": [
                                            "de benadering die zich ertoe beperkt een verschijnsel zo grondig en nauwkeurig mogelijk te beschrijven zonder theorievorming over de oorzaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52759245-8163-4e32-91aa-687ad61ced66",
                                                "sense_id": "bc6cc1ae-a48d-37c5-bb0c-347a3eed1cbe",
                                                "text": "Anderzijds kan in de fenomenologie wel geprobeerd worden op basis van de waargenomen verschijnselen uitspraken te doen over mogelijke gevolgen van die verschijnselen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53a8e6f7-2090-45c8-96b2-677f1d3a0806",
                        "source_entry_id": "25441786-96f6-3df2-a74f-2b37dc18d8dd",
                        "source_sense_description": "philosophy based on intuitive experience of phenomena",
                        "target_lang_word": "phénoménologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phénoménologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "576737ed-eb84-304c-973e-6c3623786b1d",
                                        "entry_id": "36b369d1-f4a6-35ec-87d1-0dc3b732316e",
                                        "glosses": [
                                            "(Chez Hegel) Approche philosophique qui commence par l’exploration des phénomènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0a6cda-c48d-4ab1-8dd0-c84e131f0040",
                                                "sense_id": "576737ed-eb84-304c-973e-6c3623786b1d",
                                                "text": "La Phénoménologie de l’esprit, une œuvre majeure de l’histoire de la philosophie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d62314c3-ba06-3008-aefa-7502437d8f56",
                                        "entry_id": "36b369d1-f4a6-35ec-87d1-0dc3b732316e",
                                        "glosses": [
                                            "(Depuis Husserl) Démarche partant de l’expérience en tant qu’intuition sensible des phénomènes afin d’essayer d’en extraire les dispositions essentielles des expériences ainsi que l’essence de ce dont on fait l’expérience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2746896b-6371-4f71-866d-8d1550d26757",
                                                "sense_id": "d62314c3-ba06-3008-aefa-7502437d8f56",
                                                "text": "De la même manière que les cathédrales ont toujours éveillé en moi ce sentiment proche de la syncope que l’on éprouve face à la manifestation de ce que les hommes peuvent bâtir à la gloire de quelque chose qui n’existe pas, la phénoménologie harcèle mon incrédulité à la perspective que tant d’intelligence ait pu servir une si vaine entreprise."
                                            },
                                            {
                                                "example_id": "5a81fbae-f4b2-48b4-b07f-9028e7ed343b",
                                                "sense_id": "d62314c3-ba06-3008-aefa-7502437d8f56",
                                                "text": "Sous l'influence de la phénoménologie, l'usage s'est répandu de désigner l’individualité proprement humaine par le terme technique « ipséité ». Je me demanderai donc comment concevoir une « ipséité »."
                                            },
                                            {
                                                "example_id": "c09ccb71-08de-4462-809a-7bf6c5ccd6c3",
                                                "sense_id": "d62314c3-ba06-3008-aefa-7502437d8f56",
                                                "text": "Où l'on comprend ce qui, pour Robert Misrahi, définit la phénoménologie : non pas un enfumage conceptuel mais une poétique subjective du réel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4885d1a-fd06-3465-9ec4-108e9fec239e",
                                        "entry_id": "36b369d1-f4a6-35ec-87d1-0dc3b732316e",
                                        "glosses": [
                                            "Déroulement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03919981-bab8-4cb1-8b25-3bcf3e0a54c4",
                                                "sense_id": "d4885d1a-fd06-3465-9ec4-108e9fec239e",
                                                "text": "Dans un cas comme dans l’autre, l’alcool s’invite au cœur des interactions et influe largement sur la phénoménologie des débats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a401b7a2-0aff-4654-b725-51cb519ab31a",
                        "source_entry_id": "25441786-96f6-3df2-a74f-2b37dc18d8dd",
                        "source_sense_description": "philosophy based on intuitive experience of phenomena",
                        "target_lang_word": "Phänomenologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phänomenologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6de9744e-c22e-3b81-80cb-a9cfd35fd18a",
                                        "entry_id": "38fb69ec-0a4d-3019-9058-78aaeb44f0b1",
                                        "glosses": [
                                            "Beschreibung und Einteilung der Erscheinungen (Phänomene) in der Natur und Gesellschaft"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "206a630d-1133-47c6-a623-16b8305fb64d",
                                                "sense_id": "6de9744e-c22e-3b81-80cb-a9cfd35fd18a",
                                                "text": "„Da Wissenschaft an sich eine Lehre der Erscheinungen und ihrer Zusammenhänge ist, bezeichnet Phänomenologie eine Methodik, die die deskriptiven Aspekte der Wissenschaft gegen die experimentellen und theoretischen Methoden abgrenzt. Sie bildet somit die Grundvoraussetzung für das Paradigma der Widerspruchsfreiheit zum Beobachtbaren als einzigem gesetzmäßig zugrundeliegendem Wahrheitsbegriff moderner Wissenschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b7949d5-76a5-3eac-8e05-3382b3d2996b",
                                        "entry_id": "38fb69ec-0a4d-3019-9058-78aaeb44f0b1",
                                        "glosses": [
                                            "bedeutende Richtung der Philosophie, von Edmund Husserl (1859–1938) unter Einfluss von Franz Brentano (1838–1917) ab circa 1900 entwickelt, die eine Methode letzter Grundlegung aller Philosophie und sämtlicher Einzelwissenschaften bereitstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86da29c0-d9a0-4aec-a5c2-f29cfc15fab8",
                                                "sense_id": "2b7949d5-76a5-3eac-8e05-3382b3d2996b",
                                                "text": "„Bei Husserl ist Phänomenologie der Name für eine Methode letzter Grundlegung aller Philosophie und sämtlicher Wissenschaften. Jeder Erfahrungswissenschaft liegt eine entsprechende Wesenswissenschaft oder eine regionale Ontologie zugrunde, der jeweils eine bestimmte Einstellung des Bewußtseins zugehöre; […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8cd0ed71-e8b2-3e24-bcce-6cb61ab3d638",
                                        "entry_id": "38fb69ec-0a4d-3019-9058-78aaeb44f0b1",
                                        "glosses": [
                                            "die Erscheinungslehre Georg Wilhelm Friedrich Hegels (1770–1831) aus seiner „Philosophie des Geistes“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d03a01-a424-4985-8e10-fe244a8ffaaa",
                                                "sense_id": "8cd0ed71-e8b2-3e24-bcce-6cb61ab3d638",
                                                "text": "„Hegel nennt ‚Phänomenologie des Geistes‘ jene Darstellung seines Systems, die von den Erscheinungen zur absoluten Idee führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c10a0cbe-ff07-3408-8638-2db859f6f57e",
                                        "entry_id": "38fb69ec-0a4d-3019-9058-78aaeb44f0b1",
                                        "glosses": [
                                            "Immanuel Kants Lehre von den empirischen Erscheinungen im Gegensatz zur Wesenslehre des Dings an sich aus seinen vorkritischen „Metaphysischen Anfangsgründen der Naturwissenschaft“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eacabb9-a545-422f-91f8-7afe8194ff1c",
                                                "sense_id": "c10a0cbe-ff07-3408-8638-2db859f6f57e",
                                                "text": "„Am Anfang der Phänomenologie fasst Kant die Aufgabe derselben auf folgende Weise zusammen: ‚Hier ist nicht die Rede von der Verwandlung des Scheins in Wahrheit, sondern der Erscheinung in Erfahrung.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
