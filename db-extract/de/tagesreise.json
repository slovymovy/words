                ],
                "senses": [
                    {
                        "sense_id": "f6faddd7-ab11-311b-bc21-e5583ba44f4c",
                        "entry_id": "1369fbd0-92ef-300d-9b15-821ad7eecb91",
                        "glosses": [
                            "die einen Tag dauernde Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baa24371-01aa-4e3e-b778-2740fb50b41a",
                                "sense_id": "f6faddd7-ab11-311b-bc21-e5583ba44f4c",
                                "text": "Die Familie Johannson macht jeden zweiten Sonntag eine Tagesreise ins Nachbarland."
                            },
                            {
                                "example_id": "17062530-80be-42d9-90b3-0f7c6bd24595",
                                "sense_id": "f6faddd7-ab11-311b-bc21-e5583ba44f4c",
                                "text": "„Eine Tagesreise mit dem Kahn flussabwärts, und er wäre in Jorate.“"
                            },
                            {
                                "example_id": "9b0ac38d-86cb-4164-846d-0a94edcedc22",
                                "sense_id": "f6faddd7-ab11-311b-bc21-e5583ba44f4c",
                                "text": "„Einige Tagesreisen durch Ägypten genügen, um sich davon zu überzeugen, dass die Pharaonen nicht müde wurden, immer neue Tempel für ihre Götter zu errichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "35ffc804-a27b-3e2f-8097-29a3e9623a6e",
                        "entry_id": "1369fbd0-92ef-300d-9b15-821ad7eecb91",
                        "glosses": [
                            "die an einem Tag zurücklegbare Strecke"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5601dbe0-3df2-40f7-82b7-7214df432030",
                                "sense_id": "35ffc804-a27b-3e2f-8097-29a3e9623a6e",
                                "text": "„Sie waren meist 10 bis 12 Tagesreisen von der Hauptstadt entfernt und führten gewöhnlich über Hindernisse, über feuchtes Moorland und Flüsse, oder sie umkreisten ein felsiges Fjordende an einem abgelegenen Ort.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
