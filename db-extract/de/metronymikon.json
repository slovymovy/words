                                    {
                                        "sense_id": "9a2e3230-0223-35fc-ac3f-75ee61ed6f9a",
                                        "entry_id": "07bddc70-d9f6-3321-bbca-8e7ba4e2031d",
                                        "glosses": [
                                            "Of, relating to, or derived from the given name of one's mother."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545d026f-239b-4450-adf7-29badef2c25c",
                                                "sense_id": "9a2e3230-0223-35fc-ac3f-75ee61ed6f9a",
                                                "text": "In many countries, matronymic surnames can be adopted after the death of the father, although the process is very formal and lengthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ea91cf-0c01-341c-84bd-f20375e2300d",
                                        "entry_id": "07bddc70-d9f6-3321-bbca-8e7ba4e2031d",
                                        "glosses": [
                                            "By extension; of, relating to, or derived from the given name of a female ancestor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
