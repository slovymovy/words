                    "sense_definition": "wydawać na świat potomstwo, powiększając liczbę osobników swojego gatunku (w formie zwrotnej: rozmnażać się)",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W sprzyjających warunkach te owady <w>rozmnażają</w> się w zastraszającym tempie.",
