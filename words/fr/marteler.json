    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c87d1ed5-bc49-35d1-aa8b-2d54ad24ad72",
                    "sense_definition": "Frapper à coups répétés avec un marteau ou un outil similaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le forgeron continue de <w>marteler</w> la barre de métal rougeoyante."
                        },
                        {
                            "text": "Les ouvriers <w>martèlent</w> la tôle avec vigueur pour ajuster la carrosserie."
                        }
                    ],
                    "common_phrases": [
                        "marteler le fer"
                    ]
                },
                {
                    "sense_id": "54230720-0110-3c61-8565-5645009f437a",
                    "sense_definition": "Répéter une idée, une consigne ou une affirmation avec force et insistance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a <w>martelé</w> qu'aucune hausse des taxes ne serait votée."
                        },
                        {
                            "text": "Le directeur <w>martèle</w> son message à chaque réunion hebdomadaire."
                        }
                    ],
                    "synonyms": [
                        "insister"
                    ],
                    "common_phrases": [
                        "marteler un message"
                    ]
                },
                {
                    "sense_id": "f3e2658a-5aa4-332a-ae69-5fb35dece259",
                    "sense_definition": "Prononcer des mots ou jouer des sons en accentuant lourdement chaque élément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_rythme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur furieux <w>martèle</w> chaque syllabe pour impressionner la foule."
                        },
                        {
                            "text": "Le pianiste s'est mis à <w>marteler</w> ces notes avec trop de force."
                        }
                    ],
                    "common_phrases": [
                        "marteler chaque mot",
                        "marteler les syllabes"
                    ]
                },
                {
                    "sense_id": "e1d299c7-fac0-3721-bbf2-0c93c1946e3c",
                    "sense_definition": "Tourmenter l'esprit ou occuper la pensée de façon obsédante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sombre affaire lui <w>martèle</w> l'esprit depuis des semaines."
                        },
                        {
                            "text": "Une pensée coupable ne cesse de me <w>marteler</w> le cerveau."
                        }
                    ],
                    "common_phrases": [
                        "marteler le cerveau",
                        "marteler l'esprit"
                    ]
                },
                {
                    "sense_id": "b7d80b9d-a5d5-3867-8680-fd71cd62f896",
                    "sense_definition": "Marquer une empreinte sur des arbres forestiers désignés pour la coupe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "foresterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier a fini de <w>marteler</w> les chênes dépérissants de la parcelle."
                        },
                        {
                            "text": "Il faut d'abord <w>marteler</w> le bois avant de laisser entrer les bûcherons."
                        }
                    ],
                    "common_phrases": [
                        "marteler les arbres"
                    ]
                }
            ]
        }
    ]
