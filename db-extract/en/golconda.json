                "senses": [
                    {
                        "sense_id": "6f78373c-6977-3946-ad5d-c5b1d841bb03",
                        "entry_id": "ff2f8ba3-0403-31ed-9e5e-bd817c2de02d",
                        "glosses": [
                            "A fortress and ruined city in Telangana, India, historically famous for nearby diamond mining."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd3362c-b8c8-45b3-8730-637e4d1eb3a6",
                                "sense_id": "6f78373c-6977-3946-ad5d-c5b1d841bb03",
                                "text": "Fifty years ago, there were more than twenty places in the kingdom of Golconda, in which diamonds of different sizes were found…"
                            }
                        ]
                    },
                    {
                        "sense_id": "026b2c22-fbf1-3d45-81a9-cc0110b79dfa",
                        "entry_id": "ff2f8ba3-0403-31ed-9e5e-bd817c2de02d",
                        "glosses": [
                            "A small city, the county seat of Pope County, Illinois, United States; named after Golconda in India."
