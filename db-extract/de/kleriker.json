                ],
                "senses": [
                    {
                        "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                        "entry_id": "efc1449b-b343-33dc-92ce-ed76535c585c",
                        "glosses": [
                            "Geistlicher der römisch-katholischen Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9be848e1-786a-4b36-b81a-6d33f65aa34e",
                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                "text": "Ein Kleriker von Augsburg ist Bischof Ulrich."
                            },
                            {
                                "example_id": "0f7d6a74-b386-44b5-8a1a-4a6b7f494fc0",
                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                "text": "„Hierzu bediente man sich zunächst der Hilfe von Klerikern.“"
                            },
                            {
                                "example_id": "28194d07-a4a2-44ef-b790-ab3c2881df67",
                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                "text": "„Tatsächlich muss, wer die Volksmärchen nicht nur der Gebrüder Grimm studiert, einräumen, dass die Kleriker sehr erfolgreich darin waren, bestimmte Frauen als Hexen zu denunzieren.“"
                            },
                            {
                                "example_id": "538c3a27-10ed-4fc5-a582-06e32183a8d2",
                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                "text": "„Die Kleriker kommen vor allem aus Russland und Byzanz - jener Weltregion, die Harald so lange bereist hat und deren Form des Christentums er vor allem kennt.“"
                            },
                            {
                                "example_id": "055643df-192c-47db-9e79-a8142c1d34c5",
                                "sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                                "text": "„Ungefähr ein Dutzend männliche und weibliche Gestalten in der Tracht des 18. Jahrhunderts standen laut singend im Kreis, in dessen Zentrum ein kleiner Herr im langen Rock des Klerikers und in weißer Perücke dazu den Takt schlug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bccb7ad-dc37-4f05-9b1e-15c1e7c92b97",
                        "source_entry_id": "efc1449b-b343-33dc-92ce-ed76535c585c",
                        "source_sense_id": "dc7c0573-81b8-33a2-b68c-da2ac7c1737b",
                        "source_sense_description": "Geistlicher der römisch-katholischen Kirche",
                        "target_lang_word": "clergyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clergyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                        "entry_id": "a86a902f-de41-3127-9379-3ac45148de20",
                                        "glosses": [
                                            "A male member of a clergy; especially, an ordained (male) Christian minister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7437b683-e12e-4ea7-be01-17ce19297c45",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "Holonym: clergy"
                                            },
                                            {
                                                "example_id": "4b5269bd-82af-46db-88dd-f7fc0eb55d34",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "I think if post commanders of the unchaplained posts could employ acceptable clergymen […] then the needs might be met."
                                            },
                                            {
                                                "example_id": "6968f2f4-048f-41a3-a89c-3dacffd6ffb7",
                                                "sense_id": "216b27aa-ae6d-3bd2-8389-17ad30256865",
                                                "text": "The king experienced his first attack in autumn 1788, and as his condition worsened and the physicians-in-ordinary proved unable to cope or cure, the Reverend Dr Francis Willis (1717–1807), a clergyman doctor who ran a madhouse in Lincolnshire, was called in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
