                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9b064e-b209-4c80-a248-2763c2b16cd4",
                                                "sense_id": "ab8e9067-0629-3e2b-931e-e3e8cdd248a3",
                                                "text": "Er wirft den Ball ziemlich weit."
                                            },
                                            {
                                                "example_id": "db960d71-2e98-48f1-bb33-7e36eebffa97",
                                                "sense_id": "ab8e9067-0629-3e2b-931e-e3e8cdd248a3",
                                                "text": "Als sie [die Schriftgelehrten und Pharisäer] nun fortfuhren, ihn zu fragen, richtete er [Jesus] sich auf und sprach zu ihnen: Wer unter Euch ohne Sünde ist, der werfe den ersten Stein auf sie [die Ehebrecherin]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55e0133b-5c19-37cf-b6ae-6b80ad873328",
                                        "entry_id": "cd59f3a6-7502-34a1-8aa9-e5c96e33b745",
                                        "glosses": [
                                            "Jungtiere, Säugetiere gebären, meist bei Tierarten, die mehrere Nachkommen in einem Wurf auf die Welt bringen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "34d622af-91b6-32fb-89d0-05fa214188c9",
