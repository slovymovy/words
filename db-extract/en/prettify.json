                                    {
                                        "sense_id": "6e0e8af5-ccf2-3ae0-b8f5-0174af7de6a7",
                                        "entry_id": "17674182-bc29-3314-99e7-3472dbbd87db",
                                        "glosses": [
                                            "Rendre joli, rendre plus joli, embellir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8bd4129-a28a-44e5-86c6-ba5118286a01",
                                                "sense_id": "6e0e8af5-ccf2-3ae0-b8f5-0174af7de6a7",
                                                "text": "Cette garniture enjolive-t-elle suffisamment bien votre robe ?"
                                            },
                                            {
                                                "example_id": "b4edeba7-76c1-46fd-9fe0-bcd79682938a",
                                                "sense_id": "6e0e8af5-ccf2-3ae0-b8f5-0174af7de6a7",
                                                "text": "Si à son âge elle croit s’enjoliver avec tous ses rubans, elle se trompe."
                                            },
                                            {
                                                "example_id": "c2431957-c800-47c2-a219-36568f217ba9",
                                                "sense_id": "6e0e8af5-ccf2-3ae0-b8f5-0174af7de6a7",
                                                "text": "Les solives énormes du plafond étaient enjolivées de cannelures, finement ciselées."
                                            },
                                            {
                                                "example_id": "cf4c12ed-5b6a-4e05-afce-a50b6c38268d",
                                                "sense_id": "6e0e8af5-ccf2-3ae0-b8f5-0174af7de6a7",
                                                "text": "Il faut dire la vérité nue, la simple vérité, sans chercher à vouloir la travestir, l'interpréter, l'enjoliver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f80325-70d1-328c-bb15-186b7f0d7509",
                                        "entry_id": "17674182-bc29-3314-99e7-3472dbbd87db",
                                        "glosses": [
                                            "Rendre joli, rendre plus joli, embellir.",
                                            "Il est pris parfois avec une intention critique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb828dca-2445-43d5-9e12-eae7e57a4838",
                                                "sense_id": "c1f80325-70d1-328c-bb15-186b7f0d7509",
                                                "text": "Cet écrivain enjolive son style."
                                            },
                                            {
                                                "example_id": "446c433f-8b44-43a0-a4e3-6a3f4376b08c",
                                                "sense_id": "c1f80325-70d1-328c-bb15-186b7f0d7509",
                                                "text": "Enjoliver une histoire, y ajouter des détails pour la rendre plus intéressante."
                                            }
                                        ]
                                    }
                                ]
                            }
