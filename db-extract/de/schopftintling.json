                        "source_sense_id": "dab79ba9-8acd-30df-ba22-f41f3b0a244d",
                        "source_sense_description": "ein ungiftiger Pilz, dessen Fruchtkörper sich in eine tintenartige Substanz auflösen",
                        "target_lang_word": "coprin chevelu",
