                                "target_senses": [
                                    {
                                        "sense_id": "47004919-8cb2-3086-b222-e086737680aa",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "An attempt to cause damage, injury to, or death of an opponent or enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5cbee25-74a7-41a5-85bc-3982809464bd",
                                                "sense_id": "47004919-8cb2-3086-b222-e086737680aa",
                                                "text": "From 1906 to 1960, there were forty-six recorded shark attacks, half of which were fatal."
                                            },
                                            {
                                                "example_id": "3e20a97d-2ad8-468c-8fd7-6bf41ac01cbd",
                                                "sense_id": "47004919-8cb2-3086-b222-e086737680aa",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee9aa315-9e6c-3931-8085-8726eaf1c12c",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "An attempt to cause damage, injury to, or death of an opponent or enemy.",
                                            "Any of several specific maneuvers, skills, or special abilities that a character can use to inflict damage against opponents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0919767f-5843-4bdb-80cd-ff9292d1f750",
                                                "sense_id": "ee9aa315-9e6c-3931-8085-8726eaf1c12c",
                                                "text": "Combat in Mimesis Online is nice and simple. You click on your target […] and then keep right-clicking your chosen attack from the drop down menu. Every time you right click on the attack, your character will swing, shoot, etc."
                                            },
                                            {
                                                "example_id": "18417e2c-ad77-40de-9de0-b60f929d21d1",
                                                "sense_id": "ee9aa315-9e6c-3931-8085-8726eaf1c12c",
                                                "text": "Kleavor has several attacks that it's worth roughly memorising: a charge attack, where it runs at you quickly; a jump attack, that causes a pillar of rock to spike out from under the ground; and a spin attack that does damage in a circle around it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9344790e-7093-3d4e-b4bd-ce51dde73cd1",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "An attempt to detract from the worth or credibility of, a person, position, idea, object, or thing, by physical, verbal, emotional, or other assault."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "982185a7-0886-4f7d-9aef-2b24f3c59729",
                                                "sense_id": "9344790e-7093-3d4e-b4bd-ce51dde73cd1",
                                                "text": "They claimed the censorship of the article was an attack on free speech."
                                            },
                                            {
                                                "example_id": "53bca006-2702-4b35-9686-ed1731379c88",
                                                "sense_id": "9344790e-7093-3d4e-b4bd-ce51dde73cd1",
                                                "text": "“I came down like a wolf on the fold, didn’t I ? Why didn’t I telephone ? Strategy, my dear boy, strategy. This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868d989f-828d-394d-93c8-4282837dd692",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "A time in which one attacks; the offence of a battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66407d2-8566-4ced-91f9-7f6a66b804c6",
                                                "sense_id": "868d989f-828d-394d-93c8-4282837dd692",
                                                "text": "The army timed their attack to coincide with the local celebrations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e2e1b1f-84e1-3814-a9ee-15b5302df607",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "The beginning of active operations on anything."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed0bedb-47bc-4270-b084-a672c3f1a49a",
                                                "sense_id": "7e2e1b1f-84e1-3814-a9ee-15b5302df607",
                                                "text": "Having washed the plates from dinner, I made an attack on the laundry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7991f005-830a-3f98-9f6a-7b4cd335d52c",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
                                            "An attempt to exploit a vulnerability in a computer system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315947b9-c6ca-4133-bb1b-13decb6b8652",
                                                "sense_id": "7991f005-830a-3f98-9f6a-7b4cd335d52c",
                                                "text": "birthday attack; denial-of-service attack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5d12a6-07be-3025-97e8-e08d9a2da718",
                                        "entry_id": "3f4f1537-2d2f-3d54-b060-a5dd83265dec",
                                        "glosses": [
