                        "glosses": [
                            "Agglutiner en même temps (le système portant un antigène et le système portant son anticorps)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4df98fc-ccd6-43be-954a-704b8cfd4742",
                                "sense_id": "95239166-d6f1-36c2-b307-cbfddba296c6",
                                "text": "Les sérums typhiques et paratyphiques peuvent coagglutiner les bacilles d'intoxication carnée;"
                            },
                            {
                                "example_id": "e498cd23-b82d-452b-848b-db79d7b5248b",
                                "sense_id": "95239166-d6f1-36c2-b307-cbfddba296c6",
                                "text": "Widal et Abrami avaient montré dès leur première communication sur la sporo-agglutination que le sérum des malades atteints de mycoses appartenant au groupe des Actinomycoses pouvait coagglutiner et cofixer le Sporotrichum Beurmanm."
                            }
                        ]
