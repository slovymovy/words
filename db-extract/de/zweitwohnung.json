                "senses": [
                    {
                        "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                        "entry_id": "1b51df71-1ac6-384b-8784-02a61ecafdc9",
                        "glosses": [
                            "eine zweite Wohnung an einem anderen Ort als dem Erstwohnsitz, die heute oft aus beruflichen gehalten werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae0eb5f-b8c5-4e58-b634-d495519a1f8f",
                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                "text": "Eine Zweitwohnung ist im Rahmen der doppelten Haushaltsführung steuerlich absetzbar."
                            },
                            {
                                "example_id": "2029afbe-a087-4360-9895-9e50d4aa2e6e",
                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                "text": "„In der DDR leistete sich, wer es konnte, eine Zweitwohnung auf dem Lande.“"
                            },
                            {
                                "example_id": "025977ec-8451-4b8c-a85d-b64cddeef2e0",
                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                "text": "„Bess vermisste ihre alten Freundinnen, und bald kauften die beiden eine kleine Zweitwohnung in der Elizabeth Avenue in Weequahic und unternahmen die zweistündige Fahrt dorthin an jedem Wochenende und an Feiertagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
