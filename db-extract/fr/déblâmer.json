                "senses": [
                    {
                        "sense_id": "644093e7-205a-391a-ae04-2ba266b745b9",
                        "entry_id": "a87de0d0-2480-32a7-9295-c8e63964a306",
                        "glosses": [
                            "Cesser de blâmer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ee9534-a20a-4a38-8c66-ee753a3da2f6",
                                "sense_id": "644093e7-205a-391a-ae04-2ba266b745b9",
                                "text": "Alors, il va falloir le « déblâmer », ce personnage d’aventure, lui rendre son existence légale au lieu de continuer de le payer en monnaie de singe."
                            },
                            {
                                "example_id": "689a0ba6-d1c2-475d-a496-b9b037ed46a8",
                                "sense_id": "644093e7-205a-391a-ae04-2ba266b745b9",
                                "text": "Malheureusement, le 10 mai, Louis XV meurt sans avoir eu le temps de le déblâmer."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e79b548-ea0d-3d1f-8d55-b31b2d8e45f1",
                        "entry_id": "a87de0d0-2480-32a7-9295-c8e63964a306",
                        "glosses": [
                            "Se disculper, se défausser."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7258a170-0db3-4db5-9cd8-a5a15da21f24",
                                "sense_id": "4e79b548-ea0d-3d1f-8d55-b31b2d8e45f1",
                                "text": "Arrêter de se « déblâmer » sur les autres."
                            }
                        ]
                    }
