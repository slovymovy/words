                    {
                        "sense_id": "e6ffc290-2e6d-35eb-a85e-50f7a428d560",
                        "entry_id": "bec38441-d9c6-3dca-9070-f8693c8651cf",
                        "glosses": [
                            "Mitarbeiter/Berater bei diplomatischen Vertretungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7a7fea-5a23-420b-9da4-9559cfd74b12",
                                "sense_id": "e6ffc290-2e6d-35eb-a85e-50f7a428d560",
                                "text": "„Im April 1913 wurde Umezu nach Deutschland und Dänemark entsandt, danach war er Attaché in der Schweiz.“"
                            },
                            {
                                "example_id": "4a38a0fd-a3fe-4352-a15e-3c6c6886584c",
                                "sense_id": "e6ffc290-2e6d-35eb-a85e-50f7a428d560",
                                "text": "„Er war gebürtig aus Livorno, war bei der Gesandtschaft in Neapel Attaché gewesen und mit Herrn de l'Hôpital nach Paris gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a867e93b-13b9-41d3-af3d-2542726aa33b",
                        "source_entry_id": "bec38441-d9c6-3dca-9070-f8693c8651cf",
                        "source_sense_id": "e6ffc290-2e6d-35eb-a85e-50f7a428d560",
                        "source_sense_description": "Mitarbeiter/Berater bei diplomatischen Vertretungen",
                        "target_lang_word": "attaché",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attaché",
