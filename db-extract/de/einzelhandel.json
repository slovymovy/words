                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa38f18-8c52-496c-bdee-0ae926d8517c",
                                "sense_id": "b32f2a8a-f1fb-3c45-a524-5a09e7070b31",
                                "text": "Der deutsche Einzelhandel klagt über Umsatzeinbußen."
                            },
                            {
                                "example_id": "a4bfa40d-b415-40da-b3d9-a9f374e217b7",
                                "sense_id": "b32f2a8a-f1fb-3c45-a524-5a09e7070b31",
                                "text": "„Der deutsche Einzelhandel rechnet in diesem Jahr mit einem Umsatzwachstum von 1,5 Prozent auf 420,6 Milliarden Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
