                        "entry_id": "6b70557b-7766-3c67-9811-f14349ed40e2",
                        "glosses": [
                            "Temperatur, bei der ein reiner Stoff siedet, also beginnt gasförmig zu werden"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "75952da0-b516-4f2a-8960-de5e9db86e28",
                                "sense_id": "84585474-4f77-306f-8eda-8ef6d2d0549d",
                                "text": "Der Siedepunkt hängt vom Umgebungsdruck ab. Er ist auf dem Mount Everest niedriger als auf Meeresniveau."
                            },
                            {
                                "example_id": "2afc96a7-7add-4d94-a897-29673202d195",
                                "sense_id": "84585474-4f77-306f-8eda-8ef6d2d0549d",
                                "text": "Der Siedepunkt stellt die Bedingungen dar, welche beim Phasenübergang eines Stoffes von der flüssigen in die gasförmige Phase vorliegen, was man als Sieden oder Verdampfen bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
