                {
                    "sense_id": "7fc314cb-d315-34f2-8408-a83dfe23e085",
                    "sense_definition": "Under the heavy influence of alcohol or drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They got completely <w>twisted</w> at the party last weekend.",
                            "target_lang_translations": {
                                "ru": "Они вдрызг <w>напились</w> на вечеринке в прошлые выходные.",
                                "fr": "Ils étaient complètement <w>défoncés</w> à la fête le week-end dernier.",
                                "tr": "Geçen hafta sonu partide tamamen <w>uçtular</w>."
                            }
                        },
                        {
                            "text": "He was too <w>twisted</w> to drive, so he called a taxi to get home.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>пьян</w>, чтобы вести машину, поэтому вызвал такси, чтобы добраться домой.",
                                "fr": "Il était trop <w>ivre</w> pour conduire, alors il a appelé un taxi pour rentrer chez lui.",
                                "tr": "Araba kullanamayacak kadar <w>sarhoştu</w>, bu yüzden eve gitmek için taksi çağırdı."
                            }
                        }
