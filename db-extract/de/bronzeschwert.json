                "senses": [
                    {
                        "sense_id": "035588bd-86db-3d02-86ee-8297d5ff30a2",
                        "entry_id": "54c95f2c-0d48-3c5a-b2fa-26bc59d5e2a6",
                        "glosses": [
                            "Schwert, dessen Klinge oder das vollständig aus Bronze besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6206ef50-67be-4638-beb0-8a71b9e4d73a",
                                "sense_id": "035588bd-86db-3d02-86ee-8297d5ff30a2",
                                "text": "„Bei Grabungen an der künftigen ICE-Strecke Erfurt-Halle-Leipzig haben Archäologen ein 3400 Jahre altes Bronzeschwert aus dem Umfeld des Fundortes der Himmelsscheibe von Nebra geborgen.“"
                            },
                            {
                                "example_id": "032240f7-6542-42c4-b864-5e52e6295001",
                                "sense_id": "035588bd-86db-3d02-86ee-8297d5ff30a2",
                                "text": "„Gemeinsam mit der Himmelsscheibe [von Nebra] wurden zwei Bronzeschwerter, zwei Beile, ein Meißel und zwei Armspiralen gefunden.“"
                            },
                            {
                                "example_id": "8d2ad137-584b-4984-81c4-d6082680e21f",
                                "sense_id": "035588bd-86db-3d02-86ee-8297d5ff30a2",
                                "text": "„Schärfere Schneiden von Faustkeilen, Steinäxten oder Bronzeschwertern sollten leichter eine vorgegebene Unterlage spalten, den Kopf eines Gegners inklusive.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
