                "senses": [
                    {
                        "sense_id": "380fe20a-c071-3f21-8e94-279d0f7bb9ca",
                        "entry_id": "9ad3d12a-0386-3419-b0f0-c918e3a87252",
                        "glosses": [
                            "veraltend: Schule, die ausschließlich von Jungen besucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85f1df0-0ddb-46e6-b1b8-9988618d427c",
                                "sense_id": "380fe20a-c071-3f21-8e94-279d0f7bb9ca",
                                "text": "„Rektor Schneider, der Leiter der Knabenschule, war ein Künstler im Umgang mit dem Rohrstock.“"
                            },
                            {
                                "example_id": "58829c47-8ef4-4d4e-ad7d-a613dce527fa",
                                "sense_id": "380fe20a-c071-3f21-8e94-279d0f7bb9ca",
                                "text": "„In Kutama hatte um 1914 der französische Jesuit Jean-Baptiste Loubière eine Missionsschule eingerichtet, die nach dem großen Missionar Asiens in der frühen Neuzeit, Franz Xaver, benannt war und als beste Knabenschule im ganzen Land galt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
