                        "examples": [
                            {
                                "example_id": "ca070ce5-c933-422a-b432-7f0d5bbb526f",
                                "sense_id": "0f7a506d-45e9-301c-bdee-cec528aa3324",
                                "text": "А́нна терпели́во выноси́ла все причу́ды тётки, и́сподволь занима́лась воспита́нием сестры́ и, каза́лось, уже́ примири́лась с мы́слию увя́нуть в глуши́…",
                                "translation": "Anna patiently put up with all her aunt's caprices, gradually set to work on her sister's education and, it seemed, was already reconciled to the idea of fading away in the wilderness . . .",
                                "english": "Anna patiently put up with all her aunt's caprices, gradually set to work on her sister's education and, it seemed, was already reconciled to the idea of fading away in the wilderness . . ."
                            }
                        ]
                    }
