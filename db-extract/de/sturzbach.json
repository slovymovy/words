                "senses": [
                    {
                        "sense_id": "29c3cae1-b958-3622-a671-2fc14a408aa8",
                        "entry_id": "e8257541-485b-305e-9e6a-0a0dace2c3d5",
                        "glosses": [
                            "reißender, herabstürzender Bach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9581665b-3e4c-490a-9ea2-2b97d0620401",
                                "sense_id": "29c3cae1-b958-3622-a671-2fc14a408aa8",
                                "text": "„Anar ließ damals das Blut wie Sturzbäche durch meine Adern strömen.“"
                            },
                            {
                                "example_id": "d00d7140-9681-4859-8183-160c71a6c0e9",
                                "sense_id": "29c3cae1-b958-3622-a671-2fc14a408aa8",
                                "text": "„Einen Moment saßen wir in völliger Dunkelheit, um uns herum nur der brausende Wind und der Regen, der in Sturzbächen herunterprasselte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
