                    {
                        "translation_id": "30250a09-7004-4098-9616-d2fc3c0c4f4b",
                        "source_entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "source_sense_id": "2d0fdb41-fa3d-3e93-9be7-4f899c89495d",
                        "source_sense_description": "Qui bout.",
                        "target_lang_word": "кипучий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кипучий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb67caa-8922-375c-97a8-1efeb00ab62a",
                                        "entry_id": "b8a35da1-f339-35de-8955-485f0ee25404",
                                        "glosses": [
                                            "кипящий, бурлящий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67486e0e-998f-4004-9c41-75e23de6f36d",
                                                "sense_id": "fcb67caa-8922-375c-97a8-1efeb00ab62a",
                                                "text": "Источники, большею частию в первобытном своём виде, били, дымились и стекали с гор по разным направлениям, оставляя по себе белые и красноватые следы. Мы черпали кипучую воду ковшиком из коры или дном разбитой бутылки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb33d4b2-eae1-3ff3-b5e7-4ee8248945de",
                                        "entry_id": "b8a35da1-f339-35de-8955-485f0ee25404",
                                        "glosses": [
                                            "перен. активный, деятельный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5411f7c-e003-4a61-9b7e-7fecbb968f19",
                                                "sense_id": "eb33d4b2-eae1-3ff3-b5e7-4ee8248945de",
                                                "text": "Прохору очень нравилась кипучая работа"
                                            },
                                            {
                                                "example_id": "f53ece5a-655c-41c4-b1ed-0ade41fd5d1a",
                                                "sense_id": "eb33d4b2-eae1-3ff3-b5e7-4ee8248945de",
                                                "text": "Его кипучая работа так заразительно подействовала на всю дюзовую бригаду, только что приступившую к работе, что невозможно было удержаться и не присоединиться к ней."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45ebf22d-76fa-46f2-924e-1b9cb1138f65",
                        "source_entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "source_sense_id": "ccd4d68a-aca7-3135-8407-51f9ef9873bc",
                        "source_sense_description": "Qui est extrêmement chaud.",
                        "target_lang_word": "heiß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heiß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                        "entry_id": "70bc86ec-98e9-3dcf-b369-e2755bccf705",
                                        "glosses": [
                                            "von sehr hoher Temperatur, wärmer als warm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed1986f-bc21-4506-ac2a-6fa874970727",
                                                "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                                "text": "Jetzt ist mir aber heiß."
                                            },
                                            {
                                                "example_id": "b8ea2e17-2e09-436f-ae78-f17a53adec46",
                                                "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                                "text": "Gestern war es heißer als heute."
                                            },
                                            {
                                                "example_id": "714c2b3e-e1ba-46de-9a73-ef2f39fefe49",
                                                "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                                "text": "Warte etwas ab, sonst verbrennst du dir mit der heißen Suppe noch den Mund."
                                            },
                                            {
                                                "example_id": "bd6cc259-ad89-4193-961e-3a48ac55d1c5",
                                                "sense_id": "7e3c7484-59df-33c4-8d8a-229b5de69887",
                                                "text": "„Es war ein sehr heißer Tag, und es wurde immer heißer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7b9fdfd-ee25-3ed8-b3bc-b15ded5abd7b",
                                        "entry_id": "70bc86ec-98e9-3dcf-b369-e2755bccf705",
                                        "glosses": [
                                            "in aufregender/entscheidender Phase befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a677c2f-48f8-44ba-bccf-bb746a3bdd9d",
                                                "sense_id": "a7b9fdfd-ee25-3ed8-b3bc-b15ded5abd7b",
                                                "text": "Das Rennen geht in seine heiße Phase."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9bca0950-9716-3339-b420-fdf17f221a59",
                                        "entry_id": "70bc86ec-98e9-3dcf-b369-e2755bccf705",
                                        "glosses": [
                                            "sexuell aufreizend oder erregt; geil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4498e391-b4ab-4b28-8fa3-98ab1844cb78",
                                                "sense_id": "9bca0950-9716-3339-b420-fdf17f221a59",
                                                "text": "Schaut euch diese heißen Feger an, Jungs!"
                                            },
                                            {
                                                "example_id": "bceb6f3d-d1e3-4ada-812e-10877d8f6370",
                                                "sense_id": "9bca0950-9716-3339-b420-fdf17f221a59",
                                                "text": "Ich bin ganz heiß, wenn ich an diese schnucklige Sekretärin denke."
                                            },
                                            {
                                                "example_id": "557f4c2c-a125-4cef-8172-e7988a328872",
                                                "sense_id": "9bca0950-9716-3339-b420-fdf17f221a59",
                                                "text": "„Dabei wurden er und die sechste Wang so heiß miteinander wie ein Holzkohlenfeuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b117b98e-d32d-33ef-8923-c2e6f2b8f2c7",
                                        "entry_id": "70bc86ec-98e9-3dcf-b369-e2755bccf705",
                                        "glosses": [
                                            "paarungsbereit (bei Tieren, keine Steigerung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b949a7-f8ea-44c0-a9ba-5b28572fe33e",
                                                "sense_id": "b117b98e-d32d-33ef-8923-c2e6f2b8f2c7",
                                                "text": "„Ein Schnupperhengst schnüffelt Stuten heiß, er macht sie an, er ist der Meister des Vorspiels - und darf niemals selber ran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
