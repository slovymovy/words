{
    "word_family": [
        "mariner",
        "maritime",
        "submarine",
        "ultramarine",
        "marina"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "213b6d01-6987-30dc-9b09-a009741efddf",
                    "sense_definition": "relating to, found in, or produced by the sea",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sea-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the impact of plastic pollution on <w>marine</w> life in the Pacific Ocean.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают влияние пластикового загрязнения на <w>морскую</w> флору и фауну в Тихом океане.",
                                "zh": "科学家们正在研究塑料污染对太平洋<w>海洋</w>生物的影响。"
                            }
                        },
                        {
                            "text": "The museum features a large collection of <w>marine</w> biology specimens from around the world.",
                            "target_lang_translations": {
                                "ru": "В музее представлена большая коллекция экспонатов по <w>морской</w> биологии со всего мира.",
                                "zh": "这家博物馆展出了大量来自世界各地的<w>海洋</w>生物学标本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marine life",
                        "marine biology",
                        "marine environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к морю, обитающий в нем или порожденный им",
                        "zh": "与海洋有关的，存在于海洋中的，或由海洋产生的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской",
                                "target_lang_sense_clarification": "связанный с морем или океаном"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海洋的",
                                "target_lang_sense_clarification": "与海洋相关的"
                            },
                            {
                                "target_lang_word": "海上的",
                                "target_lang_sense_clarification": "在海上发生的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bbf65b3-f836-3559-b417-26fca44d9acf",
                    "sense_definition": "relating to shipping, naval forces, or commercial activity at sea",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sea-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company specializes in <w>marine</w> insurance for large cargo vessels crossing the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Компания специализируется на <w>морском</w> страховании крупных грузовых судов, пересекающих Атлантику.",
                                "zh": "该公司专门为横跨大西洋的大型货船提供<w>海运</w>保险。"
                            }
                        },
                        {
                            "text": "He decided to pursue a career in <w>marine</w> engineering to work on ship engines.",
                            "target_lang_translations": {
                                "ru": "Он решил сделать карьеру в области <w>корабельной</w> инженерии, чтобы работать с судовыми двигателями.",
                                "zh": "他决定从事<w>船舶</w>工程，以便研究船用发动机。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "marine insurance",
                        "marine engineering",
                        "merchant marine"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к судоходству, военно-морским силам или коммерческой деятельности на море",
                        "zh": "与航运、海军或海上商业活动有关的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морской",
                                "target_lang_sense_clarification": "судоходный или военно-морской"
                            },
                            {
                                "target_lang_word": "корабельный",
                                "target_lang_sense_clarification": "относящийся к судам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海运的",
                                "target_lang_sense_clarification": "与航运相关的"
                            },
                            {
                                "target_lang_word": "船舶的",
                                "target_lang_sense_clarification": "与船只相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62a80354-c62f-3422-a41f-02ea800bb18e",
                    "sense_definition": "relating to a marine corps or its members",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers underwent rigorous <w>marine</w> training before being deployed overseas.",
                            "target_lang_translations": {
                                "ru": "Солдаты прошли суровую подготовку <w>морской пехоты</w> перед отправкой за границу.",
