                                "target_senses": [
                                    {
                                        "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                        "entry_id": "ffa44153-9ce1-3f5c-94db-08ff96b1fcb7",
                                        "glosses": [
                                            "ohne Wind; ohne Bewegung der Luft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a6df7c-a8da-4577-814c-66b86fa349c0",
                                                "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                                "text": "Gestern war ein windstiller Tag."
                                            },
                                            {
                                                "example_id": "bad25b9d-6751-4679-b72d-488e380b2264",
                                                "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                                "text": "Heute ist es vollkommen windstill."
                                            },
                                            {
                                                "example_id": "e29b559b-569e-4976-8b48-d6f5ebcedc1c",
                                                "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                                "text": "Ist es an der Küste windstill, schalten sich andernorts von selbst Wasserkraft- oder Biogasanlagen zu."
                                            },
                                            {
                                                "example_id": "e6c108b4-79f6-4dc0-a0bc-470674766d49",
                                                "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                                "text": "Immer wenn es draußen stürmte, musste [der Golfer Martin] Kaymer auf den Platz. Als es windstill war, war die andere Hälfte der 156 Golfprofis unterwegs."
                                            },
                                            {
                                                "example_id": "34659839-fad6-416e-a2df-9ebffa90354f",
                                                "sense_id": "593637eb-5490-3b40-a177-3f233bde94af",
                                                "text": "„Und dann in einem Moment, als es vollkommen windstill war, hob sich der Atlantik binnen Sekunden um zwei Meter. Es war gespenstisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
