                "senses": [
                    {
                        "sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                        "entry_id": "3762d3c9-e72e-3fa9-a53a-b271e5d81ed0",
                        "glosses": [
                            "In a clumsy manner or way; without care or finesse, often hurriedly or awkwardly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e387bb-3104-413c-ae85-c06e41debd15",
                                "sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                                "text": "But, bowing with sketchily joined hands, they smiled their way clumsily out, down to the darkness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cb939e2-5f0b-49eb-b335-f0245bf52d2f",
                        "source_entry_id": "3762d3c9-e72e-3fa9-a53a-b271e5d81ed0",
                        "source_sense_id": "6a5b95ef-670f-33e4-9850-40c951ccabab",
                        "source_sense_description": "done without care or finesse, often hurriedly or awkwardly",
                        "target_lang_word": "maladroitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladroitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                        "entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
                                        "glosses": [
                                            "D’une manière maladroite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d54e9f-6676-4781-bbe4-1616ff520d78",
                                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                                "text": "Souriante, avec, cependant, une ombre de mélancolie dans le regard, Yasmina écoutait Jacques lui chanter, maladroitement encore, toute sa passion qu’il n'essayait même plus d’enchaîner."
                                            },
                                            {
                                                "example_id": "e235c044-9c4c-4f77-a349-1a4adde03a4f",
                                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                                "text": "On jouait aux cartes à une table, un groupe lançait des fléchettes sur une cible peinte représentant des bâtiments silhouettés maladroitement, une usine, ou peut-être une centrale nucléaire."
                                            },
                                            {
                                                "example_id": "445083ba-cdfa-4588-9a5f-54ee354d08ec",
                                                "sense_id": "775c9e34-333d-3925-a3cf-9777645e5b46",
                                                "text": "Celle-ci a eu un peu le sort des cathédrales gothiques : on a défleuronné, déformé et maladroitement restauré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
