                        "examples": [
                            {
                                "example_id": "ee9362bd-51c6-4252-990c-07be2aea45c7",
                                "sense_id": "bbec41a3-85e2-34f3-a19d-b224636be197",
                                "text": "Als het in de tekst gaat over de stem van de Geest in het hart, gebruikt Bach de altstem als symbool. Diezelfde alt keert terug als het gaat over het van de Geest vervulde hart."
                            },
                            {
                                "example_id": "34412d63-6362-4569-8f76-8818f84f2bf0",
                                "sense_id": "bbec41a3-85e2-34f3-a19d-b224636be197",
                                "text": "Georgia Dagaki, in 1982 geboren in Athene, stamt uit een Kretenzisch muzikantengeslacht. Ze speelt als een godin en beschikt over een sensuele altstem waarmee ze zingt over verre horizonten en onbereikbare kusten."
                            },
                            {
                                "example_id": "a3368001-45bf-484e-98bf-d0a761372075",
                                "sense_id": "bbec41a3-85e2-34f3-a19d-b224636be197",
                                "text": "Elisabeth Kuhlmann zong even prachtig in de mooiste aria's van dit oratorium die Bach zoals wel vaker voor de altstem zette."
                            }
                        ]
                    }
                ],
