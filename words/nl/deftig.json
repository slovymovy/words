                {
                    "sense_id": "062eac55-a493-3a41-b781-cbae84407005",
                    "sense_definition": "overdreven plechtig of gewichtig op een vervelende manier",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>deftige</w> gedrag begon de andere gasten te irriteren.",
                            "target_lang_translations": {
                                "en": "His <w>pompous</w> behavior began to irritate the other guests.",
                                "fr": "Son comportement <w>guindé</w> commençait à agacer les autres invités."
                            }
                        },
                        {
                            "text": "Doe niet zo <w>deftig</w> en praat gewoon normaal tegen ons.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>stuffy</w> and just talk to us normally.",
                                "fr": "Ne fais pas tant de <w>manières</w> et parle-nous normalement."
                            }
                        }
                    ],
                    "synonyms": [
                        "statig"
                    ],
                    "common_phrases": [
                        "deftig gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "excessively solemn or self-important in an annoying way",
                        "fr": "Excessivement solennel, guindé ou prétentieux de manière agaçante."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pompous",
                                "target_lang_sense_clarification": "affectedly grand or self-important"
                            },
                            {
                                "target_lang_word": "stuffy",
                                "target_lang_sense_clarification": "excessively conventional or formal"
                            },
                            {
                                "target_lang_word": "pretentious",
                                "target_lang_sense_clarification": "attempting to impress by affecting greater importance than is possessed"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "guindé",
                                "target_lang_sense_clarification": "excessivement cérémonieux et manquant de naturel"
                            },
                            {
                                "target_lang_word": "pompeux",
                                "target_lang_sense_clarification": "qui affecte une gravité solennelle et ridicule"
                            },
                            {
                                "target_lang_word": "prétentieux",
                                "target_lang_sense_clarification": "qui se donne de grands airs"
                            }
                        ]
                    }
                }
            ]
        },
        {
