                        "target_lang_word": "fauna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fauna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d314e826-c008-364c-89c6-7190a34e7a97",
                                        "entry_id": "81c49c42-66d7-3bee-ae28-d011a0ab583e",
                                        "glosses": [
                                            "Animals considered as a group; especially those of a particular country, region, time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7fa51d3-6afc-4852-82fb-6a533a5ddf0c",
                                                "sense_id": "d314e826-c008-364c-89c6-7190a34e7a97",
                                                "text": "the flora and fauna"
                                            },
                                            {
                                                "example_id": "8d782996-f182-4f15-a92e-af705ab00149",
                                                "sense_id": "d314e826-c008-364c-89c6-7190a34e7a97",
                                                "text": "Japanese waters also support a rich and diverse shark fauna, including the smallest known shark Squaliolus laticaudus, and the bizarre goblin shark, Mitsukurina owstoni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f894c3f-5c87-3237-95ca-30aba8e02c0e",
