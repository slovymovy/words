                        "parfaite maîtrise"
                    ]
                },
                {
                    "sense_id": "54d46353-6594-334c-892c-831816aa303e",
                    "sense_definition": "Fait de dominer ou de garder le contrôle d'une situation, d'un lieu ou de forces matérielles.",
