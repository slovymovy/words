                        "glosses": [
                            "ruimte waarin de stoppen zijn aangelegd die een elektriciteitsnetwerk beschermen tegen overbelasting en kortsluiting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c47ad95-d4ba-4bb8-97bb-8d6cfeb095dc",
                                "sense_id": "acb20aa0-7421-37ff-b2f0-1562b038d3d5",
                                "text": "De Nederlander was onderweg naar zijn huis in Spanje toen bij de veiligheidscontrole een voorwerp in zijn bagage opviel, meldde de Koninklijke Marechaussee donderdag. Het bleek een onderdeel van een zekeringenkast. Waarvoor hij dat bij zich had, is onduidelijk. Bij de controle kwam ook de openstaande boete aan het licht."
                            },
                            {
                                "example_id": "0d68dcfa-e192-46df-9f12-446f51090adb",
                                "sense_id": "acb20aa0-7421-37ff-b2f0-1562b038d3d5",
                                "text": "Op de gelijkvloerse verdieping van een appartementsgebouw op de Zeedijk in Middelkerke is zondag rond 23 uur brand uitgebroken aan de zekeringenkast."
                            }
                        ]
                    }
