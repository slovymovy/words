                "senses": [
                    {
                        "sense_id": "324834ec-e443-366c-8190-e6a822b0fe49",
                        "entry_id": "a5954f64-096f-3f3d-a4bb-8c2a76b64510",
                        "glosses": [
                            "qualifizierte Mehrheit mit einem Quorum von zwei Dritteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b5f9702-524f-4068-aab5-94bb6580984d",
                                "sense_id": "324834ec-e443-366c-8190-e6a822b0fe49",
                                "text": "Unsere Partei hat die Zweidrittelmehrheit."
                            },
                            {
                                "example_id": "d54e1351-3001-488c-93fd-8dd4f56c978d",
                                "sense_id": "324834ec-e443-366c-8190-e6a822b0fe49",
                                "text": "„Doch dafür fehlt die nötige Zweidrittelmehrheit im Bundestag.“"
                            },
                            {
                                "example_id": "8ccbe1c3-da22-4e84-8fa0-bd064dd80e2b",
                                "sense_id": "324834ec-e443-366c-8190-e6a822b0fe49",
                                "text": "„Dass Viktor Orbán vor seinem 55. Geburtstag (am 31. Mai) die Wahltriumphe von 2010 und 2014 wiederholen und eine neuerliche Zweidrittelmehrheit erreichen würde, hatte kaum jemand erwartet.“"
                            }
                        ],
