                "translations": [
                    {
                        "translation_id": "5f7f090a-8e2f-4f05-bdad-eb6599f8e00a",
                        "source_entry_id": "d2853cf9-6d30-35b2-a1cc-5027cc32fc56",
                        "source_sense_id": "65df79f8-51e9-3c56-a235-5c8483670e75",
                        "target_lang_word": "nadir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nadir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1fc39be-b0f6-365d-9e47-37cdc98c99d9",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The point of the celestial sphere, directly opposite the zenith; inferior pole of the horizon; point of the celestial sphere directly under the place of observation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2955f782-bae9-4b55-8265-47979530700e",
                                                "sense_id": "a1fc39be-b0f6-365d-9e47-37cdc98c99d9",
                                                "text": "[…] when we are Nadyr to the Sunne, we have no ſhadow […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The lowest point; time of greatest depression."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72e2654-1bfd-4906-8928-aa998a4cdcb9",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "Near-synonym: dead"
                                            },
                                            {
                                                "example_id": "27a61637-5e2c-4c3b-a521-fc053857ef64",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "[…] the seventh century is the nadir of the human mind in Europe […]"
                                            },
                                            {
                                                "example_id": "37810354-f6a3-4c2d-a3af-34ff009155f6",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "In this nadir of poetic repute, when the only verse that most people read from one year’s end to the next is what appears on greetings cards, it is well for us to stop and consider our poets."
                                            },
                                            {
                                                "example_id": "344e9c3b-bdf5-4a1f-80f1-2b48b7c460c7",
                                                "sense_id": "9fba883d-6484-3d3c-a3aa-88671340269c",
                                                "text": "The myth describes the dangerous moment of the nadir, the dead of winter, the moment when it is not known whether the world will be re-created and another cycle will bring on another spring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "551370a3-bc3f-3fa4-831d-4f04adde7016",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "The axis of a projected conical shadow; the direction of the force of gravity at a location; down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42da3c48-7451-4ee2-b441-2f697518577e",
                                                "sense_id": "551370a3-bc3f-3fa4-831d-4f04adde7016",
                                                "text": "The nadir of the sun is the axis of the shadow projected by the Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19380e00-61ce-3208-8be7-557e6945bf29",
                                        "entry_id": "72e866de-65ac-3a9e-8bef-5f761e510f1e",
                                        "glosses": [
                                            "An empty box added beneath a full one in a beehive to give the colony more room to expand or store honey."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nadir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6cf3c15-44cf-33c6-b7ca-13d7ee9cb656",
                                        "entry_id": "286f0641-b08a-3e8d-b581-321620600fe6",
                                        "glosses": [
                                            "To extend (a beehive) by adding an empty box at the base."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
