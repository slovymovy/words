                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ef9611d-add6-3506-8c6d-1ad24713dafe",
                        "entry_id": "38e164f8-e7dc-3c77-8351-6944266cbfc3",
                        "glosses": [
                            "The waste that remains after the minerals have been extracted from an ore by ore dressing; the waste from coal mining."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "180e3ced-ea4c-4335-9194-917b2ddd2c3c",
                                "sense_id": "7ef9611d-add6-3506-8c6d-1ad24713dafe",
                                "text": "Meronym: culm"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f34060f-3e9e-3d68-a40a-b458d6269908",
                        "entry_id": "38e164f8-e7dc-3c77-8351-6944266cbfc3",
                        "glosses": [
                            "The weak feints, the last fraction of product obtained at the end of distillation, typically impure and containing fusel oils."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "d5966d6b-f81a-4859-8077-2a4137ac2aa2",
                                "sense_id": "8f34060f-3e9e-3d68-a40a-b458d6269908",
                                "text": "[…] and it is made into a mash which is fermented and distilled in the same way that an ordinary grain mash is handled in a whisky distillery. The tailings from the still are first compressed to extract the water, and[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "044d376d-ba72-398c-9633-a376795809d3",
                        "entry_id": "38e164f8-e7dc-3c77-8351-6944266cbfc3",
                        "glosses": [
                            "Inferior or damaged grain, as well as seeds of other plants (weeds), removed from grain before milling or sowing."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dad55db3-33e1-4421-af2f-59dae0376f39",
                        "source_entry_id": "38e164f8-e7dc-3c77-8351-6944266cbfc3",
                        "source_sense_description": "waste that remains after the minerals have been extracted from an ore",
                        "target_lang_word": "afval",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                        "entry_id": "34b84ade-492c-3b1c-825b-2c1dc21c7b32",
                                        "glosses": [
                                            "onbruikbare resten die weggegooid worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1469735-1b0d-461e-a6a6-8217fdf47c1e",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "Morgen komen ze het afval ophalen."
                                            },
                                            {
                                                "example_id": "ae87c560-1556-482b-9e52-2f17187a1c41",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "Doordat ik vaak dagenlang geen afvalbak tegenkwam, droeg ik altijd een zak vol gebruikte wc-papiertjes bij me. Het was altijd weer een enorme opluchting om in een dorpje mijn wc-papier en ander afval weg te kunnen gooien."
                                            },
                                            {
                                                "example_id": "fd28333b-159b-4e59-bfc3-6fd3b73da78b",
                                                "sense_id": "e72b4e9f-b438-39cc-9d6c-fdac25784ef9",
                                                "text": "‘Wie heeft dat ook alweer gezegd? Over dat afval?’ kreunde ze. ‘Welk afval?’‘Dat de geschiedenis neerkomt op een berg afval die op je neerdondert.’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4e0e7d-7b64-31a7-940d-e96a8d9bdf7e",
                                        "entry_id": "9bfa68eb-45fa-32b0-837d-9faeece5e95b",
                                        "glosses": [
                                            "het afvallen, verlating van een persoon of overtuiging waaraan men eerder was toegewijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be708b7-3ce2-4eb7-a69b-9b31c2520dfe",
                                                "sense_id": "9b4e0e7d-7b64-31a7-940d-e96a8d9bdf7e",
                                                "text": "De grondtoon van het boek getuigt van een cultuurpessimisme, dat vooral tot uiting komt in wantrouwen jegens een volledig geseculariseerde samenleving. De afval van God lijkt vanuit een gelovig gezichtspunt betekenis te hebben, maar dat is volgens hem een vergissing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "921201fe-e585-389b-acbe-05e9fb5ce56a",
                                        "entry_id": "c0a9add1-8ce8-33d3-916c-601f2e120f0a",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van afvallen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5aa5ea3-3ea9-433b-9cca-2df43034940c",
                                                "sense_id": "921201fe-e585-389b-acbe-05e9fb5ce56a",
                                                "text": "... dat ik afval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "524755bb-9319-47be-94d7-a7438a6de419",
                        "source_entry_id": "38e164f8-e7dc-3c77-8351-6944266cbfc3",
                        "source_sense_description": "waste that remains after the minerals have been extracted from an ore",
                        "target_lang_word": "débris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e26bf7-ffcc-410b-b960-a945072012c4",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "f945e94b-3b21-4798-a147-cdc4b405d264",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Si l'on écrase entre deux pierres des grains de blé, l'enveloppe corticale de chaque grain est brisée, et les débris, qui portent le nom de son, se mêlent à la farine provenant de la trituration de la partie intérieure."
                                            },
                                            {
                                                "example_id": "d8dddf08-0176-4803-a9fd-3f6b129ef3b1",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Ce qui m’émerveillait le plus dans les premiers temps, c'était l’étonnante habileté de nos poneys à se tirer d'affaire au milieu d'un chaos de débris volcaniques où un piéton aurait pu difficilement trouver son chemin."
                                            },
                                            {
                                                "example_id": "0b5c0b2f-7245-4667-be59-e998fba24b38",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "D'énormes blocs de corail éblouissants de blancheur sortaient de l'eau et semblaient les débris d'une gigantesque convulsion."
                                            },
                                            {
                                                "example_id": "f70f4fb0-980b-49c8-9eb9-a2793bae9b96",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Après un certains laps de temps, les femmes brûlent les défrichements au feu courant. Ensuite elles ramassent les débris et les réincinèrent en petits tas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Les restes d'un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ee565c-30a4-42c2-a4dd-82dc377b28f3",
                                                "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                                "text": "Les débris d’un souper, les débris d’un pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Ce qui reste d’une chose après sa ruine, sa destruction, son abolition ; bien qui reste à quelqu’un après un revers de fortune ; troupes qui restent après la défaite d’une armée, d’un corps, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d8650d-5f9e-48b6-a01e-140c46772ecb",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Après une journée pendant laquelle j'avais écouté avec terreur le bruit du canon qui se rapprochait incessamment, je vis arriver mon père avec une centaine de cavaliers, débris de trois mille hommes qu'il commandait."
                                            },
                                            {
                                                "example_id": "6c381868-09d2-42b5-ba42-4c091e002877",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Dans les débris de mon opulence se trouvait une somme assez forte en titres étrangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03ec0f33-83d2-391f-bfb9-c4e45619efaa",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Personne physiquement débile."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
