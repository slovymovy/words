        "fr-extract.jsonl": [
            {
                "entry_id": "ea9e4fd4-cab2-3bf8-b12b-6d1c3976efdf",
                "word": "bureaucratique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "55749d1e-d6e6-47ad-a3b8-87fdeb64cbed",
                        "entry_id": "ea9e4fd4-cab2-3bf8-b12b-6d1c3976efdf",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bureaucratiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                        "entry_id": "ea9e4fd4-cab2-3bf8-b12b-6d1c3976efdf",
                        "glosses": [
                            "Relatif à la bureaucratie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa1e0dc-b03c-45d3-bf3a-1b21633435d1",
                                "sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                                "text": "Le jeune captif qui promenait en ce moment son ennui matinal était une victime de la puissance bureaucratique."
                            },
                            {
                                "example_id": "6f6d5757-cc9f-44b2-a832-0fe4fb14ba67",
                                "sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                                "text": "Derrière les grands délires bureaucratiques, il faut rechercher la somme de délires individuels, localisés dans ces secteurs clefs de la société que sont le pouvoir central et les couches dominantes en général."
                            },
                            {
                                "example_id": "c2603abc-c65d-4b6f-beb2-48c469cd667e",
                                "sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                                "text": "Les enlèvements, les mises en détention illégales et la torture systématique étaient une structure parallèle de coercition bureaucratique efficace, apte à semer une terreur sans précédent dans la population : le but était aussi de faire souffrir l'imagination des vivants."
                            },
                            {
                                "example_id": "c041ba9d-586e-464e-bf9a-4fd684ad103f",
                                "sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                                "text": "Sigles bureaucratiques et anglicismes frimeurs à tous les coins de rue : mais que fait l’Académie française ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce1b6bc3-2d23-4331-b255-958d55e368ad",
                        "source_entry_id": "ea9e4fd4-cab2-3bf8-b12b-6d1c3976efdf",
                        "source_sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                        "target_lang_word": "bürokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bürokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                        "entry_id": "3746f71f-a636-36a5-b9a6-b8c869c87e80",
                                        "glosses": [
                                            "sich sehr pedantisch an Regeln haltend / Vorschriften befolgend, dabei autoritär, schwerfällig und unflexibel wirkend"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b33a58-1213-422c-90fa-81e302ecbb13",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Der klassische Schüleraustausch ist beliebt, aber teuer und bürokratisch aufwendig. Viel einfacher ist die Begegnung unterschiedlicher Kulturen übers Netz.“"
                                            },
                                            {
                                                "example_id": "af2ce9af-b236-4102-8769-7deafa4c0091",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Im internationalen Vergleich ist das deutsche Gesundheitssystem […] teuer und bürokratisch.“"
                                            },
                                            {
                                                "example_id": "839de11c-f64b-445c-a53f-c13e950126e6",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Das Beschaffungswesen der Bundeswehr ist noch immer bürokratisch und langwierig.“"
                                            },
                                            {
                                                "example_id": "9ebb35b7-99ad-4f09-b0d5-233a88ce9770",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "[Seit Juni 2017] „dürfen auch in Deutschland homosexuelle Paare ohne größeren bürokratischen Aufwand heiraten.“"
                                            },
                                            {
                                                "example_id": "c3979d5d-749f-43c2-a06f-775696285b91",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Eine Baubewilligung für Fenster in Solardächern ist eine unnötige bürokratische Hürde, findet CVP-Landrat Oberbeck.“"
                                            },
                                            {
                                                "example_id": "ec26dc37-2158-4c55-9e7d-97814854bdb9",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "[China in der Corona-Pandemie:] „Private Straßenhändler, die viele Jahre politisch und bürokratisch bekämpft wurden, erleben in diesen Krisenzeiten einen überraschenden Aufschwung.“"
                                            },
                                            {
                                                "example_id": "53593d4d-03ad-4b10-a486-27ff5d244158",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Einige [der Wohnungslosen] wehren sich jetzt gegen bürokratische Hürden der Stadt München, bevor eine Wohnung zugewiesen wird.“"
                                            },
                                            {
                                                "example_id": "8b6f9b22-ff6a-4b76-a4cf-f59f3c1f2ef0",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Der Thüringer Hotel- und Gaststättenverband Dehoga kritisiert die Gästelisten in Restaurants und Cafés. Hauptgeschäftsführer Dirk Ellinger bezeichnete sie als bürokratisches Monster.“"
                                            },
                                            {
                                                "example_id": "1bff3ac2-0485-4aed-a026-fd6c5d922939",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„[Kunst-]werke, die nicht auf diese Weise [durch Verkauf] \"verwertet\" werden konnten, wurden von Propagandaminister Goebbels 1939 zur Vernichtung freigegeben - fein säuberlich in Listen erfasst. Der Referent in der Abteilung Bildende Kunst, Rolf Hetsch, hatte alle Exponate der \"entarteten Kunst\" bürokratisch genau dokumentiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e64fee0-3787-39d2-8a83-0081174a9449",
                                        "entry_id": "3746f71f-a636-36a5-b9a6-b8c869c87e80",
                                        "glosses": [
                                            "den Regeln einer Verwaltung folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6626dd2-9787-44e2-a5c4-4ae87781ee9d",
                                                "sense_id": "9e64fee0-3787-39d2-8a83-0081174a9449",
                                                "text": "„Deutlicher zu erkennen als der bürokratische Ablauf sind die verschiedenen Elemente, die die Entscheidungsfindung beeinflußten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f18ddfff-50ca-4e87-81c3-0581e7edd725",
                        "source_entry_id": "ea9e4fd4-cab2-3bf8-b12b-6d1c3976efdf",
                        "source_sense_id": "eea5e7e9-90b6-3e0f-999d-2570e5682a18",
                        "target_lang_word": "bureaucratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureaucratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                        "entry_id": "75688055-0839-3f5a-8026-e638a1669d15",
                                        "glosses": [
                                            "Of or pertaining to bureaucracy or the actions of bureaucrats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acef5151-f851-430e-88ae-8e60e77a6edd",
                                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                                "text": "[T. E.] Lawrence said that in the end he felt himself to be fighting not for the imperial British but for the rebellious Arabs. All too often he conflicted with British bureaucratic fustiness."
                                            },
                                            {
                                                "example_id": "42d68f74-b216-4f6a-b341-bdc282f0e3b9",
                                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                                "text": "European Union is legalistic, bureaucratic and runs by precedent."
                                            },
                                            {
                                                "example_id": "9da9fdf1-ab64-4e9e-98eb-f22c0dc9efc7",
                                                "sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                                                "text": "“We aren’t just reducing bureaucratic sprawl. We are realigning the organization with its core mission and our new priorities in reversing the chronic disease epidemic,” Kennedy said on Thursday morning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
