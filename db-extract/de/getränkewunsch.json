                ],
                "senses": [
                    {
                        "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                        "entry_id": "bffd8882-1710-3dc9-bc19-d40ba95cab5d",
                        "glosses": [
                            "Wunsch eines Gastes nach einem bestimmten Getränk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8702c1f2-574a-4f0e-a876-b3394ca69354",
                                "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                                "text": "„Marianne Duden erkundigt sich nach den Getränkewünschen. Der Bundeskanzler bestellt Buttermilch, sein neuestes Getränk, seitdem er gemerkt hat, dass Coca-Cola zu viele Kalorien hat.“"
                            },
                            {
                                "example_id": "782b7d9e-0ba3-4bda-b635-81b5a6e2958c",
                                "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                                "text": "„Haben die Herren schon einen Getränkewunsch?“"
                            },
                            {
                                "example_id": "c3646ae9-9c8a-4b40-ad0e-9ca47006d66b",
                                "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                                "text": "„Die unbestrittene Nummer eins unter deren Getränkewünschen: eine schöne Flasche Bier aufs Zimmer.“"
                            },
                            {
                                "example_id": "9b1549f2-3dd0-496a-adc4-16468684fcbc",
                                "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                                "text": "„Wie gut geschulte Butler erraten japanische Automaten den Getränkewunsch ihrer Kunden und servieren gut gekühlt oder trinkwarm.“"
                            },
                            {
                                "example_id": "849554ab-945f-4b5f-9928-4dfe95050cbf",
                                "sense_id": "59f9ca01-fa67-364d-b871-441193403c30",
                                "text": "„Eine junge Dame im weißen Anzug verspricht, die Organisation werde sich bei der WM 2006 um alles kümmern, Getränkewünsche zur Halbzeit erfüllen oder Ergebnisse manipulieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
