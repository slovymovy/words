{
    "word_family": [
        "témoin",
        "témoigner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14b4b579-4503-349b-a4bd-3a8721053cdc",
                    "sense_definition": "Déclaration faite par une personne sur ce qu'elle a vu ou entendu, notamment devant la justice.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a écouté attentivement le <w>témoignage</w> de la voisine sur le cambriolage."
                        },
                        {
                            "text": "L'avocat a rappelé qu'un faux <w>témoignage</w> devant un tribunal est puni par la loi."
                        }
                    ],
                    "common_phrases": [
                        "faux témoignage",
                        "témoignage oculaire",
                        "recueillir un témoignage"
                    ]
                },
                {
                    "sense_id": "1a14a075-e73b-3b9b-9096-7a8463af86ca",
                    "sense_definition": "Récit dans lequel une personne raconte publiquement son expérience vécue ou ses sentiments.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce documentaire présente le <w>témoignage</w> émouvant d'une femme engagée dans l'aide humanitaire."
                        },
                        {
                            "text": "Le journaliste a recueilli de nombreux <w>témoignages</w> pour raconter la vie des habitants du quartier."
                        }
                    ],
                    "common_phrases": [
                        "témoignage poignant",
                        "livre de témoignages"
                    ]
                },
                {
                    "sense_id": "236f5099-7117-386d-9527-af89b129f8bb",
                    "sense_definition": "Marque extérieure, preuve ou signe visible qui atteste un sentiment ou une réalité historique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preuve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces ruines antiques sont de précieux <w>témoignages</w> du passé romain de la région."
                        },
                        {
                            "text": "Il lui a offert ce cadeau en <w>témoignage</w> de sa profonde reconnaissance."
                        }
                    ],
                    "common_phrases": [
                        "témoignages du passé",
                        "témoignage de reconnaissance",
                        "témoignage d'affection"
                    ]
                }
            ]
        }
    ]
