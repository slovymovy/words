                    {
                        "sense_id": "f224796f-fbcc-30f2-bc53-a1a56bcc8e90",
                        "entry_id": "7b21fb3f-e122-3729-b2cf-66c1691fb260",
                        "glosses": [
                            "Paiement réglé à distance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13bb7143-1926-4095-8d7b-d45ac819faf8",
                                "sense_id": "f224796f-fbcc-30f2-bc53-a1a56bcc8e90",
                                "text": "Ce type de carte, surtout connu pour ses applications de « télépaiement » (carte de téléphone, carte bancaire...), peut aussi avoir d’autres utilisations (carte d’accès au parking, dossier médical portatif,...)."
                            },
                            {
                                "example_id": "fb2eb29e-6bc9-47a9-8199-3ab0d6b5e971",
                                "sense_id": "f224796f-fbcc-30f2-bc53-a1a56bcc8e90",
                                "text": "L’accusé de réception peut être utilisé à chaque télépaiement. Cela oblige le client à noter et conserver l’accusé de réception."
                            },
                            {
                                "example_id": "83ea3f9c-28aa-4e2e-8838-6112f07b5f35",
                                "sense_id": "f224796f-fbcc-30f2-bc53-a1a56bcc8e90",
                                "text": "Le Salon mondial du mobile a dessiné les grandes tendances de la téléphonie mobile de cette année : télépaiement, succès d’Android, surpuissance."
                            }
                        ]
                    }
