                                        "entry_id": "7b6b282f-1895-30da-b74a-e30555eb3f0f",
                                        "glosses": [
                                            "A normal temperature of a room in which people live; typically 20 to 23°C (68 to 73°F); neither heated nor cooled."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
