            {
                "entry_id": "c7e43318-de8b-37b5-a806-951de739dc25",
                "word": "vincible",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
                        "entry_id": "c7e43318-de8b-37b5-a806-951de739dc25",
                        "glosses": [
                            "Capable of being defeated or overcome; assailable or vulnerable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "fd7e7cb6-1ebf-4854-82c9-63fac2915d70",
                                "sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
                                "text": "He, not easily vincible in spirit […] drew his sword."
                            },
                            {
                                "example_id": "90a6c810-6886-425f-8d32-7e2194a0d806",
                                "sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
                                "text": "vincible by human aid"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6195362-c4a6-4492-899c-76232695a7cb",
                        "source_entry_id": "c7e43318-de8b-37b5-a806-951de739dc25",
                        "source_sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
