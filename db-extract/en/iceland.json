                    {
                        "translation_id": "621f7c73-6942-4095-ac76-041e5a9a3eec",
                        "source_entry_id": "bf9aae40-14ce-3407-ba27-e2892014e0cb",
                        "source_sense_id": "dcbee341-a975-3201-85e7-10b7b21eb04f",
