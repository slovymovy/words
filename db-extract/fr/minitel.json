                    {
                        "sense_id": "5fe6cc9f-fb86-3067-a68e-0234f9440266",
                        "entry_id": "c8461ad0-0fc8-300b-b5e8-76650d7871f8",
                        "glosses": [
                            "Terminal de consultation de données vidéotex français."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "7ac642e7-c14e-4cc7-81d3-142fb147171e",
                                "sense_id": "5fe6cc9f-fb86-3067-a68e-0234f9440266",
                                "text": "Il fait très peu de courses et se fait livrer sa nourriture par Minitel."
                            },
                            {
                                "example_id": "e08f36ea-3ef0-48f1-b6bd-0b0fb4751ef9",
                                "sense_id": "5fe6cc9f-fb86-3067-a68e-0234f9440266",
                                "text": "Alors on vous distille cette angoisse à déchiffrer sur des feuilles collées aux portes des lycées, à pianoter sur un Minitel dans le silence fiévreux d’un vestibule – le ronron tout proche de la télévision parle déjà du Tour de France."
                            },
                            {
                                "example_id": "c9fd3b8a-75ea-44c0-89be-c9475ef2b865",
                                "sense_id": "5fe6cc9f-fb86-3067-a68e-0234f9440266",
                                "text": "Le Minitel, à condition que son coût soit suffisamment faible, allait permettre aux PTT de réaliser une importante économie d’échelle, en arrêtant progressivement de distribuer des annuaires papier."
                            }
                        ]
                    }
