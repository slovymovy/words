                    },
                    {
                        "translation_id": "377c453c-adf4-418b-9d30-e570926c3ba0",
                        "source_entry_id": "49b5b13b-1340-3615-8ebb-67d79b0ea45d",
                        "source_sense_id": "bce0f6da-2840-3719-a6b9-72c5c5bf191c",
                        "target_lang_word": "гистамин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гистамин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "87fb0268-8bcf-32bf-9fdd-611770027b4f",
                                        "entry_id": "a0deddd1-40ce-3825-bb26-ea3a5a051d78",
                                        "glosses": [
                                            "биохим., мед. биогенный амин, медиатор нервной системы (вырабатывается особыми нейронами головного мозга) и гормон (вырабатывается тучными клетками соединительной ткани и базофилами крови), производное аминокислоты гистидина, вызывающее расширение сосудов в очаге воспаления, C₅H₉N₃"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9172a814-29ce-482c-b386-09cbc1f534d3",
                                                "sense_id": "87fb0268-8bcf-32bf-9fdd-611770027b4f",
                                                "text": "В момент бурного соединения аллергена с антителом тоже происходят аналогичные процессы. В первую очередь высвобождается гистамин ― продукт декарбоксилирования аминокислоты гистидина. Гистамин ― мощный фактор межтканевого обмена, который при аллергической реакции всегда нарушается."
                                            },
                                            {
                                                "example_id": "ee385e54-76eb-4e7f-94ff-3d72a04e41dc",
                                                "sense_id": "87fb0268-8bcf-32bf-9fdd-611770027b4f",
                                                "text": ".. некоторые из веществ, участвующих в воспалении, например гистамин, тоже вызывают зуд .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
