                        "target_lang_word": "aanbesteding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aanbesteding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "738793ff-1d88-36dd-84f4-77203f83d9d3",
                                        "entry_id": "b659c95a-e024-3220-a288-b771d11860d5",
                                        "glosses": [
                                            "werk dat wordt aangeboden en waar bedrijven zich voor kunnen melden met de voorwaarden waaronder ze dit werk willen verrichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2111778c-33b0-4d9c-b60a-7e3bab7fdd27",
                                                "sense_id": "738793ff-1d88-36dd-84f4-77203f83d9d3",
                                                "text": "De aanbesteding van de bouw van het nieuwe gemeentehuis ging niet door."
                                            },
                                            {
                                                "example_id": "2250bfef-8ac8-45d3-b376-2df78b1d5f7b",
                                                "sense_id": "738793ff-1d88-36dd-84f4-77203f83d9d3",
                                                "text": "\"Bij de aanbesteding van windparken moet ecologie kernonderdeel zijn van de beoordeling\", zei Jetten, die vandaag een werkbezoek bracht aan een groot park voor de kust van Zeeland."
                                            },
                                            {
                                                "example_id": "a3b72c57-3eaf-4911-800a-e64fb5766b27",
                                                "sense_id": "738793ff-1d88-36dd-84f4-77203f83d9d3",
                                                "text": "Ik moet die aanbesteding nog lezen, de gemeente zit op onze offerte te wachten. En die moet vandaag de deur uit."
                                            },
                                            {
                                                "example_id": "bc2bbc53-c13c-417c-b7bc-d9dc744cdf38",
                                                "sense_id": "738793ff-1d88-36dd-84f4-77203f83d9d3",
                                                "text": "Voor grotere projecten is een Europese aanbesteding verplicht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "300f2e6e-900d-38f5-83ec-941bddf0c2e0",
                                        "entry_id": "b659c95a-e024-3220-a288-b771d11860d5",
                                        "glosses": [
                                            "een bedrag dat aan een nog te bereiken doel wordt besteed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb71534-412b-4841-a749-8bb46d0907e2",
                                                "sense_id": "300f2e6e-900d-38f5-83ec-941bddf0c2e0",
                                                "text": "Het gaat om een aanbesteding van meer dan € 100.000."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e08e0b53-e62c-4fa5-ba6c-ba65f70ee72c",
                        "source_entry_id": "0c76b97e-900f-3251-b2df-7d65a95969c9",
                        "target_lang_word": "inschrijving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inschrijving",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                        "entry_id": "440cc64f-92bd-387f-88fd-54f8c0843c2a",
                                        "glosses": [
                                            "de daad van het inschrijven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1824f73-4837-4db5-b320-ed326ed106f0",
                                                "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                                "text": "De inschrijving van de nieuwe studenten kostte aardig wat tijd."
                                            },
                                            {
                                                "example_id": "06e7e8fc-b43f-4301-a751-f3ba1285388f",
                                                "sense_id": "f7ecbce2-fcf7-316b-b6c5-3012187c1cd9",
                                                "text": "De belangstelling voor bloemen en planten die overblijven als de Floriade in Almere binnenkort sluit, is zo groot dat de inschrijving daarvoor per direct is gesloten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                        "entry_id": "440cc64f-92bd-387f-88fd-54f8c0843c2a",
                                        "glosses": [
                                            "een document waarmee men zich opgeeft of inschrijft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed151cc-f4b4-40c1-9e9d-0a2af307a555",
                                                "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                                "text": "We hebben al heel veel inschrijvingen ontvangen."
                                            },
                                            {
                                                "example_id": "defccd1a-5221-4950-b060-485b0fc53140",
                                                "sense_id": "0653accd-a5d2-3512-898b-f217b51b4031",
                                                "text": "De inschrijving sloot afgelopen weekend. Het merendeel van de inzendingen is Engelstalig. Ongeveer honderd liedjes zijn in het Nederlands. Ook zijn er nummers ingestuurd met Franse, Arabische, Turkse, Spaanse en Italiaanse teksten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
