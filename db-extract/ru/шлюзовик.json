                ],
                "translations": [
                    {
                        "translation_id": "3b59ba60-6fe9-4dda-b69a-4f083cdd13f0",
                        "source_entry_id": "41eb1245-933c-33e6-a4d8-b9eba408bded",
                        "source_sense_id": "970a3f24-cc50-3606-bd91-5440c0d79ba7",
                        "target_lang_word": "lockman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lockman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d10020f3-dd97-31ec-bb83-f2c4051b46c2",
                                        "entry_id": "bfb862e4-4264-3d7c-b99f-2737b2c44fe6",
                                        "glosses": [
                                            "A public executioner."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632e4e2c-70e6-4008-9339-dbab8f9a8401",
                                                "sense_id": "d10020f3-dd97-31ec-bb83-f2c4051b46c2",
                                                "text": "In 1780 James Alexander, lockman of Edinburgh, was by the city chamberlain paid for service at an execution 13s. 4d., with a fee of 2s. 6d. for the use of his rope."
                                            },
                                            {
                                                "example_id": "bcbc9661-b5cd-4941-9871-6a93f230899f",
                                                "sense_id": "d10020f3-dd97-31ec-bb83-f2c4051b46c2",
                                                "text": "At his back, the lockman reached up to grasp the noose dangling from the beam."
                                            },
                                            {
                                                "example_id": "8e283f5a-15fa-4fc0-af90-9a4f24a57d8b",
                                                "sense_id": "d10020f3-dd97-31ec-bb83-f2c4051b46c2",
                                                "text": "In contrast, Spanish hangmen had their houses painted bright red, and in France, Italy, and the Netherlands executioners' homes were located as far as possible from the main population and significant political spaces, most often being placed outside of city walls. Here, in the Scottish capital, however, the lockman was purposefully lodged just meters from the burgh's civic, spiritual, and political heart of the mercat cross, St Giles' Cathedral, and Parliament House."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b814a69-a168-3a78-878e-63efb30cb159",
                                        "entry_id": "bfb862e4-4264-3d7c-b99f-2737b2c44fe6",
                                        "glosses": [
                                            "An officer who acts as a kind of undersheriff to the governor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94de174-9f34-42d1-a5e9-1ba71c230546",
                                                "sense_id": "5b814a69-a168-3a78-878e-63efb30cb159",
                                                "text": "the defendent must be summoned by the Coronor or his deputy (a lockman) to appear at the next court day, when the action is called in rotation."
                                            },
                                            {
                                                "example_id": "c431ff97-e480-4cca-8ad9-035310ef6d6b",
                                                "sense_id": "5b814a69-a168-3a78-878e-63efb30cb159",
                                                "text": "I have gone down to vote for a clerk or a lockman; we have pressing letters to go down and vote for a lockman sometimes."
                                            },
                                            {
                                                "example_id": "683b6023-9fcd-4ccd-a309-216a2f3afaf5",
                                                "sense_id": "5b814a69-a168-3a78-878e-63efb30cb159",
                                                "text": "A lockman is appointed for each parish, and acts as deputy or assistant to the coroner."
                                            },
                                            {
                                                "example_id": "7c6f5432-298d-49bd-bbd6-3749ea12bcba",
                                                "sense_id": "5b814a69-a168-3a78-878e-63efb30cb159",
                                                "text": "You see, at the present time a coroner is appointed to a sheading but a lockman only to a parish, so this will bring them both into line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03976c02-e37d-3c0f-b5ab-cca097089a13",
                                        "entry_id": "bfb862e4-4264-3d7c-b99f-2737b2c44fe6",
                                        "glosses": [
                                            "A criminal who is skilled at picking locks and disabling alarm systems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a143cf-4e51-4506-805e-b59ce4cbfd58",
                                                "sense_id": "03976c02-e37d-3c0f-b5ab-cca097089a13",
                                                "text": "The other thing is, a lockman. We need somebody really good, to follow the schematics I got and shut down all the alarms without kicking them on instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0a54d8-1594-36a3-83d3-78871c94b7de",
                                        "entry_id": "bfb862e4-4264-3d7c-b99f-2737b2c44fe6",
                                        "glosses": [
                                            "A man who operates a canal lock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5a91e5-fdae-460e-8307-1878417ebac3",
                                                "sense_id": "fc0a54d8-1594-36a3-83d3-78871c94b7de",
                                                "text": "A lockman while attempting to jump on board the steamer \"St. Francis,\" missed his footing and fell into the canal."
                                            },
                                            {
                                                "example_id": "d882ea6d-56b4-4659-b0f2-6105eca9b439",
                                                "sense_id": "fc0a54d8-1594-36a3-83d3-78871c94b7de",
                                                "text": "The buildinghas been used as a schoolhouse for children of canal employees for several years, but upon the appointment of a lockman for that lock the house was needed for his residence."
                                            },
                                            {
                                                "example_id": "677b9f1a-2c50-4840-8ee3-a165d9fbc02a",
                                                "sense_id": "fc0a54d8-1594-36a3-83d3-78871c94b7de",
                                                "text": "The next day, at the Winfield Lock, a smiling young lockman waved us in."
                                            },
                                            {
                                                "example_id": "ef26fa10-8e6f-4d81-b375-2242d9c7b44c",
                                                "sense_id": "fc0a54d8-1594-36a3-83d3-78871c94b7de",
                                                "text": "Lock operations required both the lockmaster and lockman, often supplemented by deckhands on a towboat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1f40e7-095d-4d58-891c-831dd4f87d46",
                        "source_entry_id": "41eb1245-933c-33e6-a4d8-b9eba408bded",
