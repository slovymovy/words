                        "sense_id": "21b4dc77-0bb6-3d29-8403-f32f9367f067",
                        "entry_id": "4e9db29b-3d84-3acf-9bb7-e0fd30b4d60b",
                        "glosses": [
                            "подделать, исказить с целью выдать за подлинное, настоящее"
