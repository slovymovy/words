                                    {
                                        "sense_id": "9741dacf-b3fc-3e64-b945-240ff311404b",
                                        "entry_id": "a156751d-bb4e-3d19-a1db-eef0a5c419a4",
                                        "glosses": [
                                            "židovské náboženské učení předávané v minulosti pouze ústní tradicí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da371cd-7d2f-4836-9187-805673491e2d",
                                                "sense_id": "9741dacf-b3fc-3e64-b945-240ff311404b",
                                                "text": "Učím se talmudu. Již dříve jsem měl rád tyto nekonečné rozpravy starověkých rabínů mezopotamských o rozličných tématech rituelních a právních, jejich legendy, mravní ponaučení, přísloví, anekdoty, paradoxy, jež tvoří talmud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991bc60a-eac3-3d60-ab66-9e2d98de7a3a",
                                        "entry_id": "a156751d-bb4e-3d19-a1db-eef0a5c419a4",
                                        "glosses": [
                                            "dílo zaznamenávající židovskou náboženskou tradici"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9578ac1d-719c-42d4-9dfb-9b3845ebc87b",
                                                "sense_id": "991bc60a-eac3-3d60-ab66-9e2d98de7a3a",
                                                "text": "Talmud vypráví o jednom zbožném muži, který teprve při manželčině pohřbu poznal, že měla místo nohy — dřevěnou protézu. Ten člověk byl učitelem. — Potud talmud."
                                            }
                                        ]
                                    }
                                ]
