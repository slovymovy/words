                        "entry_id": "5ad3939a-ecde-34e4-82ba-71127e4f5dc5",
                        "glosses": [
                            "lekko zabarwiony na żółto, podobny do koloru żółtego; niezupełnie żółty, prawie żółty"
                        ],
                        "tags": [],
                        "examples": [
