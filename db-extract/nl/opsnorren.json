    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "8de3f5e4-9657-337b-a345-a2b3921f8256",
                "word": "opsnorren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53f28e33-7aab-30ca-a355-abf40d6806df",
                        "entry_id": "8de3f5e4-9657-337b-a345-a2b3921f8256",
                        "glosses": [
                            "zoeken en vinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740ee68e-6667-4a2b-9515-ae35a41a5c9f",
                                "sense_id": "53f28e33-7aab-30ca-a355-abf40d6806df",
                                "text": "Nu doet de Anne Frank Stichting dat wel. In een onderzoeksrapport legt Gertjan Broek, historicus bij de stichting, uit waarom het goed mogelijk is dat de Joodse familie bij ­toeval ontdekt werd in het Achterhuis. Zo is er pas twintig jaar na de feiten sprake van het verkliktelefoontje, in een verklaring van SS-officier Silberbauer. In 1944 waren de meeste telefoonverbindingen afgesloten, stelt Broek, en kon je het nummer van de Sicherheitsdienst niet zomaar opsnorren in een telefoonboek."
                            },
                            {
                                "example_id": "12a1b5a5-f065-43bf-a759-718035571ea6",
                                "sense_id": "53f28e33-7aab-30ca-a355-abf40d6806df",
                                "text": "De politie vermoedt dat dieven eerst naam- en bankgegevens van hun potentiële slachtoffers opsnorren, bijvoorbeeld door tussen het oud papier te kijken, en vervolgens een nieuwe pinpas op hun naam bestelden. Op de dag dat de post de nieuwe pas zou moeten bezorgen, plakken ze de brievenbus van de bewoners af en zetten er een groene plastic bus naast, in de hoop dat de postbode daar de post in stopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "886311ee-201a-4d33-9304-ee351c2a0f07",
                        "source_entry_id": "8de3f5e4-9657-337b-a345-a2b3921f8256",
                        "source_sense_id": "53f28e33-7aab-30ca-a355-abf40d6806df",
                        "source_sense_description": "zoeken en vinden",
                        "target_lang_word": "pick up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pick up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3540f6b6-e398-3036-91f3-b9037ede6ad9",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To lift; to grasp and raise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e33f1350-163a-4584-b4ef-4016077d2a44",
                                                "sense_id": "3540f6b6-e398-3036-91f3-b9037ede6ad9",
                                                "text": "When you pick up the bag, make sure to support the bottom."
                                            },
                                            {
                                                "example_id": "8c3b276a-d474-46c8-a902-4f61b1a30c48",
                                                "sense_id": "3540f6b6-e398-3036-91f3-b9037ede6ad9",
                                                "text": "Evidently some, or all, of the boars immolated themselves, for the train crew are reported to have picked up three dead boars and continued to Sézanne, the next stop, where they gave them to the local hospital cooks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea451d10-4720-3d33-b0c0-0a6edc8fa7b6",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To collect an object, especially in passing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67955a7d-3323-4d26-ab77-1fe3f6ec133b",
                                                "sense_id": "ea451d10-4720-3d33-b0c0-0a6edc8fa7b6",
                                                "text": "Can you pick up a pint of milk on your way home?"
                                            },
                                            {
                                                "example_id": "036d972d-3e37-4a62-bede-818024051e48",
                                                "sense_id": "ea451d10-4720-3d33-b0c0-0a6edc8fa7b6",
                                                "text": "\"I don't want to spoil any comparison you are going to make,\" said Jim, \"but I was at Winchester and New College.\" ¶ \"That will do,\" said Mackenzie. \"I was dragged up at the workhouse school till I was twelve. Then I ran away and sold papers in the streets, and anything else that I could pick up a few coppers by—except steal.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d713d89-0696-3f85-900d-05e4ff2a9c8a",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To acquire (something) accidentally; to catch or contract (a disease)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63b72b0-99a6-4833-9ef8-b093095ef336",
                                                "sense_id": "1d713d89-0696-3f85-900d-05e4ff2a9c8a",
                                                "text": "I picked up a cold on my trip last week."
                                            },
                                            {
                                                "example_id": "c20f6e0b-dcc1-489e-862d-e941ecb9c390",
                                                "sense_id": "1d713d89-0696-3f85-900d-05e4ff2a9c8a",
                                                "text": "Cars often pick up bits of road tar and asphalt, dried bugs, tree sap, or other debris that’s hard to remove with regular car wash soap."
                                            },
                                            {
                                                "example_id": "3e83a0b6-e066-497f-98d2-553fe278af7e",
                                                "sense_id": "1d713d89-0696-3f85-900d-05e4ff2a9c8a",
                                                "text": "We are constantly being exposed to fungi, whether by picking up spores on our skin or eating food on which fungi are hitchhiking. Most of them won’t take up residence in our bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78e72b03-ea46-3b35-b4b3-64e9d4676e71",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To clean up; to return to an organized state."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "226e7c5b-226f-4233-a192-5dbd29d75464",
                                                "sense_id": "78e72b03-ea46-3b35-b4b3-64e9d4676e71",
                                                "text": "Aren't you going to pick up after yourself?"
                                            },
                                            {
                                                "example_id": "3a3f6b6d-347b-4bf4-80d2-060268f45cb1",
                                                "sense_id": "78e72b03-ea46-3b35-b4b3-64e9d4676e71",
                                                "text": "The floor was strewn with bright snips of origami paper, a crumpled drawing, and one dirty sock, which Amy now shoved under the bed with her foot. ¶ \"You're lucky,\" said Marla. \"My mother makes me pick up my room every single day.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669ea7a1-918a-3614-90fd-8fa4259266f0",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To collect a passenger."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6987c5d7-df34-42ef-bcc6-64dab5488fe9",
                                                "sense_id": "669ea7a1-918a-3614-90fd-8fa4259266f0",
                                                "text": "I'll pick you up outside the library."
                                            },
                                            {
                                                "example_id": "126138d9-8d84-49e1-bb8c-7dfef77bde0b",
                                                "sense_id": "669ea7a1-918a-3614-90fd-8fa4259266f0",
                                                "text": "After picking up a few passengers (most likely heading into Exeter for shopping) and setting a few off (for a day at the beach), we get the 'right away' and continue along the sea wall with its iconic sandstone cliffs on the left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e891d875-70c5-3444-8c98-228dd98e3453",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To collect and detain (a suspect)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a5489cf-22d7-4a74-a209-51a526c2dee5",
                                                "sense_id": "e891d875-70c5-3444-8c98-228dd98e3453",
                                                "text": "The cops have picked up the man they were looking for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031c3ec5-a19d-3741-b105-cbbee026d0bb",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To obtain and publish a story, news item, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b05f467-258c-46a3-ae0f-e05ab3b8c2de",
                                                "sense_id": "031c3ec5-a19d-3741-b105-cbbee026d0bb",
                                                "text": "The story does not seem to have been widely picked up."
                                            },
                                            {
                                                "example_id": "5a49a500-f6ea-4133-aab5-e680be57fe69",
                                                "sense_id": "031c3ec5-a19d-3741-b105-cbbee026d0bb",
                                                "text": "News of this notice from the university was picked up by local media and had the effect of raising the ire of some citizens who saw this as an attack on ‘Chinese heritage’[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f94b071-5df4-3343-825f-2e53e69a7347",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To improve, increase, or speed up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4412b935-de6c-4c8b-9b51-ca97b4c27424",
                                                "sense_id": "8f94b071-5df4-3343-825f-2e53e69a7347",
                                                "text": "Prices seem to be picking up again."
                                            },
                                            {
                                                "example_id": "c6c42a14-cd58-49ac-bb21-29761041e82f",
                                                "sense_id": "8f94b071-5df4-3343-825f-2e53e69a7347",
                                                "text": "I was in bed sick this morning, but I'm picking up now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f73eaa9c-51e9-341e-ac3c-ef8bbbccae24",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To restart or resume."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295634b3-8be1-4cae-bbbb-ba3646043db6",
                                                "sense_id": "f73eaa9c-51e9-341e-ac3c-ef8bbbccae24",
                                                "text": "Let's pick up where we left off yesterday."
                                            },
                                            {
                                                "example_id": "f111d9b8-a748-4464-82d2-03e2730f5bc1",
                                                "sense_id": "f73eaa9c-51e9-341e-ac3c-ef8bbbccae24",
                                                "text": "The plot picks up where the last film left off. The High Table, the organisation that controls crime around the world, has a multi-million-dollar contract out on Wick, who killed a High Table member."
                                            },
                                            {
                                                "example_id": "f7b900c4-4df7-42b7-91e5-545d1e97478f",
                                                "sense_id": "f73eaa9c-51e9-341e-ac3c-ef8bbbccae24",
                                                "text": "Picking up eight years after The Dark Knight left off, the film finds Gotham enjoying a tenuous peace based on Harvey Dent’s moral ideals rather than the ugly truth of his demise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b36521ba-6509-3081-ae17-e38e14e4a618",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To reach and continue along (a road)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83e25074-e693-43ad-ab60-84263f66c36d",
                                                "sense_id": "b36521ba-6509-3081-ae17-e38e14e4a618",
                                                "text": "Miller brought his car from the underground garage and threaded a way through London's traffic to pick up the A5."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8e8675f-17b2-3c74-8e83-b23963735592",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To learn, to grasp; to begin to understand; to realize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b014efce-f48b-4c4b-8193-3cbf39a3b6fc",
                                                "sense_id": "a8e8675f-17b2-3c74-8e83-b23963735592",
                                                "text": "It looks complicated, but you'll soon pick it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9b0bb0-69b3-30c8-b72a-5dc49880dceb",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To receive (a radio signal or the like)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bf26bf5-52a9-47cc-90b3-ee0dcf4f4a36",
                                                "sense_id": "6a9b0bb0-69b3-30c8-b72a-5dc49880dceb",
                                                "text": "With the new antenna, I can pick up stations all the way from Omaha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bf61c72-6c4e-3e6a-bf6c-4382e75e3bbc",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To notice, detect or discern; to pick up on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5498294e-dbba-41e2-b882-3cfac339c17b",
                                                "sense_id": "1bf61c72-6c4e-3e6a-bf6c-4382e75e3bbc",
                                                "text": "Did you pick up his nervousness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6907e2da-7465-3834-8b7e-1a26d17afad4",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To point out the behaviour, habits, or actions of (a person) in a critical manner; used with on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28b53004-47b1-46ff-b0ab-56a2ccc53f17",
                                                "sense_id": "6907e2da-7465-3834-8b7e-1a26d17afad4",
                                                "text": "She's always picking me up on my grammar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2922c9c-a034-32e4-8895-275d008fc563",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To meet and seduce somebody for romantic purposes, especially in a social situation."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebad85a-f38c-417a-b012-32b1391df91f",
                                                "sense_id": "a2922c9c-a034-32e4-8895-275d008fc563",
                                                "text": "He was in the fabric store not to buy fabric but to pick up women."
                                            },
                                            {
                                                "example_id": "33bcee22-d6ea-4d4f-abd6-31c32c1172fe",
                                                "sense_id": "a2922c9c-a034-32e4-8895-275d008fc563",
                                                "text": "Xavier—first seen as an adult in First Class trying to pick up a woman in a bar—is impotent, at least metaphorically, and will eventually see all of his luxuriant hair fall out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d3b8e1b-7531-3604-b3c1-9154f107765c",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To answer a telephone."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14968f6f-cdc9-4aca-aa96-7058ac1c772f",
                                                "sense_id": "8d3b8e1b-7531-3604-b3c1-9154f107765c",
                                                "text": "I'm calling him, but he just isn't picking up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86196e12-1e46-3cf5-b04c-2db6b2124029",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To receive calls; to function correctly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47bf8d25-5414-4b4f-9e16-84cfbd047474",
                                                "sense_id": "86196e12-1e46-3cf5-b04c-2db6b2124029",
                                                "text": "I've tried his home number a couple times, but it isn't picking up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2c18f1-5d7d-3e00-bb52-cdbf97e7d0d2",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To pay for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d636b1b-b6d0-4e1a-a056-9a47d17a319d",
                                                "sense_id": "0e2c18f1-5d7d-3e00-bb52-cdbf97e7d0d2",
                                                "text": "The company will pick up lunch with customers for sales calls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34377d20-37b3-38e2-8832-741a3f5380cb",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To reduce the despondency of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82ff4fbf-9399-4bf7-9569-7c931a3a5939",
                                                "sense_id": "34377d20-37b3-38e2-8832-741a3f5380cb",
                                                "text": "[…]they pick me up when I'm feeling blue"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9021cdf3-8400-3760-a93f-6de19138d509",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To take control (physically) of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cef830c6-d9fe-4163-9c81-b8d56f149b91",
                                                "sense_id": "9021cdf3-8400-3760-a93f-6de19138d509",
                                                "text": "Bolton were then just inches from taking the lead, but the dangerous-looking Taylor drilled just wide after picking up a loose ball following Jose Bosingwa's poor attempted clearance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea9b5174-7954-3f25-a759-2a679fd8c21c",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To mark, to defend against an opposition player by following them closely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "220d928f-d5a1-4a6c-8a18-d57c269f5a03",
                                                "sense_id": "ea9b5174-7954-3f25-a759-2a679fd8c21c",
                                                "text": "And soon after, no-one picked up Shotton who was free to power a 12-yard header over from another Pennant corner, before Pennant sent a free kick straight at Cardiff keeper Tom Heaton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3d744d-bb3c-3f39-ad01-7152c1dc8db7",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To record; to notch up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4645c6-79c6-46b6-a6d6-5d45f8fea924",
                                                "sense_id": "da3d744d-bb3c-3f39-ad01-7152c1dc8db7",
                                                "text": "And the home side survived without any late scares to pick up the first win of their Group F campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8381b16-65e3-3919-a16f-45ea1035d650",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To behave in a manner that results in a foul."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df16d1d3-83a5-3867-b949-fe927646e539",
                                        "entry_id": "8e327c0f-7848-3ebc-9737-337ffbb30467",
                                        "glosses": [
                                            "To promote somebody who was previously passed over."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef21f789-2597-45fe-9eb5-84a211d42d9f",
                                                "sense_id": "df16d1d3-83a5-3867-b949-fe927646e539",
                                                "text": "[…] there are now 98 officers of that rank who have been passed over one or more times, most of whom have little prospect of being picked up by future selection boards but will await only the completion of 21 years' service before going on the retired list."
                                            },
                                            {
                                                "example_id": "2b603b36-b587-46e5-a4cb-8c369175051c",
                                                "sense_id": "df16d1d3-83a5-3867-b949-fe927646e539",
                                                "text": "The list is about the same as when each class was commissioned, except for a small percentage who were passed over once or twice and then picked up."
                                            }
                                        ]
                                    }
                                ]
                            },
