                                    {
                                        "sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                                        "entry_id": "2aa9c183-1a74-3070-9161-342afa10062a",
                                        "glosses": [
                                            "An expert in ichthyology: one who studies fishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d247e45e-1f3f-43f9-90f4-1d9531497c23",
                                                "sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                                                "text": "Meanwhile, the other two main actors, Richard Dreyfuss as boyish ichthyologist Hooper and Robert Shaw as grizzled shark-hunter Quint, further added to the deepening of the dramatis personae by the paradoxical boon that they loathed each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4872d31-e69c-44b2-8d02-b5d7d08c62e8",
                        "source_entry_id": "1cb99a30-788f-3dd2-b525-40503ee15076",
                        "source_sense_id": "4bbfeef5-e029-3187-86ef-1d862fb283b3",
                        "target_lang_word": "ichtyolog",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5165ac18-f2cd-4a55-80de-d5ddf14683c0",
                        "source_entry_id": "1cb99a30-788f-3dd2-b525-40503ee15076",
                        "source_sense_id": "4bbfeef5-e029-3187-86ef-1d862fb283b3",
                        "target_lang_word": "ichtyologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichtyologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                        "entry_id": "38d97e85-03a8-3631-b158-870ce1432086",
                                        "glosses": [
                                            "Spécialiste de l’étude des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa3d805-5193-4d15-a43f-3282c9662b1e",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Il se plonge dans la lecture du manuscrit et découvre alors que ce Risso fut ce qu’on appelle maintenant un ichtyologue, expert en poissons de la Méditerranée."
                                            },
                                            {
                                                "example_id": "a527a77c-f6e8-4411-aae2-3919d91dcb1c",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Sur 200 mètres d’un ruisseau guyanais, des ichtyologues ont recensé 70 espèces de poissons, à comparer aux 81 espèces de l’Hexagone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39de41e1-6263-4d7a-931a-d8fd06056ee0",
                        "source_entry_id": "1cb99a30-788f-3dd2-b525-40503ee15076",
                        "source_sense_id": "4bbfeef5-e029-3187-86ef-1d862fb283b3",
                        "target_lang_word": "ichthyologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichthyologue",
                                "target_lang_code": "fr",
                                "target_senses": [
