                                        "entry_id": "eaeebed2-1e76-3614-be3d-4a14ce876f9d",
                                        "glosses": [
                                            "Île du Pacifique occidental, en Micronésie, au sud de l’équateur."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0104a4c-38e9-3fe0-8b4e-fbe4bbc19248",
                                        "entry_id": "eaeebed2-1e76-3614-be3d-4a14ce876f9d",
                                        "glosses": [
                                            "État d’Océanie, dont le territoire est constitué de l'île ci-dessus. Sa capitale est Yaren."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8df97a-645e-4512-98e7-88d0d7f6f444",
                                                "sense_id": "a0104a4c-38e9-3fe0-8b4e-fbe4bbc19248",
                                                "text": "Ce paradis, c’est l’île de Nauru (prononcer naourou), un tout petit point de 8,2 milles carrés, perdu dans l’immensité bleue du Pacifique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12bc4a99-eade-483e-a12c-2004f0e09762",
                        "source_entry_id": "27224674-2c67-3c07-a870-dfde74a586cf",
                        "source_sense_description": "Republic of Nauru",
                        "target_lang_word": "Nauru",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
