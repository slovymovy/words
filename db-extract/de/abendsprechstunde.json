                "senses": [
                    {
                        "sense_id": "a109b8f9-f565-3ad2-a318-092ecce6302a",
                        "entry_id": "2897f037-173e-360e-8154-1be9f6be1990",
                        "glosses": [
                            "Sprechstunde während der Abendzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe893c5-1df2-4305-a71d-73a7c1330fb2",
                                "sense_id": "a109b8f9-f565-3ad2-a318-092ecce6302a",
                                "text": "„In der Bauhütte muss jeder Lehrer zusammen mit einem Sozialpädagogen auch regelmäßig Abendsprechstunden für Schüler, Eltern und Ehemalige halten.“"
                            },
                            {
                                "example_id": "80553236-a2df-434f-8f35-92d68ea8eba2",
                                "sense_id": "a109b8f9-f565-3ad2-a318-092ecce6302a",
                                "text": "„Wichtig ist der Abbau der Impfhürden, die im Alltag der Menschen den Zugang zu Impfangeboten erschweren, zum Beispiel mit regelmäßigen Aktionen am Arbeitsplatz oder in der Freizeit, mit Abendsprechstunden, Impfaktionstagen in Praxen, Apotheken und Schulen, der Frage nach dem Impfausweis bei jedem Arztkontakt und der Steigerung der Relevanz von Impfungen auch in der Ausbildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
