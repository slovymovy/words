                                                "sense_id": "3cfb6ef2-df1f-3f14-bdab-12635f81b956",
                                                "text": "Er kann alle Spielerdaten auswendig."
                                            },
                                            {
                                                "example_id": "9345910d-8d86-4362-8012-989c6f3eb354",
                                                "sense_id": "3cfb6ef2-df1f-3f14-bdab-12635f81b956",
                                                "text": "Das Gedicht wird auswendig vorgetragen."
                                            },
                                            {
                                                "example_id": "90d32e7f-42d2-4477-a33b-cba444b97b5b",
                                                "sense_id": "3cfb6ef2-df1f-3f14-bdab-12635f81b956",
                                                "text": "[…] „Czentovic brachte es nie dazu, auch nur eine einzige Schachpartie auswendig – oder wie man fachgemäß sagt: blind – zu spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
