                        "glosses": [
                            "Désinfecter avec du crésyl."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8c44df-f5eb-4f3c-8781-6963db4dbea5",
                                "sense_id": "cddfba79-f7c5-3f30-ba2c-29aab1f9cb5c",
                                "text": "C'est en faisant la cuisine sur mon sol de terre battue que j'ai ramassé cela, aussi qu'est-ce que je fais crésyler le plancher de la maison !"
                            },
                            {
                                "example_id": "b6846bc8-f2b6-4891-be1e-c30d06e8b40a",
                                "sense_id": "cddfba79-f7c5-3f30-ba2c-29aab1f9cb5c",
                                "text": "Surveiller, aux alentours des fosses à purin, la terre imbibée d'urine, à l'ombre; la crésyler, s'il y a lieu, ou la pétroler."
                            }
                        ]
                    }
