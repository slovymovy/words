                                                "example_id": "58739aef-9cd0-4012-9bc7-feeb63c13e01",
                                                "sense_id": "9c0506e5-f410-3814-b7bc-28e83321f74e",
                                                "text": "Le célèbre falsetto au pantalon ajusté au niveau du bassin [Robert Plant] fait maintenant partie du club des rockers septuagénaires."
                                            }
                                        ]
