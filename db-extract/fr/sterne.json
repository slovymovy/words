                ],
                "senses": [
                    {
                        "sense_id": "89a4ab79-6abf-3dce-b6f7-2ba5f9d26f58",
                        "entry_id": "8709c3ce-ff3e-32ed-a9dd-f12484fdc279",
                        "glosses": [
                            "Oiseau palmipède migrateur marin de la famille des laridés, communément appelé hirondelle de mer, à tête noire et à dos gris, qui vit sur les côtes ou près de l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67200330-091e-483d-8761-5d587f314a3e",
                                "sense_id": "89a4ab79-6abf-3dce-b6f7-2ba5f9d26f58",
                                "text": "Une grande sterne blanche passa au-dessus de la plate-forme en glapissant."
                            },
                            {
                                "example_id": "1e6838cc-4c3e-4e1f-9987-e757b2c98c15",
                                "sense_id": "89a4ab79-6abf-3dce-b6f7-2ba5f9d26f58",
                                "text": "Un vol de sternes passe dans le ciel avec la grâce et l’étincelante blancheur d’une vague se soulevant et dont la crête déjà se courbe et se fragmente."
                            },
                            {
                                "example_id": "91500633-c421-47a5-8192-9bed7120145c",
                                "sense_id": "89a4ab79-6abf-3dce-b6f7-2ba5f9d26f58",
                                "text": "En Indre-et-Loire, la colonie de ces oiseaux migrateurs est l’une des plus importantes de France où l’on compte environ 6000 couples de sternes pierregarins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f484d9c-c749-450b-ac19-2420de82140f",
                        "source_entry_id": "8709c3ce-ff3e-32ed-a9dd-f12484fdc279",
                        "source_sense_id": "89a4ab79-6abf-3dce-b6f7-2ba5f9d26f58",
                        "target_lang_word": "Seeschwalbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeschwalbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa5d4794-d98b-3ea7-b389-ae451da696dc",
                                        "entry_id": "8552716c-65a8-3288-89b7-e42dc4b0891c",
                                        "glosses": [
                                            "Vogel aus der Verwandtschaft der Möwen (Familie Sternidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b318e46a-0d78-4888-bb74-6ed867fa0db5",
                                                "sense_id": "aa5d4794-d98b-3ea7-b389-ae451da696dc",
                                                "text": "Die Seeschwalben brüten in Kolonien."
                                            },
                                            {
                                                "example_id": "2c25dac8-6852-4e2e-8cea-7b5938b5e37c",
                                                "sense_id": "aa5d4794-d98b-3ea7-b389-ae451da696dc",
                                                "text": "„In einem Schwarm von Seeschwalben auf einer Sandbank am Fluß warteten sechs Landstreicher, dazwischen eine Leiche.“"
                                            },
                                            {
                                                "example_id": "ab8fb049-f281-44c2-bd2d-333e36ede8e8",
                                                "sense_id": "aa5d4794-d98b-3ea7-b389-ae451da696dc",
                                                "text": "„Der Seemann erkannte Möwen und Seeschwalben, und ihr Gekreisch schien mit dem Gebrüll des Ozeans zu wetteifern.“"
                                            },
                                            {
                                                "example_id": "b35f87d8-1f56-4d25-b6c8-7e1d9759c320",
                                                "sense_id": "aa5d4794-d98b-3ea7-b389-ae451da696dc",
                                                "text": "„Es bringt allerdings mit der Zeit eine so tiefe Ruhe über jeden, den Bäumen beim Wachsen zuzusehen, dass einen die Seeschwalben als Nistplatz nutzen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e994f79f-bf5b-338d-897f-a22c2bc4474e",
                                        "entry_id": "8552716c-65a8-3288-89b7-e42dc4b0891c",
                                        "glosses": [
                                            "umgangssprachlich für den Roten Knurrhahn"
                                        ],
                                        "tags": [
                                            "Chelidonichthys lucernus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5aa71f-b8eb-438b-8ed2-58c9d28d96ad",
                                                "sense_id": "e994f79f-bf5b-338d-897f-a22c2bc4474e",
                                                "text": "Ich habe eine Seeschwalbe geangelt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
