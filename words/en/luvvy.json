{
    "word_family": [
        "love"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09f0a9cf-3cd1-387b-b937-37023c2fa217",
                    "sense_definition": "An affectionate term of address used to show warmth or friendliness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affectionate_address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't cry <w>luvvy</w>, everything will be OK.",
                            "target_lang_translations": {
                                "ru": "Не плачь, <w>милочка</w>, всё будет хорошо."
                            }
                        },
                        {
                            "text": "Come here <w>luvvy</w>, let me help you with those heavy bags.",
                            "target_lang_translations": {
                                "ru": "Иди сюда, <w>дорогая</w>, давай я помогу тебе с этими тяжелыми сумками."
                            }
                        }
                    ],
                    "synonyms": [
                        "darling",
                        "dear",
                        "sweetheart"
                    ],
                    "common_phrases": [
                        "don't cry luvvy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in British English to express endearment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение, используемое для выражения теплоты или дружелюбия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогая",
                                "target_lang_sense_clarification": "ласковое обращение к женщине"
                            },
                            {
                                "target_lang_word": "милочка",
                                "target_lang_sense_clarification": "разговорное, часто покровительственное обращение"
                            },
                            {
                                "target_lang_word": "солнышко",
                                "target_lang_sense_clarification": "очень теплое, неформальное обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feeb53d5-cf04-3e03-b013-a5f674dea085",
                    "sense_definition": "A performer, particularly one perceived as self-important or pretentious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theatrical_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was filled with <w>luvvies</w> talking loudly about their latest film projects.",
                            "target_lang_translations": {
                                "ru": "Вечеринка была полна <w>актеришек</w>, громко обсуждавших свои последние кинопроекты."
                            }
                        },
                        {
                            "text": "He dismissed the critics as a bunch of pretentious <w>luvvies</w> who do not understand real art.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от критиков, назвав их кучкой претенциозных <w>театралов</w>, которые ничего не смыслят в настоящем искусстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "thespian"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Derogatory term used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Актер или деятель искусства, воспринимаемый как самовлюбленный или претенциозный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актеришка",
                                "target_lang_sense_clarification": "пренебрежительное обозначение актера"
                            },
                            {
                                "target_lang_word": "театрал",
                                "target_lang_sense_clarification": "ироничное обозначение человека, связанного с театром"
                            }
                        ]
                    }
                }
            ]
        }
    ]
