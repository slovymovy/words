                "senses": [
                    {
                        "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                        "entry_id": "ff847769-a97c-3df5-af18-32fde98734fb",
                        "glosses": [
                            "Person, die Betriebswirtschaftslehre studiert (hat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf0426b-583e-4469-8e50-57d0a31598b5",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Schwarz ist Geschäftsmann, BWLer, Eventmanager.“"
                            },
                            {
                                "example_id": "88b79e4c-097e-4979-a5f3-0b8c958ca870",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Informatikstudenten entwickeln Navigationssysteme für Blinde, Juristen formulieren Klageschriften von Tierheimen, Germanisten unterrichten Kinder von Migranten, Grundschulpädagogen organisieren Projektwochen, Physikstudenten überraschen Schüler mit Experimenten, angehende Bauingenieure und Architekten gestalten Spielplätze, Studenten der Wärmetechnik helfen Vereinen beim Energiesparen, Psychologiestudenten agieren als Mentoren, und BWLer prüfen die Kassen von Umweltorganisationen.“"
                            },
                            {
                                "example_id": "052c5e45-a09a-4c37-a74b-ccd3170e4624",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Die Aufsteiger in die Top Ten der BWLer sind KPMG und der Luxuskonzern LVMH, der im vergangenen Jahr noch unter ferner liefen auf Rang 28 verharrte.“"
                            },
                            {
                                "example_id": "098e3359-3bb7-4e00-87eb-6c3340c2712a",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Fast zwei Drittel der arbeitslosen BWLer sind länger als sechs Monate arbeitslos.“"
                            },
                            {
                                "example_id": "046a4269-a4de-4955-b117-4f99921354aa",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Unter den BWLern, Wirtschaftsingenieuren und Wirtschaftsinformatikern haben rund zwei Drittel der Jobfrischlinge von Anfang an eine unbefristete Anstellung.“"
                            },
                            {
                                "example_id": "dc4ecec3-a11f-4e79-b660-f6c6473f5036",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Als Fachlektor sind in erster Linie Juristen, BWLer, Politologen und Historiker gefragt.“"
                            },
                            {
                                "example_id": "d6f4a434-6f58-4a27-8ea9-f705a33760a8",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Für Preise ab 30 Euro pro Seite schreiben sie jede gewünschte Arbeit, und vor allem Juristen, BWLer und Geisteswissenschaftler greifen darauf zurück.“"
                            },
                            {
                                "example_id": "c31bb57a-ce0f-4bd0-90db-827c7b44bfb3",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„In der Finanzwirtschaft gilt seit jeher das Prinzip, das eigene Kapital möglichst schnell zu mehren - das lernen BWLer und VWLer im ersten Semester.“"
                            },
                            {
                                "example_id": "1cb8bb42-b47f-4888-b77d-05e4ab36737e",
                                "sense_id": "5e656ac4-b679-3610-9aa5-27fd2020caf5",
                                "text": "„Arbeitslose BWLer erklären im Crashkurs um 15:30 Uhr den Unterschied zwischen Zentral- und Geschäftsbanken – man möchte den Feind kennen, der einem die Krise eingebrockt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
