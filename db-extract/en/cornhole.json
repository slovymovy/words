                ],
                "senses": [
                    {
                        "sense_id": "58cc523e-224c-37a3-975a-6c14606a7491",
                        "entry_id": "7a147225-eafd-3d81-beb9-19bea00c4fda",
                        "glosses": [
                            "A small room connected to a threshing floor."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e4dc26b-94a8-4a59-8fb8-533af39547ad",
                                "sense_id": "58cc523e-224c-37a3-975a-6c14606a7491",
                                "text": "The cornhole was a small, brick room opening off the threshing floor, about six or seven feet high, […] variously known as the cornhole or cornbin, and was designed for flail threshing, holding the grain until it was winnowed."
                            },
                            {
                                "example_id": "7466d97e-5086-44ea-9972-56ad2753d76a",
                                "sense_id": "58cc523e-224c-37a3-975a-6c14606a7491",
                                "text": "A small room may be found opening off the threshing floor on one side […] This is the cornhole, a mid-eighteenth-century development so far known only in Staffordshire and Suffolk, with a few in east Sussex."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2ef6ee0-4f19-3147-8f42-0285f7b758cd",
                        "entry_id": "7a147225-eafd-3d81-beb9-19bea00c4fda",
                        "glosses": [
                            "A game similar to beanbag toss, popular in Ohio, in which a bag filled with corn feed is thrown into a hole."
                        ],
                        "tags": [
                            "US",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0f49be84-31a2-4195-8e78-be2c6b0e6020",
                                "sense_id": "b2ef6ee0-4f19-3147-8f42-0285f7b758cd",
                                "text": "Cornhole, the indigenous pastime of Cincinnati's west side, is basically a democratized version of horseshoes."
                            },
                            {
                                "example_id": "5efda440-45a2-478b-8500-df525e273bb3",
                                "sense_id": "b2ef6ee0-4f19-3147-8f42-0285f7b758cd",
                                "text": "Cincinnatians, of course, know the true meaning of cornhole. The homegrown bag-toss game, which some suggest was even invented here, requires few tools: some beanbags, a box with a hole in it, and… well, that's it, really."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e258a19-1710-3875-ae38-3a9529dc476c",
                        "entry_id": "7a147225-eafd-3d81-beb9-19bea00c4fda",
