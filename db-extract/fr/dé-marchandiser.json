                "senses": [
                    {
                        "sense_id": "49fba0fc-ba45-3d3e-a49a-13c12bafce7c",
                        "entry_id": "7a50ed0b-a376-3915-819d-cc5d79e8e96c",
                        "glosses": [
                            "Variante orthographique de démarchandiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb43b44c-5475-47bc-9913-699c76cd12a1",
                                "sense_id": "49fba0fc-ba45-3d3e-a49a-13c12bafce7c",
                                "text": "Ils soulignent que le pain est distribué sur les marchés et que personne ne suggère de le «dé-marchandiser»."
                            },
                            {
                                "example_id": "979e1239-d657-495a-a4d6-fa5f3aa7705d",
                                "sense_id": "49fba0fc-ba45-3d3e-a49a-13c12bafce7c",
                                "text": "Il s'agit non seulement de « dé-marchandiser » la force de travail en rendant le bien-être individuel moins dépendant du statut au regard de l'emploi, mais aussi de « dé-familialiser » la gestion des solidarités interindividuelles."
                            }
                        ]
                    }
