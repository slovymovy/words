                    "sense_id": "d44b8c52-9c26-3d5e-a4d7-5bc133270ec6",
                    "sense_definition": "geen normale functionering van de geest hebbend; mentaal niet in orde",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ernstig <w>gestoorde</w> dader kreeg een tbs-straf opgelegd door de rechter.",
                            "target_lang_translations": {
                                "en": "The severely <w>disturbed</w> perpetrator was sentenced to mandatory psychiatric treatment by the judge.",
                                "ru": "Судья приговорил серьезно <w>психически больного</w> преступника к принудительному лечению."
                            }
                        },
                        {
                            "text": "Het is duidelijk dat deze man een <w>gestoorde</w> indruk maakt op zijn omgeving.",
                            "target_lang_translations": {
                                "en": "It is clear that this man makes a <w>disturbed</w> impression on those around him.",
                                "ru": "Очевидно, что этот человек производит на окружающих впечатление <w>ненормального</w>."
                            }
                        }
                    ],
                    "synonyms": [
