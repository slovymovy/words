                        "examples": [
                            {
                                "example_id": "9aac3176-5333-4227-8d79-665334072349",
                                "sense_id": "be49495c-cb41-3281-bd8c-215e6b55f892",
                                "text": "\"Rock, hardcore of metal\", benadrukt de bebaarde kunstenaar. \"Het liefst een beetje underground. Dus niet te glad.\"Toch lijkt er de laatste tijd wat veranderd. Niet alleen hobbyclubjes bezoeken de winkel met bar en podium. Onlangs speelt Helstar in Cult Art, met name in de jaren 80 een behoorlijk grote band."
                            },
                            {
                                "example_id": "633b90c9-04ad-463f-9148-903dada18ae6",
                                "sense_id": "be49495c-cb41-3281-bd8c-215e6b55f892",
                                "text": "Free to Rock: Een terugblik op de underground muziekscene uit de Sovjet-Unie, die zich ondanks bemoeienissen van de KGB liet inspireren door gitaarhelden uit het Westen."
                            }
                        ]
                    },
                    {
                        "sense_id": "657328e5-24c1-38d8-aa3e-3e27bd94827f",
                        "entry_id": "87f3f4ec-91cb-34fc-a956-164778fd1f65",
                        "glosses": [
                            "subcultuur die zich afzet tegen de gevestigde orde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf07d13-58f2-460d-a58a-4eade45bd33b",
                                "sense_id": "657328e5-24c1-38d8-aa3e-3e27bd94827f",
                                "text": "In de turbulente New Yorkse underground en gay scene van de jaren 70 en 80, fotografeerde Peter Hujar een indrukwekkend en ontroerend oeuvre bijeen."
                            }
                        ]
                    }
                ],
