                        "entry_id": "3e297b22-923a-3160-b027-36914d76c27c",
                        "glosses": [
                            "Personne qui suit la doctrine de Pierre Elliott Trudeau."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "25780488-a199-4e87-bbcb-59a8fd6bf1dd",
                                "sense_id": "d135aaed-0dde-3cc9-ac0c-b1d0c945c957",
                                "text": "Régine Robin est une essayiste et romancière québécoise d’origine française. Préoccupée par les questions d’identité, elle est aussi, selon Jean-François Nadeau, une trudeauiste qui ne supporte pas les indépendantistes québécois."
                            },
                            {
                                "example_id": "35ef3bd2-8a4a-452e-9c73-cd1656f98f0a",
                                "sense_id": "d135aaed-0dde-3cc9-ac0c-b1d0c945c957",
                                "text": "En bon trudeauiste, il croit que le fédéralisme permettra ce bel avenir."
                            }
                        ]
                    }
