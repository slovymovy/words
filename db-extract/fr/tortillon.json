                            {
                                "target_word": "turtling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ecefaa-20cf-32d0-b8af-ccf076dc0298",
                                        "entry_id": "3add1aa6-84cc-3e0e-8f56-4c136b26d48a",
