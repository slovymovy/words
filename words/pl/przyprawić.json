    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fe6e0e5-397a-3132-a377-a78cfbd74825",
                    "sense_definition": "dodać do potrawy przyprawy, zioła lub inne dodatki w celu nadania jej pożądanego smaku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharka starannie <w>przyprawiła</w> zupę solą, świeżym pieprzem oraz odrobiną majeranku.",
                            "target_lang_translations": {
                                "ru": "Повариха тщательно <w>приправила</w> суп солью, свежим перцем и щепоткой майорана."
                            }
                        },
                        {
                            "text": "Muszę jeszcze mocniej <w>przyprawić</w> ten sos, ponieważ wydaje się trochę mdły.",
                            "target_lang_translations": {
                                "ru": "Мне нужно еще сильнее <w>приправить</w> этот соус, так как он кажется немного пресным."
                            }
                        }
                    ],
                    "synonyms": [
                        "doprawić"
                    ],
                    "common_phrases": [
                        "przyprawić do smaku",
                        "przyprawić solą i pieprzem"
                    ],
                    "target_lang_definitions": {
                        "ru": "добавить в блюдо специи, пряности или другие добавки для придания желаемого вкуса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправить",
                                "target_lang_sense_clarification": "добавить специи, приправы"
                            },
                            {
                                "target_lang_word": "заправить",
                                "target_lang_sense_clarification": "о соусах, масле, сметане"
                            },
                            {
                                "target_lang_word": "сдобрить",
                                "target_lang_sense_clarification": "добавить что-то для улучшения вкуса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ace8e81e-d121-3a39-9e3a-e259b400d080",
                    "sense_definition": "dokonana forma od <w>przyprawiać</w>: nadać komuś lub czemuś jakąś cechę, domontować coś lub doprowadzić do określonego stanu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "znaczenie_przenośne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta niespodziewana i bardzo trudna sytuacja <w>przyprawiła</w> go o prawdziwy zawrót głowy.",
                            "target_lang_translations": {
                                "ru": "Эта неожиданная и очень трудная ситуация буквально <w>довела</w> его <w>до</w> головокружения."
                            }
                        },
                        {
                            "text": "Złośliwy kolega z klasy <w>przyprawił</w> mu gębę lenia, co bardzo go zasmuciło.",
                            "target_lang_translations": {
                                "ru": "Злой одноклассник <w>навесил</w> на него ярлык лентяя, что его очень расстроило."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodać",
                        "dorobić"
                    ],
                    "common_phrases": [
                        "przyprawić o zawrót głowy",
                        "przyprawić gębę"
                    ],
                    "target_lang_definitions": {
                        "ru": "придать кому-либо или чему-либо определенное свойство, прицепить что-либо или довести до определенного состояния"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "довести",
                                "target_lang_sense_clarification": "до какого-либо состояния (например, о головокружении)"
                            },
                            {
                                "target_lang_word": "навесить",
                                "target_lang_sense_clarification": "о ярлыке, кличке"
                            },
                            {
                                "target_lang_word": "приделать",
                                "target_lang_sense_clarification": "прикрепить, приставить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}