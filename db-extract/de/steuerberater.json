                    }
                ],
                "senses": [
                    {
                        "sense_id": "24ffa981-3f58-3d88-a5f1-31ce0ee97c4f",
                        "entry_id": "b512a78d-e2b6-3d0a-88f0-339979abe876",
                        "glosses": [
                            "Angehöriger eines freien Berufs, der in steuerrechtlichen und betriebswirtschaftlichen Fragen berät; staatlich zugelassener Berater und Vertreter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42fdccae-d34c-4284-94cb-ba8024455abc",
                                "sense_id": "24ffa981-3f58-3d88-a5f1-31ce0ee97c4f",
                                "text": "Bei all diesen komplizierten Steuerregeln habe ich mir lieber einen Steuerberater genommen."
                            },
                            {
                                "example_id": "feda2f6d-acb0-4a7c-8df9-6fa4c55bbf5d",
                                "sense_id": "24ffa981-3f58-3d88-a5f1-31ce0ee97c4f",
                                "text": "„Als Steuerberater üben Sie Ihren Beruf unabhängig, eigenverantwortlich und gewissenhaft aus.“"
                            },
                            {
                                "example_id": "9736ca98-9922-4015-89d1-7ea6a0596a28",
                                "sense_id": "24ffa981-3f58-3d88-a5f1-31ce0ee97c4f",
                                "text": "„Aber irgendjemand muss die Hunderte Rechnungen überweisen, die Unterlagen für den Steuerberater vorbereiten, die Mahnungen schreiben, schlicht, den ganzen Papierkram bewältigen.“"
                            },
                            {
                                "example_id": "b66d3131-6981-4d48-a59f-c4f19d4d0689",
                                "sense_id": "24ffa981-3f58-3d88-a5f1-31ce0ee97c4f",
                                "text": "„Der Steuerberater Eberhard Kleinschmidt war der klassische Fall von Übereinstimmung zwischen Job und Person.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
