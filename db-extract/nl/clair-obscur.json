                    {
                        "translation_id": "f9120df3-3a3e-4fe0-9615-34be4dd1e29e",
                        "source_entry_id": "6561266d-0116-37c2-8f71-4b50ea13a735",
                        "source_sense_id": "f56088f0-93af-3d50-99ee-60a4dac1020c",
                        "source_sense_description": "artistieke techniek",
