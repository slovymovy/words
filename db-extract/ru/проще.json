                                                "sense_id": "f10672e3-929d-3e40-88ea-6eaa0d1001da",
                                                "text": "Of the two, she was certainly the plainer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plainer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d340a20-fb4b-330a-acd1-527e15545d6e",
                                        "entry_id": "4918de77-76bd-3389-9998-4495100dfd09",
                                        "glosses": [
                                            "A policeman who wears plainclothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e5c232-855e-4647-abb4-7ef87097cd7e",
                                                "sense_id": "3d340a20-fb4b-330a-acd1-527e15545d6e",
                                                "text": "Three pandas were parked round the edge of the wee swing park, lights spinning, flashing blue on a huddle of plainers over by the iron roundabout."
                                            },
                                            {
                                                "example_id": "cc06c232-fec7-4bb2-bbe6-7bfd9a22fcc1",
                                                "sense_id": "3d340a20-fb4b-330a-acd1-527e15545d6e",
                                                "text": "The plainer, he was from the Marine police station on Anderson Street and Davin or Devine or something was his name — said nothing."
                                            },
                                            {
                                                "example_id": "6dd40ef3-1b9a-486e-83ed-1b9db434608e",
                                                "sense_id": "3d340a20-fb4b-330a-acd1-527e15545d6e",
                                                "text": "A guy and a girl make ideal plainers; nobody gives them a second thought; people just assume they're a couple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fe1e9ab-ce2f-44a8-934b-f4ffa27ae00f",
                        "source_entry_id": "3f31457d-a7c7-3a8f-bb71-ac7585bb4b67",
                        "source_sense_id": "c1555b78-37e1-3102-a296-9ab9a0c40868",
