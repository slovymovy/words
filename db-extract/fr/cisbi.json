                                                "sense_id": "76831fe1-7f70-3312-a095-551c2ace9e1a",
                                                "text": "Cisbi married couples elbow each other in the yogurt section when the young assistant manager with suspenders and Buddy Holly glasses walks by."
                                            },
                                            {
                                                "example_id": "4c407ba1-da43-49ad-b78b-982505afc46c",
                                                "sense_id": "76831fe1-7f70-3312-a095-551c2ace9e1a",
                                                "text": "I've seen it from cishet and cisgay people. But all my cisbi friends and my cisbi fiancée are as chill as can be."
                                            }
                                        ]
                                    }
                                ]
                            },
