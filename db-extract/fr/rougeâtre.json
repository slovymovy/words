                                    {
                                        "sense_id": "5cd820fb-8468-3e95-891c-89573ae38b06",
                                        "entry_id": "ebac0923-567e-31c1-b4cf-4ffddce534ae",
                                        "glosses": [
                                            "такой, у которого щёки имеют розовый или красный цвет (от прилива крови)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fedd58ca-0233-42b6-abdb-93900aa32cea",
                                                "sense_id": "5cd820fb-8468-3e95-891c-89573ae38b06",
                                                "text": "Румяное цветущее лицо его было сердито."
                                            },
                                            {
                                                "example_id": "6e4f2d0c-0827-4af0-9589-e4520ca96f22",
                                                "sense_id": "5cd820fb-8468-3e95-891c-89573ae38b06",
                                                "text": "И ей из снопов улыбались // Румяные лица детей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db32c60b-5d44-3fe3-9912-78d9bfa45b5c",
                                        "entry_id": "ebac0923-567e-31c1-b4cf-4ffddce534ae",
                                        "glosses": [
                                            "поэт. алый, густо-розовый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8df7bf-8c7c-4b71-963e-a3a869d6550c",
                                                "sense_id": "db32c60b-5d44-3fe3-9912-78d9bfa45b5c",
                                                "text": "Солнце окрасило румяным светом берёзки на бугре и белые рубашки мужиков"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9bbe3be-2ab5-395f-8c2d-3246e2340693",
                                        "entry_id": "ebac0923-567e-31c1-b4cf-4ffddce534ae",
                                        "glosses": [
                                            ": с красным боком, с красным, алым пятном"
                                        ],
                                        "tags": [
                                            "о плодах"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe79c7b1-0ff3-45c7-9c4e-c6d594a6b8a0",
                                                "sense_id": "e9bbe3be-2ab5-395f-8c2d-3246e2340693",
                                                "text": "Дерево было усыпано румяными яблоками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d7de56-39de-36bb-a2f2-b0e65e930fd6",
                                        "entry_id": "ebac0923-567e-31c1-b4cf-4ffddce534ae",
                                        "glosses": [
                                            ": с золотисто-коричневым оттенком"
                                        ],
                                        "tags": [
                                            "о цвете пенки на топлёном молоке, поджаристой корочке пирога и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35146a4d-1ce8-4024-af99-4b5c87fa95cc",
                                                "sense_id": "67d7de56-39de-36bb-a2f2-b0e65e930fd6",
                                                "text": "Хозяйка озабоченно вынимает из печи пирог и щёлкает ногтем по его румяной корке."
                                            }
                                        ]
                                    }
                                ]
