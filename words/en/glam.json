                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He holds a Bachelor of Science degree from <w>Glam</w>.",
                            "target_lang_translations": {
                                "tr": "<w>Glamorgan Üniversitesi</w>'nden fen bilimleri lisans derecesine sahiptir."
                            }
                        },
                        {
                            "text": "She graduated with honors from <w>Glam</w> last year.",
                            "target_lang_translations": {
                                "tr": "Geçen yıl <w>Glamorgan</w>'dan onur derecesiyle mezun oldu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
