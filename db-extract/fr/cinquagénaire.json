                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5edcb0bc-cab7-40df-a2bb-42ddc2d0e698",
                                "sense_id": "00d51a6a-7260-3add-823b-3e6eae5a2063",
                                "text": "« Vers 8 heures, j’ai entendu des cris derrière leur porte, se souvient le cinquagénaire, les yeux encore rougis par les larmes."
                            },
                            {
                                "example_id": "08c09287-13d9-4cc4-a057-681b3ad7e1b2",
                                "sense_id": "00d51a6a-7260-3add-823b-3e6eae5a2063",
                                "text": "La manigance de l’agriculteur a été démasquée en juin dernier par l’Amap de Mions en visite dans l’exploitation du cinquagénaire."
                            },
                            {
                                "example_id": "ef83dc14-d026-4977-87a2-80c404a1b3e9",
                                "sense_id": "00d51a6a-7260-3add-823b-3e6eae5a2063",
                                "text": "Les chercheurs ont isolé deux types de profils de cyberdrogués. Des hommes de 20 à 25 ans et des cinquagénaires."
                            },
                            {
                                "example_id": "728ea4d9-94c9-429e-a619-79b90b966e70",
                                "sense_id": "00d51a6a-7260-3add-823b-3e6eae5a2063",
                                "text": "Mais il n’y a pas que les quadragénaires ou cinquagénaires qui sont touchés par le divorce."
                            },
                            {
                                "example_id": "79dc8aea-3972-4175-a861-352f6b733fd2",
                                "sense_id": "00d51a6a-7260-3add-823b-3e6eae5a2063",
                                "text": "Moi, vieux cinquagénaire catarrheux et rhumatismal, j’espère bien ; ce serait bien le diable qu’un voyageur à peine aux portes de la vie, les vît se fermer sur lui, ou fût condamné à faire sa route en souffreteux."
                            }
                        ]
                    }
