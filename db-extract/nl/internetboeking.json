                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4662e530-b158-4a49-82b6-1e516d5a5403",
                                "sense_id": "79816c9f-c856-3db8-87a4-2001f2a80ed9",
                                "text": "„Een dag na mijn internetboeking bleek er op mijn naam een annulering te zijn binnengekomen en daarna is het huis verhuurd aan een ander."
                            },
                            {
                                "example_id": "f705a0ee-aa7c-4d3b-b7ce-72e3d3fc4829",
                                "sense_id": "79816c9f-c856-3db8-87a4-2001f2a80ed9",
                                "text": "Bij een internetboeking wordt naast een vlucht vaak ook een huurauto of hotel geregeld."
                            },
                            {
                                "example_id": "aed973aa-33df-4ad6-93d6-55986182d779",
                                "sense_id": "79816c9f-c856-3db8-87a4-2001f2a80ed9",
                                "text": "“Ons systeem is nu eenmaal op internetboekingen gebaseerd. Wie daar niet mee overweg kan, moet zich door een vriend of zijn kinderen laten helpen. Met die toeslagen willen we geen extra inkomsten genereren, maar het gedrag van de klanten veranderen. Bij Ikea moet u uw meubels ook zelf in elkaar zetten. Daar beklaagt niemand zich over.”"
                            }
                        ]
                    }
