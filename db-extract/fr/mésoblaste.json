                        "sense_id": "1bc38633-3fc9-354a-a9fc-d04ad5ba7a26",
                        "entry_id": "11a9fa78-0e81-31a0-a4f2-84df8bdde3f7",
                        "glosses": [
                            "Feuillet embryonnaire cellulaire de l'embryon des métazoaires triploblastiques qui se met en place au moment de la gastrulation entre l'endoderme et l'ectoderme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eaee507-8444-4600-9333-b9d73ca77118",
                                "sense_id": "1bc38633-3fc9-354a-a9fc-d04ad5ba7a26",
                                "text": "Les mésoblastes des chordés vont très tôt se différencier des mésoblastes des autres espèces par la formation d'une notochorde qui va constituer le squelette axial de l'embryon précoce."
                            },
                            {
                                "example_id": "519e3ad4-142a-44f0-808a-8303ea6d4081",
                                "sense_id": "1bc38633-3fc9-354a-a9fc-d04ad5ba7a26",
                                "text": "L’induction du mésoblaste est la première à se produire pendant le développement."
                            }
                        ]
                    }
                ],
