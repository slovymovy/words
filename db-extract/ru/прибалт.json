                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9b4aba1-1df9-30bb-8fa2-6de3e56aeede",
                                        "entry_id": "5e2589c6-8430-393f-96a8-eadf2d6e5688",
                                        "glosses": [
                                            "An ethnic descendant of the Indo-European Baltic people, especially including ethnic Lithuanians, Latvians or Prussians, but generally not including ethnic Belarusians, Estonians, Germans, Jews, Livonians, Poles, Russians, Swedes or Tatars who have also inhabited or currently inhabit the modern Baltic states."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8151b7c-1a8d-34dc-bdd0-227f9b878559",
                                        "entry_id": "5e2589c6-8430-393f-96a8-eadf2d6e5688",
                                        "glosses": [
                                            "A native speaker of one of the Baltic languages: Lithuanian, Latvian, Old Prussian, Sudovian and related languages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "643f1f99-3432-3ae2-86ad-e37658635fc4",
                                        "entry_id": "5e2589c6-8430-393f-96a8-eadf2d6e5688",
                                        "glosses": [
                                            "An inhabitant of one of the modern Baltic states: Lithuania, Latvia or Estonia."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f982c7e9-6978-446a-8bd6-761571b55a02",
                        "source_entry_id": "d7d48c11-edf9-3b33-928f-9e3cb1361dad",
                        "source_sense_id": "e828edd1-82c5-36f0-b499-ca158c773e99",
                        "target_lang_word": "Balte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                        "entry_id": "9ea38696-8101-3473-b9c2-acbdbdde62ca",
                                        "glosses": [
                                            "Angehöriger eines baltischen Volkes; einer der Balten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e43bd828-79f3-4e1c-908f-6522a6cc3207",
                                                "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                                "text": "Senff war zwar kein geborener Balte, doch gehört seine Haupt-thätigkeit Livland, speciell Dorpat, an, […]"
                                            },
                                            {
                                                "example_id": "4beca44b-1c50-45c1-9a69-f79b0ac7cd21",
                                                "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                                "text": "Bennigsen, kein geborener Balte, sondern geborener Hannoveraner, deshalb wie der wackere Balte Barclay de Tally und der hochbegabte Eugen Würtemberg dem plumpen Dünkel der Stockrussen ein Dorn im Auge, […]"
                                            },
                                            {
                                                "example_id": "141f0c6b-5eca-496b-8981-617caa85626e",
                                                "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                                "text": "Frank Fischer, ein geborener Balte, der mit einer Arbeit über die Lehnwörter des Altwestnordischen promoviert hatte, […]"
                                            },
                                            {
                                                "example_id": "f8dcc360-f0af-4bac-85d7-5a61528d9424",
                                                "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                                "text": "Aus den Akten der KK, II-VIII, 154 geht hervor, daß er ein geborener Balte und naturalisierter Franzose ist und in den 1890er Jahren eine Wohnung in St. Petersburg besessen hat. Er lebte häufig in Paris und auf Reisen."
                                            },
                                            {
                                                "example_id": "8548dcd5-cfe4-41ee-9169-1da88b455278",
                                                "sense_id": "110ad1da-0175-3223-a3c7-300563178460",
                                                "text": "Eingeladen hatte uns Herr von Osten-Sacken, ein geborener Balte und sehr bekannter Rennmann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
