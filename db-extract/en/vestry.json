    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                "word": "vestry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3e83c71b-6433-4145-b602-da99286d0ae7",
                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "tags": [
                            "plural"
                        ],
                        "form": "vestries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c75a8ac2-ff02-3d4c-a347-d3c5cd08b13f",
                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "glosses": [
                            "A room in a church where the clergy put on their vestments and where these are stored; also used for meetings and classes; a sacristy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f56487-c20b-481c-a96a-14d193a8eea5",
                                "sense_id": "c75a8ac2-ff02-3d4c-a347-d3c5cd08b13f",
                                "text": "The choirboys change into their cassocks in the vestry."
                            }
                        ]
                    },
                    {
                        "sense_id": "5eafe6c9-eca3-34fc-9ce4-8dc5113a2e5a",
                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "glosses": [
                            "A committee of parishioners elected to administer the temporal affairs of a parish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6f9308-e629-45a1-853e-b3116575d92a",
                                "sense_id": "5eafe6c9-eca3-34fc-9ce4-8dc5113a2e5a",
                                "text": "The vestry meets on the first Tuesday of every month."
                            }
                        ]
                    },
                    {
                        "sense_id": "2684ecef-6116-3926-aa77-1e6203026e1b",
                        "entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "glosses": [
                            "An assembly of persons who manage parochial affairs; so called because usually held in a vestry."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1db27d5-878d-40e0-8c1f-5309a6a8d56d",
                        "source_entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "source_sense_description": "room in a church",
                        "target_lang_word": "sacristie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
                                        "entry_id": "70686f5d-f300-35ea-a7df-93cdaa54f166",
                                        "glosses": [
                                            "een ruimte in een rooms-katholieke kerk, waarin men alles bewaart dat nodig kan zijn om een kerkdienst te houden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7044644f-b0ae-4842-be53-34b485d235a2",
                                                "sense_id": "02626ed8-384e-3eef-b381-7662fa37f5d9",
                                                "text": "In de sacristie van een kerk worden de liturgische kleding, het vaatwerk en de boeken voor de vieringen bewaard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b4a25cc-d423-46e1-9be7-c757c78b5969",
                        "source_entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "source_sense_description": "room in a church",
                        "target_lang_word": "sacristie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0cc5c9-59de-3e74-bd22-fa82fac4fd6a",
                                        "entry_id": "ab591061-2cf1-3518-ba10-259b653b02ae",
                                        "glosses": [
                                            "Partie de l’église affectée à la garde des vases sacrés, des ornements d’église, et où ceux qui officient vont revêtir les ornements sacerdotaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db6e296d-a544-48f1-b262-e2ef7ca1702b",
                                                "sense_id": "ac0cc5c9-59de-3e74-bd22-fa82fac4fd6a",
                                                "text": "Le maire ayant refusé de rendre le presbytère à sa primitive destination, le commune fut obligée d’acheter une maison de paysan située près de l’église ; il fallut dépenser cinq mille francs pour l’agrandir, la restaurer et y joindre un jardinet dont le mur était mitoyen avec la sacristie, en sorte que la communication fut établie comme autrefois entre la maison curiale et l’église."
                                            },
                                            {
                                                "example_id": "97b3560b-85f9-48fb-8c8e-989ea92c06da",
                                                "sense_id": "ac0cc5c9-59de-3e74-bd22-fa82fac4fd6a",
                                                "text": "Le récit de la vie de Rolende, tel que le faisait Octave, est très éloigné du romanesque plat de l’hagiographie apocryphe du XVIIIᵉ siècle, La princesse fugitive ou la vie de Sainte Rolende, et de la prose de sacristie des brochures qu’on distribue à l’église. Un poète a passé par là."
                                            },
                                            {
                                                "example_id": "e4f4d701-ed90-487c-a3d5-9e0e5063068f",
                                                "sense_id": "ac0cc5c9-59de-3e74-bd22-fa82fac4fd6a",
                                                "text": "Les oignons de l’Église, ça devait être, sans doute, pour le général, les sacristies sentant le moisi, les nonciatures, les pastorales d’ensemble, et tout notre bazar extérieur."
                                            },
                                            {
                                                "example_id": "c21476e5-2337-4093-b5bc-bf566d8e4490",
                                                "sense_id": "ac0cc5c9-59de-3e74-bd22-fa82fac4fd6a",
                                                "text": "Dans le tohu-bohu de la sacristie m’échoyai l’honneur d’aider le prêtre à se vêtir des ornements. Je présentais l’amict, l’aube, l’étole. Je veillais à la pose de la chasuble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ea1bde-c938-3798-8f35-27bf8c58a321",
                                        "entry_id": "ab591061-2cf1-3518-ba10-259b653b02ae",
                                        "glosses": [
                                            "Ce qui est contenu dans la sacristie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fb1a93-6cdb-47a4-8fc3-489e9c3adc9c",
                                                "sense_id": "c7ea1bde-c938-3798-8f35-27bf8c58a321",
                                                "text": "La sacristie de telle paroisse est très riche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65e4175b-8119-4101-ab48-221ed884237d",
                        "source_entry_id": "250ba08c-9586-3909-8070-e3fec40cf1d9",
                        "source_sense_description": "room in a church",
                        "target_lang_word": "Sakristei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakristei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                        "entry_id": "9d89371e-0a63-3d2f-938d-f210dbc5a03f",
                                        "glosses": [
                                            "Nebenraum einer Kirche, in dem aufbewahrt wird, was für den Gottesdienst benötigt wird; dient auch als Vorbereitungsraum für die Geistlichen"
                                        ],
                                        "tags": [
                                            "Christentum; Kirchengebäude"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e15c88-2f86-47ca-b4a0-8e8c2b541ff4",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auch das heutige an der Nordseite erbaute Querhaus entstand im Wesentlichen in diesen Jahren, um dort die Sakristei und die Bibliothek unterzubringen.“"
                                            },
                                            {
                                                "example_id": "38b804de-749f-4996-aba6-33b1fdf1b7ba",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Die Sakristei befand sich neben dem Sanktuarium (Altarraum) und an der dem kleinen Kreuzgang abgewandten Seite.“"
                                            },
                                            {
                                                "example_id": "e8d9ca9a-43dc-4e3a-bf42-87bbfe906bfa",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Auf der Suche nach einem Fluchtweg öffnete er die Seitentüre zur Sakristei und versteckte sich in einem Beichtstuhl.“"
                                            },
                                            {
                                                "example_id": "9a071535-66ad-47c0-9e02-55554f697a91",
                                                "sense_id": "a239066f-34ec-3322-8d49-d5464a5f37ee",
                                                "text": "„Ich saß noch bei Tisch mit der ganzen erlauchten Gesellschaft, als ein Geistlicher erschien und mich daran erinnerte, daß man mich in der Sakristei erwarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14db8487-6de4-4887-b65c-588fe89faa62",
