                "translations": [
                    {
                        "translation_id": "0ab1455a-9055-45e5-a74d-1e42479eb7c8",
                        "source_entry_id": "dace7010-bd55-39b2-bc2b-289c6bb2f24c",
                        "source_sense_id": "f3a028d4-dd39-3740-bb63-ef251267ef76",
                        "source_sense_description": "The time, or the condition of budding or flowering",
                        "target_lang_word": "Blütezeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blütezeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                        "entry_id": "f5bcacda-ac53-3877-893a-16271f59400f",
                                        "glosses": [
                                            "a) die Entwicklung einer einzelnen Blüte (Anthese), b) eines bestimmtes Pflanzenexemplares oder c) einer Pflanzenart in einem bestimmten Gebiet (Phänologie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fddbbfb-b01c-4e02-8c1c-f6cdd10c6920",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Die Blütezeit beginnt bei der Windbestäubung vor der Blattentwicklung […] und dauert von mehreren Wochen bis wenige Stunden, letzteres beispielsweise bei der „Königin der Nacht“.“ (Anthese)"
                                            },
                                            {
                                                "example_id": "a0ab9d92-696b-4269-b8c0-c71dc461ccf3",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Die Blütezeit der Art […] liegt im Frühling zwischen Ende April und Mitte Mai […].“ (Phänologie)"
                                            },
                                            {
                                                "example_id": "15af52b0-5248-4ec2-9b5d-eaf2f3e6f9a3",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "die Blütezeit einer einzelnen Blüten dauert von mehreren Wochen bis wenige Stunden beispielsweise bei der „Königin der Nacht“.“ (Anthese)"
                                            },
                                            {
                                                "example_id": "1a1adb05-ee72-40bc-865d-a1ac0927f2a8",
                                                "sense_id": "7f314e2f-ed76-3a6d-8ea6-0ec4620f0bca",
                                                "text": "„Aus einem mit Tausenden von Touristen voll gestopften Amphitheater, das sich Nachtclub nennt, wird eine einbalsamierte Polizeistaatversion jener heißen karibischen Shows gesendet, die in der Blütezeit des organisierten Verbrechens die Leute mit den großen Scheinen anlockten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                        "entry_id": "f5bcacda-ac53-3877-893a-16271f59400f",
                                        "glosses": [
                                            "die Zeit, in der ein bestimmtes kulturelles Konstrukt (ein handwerkliches, künstlerisches, politisches, wissenschaftliches oder ähnliches Konstrukt) besonders gut entwickelt ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd465e95-25c0-4bcf-8743-24f22d300493",
                                                "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                                "text": "„Das Ende der Blütezeit der irischen Klosterkultur kam mit der Wikingerzeit, die mit dem Überfall auf das Kloster Lindisfarne im Jahre 793 begann.“"
                                            },
                                            {
                                                "example_id": "43170cac-3d8a-4610-9cf3-cb2a2e808ceb",
                                                "sense_id": "e47a1fcd-083a-3fbb-963f-c781bdd07a90",
                                                "text": "„Irgendwann aber akzeptiert der jüngere Sohn die Königswürde doch, die Intrigen am Hof ebben ab, und das Edo-Reich geht einer weiteren Blütezeit mit neuen Eroberungen entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77c0853d-2bab-421f-9d0c-e56d02a6eb80",
                        "source_entry_id": "dace7010-bd55-39b2-bc2b-289c6bb2f24c",
                        "source_sense_id": "f3a028d4-dd39-3740-bb63-ef251267ef76",
                        "source_sense_description": "The time, or the condition of budding or flowering",
                        "target_lang_word": "Blüte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blüte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "755e6e8c-efab-3c3c-be55-cc1556444d99",
                                        "entry_id": "cb74244e-66ac-326d-bae7-c921942962af",
                                        "glosses": [
                                            "Reproduktionsorgan der Blütenpflanzen, besteht, wenn vollständig ausgebildet (von oben nach unten), aus den weiblichen Frucht-, den männlichen Staub- sowie den diese umhüllenden Kelch- und Kronblättern, die alle endständig gestaucht an der Sprossachse angeordnet sind. Die Fruchtblätter sind oft zu einem Fruchtknoten verwachsen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6accc2-61ba-4814-938a-030e8650f96a",
                                                "sense_id": "755e6e8c-efab-3c3c-be55-cc1556444d99",
                                                "text": "„Die Schlingpflanzen trugen gelbe Blüten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "697db6e0-1c4a-3c9f-8355-03ca2a847941",
                                        "entry_id": "cb74244e-66ac-326d-bae7-c921942962af",
                                        "glosses": [
                                            "Zustand während des Blühens einer Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d2140a-e285-4227-b961-1fda8fc7789a",
                                                "sense_id": "697db6e0-1c4a-3c9f-8355-03ca2a847941",
                                                "text": "Die Kirschbäume stehen um diese Zeit schon in voller Blüte."
                                            },
                                            {
                                                "example_id": "8ee74e76-31e7-46ec-acdf-cb843e8a116c",
                                                "sense_id": "697db6e0-1c4a-3c9f-8355-03ca2a847941",
                                                "text": "„Im Gartenschuppen, der eigentlich Teil des Anbaus war, den aber der Gärtner für seine eigenen Zwecke nutzte, hatte ich einen Blumentopf gefunden, in den ich einen Löwenzahn in voller Blüte eingepflanzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0a1cf751-683e-3fff-8f05-02009dd5ac8e",
                                        "entry_id": "cb74244e-66ac-326d-bae7-c921942962af",
                                        "glosses": [
                                            "plötzliches, massenhaftes Auftreten von pflanzlichen Organismen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0003579-9016-4a9a-a8bd-53f40ff4cc75",
                                                "sense_id": "0a1cf751-683e-3fff-8f05-02009dd5ac8e",
                                                "text": "Die Blüte der Algen nahm im Mittelmeer wieder überhand."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "caabdd1f-dd7c-3b71-9a0d-8fd5f453b2da",
                                        "entry_id": "cb74244e-66ac-326d-bae7-c921942962af",
                                        "glosses": [
                                            "gefälschte Banknote"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae74c44-9f15-49f6-ae4d-3855eaa8bffe",
                                                "sense_id": "caabdd1f-dd7c-3b71-9a0d-8fd5f453b2da",
                                                "text": "Auch nach Einführung des Euro waren sehr bald wieder Blüten im Umlauf."
                                            }
                                        ],
