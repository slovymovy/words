                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "faire preuve de (avoir le courage, l'audace)"
                            },
                            {
                                "target_lang_word": "faire preuve de",
                                "target_lang_sense_clarification": "monstrer une qualité morale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d375400-2149-3041-a882-a200f58823aa",
