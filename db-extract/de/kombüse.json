                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "A youngest child who is born after a long gap in time."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13026ac3-4973-485d-bfb2-1c8aa9dfe420",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "Jimmy was seven and had just finished first grade, so that made Nancy our caboose baby — our bonus child — our swan song."
                                            },
                                            {
                                                "example_id": "675ba159-00a0-44e4-877e-1ed45c8af906",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "\"Caboose\" children, the late-born last offspring in the family, didn't suffer from this as much."
                                            },
                                            {
                                                "example_id": "4f73b794-edfa-4795-8c23-89384e02e159",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "After looking back on her own experience, she thought of some ways parents could help ease the transition for their caboose kid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cf69ae5-9d9e-46b1-8c91-ca65895e2b56",
                        "source_entry_id": "f4fdcf2c-9f4c-3b88-90eb-00bc1fdcbd6e",
                        "source_sense_id": "f92874e1-ce05-3f07-9c81-788b3934d539",
                        "source_sense_description": "der Raum auf einem Schiff, in dem das Essen zubereitet wird",
                        "target_lang_word": "галера",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "галера",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3f9c8d-6435-3f80-9737-36ee10dcdfd0",
                                        "entry_id": "eafd17b1-e1ec-3b5a-809a-204c0e4f873e",
                                        "glosses": [
                                            "морск. истор. парусно-гребное многовёсельное судно, преимущественно ходящее на вёслах; в узком смысле — парусно-гребной корабль с характерным узким, длинным корпусом, одним рядом вёсел и косыми парусами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e989c5-b388-4aaf-bca1-13e97bb11223",
                                                "sense_id": "9d3f9c8d-6435-3f80-9737-36ee10dcdfd0",
                                                "text": "Вечером в военную гавань Улеаборга медленно вошла шестидесятивёсельная галера под шведским военно-морским флагом ― золотой крест на синем поле."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942f088b-dfbe-36a8-bf78-b6a5c8355bb9",
                                        "entry_id": "eafd17b1-e1ec-3b5a-809a-204c0e4f873e",
                                        "glosses": [
                                            "тяжёлая работа, каторга || комп. жарг. IT-компания, занимающаяся аутсорсингом (содержит штат сотрудников и исполняет задания внешних заказчиков)"
                                        ],
                                        "tags": [
                                            "перен., мн.ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d9d062b-81a2-4628-97c4-f6e1b9877892",
                                                "sense_id": "942f088b-dfbe-36a8-bf78-b6a5c8355bb9",
                                                "text": "Высокое качество ролика — это цель его участников, иначе зачем после тяжких трудов за кусок хлеба снова на галеры?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055260f0-e694-3759-8bd6-a783376c0bc5",
                                        "entry_id": "eafd17b1-e1ec-3b5a-809a-204c0e4f873e",
                                        "glosses": [
                                            "матем. истор. метод деления, устаревший метод записи арифметической операции. В настоящее время чаще употребляется как словосочетание метод галеры."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
