                "senses": [
                    {
                        "sense_id": "35831c59-a4e6-334b-b5a5-a94ba1149ff0",
                        "entry_id": "df7938de-9f51-371b-b724-27c54ef45b1f",
                        "glosses": [
                            "bepaald soort kleine dwarsfluit, vaak gebruikt bij tamboerkorpsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0204b8-cdac-4b54-b8ce-2dc6bc394f57",
                                "sense_id": "35831c59-a4e6-334b-b5a5-a94ba1149ff0",
                                "text": "Uit de deuren, achter de toeschouwers, dus dóór de zaal stroomt het kermisvolk toe: kinderen en gekken met fijfel en trom, gretige verliefden met rammelaars schijven en mirlitons, ouderlingen met triangel en harmonika, kreupelen en zieken op maat van tamboerlinen; papieren linten kruisen de zaal; fanfaremuziek weerklinkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "961d69e9-cda0-3815-947a-3046147f7fa2",
                        "entry_id": "df7938de-9f51-371b-b724-27c54ef45b1f",
                        "glosses": [
                            "fluit"
                        ],
                        "tags": [
                            "in het algemeen"
                        ],
                        "examples": [
                            {
                                "example_id": "f93325b0-1bd9-4be5-b0ab-4ecb13afa02b",
                                "sense_id": "961d69e9-cda0-3815-947a-3046147f7fa2",
                                "text": "E. is een engel, 't is er een van de velen,\nF. is de fijfel, waarop hij mag spelen."
                            }
                        ]
                    }
                ],
                "translations": [
