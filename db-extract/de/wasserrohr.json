                "senses": [
                    {
                        "sense_id": "6183d058-b2f0-37a2-9df0-79de7767ffee",
                        "entry_id": "d003d273-b7d7-33ac-acb1-0a4430e30391",
                        "glosses": [
                            "Rohr zum Transport von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "219a39d3-3bca-4a20-ad10-554d66c48b37",
                                "sense_id": "6183d058-b2f0-37a2-9df0-79de7767ffee",
                                "text": "„Ein geplatztes Wasserrohr hat in Memmingen am Samstagmorgen mehrere Straßen und Häuser unter Wasser gesetzt.“"
                            },
                            {
                                "example_id": "ecd1c9d7-b01c-4dfb-b8af-9416b530adec",
                                "sense_id": "6183d058-b2f0-37a2-9df0-79de7767ffee",
                                "text": "„Obwohl ihn ein Freund von Zeit zu Zeit mit ein paar Sack Kohlen vom Schwarzen Markt versorgt hatte, war das Haus unerträglich kalt, und als der Winter härter wurde, froren alle Wasserrohre zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
