{
    "word_family": [
        "sophisticate",
        "sophisticated",
        "unsophisticated",
        "sophistry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74dc6df3-a97f-3f30-9b2a-18498b6a525c",
                    "sense_definition": "Cultivated intellectual worldliness, refined culture, and social savoir-faire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worldliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her effortless <w>sophistication</w> impressed everyone she met at the international summit.",
                            "target_lang_translations": {
                                "ru": "Её непринуждённая <w>утончённость</w> произвела впечатление на каждого, с кем она общалась на международном саммите."
                            }
                        },
                        {
                            "text": "The quiet village was completely devoid of worldly <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "В тихой деревушке напрочь отсутствовала светская <w>искушённость</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "worldliness",
                        "refinement",
                        "elegance",
                        "cultivation"
                    ],
                    "antonyms": [
                        "provincialism"
                    ],
                    "common_phrases": [
                        "air of sophistication",
                        "level of sophistication",
                        "worldly sophistication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изысканный вкус, светская искушённость, элегантность и утончённость манер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утончённость",
                                "target_lang_sense_clarification": "изысканность манер и вкуса"
                            },
                            {
                                "target_lang_word": "искушённость",
                                "target_lang_sense_clarification": "жизненный или светский опыт"
                            },
                            {
                                "target_lang_word": "изящество",
                                "target_lang_sense_clarification": "элегантность и благородство стиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2c16abe-aa1f-3fdf-a2d5-775115298d25",
                    "sense_definition": "The state or quality of being complex, intricate, or highly developed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern computer software has reached an unprecedented level of <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Современное компьютерное обеспечение достигло беспрецедентного уровня <w>сложности</w>."
                            }
                        },
                        {
                            "text": "The police force were unable to deal with the <w>sophistication</w> of the criminal network.",
                            "target_lang_translations": {
                                "ru": "Полиция оказалась не готова противостоять высокой <w>изощрённости</w> преступной сети."
                            }
                        }
                    ],
                    "synonyms": [
                        "complexity",
                        "intricacy",
                        "advancement"
                    ],
                    "common_phrases": [
                        "technological sophistication",
                        "increasing sophistication",
                        "level of sophistication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень высокой развитости, технологичности, сложности или замысловатости системы или объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложность",
                                "target_lang_sense_clarification": "высокий уровень структурной организации"
                            },
                            {
                                "target_lang_word": "изощрённость",
                                "target_lang_sense_clarification": "высокая степень продуманности и сложности"
                            },
                            {
                                "target_lang_word": "совершенство",
                                "target_lang_sense_clarification": "высокий технологический уровень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "518f95a9-9fe2-38db-9536-7d3af8d1c8ef",
                    "sense_definition": "The ability or capacity to understand and deal with complex issues.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Navigating such intricate regulatory frameworks requires considerable analytical <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Для ориентации в столь запутанной нормативной базе требуется немалая аналитическая <w>искушённость</w>."
                            }
                        },
                        {
                            "text": "The young analyst demonstrated a surprising degree of intellectual <w>sophistication</w> during the debate.",
                            "target_lang_translations": {
                                "ru": "Молодой аналитик продемонстрировал удивительную интеллектуальную <w>изощрённость</w> в ходе дебатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "discernment",
                        "insight",
                        "shrewdness"
                    ],
                    "common_phrases": [
                        "intellectual sophistication",
                        "analytical sophistication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность глубоко понимать и эффективно анализировать сложные явления или проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искушённость",
                                "target_lang_sense_clarification": "глубокий опыт и мастерство в какой-либо сфере"
                            },
                            {
                                "target_lang_word": "изощрённость",
                                "target_lang_sense_clarification": "высокая аналитическая тонкость ума"
                            },
                            {
                                "target_lang_word": "проницательность",
                                "target_lang_sense_clarification": "способность тонко подмечать и разбираться в деталях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf1fa71-4f7c-31fd-95a4-19abcdeed11b",
                    "sense_definition": "Intellectual advancement, education, or enlightenment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worldliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Access to higher education contributed significantly to the cultural <w>sophistication</w> of the populace.",
                            "target_lang_translations": {
                                "ru": "Доступ к высшему образованию внёс существенный вклад в культурную <w>просвещённость</w> населения."
                            }
                        },
                        {
                            "text": "Their debate displayed a remarkable depth of philosophical <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Их дебаты продемонстрировали поразительную глубину философской <w>зрелости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlightenment",
                        "erudition",
                        "education"
                    ],
                    "common_phrases": [
                        "cultural sophistication"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интеллектуальная зрелость, образованность, просвещённость и культурное развитие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвещённость",
                                "target_lang_sense_clarification": "высокий уровень образования и культуры"
                            },
                            {
                                "target_lang_word": "зрелость",
                                "target_lang_sense_clarification": "глубина мысли и интеллектуальное развитие"
                            },
                            {
                                "target_lang_word": "эрудиция",
                                "target_lang_sense_clarification": "начитанность и широкие познания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fd7bf6a-7f4c-3834-b0f1-cf2209dedfee",
                    "sense_definition": "The use of misleading or deceptive reasoning; sophistry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to disguise weak arguments behind clever linguistic <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Ему удалось замаскировать слабые аргументы за искусной языковой <w>софистикой</w>."
                            }
                        },
                        {
                            "text": "The philosopher warned his students against falling prey to empty rhetorical <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Философ предостерегал учеников от того, чтобы становиться жертвами пустых риторических <w>ухищрений</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sophistry",
                        "casuistry",
                        "quibbling",
                        "fallacy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of fallacious argument or sophistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Применение обманчивых, лукавых аргументов; ухищрения в рассуждениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "софистика",
                                "target_lang_sense_clarification": "намеренно ложные или лукавые доводы"
                            },
                            {
                                "target_lang_word": "ухищрение",
                                "target_lang_sense_clarification": "изворотливость в споре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33cf125c-ef5d-3545-8e2c-3183abb70556",
                    "sense_definition": "The act of adulterating, contaminating, or debasing something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inspectors uncovered the deliberate <w>sophistication</w> of medicinal supplies with cheap fillers.",
                            "target_lang_translations": {
                                "ru": "Инспекторы выявили умышленную <w>фальсификацию</w> лекарственных препаратов дешёвыми наполнителями."
                            }
                        },
                        {
                            "text": "Strict regulations were instituted to prevent the fraudulent <w>sophistication</w> of wine.",
                            "target_lang_translations": {
                                "ru": "Были введены строгие нормы, чтобы предотвратить мошенническое <w>фальсифицирование</w> вина."
                            }
                        }
                    ],
                    "synonyms": [
                        "adulteration",
                        "contamination",
                        "corruption"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of adulteration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по примешиванию посторонних веществ, ухудшению качества или подделке чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальсификация",
                                "target_lang_sense_clarification": "подделка или искажение состава"
                            },
                            {
                                "target_lang_word": "фальсифицирование",
                                "target_lang_sense_clarification": "процесс умышленного ухудшения качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c790b7af-17b5-3945-9c5a-24316d055319",
                    "sense_definition": "The state of being altered, falsified, or contaminated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "contamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The purity of the ancient manuscript was compromised by later textual <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Подлинность древней рукописи пострадала от позднейших текстовых <w>искажений</w>."
                            }
                        },
                        {
                            "text": "Scientists checked the vintage wine for any trace of chemical <w>sophistication</w>.",
                            "target_lang_translations": {
                                "ru": "Учёные проверили марочное вино на предмет любых следов химической <w>фальсификации</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "falsification",
                        "impurity",
                        "corruption"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of falsification or impurity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние испорченности, загрязнённости или поддельности чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальсификация",
                                "target_lang_sense_clarification": "поддельный характер продукта или текста"
                            },
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "нарушение подлинности или чистоты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}