                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec91176f-006f-3552-adeb-99db398d5d71",
                        "entry_id": "eca52282-e66a-35cb-8d51-5b69192475a5",
                        "glosses": [
                            "op zichzelf staande gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2060096e-252a-49d7-8746-36579bd19f34",
                                "sense_id": "ec91176f-006f-3552-adeb-99db398d5d71",
                                "text": "De operatie en het herstel daarvan was een moeilijke periode in zijn leven die nu gelukkig is afgesloten."
                            }
                        ]
                    },
                    {
                        "sense_id": "8419cb4c-37ea-3142-9c79-22b14dacd5f4",
                        "entry_id": "eca52282-e66a-35cb-8d51-5b69192475a5",
                        "glosses": [
                            "aflevering van een televisieserie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5eb85d-d464-4346-a528-20e1a7a6a6b8",
                        "source_entry_id": "eca52282-e66a-35cb-8d51-5b69192475a5",
                        "target_lang_word": "Episode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Episode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                        "entry_id": "7411e87e-8f62-307e-9419-ae52b4c93353",
                                        "glosses": [
                                            "kurzer Abschnitt in einem längeren Prozess, Verlauf"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e20e5e94-a8b8-4568-9b1b-2095d26aafb4",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "Die Unterbrechung war nur eine kleine Episode in unserer Reise."
                                            },
                                            {
                                                "example_id": "d73dfb0c-d003-479a-b5fc-ceee39caad7a",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "„Trotz dieser Episoden erwarb sich Glogowski als Innenminister auch beim politischen Gegner durchaus Respekt, galt als zuverlässig und bürgernah.“"
                                            },
                                            {
                                                "example_id": "b0e33a8e-b4c8-4137-a49a-4547a4e25c74",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "„Die drei Episoden haben aber noch etwas, wieder einmal, demonstriert.“"
                                            },
                                            {
                                                "example_id": "0cb15a99-022b-4be0-b659-373f98d5b121",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "„Und dann fragte er, was sie unternommen hätten, und Elisabeth erzählte von der Episode am Strand, wo sie die Betenden fotografiert hatte.“"
                                            },
                                            {
                                                "example_id": "9c1ba7d0-2a09-4087-be18-24a3f9002a9a",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "„Diese Episode meines Lebens ist vorbei.“"
                                            },
                                            {
                                                "example_id": "f7ba3f4c-5b8c-4e5f-9ba6-7417003a68a5",
                                                "sense_id": "4d5b6a60-55a7-3557-92ad-c139615acfaa",
                                                "text": "„Die Weimarer Republik gilt als eine krisengeschüttelte, politisch umkämpfte Episode, an deren Ende die Schreckensherrschaft der Nazis steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9122fc58-f38b-3715-a44c-2cfb9b39afd2",
                                        "entry_id": "7411e87e-8f62-307e-9419-ae52b4c93353",
                                        "glosses": [
                                            "eingeschobene Handlung, Nebenhandlung"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "891f682d-9547-46da-b447-bd0de1382320",
                                                "sense_id": "9122fc58-f38b-3715-a44c-2cfb9b39afd2",
                                                "text": "In Krimis werden gerne Episoden eingeschoben, um den Zuschauer zu irritieren."
                                            },
                                            {
                                                "example_id": "fbc4206b-50ad-424d-a954-89b44f92b2c7",
                                                "sense_id": "9122fc58-f38b-3715-a44c-2cfb9b39afd2",
                                                "text": "„Zwei Episoden illustrieren diesen Respekt vor dem Gegner anschaulich.“"
                                            },
                                            {
                                                "example_id": "e835c614-95ea-4ea6-9abc-ccea611e9cee",
                                                "sense_id": "9122fc58-f38b-3715-a44c-2cfb9b39afd2",
                                                "text": "„Zahlreiche Episoden des Romans weisen unzweideutig auf den ungebrochenen Humanitätsglauben hin, den er trotz der Schrecknisse der Zeit verkündet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e227822-0cdb-34e4-b89e-4e1f445f2e24",
                                        "entry_id": "7411e87e-8f62-307e-9419-ae52b4c93353",
                                        "glosses": [
                                            "kurzer Abschnitt im Krankheitsverlauf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598e3d9a-5f26-4383-9ddd-4eaa3029637b",
                                                "sense_id": "5e227822-0cdb-34e4-b89e-4e1f445f2e24",
                                                "text": "Im Verlauf von Krankheiten gibt es immer wieder mal kurze Episoden, in denen sich der Zustand des Patienten verschlimmert oder verbessert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "47387278-5fda-3976-adbf-033e2abc96ff",
                                        "entry_id": "7411e87e-8f62-307e-9419-ae52b4c93353",
                                        "glosses": [
                                            "einzelne Folge oder einzelner Teil einer Fernsehreihe oder eines mehrteiligen Films"
                                        ],
                                        "tags": [
                                            "Film",
                                            "Fernsehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3466f670-b793-4991-b205-eff318fd65e7",
                                                "sense_id": "47387278-5fda-3976-adbf-033e2abc96ff",
                                                "text": "In der letzten Episode stirbt die junge Heldin dann den Serientod."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "df60162e-1b52-308d-a7b3-da8afa117953",
                                        "entry_id": "7411e87e-8f62-307e-9419-ae52b4c93353",
                                        "glosses": [
                                            "zwischen die Ausführungen des Fugenthemas eingeschobener Satz"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd05c2bc-445e-43cd-8769-b165e638aea1",
                                                "sense_id": "df60162e-1b52-308d-a7b3-da8afa117953",
                                                "text": "Das erste Zwischenspiel kann in einer Fuge eine Episode modulatorischer Art oder freies Spielen mit Sequenzen des Themas sein."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "307e87ef-8f0e-4e11-8d2a-42e668fa11ca",
                        "source_entry_id": "eca52282-e66a-35cb-8d51-5b69192475a5",
                        "target_lang_word": "episode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "episode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                        "entry_id": "0fd6c845-1c9b-3b60-a99b-23403e4018bd",
                                        "glosses": [
                                            "An incident, action, or time period standing out by itself, but more or less connected with a complete series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b675bb2-a741-4a57-a0ac-80ec7f0da6c5",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "It was a most embarrassing episode in my life."
                                            },
                                            {
                                                "example_id": "f75a63f1-7462-4e7f-a528-8b1b0f70a32e",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "The Attorney-General, however, had used this episode, which Martin in retrospect had felt to be a blot on the scutcheon, merely to emphasise the intelligence and resource of the prisoner."
                                            },
                                            {
                                                "example_id": "e8d1ef6a-dcb1-4b30-a707-9f5563a4c269",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "Three of the great extinctions appear to have occurred during cold episodes and two during hot episodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                        "entry_id": "0fd6c845-1c9b-3b60-a99b-23403e4018bd",
                                        "glosses": [
                                            "An installment of a drama told in parts, as in a TV series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411cece0-9fd4-4dea-ba4a-0be53f8010e9",
                                                "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                                "text": "I can't wait till next week’s episode."
                                            },
                                            {
                                                "example_id": "65b7587a-fe4f-47a8-8f2b-0426ff148f41",
                                                "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                                "text": "We all know how genius “Kamp Krusty,” “A Streetcar Named Marge,” “Homer The Heretic,” “Itchy & Scratchy: The Movie” and “Mr. Plow” are, but even the relatively unheralded episodes offer wall-to-wall laughs and some of the smartest, darkest, and weirdest gags ever Trojan-horsed into a network cartoon with a massive family audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e782ab8-78f3-45e7-9e66-a73e07be6eee",
                        "source_entry_id": "eca52282-e66a-35cb-8d51-5b69192475a5",
                        "target_lang_word": "épisode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épisode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f24a08f-7065-3869-92b9-5e0689652c83",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Période complète inscrite dans le déroulement du temps, ayant un caractère spécifique."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aada0e1-6e9b-4918-8d50-018234fc71c7",
                                                "sense_id": "7f24a08f-7065-3869-92b9-5e0689652c83",
                                                "text": "Je ne dis rien du dernier épisode, celui de la fête de l’agriculture à la Chine, le seul de tous qui convînt au sujet, mais dont l’auteur étouffe tout l’intérêt à force d’emphase."
                                            },
                                            {
                                                "example_id": "6a8a4cf8-763e-463a-a1fc-1946c2da70f9",
                                                "sense_id": "7f24a08f-7065-3869-92b9-5e0689652c83",
                                                "text": "Pierre, trop heureux de trouver une oreille intéressée, se lança dans la narration des épisodes de la veille, de son départ du Jardin du roi jusqu'à son espionnage chez le baron d’Holbach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5532af06-d0a7-3195-abd1-45ec1869ffbf",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Période complète inscrite dans le déroulement du temps, ayant un caractère spécifique.",
                                            "Récit secondaire faisant partie d’une œuvre principale."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb0490d-567e-44cc-a1df-999732c3fae3",
                                                "sense_id": "5532af06-d0a7-3195-abd1-45ec1869ffbf",
                                                "text": "Ce trait amène un Épisode intéressant , dont il résulte , qu’il y eut sous le règne de David plusieurs prisonniers de guerre Juifs dans le royaume de Damas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59a6efa-ae89-30fe-a496-4cfca356fa13",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Période complète inscrite dans le déroulement du temps, ayant un caractère spécifique.",
                                            "Toute action ou scène secondaire ajoutée à celle qui fait le sujet principal d’un tableau."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1cda1b-ce74-44cc-8805-85cf1573ce73",
                                                "sense_id": "e59a6efa-ae89-30fe-a496-4cfca356fa13",
                                                "text": "En matiére de Peinture comme de Poésie, on appelle épisode toute action accessoire qu’on ajoute à l’action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2facce3f-1185-3663-b7e0-ccee75985ac6",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Période complète inscrite dans le déroulement du temps, ayant un caractère spécifique.",
                                            "Évènement circonscrit dans le temps, incident, isolé en apparence, mais qui se rattache plus ou moins à quelque grand évènement."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e5441a-15cb-41b5-81e8-c1edc02ac5de",
                                                "sense_id": "2facce3f-1185-3663-b7e0-ccee75985ac6",
                                                "text": "Voici, par exemple, au bord de la route qui me conduit à Montauban, le joli bourg de Réalville, […] où, par la suite, se déroulèrent de tragiques épisodes de la vaine lutte entre catholiques et protestants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8420742f-8b6b-3ef5-8da4-45666eb579e4",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Période complète inscrite dans le déroulement du temps, ayant un caractère spécifique.",
                                            "Période circonscrite de la présence des symptômes d’une maladie."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef821f6-8545-45f8-8a52-b3b5356f1f6b",
                                                "sense_id": "8420742f-8b6b-3ef5-8da4-45666eb579e4",
                                                "text": "Plutôt que de s’appesantir sur ces discussions, il est préférable d’aider le lecteur à ne pas prendre pour une maladie de Crohn tout épisode de diarrhée inhabituel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8956862-708a-3fc7-a541-746384318792",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Cette période elle-même considérée comme principale et constituant une partie d’un ensemble identique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79b01459-b155-3e13-affb-388fec3b8cb9",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Cette période elle-même considérée comme principale et constituant une partie d’un ensemble identique.",
                                            "Émission individuelle de télévision, radio, baladodiffusion, etc., qui fait partie d’une série."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8f4262-051e-4f10-bf61-6b7a77de69ca",
                                                "sense_id": "79b01459-b155-3e13-affb-388fec3b8cb9",
                                                "text": "« Quand j’étais petit, je ne ratai jamais un seul de vos épisodes. Le Fantôme gris était mon héros.\n— Je n’aurai donc pas été totalement inutile. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e97d23-7c52-3051-9110-74c7d28d480e",
                                        "entry_id": "c194bc55-ad3c-3174-b255-44a6f1256ed8",
                                        "glosses": [
                                            "Cette période elle-même considérée comme principale et constituant une partie d’un ensemble identique.",
                                            "Récit que l’on introduit dans un poème didactique pour lui donner plus de variété, plus d’intérêt."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
