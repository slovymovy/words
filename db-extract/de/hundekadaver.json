                "senses": [
                    {
                        "sense_id": "8bffa14b-f3f9-37ec-b463-02fd33c413d7",
                        "entry_id": "ae37a208-e959-383e-819e-dbd7b3dde666",
                        "glosses": [
                            "Kadaver eines Hundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a2480e-8cd8-48cf-a64b-6aa2092cb3f4",
                                "sense_id": "8bffa14b-f3f9-37ec-b463-02fd33c413d7",
                                "text": "„Als sie eingeschlafen ist, bin ich zurück und hab den Hundekadaver geholt und an das drinnen verfüttert.“"
                            },
                            {
                                "example_id": "a1aeda78-368a-4dce-b33d-599f9d00d942",
                                "sense_id": "8bffa14b-f3f9-37ec-b463-02fd33c413d7",
                                "text": "„Ich weiß nicht mehr, ob ich erwähnte, dass wir bei der Überprüfung der Hundekadaver ein Tier vermissten.“"
                            },
                            {
                                "example_id": "73969089-010d-4a80-aad4-3ee07fc58521",
                                "sense_id": "8bffa14b-f3f9-37ec-b463-02fd33c413d7",
                                "text": "„Ein würziges Aroma kitzelte meine Geschmacksnerven - bis ich das Hinterteil eines Hundekadavers sah, das aus einem Kochtopf ragte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
