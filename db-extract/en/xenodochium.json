                "senses": [
                    {
                        "sense_id": "50dd3f5c-2061-373e-bc0b-8f92570bdd8c",
                        "entry_id": "fff759cf-b666-32e3-9da0-02c8bc2511ef",
                        "glosses": [
                            "A room (or separate guesthouse) in a monastery for the temporary accommodation of guests or pilgrims."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4987a47f-e97c-48fd-9d21-1d3e9fc6e919",
                                "sense_id": "50dd3f5c-2061-373e-bc0b-8f92570bdd8c",
                                "text": "Gregory the Great orders that the accounts of xenodochia should be audited by the bishop (Epist. iv. 27)."
                            },
                            {
                                "example_id": "3d9e13c3-c128-4d1b-833b-5c5b681b2a99",
                                "sense_id": "50dd3f5c-2061-373e-bc0b-8f92570bdd8c",
                                "text": "There is, first, the xenodochium, to provide lodging for passing strangers, pilgrims, travellers, refugees, exiles of all kinds, like the one founded at Ostia by Pammachius and Fabiola for all who were embarking or landing."
                            },
                            {
                                "example_id": "aa8a5bea-0a01-4861-9646-ba4ea1c2349f",
                                "sense_id": "50dd3f5c-2061-373e-bc0b-8f92570bdd8c",
                                "text": "His and his uncle Johannes de Curte's principal gift to Monte Cassino was a xenodochium or \"hospitale\" to house the pilgrims who, in great numbers, visited the famous shrine of the Archangel Michael."
                            }
                        ]
                    }
                ],
