                    }
                ],
                "translations": [
                    {
                        "translation_id": "02fd9c21-d5d7-49a5-af10-b046a70b9bea",
                        "source_entry_id": "ca463553-3ece-3fde-9f74-4edfeab5bd5c",
                        "target_lang_word": "governor-general",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "governor-general",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea051897-c8d2-330d-8cba-5603a061144c",
                                        "entry_id": "5889750a-4fd7-3cff-a1c4-ea59d89b3500",
                                        "glosses": [
                                            "An official appointed by the reigning British monarch to govern a Commonwealth realm as the monarch's representative."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f120f1a3-912d-4364-8b1d-5c2454b8b6fc",
                                                "sense_id": "ea051897-c8d2-330d-8cba-5603a061144c",
                                                "text": "The vulnerability of the Governor-General should not be overstated."
                                            },
                                            {
                                                "example_id": "ac74f459-8414-443c-80a7-9debb449524c",
                                                "sense_id": "ea051897-c8d2-330d-8cba-5603a061144c",
                                                "text": "2003, The Far East and Australasia 2003, Europa Publications, page 122,\nThe legislative power of the Commonwealth of Australia is vested in a Federal Parliament, consisting of HM the Queen (represented by the Governor-General), a Senate, and a House of Representatives."
                                            },
                                            {
                                                "example_id": "d81bbea3-6187-4f91-9002-947eb541a9ad",
                                                "sense_id": "ea051897-c8d2-330d-8cba-5603a061144c",
                                                "text": "It is a historical and analytical study of the position of Viceroy and Governor-General in the Indian constitutional system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                        "entry_id": "5889750a-4fd7-3cff-a1c4-ea59d89b3500",
                                        "glosses": [
                                            "An official in a similar position in other countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113f602e-ce7b-4f71-983b-d856df802532",
                                                "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                                "text": "Nikolai Bobrikov served as governor-general of the Grand Duchy of Finland from 1898 until his untimely death in 1904."
                                            },
                                            {
                                                "example_id": "4dbde9ff-3c85-4e00-b61b-d20a9bec6bda",
                                                "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                                "text": "[…]the proper warrants thereon shall be issued by the auditor and countersigned by the governor-general."
                                            },
                                            {
                                                "example_id": "997094a2-c6c7-40de-9e62-1e16559669a6",
                                                "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                                "text": "The Governor-General of Amur resides at Khabarovka (哈巴羅甫喀，即，伯利), in the Primorsk Province (東海濱省).",
                                                "translation": "RUSSIA IN ASIA",
                                                "english": "RUSSIA IN ASIA"
                                            },
                                            {
                                                "example_id": "93c9f6c3-c635-477c-92b1-be3740609484",
                                                "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                                "text": "A real acuerdo (decision reached by a full session of the high court presided over by the governor-general) gradually came to have the force of law in the form of administrative ordinances embracing a wide range of subjects."
                                            },
                                            {
                                                "example_id": "3ce8ea76-974e-4e0b-84a4-54229a5c1744",
                                                "sense_id": "4f20f8a4-732a-3086-a909-c7706db09ec5",
                                                "text": "2007, Taiwan under Japanese Rule, 1895—1945, Murray A. Rubinstein (editor), Taiwan: A New History, page 222,\nIn the meantime the Taiwan governors-general were gradually brought under closer supervision of the home government in Tokyo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3465fe6-2d38-3ad6-a4ca-7f782fff2152",
                                        "entry_id": "5889750a-4fd7-3cff-a1c4-ea59d89b3500",
                                        "glosses": [
                                            "A zongdu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d239296d-f339-4c6c-94be-08258682b913",
                        "source_entry_id": "ca463553-3ece-3fde-9f74-4edfeab5bd5c",
                        "target_lang_word": "governor general",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "governor general",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45272cd3-84f0-340e-9f84-0dc12e38eba8",
                                        "entry_id": "9275594a-4d45-3bdc-b080-0cacee44f2d4",
                                        "glosses": [
                                            "An official appointed by the reigning British monarch to govern a Commonwealth realm as the monarch's representative."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "574dfcff-1b0e-4e73-9351-29cf9772fd03",
                                                "sense_id": "45272cd3-84f0-340e-9f84-0dc12e38eba8",
                                                "text": "In 1968, as one of the projects sponsored by the federal Centennial Commission, Irma Coucill was asked to add drawings of all the Governors General and Prime Ministers since Confederation."
                                            },
                                            {
                                                "example_id": "9fb73bbd-9cad-4eb0-99b9-11117c63498f",
                                                "sense_id": "45272cd3-84f0-340e-9f84-0dc12e38eba8",
                                                "text": "But in a minority government scenario, the governor general might still be called upon to play a part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c17aa3f3-7f01-3602-b824-3ec0038634fb",
                                        "entry_id": "9275594a-4d45-3bdc-b080-0cacee44f2d4",
                                        "glosses": [
                                            "An official in a similar position in other countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeabd598-a05b-4861-859d-682168fc54c8",
                                                "sense_id": "c17aa3f3-7f01-3602-b824-3ec0038634fb",
                                                "text": "The practice and usage have been recognised in a variety of instances by the Governors General of Louisiana."
                                            },
                                            {
                                                "example_id": "2f3654da-9be7-4782-a57e-1286ec79844c",
                                                "sense_id": "c17aa3f3-7f01-3602-b824-3ec0038634fb",
                                                "text": "Because of the military′s autonomy in the Japanese political system, the relationships of the governors general in Korea to the prime minister′s office in Japan remained ambiguous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
