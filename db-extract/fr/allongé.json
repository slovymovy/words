                "senses": [
                    {
                        "sense_id": "77933f3e-f8ba-3522-939a-4ba9c5ab2725",
                        "entry_id": "ca4b62b6-85c9-3336-b8b7-ad48ac558db7",
                        "glosses": [
                            "Personne se tenant sur le dos en position couchée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a40407-bdac-4424-847b-4e667cf83e42",
                                "sense_id": "77933f3e-f8ba-3522-939a-4ba9c5ab2725",
                                "text": "Elle alla à Berck pour y rencontrer une espèce de sainte qui avait consacré sa vie aux « allongés »."
                            }
                        ]
                    },
                    {
                        "sense_id": "229ccf79-6cdb-390a-8e39-0046c1fd934a",
                        "entry_id": "ca4b62b6-85c9-3336-b8b7-ad48ac558db7",
                        "glosses": [
                            "Personne atteinte de la tuberculose."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "698b706c-1dfd-4819-b067-795d73b6165c",
                                "sense_id": "229ccf79-6cdb-390a-8e39-0046c1fd934a",
                                "text": "On trouvera ainsi dans le courrier : les dactylos, les coloniaux, les exilés, les cols bleus, les aviateurs…. La majorité de ces groupes sont très genrés, à l’exception notable des “allongés”, ceux qui, en traitement pour la tuberculose sont allongés en sanatorium."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
