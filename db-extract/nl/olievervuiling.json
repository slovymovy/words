                        "examples": [
                            {
                                "example_id": "cd9e8923-94d1-4fcb-ab16-041aa3b4b0ba",
                                "sense_id": "40b899b9-f580-31fe-af2d-672e952e6e35",
                                "text": "Een dochteronderneming van Shell moet schadevergoeding betalen aan een Nigeriaanse boer voor de schade die hij heeft geleden door olievervuiling. Dat heeft de rechtbank in Den Haag besloten. In vier andere gevallen hoeft Shell niet te betalen. De zaak was aangespannen door Milieudefensie namens de Nigeriaanse boeren. Bij de rechtbank in Den Haag is Henrik Willem Hofs."
                            },
                            {
                                "example_id": "ae42aa81-186d-45d5-93ff-bb32e2d90b03",
                                "sense_id": "40b899b9-f580-31fe-af2d-672e952e6e35",
                                "text": "Nigeriaanse boeren die een zaak tegen Shell over olievervuiling hebben verloren, zijn samen met Milieudefensie in hoger beroep gegaan bij het gerechtshof in Den Haag."
                            }
                        ]
                    }
