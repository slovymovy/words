            "senses": [
                {
                    "sense_id": "4edeb41b-e422-3bc8-afd3-bd0a3f5a6672",
                    "sense_definition": "A high-pitched, sharp cry or sound; an instance of a squeal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>squealing</w> of the rusty hinges echoed through the empty hallway.",
                            "target_lang_translations": {
                                "nl": "Het aanhoudende <w>gepiep</w> van de roestige scharnieren galmde door de lege gang."
                            }
                        },
                        {
                            "text": "We could hear the faint <w>squealing</w> of piglets from the barn.",
                            "target_lang_translations": {
                                "nl": "We konden het zwakke <w>gekrijs</w> van biggetjes uit de schuur horen."
                            }
                        }
                    ],
                    "synonyms": [
                        "screeching",
                        "shrieking",
                        "squeal"
                    ],
                    "common_phrases": [
                        "constant squealing",
                        "loud squealing"
                    ],
                    "target_lang_definitions": {
                        "nl": "een hoge, scherpe kreet of een piepend/gierend geluid"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het gillen",
                                "target_lang_sense_clarification": "van opwinding of angst"
                            },
                            {
                                "target_lang_word": "het gekrijs",
                                "target_lang_sense_clarification": "luid, doordringend geschreeuw"
                            },
                            {
                                "target_lang_word": "het gepiep",
