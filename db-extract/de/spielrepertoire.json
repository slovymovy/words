                "senses": [
                    {
                        "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                        "entry_id": "71b88364-c6af-3ebd-8c3a-9ec8b3995d57",
                        "glosses": [
                            "Vorrat an verfügbaren Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d698bf-1e08-404c-97cc-d181ea1ddf9a",
                                "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                                "text": "„Die Wiener Psychologieschule und William Stern hatten innerhalb des gesamten Spielrepertoires der Kinder auch die Sozialspiele beobachtet und versucht, die typische Abfolge ausfindig zu machen, in der die Kinder soziales Spielen lernen und ausbilden.“"
                            },
                            {
                                "example_id": "fb04a568-8c28-49f9-8ee7-5485e8f8df0b",
                                "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                                "text": "„Sie (die Hämespiele) kontrastieren mit den ernsten Wettspielen, Kampfspielen, Kriegsspielen, Abenteuerspielen und bereichern dadurch das Spielrepertoire.“"
                            },
                            {
                                "example_id": "326da72b-11a3-46e1-a0c3-248ff8ad86f9",
                                "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                                "text": "„Das Regelspiel löst aber wiederum Rollen- und Konstruktionsspiel nicht einfach ab, sondern erweitert das Spielrepertoire lediglich.“"
                            },
                            {
                                "example_id": "7f2a13ec-88a8-4719-b661-57982cf835e8",
                                "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                                "text": "„Kriegsspiele gehören überall auf der Welt zum Spielrepertoire.“"
                            },
                            {
                                "example_id": "b290b80f-0b45-4cda-a4f8-a9379db6a8ba",
                                "sense_id": "ddccf64e-40e2-31ef-94a8-f0e0f9d71c96",
                                "text": "„Hier konzentrieren wir uns darauf, mit den gleichen Techniken das Spielrepertoire des Kindes mit Spielsachen zu erweitern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
