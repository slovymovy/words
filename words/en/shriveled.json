{
    "word_family": [
        "shrivel",
        "shriveling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1944943-4ddd-337f-97c8-dfdc2b0a263e",
                    "sense_definition": "Wrinkled, withered, or shrunk, especially due to loss of moisture or age.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shrunken_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry summer heat left nothing but <w>shriveled</w> leaves on the garden floor.",
                            "target_lang_translations": {
                                "ru": "Сухой летний зной оставил на земле в саду лишь <w>высохшие</w> листья.",
                                "zh": "干燥的夏日酷暑过后，花园地上只剩下<w>皱缩的</w>落叶。"
                            }
                        },
                        {
                            "text": "A prune is simply a <w>shriveled</w> plum that has been dried in the sun.",
                            "target_lang_translations": {
                                "ru": "Чернослив — это просто <w>сморщенная</w> слива, высушенная на солнце.",
                                "zh": "西梅其实就是经过阳光暴晒而<w>干枯的</w>李子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "withered",
                        "shrunken",
                        "wrinkled"
                    ],
                    "antonyms": [
                        "plump",
                        "swollen"
                    ],
                    "common_phrases": [
                        "shriveled leaves",
                        "shriveled skin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сморщенный, высохший или уменьшившийся в размерах, особенно из-за потери влаги или возраста.",
                        "zh": "因失去水分或衰老而变得皱缩、干枯或萎缩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сморщенный",
                                "target_lang_sense_clarification": "о коже, плодах, листьях"
                            },
                            {
                                "target_lang_word": "высохший",
                                "target_lang_sense_clarification": "о растениях, плодах"
                            },
                            {
                                "target_lang_word": "увядший",
                                "target_lang_sense_clarification": "о цветах, листьях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皱缩的",
                                "target_lang_sense_clarification": "形容表面因失水而产生褶皱"
                            },
                            {
                                "target_lang_word": "干枯的",
                                "target_lang_sense_clarification": "形容植物或果实失去水分"
                            },
                            {
                                "target_lang_word": "枯萎的",
                                "target_lang_sense_clarification": "形容花朵或叶子失去生机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "189055e7-915a-316a-9fd8-831946265fb9",
                    "sense_definition": "Collapsed or significantly reduced in size, strength, or vitality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shrunken_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her lips looked too <w>shriveled</w> to close properly over her teeth.",
                            "target_lang_translations": {
                                "ru": "Ее губы выглядели слишком <w>сморщенными</w>, чтобы полностью прикрывать зубы.",
                                "zh": "她的嘴唇看起来太<w>干瘪</w>了，无法完全盖住牙齿。"
                            }
                        },
                        {
                            "text": "The old man stared at his <w>shriveled</w> limbs, remembering his youth as an athlete.",
                            "target_lang_translations": {
                                "ru": "Старик смотрел на свои <w>усохшие</w> конечности, вспоминая свою атлетическую молодость.",
                                "zh": "老人盯着自己<w>萎缩的</w>四肢，回忆起他身为运动员的青春岁月。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wasted",
                        "atrophied"
                    ],
                    "antonyms": [
                        "robust",
                        "healthy"
                    ],
                    "common_phrases": [
                        "shriveled limbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опавший, уменьшившийся в объеме или потерявший силу и жизнеспособность.",
                        "zh": "指身体部位或器官因衰老、疾病而萎缩、干瘪，失去活力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усохший",
                                "target_lang_sense_clarification": "о конечностях, теле"
                            },
                            {
                                "target_lang_word": "атрофированный",
                                "target_lang_sense_clarification": "о мышцах, конечностях"
                            },
                            {
                                "target_lang_word": "сморщенный",
                                "target_lang_sense_clarification": "о губах, коже от старости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干瘪的",
                                "target_lang_sense_clarification": "形容身体部位失去丰满感"
                            },
                            {
                                "target_lang_word": "萎缩的",
                                "target_lang_sense_clarification": "形容肌肉或肢体因退化而变小"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f23d795e-3e81-3ece-a65e-f00624982db1",
                    "sense_definition": "Simple past tense and past participle of <w>shrivel</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grapes <w>shriveled</w> under the intense heat of the desert sun.",
                            "target_lang_translations": {
                                "ru": "Виноград <w>сморщился</w> под палящим зноем пустынного солнца.",
                                "zh": "葡萄在沙漠烈日的炙烤下<w>皱缩</w>了。"
                            }
                        },
                        {
                            "text": "Without water, the beautiful flowers quickly <w>shriveled</w> and died.",
                            "target_lang_translations": {
                                "ru": "Без воды красивые цветы быстро <w>завяли</w> и погибли.",
                                "zh": "没有水，美丽的花朵很快就<w>枯萎</w>凋谢了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола shrivel (высыхать, сморщиваться).",
                        "zh": "动词 shrivel 的过去式或过去分词，意为枯萎、皱缩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сморщился",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "высох",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "завял",
                                "target_lang_sense_clarification": "прошедшее время глагола о растениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "皱缩",
                                "target_lang_sense_clarification": "指物体表面因失水而收缩"
                            },
                            {
                                "target_lang_word": "枯萎",
                                "target_lang_sense_clarification": "指植物因缺水而凋谢"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}