                "senses": [
                    {
                        "sense_id": "b3b5f330-dc33-3eae-828f-40d46ac6357a",
                        "entry_id": "8397adc2-8587-3aa7-a6c5-35e0b5d363b0",
                        "glosses": [
                            "iemand die op een heel kunstige manier zijn evenwicht kan bewaren"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b07003f4-eec1-4d3b-be9f-dfcf93b6a75f",
                                "sense_id": "b3b5f330-dc33-3eae-828f-40d46ac6357a",
                                "text": "De Chinese koorddanser Aisikaier was bezig met zijn act tussen twee bergen in de provincie Hunan toen hij uiteindelijk, achteruitlopend en geblindeerd, toch zijn evenwicht verloor. Aisikaier had geen voorzorgsmaatregelen genomen en viel zo'n tweehonderd meter naar beneden. Hij hield aan zijn val slechts lichte verwondingen over. Spectaculaire beelden van de evenwichtskunstenaar; het gaat mis op 2.05."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1a349c4-c9e7-36be-9880-385f437dca6a",
                        "entry_id": "8397adc2-8587-3aa7-a6c5-35e0b5d363b0",
                        "glosses": [
                            "iemand die op een kunstige manier weet om te gaan met snel wisselende en tegengestelde krachten en meningen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c67d11d4-71a9-44ae-b7c7-4afb69603447",
                                "sense_id": "c1a349c4-c9e7-36be-9880-385f437dca6a",
                                "text": "Journalisten typeren Rutte als een \"evenwichtskunstenaar\" en iemand die \"vrolijk overeind blijft in een onmogelijke combinatie\". \"Hij laveert kundig van meerderheid naar meerderheid,\" staat in een van de inzendingen."
                            }
                        ]
                    }
