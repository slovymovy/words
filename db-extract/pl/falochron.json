                "senses": [
                    {
                        "sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "glosses": [
                            "konstrukcja hydrotechniczna, która służy do ochrony wybrzeża lub portu przed działaniem fal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d533fb1-7730-484d-b0ed-9302ca6ccdf6",
                                "sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                                "text": "Sztorm uszkodził tylko cztery metry nabrzeża i podmył dno pod kamieniami osłaniającymi falochron."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cc33cda-8b11-4573-b553-25effe0b5129",
                        "source_entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "source_sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "target_lang_word": "breakwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breakwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48590b2c-5935-35e6-a1ae-bbc72ef25a22",
                                        "entry_id": "278425ec-3f85-3fa2-8dc5-5b375a01a42c",
                                        "glosses": [
                                            "A construction in or around a harbour designed to break the force of the sea and to provide shelter for vessels lying inside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5987fda5-b93b-4976-8595-f88806e92bba",
                                                "sense_id": "48590b2c-5935-35e6-a1ae-bbc72ef25a22",
                                                "text": "[…]there is a channel, some three miles wide between the city and the mainland, and some mile and a half wide between it and the sandy breakwater called the Lido, which divides the lagoon from the Adriatic,"
                                            },
                                            {
                                                "example_id": "3158c809-31ff-41b8-b520-e4a0529b3b4a",
                                                "sense_id": "48590b2c-5935-35e6-a1ae-bbc72ef25a22",
                                                "text": "But there's a pier or breakwater runs out into the sea just here, which we could defend longer than anything else, like Horatius and his bridge."
                                            },
                                            {
                                                "example_id": "278ccbec-fc9b-463d-b941-c6c2fa03a84c",
                                                "sense_id": "48590b2c-5935-35e6-a1ae-bbc72ef25a22",
                                                "text": "Using the countless tons of rock from the cliff-face, supplemented by much more from inland, they threw out a huge breakwater, 2,000 ft. long and 80 ft. high, roughly at right angles to the quay, so forming an almost completely sheltered corner. Fifty years later, this massive mole is still standing up to the worst that the Irish Sea can do."
                                            },
                                            {
                                                "example_id": "33d19ae9-cc54-4c4e-a5dc-27c6b7ab473e",
                                                "sense_id": "48590b2c-5935-35e6-a1ae-bbc72ef25a22",
                                                "text": "They sailed around a breakwater that hadn't existed on Peregrine's last trip and tied in at the moorage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "637fca26-8cf2-3395-9e04-ced322dad680",
                                        "entry_id": "278425ec-3f85-3fa2-8dc5-5b375a01a42c",
                                        "glosses": [
                                            "A low bulkhead across the forecastle deck of a ship which diverts water breaking over the bows into the scuppers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1672783e-b9b8-34e9-9c82-780f54ae2864",
                                        "entry_id": "278425ec-3f85-3fa2-8dc5-5b375a01a42c",
                                        "glosses": [
                                            "A wooden or concrete barrier, usually perpendicular to the shore, intended to prevent the movement of sand along a coast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8041dc63-044f-42bd-bf9b-cdc4194c0841",
                        "source_entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "source_sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "target_lang_word": "vlnolam",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vlnolam",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e654ca52-b735-3de6-96a7-933422a50cec",
                                        "entry_id": "49cc7bea-87c4-3db1-a0d3-f4e97d531348",
                                        "glosses": [
                                            "řada kůlů, hráz či podobná překážka u břehu moře sloužící ke zmírnění eroze způsobené vlnami"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd6fc922-6d87-48c2-bfd7-0915af40ceba",
                        "source_entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "source_sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "target_lang_word": "brise-lame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brise-lame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "316f0fd8-b148-3dd3-915f-6b511efece6f",
                                        "entry_id": "bcecd760-6dc3-3181-863f-813ce6cbaa1c",
                                        "glosses": [
                                            "Variante orthographique de brise-lames."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f5562f-9f73-46b5-b8dc-92d9317dcd1d",
                                                "sense_id": "316f0fd8-b148-3dd3-915f-6b511efece6f",
                                                "text": "Et, sans plus de façons, le juge de Valognes y avait pris place, dès potron-minet, alors que les dernières étoiles se miraient encore dans les eaux lourdes du bassin saint-vaastais mêlant leurs éclats pâlis à ceux du feu de la jetée, des phares de Jonville et Gatteville, aux deux clignots vert et rouge du brise-lame."
                                            },
                                            {
                                                "example_id": "89d20769-f407-4dca-a463-36e4afbe641b",
                                                "sense_id": "316f0fd8-b148-3dd3-915f-6b511efece6f",
                                                "text": "Pendant quelques interminables minutes, l’ex-inspecteur-chef Alcazar laissa errer son regard sur la houle qui s’éteignait paisiblement sur le brise-lame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ff0dc84-3715-4e77-b6ca-d50a9095c3e6",
                        "source_entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "source_sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "target_lang_word": "rompeolas",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "245125a8-329a-45c8-95a4-04cbb67940ae",
                        "source_entry_id": "9494c607-15a4-3257-ac88-100803d0bb56",
                        "source_sense_id": "bd0077a3-a486-3129-bacf-506d60213b08",
                        "target_lang_word": "Wellenbrecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wellenbrecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f60bd75-523f-33aa-9115-f68667d51ff0",
                                        "entry_id": "7775a771-f57b-3397-b964-68db6876494e",
                                        "glosses": [
                                            "Anlage (zum Beispiel ein Damm), die ankommende Wasserwellen brechen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75561b8-6b7f-4c69-b8e7-fe5908b99470",
                                                "sense_id": "8f60bd75-523f-33aa-9115-f68667d51ff0",
                                                "text": "„Tetrapoden werden an der Küstenlinie, an Dämmen oder Hafenmolen aneinander gereiht oder in mehreren Reihen aufeinander geschichtet. Sie dienen primär als Wellenbrecher und sollen die Kraft der Wasserwellen, die gegen das Ufer schlagen, mindern.“"
                                            },
                                            {
                                                "example_id": "b3e35b2a-5e3f-4a46-8132-746b07913d21",
                                                "sense_id": "8f60bd75-523f-33aa-9115-f68667d51ff0",
                                                "text": "„Die ersten Bodenerosionen wurden hier um 1950 festgestellt. Einige der Touristenorte mussten daraufhin Wellenbrecher (Barrieren aus großen Steinen) errichten, mit deren Hilfe es bisher möglich war, das Wasser zurückzuhalten und den Strandbereich sogar zu vergrößern.“"
                                            },
                                            {
                                                "example_id": "5d6d21c4-b039-4c40-8a82-9509e5be8f59",
                                                "sense_id": "8f60bd75-523f-33aa-9115-f68667d51ff0",
                                                "text": "[Osterinsel:] „Immerhin aber beteiligt sich die Regierung am Bau einer Schutzmauer, die im Südosten der dreiecksförmigen Insel als Wellenbrecher für die Statuen von Uranga Te Mahina dienen soll.“"
                                            },
                                            {
                                                "example_id": "0734cd54-f88f-4888-8e0f-bf1ca4177be4",
                                                "sense_id": "8f60bd75-523f-33aa-9115-f68667d51ff0",
                                                "text": "„In langen Stößen klangen die Wogen heran, stürmten gegen die Steinblöcke der Wellenbrecher und türmten sich zu fliegendem Schaum und weißer Brandung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "313f20bd-0c42-3007-843a-791531fe7ab0",
                                        "entry_id": "7775a771-f57b-3397-b964-68db6876494e",
                                        "glosses": [
                                            "Vorrichtung auf dem Vordeck von Schiffen, die das Schiff überrollende Wellen brechen und zur Seite ablenken soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c44f57-18aa-46f1-babe-fb7c6de16dc7",
                                                "sense_id": "313f20bd-0c42-3007-843a-791531fe7ab0",
                                                "text": "„Die Panzerung wurde erst nachträglich richtig befestigt, der Großmast musste versetzt werden, und Schanzkleider wurden als Wellenbrecher auf den Vorsteven aufgesetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b3098831-20ea-3207-a1e5-5fe39dd94bad",
                                        "entry_id": "7775a771-f57b-3397-b964-68db6876494e",
                                        "glosses": [
                                            "Maßnahme, welche die Übertragungshäufigkeit während einer Infektionswelle verringern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cad14e5-0f98-4109-86f9-45105c36f18a",
                                                "sense_id": "b3098831-20ea-3207-a1e5-5fe39dd94bad",
                                                "text": "„Ministerpräsident Michael Kretschmer (CDU) kündigte in einer Regierungserklärung im Landtag für sein Bundesland einen ‚harten und klaren Wellenbrecher‘ für zwei oder drei Wochen an.“"
                                            },
                                            {
                                                "example_id": "ea90b24f-0c76-4ec0-8560-01c4f65dec77",
                                                "sense_id": "b3098831-20ea-3207-a1e5-5fe39dd94bad",
                                                "text": "„Es sollte ein ‚Wellenbrecher‘ sein, um die im Oktober exponentiell gestiegenen Corona-Infektionszahlen wieder in einen akzeptablen Bereich zu drücken: Anfang November wurden alle Restaurants, Cafés und Bars geschlossen.“"
                                            },
                                            {
                                                "example_id": "b01bb394-8ce5-4932-84d6-805bbbc6ba8e",
                                                "sense_id": "b3098831-20ea-3207-a1e5-5fe39dd94bad",
                                                "text": "„Keine große Wirkung des ‚Wellenbrechers‘ – Der teilweise Lockdown seit Anfang November, den manche Politiker ‚Wellenbrecher‘ nennen, hat bislang für eine Stabilisierung der Infektionszahlen auf hohem Niveau gesorgt, nicht aber zu einer Verringerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
