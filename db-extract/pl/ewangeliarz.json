                    {
                        "sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                        "entry_id": "4a430d19-58e9-3c11-8b11-812e240bc1f1",
                        "glosses": [
                            "księga liturgiczna z podzielonymi na perykopy ewangeliami"
                        ],
                        "tags": [
                            "bibliot."
                        ],
                        "examples": [
                            {
                                "example_id": "31c13fa9-aca1-4683-b5b0-afa47fed7e83",
                                "sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                                "text": "Po błogosławieństwie ewangeliarzem biskup wygłosił homilię."
                            },
                            {
                                "example_id": "6b5dadc2-d9bb-4e11-a1c5-9f6e2954693d",
                                "sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                                "text": "W tej gablocie wystawione są zabytkowe bogato zdobione ewangeliarze pochodzące z Sącza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
