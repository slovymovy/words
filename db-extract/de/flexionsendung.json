                "senses": [
                    {
                        "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                        "entry_id": "f898398a-02f4-3a38-a8cc-6d470c6821ae",
                        "glosses": [
                            "grammatisches Morphem, das als Flexionssuffix in Deklination, Konjugation oder Komparation dient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5789637d-bf87-4fce-ad79-9ce7bbf30ebe",
                                "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                                "text": "\"-st\" ist eine häufig verwendete Flexionsendung für die 2. Person Singular von Verben (Konjugation)."
                            },
                            {
                                "example_id": "d33c499a-e767-4e4c-83a9-af4855bb357d",
                                "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                                "text": "„Im Bereich der Aussprache ist oft die Tendenz zu betonter Nachlässigkeit zu beobachten, die sich unter anderem im Verschleifen von Flexionsendungen äußert.“"
                            },
                            {
                                "example_id": "b3373f40-a151-400b-a666-01aa79ebf60d",
                                "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                                "text": "„Dennoch haben die Flexionsendungen, Pronomen, Numerale und andere Wörter der indoeuropäischen Sprachen eine große Ähnlichkeit, die kein Zufall sein kann.“"
                            },
                            {
                                "example_id": "117b2250-b804-4551-bb0a-d9a0c462ccfb",
                                "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                                "text": "„Flexionsendungen wurden ebenfalls ins Jiddische entlehnt.“"
                            },
                            {
                                "example_id": "506738c0-2064-4680-9d3b-d3618c522fc8",
                                "sense_id": "8dfadbf3-c49e-3dc4-9df7-82551fb93d46",
                                "text": "„Deutliches Kennzeichen des Niederhessischen zu allen anderen hessischen Mundarten sind die erhaltenen Flexionsendungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
