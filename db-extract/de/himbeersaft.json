                                "example_id": "e805af96-e205-4b51-ba00-5a96b0cf1c58",
                                "sense_id": "33ec27b3-1065-3d04-8015-e85a96cdf4fb",
                                "text": "„Wenn der Großvater Godny kein Geld mehr für den Wodka hatte, trank er Spiritus, den er mit etwas Wasser und Himbeersaft streckte.“"
                            },
                            {
                                "example_id": "5cbc7c4a-a5b7-4b1e-af1d-a23b262d23b6",
                                "sense_id": "33ec27b3-1065-3d04-8015-e85a96cdf4fb",
                                "text": "„Lächelnd nahm sie einen Lappen zur Hand und wischte ein paar Flecken Himbeersaft vom Boden vor der Spüle.“"
                            }
                        ],
