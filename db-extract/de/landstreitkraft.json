                ],
                "senses": [
                    {
                        "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                        "entry_id": "41a37bee-7384-30b8-b052-09752ca13202",
                        "glosses": [
                            "Heer; militärische Teilstreitkraft zu Lande"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9d455c-bc02-4d65-90f8-3581a3103391",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Das spartanische Herr aus dem antiken Griechenland galt lange als professionellste Landstreitkraft überhaupt.“"
                            },
                            {
                                "example_id": "29bb8110-2a5e-46e9-89cb-36ab95576745",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Synchronisiert mit dem Feuerschlag haben die Landstreitkräfte der anderen Seite schnell in die Tiefe des zu verteidigenden Raumes vorzustoßen.“"
                            },
                            {
                                "example_id": "bdd70815-e2a4-499e-b45e-679ef5b7386a",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Der Führungsprozess der Landstreitkräfte ist ein wichtiger Bezugspunkt dieser Arbeit, weshalb sich das folgende Kapitel diesem ausführlich widmet.“"
                            },
                            {
                                "example_id": "d1d2e99c-e427-4971-b125-1e32f046c535",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Danach erfolgte eine umfassende Umstrukturierung und Modernisierung des militärischen Geheimdienstes der Landstreitkräfte.“"
                            },
                            {
                                "example_id": "5014a49b-9648-4ca3-b47a-de6344f266b9",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Außerdem planten die Russen eine weitere Verstärkung ihrer Landstreitkräfte bis 1917 um zusätzliche drei bis vierhunderttausend Mann.“"
                            },
                            {
                                "example_id": "7ca5992a-48c3-4f5c-b43c-79a71b559d94",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Dabei muß besonders eine vertragswidrige Zuführung sowjetischer Landstreitkräfte verhindert werden.“"
                            },
                            {
                                "example_id": "1bd757e8-6cfc-41b6-bcf0-868c294680fd",
                                "sense_id": "b196627b-e4a8-3747-ae14-b5c3a9a583cd",
                                "text": "„Sie waren nach deren Befreiung vom Faschismus mit der stärksten Landstreitkraft Europas einfach dageblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
