                "senses": [
                    {
                        "sense_id": "9c1017fa-6c5f-346a-941e-9e88f33135a8",
                        "entry_id": "af1eb19c-8b0b-3716-b626-54b0d332a8c9",
                        "glosses": [
                            "Enlever quelque chose qui était fixé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec69653-82a3-48ca-ab25-43575e434614",
                                "sense_id": "9c1017fa-6c5f-346a-941e-9e88f33135a8",
                                "text": "Dans le cas présent, la facilité d'entretien est quand même remarquable : juste le bac à décapser et passer au sac poubelle puis sous l'eau. rien de plus !"
                            }
                        ]
                    },
                    {
                        "sense_id": "994b67d7-b472-3e41-832d-f8e5d0bd6c7f",
                        "entry_id": "af1eb19c-8b0b-3716-b626-54b0d332a8c9",
                        "glosses": [
                            "Enlever le dissipateur de chaleur d’un microprocesseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde8a424-0c87-447f-a8b6-29eb53487e4c",
                                "sense_id": "994b67d7-b472-3e41-832d-f8e5d0bd6c7f",
                                "text": "Voilà donc un nouveau produit permettant de décapser les processeurs et ce dernier vient de chez Aquacomputer."
                            },
                            {
                                "example_id": "7fcc8b18-8764-4406-b9e0-e97f9b941e1c",
                                "sense_id": "994b67d7-b472-3e41-832d-f8e5d0bd6c7f",
                                "text": "A la rigueur, décapser son processeur, on peut comprendre, même si cela permet de réellement gagner en températures, mais ne pas recommander l'OC pour un processeur K, donc destiné à l'OC, c'est un comble..."
                            },
                            {
                                "example_id": "72a5033f-6c1d-4482-9665-2c8223176e26",
                                "sense_id": "994b67d7-b472-3e41-832d-f8e5d0bd6c7f",
                                "text": "J'ai vu les vidéos, les mecs pètent un coup sec et ça se décapse mais franchement je crois pas que ce soit aussi facile pour tout le monde."
                            }
                        ]
                    }
