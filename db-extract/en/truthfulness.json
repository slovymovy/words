                    {
                        "sense_id": "c1ad9bda-c81b-331d-9c36-e8e4e729ec07",
                        "entry_id": "31eafc2b-bbed-3428-bd9c-9085e8980f30",
                        "glosses": [
                            "The quality of being truthful"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ee34dc49-3862-4889-b738-3ec2bce2edf0",
                                "sense_id": "c1ad9bda-c81b-331d-9c36-e8e4e729ec07",
                                "text": "Many hard-working students, alive to the deficiencies of this kind of romance-writing, have grown to distrust not only all historical writing that is romantic, but all historical writing that is vivid. They feel that complete truthfulness must never be sacrificed to color."
                            }
                        ]
                    }
                ],
