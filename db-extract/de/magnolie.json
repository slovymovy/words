                                        "sense_id": "0b6ed525-96e3-3236-a415-50b7b9a25580",
                                        "entry_id": "e3438d50-5ae0-39cf-b7a0-306b540bfd64",
                                        "glosses": [
                                            "A tree or shrub in any species of the genus Magnolia, many with large flowers and simple leaves."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e7f77d-df93-41b9-89d2-4fb4f3bd2bc4",
                                                "sense_id": "0b6ed525-96e3-3236-a415-50b7b9a25580",
                                                "text": "There are clusters of magnolias that are so tall and green and glossy, they are impossible to climb, and the air around them always smells like peaches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4531e31b-f170-3dc9-8168-0e7ddc0700f0",
                                        "entry_id": "e3438d50-5ae0-39cf-b7a0-306b540bfd64",
