                    {
                        "translation_id": "0fe07dfa-d349-40c2-92b2-1c92ea5c54ef",
                        "source_entry_id": "89f3d440-2bf5-3f15-92c0-6485a4d60113",
                        "source_sense_description": "country in South America",
