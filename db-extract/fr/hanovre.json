                    {
                        "sense_id": "22f41bc7-9641-3058-b900-a7ce33d515d9",
                        "entry_id": "88e981d8-354b-37e5-adde-68e26c9fa4d3",
                        "glosses": [
                            "Ville, commune et arrondissement d’Allemagne, capitale de la Basse-Saxe, au bord du fleuve Leine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b255fd0-24e6-4458-be37-581910e69ac0",
                                "sense_id": "22f41bc7-9641-3058-b900-a7ce33d515d9",
                                "text": "Quelle différence, en effet, entre le cheval arabe léger, vif, sanguin, et les gros chevaux du Danemarck, du Hanovre, de la Hollande et de la Normandie aux formes lourdes et empâtées et au tempérament essentiellement lymphatique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6973cd97-4bd7-4249-825d-7de4b2b8d9c1",
                        "source_entry_id": "88e981d8-354b-37e5-adde-68e26c9fa4d3",
                        "source_sense_id": "22f41bc7-9641-3058-b900-a7ce33d515d9",
                        "target_lang_word": "Hannover",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
