                    "sense_id": "f9adb746-96f8-30cd-920e-5cb672569874",
                    "sense_definition": "Qui provoque le rire ou le sourire par son caractère plaisant ou amusant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "humour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pièce de théâtre raconte une histoire très <w>comique</w>.",
                            "target_lang_translations": {
                                "en": "This play tells a very <w>funny</w> story.",
                                "ru": "Эта пьеса рассказывает очень <w>смешную</w> историю.",
                                "de": "Dieses Theaterstück erzählt eine sehr <w>lustige</w> Geschichte.",
                                "es": "Esta obra de teatro cuenta una historia muy <w>graciosa</w>.",
                                "zh": "这部话剧讲述了一个非常<w>好笑</w>的故事。"
                            }
                        },
                        {
                            "text": "Il a fait une grimace <w>comique</w> pour faire sourire l'enfant qui pleurait.",
                            "target_lang_translations": {
                                "en": "He pulled a <w>funny</w> face to make the crying child smile.",
                                "ru": "Он состроил <w>смешную</w> гримасу, чтобы заставить плачущего ребёнка улыбнуться.",
                                "de": "Er schnitt eine <w>komische</w> Grimasse, um das weinende Kind zum Lächeln zu bringen.",
                                "es": "Hizo una mueca <w>graciosa</w> para hacer sonreír al niño que lloraba.",
                                "zh": "为了逗哭闹的孩子笑，他做了一个<w>滑稽</w>的鬼脸。"
                            }
                        }
                    ],
