                "senses": [
                    {
                        "sense_id": "48553f6c-2fdb-3344-94bc-04e314317065",
                        "entry_id": "66a8c2d8-05ec-33c3-b15d-4f0acc93944c",
                        "glosses": [
                            "Étude des sols et de leur évolution en considérant des critères chimiques, physiques et biologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb0a435-2ddc-4973-b77f-9c8e580e9114",
                                "sense_id": "48553f6c-2fdb-3344-94bc-04e314317065",
                                "text": "La pédologie est née de cette question, d'une entreprise de moralisation contre des escroqueries », assure Jean Boulaine."
                            },
                            {
                                "example_id": "04723fd2-308f-4b49-bc6d-cd2534e8e54b",
                                "sense_id": "48553f6c-2fdb-3344-94bc-04e314317065",
                                "text": "L’érosion des roches, fondement historique de la géomorphologie, est aussi à l’origine d’un autre discours spécialisé entre géologie, géographie et biologie : la pédologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dfefa1b-c18a-49c4-abe2-4cd54e82a850",
                        "source_entry_id": "66a8c2d8-05ec-33c3-b15d-4f0acc93944c",
                        "source_sense_id": "48553f6c-2fdb-3344-94bc-04e314317065",
                        "source_sense_description": "Science des sols",
                        "target_lang_word": "Bodenkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
