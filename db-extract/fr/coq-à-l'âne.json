                    {
                        "translation_id": "2894e393-3183-40aa-85b4-15b03a4e67b4",
                        "source_entry_id": "3495106f-1cbd-3d24-9581-7e84b228ec97",
                        "source_sense_description": "Sauter du coq à l’âne; voir du coq à l’âne",
                        "target_lang_word": "vom Hundertsten ins Tausendste kommen",
                        "target_lang_code": "de",
