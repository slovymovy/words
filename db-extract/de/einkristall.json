                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "18140898-c6ac-42bc-bda4-79d554c76763",
                                "sense_id": "02a1cd25-e500-3e73-bd72-25c8eabdd4db",
                                "text": "Wafer für die Halbleiterherstellung werden aus Einkristallen hergestellt.",
                                "translation": "Les plaquettes pour la fabrication de semiconducteurs sont fabriquées à partir de monocristaux"
                            },
                            {
                                "example_id": "d6591293-9c6b-415b-babf-e59ddc6c5929",
                                "sense_id": "02a1cd25-e500-3e73-bd72-25c8eabdd4db",
                                "text": "Jan Czochralski entwickelte 1916 das nach ihm benannte Czochralski-Verfahren in Berlin. Dieses Verfahren wird heute vor allem zum Ziehen großer Silizium-Einkristalle für die Computer- und Solarindustrie verwendet.",
                                "translation": "Jan Czochralski a développé le procédé Czochralski qui porte son nom en 1916 à Berlin. Actuellement, ce procédé est principalement utilisé pour faire croître de gros monocristaux de silicium, utilisés dans les industries informatique et solaire."
                            }
                        ]
                    }
