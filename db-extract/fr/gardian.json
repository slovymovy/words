                    {
                        "sense_id": "373d188e-215b-397e-a045-42d39433c869",
                        "entry_id": "4b461f11-157c-3328-a43d-7a8600437a6d",
                        "glosses": [
                            "Gardien de chevaux ou de taureaux camarguais."
                        ],
                        "tags": [
                            "Camargue"
                        ],
                        "examples": [
                            {
                                "example_id": "25189417-4ce6-455e-82a9-a6a6bb51aea2",
                                "sense_id": "373d188e-215b-397e-a045-42d39433c869",
                                "text": "Au père de Zanette, le gardian ne dit qu’une chose : il l’avait prise en croupe et sauvée du taureau, et la fille se garda bien de raconter la baignade."
                            },
                            {
                                "example_id": "e928960d-da31-4a8f-b97d-ed3c501ca2a7",
                                "sense_id": "373d188e-215b-397e-a045-42d39433c869",
                                "text": "Les étangs! Les chevaux sauvages! Les gardians! Les taureaux! C'est un ami de mon père qui nous invite!"
                            },
                            {
                                "example_id": "8b54ebeb-539d-4c6b-8e5a-372c6a313ba2",
                                "sense_id": "373d188e-215b-397e-a045-42d39433c869",
                                "text": "Peu de gardians parviennent à mater Ardent, le cheval bien-aimé de grand-père, que nous envient les autres manadiers."
                            }
                        ]
                    }
                ],
