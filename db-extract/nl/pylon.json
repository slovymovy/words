                "senses": [
                    {
                        "sense_id": "43cb8efd-9b80-3206-921b-2e4337422d98",
                        "entry_id": "7a2961bc-c045-3302-a4af-8d561e8a24eb",
                        "glosses": [
                            "een oranje verkeerskegel, gebruikt bij wegwerkzaamheden."
                        ],
