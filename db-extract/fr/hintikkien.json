                                        "glosses": [
                                            "Of or pertaining to the work of Jaakko Hintikka, Finnish philosopher and logician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8dc558-f262-4e94-8645-399bd06ed210",
                                                "sense_id": "e5a73258-3438-34dc-92d6-7b1f9bd5f79d",
                                                "text": "Hintikkian erotetic logic is thoroughly intentional and hence adapts well to the intentional contexts of teaching."
                                            }
                                        ]
                                    }
