                "senses": [
                    {
                        "sense_id": "b1ff5c01-52bc-3a50-9689-043ef24865f4",
                        "entry_id": "2028af32-29fd-3756-92ed-236807b13bca",
                        "glosses": [
                            "Art von Affen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6efb11e-78e5-453a-9aeb-17ea63259536",
                                "sense_id": "b1ff5c01-52bc-3a50-9689-043ef24865f4",
                                "text": "„Im Gegensatz zu den aggressiven Makaken sind die Orang-Utans absolut friedliebend und lassen sich von der kleineren Affenart auch durchaus von ihren Bananen vertreiben.“"
                            },
                            {
                                "example_id": "a9a63c15-f953-4fa6-9101-53a3488cdd82",
                                "sense_id": "b1ff5c01-52bc-3a50-9689-043ef24865f4",
                                "text": "„Zu dem menschenähnlichen Aussehen vieler Affenarten […] tragen das teilweise unbehaarte Gesicht mit den nach vorne blickenden Augen, das Fehlen des Nasenspiegels, die Form der Ohren, vor allem aber das ausdrucksvolle Mienenspiel bei (Mimik), ermöglicht durch die freie Beweglichkeit der Oberlippe und die oft hohe Entwicklung der Gesichtsmuskulatur.“"
                            },
                            {
                                "example_id": "be01a6a8-db3e-4ac5-b6b2-79c969041aca",
                                "sense_id": "b1ff5c01-52bc-3a50-9689-043ef24865f4",
                                "text": "„Unter den heute lebenden Affenarten sind es die zu den Altweltaffen oder Schmalnasen gehörenden Menschenaffen, mit denen der Mensch […] mehr Gemeinsamkeiten als mit jeder anderen Tiergruppe aufweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
