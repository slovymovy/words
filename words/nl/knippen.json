                {
                    "sense_id": "08568d21-353a-39df-a370-8c0b9dd2625b",
                    "sense_definition": "Geselecteerde digitale gegevens verwijderen en tijdelijk in het geheugen opslaan om ze elders te plaatsen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag die tabel wel uit mijn presentatie <w>knippen</w>.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>вырезать</w> эту таблицу из моей презентации.",
                                "en": "You can <w>cut</w> that table from my presentation.",
                                "pl": "Możesz <w>wyciąć</w> tę tabelę z mojej prezentacji.",
                                "de": "Du kannst diese Tabelle gerne aus meiner Präsentation <w>ausschneiden</w>.",
                                "fr": "Tu peux <w>couper</w> ce tableau de ma présentation.",
                                "it": "Puoi anche <w>tagliare</w> quella tabella dalla mia presentazione.",
                                "cs": "Tuhle tabulku můžeš z mé prezentace <w>vyjmout</w>.",
                                "tr": "O tabloyu sunumumdan <w>kesebilirsin</w>.",
                                "es": "Puedes <w>cortar</w> esa tabla de mi presentación."
                            }
                        },
                        {
                            "text": "Als je de tekst wilt verplaatsen, moet je eerst <w>knippen</w> en dan plakken.",
                            "target_lang_translations": {
                                "ru": "Если хочешь переместить текст, нужно сначала <w>вырезать</w>, а затем вставить.",
                                "en": "If you want to move the text, you have to <w>cut</w> and then paste first.",
                                "pl": "Jeśli chcesz przenieść tekst, musisz najpierw <w>wyciąć</w>, a potem wkleić.",
                                "de": "Wenn du den Text verschieben willst, musst du zuerst <w>ausschneiden</w> und dann einfügen.",
                                "fr": "Si tu veux déplacer le texte, tu dois d'abord <w>couper</w> puis coller.",
                                "it": "Se vuoi spostare il testo, devi prima <w>tagliare</w> e poi incollare.",
                                "cs": "Pokud chceš text přesunout, musíš nejprve <w>vyjmout</w> a pak vložit.",
                                "tr": "Metni taşımak istiyorsan, önce <w>kesmeli</w> ve sonra yapıştırmalısın.",
                                "es": "Si quieres mover el texto, primero tienes que <w>cortar</w> y luego pegar."
                            }
