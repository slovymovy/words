                                        "glosses": [
                                            "Of or pertaining to, characteristic of, associated with, or suggestive of French abstract painter Pierre Soulages (born 1919), his works, or his authorship; especially of his use of the black color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9274ec1f-9373-453c-bb43-3a5ab6a7f330",
                                                "sense_id": "edf86fab-abc4-3fac-8dac-406d8dbf2af6",
                                                "text": "This recent flurry of Soulagean activity will be news to the New York contemporary art world, since he has not had a show there since 1977."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
