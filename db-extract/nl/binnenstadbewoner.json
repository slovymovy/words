                        "examples": [
                            {
                                "example_id": "1bb6147b-fc55-4593-a2dc-fbeadc78df53",
                                "sense_id": "d8a52e92-077a-3b13-aa02-05906032c0b5",
                                "text": "\"Vroeger was er een toeristenseizoen. Dat is te overleven, want dan wist je wanneer het druk was. Nu is het iedere dag feest.\" Binnenstadbewoner Bert Nap noemt het de 'disneyficering' van de binnenstad. Het is net een pretpark. Met dit verschil: in de Efteling gaan de mensen 's avonds naar huis en is er voldoende toezicht. Op de Wallen is er volgens hem vaak niemand om de menigte in bedwang te houden. 's Avonds na tienen kun je er vaak letterlijk niet meer lopen omdat het er zo druk is."
                            },
                            {
                                "example_id": "8219c44e-b649-411f-8d34-158592d81044",
                                "sense_id": "d8a52e92-077a-3b13-aa02-05906032c0b5",
                                "text": "Ook binnenstadbewoner Jasper van Dijk verwelkomt maatregelen om het aantal toeristen te verminderen. \"Er is veel overlast. Mensen die in je straat plassen, winkels die verdwijnen. Bij mij in de buurt is een schoenenwinkel nu een ijsjeswinkel voor toeristen geworden. Het haalt het karakter uit je stad.\""
                            }
                        ]
                    }
