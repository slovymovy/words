            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92dd8fed-f817-34bc-a874-5640b24c5c16",
                    "sense_definition": "Wat gedaan of gebruikt mag worden omdat er toestemming voor is gegeven.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet <w>toegestaan</w> om in dit gebouw te roken.",
                            "target_lang_translations": {
                                "en": "It is not <w>allowed</w> to smoke in this building.",
                                "ru": "В этом здании курить не <w>разрешено</w>.",
                                "pl": "W tym budynku nie <w>wolno</w> palić.",
                                "de": "Es ist nicht <w>erlaubt</w>, in diesem Gebäude zu rauchen.",
                                "fr": "Il n'est pas <w>autorisé</w> de fumer dans ce bâtiment.",
                                "it": "Non è <w>consentito</w> fumare in questo edificio.",
                                "cs": "V této budově není <w>dovoleno</w> kouřit.",
                                "tr": "Bu binada sigara içmek <w>yasaktır</w>.",
                                "es": "No está <w>permitido</w> fumar en este edificio.",
                                "zh": "在这栋楼里不<w>允许</w>吸烟。"
                            }
                        },
                        {
                            "text": "Een hond is een <w>toegestaan</w> huisdier, mits de andere bewoners er geen last van hebben.",
                            "target_lang_translations": {
                                "en": "A dog is a <w>permitted</w> pet, provided the other residents are not bothered by it.",
                                "ru": "Собака — <w>разрешённое</w> домашнее животное, при условии, что это не мешает другим жильцам.",
                                "pl": "Pies jest <w>dozwolonym</w> zwierzęciem domowym, pod warunkiem, że nie przeszkadza innym mieszkańcom.",
                                "de": "Ein Hund ist ein <w>erlaubtes</w> Haustier, sofern sich die anderen Bewohner nicht daran stören.",
                                "fr": "Un chien est un animal de compagnie <w>autorisé</w>, à condition que les autres résidents ne soient pas dérangés.",
                                "it": "Un cane è un animale domestico <w>permesso</w>, a patto che gli altri residenti non ne siano disturbati.",
                                "cs": "Pes je <w>povolený</w> domácí mazlíček, pokud to ostatním obyvatelům nevadí.",
                                "tr": "Diğer sakinleri rahatsız etmediği sürece köpek <w>izin verilen</w> bir evcil hayvandır.",
                                "es": "Un perro es una mascota <w>permitida</w>, siempre y cuando no moleste a los otros vecinos.",
                                "zh": "只要不打扰到其他住户，养狗是<w>允许</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legaal",
                        "wettig",
                        "toegelaten",
                        "geoorloofd"
                    ],
                    "antonyms": [
                        "verboden",
                        "illegaal",
                        "onwettig"
                    ],
                    "common_phrases": [
                        "niet toegestaan",
                        "wettelijk toegestaan"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is permitted or allowed because permission has been granted.",
                        "ru": "То, что разрешено делать или использовать, так как на это было дано разрешение.",
                        "pl": "Coś, co jest dozwolone lub na co uzyskano zgodę.",
                        "de": "Etwas, das getan oder verwendet werden darf, weil eine Erlaubnis erteilt wurde.",
                        "fr": "Ce qui peut être fait ou utilisé car une autorisation a été donnée.",
                        "it": "Ciò che può essere fatto o utilizzato perché è stato dato il permesso.",
                        "cs": "Něco, co je dovoleno dělat nebo používat, protože k tomu bylo uděleno svolení.",
                        "tr": "İzin verildiği için yapılması veya kullanılması serbest olan.",
                        "es": "Algo que se puede hacer o usar porque se ha dado permiso para ello.",
                        "zh": "指因为获得了许可而可以被做或被使用的事情。"
                    },
