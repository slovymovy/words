                        "examples": [
                            {
                                "example_id": "577e2579-9047-4e18-9b7c-0b91f1d3feba",
                                "sense_id": "6e2f41fd-1cd7-3a24-869f-7884ce6c11fb",
                                "text": "Ein Bieter erhöhte das Gebot für das Gemälde von Picasso auf 2 Millionen."
                            }
