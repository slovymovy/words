                "senses": [
                    {
                        "sense_id": "b0945846-8c47-3a2e-b405-e308ce9cf3a0",
                        "entry_id": "70e47c9a-afa4-32dc-981f-10d743f95575",
                        "glosses": [
                            "Action d’embêter ou résultat de cette action."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "eb7da5f4-a40a-4a0c-93a6-3d5a1eacee12",
                                "sense_id": "b0945846-8c47-3a2e-b405-e308ce9cf3a0",
                                "text": "— Monsieur Froment, finit par dire Salvat, debout, timide et gêné, cela m’a fait bien de la peine, quand on m’a dit l’embêtement où je vous ai mis, car je n’oublierai jamais que vous avez été bon pour moi, un jour que tout le monde me jetait à la porte…"
                            },
                            {
                                "example_id": "f14c9b20-a32d-462a-9ebb-54b1323e4a29",
                                "sense_id": "b0945846-8c47-3a2e-b405-e308ce9cf3a0",
                                "text": "Car l'embêtement pour Athalie, c'est que c'est toujours Eliacin, l'embêtant pour Hérode, c'est que c'est toujours la Sainte Famille qui échappe»,— écrivais-je en 1910."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d49ea86f-3e33-4054-bb8b-51ad4910c0f1",
                        "source_entry_id": "70e47c9a-afa4-32dc-981f-10d743f95575",
                        "source_sense_id": "b0945846-8c47-3a2e-b405-e308ce9cf3a0",
