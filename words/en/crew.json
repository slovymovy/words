                },
                {
                    "sense_id": "eeee4313-e745-3732-bc43-7a98492f243f",
                    "sense_definition": "A dedicated group of hip-hop artists, dancers, or graffiti writers working together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dance <w>crew</w> practiced their routine in the park.",
                            "target_lang_translations": {
                                "ru": "Танцевальная <w>команда</w> репетировала свой номер в парке.",
                                "tr": "Dans <w>grubu</w> gösterilerini parkta çalıştı.",
                                "zh": "舞蹈<w>团</w>在公园里练习他们的动作。"
                            }
                        },
                        {
                            "text": "We decided we needed another rapper in the <w>crew</w>.",
                            "target_lang_translations": {
