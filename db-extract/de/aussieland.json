                "senses": [
                    {
                        "sense_id": "885ae8c7-347c-33e2-b939-b9c06923166e",
                        "entry_id": "cfa6990c-b676-39cb-be51-fa839b6e42f9",
                        "glosses": [
                            "Australien"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a78b9b2a-6e53-4bd4-a009-5c93fbf6b334",
                                "sense_id": "885ae8c7-347c-33e2-b939-b9c06923166e",
                                "text": "„Wie gut, dass aus dem super healthy Australien gerade ein neuer Trend für alle Kaffee-Junkies herüberschwappt: Kaffee mit Pilzextrakt, im Aussieland auch „Mushroom Coffee“ oder nur kurz „Shroom Coffee“ genannt.“"
                            },
                            {
                                "example_id": "7ebcda4d-b2d7-4cbc-88e5-3b8469311ef9",
                                "sense_id": "885ae8c7-347c-33e2-b939-b9c06923166e",
                                "text": "„Einige mögen denken, dass Koalas im Aussieland (gesprochen: Ossiland) auf der anderen Seite der Weltkugel beheimatet sind, in Leipzig wurde jedoch erstmals ein waschechter Ossi-Koala geboren.“"
                            },
                            {
                                "example_id": "dfea7980-d77a-4e20-b7f1-d985ab889b77",
                                "sense_id": "885ae8c7-347c-33e2-b939-b9c06923166e",
                                "text": "„‚Er ist ja mit 21 Jahren noch recht jung‘, erzählt seine Mutter Dörte Michels, die Erste Vorsitzende des TB Burgsteinfurt, vom Trip ihres Sohnes ins ‚Aussieland‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
