        "nl-extract.jsonl": [
            {
                "entry_id": "e3985f61-6b66-3322-b06c-b01e12e00713",
                "word": "zelfgevoel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4d7e69c-cc02-3ee9-b70c-18902ce5d791",
                        "entry_id": "e3985f61-6b66-3322-b06c-b01e12e00713",
                        "glosses": [
                            "het respect dat men heeft voor zichzelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0d7585-4b19-45ef-8b83-56bb03df748a",
                                "sense_id": "e4d7e69c-cc02-3ee9-b70c-18902ce5d791",
                                "text": "'De media-aandacht was voor de man een sterk belonende factor: het droeg bij aan reparatie van het beschadigde zelfgevoel en wakkerde een sensatiezucht bij hem aan', aldus de rechter. De Coevordenaar moet ook 21.000 euro schadevergoedingen betalen."
                            },
                            {
                                "example_id": "10c38bdb-b4b1-4c4f-88fc-84ccfb2aeba5",
                                "sense_id": "e4d7e69c-cc02-3ee9-b70c-18902ce5d791",
                                "text": "Onmiskenbaar bezit de nepveteraan een zwak zelfgevoel. Dat stelt althans Wybrand op den Velde, als psychiater verbonden aan de Bond van Nederlandse Militaire Oorlogs- en Dienstslachtoffers (BNMO) in Doorn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deebbdc9-b02e-44b8-9af9-32fe99df86f2",
                        "source_entry_id": "e3985f61-6b66-3322-b06c-b01e12e00713",
                        "source_sense_id": "e4d7e69c-cc02-3ee9-b70c-18902ce5d791",
                        "source_sense_description": "het respect dat men heeft voor zichzelf",
                        "target_lang_word": "dignity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dignity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "The state of being dignified or worthy of esteem: elevation of mind or character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43602237-e4b7-43e4-9189-c0464ac51707",
                                                "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                                "text": "He uttered this ... with great majesty, or, as he called it, dignity."
                                            },
                                            {
                                                "example_id": "79ed87e0-b8d1-4b7f-9b09-757de098847e",
                                                "sense_id": "39dbc146-e63b-3015-9882-ba49de1dc384",
                                                "text": "Every individual shall have the right to the respect of the dignity inherent in a human being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "Decorum, formality, stateliness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30af991-6f77-4ae3-b0c7-947112cf1dbb",
                                                "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                                "text": "The reception room was sacred to the dead wife. Her shiny portrait hung upon the wall - similar, doubtless, in all respects to the one which would be pasted on her tombstone. A little piece of black drapery had been tacked above the frame to lend a dignity to woe. But two of the tacks had fallen out, and the effect was now rakish, as that of a drunkard's bonnet."
                                            },
                                            {
                                                "example_id": "caace545-815e-457e-bbc0-1df8fb3e898f",
                                                "sense_id": "8ca91e28-f90e-3b89-a579-2297a0e548e3",
                                                "text": "Official DIGNITY tends to increase in inverse ratio to the importance of the country in which the office is held."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "High office, rank, or station."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e2376d6-e7f1-46d4-96da-d4bf0291922f",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                                            },
                                            {
                                                "example_id": "63d6c589-3af0-4a49-80f7-8a95399bd593",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "And the king said, What honour and dignity hath been done to Mordecai for this?"
                                            },
                                            {
                                                "example_id": "136e95ca-dca4-4a2b-989f-61b816332d10",
                                                "sense_id": "7fc22a13-9cc9-3e42-b66b-7b32be4fd729",
                                                "text": "He ... distributed the civil and military dignities among his favourites and followers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3cf60dd-b469-35c7-934d-2df491cb5a2e",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "One holding high rank; a dignitary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "082f1929-662d-4f3c-bb88-9cad61c79789",
                                                "sense_id": "c3cf60dd-b469-35c7-934d-2df491cb5a2e",
                                                "text": "These filthy dreamers […] speak evil of dignities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978cd10a-729c-3488-9014-ec37f601606e",
                                        "entry_id": "b9fb2943-8a55-362c-8e44-6f98969cf480",
                                        "glosses": [
                                            "Fundamental principle; axiom; maxim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6cb311-23c5-4fcf-947c-6d88229d7ccc",
                                                "sense_id": "978cd10a-729c-3488-9014-ec37f601606e",
                                                "text": "Sciences concluding from dignities, and principles known by themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
