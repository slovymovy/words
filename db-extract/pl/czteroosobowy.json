                    {
                        "sense_id": "b4d2b9c4-1083-3c0c-899f-4436ccfbc182",
                        "entry_id": "12061df1-8394-3b1d-b287-daac996ff55d",
                        "glosses": [
                            "przeznaczony dla czterech osób, mogący pomieścić cztery osoby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3077b996-955f-4ca8-8a13-87cbb45af445",
                                "sense_id": "b4d2b9c4-1083-3c0c-899f-4436ccfbc182",
                                "text": "W czasie pierwszej rozmowy, na początku kwietnia, sprawia wrażenie, jakby nie wierzył, że zamienia rezydencję w podwarszawskim Konstancinie na czteroosobową celę mokotowskiego więzienia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8c88ef6a-f5bb-3a4c-89c3-49852fecc38a",
                        "entry_id": "12061df1-8394-3b1d-b287-daac996ff55d",
                        "glosses": [
                            "złożony z czterech osób, wykonywany przez cztery osoby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2d4460-a18b-4ca5-8db0-1f8ea6a71cbb",
                                "sense_id": "8c88ef6a-f5bb-3a4c-89c3-49852fecc38a",
                                "text": "Tymczasem znamy już skład czteroosobowej drużyny, która będzie nas reprezentować w Brnie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
