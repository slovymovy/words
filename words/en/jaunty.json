                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the Royal Navy."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Oficial encargado del orden y la disciplina a bordo de un barco de la Marina Real británica."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maestre de armas",
                                "target_lang_sense_clarification": "oficial naval británico"
