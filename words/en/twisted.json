        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fdac2aec-b710-36b8-8555-1f32018a77b3",
                    "sense_definition": "Bent out of its normal shape or formed by winding strands together.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was reduced to a pile of <w>twisted</w> metal after the crash.",
                            "target_lang_translations": {
                                "ru": "После аварии машина превратилась в груду <w>искореженного</w> металла.",
                                "fr": "La voiture a été réduite à un tas de métal <w>tordu</w> après l'accident.",
                                "tr": "Kazadan sonra araba <w>bükülmüş</w> bir metal yığınına dönüştü."
                            }
                        },
                        {
                            "text": "She wore a beautiful necklace made of <w>twisted</w> silver wire.",
                            "target_lang_translations": {
                                "ru": "На ней было красивое ожерелье из <w>витой</w> серебряной проволоки.",
                                "fr": "Elle portait un magnifique collier fait de fil d'argent <w>vrillé</w>.",
                                "tr": "<w>Kıvrılmış</w> gümüş telden yapılmış güzel bir kolye takıyordu."
                            }
