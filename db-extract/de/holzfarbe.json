                ],
                "senses": [
                    {
                        "sense_id": "aa5a3318-00f3-36b6-ae31-2ae011e3aaba",
                        "entry_id": "c12c18c6-8d59-3d02-bd8a-e95955439cca",
                        "glosses": [
                            "diejenige Farbe, die ein Holz oder eine bestimmte Holzart aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cea3d71-969b-4814-94c1-55db999ee1d6",
                                "sense_id": "aa5a3318-00f3-36b6-ae31-2ae011e3aaba",
                                "text": "„»Farbfehler« sind Abweichungen von der normalen Holzfarbe der jeweiligen Holzarten.“"
                            },
                            {
                                "example_id": "10e91423-f602-484d-b9c4-a4b8998e4d6f",
                                "sense_id": "aa5a3318-00f3-36b6-ae31-2ae011e3aaba",
                                "text": "„Durch verſchiedene Nuancen der Holzfarbe laſſen ſich die conſtructiven Unterſchiede der Theile charakteriſiren. Dunkelgefärbtes Holz iſt im Allgemeinen ſchwerer und kräftiger, z. B. Eichen gegen Tannen.“ [1876]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bfe3d2e7-7f2c-3192-abf2-894450078fc1",
                        "entry_id": "c12c18c6-8d59-3d02-bd8a-e95955439cca",
                        "glosses": [
                            "Farbe zum Auftragen auf das Material Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f2ac33-6046-4b4d-9241-62b6dcae3e1a",
                                "sense_id": "bfe3d2e7-7f2c-3192-abf2-894450078fc1",
                                "text": "„Die erſte Arbeit einer [Holzmalerei] iſt das Auftragen der Holzfarbe (Eſſigfarbe) mit einem gewöhnlichen Pinſel […]“ [1861]"
                            },
                            {
                                "example_id": "c79b2f0f-090a-4619-b7b8-0dd488dce421",
                                "sense_id": "bfe3d2e7-7f2c-3192-abf2-894450078fc1",
                                "text": "„Weil ich durch giftige Holzfarben krank wurde, schickt man mich jetzt mit zwei Dritteln meiner Bezüge in den vorläufigen Ruhestand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
