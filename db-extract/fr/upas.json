                "entry_id": "807117b5-a142-34cc-9e68-78f7e83775f2",
                "word": "upas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72b6651b-0a07-3dd0-be06-f750cf1f15f1",
                        "entry_id": "807117b5-a142-34cc-9e68-78f7e83775f2",
                        "glosses": [
                            "Grand arbre de l’île de Java, de la famille des Urticées et d’où découle un suc très vénéneux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a5b955-e9f8-4140-b45e-992e45827e3a",
                                "sense_id": "72b6651b-0a07-3dd0-be06-f750cf1f15f1",
                                "text": "Je ne fus pas longtemps à Java sans entendre parler de la merveille du pays, de l’upas, le seul arbre de cette espèce qui existe sur le globe, et dont les terribles produits jouent un si grand rôle dans les mœurs javanaises."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f7aacf3-0b74-3052-b201-6b428bb018cf",
                        "entry_id": "807117b5-a142-34cc-9e68-78f7e83775f2",
                        "glosses": [
                            "Antiar, substance vénéneuse qui provient de cet arbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a279dc64-6255-4710-959d-69e7633252ca",
                                "sense_id": "3f7aacf3-0b74-3052-b201-6b428bb018cf",
                                "text": "Les habitants des îles de la Sonde se servent de l’upas pour empoisonner leurs flèches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "169caa67-001a-420c-bd08-3faae86b189e",
                        "source_entry_id": "807117b5-a142-34cc-9e68-78f7e83775f2",
