                    },
                    {
                        "translation_id": "6ffae9a5-ed0b-43c3-98bb-dcf8373adb4b",
                        "source_entry_id": "04e86bc8-e1ef-3dee-a063-aab5ba4fc7bf",
                        "source_sense_id": "0cb1e4f4-b0dd-3802-bbed-7b151097c14d",
                        "target_lang_word": "Bestechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                        "entry_id": "cc6e7e2d-ebdc-3c6a-a510-f5a50280f7f1",
                                        "glosses": [
                                            "Vorteilsgewährung an Amtsträger mit zu erwartender Gegenleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c499115-cba8-41b6-9e3c-8724d4d59c50",
                                                "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                                "text": "Noch heute wird so manches Amt durch Bestechung erkauft."
                                            },
                                            {
                                                "example_id": "3a33e740-5636-4ef3-8ef6-b9ec93075b4d",
                                                "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                                "text": "Anklage erhoben hat die Staatsanwaltschaft nicht allein gegen den Juraprofessor, sondern auch gegen die beiden Studentinnen - wegen Bestechung."
                                            },
                                            {
                                                "example_id": "d67d5668-e446-4783-9828-6e471a07a554",
                                                "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                                "text": "„Weil er weder die Zuzugsgenehmigung noch einen Entlassungsschein vorweisen kann, stellt er im Sinne der Gesetzes eine Unperson dar; es kostet mich Wochen und am Ende eine handfeste Bestechung, um diesen Zustand zu ändern.“"
                                            },
                                            {
                                                "example_id": "53d64144-45a3-4618-b3ac-06a0e7ec17cc",
                                                "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                                "text": "„Die Bestechungen gingen ganz öffentlich vor sich.“"
                                            },
                                            {
                                                "example_id": "f770d65a-6dd7-4402-8bd4-faceecef51b9",
                                                "sense_id": "17a7e1f8-f8a9-3c16-8246-66fc739d8cb9",
                                                "text": "„Zu der Zeit, als Sade seine Erfahrungen in Romanen niederlegte, übte die Polizei eine Aufsicht aus, die durch Bestechung hinfällig gemacht wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94643f78-8780-4570-b562-55b8bfa9ef26",
                        "source_entry_id": "04e86bc8-e1ef-3dee-a063-aab5ba4fc7bf",
                        "source_sense_id": "0cb1e4f4-b0dd-3802-bbed-7b151097c14d",
                        "target_lang_word": "Korruption",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korruption",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                        "entry_id": "d9abc228-1983-34f0-8f6a-f204fa34df56",
                                        "glosses": [
                                            "Verhältnisse, in denen eine Position ausgenutzt wird, um ohne Rücksicht auf das Amt und die Verantwortung an persönliche Vorteile, oftmals Geld, zu gelangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afa5498-8063-4d9f-b8b9-c7b42c4ced9f",
                                                "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                                "text": "In dieser Stadt herrscht die Korruption."
                                            },
                                            {
                                                "example_id": "f7d30395-1d7f-4819-8912-213fa3ddaf65",
                                                "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                                "text": "„Das Regime Algeriens etwa, das in den vergangenen Wochen ähnliche Ausschreitungen erlebte wie Tunesien, gilt im US-Außenministerium als »fragil« und »geplagt von einem nie dagewesenen Maß an Korruption«.“"
                                            },
                                            {
                                                "example_id": "1c44cb85-95b6-4787-8a44-f81480ab9881",
                                                "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                                "text": "„Selbst die Polizisten, die mich stets völlig grundlos anhielten, um ihrem unstillbaren Hang zur Korruption nachzugeben, grüßten plötzlich ausgiebig und wünschten mir einen guten Tag, bevor sie Geld und Ausweis verlangten.“"
                                            },
                                            {
                                                "example_id": "69de8947-ec46-4f8a-882c-e47212eb3b96",
                                                "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                                "text": "„Eine der wichtigsten Ursachen für die Korruption in Afrika ist die Armut.“"
                                            },
                                            {
                                                "example_id": "034ab25c-95ae-4e78-a9f2-2bfbf6b6332c",
                                                "sense_id": "a40d78c7-519e-3eb7-b0ca-fbfa57f1d62f",
                                                "text": "„Das war ein ganz guter Anfang in Korruption, dachte er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b24d84dc-17f6-35c5-b8eb-ca2400d512b3",
                                        "entry_id": "d9abc228-1983-34f0-8f6a-f204fa34df56",
                                        "glosses": [
                                            "Methode, sich gegen Entgelt einen Vorteil zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b5f69c-2dba-431a-a0cc-140c21b0daad",
                                                "sense_id": "b24d84dc-17f6-35c5-b8eb-ca2400d512b3",
                                                "text": "Das ist für die Operationsweise des organisierten Verbrechens immer noch wichtig: Es kann nur auf der Grundlage von Korruption und Einschüchterung von staatlichem Personal und manchmal auch staatlichen Institutionen überleben."
                                            },
                                            {
                                                "example_id": "20e0749c-d57c-4b46-8306-8d036b9d4a70",
                                                "sense_id": "b24d84dc-17f6-35c5-b8eb-ca2400d512b3",
                                                "text": "„Ich helfe also dem indischen Staat, indem ich einen Akt von Erpressung und Korruption unterlaufe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
