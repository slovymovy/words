                "senses": [
                    {
                        "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                        "entry_id": "aaea9d65-1392-306f-baf2-a4911f59b763",
                        "glosses": [
                            "Mütze, die aus Bärenfell gefertigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd58710-aba5-4e1d-b658-0a7c04fafeeb",
                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                "text": "Für die Herstellung von Bärenfellmützen werden viele Bärenfelle benötigt."
                            },
                            {
                                "example_id": "0eb7d09e-c012-4f3e-a513-87bf80e81b4e",
                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                "text": "„Die Trommler der Musikkapelle kreuzten die Schlegel über die Bärenfellmützen.“"
                            },
                            {
                                "example_id": "a09eda66-f7cf-4628-81bc-e41479a6f303",
                                "sense_id": "216cdfb8-4b0e-3e89-b896-e602c3623309",
                                "text": "„Staunend sah das Volk die blauen Jacken der Grenadiere, die weißen Röcke der Spanier, die schwarzen Bärenfellmützen, die bunten Standarten und Wimpel durch die rauchenden Trümmer ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cab0561-9928-4878-98c9-640a04621a1a",
