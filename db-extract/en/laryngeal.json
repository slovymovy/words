                    },
                    {
                        "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                        "entry_id": "b9507620-e5fc-39db-8e29-885c93126b59",
                        "glosses": [
                            "In Proto-Indo-European, one of the typically three reconstructed consonants usually marked as ⟨h₁⟩, ⟨h₂⟩ and ⟨h₃⟩."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef194937-b5d1-4bf9-8606-f8889820341e",
                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                "text": "The vowel-coloring effects of the IH laryngeals cannot be considered apart from the vowel-reducing effect of the IH stress accent[…]"
                            },
                            {
                                "example_id": "ed8fd6c9-9a6e-4ce9-abef-73cc72da971d",
                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                "text": "[…]it is not only different from Buck's in the linguistics (laryngeals have seen to that); it is very different in scope and aim."
                            },
                            {
                                "example_id": "c52883d0-f52b-45d2-931c-49c6884fe7fd",
                                "sense_id": "c39c78f4-888b-37aa-91bf-98ec976a5bac",
                                "text": "Finally, it should be noted that laryngeals not adjacent to syllabics were apparently deleted by three different rules."
                            }
                        ]
                    }
                ],
                "translations": [
