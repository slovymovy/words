                    "sense_definition": "Action ou art de produire des sons musicaux avec la voix humaine.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "voix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère prend des cours de <w>chant</w> tous les mercredis après-midi."
                        },
                        {
                            "text": "Le <w>chant</w> choral demande beaucoup de travail et d'écoute mutuelle."
                        }
                    ],
                    "common_phrases": [
