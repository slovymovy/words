                        "sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                        "entry_id": "e7aa63b6-c5f6-3fe0-8513-f67d18904f2d",
                        "glosses": [
                            "großer landwirtschaftlicher Betrieb in den USA und anderen überseeischen englischsprachigen Ländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1655ea2c-6edb-4da2-b7f8-d65425d32930",
                                "sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                                "text": "„Der Weg stieg jetzt steil bis zu einer Bergkuppe an, von wo aus wir, wie Vanderbrecken sagte, die Farm der Huysmans im Tal liegen sehen würden.“"
                            },
                            {
                                "example_id": "27de2c5b-9fec-405a-b058-6cda2b93fef0",
                                "sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                                "text": "„Wir schlenderten den Hügel zur Farm hinauf.“"
                            },
                            {
                                "example_id": "3ecb2066-7e0f-4bb5-83eb-6b399f1363a4",
                                "sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                                "text": "„Die Arbeit auf der Farm brachte nach einiger Zeit tatsächlich Erfolg.“"
                            },
                            {
                                "example_id": "d4d77108-511f-4ec2-8ecd-ef28c69d1ad5",
                                "sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                                "text": "„Nach und nach entstehen neue Farmen, Siedlungen und Plantagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0f122fa-9f25-3a10-b849-a895e5e18c6b",
                        "entry_id": "e7aa63b6-c5f6-3fe0-8513-f67d18904f2d",
                        "glosses": [
                            "großer landwirtschaftlicher Betrieb, der sich auf die Zucht/Vermehrung von etwas spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2542b5a7-d084-4f6e-b18b-1c2eb6ec9f4b",
                                "sense_id": "c0f122fa-9f25-3a10-b849-a895e5e18c6b",
                                "text": "Sie züchten in großem Stil Lachse. Auf der Farm ist im Herbst Hochbetrieb."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6559da15-4fe2-3f94-b34d-e660d0ce939c",
                        "entry_id": "e7aa63b6-c5f6-3fe0-8513-f67d18904f2d",
                        "glosses": [
                            "Betrieb, der Ressourcen nutzt/vermehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497bb6dd-4492-4772-bcfd-018cefc89160",
                                "sense_id": "6559da15-4fe2-3f94-b34d-e660d0ce939c",
                                "text": "Wenn Sie eine Serverfarm aufbauen möchten, installieren Sie zunächst die Server, bevor Sie die Farm dann konfigurieren."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98961f81-b1c3-4669-a408-cdfae53144a3",
                        "source_entry_id": "e7aa63b6-c5f6-3fe0-8513-f67d18904f2d",
                        "source_sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
                        "source_sense_description": "großer landwirtschaftlicher Betrieb in den USA und anderen überseeischen englischsprachigen Ländern",
                        "target_lang_word": "ферма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ферма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd8c4f0-ae2c-33fd-9f90-35daddbe93ab",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "с.-х. частное сельскохозяйственное предприятие на собственном или арендуемом участке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b786567b-b220-49b9-8249-e32790a78e75",
                                                "sense_id": "4dd8c4f0-ae2c-33fd-9f90-35daddbe93ab",
                                                "text": "У нас скотоводческая ферма в Баварии, и выгоднее кормить несколько лишних голов скота, чем лишних рабочих."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4df91e0-f9bc-3026-8e8a-034e7bb6047a",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "истор. специализированное животноводческое подразделение сельскохозяйственного предприятия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e997753-699f-4733-88b8-5d477d747bc6",
                                                "sense_id": "c4df91e0-f9bc-3026-8e8a-034e7bb6047a",
                                                "text": "Наконец, под Детским Селом построена молочная ферма ЛСПО на 1200 голов скота."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "комп. группа серверов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0ebac2-00e5-472d-8a81-da3f7954b06a",
                                                "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                                "text": "Для каждого узла фермы серверов можно отдельно выполнять резервное копирование и восстановление, а также устанавливать квоты для дискового пространства, занимаемого узлом и автоматически отправлять владельцу узла уведомления при достижении предельного размера узла."
                                            },
                                            {
                                                "example_id": "c3e41a04-ea2a-40e6-8422-4f6a7b843621",
                                                "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                                "text": "Во время параллельной миграции определяются и конфигурируются новые фермы серверов приложений параллельно существующему окружению. В определённый момент времени они заменяют старые фермы и работают параллельно с другими фермами, не имея с ними общих точек соприкосновения."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ферма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                        "entry_id": "0e51ecb7-1b13-38f4-891d-932deb30b754",
                                        "glosses": [
                                            "строит. сооружение из скреплённых концами стержней, брусьев и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0d50b6-7ce2-4fb8-aba2-8ac6a31e7740",
                                                "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                                "text": "Ферма весом не менее четырёхсот тонн была поднята нами за три месяца на высоту двенадцати метров над водой очень простыми приёмами."
                                            },
                                            {
                                                "example_id": "299db982-2457-448e-b196-0f66a539f472",
                                                "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                                "text": "Здесь, между кирпичными быками, торчит рухнувшая в реку ферма взорванного моста."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c70691c-cafd-4aef-a665-c009a98df009",
                        "source_entry_id": "e7aa63b6-c5f6-3fe0-8513-f67d18904f2d",
                        "source_sense_id": "a2ec9335-49d1-355e-94b1-6f6a96f6d258",
