                    {
                        "form_id": "a98611cc-3807-469d-8566-c8bf850bbe20",
                        "entry_id": "cdf469b1-7f5b-3cd2-b883-9b82471eb351",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Protestbewegungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                        "entry_id": "cdf469b1-7f5b-3cd2-b883-9b82471eb351",
                        "glosses": [
                            "Gruppe von Personen, die soziale oder politische Veränderungen, beispielsweise mit Hilfe von Demonstrationen, anstrebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0be943-ef16-4c7d-ab49-0a947011b9f9",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Im Sudan haben sich die Protestbewegung und der militärische Übergangsrat auf einen Verfassungstext geeinigt.“"
                            },
                            {
                                "example_id": "db54d8d0-ad8b-45c1-9e5c-c0c5420711be",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Mit seiner ersten Protestbewegung setzt er 2009 bessere Mahlzeiten in seiner Schule durch.“"
                            },
                            {
                                "example_id": "b3fc5388-7cbe-42d3-bad5-1e101e4e7540",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Die bundesweite Protestbewegung, die im Herbst aus einer Facebook-Gruppe heraus entstand, will auf jeden Fall weitermachen.“"
                            },
                            {
                                "example_id": "32587c9e-390c-41c6-bb88-f1649cab4365",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Die Protestbewegung könnte weit stärker werden als die Massenproteste von 2009, sagte Ebadi der italienischen Zeitung «La Repubblica».“"
                            },
                            {
                                "example_id": "f25aba03-5c63-4dd0-9b48-533aea494adc",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Ministerpräsident Hassan Diab hat eine Regierung gebildet - allerdings eine, die der Protestbewegung nicht gefällt […]“"
                            },
                            {
                                "example_id": "7563bfbd-8249-495e-8ec1-d68651a26d50",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„[…] seit dem Fall des Eisernen Vorhangs ist es stiller um die Friedensbewegung geworden. Doch die weltpolitische Lage und junge Protestbewegungen wie \"Fridays for Future\" lassen die Friedensbewegung wieder aktiver werden, etwa in Göttingen.“"
                            },
                            {
                                "example_id": "e78c78ec-ab5c-41ee-ae58-21bb8bcb5d5d",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Im April 1989 strömen Studenten auf den Tian'anmen-Platz in Peking, um des verstorbenen Generalsekretärs Hu Yaobang zu gedenken. Aus den Feierlichkeiten entwickelt sich die größte Protestbewegung in der Geschichte der Volksrepublik China.“"
                            },
                            {
                                "example_id": "15e288aa-086e-443c-9d87-a1c0a9481324",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Ab 1976 formiert sich eine Protestbewegung gegen den Bau eines Atomkraftwerkes in Brokdorf und das geplante atomare Endlager in Gorleben.“"
                            },
                            {
                                "example_id": "9e713934-4342-4f3d-bb85-85c12323330c",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Die Novemberrevolution 1918 ist das Ergebnis einer spontanen Protestbewegung. Während der Militär- und Polizeiapparat des Kaiserreichs zusammenbricht, bilden die Aufständischen ohne zentrale Lenkung Arbeiter- und Soldatenräte.“"
                            },
                            {
                                "example_id": "98a0bf2d-f977-4fd2-8e0f-57ed06cf07ce",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Auf einem Kongress in Paris legten Delegierte sozialistischer Parteien und Gewerkschafter fest, dass beginnend mit dem 1. Mai 1890 dies alljährlich der Tag für Kundgebungen und Manifeste der Arbeiterklasse ist. Eine globale Protestbewegung war entstanden.“"
                            },
                            {
                                "example_id": "eb17c521-dfe5-487a-b096-41696a3a7bef",
                                "sense_id": "c0fea592-8c80-3c30-a2e1-1ac2655d596b",
                                "text": "„Die Täufer sind Anhänger einer Protestbewegung, die im frühen 16. Jahrhundert in weiten Teilen des Reiches auftritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
