                "senses": [
                    {
                        "sense_id": "bf4b4a56-ec0d-39d2-8f28-4f0330364f66",
                        "entry_id": "6ed655e4-7b7a-3e18-9b37-8e3b1f884da6",
                        "glosses": [
                            "Koffer aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f45856-ccea-43ed-b013-fd6892367d20",
                                "sense_id": "bf4b4a56-ec0d-39d2-8f28-4f0330364f66",
                                "text": "„Sie stand zwischen den vier Drachen und Lucky, die Glock in der einen Hand und etwas, das wie ein dicker Plastikkoffer aussah, in der anderen.“"
                            },
                            {
                                "example_id": "ee89b921-2d47-4be0-a331-df5b212fdb48",
                                "sense_id": "bf4b4a56-ec0d-39d2-8f28-4f0330364f66",
                                "text": "„Danach packte er seinen rot-gelben Plastikkoffer aus, in dem seine Spielsachen waren, und hockte sich damit auf den Wohnzimmerboden, wo er ganz in seinem Spiel aufging, während Granny ihm zusah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
