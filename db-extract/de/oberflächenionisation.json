                "senses": [
                    {
                        "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                        "entry_id": "64bb5fdf-6162-3b01-941c-a67fd01427fd",
                        "glosses": [
                            "entfernen/hinzufügen eines oder mehrerer Elektronen von einem Atom oder Molekül durch Energiezufuhr an Flächen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75544735-35fc-4702-be71-65bcf61b50cf",
                                "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                                "text": "„Die Oberflächenionisation wurde zuerst von Langmuir 1923 untersucht.“"
                            },
                            {
                                "example_id": "ac3abaa3-3e50-4972-bcdb-23cd47f05534",
                                "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                                "text": "„Innovatives Design ermöglicht hier die Beschaffung mehrerer Signale, bestehend aus resistiver Antwort (resistive response, RES), Oberflächenionisation (surface ionisation, SI) und katalytischer Wärmeleitfähigkeit (catalytic heat conductivity, CH), aus einer einzigen Sensorschicht.“"
                            },
                            {
                                "example_id": "0a0dbf9f-e755-43af-9e01-cbcf2914b990",
                                "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                                "text": "„Zur schnellen und kostengünstigen Erkennung von stickstoffhaltigen Kohlenwasserstoffen im Bodengas wird die Anwendung der Oberflächenionisation untersucht.“"
                            },
                            {
                                "example_id": "cb57b210-a449-4500-a8a3-c49e0ed901e4",
                                "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                                "text": "„Die auf der Grundlage der Oberflächenionisation arbeitenden Detektoren weisen eine hohe Empfindlichkeit und Selektivität bei der Detektion einer Reihe von Stickstoffheteroatome enthaltenden organischen Verbindungen auf.“"
                            },
                            {
                                "example_id": "e7ee9480-35be-48f5-b960-5447cd948853",
                                "sense_id": "93bce6d4-1a56-3fba-be31-d23c60179280",
                                "text": "„Es wird deshalb im theoretischen Teil eine Reihe von Beziehungen zusammengestellt zwischen Oberflächenionisation und Adsorptions- bzw. Desorptionsvorgängen bei niedrigem und höherem Bedeckungsgrad.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
