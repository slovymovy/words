                    },
                    {
                        "form_id": "ae54ff64-a6ff-4548-982c-bcac4b7b8ae2",
                        "entry_id": "122c1bb2-0a59-3707-b4bc-e6b4fd34f679",
                        "tags": [],
                        "form": "anté-pénultième"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                        "entry_id": "122c1bb2-0a59-3707-b4bc-e6b4fd34f679",
                        "glosses": [
                            "Troisième en comptant de la fin. Qui précède immédiatement le pénultième."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc8b2c4-3a31-4e38-8f89-d79751e65450",
                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                "text": "C’est, selon la terminologie de Fourier, l’état antépénultième du refroidissement."
                            },
                            {
                                "example_id": "ac64d07c-413b-4a12-8a20-67eba76a0827",
                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                "text": "Vince Taylor passa en vedette à l’Olympia, avec, en vedette américaine, Henri Tisot, l’imitateur du général De Gaulle et en vedette anglaise, à l’antépénultième place, Rosalie Dubois une ancienne poissonnière […]"
                            },
                            {
                                "example_id": "5a165429-e98a-4402-a4cf-c586fde3a6ea",
                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                "text": "Les lois de programmation mentionnées à l’antépénultième alinéa de l’article 34 de la Constitution ont pour objet de déterminer « les objectifs de l’action de l’État »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01850b55-263b-4ffc-a645-583483afebf4",
                        "source_entry_id": "122c1bb2-0a59-3707-b4bc-e6b4fd34f679",
                        "source_sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
