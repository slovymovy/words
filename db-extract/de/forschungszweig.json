                "senses": [
                    {
                        "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                        "entry_id": "22ccb7e6-9730-3975-a59f-337c26639811",
                        "glosses": [
                            "Teildisziplin in der wissenschaftlichen Forschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9015c59-a09b-4f98-9ae0-6682906336c0",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Der entsprechende Forschungszweig ist die Chronobiologie, nach ‚Chronos‘, dem griechischen Wort für Zeit.“"
                            },
                            {
                                "example_id": "a207858c-fe22-487a-99d6-62c9494d891c",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Mit seinen Arbeiten begründete er einen neuen Forschungszweig, der die Bezeichnung ‚evolutionäre Biotechnologie‘ erhielt.“"
                            },
                            {
                                "example_id": "86e79193-c756-48c0-a82d-e76b9cbfc5d3",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Aber auch die Lebensgeschichten einzelner Tiere lassen sich anhand von Knochen und Zähnen rekonstruieren - ein Forschungszweig, der nach Schrenks Worten derzeit kräftig wächst.“"
                            },
                            {
                                "example_id": "eff802ea-a006-4cb9-b0fd-3776a7de70ef",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Zugleich ist Gaia nicht identisch mit dem ‚Erdsystem‘, für das sich Forschungszweige zuständig erklären, die heute nicht einfach nur ‚Geologie‘ oder ‚Paläontologie‘ heißen wollen.“"
                            },
                            {
                                "example_id": "8ae1fb08-32f6-4a19-8e5d-a008a4f0e87a",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Die gebräuchlichen physikalischen Instrumente und Verfahren werden ebenso ausführlich beschrieben wie die vielen Forschungszweige der Physik.“"
                            },
                            {
                                "example_id": "1fc45c68-7205-4e2a-afaa-4d819c635427",
                                "sense_id": "8630c077-b6d4-34d5-b2f5-3f73468f389d",
                                "text": "„Wir werden uns deshalb bei unseren Betrachtungen von vornherein besonders auf die Erfahrungen stützen müssen, die dem Forschungszweige der Meteorologie entspringen, der seit dem Beginn seiner Arbeit auf die Angaben selbstschreibender Geräte angewiesen war, auf die Erfahrungen der Aerologie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
