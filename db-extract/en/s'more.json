                        "sense_id": "636aa92a-fba5-3790-b797-96398d48ca07",
                        "entry_id": "5d723192-df7c-360a-9a75-efa4989193e4",
                        "glosses": [
                            "A snack food made by combining graham crackers, marshmallows (frequently toasted) and chocolate, a typical camping fireside treat."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "2983c87b-9440-45c1-8203-361d2f41f1b8",
                                "sense_id": "636aa92a-fba5-3790-b797-96398d48ca07",
                                "text": "1990, Margaret Kenda, Cooking Wizardry for Kids\nS’Mores are a traditional favorite cook-out food with Boy Scouts and Girl Scouts."
                            },
                            {
                                "example_id": "74e1ffd7-0111-4af4-8603-e8f539331d02",
                                "sense_id": "636aa92a-fba5-3790-b797-96398d48ca07",
                                "text": "2003, Sheri Joseph, Bear Me Safely Over\nShe bit into the s’more, and the melted marshmallow goo fell over her lip, onto her chin."
                            },
                            {
                                "example_id": "059c437f-0453-4425-8e3a-5fad3f77d168",
                                "sense_id": "636aa92a-fba5-3790-b797-96398d48ca07",
                                "text": "2003, Cynthia Kaplan, I’m Like This\nI’d had too many s’mores."
                            }
                        ]
                    }
