                "senses": [
                    {
                        "sense_id": "eb870ac2-0328-336c-b764-185041f1e6c9",
                        "entry_id": "f54a8ab7-d8dc-3be4-8606-d0d8979a406b",
                        "glosses": [
                            "weibliche Person, die Inhaberin eines landwirtschaftlichen Betriebes (Landgutes) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd2f310-aea9-471c-91fc-f4cd26a91848",
                                "sense_id": "eb870ac2-0328-336c-b764-185041f1e6c9",
                                "text": "Die Gutsherrin veranstaltet jährlich ein Fest auf ihrem Gut."
                            },
                            {
                                "example_id": "fa8f1142-6b9f-4932-baaf-a4eb0113e0da",
                                "sense_id": "eb870ac2-0328-336c-b764-185041f1e6c9",
                                "text": "„Die Amtsanwaltschaft in Danzig stellt ein Verfahren gegen eine Gutsherrin ein, die ein 42-jähriges Dienstmädchen während eines Streits so misshandelt hatte, dass es sich ein ärztliches Attest hatte geben lassen und vor Gericht gezogen war.“"
                            },
                            {
                                "example_id": "105c1599-c41b-4b0a-be93-aeb0e23c2d7a",
                                "sense_id": "eb870ac2-0328-336c-b764-185041f1e6c9",
                                "text": "„Gegen Mittag machten wieder ein paar Wehrmachtssoldaten Halt in Götzlack und drängten die Gutsherrin, Haus und Hof so rasch wie möglich zu verlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
