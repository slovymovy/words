                        "entry_id": "2a690421-9563-355f-9ea4-653247182e4c",
                        "glosses": [
                            "Qualifie une chose qui n'est pas neuve."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
