                        "examples": [
                            {
                                "example_id": "515f6b4a-4a12-4980-858f-fb006d67ce8a",
                                "sense_id": "742bcc8a-790f-3832-a47c-f0612d44044f",
                                "text": "Voor goedkeuring moet uw monster voldoen aan drie voorwaarden: het mag niet druppelen (brandend of druipend), er mogen geen roetvlokken zijn vrijgekomen en niet langer dan vijftien seconden nabranden of zestig seconden nagloeien. Pas dan mag u... aanvalluh!"
                            }
                        ]
                    },
