                        "sense_id": "a8eb15d9-2fd2-36d9-8b68-e37d80920c45",
                        "entry_id": "15c771a6-bf19-38cb-b3ac-0e8a0f43b006",
                        "glosses": [
                            "Producteur de thé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03bfe7bb-9318-46d1-ac7b-f6c6025c10af",
                                "sense_id": "a8eb15d9-2fd2-36d9-8b68-e37d80920c45",
                                "text": "Aussi les nouveaux théiculteurs africains ne prétendent-ils pas rivaliser, pour la qualité, avec les producteurs asiatiques, et ce d’autant moins que l’importation des semences de Ceylan est interdite."
                            },
                            {
                                "example_id": "5be7b2aa-c5b5-4910-8778-e6324bfbd080",
                                "sense_id": "a8eb15d9-2fd2-36d9-8b68-e37d80920c45",
                                "text": "Pourtant, en 1901, un théiculteur de Tchakva, Iouda Antonovitch Kochman, réussit à planter du thé à presque 44° de latitude."
                            },
                            {
                                "example_id": "e55643eb-9a19-40a6-acea-a6c30695ce07",
                                "sense_id": "a8eb15d9-2fd2-36d9-8b68-e37d80920c45",
                                "text": "« C’est un revenu d’appoint qui est important pour nous », me précise l’une des théicultrices."
                            }
                        ]
                    }
