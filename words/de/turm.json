                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der mutige Junge sprang im Freibad direkt vom zehn Meter hohen <w>Turm</w> ins Wasser."
                        },
                        {
                            "text": "Vor dem Sprung ins tiefe Becken stand sie zögernd auf dem <w>Turm</w>."
