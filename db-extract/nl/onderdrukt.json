                                "sense_id": "0cf09688-7a84-374f-a55e-bdf74bc9f2f6",
                                "text": "Hij onderdrukt."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3b78390-4ac0-3634-a5af-f0ac0873db60",
                        "entry_id": "8a60dccb-8b72-31e8-b82b-6b644308de1d",
                        "glosses": [
