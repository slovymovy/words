{
    "word_family": [
        "oplegging",
        "oplegger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00f71988-379b-3bff-8bef-c879f6f00b2d",
                    "sense_definition": "Iets op iets anders plaatsen of aanbrengen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige moest voorzichtig een nieuw verband <w>opleggen</w> bij de patiënt.",
                            "target_lang_translations": {
                                "en": "The nurse had to carefully <w>apply</w> a new bandage to the patient.",
                                "ru": "Медсестра должна была осторожно <w>наложить</w> пациенту новую повязку.",
                                "fr": "L'infirmier a dû délicatement <w>appliquer</w> un nouveau pansement au patient."
                            }
                        },
                        {
                            "text": "Tijdens de ceremonie zal de priester de gelovigen de handen <w>opleggen</w>.",
                            "target_lang_translations": {
                                "en": "During the ceremony, the priest will <w>lay</w> hands on the believers.",
                                "ru": "Во время церемонии священник будет <w>возлагать</w> руки на верующих.",
                                "fr": "Pendant la cérémonie, le prêtre va <w>imposer</w> les mains aux fidèles."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaatsen",
                        "aanbrengen",
                        "neerleggen"
                    ],
                    "antonyms": [
                        "wegnemen",
                        "verwijderen",
                        "afnemen"
                    ],
                    "common_phrases": [
                        "de handen opleggen",
                        "een verband opleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To place or apply something onto something else.",
                        "ru": "Помещать или накладывать что-либо на что-то другое.",
                        "fr": "Placer ou appliquer quelque chose sur autre chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apply",
                                "target_lang_sense_clarification": "a bandage or medical dressing"
                            },
                            {
                                "target_lang_word": "lay",
                                "target_lang_sense_clarification": "hands, in a religious or ritual context"
                            },
                            {
                                "target_lang_word": "put on",
                                "target_lang_sense_clarification": "general physical placement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "накладывать",
                                "target_lang_sense_clarification": "повязку, слой чего-либо"
                            },
                            {
                                "target_lang_word": "возлагать",
                                "target_lang_sense_clarification": "руки (в религиозном контексте)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "appliquer",
                                "target_lang_sense_clarification": "un pansement ou un bandage"
                            },
                            {
                                "target_lang_word": "imposer",
                                "target_lang_sense_clarification": "les mains, rituel ou religieux"
                            },
                            {
                                "target_lang_word": "poser",
                                "target_lang_sense_clarification": "mettre physiquement sur quelque chose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfc63351-7246-3655-abe3-3a9da47671ff",
                    "sense_definition": "Iemand verplichten een bepaalde straf, maatregel of taak te ondergaan of uit te voeren.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter besloot de verdachte een zware geldboete <w>op</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "The judge decided to <w>impose</w> a heavy fine on the suspect.",
                                "ru": "Судья решил <w>наложить</w> на обвиняемого крупный денежный штраф.",
                                "fr": "Le juge a décidé d'<w>infliger</w> une lourde amende au suspect."
                            }
                        },
                        {
                            "text": "De overheid kan in tijden van crisis beperkingen <w>opleggen</w> aan de bevolking.",
                            "target_lang_translations": {
                                "en": "The government can <w>impose</w> restrictions on the population in times of crisis.",
                                "ru": "Правительство может <w>наложить</w> ограничения на население во время кризиса.",
                                "fr": "Le gouvernement peut <w>imposer</w> des restrictions à la population en temps de crise."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplichten",
                        "afdwingen",
                        "voorschrijven",
                        "dicteren"
                    ],
                    "antonyms": [
                        "kwijtschelden",
                        "vrijstellen",
                        "ontheffen"
                    ],
                    "common_phrases": [
                        "een boete opleggen",
                        "een straf opleggen",
                        "sancties opleggen",
                        "beperkingen opleggen",
                        "regels opleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To force someone to accept a punishment, rule, or task.",
                        "ru": "Обязывать кого-либо выполнить определенное наказание, меру или задачу; принуждать.",
                        "fr": "Contraindre quelqu'un à subir une punition, respecter une règle ou accomplir une tâche."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impose",
                                "target_lang_sense_clarification": "a penalty, restriction, or tax"
                            },
                            {
                                "target_lang_word": "inflict",
                                "target_lang_sense_clarification": "a punishment or suffering"
                            },
                            {
                                "target_lang_word": "levy",
                                "target_lang_sense_clarification": "a fine or tax"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "налагать",
                                "target_lang_sense_clarification": "штраф, запрет, санкции"
                            },
                            {
                                "target_lang_word": "облагать",
                                "target_lang_sense_clarification": "налогом, пошлиной"
                            },
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "волю, мнение, правила"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "imposer",
                                "target_lang_sense_clarification": "une sanction, une règle, des restrictions"
                            },
                            {
                                "target_lang_word": "infliger",
                                "target_lang_sense_clarification": "une punition ou une amende"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08116659-4791-34e1-9fa3-c2954221a863",
                    "sense_definition": "Een voorwerp bedekken met een dunne laag van een ander (vaak kostbaarder) materiaal, zoals hout of metaal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meubelmaker gaat het tafelblad met een laagje mahoniehout <w>opleggen</w>.",
                            "target_lang_translations": {
                                "en": "The furniture maker is going to <w>veneer</w> the table top with a layer of mahogany.",
                                "ru": "Мебельщик собирается <w>облицевать</w> столешницу слоем красного дерева.",
                                "fr": "L'ébéniste va <w>plaquer</w> le dessus de table avec une fine couche d'acajou."
                            }
                        },
                        {
                            "text": "Dit antieke kistje is vakkundig <w>opgelegd</w> met zilver en parelmoer.",
                            "target_lang_translations": {
                                "en": "This antique box is skillfully <w>inlaid</w> with silver and mother-of-pearl.",
                                "ru": "Эта антикварная шкатулка искусно <w>инкрустирована</w> серебром и перламутром.",
                                "fr": "Ce coffret ancien est habilement <w>incrusté</w> d'argent et de nacre."
                            }
                        }
                    ],
                    "synonyms": [
                        "fineren",
                        "bedekken",
                        "inleggen"
                    ],
                    "common_phrases": [
                        "met goud opleggen",
                        "met zilver opleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover an object with a thin layer of another material.",
                        "ru": "Покрывать предмет тонким слоем другого материала (например, деревом или металлом).",
                        "fr": "Recouvrir un objet d'une fine couche d'un autre matériau, souvent plus précieux."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "veneer",
                                "target_lang_sense_clarification": "with a thin layer of wood"
                            },
                            {
                                "target_lang_word": "overlay",
                                "target_lang_sense_clarification": "with a layer of material like metal"
                            },
                            {
                                "target_lang_word": "inlay",
                                "target_lang_sense_clarification": "with decorative material"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "облицовывать",
                                "target_lang_sense_clarification": "покрывать слоем материала"
                            },
                            {
                                "target_lang_word": "инкрустировать",
                                "target_lang_sense_clarification": "украшать вставками"
                            },
                            {
                                "target_lang_word": "фанеровать",
                                "target_lang_sense_clarification": "покрывать шпоном"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plaquer",
                                "target_lang_sense_clarification": "avec du bois précieux ou du métal"
                            },
                            {
                                "target_lang_word": "incruster",
                                "target_lang_sense_clarification": "avec des ornements ou matériaux"
                            },
                            {
                                "target_lang_word": "revêtir",
                                "target_lang_sense_clarification": "couvrir d'une couche"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}