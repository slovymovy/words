                "senses": [
                    {
                        "sense_id": "8847c5b5-a059-3309-b042-8cc53b4fa4d3",
                        "entry_id": "88779971-ce81-3b18-a00e-d87f89260a84",
                        "glosses": [
                            "A supernatural being similar to an elf; one of the Dǫkkálfar or Ljósalfar."
                        ],
                        "tags": [
                            "Norse"
                        ],
                        "examples": [
                            {
                                "example_id": "7952bca8-4118-407b-a1a3-53b4c3fca0f4",
                                "sense_id": "8847c5b5-a059-3309-b042-8cc53b4fa4d3",
                                "text": "As the Scandinavians were at that time still worshippers of Thor and Odin, the belief in Alfs and Dwarfs accompanied them to their new abodes, and there, as elsewhere, survived the introduction of Christianity."
                            },
                            {
                                "example_id": "dec00450-8087-4312-ba5b-f9343bfcc4f5",
                                "sense_id": "8847c5b5-a059-3309-b042-8cc53b4fa4d3",
                                "text": "[T]he charm suggests rather that the Ases had sunk to a level where they could be counted together with witches and lesser wights, than that the alfs were seen as godly beings at the time the charm was composed."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d824309d-7eb6-3947-a050-f1941b99b932",
                "word": "Alf",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eb398bcd-cf9a-488c-b541-868ae298bd86",
                        "entry_id": "d824309d-7eb6-3947-a050-f1941b99b932",
                        "tags": [
                            "plural"
                        ],
                        "form": "Alfs"
