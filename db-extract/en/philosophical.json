                                        "glosses": [
                                            "reich an Wissen und Lebenserfahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3d4271-86f2-4cfa-afac-e38af48c8aeb",
                                                "sense_id": "91824a0a-4ba7-33ca-888c-b71e69455a3a",
                                                "text": "Er ist ein weiser Mann."
                                            },
                                            {
                                                "example_id": "c10b57e5-eab9-4212-b2d8-1ecfa1a095bf",
                                                "sense_id": "91824a0a-4ba7-33ca-888c-b71e69455a3a",
                                                "text": "Die achtzig Jahre ihres Lebens haben sie weise werden lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1e9062a-f6a0-3823-a5fb-d3d2ffad753d",
                                        "entry_id": "a372bfba-fa66-3c0c-b36a-95b23c5ea5bd",
                                        "glosses": [
                                            "von viel Wissen und Lebenserfahrung zeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88963e91-bc47-4357-a896-00e8eb4a12a4",
                                                "sense_id": "e1e9062a-f6a0-3823-a5fb-d3d2ffad753d",
                                                "text": "Das ist eine sehr weise Entscheidung."
                                            },
                                            {
                                                "example_id": "2f8829ca-2ef0-4443-b9b4-ff2c7ef7369b",
                                                "sense_id": "e1e9062a-f6a0-3823-a5fb-d3d2ffad753d",
                                                "text": "Der Häuptling lächelte weise."
                                            },
                                            {
                                                "example_id": "0c46f710-15c8-49db-b5fa-c67039993b36",
                                                "sense_id": "e1e9062a-f6a0-3823-a5fb-d3d2ffad753d",
                                                "text": "In weiser Voraussicht hatte Kunigunde ihrem Mann nie Einblick in ihre finanziellen Angelegenheiten gewährt."
                                            }
