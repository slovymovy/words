                "senses": [
                    {
                        "sense_id": "f357d85a-ceed-3cd6-85d7-9b4bc2c3bf55",
                        "entry_id": "20646fd1-194f-3050-8b35-8ac138f61c35",
                        "glosses": [
                            "Donner un caractère synodal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e34a8dab-eb0f-4402-9216-042570d824fd",
                                "sense_id": "f357d85a-ceed-3cd6-85d7-9b4bc2c3bf55",
                                "text": "Comment « synodaliser » l’Église, nos Églises ?"
                            },
                            {
                                "example_id": "c0b39ad5-91a1-4940-9e6f-4461a7fdc6cd",
                                "sense_id": "f357d85a-ceed-3cd6-85d7-9b4bc2c3bf55",
                                "text": "A Madagascar, c’est le même mouvement qui conduit les missionnaires à synodaliser les structures congrégationalistes des Eglises héritées de la Mission de Londres pour aboutir à la tenue, en 1903, d’un premier synode et, en 1909, à l’adoption d’une discipline et à la création d’une caisse centrale au profit de l’évangélisation du nord de la Grande-Ile."
                            },
                            {
                                "example_id": "4383a19e-3940-46d9-ba8d-8ff1a8b446b6",
                                "sense_id": "f357d85a-ceed-3cd6-85d7-9b4bc2c3bf55",
                                "text": "Quelques années plus tard, l'évangélisation ayant porté ses fruits, les conseils presbytéraux seront fiers de voir leurs églises réjoindre l’Eglise Réformée et se \"synodaliser\"."
                            }
                        ]
                    }
                ],
