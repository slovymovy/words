                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "8ee43ca9-5ee5-4c46-8943-ceb4496949b8",
                        "entry_id": "ec177fb4-8db6-31a8-9c24-572eabc5335c",
