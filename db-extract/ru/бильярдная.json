                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billiard-room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90390227-cca7-34c6-a4c5-31ba7ffbb3c7",
                                        "entry_id": "7f4a73e6-8caf-361d-9a63-edd7536b3940",
                                        "glosses": [
                                            "Dated form of billiard room."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52169e4d-3a1f-416b-8da9-84d4256181fc",
                                                "sense_id": "90390227-cca7-34c6-a4c5-31ba7ffbb3c7",
                                                "text": "The drawing-room had been modernized, and contrasted ill with an ancient paneled billiard-room, through which one had to pass ere it was entered."
                                            },
                                            {
                                                "example_id": "5b62e008-4a23-4cfc-beaf-07a8081d862a",
                                                "sense_id": "90390227-cca7-34c6-a4c5-31ba7ffbb3c7",
                                                "text": "[…] who hate living in camp (though they have a club-house), and miss the billiard-rooms, flirtations with pretty confectioneresses and milliners […]"
                                            },
                                            {
                                                "example_id": "8995808d-dfdd-4789-8842-9da544a99ed3",
                                                "sense_id": "90390227-cca7-34c6-a4c5-31ba7ffbb3c7",
                                                "text": "The game between Hargate and Lord Dreever was still in progress when Jimmy returned to the billiard-room."
                                            },
                                            {
                                                "example_id": "097a3f95-c725-48df-8c67-8438001ce441",
                                                "sense_id": "90390227-cca7-34c6-a4c5-31ba7ffbb3c7",
                                                "text": "Finally they retired, did you not? said Tetty. / We did indeed, said Goff, we retired to the billiard-room, for a game of slosh."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
