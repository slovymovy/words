                        "examples": [
                            {
                                "example_id": "603a1fd1-3327-418c-a24c-96a3766f9791",
                                "sense_id": "b9dec1ec-0591-384a-9f53-751616f226ab",
                                "text": "„Als Thomas Lieven eine halbe Stunde später das Haus am Boulevard de la Corderie verließ, sah er, daß sich aus einer Mauernische ein Schatten löste und ihm durch die diesige Dunkelheit folgte.“"
                            },
                            {
                                "example_id": "6396e575-a648-4097-a998-db6535e0e9dd",
                                "sense_id": "b9dec1ec-0591-384a-9f53-751616f226ab",
                                "text": "„Er kommt aus einer Mauernische und geht ruhig wie der eines Schlafenden.“"
                            }
                        ],
