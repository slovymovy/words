                "senses": [
                    {
                        "sense_id": "fa9297e3-80a2-3ca0-8970-c7b494600fd7",
                        "entry_id": "4416a673-a085-396e-8e0b-94b34e5ef0ad",
                        "glosses": [
                            "Action d’héberger ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                        "entry_id": "4416a673-a085-396e-8e0b-94b34e5ef0ad",
                        "glosses": [
                            "Logement, généralement provisoire."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7e00ab9f-deb3-4dd5-9651-e133245a418a",
                                "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                                "text": "Il faut leur trouver un hébergement pour la nuit."
                            },
                            {
                                "example_id": "e2250c34-5b2b-4408-92d1-ea14860893f0",
                                "sense_id": "d15ff32e-95c1-3cc2-b30a-a0385499b3c3",
                                "text": "L’investissement dans un hébergement de groupe est souvent important (c’est pourquoi ces structures sont très souvent à la charge de collectivités, ce qui ne signifie pas qu’elles fonctionnent mieux)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d82746-bb48-4841-a9c9-951e29369d78",
                        "source_entry_id": "4416a673-a085-396e-8e0b-94b34e5ef0ad",
                        "source_sense_description": "Action d’héberger ou résultat de cette action",
                        "target_lang_word": "Unterbringung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterbringung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a54c0fbe-fc96-30ee-b11a-f23f0cfc340b",
                                        "entry_id": "353f0802-699d-35bb-a39a-20af63c7e69e",
                                        "glosses": [
                                            "das Organisieren einer Unterkunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc862b63-05a5-492f-a51b-16665cb0c59d",
                                                "sense_id": "a54c0fbe-fc96-30ee-b11a-f23f0cfc340b",
                                                "text": "Wer viele Gäste einlädt, muss sich auch um deren Unterbringung kümmern."
                                            },
                                            {
                                                "example_id": "d661b45d-0614-4283-8b2b-70b4c44faa9c",
                                                "sense_id": "a54c0fbe-fc96-30ee-b11a-f23f0cfc340b",
                                                "text": "Wenn die Krankenpflege zu Hause nicht gewährleistet ist, bleibt nur eine Unterbringung in einem Pflegeheim."
                                            },
                                            {
                                                "example_id": "e093e51a-7f48-4329-b815-5cdb39689d11",
                                                "sense_id": "a54c0fbe-fc96-30ee-b11a-f23f0cfc340b",
                                                "text": "Der Reiseveranstalter sorgte wegen Überbuchung des Hotels für die Unterbringung in einer billigen Absteige."
                                            },
                                            {
                                                "example_id": "ef58c37e-6885-41e1-95a4-4f7301c74db6",
                                                "sense_id": "a54c0fbe-fc96-30ee-b11a-f23f0cfc340b",
                                                "text": "„Mit honigsüßen Worten sagte er mir, Seine Excellenz habe höchstselbst dem Haushofmeister Weisungen bezüglich meiner Unterbringung im Palazzo gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b135defa-c394-3076-99c7-5312a156d94a",
                                        "entry_id": "353f0802-699d-35bb-a39a-20af63c7e69e",
                                        "glosses": [
                                            "Unterkunft als Ort des zeitweiligen Aufenthaltes zum Wohnen und Schlafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590c0625-f325-4003-a5b2-c9d07d238807",
                                                "sense_id": "b135defa-c394-3076-99c7-5312a156d94a",
                                                "text": "„Mit honigsüßen Worten sagte er mir, Seine Excellenz habe höchstselbst dem Haushofmeister Weisungen bezüglich meiner Unterbringung im Palazzo gegeben.“"
                                            },
                                            {
                                                "example_id": "5629076e-09c0-48dc-bbb1-7d28f2ced73f",
                                                "sense_id": "b135defa-c394-3076-99c7-5312a156d94a",
                                                "text": "Die Unterbringung war zwar einfach, aber geschmackvoll eingerichtet."
                                            },
                                            {
                                                "example_id": "bf9a778b-db93-427a-b934-3cbf47c4527a",
                                                "sense_id": "b135defa-c394-3076-99c7-5312a156d94a",
                                                "text": "„Wer eine gepflegtere Unterbringung vorzieht und es nicht liebt, sich während seines Skiurlaubs über Nacht im Schnee zusammenzurollen, dem ist zu raten, seine Urlaubstermine etwa auf Lebenszeit vorauszuplanen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "025f834c-b101-3e79-83a7-6b533de22acf",
                                        "entry_id": "353f0802-699d-35bb-a39a-20af63c7e69e",
                                        "glosses": [
                                            "Aufenthalt in einer psychiatrischen Klinik gegen den Willen des Betroffenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea08dcbc-e9bf-4acb-b781-04618eee51db",
                                                "sense_id": "025f834c-b101-3e79-83a7-6b533de22acf",
                                                "text": "Der Psychiater ordnet die Unterbringung des Patienten in einer geschlossenen Einrichtung an."
                                            },
                                            {
                                                "example_id": "def8152b-1d5a-46be-8346-f1ee7ce3bc3d",
                                                "sense_id": "025f834c-b101-3e79-83a7-6b533de22acf",
                                                "text": "„Für eine Unterbringung in der Psychiatrie sah der Gutachter durchaus Voraussetzungen gegeben – sie erschien ihm aber nicht zwingend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
