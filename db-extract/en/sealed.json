                "senses": [
                    {
                        "sense_id": "6c7bd9ee-2d81-3fb7-824b-ae3c7fd5f856",
                        "entry_id": "4f8cd2f9-9f22-3d3b-84e4-38b152cdbd72",
                        "glosses": [
                            "Closed by a seal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "456ff322-62bc-4589-b9f7-c4fea41e2369",
                                "sense_id": "6c7bd9ee-2d81-3fb7-824b-ae3c7fd5f856",
                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb953750-067d-34e7-91d7-b384a5e5859e",
                        "entry_id": "4f8cd2f9-9f22-3d3b-84e4-38b152cdbd72",
                        "glosses": [
                            "Preventing entrance."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "96f24936-0fcb-33d6-97c4-490a715a819d",
                        "entry_id": "4f8cd2f9-9f22-3d3b-84e4-38b152cdbd72",
                        "glosses": [
                            "Of a road: having an asphalt or macadamised surface."
                        ],
