                        "glosses": [
                            "The state or condition of having no possessions."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cf5af9ce-e395-4fcb-93eb-3670cd1a60dc",
                                "sense_id": "710f9320-279f-3d72-9dd3-5bdbc4d0ee10",
                                "text": "Their rebellion . . . translated their dispossession into the free possessionlessness of childhood."
                            },
                            {
                                "example_id": "33f825ed-adf8-44c3-b954-7551bf576ddd",
                                "sense_id": "710f9320-279f-3d72-9dd3-5bdbc4d0ee10",
                                "text": "Olivi in his commentary on the Apocalypse sanctified Francisan poverty, in the extreme form of absolute penury as well as possessionlessness attributed by the Franciscan Spirituals to St. Francis."
                            },
                            {
                                "example_id": "757b3b41-3235-4427-859a-4b1337f2b72f",
                                "sense_id": "710f9320-279f-3d72-9dd3-5bdbc4d0ee10",
                                "text": "More appropriate here is a definition of poverty as \"possessionlessness,\" an understanding conveyed by the Pāli term akiñcana (\"without anything,\" \"lacking possessions\")."
                            }
                        ]
