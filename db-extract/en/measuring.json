                        "glosses": [
                            "Act of measurement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488629f7-249c-48a6-b618-f1eb975cb192",
                                "sense_id": "d919e878-cff8-366c-89cd-38d1087dfd9c",
                                "text": "The repeated measurings of one monument result in a mean approximation to something actually existing, and this is an excellent definition of an average."
                            }
                        ]
