    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
                "word": "transatlantic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                        "entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
                        "glosses": [
                            "On, spanning or crossing, or from the other side of the Atlantic Ocean."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "86815198-d98b-47d7-a7c3-f4f4072f092f",
                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                "text": "Serving the flat and fertile south-eastern part of Co. Cork is the railway that runs from Glanmire Road Station in Cork City to the popular seaside resort of Youghal (pronounced \"Yawl\") and the town of Cobh (pronounced \"Cove\"), which is Ireland's port of call for transatlantic liners."
                            },
                            {
                                "example_id": "bf6516d2-377e-40f7-9099-df366343f6d1",
                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                "text": "Many travellers via Fishguard regret the closing by British Transport Hotels & Catering Services of the Fishguard Bay Hotel, built by the G.W.R. early in the century for the expected transatlantic traffic."
                            },
                            {
                                "example_id": "2f220f57-7b7f-401f-9822-05bc446b3458",
                                "sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
                                "text": "Ruth Elder was known for her beauty and acting, but her real dream was to become the female version of transatlantic aviator Charles Lindbergh."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4aaecb43-150f-4869-92a6-30bb8af81cbe",
                        "source_entry_id": "c1d5725e-f06d-3fd3-a2ae-98b9dca57e5f",
                        "source_sense_id": "348372f4-ff2f-374c-8320-584d577013d6",
