    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a2fda83-4cff-36a6-97bf-73baf8e43308",
                    "sense_definition": "een vloeistof of substantie met een voorwerp in beweging brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de soep goed <w>roeren</w> zodat hij niet aanbrandt.",
                            "target_lang_translations": {
                                "en": "You must <w>stir</w> the soup well so that it doesn't burn."
                            }
                        },
                        {
                            "text": "Vergeet niet om de suiker in je koffie te <w>roeren</w>.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>stir</w> the sugar into your coffee."
                            }
                        }
                    ],
                    "synonyms": [
                        "mengen",
                        "klutsen"
                    ],
                    "common_phrases": [
                        "in de pan roeren",
                        "door elkaar roeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to set a liquid or substance in motion using an object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to move a liquid around with a spoon or object"
                            },
                            {
                                "target_lang_word": "mix",
                                "target_lang_sense_clarification": "to combine ingredients by stirring"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da1e31ba-8063-3057-a979-c4feb6d0964f",
                    "sense_definition": "zich bewegen of een teken van leven geven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het konijn <w>roerde</w> zich niet en wachtte geduldig tot de vos verdwenen was.",
                            "target_lang_translations": {
                                "en": "The rabbit didn't <w>stir</w> and waited patiently until the fox had disappeared."
                            }
                        },
                        {
                            "text": "Niemand durfde zich te <w>roeren</w> toen de leraar boos de klas in keek.",
                            "target_lang_translations": {
                                "en": "No one dared to <w>move</w> when the teacher looked angrily into the classroom."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen",
                        "verroeren"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "zich niet roeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to move or show a sign of life"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to make a slight physical movement"
                            },
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change position or posture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881b2e88-1a4a-3bf0-b0ed-603df46b2ad6",
                    "sense_definition": "iemand emotioneel raken of ontroeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het droevige verhaal van de vluchtelingen <w>roerde</w> het publiek tot tranen.",
                            "target_lang_translations": {
                                "en": "The sad story of the refugees <w>moved</w> the audience to tears."
                            }
                        },
                        {
                            "text": "Dat gebaar van vriendelijkheid <w>roerde</w> hem zeer.",
                            "target_lang_translations": {
                                "en": "That gesture of kindness <w>touched</w> him deeply."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontroeren",
                        "raken",
                        "aangrijpen"
                    ],
                    "common_phrases": [
                        "tot tranen geroerd"
                    ],
                    "target_lang_definitions": {
                        "en": "to touch someone emotionally or move them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to affect someone's emotions deeply"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "to cause a feeling of sympathy or gratitude"
                            },
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to arouse or excite a particular feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66284940-1c1e-3e56-b9d3-16317e1fca4b",
                    "sense_definition": "zich laten horen of in opstand komen om onvrede te uiten",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bergbewoners van de Kaukasus <w>roeren</w> zich weer als vanouds tegen de overheid.",
                            "target_lang_translations": {
                                "en": "The mountain dwellers of the Caucasus are <w>revolting</w> against the government again as of old."
                            }
                        },
                        {
                            "text": "De oppositie begon zich eindelijk te <w>roeren</w> na de nieuwe wetgeving.",
                            "target_lang_translations": {
                                "en": "The opposition finally began to <w>make itself heard</w> after the new legislation."
                            }
                        }
                    ],
                    "synonyms": [
                        "protesteren",
                        "opstaan"
                    ],
                    "common_phrases": [
                        "zich krachtig roeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make oneself heard or revolt to express dissatisfaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stir",
                                "target_lang_sense_clarification": "to begin to take action or cause trouble"
                            },
                            {
                                "target_lang_word": "revolt",
                                "target_lang_sense_clarification": "to rise up against authority"
                            },
                            {
                                "target_lang_word": "agitate",
                                "target_lang_sense_clarification": "to protest or stir up public opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9d3afe0-560a-3648-ad45-3f626733c702",
                    "sense_definition": "geluid of lawaai maken om aandacht te trekken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ongeduldige jongelui <w>roerden</w> zich tijdens het concert met boegeroep en andere ongein.",
                            "target_lang_translations": {
                                "en": "The impatient youngsters <w>made a stir</w> during the concert with booing and other mischief."
                            }
                        },
                        {
                            "text": "De supporters <w>roerden</w> zich luidkeels toen hun team eindelijk scoorde.",
                            "target_lang_translations": {
                                "en": "The supporters <w>made themselves heard</w> loudly when their team finally scored."
                            }
                        }
                    ],
                    "synonyms": [
                        "lawaai maken"
                    ],
                    "common_phrases": [
                        "zich luidkeels roeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make sound or noise to attract attention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make a stir",
                                "target_lang_sense_clarification": "to cause a commotion or excitement"
                            },
                            {
                                "target_lang_word": "be heard",
                                "target_lang_sense_clarification": "to speak up or make noise to be noticed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02da2388-5d6a-3468-a3fe-d053875b970c",
                    "sense_definition": "een muziekinstrument bespelen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wanneer de virtuoos de trompet <w>roerde</w> was iedereen tot tranen geroerd.",
                            "target_lang_translations": {
                                "en": "Whenever the virtuoso <w>played</w> the trumpet, everyone was moved to tears."
                            }
                        },
                        {
                            "text": "Hij voelde zich gedwongen de snaren te <w>roeren</w> en een lied te zingen.",
                            "target_lang_translations": {
                                "en": "He felt compelled to <w>strike</w> the strings and sing a song."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespelen",
                        "tokkelen"
                    ],
                    "common_phrases": [
                        "de snaren roeren",
                        "de trom roeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "voornamelijk in poëtische of historische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to play a musical instrument"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "to produce music from an instrument"
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "to hit or touch strings/keys to make music"
                            }
                        ]
                    }
                }
            ]
        },
