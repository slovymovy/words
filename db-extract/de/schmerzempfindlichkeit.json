                ],
                "senses": [
                    {
                        "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                        "entry_id": "f38a70c1-072a-3d5c-b4b1-a19a815dcb5e",
                        "glosses": [
                            "Eigenschaft, leicht Schmerzen zu spüren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5922323e-02a1-4803-850a-53ba05479bff",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "Aufgrund seiner hohen Schmerzempfindlichkeit konnte der Arzt ihn nicht behandeln."
                            },
                            {
                                "example_id": "5a8be27c-305e-47f1-8283-009d3a00d72d",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "„Lässt die Wirkung des Schmerzmittels nach, schießt die Schmerzempfindlichkeit hoch, es treten spontan sogenannte Rückschlagkopfschmerzen auf, die erneut die Schmerzmitteleinnahme fordern – ein Teufelskreis.“"
                            },
                            {
                                "example_id": "85ec8e0e-1ffc-48ad-bb86-b3c61cf5f3c9",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "„Uhl und seine Kollegen wollen nun untersuchen, inwieweit es möglich ist, individuelle, direkt auf die Schmerzempfindlichkeit des Einzelnen zugeschnittene Behandlungsverfahren zu entwickeln.“"
                            },
                            {
                                "example_id": "e13a9dc1-046f-4906-895d-ebf8a71a3230",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "„All diese Faktoren könnten wiederum hormonelle Stressreaktionen auslösen, die zu einer übertriebene Schmerzempfindlichkeit führen.“"
                            },
                            {
                                "example_id": "6aef1b16-ad8b-47c0-bb23-0c7cedc7d48d",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "„Nur in wenigen Fällen differenzieren Ärzte bei ihrem Vorgehen zwischen den – ohnehin schwer messbare – Schmerzempfindlichkeiten ihrer Patienten, und selbst, wo dies der Fall ist (etwa bei der ominösen Frage des Zahnarztes, ob der Patient seine Behandlung mit oder ohne Betäubungsspritze wünscht), entscheidet die individuelle Selbsteinschätzung, nicht die ›objektiv‹ ermittelte ›Standfestigkeit‹."
                            },
                            {
                                "example_id": "262875d9-28ed-4e66-bbb3-4fb2618e0797",
                                "sense_id": "56cc269b-fb59-3439-b0fa-ea6799f96211",
                                "text": "„Bei Anwendung der carbamidperoxidhaltigen Bleichungsmittel können allerdings Schleimhautverletzungen in Form von Erosionen und postoperative, meist reversible Schmerzempfindlichkeiten der behandelten Zähne auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
