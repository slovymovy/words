                        {
                            "text": "The prisoner was led to the Tyburn <w>tree</w> to face his final sentence.",
                            "target_lang_translations": {
                                "ru": "Заключенного повели к Тайбернской <w>виселице</w>, чтобы привести в исполнение смертный приговор."
                            }
