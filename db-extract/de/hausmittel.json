                "senses": [
                    {
                        "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                        "entry_id": "6f5a9999-13f9-3505-99cc-e96a8dfa569d",
                        "glosses": [
                            "Heilmittel oder Heilverfahren, das durch den Volksmund oder Ratgeber weitergegeben wird und nicht notwendigerweise wissenschaftlich untersucht wurde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5868b6cb-56fd-4c7d-8022-c427874fc1b2",
                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                "text": "„Streichen Sie auf Verbrennungen keine Cremen oder Hausmittel wie etwa Mehl oder Melkfett.“"
                            },
                            {
                                "example_id": "73f51e0e-970d-4a45-867d-5d154b5c3acd",
                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                "text": "Omas Hausmittel haben mir schon öfters geholfen."
                            },
                            {
                                "example_id": "5e6a1d57-8c60-48c1-b65d-7bf1c579e7b2",
                                "sense_id": "10e4f13d-0baa-3293-8779-33ddcfd51e6b",
                                "text": "„Doch es gab ja dieses alte Hausmittel, das Auge mit Wasser aus einer Pfütze mit still stehendem Wasser auszuwaschen, und das tat er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
