                        "examples": [
                            {
                                "example_id": "8ad8f3de-2aff-47c0-8cad-69618e68d0ce",
                                "sense_id": "6c33f3f6-9cdf-3421-90af-b30b9ad1038c",
                                "text": "Love for a balanced, harmonious, self-sufficient and unproblematic existence is the root of Greek art."
                            },
                            {
                                "example_id": "a7f22653-9f08-4766-bc68-f4dd26be6ed6",
                                "sense_id": "6c33f3f6-9cdf-3421-90af-b30b9ad1038c",
                                "text": "Peace, security, the untroubled enjoyment of unproblematic Nature: such is the main motif of Constable's work."
                            }
                        ]
                    }
