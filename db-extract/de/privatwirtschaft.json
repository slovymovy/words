                "senses": [
                    {
                        "sense_id": "2a58edb0-2ef0-3f0c-ac24-a01bd51d6043",
                        "entry_id": "7473767e-0c5d-30a4-993b-0072e917d8f6",
                        "glosses": [
                            "jener Teil der Volkswirtschaft, der nicht im Eigentum oder unter der Leitung des Staates steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3eab763-481d-4fad-bffd-05293b197037",
                                "sense_id": "2a58edb0-2ef0-3f0c-ac24-a01bd51d6043",
                                "text": "2001 wurde die „Vereinbarung zwischen der Bundesregierung und den Spitzenverbänden der deutschen Wirtschaft zur Förderung der Chancengleichheit von Frauen und Männern in der Privatwirtschaft“ getroffen."
                            },
                            {
                                "example_id": "973bda93-dbc5-46fa-9183-74f509e8e126",
                                "sense_id": "2a58edb0-2ef0-3f0c-ac24-a01bd51d6043",
                                "text": "„Nazis wie auch Kommunisten haben immer wieder Privatwirtschaft und Kirche zu Recht als grundsätzlich mit dem Staat konkurrierende Kräfte erkannt und zu entmachten versucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b8a3cd8-c2ce-4c0a-88c8-1b652ced0af4",
