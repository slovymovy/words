                                    },
                                    {
                                        "sense_id": "7f75cd18-0f9c-3af6-8b8f-1296ad5a4310",
                                        "entry_id": "1609f3fd-eaff-3d71-b862-fb2ec509afef",
                                        "glosses": [
                                            "Donner la bastonnade. ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b068e4a-0679-49d6-95ac-9882e6b2dfdf",
                                                "sense_id": "7f75cd18-0f9c-3af6-8b8f-1296ad5a4310",
                                                "text": "Il bannit tous les instruments de musique ; s’il découvrait la plus petite flûte, il la brisait en public, la jetait aux flammes ; le fautif était mis aux fers, abondamment bastonné, avant d’être expulsé de la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52200c2c-c10e-3d23-bff9-de1ed668d1ac",
                                        "entry_id": "1609f3fd-eaff-3d71-b862-fb2ec509afef",
                                        "glosses": [
                                            "Frapper quelqu'un."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48755bf2-cd2d-4f1a-a39b-af115e34aa0a",
                                                "sense_id": "52200c2c-c10e-3d23-bff9-de1ed668d1ac",
                                                "text": "Il m'a bastonné."
                                            },
                                            {
                                                "example_id": "e59f4f3b-1a84-4ccc-9a39-ab709e174892",
                                                "sense_id": "52200c2c-c10e-3d23-bff9-de1ed668d1ac",
                                                "text": "Le narrateur est un petit gars de 23 ans qui deale du shit sans grand succès, se fait bastonner, essaie d’exister […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6278da76-625f-3ac3-9699-72520096df70",
                                        "entry_id": "1609f3fd-eaff-3d71-b862-fb2ec509afef",
                                        "glosses": [
                                            "Se battre, prendre part à une baston."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b1b6fa-8e4b-493c-bf90-c6a65e3dbfae",
                                                "sense_id": "6278da76-625f-3ac3-9699-72520096df70",
                                                "text": "Ils se sont bastonnés toute la nuit dans le fond du bar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
