                "translations": [
                    {
                        "translation_id": "38e144f9-4bc8-4278-921c-1bf984671c3f",
                        "source_entry_id": "c778663c-717f-31b6-9f49-159ea5aa89dd",
                        "source_sense_id": "6d596759-0e8d-3e30-a6a1-6565ec6d5355",
