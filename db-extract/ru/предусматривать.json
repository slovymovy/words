                        "sense_id": "02254c83-35b5-36ca-84c1-5763786166ba",
                        "entry_id": "fc2f2e9f-fb65-3a20-8088-c48fccc56de4",
                        "glosses": [
                            "počítat s ; obnášet; předpokládat ; zahrnovat, kalkulovat"
