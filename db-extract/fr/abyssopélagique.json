                "senses": [
                    {
                        "sense_id": "85f3a6f4-c7d3-370e-8a97-13bf226b291c",
                        "entry_id": "1d273e90-1ddf-3587-a568-df43f2a2fd0d",
                        "glosses": [
                            "Qui se situe dans les abysses. Profond de 2000 à 6000 mètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19db5987-c629-47a3-80b2-4c78f1c05861",
                                "sense_id": "85f3a6f4-c7d3-370e-8a97-13bf226b291c",
                                "text": "De 2 000 à 6 000-6 500 m. s'étend la zone abyssopélagique, caractérisée par le fait que l'essentiel de la biomasse n'y est plus représenté par les copépodes, mais par les chétognathes, les mysidacées et les décapodes; …"
                            },
                            {
                                "example_id": "4230f06a-54b8-4a85-9f61-2c7fa609637d",
                                "sense_id": "85f3a6f4-c7d3-370e-8a97-13bf226b291c",
                                "text": "Abyssopélagique (entre 4 000 et 6000 m) - Aucune lumière quelle qu'elle soit ne pénètre à cette profondeur. La plupart des êtres vivants sont aveugles et albinos. Le nom vient du grec άβυσσος (abyssos), « abysse », signifiant « sans fond » (dans les temps anciens, on croyait que l'océan était sans fond)."
                            }
                        ]
                    },
                    {
                        "sense_id": "86907ee1-e1f1-3da0-b5fc-06a85e52135d",
                        "entry_id": "1d273e90-1ddf-3587-a568-df43f2a2fd0d",
                        "glosses": [
                            "Qui vit dans la mer ou les océans, entre 4000 mètres sous la surface et la croûte océanique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f19c0fa3-bac8-4c56-a42a-635f119e31e5",
                        "source_entry_id": "1d273e90-1ddf-3587-a568-df43f2a2fd0d",
                        "target_lang_word": "abyssopelagisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abyssopelagisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                        "entry_id": "0363a2d6-7031-3f65-925c-ec57acf0514b",
                                        "glosses": [
                                            "das Abyssopelagial betreffend, zu ihm gehörig"
                                        ],
                                        "tags": [
                                            "Biogeographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a37c6610-77ca-42c1-95b6-1a8985fe90e0",
                                                "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                                "text": "Sie finden sich in unseren Meeren in den polaren Gewässern pelagisch, in den südlichen und äquatorialen abyssopelagisch."
                                            },
                                            {
                                                "example_id": "8b25c6c8-548d-4c5c-9b30-107f1ab608a9",
                                                "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                                "text": "In südlicheren und aequatorialen Breiten leben die Spirialiden nach Chun ¹) abyssopelagisch, während andere Gattungen sich an der Oberfläche oder in sehr verschiedenen Tiefen aufhalten."
                                            },
                                            {
                                                "example_id": "ed31226f-5656-4c91-bfc9-e964dbbb6c61",
                                                "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                                "text": "Bei einer Mindesttiefe von 2000 m kann diese Art vielleicht als abyssopelagisch bezeichnet werden."
                                            },
                                            {
                                                "example_id": "edbe3c36-9cbf-4f6b-8e90-ad975447c932",
                                                "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                                "text": "Die abyssopelagische oder untere Mitternachtschicht des Ozeans, 4.000 Meter tief bis knapp über den Meeresboden, und die hadopelagische Zone, die das Tiefenwasser in den Meeresgräben ist, sind unwirtliche Gegenden für Fische."
                                            },
                                            {
                                                "example_id": "bfe8b4fb-ef01-4326-bcd7-59e2edc68b55",
                                                "sense_id": "e10cd7f1-93b7-3485-abc1-68cef1468474",
                                                "text": "Das Gebiet, in dem die Laternenfische leben[,] es ist als abyssopelagische Zone bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
