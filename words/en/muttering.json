{
    "word_family": [
        "mutter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "975bf665-110e-3241-85a7-d473def8c191",
                    "sense_definition": "Words or sounds spoken in a low, unclear voice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to catch a few of his <w>mutterings</w> as he walked away.",
                            "target_lang_translations": {
                                "cs": "Podařilo se mi zachytit pár jeho <w>zamumlání</w>, když odcházel."
                            }
                        },
                        {
                            "text": "The angry <w>mutterings</w> from the crowd grew louder as the meeting continued.",
                            "target_lang_translations": {
                                "cs": "Naštvané <w>brumlání</w> davu sílilo, jak schůze pokračovala."
                            }
                        }
                    ],
                    "synonyms": [
                        "mumblage"
                    ],
                    "common_phrases": [
                        "angry mutterings",
                        "quiet mutterings"
                    ],
                    "target_lang_definitions": {
                        "cs": "Slova nebo zvuky pronesené tichým, nesrozumitelným hlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mumlání",
                                "target_lang_sense_clarification": "obecné označení pro nesrozumitelnou řeč"
                            },
                            {
                                "target_lang_word": "brumlání",
                                "target_lang_sense_clarification": "často vyjadřující nespokojenost nebo podráždění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b5a9897-5c7c-38c2-88dc-20183d0d3c99",
                    "sense_definition": "A vague or unconfirmed report or rumor.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were <w>mutterings</w> about a possible change in company leadership.",
                            "target_lang_translations": {
                                "cs": "Objevily se <w>řeči</w> o možné změně ve vedení společnosti."
                            }
                        },
                        {
                            "text": "Despite the official denial, <w>mutterings</w> of a scandal persisted throughout the office.",
                            "target_lang_translations": {
                                "cs": "Navzdory oficiálnímu popření se kanceláří stále šířily <w>šuškandy</w> o skandálu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nejasná nebo nepotvrzená zpráva či fáma."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šuškanda",
                                "target_lang_sense_clarification": "neoficiální šíření informací"
                            },
                            {
                                "target_lang_word": "řeči",
                                "target_lang_sense_clarification": "neformální, často spekulativní hovory"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "605db325-31d0-3796-86bf-94f53555a34a",
                    "sense_definition": "Present participle and gerund of <w>mutter</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>muttering</w> to himself while looking for his lost keys.",
                            "target_lang_translations": {
                                "cs": "Když hledal ztracené klíče, něco si pro sebe <w>mumlal</w>."
                            }
                        },
                        {
                            "text": "Stop <w>muttering</w> and speak clearly so everyone can hear your opinion.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>mumlat</w> a mluv jasně, aby všichni slyšeli tvůj názor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep muttering",
                        "start muttering"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa mumlat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mumlat",
                                "target_lang_sense_clarification": "mluvit nesrozumitelně nebo potichu"
                            },
                            {
                                "target_lang_word": "brumlat",
                                "target_lang_sense_clarification": "mluvit pod vousy, často nespokojeně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}