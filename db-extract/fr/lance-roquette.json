                        ],
                        "examples": [
                            {
                                "example_id": "916fde38-5fbc-4d64-89f5-45bdb46e0a24",
                                "sense_id": "62d198de-dab9-351d-954b-9e52e84c3240",
                                "text": "Une première livraison de 18 de ces lance-roquettes, qui seront montés sur les châssis polonais Jelcz, ainsi que leurs munitions, arrivera en Pologne en 2023."
                            },
                            {
                                "example_id": "b9442eb3-c9a2-4586-8184-51dc2deff9fb",
                                "sense_id": "62d198de-dab9-351d-954b-9e52e84c3240",
                                "text": "D’autres bombardements au lance-roquette multiple ont visé la région de Tcherniguiv dans le nord de l’Ukraine, tirés depuis le Bélarus voisin, un allié de Moscou."
                            }
                        ]
