                        "entry_id": "8b86ef25-0c6e-3c6d-af6f-fa03b6cf757e",
                        "glosses": [
                            "karretje dat naast een motorfiets bevestigd is voor het vervoer van een passagier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9eb924c-0497-4fe4-9fff-0acfee192eb0",
                                "sense_id": "dbed6cae-d9c9-3914-84b4-ebca45bdf0c2",
                                "text": "Hij reed een motor met zijspan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "005b25b9-962d-4430-9d69-ed0f3f8ef711",
                        "source_entry_id": "8b86ef25-0c6e-3c6d-af6f-fa03b6cf757e",
                        "source_sense_id": "dbed6cae-d9c9-3914-84b4-ebca45bdf0c2",
                        "source_sense_description": "karretje dat naast een motorfiets bevestigd is voor het vervoer van een passagier",
                        "target_lang_word": "Beiwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beiwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                        "entry_id": "3a3699d5-fe3b-3f6f-b4ab-1497290326d5",
                                        "glosses": [
                                            "kleines Fahrzeug, das seitlich an einem Motorrad angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6e5ea7-c83b-4737-933b-a780436de0c8",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "Motorräder mit Beiwagen sieht man heute weniger oft als vor Jahrzehnten."
                                            },
                                            {
                                                "example_id": "53b3eb38-2fd5-4b61-b5b5-d8b27bac59a2",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Ich ging nach vorn und kuckte aus dem Fenster, da stand ein Motorrad mit Beiwagen, ein Russe darauf.“"
                                            },
                                            {
                                                "example_id": "19f26aa2-2d52-4b7c-b02d-21bdb43d0683",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Es ist ein Motorradfahrer mit Beiwagen, der von einer kurzen Fahrt mit seiner Frau nach Haus kommt.“"
                                            },
                                            {
                                                "example_id": "176af4ca-77a8-48fe-8a2c-31707de78ef4",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Stattdessen versperrte eine olivgrüne Harley-Davidson den Eingang, sodass man über den Beiwagen klettern musste.“"
                                            },
                                            {
                                                "example_id": "36837240-28a3-4ab1-a084-26e8f28f7e55",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Heute leben Rachel, Simon und ihr gemeinsamer Sohn Patrick friedlich in Rachels Heimatstadt Nantes, und das Transportmittel der Familie ist – wie kann es anders sein – ein Motorrad mit Beiwagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9be87a3e-22bb-3d6b-87a7-33168269a0aa",
                                        "entry_id": "3a3699d5-fe3b-3f6f-b4ab-1497290326d5",
                                        "glosses": [
                                            "Wagen ohne eigenen Antrieb (Anhänger) bei Schienenfahrzeugen (Straßenbahn, U-Bahn)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a717780e-649d-4ace-8ab0-3f0832369f22",
                                                "sense_id": "9be87a3e-22bb-3d6b-87a7-33168269a0aa",
                                                "text": "„Im September 1899 standen für das 15,5 km lange Streckennetz 26 Trieb- und 20 Beiwagen zur Verfügung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
