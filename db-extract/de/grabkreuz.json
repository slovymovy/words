                        "examples": [
                            {
                                "example_id": "f701ab52-b516-4bad-9d81-ef14809bb205",
                                "sense_id": "60b29c2d-6a08-3b4d-b5d7-af9034945720",
                                "text": "„Der Direktor der »Großen Zivilisierungsgesellschaft« geht an Land und findet Kayerts aufgeknüpft am Grabkreuz seines Vorgängers.“"
                            },
                            {
                                "example_id": "930ee201-70ef-4144-8ac0-314c5d2cf7d9",
                                "sense_id": "60b29c2d-6a08-3b4d-b5d7-af9034945720",
                                "text": "„Sie lächelte, beugte sich vor, wischte den Vogelkot vom Grabkreuz ihrer Mutter, und es kam ein Name zum Vorschein: Aldís.“"
                            }
                        ],
