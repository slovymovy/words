                                                "example_id": "b28bca7c-ee13-4d4b-a87f-429ac0cdaecb",
                                                "sense_id": "13767afb-fa9c-36cd-a0b1-db17bbf0f8dc",
                                                "text": "My seat at the restaurant was uncomfortable."
                                            },
                                            {
                                                "example_id": "2b20e152-9934-4ecd-ad33-8a19ae9d36a8",
                                                "sense_id": "13767afb-fa9c-36cd-a0b1-db17bbf0f8dc",
                                                "text": "Don't you know my name?"
                                            },
