                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352fda4b-76f2-4505-b280-eea5c17a0715",
                                "sense_id": "5833b247-8254-3f3b-a2e1-e38565cca653",
                                "text": "„Unsere Kaffeetassen und Blechbecher klingen beim Anstoßen nicht gerade wie Kelche, und natürlich ist der Sekt viel zu warm.“"
                            },
                            {
                                "example_id": "a2503502-2d7e-4764-9785-9f5850975b63",
                                "sense_id": "5833b247-8254-3f3b-a2e1-e38565cca653",
                                "text": "„Seine Rede wurde durch Cook abgeschnitten, der in diesem Augenblick mit einem großen Blechbecher eines kühlenden, von Mrs. Lively selbst bereiteten Getränkes in der Tür erschien und ohne weitere Umstände zum Lager des Kranken schritt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
