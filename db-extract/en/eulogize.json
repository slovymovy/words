                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba84adcc-5ead-3ee6-bf83-b5e4fc8861b2",
                                        "entry_id": "1201e116-422f-3f55-afcb-2898bdeb1c4b",
                                        "glosses": [
                                            "jemanden oder etwas überschwänglich loben, dessen Größe bewundern/anerkennen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "685cfa07-dde8-4ecc-9a99-15b64eaea59b",
                                                "sense_id": "ba84adcc-5ead-3ee6-bf83-b5e4fc8861b2",
                                                "text": "Die ganze Stadt pries den edlen Ritter, der die Gefahr von den Einwohnern abgewandt hatte."
                                            },
                                            {
                                                "example_id": "94aee384-01cf-4abd-ae97-0aa34693a1c5",
                                                "sense_id": "ba84adcc-5ead-3ee6-bf83-b5e4fc8861b2",
                                                "text": "500 Hersteller aus aller Welt priesen Hochleistungs-Flugzeuge, Kameras, Sensoren, Turbinen, Antennen, Kunststoffe, aber so fasziniert sie sich von ihrer Ware zeigten, so irritiert waren sie auch darüber, dass viele Leute da draußen noch nicht überzeugt seien."
                                            },
                                            {
                                                "example_id": "c4cd20e0-f637-44b4-9987-848594c37887",
                                                "sense_id": "ba84adcc-5ead-3ee6-bf83-b5e4fc8861b2",
                                                "text": "Es klang wie ein tolles Geschäft: Investmentbanken priesen italienischen Städten riskante Zinswetten an, die den klammen Kommunen niedrigere Zinsen bringen sollten."
                                            },
                                            {
                                                "example_id": "7e1671b2-b81a-49b8-83d7-fc1bc2e6d9b2",
                                                "sense_id": "ba84adcc-5ead-3ee6-bf83-b5e4fc8861b2",
                                                "text": "„Der international viel übersetzte Urdu-Dichter Ghalib (1797-1869) pries den Wein und die Schönheit der Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
