                                        "sense_id": "c872e86c-26f5-32ca-bfae-f7beef53f9da",
                                        "entry_id": "26e97881-4c39-36d7-abc6-ec6261f80c3f",
                                        "glosses": [
                                            "Personenkreis, der den Faschismus ablehnt, im engeren Sinn häufig als organisierte Gruppe beziehungsweise Gruppen verstanden"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ede116a-9c52-427b-b862-796a724b2ae7",
                                                "sense_id": "c872e86c-26f5-32ca-bfae-f7beef53f9da",
                                                "text": "„US-Präsident Donald Trump kündigte zudem an, ‚die Antifa‘ als terroristische Organisation verbieten lassen zu wollen.“"
                                            },
                                            {
                                                "example_id": "0c40f8b0-6d1e-48ad-b737-b5e0033b38e1",
                                                "sense_id": "c872e86c-26f5-32ca-bfae-f7beef53f9da",
                                                "text": "„Trumps Ankündigung, die Antifa als Terrororganisation einzustufen, ist absurd, sagen Experten. Die Antifa ist keine eigene Organisation - und zusätzlich gibt es rechtliche Hürden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
