                "senses": [
                    {
                        "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                        "entry_id": "98c3de36-6ab8-3534-bb1b-acc25f19b3aa",
                        "glosses": [
                            "Fahrzeug zum Transport von Intensivpatienten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1046712e-99eb-4b1a-abbb-1aba8696d928",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„Für den Transport der meist beatmeten Intensivpatienten stehen Intensivtransportwagen (ITW) in Ulm, Konstanz, Stuttgart, Mannheim, Freiburg, Ludwigsburg und bei Engpässen auch Rettungswagen bereit.“"
                            },
                            {
                                "example_id": "3e9c2db0-4237-4b5c-8e11-f8b545045a8d",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„Seit 2012 ist zudem auch ein Intensivtransportwagen für Krankenhaus-Verlegungen von Patienten, die einer intensivmedizinischen Versorgung bedürfen, genormt.“"
                            },
                            {
                                "example_id": "80129adf-2130-49e4-9a0f-b6ba94410074",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„Die Bestimmung setzt Blutgasanalysegeräte voraus, die in der Klinik und auf Intensivtransportwagen vorgehalten werden, auf den anderen präklinischen Rettungsmitteln aber üblicherweise nicht.“"
                            },
                            {
                                "example_id": "72f8e581-e521-4d25-b24f-145e1a37b4fc",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„Die Fahrzeuge sind mindestens wie Rettungswagen ausgestattet, darüber hinaus aber oft auch als Intensivtransportwagen (ITW) eingesetzt, sodass extra Monitore, Spritzenpumpen, Befestigungsschienen, etc. vorhanden sind.“"
                            },
                            {
                                "example_id": "e4c01d2d-5dce-4372-bb79-8552839795a0",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„Acht Rettungswagen und ein Intensivtransportwagen sollen im Rahmen des Test-Projektes mit den auffälligen QR-Codes ausgestattet werden.“"
                            },
                            {
                                "example_id": "a368c537-2a80-41de-a66d-0c3be32b6cf2",
                                "sense_id": "f904d68c-144d-32e5-a61c-23c3f8d6467c",
                                "text": "„In einem speziellen Intensivtransportwagen der Bundeswehr wurde Nawalny mit einer Polizeieskorte in die Charité nahe dem Berliner Hauptbahnhof gebracht, wo er kurz nach zehn Uhr am Vormittag eintraf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
