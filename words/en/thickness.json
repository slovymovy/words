            "senses": [
                {
                    "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                    "sense_definition": "The dimension or measurement of how thick something is between opposite surfaces.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thickness</w> of the Earth's crust varies from two to 70 kilometres.",
                            "target_lang_translations": {
                                "ru": "<w>Толщина</w> земной коры варьируется от двух до 70 километров."
                            }
                        },
                        {
                            "text": "These guitar picks come in different <w>thicknesses</w> to suit every player's style.",
                            "target_lang_translations": {
                                "ru": "Эти гитарные медиаторы бывают разной <w>толщины</w>, чтобы соответствовать стилю любого игрока."
                            }
                        }
                    ],
                    "synonyms": [
                        "depth"
                    ],
                    "common_phrases": [
                        "varying thickness",
                        "uniform thickness",
                        "wall thickness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размер или измерение того, насколько толстым является предмет между противоположными поверхностями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толщина",
                                "target_lang_sense_clarification": "физический размер"
                            }
                        ]
