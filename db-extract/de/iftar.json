                                        "entry_id": "89c80c4f-60d4-3021-9127-93388cb15409",
                                        "glosses": [
                                            "The evening meal (of dates) that breaks each day's fast during Ramadan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aecaec4a-a108-48fa-b39d-aff9ae314aa3",
                                                "sense_id": "ac50b27c-8b25-3d7e-8f12-d2c2c74dd93b",
                                                "text": "Iftars can be social events, where people congregate to eat and socialize."
                                            },
                                            {
                                                "example_id": "b01bfe02-6c32-46a9-a424-13c758994547",
                                                "sense_id": "ac50b27c-8b25-3d7e-8f12-d2c2c74dd93b",
                                                "text": "On a recent afternoon in the Tunisian coastal city of Sfax, as shoppers hurried around a market buying food and drink for that evening’s iftar meal, a small group of men from sub-Saharan Africa gathered near a stall selling phone accessories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
