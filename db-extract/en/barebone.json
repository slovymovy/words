                "forms": [],
                "senses": [
                    {
                        "sense_id": "7618318f-deb5-3e0c-8f5a-6ed491ef755d",
                        "entry_id": "7d260213-6d86-355b-907b-3a8d18f62390",
                        "glosses": [
                            "sehr magerer Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636224cb-ec9e-49cc-acf4-53d7ea14c420",
                                "sense_id": "7618318f-deb5-3e0c-8f5a-6ed491ef755d",
                                "text": "My sister's youngest son is a barebone.",
                                "translation": "Der jüngste Sohn meiner Schwester ist ein sehr magerer Mensch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dc910ab-9813-4693-b169-b5ac3d38bd17",
                        "source_entry_id": "7d260213-6d86-355b-907b-3a8d18f62390",
                        "source_sense_id": "7618318f-deb5-3e0c-8f5a-6ed491ef755d",
                        "source_sense_description": "sehr magerer Mensch",
                        "target_lang_word": "Mensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                        "entry_id": "e2595e24-5b40-398d-b51a-eb3674ba3ef6",
                                        "glosses": [
                                            "Lebewesen; Spezies, der Klasse der Säugetiere angehörend, die sich durch folgende besondere Eigenschaften auszeichnet: aufrechter Gang, Sprache, Erfindertum, Vorausdenken und Nachahmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8b5dbd-e681-4a68-8edb-92fe0725817a",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "\"Was für ein grobes Tier ist der Mensch! Alles / was die Natur gutes tut entstellt er, / sie macht eine Sache einfach und rein / und er mit seinen Händen wandelt sie um.\" (Original vec: \"Gran bestia che xe l’omo! Lu defforma / tutto quel che de ben fa la natura, / ella una cossa fa semplice, e pura, / e lu colle so man el la trasforma.\")"
                                            },
                                            {
                                                "example_id": "23d5b5bd-bf39-41f5-996f-d1e5e90d1c86",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "„Beim Stierkampf (Corrida), dem in südlichen Ländern häufig noch Kultcharakter zukommt und der dort als hohe Kunst betrieben wird, stehen sich Mensch und Tier in einem gefährlichen Zweikampf gegenüber.“"
                                            },
                                            {
                                                "example_id": "2bdce5f7-547a-47da-ac5c-dd3058e3c742",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "„Daß Mensch und Natur sehr wohl miteinander auskommen können, haben die sächsischen Freikletterer seit über 130 Jahren bewiesen.“"
                                            },
                                            {
                                                "example_id": "cb1e9530-ce48-433e-a949-800aceddf088",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "Der Unterschied zwischen Gorilla und Mensch beträgt gerade mal drei Prozent ihres Erbguts."
                                            },
                                            {
                                                "example_id": "fe15afff-f9ba-4438-861f-6441155b77ab",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "„Die modernen Menschen entwickelten in der oberen Altsteinzeit mehrere aufeinanderfolgende Kulturen.“"
                                            },
                                            {
                                                "example_id": "d13fe64a-cfac-4b28-a0ff-7d25cb7d3e9f",
                                                "sense_id": "b884dde1-7a6b-3ab6-90d2-586b4cfb9096",
                                                "text": "„Der Mensch ist frei, und keiner sollte mehr in Ketten geboren werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                        "entry_id": "e2595e24-5b40-398d-b51a-eb3674ba3ef6",
                                        "glosses": [
                                            "[1] als einzelnes Individuum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4874de9d-a712-45d2-9b7c-4891af4051a9",
                                                "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                                "text": "Das glaubt mir kein Mensch!"
                                            },
                                            {
                                                "example_id": "fe699918-eba9-46fe-a6f2-fac8c2b6cab4",
                                                "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                                "text": "Die UN warnen vor einer Hungersnot im Bürgerkriegsland Südsudan. Mehr als eine Million Menschen sind auf der Flucht und konnten ihre Felder nicht bestellen."
                                            },
                                            {
                                                "example_id": "fe8b2717-66ae-48c2-a590-10cc9e158bb7",
                                                "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "f5aad7a4-a47a-4417-b5be-2bcd74dcac08",
                                                "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                                "text": "„Es kam ihm vor, als reisten in der U-Bahn genauso viele Menschen wie Pudel.“"
                                            },
                                            {
                                                "example_id": "1f76eab0-8bf9-4b75-a139-0c54a11751dd",
                                                "sense_id": "276f74a0-3f76-3cae-bec3-ff3e8f648f72",
                                                "text": "„Wohl waren noch Menschen in der Stadt, wohl war etwa ein Fünfzigstel der früheren Einwohnerzahl noch da, aber die Stadt war verödet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e1d93a6-5d7e-33f0-9b5a-25e42cff34e4",
                                        "entry_id": "9df9008e-dc83-3c70-b7f6-52c5780dc276",
                                        "glosses": [
                                            "junge Frau, Magd oder Jungfrau"
                                        ],
