                                ]
                            },
                            {
                                "target_word": "réfugié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba34bb46-9b36-3cdd-9a69-ebf1767fda8d",
                                        "entry_id": "0fe729d1-e33a-3a5d-895a-c9f4e6603273",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe réfugier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7cfe2c-ca54-4390-8ce4-49a18c2652e1",
                                                "sense_id": "ba34bb46-9b36-3cdd-9a69-ebf1767fda8d",
                                                "text": "Il a passé les premières nuits de la guerre réfugié au sous-sol avec Larissa, sa collègue et voisine."
                                            }
