                                        "entry_id": "85348725-a329-33aa-bdc0-1fea842742a0",
                                        "glosses": [
                                            "Celle qui est chargée d’enseigner aux autres."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ca8013-3802-4c89-aeba-cafec77edc52",
                                                "sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                                                "text": "On peut remarquer, à ce sujet, que la voix féminine de l’enseignante est généralement considérée comme moins « efficace » que la voix masculine parce que porteuse de moins de « puissance virile »."
                                            },
                                            {
                                                "example_id": "0a7dabd0-60bc-4623-894a-50a67b4d170a",
                                                "sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                                                "text": "Les enseignantes ont également participé à ces remises."
                                            }
                                        ]
                                    }
                                ]
                            },
