                ],
                "senses": [
                    {
                        "sense_id": "94db925c-2631-3b9d-a634-4226fab35d25",
                        "entry_id": "1d12be0f-1c30-394e-b4a0-6a196421b641",
                        "glosses": [
                            "разг. покрываться нагаром — веществом, образующимся при горении свечи, фитиля и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51fa835-64a4-48d5-b3e7-5acbd6f6e87a",
                                "sense_id": "94db925c-2631-3b9d-a634-4226fab35d25",
                                "text": "Свеча нагорала тускло, свет трепетал на стенах…"
                            },
                            {
                                "example_id": "1f15ca4d-9d78-4361-b19c-2b67c504a38b",
                                "sense_id": "94db925c-2631-3b9d-a634-4226fab35d25",
                                "text": "Вон сколько нагорело золы, уже черной, закаменевшей, ― не с одной ночевкой сидел тут человек."
                            }
                        ]
                    },
                    {
                        "sense_id": "66aec3d7-3819-3468-a9ca-e8a8cf68c59c",
                        "entry_id": "1d12be0f-1c30-394e-b4a0-6a196421b641",
                        "glosses": [
                            "разг., безл. расходоваться в каком-либо (обычно большом) количестве (об электроэнергии)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ae702a2-ef64-4abd-aa3f-4f3cb4da6c29",
                                "sense_id": "66aec3d7-3819-3468-a9ca-e8a8cf68c59c",
                                "text": "Днем не включают свет в туалете, чтобы поменьше нагорало электричества."
                            },
                            {
                                "example_id": "ad097525-63da-4d90-9d3a-94e9a5556f93",
                                "sense_id": "66aec3d7-3819-3468-a9ca-e8a8cf68c59c",
                                "text": "В её времянке стоит счётчик, на котором нагорело два киловатт-часа."
                            }
                        ]
                    },
                    {
                        "sense_id": "3371334e-6abc-3aae-a6ea-a4d1c29452b3",
                        "entry_id": "1d12be0f-1c30-394e-b4a0-6a196421b641",
                        "glosses": [
                            "разг. доставаться за что-либо (о наказании, выговоре и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c800aa3-64b0-43b0-bb68-114e74e32859",
                                "sense_id": "3371334e-6abc-3aae-a6ea-a4d1c29452b3",
                                "text": "Вчера они до десяти часов вечера гуляли в саду, и Тане нагорело от мамы."
                            }
                        ]
                    }
                ],
