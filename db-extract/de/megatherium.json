                "senses": [
                    {
                        "sense_id": "895c9d6f-22cf-3db2-a6c3-d2fa61c82deb",
                        "entry_id": "eb8daced-1a15-3200-80b1-45b7c36b501a",
                        "glosses": [
                            "ausgestorbenes Riesenfaultier aus der Familie der Megatheriidae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85238525-d674-4edd-bf5e-57b2ddcfb3a0",
                                "sense_id": "895c9d6f-22cf-3db2-a6c3-d2fa61c82deb",
                                "text": "Megatherium war ein elefantengroßes, eiszeitliches Riesenfaultier Südamerikas."
                            },
                            {
                                "example_id": "65f1480f-1161-4a03-935c-6639ebfe3662",
                                "sense_id": "895c9d6f-22cf-3db2-a6c3-d2fa61c82deb",
                                "text": "Als weitgehender Pflanzenfresser ernährte sich Megatherium von hauptsächlich weicher Pflanzenkost."
                            },
                            {
                                "example_id": "b4f21cbd-f179-46ae-81ba-e980dc2c796a",
                                "sense_id": "895c9d6f-22cf-3db2-a6c3-d2fa61c82deb",
                                "text": "Erst ganz am Ende des Pleistozän starb Megatherium wie etliche andere Großtierarten Amerikas aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
