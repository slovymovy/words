                    "target_lang_definitions": {
                        "ru": "Лгать, преувеличивать или вводить кого-то в заблуждение.",
                        "zh": "说谎、夸大其词，或故意误导别人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пизде́ть",
                                "target_lang_sense_clarification": "грубо лгать или обманывать"
                            },
