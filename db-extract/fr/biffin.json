        "fr-extract.jsonl": [
            {
                "entry_id": "13cb9d8a-0b56-36f7-b276-be7bbc5e1cee",
                "word": "biffin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f39c9c5b-42ab-4d91-8fd7-f1187e69da1b",
                        "entry_id": "13cb9d8a-0b56-36f7-b276-be7bbc5e1cee",
                        "tags": [
                            "plural"
                        ],
                        "form": "biffins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9cd922dc-5cb5-36e4-83a2-dfafb93bf764",
                        "entry_id": "13cb9d8a-0b56-36f7-b276-be7bbc5e1cee",
                        "glosses": [
                            "Chiffonnier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4c2dc0-d54a-4359-b6b2-36daa739e85d",
                                "sense_id": "9cd922dc-5cb5-36e4-83a2-dfafb93bf764",
                                "text": "— C’est un ancien biffin qui a gagné gros dans le chiffon, qu’il n’a quitté que quand il s’est fait écraser un bras, parce qu’un seul bras n’est pas commode pour courir les poubelles."
                            },
                            {
                                "example_id": "fd02239f-76c8-4b1b-88b8-3a4d941d4845",
                                "sense_id": "9cd922dc-5cb5-36e4-83a2-dfafb93bf764",
                                "text": "Les deux édiles demandent davantage d’effectifs policiers en vue de dissuader les biffins du haut de la rue du Faubourg-du-Temple […]."
                            },
                            {
                                "example_id": "d1e52afc-4cdb-4ede-8fca-22123277ffb6",
                                "sense_id": "9cd922dc-5cb5-36e4-83a2-dfafb93bf764",
                                "text": "Chaque quartier avait sa spécialité, il y avait les chiffonniers de Clignancourt et les biffins de Saint-Ouen, les boumians de Levallois et les rempailleurs d’Ivry, les ramasseurs de rats, qui revendaient les bestioles aux laboratoires des quais de Seine pour leurs expériences."
                            }
                        ]
                    },
                    {
                        "sense_id": "9de99d04-a563-37b9-a722-b4baa36a0a47",
                        "entry_id": "13cb9d8a-0b56-36f7-b276-be7bbc5e1cee",
                        "glosses": [
                            "Personne en situation de précarité qui cherche de petits objets et matériaux usagés, puis les revend pour augmenter ses faibles revenus."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "225d40b5-66ab-4617-b9fd-d010879a4897",
                                "sense_id": "9de99d04-a563-37b9-a722-b4baa36a0a47",
                                "text": "La voie qui mène aux puces de Saint-Ouen a accueilli pendant des années un marché clandestin rassemblant jusqu’à 400 à 500 biffins."
                            }
                        ]
                    },
                    {
                        "sense_id": "33f055da-16f4-3c06-a25d-d703e93a283c",
                        "entry_id": "13cb9d8a-0b56-36f7-b276-be7bbc5e1cee",
                        "glosses": [
                            "Fantassin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9bad3565-fcd3-4f40-9435-163f8f9bf74f",
                                "sense_id": "33f055da-16f4-3c06-a25d-d703e93a283c",
                                "text": "L’appellation est née au XIXᵉ siècle quand marins, marsouins et bigors, fiers de leur tenue impeccable (dont ils étaient propriétaires), reprochaient aux soldats de l’armée de terre d’être habillés comme des chiffonniers (biffins en argot)."
                            },
                            {
                                "example_id": "a9cce3d0-18e5-4a29-b464-79cf19d0777c",
                                "sense_id": "33f055da-16f4-3c06-a25d-d703e93a283c",
                                "text": "Maillat entendit un bruit de roues sur les pavés, et au même instant, un petit charreton, poussé par un biffin, débouchait sur sa droite."
                            },
                            {
                                "example_id": "84775096-1c08-4092-b325-3b2145290a13",
                                "sense_id": "33f055da-16f4-3c06-a25d-d703e93a283c",
                                "text": "— C’t’un mec qui m’a tossé. Un grand con de sergent biffin qui voulait m’faucher mon pinard… Le fumier !"
                            },
                            {
                                "example_id": "0fbbf143-4616-4bf8-a5b8-1cc89896fbb4",
                                "sense_id": "33f055da-16f4-3c06-a25d-d703e93a283c",
                                "text": "Je sais qu’hier et avant-hier « Dominique » fut le théâtre d’effroyables carnages. Comment le biffin fait-il pour tenir au milieu d’une boucherie pareille ?"
                            }
                        ]
                    }
                ],
