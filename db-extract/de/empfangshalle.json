                                    },
                                    {
                                        "sense_id": "332d2b67-a7a8-3483-a4b9-2acadbe7dfdd",
                                        "entry_id": "e583a426-dd78-338e-a699-e1e755b900ab",
                                        "glosses": [
                                            "A confined place for cattle, formed by hedges, trees, or other fencing, near the farmyard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76e9bfc-2fd9-4fae-ae2a-215896dca00d",
