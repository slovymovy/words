                        "examples": [
                            {
                                "example_id": "9b993b32-3169-4465-8bfa-c6346490a221",
                                "sense_id": "0a2c0d0f-5925-3353-a39d-f9a3fc0f3929",
                                "text": "Jullie hadden mijn rugzak gedragen, mijn waterflesjes gevuld, mij de beste kamer gegeven, de hele tijd gevraagd of het wel met me ging."
                            },
                            {
                                "example_id": "a92264d1-f495-489a-a66e-ee98aad0eef8",
                                "sense_id": "0a2c0d0f-5925-3353-a39d-f9a3fc0f3929",
                                "text": "Dat ze haar halve rugzak heeft gevuld met pillen en poeders."
                            },
                            {
                                "example_id": "35ca5d79-88d9-4891-9179-c2f15b8d8484",
                                "sense_id": "0a2c0d0f-5925-3353-a39d-f9a3fc0f3929",
                                "text": "Mijn rugzak was gevuld met eten voor negen dagen en de zon was weer even heet als altijd."
                            }
                        ]
                    }
                ],
