            {
                "entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                "word": "généreusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "530f92c9-c267-36b2-b53b-d0481ccf81bc",
                        "entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                        "glosses": [
                            "D’une manière généreuse, avec un grand cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26ef762-6c6d-4747-802a-1aa344c4bb3d",
                                "sense_id": "530f92c9-c267-36b2-b53b-d0481ccf81bc",
                                "text": "Je crois qu’il n'agit point moins généreusement."
                            },
                            {
                                "example_id": "68e61036-937d-4bcd-84a4-5972b23bb75f",
                                "sense_id": "530f92c9-c267-36b2-b53b-d0481ccf81bc",
                                "text": "Secourons l’innocence et généreusement."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bcefc74-fd09-3698-b060-3649be03cc93",
                        "entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                        "glosses": [
                            "D’une main libérale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6850e4-7699-4391-9aaa-c201a5754dac",
                                "sense_id": "8bcefc74-fd09-3698-b060-3649be03cc93",
                                "text": "Payer généreusement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fb6e2bc-7b51-3986-b6f7-ea41cdb536f7",
                        "entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                        "glosses": [
                            "En abondance."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "33377518-68ff-4562-87ad-5a94e19383c5",
                                "sense_id": "9fb6e2bc-7b51-3986-b6f7-ea41cdb536f7",
                                "text": "Alors que tant de théories, d'arts poétiques et de métaphysiques ont été généreusement formulés à l'égard de cet art, il était peut-être nécessaire que l'on avançât, pour commencer, quelques arguments d'artisan."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e924024-9050-30f1-bc2f-bc0bda7e0e90",
                        "entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                        "glosses": [
                            "Courageusement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5314f5-e82e-4a7a-920d-0757ca7d7354",
                                "sense_id": "8e924024-9050-30f1-bc2f-bc0bda7e0e90",
                                "text": "Répandre généreusement son sang pour la patrie."
                            },
                            {
                                "example_id": "ff7f5b84-cc57-4b06-b99b-f91f853e2274",
                                "sense_id": "8e924024-9050-30f1-bc2f-bc0bda7e0e90",
                                "text": "Vous avez généreusement souffert d’autres atteintes que celles-ci."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8e31deb-284b-42bd-b674-507984a8a6a2",
                        "source_entry_id": "325f5b6b-1ee8-3b1b-8881-7c0acb4f2100",
                        "target_lang_word": "generously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                        "entry_id": "48cf476d-9bd1-3a76-977b-c2dc9f549f37",
                                        "glosses": [
                                            "In a generous manner, in a way that is giving or ample."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5fd2737-a528-4c2a-97bb-5850e0dbad53",
                                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                                "text": "The dessert generously filled a large plate."
                                            },
                                            {
                                                "example_id": "e5cf68b2-5a18-4273-a3b7-a4c1834f99dd",
                                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                                "text": "He generously donated what little he could."
                                            },
                                            {
                                                "example_id": "c3cacb83-728a-4f17-a6db-7e9964b911bd",
                                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                                "text": "Consequently, to brighten up a shady spot in the front garden we have recently added ‘Harlequin’, its green foliage splashed generously with white, though hopefully not to be splashed generously with a multicolour yawn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
