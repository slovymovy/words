                "senses": [
                    {
                        "sense_id": "a70a5890-6dce-3d31-b351-b392ef079d53",
                        "entry_id": "aeaf8231-e64f-3f4a-9108-94775bed7665",
                        "glosses": [
                            "Fachfrau beziehungsweise Wissenschaftlerin auf dem Gebiet der Ägyptologie, der Erforschung des Alten Ägyptens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db5f72e-4714-4420-8d09-ae63b1ad578b",
                                "sense_id": "a70a5890-6dce-3d31-b351-b392ef079d53",
                                "text": "Als Ägyptologin hatte sie sich schon früh einen Namen gemacht."
                            },
                            {
                                "example_id": "035568b6-111e-42b3-a8aa-4fac6d75526a",
                                "sense_id": "a70a5890-6dce-3d31-b351-b392ef079d53",
                                "text": "„Brian Morris führte die Versuche, die Kontinuität von Hexerei durch die Zeiten zu plausibilisieren, auf die Ägyptologin Margaret Murray zurück, die die These aufgestellt hatte, dass es sich bei Hexerei um einen vorchristlichen, paganen Fruchtbarkeitskult handelte, der die Göttin Diana verehrte und in erster Linie in der bäuerlichen Bevölkerung praktiziert wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76fab441-d27d-4c0a-a606-0fc470dfeb25",
                        "source_entry_id": "aeaf8231-e64f-3f4a-9108-94775bed7665",
                        "source_sense_id": "a70a5890-6dce-3d31-b351-b392ef079d53",
                        "target_lang_word": "Egyptologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Egyptologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc57d2c7-40ba-3693-919d-a4efba47287f",
                                        "entry_id": "d123b27e-0232-3cb2-9196-cd5b6b0c351c",
                                        "glosses": [
                                            "A person; one who is skilled in or professes or practices Egyptology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2adf24d5-2592-4e82-96dc-0403d5704b97",
                                                "sense_id": "fc57d2c7-40ba-3693-919d-a4efba47287f",
                                                "text": "An Egyptologist's mind immediately turns to the ancient Egyptian counterpart to such an imagined protosactuary: a reed hut that all late Egyptian temples, in their archaizing longing to return to the origins, sought to emulate in stone through the typically Egyptian temple features of inward-sloping walls, torus and corvetto cornice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9111a8c5-dc69-401d-9b1b-caf551ddf5b2",
                        "source_entry_id": "aeaf8231-e64f-3f4a-9108-94775bed7665",
                        "source_sense_id": "a70a5890-6dce-3d31-b351-b392ef079d53",
                        "target_lang_word": "égyptologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égyptologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                        "entry_id": "5c266a2a-78b9-3b3a-bb46-10b07d85a798",
                                        "glosses": [
                                            "Archéologue spécialisé en égyptologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05cb8b0-df76-4614-a56d-181b9b606f8d",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Dominique Farout, égyptologue et commissaire français de la rétrospective de 2023, y était."
                                            },
                                            {
                                                "example_id": "a2a0d82a-c8bd-4267-b7c4-b0f8c4bfadd5",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Je vais ajouter ici quelques autres considérations de l’égyptologue français relatives à ces éléments."
                                            },
                                            {
                                                "example_id": "b7863d93-4026-480f-aaa5-88110d5bc0f6",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Selon l’égyptologue biomédicale Sofia Aziz, le souverain égyptien aurait perdu la vie dans un accident de char dû à une conduite sous l’emprise de l’alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
