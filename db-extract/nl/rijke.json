                    {
                        "sense_id": "327f055a-3d50-3b21-bafa-76d085b4f742",
                        "entry_id": "a867beab-1e0e-3f4a-84b8-e21b6b20bd7b",
                        "glosses": [
                            "verbogen vorm van de stellende trap van rijk"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fbc5da73-1ef3-4d86-bb06-61534f3b1f5f",
                                "sense_id": "327f055a-3d50-3b21-bafa-76d085b4f742",
                                "text": "Als ik de volle maan zie sla ik vreemd genoeg altijd een kruis, kus mijn duim en wijs naar de maan als gebaar van dankbaarheid voor de rijke ervaringen in mijn leven en de mensen om mij heen."
                            },
                            {
                                "example_id": "28dd9d66-4c93-429d-a922-ff161157fc7f",
                                "sense_id": "327f055a-3d50-3b21-bafa-76d085b4f742",
                                "text": "Deze waren weer geïnspireerd door de talloze standbeelden en atletische representaties (bijvoorbeeld op Griekse vazen) die oudheidkundigen en handelaars in groten getale vanuit Italië en Griekenland verscheepten naar de verzamelingen van vorsten en rijke Europeanen."
                            },
                            {
                                "example_id": "238265b6-eb21-4ec7-97d0-35def5e6727a",
                                "sense_id": "327f055a-3d50-3b21-bafa-76d085b4f742",
                                "text": "De belangrijkste naam in dit opzicht is die van Evangelis Zappas (1800-1865), een rijke zakenman die geboren was in het huidige Albanië en werkzaam in Constanza, in het huidige Roemenië."
                            }
                        ]
                    }
                ],
