        "fr-extract.jsonl": [
            {
                "entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
                "word": "suavité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "53e3769c-d08c-4270-806b-b4ba2390c056",
                        "entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
                        "tags": [
                            "plural"
                        ],
                        "form": "suavités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a5d6b1d-1980-3359-a7d1-a10165ce294c",
                        "entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
                        "glosses": [
                            "Qualité de ce qui est suave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb3f5c1-3e9f-4734-9d48-5dde25d56984",
                                "sense_id": "2a5d6b1d-1980-3359-a7d1-a10165ce294c",
                                "text": "Cette scène délicieuse, au milieu de ce magnifique paysage, y répandait une incroyable suavité."
                            },
                            {
                                "example_id": "2ff90a64-d28f-4e16-8d12-373ecf5b3e54",
                                "sense_id": "2a5d6b1d-1980-3359-a7d1-a10165ce294c",
                                "text": "Je m’accrochai à mon alibi, je protestai aussi qu’un artiste de ma suavité ne tuait pas à coups de marteau, ce qui ne fit qu’indisposer le magistrat instructeur."
                            },
                            {
                                "example_id": "576b84cf-9afa-4caf-ac0c-0370ec6445b7",
                                "sense_id": "2a5d6b1d-1980-3359-a7d1-a10165ce294c",
                                "text": "Oh, je n'ignore pas l’anéantissante suavité qu'il y a à effleurer une peau délicate sur une étendue sans bords, ce qu'offrent presque tous les corps de femmes et beaucoup plus rarement des corps d'hommes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "abf8b0e0-2bb0-37f5-9efa-d8fdeb1b3e2e",
                        "entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
                        "glosses": [
                            "Douceur qui se fait sentir à l’âme, quand Dieu la favorise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73da0777-f658-48ce-a186-0a5e79b356f0",
                                "sense_id": "abf8b0e0-2bb0-37f5-9efa-d8fdeb1b3e2e",
                                "text": "Et puis la nature agit de même : est-ce que pour le petit enfant qui repose dans son berceau et qui prend possession du monde avec son regard éclos de l’avant-veille, la vie n’est pas toute suavité, toute caresse ?"
                            },
                            {
                                "example_id": "1e33cd7e-94c4-4e14-9ce2-13abe25f17c9",
                                "sense_id": "abf8b0e0-2bb0-37f5-9efa-d8fdeb1b3e2e",
                                "text": "Sainte Thérèse éprouvait des suavités merveilleuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "291ab2cf-69ee-4944-ba44-d423034cd016",
                        "source_entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
                        "target_lang_word": "suavity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suavity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2fc942a-a32d-3407-9a3f-149ba7ef3107",
                                        "entry_id": "30a2bec8-e831-3ef7-8878-33ef717992cb",
                                        "glosses": [
                                            "The quality of being sweet or pleasing to the mind; agreeableness; pleasantness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86fc95e0-398c-4e45-820d-cbcc0a790c90",
                                                "sense_id": "e2fc942a-a32d-3407-9a3f-149ba7ef3107",
                                                "text": "suavity of manners"
                                            },
                                            {
                                                "example_id": "f69cb660-784f-4d4f-a7a5-dc0f9f188335",
                                                "sense_id": "e2fc942a-a32d-3407-9a3f-149ba7ef3107",
                                                "text": "suavity of language, conversation, or address"
                                            },
                                            {
                                                "example_id": "76aee77a-e88c-4d67-948b-a71673562b81",
                                                "sense_id": "e2fc942a-a32d-3407-9a3f-149ba7ef3107",
                                                "text": "[N]othing, not even the crude curves of the railway, can utterly deform the suavity of contour of one bay after another along the whole reach of the Riviera."
                                            },
                                            {
                                                "example_id": "49ea9f58-f118-467e-8dfc-488452cf137e",
                                                "sense_id": "e2fc942a-a32d-3407-9a3f-149ba7ef3107",
                                                "text": "[T]he brothers’ gowns and broad straw hats were hanging up, each with his religious name upon a board,—names full of legendary suavity and interest, such as Basil, Hilarion, Raphael, or Pacifique; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69280d5-d0cd-3616-84f2-8627cb65e9a5",
                                        "entry_id": "30a2bec8-e831-3ef7-8878-33ef717992cb",
                                        "glosses": [
                                            "The quality of being suave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c2d0d37-e281-4e40-ad93-11e4812a8918",
                                                "sense_id": "b69280d5-d0cd-3616-84f2-8627cb65e9a5",
                                                "text": "Macavity, Macavity, there’s no one like Macavity,\nThere never was a Cat of such deceitfulness and suavity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e369463-5227-3852-8537-5078df03847b",
                                        "entry_id": "30a2bec8-e831-3ef7-8878-33ef717992cb",
                                        "glosses": [
                                            "Sweetness or agreeableness to the senses, especially of taste and odour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9da4072b-1425-478e-a085-6f2b4e6c6aa2",
                                                "sense_id": "1e369463-5227-3852-8537-5078df03847b",
                                                "text": "Whan this ſayd monument diſcouered was / Suche a ſuauite and fragrant odoure / Aſcended from the corps by ſingular grace / Paſſyng all worldly ſwetnes and ſauour / That all there present that day and hour / Suppoſed they had ben / in the felicite / Of erthely paradiſe / without ambiguite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef4ec0ba-798a-4d9b-ba89-b37d8436f01a",
                        "source_entry_id": "9a739b5f-1255-3005-91f1-f5d0292fe8a4",
