                                                "sense_id": "a82985fc-4956-355f-ba04-b2c20d3c8439",
                                                "text": "Het was echt een wonder dat hij dat ongeluk overleefd heeft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca91a34-9f70-32c0-9c9c-a7cd2371c205",
                                        "entry_id": "beeea8eb-58b8-3e3c-a0d2-dd8d0dad6321",
                                        "glosses": [
                                            "een natuurlijke gebeurtenis die eigenlijk zo bijzonder is dat het wel een bovennatuurlijke oorsprong lijkt te hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13d916b-6731-45d9-9499-3a2c28efbd6d",
                                                "sense_id": "2ca91a34-9f70-32c0-9c9c-a7cd2371c205",
                                                "text": "Ik geloof in de kracht van de natuur, in het wonder van de seizoenen, en de elementen die continu in beweging zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33698d03-6054-3e56-aa21-ca6d52b08b66",
                                        "entry_id": "beeea8eb-58b8-3e3c-a0d2-dd8d0dad6321",
                                        "glosses": [
                                            "een natuurlijke handeling die een probleem wel heel goed weet op te lossen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32066607-3179-4c79-8bc6-40aa981c2d2d",
                                                "sense_id": "33698d03-6054-3e56-aa21-ca6d52b08b66",
                                                "text": "Gelukkig deden af en toe ’s avonds een jointje, minder werken, minder koffie en vlees en vaker hardlopen en zwemmen wonderen."
                                            }
                                        ]
                                    }
