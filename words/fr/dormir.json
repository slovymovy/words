                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants sont fatigués et vont bientôt <w>dormir</w>."
                        },
                        {
                            "text": "Je <w>dors</w> généralement huit heures par nuit pour être en forme."
                        }
                    ],
                    "synonyms": [
                        "sommeiller",
                        "roupiller",
                        "pioncer"
                    ],
                    "antonyms": [
                        "veiller"
                    ],
                    "common_phrases": [
                        "dormir à poings fermés",
                        "dormir debout",
                        "dormir sur ses deux oreilles"
                    ]
                },
                {
                    "sense_id": "af0f1dcc-a91e-3f25-b32c-bc51436ebe3f",
                    "sense_definition": "Être immobile, inactif ou ne manifester aucune animation.",
