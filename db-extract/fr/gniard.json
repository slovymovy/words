                "senses": [
                    {
                        "sense_id": "22133993-c2cd-3d4f-902b-674a7e98c987",
                        "entry_id": "5f76e2c3-787b-3f15-a72e-9b54fa020381",
                        "glosses": [
                            "puis Jeune enfant."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dd75b657-b13c-4a17-bdb5-a95d3c8344fb",
                                "sense_id": "22133993-c2cd-3d4f-902b-674a7e98c987",
                                "text": "Je me demande bien ce que je ferais si j'étais enceinte. Tu me vois avec un gniard ? Remarque, ma mère s'en occuperait. Jusqu'à mon retour du lycée."
                            },
                            {
                                "example_id": "9a320ca4-458b-4f66-aeb2-85a7165cd4e9",
                                "sense_id": "22133993-c2cd-3d4f-902b-674a7e98c987",
                                "text": "Amène-toi morveux : on est grands, merde aux gniards. Ça te travaille pas, la glande, momichon ? Ça va le faire. Ça vient, a pas peur."
                            },
                            {
                                "example_id": "9dbbb0f9-0dad-481f-969a-d0c7a30dce97",
                                "sense_id": "22133993-c2cd-3d4f-902b-674a7e98c987",
                                "text": "Aucune domestique ne voudra s'occuper d'un gniard en bas âge, et surtout pas à Chinatown au beau milieu d'une épidémie."
                            },
                            {
                                "example_id": "fcce9e99-67d7-4776-a6e2-65f7123598ab",
                                "sense_id": "22133993-c2cd-3d4f-902b-674a7e98c987",
                                "text": "Devant la porte, trois gniards se disputent à grands coups de pied un ballon crevé."
                            }
                        ]
                    }
                ],
