                        ]
                    },
                    {
                        "translation_id": "68a663f1-4baa-4592-bd38-eb99855c5b55",
                        "source_entry_id": "1cf7258a-4e4b-3b3f-abc0-7f0993908979",
                        "source_sense_id": "032a5f8f-82e8-3e71-8a20-07f1e92bc53f",
                        "target_lang_word": "attelage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attelage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78a07b0e-8014-39f8-a946-a5e793f533e5",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
                                            "Action d’atteler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28163e0-0134-406d-992a-196c9f4249a0",
                                                "sense_id": "78a07b0e-8014-39f8-a946-a5e793f533e5",
                                                "text": "L’attelage des bœufs ne se fait pas de la même façon que celui des chevaux."
                                            },
                                            {
                                                "example_id": "e3e7509f-5e93-4b1b-a048-3cc719163634",
                                                "sense_id": "78a07b0e-8014-39f8-a946-a5e793f533e5",
                                                "text": "L’attelage des wagons de chemin de fer."
                                            },
                                            {
                                                "example_id": "c70bba8c-2c66-4cd5-adc3-4b70abc9a575",
                                                "sense_id": "78a07b0e-8014-39f8-a946-a5e793f533e5",
                                                "text": "Les bœufs rentraient du labour, et c’était le moment où la ferme s’animait. Accouplés par deux ou trois paires, — car à cause de la lourdeur des terres mouillées on avait dû tripler les attelages, — ils arrivaient traînant leur timon, le mufle soufflant, les cornes basses, les flancs émus, avec de la boue jusqu’au ventre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "373f3d0c-2ef6-3edf-8cbb-62c2525f441d",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
                                            "Ce qui sert à atteler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1290887b-f19a-4ad0-af59-08e951ccfb34",
                                                "sense_id": "373f3d0c-2ef6-3edf-8cbb-62c2525f441d",
                                                "text": "Nettoyer l’attelage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f8bda0-5cbc-3620-b50f-beb6f578fbce",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
                                            "Animaux de trait qui sont attelés ensemble."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19efde6-4738-4d4a-8ff5-2562e96bcb45",
                                                "sense_id": "e3f8bda0-5cbc-3620-b50f-beb6f578fbce",
                                                "text": "Là, elle descendait de voiture, marchait pendant une heure, remontait dans son coupé, et rentrait chez elle au grand trot de son attelage."
                                            },
                                            {
                                                "example_id": "5631d844-2773-434d-a129-11795b5df078",
                                                "sense_id": "e3f8bda0-5cbc-3620-b50f-beb6f578fbce",
                                                "text": "Aussi le lieutenant et ses hommes furent-ils fréquemment obligés de mettre pied à terre, de renforcer l’attelage épuisé, de pousser à l’arrière des traîneaux, de les soutenir même, […]."
                                            },
                                            {
                                                "example_id": "8b3cc712-cddd-4625-b572-dac848b75830",
                                                "sense_id": "e3f8bda0-5cbc-3620-b50f-beb6f578fbce",
                                                "text": "Fort, et adroit dans ses mains comme dans sa tête. Il vous mènerait un attelage à six rien qu’en sifflant sur le bout de sa langue. C’est pourtant moi qui lui ai tout appris, et à présent, il m’en remontrerait. Voilà les garçons."
                                            },
                                            {
                                                "example_id": "8cc1a8f3-98b1-44d9-953c-00f1543841e8",
                                                "sense_id": "e3f8bda0-5cbc-3620-b50f-beb6f578fbce",
                                                "text": "S’il rencontre des résistances, il allonge de terribles coups de fouet comme le cocher qui, se réveillant en sursaut, malmène l’attelage que son sommeil a émancipé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa057b1-6717-3fbd-b608-30b96930bf1e",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
                                            "Ensemble constitué des animaux de trait et de la remorque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde491e0-ed84-4f0d-a186-9e3f5c715fb0",
                                                "sense_id": "0fa057b1-6717-3fbd-b608-30b96930bf1e",
                                                "text": "Autrefois ce chemin était une vraie route, où j’ai vu passer des attelages à quatre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7769ef40-3d77-3c37-a4af-59353d254a98",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
                                            "Discipline de sport équestre qui comporte différentes épreuves : du dressage, un marathon et une épreuve de maniabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2059d404-0896-45de-8a91-ea6e8ba0e11f",
                                                "sense_id": "7769ef40-3d77-3c37-a4af-59353d254a98",
                                                "text": "Les jeux mondiaux équestre se terminent avec l’attelage à quatre chevaux […]"
                                            },
                                            {
                                                "example_id": "d9950bcc-6bc7-4c7b-a33f-2c308c2a2796",
                                                "sense_id": "7769ef40-3d77-3c37-a4af-59353d254a98",
                                                "text": "On connaît son goût pour l’équitation, le polo et les compétitions d’attelages, discipline dans laquelle il concourait pour le Royaume-Uni."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc21f76-47f6-3ba6-b4e3-8dee10dbcf28",
                                        "entry_id": "63dc7959-6349-33c6-b10d-44d3f86d818d",
                                        "glosses": [
