                {
                    "sense_id": "e147ff1e-74dc-3861-a71b-91849f584446",
                    "sense_definition": "Qui est éprouvé ou exprimé sans déguisement ; qui est authentique et véritable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sincerite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous vous adressons nos plus <w>sincères</w> condoléances en cette période difficile.",
                            "target_lang_translations": {
                                "en": "We extend our most <w>heartfelt</w> condolences to you at this difficult time.",
                                "ru": "Выражаем вам наши самые <w>искренние</w> соболезнования в это трудное время.",
                                "nl": "Wij betuigen u onze <w>oprechtste</w> condoleances in deze moeilijke tijd.",
                                "de": "In dieser schwierigen Zeit sprechen wir Ihnen unser <w>aufrichtigstes</w> Beileid aus.",
                                "pl": "W tym trudnym czasie składamy Państwu nasze <w>najszczersze</w> kondolencje.",
                                "it": "Vi porgiamo le nostre più <w>sincere</w> condoglianze in questo periodo difficile.",
                                "cs": "V této těžké době vám vyjadřujeme své <w>nejupřímnější</w> soustrasti.",
                                "tr": "Bu zor dönemde size en <w>içten</w> başsağlığı dileklerimizi iletiyoruz.",
                                "es": "Les enviamos nuestras más <w>sinceras</w> condolencias en este momento difícil.",
                                "zh": "在这段艰难时期，我们谨向您致以最<w>诚挚</w>的慰问。"
                            }
                        },
                        {
                            "text": "Leur amitié <w>sincère</w> résiste à toutes les épreuves depuis leur enfance.",
                            "target_lang_translations": {
                                "en": "Their <w>genuine</w> friendship has withstood every trial since childhood.",
                                "ru": "Их <w>искренняя</w> дружба выдерживает все испытания с детства.",
                                "nl": "Hun <w>oprechte</w> vriendschap doorstaat al sinds hun kindertijd elke beproeving.",
                                "de": "Ihre <w>echte</w> Freundschaft hält seit ihrer Kindheit allen Prüfungen stand.",
                                "pl": "Ich <w>szczera</w> przyjaźń od dzieciństwa wytrzymuje wszystkie próby.",
                                "it": "La loro amicizia <w>sincera</w> resiste a tutte le prove fin dall'infanzia.",
                                "cs": "Jejich <w>upřímné</w> přátelství odolává všem zkouškám už od dětství.",
                                "tr": "Onların <w>samimi</w> dostluğu çocukluklarından beri her türlü sınava dayanıyor.",
                                "es": "Su amistad <w>sincera</w> resiste todas las pruebas desde la infancia.",
                                "zh": "他们从童年起就结下的<w>真挚</w>友谊，经受住了一切考验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "authentique",
                        "véritable"
                    ],
                    "antonyms": [
                        "feint",
                        "artificiel",
                        "simulé"
                    ],
                    "common_phrases": [
