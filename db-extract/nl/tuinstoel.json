                        "sense_id": "67cb43be-f33f-38bc-bc8a-6937017750ec",
                        "entry_id": "e8947744-8917-3a9b-92db-1ef9f6191622",
                        "glosses": [
                            "een weersbestendige stoel, vaak van plastic, metaal of teakhout, die men in de tuin kan gebruiken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9230fc9f-f054-4640-92eb-ee0fa2ee131e",
                                "sense_id": "67cb43be-f33f-38bc-bc8a-6937017750ec",
                                "text": "Tijdens de zomervakantie zitten we vaak in comfortabele tuinstoelen te genieten in de tuin van het mooie weer."
                            },
                            {
                                "example_id": "812ea61b-87cb-456b-a94d-541359972dc5",
                                "sense_id": "67cb43be-f33f-38bc-bc8a-6937017750ec",
                                "text": "Ik trok er een plastic tuinstoel bij en kwam daar de rest van de dag niet meer van af."
                            },
                            {
                                "example_id": "28174998-b3a1-4d2c-b802-c2f1f0d0e4cc",
                                "sense_id": "67cb43be-f33f-38bc-bc8a-6937017750ec",
                                "text": "\"Zorg er ook voor dat bijvoorbeeld tuinstoelen zijn opgeborgen\", geeft Geijs de inwoners van de drie Caribische eilanden een tip. \"Als die door de wind gaan rondslingeren, kunnen die ook voor schade zorgen.\""
                            }
                        ]
                    }
