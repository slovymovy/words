                        "entry_id": "7cf6418d-9f9e-3f34-ba35-b734f9ac2c8a",
                        "glosses": [
                            "die Anstifterin oder der Anführerin eines Aufruhrs oder einer Verschwörung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f6349d62-712e-4192-b1cc-05598a4917a6",
                                "sense_id": "7ee1367a-e3c2-3b2d-a548-3a9dea29b1fd",
                                "text": "Als Rädelsführerin wurde sie zu einer besonders hohen Strafe verurteilt."
                            },
                            {
                                "example_id": "e080b81a-cf67-481c-a6e7-357f856603a7",
                                "sense_id": "7ee1367a-e3c2-3b2d-a548-3a9dea29b1fd",
                                "text": "„Er sieht Mathilde Canetti – sie ist ja auch eine Arditti! – als die Rädelsführerin dieser Wegzugspläne und spricht mit ihr kein Wort mehr.“"
                            }
                        ],
