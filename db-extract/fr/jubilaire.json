                        "entry_id": "d1a329c7-0175-3d10-bfef-631eb362a04d",
                        "glosses": [
                            "Personne dont on fête un jubilé, un anniversaire."
                        ],
                        "tags": [
                            "Belgique",
                            "Canada",
                            "Suisse",
