{
    "word_family": [
        "staan",
        "voldoen",
        "voldoende"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79d0f254-e7f3-3c39-9857-c6e56a4b1d1b",
                    "sense_definition": "voldoende zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voldoende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een korte opmerking daarover <w>volstaat</w>.",
                            "target_lang_translations": {
                                "en": "A short remark about that <w>suffices</w>."
                            }
                        },
                        {
                            "text": "Mocht u iets nodig hebben, <w>volstaat</w> het aan het schelkoord te trekken dat naast de deur hangt.",
                            "target_lang_translations": {
                                "en": "Should you need anything, it <w>is enough</w> to pull the bell pull hanging next to the door."
                            }
                        }
                    ],
                    "synonyms": [
                        "voldoen",
                        "reiken"
                    ],
                    "antonyms": [
                        "tekortschieten"
                    ],
                    "common_phrases": [
                        "een korte opmerking volstaat",
                        "het volstaat om"
                    ],
                    "target_lang_definitions": {
                        "en": "to be enough or adequate for a particular purpose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffice",
                                "target_lang_sense_clarification": "to be enough or sufficient"
                            },
                            {
                                "target_lang_word": "be enough",
                                "target_lang_sense_clarification": "to be adequate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2849c689-8735-329f-aa76-58e469fb675b",
                    "sense_definition": "besluiten dat iets voldoende moet zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voldoende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is <w>volstaan</w> met een korte opmerking.",
                            "target_lang_translations": {
                                "en": "They <w>limited themselves</w> to a short remark."
                            }
                        },
                        {
                            "text": "De politie heeft <w>volstaan</w> met een waarschuwing in plaats van een boete.",
                            "target_lang_translations": {
                                "en": "The police <w>were satisfied</w> with a warning instead of a fine."
                            }
                        }
                    ],
                    "synonyms": [
                        "genoegen nemen"
                    ],
                    "common_phrases": [
                        "volstaan met"
                    ],
                    "target_lang_definitions": {
                        "en": "to decide that something is sufficient or to limit oneself to a specific action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "limit oneself to",
                                "target_lang_sense_clarification": "to do only a specific thing"
                            },
                            {
                                "target_lang_word": "be satisfied with",
                                "target_lang_sense_clarification": "to accept something as enough"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32256eda-25dd-3a24-a3f3-0b35cc65cd20",
                    "sense_definition": "geheel gevuld zijn met staande personen of objecten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vulling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele zaal <w>stond</w> <w>vol</w> met enthousiaste mensen.",
                            "target_lang_translations": {
                                "en": "The whole hall <w>was full</w> of enthusiastic people."
                            }
                        },
                        {
                            "text": "De kast <w>stond</w> helemaal <w>vol</w> met oude boeken en papieren.",
                            "target_lang_translations": {
                                "en": "The cupboard <w>was</w> completely <w>full</w> of old books and papers."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "leegstaan"
                    ],
                    "common_phrases": [
                        "vol staan met"
                    ],
                    "target_lang_definitions": {
                        "en": "to be completely filled with standing people or objects"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be full of",
                                "target_lang_sense_clarification": "filled with standing items or people"
                            },
                            {
                                "target_lang_word": "be packed with",
                                "target_lang_sense_clarification": "crowded or filled to capacity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a6fcff2-8fcd-391e-ba10-38b717800e6e",
                    "sense_definition": "voltooid deelwoord van <w>volstaan</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft met een kort antwoord <w>volstaan</w>.",
                            "target_lang_translations": {
                                "en": "He <w>limited himself</w> to a short answer."
                            }
                        },
                        {
                            "text": "Nadat de burgemeester had <w>volstaan</w> met een korte toespraak, begon het feest.",
                            "target_lang_translations": {
                                "en": "After the mayor <w>had limited himself</w> to a short speech, the party began."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'volstaan', meaning to have limited oneself to or to have been sufficient"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sufficed",
                                "target_lang_sense_clarification": "past participle of suffice"
                            },
                            {
                                "target_lang_word": "limited oneself to",
                                "target_lang_sense_clarification": "past action of doing only a specific thing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}