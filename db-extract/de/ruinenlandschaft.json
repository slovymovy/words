                "senses": [
                    {
                        "sense_id": "4ee421a1-16e8-3ed2-84bd-c784cdcacd4a",
                        "entry_id": "3bc8b5ef-3e26-384a-8736-1c0ef31556a2",
                        "glosses": [
                            "Landschaft voller Ruinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbffc66-5464-4aca-b31f-c691dac6b3b0",
                                "sense_id": "4ee421a1-16e8-3ed2-84bd-c784cdcacd4a",
                                "text": "„Angehäufter Schutt vereinfachte das Betreten des großen Gebäudes zu unserer Linken, und dennoch zögerten wir einen Augenblick, die lang ersehnte Gelegenheit zu nutzen - denn obwohl wir bereits ein gutes Stück in diese Ruinenlandschaft urzeitlichen Geheimnisses vorgedrungen waren, mussten wir neuen Mut sammeln, um tatsächlich den Fuß in ein vollständig erhaltenes Bauwerk einer sagenhaften uralten Welt zu setzen, über deren Natur wir immer deutlichere und immer schrecklichere Gewissheit gewannen.“"
                            },
                            {
                                "example_id": "ab55e1f0-b618-4090-9744-100d237d6e28",
                                "sense_id": "4ee421a1-16e8-3ed2-84bd-c784cdcacd4a",
                                "text": "„Schon jetzt, in der frühen Morgensonne, wirkte die Stadt wie eine kleine Ruinenlandschaft; das Licht brach sich an den Rändern der Gebäude und betonte die Kargheit, die bereits zu sehen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
