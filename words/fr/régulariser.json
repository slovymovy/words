    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df6972f3-e391-37ac-a2cb-ec9dd72ba937",
                    "sense_definition": "Rendre conforme aux règles ou à la loi ce qui ne l'était pas, donner un statut légal ou administratif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conformité légale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il doit se rendre rapidement à la préfecture pour <w>régulariser</w> sa situation."
                        },
                        {
                            "text": "L'entreprise a payé les cotisations en retard afin de <w>régulariser</w> son dossier comptable."
                        }
                    ],
                    "synonyms": [
                        "légaliser",
                        "normaliser"
                    ],
                    "common_phrases": [
                        "régulariser une situation",
                        "régulariser un dossier",
                        "régulariser des sans-papiers"
                    ]
                },
                {
                    "sense_id": "9d6fdad9-afd1-3fa6-ab3d-9a95d42f160f",
                    "sense_definition": "Rendre plus régulier, uniforme ou constant dans son rythme ou son débit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rythme et flux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a recommandé de profonds exercices pour <w>régulariser</w> sa respiration."
                        },
                        {
                            "text": "Ce nouveau barrage permettra de <w>régulariser</w> le débit de la rivière en été."
                        }
                    ],
                    "synonyms": [
                        "réguler",
                        "stabiliser"
                    ],
                    "common_phrases": [
                        "régulariser la respiration",
                        "régulariser le débit",
                        "régulariser le cours"
                    ]
                }
            ]
        }
    ]
