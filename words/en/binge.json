                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6ae651b-5840-39af-940c-8ac9a45d17d9",
                    "sense_definition": "A period of time spent doing a particular activity, especially watching television or movies, to an excessive degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excessive consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went on a weekend <w>binge</w> and finished three entire seasons of that new sci-fi show.",
                            "target_lang_translations": {
                                "ru": "Я устроил себе <w>марафон</w> на выходных и посмотрел целиком три сезона того нового научно-фантастического сериала.",
                                "zh": "我周末进行了一场<w>马拉松式观看</w>，看完了那部新科幻剧的整整三季。"
                            }
                        },
                        {
                            "text": "A weekend <w>binge</w> of your favorite show can be a great way to relax and disconnect.",
                            "target_lang_translations": {
                                "ru": "<w>Запойный просмотр</w> любимого шоу на выходных может быть отличным способом расслабиться и отвлечься.",
                                "zh": "周末<w>狂看</w>你最喜欢的节目是放松和解压的好方法。"
                            }
                        }
