                            },
                            {
                                "target_word": "misandric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26e25875-e848-3df5-884e-6f680df035a9",
                                        "entry_id": "9de6daee-50b9-324d-bb40-88e49f6cb287",
                                        "glosses": [
                                            "One who professes misandry; a hater of men, or one prejudiced against men."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f6ac3bd-2c68-44a0-ac98-f28fc935f442",
                                                "sense_id": "26e25875-e848-3df5-884e-6f680df035a9",
                                                "text": "Sentimental misandrics, for example, focus attention on the warm and cosy features of womanhood, contrasting them pointedly with the sinister and threatening features of manhood."
                                            },
                                            {
                                                "example_id": "46e484bd-9f47-4d81-8f9b-135c11deb892",
                                                "sense_id": "26e25875-e848-3df5-884e-6f680df035a9",
                                                "text": "By turning Shakti into an odd misandric, the patriarchal order is maintained as her field of action is limited to only women in distress."
                                            },
                                            {
                                                "example_id": "85b811d8-d7fc-4a6d-af06-8f5cbf5fed0c",
                                                "sense_id": "26e25875-e848-3df5-884e-6f680df035a9",
                                                "text": "However, expressing anguish over crime against women and being a misandric are two different things."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
