                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d21c0c4-4e46-4363-a15f-30959502b3bc",
                                "sense_id": "421b4c58-0b28-33fa-b6e1-2775fd9b53ef",
                                "text": "Ah, le doppleriste du privé ! Un homme froid et arasé, venu de la Pitié, ultra-compétent mais ultra-mutique…"
                            },
                            {
                                "example_id": "6adf2886-88bd-484e-b065-b902bbb65202",
                                "sense_id": "421b4c58-0b28-33fa-b6e1-2775fd9b53ef",
                                "text": "Elle demande ensuite à Michèle de prendre rendez-vous chez un doppleriste en ville."
                            },
                            {
                                "example_id": "d5822d86-2bcf-453d-a99a-d089934358e0",
                                "sense_id": "421b4c58-0b28-33fa-b6e1-2775fd9b53ef",
                                "text": "Un des problèmes majeurs de la technique est que les vitesses circulatoires doivent être a priori connues pour éviter les phénomènes « d’aliasing » bien connus par les doppleristes."
                            }
                        ]
