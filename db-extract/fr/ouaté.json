                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d925f917-66dd-4d6a-89ff-31fa4c37f45c",
                                "sense_id": "e4f114db-2ff1-33e5-ac1d-c867ee86215d",
                                "text": "Une démarche ouatée."
                            },
                            {
                                "example_id": "30edb71c-85a2-48e5-9666-1e450d80d461",
                                "sense_id": "e4f114db-2ff1-33e5-ac1d-c867ee86215d",
                                "text": "L’atmosphère paraissait ouatée et, comme une salle tendue de tapisseries, perdait toute sonorité."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6bce8b1-f4d5-335c-a268-a1223f5440f2",
