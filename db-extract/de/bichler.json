                ],
                "senses": [
                    {
                        "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                        "entry_id": "9ca707ac-eb2f-34e0-975b-9e23cf92407a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname mit häufigem Vorkommen in Bayern und Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae200e01-3cfe-4e27-a73d-154352c0b247",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Frau Bichler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "32a004a6-2c42-4407-a96c-542ef4c02370",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Herr Bichler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4ef7282a-7cdf-44ea-b47c-4de6e1426f8a",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Die Bichlers fahren heute ins Burgenland."
                            },
                            {
                                "example_id": "da5d9d14-2c32-420e-8287-bdc224430dfb",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Der Bichler trägt nie die Schals, die die Bichler ihm strickt."
                            },
                            {
                                "example_id": "eb77f823-b0b4-452a-974e-48eacd0036b0",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bichler kommt, geht der Herr Bichler.“"
                            },
                            {
                                "example_id": "1344f6fe-2039-48a4-a6df-3e32e1dcb2a0",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Bichler kommt und geht."
                            },
                            {
                                "example_id": "cedbeef4-86f2-440c-9543-be3dc80b2ddb",
                                "sense_id": "4e3e5a58-f4ab-3c70-9eaa-d45a01aa376a",
                                "text": "Bichlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
