                        "glosses": [
                            "Of or pertaining to a lack of attention; not paying attention; careless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43164df-d1d0-42cf-89a4-81e16fb9373b",
                                "sense_id": "ee652103-2ec3-397a-8a45-5985dc8090f7",
                                "text": "He was inattentive in class and did not do well in his exams."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bc0e208-3cf0-4365-be81-531436a3a665",
