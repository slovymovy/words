                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6509173b-9fc3-4aa8-b350-edea3c742877",
                                "sense_id": "15c6665e-833b-3954-9cf5-8dd75b7e6c78",
                                "text": "Laser helowo-neonowy emituje promieniowanie o długości fali równej 632,8 nm (= nanometrów)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "911c901c-2f72-4840-8523-3b1e406a9ddf",
                        "source_entry_id": "74651caf-b888-3189-be1a-9b78d93ccfd0",
                        "source_sense_id": "15c6665e-833b-3954-9cf5-8dd75b7e6c78",
                        "target_lang_word": "гелиевый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гелиевый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5511e646-9aeb-3331-920b-e7e721a59d19",
                                        "entry_id": "12ba8fa8-41ec-3ec6-81c8-b03893af77f0",
                                        "glosses": [
                                            "сделанный из гелия, содержащий гелий, свойственный гелию или относящийся к нему"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822b6706-b4e8-4088-829c-0085a4102e04",
                                                "sense_id": "5511e646-9aeb-3331-920b-e7e721a59d19",
                                                "text": "Меняю газовую смесь: перехожу с кислородно-азотной на гелиево-кислородно-азотную."
                                            },
                                            {
                                                "example_id": "24c68fa9-470a-42e8-97c9-3fde7d7608f7",
                                                "sense_id": "5511e646-9aeb-3331-920b-e7e721a59d19",
                                                "text": "Оренбургский гелиевый завод (ОГЗ) входит в состав Оренбурггазпрома и является единственным в отечественной газовой отрасли крупномасштабным производителем гелия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9977eb-8651-3987-9c6f-f60370ec8837",
                                        "entry_id": "12ba8fa8-41ec-3ec6-81c8-b03893af77f0",
                                        "glosses": [
                                            "наполненный гелием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fa1873-359b-43f1-8505-14245926ed39",
                                                "sense_id": "4d9977eb-8651-3987-9c6f-f60370ec8837",
                                                "text": "Константин Боровой и Станислав Говорухин пустили в небо десятиметровую ракету из белых гелиевых шариков «СССР-Восток»."
                                            },
                                            {
                                                "example_id": "82635bcb-09d4-4d5a-8ece-37fad7258604",
                                                "sense_id": "4d9977eb-8651-3987-9c6f-f60370ec8837",
                                                "text": "TAOS представляет собой аэростатную систему контроля и наблюдения, включающую разнообразные датчики, размещаемые на гелиевом аэростате в качестве полезной нагрузки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
