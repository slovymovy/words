                        "cross_references": [
                            {
                                "target_word": "danger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce69ee09-e647-3213-aee8-68c784db96a1",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "Exposure to likely harm; peril."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d050778e-1e3f-47ef-a7e6-a566813fedf9",
                                                "sense_id": "ce69ee09-e647-3213-aee8-68c784db96a1",
                                                "text": "There's plenty of danger in the desert."
                                            },
                                            {
                                                "example_id": "2c20d977-b24f-4547-ab61-4eb30252d885",
                                                "sense_id": "ce69ee09-e647-3213-aee8-68c784db96a1",
                                                "text": "Danger is a good teacher, and makes apt scholars."
                                            },
                                            {
                                                "example_id": "beef1d6e-1173-4742-92bb-f9ae0c95b32a",
                                                "sense_id": "ce69ee09-e647-3213-aee8-68c784db96a1",
                                                "text": "The Owl is flying high, frightening to the eye.\nThe Rattler is nearby, Cool is on the fly.\nDanger is his business."
                                            },
                                            {
                                                "example_id": "d4668554-5ec8-4252-8589-eabebc5ae315",
                                                "sense_id": "ce69ee09-e647-3213-aee8-68c784db96a1",
                                                "text": "We determined that the car driver’s transportation of multiple teen passengers, limited driving experience, and likely impairment from effects of cannabis at the time of the crash adversely affected her judgment of the danger of entering the intersection in front of the approaching combination vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f96eb12b-5b70-333d-985d-16babb646f3c",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "An instance or cause of likely harm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fb7ad5-d8dc-425d-8038-25de1d8c8114",
                                                "sense_id": "f96eb12b-5b70-333d-985d-16babb646f3c",
                                                "text": "1st September 1884, William Gladstone, Second Midlothian Speech\nTwo territorial questions […] unsettled […] each of which was a positive danger to the peace of Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aad1509-8517-3d0a-8468-ba6fd2197ea4",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "Mischief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5631322c-acec-4699-b480-49fe6754b531",
                                                "sense_id": "4aad1509-8517-3d0a-8468-ba6fd2197ea4",
                                                "text": "We put a Sting in him, / That at his will he may doe danger with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb03fcb-fd13-382b-827f-355ce3abd843",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "The stop indication of a signal (usually in the phrase \\\"at danger\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d982a6a-81e5-4425-bb58-09fcd3c6c967",
                                                "sense_id": "2bb03fcb-fd13-382b-827f-355ce3abd843",
                                                "text": "The north signal was at danger because of the rockslide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be326b8a-1fe5-3d72-9d7d-8838c4b5a439",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "Ability to harm; someone's dominion or power to harm or penalise. See in one's danger, below."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c93c5d38-368b-48aa-8f03-68028ad80bd7",
                                                "sense_id": "be326b8a-1fe5-3d72-9d7d-8838c4b5a439",
                                                "text": "You stand within his danger, do you not?"
                                            },
                                            {
                                                "example_id": "1ad9d171-015c-427c-85f5-40737f94bff8",
                                                "sense_id": "be326b8a-1fe5-3d72-9d7d-8838c4b5a439",
                                                "text": "Covetousness of gains hath brought [them] in danger of this statute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d7e1c5-8e21-3384-a841-10e8961c3384",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "Liability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cce9df8-5670-4985-805a-fd0a97e4446f",
                                                "sense_id": "b8d7e1c5-8e21-3384-a841-10e8961c3384",
                                                "text": "Thou shalt not kyll. Whosoever shall kyll, shalbe in daunger of iudgement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99bb307b-bb08-37a1-ae15-180ca19b29a2",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "Difficulty; sparingness; hesitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89857049-8314-4cca-8079-ba45d0bf842e",
                                                "sense_id": "99bb307b-bb08-37a1-ae15-180ca19b29a2",
                                                "text": "They of Coloyne made grete daunger to lete passe the oost thrughe the Cite at brydge."
                                            },
                                            {
                                                "example_id": "0fab2ddf-e249-4d7a-9f64-101f0f921138",
                                                "sense_id": "99bb307b-bb08-37a1-ae15-180ca19b29a2",
                                                "text": "I made daunger of it a while at first, but afterward beyng persuaded by them..I promised to do as they would haue me."
                                            },
                                            {
                                                "example_id": "7f69a8dc-8cee-445a-a96b-8218085180e3",
                                                "sense_id": "99bb307b-bb08-37a1-ae15-180ca19b29a2",
                                                "text": "I shall make danger, sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fa130d-875d-3af6-b339-c632d4592ca6",
                                        "entry_id": "2acd0adc-c7ff-3814-8cf6-04a69e59b0e1",
                                        "glosses": [
                                            "A contemptible person, especially one seen as perverted or mentally ill."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1286e401-0cb4-4663-87a0-af22c3b5cb73",
                                                "sense_id": "11fa130d-875d-3af6-b339-c632d4592ca6",
                                                "text": "Pineapple and pizza. ONLY JOKING YOU FUCKING DANGER."
                                            },
                                            {
                                                "example_id": "cb077821-37d8-4fd5-a533-8d8784ae794f",
                                                "sense_id": "11fa130d-875d-3af6-b339-c632d4592ca6",
                                                "text": "Why did the chicken cross the road?\n\"To try and get away from you, you absolute danger. I've heard all about you posh boy Etonians and farmyard animals\""
                                            }
                                        ]
                                    }
                                ]
