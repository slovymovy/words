                ],
                "senses": [
                    {
                        "sense_id": "21a8837e-9f0f-3033-8ef6-33d6f422d6fb",
                        "entry_id": "9d1cc73f-8e08-32b9-88e6-b4ab9a9f09cd",
                        "glosses": [
                            "состояние по значению прил. подавленный"
                        ],
                        "tags": [],
