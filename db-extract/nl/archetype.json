                    },
                    {
                        "sense_id": "6a0df2ba-c437-3170-be9a-8f2607057f8a",
                        "entry_id": "209b4049-a905-3344-b4fd-ce46d513f0ae",
                        "glosses": [
                            "overgeërfd, onbewust idee of beeld in het collectief onbewuste van de mensheid"
                        ],
                        "tags": [
                            "volgens Jung"
                        ],
                        "examples": [
                            {
                                "example_id": "b5dd8924-9c58-40e2-94b3-9d2bbd7d1bf1",
                                "sense_id": "6a0df2ba-c437-3170-be9a-8f2607057f8a",
                                "text": "'Ik bestudeer mensen, analyseer hun woorden, interpreteer hun gebaren. Voor mijn rollen ga ik altijd uit van de psychologie van de archetypes van Jung, ken je die?' Hannah knikt traag. 'Welk archetype ben jij dan?' Het blijft stil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec5edb8f-9fcf-4e30-a28f-528e663ed0f9",
                        "source_entry_id": "209b4049-a905-3344-b4fd-ce46d513f0ae",
                        "target_lang_word": "Archetypus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archetypus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c511f02e-8eed-3f28-b345-316bc283650b",
                                        "entry_id": "5188649e-7b7d-3cd0-a5f3-25be376a33f4",
                                        "glosses": [
                                            "etwas Ursprüngliches, Vorbildhaftes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b1fe2a6-ef4d-3ac6-8f07-d0561d7dee51",
                                        "entry_id": "5188649e-7b7d-3cd0-a5f3-25be376a33f4",
                                        "glosses": [
                                            "elementare Disposition des Unbewussten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdce9f71-63b2-4214-9d0c-f44fba77c73f",
                                                "sense_id": "9b1fe2a6-ef4d-3ac6-8f07-d0561d7dee51",
                                                "text": "„Eigentlich schritt ich als neuer Archetypus zu Werke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df7de2d0-5d99-4dc5-9b09-35a99eac8def",
                        "source_entry_id": "209b4049-a905-3344-b4fd-ce46d513f0ae",
                        "target_lang_word": "archetype",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archetype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beae4648-9cec-3d13-86f3-44d2ed80eb07",
                                        "entry_id": "41ba7a57-76c3-3150-aed9-b4717140bac0",
                                        "glosses": [
                                            "An original model of which all other similar concepts, objects, or persons are merely copied, derivative, emulated, or patterned; a prototype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a20d83-50b7-4b1f-9084-93a3d4f14ef5",
                                                "sense_id": "beae4648-9cec-3d13-86f3-44d2ed80eb07",
                                                "text": "According to that Cabaliſticall Dogma: If Abram had not had this Letter [i.e., ה (he)] added unto his Name he had remained fruitleſſe, and without the power of generation: […] So that being ſterill before, he received the power of generation from that meaſure and manſion in the Archetype; and was made conformable unto Binah."
                                            },
                                            {
                                                "example_id": "67a06bc2-b8dc-405a-95dc-16df98e50b8a",
                                                "sense_id": "beae4648-9cec-3d13-86f3-44d2ed80eb07",
                                                "text": "Sir Edward Newenden, a married man, the guardian of Ethelinde at the deceaſe of her father, and who is enamoured of his ward, is evidently a copy, in the outline, or Mr. Monckton in the novel of Cecilia. His manners, however, are of a much more engaging nature than thoſe of his archetype."
                                            },
                                            {
                                                "example_id": "3ad0d6b9-32a5-4c79-8292-4707a4766d06",
                                                "sense_id": "beae4648-9cec-3d13-86f3-44d2ed80eb07",
                                                "text": "Outlines of the chief developments of the dermoskeleton, in different vertebrates, which are usually more or less ossified, are added to the endoskeletal archetype: as, e.g. the median horn supported by the nasal spine […] in the rhinoceros; […]"
                                            },
                                            {
                                                "example_id": "57d2f40f-c5ff-4494-94f1-e031919d8eba",
                                                "sense_id": "beae4648-9cec-3d13-86f3-44d2ed80eb07",
                                                "text": "Now these plans, models, original patterns, existing in God's mind before He made a single plant or a single animal, are what we mean by Archetypes. An archetype, therefore, is not a real, actual, objective thing, existing independent of the copy, or of God. It is only a plan, a model, an original pattern in God's mind—an idea, or thought of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af3c5d1-dc0e-3128-b03f-29ff9dc1ae56",
                                        "entry_id": "41ba7a57-76c3-3150-aed9-b4717140bac0",
                                        "glosses": [
                                            "An ideal example of something; a quintessence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c85777f5-da4a-4d4a-878c-9681d6f72115",
                                                "sense_id": "1af3c5d1-dc0e-3128-b03f-29ff9dc1ae56",
                                                "text": "The Bishop [of Gloucester, William Warburton] asserts there is no Archetype, because eloquence is a variable thing, depending on custom and fashion; […] there is no Archetype in nature of perfect eloquence; its very constituent parts, as they are deemed, having no substance or reality in them."
                                            },
                                            {
                                                "example_id": "cde47375-605e-4f7c-b114-50c4576015cc",
                                                "sense_id": "1af3c5d1-dc0e-3128-b03f-29ff9dc1ae56",
                                                "text": "“New Kid On The Block” doubles as a terrific showcase for the Sea Captain who, in the grand tradition of Simpsons supporting characters, quickly goes from being a stereotype to an archetype, from being a crusty sea-captain character to the crusty sea-captain character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89099e46-b847-39ff-acbc-521dcbc342fc",
                                        "entry_id": "41ba7a57-76c3-3150-aed9-b4717140bac0",
                                        "glosses": [
                                            "A character, object, or story that is based on a known character, object, or story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25908d61-8513-471b-af28-084b99b107b7",
                                                "sense_id": "89099e46-b847-39ff-acbc-521dcbc342fc",
                                                "text": "Archetypes are figures and creatures that inhabit the pools of the world's mythology, folk tales, epics, and ballads. […] Thus archetypes are universal essences that we all recognize: the Mother, the Lover, the Trickster, the Spiritual and Temporal Leader, the Devil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef440ec-29a8-368c-9e3c-14c1d01ca112",
                                        "entry_id": "41ba7a57-76c3-3150-aed9-b4717140bac0",
                                        "glosses": [
                                            "According to Swiss psychologist Carl Jung: a universal pattern of thought, present in an individual's unconscious, inherited from the past collective experience of humanity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c449e16f-ceb6-4536-9880-1dd766486eda",
                                                "sense_id": "bef440ec-29a8-368c-9e3c-14c1d01ca112",
                                                "text": "The three archetypes so far discussed—the shadow, the anima, and the wise old man—are of a kind that can be directly experienced in personified form. In the foregoing I tried to indicate the general psychological conditions in which such an experience arises. But what I conveyed were only abstract generalizations. One could, or rather should, really give a description of the process as it occurs in immediate experience. In the course of this process the archetypes appear as active personalities in dreams and fantasies."
                                            },
                                            {
                                                "example_id": "8b86a643-bd34-4970-a42a-be02d2835102",
                                                "sense_id": "bef440ec-29a8-368c-9e3c-14c1d01ca112",
                                                "text": "It has been suggested that Prothean data recording is highly dependent on a certain point of view, what Carl Jung described as the collective unconscious. The 'cipher' needed to comprehend the images implanted in Shepard's mind is the cultural knowledge of a Prothean: the archetypes, biological instincts, and common experiences universal to the race."
                                            },
                                            {
                                                "example_id": "a363743e-c7a1-4c44-873c-ebce67c30067",
                                                "sense_id": "bef440ec-29a8-368c-9e3c-14c1d01ca112",
                                                "text": "According to [Carl] Jung, all the most important ideas, in both science and religion, originate from archetypes. People acquire archetypal images and notions and consciously convert them to ideas, art, technology, and other products of culture and civilization. Archetypes also play a crucial role in the development of the individual. […] Typical archetypes connected with individuation are the archetypes of transformation, like birth, death and rebirth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95fcedd0-e5cb-3639-80a1-da1dca007bed",
                                        "entry_id": "41ba7a57-76c3-3150-aed9-b4717140bac0",
                                        "glosses": [
                                            "A protograph (“original manuscript of a text from which all further copies derive”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53da737-97f4-46b1-b14d-35e9942435a6",
                                                "sense_id": "95fcedd0-e5cb-3639-80a1-da1dca007bed",
                                                "text": "The outstanding importance of this manuscript for the text of Aeschylus has long been recognized. In the last century some scholars even persuaded themselves that it was the archetype of the whole extant tradition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "archetype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee28313d-4fdc-35b5-901d-a5313eb637d5",
                                        "entry_id": "6468a115-9b8f-364f-8183-1f4713ccb180",
                                        "glosses": [
                                            "To depict as, model using, or otherwise associate an object or subject with an archetype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f26917-2749-4c10-8722-aaa0b7d094cc",
                                                "sense_id": "ee28313d-4fdc-35b5-901d-a5313eb637d5",
                                                "text": "The whole issue of generalizing and overgeneralizing is always an issue. I use the term \"archetyping.\" I say, \"No, I am not stereotyping; I am archetyping.\" Stereotypes tend to be accusatory. I want to move the discussion away from a discussion of right and wrong to right and left—this is the way it is over here, and this is the way it is over there—and then look at the problems that develop as a result of each group interacting according to the standards of its own culture."
                                            },
                                            {
                                                "example_id": "358a699a-83ef-4877-adf8-576e398753c1",
                                                "sense_id": "ee28313d-4fdc-35b5-901d-a5313eb637d5",
                                                "text": "These stereotypes of indigenous peoples implied obvious roles for the associated Europeans—heirs to the Dying, bleaching agents to the Whitening. But the interaction of conceptions of Us and Them went further, through archetyping and anti-typing. Maoris were sometimes archetyped or idealized, as with the Noble Savage and some Whitening Savages."
                                            },
                                            {
                                                "example_id": "95617a0d-298d-4d85-b232-78f1158377ed",
                                                "sense_id": "ee28313d-4fdc-35b5-901d-a5313eb637d5",
                                                "text": "His collaborator was Robert Singer, a professor of English and film studies at Kingsborough Community College, who lamented this week that he and his fellow Brooklynites \"have been archetyped to death.\""
                                            },
                                            {
                                                "example_id": "e708d17d-6be2-42b9-a6bc-25c168d7d2fa",
                                                "sense_id": "ee28313d-4fdc-35b5-901d-a5313eb637d5",
                                                "text": "“But it is gendered and it’s archetyped and stereotyped that you’re so lucky, and it just feeds into this idea that you’re waiting for someone to tell you that you’re good enough, as opposed to knowing that you’re good enough on your own,” she said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "920f4934-3fb9-4a2e-986e-0a21e8b8c6ed",
                        "source_entry_id": "209b4049-a905-3344-b4fd-ce46d513f0ae",
                        "target_lang_word": "archétype",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archétype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edeb18ec-5c4c-3576-a5e4-0b9fc081e4ea",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Type ou modèle primitif et idéal, en concurrence avec prototype."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f31e061-2cad-3477-9bba-00a1f04afac0",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Modèle ou type représentatif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64bf4e27-bb68-461c-b839-812e64c5c794",
                                                "sense_id": "4f31e061-2cad-3477-9bba-00a1f04afac0",
                                                "text": "Ce patchwork est encore plus manifeste dans les mégapoles, l’archétype étant New York avec ses communautés irlandaise, italienne, chinoise…, leurs quartiers et leurs festivités."
                                            },
                                            {
                                                "example_id": "04084d68-7874-49df-9d6e-eb43291fc35a",
                                                "sense_id": "4f31e061-2cad-3477-9bba-00a1f04afac0",
                                                "text": "La NSA est devenue l’archétype de l’agence incontrôlable : investie du pouvoir d’agir comme bon lui semble, soumise à très peu d’obligations de contrôle, de transparence ou de rendre des comptes."
                                            },
                                            {
                                                "example_id": "e1cebe41-5c03-4233-9152-d74383d91f13",
                                                "sense_id": "4f31e061-2cad-3477-9bba-00a1f04afac0",
                                                "text": "À rebours de l’archétype de l’anarchiste, éruptive et extravertie, Voltairine [de Cleyre] fut une personnalité effacée, introvertie, maladive, tout en dispensant des cours aux migrants des ghettos à Philadelphie et à Chicago, et en écrivant sans cesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d10395b6-51eb-387f-a5d0-000542928a64",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Modèle approchant la perfection, dans les Idées platoniciennes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c31312e-3e74-41bb-9488-179898025e4f",
                                                "sense_id": "d10395b6-51eb-387f-a5d0-000542928a64",
                                                "text": "Les idées, selon Platon, sont l’archétype du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c33c204c-4e34-3f05-865f-c7f18134781b",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Type d’après lequel est fait un ouvrage."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120367a2-5670-4ca5-a065-7916e12fa5ac",
                                                "sense_id": "c33c204c-4e34-3f05-865f-c7f18134781b",
                                                "text": "Ce manuscrit est l’archétype sur lequel ont été faits les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b1e2df-2875-3be9-9839-91dc21785cf3",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Espèce primordiale dans l’évolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44dfe969-6e6c-300e-8ab5-dfc8158ce8d3",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Plâtre moulé sur un bas-relief."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8dbde43-07fb-31b3-966c-4aa020611cae",
                                        "entry_id": "c7138c61-d2db-3c65-bf26-45716788c87f",
                                        "glosses": [
                                            "Symbole ou mythe primitif et universel de l’inconscient collectif. Introduit par Carl Gustav Jung en 1919."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7b3447-9ad5-4e94-8725-59b4e4e95fa8",
                                                "sense_id": "a8dbde43-07fb-31b3-966c-4aa020611cae",
                                                "text": "Dans Mam’zelle Nitouche, fort de son expérience, Hervé créa l’archétype du personnage double, à la fois Célestin pour les cocottes du demi-monde et Floridor pour les grenouilles de bénitier de matines et de vêpres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
