{
    "word_family": [
        "ridicule",
        "ridiculously",
        "ridiculousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90468dc8-928a-317e-b170-6813fe9e0e05",
                    "sense_definition": "Deserving of ridicule; foolish, absurd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That hairstyle looks <w>ridiculous</w>.",
                            "target_lang_translations": {
                                "ru": "Эта прическа выглядит <w>нелепо</w>.",
                                "zh": "那个发型看起来真<w>滑稽</w>。"
                            }
                        },
                        {
                            "text": "It is <w>ridiculous</w> to charge so much for a little souvenir.",
                            "target_lang_translations": {
                                "ru": "Это <w>смехотворно</w> — просить так много за маленький сувенир.",
                                "zh": "为一个小纪念品收这么多钱简直太<w>荒谬</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absurd",
                        "foolish",
                        "laughable",
                        "ludicrous",
                        "nonsensical",
                        "preposterous",
                        "silly"
                    ],
                    "antonyms": [
                        "serious",
                        "solemn"
                    ],
                    "common_phrases": [
                        "look ridiculous",
                        "sound ridiculous",
                        "absolutely ridiculous",
                        "ridiculous idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий осмеяния; глупый, абсурдный.",
                        "zh": "值得嘲笑的；愚蠢的，荒谬的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "странный, вызывающий недоумение или насмешку"
                            },
                            {
                                "target_lang_word": "смехотворный",
                                "target_lang_sense_clarification": "заслуживающий смеха, ничтожный"
                            },
                            {
                                "target_lang_word": "абсурдный",
                                "target_lang_sense_clarification": "противоречащий здравому смыслу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荒谬的",
                                "target_lang_sense_clarification": "指极其不合理，违背常理"
                            },
                            {
                                "target_lang_word": "可笑的",
                                "target_lang_sense_clarification": "指令人发笑，不严肃"
                            },
                            {
                                "target_lang_word": "滑稽的",
                                "target_lang_sense_clarification": "指样子或行为古怪可笑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4446182f-d01e-3a60-9437-07e0c58aff45",
                    "sense_definition": "Astonishing, extreme, or unbelievable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete showed <w>ridiculous</w> strength during the match.",
                            "target_lang_translations": {
                                "ru": "Спортсмен продемонстрировал <w>невероятную</w> силу во время матча.",
                                "zh": "那名运动员在比赛中展现出了<w>惊人</w>的力量。"
                            }
                        },
                        {
                            "text": "He spent a <w>ridiculous</w> amount of money on that car.",
                            "target_lang_translations": {
                                "ru": "Он потратил <w>сумасшедшую</w> сумму денег на эту машину.",
                                "zh": "他在那辆车上花了<w>离谱</w>的一大笔钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unreasonable",
                        "surreal"
                    ],
                    "common_phrases": [
                        "ridiculous amount",
                        "ridiculous speed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поразительный, чрезмерный или невероятный.",
                        "zh": "令人惊讶的、极端的或难以置信的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "очень большой или удивительный"
                            },
                            {
                                "target_lang_word": "сумасшедший",
                                "target_lang_sense_clarification": "разг. чрезмерный, огромный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊人的",
                                "target_lang_sense_clarification": "指程度极高，令人吃惊"
                            },
                            {
                                "target_lang_word": "离谱的",
                                "target_lang_sense_clarification": "指程度过分，超出正常范围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}