                "senses": [
                    {
                        "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                        "entry_id": "c589e772-43d0-346b-9e24-18b9ca002d6f",
                        "glosses": [
                            "Untersuchung, in der Meinungen einzelner Menschen als repräsentativ für eine größere Personengruppe angesehen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c374d9f-f661-46b8-8f24-5812c4f46161",
                                "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                                "text": "„Nach einer Repräsentativuntersuchung des Fessel-GfK-Instituts (1000 Befragte im Zeitraum 14. Juli bis 12. August) sind 44 Prozent für die Einführung der gemeinsamen Währung, 41 Prozent sind dagegen.“"
                            },
                            {
                                "example_id": "ec41b766-4da3-40de-8b36-a3940b8873fc",
                                "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                                "text": "„Die wirtschaftliche Entwicklung in Ostmitteleuropa wird überwiegend negativ beurteilt, geht aus einer Repräsentativuntersuchung, welche die Töchter des Fessel+GfK Instituts in Ost-Mitteleuropa im Frühjahr durchgeführt haben.“"
                            },
                            {
                                "example_id": "912167c8-f886-43e7-ab09-5b990e979687",
                                "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                                "text": "„eine vom IFAK-Institut durchgeführte Repräsentativuntersuchung (200 Allgemeinmediziner und Internisten) zeigt zudem nur geringe Kenntnis über die klinischen Folgen einer falschen Ernährungsweise.“"
                            },
                            {
                                "example_id": "380d771a-fef2-4cf1-8f4f-d4f4894cacb6",
                                "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                                "text": "„Im nächsten Forschungsschritt wurde eine bundesweite Repräsentativuntersuchung durchgeführt mit 2.053 persönlich-mündlichen Interviews.“"
                            },
                            {
                                "example_id": "d2b0bd70-9149-40df-9ff1-315d4d07f2e5",
                                "sense_id": "48a5bc17-4954-3d0f-87da-bd1ceb59cad5",
                                "text": "„(4) Tarifausgaben der Krankenversorgung der Bundesbahnbeamten, die durch den auf der Grundlage von Repräsentativuntersuchungen ermittelten beihilfeentsprechenden Zuschuß des Bundes (§ 27 der Satzung) und den nach Absatz 2 bemessenen Beitrag der Mitglieder nicht gedeckt werden, gehen zu Lasten des Bundes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
