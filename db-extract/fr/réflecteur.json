                                                "example_id": "0e4af2a1-05ca-487b-8c82-3fbd112b1337",
                                                "sense_id": "e0c708d1-f28f-3905-bf94-e8b40a607fd1",
                                                "text": "При изготовлении рефлекторов для прожекторов фирмой «Рефлектор Синдикейт» в Лондоне в 1896 г. было применено палладирование."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d01ebe-996e-3631-b226-a38a31547ca7",
                                        "entry_id": "648bcccb-abfd-3e2c-80e4-ae01efb9dba9",
                                        "glosses": [
                                            "техн. устройство для направленного излучения или отражения радиоволн, расположенное вблизи антенны"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3f8432e-35bc-4936-a5f8-91e4404b01fe",
                        "source_entry_id": "12080d69-60bc-39a6-ae3c-7844f1d4e308",
                        "target_lang_word": "зеркало",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зеркало",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe3f3f0-781b-3cd7-b8b1-01481a498a6d",
                                        "entry_id": "d529731f-8e1d-319d-b15c-3c165dde836a",
                                        "glosses": [
                                            "оптический прибор с гладкой отражающей свет поверхностью, используемый в быту и технике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a94d9297-2c29-4980-bd3b-fddfeb0545b7",
                                                "sense_id": "2fe3f3f0-781b-3cd7-b8b1-01481a498a6d",
                                                "text": "Способность узнавать своё отражение в зеркале психологи считают одним из проявлений сознания."
                                            },
                                            {
                                                "example_id": "10c7f957-9dbe-493f-bd0b-43210768b4d5",
                                                "sense_id": "2fe3f3f0-781b-3cd7-b8b1-01481a498a6d",
                                                "text": "Я посмотрелся в зеркало; тусклая бледность покрывала лицо моё, хранившее следы мучительной бессонницы; но глаза, хотя окружённые коричневою тенью, блистали гордо и неумолимо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d9c87e-0b4c-3c39-8c06-1eaea10eb874",
                                        "entry_id": "d529731f-8e1d-319d-b15c-3c165dde836a",
                                        "glosses": [
                                            "перен. любая гладкая отражающая поверхность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471b3cca-74bc-4c36-a0e6-b6645b8fde1d",
                                                "sense_id": "83d9c87e-0b4c-3c39-8c06-1eaea10eb874",
                                                "text": "В зеркале пола отражалась висящая высоко над головами огромная люстра."
                                            },
                                            {
                                                "example_id": "1d4185c5-dbf7-4b70-b2cf-973114644174",
                                                "sense_id": "83d9c87e-0b4c-3c39-8c06-1eaea10eb874",
                                                "text": "Первым делом предстоит защитить от коррозии внутренние поверхности цилиндров (так называемые зеркала цилиндров)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ad28ef-a8cf-34e6-bc3b-493fc3b297e3",
                                        "entry_id": "d529731f-8e1d-319d-b15c-3c165dde836a",
                                        "glosses": [
                                            "перен., спец. совокупная поверхность водоёма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e74846d-4454-4912-ae5c-cf538d2a5be4",
                                                "sense_id": "a6ad28ef-a8cf-34e6-bc3b-493fc3b297e3",
                                                "text": "Противник прорвался к Волге ещё в нескольких местах, и всё зеркало реки простреливалось."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc8677dc-1444-38db-ac51-6be27ccf8482",
                                        "entry_id": "d529731f-8e1d-319d-b15c-3c165dde836a",
                                        "glosses": [
                                            "перен., комп. дублирующий сервер, диск или иной ресурс, хранящий те же данные и предоставляющий те же возможности, что и основное устройство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154e8a15-e6ef-4577-94b0-081aa981ff4b",
                                                "sense_id": "dc8677dc-1444-38db-ac51-6be27ccf8482",
                                                "text": "Зеркало сайта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd34758-b57d-3be8-8893-7187b26c21f9",
                                        "entry_id": "d529731f-8e1d-319d-b15c-3c165dde836a",
                                        "glosses": [
                                            "перен. то, что позволяет получить косвенное представление о каком-либо другом предмете или явлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9011c2-9577-425c-841b-8129a411aad1",
                                                "sense_id": "ebd34758-b57d-3be8-8893-7187b26c21f9",
                                                "text": "Глаза — зеркало души."
                                            },
                                            {
                                                "example_id": "a8aaff36-d80c-4647-abab-88f93aac6d50",
                                                "sense_id": "ebd34758-b57d-3be8-8893-7187b26c21f9",
                                                "text": "Китайцы доныне считают каллиграфию зеркалом характера человека."
                                            },
                                            {
                                                "example_id": "64e0300b-56f3-463f-a004-c60dcc4d4738",
                                                "sense_id": "ebd34758-b57d-3be8-8893-7187b26c21f9",
                                                "text": "Социально-экономическое состояние этого региона можно рассматривать как зеркало политики правительства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
