                            {
                                "example_id": "68f44302-f03c-4de0-82a7-849c8744f350",
                                "sense_id": "a293f3bf-215a-384c-9b25-71f37535b03d",
                                "text": "Dat betekent niet dat we als vakbond de digitalisering willen afblokken, maar het is aan de sociale partners en de overheid om preventief via vorming en begeleiding iedereen te helpen om vooruit te blijven gaan, terwijl digitalisering en nieuwe technologie hun intrede doen.’"
                            },
                            {
                                "example_id": "7baa189e-c94f-4474-bea2-9f03396d0245",
                                "sense_id": "a293f3bf-215a-384c-9b25-71f37535b03d",
                                "text": "We willen het gesprek gaande houden en niet afblokken."
                            },
                            {
                                "example_id": "85327b57-f286-460b-9816-2ff6badca9fd",
                                "sense_id": "a293f3bf-215a-384c-9b25-71f37535b03d",
                                "text": "De film bevat een scène waarin een twaalfjarige jongen voor een publiek van gelovigen een ter dood veroordeelde met een slagersmes de keel doorsnijdt. Het afblokken van de scène maakt het gevoel van weerzin en walging niet kleiner."
                            }
                        ]
                    },
