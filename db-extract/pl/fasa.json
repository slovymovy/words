                        "entry_id": "016fa21e-c008-3508-bb17-1e37cb34f7fd",
                        "glosses": [
                            "duże naczynie z drewnianych klepek do przechowywania produktów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b92fde-184c-42b0-b4fa-569c1ea1e256",
                                "sense_id": "bacf801a-3369-3b87-abd8-121d8f7ed2b9",
                                "text": "Ujrzał poza sobą stojącego mężczyznę ogromnych rozmiarów, pleców żubrzych, otyłego, z brzuchem jak fasa, z twarzą w trzech fałdzistych podbródkach…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e285d6fe-c284-38d2-b343-cf005fba1514",
                        "entry_id": "016fa21e-c008-3508-bb17-1e37cb34f7fd",
                        "glosses": [
                            "zawartość fasy (1.1), umowna miara pojemności"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "677fb2bc-fae4-4029-bea3-a16faaa59ee8",
                                "sense_id": "e285d6fe-c284-38d2-b343-cf005fba1514",
                                "text": "Na weselu cześnika i ciwunówny goście wypili wiele fas wina."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0a23c5f1-780a-3220-9597-26f77a759c47",
                        "entry_id": "016fa21e-c008-3508-bb17-1e37cb34f7fd",
                        "glosses": [
                            "naczynie wkopane w ziemię, używane do garbowania skór"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
