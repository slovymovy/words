                "translations": [
                    {
                        "translation_id": "0c92dd54-d49b-4dcc-8ddf-abadc26de6ce",
                        "source_entry_id": "c7a177ec-2e79-34bc-8214-dcb1ca4ee6fc",
                        "source_sense_id": "a3c0915a-bcf3-3101-94f3-237907c0df63",
                        "target_lang_word": "independence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "independence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                        "entry_id": "2bb25789-7500-3d06-bef3-0f525e1df21f",
                                        "glosses": [
                                            "The quality or state of being independent; lack of dependence; the state of not being reliant on, or controlled by, others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805f617e-c0d6-40ec-9bd6-8db60a98472c",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "In 1947, India gained independence from the British Empire."
                                            },
                                            {
                                                "example_id": "a060a286-f8e3-4ffa-bd8d-d77185f8d714",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "Bob the aforesaid, and his present chances of deriving a competent independence from the honourable profession to which he had devoted himself."
                                            },
                                            {
                                                "example_id": "82afc4d4-a9ee-4a45-bf45-e110901aa493",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "[…] I had achieved my own living, preserved my independence, and become indebted to no one."
                                            },
                                            {
                                                "example_id": "7414c5a6-bb4c-44a6-8d28-af5e4217c0a4",
                                                "sense_id": "11e9b95c-0875-3e81-955b-217746cd8715",
                                                "text": "And this year, some of the granite facades have a new addition - the blue and yellow of the flag of Ukraine. It's hardly surprising to see the Scots, a nation more attuned to independence than some, showing solidarity with a country brutally invaded by Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d158f20c-b5eb-3cad-b5c6-a428e5e64893",
                                        "entry_id": "2bb25789-7500-3d06-bef3-0f525e1df21f",
                                        "glosses": [
                                            "The state of having sufficient means for a comfortable livelihood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8268cd3d-62c3-4d78-ad70-8f88cb9a2f02",
                        "source_entry_id": "c7a177ec-2e79-34bc-8214-dcb1ca4ee6fc",
                        "source_sense_id": "a3c0915a-bcf3-3101-94f3-237907c0df63",
                        "target_lang_word": "self-reliance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-reliance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                        "entry_id": "042fc22f-948c-319d-a6cd-bbc59421eac8",
                                        "glosses": [
                                            "The capacity to rely on one's own capabilities, and to manage one's own affairs; independence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc6c0e5-e8c5-4a8a-be60-5622075cb80f",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "Loss of self-reliance leads to loss of self-confidence."
                                            },
                                            {
                                                "example_id": "306a76b7-3193-4f71-bcfb-816afa880e24",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "The present sorrow always exceeds its predecessors—not so the present joy; comparison exaggerates the one, while it diminishes the other; and people talk of their youth as if it had not been a period of feverish sensitiveness, awkward embarrassments, many heart-burnings, and an utter want of that self-reliance which alone can ensure content."
                                            },
                                            {
                                                "example_id": "b9cde9ad-9931-4005-ab3d-c2bf68dd9835",
                                                "sense_id": "ae524136-febc-3a5c-a9b9-cc3897ed12d1",
                                                "text": "A successful response uses social forces such as peer pressure and altruism to help people adapt to changing circumstances. It delivers messages and support that promote self-reliance rather than encourage people to fall back on stressed state support."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
