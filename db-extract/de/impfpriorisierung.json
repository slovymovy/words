                "senses": [
                    {
                        "sense_id": "c18f3298-ed69-3390-9c53-6db0b1386ce7",
                        "entry_id": "0dea113e-f74f-35fd-9f8a-f37357cd67d3",
                        "glosses": [
                            "Aussage darüber, wer (welche Gruppe) vor einem anderen (einer anderen Gruppe) einen (begrenzt zur Verfügung stehenden) Impftermin bekommt; Liste mit der Reihenfolge von Impflingen (Gruppen von zu impfenden Personen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8965bc50-bd74-455a-bc55-ed2978df6d4c",
                                "sense_id": "c18f3298-ed69-3390-9c53-6db0b1386ce7",
                                "text": "„Allerdings soll laut der SPD-Politikerin nicht die Impfpriorisierung zugunsten von Olympioniken aufgehoben werden.“"
                            },
                            {
                                "example_id": "b70978c7-d5e5-439c-9f30-78b71352186e",
                                "sense_id": "c18f3298-ed69-3390-9c53-6db0b1386ce7",
                                "text": "„Die Mediziner sollen eventuell auch die Möglichkeit bekommen, von den strengen Vorgaben der Impfpriorisierung abzuweichen, wenn sie dies aus ärztlicher Sicht für ratsam halten.“"
                            },
                            {
                                "example_id": "f381874e-ebed-4750-9661-ef0d7eb75097",
                                "sense_id": "c18f3298-ed69-3390-9c53-6db0b1386ce7",
                                "text": "„In der Impfpriorisierung stehen Hebammen inzwischen in der zweiten Kategorie.“"
                            },
                            {
                                "example_id": "9bf4398c-a026-497c-abf8-650b1c1ea8b2",
                                "sense_id": "c18f3298-ed69-3390-9c53-6db0b1386ce7",
                                "text": "„Weiterhin gilt für den Vogtlandkreis aufgrund der hohen Inzidenzzahlen eine Öffnung der Impfpriorisierung gemäß Impfverordnung des Bundes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
