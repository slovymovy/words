                "forms": [
                    {
                        "form_id": "88af44ee-6bcf-4a48-b8ee-1b4d63ad4da6",
                        "entry_id": "98dfa169-de7e-3614-974a-4eb69fb248fb",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "allègrement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72bb079f-d604-32e3-9b5d-30b8770bdaca",
                        "entry_id": "98dfa169-de7e-3614-974a-4eb69fb248fb",
                        "glosses": [
                            "D’une manière allègre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f48933b-5b75-4be2-8c2a-16cc665edeb8",
                                "sense_id": "72bb079f-d604-32e3-9b5d-30b8770bdaca",
                                "text": "Nous continuâmes notre voyage aussi allégrement que nous l’avions commencé, mais filant un peu plus droit vers le terme, où notre bourse tarissante nous faisait une nécessité d’arriver."
                            },
                            {
                                "example_id": "e9769aa7-324e-44e4-92db-469d6a132268",
                                "sense_id": "72bb079f-d604-32e3-9b5d-30b8770bdaca",
                                "text": "Je descendrai au tombeau très allégrement."
                            },
                            {
                                "example_id": "8c28d35d-295c-4cb0-afa3-f18e8f4dc781",
                                "sense_id": "72bb079f-d604-32e3-9b5d-30b8770bdaca",
                                "text": "Il marchait allégrement, ivre de vie et de jeunesse, dans les rues qui s’éveillaient."
                            }
                        ]
                    },
                    {
                        "sense_id": "592f83b4-84c3-3578-804e-565a5b7f8fe8",
                        "entry_id": "98dfa169-de7e-3614-974a-4eb69fb248fb",
                        "glosses": [
                            "Sans difficulté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b6109bff-a123-4f65-bcda-fc41a1fa49a5",
                                "sense_id": "592f83b4-84c3-3578-804e-565a5b7f8fe8",
                                "text": "Néanmoins, tant que l’industrie du tissage à la main fut prospère dans ces campagnes, c’est-à-dire jusqu’à 1872, le chômage agricole de l’hiver fut allégrement supporté."
                            },
                            {
                                "example_id": "c46ed135-d77b-4667-9de5-c95f87082dae",
                                "sense_id": "592f83b4-84c3-3578-804e-565a5b7f8fe8",
                                "text": "Les maîtres d’ouvrage publics sont habitués à ce que les montants des marchés publics de travaux dépassent – parfois d’ailleurs allégrement – le montant initial du marché du fait d’aléas, sujétions techniques imprévues ou encore simplement du fait de travaux supplémentaires indispensables."
                            }
                        ]
                    }
                ],
