        "nl-extract.jsonl": [
            {
                "entry_id": "280a17ea-f8e1-3537-a718-62bce8078e66",
                "word": "plausibiliteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "16574b4a-5d30-4306-a037-2745e0103a46",
                        "entry_id": "280a17ea-f8e1-3537-a718-62bce8078e66",
                        "tags": [
                            "plural"
                        ],
                        "form": "plausibiliteiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33d12b24-c4d3-3d58-a231-880088c7b472",
                        "entry_id": "280a17ea-f8e1-3537-a718-62bce8078e66",
                        "glosses": [
                            "hoe aannemelijk of waarschijnlijk het is dat iets ook in de werkelijkheid zo is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406b5a4d-57ca-4b37-b58d-ba5c6b5a103e",
                                "sense_id": "33d12b24-c4d3-3d58-a231-880088c7b472",
                                "text": "Het fenomeen is niet uniek, bij de meeste mensen verhoudt het geheugen zich niet 1:1 tot de objectieve waarheid en ons brein heeft de neiging om naar hartenlust met gebouwen en landschappen te schuiven (gelukkig meestal binnen de grenzen van een zekere plausibiliteit)."
                            },
                            {
                                "example_id": "3d7139b0-2f30-47ff-a443-d9d7338836b2",
                                "sense_id": "33d12b24-c4d3-3d58-a231-880088c7b472",
                                "text": "Volgens het ministerie van Volksgezondheid zijn de huisartsenverenigingen er verantwoordelijk voor de controle op de aantallen en kwaliteit van de tests. Die verenigingen wijzen dat van de hand, en zeggen dat hen niet is gevraagd \"de plausibiliteit van de aantallen\" te controleren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b25c6858-1838-4171-8919-4bbd0ea9c116",
                        "source_entry_id": "280a17ea-f8e1-3537-a718-62bce8078e66",
                        "source_sense_id": "33d12b24-c4d3-3d58-a231-880088c7b472",
                        "source_sense_description": "hoe aannemelijk of waarschijnlijk het is dat iets ook in de werkelijkheid zo is",
                        "target_lang_word": "plausibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plausibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The quality of deserving applause, praiseworthiness; something worthy of praise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f440a85-a4ec-435c-be71-e1bbac1db2ac",
                                                "sense_id": "548d7d87-ad84-385e-bea9-e5319a26dfe8",
                                                "text": "integrity, fidelity, and other gracious plausibilities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The appearance of truth, especially when deceptive; speciousness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61db0587-2281-4459-9435-46809b3ea56e",
                                                "sense_id": "72cd34ba-b4ac-344d-9cd8-e538ebcbfdcc",
                                                "text": "Plausibility, I know, can only be unmasked by shewing the absurdities it glosses over, and the simple truths it involves with specious errors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "A plausible statement, argument etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4190e124-957a-4108-adf9-720796e5b26d",
                                                "sense_id": "9e27195e-0c70-3a63-be4b-b21cfda5c7c4",
                                                "text": "She too must shimmer through the gloom o' the grave, / Come and confront me— […] / Striking me dumb, and helping her to speak, / Tell her own story her own way, and turn / My plausibility to nothingness!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                        "entry_id": "a4fac28f-d510-3694-a598-4771d7a8da94",
                                        "glosses": [
                                            "The fact of being believable; believability, credibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27289e7b-337e-496c-a0a9-1290465c1c74",
                                                "sense_id": "e8b7f3e9-2ee3-34d9-ac0a-d04b385d81a6",
                                                "text": "The question of the plausibility of the counter-factual is seen as key in all three discussions of allohistorical fiction (as it is in Demandt's and Ferguson's examinations of allohistory) (cf. Rodiek 25–26; Ritter 15–16; Helbig 32)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a816915-bc21-4c2e-9855-9bceaa360138",
                        "source_entry_id": "280a17ea-f8e1-3537-a718-62bce8078e66",
                        "source_sense_id": "33d12b24-c4d3-3d58-a231-880088c7b472",
                        "source_sense_description": "hoe aannemelijk of waarschijnlijk het is dat iets ook in de werkelijkheid zo is",
                        "target_lang_word": "probability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "probability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b62e8b4-b0ac-3074-a197-cf518f442d6d",
                                        "entry_id": "bf79dcf8-821a-3ae2-8a99-6a8ff5a662dc",
                                        "glosses": [
                                            "The state of being probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18478414-6f2b-4df4-bcfe-32a97582ecc1",
                                                "sense_id": "4b62e8b4-b0ac-3074-a197-cf518f442d6d",
                                                "text": "For, a man may with as great probability derive the Scots pedigree from the Gods, as from Scota that ſuppoſed and counterfeit daughter of the Ægyptian King Pharao, wedded (forſooth) unto Gaithelus, the ſonne of Cecrops founder of Athens. But, as this conceit ariſing from the unskilfulneſſe of Antiquitie, is of the better ſort of ingenuous Scots rejected: […]"
                                            },
                                            {
                                                "example_id": "f51ad5ac-198c-44cc-9f21-52b96892f2d2",
                                                "sense_id": "4b62e8b4-b0ac-3074-a197-cf518f442d6d",
                                                "text": "Thus, firſt Traditions were a proof alone; / Cou’d we be certain ſuch they were ſo known: / But ſince ſome Flaws in long deſcent may be, / They make not Truth but Probability."
                                            },
                                            {
                                                "example_id": "923d16a8-2aa5-44db-96c7-cbadc8efff51",
                                                "sense_id": "4b62e8b4-b0ac-3074-a197-cf518f442d6d",
                                                "text": "As Demonſtration is the ſhewing the agreement, or diſagreement of two Ideas, by the intervention of one or more Proofs, which have a conſtant, immutable, and viſible connexion one with another : ſo Probability is nothing but the appearance of ſuch an agreement, or diſagreement, by the intervention of Proofs, whoſe connexion is not conſtant and immutable, or at leaſt is not perceived to be ſo, but is, or appears for the moſt part to be ſo, and is enough to induce the Mind to judge the Propoſition to be true, or falſe, rather than the contrary."
                                            },
                                            {
                                                "example_id": "a2b819a6-fcd4-424d-99c8-18feb471c374",
                                                "sense_id": "4b62e8b4-b0ac-3074-a197-cf518f442d6d",
                                                "text": "Thus though this degree of faith is but one remove from disbelief, (denial) nevertheless as much probability is given to one side of the question as the other, and we stand, as it were, on an average between two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c7a38b-528f-367d-a8ad-9fde22343dd4",
                                        "entry_id": "bf79dcf8-821a-3ae2-8a99-6a8ff5a662dc",
                                        "glosses": [
                                            "An event that is likely to occur."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ba4cea-2616-4388-91f8-a8e4326b9e70",
                                                "sense_id": "78c7a38b-528f-367d-a8ad-9fde22343dd4",
                                                "text": "These waters wash from the rocks such glistering tinctures, that the ground in some places seemeth as guilded, that better iudgements then ours might haue been perswaded, they contained more then probabilities."
                                            },
                                            {
                                                "example_id": "9ba6e520-4e17-459c-a335-6bc7a94306bf",
                                                "sense_id": "78c7a38b-528f-367d-a8ad-9fde22343dd4",
                                                "text": "As all experience shows, the probabilities are, that you will waste the rich treasure of your affection on one who has none to give in return, or who is wholly unworthy of the gift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee1d74bf-6613-3c2d-b765-2eaf324fd87e",
                                        "entry_id": "bf79dcf8-821a-3ae2-8a99-6a8ff5a662dc",
                                        "glosses": [
                                            "The relative likelihood of an event happening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09088513-8056-4b4e-b1dd-3f4615d60e85",
                                                "sense_id": "ee1d74bf-6613-3c2d-b765-2eaf324fd87e",
                                                "text": "Hoyle said that the probability of life originating on Earth is no greater than the chance that a hurricane, sweeping through a scrapyard, would have the luck to assemble a Boeing 747."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a241bf-117f-392c-940b-6a138f333258",
                                        "entry_id": "bf79dcf8-821a-3ae2-8a99-6a8ff5a662dc",
                                        "glosses": [
                                            "A number, between 0 and 1, expressing the precise likelihood of an event happening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b75cf34-5555-4b5a-bc6e-6f1d855dbe7c",
                                                "sense_id": "f7a241bf-117f-392c-940b-6a138f333258",
                                                "text": "The probability of an event A occurring is denoted P(A)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
