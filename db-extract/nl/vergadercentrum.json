                        "examples": [
                            {
                                "example_id": "bd71624f-324c-41ae-a3f0-79ba166b0944",
                                "sense_id": "f6cd5ae6-8646-3326-8b36-28bb29874a65",
                                "text": "Dat er wel wordt geïnnoveerd in de bouw, is bijvoorbeeld te zien in het Gelderse Teuge. Daar wordt gebouwd aan een futuristisch vergadercentrum dat volledig uit een 3D-printer komt rollen: De Vergaderfabriek. De ronde en gebogen vormen zijn in de traditionele bouw nauwelijks te realiseren."
                            },
                            {
                                "example_id": "d44a7866-a994-4bdc-b41f-56fea6051c0c",
                                "sense_id": "f6cd5ae6-8646-3326-8b36-28bb29874a65",
                                "text": "Volgens het leger is het machtscentrum van IS in Libië, een groot vergadercentrum in de stad, ingenomen bij het meest recente offensief tegen IS. Ze zeiden dat de strijders van IS ook zijn verdreven uit het grootste ziekenhuis van Sirte, Ibn Sina."
                            }
                        ]
                    }
