                        "entry_id": "9724ba46-e307-36a4-a8f3-be8912df9859",
                        "glosses": [
                            "Se dit des églises, des lieux de culte où l'on fait des stations dans les temps de jubilé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54da0e71-e401-4554-9877-6cf49e3e99f2",
                                "sense_id": "da193088-94e5-3035-bb2c-fc1804c64f09",
                                "text": "Églises stationnales, celles qui, dans le temps du jubilé ou d'autres fêtes ecclésiastiques, sont marquées par les évêques pour les stations, c'est-à-dire pour recevoir les visites des fidèles."
                            },
                            {
                                "example_id": "9c5c6440-1fc9-4566-9807-05c922ac0fc6",
                                "sense_id": "da193088-94e5-3035-bb2c-fc1804c64f09",
                                "text": "Elle est ambulante en ce sens que, jour après jour, elle va dʼune église stationnale à lʼautre."
                            }
                        ]
                    }
                ],
