                                        "entry_id": "40931445-fa20-37f5-a38e-6548b58c9537",
                                        "glosses": [
                                            "als Schnittblume verwendete Pflanzenart aus der Familie der Korbblütler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "983ae142-de28-4d56-8dbd-45b15299e2f6",
                                                "sense_id": "e3660106-2a2c-361f-900d-659521e04e63",
                                                "text": "„›Jedenfalls muss ich die Gerbera jetzt von Hand gießen, mit dem Brauchwasser aus dem Badezimmer, dabei mögen Gerbera kein Seifenwasser, aber was soll man machen?‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96f38836-76e6-4610-9de2-0ba45d3dda28",
                        "source_entry_id": "71fdfd93-24eb-34db-a39d-3c178f4c93c2",
                        "source_sense_id": "5ecd3ce1-3ec6-398c-ad68-837cf07e4931",
                        "target_lang_word": "гербера",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гербера",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                        "entry_id": "f7274f5b-389c-3688-93af-afb530bddc60",
                                        "glosses": [
                                            "род многолетних трав семейства астровых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6002ac04-2361-4b21-83f4-f1ea16e44677",
                                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                                "text": "Повезло в цветочном магазине, куда только что привезли болгарские герберы .."
                                            },
                                            {
                                                "example_id": "6cfe1515-1ec8-45ce-adee-68e33c834713",
                                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                                "text": "Он покупал Светочке огромные букеты голландских роз и тюльпанов, клумбы гербер и вёдра декоративных ромашек."
                                            },
                                            {
                                                "example_id": "56fa5618-c2bb-4936-8236-c986af51b144",
                                                "sense_id": "9a75571d-a4b4-3612-8801-1fea6b1018ff",
                                                "text": "Хорошим подарком для учителя станет букет из таких традиционно популярных цветов, как розы, хризантемы, герберы, каллы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
