        "fr-extract.jsonl": [
            {
                "entry_id": "a188555e-70d2-3b6b-8238-b6a8b6567834",
                "word": "poisson-chat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "47881284-ca09-43c7-b6d0-780b809a7353",
                        "entry_id": "a188555e-70d2-3b6b-8238-b6a8b6567834",
                        "tags": [
                            "plural"
                        ],
                        "form": "poissons-chats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c0e23eb-b0d9-3621-a379-8fbed750ede4",
                        "entry_id": "a188555e-70d2-3b6b-8238-b6a8b6567834",
                        "glosses": [
                            "Nom vernaculaire de plusieurs genres de poissons d'eau douce de l’ordre des siluriformes, par exemple le poisson-chat commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc36e186-01c0-436a-962e-e6691e53fc59",
                                "sense_id": "4c0e23eb-b0d9-3621-a379-8fbed750ede4",
                                "text": "Ce jeudi, il s’active dans sa minuscule cuisine de célibataire, à faire cuire un poisson-chat accompagné de purée de pommes de terre, pendant qu’elle se livre à l’inventaire de son butin."
                            },
                            {
                                "example_id": "ed85711f-ff19-46b8-92e4-3abec2793bf5",
                                "sense_id": "4c0e23eb-b0d9-3621-a379-8fbed750ede4",
                                "text": "Il pêchait parfois dans le canal situé au-dessus du moulin, alimenté par la rivière, dans les grands calmes où les rotengles, les poissons-chats et les carpes venaient se nourrir de grains concassés en balançant leurs flancs dans la lumière."
                            },
                            {
                                "example_id": "49eb11dd-9de9-4198-a100-915fd9a2189b",
                                "sense_id": "4c0e23eb-b0d9-3621-a379-8fbed750ede4",
                                "text": "L’homme ne montra d’abord aucune réaction, sa bouche lippue et tombante lui donnait des allures de poisson-chat débonnaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "644fe9e4-a86c-47f6-8a23-30b048862bf3",
                        "source_entry_id": "a188555e-70d2-3b6b-8238-b6a8b6567834",
                        "source_sense_id": "4c0e23eb-b0d9-3621-a379-8fbed750ede4",
                        "target_lang_word": "catfish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "785c8185-54dd-389d-a808-4e7806199dc6",
                                        "entry_id": "d1cced99-d32e-3362-84aa-06579197fa1f",
                                        "glosses": [
                                            "Any fish of the order Siluriformes, mainly found in fresh water, lacking scales, and having barbels like whiskers around the mouth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327e1141-ad9b-4eb8-b81a-35d5efb78ba3",
                                                "sense_id": "785c8185-54dd-389d-a808-4e7806199dc6",
                                                "text": "“You don’t see catfish that big anymore, except in Chernobyl […] Nobody fishes there anymore, so the catfish thrive. They’ve gotten really enormous, some even twelve or thirteen feet long. They’re bottom-feeders, and apparently the mud still contains a lot of radioactive particles, but the catfish don’t seem to mind.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af07f53f-5dc7-3a68-beb3-5692057a3488",
                                        "entry_id": "d1cced99-d32e-3362-84aa-06579197fa1f",
                                        "glosses": [
                                            "The meat of such a fish, popular in the Southern U.S. and Central Europe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "catfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc37a83f-f9e8-321d-b7a0-1d9768da2750",
                                        "entry_id": "369d1fb4-b93f-31b4-a7ce-1fa5d4751417",
                                        "glosses": [
                                            "To fish for catfish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f252d77-00b6-4083-be23-7f7a0fd27014",
                                                "sense_id": "cc37a83f-f9e8-321d-b7a0-1d9768da2750",
                                                "text": "I only use this rod for catfishing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "catfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c12894-8865-300a-a258-7e30d6221b41",
                                        "entry_id": "89c83118-47d2-3d12-a673-443dd9f8b885",
                                        "glosses": [
                                            "Someone who creates a false profile on a social media platform in order to deceive people."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82714042-a7e1-4644-a76c-de6b91c8fb65",
                                                "sense_id": "e5c12894-8865-300a-a258-7e30d6221b41",
                                                "text": "Many online dating users create profiles on these online dating platforms looking for potential partners. However, they might end up meeting with users who have bad intentions, potential catfish. These catfish have begun pushing away potential, innocent users and possibly hindering the success of these online dating platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a41e1d07-1604-3bc5-8e22-60c89c8eaa3b",
                                        "entry_id": "89c83118-47d2-3d12-a673-443dd9f8b885",
                                        "glosses": [
                                            "Such a false profile."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "catfish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35644668-aae8-32d3-85e5-f9787c5dc08c",
                                        "entry_id": "dee2758a-28c1-3295-be58-005b8b56b77b",
                                        "glosses": [
                                            "To create and operate a fake online profile to deceive (someone)."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c156ef-f264-4576-9532-924b7be0028d",
                                                "sense_id": "35644668-aae8-32d3-85e5-f9787c5dc08c",
                                                "text": "Getting catfished is when someone falls for a person online who is not necessarily real. It can involve pictures, phone calls, social media profiles, text messages, e-mails and even phony friends or family members."
                                            },
                                            {
                                                "example_id": "a0f01be4-c625-4b24-80cf-6f96a7022612",
                                                "sense_id": "35644668-aae8-32d3-85e5-f9787c5dc08c",
                                                "text": "[to Abed] You made a profile for a fake dude and lured her into an online relationship. [to Annie] He's catfishing you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
