                            },
                            {
                                "target_word": "survey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3136ffe-0232-3b07-9418-0c75f84c2064",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To inspect, or take a view of; to view with attention, as from a high place; to overlook"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0789a5ba-e807-4e51-8278-5c30fa17f490",
                                                "sense_id": "a3136ffe-0232-3b07-9418-0c75f84c2064",
                                                "text": "He stood on a hill, and surveyed the surrounding country."
                                            },
                                            {
                                                "example_id": "7ce8bca3-92e0-41a1-9e6f-980dbd070416",
                                                "sense_id": "a3136ffe-0232-3b07-9418-0c75f84c2064",
                                                "text": "Round he ſurveys, and well might, where he ſtood / So high above[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d10e4eb-4855-334e-978a-17fe5acee81a",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To view with a scrutinizing eye; to examine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700ee531-fec4-490d-8230-29435a5c6485",
                                                "sense_id": "5d10e4eb-4855-334e-978a-17fe5acee81a",
                                                "text": "[…]with ſuch alter'd Looks,[…] / All pale, and ſpeechleſs, he ſurvey'd me round;"
                                            },
                                            {
                                                "example_id": "13227059-8d25-4ace-a95e-b0fbaf4b41c5",
                                                "sense_id": "5d10e4eb-4855-334e-978a-17fe5acee81a",
                                                "text": "By using the same classification system for all the dictionaries surveyed, it was possible to compare the lexical richness of each against the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789ad5aa-5db3-3f10-9875-3e4feea8c5ec",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To examine with reference to condition, situation, value, etc.; to examine and ascertain the state of"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4edf458c-b400-4d84-8d46-78c6cd3b1905",
                                                "sense_id": "789ad5aa-5db3-3f10-9875-3e4feea8c5ec",
                                                "text": "It was his job to survey buildings in order to determine their value and risks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eef4f211-240d-3d8c-90ec-507a41d957bf",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To determine the form, extent, position, etc., of, as a tract of land, a coast, harbor, or the like, by means of linear and angular measurements, and the application of the principles of geometry and trigonometry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faeeb755-bd0c-40f4-bbf5-a69b57423863",
                                                "sense_id": "eef4f211-240d-3d8c-90ec-507a41d957bf",
                                                "text": "to survey land or a coast"
                                            },
                                            {
                                                "example_id": "a008e271-b69b-4aef-a03c-fe6398dbb0e9",
                                                "sense_id": "eef4f211-240d-3d8c-90ec-507a41d957bf",
                                                "text": "The proposed route had been surveyed by George Stephenson and consisted of a main line 41⅝ miles in length with two short branches, to Norbury and Poynton Collieries, and to Chapel-en-le-Frith."
                                            },
                                            {
                                                "example_id": "9c54f5ee-eae2-4e62-81f8-da933097fb39",
                                                "sense_id": "eef4f211-240d-3d8c-90ec-507a41d957bf",
                                                "text": "He explained that engineers had been able to examine the bridge visually, and had started surveying likely sites for access roads and where to place the heavyweight crawler crane. NR was also ordering the aggregates needed for the access roads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c2d784-e400-3a3c-ad80-3a6bb14307a0",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To examine and ascertain, as the boundaries and royalties of a manor, the tenure of the tenants, and the rent and value of the same."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86513979-cbe4-485a-8748-fda459f8820a",
                                                "sense_id": "01c2d784-e400-3a3c-ad80-3a6bb14307a0",
                                                "text": "all the Tenants Leases and Copies are surveyed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f37b33a-8301-31f6-8fa3-9fb6675e552a",
                                        "entry_id": "c8257856-5086-394c-b0d0-ea3b005d8c7c",
                                        "glosses": [
                                            "To investigate the opinions, experiences, etc., of people by asking them questions; to conduct a survey; to administer a questionnaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57f63495-c842-47da-922a-1feca11433bb",
                        "source_entry_id": "95cf0f96-7a61-3c56-a5f0-5f0fbffe0a81",
                        "source_sense_id": "f1df62d1-782d-342e-8c40-958df78fd76d",
                        "target_lang_word": "examen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "examen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Observation attentive, réfléchie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f4dd1b-8cbc-449b-936a-fc6af6ec7f0e",
                                                "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                                "text": "C’est dans ce cas qu’une uro-IRM ou un uro-scanner, examens permettant de visualiser les voies urinaires, sont réellement utiles, pour effectuer la cartographie la plus précise possible avant d’opérer."
                                            },
                                            {
                                                "example_id": "e88f4588-dc25-4943-976d-1c6ca4ea9347",
                                                "sense_id": "672c13cb-c605-30bb-9e06-f60948ee8830",
                                                "text": "Soit les assauts du conquistador s'arrêtaient au seuil de la couche, soit, si la consommation avait lieu, se déchaînaient ensuite une succession interminable d’examens médicaux : sida, syphilis, gonocoque, staphylocoque et j'en passe..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3f3cc4d-bdfb-3530-bfde-e57fe3e64c8e",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Examen de conscience, introspection méditative effectuée dans un esprit religieux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b445355a-ffc5-4187-981e-7aaa3df583b4",
                                                "sense_id": "f3f3cc4d-bdfb-3530-bfde-e57fe3e64c8e",
                                                "text": "Comme premier point de l'examen, Ignace propose l'action de grâce et ensuite de demander la lumière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                        "entry_id": "b30a51d1-6286-3672-84ae-c605036ce46a",
                                        "glosses": [
                                            "Action de constater le degré d’instruction ou les aptitudes d’une personne par des épreuves écrites ou orales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa260a9-41b0-401f-9730-3b2701f2bc2f",
                                                "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                                "text": "Examen oral, examen écrit, examen physique."
                                            },
                                            {
                                                "example_id": "ca8c2d8f-9d05-463c-8cfb-323e0a22b635",
                                                "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                                "text": "Passer un examen, se préparer à un examen, réussir un examen, rater un examen"
                                            },
                                            {
                                                "example_id": "8b45c1c5-09b5-41f5-a0b9-6ef37ebc21ea",
                                                "sense_id": "33c54fe8-e418-39f1-9cd1-460655d34318",
                                                "text": "Examen du baccalauréat, de la licence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
