                        "glosses": [
                            "de keer dat men met een valscherm gebruikt bij het naar beneden springen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dda0e74-c5cd-4ec1-8169-b9490a2dc536",
                                "sense_id": "5aaa61b9-c0ed-3fae-a514-38ec9f05dfa3",
                                "text": "Starling, die bij de gootsteen stond, moest op dat moment meer moed verzamelen dan ze nodig had bij een parachutesprong."
                            },
                            {
                                "example_id": "df66ac13-4675-40f0-8151-6f8ddbc438eb",
                                "sense_id": "5aaa61b9-c0ed-3fae-a514-38ec9f05dfa3",
                                "text": "De Deense militair die afgelopen weekend om het leven kwam door een ongeval bij een parachutesprong boven Texel, raakte verstrikt in de lijnen van zijn parachute. Dat meldt een woordvoerder van de Koninklijke Marechaussee aan persbureau ANP."
                            },
                            {
                                "example_id": "8f9cdfe7-347f-4d30-8ce9-d22f7ca6198d",
                                "sense_id": "5aaa61b9-c0ed-3fae-a514-38ec9f05dfa3",
                                "text": "In België is een 65-jarige vrouw omgekomen bij een duo-parachutesprong. De 30-jarige instructeur met wie ze de sprong maakte is ernstig gewond geraakt en ligt in kritieke toestand in het ziekenhuis. Het ongeluk gebeurde in de Vlaamse gemeente Diest, in de buurt van Hasselt."
                            }
                        ]
                    }
