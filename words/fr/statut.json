                },
                {
                    "sense_id": "e15d4a90-5b9e-359e-a139-c47021772253",
                    "sense_definition": "Ensemble des règles fondamentales et obligatoires régissant la constitution et le fonctionnement d'une personne morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les associés fondateurs se sont réunis ce matin pour signer les <w>statuts</w> de l'entreprise."
                        },
                        {
                            "text": "Une assemblée générale extraordinaire est convoquée pour modifier les <w>statuts</w> de l'association."
