                                    {
                                        "sense_id": "84625c31-b36d-3b78-9607-c17dbce85076",
                                        "entry_id": "f94f110d-d910-3450-8979-192aa2bf9795",
                                        "glosses": [
                                            "gefühlte körperliche oder psychische Unstimmigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aaf35ef-ef6d-4d8f-8911-bf214696bd1e",
                                                "sense_id": "84625c31-b36d-3b78-9607-c17dbce85076",
                                                "text": "Katharina, überwältigt von Unwohlsein und Ohnmacht, erhielt endlich Erlaubniß, sich von dem furchtbaren Anblick zurückzuziehen, und …"
                                            },
                                            {
                                                "example_id": "2b8f332e-5676-424e-a44f-f1b5d3f9bd26",
                                                "sense_id": "84625c31-b36d-3b78-9607-c17dbce85076",
                                                "text": "Ein langes Unwohlsein das ihn in seinen Studien sehr zurückbrachte, hatte ihn veranlaßt, aufs Land zu gehen."
                                            },
                                            {
                                                "example_id": "50c8cae5-550a-413d-beaf-ac98f23dd38a",
                                                "sense_id": "84625c31-b36d-3b78-9607-c17dbce85076",
                                                "text": "Männer reagierten indes im umgekehrten Testfall nicht mit Unwohlsein und genössen es ganz im Gegenteil sogar, allein oder fast allein unter Frauen zu sein."
                                            },
                                            {
                                                "example_id": "53f51bb8-744f-483b-9114-0d66fd423881",
                                                "sense_id": "84625c31-b36d-3b78-9607-c17dbce85076",
                                                "text": "Auf dem zweiten Platz des Wettbewerbs landete das Adjektiv \"blümerant\". Es bezeichnet den Zustand eines leichten Unwohlseins und leitet sich vom französischen \"bleu mourant\" (\"sterbendes Blau\") her."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
