                "translations": [
                    {
                        "translation_id": "2d1d75d8-c7bc-4675-a719-794fa3298ed6",
                        "source_entry_id": "6ead6c96-3954-391c-ab68-fff911a2d6a9",
                        "source_sense_id": "ac5bfffb-e955-3456-be63-c2c9a98ab640",
                        "target_lang_word": "failliet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "failliet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                        "entry_id": "08178fb0-9db9-3046-aced-6bd71794b5ef",
                                        "glosses": [
                                            "in staat van faillissement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8173fd-7e06-4b1d-803e-567f91d72983",
                                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                                "text": "Het failliete bedrijf kon zijn schulden niet meer aflossen."
                                            },
                                            {
                                                "example_id": "48e6e2a5-b3a0-41d9-899c-d6eb3be87115",
                                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                                "text": "‘Er staat bijvoorbeeld dat we failliet gaan’, zegt Atasoy. ‘Dat is aantoonbaar onjuist. We hebben de rechter ook laten zien dat het niet klopt. Dan moet dat toch uit het rapport geschrapt worden?’"
                                            },
                                            {
                                                "example_id": "2ad206b4-da4d-4403-99ea-02f332e39986",
                                                "sense_id": "2beb69b9-8d72-34d3-bc38-d214234afb22",
                                                "text": "De Jonge Socialisten (JS), de jongerenafdeling van de PvdA, is zo goed als failliet door financieel wanbeheer, meldt NRC. Meer dan een ton aan uitgaven door twee voormalige penningmeesters is niet verantwoord, zegt het huidige JS-bestuur. De twee penningmeesters worden mogelijk juridisch vervolgd omdat niet duidelijk is waar meer dan een ton aan is uitgegeven, aldus de krant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c950d33b-b96c-467a-941a-69c4884f54ab",
                        "source_entry_id": "6ead6c96-3954-391c-ab68-fff911a2d6a9",
                        "source_sense_id": "ac5bfffb-e955-3456-be63-c2c9a98ab640",
                        "target_lang_word": "bankroet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bankroet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7106612e-8ab2-3797-99d7-b9f0ddb26730",
                                        "entry_id": "93c0910c-d25c-353c-b4a0-35b17c47d8fc",
                                        "glosses": [
                                            "de toestand van een rechtspersoon die, blijkens rechterlijk onderzoek, niet in staat is aan zijn financiële verplichtingen te voldoen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e5d8bf-a11f-471f-946c-535f3dd9994d",
                                                "sense_id": "7106612e-8ab2-3797-99d7-b9f0ddb26730",
                                                "text": "Na het bankroet van de bank konden veel mensen naar hun geld fluiten."
                                            },
                                            {
                                                "example_id": "6509db4f-c6b4-4c26-9f1e-e67b2d52910f",
                                                "sense_id": "7106612e-8ab2-3797-99d7-b9f0ddb26730",
                                                "text": "Bij een bankroet zijn de aandeelhouders, het personeel en de leveranciers vaak de slachtoffers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bankroet",
                                "target_lang_code": "nl",
                                "target_senses": [
