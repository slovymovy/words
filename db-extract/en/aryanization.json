                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40714971-d574-4905-bf21-43866929d293",
                                                "sense_id": "39405fb5-3e6b-3bf0-97e7-25888a9e603a",
                                                "text": "Henri Ardant, PDG de la Société générale, joua un rôle moteur dans l’« aryanisation » des banques françaises ainsi que des secteurs dans lesquels sa banque possédait des intérêts."
                                            },
                                            {
                                                "example_id": "c8ec31d6-340d-4cd8-b912-173c6028b62a",
                                                "sense_id": "39405fb5-3e6b-3bf0-97e7-25888a9e603a",
                                                "text": "Néanmoins, Vichy cherche à définir une aryanisation plus rationnelle."
                                            },
                                            {
                                                "example_id": "f5b674fa-7532-4cd0-b010-02ccd3ce810e",
                                                "sense_id": "39405fb5-3e6b-3bf0-97e7-25888a9e603a",
                                                "text": "Les commerçants et les patrons doivent eux-mêmes aller se déclarer au commissariat de leur quartier. C’est ce qu’on appelle « l’aryanisation des entreprises »."
                                            }
                                        ]
