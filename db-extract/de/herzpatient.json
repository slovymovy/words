                "senses": [
                    {
                        "sense_id": "681e6072-5096-3ec7-98c1-1267603d39ca",
                        "entry_id": "9de0a5f9-a6e4-3583-af90-2b11e7425667",
                        "glosses": [
                            "Patient, der an einer Herzerkrankung leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2430ac1f-814d-4dd5-a4f6-e719545fb2dd",
                                "sense_id": "681e6072-5096-3ec7-98c1-1267603d39ca",
                                "text": "Seit mehr als 130 Jahren wird Nitroglyzerin gegen Brustschmerzen bei Herzpatienten eingesetzt (Angina pectoris)."
                            },
                            {
                                "example_id": "eebc2c43-293e-4467-8731-6db7fba1ef13",
                                "sense_id": "681e6072-5096-3ec7-98c1-1267603d39ca",
                                "text": "„Wenn zum Beispiel ein Herzpatient in einem sehr schlechten Zustand ist, wird bei uns sehr schnell ein Kunstherz eingebaut.“"
                            },
                            {
                                "example_id": "c75327d4-4107-4002-8112-317df6a7f351",
                                "sense_id": "681e6072-5096-3ec7-98c1-1267603d39ca",
                                "text": "„An diesem Tag war es lange ruhig geblieben. Um halb sechs Uhr abends liefen die Drähte aber plötzlich heiss, und innert zwei Stunden musste Myles acht Fälle zur Priorität erklären – darunter war ein Herzpatient, eine Person mit Rückenverletzungen, eine weitere mit akuten psychischen Problemen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
