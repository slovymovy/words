                                        "entry_id": "7d270a8a-075d-3e7e-ab32-4c4ee7b94e21",
                                        "glosses": [
                                            "To evaluate one or more performers in through an audition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5540a77b-cc41-4612-bdcf-3ce3dc73dc13",
                                                "sense_id": "f17f8184-6a5b-3766-b6a7-03e05dc11479",
                                                "text": "We auditioned several actors for the part."
