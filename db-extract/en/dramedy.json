                ],
                "senses": [
                    {
                        "sense_id": "86a34ec3-ddda-314f-b2d6-41d46e2ec5a1",
                        "entry_id": "b4b3c0fc-cbb7-3516-ad6c-a782795868d4",
                        "glosses": [
                            "A genre of film or television that lies somewhere between drama and comedy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c9f3a8a0-d3d0-32dc-9c7f-f088c1488970",
                        "entry_id": "b4b3c0fc-cbb7-3516-ad6c-a782795868d4",
                        "glosses": [
                            "A film or television programme belonging to this genre."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd042dfd-f842-4307-a181-c907705a0e39",
                                "sense_id": "c9f3a8a0-d3d0-32dc-9c7f-f088c1488970",
                                "text": "”Fleabag,” Phoebe Waller-Bridge’s critically acclaimed British dramedy, featured a young woman whose strongest character trait — being horny — was decidedly not male."
                            },
                            {
                                "example_id": "874de5e9-4f15-4a10-94e1-8c02070caef4",
                                "sense_id": "c9f3a8a0-d3d0-32dc-9c7f-f088c1488970",
                                "text": "Last year, the Daily Mail found that Emily in Paris, a bubblegum dramedy starring Lily Collins, plugged 37 brands throughout 10 episodes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd746411-f39a-4f74-98d6-5dc31480e5bd",
