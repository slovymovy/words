                        "entry_id": "d983a4c3-108d-35c4-9130-9ff840836f3d",
                        "glosses": [
                            "Qui est moins coté que ce qui serait normalement mérité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c3733a-7950-42ce-800c-441660266720",
                                "sense_id": "762a2030-a804-3f44-bc7e-8f0e7ed081ba",
                                "text": "Dans le sport, on qualifie de « sous-coté » un joueur pas reconnu à sa juste valeur et n’ayant pas la faveur du public malgré son apport sur le terrain."
                            },
                            {
                                "example_id": "6f32d33e-bd93-49ca-96ad-ae0df60c5221",
                                "sense_id": "762a2030-a804-3f44-bc7e-8f0e7ed081ba",
                                "text": "Tous les chevaux montés par Yves Saint-Martin, ou, à Vincennes, drivés par Jean-René Gougeon, sont sous-cotés : le public plonge dessus en pleine confiance, sans même étudier leur chance."
                            },
                            {
                                "example_id": "b4aae3f1-47a7-4f28-bcf8-254f01cb65aa",
                                "sense_id": "762a2030-a804-3f44-bc7e-8f0e7ed081ba",
                                "text": "Feel Good, la série sous-cotée qu'il faut absolument regarder."
                            }
                        ]
                    }
