                "senses": [
                    {
                        "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                        "entry_id": "608d7c71-2822-3f6e-b166-890548275c99",
                        "glosses": [
                            "Beförderung von Postsachen durch ungelenkte Freiballons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654ffb9a-9318-410a-9851-55bcb876ee71",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "Der Aero-Philatelisten-Club Deutschland verschickt Ballonpost bei Veranstaltungen."
                            },
                            {
                                "example_id": "aee72407-1116-4486-aba0-8fc2476e14eb",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "Ballonpost wurde während des deutsch-französischen Kriegs 1870/71 verwendet."
                            },
                            {
                                "example_id": "5a6626b0-1e05-42f1-83bd-f8dc1e0ae128",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "„In umgekehrter Richtung, von Tours aus, funktionierte die Ballonpost nicht - aber einige der Brieftauben kehrten nach Paris zurück.“"
                            },
                            {
                                "example_id": "9fa39c42-f13c-414a-a14e-24f88bb385c5",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "„Der Brief ist an ein Fräulein in den Ort Le Vigan im Département Gard in Südfrankreich gerichtet und trägt die vorgeschriebene Beschriftung zur Beförderung als Ballonpost »Ballon monté«.“"
                            },
                            {
                                "example_id": "303dba25-e4cc-42f7-a4a3-f7349145ef78",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "„Eingebunden werden zur Abrundung der Ballongeschichte auch Ballonposten anderer Veranstalter oder Organisatoren in der zweiten Abteilung.“"
                            },
                            {
                                "example_id": "4cfa1c15-0893-47a1-89e7-ed0e9123332a",
                                "sense_id": "fddb521b-558d-3cad-9ed5-4b001ba2eec8",
                                "text": "„Niemand kann behaupten, es mangele an Literatur zur Ballonpost während des Deutsch-Französischen Krieges 1870/71.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0408de49-60f7-31ec-8433-07485db91918",
                        "entry_id": "608d7c71-2822-3f6e-b166-890548275c99",
                        "glosses": [
                            "durch Ballons befördertes Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb171605-56b5-43fb-9ac6-4f61814512f2",
                                "sense_id": "0408de49-60f7-31ec-8433-07485db91918",
                                "text": "„Die erste Ballonpost aus Deutschland stammt aus dem Juni 1897.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
