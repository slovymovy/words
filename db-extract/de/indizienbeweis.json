                        "entry_id": "83ad163c-275a-35c2-a1a2-7fb5a64b916e",
                        "glosses": [
                            "Beweis, der nicht direkt, sondern nur indirekt mit Hilfe von Anzeichen/Indizien geführt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de71039d-7e6f-4f31-b0fe-263e29f14eca",
                                "sense_id": "b9f1aacb-c139-35c1-a799-896103ed89f2",
                                "text": "„Sie gründen sich auf Indizienbeweise und nicht auf unmittelbares Textmaterial.“"
                            },
                            {
                                "example_id": "41e4b303-12a9-42b3-9bfb-fb548d4d89d7",
                                "sense_id": "b9f1aacb-c139-35c1-a799-896103ed89f2",
                                "text": "„Der Preis für die gerichtliche Wahrheitsfindung, die Indizienbeweise ohne Geständnis nicht anerkannte, war die Institutionalisierung der Folter zum Rechtsmittel.“"
                            }
                        ],
