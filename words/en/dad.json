    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3cb1e86-b585-38c1-aa4d-a0e6e463ed36",
                    "sense_definition": "A father; a male parent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>dad</w> drives me to school every morning.",
                            "target_lang_translations": {
                                "ru": "Мой <w>папа</w> отвозит меня в школу каждое утро.",
                                "zh": "我<w>爸爸</w>每天早上开车送我去学校。"
                            }
                        },
                        {
                            "text": "He loves being a <w>dad</w> and spending time with his children.",
                            "target_lang_translations": {
                                "ru": "Ему нравится быть <w>папой</w> и проводить время со своими детьми.",
                                "zh": "他很享受做<w>爸爸</w>，喜欢和孩子们待在一起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "father",
                        "daddy",
                        "papa",
                        "pop",
                        "pa"
                    ],
                    "antonyms": [
                        "mother",
                        "mom",
                        "mum"
                    ],
                    "common_phrases": [
                        "my dad",
                        "dad jokes",
                        "single dad",
                        "stay-at-home dad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отец; родитель мужского пола.",
                        "zh": "父亲；男性家长。"
                    },
                    "translations": {
