                    {
                        "translation_id": "8100b94b-faba-41f9-8e06-f6777b29f5de",
                        "source_entry_id": "3221c819-63f7-3d1a-a6e5-c7f6ed7d40bc",
                        "source_sense_id": "697de6bf-2ae0-38df-9785-f7f28a74aeab",
