                    "semantic_group_id": "changement_couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laissez <w>brunir</w> les oignons à feu doux pendant une dizaine de minutes."
                        },
                        {
                            "text": "Sa peau commence à <w>brunir</w> après seulement quelques jours passés au bord de la mer."
                        }
                    ],
                    "synonyms": [
