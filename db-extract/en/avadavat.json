                "senses": [
                    {
                        "sense_id": "9f3f21a2-1a16-3d01-b421-e4226cd283e9",
                        "entry_id": "39ad8316-9cfb-38cf-9a02-3be0984da1b8",
                        "glosses": [
                            "Any of various estrildid finches of the genus Amandava, especially the red avadavat, Amandava amandava, of India and Southeast Asia, commonly kept and bred as a cagebird; also known as Java sparrow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198e1710-e003-42b6-8bf5-4c7ca4d4b90f",
                                "sense_id": "9f3f21a2-1a16-3d01-b421-e4226cd283e9",
                                "text": "SIR OLIVER. What!—has he never transmitted—you—Bullion—Rupees—Pagodas!\nSURFACE. O Dear Sir—Nothing of the kind—no—no—a few Presents now and then—china, shawls, congo Tea, Avadavats—and indian Crackers—little more, believe me."
                            },
                            {
                                "example_id": "0d81e131-c1a5-42d7-9e72-1c82d9834778",
                                "sense_id": "9f3f21a2-1a16-3d01-b421-e4226cd283e9",
                                "text": "And now it has flown to new scenes of delight,\nWhere Venus's pigeons long cooing have sat,\nWhile Lesbia's famed sparrow with envy moults white"
                            },
                            {
                                "example_id": "366a544b-e3b8-4ea7-b75a-d1ca41b06822",
                                "sense_id": "9f3f21a2-1a16-3d01-b421-e4226cd283e9",
                                "text": "And the warm angled winter screen,\nOn which were many monsters seen,\nCall’d doves of Siam, Lima mice,\nAnd legless birds of Paradise,\nMacaw, and tender Avadavat,"
                            }
                        ]
                    }
                ],
