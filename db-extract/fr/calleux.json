                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1a610f-7392-4ef7-b900-7abfa5b0b61d",
                                                "sense_id": "0643622e-f2a8-36eb-8897-3e12709604b6",
                                                "text": "Hanson was beginning to feel annoyance at the suddenly cocksure and unsympathetic girl, but he stood fully erect and flexed his muscles. There wasn't even a trace of bedsoreness, though he had been flat on his back long enough to grow callouses."
