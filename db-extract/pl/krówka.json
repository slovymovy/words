                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef494a30-d18a-4108-b2c2-ecd4a0b57308",
                                                "sense_id": "f127b219-9669-3e91-a1a2-e0e9f932fc4e",
                                                "text": "Fudge! if you had such a fine instinct, why did you let us go to Transome Court and make fools of ourselves?"
                                            },
                                            {
                                                "example_id": "4e280c3e-c9e1-4a61-859c-d9363c2e13e6",
                                                "sense_id": "f127b219-9669-3e91-a1a2-e0e9f932fc4e",
                                                "text": "Pearl had to go home. Mike was one of the last of the good guys, so he said he'd run her on home. All Robert could say was, \"Ah, fudge.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f08db841-5bf7-3ddc-9cec-bf2d0ff45521",
                                        "entry_id": "c8aba2d1-aa3f-3cbd-bc29-aaf7684fed62",
                                        "glosses": [
                                            "Nonsense; tommyrot."
                                        ],
