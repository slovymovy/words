    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a2214d1-7216-31d6-b461-90c27fefe554",
                    "sense_definition": "Qui n'est pas présent dans un lieu où il devrait ou pourrait se trouver.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "non-presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a remarqué que trois élèves étaient <w>absents</w> ce matin."
                        },
                        {
                            "text": "Il est souvent <w>absent</w> du bureau en raison de ses nombreux déplacements professionnels."
                        }
                    ],
                    "antonyms": [
                        "présent"
                    ],
                    "common_phrases": [
                        "aux abonnés absents"
                    ]
                },
                {
                    "sense_id": "8e543b17-caea-3771-9675-d5f0a7efe1c5",
                    "sense_definition": "Qui fait défaut, qui n'existe pas ou n'apparaît pas dans un ensemble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "defaut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute forme de compassion semblait totalement <w>absente</w> de son discours."
                        },
                        {
                            "text": "Ce détail important est malheureusement <w>absent</w> de la version finale du rapport."
                        }
                    ],
                    "synonyms": [
                        "manquant"
                    ],
                    "antonyms": [
                        "présent"
                    ]
                },
                {
                    "sense_id": "a04c38fa-7a81-34b6-8163-b01867caae2b",
                    "sense_definition": "Qui a l'esprit ailleurs, distrait ou inattentif à ce qui se passe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inattention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avait l'air <w>absent</w> pendant que son collègue lui expliquait le projet."
                        },
                        {
                            "text": "Son regard <w>absent</w> montrait bien qu'il ne pensait plus du tout à la discussion."
                        }
                    ],
                    "synonyms": [
                        "distrait"
                    ],
                    "common_phrases": [
                        "air absent",
                        "regard absent"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b868b32-3df0-3b7c-9304-50ee8e69978a",
                    "sense_definition": "Personne qui n'est pas présente à un endroit ou à un événement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_non_presente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a dressé la liste des <w>absents</w> avant d'entamer la réunion."
                        },
                        {
                            "text": "Un proverbe bien connu affirme que les <w>absents</w> ont toujours tort."
                        }
                    ],
                    "antonyms": [
                        "présent"
                    ],
                    "common_phrases": [
                        "les absents ont toujours tort"
                    ]
                },
                {
                    "sense_id": "79de67ac-b4c5-3e54-94cd-9e4e34edcec9",
                    "sense_definition": "Personne dont on ignore où elle se trouve et dont l'existence est incertaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne_non_presente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal doit statuer sur la gestion des biens de l'<w>absent</w>."
                        },
                        {
                            "text": "La loi protège les intérêts patrimoniaux d'un <w>absent</w> jusqu'à son retour éventuel."
                        }
                    ]
                }
            ]
        }
    ]
