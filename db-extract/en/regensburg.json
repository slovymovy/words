                        "entry_id": "3480b3bd-6d3c-321e-8f62-b7b5f4ca1d25",
                        "glosses": [
                            "An independent city, the administrative seat of the Upper Palatinate region, on the River Danube in Bavaria, Germany; also called Ratisbon."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0948b07d-bd51-3024-ab9a-3a3a9b025107",
                        "entry_id": "3480b3bd-6d3c-321e-8f62-b7b5f4ca1d25",
                        "glosses": [
                            "A rural district of the Upper Palatinate region, Bavaria, surrounding but not including the town of Regensburg, which nevertheless serves as its administrative seat."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
