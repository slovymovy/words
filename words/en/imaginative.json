{
    "word_family": [
        "imagine",
        "imagination",
        "imaginary",
        "imaginably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c61ef885-2737-3a31-96ed-23fb4de92b57",
                    "sense_definition": "Having a lively or creative imagination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>imaginative</w> boy built a castle out of cardboard boxes.",
                            "target_lang_translations": {
                                "nl": "De <w>fantasierijke</w> jongen bouwde een kasteel van kartonnen dozen."
                            }
                        },
                        {
                            "text": "She is an <w>imaginative</w> artist who uses unusual materials in her work.",
                            "target_lang_translations": {
                                "nl": "Zij is een <w>creatieve</w> kunstenaar die ongebruikelijke materialen in haar werk gebruikt."
                            }
                        }
                    ],
                    "synonyms": [
                        "creative",
                        "inventive",
                        "original"
                    ],
                    "antonyms": [
                        "unimaginative"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beschikkend over een levendige of creatieve verbeeldingskracht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "fantasierijk",
                                "target_lang_sense_clarification": "Iemand die veel fantasie heeft."
                            },
                            {
                                "target_lang_word": "creatief",
                                "target_lang_sense_clarification": "Iemand die nieuwe dingen bedenkt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6cc95aa-9ca5-3207-b155-d46720480770",
                    "sense_definition": "Tending to be fanciful or inventive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote an <w>imaginative</w> story about life on another planet.",
                            "target_lang_translations": {
                                "nl": "De auteur schreef een <w>fantasierijk</w> verhaal over het leven op een andere planeet."
                            }
                        },
                        {
                            "text": "They came up with an <w>imaginative</w> solution to the difficult problem.",
                            "target_lang_translations": {
                                "nl": "Zij kwamen met een <w>vindingrijke</w> oplossing voor het moeilijke probleem."
                            }
                        }
                    ],
                    "synonyms": [
                        "fanciful",
                        "innovative"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geneigd om vernieuwend of vindingrijk te zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vindingrijk",
                                "target_lang_sense_clarification": "Goed in het bedenken van oplossingen."
                            },
                            {
                                "target_lang_word": "innovatief",
                                "target_lang_sense_clarification": "Vernieuwend en origineel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d377b85f-9b7a-3313-afa7-c87ce1dc1133",
                    "sense_definition": "False or imagined.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was punished for his <w>imaginative</w> excuses about why he was late.",
                            "target_lang_translations": {
                                "nl": "Het kind werd gestraft voor zijn <w>verzonnen</w> excuses over waarom hij te laat was."
                            }
                        },
                        {
                            "text": "These fears are purely <w>imaginative</w> and have no basis in reality.",
                            "target_lang_translations": {
                                "nl": "Deze angsten zijn puur <w>denkbeeldig</w> en hebben geen basis in de werkelijkheid."
                            }
                        }
                    ],
                    "synonyms": [
                        "fictitious",
                        "unreal"
                    ],
                    "antonyms": [
                        "real",
                        "factual"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet gebaseerd op de werkelijkheid; verzonnen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verzonnen",
                                "target_lang_sense_clarification": "Niet echt, uit de duim gezogen."
                            },
                            {
                                "target_lang_word": "denkbeeldig",
                                "target_lang_sense_clarification": "Alleen in de geest bestaand."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}