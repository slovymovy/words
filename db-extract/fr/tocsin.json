                                        "sense_id": "e6253a57-4925-3fbc-a549-f0ebf9c1d32f",
                                        "entry_id": "abe3dff7-44f3-3368-9e08-ebb1abc26613",
                                        "glosses": [
                                            "bestimmte Glocke (innerhalb einer Siedlung), die bei drohender Gefahr Sturm (mehrmals schnell hintereinander) geläutet wird"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311f45c6-d55a-42f5-926e-6a16d854c2ef",
                                                "sense_id": "e6253a57-4925-3fbc-a549-f0ebf9c1d32f",
                                                "text": "„Die Nacht war angebrochen, aus allen Städten und Dörfern schallten die Sturmglocken, und zahllose Wachtfeuer brannten ringsumher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ef4b9c-61a6-41cd-bbf2-59b7058ec567",
