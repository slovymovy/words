                        "entry_id": "6cca775f-42c6-32a9-9d15-f0bc2d231efd",
                        "glosses": [
                            "A loud, deep, prolonged sound, as of a large beast; a roar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "55581106-01d5-43d2-b285-dc1f0641fa9b",
                                "sense_id": "28fede79-d6da-3ba1-b86e-fcc4a5f4ca24",
                                "text": "[…] those wild eyes that watch the wave\nIn roarings round the coral reef."
                            }
                        ]
                    },
                    {
                        "sense_id": "720215d0-c104-3da5-bc94-33a2184fe398",
                        "entry_id": "6cca775f-42c6-32a9-9d15-f0bc2d231efd",
                        "glosses": [
                            "An affection of the windpipe of a horse, causing a loud, peculiar noise in breathing under exertion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9014d7e-cdc9-4f6d-8e8e-9ade8eb2eddc",
                        "source_entry_id": "6cca775f-42c6-32a9-9d15-f0bc2d231efd",
                        "source_sense_description": "a loud, deep, prolonged sound",
                        "target_lang_word": "Gebrüll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebrüll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                        "entry_id": "8f93c8e8-2d9b-3133-ab27-eaa7ceecae77",
                                        "glosses": [
                                            "ein sehr lautes, oft lang anhaltendes Geräusch eines oder mehrerer Menschen sowie einiger Tierarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db41bc0-53c0-4c8a-a11d-510dbcb24491",
                                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                                "text": "Mit deinem Gebrüll weckst du noch die Kinder."
                                            },
                                            {
                                                "example_id": "c816fd9b-630a-485c-930b-ed18590e31f1",
                                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                                "text": "Das Gebrüll der Tiere schreckte uns hoch."
                                            },
                                            {
                                                "example_id": "e40d9c9a-cc0b-475c-a2d8-19dc4a2c9353",
                                                "sense_id": "1c8f36d2-0f30-3448-91fc-79c1ddaab002",
                                                "text": "„Und so zogen wir unsere Rucksäcke über und spazierten einfach ins Freie und gingen hinüber nach Cochem, als ginge uns das ganze Gebrüll und Geschrei des Herbergsvaters einfach nichts an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
