                "forms": [],
                "senses": [
                    {
                        "sense_id": "d59e5220-bb68-3006-8a51-96b6ca32789f",
                        "entry_id": "5449c601-a2c7-3cdd-9592-6892e2b6ec39",
                        "glosses": [
                            "Of, pertaining to, derived from, or possessed by, an ancestor or ancestors"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ca2be84-aeb0-49d1-81d1-af5ad4f7df3a",
                                "sense_id": "d59e5220-bb68-3006-8a51-96b6ca32789f",
                                "text": "an ancestral estate"
                            },
                            {
                                "example_id": "3e5e1b93-de1d-4fb2-ab31-cdc577a0b1dc",
                                "sense_id": "d59e5220-bb68-3006-8a51-96b6ca32789f",
                                "text": "one’s ancestral home"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af71a1df-22c5-4a8c-adf1-8fd8d2e643a0",
                        "source_entry_id": "5449c601-a2c7-3cdd-9592-6892e2b6ec39",
                        "source_sense_id": "d59e5220-bb68-3006-8a51-96b6ca32789f",
                        "source_sense_description": "pertaining to ancestors",
                        "target_lang_word": "ancestral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancestral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12100b04-4104-38ef-961b-8f67ebc46375",
                                        "entry_id": "cf89a7f2-3fd6-3e14-814a-e9d83ef344b9",
                                        "glosses": [
                                            "Qui a rapport aux ancêtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47111e13-3f77-4406-9dd8-1f2c64d17f3d",
                                                "sense_id": "12100b04-4104-38ef-961b-8f67ebc46375",
                                                "text": "Mœurs, influences ancestrales."
                                            },
                                            {
                                                "example_id": "9f2c70a3-65d2-420e-93fc-ba61a8ccd8e5",
                                                "sense_id": "12100b04-4104-38ef-961b-8f67ebc46375",
                                                "text": "En outre, la certification par le Président de la Commission Nationale sur les Peuples Autochtones d’une zone comme appartenant au territoire ancestral a pour effet d’invalider les bases légales des compétences antérieures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af364ec-4982-3f13-a64f-772cdad92816",
                                        "entry_id": "cf89a7f2-3fd6-3e14-814a-e9d83ef344b9",
                                        "glosses": [
                                            "Très ancien."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eea4277-111c-4307-a0d9-e1a497de0550",
                                                "sense_id": "5af364ec-4982-3f13-a64f-772cdad92816",
                                                "text": "Il convient cependant de se montrer prudent dans la mesure où une croyance ancestrale faisait de ces haches des « pierres de tonnerre » tombées du ciel les soirs d'orage. Souvent découvertes à l'occasion des labours, elles étaient précieusement conservées et déposées sous le seuil des maisons ou à la base des toits."
                                            },
                                            {
                                                "example_id": "f38b6e18-9cc8-4ded-bf64-bcc84f2ed861",
                                                "sense_id": "5af364ec-4982-3f13-a64f-772cdad92816",
                                                "text": "Un développeur a trouvé un moyen pour continuer à recevoir et installer des patchs logiciels pour ce système d’exploitation ancestral."
                                            },
                                            {
                                                "example_id": "153a09f5-3ac8-4cf4-b319-e88d7314b2d1",
                                                "sense_id": "5af364ec-4982-3f13-a64f-772cdad92816",
                                                "text": "Or, selon certains linguistes, « tik » était l'un des premiers mots inventés par l'humanité. Dans le vocabulaire ancestral, il aurait signifié « doigt ». — (Xavier Müller, Erectus, XO éditions, 2018)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
