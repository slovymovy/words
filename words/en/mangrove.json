                                "target_lang_sense_clarification": "растение из семейства мангровых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac265ae8-968f-3e3d-977f-0fec0ce83084",
                    "sense_definition": "A dense forest or swamp consisting of mangrove trees",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mangrove_ecosystem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team found a new species of spider living deep within a <w>mangrove</w> forest.",
                            "target_lang_translations": {
                                "ru": "Команда обнаружила новый вид паука, обитающего глубоко в <w>мангровом</w> лесу."
                            }
                        },
                        {
                            "text": "Many small fish find shelter among the roots in the coastal <w>mangrove</w>.",
                            "target_lang_translations": {
                                "ru": "Многие мелкие рыбы находят убежище среди корней в прибрежных <w>манграх</w>."
                            }
                        }
