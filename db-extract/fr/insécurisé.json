                        "entry_id": "ea0e5731-97fa-38c7-8104-cdbf059e848e",
                        "glosses": [
                            "Qui ne se trouve pas dans une situation sécurisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e966e362-9a75-446e-9968-26b1a74fe41f",
                                "sense_id": "621b265b-4a46-3cdf-8840-0506fe6258c8",
                                "text": "Car celui-ci, bourgeois (et notre jeune ingénieur en adopte la façon d’être), diffère assurément du chevalier, de l’aventurier ; il est venu et a vaincu tel l’opposé de ce dernier ; il ne cherche pas la vie insécurisée, mais il la craint, s’effraie de ce qui bondit devant lui au cours de la chasse."
                            }
                        ]
                    }
