                "senses": [
                    {
                        "sense_id": "2b5657b2-5de9-30ef-bfc4-bf18321eca8f",
                        "entry_id": "d54aa94c-cc18-39b6-a158-4a16cb0b7f15",
                        "glosses": [
                            "Person, die nicht schwimmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52dc472a-c28a-48a2-b5d8-68fefd28d79e",
                                "sense_id": "2b5657b2-5de9-30ef-bfc4-bf18321eca8f",
                                "text": "Nichtschwimmer sollten nur unter Aufsicht im Wasser spielen."
                            },
                            {
                                "example_id": "3eba7082-dc96-4482-968b-fffd77ef05aa",
                                "sense_id": "2b5657b2-5de9-30ef-bfc4-bf18321eca8f",
                                "text": "[2022:] „Die Zahl der Nichtschwimmer im Grundschulalter hat sich binnen fünf Jahren verdoppelt.“"
                            },
                            {
                                "example_id": "05537ef9-a6e9-4419-9f29-37fa9e6a4696",
                                "sense_id": "2b5657b2-5de9-30ef-bfc4-bf18321eca8f",
                                "text": "„Die DRLG warnt vor einer wachsenden Zahl von Nichtschwimmern.“"
                            },
                            {
                                "example_id": "2c0de810-c353-4741-a0b9-3e93395d8023",
                                "sense_id": "2b5657b2-5de9-30ef-bfc4-bf18321eca8f",
                                "text": "„In ärmeren Haushalten gibt es der Umfrage zufolge viel mehr Nichtschwimmer:“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
