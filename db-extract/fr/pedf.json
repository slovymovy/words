                        "glosses": [
                            "Protéine (serpine) qui a des propriétés anti-angiogéniques, anti-tumorigènes et neurotrophiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a395e0-5a0a-4ed6-8938-9a44e738d460",
                                "sense_id": "8eaf7835-3093-318a-bd3a-e7b52d631134",
                                "text": "Des études sont réalisées visant non plus à introduire un gène mais un gène curatif de l’anomalie génétique associé à un facteur neuro-protecteur, voire deux substances neuro-protectrices telles que le PEDF et le FGF2."
                            },
                            {
                                "example_id": "96dc7492-5517-485d-9749-d14b58e5e51f",
                                "sense_id": "8eaf7835-3093-318a-bd3a-e7b52d631134",
                                "text": "Le PEDF (pigment epithelium derived factor) est un facteur anti-angiogénique normalement sécrété par l’épithélium pigmentaire, qu’il est possible d’administrer par thérapie génique."
                            },
                            {
                                "example_id": "94b58951-f4a3-44d1-b668-6722816990f6",
                                "sense_id": "8eaf7835-3093-318a-bd3a-e7b52d631134",
                                "text": "Le PEDF (Pigment Epithelium Derived Factor) est en cours d’étude."
                            }
                        ]
                    }
