                "senses": [
                    {
                        "sense_id": "cf64a397-9f5d-3b26-a344-79edf89d3684",
                        "entry_id": "24590836-b3a9-33c1-bbf0-cb93c60bc4c2",
                        "glosses": [
                            "kleiner Schritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcfdaa4d-d8a9-401d-a19e-f1ab649ca0c1",
                                "sense_id": "cf64a397-9f5d-3b26-a344-79edf89d3684",
                                "text": "„Ein mehr oder weniger geordneter Staatsbankrott Griechenlands wäre nur ein Trippelschritt bei der Rettung des Euro…“"
                            },
                            {
                                "example_id": "1490ad98-6d5b-4f8d-8ef0-ac75377aa933",
                                "sense_id": "cf64a397-9f5d-3b26-a344-79edf89d3684",
                                "text": "„Bei den Frauen waren Kleider in Mode gekommen, die so eng waren, daß man darin nur Trippelschritte machen konnte.“"
                            },
                            {
                                "example_id": "c9168f23-6de6-46a6-b255-dacc853c1990",
                                "sense_id": "cf64a397-9f5d-3b26-a344-79edf89d3684",
                                "text": "„Der Mann empfand ein tiefes Gefühl des Glücks, als er der Kleinen, die mit schnellen Trippelschritten ihrer Mutter entgegeneilte, nachschaute.“"
                            },
                            {
                                "example_id": "27213f08-9a21-4fea-9730-4f7e76493dc9",
                                "sense_id": "cf64a397-9f5d-3b26-a344-79edf89d3684",
                                "text": "„Er bewegte sich mit langsamen Trippelschritten in ihren Kreis, streckte seine Arme und schnippte dazu im Takt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
