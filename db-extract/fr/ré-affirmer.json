                "senses": [
                    {
                        "sense_id": "4f3f70c8-503c-3960-a346-381876ede5aa",
                        "entry_id": "75f3f3c8-9faa-3f08-8729-c9482975b8d8",
                        "glosses": [
                            "Variante rare de réaffirmer, utilisée pour bien mettre l’accent à la fois sur le préfixe et sur le verbe de base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5166b895-403a-4ff3-9f5c-b472e4bc2144",
                                "sense_id": "4f3f70c8-503c-3960-a346-381876ede5aa",
                                "text": "Nul n'est contraint certes d'affirmer, mais nul n'est contraint non plus de ré-affirmer."
                            },
                            {
                                "example_id": "1e7af2f7-fa75-4d26-8a00-b18712e2165a",
                                "sense_id": "4f3f70c8-503c-3960-a346-381876ede5aa",
                                "text": "N'importe quelle philosophie nomade de la viabilité digne de ce nom doit partir de cette hypothèse et la ré-affirmer comme une valeur fondamentale."
                            }
                        ]
                    }
