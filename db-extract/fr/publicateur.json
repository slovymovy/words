                ],
                "senses": [
                    {
                        "sense_id": "45b7cdab-4a5d-3a96-b229-a369eed17d39",
                        "entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "glosses": [
                            "Celui qui publie, qui fait une publication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f1b9bb-18fc-49ea-a224-f61f4fd61204",
                                "sense_id": "45b7cdab-4a5d-3a96-b229-a369eed17d39",
                                "text": "L'article 7 de la loi du 6 juillet 1871 sur la presse, en édictant que le publicateur et l'imprimeur seront solidairement responsables des amendes."
                            },
                            {
                                "example_id": "b339c6ee-21eb-4a19-9cee-e1a4399a7b70",
                                "sense_id": "45b7cdab-4a5d-3a96-b229-a369eed17d39",
                                "text": "Le publicateur anglais n’était pas chez lui, il était chez la marquise du Châtelet, où l’on causait théâtre autour d’une tasse de chicorée."
                            }
                        ]
                    },
                    {
                        "sense_id": "47c76ccb-efe7-3b39-b50e-01a9472b0ec3",
                        "entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "glosses": [
                            "Personne chargée de gérer un contenu éditorial (textes-images) afin de l'adapter et de le préparer pour une diffusion sur plusieurs supports."
                        ],
                        "tags": [
                            "Infographie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a64a707-4b51-449b-ad19-acbea070874d",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Editor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Editor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51fa1eaf-906b-399a-a3e2-35c660c1e782",
                                        "entry_id": "992c6478-ed98-3ba9-9837-12b3e05dd014",
                                        "glosses": [
                                            "Person, die ein Buch, eine Textsammlung herausgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4289f250-18af-4b53-b907-4afab0b2fed1",
                                                "sense_id": "51fa1eaf-906b-399a-a3e2-35c660c1e782",
                                                "text": "Kannst du mir den Editor der geplanten Veröffentlichung sagen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Editor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                        "entry_id": "1f0636cd-d99c-3a18-bc1e-fe8fb4f0908a",
                                        "glosses": [
                                            "Bearbeitungssoftware; ein rechnergestütztes Programm für die Bearbeitung digitaler Daten"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7530a237-3afb-40fd-8306-9ff262b2550c",
                                                "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                                "text": "Ich komme mit dem Editor nicht gut zurecht."
                                            },
                                            {
                                                "example_id": "12b9cc09-5768-4489-a397-3494d3781185",
                                                "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                                "text": "Starte bitte den Editor und öffne damit eine Textdatei."
                                            },
                                            {
                                                "example_id": "3d33cffe-7f74-4f67-837c-b8f4d9b122db",
                                                "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                                "text": "Es gibt Editoren für die Bearbeitung von Grafiken, Filmen, Musik und vieles mehr."
                                            },
                                            {
                                                "example_id": "408f7467-0620-43ae-9c5b-49209a372f46",
                                                "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                                "text": "Der erste Editor war ein Texteditor."
                                            },
                                            {
                                                "example_id": "91f5e10a-ed48-4f2e-8cf6-d434b581e542",
                                                "sense_id": "840b89a9-6312-31bd-89a6-5058ae6553b4",
                                                "text": "Neben vi unter UNIX-ähnlichen Systemen und dem heute üblichen Editor Notepad bei Windows gibt es viele weitere Texteditoren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f16c2cd-4661-422e-a4a3-8c9fc9f7225d",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Editorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Editorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fef433d0-4ef2-36d5-89b6-a86876ac8538",
                                        "entry_id": "9bc12a76-df52-3a59-aa46-df7bfe1bacdd",
                                        "glosses": [
                                            "weibliche Person, die ein Buch, eine Textsammlung herausgibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6474be88-5127-4538-b4ec-9540faed6809",
                                                "sense_id": "fef433d0-4ef2-36d5-89b6-a86876ac8538",
                                                "text": "Sie arbeitet in mehreren Berufen zugleich, bekleidet Lehraufträge, wird Lektorin beim Stadtverlag und fungiert dort auch als Editorin verschiedener Schriften von Autoren, die sie unterstützen möchte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98228160-8bb5-4c5e-b6a8-40e2fe0f65b5",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Herausgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herausgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "eine Person oder Personengruppe, die für die Veröffentlichung von künstlerischen oder wissenschaftlichen Werken in Wort, Schrift, Ton oder Bild rechtlich und publizistisch verantwortlich zeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c604b89d-2134-42ce-9f5f-64871590111e",
                                                "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                                "text": "Ist kein Herausgeber angegeben, so wird vermutet, daß der Verleger ermächtigt ist."
                                            },
                                            {
                                                "example_id": "8a29ef0a-2765-4a93-bf4b-c9b2c15aaceb",
                                                "sense_id": "1b549e6b-0e3c-3876-be16-173d118a2c4f",
                                                "text": "Ich halte es für ehrlicher, wenn sich von nun an die Verleger ›Herausgeber‹ nennen. Denn näher betrachtet sind sie es."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "eine Person, die die journalistische Leitlinie eines periodischen Mediums (Zeitschrift etc.) bestimmt und deren Umsetzung überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df522d3f-e7a7-44f6-b7d9-323f1358155c",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "Im Sinn der Bestimmungen dieses Bundesgesetzes ist … 9. \"Herausgeber\": wer die grundlegende Richtung des periodischen Mediums bestimmt; …"
                                            },
                                            {
                                                "example_id": "7cec457e-289c-4464-8600-02b8b1630d9d",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "Auf jedem periodischen Medienwerk sind zusätzlich die Anschriften des Medieninhabers und der Redaktion des Medienunternehmens sowie Name und Anschrift des Herausgebers anzugeben."
                                            },
                                            {
                                                "example_id": "3ca04e3a-a314-4b25-9264-5f6042b97f79",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "„Ich betrat das Haus, und die Dienerin zeigte mir das Zimmer, in dem der Herausgeber Jacquet ganz allein an seiner Zeitung arbeitete; es lag im Erdgeschoß, und die Tür war wegen der Hitze offen.“"
                                            },
                                            {
                                                "example_id": "2bad2a6e-7faf-4fd0-a001-30378ae4137c",
                                                "sense_id": "87a09f4c-bcca-30b1-bafb-89d4fe7ee43b",
                                                "text": "„Als Herausgeber eines populären Journals führt Wieland eine umfangreiche und vielfältige Korrespondenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                        "entry_id": "5546d820-f3b3-3872-bda9-f3225e3877b1",
                                        "glosses": [
                                            "Emittent einer Wandelanleihe oder einer Umtauschanleihe"
                                        ],
                                        "tags": [
                                            "Wertpapierrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e370d53-8af1-4a5a-835a-0de749fdc064",
                                                "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                                "text": "Der Herausgeber sichert dem Anleiheninhaber eine feste Laufzeit und einen festen Zinssatz zu, der deutlich unterhalb des Kapitalmarktzinses liegt."
                                            },
                                            {
                                                "example_id": "2a6a09ce-b2db-4ed1-a26f-58024902127e",
                                                "sense_id": "09bf987b-e408-3e83-b176-5eedd7688162",
                                                "text": "Die Ausfertigungen der Edikte und die Mitteilungen über Verlustanzeigen sind dem Herausgeber erst zu übersenden, wenn das Entgelt für die Einschaltung entrichtet worden ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b370d8d6-f108-49ad-b886-be4087aa650c",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Herausgeberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herausgeberin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8005ce14-8efb-3384-ad77-4d09bc3e1078",
                                        "entry_id": "8849b2e4-864f-3373-841b-14a4435850a5",
                                        "glosses": [
                                            "weibliche Person, die für die Veröffentlichung von künstlerischen oder wissenschaftlichen Werken in Wort, Schrift, Ton oder Bild rechtlich und publizistisch verantwortlich zeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f837b5-64a4-44e1-9924-5267035083de",
                                                "sense_id": "8005ce14-8efb-3384-ad77-4d09bc3e1078",
                                                "text": "Sie zeichnet als Herausgeberin des Jahrbuches verantwortlich für den Inhalt."
                                            },
                                            {
                                                "example_id": "35e38b20-822a-4059-8146-703a5974365c",
                                                "sense_id": "8005ce14-8efb-3384-ad77-4d09bc3e1078",
                                                "text": "„Sylvia blickte sich um, ob sie die beiden Herausgeberinnen in der Menge entdecken konnte, doch sie waren nicht zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3bd7435d-3a2a-3dab-be8d-196083cc98fe",
                                        "entry_id": "8849b2e4-864f-3373-841b-14a4435850a5",
                                        "glosses": [
                                            "weibliche Person, die die journalistische Leitlinie eines periodischen Mediums (Zeitschrift und weitere) bestimmt und deren Umsetzung überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17483f94-0991-45a5-95d9-292de31316d0",
                                                "sense_id": "3bd7435d-3a2a-3dab-be8d-196083cc98fe",
                                                "text": "Immer wieder versuchte die Herausgeberin, sich in die journalistische Berichterstattung einzumischen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f052069-a3a1-4fd5-b01f-23ce83398c67",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Verleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                        "entry_id": "a6fc243d-9bdd-3260-96c8-50374c1237ae",
                                        "glosses": [
                                            "Person, die einen Verlag betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01beef55-e2e4-4181-9ae8-13cad25d0122",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "Viele Autoren haben Probleme, für ihre Werke einen Verleger zu finden."
                                            },
                                            {
                                                "example_id": "5818c9ef-f414-4f5b-af0d-46c09ff3658f",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der Verleger entzog sich der Polizeibehörde und kehrte erst 1903 mit einer Zahlung von 30000 Goldmark Buße aus Paris zurück.“"
                                            },
                                            {
                                                "example_id": "57139c10-77a7-4485-a339-bf12f38f0b5b",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der Verleger bestellte ein Glas Rum auf Eis.“"
                                            },
                                            {
                                                "example_id": "16aea986-ed04-410e-bda6-d1dbc61b6dd5",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Außerdem ist da Carl Friedrich Kunz, ein Weinhändler und Verleger, der als erster Hoffmanns Werke in Buchform veröffentlichen wird.“"
                                            },
                                            {
                                                "example_id": "94682147-5f6b-404c-9a93-f9e536fbe8d3",
                                                "sense_id": "5bff6753-7ac4-3b40-9395-fe19ecd0ca29",
                                                "text": "„Der starke Herr neben ihm war der Verleger seiner Schriften, Herr Daniel Sander, im übrigen aber sein vollkommener Widerpart, wenigstens in allem, was Erscheinung anging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87028336-df5a-4bcf-b7f0-982aa4111b4e",
                        "source_entry_id": "8202f9d5-0475-3d4c-915d-fa0ec786e273",
                        "target_lang_word": "Verlegerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlegerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                                        "entry_id": "d57506a4-acd1-337a-ac14-335255f5ccd2",
                                        "glosses": [
                                            "weibliche Person, die einen Verlag betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e8447a-5478-4990-b404-0931ebbdbd57",
                                                "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                                                "text": "Nachdem sie als Verlegerin keinen Erfolg hatte, wurde sie Börsenmaklerin."
                                            },
                                            {
                                                "example_id": "b1d21cb2-cc49-4ed3-95db-dda67c3be6da",
                                                "sense_id": "5f832fc4-4953-32a5-8071-540e2ec8cc23",
                                                "text": "„Und obgleich mein Buch 1936 endet, knapp zwanzig Jahre nach seinem Beginn, weil ich fand, dass es Sylvias Geschichte als Buchhändlerin und Verlegerin auf sehr befriedigende Weise schildert, lebte sie noch viele Jahre in Paris, bis sie 1962 mit fünfundsiebzig starb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "360c6f3c-1a65-4ab2-a445-a5fc752db5c3",
