            {
                "entry_id": "cf9b03c7-ab5f-3ced-9eb8-9c89a7c8c0c5",
                "word": "shortwave",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "00bae448-0b83-4943-91ca-377d186996b0",
                        "entry_id": "cf9b03c7-ab5f-3ced-9eb8-9c89a7c8c0c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "shortwaves"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32052de9-47ee-3e37-88fa-1273ec034063",
                        "entry_id": "cf9b03c7-ab5f-3ced-9eb8-9c89a7c8c0c5",
                        "glosses": [
                            "短波"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e6182c-fcc8-4114-99dc-0eceb8d49c86",
                                "sense_id": "32052de9-47ee-3e37-88fa-1273ec034063",
                                "text": "Shortwaves are longer than microwaves.",
                                "translation": "短波比微波更長。"
                            }
                        ]
                    },
                    {
                        "sense_id": "df1740ba-f5da-3bea-9b8e-4358d201e26a",
                        "entry_id": "cf9b03c7-ab5f-3ced-9eb8-9c89a7c8c0c5",
                        "glosses": [
                            "短波頻率（尤其用於廣播）"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e47518d-a43e-45a3-a706-46c335b6b745",
                                "sense_id": "df1740ba-f5da-3bea-9b8e-4358d201e26a",
                                "text": "The fun of listening to shortwave while in a car or boat is diminished by spark-plug noise created while the engine is running.",
                                "translation": "在汽车或船上收听短波的乐趣会因发动机运转时产生的火花塞噪音而减弱。"
                            },
                            {
                                "example_id": "7ede4b4a-e44b-45eb-b105-67da5b7e8868",
                                "sense_id": "df1740ba-f5da-3bea-9b8e-4358d201e26a",
                                "text": "Many stations broadcast on shortwaves.",
                                "translation": "許多電臺以短波進行廣播。"
                            }
                        ]
                    },
                    {
                        "sense_id": "dff91257-68a2-35b4-9d64-9c21eaaeb802",
                        "entry_id": "cf9b03c7-ab5f-3ced-9eb8-9c89a7c8c0c5",
                        "glosses": [
                            "短波輻射"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafb573c-0f92-424d-95e7-02dbe2d8f1da",
                                "sense_id": "dff91257-68a2-35b4-9d64-9c21eaaeb802",
                                "text": "Some doubt is cast on the quality of the shortwave fadeout data during the early part of the period considered."
                            },
                            {
                                "example_id": "f1402f05-6999-4dc4-8f90-10523c457357",
                                "sense_id": "dff91257-68a2-35b4-9d64-9c21eaaeb802",
                                "text": "A concise review is presented for the algorithm that has been tentatively selected to produce simulated net shortwave surface fluxes from measured TOA radiances."
                            },
                            {
                                "example_id": "a76bcc20-0962-4228-ae22-5c91ce9991fe",
                                "sense_id": "dff91257-68a2-35b4-9d64-9c21eaaeb802",
                                "text": "Shortwave radiative fluxes that reach the earth's surface are key factors that influence atmospheric and oceanic circulations as well as surface climate.",
                                "translation": "到达地球表面的短波辐射通量是影响大气和海洋环流以及地表气候的关键因素。"
                            }
                        ]
                    }
                ],
