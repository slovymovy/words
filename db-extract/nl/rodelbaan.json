                    {
                        "sense_id": "9fbc85e6-3d29-3c00-b9ae-acf2d853f0d6",
                        "entry_id": "f5dfaf8c-9101-3def-a366-4ff30cb13402",
                        "glosses": [
                            "een holle, bochtige baan die speciaal is gemaakt om er met een slee vanaf te kunnen glijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e42c59-f744-4c31-bd25-e8f8a1a358fc",
                                "sense_id": "9fbc85e6-3d29-3c00-b9ae-acf2d853f0d6",
                                "text": "Een machine voert voortdurend verse sneeuw aan zodat ook bij temperaturen boven het vriespunt gerodeld kan worden. De rodelbaan is tot en met zondag 11 december geopend, doordeweeks vanaf 15.00 uur, in het weekend vanaf 10.30 uur."
                            },
                            {
                                "example_id": "905f3c6a-189a-408b-a905-becb9ca0b2ac",
                                "sense_id": "9fbc85e6-3d29-3c00-b9ae-acf2d853f0d6",
                                "text": "In het Oostenrijkse Bramberg is het wereldrecord 'langste keten met sleeën' verbroken. 22 januari gleden gleden 508 wintersporters in één lint van de langste verlichte rodelbaan ter wereld af."
                            }
                        ]
                    },
                    {
                        "sense_id": "38db2f0b-2ba0-31c1-bbc4-cd4967d1d859",
                        "entry_id": "f5dfaf8c-9101-3def-a366-4ff30cb13402",
                        "glosses": [
                            "een bochtige baan waarover je met wagentje kunt rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12687c1b-cc6d-41cb-86bc-341d570addf3",
                                "sense_id": "38db2f0b-2ba0-31c1-bbc4-cd4967d1d859",
                                "text": "Pretpark De Waarbeek in Hengelo opent tijdens de voorjaarsvakantie tijdelijk haar deuren. De overdekte attracties, waaronder de rodelbaan, botsauto's, het springkussen en het indoor speelparadijs, zijn van zaterdag 18 februari tot en met zondag 5 maart geopend. De buitenattracties blijven nog gesloten tot 1 april."
                            }
                        ]
                    }
