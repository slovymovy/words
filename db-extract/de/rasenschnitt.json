                ],
                "senses": [
                    {
                        "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                        "entry_id": "08ee0e41-4672-3203-843c-6728981184af",
                        "glosses": [
                            "Vorgang des Abmähens von Gras"
                        ],
                        "tags": [
                            "Gärtnern",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "e804d535-6522-4359-80bf-1d6b27ba43ef",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "Regelmäßiger Rasenschnitt fördert ein dichteres Wachstum und verhindert Unkraut."
                            },
                            {
                                "example_id": "2860d276-5b21-4a39-bd2c-f9e84257e6f0",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "„Auch wenn die freie Zeit häufig den Termin für den Rasenschnitt vorgibt, gibt es doch aus meteorologischer Sicht günstige und ungünstige Zeitpunkte für den Rasenschnitt.“"
                            },
                            {
                                "example_id": "3dfcbac8-7b85-401d-96b7-a1ee5c36c631",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "„Die Bedingungen für den Rasenschnitt werden in 5 Klassen (schlecht, ungünstig, mittel, günstig, optimal) eingeteilt.“"
                            },
                            {
                                "example_id": "aa39b4db-5810-413e-ad94-5a7405ac7f42",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "[Galopprennbahn:] „Zuerst werden mit einer sogenannten Schleppe Maulwurfshügel und kleinere Unebenheiten beseitigt, danach wird mit einem Striegel der Boden bearbeitet. Es folgt ein erster Rasenschnitt und die Frühjahrsdüngung.“"
                            },
                            {
                                "example_id": "1e837084-17ba-4003-8989-589163f0d2c8",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "[Rasenpflege im Frühjehr:] „Dem ersten Rasenschnitt ist ein besonderes Augenmerk zu widmen. Er wird vorgenommen sobald die Gräser etwa acht bis zehn Zentimeter hoch geworden sind.“"
                            },
                            {
                                "example_id": "fa35cd16-5c51-427b-8bab-582d0eb23167",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "„Der letzte Rasenschnitt sollte im Herbst erfolgen, um den Rasen auf den Winter vorzubereiten.“"
                            },
                            {
                                "example_id": "dc00ff28-f5d1-4231-a432-cff6e918ee61",
                                "sense_id": "005aa7f0-253d-3d2f-a6af-427384f6cf29",
                                "text": "„Auch wenn man grundsätzlich sagt, dass im Herbst der letzte Rasenschnitt fällig ist: Richten Sie sich lieber nach den Temperaturen und nicht nach dem Monat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                        "entry_id": "08ee0e41-4672-3203-843c-6728981184af",
                        "glosses": [
                            "abgemähtes Gras, das Produkt von [1], also die abgeschnittenen Halme, die beim Mähen eines Rasens anfallen"
                        ],
                        "tags": [
                            "Gärtnern",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "c8cced27-d1d5-4d8e-9c28-bb37ba3335af",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "Rasenschnitt kann auf dem Rasen selbst zum Düngen liegen gelassen werden."
                            },
                            {
                                "example_id": "d35beba9-444d-45f6-997e-47383fdad1ed",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Eine Mulchschicht aus Rasenschnitt, Hanfstreu oder Laub schützt den Boden gleich mehrfach: Sie verhindert die Verdunstung von Wasser, lässt Regen besser versickern und bewahrt den Boden vor Überhitzung. Gleichzeitig bietet sie Schutz vor Erosion durch Wind und Starkregen.“"
                            },
                            {
                                "example_id": "9e92b056-6031-4d72-bc82-a17ad5bcecb9",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Unkraut jäten gehört zu den unbeliebtesten Aufgaben im Garten. Wer Beete mit Hecken-, Rasenschnitt oder gehäckselter Rinde mulcht, erspart sich viel Arbeit.“"
                            },
                            {
                                "example_id": "c980c3b4-44e2-4c5f-938a-1eb65347d37d",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Leicht angetrockneter Rasenschnitt eignet sich außerdem zum Mulchen im Gemüsebeet.“"
                            },
                            {
                                "example_id": "cefd62a6-f369-4860-9c31-e764df61f24e",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "[Mulchdecke:] „Eine solche Schicht aus trockenem Rasenschnitt, Laub, Gemüseresten, Schafwolle oder gejäteten Wildpflanzen hält den Boden schön feucht und versorgt die Beete zudem mit Nährstoffen.“"
                            },
                            {
                                "example_id": "ccd7dc04-4877-4a89-80e8-db8d62ccd92c",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Eine Schicht Mulch aus Rasenschnitt wirkt der Austrocknung des Bodens entgegen. Die Lebewesen in der Erde freuen sich auch darüber.“"
                            },
                            {
                                "example_id": "e4296699-554d-4b30-9ab2-23dc46792746",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Beim Mulchmähen sollte auf einen trockenen Rasen geachtet werden, denn nasser Rasenschnitt neigt zum Verklumpen.“"
                            },
                            {
                                "example_id": "e74afdb7-a090-4928-a963-1cf33ce15d87",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Bevor Sie nun anfangen, Reisig, Laub oder Rasenschnitt in Ihr Auto zu packen, informieren Sie sich über die Öffnungszeiten der Kompostieranlage Ihrer Wahl, damit Sie nicht umsonst hinfahren.“"
                            },
                            {
                                "example_id": "6e153e08-d67d-4f0e-97c2-f92ead1b3968",
                                "sense_id": "84408a24-6c7e-39ac-8954-9ec596ac8f98",
                                "text": "„Die krautigen Pflanzenteile sowie der Rasenschnitt haben ein besonders hohes Potenzial zur regenerativen Energieerzeugung mithilfe von Vergärungstechnologien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
