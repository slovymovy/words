                    {
                        "sense_id": "5528aae2-6098-315b-bb5f-4110237c431c",
                        "entry_id": "a595d766-a0e4-3d4f-b57d-a8987d970e4c",
                        "glosses": [
                            "Qui parsème."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9444fbb8-2c15-43a4-8084-25f4158f695f",
                                "sense_id": "5528aae2-6098-315b-bb5f-4110237c431c",
                                "text": "Prends ceci, dit-il, non pour tes fleurs dont je ne me soucie pas, mais pour m’avoir si parfaitement donné l’image de la nuit sereine, parsemeuse de songes, de charmes et de mensonges."
                            },
                            {
                                "example_id": "a5ea9da1-df26-46aa-845a-094b9edf62fa",
                                "sense_id": "5528aae2-6098-315b-bb5f-4110237c431c",
                                "text": "Mon tout pour le touriste est un fléau terrible\nParsemeur des malheurs les plus indescriptibles."
                            },
                            {
                                "example_id": "0149534f-1618-45a6-92d0-6d6eef398bb4",
                                "sense_id": "5528aae2-6098-315b-bb5f-4110237c431c",
                                "text": "Les auteurs parsemeurs de bruits télégraphiques."
                            }
                        ]
                    }
