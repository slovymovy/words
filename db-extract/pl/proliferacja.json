                        "cross_references": [
                            {
                                "target_word": "proliferation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63573902-e008-3905-a159-25e4ce4b50bf",
                                        "entry_id": "1c015743-2ac9-32da-82e8-6cd2884e5cec",
                                        "glosses": [
                                            "The process by which an organism produces others of its kind; breeding, propagation, procreation, reproduction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "102a9d64-0ceb-3f2a-abd7-71773ecdeb97",
                                        "entry_id": "1c015743-2ac9-32da-82e8-6cd2884e5cec",
                                        "glosses": [
                                            "The act of increasing, rising, or proliferating; augmentation, amplification, enlargement, escalation, aggrandizement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08392a70-21b7-46bd-b57b-04e5937acc1c",
                                                "sense_id": "102a9d64-0ceb-3f2a-abd7-71773ecdeb97",
                                                "text": "One particularly damaging, but often ignored, effect of conflict on education is the proliferation of attacks on schools[…]as children, teachers or school buildings become the targets of attacks. Parents fear sending their children to school. Girls are particularly vulnerable to sexual violence."
                                            },
                                            {
                                                "example_id": "ac7cb185-8ec8-49b3-9ed2-1b45e09a60ff",
                                                "sense_id": "102a9d64-0ceb-3f2a-abd7-71773ecdeb97",
                                                "text": "Internationally, the shipping container had already proven its worth, and by the early 1960s battles were being fought over what their standardised dimensions would be (their expected proliferation was not in question)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573aee9b-f63e-3576-a896-62ac0eda82ae",
                                        "entry_id": "1c015743-2ac9-32da-82e8-6cd2884e5cec",
                                        "glosses": [
                                            "The act of increasing, rising, or proliferating; augmentation, amplification, enlargement, escalation, aggrandizement.",
                                            "In paticular, the spread (proliferating) of biochemical, nuclear and other weapons of mass destruction to countries not originally involved in developing them."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183bb4a2-d0da-4fb7-bb92-153b4341fa5c",
                                                "sense_id": "573aee9b-f63e-3576-a896-62ac0eda82ae",
                                                "text": "... to combat proliferation by assisting them in gaining and assuring greater control over their dual-use equipment and technology. States that gain weapons of mass destruction are able to pose a significant military threat to the[…]"
                                            },
                                            {
                                                "example_id": "a1b6b669-4c9f-452f-87c0-9541cd6d9c8e",
                                                "sense_id": "573aee9b-f63e-3576-a896-62ac0eda82ae",
                                                "text": "[Efforts] to fight proliferation will require more than just new targets for collection; intelligence analysis will also have to change. In particular, to support policymakers looking for opportunities to disrupt, slow, or stop a[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a08289d-4fb7-34f4-9485-ff5e14c53a9a",
                                        "entry_id": "1c015743-2ac9-32da-82e8-6cd2884e5cec",
                                        "glosses": [
                                            "The result of building up; buildup, accretion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09634a2f-776b-4625-a74e-69b687fe2dbd",
                        "source_entry_id": "c94b856a-45c0-36e6-a9fb-e69c1d2a97b4",
                        "source_sense_id": "58b10f61-4339-3a50-ad7d-753da5885b6c",
                        "target_lang_word": "prolifération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolifération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication par division des cellules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f91dd6-ca31-436a-81e0-98817065220a",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "La prolifération tuberculeuse."
                                            },
                                            {
                                                "example_id": "12cccdcb-92fd-4854-996e-c9ad8c7c9445",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "La prolifération des cellules cancéreuses."
                                            },
                                            {
                                                "example_id": "bc7b77a4-28e4-4d55-8f42-e9cd49d5fe8e",
                                                "sense_id": "6d2574d4-f253-322a-833d-04c547ea8563",
                                                "text": "Le froid -- suffisant pour empêcher la prolifération bactérienne et fongique, mais pas assez important pour endommager les tissus -- a permis d’incroyablement bien conserver l’animal qui gardait des plumes, des ongles, de la peau et des tissus mous intacts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication de choses indésirables."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fccae05-d3ba-4545-848f-770d418e0e78",
                                                "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                                "text": "La renaissance d'un certain patriotisme de clocher se traduisit par la prolifération des sectes manichéennes et millénaristes."
                                            },
                                            {
                                                "example_id": "d8f83384-9a20-4596-8eda-6810bf31c752",
                                                "sense_id": "b040490e-ee60-3480-8b47-b3c36c0ba9c3",
                                                "text": "Le biotope favorisant la prolifération de ces moustiques associe l'eau, les sols hydromorphes et salés, et la végétation qui leur est associée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                        "entry_id": "954a811a-81ab-37b3-aa34-95c95f81af91",
                                        "glosses": [
                                            "Multiplication de choses indésirables.",
                                            "Prolifération nucléaire : accroissement du nombre des pays disposant de l'arme atomique."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a5acb0d-6325-495c-aa48-b6babfec0280",
                                                "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                                "text": "L’attitude de la France à l’égard de la prolifération nucléaire a été particulièrement complexe. Paris a été à la fois, mais pas toujours, la victime de politiques de non-prolifération, en particulier de la part des États-Unis, et par moments un proliférateur de première importance."
                                            },
                                            {
                                                "example_id": "1c0af60e-bb1a-487f-b5b6-0ad73caf7f4e",
                                                "sense_id": "3de7ef53-3275-3fb5-98e5-cd9b6f809e4f",
                                                "text": "En ce qui concerne les secteurs clés, tels que le nucléaire, le balistique et le chimique, les pays occidentaux ont pris progressivement conscience du risque de prolifération lié à un transfert de technologie, particulièrement dans un certain nombre de pays en voie de développement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
