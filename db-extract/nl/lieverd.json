                                "example_id": "7dac06fd-df1a-433a-8935-9f26110c591a",
                                "sense_id": "1a3340e9-0915-3555-bd90-d24be62b661c",
                                "text": "'Doe je rustig aan, lieverd?' Lieverd."
                            },
                            {
                                "example_id": "8e6d78d6-56ea-4740-85e9-c3e20bc1cba1",
                                "sense_id": "1a3340e9-0915-3555-bd90-d24be62b661c",
                                "text": "'Wat is er, lieverd?' Zachtjes schud ik mijn hoofd."
                            }
                        ]
