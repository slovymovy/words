                ],
                "senses": [
                    {
                        "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                        "entry_id": "9be8d82a-6350-3bcd-86ae-a6ae6d103f60",
                        "glosses": [
                            "Wechsel, bei dem sich der Aussteller des Wechsels selbst zur Zahlung einer Geldsumme verpflichtet"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fd5e1158-09c2-4657-adec-bcbc0ac041a7",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„In der weiteren Entwicklung löste sich der Rückwechsel vom Kreditwechsel und wurde dadurch zum Eigenwechsel, auch Solawechsel genannt.“"
                            },
                            {
                                "example_id": "72d687aa-3f5b-447f-8df1-1e87232826ad",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Der Eigenwechsel war das Instrument auf dem u.a. Fugger virtuos zu spielen vermochte.“"
                            },
                            {
                                "example_id": "1eac4b5d-82bc-46af-93d3-995beb4e56f6",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Mit dem Eigenwechsel entstand das Kreditgeld.“"
                            },
                            {
                                "example_id": "1304fca2-417d-48a2-b1ec-af76b7b3a4b8",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Schon vor 500 Jahren begannen Großkaufleute sich selbst Kreditgeld zu schaffen. Möglich wurds das durch den Eigenwechsel.“"
                            },
                            {
                                "example_id": "569799d2-b81c-48dc-bd78-d6c37b0f9f2c",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Doch ein Kaufmann, der gerade 100 Dukaten in seiner Truhe verwahrte, konnte Eigenwechsel über 1.000 und mehr Dukaten ausstellen. Jedem einzelnen Kaufmann, dem er einen Eigenwechsel in Zahlung gab, konnte er seine 100 Dukaten vorweisen.“"
                            },
                            {
                                "example_id": "6e13df15-042d-4df3-a913-6504aefbd7c8",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Ein formwirksamer Eigenwechsel kann daher lauten „this bill of exchange is payable …” oder „this promissory note is payable …” (aber nicht: „gegen diese bill of exchange (oder promissory note) zahle ich …”).“"
                            },
                            {
                                "example_id": "e0f80954-4c82-48e2-bd7f-cc1437bf012f",
                                "sense_id": "7ee6925c-9b8c-3b41-b3eb-ced37a5d7b58",
                                "text": "„Die praktische Bedeutung des Eigenwechsels ist gering, da sich mit den Normal- und Sonderformen des gezogenen Wechsels die gleichen Wirkungen erzielen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
