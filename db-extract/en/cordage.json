                "translations": [
                    {
                        "translation_id": "ec8787f7-d201-414e-a9a3-7989f36ba032",
                        "source_entry_id": "b3e69000-c998-3c82-9d3c-4836828051e7",
                        "source_sense_id": "890ad833-30db-31f1-a0e3-3d7e6a5791f3",
                        "source_sense_description": "Tauwerk",
                        "target_lang_word": "Tauwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tauwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                                        "entry_id": "5bcc2c5e-5dc8-3e65-9e8c-2bb643c8848d",
                                        "glosses": [
                                            "in der Seefahrt verwendete Taue"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc77923a-c32b-488a-8b38-3066e545076c",
                                                "sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                                                "text": "„In der zweiten Woche nach der Seeschlacht lag Murphy zwischen dem Tauwerk auf dem erhöhten Achterdeck und träumte.“"
                                            },
                                            {
                                                "example_id": "2ea0347e-ce55-4378-82c0-4fc89b95e7ea",
                                                "sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                                                "text": "Der rote Faden war eine besondere Einrichtung bei der englischen Marine. Sämtliche Taue der königlichen Flotte waren so geflochten, dass ein roter Faden sich deutlich hindurchzog. Ihn herauszuwinden, ohne das ganze Tauwerk aufzulösen, war unmöglich."
                                            },
                                            {
                                                "example_id": "37cb7e31-2467-4a64-9a6b-49ec62b3d7ec",
                                                "sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                                                "text": "„Das Paternoster war, wie Jón Hreggvidsson bald feststellen konnte, ein Kranz aus Tauwerk mit vielen Knoten, der dem Manne um den Kopf gezwängt und dann mittels eines Holzstückchens gestrammt wurde, bis die Knoten ihm in den Schädel drangen, daß die Augen fast aus ihren Höhlen sprangen.“"
                                            },
                                            {
                                                "example_id": "c27aba92-644f-4fbc-a920-54b3f3278c6e",
                                                "sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                                                "text": "„Während Nab und Spilett ohne Unterbrechung Enten brieten und Bekassinen konservierten, nähten Pencroff und Harbert Segel und machten das Tauwerk zurecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
