                "senses": [
                    {
                        "sense_id": "58cfbd5f-4359-3c4a-b7e8-bb7ed183afb7",
                        "entry_id": "79cfcf8b-b029-3064-b9e3-ea3db23d0942",
                        "glosses": [
                            "Donner un caractère labourdin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473cbcce-c4a2-497a-8a6e-4310d6a781f5",
                                "sense_id": "58cfbd5f-4359-3c4a-b7e8-bb7ed183afb7",
                                "text": "Quand un Bas-Navarrais écrit ou prêche en Basque, il labourdinise d'ordinaire plus ou moins son dialecte, conformément à certaines règles traditionnelles."
                            },
                            {
                                "example_id": "3ef13519-032a-49ea-bdde-e2eee10afd19",
                                "sense_id": "58cfbd5f-4359-3c4a-b7e8-bb7ed183afb7",
                                "text": "Au moins pour ce qui est de l’aspiration, l’écrit de la dame d’Urtubie se «labourdinise» donc, fortement dans la lettre 15, plus modérément par la suite."
                            }
                        ]
                    }
