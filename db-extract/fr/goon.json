                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72edfba6-17cb-3748-9028-0b5d47f29336",
                                        "entry_id": "fdab9579-5c3a-38f7-b3ca-e06c4903dbd6",
                                        "glosses": [
                                            "To masturbate for long periods of time without reaching a climax."
                                        ],
                                        "tags": [
