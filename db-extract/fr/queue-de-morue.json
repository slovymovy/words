                    {
                        "sense_id": "e06ea89f-c740-3c0a-a26b-580231531f9e",
                        "entry_id": "7830b9a2-e9bd-3aa1-ab3e-dc1738cdfdc4",
                        "glosses": [
                            "Planche plus large à une extrémité qu'à l'autre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cdacf339-7d35-32bd-b426-bcc183293882",
                        "entry_id": "7830b9a2-e9bd-3aa1-ab3e-dc1738cdfdc4",
                        "glosses": [
                            "Basques de certains habits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e571da-14b0-4272-bc9d-50149d668ad7",
                                "sense_id": "cdacf339-7d35-32bd-b426-bcc183293882",
                                "text": "C’est mal comprendre le sens de la création que de vouloir imposer la même livrée aux hommes de tous les climats, et c’est une des mille erreurs de la civilisation européenne ; avec un habit à queue de morue, l’on est beaucoup plus laid, mais tout aussi barbare."
                            },
                            {
                                "example_id": "7cfded69-5239-4774-9509-c8f57a10930f",
                                "sense_id": "cdacf339-7d35-32bd-b426-bcc183293882",
                                "text": "J’avais eu soin, la veille, de déployer au dos d’une chaise mon habit bleu de ciel à queue de morue, mon pantalon, […]. Tout était prêt ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa838db7-bf9a-30f4-a1f9-49d426e213e2",
                        "entry_id": "7830b9a2-e9bd-3aa1-ab3e-dc1738cdfdc4",
                        "glosses": [
                            "Habit de cérémonie à longues basques étroites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c363f005-b959-4890-8194-a4f28aca1319",
                                "sense_id": "fa838db7-bf9a-30f4-a1f9-49d426e213e2",
                                "text": "Elle l’imaginait « en queue de morue », comme elle disait, avec un « gibus », dans ce restaurant de luxe : il y avait une petite lampe rose sur chaque table."
                            }
                        ]
                    }
                ],
