                                "sense_id": "3367e983-1fa9-3af1-9a73-2d5affc18100",
                                "text": "Bois flotté, bois à brûler qui est venu par le flottage."
                            },
                            {
                                "example_id": "e95e4764-7150-4247-a154-94ba513ac58f",
                                "sense_id": "3367e983-1fa9-3af1-9a73-2d5affc18100",
                                "text": "Une voie de bois flotté."
                            }
                        ]
                    },
