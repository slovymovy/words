        "fr-extract.jsonl": [
            {
                "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                "word": "faîtage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "319ca2e7-31b5-4674-ada6-420f138ca47f",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "tags": [
                            "plural"
                        ],
                        "form": "faîtages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43a26b5d-2759-3b3a-b76d-655723fb65ea",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "glosses": [
                            "Ouvrage qui permet de joindre les deux versants d'une toiture. Il doit assurer l'étanchéité de la couverture d'un bâtiment, ainsi que sa solidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a8bcda-d5e9-4347-aaf6-86742f59ee35",
                                "sense_id": "43a26b5d-2759-3b3a-b76d-655723fb65ea",
                                "text": "Le voyageur qui eût aperçu de loin le castel dessinant ses faîtages pointus sur le ciel, au-dessus des genêts et des bruyères, l’eût jugé une demeure convenable pour un hobereau de province ; mais, en approchant, son avis se fût modifié."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c84796-2372-3c18-b3d9-f5a43b1e0e6c",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "glosses": [
                            "Pièce de bois qui termine le comble et sur laquelle s’appuient les chevrons."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b302dcc1-f695-4854-bcf0-cad0abae7177",
                                "sense_id": "05c84796-2372-3c18-b3d9-f5a43b1e0e6c",
                                "text": "Quant au bois, il remplissait les hangars jusqu'au faîtage."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3dd5fdf-bad6-35d2-9d6c-05b912aeb9a9",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "glosses": [
                            "Plaque de métal que les couvreurs disposent en haut d’un toit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088884f0-e1fe-43d4-801c-ab746b5a4672",
                                "sense_id": "c3dd5fdf-bad6-35d2-9d6c-05b912aeb9a9",
                                "text": "Enfin, l’enrichissement des toits par la dorure des faîtages, de toute la plomberie des lucarnes et des chéneaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "69d81494-2f70-342c-8cad-d315ffe98e20",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "glosses": [
                            "Droit payé au seigneur pour avoir l'autorisation de construire une maison."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7fa709fd-a3d4-321e-a493-1a0492ab9ee6",
                        "entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "glosses": [
                            "Droit payé au seigneur pour avoir l'autorisation de construire une maison.",
                            "Droit qu'avaient parfois les habitants de certaines seigneuries de prélever dans les bois un arbre pour faire la charpente de leur habitation."
                        ],
                        "tags": [
                            "Droit féodal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71626e29-fca2-441d-9700-9e8bcce63d0e",
                        "source_entry_id": "1b2ce806-3291-353f-bf10-80c42fa2adec",
                        "source_sense_description": "Ouvrage qui permet de joindre les deux versants d'une toiture",
                        "target_lang_word": "Dachfirst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dachfirst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                        "entry_id": "2dda2cbf-da22-3a13-bee5-949c5961001f",
                                        "glosses": [
                                            "höchste Kante an einem geneigten Dach, die durch die Berührungslinien zweier geneigter Dachflächen gebildet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de822690-4282-45ee-b930-5f7779b6f1e9",
                                                "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                                "text": "Zwei Krähen sitzen auf dem Dachfirst des Nachbarhauses."
                                            },
                                            {
                                                "example_id": "322601b7-e91d-4463-a092-de54736aa290",
                                                "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                                "text": "Als Dachfirst (kurz First) bezeichnet man die meist waagerechte obere Kante eines Satteldaches oder anderer Dachformen."
                                            },
                                            {
                                                "example_id": "936dbbb5-31b5-44e5-9a14-07fc686a0a6b",
                                                "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                                "text": "„Von den Längsseiten des Dachfirstes hingen, grün in der Sonne aufleuchtend, gewaltige Kupferplatten herab, die zu einer schrundigen Masse mit ausgezackten Kanten verschmolzen waren.“"
                                            },
                                            {
                                                "example_id": "8ed0d8f9-9e4e-4872-a371-7a2fb5438b23",
                                                "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                                "text": "„Blau steht der späte Nachmittag im Fenster zwischen den Dachfirsten.“"
                                            },
                                            {
                                                "example_id": "2e0f9b2c-6ae9-45ff-b35c-9c8cceb5ad4d",
                                                "sense_id": "d0eccb55-e207-37b5-99dd-6b6ca9240950",
                                                "text": "„In dem Augenblick, als ich aus dem Haus trat, war Sherlock Holmes auf dem Dach, und ich konnte sehen, wie er den Dachfirst gleich einem riesigen Leuchtkäfer sehr langsam entlangkroch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
