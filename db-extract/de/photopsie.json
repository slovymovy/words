                "senses": [
                    {
                        "sense_id": "bb49a95e-eabd-3597-bdab-91ceea5d8cc5",
                        "entry_id": "dbfce013-b7ca-361e-9258-de79589ccddb",
                        "glosses": [
                            "das Auftreten von visuellen Empfindungen in Form von Licht, Farben, Funken oder Blitzen, die nicht durch optische Reize auf die Netzhaut oder Sehbahn hervorgerufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5769f81-ec9c-4e88-b018-58c990b1b962",
                                "sense_id": "bb49a95e-eabd-3597-bdab-91ceea5d8cc5",
                                "text": "Photopsie tritt bei mechanischen oder vaskulären Reizen auf die Netzhaut oder Sehbahn, etwa bei Kontusion des Auges, Migräne oder Hirntumoren, auf."
                            },
                            {
                                "example_id": "4d4eff9f-bf42-4d5f-ac47-926716012e72",
                                "sense_id": "bb49a95e-eabd-3597-bdab-91ceea5d8cc5",
                                "text": "Die Patienten zeigen Farbsinnstörungen, zentrale, oft mottenfraßartige Skotome und eine Photopsie in Form von Lichtblitzen am Rand der Skotome."
                            },
                            {
                                "example_id": "9620f1cb-199b-45df-bba1-65f42907d5cf",
                                "sense_id": "bb49a95e-eabd-3597-bdab-91ceea5d8cc5",
                                "text": "Diese \"Photopsie\" kann auch bei Epilepsie und Migräne auftreten, aber auch bei einigen gesunden Menschen durch heftiges Niesen."
                            },
                            {
                                "example_id": "322de690-dff7-4cd3-aa11-48fa82426be0",
                                "sense_id": "bb49a95e-eabd-3597-bdab-91ceea5d8cc5",
                                "text": "Schleiersehen, Photophobie, Photopsie, Glaskörpertrübung und Augenschmerzen werden häufig vor sowie während der Behandlung mit Fomivirsen beobachtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
