{
    "word_family": [
        "questionable",
        "questioner",
        "questioning",
        "questionnaire",
        "unquestionable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a103a3cb-40b3-3193-902a-346159ed5e1c",
                    "sense_definition": "A sentence or phrase used to ask for information or a reply.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "inquiry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked a difficult <w>question</w> during the history lesson.",
                            "target_lang_translations": {
                                "ru": "Учитель задал сложный <w>вопрос</w> во время урока истории."
                            }
                        },
                        {
                            "text": "If you have any <w>questions</w>, please raise your hand.",
                            "target_lang_translations": {
                                "ru": "Если у вас есть <w>вопросы</w>, пожалуйста, поднимите руку."
                            }
                        },
                        {
                            "text": "I would like to <w>ask</w> a <w>question</w> about the new project.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы задать <w>вопрос</w> о новом проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "query",
                        "inquiry",
                        "enquiry"
                    ],
                    "antonyms": [
                        "answer",
                        "reply",
                        "response"
                    ],
                    "common_phrases": [
                        "ask a question",
                        "answer a question",
                        "simple question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложение или фраза, используемые для запроса информации или получения ответа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "обращение для получения информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49fc6ea4-b555-33d6-8f37-c5c301085db5",
                    "sense_definition": "A subject or topic that needs to be considered, discussed, or investigated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>question</w> of safety is our main priority right now.",
                            "target_lang_translations": {
                                "ru": "<w>Вопрос</w> безопасности является нашим главным приоритетом сейчас."
                            }
                        },
                        {
                            "text": "There is still the <w>question</w> of who will pay for the repairs.",
                            "target_lang_translations": {
                                "ru": "Все еще остается <w>вопрос</w> о том, кто будет платить за ремонт."
                            }
                        }
                    ],
                    "synonyms": [
                        "issue",
                        "topic",
                        "subject",
                        "problem",
                        "consideration"
                    ],
                    "common_phrases": [
                        "the question of",
                        "matter in question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или тема, требующие рассмотрения, обсуждения или расследования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "дело, обстоятельство или проблема"
                            },
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "тема обсуждения или изучения"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "сложный вопрос для решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6767c2f-ddbc-3cb7-989d-3a2806a9e913",
                    "sense_definition": "A doubt or challenge regarding the truth or validity of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His honesty is <w>beyond</w> <w>question</w> because he has always been truthful.",
                            "target_lang_translations": {
                                "ru": "Его честность вне <w>сомнений</w>, потому что он всегда был правдив."
                            }
                        },
                        {
                            "text": "The recent scandal has <w>thrown</w> <w>into</w> <w>question</w> the future of the company.",
                            "target_lang_translations": {
                                "ru": "Недавний скандал поставил под <w>вопрос</w> будущее компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "doubt",
                        "issue"
                    ],
                    "antonyms": [
                        "certainty"
                    ],
                    "common_phrases": [
                        "beyond question",
                        "without question",
                        "call into question",
                        "throw into question"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сомнение или вызов в отношении истинности или обоснованности чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "отсутствие уверенности в истинности"
                            },
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "в контексте сомнения, например «под вопросом»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8412247-6d0e-3aee-a7f0-9a8477bdb145",
                    "sense_definition": "A formal proposal or motion submitted to a meeting for a vote or discussion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "formal_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chairman moved that the <w>question</w> be put to a vote immediately.",
                            "target_lang_translations": {
                                "ru": "Председатель предложил немедленно поставить <w>вопрос</w> на голосование."
                            }
                        },
                        {
                            "text": "Members debated the <w>question</w> for hours before reaching a decision.",
                            "target_lang_translations": {
                                "ru": "Члены совета обсуждали этот <w>вопрос</w> часами, прежде чем принять решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal",
                        "proposition"
                    ],
                    "common_phrases": [
                        "put the question"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in formal meetings or parliamentary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное предложение или ходатайство, представленное на собрании для голосования или обсуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "пункт повестки дня для голосования"
                            },
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "формальное ходатайство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d8ac383-0a0b-31bf-b1b8-6e3a6a3af669",
                    "sense_definition": "The act of interrogating someone using torture to extract information.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, prisoners were often <w>brought</w> <w>to</w> <w>the</w> <w>question</w> to force a confession.",
                            "target_lang_translations": {
                                "ru": "В средневековье заключенных часто подвергали <w>пытке</w>, чтобы вырвать признание."
                            }
                        },
                        {
                            "text": "The historical records describe the horrific methods used during the <w>question</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические записи описывают ужасающие методы, использовавшиеся во время <w>допроса</w> с пристрастием."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrogation"
                    ],
                    "common_phrases": [
                        "put to the question",
                        "bring to the question"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context of judicial torture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт допроса кого-либо с применением пыток для получения информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пытка",
                                "target_lang_sense_clarification": "истязание для получения признания"
                            },
                            {
                                "target_lang_word": "допрос",
                                "target_lang_sense_clarification": "в историческом контексте судебного дознания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f05a93d3-ff88-3367-bd27-3fd68e0c1a65",
                    "sense_definition": "To ask someone for information or to interrogate them.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "interrogate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police began to <w>question</w> the witness about what he saw.",
                            "target_lang_translations": {
                                "ru": "Полиция начала <w>допрашивать</w> свидетеля о том, что он видел."
                            }
                        },
                        {
                            "text": "She was <w>questioned</w> by her boss regarding the missing files.",
                            "target_lang_translations": {
                                "ru": "Начальник <w>расспрашивал</w> её по поводу пропавших файлов."
                            }
                        }
                    ],
                    "synonyms": [
                        "interrogation",
                        "query",
                        "inquiry",
                        "enquiry"
                    ],
                    "antonyms": [
                        "answer",
                        "respond"
                    ],
                    "common_phrases": [
                        "question a witness",
                        "question someone closely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задавать кому-либо вопросы для получения информации или проводить допрос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "допрашивать",
                                "target_lang_sense_clarification": "официально расспрашивать свидетеля или подозреваемого"
                            },
                            {
                                "target_lang_word": "расспрашивать",
                                "target_lang_sense_clarification": "задавать много вопросов для получения информации"
                            },
                            {
                                "target_lang_word": "опрашивать",
                                "target_lang_sense_clarification": "проводить сбор информации через вопросы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c363e8e8-8870-3491-bb62-a633471299fc",
                    "sense_definition": "To express or feel doubt about the truth or value of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always <w>question</w> the <w>motives</w> of people who offer free gifts.",
                            "target_lang_translations": {
                                "ru": "Всегда следует <w>подвергать сомнению</w> мотивы людей, предлагающих бесплатные подарки."
                            }
                        },
                        {
                            "text": "Many citizens began to <w>question</w> the government's decision to raise taxes.",
                            "target_lang_translations": {
                                "ru": "Многие граждане начали <w>ставить под сомнение</w> решение правительства повысить налоги."
                            }
                        }
                    ],
                    "synonyms": [
                        "doubt",
                        "query",
                        "proposition"
                    ],
                    "antonyms": [
                        "accept",
                        "believe",
                        "trust"
                    ],
                    "common_phrases": [
                        "question the motives",
                        "question the validity",
                        "question authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать или испытывать сомнение в истинности или ценности чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить под сомнение",
                                "target_lang_sense_clarification": "выражать недоверие к чему-либо"
                            },
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "оспаривать правильность или ценность"
                            },
                            {
                                "target_lang_word": "сомневаться",
                                "target_lang_sense_clarification": "испытывать неуверенность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}