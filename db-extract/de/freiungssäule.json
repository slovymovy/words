                "senses": [
                    {
                        "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                        "entry_id": "24c33491-f720-3621-85f0-de060717d953",
                        "glosses": [
                            "Bildstock mit 4 Wappen, der an den Ecken eines Grundstückes positioniert wurde, ab dessen Grenze Privatrecht gilt; Asyl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08740464-63a1-41b7-b5ed-a33806078d4b",
                                "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                                "text": "„Innerhalb eines durch vier pyramidale Freiungssäulen abgegrenzten Bezirks genoss ein Verfolgter Rechtsschutz bis zum Ausgang seiner Sache.“"
                            },
                            {
                                "example_id": "7aa66739-527f-4644-a2d5-c649fcc50244",
                                "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                                "text": "„Sogenannte Freiungssäulen (auch Weißmarter) entlang der Zugangswege markierten die Grenze des Einflussbereiches staatlicher Verfolger.“"
                            },
                            {
                                "example_id": "791fd081-7fcb-4a39-a18d-bc633a8303fa",
                                "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                                "text": "„Nebenan finden wir vier Freiungssäulen des ehemals kaiserlich befreiten Burg Hohenberg.“"
                            },
                            {
                                "example_id": "7562503f-7e50-4624-91ad-ea99ed8db596",
                                "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                                "text": "„Das gefreite Gebiet von St. Georgenberg begann gegen das Gericht Freundsberg an der Stelle, wo der geschlossene Bezirk des Klosters anfängt; dort steht auch die Freiungssäule.“"
                            },
                            {
                                "example_id": "cbea2065-5419-4d48-b121-e95e7a1a600f",
                                "sense_id": "e09ebae7-ef57-34f9-8ecd-221334c5984a",
                                "text": "„Sogenannte Freiungssäulen (auch Weißmarter) entlang der Zugangswege markierten die Grenze des Einflussbereiches staatlicher Verfolger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
