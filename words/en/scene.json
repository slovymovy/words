{
    "word_family": [
        "scenery",
        "scenic",
        "scenario",
        "scenographer",
        "scenography"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                    "sense_definition": "A specific part of a play, movie, or book in which the action remains in one place for a continuous period.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dramatic_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opening <w>scene</w> of the movie grabbed everyone's attention immediately.",
                            "target_lang_translations": {
                                "ru": "Начальная <w>сцена</w> фильма сразу же привлекла всеобщее внимание.",
                                "zh": "电影的开场<w>场景</w>立刻抓住了所有人的注意力。"
                            }
                        },
                        {
                            "text": "The actors rehearsed the final <w>scene</w> until it was perfect.",
                            "target_lang_translations": {
                                "ru": "Актёры репетировали финальную <w>сцену</w>, пока она не стала идеальной.",
                                "zh": "演员们排练了最后一<w>场</w>戏，直到完美为止。"
                            }
                        }
                    ],
                    "synonyms": [
                        "part",
                        "section",
                        "segment"
                    ],
                    "common_phrases": [
                        "opening scene",
                        "final scene",
                        "love scene",
                        "movie scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная часть пьесы, фильма или книги, в которой действие происходит в одном месте в течение непрерывного периода времени.",
                        "zh": "戏剧、电影或书籍中，动作在同一地点连续发生的一段情节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцена",
                                "target_lang_sense_clarification": "часть произведения"
                            },
                            {
                                "target_lang_word": "эпизод",
                                "target_lang_sense_clarification": "фрагмент действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "场景",
                                "target_lang_sense_clarification": "作品中的片段"
                            },
                            {
                                "target_lang_word": "场",
                                "target_lang_sense_clarification": "戏剧或电影的段落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f94391d-060f-3751-9adc-c8f352f259da",
                    "sense_definition": "The place where a specific event, often an unpleasant one like a crime or accident, has happened.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police officers arrived at the <w>scene</w> of the accident within minutes.",
                            "target_lang_translations": {
                                "ru": "Полицейские прибыли на <w>место</w> аварии через несколько минут.",
                                "zh": "警察在几分钟内就赶到了事故<w>现场</w>。"
                            }
                        },
                        {
                            "text": "Detectives examined the <w>scene</w> for any fingerprints or evidence.",
                            "target_lang_translations": {
                                "ru": "Детективы осмотрели <w>место происшествия</w> на наличие отпечатков пальцев или улик.",
                                "zh": "侦探们检查了<w>案发现场</w>，寻找指纹或证据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "site",
                        "location",
                        "place",
                        "spot"
                    ],
                    "common_phrases": [
                        "scene of the crime",
                        "scene of the accident",
                        "arrive at the scene",
                        "flee the scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где произошло конкретное событие, часто неприятное (например, преступление или авария).",
                        "zh": "特定事件（通常是不愉快的事情，如犯罪或事故）发生的地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место",
                                "target_lang_sense_clarification": "локация события"
                            },
                            {
                                "target_lang_word": "место происшествия",
                                "target_lang_sense_clarification": "термин криминалистики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现场",
                                "target_lang_sense_clarification": "事件发生的地点"
                            },
                            {
                                "target_lang_word": "案发现场",
                                "target_lang_sense_clarification": "犯罪发生的地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                    "sense_definition": "A loud, angry argument or display of strong emotion in a public place that causes embarrassment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please calm down and do not make a <w>scene</w> in front of everyone.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, успокойся и не устраивай <w>сцену</w> у всех на глазах.",
                                "zh": "请冷静点，别在大家面前<w>闹事</w>。"
                            }
                        },
                        {
                            "text": "He caused a <w>scene</w> at the restaurant when the waiter brought the wrong order.",
                            "target_lang_translations": {
                                "ru": "Он устроил <w>скандал</w> в ресторане, когда официант принес не тот заказ.",
                                "zh": "当服务员上错菜时，他在餐厅里<w>出丑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion",
                        "fuss",
                        "tantrum",
                        "outburst"
                    ],
                    "common_phrases": [
                        "make a scene",
                        "cause a scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкая ссора или проявление сильных эмоций на людях, вызывающие неловкость у окружающих.",
                        "zh": "在公共场合大声争吵或表现出强烈情绪，引起尴尬的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцена",
                                "target_lang_sense_clarification": "бурное выяснение отношений"
                            },
                            {
                                "target_lang_word": "скандал",
                                "target_lang_sense_clarification": "публичная ссора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闹事",
                                "target_lang_sense_clarification": "引起骚乱"
                            },
                            {
                                "target_lang_word": "出丑",
                                "target_lang_sense_clarification": "丢脸的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "158cdf2e-97ed-3d45-9ba5-218c368dec96",
                    "sense_definition": "A view of a place or a situation as seen by an observer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a peaceful rural <w>scene</w> with sheep grazing in the fields.",
                            "target_lang_translations": {
                                "ru": "Художник нарисовал мирный сельский <w>пейзаж</w> с овцами, пасущимися на полях.",
                                "zh": "艺术家画了一幅宁静的乡村<w>景象</w>，羊群在田野里吃草。"
                            }
                        },
                        {
                            "text": "It was a chaotic <w>scene</w> at the market with people rushing everywhere.",
                            "target_lang_translations": {
                                "ru": "На рынке царила хаотичная <w>картина</w>: люди носились повсюду.",
                                "zh": "市场上是一片混乱的<w>画面</w>，人们到处奔走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "view",
                        "sight",
                        "spectacle",
                        "vista"
                    ],
                    "common_phrases": [
                        "street scene",
                        "beautiful scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид места или ситуации, наблюдаемый со стороны.",
                        "zh": "观察者所看到的地点或情况的景象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картина",
                                "target_lang_sense_clarification": "наблюдаемая ситуация"
                            },
                            {
                                "target_lang_word": "пейзаж",
                                "target_lang_sense_clarification": "вид природы"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "то, что предстает взору"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "景象",
                                "target_lang_sense_clarification": "所见到的情景"
                            },
                            {
                                "target_lang_word": "画面",
                                "target_lang_sense_clarification": "视觉呈现的状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e835b8c-bc1f-3aba-b6c6-80e17d066586",
                    "sense_definition": "A particular area of activity, interest, or way of life, and the people involved in it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has been very active in the local jazz <w>scene</w> for years.",
                            "target_lang_translations": {
                                "ru": "Она много лет принимает активное участие в местной джазовой <w>сцене</w>.",
                                "zh": "多年来，她一直活跃在当地的爵士乐<w>圈子</w>里。"
                            }
                        },
                        {
                            "text": "Going to loud clubs is not really my <w>scene</w> anymore.",
                            "target_lang_translations": {
                                "ru": "Ходить по шумным клубам — это больше не моя <w>тема</w>.",
                                "zh": "去吵闹的夜店已经不再是我的<w>圈子</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "world",
                        "circle",
                        "arena",
                        "environment"
                    ],
                    "common_phrases": [
                        "music scene",
                        "dating scene",
                        "social scene",
                        "not my scene"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in phrases like 'not my scene'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная сфера деятельности, интересов или образ жизни, а также вовлеченные в нее люди.",
                        "zh": "特定的活动领域、兴趣圈子或生活方式，以及参与其中的人群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сфера",
                                "target_lang_sense_clarification": "область деятельности"
                            },
                            {
                                "target_lang_word": "среда",
                                "target_lang_sense_clarification": "окружение"
                            },
                            {
                                "target_lang_word": "тусовка",
                                "target_lang_sense_clarification": "разговорное, круг общения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圈子",
                                "target_lang_sense_clarification": "特定兴趣群体"
                            },
                            {
                                "target_lang_word": "领域",
                                "target_lang_sense_clarification": "活动范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3b1cb3c-3513-3c2c-accf-f911154eba00",
                    "sense_definition": "The painted background, furniture, and structures on a stage that represent the location of the action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dramatic_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew worked quickly to change the <w>scenes</w> between the acts.",
                            "target_lang_translations": {
                                "ru": "Рабочие быстро меняли <w>декорации</w> между актами.",
                                "zh": "工作人员在幕间迅速更换了<w>布景</w>。"
                            }
                        },
                        {
                            "text": "We were lucky enough to get a tour behind the <w>scenes</w> of the theater.",
                            "target_lang_translations": {
                                "ru": "Нам посчастливилось попасть за <w>кулисы</w> театра.",
                                "zh": "我们很幸运能参观剧院的<w>后台</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scenery",
                        "set",
                        "setting",
                        "backdrop"
                    ],
                    "common_phrases": [
                        "behind the scenes",
                        "change the scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расписной фон, мебель и конструкции на сцене, изображающие место действия.",
                        "zh": "舞台上代表动作发生地点的背景、家具和结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декорации",
                                "target_lang_sense_clarification": "оформление сцены"
                            },
                            {
                                "target_lang_word": "кулисы",
                                "target_lang_sense_clarification": "закулисное пространство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布景",
                                "target_lang_sense_clarification": "舞台装饰"
                            },
                            {
                                "target_lang_word": "后台",
                                "target_lang_sense_clarification": "舞台后方区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d5f5fcb-b994-3880-9689-0ab189107980",
                    "sense_definition": "The place, time, or circumstances in which a story or event occurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author uses the first chapter to set the <w>scene</w> for the mystery.",
                            "target_lang_translations": {
                                "ru": "Автор использует первую главу, чтобы описать <w>обстановку</w> для детективной истории.",
                                "zh": "作者用第一章来为这个悬疑故事铺设<w>背景</w>。"
                            }
                        },
                        {
                            "text": "Paris was the <w>scene</w> of many important diplomatic meetings.",
                            "target_lang_translations": {
                                "ru": "Париж был <w>местом действия</w> многих важных дипломатических встреч.",
                                "zh": "巴黎是许多重要外交会议的举办<w>环境</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "setting",
                        "background",
                        "context"
                    ],
                    "common_phrases": [
                        "set the scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, время или обстоятельства, в которых происходит история или событие.",
                        "zh": "故事或事件发生的时间、地点或背景环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "место действия",
                                "target_lang_sense_clarification": "локация сюжета"
                            },
                            {
                                "target_lang_word": "обстановка",
                                "target_lang_sense_clarification": "условия происходящего"
                            },
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背景",
                                "target_lang_sense_clarification": "故事发生的条件"
                            },
                            {
                                "target_lang_word": "环境",
                                "target_lang_sense_clarification": "事件发生的场所"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "77fd93bb-f19d-3986-8a9d-6c4e84049c4b",
                    "sense_definition": "A command used in filmmaking or theater to signal the end of a performance or take.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theater_command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director shouted <w>scene</w> and the actors relaxed immediately.",
                            "target_lang_translations": {
                                "ru": "Режиссер крикнул «<w>Снято</w>», и актеры сразу расслабились.",
                                "zh": "导演喊了声“<w>停</w>”，演员们立刻放松了下来。"
                            }
                        },
                        {
                            "text": "After a long take, the call of <w>scene</w> was a relief to the crew.",
                            "target_lang_translations": {
                                "ru": "После долгого дубля команда «<w>Стоп</w>» стала облегчением для съемочной группы.",
                                "zh": "经过长时间的拍摄，那声“<w>停</w>”让剧组人员松了一口气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cut"
                    ],
                    "antonyms": [
                        "action"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Команда в кинопроизводстве или театре, сигнализирующая об окончании дубля или выступления.",
                        "zh": "电影或戏剧中用于示意表演或拍摄结束的指令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снято",
                                "target_lang_sense_clarification": "команда режиссера"
                            },
                            {
                                "target_lang_word": "стоп",
                                "target_lang_sense_clarification": "остановка съемки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停",
                                "target_lang_sense_clarification": "拍摄停止指令"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4f946be-c1d4-312e-ac57-cb36cf7fa5ef",
                    "sense_definition": "To exhibit something as a scene or display it dramatically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director <w>scened</w> the event to look like a tragic accident.",
                            "target_lang_translations": {
                                "ru": "Режиссер <w>инсценировал</w> событие так, чтобы оно выглядело как трагическая случайность.",
                                "zh": "导演将该事件<w>布置</w>得看起来像是一场悲剧事故。"
                            }
                        },
                        {
                            "text": "They <w>scened</w> the storefront to attract more customers during the festival.",
                            "target_lang_translations": {
                                "ru": "Они <w>оформили</w> витрину, чтобы привлечь больше покупателей во время фестиваля.",
                                "zh": "他们在节日期间对店面进行了<w>摆设</w>，以吸引更多顾客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "exhibit",
                        "stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представить что-либо как сцену или драматично продемонстрировать.",
                        "zh": "将某事呈现为场景或进行戏剧化的展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инсценировать",
                                "target_lang_sense_clarification": "разыграть"
                            },
                            {
                                "target_lang_word": "обставить",
                                "target_lang_sense_clarification": "оформить определенным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布置",
                                "target_lang_sense_clarification": "进行场景设计"
                            },
                            {
                                "target_lang_word": "摆设",
                                "target_lang_sense_clarification": "陈列展示"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}