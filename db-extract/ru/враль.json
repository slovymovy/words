                ],
                "senses": [
                    {
                        "sense_id": "35efd92d-0bb1-31d8-8995-6b44abff3993",
                        "entry_id": "57a70d14-409f-3f79-9f93-daaeb0a76f7c",
                        "glosses": [
                            "разг. любитель рассказывать небылицы, вздорные, нелепые и т. п. вещи; обманщик, врун, лгун, пустослов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a4618d-1ec5-473c-a964-0ce44bdcbe27",
                                "sense_id": "35efd92d-0bb1-31d8-8995-6b44abff3993",
                                "text": "Припечь бы калёными щипцами язык у такого враля."
                            },
                            {
                                "example_id": "35565e77-f380-4ad9-9dac-e93a7a99fd41",
                                "sense_id": "35efd92d-0bb1-31d8-8995-6b44abff3993",
                                "text": "У Гоголя где-то (забыл где) один враль начал об чём-то рассказывать и, может быть, сказал бы правду, «но сами собою представились такие подробности» в рассказе, что уж никак нельзя было сказать правду."
                            }
                        ]
                    }
                ],
