                                    {
                                        "sense_id": "2e1f1860-53b6-3fb9-9a52-603637e25957",
                                        "entry_id": "1ca71f73-a56f-3405-95a0-c16a0e741ccb",
                                        "glosses": [
                                            "Large projectile weapons, in modern usage usually large guns, but also rocket artillery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "333f23b3-040a-38d3-8046-c0ec1cdbdb2d",
                                        "entry_id": "1ca71f73-a56f-3405-95a0-c16a0e741ccb",
                                        "glosses": [
                                            "An army unit that uses such weapons, or a military formation using projectile weapons, such as archers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73814afa-51c0-358f-8847-9d53b1b870b8",
                                        "entry_id": "1ca71f73-a56f-3405-95a0-c16a0e741ccb",
                                        "glosses": [
                                            "Gunnery (design and manufacture of guns)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "333fc516-8249-3f7f-acef-2abdf810cefc",
                                        "entry_id": "1ca71f73-a56f-3405-95a0-c16a0e741ccb",
                                        "glosses": [
                                            "Weapons, especially siege engines."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49beaef8-3f9e-4aab-8cfa-7675c25e625a",
                                                "sense_id": "333fc516-8249-3f7f-acef-2abdf810cefc",
                                                "text": "And Ionathan gaue his artillery vnto his ladde, and said vnto him, Goe, cary them to the citie.",
                                                "translation": "And Jonathan gave his weapons unto his lad, and said unto him, Go, carry them to the city. (American Standard Version)",
                                                "english": "And Jonathan gave his weapons unto his lad, and said unto him, Go, carry them to the city. (American Standard Version)"
                                            },
                                            {
                                                "example_id": "4c271c5d-f4df-4b94-960b-2343a1448ca1",
                                                "sense_id": "333fc516-8249-3f7f-acef-2abdf810cefc",
                                                "text": "The old walls […] were surely strong enough to keep out men without battering-rams, balistas, or artillery of any kind. [Footnote] Artillery is here used in its old English meaning for any kind of warlike engine. Cf. I Sam. XX. 40."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f239986a-6eb3-392f-8803-d9777fa1f6c0",
                                        "entry_id": "1ca71f73-a56f-3405-95a0-c16a0e741ccb",
                                        "glosses": [
                                            "One or more guns."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768bf996-9cf5-4655-ab98-5b9a1923d38d",
                        "source_entry_id": "893baa43-a362-33cf-ac41-a5c85cf1a4f4",
                        "source_sense_id": "42f31c28-e470-3ec8-bd57-4fe6618932bd",
                        "target_lang_word": "artillerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artillerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                        "entry_id": "affc0604-c476-31c9-b3c2-a114711cffa7",
                                        "glosses": [
                                            "Partie du matériel de guerre qui comprend les canons, les mortiers, les bombes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5d4ebc9-42e4-444a-b41a-274ab13fddad",
                                                "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                                "text": "Des détonations retentissaient incessamment, comparables aux décharges continues d’une formidable artillerie."
                                            },
                                            {
                                                "example_id": "d1fb0c76-517c-4ad9-8dc9-f713a9b581e9",
                                                "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                                "text": "Enfin la dernière nous paraît représenter le bosson, ou bélier des anciens, avec lequel on battait en brèche les murailles avant l’emploi de l’artillerie."
                                            },
                                            {
                                                "example_id": "3feb7910-2e9e-4491-aa98-13006b46fcf8",
                                                "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                                "text": "Mais au lieu des secours attendus, ses habitants ne reçurent de Joseph I que l’ordre de l’évacuer. Ils obéirent malgré eux, mais non sans avoir encloué leur artillerie et mis le feu à leurs maisons et aux poudres."
                                            },
                                            {
                                                "example_id": "05fb89f7-467d-43c7-9701-dcedf9eea2df",
                                                "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                                "text": "Toute la troupe prend les armes ; les pièces d’artillerie se rebraquent de nouveau sur le pont, et tout présage les plus grands malheurs."
                                            },
                                            {
                                                "example_id": "30708f51-da32-403c-ba1f-2aa145329d25",
                                                "sense_id": "da577e31-f2e0-3016-b87d-9b5e502b8870",
                                                "text": "Ce n’est qu’un répit. L’artillerie viet prend la relève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "008e63d0-93c3-3577-b6fb-fe1977b1c533",
                                        "entry_id": "affc0604-c476-31c9-b3c2-a114711cffa7",
                                        "glosses": [
                                            "Troupes employées au service de l’artillerie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9bf7dc9-2aaa-46f5-9f70-74108232fe4d",
                                                "sense_id": "008e63d0-93c3-3577-b6fb-fe1977b1c533",
                                                "text": "Je laisse à la garde d’un lieutenant d’artillerie quatre droguistes à bicyclette, d’allure allemande, qui prétendent aller à Mulhouse, leurs communes manquant d’aspirine."
                                            },
                                            {
                                                "example_id": "a69dfe9d-b838-491c-9f44-aaa584a648b0",
                                                "sense_id": "008e63d0-93c3-3577-b6fb-fe1977b1c533",
                                                "text": "Quoiqu'on en ait dit, non seulement il y avait des soldats dans Albert quand le bombardement commença, mais un état-major s'y trouvait. L’artillerie' française s'appuyait sur la ville."
                                            },
                                            {
                                                "example_id": "974a10dc-8e9a-4849-8c13-83f006efb4f2",
                                                "sense_id": "008e63d0-93c3-3577-b6fb-fe1977b1c533",
                                                "text": "Je donnai l'ordre à l’artillerie d’aller occuper la croupe à l’ouest de Burnhaupt-le-Haut. En y arrivant, vers 15 heures, je constatai que mon artillerie s’était portée beaucoup trop en arrière au sud du bois de Langlittenhaag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
