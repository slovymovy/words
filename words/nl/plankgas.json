                            {
                                "target_lang_word": "at full throttle",
                                "target_lang_sense_clarification": "with maximum power or speed"
                            },
                            {
                                "target_lang_word": "flat out",
                                "target_lang_sense_clarification": "at maximum speed"
                            },
                            {
