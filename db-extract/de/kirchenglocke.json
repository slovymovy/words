                ],
                "senses": [
                    {
                        "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                        "entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                        "glosses": [
                            "Glocke, die zum Geläut einer Kirche gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125195a8-5eae-4003-8a0e-7cc0426045ca",
                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                "text": "„Außerdem hatte Schneedorf ja seine mächtig tönenden Kirchenglocken, deren Ruf, wenn es zum Beispiel irgendwo brannte, auch noch im entferntesten Einödhof gehört wurde.“"
                            },
                            {
                                "example_id": "162d85d9-17ed-45f6-b17f-bcf306bc74e5",
                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                "text": "„Entfernt nahm ich die Schläge einer Kirchenglocke wahr.“"
                            },
                            {
                                "example_id": "0fd343a2-a19a-450d-a34c-005b1196e11e",
                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                "text": "„In der Ferne läuten Kirchenglocken.“"
                            },
                            {
                                "example_id": "6fa19f07-3d15-490e-8697-51ed3521334b",
                                "sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                                "text": "„Die Kirchenglocke schlägt sechs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7269031c-aecb-45e4-9f7c-c567e226a510",
                        "source_entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                        "source_sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                        "source_sense_description": "Glocke, die zum Geläut einer Kirche gehört",
                        "target_lang_word": "church bell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "church bell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "502c5651-9bfd-3351-9bb0-87497b0eb212",
                                        "entry_id": "23904225-bd32-3c0d-a706-111985f43c92",
                                        "glosses": [
                                            "A bell belonging to a church, usually housed in a tower or steeple, customarily rung before church services or for other occasions such as weddings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6f747bd-002c-4962-bf96-9d8da251d891",
                                                "sense_id": "502c5651-9bfd-3351-9bb0-87497b0eb212",
                                                "text": "As we stood waiting for the departure time with the setting sun twinkling on the great brass dome of our 2-4-0, the sound of church bells was the only one apart from the measured tread of the guard slowly pacing towards his van, and, standing at an open window, I more than once heard the fireman's \"Right away!\" to his mate in acknowledgement of a desultory wave of the unfurled green flag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fac680d-4e16-4068-abcc-742b2d5ae543",
                        "source_entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                        "source_sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
