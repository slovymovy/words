                "senses": [
                    {
                        "sense_id": "dac01d2c-d7dd-310c-9616-e99ee4eb589b",
                        "entry_id": "a2cfad62-8f62-3ddd-9272-7f7f0d3a735a",
                        "glosses": [
                            "jemand, der über eine umfassende Vollmacht für alle rechtlichen Stellvertretungen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d8caf1f-004e-49dc-adae-e36f625d4660",
                                "sense_id": "dac01d2c-d7dd-310c-9616-e99ee4eb589b",
                                "text": "„Diese Aufgabe wird SS-Obergruppenführer und General der Waffen-SS Frank als Generalbevollmächtigter für das Berichtsund Auswertungswesen durchführen.“"
                            },
                            {
                                "example_id": "5a55666b-2097-4364-a065-f1bf98ed3533",
                                "sense_id": "dac01d2c-d7dd-310c-9616-e99ee4eb589b",
                                "text": "„Andreas Torner war zuletzt als Generalbevollmächtigter bei der Citibank für das Vertriebsressort verantwortlich.“"
                            },
                            {
                                "example_id": "6e359b34-37c0-4528-a671-cd839d02dd5f",
                                "sense_id": "dac01d2c-d7dd-310c-9616-e99ee4eb589b",
                                "text": "„Bis vor kurzem war der Mann Generalbevollmächtigter des VW-Konzerns und rechte Hand des Vorstandsvorsitzenden Martin Winterkorn in allen Dingen der Kommunikation mit der Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
