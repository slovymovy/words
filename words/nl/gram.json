                {
                    "sense_id": "d4792e2c-88f6-3609-a8b5-db90deee562f",
                    "sense_definition": "Een eenheid van massa die gelijk is aan één duizendste van een kilogram.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>gram</w> van een stof is ook op de maan een <w>gram</w>.",
                            "target_lang_translations": {
                                "en": "A <w>gram</w> of a substance is also a <w>gram</w> on the moon."
                            }
                        },
                        {
                            "text": "In totaal scheelden deze multifunctionele stokken mij 350 <w>gram</w> aan gewicht.",
                            "target_lang_translations": {
                                "en": "In total, these multifunctional poles saved me 350 <w>grams</w> in weight."
                            }
                        }
                    ],
                    "common_phrases": [
                        "honderd gram kaas",
                        "per gram betalen"
                    ],
                    "target_lang_definitions": {
