                "senses": [
                    {
                        "sense_id": "1fad4d67-4e56-3afd-80fb-8ebd9b85a460",
                        "entry_id": "79164dcd-fd42-30d0-a9e9-3c161a540099",
                        "glosses": [
                            "eine umschriebene oder allgemeine Verminderung der Berührungs- und Drucksensibilität der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a536da-5b3d-408c-b941-42709b800eb9",
                                "sense_id": "1fad4d67-4e56-3afd-80fb-8ebd9b85a460",
                                "text": "„Ich erinnere an jenen häufigen Syndromenkomplex einer Vagusneurose […], wo wir Hypästhesie des Pharynx und Larynx, also Untererregbarkeit und Bradykardie, also Übererregung des Vagus, vereint finden.“"
                            },
                            {
                                "example_id": "18034ac8-9826-4609-9f91-67dc98ea7970",
                                "sense_id": "1fad4d67-4e56-3afd-80fb-8ebd9b85a460",
                                "text": "„Bei Sensibilitätsstörungen kann es sich um eine Hypästhesie, Dysästhesie oder Parästhesie (Missempfindung) handeln, auch die Schmerzwahmehmung kann betroffen sein.“"
                            },
                            {
                                "example_id": "783fc30b-b496-4ce1-a441-df3becc967b6",
                                "sense_id": "1fad4d67-4e56-3afd-80fb-8ebd9b85a460",
                                "text": "„Von der Mitte des li. Oberschenkels abwärts wird nach distal zunehmend eine Hypästhesie angegeben ohne gröbere Ausfälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
