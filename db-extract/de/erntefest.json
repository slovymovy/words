                "senses": [
                    {
                        "sense_id": "52a95f08-46bc-331f-9e4b-f49312e570fe",
                        "entry_id": "bf5aeedb-daff-36bf-8844-6b3914698ada",
                        "glosses": [
                            "Fest, bei dem das Einbringen der Ernte gefeiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889bca82-2ef0-4350-b854-560ab02b203f",
                                "sense_id": "52a95f08-46bc-331f-9e4b-f49312e570fe",
                                "text": "„So heißt es am Anfang des langen Gedichts, das im Frieden alljährlich beim Erntefest ein Mädchen im weißen Kleid aufsagte.“"
                            },
                            {
                                "example_id": "d3955602-10b0-413d-b364-45903f8f729b",
                                "sense_id": "52a95f08-46bc-331f-9e4b-f49312e570fe",
                                "text": "„Bald werden sie das Erntefest feiern, der Nachtwächter wird die Trompete blasen, und Mareike wird um die große Hocke tanzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
