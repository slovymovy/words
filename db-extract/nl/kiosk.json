                "senses": [
                    {
                        "sense_id": "f17f0b30-ee93-342f-b9ea-4f1818691121",
                        "entry_id": "11dd757b-2ac3-3ea3-ac52-98a54d9745a1",
                        "glosses": [
                            "klein vrijstaand winkeltje waar men snoep, koffie, kranten en tijdschriften kan kopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a31e53-9153-4dea-b0d2-6b4be8388934",
                                "sense_id": "f17f0b30-ee93-342f-b9ea-4f1818691121",
                                "text": "Een kiosk is handig voor reizigers die snel wat nodig hebben voor hun reis"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a3c6caa-b89a-4a68-83e6-931b39d97fcb",
                        "source_entry_id": "11dd757b-2ac3-3ea3-ac52-98a54d9745a1",
                        "source_sense_id": "f17f0b30-ee93-342f-b9ea-4f1818691121",
                        "source_sense_description": "klein vrijstaand winkeltje waar men snoep, koffie, kranten en tijdschriften kan kopen",
                        "target_lang_word": "Kiosk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiosk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6d9dd39-3979-3177-8c2b-e1ad78d7efea",
                                        "entry_id": "a06e511a-b349-39f3-a578-d5024f591c16",
                                        "glosses": [
                                            "nach mehreren Seiten offener, freistehender Bau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8876d137-c75a-4580-97d0-a2fae7362e06",
                                                "sense_id": "d6d9dd39-3979-3177-8c2b-e1ad78d7efea",
                                                "text": "Dazu gehörten ein Maurischer Kiosk, eine Indische Fischerhütte, ein Indisches Zelt, ein See und zahlreiche exotische Pflanzen."
                                            },
                                            {
                                                "example_id": "8762679a-e106-4564-a5a9-6f7a30740497",
                                                "sense_id": "d6d9dd39-3979-3177-8c2b-e1ad78d7efea",
                                                "text": "„Rechts vorn ist ein Kiosk errichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a068394f-0f41-38d5-9777-4843fb0fcf83",
                                        "entry_id": "a06e511a-b349-39f3-a578-d5024f591c16",
                                        "glosses": [
                                            "Laden zum Verkauf von Kleinigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d23d78-d9f2-4659-8542-6cc2f45c3d94",
                                                "sense_id": "a068394f-0f41-38d5-9777-4843fb0fcf83",
                                                "text": "Am Kiosk werden Süßigkeiten verkauft."
                                            },
                                            {
                                                "example_id": "a9ad7937-29f7-43e6-b8d4-eefcfe52fde4",
                                                "sense_id": "a068394f-0f41-38d5-9777-4843fb0fcf83",
                                                "text": "„An einem Kiosk kaufe ich mir eine Dreitageskarte für den öffentlichen Nahverkehr.“"
                                            },
                                            {
                                                "example_id": "26062f11-a47d-4ed0-ab2e-9bf0b0bdc95f",
                                                "sense_id": "a068394f-0f41-38d5-9777-4843fb0fcf83",
                                                "text": "„In einer Ecke des Postamtes stand ein kleiner Kiosk mit der Aufschrift »Volksapotheke«.“"
                                            },
                                            {
                                                "example_id": "575ee829-c11a-4355-946a-0c0be51e2da1",
                                                "sense_id": "a068394f-0f41-38d5-9777-4843fb0fcf83",
                                                "text": "„Ich schaute mir den Kasten sehr genau an und ging um den Kiosk herum, und dann fragte ich den Mann im Kiosk, was das über ihm für ein Kasten sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b18d22c1-9967-40d3-8ee1-77909d4b8e31",
                        "source_entry_id": "11dd757b-2ac3-3ea3-ac52-98a54d9745a1",
                        "source_sense_id": "f17f0b30-ee93-342f-b9ea-4f1818691121",
                        "source_sense_description": "klein vrijstaand winkeltje waar men snoep, koffie, kranten en tijdschriften kan kopen",
                        "target_lang_word": "Verkaufsstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkaufsstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                        "entry_id": "de6d3461-6fdb-335a-9f51-3bcdaff9a54f",
                                        "glosses": [
                                            "schnell auf- und abbaubare Verkaufsstelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc6830b-25b6-4043-b635-1c850dfbad6f",
                                                "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                                "text": "Auf dem Wochenmarkt bieten viele Verkaufsstände Obst und Gemüse an."
                                            },
                                            {
                                                "example_id": "b83d5cb7-866d-4b48-9e23-5d1973d743d8",
                                                "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                                "text": "„Wir blicken über den Platz, auf dem Verkaufsstände stehen, die heute, an einem Sonntag, leer stehen, und während wir uns vom Denkmal entfernen, sehen wir den Mann noch einmal durch das Fernglas Richtung Kleber schauen.“"
                                            },
                                            {
                                                "example_id": "d39a69ed-e63d-4bed-84ca-c0a5e67141fc",
                                                "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                                "text": "„Die Kaufleute begannen in ihren Verkaufsständen wieder Waren feilzuhalten.“"
                                            },
                                            {
                                                "example_id": "1dd3dede-0fb4-49e5-8ee9-1862e7e41c3a",
                                                "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                                "text": "„Tatsächlich hatte ich den Mann gekannt, ebenso wie ihn die ganze Stadt Venedig an dem Verkaufsstand für einen Balsam gekannt haben mußte.“"
                                            },
                                            {
                                                "example_id": "fcd9b862-3556-4ae0-8c9c-28d755216889",
                                                "sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
                                                "text": "„Der auf die öffentlichen Verkaufsstände bschränkte Handel sollte dem Rat die Kontrolle ermöglichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
