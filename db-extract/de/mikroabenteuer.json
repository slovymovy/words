                        "target_lang_word": "microadventure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microadventure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e235f7c3-3c4c-3c2b-93f8-5570da997de4",
                                        "entry_id": "4325661b-764e-3c5e-bc28-14c4bbe5b256",
                                        "glosses": [
                                            "A short adventure, typically sought on a weekend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e9038c-238d-4e30-b0fe-460715f3eaee",
                                                "sense_id": "e235f7c3-3c4c-3c2b-93f8-5570da997de4",
                                                "text": "So how do you train yourself to find awe? One answer may be microadventures. A microadventure is exactly what it sounds like: a short, simple, cheap, local version of an adventure."
                                            },
                                            {
                                                "example_id": "37562deb-5836-4b34-8b61-7ab5f8149f19",
                                                "sense_id": "e235f7c3-3c4c-3c2b-93f8-5570da997de4",
                                                "text": "In 2011, amid struggles to secure funding for an Antarctic expedition, [Alastair] Humphreys started blogging about “microadventures”: inclusive, easy-to-emulate escapades like “sleeping outdoors” or “foraging for a meal”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
