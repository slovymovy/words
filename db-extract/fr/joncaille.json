                "senses": [
                    {
                        "sense_id": "fb6671a7-e300-309f-82cf-aa0a5d57cc44",
                        "entry_id": "6d162346-7d1e-34c6-b817-3b60ee64ad9c",
                        "glosses": [
                            "Or."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1fb686a5-ca82-4e89-be27-007d782dcc2f",
                                "sense_id": "fb6671a7-e300-309f-82cf-aa0a5d57cc44",
                                "text": "D’autant qu’il n’aurait pas aimé qu’on rôdât dans son bureau, trop près du coffre sérieux où il entreposait la joncaille."
                            },
                            {
                                "example_id": "d3d39077-23f6-4ad2-b1b1-7a136f4fb169",
                                "sense_id": "fb6671a7-e300-309f-82cf-aa0a5d57cc44",
                                "text": "Elle scintille, elle néone, elle embrase, elle irradie, elle étincelle, elle flambe, elle postillonne des reflets, dans sa carapace de joncaille, de diams et de perlouzes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b683c83-3093-3623-9fe6-433b78ad091a",
                        "entry_id": "6d162346-7d1e-34c6-b817-3b60ee64ad9c",
                        "glosses": [
                            "Bijoux, objet ou ensemble d’objets en or."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ae06af2e-2caf-480b-b6f8-4957c221622e",
                                "sense_id": "7b683c83-3093-3623-9fe6-433b78ad091a",
                                "text": "Les temps sont mauvais pour ces négociants en belle joncaille. Braqué, le bijoutier Van Gold, rue de Caumartin à Paris. Braqué, l’établissement Cartier avenue Montaigne. Braquée encore, en août 1983, sa succursale sur la Croisette à Cannes."
                            },
                            {
                                "example_id": "0444be64-ed67-4240-9013-c47c8a830065",
                                "sense_id": "7b683c83-3093-3623-9fe6-433b78ad091a",
                                "text": "Si les deux auxi égyptiens qui le trouvèrent avaient donné l’alarme, il serait peut-être encore en vie. Ils préférèrent le soulager de son horloge et de sa joncaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e44016b-731c-3346-aa68-9e15dccfdf86",
                        "entry_id": "6d162346-7d1e-34c6-b817-3b60ee64ad9c",
                        "glosses": [
                            "Lieu où poussent les joncs."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1e0a91f0-5083-4d14-8897-ebb7189a7154",
                                "sense_id": "5e44016b-731c-3346-aa68-9e15dccfdf86",
                                "text": "Il tourna la tête et, à travers les roseaux, il les vit qui chevauchaient sur la joncaille, loin, dans une trouée de soleil mauve, près d’un étang mort qui s’étalait sous la résille de feu du crépuscule."
                            },
                            {
                                "example_id": "409c1c2c-7eb6-48d7-b819-3ecd06f537b0",
                                "sense_id": "5e44016b-731c-3346-aa68-9e15dccfdf86",
                                "text": "Dans la vallée, au-dessus des prairies humides et des espaces de joncaille, des bouquets de brume restaient en suspens, comme ces filaments de laine grise que les brebis laissent aux buissons ou aux fils de fer barbelé des palissades."
                            }
                        ]
                    }
                ],
