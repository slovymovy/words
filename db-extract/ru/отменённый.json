                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee07b591-1f78-49b0-94f1-aea8736480b9",
                                                "sense_id": "63cad52f-1b0e-3a80-a172-1217a0f6d3f3",
                                                "text": "Most of the cancelled specimens were somewhat less valuable philatelically."
                                            }
