                "senses": [
                    {
                        "sense_id": "483bec0f-14c4-3e78-bb80-29715107903c",
                        "entry_id": "42c2dc41-3124-345a-86c5-477ebaa1142e",
                        "glosses": [
                            "Brioche consommée durant la période de la Saint-Nicolas et de Noël. Sa forme rappelle celle d’un bébé emmailloté et fait ainsi référence à l’enfant Jésus."
                        ],
                        "tags": [
                            "Belgique",
                            "Nord de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "07c9b4ce-33ae-4e42-85fb-b120360cd6ee",
                                "sense_id": "483bec0f-14c4-3e78-bb80-29715107903c",
                                "text": "Le 8 février 1632, selon les termes d’une sentence du conseil provincial de Stavelot, chaque ménage de Comblain, pour contribuer à l’entretien du passage d’eau, devra annuellement un pain ou un cougnou de trois demi-livres ou trois patars."
                            }
                        ]
                    }
