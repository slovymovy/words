                ],
                "senses": [
                    {
                        "sense_id": "6c67c25e-d542-35e7-a6d6-7fd2edd37805",
                        "entry_id": "9faad610-733b-38ce-b01a-16946ad5e916",
                        "glosses": [
                            "Femme qui exerce une certaine activité en tant que profession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d90cc5-6ca4-4441-9eda-79ee207e080f",
                                "sense_id": "6c67c25e-d542-35e7-a6d6-7fd2edd37805",
                                "text": "« Nous avons une quinzaine de places manquantes, car il manque deux professionnelles, et nous n’avons aucune certitude quant à la possibilité de nouvelles arrivées », s’inquiète Myriam Lelion, la responsable de la crèche."
                            }
                        ]
                    },
                    {
                        "sense_id": "f242b317-c3ab-306e-b56e-e0fe6f71f80a",
                        "entry_id": "9faad610-733b-38ce-b01a-16946ad5e916",
                        "glosses": [
                            "Prostituée."
                        ],
                        "tags": [
                            "euphemism",
                            "pejorative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "727d3652-64f2-43d1-8af9-e618ec181435",
                                "sense_id": "f242b317-c3ab-306e-b56e-e0fe6f71f80a",
                                "text": "J’ai souvenance du cas d’un de mes camarades d’étude, qui, à l’âge de 18 ans, racolé un soir sur nos grands boulevards par une professionnelle, contracta d’elle la syphilis et mourut dix ans plus tard d’une paralysie générale due à cette infection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d333d64-68e5-4368-8811-cf9defe1fbd0",
                        "source_entry_id": "9faad610-733b-38ce-b01a-16946ad5e916",
                        "target_lang_word": "professional",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92f90e18-7a89-360b-96eb-cf6d737aa77e",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "A person who belongs to a profession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "416922f5-8571-336c-9aad-8785a1929054",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "A person who earns their living from a specified activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4f921e-efdc-4cb7-bd84-70e1b8d931ac",
                                                "sense_id": "416922f5-8571-336c-9aad-8785a1929054",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa6b0743-16d9-360d-a2c9-14773963de12",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccab37fa-c7de-46e9-8f29-485ed6397042",
                                                "sense_id": "aa6b0743-16d9-360d-a2c9-14773963de12",
                                                "text": "There was this nice lady who flirted with me at the bar, but it turned out that she was a professional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82d12b7-c435-387c-b2fc-8d0fafabc424",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "A reputation known by name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ce3051b-a5d4-3835-86bd-9a60a11f5d73",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "An expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1750f6bf-afb2-4fd9-8028-b2bb8090bc9a",
                                                "sense_id": "7ce3051b-a5d4-3835-86bd-9a60a11f5d73",
                                                "text": "I have learned that there is a person attached to a golf club called a professional. Find out who fills that post at the Green Meadow Club; […] invite the professional, urgently, to dine with us this evening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef018b38-485e-34d3-b56b-8a210f824c9d",
                                        "entry_id": "fcbae3b9-bdbf-39d5-a5b7-0e879bbcfb96",
                                        "glosses": [
                                            "One of four categories of sociologist propounded by Horowitz: a sociologist who is actively concerned with promoting the profession of sociology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "professional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abf53041-2e3e-3a00-abf7-8b32a6352c7b",
                                        "entry_id": "7652839a-6a64-38fd-8732-b1ceb5654676",
                                        "glosses": [
                                            "Of, pertaining to, or in accordance with the (usually high) standards of a profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5691a4d6-78db-4b57-b052-d41e1be1f64a",
                                                "sense_id": "abf53041-2e3e-3a00-abf7-8b32a6352c7b",
                                                "text": "His forefathers had been, as a rule, professional men—physicians and lawyers; his grandfather died under the walls of Chapultepec Castle while twisting a tourniquet for a cursing dragoon; an uncle remained indefinitely at Malvern Hill;[…]."
                                            },
                                            {
                                                "example_id": "df06ef95-c158-48fc-8e7e-ff59a4a0f67a",
                                                "sense_id": "abf53041-2e3e-3a00-abf7-8b32a6352c7b",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f3ba58-5e74-3005-9e4f-61753cadfdd5",
                                        "entry_id": "7652839a-6a64-38fd-8732-b1ceb5654676",
                                        "glosses": [
                                            "That is carried out for money, especially as a livelihood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88b42222-6fd4-33e9-bcac-c63440c6a0b9",
                                        "entry_id": "7652839a-6a64-38fd-8732-b1ceb5654676",
                                        "glosses": [
                                            "Expert."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
