                        "glosses": [
                            "An extratropical storm, usually found in coastal New England and Atlantic Canada, whose winds usually come from the northeast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8142c69b-db63-47dd-bc9b-3f5984978fcf",
                                "sense_id": "e58a70e7-9354-33b3-8598-fe6d451339f8",
                                "text": "A northeaster in one place may be an easter, a norther, or a souther in some other locality."
                            },
                            {
                                "example_id": "9a3df6f9-e0f2-4979-8e65-df08b52fb0ba",
                                "sense_id": "e58a70e7-9354-33b3-8598-fe6d451339f8",
                                "text": "A wave simulator in the tank can re-enact tsunamis and northeasters, and imitate wave conditions from midocean."
                            }
                        ]
                    }
