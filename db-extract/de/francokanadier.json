                        "glosses": [
                            "kanadischer Staatsbürger, der die französische Sprache beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ba1cec-84e8-4d31-a6f0-7d3ba094b9d3",
                                "sense_id": "3ae81717-8b9e-3c96-bb6f-0fcb8ea2ae0b",
                                "text": "„Nach der Vertragsverlängerung von Jaques Villeneuve bei seinem alten Rennstall ist der Francokanadier der Fahrer mit dem nach Michael Schumacher zweithöchsten Gehalt in der Formel 1.“"
                            },
                            {
                                "example_id": "e68f49b0-5abb-442c-9e9e-c204d9365e8c",
                                "sense_id": "3ae81717-8b9e-3c96-bb6f-0fcb8ea2ae0b",
                                "text": "„Die Politik der Zweisprachigkeit und des kulturellen Dualismus, die Pearson eingeleitet hatte und die sein Nachfolger, der liberale Francokanadier Pierre Elliott Trudeau, der Premierminister der Jahre 1968 bis 1979 und1980 bis 1984, fortsetzte, zeitigte nicht die von Ottawa erhofften Erfolge.“"
                            }
                        ],
