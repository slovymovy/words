                "senses": [
                    {
                        "sense_id": "80198ac2-e6df-3c66-aeec-e43193181c44",
                        "entry_id": "edd4dc92-82d4-39b1-a4c5-31b11d53cdb3",
                        "glosses": [
                            "mit Cognac gefüllte Flasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2450c1eb-5ea8-43b8-a13a-9803bf4380ce",
                                "sense_id": "80198ac2-e6df-3c66-aeec-e43193181c44",
                                "text": "„1894 wurde dann die erste maschinengefertigte Cognacflasche hergestellt, und das Zeitalter der uniformen Flaschen begann.“"
                            },
                            {
                                "example_id": "89335b75-b066-438e-9e17-9203a8503dfa",
                                "sense_id": "80198ac2-e6df-3c66-aeec-e43193181c44",
                                "text": "„Black lächelte besänftigt und griff nach der Cognacflasche.“"
                            },
                            {
                                "example_id": "628bb506-f300-4098-8569-dfdb40974cab",
                                "sense_id": "80198ac2-e6df-3c66-aeec-e43193181c44",
                                "text": "„Sie hatte mit dem Aushändigen der Post bis zum Morgen warten wollen, weil sie wusste, dass die Umstände dann günstiger wären, wenn Vater und Sohn nicht bloß darauf erpicht waren, sich so schnell wie möglich mit der Cognacflasche in den Stall zu verziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
