                                    {
                                        "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                                        "entry_id": "7f88f792-039b-3101-9337-0f7195c44564",
                                        "glosses": [
                                            "Dessin schématique désignant le plus clairement possible une direction, une fonction ou une action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20cc287c-0287-4cb4-9884-6a592e4e57fc",
                                                "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                                                "text": "Dans les temps historiques, la traduction spatiale du développement d’une action conduit du mythogramme au pictogramme et aux diverses formes de signes linéarisés qui sont caractéristiques de l’écriture."
                                            },
                                            {
                                                "example_id": "c23c25a6-81be-4cfc-ae8c-86cd34f454ec",
                                                "sense_id": "57cb190b-15dc-389d-9037-17bcd5afe6ac",
                                                "text": "Une histoire sans mots est réellement une histoire sans mots. À partir de pictogrammes totalement inventés, voici, heure par heure, une journée de M. Noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786e0274-a4fb-38cb-bb39-63d239e8d6ae",
