                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bel ging en de kinderen <w>stormden</w> direct naar buiten.",
                            "target_lang_translations": {
                                "ru": "Прозвенел звонок, и дети сразу <w>ринулись</w> на улицу.",
                                "en": "The bell rang and the children immediately <w>rushed</w> outside.",
                                "pl": "Zadzwonił dzwonek i dzieci natychmiast <w>wypadły</w> na zewnątrz.",
                                "de": "Es klingelte und die Kinder <w>stürmten</w> sofort nach draußen.",
                                "fr": "La sonnerie a retenti et les enfants se sont immédiatement <w>précipités</w> dehors.",
                                "it": "Suonò la campanella e i bambini si <w>precipitarono</w> subito fuori.",
                                "cs": "Zazvonilo a děti se okamžitě <w>vyřítily</w> ven.",
                                "tr": "Zil çaldı ve çocuklar hemen dışarı <w>fırladılar</w>.",
                                "es": "Sonó el timbre y los niños <w>salieron disparados</w> hacia afuera.",
                                "zh": "铃声一响，孩子们立刻<w>冲</w>到了外面。"
                            }
                        },
                        {
                            "text": "Hij <w>stormde</w> woedend de vergaderzaal uit zonder iets te zeggen.",
                            "target_lang_translations": {
                                "ru": "Он в ярости <w>вылетел</w> из конференц-зала, не сказав ни слова.",
                                "en": "He <w>stormed</w> furiously out of the meeting room without saying a word.",
                                "pl": "Wściekły <w>wypadł</w> z sali konferencyjnej, nie mówiąc ani słowa.",
                                "de": "Er <w>stürmte</w> wütend aus dem Konferenzraum, ohne etwas zu sagen.",
                                "fr": "Il est <w>sorti en trombe</w> de la salle de réunion, furieux, sans dire un mot.",
                                "it": "Lui <w>irruppe</w> fuori dalla sala riunioni furioso senza dire una parola.",
                                "cs": "Vztekle <w>vyletěl</w> z jednací místnosti, aniž by cokoli řekl.",
                                "tr": "Hiçbir şey söylemeden öfkeyle toplantı salonundan <w>fırlayıp çıktı</w>.",
                                "es": "Él <w>salió furioso</w> de la sala de reuniones sin decir nada.",
                                "zh": "他一言不发，愤怒地<w>冲</w>出了会议室。"
                            }
                        }
