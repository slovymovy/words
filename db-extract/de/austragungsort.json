                                "target_senses": [
                                    {
                                        "sense_id": "1198bfb8-e7c9-3621-bf43-d3b7381bb8b1",
                                        "entry_id": "b8e7f666-2846-3f28-9d90-7c5ed0e4d066",
                                        "glosses": [
                                            "A theater, auditorium, arena, or other area designated for sporting or entertainment events."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b27b4d13-50a1-3eb1-bac0-096fd6691604",
                                        "entry_id": "b8e7f666-2846-3f28-9d90-7c5ed0e4d066",
                                        "glosses": [
                                            "A neighborhood or near place; the place or county in which anything is alleged to have happened; also, the place where an action is laid, or the district from which a jury comes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9178c-0fc0-4d8e-a181-87ea6ae9c168",
                                                "sense_id": "b27b4d13-50a1-3eb1-bac0-096fd6691604",
                                                "text": "The twelve men who are to try the cause must be of the same venue where the demand is made."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6546689-cc05-3744-8793-4a2d016f68bc",
                                        "entry_id": "b8e7f666-2846-3f28-9d90-7c5ed0e4d066",
                                        "glosses": [
                                            "A bout; a hit; a turn."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33309112-4306-31fa-9959-63aa296159a6",
                                        "entry_id": "b8e7f666-2846-3f28-9d90-7c5ed0e4d066",
                                        "glosses": [
                                            "A stadium or similar building in which a sporting competition is held."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051f6150-fc8d-4add-afaf-3afd678f8706",
                                                "sense_id": "33309112-4306-31fa-9959-63aa296159a6",
                                                "text": "With such focus from within the footballing community this week on Remembrance Sunday, there was something appropriate about Colchester being the venue for last night’s game. Troops from the garrison town formed a guard of honour for both sets of players, who emerged for the national anthem with poppies proudly stitched into their tracksuit jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e9046b2-e63f-3aec-a70f-b7529fd8d74d",
                                        "entry_id": "b8e7f666-2846-3f28-9d90-7c5ed0e4d066",
                                        "glosses": [
                                            "The place where something happens."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4eff33-ab5e-4bea-96b5-8e2a79c59f82",
                                                "sense_id": "3e9046b2-e63f-3aec-a70f-b7529fd8d74d",
                                                "text": "The metalworking forum is not the appropriate venue for this discussion about politics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
