                    {
                        "translation_id": "bb8af8e8-dd89-4ce3-a2ff-5bf2d118fc8b",
                        "source_entry_id": "2a423af8-9337-3685-a1ef-e418a076b3f4",
                        "source_sense_id": "8f8fb6d5-c1b0-388e-afe9-5efb0aa359d9",
                        "source_sense_description": "ohne eigenen Willen: willenlos",
                        "target_lang_word": "willenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                        "entry_id": "64ae9eb1-004b-36b5-a23a-2b8af50c1f4c",
                                        "glosses": [
                                            "ohne eigenen Willen; beherrscht von jemand anderem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800b485c-87bd-47d4-b5fe-aaf00a9b9228",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„K.O.-Tropfen machen willenlos.“"
                                            },
                                            {
                                                "example_id": "7032bcbd-0371-4ab8-98b0-b04fc4d2d55c",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„Unbemerkt in Getränke gemischt sind K.-o.-Tropfen besonders heimtückisch: Sie machen die Opfer willenlos und erinnerungsunfähig.“"
                                            },
                                            {
                                                "example_id": "a3e17825-5350-46ed-adbb-6ba71a7d0585",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„Diese Substanz mit dem Wirkstoff Scopolamin wird in Südamerika von Verbrechern genutzt, um Opfer willenlos zu machen.“"
                                            },
                                            {
                                                "example_id": "136b103f-3699-4061-a7ce-1d436eb835b7",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "[Haftstrafe für ehemaligen Chefarzt wegen Vergewaltigung:] „Das Landgericht Bamberg sah es als erwiesen an, dass der 51-Jährige zwölf Frauen - darunter auch Patientinnen - betäubt und damit willenlos gemacht hatte.“"
                                            },
                                            {
                                                "example_id": "7122fd46-1fc9-45fb-b59b-5ba5df2e0d85",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "[Der Pilz Ophiocordyceps unilateralis:] „Er befällt Ameisen, genauer gesagt die im Urwald Thailands lebende Rossameise Camponotus leonardi. Dann nistet er sich wie ein Computer-Trojaner in ihr Hirn ein und verwandelt sie in eine willenlose Marionette.“"
                                            },
                                            {
                                                "example_id": "11e25bc8-b32e-4330-8869-9c27e3b9af6c",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„Die Nazis wollten auch einen neuen Typ Mensch schaffen, der dem System willenlos dienen sollte.“"
                                            },
                                            {
                                                "example_id": "1c3bed72-150a-4d00-8d14-c51ce610e1b4",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„Das Elternhaus war preußisch-streng und freudlos. Der Sohn sollte mit drakonischen Strafen zum willenlosen Untertan herangezogen werden.“"
                                            },
                                            {
                                                "example_id": "866a5534-27ac-40f0-9928-58e49a24b85f",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "„Erst als Biberkopf freigesprochen und -entlassen wird, begreift er, dass er sich zum willenlosen Werkzeug eines Verbrechers hat machen lassen.“"
                                            },
                                            {
                                                "example_id": "7dc9d2e2-71ef-4279-921c-ec2df7bf67ab",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "[Erich Mielke:] „In einem medizinischen Gutachten wird Mielke als gebrochener, depressiver und willenloser Mann beschrieben, er wird für verfahrens- und haftunfähig erklärt.“"
                                            },
                                            {
                                                "example_id": "a280aa25-4222-47d2-b7f7-b53890bce783",
                                                "sense_id": "33f59942-490a-3c3c-afca-64d12a72847f",
                                                "text": "[Fußball-EM 2016 – Wales gegen Russland – 3:0:] „Die Russen ergaben sich fast hilf- und willenlos ihrem Schicksal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
