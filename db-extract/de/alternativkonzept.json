                "senses": [
                    {
                        "sense_id": "89c596a3-abff-3f91-b6fb-05b0da935007",
                        "entry_id": "0e47ee65-ea37-3e07-868d-1ff7d83e1c53",
                        "glosses": [
                            "Konzept, das andere als die bisher bekannten Möglichkeiten zur Erreichung eines vorgegebenen Zieles aufzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7629500a-44e5-4cbd-8c47-2b3b66a0cbdd",
                                "sense_id": "89c596a3-abff-3f91-b6fb-05b0da935007",
                                "text": "„Der Stiftungsrat genehmigte am Donnerstag ein Alternativkonzept, wonach alle notwendigen Büros und Studios samt dem geplanten Newsroom im vorhandenen Gebäudekomplex untergebracht werden sollen.“"
                            },
                            {
                                "example_id": "50132447-f84e-411b-9db5-0d613dda125c",
                                "sense_id": "89c596a3-abff-3f91-b6fb-05b0da935007",
                                "text": "„In den Abstimmungen vom Sonntag unterstützen alle drei Standortgemeinden dieses Alternativkonzept und erteilen dem Projekt des Bundes für einen Business-Flugplatz eine Absage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
