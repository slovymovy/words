                                                "sense_id": "92f269c0-308e-36ff-bb04-a03d624b1ce6",
                                                "text": "„Entgegen der verbreiteten Meinung ist Tahiti keineswegs von weißen Stränden umgeben.“"
                                            },
                                            {
                                                "example_id": "6cf04f78-cc0e-4d22-81d2-ec7710df4359",
                                                "sense_id": "92f269c0-308e-36ff-bb04-a03d624b1ce6",
                                                "text": "Es ist ein Erlebnis, durch das dichtbewachsene Innere Tahitis zu wandern."
                                            }
