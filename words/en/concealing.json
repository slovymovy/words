    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68985906-97c3-3cdb-b62c-952fdf5a85e2",
                    "sense_definition": "present participle and gerund of <w>conceal</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conceal_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was accused of <w>concealing</w> critical evidence from the investigators.",
                            "target_lang_translations": {
                                "pl": "Została oskarżona o <w>zatajanie</w> kluczowych dowodów przed śledczymi."
                            }
                        },
                        {
                            "text": "He wore a long coat capable of <w>concealing</w> weapons.",
                            "target_lang_translations": {
                                "pl": "Miał na sobie długi płaszcz zdolny do <w>ukrycia</w> broni."
                            }
                        }
                    ],
                    "synonyms": [
                        "hiding"
                    ],
                    "antonyms": [
                        "revealing"
                    ],
                    "common_phrases": [
                        "concealing evidence",
                        "concealing identity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "forma imiesłowu czasu teraźniejszego (present participle) lub rzeczownika odsłownego (gerund) czasownika conceal; ukrywanie, chowanie lub zatajanie czegoś"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ukrywanie",
                                "target_lang_sense_clarification": "czynność chowania lub trzymania w tajemnicy"
                            },
                            {
                                "target_lang_word": "ukrywający",
                                "target_lang_sense_clarification": "taki, który ukrywa"
                            },
                            {
                                "target_lang_word": "zatajanie",
                                "target_lang_sense_clarification": "ukrywanie prawdy lub informacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7caebf6-0d25-3f52-8d3c-480994e9da44",
                    "sense_definition": "The act of hiding or keeping something secret.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conceal_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deliberate <w>concealing</w> of the truth destroyed any remaining trust between them.",
                            "target_lang_translations": {
                                "pl": "Celowe <w>zatajanie</w> prawdy zniszczyło resztki zaufania między nimi."
                            }
                        },
                        {
                            "text": "Careful <w>concealing</w> was necessary to prevent the documents from being discovered.",
                            "target_lang_translations": {
                                "pl": "Ostrożne <w>ukrywanie</w> było konieczne, aby zapobiec odkryciu dokumentów."
                            }
                        }
                    ],
                    "synonyms": [
                        "concealment",
                        "hiding"
                    ],
                    "antonyms": [
                        "disclosure",
                        "revelation"
                    ],
                    "common_phrases": [
                        "deliberate concealing"
                    ],
                    "target_lang_definitions": {
                        "pl": "akt lub czynność ukrywania, zatajania czegoś przed innymi"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ukrywanie",
                                "target_lang_sense_clarification": "czynność chowania czegoś"
                            },
                            {
                                "target_lang_word": "zatajenie",
                                "target_lang_sense_clarification": "ukrycie prawdy lub faktów"
                            },
                            {
                                "target_lang_word": "zatajanie",
                                "target_lang_sense_clarification": "proces nieujawniania faktów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a7d5e84-2eef-33f3-82c5-0f490a5f2250",
                    "sense_definition": "Material or covering that hides or obscures something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog acted as natural <w>concealing</w> for the fleeing soldiers.",
                            "target_lang_translations": {
                                "pl": "Gęsta mgła służyła jako naturalna <w>osłona</w> dla uciekających żołnierzy."
                            }
                        },
                        {
                            "text": "Dense clouds formed mysterious <w>concealings</w> across the vast mountain peaks.",
                            "target_lang_translations": {
                                "pl": "Gęste chmury tworzyły tajemnicze <w>zasłony</w> spowijające rozległe górskie szczyty."
                            }
                        }
                    ],
                    "synonyms": [
                        "covering",
                        "screen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "materiał, osłona lub zasłona, która coś ukrywa lub zasłania"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "osłona",
                                "target_lang_sense_clarification": "coś chroniącego przed wzrokiem"
                            },
                            {
                                "target_lang_word": "zasłona",
                                "target_lang_sense_clarification": "bariera uniemożliwiająca zobaczenie czegoś"
                            },
                            {
                                "target_lang_word": "kamuflaż",
                                "target_lang_sense_clarification": "sposób lub materiał do maskowania"
                            }
                        ]
                    }
                }
            ]
        }
    ]
