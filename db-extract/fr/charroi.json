                                "target_senses": [
                                    {
                                        "sense_id": "2e5daaa9-631d-3ce7-a26c-5b62343996f6",
                                        "entry_id": "125a0c84-9544-346f-a001-b206ec047d45",
                                        "glosses": [
                                            "The transport of goods by cart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00eec5c8-2809-4fe7-8f58-568bd6c9c0cd",
                                                "sense_id": "2e5daaa9-631d-3ce7-a26c-5b62343996f6",
                                                "text": "Near-synonym: wagonage"
                                            },
                                            {
                                                "example_id": "d4f66872-0867-418a-a247-43bce0ad88e1",
                                                "sense_id": "2e5daaa9-631d-3ce7-a26c-5b62343996f6",
                                                "text": "Railways are forming in one quarter of this earth, canals in another, much cartage is wanted"
                                            },
                                            {
                                                "example_id": "83b9632b-13d0-4719-986e-ad313f75e17a",
                                                "sense_id": "2e5daaa9-631d-3ce7-a26c-5b62343996f6",
                                                "text": "In these years, all long-distance freight went by rail, with local cartage by the railway's horses and carts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d33953d-e3a5-3f3b-aa58-061d3af8eda6",
                                        "entry_id": "125a0c84-9544-346f-a001-b206ec047d45",
                                        "glosses": [
                                            "Any vehicular transportation of goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a9488d1-2ff4-4b23-b1e6-5c5b4b5311f0",
                                                "sense_id": "2d33953d-e3a5-3f3b-aa58-061d3af8eda6",
                                                "text": "Near-synonyms: shipping, carriage"
                                            },
                                            {
                                                "example_id": "b87cf4fd-fa7c-4d6e-9116-286381b3dc27",
                                                "sense_id": "2d33953d-e3a5-3f3b-aa58-061d3af8eda6",
                                                "text": "I started general cartage work and hauling bagged cement to Pine Creek, south of Darwin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e21c541-b610-3074-8595-b57294938677",
                                        "entry_id": "125a0c84-9544-346f-a001-b206ec047d45",
                                        "glosses": [
                                            "A charge made for such transport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32126e47-8045-4018-afbb-a97865cdb988",
                                                "sense_id": "7e21c541-b610-3074-8595-b57294938677",
                                                "text": "Near-synonym: wagonage"
                                            },
                                            {
                                                "example_id": "7f85bf8a-d6f1-4cd9-9919-7385196d493f",
                                                "sense_id": "7e21c541-b610-3074-8595-b57294938677",
                                                "text": "1842 Great Britain Poor Law Commissioners - Report to Her Majesty's Principal Secretary of State for the Home Department, from the Poor Law\nTwo-thirds of the usual expense of street cleansing is the expense of cartage, which, with a proper adaptation of the sewers, is wholly unnecessary."
                                            }
                                        ]
                                    }
