                "forms": [
                    {
                        "form_id": "d315fae5-ad6c-403e-8437-ae778f8625e1",
                        "entry_id": "40f977de-f2f3-3b77-b797-e3070be7ea7e",
                        "tags": [
                            "plural"
                        ],
                        "form": "épurges"
