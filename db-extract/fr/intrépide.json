                                        "glosses": [
                                            "geen angst voor gevaar tonend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07e2fe6-a886-485b-8411-911dc1cbde8e",
                                                "sense_id": "da9ad6a4-f419-3497-bf7c-8867f8061c15",
                                                "text": "De moedige jongen nam het op tegen iemand die een kop groter was dan hij."
                                            },
                                            {
                                                "example_id": "8ab2af6b-905d-45cd-b48b-d004ddc64124",
                                                "sense_id": "da9ad6a4-f419-3497-bf7c-8867f8061c15",
                                                "text": "De CDT, de Continental Divide Trail, is pas een paar jaar oud en bekend om haar isolated untouched nature en is alleen weggelegd voor de moedige avonturier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
