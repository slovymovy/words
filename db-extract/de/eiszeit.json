                        "form": "die Eiszeit"
                    },
                    {
                        "form_id": "d715ea5d-9ae3-450f-b0dc-e2418e6627b8",
                        "entry_id": "6204dd32-8374-3b1e-9b5d-be0bed0f2edf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eiszeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                        "entry_id": "6204dd32-8374-3b1e-9b5d-be0bed0f2edf",
                        "glosses": [
                            "erdgeschichtliche Periode mit kaltem Klima"
                        ],
                        "tags": [
                            "Klimatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba60a2a-503d-4b46-a2c4-0afcf675eb97",
                                "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                                "text": "In Norddeutschland findet man manche Relikte der Eiszeit."
                            },
                            {
                                "example_id": "1a1f9a80-73d8-4661-8d82-054900b65ef7",
                                "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                                "text": "„Die letzte Eiszeit in Mitteleuropa war ein Glücksfall für die Eisenbahningenieure.“"
                            },
                            {
                                "example_id": "419ea834-4c75-4233-902b-c3afdeb90da8",
                                "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                                "text": "„Den Spuren der jüngsten dieser Eiszeiten sind Sie bereits begegnet: Die Niederterrassen werden der Weichseleiszeit zugeordnet, deren Höhepunkt vor 20.000 Jahren erreicht wurde.“"
                            },
                            {
                                "example_id": "096131d9-a25e-4b56-952e-cab32c6aea9a",
                                "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                                "text": "„Eine Eiszeit besteht aus Kaltzeiten und Warmzeiten im Gegensatz zu einer Nichteiszeit, die nur aus Warmzeiten besteht. Wir sind in einer Warmzeit, denn zurzeit ist es wärmer als vor 18.000 Jahren - da war's nämlich eine Kaltzeit.“"
                            },
                            {
                                "example_id": "2d37fd97-051f-4082-8a3b-8bfb52324578",
                                "sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                                "text": "„Mitten in der Eiszeit mussten die Einwanderer an einem riesigen Gletscherschild vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19b50069-192a-42e5-8815-4fbd5ecea880",
                        "source_entry_id": "6204dd32-8374-3b1e-9b5d-be0bed0f2edf",
                        "source_sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                        "source_sense_description": "Klimatologie: erdgeschichtliche Periode mit kaltem Klima",
                        "target_lang_word": "ice age",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ice age",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24517d71-ae3d-3332-ba29-400699e0b399",
                                        "entry_id": "daa01114-cbfb-3e14-bea6-6bd0f2d1ab09",
                                        "glosses": [
                                            "A period of long-term reduction in the temperature of Earth's surface and atmosphere, resulting in the presence of major polar ice sheets that reach the ocean and calve icebergs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07cee0dc-dfd8-4a28-ab1a-5d59b6db7817",
                                                "sense_id": "24517d71-ae3d-3332-ba29-400699e0b399",
                                                "text": "The earth is currently in the Late Cenozoic Ice Age, an ice age that began 33.9 million years ago with the Antarctic Ice Cap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7184fefa-93e0-3ee4-b3d3-895a5d41fa5b",
                                        "entry_id": "daa01114-cbfb-3e14-bea6-6bd0f2d1ab09",
                                        "glosses": [
                                            "Any of several glacial periods (within a scientific ice age) marked by episodes of extensive glaciation alternating with episodes of relative warmth (interglacial)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "525ab6a6-67bf-44b6-bb75-ff053a748d34",
                                                "sense_id": "7184fefa-93e0-3ee4-b3d3-895a5d41fa5b",
                                                "text": "The cause of ice ages, Köppen decided, is to be found in cool summers, not brutal winters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a90e1fda-8990-4f1a-89d8-8aa70c8cf3c2",
                        "source_entry_id": "6204dd32-8374-3b1e-9b5d-be0bed0f2edf",
                        "source_sense_id": "cb85e938-eeb1-33ff-bbe7-7baebe47695f",
                        "source_sense_description": "Klimatologie: erdgeschichtliche Periode mit kaltem Klima",
                        "target_lang_word": "glaciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaciation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2083d9-e9a3-3ab8-acc8-38d30908f18c",
                                        "entry_id": "bc44e77b-3a6d-3d74-9b74-51d8caf5da26",
                                        "glosses": [
                                            "Action de geler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7761071a-e966-38f3-84f5-8ee971f0be9b",
                                        "entry_id": "bc44e77b-3a6d-3d74-9b74-51d8caf5da26",
                                        "glosses": [
                                            "Ce qui est formé par cette action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42b69258-80ae-3c33-b1dc-d8c65bc17028",
                                        "entry_id": "bc44e77b-3a6d-3d74-9b74-51d8caf5da26",
                                        "glosses": [
                                            "Le processus de formation ou l'état d'avoir présent des glaciers ou une calotte glaciaire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c2989c3-fe18-4b7e-a832-ed3f9eb6c06d",
                                                "sense_id": "42b69258-80ae-3c33-b1dc-d8c65bc17028",
                                                "text": "De nos jours, la glaciation du Mont Blanc est essentiellement concentrée sur le massif du Mont-Blanc (stricto sensu)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52770b62-2672-3ba3-b749-4962bd52f5db",
                                        "entry_id": "bc44e77b-3a6d-3d74-9b74-51d8caf5da26",
                                        "glosses": [
                                            "Période glaciaire; intervalle de temps géologique durant lequel des glaciers ont été présents dans une région."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5adbe5ad-4828-4015-b59c-5d36f6b4e9d8",
                                                "sense_id": "52770b62-2672-3ba3-b749-4962bd52f5db",
                                                "text": "À la fin du Tertiaire s’est produit le refroidissement qui a conduit aux glaciations quaternaires ; il a peut-être quelque rapport avec la formation de l’Atlantique Nord."
                                            },
                                            {
                                                "example_id": "25d76501-2ec2-4ec4-b12b-d97df86dc5fb",
                                                "sense_id": "52770b62-2672-3ba3-b749-4962bd52f5db",
                                                "text": "En outre, l’auge glaciaire d'en bas étant incontestablement datée, comme plus récente que la dernière glaciation, l’épaulement occupe précisément la place où l'on doit s'attendre à trouver le fond d’auge de celle-ci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
