                "senses": [
                    {
                        "sense_id": "29dfde32-19e5-3b41-a402-ef6c64d08b93",
                        "entry_id": "dfd5395e-6cf3-370e-8c97-13de97ea435c",
                        "glosses": [
                            "een bocht of kromming in een voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da3e2fe-7521-4186-a15a-11fe76ab0981",
                                "sense_id": "29dfde32-19e5-3b41-a402-ef6c64d08b93",
                                "text": "De Twentse goastok is een handgemaakte wandelstok uit een vergroeid stuk berkenhout en werd vroeger - al dan niet versierd - gebruikt bij bijzondere gelegenheden, zoals bruiloften, geboorten en overlijden. Ook was de goastok vaste begeleider bij het afleggen van visites en het uitgaan. Kenmerkend aan de wandelstok is de krulling. Tijdens de Landleventocht van de VVV Losser op zondag 20 september kunnen bezitters en makers hun eigen goastok inbrengen voor de verkiezing van de mooiste goastok van Twente."
                            },
                            {
                                "example_id": "72ad2c60-21e3-4be0-8fb9-6231a5b0651f",
                                "sense_id": "29dfde32-19e5-3b41-a402-ef6c64d08b93",
                                "text": "In slowmotion zie ik hoe mijn ijsje uit mijn hand vliegt en met een bocht op de grond genadeloos uit elkaar spat. Mijn ogen worden groot, mijn lip maakt de krulling waar Britney ooit roem mee vergaarde en het kost me moeite, erg veel moeite om nu niet als een klein kind in huilen uit te barsten."
                            }
                        ]
                    }
