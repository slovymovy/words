                        "glosses": [
                            "großes Bild in Form einer Tafel, auf dem dem ein Thema/Sachverhalt erläutert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7c4688-594c-486f-9b9c-1d248d60921e",
                                "sense_id": "96ea6a85-9c36-3acc-8b06-2a24eeaa3a7c",
                                "text": "Vom richtigen Gebrauch dieser visuellen Lehrmittel, der Schautafeln, Wandbilder und Kleinbilder, hingt der Erfolg des Unterrichts ab."
                            },
                            {
                                "example_id": "90d41973-7350-4ee3-b85b-4964e1c77d4c",
                                "sense_id": "96ea6a85-9c36-3acc-8b06-2a24eeaa3a7c",
                                "text": "„Gut durch Schautafeln erschlossen und durch einen Wanderweg miteinander verbunden sind die Fürstengrabhügel um den Asperg bei Ludwigsburg in Schwaben, darunter das Kleinaspergle.“"
                            }
                        ],
