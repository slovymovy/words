                                        "entry_id": "2da8af00-10d1-396f-baf8-2216c50de4a4",
                                        "glosses": [
                                            "Orchidée du genre Cattleya, originaire des forêts tropicales d’Amérique centrale et d’Amérique du Sud qui comprend plus de 150 espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ddbd0f-cbfa-4f26-adfe-cdf65106c522",
                                                "sense_id": "2763af89-8c37-3ea2-ac6a-82f5066f12d4",
                                                "text": "Dans l’ombre des ruines, les plantes timides, la menthe, la gentiane, le datura, les plantes à teinture, les orchidées et les cattleyas qui se vendent au marché."
                                            },
                                            {
                                                "example_id": "2be651bf-810a-4239-abf9-c4eabd587cd7",
                                                "sense_id": "2763af89-8c37-3ea2-ac6a-82f5066f12d4",
                                                "text": "Les cattleyas aiment beaucoup la lumière, mais pas le soleil direct qui doit être filtré par un voilage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
