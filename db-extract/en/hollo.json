                "senses": [
                    {
                        "sense_id": "96b0bc97-73f6-3cea-9232-9a4ebab43fb5",
                        "entry_id": "0c7b7c65-28a2-37f6-9a00-b1a73342cf24",
                        "glosses": [
                            "A cry of \\\"hollo\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278e458d-34f8-4c25-ba65-bcac29a9f6f6",
                                "sense_id": "96b0bc97-73f6-3cea-9232-9a4ebab43fb5",
                                "text": "And a good south wind sprung up behind; The Albatross did follow, And every day, for food or play, Came to the mariners' hollo!"
                            },
                            {
                                "example_id": "54a3aed3-2080-4352-a9db-6aa7f473d4f0",
                                "sense_id": "96b0bc97-73f6-3cea-9232-9a4ebab43fb5",
                                "text": "\"I always add my hollo,\" said the yeoman, \"when I see a good shot, or a gallant blow.\""
                            },
                            {
                                "example_id": "69cb5639-5a13-4020-8fe8-2f2f0b172126",
                                "sense_id": "96b0bc97-73f6-3cea-9232-9a4ebab43fb5",
                                "text": "The old chief stepped to the entrance of the wigwam and made a peculiar noise between a whistle and a hollo, and in a few minutes there were hundreds of Indians there, both bucks and squaws."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
