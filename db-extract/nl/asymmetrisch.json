                "forms": [],
                "senses": [
                    {
                        "sense_id": "a63bb7e0-2593-3e15-82c0-1b2c5d2c6bd8",
                        "entry_id": "6c372c30-1446-3e7c-baa7-db218ef94837",
                        "glosses": [
                            "zonder symmetrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a189731-760d-4508-b1e4-9c722ada0dd4",
                                "sense_id": "a63bb7e0-2593-3e15-82c0-1b2c5d2c6bd8",
                                "text": "De buitenproportioneel grote klokkentoren van rode baksteen met een witte marmeren omgang en een groen puntdak bracht met zijn asymmetrische plaatsing een belachelijk contrapunt aan in de rationele, paradeerbare ruimte, dat juist vanwege het feit dat het concessieloos gewaagd en overdreven was effectief en elegant uitpakte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0ae4150-5710-46cc-a33a-bef509c35eb5",
                        "source_entry_id": "6c372c30-1446-3e7c-baa7-db218ef94837",
                        "source_sense_id": "a63bb7e0-2593-3e15-82c0-1b2c5d2c6bd8",
                        "target_lang_word": "asymmetrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asymmetrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                        "entry_id": "d8a4be3c-e7b9-3364-93cd-5d5ea0338833",
                                        "glosses": [
                                            "nicht symmetrisch, keine Symmetrien besitzend"
                                        ],
                                        "tags": [
                                            "auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a92bf9d-dbfc-4826-9953-b8451e1c6826",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "Dieses Trapez ist asymmetrisch."
                                            },
                                            {
                                                "example_id": "a1b87de2-3ed1-42dc-be12-fd79d6758759",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Unmittelbare Konsequenz daraus war eine asymmetrische Machtverlagerung zugunsten weniger Personen und Machtgruppen auf Kosten der Adelssolidarität.“"
                                            },
                                            {
                                                "example_id": "8e8d2479-b613-49eb-b0ed-b439e08169f7",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Die Abwehr terroristischer und anderer asymmetrischer Bedrohungen innerhalb Deutschlands ist vorrangig eine Aufgabe der für die innere Sicherheit zuständigen Behörden von Bund und Ländern.“"
                                            },
                                            {
                                                "example_id": "9f766a94-06ae-49a2-b2df-6d361300cb67",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Dieser Kanalisierungseffekt ist der Grund für die asymmetrischere Schadstoffbelastung an Wand A.“"
                                            },
                                            {
                                                "example_id": "00c1e457-231b-408f-aaf1-0051458f6dbf",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Damit unterscheiden sie sich deutlich von den Häusern der hohen und späten Kaiserzeit, für die allgemein eine deutlich asymmetrischere Anlage gewählt ist.“"
                                            },
                                            {
                                                "example_id": "003d7a61-d77b-49ef-a48c-78eedcfae893",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Männer nehmen im Allgemeinen wesentlich entspanntere, raumgreifendere und asymmetrischere Haltungen ein als Frauen.“"
                                            },
                                            {
                                                "example_id": "e9b971f4-9dbc-4e7c-ac5e-518d7ac17743",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Aber natürlich gibt es den Kampf gegen Terroristen, und der ist spätestens mit dem Attentat von Nizza in eine neue, noch schwierigere, weil noch asymmetrischere Phase getreten.“"
                                            },
                                            {
                                                "example_id": "1901f046-ff76-45ee-91f6-53640f369584",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Dieser Hypothese folgend untersuchten wir in der folgenden Studie eine der asymmetrischsten Strukturen im menschlichen Gehirn, die Sylvische Fissur.“"
                                            },
                                            {
                                                "example_id": "b02370d3-df36-4ff0-aab7-5774c3853619",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Ein Stück dieser Macht kommt selbst in den asymmetrischsten Herrschaftsverhältnissen auch jenen zu, die nur über sehr wenige Ressourcen verfügen.“"
                                            },
                                            {
                                                "example_id": "3ef925d9-5f81-4fc7-a364-59b42f45fdf4",
                                                "sense_id": "e4c5ceba-deb8-3b03-9e34-b0ffb2e8ec35",
                                                "text": "„Die am höchsten entwickelten Formen und Funktionen der Natur – die von Leben, Geist und Gesellschaft – sind die in der mathematischen Bedeutung des Wortes asymmetrischsten Formen der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
