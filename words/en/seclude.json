                    "frequency": "Low",
                    "semantic_group_id": "isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to <w>seclude</w> himself in a remote cabin to finish his novel."
                        },
                        {
                            "text": "She often <w>secludes</w> herself from the world when she needs to focus on her work."
                        }
                    ],
                    "synonyms": [
                        "isolate",
                        "withdraw",
                        "sequester"
                    ],
                    "antonyms": [
