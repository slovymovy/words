                ],
                "senses": [
                    {
                        "sense_id": "45c537d7-bafc-3c6c-99fd-ba86bbdcb297",
                        "entry_id": "a53e574b-3e50-3be2-aaef-3152a26950f0",
                        "glosses": [
                            "für den Sommer typisches Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0173f63d-816d-4ae6-9f04-519245b2aae5",
                                "sense_id": "45c537d7-bafc-3c6c-99fd-ba86bbdcb297",
                                "text": "„Der Schlusstag empfing die 66 im Turnier verbliebenen Spieler bei bestem Sommerwetter und kaum Wind, also den score-freundlichsten Bedingungen der ganzen Woche.“"
                            },
                            {
                                "example_id": "03a17753-012a-411b-81e9-f6ff1e588e8a",
                                "sense_id": "45c537d7-bafc-3c6c-99fd-ba86bbdcb297",
                                "text": "„Wieweit sich das heisse Sommerwetter auf Notaufnahmen und Mortalitätsraten in den Schweizer Spitälern ausgewirkt hat, lässt sich laut Damiano Urbinello vom Bundesamt für Gesundheit noch nicht sagen.“"
                            },
                            {
                                "example_id": "afd56614-a2b6-4edb-b34f-56177db98222",
                                "sense_id": "45c537d7-bafc-3c6c-99fd-ba86bbdcb297",
                                "text": "„Andererseits war herrliches Sommerwetter, schwacher Wind, vierzehn Grad warm, knisternd trocken, der Fjord duftete nach Heuernte, die Luft roch nach Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
