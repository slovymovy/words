                {
                    "sense_id": "60974256-0e8e-3ada-a269-d9b13696920d",
                    "sense_definition": "zorgvuldig toezien op iets of iemand om deze te beschermen of te controleren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toezicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie moet voortdurend over de veiligheid op straat <w>waken</w>.",
                            "target_lang_translations": {
                                "en": "The police must constantly <w>watch over</w> the safety on the streets."
                            }
                        },
                        {
                            "text": "De G20-landen zullen voortaan samen over de wereldwijde economie <w>waken</w>.",
                            "target_lang_translations": {
                                "en": "From now on, the G20 countries will <w>monitor</w> the global economy together."
                            }
                        }
                    ],
                    "synonyms": [
                        "toezien",
                        "bewaken",
                        "hoeden"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "waken over",
                        "over de veiligheid waken"
                    ],
                    "target_lang_definitions": {
                        "en": "to carefully monitor something or someone in order to protect or control them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch over",
                                "target_lang_sense_clarification": "to guard or monitor for safety"
                            },
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to protect or keep watch over"
                            },
                            {
                                "target_lang_word": "monitor",
                                "target_lang_sense_clarification": "to observe and check the progress of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f160789-ab31-3b80-afeb-9a8865998c6a",
                    "sense_definition": "wakker blijven bij een zieke of stervende persoon om steun te bieden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bijstaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft de hele nacht bij haar zieke moeder zitten <w>waken</w>.",
                            "target_lang_translations": {
                                "en": "She sat <w>keeping a vigil</w> by her sick mother all night."
                            }
                        },
                        {
                            "text": "In de uren dat zij bij hem zat te <w>waken</w> hebben ze veel gesproken.",
                            "target_lang_translations": {
                                "en": "In the hours that she sat <w>watching</w> over him, they spoke a lot."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij een zieke waken"
                    ],
                    "target_lang_definitions": {
                        "en": "to stay awake with a sick or dying person to provide support"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watch",
                                "target_lang_sense_clarification": "to remain awake with a sick person"
                            },
                            {
                                "target_lang_word": "keep a vigil",
                                "target_lang_sense_clarification": "to stay awake to keep watch or pray"
                            },
                            {
                                "target_lang_word": "sit with",
                                "target_lang_sense_clarification": "to stay beside someone who is ill"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39b41c0a-7326-3715-bc76-0a356cd2b637",
                    "sense_definition": "bewust niet gaan slapen, vaak met een specifiek doel of uit plichtsbesef",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wakker_zijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als andere mensen slapen dan <w>waak</w> ik om het huis te beveiligen.",
                            "target_lang_translations": {
                                "en": "When other people sleep, I <w>keep watch</w> to secure the house."
                            }
                        },
                        {
                            "text": "De soldaten moesten de hele nacht <w>waken</w> bij de poort.",
                            "target_lang_translations": {
                                "en": "The soldiers had to <w>stand guard</w> at the gate all night."
                            }
                        }
                    ],
                    "synonyms": [
                        "opblijven"
                    ],
                    "antonyms": [
                        "slapen"
                    ],
                    "common_phrases": [
                        "de hele nacht waken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
