                "senses": [
                    {
                        "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                        "entry_id": "e925d6d7-c427-387a-8197-f3c4f96beef7",
                        "glosses": [
                            "Bereich der subjektiven Wahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add749ef-4089-4b19-99ce-28bab38f4de4",
                                "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                                "text": "„Wie können wir unseren Wahrnehmungsraum so weiten, dass wir unsere Partner*innen [sic] dort fühlen können, wo sie innerlich gerade sind?“"
                            },
                            {
                                "example_id": "43cc7e8a-e581-429f-b2e7-0bc13c92dbfe",
                                "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                                "text": "„Wahrnehmungsraum befähigt Menschen durch bewusstes und achtsames Denken, innere Freiheit zu erlangen und Selbstverantwortung zu übernehmen.“"
                            },
                            {
                                "example_id": "e004a94d-aa9d-4129-b481-68055f4ef4b8",
                                "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                                "text": "„Jedoch ist Coaching keine Therapie, sondern dient zur Unterstützung und Erweiterung der persönlichen Wahrnehmungsraum und des Bewusstseinszustandes.“"
                            },
                            {
                                "example_id": "157c9c1c-e82a-4696-9505-558272c8ba0a",
                                "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                                "text": "„Lass dich von Trommeln,Rasseln und der Energie im Kreis in neue Erlebens- und Wahrnehmungsräume tragen.“"
                            },
                            {
                                "example_id": "33fe8aa2-d2eb-4003-ac9d-ca812425c370",
                                "sense_id": "721cbafa-81e4-331b-a486-bc153269b54b",
                                "text": "„Egal wie intensiv Du jemanden beobachtest, Du magst mehr über dessen inneren Wahrnehmungsraum erfahren, doch über seinen Wesenskern (bhūta) wirst Du nichts erfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
