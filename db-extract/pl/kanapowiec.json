                "senses": [
                    {
                        "sense_id": "f8c816eb-2797-3b54-9736-77ebb1e6d0f7",
                        "entry_id": "ace23ecd-8f02-33ce-8370-b1c035fbbf9b",
                        "glosses": [
                            "domowy pies lub kot, który lubi długo wylegiwać się, np. na kanapie lub na łóżku"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "40fce128-ecb9-34a1-9dba-8fc4b838fcc7",
                        "entry_id": "ace23ecd-8f02-33ce-8370-b1c035fbbf9b",
                        "glosses": [
                            "o małym, pokojowym, spokojnym psie (najczęściej z grupy psów do towarzystwa i ozdobnych), który nie wymaga dużo ruchu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "499977b6-3485-432f-ac60-8170e145f6ba",
                                "sense_id": "40fce128-ecb9-34a1-9dba-8fc4b838fcc7",
                                "text": "Znam wiele labradorów i ich właścicieli i każdy z nich to pospolity kanapowiec"
                            },
                            {
                                "example_id": "439272b8-00aa-4b51-861e-9e088a5d1068",
                                "sense_id": "40fce128-ecb9-34a1-9dba-8fc4b838fcc7",
                                "text": "W ciasnym mieszkaniu nie można trzymać psa, który wymaga dużo ruchu. Lepszy jest tym w przypadku jakiś kanapowiec."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
