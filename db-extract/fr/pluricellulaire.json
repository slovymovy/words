                                                "sense_id": "cbd4616e-edf6-319c-b4b9-c94954d7e48f",
                                                "text": "Während des Neoproterozoikums entstand das vielzellige Leben auf der Erde."
                                            },
                                            {
                                                "example_id": "6c2b1d6e-e763-4d26-864f-7d199421bff4",
                                                "sense_id": "cbd4616e-edf6-319c-b4b9-c94954d7e48f",
                                                "text": "„Im Deutschen werden sie, wie auch vielzellige Rot- und Grünalgen, allgemein als Tang bezeichnet […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
