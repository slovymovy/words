                                ]
                            },
                            {
                                "target_word": "matematico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "16a71651-b925-3582-bfb6-3f8e7f306306",
                                        "entry_id": "5c479ff5-51ce-3bba-aba0-5f82e02cff1e",
                                        "glosses": [
                                            "studioso di matematica"
                                        ],
                                        "tags": [
                                            "professione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b045fc3-39cd-4e55-b95d-bb52807ae9be",
                                                "sense_id": "16a71651-b925-3582-bfb6-3f8e7f306306",
                                                "text": "Newton é stato un grande matematico"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e52c6ab8-9141-4b9e-aff3-2ebd4e6df78d",
                        "source_entry_id": "3260bf11-0e03-3e6c-b12f-9a0a41c85471",
                        "source_sense_description": "специалист в области математики",
                        "target_lang_word": "Mathematiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mathematiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                        "entry_id": "28650532-6a9a-3eb7-a555-21ce4c4e2ad1",
                                        "glosses": [
                                            "jemand, der sich beruflich hauptsächlich mit Mathematik befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d3764a-4a74-47ff-bc74-9fdddd9b0cbc",
                                                "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                                "text": "Ein Mathematiker befasst sich mit Mathematik."
                                            },
                                            {
                                                "example_id": "8b120f5d-a99c-4a10-8b74-dbaa1af3f0da",
                                                "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                                "text": "„Der Mathematiker ist also bei Platon für die Entfaltung und Ausarbeitung zuständig, die Basis dazu wird ihm vom Dialektiker zur Verfügung gestellt.“"
                                            },
                                            {
                                                "example_id": "87e183bf-64e0-4ba4-a72e-820b57974981",
                                                "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                                "text": "„Der intelligente Mathematiker in ihm verschwindet, der junge Mann, für den alles zu einfach war.“"
                                            },
                                            {
                                                "example_id": "6b254724-886c-4fdd-9039-537ae79d139f",
                                                "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                                "text": "„Tom lächelte, weil er diesen Standpunkt des Mathematikers eigentlich sehr sympathisch fand, nickte Noby aber zu.“"
                                            },
                                            {
                                                "example_id": "108658a6-3456-44a7-bf1f-2e418a61bada",
                                                "sense_id": "debc087c-72a5-3ac2-8eac-66a221d731ee",
                                                "text": "„Man denkt: Wenn die Mathematiker etwas wissen müssen, dann zumindest, was eine Zahl ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
