                    },
                    {
                        "translation_id": "247d7102-20d4-48c0-92d8-a41bbc111644",
                        "source_entry_id": "0a060204-b561-3bc0-8a2d-3aea7e17eaf2",
                        "source_sense_description": "Abrahamic religion",
                        "target_lang_word": "Islam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                        "entry_id": "f3ffbecc-0c7b-39e4-ab7a-ae8d4ce11342",
                                        "glosses": [
                                            "monotheistische Religion, die im frühen 7. Jahrhundert in Arabien durch den Mekkaner Mohammed gestiftet wurde."
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01e9931f-1e91-473b-bc88-92cc6f424043",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "Der Islam entstand wie das Judentum und Christentum im Nahen Osten."
                                            },
                                            {
                                                "example_id": "226b88be-f072-402e-a94a-223a39878109",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "„Närrisch, dass jeder in seinem Falle // Seine besondere Meinung preist! // Wenn Islam »Gott ergeben« heißt, // In Islam leben und sterben wir alle.“ - Johann Wolfgang von Goethe, West-östlicher Divan"
                                            },
                                            {
                                                "example_id": "ad36b065-c631-453e-ba42-f20bc4cd0cce",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "„Sie wird hofiert, weil sie die Menschen nicht mit der Komplexität und Ambivalenz der Religion des Islam überfordert, sondern ihnen vorgefertigte, schubladengerechte Antworten auf schwierige Fragen anbietet.“"
                                            },
                                            {
                                                "example_id": "2155ea98-0622-44ae-9b43-f80daf256272",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "Islam bedeutet für den Muslim die Hingabe in Allahs Willen."
                                            },
                                            {
                                                "example_id": "5804c16a-fdc6-4843-850b-534acd084297",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "„Die Religion bei Gott ist der Islam. Diejenigen, denen das Buch zugekommen ist, sind erst uneins geworden, nachdem das Wissen zu ihnen gekommen war, dies aus ungerechter Auflehnung untereinander. Wenn aber jemand die Zeichen Gottes verleugnet - siehe, Gott ist schnell im Abrechnen.“"
                                            },
                                            {
                                                "example_id": "6dda6f1b-cdb9-4147-97c4-78dd08b7cd42",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "„Die meisten dieser Männer sind freilich gar nicht arabischer Herkunft, sondern stammen aus Ostafrika, sind zum Islam konvertiert und sprechen die Verkehrssprache Swahili.“"
                                            },
                                            {
                                                "example_id": "acf40fd0-a85b-498b-9b24-eef69ceaac02",
                                                "sense_id": "ce121e9e-352b-369f-b1bf-97e05d0c39e7",
                                                "text": "„Der Islam, der Buddhismus und der Kommunismus sind dagegen Religionen, weil es sich um Systeme menschlicher Werte und Normen handelt, die auf dem Glauben an eine übermenschliche Ordnung basieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                        "entry_id": "f3ffbecc-0c7b-39e4-ab7a-ae8d4ce11342",
                                        "glosses": [
                                            "spezifische Auffassung oder Art von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfaf0394-c56c-4810-ac90-68f43331a778",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Streben sie einen europäischen Islam oder einen klassischen – in der Heimat verwurzelten – Islam an?“"
                                            },
                                            {
                                                "example_id": "3cd2bc7c-0af2-4d95-a635-343ace130ee8",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Laut Bougarel muss man gegenwärtig jedoch von mehreren Islamen bzw. dessen Auffassungen ausgehen, weil ein europäischer Islam in jener Form nicht existiert, in der Angelegenheiten, die für alle europäischen Muslime von Belang sind, in einem gemeinsamen religiösen und intellektuellen Raum diskutiert werden.“"
                                            },
                                            {
                                                "example_id": "e87ad8e5-3dfd-407c-bd46-a7f5502f3bba",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Weiterhin gesteht Umar Maschri seine Angst vor dem Verfall der Mehrheit der Muslime in Verzweiflung und Sorge ein, wenn diese sich aufgefordert fühlten, sich mehr als einer Richtung anschließen zu müssen, denn dann könnten sich einige unter Umständen einbilden, es gebe mehrere Islame und verfeindete Richtungen.“"
                                            },
                                            {
                                                "example_id": "62653b06-944d-427d-a23b-172d5e81ef6c",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Obwohl es sich aus der subjektiven Sicht des Gläubigen immer um einen Islam handelt, spaltet er sich von außen gesehen in mehrere Islame auf.“"
                                            },
                                            {
                                                "example_id": "90840273-c9a2-48f7-a1a6-1dfb02716f5a",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Es wird argumentiert, dass es ›den Islam‹ gar nicht gibt, sondern viele Islame, und dass – genauso wie bei jeder anderen Religion auch – man sich aktiv einbringen und anstrengen muss, um die kulturelle Vorherrschaft nicht den Fundamentalisten zu überlassen.“"
                                            },
                                            {
                                                "example_id": "422871ce-3c5e-4a97-90f6-5140398f0930",
                                                "sense_id": "2feacaca-0488-3b44-aa2e-212f7e0d1dce",
                                                "text": "„Es gibt offensichtlich zwei verschiedene ‚Islame‘, den, den unsere christlichen Freunde dafür halten, und jenen, durch den wir Moslems unser Heil erhoffen…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
