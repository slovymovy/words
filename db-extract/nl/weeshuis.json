                "senses": [
                    {
                        "sense_id": "836a889b-233a-3860-b5b2-2b600e9e6c95",
                        "entry_id": "b0f11ae1-0b23-3c5c-a3de-48feff938cc6",
                        "glosses": [
                            "een opvanghuis voor wezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba1800a7-6f62-4ed1-b19c-009b6df2f14e",
                                "sense_id": "836a889b-233a-3860-b5b2-2b600e9e6c95",
                                "text": "Het is uiteraard beter voor kinderen om bij hun ouders op te groeien dan in een weeshuis."
                            },
                            {
                                "example_id": "94296c9c-e16b-4a1f-b58f-6a9eb844f05e",
                                "sense_id": "836a889b-233a-3860-b5b2-2b600e9e6c95",
                                "text": "List woonde vanaf haar zevende jaar, na omzwervingen in weeshuizen, bij Jaap en Marie List op Vlieland. Uiteindelijk nam ze ook hun achternaam aan. Tot haar achttiende verbleef ze op het Waddeneiland, om vervolgens haar geluk te beproeven in Amsterdam, waar ze tot aan haar overlijden op 78-jarige leeftijd woonde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c8c2572-18d3-454e-b2fb-c3fdc83105f9",
                        "source_entry_id": "b0f11ae1-0b23-3c5c-a3de-48feff938cc6",
                        "source_sense_id": "836a889b-233a-3860-b5b2-2b600e9e6c95",
                        "source_sense_description": "een opvanghuis voor wezen",
                        "target_lang_word": "Waisenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waisenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                        "entry_id": "c9534063-8dd4-313e-8fd5-4b1f78b84c88",
                                        "glosses": [
                                            "Heim für elternlose Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2130193f-6e70-4169-a9ba-9d8fc29ba657",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "Der Junge wurde in einem Waisenhaus untergebracht."
                                            },
                                            {
                                                "example_id": "b4bdcbbf-7856-4c9d-ad91-0e767b64e386",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Später zog das Waisenhaus in ein größeres Gebäude in der Bolschaja Shitomirskaja, damals noch Uliza Lwowskaja.“"
                                            },
                                            {
                                                "example_id": "5a7be4f1-ae3e-4cb5-901a-8b13e945f5cc",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Dort muss er zwei Wochen behandelt werden, bevor er in ein Waisenhaus kommt.“"
                                            },
                                            {
                                                "example_id": "48797220-ba78-41fb-a6c5-b1bdc047c69c",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Joe war hauptsächlich im Waisenhaus aufgewachsen und daher immer von anderen Kindern umgeben gewesen, mehr als die meisten anderen Menschen.“"
                                            },
                                            {
                                                "example_id": "6d747509-e259-44f9-af1f-1bede5a31bbf",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Wir kamen an einem verlassenen Gebäude vorbei, das Linus als Waisenhaus identifizierte, und einigen weiteren, die wie Pferche aussahen, von denen er aber sagte, es seien Kindergärten, die auf Spendenbasis arbeiteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
