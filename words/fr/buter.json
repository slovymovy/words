                    ]
                },
                {
                    "sense_id": "75666dd8-8214-31fa-8701-58ae036a4970",
                    "sense_definition": "S'obstiner avec raideur dans une opinion, une décision ou un refus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se <w>bute</w> dans son silence dès que son père tente de la raisonner."
