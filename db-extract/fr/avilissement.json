                    {
                        "translation_id": "95c5661b-a59c-4384-a02a-0c85373eac16",
                        "source_entry_id": "f9fba935-a82f-3157-b478-9893133f27df",
                        "source_sense_id": "dc4f7815-aadc-39a3-a240-56f733148ac6",
                        "source_sense_description": "veraltend, Finanzen: Wertminderung, Abwertung",
                        "target_lang_word": "Wertminderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wertminderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                        "entry_id": "9ab16bfd-30b0-3e4d-8752-da3c09b64c0d",
                                        "glosses": [
                                            "Verschlechterung der Qualität einer Sache durch Gebrauch, Beschädigung oder wirtschaftliche Aspekte"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9909f815-02c7-4f80-9007-708805a27899",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Geht es um die Wertminderung eines Leasingfahrzeugs, muss zwischen merkantilem und technischem Minderwert differenziert werden."
                                            },
                                            {
                                                "example_id": "dba0ffee-f1fe-4fcc-9c3a-f14cd981d3e8",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Ein merkantiler Minderwert ist die Art von Wertminderung, die ein Fahrzeug im Vergleich zu anderen nicht durch einen Unfall beschädigten und nach besten Möglichkeiten reparierten Fahrzeugen aufweist."
                                            },
                                            {
                                                "example_id": "ba832214-af0a-4980-b6cf-3504a6ec0e61",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Von technischer Wertminderung ist dann die Rede, wenn das Fahrzeug wegen Schäden repariert werden muss und der rein technische Zustand des Fahrzeugs nicht mehr mit dem vor dem Schadensfall zu vergleichen ist."
                                            },
                                            {
                                                "example_id": "a207f732-c358-4090-a27a-3b604ab2b84c",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Die Angabe der Wertminderung erfolgt in der Regel steuerneutral, da es sich um einen fiktiven Wert handelt."
                                            },
                                            {
                                                "example_id": "b14eebe1-7397-40d9-90fa-afbff649f14c",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Wertminderungen (das heißt erstattungsfähige Schäden, die damit begründet werden, dass ein Unfallwagen im Falle eines späteren Verkaufs eine geringeren Erlös erzielen kann als Fahrzeuge ohne Vorschäden) sind gemäß den Regelungen in den jeweils geltenden Allgemeinen Geschäftsbedingungen geltend zu machen."
                                            },
                                            {
                                                "example_id": "ce1db8c5-b174-46c3-962f-496a76a45a2a",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "Entschädigungsleistungen für Wertminderung sind in jedem Fall an den Leasinggeber weiterzuleiten. (Quelle: Allgemeine Geschäftsbedingungen für das Leasing von Kraftfahrzeugen, Abschnitt X, Punkt 5. Stand 11/2012)"
                                            },
                                            {
                                                "example_id": "8830b162-4a55-4e10-ae7c-4074dc8edde4",
                                                "sense_id": "b3cbb2e9-853e-3c7a-9a5f-9edd28fd46cb",
                                                "text": "„Gerichte berechnen die Wertminderung in schwierigen Fällen mit Hilfe eines Sachverständigengutachtens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d83fea3-d155-4409-9055-b97306d6dc5d",
                        "source_entry_id": "f9fba935-a82f-3157-b478-9893133f27df",
                        "source_sense_id": "dc4f7815-aadc-39a3-a240-56f733148ac6",
                        "source_sense_description": "veraltend, Finanzen: Wertminderung, Abwertung",
                        "target_lang_word": "Abwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Verringerung des Wertes einer Währung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510a7eef-c497-4add-ac27-e5236e4deab8",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "Die folgende Abwertung bewirkte, daß die Währungen in der ganzen Region mit nach unten gezogen wurden."
                                            },
                                            {
                                                "example_id": "b5eba18b-0d2c-4137-8c3a-445a7ccb74af",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "„Die ING Groep hat ihre Kursprognose zum zweiten Mal innerhalb weniger Tage gesenkt und geht von einem künftigen Kurs von 7 Yuan für den Dollar aus da die Zentralbank den Marktkräften erlaube, die Geschwindigkeit der Abwertung zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Absprechung von Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43ef25b-1964-4259-8454-189ba9324fa8",
                                                "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                                "text": "Glaubt man, solche gefunden zu haben, dann greifen die feinen Mechanismen von Ausgrenzung, Abwertung, Diffamierung wie eh und je, wenn auch heute wohl nicht mehr so stark mit existenzgefährdenden Folgen wie in der Adenauerzeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
