                                        "sense_id": "3d8432cb-4a0f-390d-9937-e0de868ad33a",
                                        "entry_id": "b3ae3eb0-e29f-34fd-9a3b-cc62f534adc0",
                                        "glosses": [
                                            "op een wijze de getuigt van aandacht en interesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63391e87-2de5-4a18-9ff4-c21a4754dbc3",
                                                "sense_id": "3d8432cb-4a0f-390d-9937-e0de868ad33a",
                                                "text": "Mijn zoontje was aandachtig naar de tv aan het kijken."
                                            },
                                            {
                                                "example_id": "70ce1d16-ddcf-4f7a-b355-f420ee788d93",
                                                "sense_id": "3d8432cb-4a0f-390d-9937-e0de868ad33a",
                                                "text": "De arts luisterde aandachtig naar de patiënten."
                                            },
                                            {
                                                "example_id": "0bb0f6e5-b176-4694-bed5-637694d55b87",
                                                "sense_id": "3d8432cb-4a0f-390d-9937-e0de868ad33a",
                                                "text": "De koningin, die bekendstaat als groot paardenliefhebber, genoot zichtbaar van het evenement, zeker toen er op het hoogtepunt van de show dieren uit haar eigen stoeterij voorbij werden geleid. Met een deken over haar benen en een sjaal om volgde ze de show aandachtig en knikte ze soms instemmend bij alle lof."
                                            },
                                            {
                                                "example_id": "53028f7d-fc37-47d4-9934-a46dace6af8c",
                                                "sense_id": "3d8432cb-4a0f-390d-9937-e0de868ad33a",
                                                "text": "Iedereen stond er met aandachtige toewijding bij en ze hadden allemaal het gevoel dat er een kroon op het werk werd gezet, alsof het succes van de burgerlijke familie op dat moment eindelijk werd gemanifesteerd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
