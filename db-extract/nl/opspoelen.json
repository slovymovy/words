                            {
                                "target_word": "wind up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1267cd-49e4-3bd7-96c8-6cde256712d2",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To wind (rope, string, mainsprings, etc.) completely."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4fd8063-9c58-4af0-9ec6-05335ad9d1d8",
                                                "sense_id": "1f1267cd-49e4-3bd7-96c8-6cde256712d2",
                                                "text": "I wound up the spool of rope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ea3fac-3bc3-376b-83cc-98acfb809b8b",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To put (a clock, watch, etc.) in a state of renewed or continued motion by winding the spring or other energy-storage mechanism."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48b28ee-d03b-4759-b401-83ff366b9efd",
                                                "sense_id": "37ea3fac-3bc3-376b-83cc-98acfb809b8b",
                                                "text": "I wound up the clock."
                                            },
                                            {
                                                "example_id": "279bf009-7d4b-42e8-995a-f47565f10cb1",
                                                "sense_id": "37ea3fac-3bc3-376b-83cc-98acfb809b8b",
                                                "text": "Your pocket watch will run for a long time if you wind up the spring all the way."
                                            },
                                            {
                                                "example_id": "08370bff-96c4-4d2e-ae9e-c9f1389dc4a5",
                                                "sense_id": "37ea3fac-3bc3-376b-83cc-98acfb809b8b",
                                                "text": "Their feet padded softly on the ground, and they crept quite close to him, twitching their noses, while the Rabbit stared hard to see which side the clockwork stuck out, for he knew that people who jump generally have something to wind them up. But he couldn't see it. They were evidently a new kind of rabbit altogether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "984542c8-ce02-3be1-ad90-bbfb01e05549",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To tighten (someone or something) by winding or twisting."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92cf1cce-c079-40bd-b7ff-b8110f380896",
                                                "sense_id": "984542c8-ce02-3be1-ad90-bbfb01e05549",
                                                "text": "The movie wound me up emotionally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee38d9ff-fb65-37be-8d5f-323b17c02d2f",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To excite."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d904bf5-eaee-4ab5-91c3-cf93ee6208a6",
                                                "sense_id": "ee38d9ff-fb65-37be-8d5f-323b17c02d2f",
                                                "text": "Try not to wind up the kids too much right before bedtime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e316cab-4cc0-3328-aa9b-a9612904353e",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To upset; to anger or distress."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c84b13e-d014-4680-81b4-5707dae8a095",
                                                "sense_id": "5e316cab-4cc0-3328-aa9b-a9612904353e",
                                                "text": "Of all their regrets, it was their inability to score an away goal that might wind up Klopp the most. Sadio Mané wasted a glorious chance in the first half and, late on, Mohamed Salah turned his shot against a post after a goal-line clearance had spun his way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77de81c-a2b3-3fa6-b4e1-7503db1bfd16",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To roll up (a car window or well bucket, etc., by cranking)."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d98bd41-4a78-45f4-9e19-843d6c8ae547",
                                                "sense_id": "a77de81c-a2b3-3fa6-b4e1-7503db1bfd16",
                                                "text": "Wind up your window — it's starting to rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4220c831-f5e5-33af-baf6-a8635bcd7f92",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To end up; to arrive or result."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f2c618-ec01-4488-931b-fed656d87bf8",
                                                "sense_id": "4220c831-f5e5-33af-baf6-a8635bcd7f92",
                                                "text": "Mess around with drugs and wind up broke."
                                            },
                                            {
                                                "example_id": "ac1bcd87-928e-4ebc-8232-158d80768214",
                                                "sense_id": "4220c831-f5e5-33af-baf6-a8635bcd7f92",
                                                "text": "I followed the signs, and I wound up getting nowhere."
                                            },
                                            {
                                                "example_id": "4746ae82-3b5c-4425-a933-d467eec1c878",
                                                "sense_id": "4220c831-f5e5-33af-baf6-a8635bcd7f92",
                                                "text": "The Hound's afraid to go in. Maybe he's afraid the occupants will tell on him, but Beric points out that there's no smoke in the chimney or livestock in the yard, so it's probably deserted. It's not. Inside are the decaying corpses of the farmer and his little girl, in bed together with a knife on the floor. Beric CSIs that they were starving to death, so the man ended the suffering for both of them. And they might not have wound up that way if they hadn't met the Hound."
                                            },
                                            {
                                                "example_id": "449a7c32-bbc4-4fe3-83d4-a1bd9564b87b",
                                                "sense_id": "4220c831-f5e5-33af-baf6-a8635bcd7f92",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b99d5ed-2532-313c-9c98-2b37807db36a",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To increase (in some aspect)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18de5cc3-3974-4f58-bcd6-93213f548b03",
                                                "sense_id": "2b99d5ed-2532-313c-9c98-2b37807db36a",
                                                "text": "Now, things got even more confusing. Farenholt and Laffey hadn't spotted the incoming Japanese Navy vessels, and were winding up to full speed to more-quickly bypass the cruisers. Duncan, of course, could see the radar contacts to its starboard, and so assumed that this increase in speed by its compatriots was the start of a general assault on the enemy. And so, not wanting to be left behind, it broke off and headed off into the darkness to start what turned out to be a one-ship torpedo assault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f59ae2b-e26c-37e8-b844-498c5de6027f",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To conclude, complete, or finish (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36bd5aa-b03c-461a-9645-1eb99a3dfc5a",
                                                "sense_id": "2f59ae2b-e26c-37e8-b844-498c5de6027f",
                                                "text": "Even though he had bad news, he tried to wind up his speech on a positive note."
                                            },
                                            {
                                                "example_id": "7cd84b6d-3bc9-412b-bcf8-010ad8d1da92",
                                                "sense_id": "2f59ae2b-e26c-37e8-b844-498c5de6027f",
                                                "text": "A general feast, of which all the male inhabitants of the town partake, winds up the proceedings at the close of the nineteen days."
                                            },
                                            {
                                                "example_id": "b9f9d621-2a83-4a79-b5e4-9bc7851aa6f4",
                                                "sense_id": "2f59ae2b-e26c-37e8-b844-498c5de6027f",
                                                "text": "In late April, residents were sent a blunt letter telling them that the town's ancient market, which had stopped because of the pandemic, and which really did date back to the reign of Queen Anne, would be wound up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae2416b-1f6b-3864-ba25-286958c6d643",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To dissolve (a partnership or corporation) and liquidate its assets."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d574514-e870-345c-b1e7-af3cad1a7010",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To play a prank (on); to take the mickey (out of) or mock."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8139ee-f948-4bc2-b5fd-af8afbc1d730",
                                                "sense_id": "3d574514-e870-345c-b1e7-af3cad1a7010",
                                                "text": "Twenty quid? Are you winding me up?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77327245-303b-378e-83f5-4184c710d408",
                                        "entry_id": "96b93345-b241-30e1-b30c-1bcac999bf07",
                                        "glosses": [
                                            "To make the preparatory movements for a certain kind of pitch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e16b54f-9e4e-4bc8-b3ee-0e9b5bef1e45",
                                                "sense_id": "77327245-303b-378e-83f5-4184c710d408",
                                                "text": "Paige seemed to be winding up for a fastball but then switched it up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
