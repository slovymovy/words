                            {
                                "example_id": "6e481227-b363-4255-b3d5-b3b3348af8bb",
                                "sense_id": "d374e2d5-af1e-3e17-8e0b-3d495f356555",
                                "text": "De medewerker van het bedrijf is erg behulpzaam.",
                                "translation": "The employee of the company is very helpful.",
                                "english": "The employee of the company is very helpful."
                            },
                            {
                                "example_id": "0b8a9b9f-997c-4e1a-8dcd-7d0b7038075f",
                                "sense_id": "d374e2d5-af1e-3e17-8e0b-3d495f356555",
                                "text": "Er zijn veel tevreden medewerkers in dit bedrijf.",
                                "translation": "There are many satisfied employees in this company.",
                                "english": "There are many satisfied employees in this company."
                            },
                            {
                                "example_id": "f1b074b0-908a-40ce-af47-7e43c57873e4",
                                "sense_id": "d374e2d5-af1e-3e17-8e0b-3d495f356555",
                                "text": "De medewerkers werken nauw samen aan het project.",
                                "translation": "The staff are working closely together on the project.",
                                "english": "The staff are working closely together on the project."
                            }
                        ]
                    }
