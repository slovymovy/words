                "senses": [
                    {
                        "sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                        "entry_id": "5647b775-1226-3d6a-bd3d-737f8be57f22",
                        "glosses": [
                            "мед. расстройство деятельности кишечника у человека и животных, выражающееся в появлении жидких и обычно учащённых испражнений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3f4d71-a6b6-4d46-90b7-4fbbb1c45a21",
                                "sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                                "text": "Одно Д точно помню — это дерматит. Замечаешь, как она вся шелушится? Второе... Второе Д — это, кажется, диарея. Понос."
                            },
                            {
                                "example_id": "8caa07f9-8726-429e-932d-67da3cad8ea2",
                                "sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                                "text": "Заболевание началось с однократной рвоты и диареи до 10 раз в день, характер стула ― жидкий со слизью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a215edb5-2bb7-4046-b05d-f0c668f52b29",
                        "source_entry_id": "5647b775-1226-3d6a-bd3d-737f8be57f22",
                        "source_sense_id": "c35ecb2b-1b21-33a5-9904-e88386804899",
                        "target_lang_word": "diarrhea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diarrhea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea87c697-9261-3bb2-862b-f03f16663458",
                                        "entry_id": "f885718d-5d6d-306e-a7ba-a9760eb26f21",
                                        "glosses": [
                                            "A gastrointestinal disorder characterized by frequent and very soft or watery bowel movements."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                        "entry_id": "f885718d-5d6d-306e-a7ba-a9760eb26f21",
                                        "glosses": [
                                            "The watery or very soft excrement that comes from such bowel movements."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc1dd31-11f4-42d2-afb1-6bb35f5c5417",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "My Pampers bill is higher than your paycheck, my hands are raw from washing them every six minutes, and I do eight loads of laundry a day because everything we own is covered in diarrhea, and you want me to \"plug him up\" and wait another three weeks?"
                                            },
                                            {
                                                "example_id": "0f91a169-e426-4ba8-9f02-9fca034c4a43",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "I looked and saw that she and her hammock were covered in diarrhea."
                                            },
                                            {
                                                "example_id": "605c14c3-435e-4a23-a601-3c6ef164acc6",
                                                "sense_id": "74f59a34-f720-3371-bdb9-d068e9b33acd",
                                                "text": "Why was she covered in diarrhea?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
