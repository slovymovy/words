                    "sense_id": "2a501c8c-e86b-359e-8ff7-612cfdaa41b9",
                    "sense_definition": "вызывать беспокойство, сильные эмоции или переживания у кого-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта проблема продолжает <w>волновать</w> многих людей в нашей стране.",
                            "target_lang_translations": {
                                "en": "This problem continues to <w>worry</w> many people in our country.",
                                "es": "Este problema sigue <w>preocupando</w> a muchas personas en nuestro país.",
                                "fr": "Ce problème continue d'<w>inquiéter</w> beaucoup de gens dans notre pays."
                            }
                        },
                        {
                            "text": "Старые фотографии могут сильно <w>волновать</w> и вызывать воспоминания.",
                            "target_lang_translations": {
                                "en": "Old photographs can deeply <w>stir</w> emotions and bring back memories.",
                                "es": "Las fotos antiguas pueden <w>emocionar</w> mucho y evocar recuerdos.",
                                "fr": "Les anciennes photographies peuvent beaucoup <w>émouvoir</w> et faire surgir des souvenirs."
                            }
                        }
                    ],
                    "synonyms": [
                        "беспоко́ить",
                        "будора́жить",
                        "трево́жить",
                        "заботить",
                        "тревожить"
                    ],
                    "antonyms": [
                        "успокаивать"
                    ],
                    "common_phrases": [
                        "сильно волновать"
                    ],
                    "target_lang_definitions": {
