                ],
                "senses": [
                    {
                        "sense_id": "29a07a82-cd10-3781-af41-6b3fac859332",
                        "entry_id": "50796e5d-dede-3e4b-ba3b-62b5da17ba44",
                        "glosses": [
                            "Beruf, der vorwiegend von Frauen erlernt und ausgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c91e13-e271-411e-a4a8-db22c5c718c1",
                                "sense_id": "29a07a82-cd10-3781-af41-6b3fac859332",
                                "text": "Die Frauenfachschulen wurden im Hinblick auf die Anforderungen der Frauenberufe eingerichtet."
                            },
                            {
                                "example_id": "c298ea52-a1e3-4eb4-a5c0-255535feb7f1",
                                "sense_id": "29a07a82-cd10-3781-af41-6b3fac859332",
                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
