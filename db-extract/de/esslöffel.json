                        "entry_id": "61211ae1-9d34-35aa-a28c-78d846a71c2a",
                        "glosses": [
                            "Gerät zur Nahrungsaufnahme, um Suppe, Brei oder Ähnliches zu essen"
                        ],
                        "tags": [
                            "Küche",
                            "Haushalt"
                        ],
                        "examples": [
                            {
                                "example_id": "8551fbc8-2afb-49ed-a8c8-cb4f3d1662ee",
                                "sense_id": "016a5001-e6aa-353c-b386-a170bc6b3fd7",
                                "text": "Die Stiftung Warentest in Berlin empfiehlt, auf dem ganzen Körper eine Menge von etwa drei Esslöffeln zu verteilen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63dfbdd4-34f4-41ef-9537-c03c34ee373b",
                        "source_entry_id": "61211ae1-9d34-35aa-a28c-78d846a71c2a",
                        "source_sense_id": "016a5001-e6aa-353c-b386-a170bc6b3fd7",
                        "source_sense_description": "Küche, Haushalt: Gerät zur Nahrungsaufnahme, um Suppe, Brei oder Ähnliches zu essen",
                        "target_lang_word": "tablespoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tablespoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2c71960-fd52-3446-821b-eb125a152e08",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A large spoon, used for eating food from a bowl."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e63137d-7353-43b7-a4ac-5fb759de0090",
                                                "sense_id": "c2c71960-fd52-3446-821b-eb125a152e08",
                                                "text": "Their eggs were deposited on a few bits of straw, and great caution was necessary in attempting to procure them, as the slightest touch crumbled their frail tenement into dust. By means of a tablespoon, I was enabled to procure many of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598f29aa-3874-3ae2-9a82-da164268ed5e",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A spoon too large for eating, usually used for cooking or serving."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "Northern-UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                        "entry_id": "f28b4dc8-308a-3e54-be3f-932a6d3c66a8",
                                        "glosses": [
                                            "A unit of volume, the value of which varies regionally; in the US: three teaspoons or one half fluid ounce or roughly 15 ml; in Britain and Canada: exactly 15 ml; in Russia 18 ml; in Australia: four teaspoons or 20 ml."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5150827-2ebc-4122-9933-f86cd7d7f494",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "1995 May 22, Salad Recipes, New York, page 51,\nHeat 2 tablespoons olive oil in a nonstick skillet until hot and quickly saute the goat-cheese buttons on both sides until brown."
                                            },
                                            {
                                                "example_id": "df5f62a7-aac7-425a-b82a-49aa9f47f23a",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "In Australia, 1 tablespoon equals 20 ml, and there are 4 teaspoons in the Australian tablespoon."
                                            },
                                            {
                                                "example_id": "988d9d61-8e6d-4f5d-be34-85561260f376",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "2006, Tempted: 150 Very Wicked Desserts, Murdoch Books, UK, copyright page,\nIf you are using a 15 ml (3 teaspoon) tablespoon, for most recipes the difference will not be noticeable."
                                            },
                                            {
                                                "example_id": "9f09eee0-aa29-4fdb-88b2-c5b344fc28c6",
                                                "sense_id": "4598471f-04d9-36d4-b7c0-e332c455c43d",
                                                "text": "2012, James Armstrong, Kellee Hollyman, General, Organic, and Biochemistry: An Applied Approach, Cengage Learning, US, page 27,\nThe problem gives us a number of tablespoons of cooking oil and asks us to convert this amount into milliliters. We are also told that one tablespoon equals 3 teaspoons, but this is a relationship between two units, not an actual measurement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05ca1fb8-756f-4f31-a0ed-9e9340db7311",
                        "source_entry_id": "61211ae1-9d34-35aa-a28c-78d846a71c2a",
                        "source_sense_id": "016a5001-e6aa-353c-b386-a170bc6b3fd7",
                        "source_sense_description": "Küche, Haushalt: Gerät zur Nahrungsaufnahme, um Suppe, Brei oder Ähnliches zu essen",
                        "target_lang_word": "cuillère à soupe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuillère à soupe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                        "entry_id": "dbdb6b6c-de5d-3585-8bd5-13c0939bdd4d",
                                        "glosses": [
                                            "Ustensile de table destiné à porter à la bouche des aliments liquides ou peu consistants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cfd5b9-5d5b-4f29-82ed-9d348300f06f",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "Une cuillère à soupe contient 15 millilitres (ml) ou 15 centimètres-cubes (cm³), une cuillère à café 5 millilitres (ml) ou 5 centimètres-cubes (cm³)."
                                            },
                                            {
                                                "example_id": "d7d60ecd-ca40-40c1-8b1a-6005f9aeda44",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "Avec un vieux couteau rouillé, elle taillait des tranches minces dans sa miche ; sa cuillère à soupe, en fer blanc étamé, était de forme ronde."
                                            },
                                            {
                                                "example_id": "f6d2c4e9-3b8c-485a-b523-eb207dbb5f2a",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "De plus, l’élève doit avoir un coffre pour renfermer son linge sale, un parapluie, un couvert de table consistant en une cuillère à soupe, une cuillère à café, toutes les deux en argent, un couteau et une fourchette, […]."
                                            },
                                            {
                                                "example_id": "221ca6a6-b6ed-4d44-a68e-287f9818b5f1",
                                                "sense_id": "0b647269-f440-3809-a8a5-91283ac38e26",
                                                "text": "La contenance d’une cuillère à café ou d’une cuillère à soupe est utilisée, parfois, pour exprimer une quantité de liquide (sirop, médicament)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de7e6add-9470-3eac-9499-8a8c63199fe7",
                                        "entry_id": "dbdb6b6c-de5d-3585-8bd5-13c0939bdd4d",
                                        "glosses": [
                                            "Mesure de volume de 15 ml."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5db46011-6802-4499-b685-87f3f228b59d",
                                                "sense_id": "de7e6add-9470-3eac-9499-8a8c63199fe7",
                                                "text": "À la fin, ajoutez une cuillère à soupe de crème fraîche, puis les moules."
                                            }
