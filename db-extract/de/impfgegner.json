                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c574bde7-32ef-4582-8290-bba0208e050b",
                        "source_entry_id": "d0a8dc4d-a49b-3e4f-bc72-dcde3d06d4d3",
