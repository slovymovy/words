    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "323c0819-e40d-3317-8638-68d96c2a8f1f",
                    "sense_definition": "A sharp, hooked claw of a bird of prey or predatory animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle grabbed the fish with its sharp <w>talons</w> and flew away.",
                            "target_lang_translations": {
                                "de": "Der Adler packte den Fisch mit seinen scharfen <w>Krallen</w> und flog davon."
                            }
                        },
                        {
                            "text": "An eagle can grip its prey tightly using a sharp <w>talon</w>.",
                            "target_lang_translations": {
                                "de": "Ein Adler kann seine Beute mit einer scharfen <w>Kralle</w> festpacken."
                            }
                        }
                    ],
                    "synonyms": [
                        "claw"
                    ],
                    "common_phrases": [
                        "sharp talon"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine scharfe, gekrümmte Kralle eines Raubvogels oder Raubtiers."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kralle",
                                "target_lang_sense_clarification": "eines Raubvogels oder Raubtiers"
                            },
                            {
                                "target_lang_word": "Klaue",
                                "target_lang_sense_clarification": "von Tieren und Raubvögeln"
                            },
                            {
                                "target_lang_word": "Fang",
                                "target_lang_sense_clarification": "Jägersprache für Greifvogelkralle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6e7b37-8f5d-3b38-9ee4-e4dd4f873a4e",
                    "sense_definition": "The remaining stack of undealt cards in certain card games.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drew a card from the <w>talon</w> during his turn.",
                            "target_lang_translations": {
                                "de": "Er zog während seines Zuges eine Karte vom <w>Talon</w>."
                            }
                        },
                        {
                            "text": "The players left the rest of the deck in the center as the <w>talon</w>.",
                            "target_lang_translations": {
                                "de": "Die Spieler ließen den Rest des Decks als <w>Talon</w> in der Mitte liegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stock"
                    ],
                    "target_lang_definitions": {
                        "de": "Der verbleibende Stapel unverteilter Karten bei bestimmten Kartenspielen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Talon",
                                "target_lang_sense_clarification": "Kartenstapel beim Kartenspiel"
                            },
                            {
                                "target_lang_word": "Stock",
                                "target_lang_sense_clarification": "Kartenstapel zum Nachziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d98973d5-ad60-33e2-bc9a-96ebea3631c5",
                    "sense_definition": "An ogee molding shape, concave at the bottom and convex at the top.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect specified an elaborate <w>talon</w> molding for the ceiling edge.",
                            "target_lang_translations": {
                                "de": "Der Architekt sah eine aufwendige <w>S-förmige Profilleiste</w> für die Deckenkante vor."
                            }
                        },
                        {
                            "text": "The decorative wooden beam featured a classical <w>talon</w> profile.",
                            "target_lang_translations": {
                                "de": "Der dekorative Holzbalken wies ein klassisches <w>Kartenprofil</w> auf."
                            }
                        }
                    ],
                    "synonyms": [
                        "ogee"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "architecture"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine S-förmige Profilleiste, unten konkav und oben konvex."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "K Kehle",
                                "target_lang_sense_clarification": "in der Architektur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "190b36b1-25ef-3a07-afa1-2499b86c4846",
                    "sense_definition": "The shoulder of a lock bolt on which the key acts to slide the bolt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locksmith inspected the worn <w>talon</w> on the old lock bolt.",
                            "target_lang_translations": {
                                "de": "Der Schlosser untersuchte den abgenutzten <w>Riegelansatz</w> des alten Schlossriegels."
                            }
                        },
                        {
                            "text": "When the key turns, it engages the <w>talon</w> to shoot the bolt forward.",
                            "target_lang_translations": {
                                "de": "Wenn sich der Schlüssel dreht, greift er am <w>Riegelansatz</w> an, um den Riegel vorzuschieben."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Schulter eines Schlossriegels, an der der Schlüssel angreift."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Angriffspunkt",
                                "target_lang_sense_clarification": "am Schlossriegel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39db29e9-d81d-3281-a60f-c51cc17ae22b",
