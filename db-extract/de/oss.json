                "senses": [
                    {
                        "sense_id": "2a9464bd-e276-3d8a-8881-aa424596867c",
                        "entry_id": "68db182d-4647-34a7-8608-a51b4c7bebd9",
                        "glosses": [
                            "US-amerikanischer Auslandsgeheimdienst während des 2. Weltkrieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "486e1a7c-ceff-48d3-a832-aaf0898c70b3",
                                "sense_id": "2a9464bd-e276-3d8a-8881-aa424596867c",
                                "text": "„Als im Februar 1944 in Palermo ein US-Konsulat eingerichtet wurde, lieferte das OSS geheimdienstliche Daten. Das OSS wiederum bezog seine Informationen teilweise von der Mafia und insbesondere von Don Calò [Calogero Vizzini].“"
                            },
                            {
                                "example_id": "e02b8796-ec1d-4118-bfbd-83e88aee7037",
                                "sense_id": "2a9464bd-e276-3d8a-8881-aa424596867c",
                                "text": "„Im Oktober desselben Jahres [1943] beauftragte Präsident Franklin D. Roosevelt den Direktor des OSS William Donovan mit konzeptionellen Vorarbeiten zu Strafverfahren gegen Kriegsverbrecher.“"
                            },
                            {
                                "example_id": "d083c2f2-8e4b-42bc-b145-1f90812448b0",
                                "sense_id": "2a9464bd-e276-3d8a-8881-aa424596867c",
                                "text": "„Doch zunächst [vor Beginn des kalten Krieges], 1944 und 1945, pflegten die USA, insbesondere die Chinaspezialisten im OSS, aber auch die Militärs um General [Albert] Wedemeyer, ein geradezu freundschaftliches Verhältnis zur kommunistischen Führung um Mao Tsetung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
