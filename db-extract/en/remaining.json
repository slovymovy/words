                        "entry_id": "f8354724-86a6-378a-b7de-b6f04ad8950d",
                        "glosses": [
                            "Which remains, especially after something else has been removed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "589b2808-b392-47af-818d-445935955cb5",
                                "sense_id": "a01d9731-224d-37f5-b4dc-739f9f200788",
                                "text": "May I have the only remaining cake?"
                            },
                            {
                                "example_id": "07c7214b-6de0-40e2-9f12-6a72544a8846",
                                "sense_id": "a01d9731-224d-37f5-b4dc-739f9f200788",
                                "text": "Last year, the company eliminated hundreds of jobs and asked some of the remaining staff to take on the responsibilities of those who were let go."
                            }
                        ]
