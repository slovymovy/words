                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7163c2d-b24c-45e5-91ad-bd027029dc7e",
                                "sense_id": "0104096e-b1cb-3d62-9852-19b71491fbf9",
                                "text": "Qu’on se souvienne des larmes et des sanglots cachés dans le recoin de cet arrière-cabinet, où je surpris M. le duc d’Orléans la nuit de la mort de Monseigneur."
                            },
                            {
                                "example_id": "717a709b-66cd-4878-afa2-765f2a32dfda",
                                "sense_id": "0104096e-b1cb-3d62-9852-19b71491fbf9",
                                "text": "Le duc d’Orléans m’emmena dans son arrière-cabinet obscur, sur la galerie."
                            },
                            {
                                "example_id": "ed81ce46-3c5d-4139-a7d4-8eb62a78931c",
                                "sense_id": "0104096e-b1cb-3d62-9852-19b71491fbf9",
                                "text": "Le rideau du lit fut un peu tiré, et Mme de Maintenon passa dans les arrière-cabinets."
                            }
                        ]
                    }
