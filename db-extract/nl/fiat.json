                        "source_entry_id": "872225bc-dc82-3f19-8059-45ec423d6f4b",
                        "source_sense_id": "6f3ef698-0a16-357d-824c-0490c894fd5a",
                        "target_lang_word": "agreement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agreement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                                        "entry_id": "f7ba1034-2cf6-337e-bc36-cb15364b5107",
                                        "glosses": [
                                            "An understanding between entities to follow a specific course of conduct."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37d8079-9372-48e0-878c-a483dcdf04f6",
                                                "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                                                "text": "to enter an agreement"
                                            },
                                            {
                                                "example_id": "c00be03b-66f5-44e8-9a13-2e83af17b05d",
                                                "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                                                "text": "The UK and US negotiators were nearing agreement."
                                            },
                                            {
                                                "example_id": "a776762a-2f21-485c-880b-a9f626420d3e",
                                                "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                                                "text": "He nodded his agreement."
                                            },
                                            {
                                                "example_id": "82596c1e-654d-40d6-a33a-0776615dee19",
                                                "sense_id": "8856f073-afb0-3d59-8fdc-ec709af4e05c",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe.[…]The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39846f39-e1e1-309f-9833-7a99b9c08553",
                                        "entry_id": "f7ba1034-2cf6-337e-bc36-cb15364b5107",
                                        "glosses": [
                                            "A state whereby several parties share a view or opinion; the state of not contradicting one another."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e78ece1c-95da-49b2-a088-8905ecc4c279",
                                                "sense_id": "39846f39-e1e1-309f-9833-7a99b9c08553",
                                                "text": "The results of my experiment are in agreement with those of Michelson and with the law of General Relativity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b25932f6-f6de-3e9e-9522-8123e71a4c3b",
                                        "entry_id": "f7ba1034-2cf6-337e-bc36-cb15364b5107",
                                        "glosses": [
                                            "A legally binding contract enforceable in a court of law."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c87001d5-3cb8-323f-a6c3-2c3024bda3af",
                                        "entry_id": "f7ba1034-2cf6-337e-bc36-cb15364b5107",
                                        "glosses": [
                                            "Rules that exist in many languages that force some parts of a sentence to be used or inflected differently depending on certain attributes of other parts."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbcef711-dd76-4211-b1f4-a7850da220f0",
                                                "sense_id": "c87001d5-3cb8-323f-a6c3-2c3024bda3af",
                                                "text": "Having clarified what we mean by ‘Personʼ and ‘Numberʼ, we can now return to our earlier observation that a finite I is inflected not only for Tense, but also for Agreement. More particularly, I inflects for Person and Number, and must ‘agreeʼ with its Subject, in the sense that the Person/Number features of I must match those of the Subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9635960f-d7c0-3662-b627-382789ae3e96",
                                        "entry_id": "f7ba1034-2cf6-337e-bc36-cb15364b5107",
                                        "glosses": [
                                            "An agreeable quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e724be8c-77e7-403f-a9a6-1a5742efac51",
                                                "sense_id": "9635960f-d7c0-3662-b627-382789ae3e96",
                                                "text": "Her nymph-like features such agreements have / That I could venture with her to the grave [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
