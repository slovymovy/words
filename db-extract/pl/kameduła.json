                        "entry_id": "18228c09-9b09-33f9-9a53-f348e2d42306",
                        "glosses": [
                            "zakonnik z zakonu założonego przez św. Romualda z Camaldoli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8f93a4-9b59-4f62-a5d4-0fd8ae7a8472",
                                "sense_id": "31053b30-5bdd-3a1f-8a83-712cf436714c",
                                "text": "Habit kameduły wisiał na haku."
                            },
                            {
                                "example_id": "febebec8-ec4a-45cc-bbf3-8ec75bf4f617",
                                "sense_id": "31053b30-5bdd-3a1f-8a83-712cf436714c",
                                "text": "Podrzuciliśmy ojca kamedułę na Bielany."
                            },
                            {
                                "example_id": "7c2221bd-e5e8-4bfc-9b8c-df47a98d76fa",
                                "sense_id": "31053b30-5bdd-3a1f-8a83-712cf436714c",
                                "text": "Erem kamedułów stoi na wzgórzu."
                            },
                            {
                                "example_id": "74591cff-65be-43ba-9622-4c2fba9350d8",
                                "sense_id": "31053b30-5bdd-3a1f-8a83-712cf436714c",
                                "text": "Tomek myślał o kamedułach po maturze."
                            }
                        ],
