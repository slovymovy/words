                    }
                ],
                "senses": [
                    {
                        "sense_id": "12635819-1836-3871-91f9-c74a84045250",
                        "entry_id": "77bac427-c605-35f7-9c18-f9624054da52",
                        "glosses": [
                            "Any disorder of the muscles, tendons, joints, bones, nerves, characterized by pain, discomfort and disability."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b93909fe-07f0-4224-8700-a7f2ef25fac6",
                                "sense_id": "12635819-1836-3871-91f9-c74a84045250",
                                "text": "And then as to your ſcurvys, and gouts, rheumatiſms, conſumptions, coughs and catarrhs, tar-vvater and turpentine vvill make you as ſound as a roach."
                            },
                            {
                                "example_id": "e9383376-2f7d-47da-96ac-dd88490d1c84",
                                "sense_id": "12635819-1836-3871-91f9-c74a84045250",
                                "text": "The old man had become a confirmed invalid, confined by chronic rheumatism to his chair."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe6f124f-854c-3146-8510-742655049b48",
                        "entry_id": "77bac427-c605-35f7-9c18-f9624054da52",
                        "glosses": [
                            "Atrophic arthritis, rheumatoid arthritis"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6d8c2da-e969-41a9-a0dc-b9782f7f9cf8",
