                        "form": "die Hüterin"
                    },
                    {
                        "form_id": "5f2d5253-af8f-4860-b8bd-3bb7fe412114",
                        "entry_id": "8c043ce4-002e-365c-b7af-bf9453eb3e52",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hüterinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63a0eb9d-c01e-3917-abc6-d3d89a13c7e6",
                        "entry_id": "8c043ce4-002e-365c-b7af-bf9453eb3e52",
                        "glosses": [
                            "weibliche Person (weibliches Subjekt), die (das) etwas wachsam beobachtet und schützt/garantiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce14218-2780-4ac1-ae2c-deac617bba16",
                                "sense_id": "63a0eb9d-c01e-3917-abc6-d3d89a13c7e6",
                                "text": "„Diese archaischen Bilder – der Mann als Held und Kämpfer, die Frau als Hüterin von Heim und Feuer – sind über Generationen weitergegeben und vererbt.“"
                            },
                            {
                                "example_id": "e98fa114-bb98-476e-b3b3-58b468be2e44",
                                "sense_id": "63a0eb9d-c01e-3917-abc6-d3d89a13c7e6",
                                "text": "„Die Beachtung dieses Grundsatzes gewährleistet nach Maßgabe der Gesetze die ordentliche Gerichtsbarkeit als Hüterin der Freiheit der Person.“"
                            },
                            {
                                "example_id": "96f2dcbf-d38f-478f-8ed7-8fc919b72236",
                                "sense_id": "63a0eb9d-c01e-3917-abc6-d3d89a13c7e6",
                                "text": "„Wir nahmen Abschied von der guten Hüterin des Gartens, die nicht mehr hoffen konnte, uns wiederzusehen, und fuhren nach Venedig.“"
                            },
                            {
                                "example_id": "d510ffb0-d408-46df-a668-de588281a7fd",
                                "sense_id": "63a0eb9d-c01e-3917-abc6-d3d89a13c7e6",
                                "text": "„Der tägliche Umgang mit Pralinen, deren Hüterin sie ist, hat Frau Joos diesen ähnlich gemacht; sie sieht wie eine Praline aus: süß, sauber, appetitlich, und ihre zierlichen Finger sind vom Umfang mit der Silberzange her immer ein wenig gespreizt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
