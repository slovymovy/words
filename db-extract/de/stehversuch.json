                        "examples": [
                            {
                                "example_id": "d70cee06-21c7-4747-8cec-27f7a5957086",
                                "sense_id": "b63bccf4-68d0-32ab-a903-756542f6f71c",
                                "text": "Sinn des Stehversuches ist es, den Gegner zum Vorbeifahren zu zwingen, um so selbst die bessere Position für den abschließenden Sprint einzunehmen."
                            },
                            {
                                "example_id": "f149ea37-8b12-478e-aba5-5e0736631c2b",
                                "sense_id": "b63bccf4-68d0-32ab-a903-756542f6f71c",
                                "text": "Beim Stehversuch darf sich der Fahrer weder irgendwo (z. B. an der Bande) festhalten noch den Fuß auf die Bahn setzen."
                            }
                        ],
