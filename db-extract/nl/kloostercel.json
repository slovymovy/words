                        "examples": [
                            {
                                "example_id": "396402d2-8846-44b7-9d45-75a7933b8544",
                                "sense_id": "28fe8ed1-eef5-3be6-833b-7121b5756ba7",
                                "text": "De treinkaartjes waren gekocht, hun spullen stonden samengebonden in de kloostercel."
                            },
                            {
                                "example_id": "ed952d18-2d9d-4963-8128-d132473290ad",
                                "sense_id": "28fe8ed1-eef5-3be6-833b-7121b5756ba7",
                                "text": "Er is slechts één personage, de vermogende dandy Des Esseintes, die zich terugtrekt uit het Parijse mondaine leven en in een verfijnd ingerichte kloostercel gaat wonen, op zoek naar pure schoonheid."
                            }
                        ]
