                        "glosses": [
                            "устар. и поэт. рубин или красная шпинель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36dbb6cf-19a5-46fc-96a0-680c2734d5dd",
                                "sense_id": "c6f49ab2-8296-3c95-a501-c3fc75a3a27a",
                                "text": "Из перстней же вот этот ей пошлём: // Он всех ценней, зовётся камень лал, // Привозится к нам из земли Индийской, // А достается нелегко, затем // Что страховидные там звери, грифы, // Его стрегут."
                            }
                        ]
                    }
