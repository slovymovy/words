        "fr-extract.jsonl": [
            {
                "entry_id": "b7b37510-ffb2-3c35-beda-08aa8c6103a3",
                "word": "bécot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cc76654-2d98-42c2-ba52-c801539f5027",
                        "entry_id": "b7b37510-ffb2-3c35-beda-08aa8c6103a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "bécots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                        "entry_id": "b7b37510-ffb2-3c35-beda-08aa8c6103a3",
                        "glosses": [
                            "Baiser."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "44c09131-3fcc-449e-a8c9-1ab28069cd71",
                                "sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                                "text": "Mercredi t'es parti sans me faire un bécot ?!"
                            },
                            {
                                "example_id": "f55d635d-faa6-4adf-a658-2e943d19d014",
                                "sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                                "text": "Avec un bref mugissement destiné à simuler la tendresse il posa un bécot sur son front, qui était aussi froid que du fromage blanc."
                            },
                            {
                                "example_id": "83aa2961-18ee-4891-be93-8f5fa3884b81",
                                "sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                                "text": "Les miennes, mes grand-tantes, ma grand-mère, n’étaient pas commodes, elles n’aimaient pas qu’on leur saute dans le tablier, perdu l’habitude, juste le bécot de l’arrivée et du départ […]"
                            },
                            {
                                "example_id": "e748f095-66de-4301-a9c0-c2256e4c4ebc",
                                "sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                                "text": "Remarquez, ça n’allait jamais bien loin. Du flirt de surface. Arriver à peloter un nichon naissant à travers le pull, déjà fallait le faire. Un bécot « avec la langue » était un exploit, après ça c’était le mariage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bcf0846-117c-455f-8954-2be3ea21a852",
                        "source_entry_id": "b7b37510-ffb2-3c35-beda-08aa8c6103a3",
                        "source_sense_id": "27e8709e-c795-31ec-8c67-d1f00980aa48",
                        "target_lang_word": "peck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "235d4d58-933b-3cc5-844f-b0857b8d1c8e",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To strike or pierce with the beak or bill (of a bird)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bc72459-13e2-4e05-a28a-2c584cb0f086",
                                                "sense_id": "235d4d58-933b-3cc5-844f-b0857b8d1c8e",
                                                "text": "The birds pecked at their food."
                                            },
                                            {
                                                "example_id": "7c7879da-a023-416c-87a0-426ed6048b5e",
                                                "sense_id": "235d4d58-933b-3cc5-844f-b0857b8d1c8e",
                                                "text": "The rooster had been known to fly on her shoulder and peck her neck, so that now she carried a stick or took one of the children with her when she went to feed the fowls."
                                            },
                                            {
                                                "example_id": "c9a5c038-675b-4c70-a27b-392a56b12829",
                                                "sense_id": "235d4d58-933b-3cc5-844f-b0857b8d1c8e",
                                                "text": "And the Wicked Witch said to the King Crow, \"Fly at once to the strangers; peck out their eyes and tear them to pieces.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09ab1c9d-8f74-31bd-9ea5-fe08013c6e82",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To form by striking with the beak or a pointed instrument."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb81250-e576-475b-b2cf-24d21c807735",
                                                "sense_id": "09ab1c9d-8f74-31bd-9ea5-fe08013c6e82",
                                                "text": "to peck a hole in a tree"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89594bf9-39bb-3a0b-9539-ae6c5645cc37",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To strike, pick, thrust against, or dig into, with a pointed instrument, especially with repeated quick movements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8bc9f71-85f3-31a3-8d36-3c3d6d2b6060",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To seize and pick up with the beak, or as if with the beak; to bite; to eat; often with up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b0e7d9-bd69-408a-aadf-9c2d63c9eb04",
                                                "sense_id": "a8bc9f71-85f3-31a3-8d36-3c3d6d2b6060",
                                                "text": "This fellow pecks up wit as pigeons peas."
                                            },
                                            {
                                                "example_id": "aa16dfac-82bb-4faf-a4eb-100305879510",
                                                "sense_id": "a8bc9f71-85f3-31a3-8d36-3c3d6d2b6060",
                                                "text": "1713 September 14, letter to Joseph Addison, The Guardian, issue 160.\nI HAVE laid a wager, with a friend of mine, about the pigeons that used to peck up the corn which belonged to the ants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c4bdca-e0ba-3b11-a4c5-55e6b49d75cf",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To do something in small, intermittent pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dabd350-590f-43f8-b715-0155fd32fe00",
                                                "sense_id": "15c4bdca-e0ba-3b11-a4c5-55e6b49d75cf",
                                                "text": "He has been pecking away at that project for some time now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61725f42-4ce6-3372-b0b3-46fc50ac2b9f",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To type by searching for each key individually."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "348c8436-c189-3064-840f-b0f79b2b6c32",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To type in general."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "750296f5-917f-33d3-8655-bef06a6b739d",
                                        "entry_id": "ae6d698e-c49b-3142-9a97-c6d10e7a4ea2",
                                        "glosses": [
                                            "To kiss briefly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39ae72e-0541-4d24-b0b0-df41f374d46c",
                                                "sense_id": "750296f5-917f-33d3-8655-bef06a6b739d",
                                                "text": "At half past eight, Mr. Dursley picked up his briefcase, pecked Mrs. Dursley on the cheek, and tried to kiss Dudley good-bye but missed, because Dudley was now having a tantrum and throwing his cereal at the walls."
                                            }
                                        ]
                                    }
                                ]
                            },
