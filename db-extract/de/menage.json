                "senses": [
                    {
                        "sense_id": "2cff41ce-a2ca-3617-a693-b2c42ca43acc",
                        "entry_id": "87620e7e-bd00-324f-8c3d-7ea91e27ec97",
                        "glosses": [
                            "Teil des Tafelgeschirrs: Ständer für Essig, Öl, Gewürze und mehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f944d10-5b5b-4206-9dfd-2e88e0871223",
                                "sense_id": "2cff41ce-a2ca-3617-a693-b2c42ca43acc",
                                "text": "„Es war eine Menage, aus Neusilber, verbogen und verrostet, aber dennoch hier auf so lächerliche Weise fehl am Platze, daß sie an einen König erinnerte, der in Lumpen gehüllt ins Exil unter Barbaren verbannt ist, und die Erhabenheit ihres früheren Ranges erwartete sogar in ihrer Erniedrigung noch Achtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69fa955d-08af-46dc-a3e7-614ee37a7d6a",
