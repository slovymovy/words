            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37838291-93f2-3aa3-9674-5908e680715e",
                    "sense_definition": "beweegbaar handvat of hefboom waarmee men een mechanisme of apparaat bedient",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "handvat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trek aan de rode <w>hendel</w> om de machine direct uit te schakelen.",
                            "target_lang_translations": {
                                "en": "Pull the red <w>lever</w> to shut down the machine immediately."
                            }
                        },
                        {
                            "text": "Door deze <w>hendel</w> naar voren te duwen, gaat het voertuig sneller rijden.",
                            "target_lang_translations": {
                                "en": "By pushing this <w>lever</w> forward, the vehicle accelerates."
                            }
                        }
                    ],
                    "synonyms": [
                        "hefboom"
                    ],
                    "common_phrases": [
                        "aan de hendel trekken",
                        "de hendel overhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "a movable handle or lever used to operate a mechanism or device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lever",
                                "target_lang_sense_clarification": "to operate a machine or mechanism"
                            },
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "movable control or operating grip"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c044f3-06ec-3609-b61f-bb9161b3f97b",
                    "sense_definition": "vast gemonteerde handgreep waaraan men iets kan vastpakken of optillen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "handvat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pak de zware kist stevig vast bij de metalen <w>hendel</w> aan de zijkant.",
                            "target_lang_translations": {
                                "en": "Grip the heavy chest firmly by the metal <w>handle</w> on the side."
                            }
                        },
                        {
                            "text": "De <w>hendel</w> van de emmer brak af toen hij te vol zat met water.",
                            "target_lang_translations": {
                                "en": "The <w>handle</w> of the bucket snapped off when it was too full of water."
                            }
                        }
                    ],
                    "synonyms": [
                        "handgreep",
                        "handvat",
                        "hengsel"
                    ],
                    "common_phrases": [
                        "een stevige hendel"
                    ],
                    "target_lang_definitions": {
                        "en": "a fixed or attached grip used for holding, carrying, or lifting something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "for carrying, lifting, or holding"
                            },
                            {
                                "target_lang_word": "grip",
                                "target_lang_sense_clarification": "part designed to be grasped"
                            }
                        ]
                    }
                }
            ]
        }
    ]
