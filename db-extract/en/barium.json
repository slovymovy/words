                                        "entry_id": "3d88e605-ed2b-3579-8bf4-2e5443f94754",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 56 et de symbole Ba qui fait partie de la série chimique des métaux alcalino-terreux."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e81729-257c-47e8-a37d-144cefce0748",
                                                "sense_id": "2bf0dfea-d90b-3243-870c-0d63353ca7ed",
                                                "text": "Les produits chimiques employés pour obtenir ce résultat sont des dissolutions aqueuses de peroxydes alcalins et alcalino-terreux; peroxyde de sodium, de potassium, de baryum, etc. …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca7409f-2ec9-31cf-97ec-d34bdecf12f3",
                                        "entry_id": "3d88e605-ed2b-3579-8bf4-2e5443f94754",
                                        "glosses": [
                                            "Métal argenté, mou et qui fond à haute température, forme métallique pure de l’élément."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e8c0a14-0f8d-421b-84aa-84bb442d12a3",
                                                "sense_id": "2ca7409f-2ec9-31cf-97ec-d34bdecf12f3",
                                                "text": "Du nitrate de soude pour le jaune... du baryum pour le vert."
                                            },
                                            {
                                                "example_id": "4b73e766-ff74-4722-a58c-ec81a2319da2",
                                                "sense_id": "2ca7409f-2ec9-31cf-97ec-d34bdecf12f3",
                                                "text": "Le baryum s’oxyde rapidement à l’air. — Le baryum décompose l’eau à température ordinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
