                        "sense_id": "358a46ef-0a6f-3e23-85d2-7e444d37a2aa",
                        "entry_id": "ff89d2ce-54b7-3728-80c7-e1b3babef8b7",
                        "glosses": [
                            "History that emphasizes the role of women, or that is told from a woman's (or from a feminist) point of view."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cf8d1068-b9c4-4b50-b98d-1007dbcf5eb0",
                                "sense_id": "358a46ef-0a6f-3e23-85d2-7e444d37a2aa",
                                "text": "\"Mama's Lullaby\" shared the growth of McCord's appreciation for her mother and a prayer that her infant son might someday \"sing this motther song with me\"; a blending of the strong herstory of women's survival with the hope that men of the future will learn to praise their own capacity for nurturance."
                            },
                            {
                                "example_id": "178f6566-6e1e-4314-b426-0a73dcb6c50e",
                                "sense_id": "358a46ef-0a6f-3e23-85d2-7e444d37a2aa",
                                "text": "For Dita Garbo, it’s an “honour” to make herstory as Drag Race UK’s oldest-ever queen. “The younger bitches need to be careful ‘cause we’ve got wisdom – and we’ve still got time!” (Kandy Ho is trembling.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a1a1714d-ddd4-3de7-93c4-89a5e0c85b26",
                        "entry_id": "ff89d2ce-54b7-3728-80c7-e1b3babef8b7",
                        "glosses": [
                            "Any historical writing by or about women."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ff5b1078-b343-375d-998c-3861939cb002",
                        "entry_id": "ff89d2ce-54b7-3728-80c7-e1b3babef8b7",
                        "glosses": [
                            "Biographical material about a woman."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "de92f11c-5e32-4ef6-88ba-07fcdadb4918",
                                "sense_id": "ff5b1078-b343-375d-998c-3861939cb002",
                                "text": "Nobody thought of it as history, herstory, my-story, your-story, or our-story."
                            }
                        ]
                    }
