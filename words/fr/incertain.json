                    "sense_id": "4c3beb1d-2450-3b73-8d65-8702269d3cba",
                    "sense_definition": "Qui n'est pas précisément fixé ou déterminé dans le temps ou l'espace.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indetermine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce manuscrit ancien a été rédigé à une époque encore <w>incertaine</w>.",
                            "target_lang_translations": {
                                "en": "This ancient manuscript was written in a period that is still <w>uncertain</w>.",
                                "ru": "Эта древняя рукопись была написана в эпоху, датировка которой до сих пор <w>неопределённа</w>.",
                                "de": "Dieses alte Manuskript wurde zu einer noch <w>unbestimmten</w> Zeit verfasst.",
                                "es": "Este antiguo manuscrito se redactó en una época todavía <w>incierta</w>.",
                                "zh": "这份古老的手稿写于一个年代仍<w>不确定</w>的时期。"
                            }
                        },
                        {
                            "text": "La date exacte de leur départ demeure <w>incertaine</w> à ce jour.",
                            "target_lang_translations": {
                                "en": "The exact date of their departure remains <w>uncertain</w> to this day.",
                                "ru": "Точная дата их отъезда до сих пор остаётся <w>неопределённой</w>.",
                                "de": "Das genaue Datum ihrer Abreise ist bis heute <w>unbestimmt</w>.",
                                "es": "La fecha exacta de su partida sigue siendo <w>incierta</w> a día de hoy.",
                                "zh": "他们出发的确切日期至今仍<w>未定</w>。"
                            }
                        }
