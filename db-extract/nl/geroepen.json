                    {
                        "sense_id": "1c8c82cb-be8b-3b56-9d75-1157e44ca236",
                        "entry_id": "bd7f6aca-65cb-3b40-8f51-269313a92c9d",
                        "glosses": [
                            "voltooid deelwoord van roepen"
