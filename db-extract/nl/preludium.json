                                    {
                                        "sense_id": "341b2a42-e775-3b2a-bc7e-a44fe22fdb99",
                                        "entry_id": "520034cc-af82-391f-96c4-d40f85ad0612",
                                        "glosses": [
                                            "ursprünglich: einleitendes Vorspiel zu einem Musikstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5c1f87-19cc-4242-961c-fc74023590d6",
                                                "sense_id": "341b2a42-e775-3b2a-bc7e-a44fe22fdb99",
                                                "text": "Ein Präludium ist ein Instrumentalwerk mit eröffnendem oder hinführendem Charakter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5bc0bdb-aac1-335d-9c30-d193e6e4c32f",
                                        "entry_id": "520034cc-af82-391f-96c4-d40f85ad0612",
                                        "glosses": [
                                            "eigene musikalische Form für Tasteninstrumente oder auch Orchester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb5283b-fbfc-4382-a891-e4b17311a700",
                                                "sense_id": "a5bc0bdb-aac1-335d-9c30-d193e6e4c32f",
                                                "text": "\"Präludium und Fuge Es-Dur\" BWV 552 ist ein Orgelwerk von Johann Sebastian Bach."
                                            },
                                            {
                                                "example_id": "5679a4e7-0738-491c-aad6-ffb601df9bb5",
                                                "sense_id": "a5bc0bdb-aac1-335d-9c30-d193e6e4c32f",
                                                "text": "„So klingt jetzt das Präludium, ein reißender Strom.“"
                                            },
                                            {
                                                "example_id": "5ae11500-4f61-4688-b782-90afe1c1de6c",
                                                "sense_id": "a5bc0bdb-aac1-335d-9c30-d193e6e4c32f",
                                                "text": "„Dank des vielen Weins und der Spirituosen störten sich die meisten Gäste auch gar nicht weiter an den Darbietungen des Hausherrn, manche flunkerten sogar, wie besonders geehrt sie sich durch die musikalischen Präludien fühlten.“"
                                            },
                                            {
                                                "example_id": "816ba431-c79c-4811-84af-94d82a51d953",
                                                "sense_id": "a5bc0bdb-aac1-335d-9c30-d193e6e4c32f",
                                                "text": "„Ich habe die Präludien und Fugen in C-Dur, C-moll, D-Dur und D-moll gespielt, da aber ist Papa in den kleinen Saal gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6f99f66-57b3-4db8-b3b8-71b8e022d8e2",
                        "source_entry_id": "29d8fc8d-50d5-3a7c-b5e5-d237ae754b97",
                        "source_sense_id": "62ff7ad2-5007-30b5-a4f1-dd08c467f8ce",
                        "source_sense_description": "een fantasiestuk of een muzikale introductie tot een muziekstuk",
                        "target_lang_word": "Vorspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4896c9d1-144c-33e3-81b5-36188b9f20b2",
                                        "entry_id": "0c8b7817-ec85-3ef4-b735-988175fe6a9e",
                                        "glosses": [
                                            "vor anderen etwas (zum Beispiel auf einem Instrument oder eine Szene) spielen, um sein Können beurteilen zu lassen"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Schauspiel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f153d8fc-274e-41a0-a476-8dd3a48ad672",
                                                "sense_id": "4896c9d1-144c-33e3-81b5-36188b9f20b2",
                                                "text": "In der Adventszeit gibt es immer ein Vorspiel der Klavierklasse im kleinen Saal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e802932-e8aa-3dfa-859f-29c870d5ba92",
                                        "entry_id": "0c8b7817-ec85-3ef4-b735-988175fe6a9e",
                                        "glosses": [
                                            "das, was vor dem Wesentlichen kommt; das, was den Weg zur Hauptsache vorbereitet"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec2ed0f-9fb2-4ce2-8237-3f3ec600ecf9",
                                                "sense_id": "9e802932-e8aa-3dfa-859f-29c870d5ba92",
                                                "text": "Die gegenseitigen Beschimpfungen waren nur das Vorspiel der Wirtshausschlägerei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afb12493-7d76-3685-89ca-d7257ce42592",
                                        "entry_id": "0c8b7817-ec85-3ef4-b735-988175fe6a9e",
                                        "glosses": [
                                            "(meist kurzes) Einleitungsstück"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588ee0a0-0bb2-4d54-a649-3adb323feeea",
                                                "sense_id": "afb12493-7d76-3685-89ca-d7257ce42592",
                                                "text": "„Die fünf Teile des Vorspiels zeigen Bewohner in fünf Wohnungen des Hauses, wo stets wenigstens eine Person Pläne schmiedet, um in den Besitz dieses Hauses in der ironisch genannten »Gütigkeitsstraße« zu kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e2ed029e-cabd-3fe5-9b6f-5c24345a4096",
                                        "entry_id": "0c8b7817-ec85-3ef4-b735-988175fe6a9e",
                                        "glosses": [
                                            "Austausch von Zärtlichkeiten vor dem Geschlechtsverkehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aae44ff-3016-4204-9e71-297737f0da67",
                                                "sense_id": "e2ed029e-cabd-3fe5-9b6f-5c24345a4096",
                                                "text": "Angeblich genießen besonders Frauen ein langes Vorspiel."
                                            },
                                            {
                                                "example_id": "fe095324-8e2e-4b42-a18d-7edb741d0673",
                                                "sense_id": "e2ed029e-cabd-3fe5-9b6f-5c24345a4096",
                                                "text": "„Der wahre Verführer beginnt das Vorspiel am Herd.“"
                                            },
                                            {
                                                "example_id": "605ebfad-7a9a-4d7f-b76a-ac3024e8e3d8",
                                                "sense_id": "e2ed029e-cabd-3fe5-9b6f-5c24345a4096",
                                                "text": "„Nach einem angemessenen Vorspiel fand ich sie bis zu einem gewissen Punkt zugänglich; sie sträubte sich aber energisch, sobald ich tat, als wollte ich ihr volle Gerechtigkeit widerfahren lassen.“"
                                            },
                                            {
                                                "example_id": "1fdd2e7b-0ae1-4d10-9a2a-2381babfa425",
                                                "sense_id": "e2ed029e-cabd-3fe5-9b6f-5c24345a4096",
                                                "text": "„Er, Bundschuh, würde mit seiner Frau ein Vorspiel machen, aber er sei auch ein alter Hase, er hätte sich vor seiner Ehe, auf dem Bodensee, ausgetobt, das sei seiner Ehe gut bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "19449bf8-09dc-3f1c-8e8c-f2b4615a28ed",
                                        "entry_id": "0c8b7817-ec85-3ef4-b735-988175fe6a9e",
                                        "glosses": [
                                            "ein vor einem Sportereignis stattfindendes Spiel oder Ereignis von untergeordneter Bedeutung, zum Beispiel ein Spiel von Jugendmannschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc9503f-7793-4226-80cc-86ff2b7d4e5b",
                                                "sense_id": "19449bf8-09dc-3f1c-8e8c-f2b4615a28ed",
                                                "text": "Bereits beim Vorspiel war die Fußballarena gut gefüllt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
