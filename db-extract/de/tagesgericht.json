                                                "text": "Singapore Special;  Darwin special"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4047ea31-8a82-313d-a633-bdddb301d9b0",
                                        "entry_id": "36efd8c6-a182-3388-810d-deda77a54147",
                                        "glosses": [
                                            "A racehorse predicted to win; a sure thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48faa1ce-539f-43dd-bde7-38d8fc7654e1",
                                                "sense_id": "4047ea31-8a82-313d-a633-bdddb301d9b0",
                                                "text": "\"How's your horse going to go Fatty?\" My replies included, \"It's a special.\" \"Get on. It can't be beaten.\""
                                            }
