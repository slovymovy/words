                "senses": [
                    {
                        "sense_id": "211fa65e-845e-3132-b02e-6129e0fee783",
                        "entry_id": "5f49e72c-f99a-380a-bdf3-bc55c487d690",
                        "glosses": [
                            "Faire perdre son caractère de théâtre de boulevard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c90f48-c123-4bdf-8ca6-11b9fbbf21f8",
                                "sense_id": "211fa65e-845e-3132-b02e-6129e0fee783",
                                "text": "Parce qu’il a su, dans ce sens, donner un contenu nouveau au théâtre, formellement de boulevard, Soria le « déboulevardise » et le fait ainsi avancer."
                            },
                            {
                                "example_id": "6aa3153a-0572-402c-a957-29f9e69e3c1f",
                                "sense_id": "211fa65e-845e-3132-b02e-6129e0fee783",
                                "text": "Encore faut-il ne pas fuir le système dramatique marivaudien. Jusqu’ici, la volonté de « déboulevardiser » ce théâtre, aussi légitime soit-elle, a peut-être eu pour effet de le rigidifier."
                            }
                        ]
                    }
                ],
