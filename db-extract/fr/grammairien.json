                                        "glosses": [
                                            "A person who studies grammar, either scientifically or (traditionally) unscientifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b633d818-bd93-41a5-988b-745587dd35ba",
                                                "sense_id": "3b4ef5c0-d010-333b-9166-39c6724f79ab",
                                                "text": "Huddleston and Pullum are well-known grammarians of the 21st century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8f3902-0fae-3178-97ef-2f1da14bd5c8",
                                        "entry_id": "9fe033eb-89b4-3e81-a911-0cde3e388e35",
                                        "glosses": [
                                            "A person who pedantically critiques the grammar of others' speech or writing, especially when unscientifically and misguidedly."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
