                        "glosses": [
                            "Qui peut, qui doit être poursuivi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34dbdfdb-f88a-423c-b667-ff0d70b918d9",
                                "sense_id": "4f9ce04f-782e-3839-92bc-0711dec75391",
                                "text": "Ils seront poursuivables par toutes sortes d’offenses et molestes."
                            },
                            {
                                "example_id": "a8e3fc15-adc9-4dd2-811f-2b0275689b37",
                                "sense_id": "4f9ce04f-782e-3839-92bc-0711dec75391",
                                "text": "En d’autres terme, François [X...] n’est pas poursuivable et condamnable par l’autorité judiciaire pour les actes dont on estime qu’ils sont faits en tant Président de l’assemblée nationale dans le cadre de cette fonction, même en cas de levée d’immunité."
                            },
                            {
                                "example_id": "42bc15a0-f8d7-4496-a0c1-62dd1a3c23dd",
                                "sense_id": "4f9ce04f-782e-3839-92bc-0711dec75391",
                                "text": "La convention judiciaire n’est pas à une condamnation, il s’agit d’un accord entre l’autorité judiciaire et la société en question qui n’est plus poursuivable au terme de la convention."
                            }
                        ]
                    }
