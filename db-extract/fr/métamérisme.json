                            {
                                "example_id": "e0bcc04c-21f7-463d-ad79-e6dce56bb67b",
                                "sense_id": "cbf9d149-6c90-39c5-9105-a7764c644d2d",
                                "text": "Le fait que toute l’information lumineuse et spectrale soit réduite à trois signaux explique le phénomène de métamérisme, suspecté depuis le XIXᵉ siècle."
                            },
                            {
                                "example_id": "5ec23ecb-f224-4bfe-abd3-1f60751c80b2",
                                "sense_id": "cbf9d149-6c90-39c5-9105-a7764c644d2d",
                                "text": "Les stimuli de couleurs métamères sont des rayonnements de composition spectrale différente produisant la même couleur dans les mêmes conditions de vision : La propriété correspondante est appelée métamérisme."
                            }
                        ]
                    }
