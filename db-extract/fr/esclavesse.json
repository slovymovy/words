                "senses": [
                    {
                        "sense_id": "9c268a98-e7b5-3bc9-bc6a-a72bdd7e9022",
                        "entry_id": "31156b0e-1a74-3e0a-8280-789f4ece67e4",
                        "glosses": [
                            "Celle qui est privée de sa liberté."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "621058a1-eb9a-4c4c-a9ad-bf32c65d2d25",
                                "sense_id": "9c268a98-e7b5-3bc9-bc6a-a72bdd7e9022",
                                "text": "Et n’a-t-elle point quelque esclavesse ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9107e60c-0023-4bc8-8318-e23e86774405",
                        "source_entry_id": "31156b0e-1a74-3e0a-8280-789f4ece67e4",
                        "source_sense_id": "9c268a98-e7b5-3bc9-bc6a-a72bdd7e9022",
                        "target_lang_word": "Sklavin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sklavin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3ef55d-62ff-3d07-ba86-98db3d44969f",
                                        "entry_id": "afdf2283-0e6c-3724-accc-64a7b8f8a3de",
                                        "glosses": [
                                            "weibliche Person, die als Sache im Eigentum eines anderen Menschen steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f98aa30-385f-49f5-9b9e-8534b0fedbc2",
                                                "sense_id": "4a3ef55d-62ff-3d07-ba86-98db3d44969f",
                                                "text": "„Sie wollte sich nie mit ihrem Los als Sklavin abfinden.“"
                                            },
                                            {
                                                "example_id": "5e6d521d-dc41-421e-8954-569987148cf5",
                                                "sense_id": "4a3ef55d-62ff-3d07-ba86-98db3d44969f",
                                                "text": "„Sie lösten die Fesseln einer Sklavin und befahlen ihr emporzuklettern.“"
                                            },
                                            {
                                                "example_id": "f247e6f2-d742-4543-9967-e6862abb8bb9",
                                                "sense_id": "4a3ef55d-62ff-3d07-ba86-98db3d44969f",
                                                "text": "„Die meisten Sklavinnen haben aber weniger Glück und wechseln für einen durchschnittlichen Preis von 200 Gramm Silber den Besitzer.“"
                                            },
                                            {
                                                "example_id": "b57d808e-be96-4e68-94cd-e31144c28b15",
                                                "sense_id": "4a3ef55d-62ff-3d07-ba86-98db3d44969f",
                                                "text": "„Die Läden mit Seidenstoffen und die Läden mit Schmuck sind auch der Treffpunkt der Haremsdamen mit ihren Sklavinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "baf6534d-3347-4301-9673-d1e7fecaffd0",
                        "source_entry_id": "31156b0e-1a74-3e0a-8280-789f4ece67e4",
                        "source_sense_id": "9c268a98-e7b5-3bc9-bc6a-a72bdd7e9022",
                        "target_lang_word": "slavess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slavess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1631dc2f-0a5f-37c7-8aac-ed3ead2720d1",
                                        "entry_id": "a2fd724d-6903-3952-b8a2-0f3ca5f753e1",
                                        "glosses": [
                                            "female slave"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9e580d-3dc2-410e-b5f2-c2b0e507cb04",
                                                "sense_id": "1631dc2f-0a5f-37c7-8aac-ed3ead2720d1",
                                                "text": "Should a Moor marry his slavess, which is a common practice here, the latter is free from the moment of such marriage, and her offspring likewise."
                                            },
                                            {
                                                "example_id": "ad1fa179-3e54-4828-b756-e6c079b5e314",
                                                "sense_id": "1631dc2f-0a5f-37c7-8aac-ed3ead2720d1",
                                                "text": "But now you have turned and polluted My Name, and everyone seizes his male or female slave, whom you had released into freedom, to pollute and degrade them to be your slaves and slavesses."
                                            },
                                            {
                                                "example_id": "5e44eedb-3083-434a-967a-c1811becf536",
                                                "sense_id": "1631dc2f-0a5f-37c7-8aac-ed3ead2720d1",
                                                "text": "I come home from working to support you and all the other slavesses that I have."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
