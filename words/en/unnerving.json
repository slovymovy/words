{
    "word_family": [
        "nerve",
        "nervous",
        "nervously",
        "nervousness",
        "unnerve"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f980b97-a3cc-337c-ae9a-370386898f9c",
                    "sense_definition": "Causing someone to feel worried, anxious, or lose their confidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>unnerving</w> silence in the empty house made me feel very uneasy.",
                            "target_lang_translations": {
                                "tr": "Boş evdeki <w>ürkütücü</w> sessizlik kendimi çok huzursuz hissetmeme neden oldu.",
                                "pl": "<w>Niepokojąca</w> cisza w pustym domu sprawiła, że poczułem się bardzo nieswojo."
                            }
                        },
                        {
                            "text": "It was an <w>unnerving</w> experience to walk home alone through the dark park.",
                            "target_lang_translations": {
                                "tr": "Karanlık parktan tek başına eve yürümek <w>tedirgin edici</w> bir deneyimdi.",
                                "pl": "Samotny powrót do domu przez ciemny park był <w>deprymującym</w> doświadczeniem."
                            }
                        }
                    ],
                    "synonyms": [
                        "disconcerting",
                        "unsettling",
                        "disturbing",
                        "daunting"
                    ],
                    "antonyms": [
                        "comforting",
                        "reassuring"
                    ],
                    "common_phrases": [
                        "unnerving silence",
                        "unnerving experience"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin endişeli, huzursuz hissetmesine veya kendine olan güvenini kaybetmesine neden olan.",
                        "pl": "Powodujący, że ktoś czuje się zaniepokojony, pełen obaw lub traci pewność siebie."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ürkütücü",
                                "target_lang_sense_clarification": "Korku veya tedirginlik veren durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "tedirgin edici",
                                "target_lang_sense_clarification": "Huzursuzluk veren veya rahatsız eden durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "sinir bozucu",
                                "target_lang_sense_clarification": "Kişinin moralini bozan veya gerginlik yaratan durumlar için kullanılır."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokojący",
                                "target_lang_sense_clarification": "Ogólne określenie na coś, co wywołuje lęk lub niepokój."
                            },
                            {
                                "target_lang_word": "deprymujący",
                                "target_lang_sense_clarification": "Sytuacja, która odbiera pewność siebie lub wprawia w zakłopotanie."
                            },
                            {
                                "target_lang_word": "stresujący",
                                "target_lang_sense_clarification": "Coś, co wywołuje napięcie nerwowe."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df8304af-36cc-3ef1-8d58-b4eb4847396e",
                    "sense_definition": "The present participle and gerund of <w>unnerve</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>unnerving</w> his opponent by staring at him during the entire match.",
                            "target_lang_translations": {
                                "tr": "Maç boyunca rakibine dik dik bakarak onu <w>tedirgin ediyor</w>.",
                                "pl": "<w>Deprymuje</w> swojego przeciwnika, wpatrując się w niego przez cały mecz."
                            }
                        },
                        {
                            "text": "The constant noise is <w>unnerving</w> everyone in the office today.",
                            "target_lang_translations": {
                                "tr": "Sürekli gelen gürültü bugün ofisteki herkesin <w>sinirini bozuyor</w>.",
                                "pl": "Ciągły hałas <w>niepokoi</w> dziś wszystkich w biurze."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin cesaretini kırmak, huzursuz etmek veya kendine olan güvenini sarsmak.",
                        "pl": "Imiesłów czasu teraźniejszego czasownika 'unnerve', oznaczający pozbawianie kogoś spokoju, pewności siebie lub wprawianie w zdenerwowanie."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tedirgin etmek",
                                "target_lang_sense_clarification": "Birini huzursuz bir duruma sokmak."
                            },
                            {
                                "target_lang_word": "cesaretini kırmak",
                                "target_lang_sense_clarification": "Birinin özgüvenini sarsmak."
                            },
                            {
                                "target_lang_word": "sinirini bozmak",
                                "target_lang_sense_clarification": "Birini gerginleştirmek."
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokojąc",
                                "target_lang_sense_clarification": "Wprowadzając kogoś w stan niepokoju."
                            },
                            {
                                "target_lang_word": "deprymując",
                                "target_lang_sense_clarification": "Odbierając komuś pewność siebie."
                            },
                            {
                                "target_lang_word": "denerwując",
                                "target_lang_sense_clarification": "Wprawiając kogoś w stan zdenerwowania."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}