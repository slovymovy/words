                        "glosses": [
                            "Autre orthographe, moins courante, de schlinguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2485184c-872f-4420-9a6c-50d403095f2d",
                                "sense_id": "9233cbb6-dd49-3fb5-9b48-70e92058dad5",
                                "text": "Ça schelingue un bateau quand même, pas vrai ?"
                            },
                            {
                                "example_id": "30a2026a-53de-466d-8553-75daf9b0c92a",
                                "sense_id": "9233cbb6-dd49-3fb5-9b48-70e92058dad5",
                                "text": "Vers deux heures du matin, ça schelingue au Macumba."
                            },
                            {
                                "example_id": "c4d872eb-702a-4373-8b9d-63ef957039cb",
                                "sense_id": "9233cbb6-dd49-3fb5-9b48-70e92058dad5",
                                "text": "De faire attention, car des oiseaux justiciers peuvent venir fourrer leur bec dans la merde qu'il crée tous les jours et dire au monde à quel point ça schelingue."
                            }
                        ]
                    }
