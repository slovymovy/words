{
    "word_family": [
        "commencement",
        "recommence"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd44ef66-71b1-3c00-9c0c-3e7ff165d565",
                    "sense_definition": "To begin or start something, often used in formal or official contexts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official ceremony will <w>commence</w> at exactly ten o'clock in the morning.",
                            "target_lang_translations": {
                                "ru": "Официальная церемония <w>начнется</w> ровно в десять часов утра."
                            }
                        },
                        {
                            "text": "The legal team is ready to <w>commence</w> proceedings against the corporation immediately.",
                            "target_lang_translations": {
                                "ru": "Юридическая группа готова немедленно <w>возбудить</w> дело против корпорации."
                            }
                        }
                    ],
                    "synonyms": [
                        "begin"
                    ],
                    "antonyms": [
                        "stop",
                        "end",
                        "cease",
                        "finish",
                        "conclude",
                        "complete"
                    ],
                    "common_phrases": [
                        "commence proceedings",
                        "commence operations",
                        "commence work",
                        "ready to commence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать или запускать что-либо, часто используется в официальном или формальном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинать",
                                "target_lang_sense_clarification": "приступать к действию"
                            },
                            {
                                "target_lang_word": "начинаться",
                                "target_lang_sense_clarification": "о событиях или процессах"
                            },
                            {
                                "target_lang_word": "приступать",
                                "target_lang_sense_clarification": "к официальным процедурам или работе"
                            },
                            {
                                "target_lang_word": "возбуждать",
                                "target_lang_sense_clarification": "о судебном производстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cbddccc-8ca1-3606-aee0-3828f494c386",
                    "sense_definition": "To begin to be or to act in a specific role or capacity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "role-start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of study, he finally <w>commenced</w> author with the publication of his first novel.",
                            "target_lang_translations": {
                                "ru": "После многих лет учебы он наконец <w>стал</w> автором, опубликовав свой первый роман."
                            }
                        },
                        {
                            "text": "Having received his commission, the young man <w>commenced</w> soldier in the king's army.",
                            "target_lang_translations": {
                                "ru": "Получив назначение, молодой человек <w>стал</w> солдатом в королевской армии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "commence author",
                        "commence soldier"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary or older usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать выступать или действовать в определенной роли или качестве (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стать",
                                "target_lang_sense_clarification": "начать деятельность в качестве кого-либо"
                            },
                            {
                                "target_lang_word": "сделаться",
                                "target_lang_sense_clarification": "принять на себя роль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01fdebbb-9f37-30df-bcb6-612c8ba4caff",
                    "sense_definition": "To take or receive an academic degree at a university.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He studied diligently at Cambridge and <w>commenced</w> Master of Arts in the year 1592.",
                            "target_lang_translations": {
                                "ru": "Он прилежно учился в Кембридже и <w>получил степень</w> магистра искусств в 1592 году."
                            }
                        },
                        {
                            "text": "Records show that several students <w>commenced</w> doctors of divinity during that particular term.",
                            "target_lang_translations": {
                                "ru": "Записи показывают, что в течение того семестра несколько студентов <w>удостоились звания</w> докторов богословия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "commence Master of Arts"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical academic terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать ученую степень в университете (архаичный термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получить степень",
                                "target_lang_sense_clarification": "об академической квалификации"
                            },
                            {
                                "target_lang_word": "удостоиться звания",
                                "target_lang_sense_clarification": "в историческом контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}