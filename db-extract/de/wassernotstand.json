                "senses": [
                    {
                        "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                        "entry_id": "ade38009-ad1b-3640-baf5-ca51641154ef",
                        "glosses": [
                            "Wasserknappheit; kritischer Zustand bei der Versorgung der Bevölkerung und der Landwirtschaft mit sauberem Trinkwasser/Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76cc027a-d664-445f-a44f-c175de65f01f",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[Schlagzeile:] „Wassernotstand in Deutschland“"
                            },
                            {
                                "example_id": "e30ed4e1-ae82-41d2-9981-d2e020e6bead",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[Trockenheit in Südeuropa 2022:] „Wassernotstand herrscht bereits jetzt schon in etwa 125 Gemeinden in den beiden Regionen.“"
                            },
                            {
                                "example_id": "15dc10b5-f18e-4c30-87dc-de712d80fee2",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[2012:] „In Südengland herrscht Wassernotstand. 17 Grafschaften in den Midlands und im Südwesten wurden zu Dürrezonen erklärt.“"
                            },
                            {
                                "example_id": "e84727bd-b163-4945-a48c-05de19ef023c",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "„2014 rief Gouverneur Brown den Wassernotstand aus.“"
                            },
                            {
                                "example_id": "14718edc-fc0c-4f7e-9997-191eb35146a8",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "„Bereits in den vergangenen beiden Sommern riefen einzelne Gemeinden einen Wassernotstand aus.“"
                            },
                            {
                                "example_id": "7a82d132-07b8-4ea8-b558-9ff38cf065e0",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "„Hier wurde die Wasserknappheit so schlimm, dass die Regierung den \"Wassernotstand\" ausrief und jedem Einwohner nur 50 Liter Wasser pro Tag zugestand.“"
                            },
                            {
                                "example_id": "76231645-01ff-4465-8725-21140043ca57",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[2022: Auch um einen kompletten Ernteausfall] „zu verhindern und eine bevorzugte Versorgung der Landwirtschaft sicherzustellen, wollen jetzt die Präsidenten der Regionen Piemont und Lombardei den Wassernotstand ausrufen.“"
                            },
                            {
                                "example_id": "d42cd74d-5e9f-4b79-bed2-6ef1f6ebf696",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[2021:] „Die Regierung in Buenos Aires hat den Wassernotstand über die sieben Provinzen verhängt, die der Paraná in Argentinien auf seinem Weg zum Río de la Plata durchfließt. Denn immer kritischer wird auch die Lage der lokalen Trinkwasserversorgung.“"
                            },
                            {
                                "example_id": "c3b92088-8ad6-42fb-aa6c-0bbbd678cc8b",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[Chile:] „Um Copiapó herum haben die steigenden Kupferpreise den Wassernotstand verschärft.“"
                            },
                            {
                                "example_id": "b61b161b-7a2f-4563-8ce5-5013e1fc66ce",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[Iran:] „Seit dem Amtsantritt von Präsident Hassan Ruhani 2013 ist der Wassernotstand zum ersten Mal Chefsache.“"
                            },
                            {
                                "example_id": "e4f28c10-50d2-444a-90d3-d42c0e4335cf",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "[2010:] „Viel Zeit hat Pakistan nicht mehr, fürchten die Experten, dem drohenden Wassernotstand zu entgehen."
                            },
                            {
                                "example_id": "1fefe271-5460-4712-8d68-6b71329621e3",
                                "sense_id": "c2ef6cb9-8b28-340f-8cff-ccc66129c113",
                                "text": "„»Jeder Einzelne, aber auch Wirtschaft und die Politik müssen jetzt handeln, damit keine Wassernotstände entstehen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ef13a14-4d60-38dc-a0a4-6183de6e6f14",
                        "entry_id": "ade38009-ad1b-3640-baf5-ca51641154ef",
                        "glosses": [
                            "kritischer Zustand durch zuviel Wasser, beispielsweise infolge Hochwasser, Überflutungen, brechenden Dämmen oder Rohrbrüchen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "a05ba15a-0fbe-43ac-b974-d802266e86fd",
                                "sense_id": "4ef13a14-4d60-38dc-a0a4-6183de6e6f14",
                                "text": "„Zu Wassernotständen rückt die Feuerwehr in der Regel mit der gleichen Eile aus, wie zu Bränden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
