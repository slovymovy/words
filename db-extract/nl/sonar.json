                        "tags": [
                            "plural"
                        ],
                        "form": "sonars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe1e25bb-336d-3b28-a525-d8c03de36570",
                        "entry_id": "e05e6389-f719-308e-89ac-5aa9410a95a3",
                        "glosses": [
                            "techniek om de plaats van objecten onder water vast te stellen met behulp van teruggekaatst ultrasoon geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c81e406-a18d-4918-ac5b-b641bb69783e",
                                "sense_id": "fe1e25bb-336d-3b28-a525-d8c03de36570",
                                "text": "De uitschuring daar, die voorlopig volgens de vooraf gemaakte berekeningen verloopt, wordt eveneens met sonar en met dieptepeilingen in de gaten gehouden."
                            },
                            {
                                "example_id": "0e3458d6-1624-450e-92a8-5d0db4ade03f",
                                "sense_id": "fe1e25bb-336d-3b28-a525-d8c03de36570",
                                "text": "Sonar, de duibootzoekinstallatie [sic!], is tot op honderd meter diepte betrouwbaar, maar de duikboten van het type XXVI varen tot op twééhonderd nieter diepte."
                            }
                        ]
                    },
                    {
                        "sense_id": "fffc1347-5eb6-38d2-a57f-16671fd0b140",
                        "entry_id": "e05e6389-f719-308e-89ac-5aa9410a95a3",
                        "glosses": [
                            "apparaat waarmee ultrasoon geluid wordt opgevangen om de plaats van objecten onder water vast te stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5485c5f4-a267-4d26-9b46-cd5e46fe4a2e",
                                "sense_id": "fffc1347-5eb6-38d2-a57f-16671fd0b140",
                                "text": "Ik was commandant van de Zeehond. De uitschuifbare sonar stak twee meter uit. We voeren te dicht bij de wal. Ik keek door de periscoop en voelde een lichte trilling: de sonar brak af."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6179940-538e-3fdd-a2a3-7bfc2c7d4295",
                        "entry_id": "e05e6389-f719-308e-89ac-5aa9410a95a3",
                        "glosses": [
                            "wijze waarop dieren de plaats van objecten vaststellen met teruggekaatst ultrasoon geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02c76d4-11c5-4c54-bf21-2a6a633cc29e",
                                "sense_id": "a6179940-538e-3fdd-a2a3-7bfc2c7d4295",
                                "text": "Vooropgesteld dat potvissen hun sonar gebruiken tijdens het navigeren, wat wel wordt aangenomen maar nog niet is bewezen, is een andere mogelijke verklaring dat die sonar in ondiep water van slag raakt."
                            }
                        ]
                    }
                ],
