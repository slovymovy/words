            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae4f5791-3e72-3df6-85fc-0c3991e2df64",
                    "sense_definition": "Großes Kraftfahrzeug zur Beförderung von mehreren Fahrgästen im öffentlichen oder privaten Personenverkehr.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe heute Morgen leider den <w>Bus</w> verpasst."
                        },
                        {
                            "text": "Wir müssen an der Haltestelle zehn Minuten auf den nächsten <w>Bus</w> warten."
                        }
                    ],
                    "synonyms": [
                        "Autobus",
                        "Omnibus"
                    ],
                    "common_phrases": [
                        "den Bus verpassen",
                        "den Bus nehmen",
                        "mit dem Bus fahren"
                    ]
                },
                {
                    "sense_id": "c726531f-8523-3628-8396-cf02d09d7e47",
                    "sense_definition": "Elektrisch angetriebenes Straßenfahrzeug zur Personenbeförderung, das über eine Oberleitung mit Strom versorgt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In einigen Städten fährt ein elektrischer <w>Bus</w> mit Stangen an der Oberleitung."
                        },
                        {
                            "text": "Dieser moderne <w>Bus</w> wird über ein Leitungsnetz mitten auf der Straße mit Strom versorgt."
                        }
                    ],
                    "synonyms": [
                        "Oberleitungsbus",
                        "Obus",
                        "Trolleybus"
                    ]
                },
                {
                    "sense_id": "eab9032a-90af-3510-a04b-e2daf1eb5515",
                    "sense_definition": "System von Leitungen und Schnittstellen zur Übertragung von Daten oder Steuersignalen zwischen Komponenten eines Rechners.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "computer_hardware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der interne <w>Bus</w> verbindet den Prozessor direkt mit dem Arbeitsspeicher."
                        },
                        {
                            "text": "Moderne Computer besitzen mehrere <w>Busse</w> mit unterschiedlichen Übertragungsraten."
                        }
                    ],
                    "synonyms": [
                        "Datenbus"
                    ]
                },
                {
                    "sense_id": "18053a80-007c-3e4f-9461-0c504ef2bdd7",
                    "sense_definition": "Vielsitziges Fahrzeug zur Personenbeförderung, mit weiblichem Genus gebraucht.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Da kommt die <w>Bus</w>, auf die wir schon seit einer halben Stunde warten."
                        },
                        {
                            "text": "Im lokalen Sprachgebrauch sagen die Leute oft 'die <w>Bus</w>' statt 'der Bus'."
                        }
                    ],
                    "synonyms": [
                        "Autobus",
                        "Omnibus"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Südafrika (KwaZulu-Natal)"
                        }
                    ]
                },
                {
                    "sense_id": "6e5ca065-8542-385c-856e-68f18dfa742a",
                    "sense_definition": "Männliche homosexuelle Person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historischen Texten des zwanzigsten Jahrhunderts taucht das Wort <w>Bus</w> gelegentlich als abwertende Bezeichnung auf."
                        },
                        {
                            "text": "Die Sprachforschung untersuchte ältere Schimpfwörter und fand heraus, dass man damals einen Homosexuellen manchmal als <w>Bus</w> bezeichnete."
                        }
                    ],
                    "synonyms": [
                        "Homosexueller",
                        "Schwuler"
                    ],
                    "antonyms": [
                        "Hetero"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historische abwertende Bezeichnung"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Österreich"
                        }
                    ]
                }
            ]
        }
