                        "examples": [
                            {
                                "example_id": "8075880a-d0af-4432-84a4-2426fd379608",
                                "sense_id": "f3b9098c-2659-3f09-ae16-85dfba7f58c2",
                                "text": "„Als der Vater von Peter Buyer 1959 seinen landwirtschaftlichen Betrieb in Botenheim erweiterte und sich 200 Hühner zulegte, wurden die Eier bei ihm auf dem Hof verkauft.“"
                            },
                            {
                                "example_id": "1586cd0f-a2a5-4988-a83e-87cab4bf5ede",
                                "sense_id": "f3b9098c-2659-3f09-ae16-85dfba7f58c2",
                                "text": "„Dennis Buyer und Simon Heege von der Bürger Holzbau in Bönnigheim etwa haben einen Holzbalken mitgebracht, in den die Schüler unter Aufsicht einen Nagel reinschlagen dürfen – eben so wie ein echter Zimmerer.“"
                            }
                        ],
