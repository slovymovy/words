                                        "entry_id": "7f941de8-4fcc-35fc-bec0-7179911ea332",
                                        "glosses": [
                                            "A hooded chaise; any similar horse-drawn vehicle with no definite name."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1253f9-ecca-451a-8d22-59420f0fd0d0",
                                                "sense_id": "abfdbfb4-762c-3816-97fd-629558ed08f9",
                                                "text": "The odd-man gardener has brought the Rectory shandrydan round to the front door — it was a long elongated open vehicle drawn by a mild old mare named Lucy."
                                            }
                                        ]
                                    },
                                    {
