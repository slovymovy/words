                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плю́хнуться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75487cf8-07c7-3b5e-8c5e-14d1055a4e1f",
                                        "entry_id": "2990b35e-7413-3198-9e22-76471575d6e4",
                                        "glosses": [
                                            "разг. однокр. к плюхаться; упасть с шумом (обычно во что-либо жидкое); шлёпнуться"
                                        ],
                                        "tags": [
                                            "semelefactive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1719d001-dd13-4563-a9ec-8f8d86add62d",
                                                "sense_id": "75487cf8-07c7-3b5e-8c5e-14d1055a4e1f",
                                                "text": "Снаряд плюхнулся почти у самого борта 148 парохода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb0d33c4-a15e-3c31-a3ea-58a8e33827b0",
                                        "entry_id": "2990b35e-7413-3198-9e22-76471575d6e4",
                                        "glosses": [
                                            "разг. быстро или неловко, грузно сесть, лечь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f87311b-5c18-4ce6-95d6-0cb0c0c4efa6",
                                                "sense_id": "fb0d33c4-a15e-3c31-a3ea-58a8e33827b0",
                                                "text": "Капитан, как подрубленный, плюхнулся на стул."
                                            },
                                            {
                                                "example_id": "994e2521-0695-405a-b7d1-66bc4dc6883d",
                                                "sense_id": "fb0d33c4-a15e-3c31-a3ea-58a8e33827b0",
                                                "text": "― послышалась команда Кузьмы, и невод, подхваченный дружным усилием, плюхнулся на береговой откос."
                                            },
                                            {
                                                "example_id": "6042558b-fbe6-48b3-a0d2-d7f8f46059e7",
                                                "sense_id": "fb0d33c4-a15e-3c31-a3ea-58a8e33827b0",
                                                "text": "― Может, завтра будет в Посаде, коли выехала в тот самый день, как назначила себе. ― И вдруг здесь плюхнется гостить! ― вырвалось у Серафимы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
