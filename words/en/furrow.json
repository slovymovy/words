{
    "word_family": [
        "furrowing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                    "sense_definition": "A long narrow trench made in the ground by a plow for planting seeds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trench",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer dug a deep <w>furrow</w> in the field to prepare for planting.",
                            "target_lang_translations": {
                                "tr": "Çiftçi, ekime hazırlık yapmak için tarlada derin bir <w>karık</w> açtı."
                            }
                        },
                        {
                            "text": "Heavy rain washed away the soil from the <w>furrow</w>.",
                            "target_lang_translations": {
                                "tr": "Şiddetli yağmur, <w>karıktaki</w> toprağı alıp götürdü."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plow a furrow"
                    ],
                    "target_lang_definitions": {
                        "tr": "Toprağın sürülmesiyle oluşan uzun, dar hendek veya kanal."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karık",
                                "target_lang_sense_clarification": "Tarımda tohum ekmek için açılan hendek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "427d9365-d559-3bca-960c-6b6a951aa040",
                    "sense_definition": "A long narrow groove or channel in a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trench",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy wheels left a deep <w>furrow</w> in the soft mud.",
                            "target_lang_translations": {
                                "tr": "Ağır tekerlekler yumuşak çamurda derin bir <w>oluk</w> bıraktı."
                            }
                        },
                        {
                            "text": "The metal tool left a permanent <w>furrow</w> along the wooden plank.",
                            "target_lang_translations": {
                                "tr": "Metal alet, tahta kalas boyunca kalıcı bir <w>çizgi</w> bıraktı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yüzey üzerinde oluşan uzun, dar oyuk veya kanal."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "oluk",
                                "target_lang_sense_clarification": "Yüzeyde oluşan derin kanal veya iz."
                            },
                            {
                                "target_lang_word": "çizgi",
                                "target_lang_sense_clarification": "Yüzeyde oluşan iz veya hat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bcffa7b-890c-3ebc-94d1-4c4363f24082",
                    "sense_definition": "A deep line or wrinkle in the skin of the face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A deep <w>furrow</w> appeared on his forehead as he concentrated.",
                            "target_lang_translations": {
                                "tr": "Konsantre olurken alnında derin bir <w>kırışıklık</w> belirdi."
                            }
                        },
                        {
                            "text": "Years of worry had left a permanent <w>furrow</w> between her eyes.",
                            "target_lang_translations": {
                                "tr": "Yılların endişesi, gözlerinin arasında kalıcı bir <w>çizgi</w> bırakmıştı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüz derisinde oluşan derin çizgi veya kıvrım."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kırışıklık",
                                "target_lang_sense_clarification": "Yaşlılık veya ifade nedeniyle yüzde oluşan derin iz."
                            },
                            {
                                "target_lang_word": "çizgi",
                                "target_lang_sense_clarification": "Yüz hatlarında beliren derin ifade çizgisi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf2abce6-a228-34cf-a6f5-b169651bbcbf",
                    "sense_definition": "To pull one's eyebrows together to show worry or concentration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>furrowed</w> her brows while trying to solve the difficult puzzle.",
                            "target_lang_translations": {
                                "tr": "Zor bulmacayı çözmeye çalışırken <w>kaşlarını çattı</w>."
                            }
                        },
                        {
                            "text": "He <w>furrowed</w> his brow in confusion when he heard the news.",
                            "target_lang_translations": {
                                "tr": "Haberi duyduğunda şaşkınlıkla <w>kaşlarını çattı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frown"
                    ],
                    "common_phrases": [
                        "furrow one's brow"
                    ],
                    "target_lang_definitions": {
                        "tr": "Endişe veya konsantrasyonu göstermek için kaşları çatmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kaşlarını çatmak",
                                "target_lang_sense_clarification": "Endişe veya düşünce anında kaşları bir araya getirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "040f9fba-9041-30e3-ab22-a6fd7845c97e",
                    "sense_definition": "To make lines or wrinkles on a surface or skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Age began to <w>furrow</w> his once smooth skin.",
                            "target_lang_translations": {
                                "tr": "Yaşlılık, bir zamanlar pürüzsüz olan cildini <w>kırıştırmaya</w> başladı."
                            }
                        },
                        {
                            "text": "The stress of the job started to <w>furrow</w> her face.",
                            "target_lang_translations": {
                                "tr": "İşin stresi yüzünü <w>kırıştırmaya</w> başladı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir yüzeyde veya ciltte çizgiler ya da kırışıklıklar oluşturmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kırıştırmak",
                                "target_lang_sense_clarification": "Ciltte veya yüzeyde kırışıklık meydana getirmek."
                            },
                            {
                                "target_lang_word": "çizgiler oluşturmak",
                                "target_lang_sense_clarification": "Yüzeyde derin izler bırakmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                    "sense_definition": "To cut a long narrow channel into the ground.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trench",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy tractor began to <w>furrow</w> the dry earth.",
                            "target_lang_translations": {
                                "tr": "Ağır traktör kuru toprağı <w>karık açarak sürmeye</w> başladı."
                            }
                        },
                        {
                            "text": "The river continued to <w>furrow</w> the landscape over many centuries.",
                            "target_lang_translations": {
                                "tr": "Nehir, yüzyıllar boyunca araziyi <w>yararak kanal açmaya</w> devam etti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Toprağı kazarak uzun, dar bir kanal açmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karık açmak",
                                "target_lang_sense_clarification": "Toprağı sürerek kanal oluşturmak."
                            },
                            {
                                "target_lang_word": "kanal açmak",
                                "target_lang_sense_clarification": "Yüzeyde derin bir yol veya kanal kazmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c064d335-75c7-313e-af1e-74d73548423d",
                    "sense_definition": "To become marked with deep lines or wrinkles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His forehead began to <w>furrow</w> as he thought about the problem.",
                            "target_lang_translations": {
                                "tr": "Sorunu düşünürken alnı <w>kırışmaya</w> başladı."
                            }
                        },
                        {
                            "text": "The old man's face seemed to <w>furrow</w> even more in the bright sunlight.",
                            "target_lang_translations": {
                                "tr": "Yaşlı adamın yüzü parlak güneş ışığında daha da <w>kırışmış</w> görünüyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Derin çizgiler veya kırışıklıklarla kaplanmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kırışmak",
                                "target_lang_sense_clarification": "Yüzeyin veya cildin derin çizgilerle dolması."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c5827a21-14ac-347e-be02-fb4429af3cd3",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Furrow</w> is our new history teacher.",
                            "target_lang_translations": {
                                "tr": "Bay <w>Furrow</w> yeni tarih öğretmenimiz."
                            }
                        },
                        {
                            "text": "The <w>Furrows</w> live in the house at the end of the street.",
                            "target_lang_translations": {
                                "tr": "<w>Furrowlar</w> sokağın sonundaki evde yaşıyorlar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir aile ismi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Furrow",
                                "target_lang_sense_clarification": "Özel isim (soyadı)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}