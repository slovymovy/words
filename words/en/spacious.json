{
    "word_family": [
        "space",
        "spaciously",
        "spaciousness",
        "spatial"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46803feb-5af3-33e9-8e4c-a730fc5622f2",
                    "sense_definition": "Having plenty of space or room inside; not cramped.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "size_and_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new apartment has a <w>spacious</w> bedroom that fits a king-sized bed easily.",
                            "target_lang_translations": {
                                "ru": "В новой квартире <w>просторная</w> спальня, в которой легко помещается большая двуспальная кровать."
                            }
                        },
                        {
                            "text": "We prefer a <w>spacious</w> living area where the children have enough room to play.",
                            "target_lang_translations": {
                                "ru": "Мы предпочитаем <w>просторную</w> гостиную, где детям хватает места для игр."
                            }
                        }
                    ],
                    "synonyms": [
                        "roomy",
                        "capacious",
                        "commodious",
                        "sizeable",
                        "large",
                        "big"
                    ],
                    "antonyms": [
                        "cramped",
                        "confined",
                        "narrow",
                        "small"
                    ],
                    "common_phrases": [
                        "spacious living area",
                        "spacious interior",
                        "spacious kitchen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий много свободного места внутри; не тесный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просторный",
                                "target_lang_sense_clarification": "о помещении или комнате"
                            },
                            {
                                "target_lang_word": "вместительный",
                                "target_lang_sense_clarification": "способный вместить много вещей или людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "710a5781-f683-3ef3-abc5-2522b7bbdc86",
                    "sense_definition": "Large in expanse or covering a wide area of land or sky.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size_and_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cabin offers a lovely <w>spacious</w> view of the mountain meadows and the valley below.",
                            "target_lang_translations": {
                                "ru": "Из хижины открывается чудесный <w>обширный</w> вид на горные луга и долину внизу."
                            }
                        },
                        {
                            "text": "They stood on the cliff looking out over the <w>spacious</w> landscape of the desert.",
                            "target_lang_translations": {
                                "ru": "Они стояли на утесе, глядя на <w>необъятный</w> ландшафт пустыни."
                            }
                        }
                    ],
                    "synonyms": [
                        "vast",
                        "expansive",
                        "wide",
                        "broad"
                    ],
                    "antonyms": [
                        "restricted",
                        "limited"
                    ],
                    "common_phrases": [
                        "spacious view",
                        "spacious landscape",
                        "spacious grounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающий большую площадь или имеющий широкий охват (о ландшафте или небе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "о территории или пространстве"
                            },
                            {
                                "target_lang_word": "необъятный",
                                "target_lang_sense_clarification": "очень большой, трудно охватить взглядом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}