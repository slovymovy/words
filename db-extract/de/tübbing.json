                "senses": [
                    {
                        "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                        "entry_id": "b18ec5a1-e070-3611-99d8-4ea44376c518",
                        "glosses": [
                            "Bauteil der Innenschale eines Tunnels"
                        ],
                        "tags": [
                            "Bergbau",
                            "Tunnelbau"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f94d3d-21df-463e-90b8-7201ded7e921",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Schäden an Tübbingen sind oftmals mit zeitaufwendigen und dementsprechend auch kostenintensiven Reparaturarbeiten verbunden."
                            },
                            {
                                "example_id": "a06e369e-31f4-44fb-8e1f-726e75f066a2",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Man unterscheidet Stahl- und Betontübbinge."
                            },
                            {
                                "example_id": "6369ef5c-fe18-43e8-9dd5-d01dd39dd8c4",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Was sind eigentlich Tübbinge?"
                            },
                            {
                                "example_id": "401157f0-e48e-4949-98f0-dc34e0ab6cc0",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "15 500 dieser Tübbinge werden insgesamt verbaut, hergestellt im brandenburgischen Linthe."
                            },
                            {
                                "example_id": "bd2d35c7-0508-43c8-9991-6cfc6434dca9",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Die Riesenmaschine „Bärlinde“ hatte sie von einer Grube in der Spandauer Straße aus durch den Untergrund getrieben und mit Tübbingen ausgesteift, Betonelementen, die sich zu einer perfekt abgedichteten Röhre fügen."
                            },
                            {
                                "example_id": "2893e86c-74ea-457b-9aad-f65e690398f7",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Maschineller Tunnelbau mit Stahlbetontübbings steht für intelligentes Bauen unter bewährter Kosten- und Zeitersparnis."
                            },
                            {
                                "example_id": "263e962c-a84e-4a30-bfc0-28c00f3a05d5",
                                "sense_id": "6399d3eb-2869-3c4d-9c28-a8474fa4bd9d",
                                "text": "Einer dieser Tübbings wiegt 900 kg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
