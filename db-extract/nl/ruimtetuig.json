                        "glosses": [
                            "een vaartuig bedoeld voor ruimtevaart"
                        ],
                        "tags": [
                            "ruimtevaart"
                        ],
                        "examples": [
                            {
                                "example_id": "c6114b50-0668-4521-8dd4-ffcdaac3a5af",
                                "sense_id": "71925a0d-914e-3c98-8e80-1bf427efa528",
                                "text": "Het ruimtetuig gaat in een koers rond de zon varen en de sterren afzoeken naar andere planeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f893190-f54d-482c-854b-f335924c0bbd",
                        "source_entry_id": "8f2517ca-6350-3428-8d10-7c23f977ed98",
                        "source_sense_id": "71925a0d-914e-3c98-8e80-1bf427efa528",
                        "source_sense_description": "een vaartuig bedoeld voor de ruimtevaart",
                        "target_lang_word": "spacecraft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spacecraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b15263-af9f-397d-a503-4b0a0d8d3e09",
                                        "entry_id": "f4a4d670-5aae-36be-8176-5f7ee2618f1d",
                                        "glosses": [
                                            "A vehicle that travels through space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44d6d87-d125-4eb4-9792-65149f520795",
                                                "sense_id": "e8b15263-af9f-397d-a503-4b0a0d8d3e09",
                                                "text": "Today, Velcro is used for everything from keeping astronauts from floating off the floor of their spacecrafts to keeping artificial hearts in place, as well as the more mundane tasks of fastening clothing."
                                            },
                                            {
                                                "example_id": "745e3f2c-c4ff-410a-a4b5-c82beb557ac7",
                                                "sense_id": "e8b15263-af9f-397d-a503-4b0a0d8d3e09",
                                                "text": "The object appeared after a series of routine prelanding procedures in which the crew tested the steering jets, a test that often shakes loose objects from the spacecraft."
                                            },
                                            {
                                                "example_id": "1da73295-0823-4bce-8388-34d54d87c217",
                                                "sense_id": "e8b15263-af9f-397d-a503-4b0a0d8d3e09",
                                                "text": "For the autocompatibility test, completed with Redwire partner Airbus Defense and Space, both spacecraft were stacked together, just like they will be for launch and the first month of the mission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
