                        "glosses": [
                            "Eigenschaft, kein Plastik zu enthalten; Zustand, ohne Plastik/Kunststoffe auszukommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fce9a58-2b8d-4ee0-bb9f-1e3ce3bb3646",
                                "sense_id": "7f44fa0e-877d-3a1a-a70b-9cf22a284dc6",
                                "text": "„Die Umstellung zur völligen Plastikfreiheit muss jedoch nicht von heute auf morgen gelingen.“"
                            },
                            {
                                "example_id": "fe4fbdbf-489c-4a11-90db-0140684a438a",
                                "sense_id": "7f44fa0e-877d-3a1a-a70b-9cf22a284dc6",
                                "text": "„Wenn Sie dieses Buch gekauft haben, sind Sie bereits am Thema Plastikfreiheit interessiert.“"
                            },
                            {
                                "example_id": "bdf8271a-d94d-4a49-9411-689e6ac8eead",
                                "sense_id": "7f44fa0e-877d-3a1a-a70b-9cf22a284dc6",
                                "text": "„Die Aktion wirbt dafür, alle kompostierbaren Küchen- und Gartenabfälle in die Biotonne zu geben und gleichzeitig auf genaue Sortierung und Plastikfreiheit zu achten.“"
                            },
                            {
                                "example_id": "e1490bc2-e219-452f-a2c0-47df7094886b",
                                "sense_id": "7f44fa0e-877d-3a1a-a70b-9cf22a284dc6",
                                "text": "„Der Gemeinderat verständigte sich darauf, dass die Gemeinde ihre Bestrebung nach Plastikfreiheit verstärkt.“"
                            }
                        ],
