                "senses": [
                    {
                        "sense_id": "06c4c367-1fa1-3ae5-b437-f02dc4247a57",
                        "entry_id": "648cd998-3155-301a-94b8-406accb14d48",
                        "glosses": [
                            "aan een kat herinnerend of erop gelijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968d88b0-820a-4f61-8f91-804af8319d1e",
                                "sense_id": "06c4c367-1fa1-3ae5-b437-f02dc4247a57",
                                "text": "Met een katachtige sprong belandde de lenige jongen van het dakje op de grond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10c035bd-583a-4706-99b6-c43afef062fa",
                        "source_entry_id": "648cd998-3155-301a-94b8-406accb14d48",
                        "source_sense_id": "06c4c367-1fa1-3ae5-b437-f02dc4247a57",
                        "source_sense_description": "aan een kat herinnerend of erop gelijkend.",
                        "target_lang_word": "katzenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "katzenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                        "entry_id": "1f3eff49-aac4-30b6-a461-b487dc58e223",
                                        "glosses": [
                                            "einer Katze ähnelnd, an eine Katze erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f903d306-ab33-4bf3-bdf8-5e7687dcac38",
                                                "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                                "text": "„Während die Sängerin mit katzenartiger Stimme nach einem verlorenen Liebhaber rief, schlich jemand an das Podest heran, ergriff die Scheibe vor der Lampe und drehte an ihr.“"
                                            },
                                            {
                                                "example_id": "79766e5f-31be-489b-8220-7c3a778d3cd5",
                                                "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                                "text": "„Sie rollte sich katzenartig auf einem cognacfarbenen Ohrensessel aus rissigem Leder zusammen.“"
                                            },
                                            {
                                                "example_id": "229dfaa5-06f7-48cc-8367-54de8ab4551f",
                                                "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                                "text": "„Kaddishs graue Augen wirkten mindestens genauso verschlagen und rätselhaft amüsiert wie sein katzenartiges Lächeln.“"
                                            },
                                            {
                                                "example_id": "a18e688b-8409-423f-b328-fc1be9c22e50",
                                                "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                                "text": "„Fertility hat gesagt, wenn ich dann berühmt sei, solle ich ihre Augen als katzenartig beschreiben.“"
                                            },
                                            {
                                                "example_id": "e99e82e5-b552-4d12-b185-5fe08d8b56c2",
                                                "sense_id": "e22640ec-3c54-3760-9850-bedcb4c10dc6",
                                                "text": "„Das Wort M[aidet] bezeichnet ein katzenartiges Raubtier, dessen Art nicht eindeutig zu bestimmen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
