                "senses": [
                    {
                        "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                        "entry_id": "982999b2-c17a-3ffc-b678-1f7e6a73d23e",
                        "glosses": [
                            "(alte) Person, die Schlechtes tut oder pessimistisch ist"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fd3d3a-d4a3-49b6-b010-16a665f61783",
                                "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                                "text": "„Zuletzt sorgt auch noch der CDU-Politiker Jürgen Wohlrabe für falsche Töne. Der stimmgewaltige Rechte, den SPD-Zuchtmeister Herbert Wehner einst als „Übelkrähe“ diffamierte, intoniert das Deutschlandlied, mit kehliger Stimme und eine Oktave zu tief.“"
                            },
                            {
                                "example_id": "f70a148b-f8b7-4c95-86dd-3e45b3e77821",
                                "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                                "text": "„Dass heute noch als Höhepunkte parlamentarischer Gefechte Herbert Wehners Rüpeleien zitiert werden, ist dafür kein Gegenbeweis, sondern eher ein Beleg. Als er den Abgeordneten Wohlrabe als ‚Übelkrähe‘ titulierte und einen anderen als ‚Düffeldoffel‘, war das nicht Ausdruck geistreicher Gewitztheit, sondern eher ergreifender Schlichtheit, der Spaßfaktor hielt sich in Grenzen.“"
                            },
                            {
                                "example_id": "92b1d862-f452-43b0-a4a0-588d32977bca",
                                "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                                "text": "„Den Burschen kenne ich. Wir hatten ihn schon wegen Einbruch, Überfall und Sachbeschädigung dran. Noch so eine Übelkrähe.“"
                            },
                            {
                                "example_id": "221d9682-4e46-44d1-9853-98202f5c383b",
                                "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                                "text": "„Ich bin brav ausgestiegen und habe der faltigen Übelkrähe das Feld überlassen.“"
                            },
                            {
                                "example_id": "7ff3271e-e8d4-4ffa-b0ab-65213cb4f7de",
                                "sense_id": "72b522c1-06b0-3fe1-8415-a099a3fc90ef",
                                "text": "„»Alte Übelkrähe! Uns wird gewiss nichts passieren. Schließlich sind wir keine Russen«, unterbrach ein anderer ihn spöttisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
