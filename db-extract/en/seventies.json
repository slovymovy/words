                    {
                        "sense_id": "a2c391dd-099d-3724-9761-755b22abc57f",
                        "entry_id": "cc94826e-055a-3e49-97a4-9306e5db545e",
                        "glosses": [
                            "The decade of the 1870s, 1970s, etc."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2cf3e524-04aa-45af-b5c6-d5e5cf16f82f",
                                "sense_id": "a2c391dd-099d-3724-9761-755b22abc57f",
                                "text": "I'm so bored of this decade, the seventies can't come soon enough."
                            },
                            {
                                "example_id": "852a245f-27ba-49bc-a1a5-623093a96196",
                                "sense_id": "a2c391dd-099d-3724-9761-755b22abc57f",
                                "text": "Our readers — and contributors — are apt to elect a good deal according to years. The seventies and eighties, we may suppose, are concerned for the large educational and cultural interests of their Alma Mater; the nineties are deep in the practical and business activities; the noughties are not naughty, but still young enough to sport a fantastic costume at reunion and let the college wag as it will; the oneties are the really wise as to what the college ought to be, especially on its athletic side, but as contributors modest."
                            },
                            {
                                "example_id": "da0af5ea-d8ac-4e0c-8989-91b6222b6b6d",
                                "sense_id": "a2c391dd-099d-3724-9761-755b22abc57f",
                                "text": "'The Bride' [a snowdrop variety], found in the early Seventies at Foxcote Farm near Cheltenham, was his first discovery. It's a poculiform (cup-shaped) G. elwesii] with six pure white petals of the same length."
                            }
                        ]
                    },
                    {
                        "sense_id": "fee2b2a2-a485-35eb-83d8-4e0ceb5cb58c",
                        "entry_id": "cc94826e-055a-3e49-97a4-9306e5db545e",
                        "glosses": [
                            "The decade of one's life from age 70 through age 79."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "d71e5c8e-f157-4ab7-a581-850f3532e039",
                                "sense_id": "fee2b2a2-a485-35eb-83d8-4e0ceb5cb58c",
                                "text": "My grandma met her third wife when they were both in their seventies."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ece85cb-f748-3a03-8235-e2884bd941c7",
                        "entry_id": "cc94826e-055a-3e49-97a4-9306e5db545e",
                        "glosses": [
                            "The range between 70 and 79."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3dea798f-8667-49c9-9b1a-771e80da7866",
                                "sense_id": "7ece85cb-f748-3a03-8235-e2884bd941c7",
                                "text": "You don't need your parka today, it's in the seventies."
                            }
                        ]
                    }
