                "senses": [
                    {
                        "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                        "entry_id": "4c6771e8-70eb-317c-a133-f91c49420bb8",
                        "glosses": [
                            "Ablenkung von Lichtstrahlen durch schwere Massen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "51efca18-b9dc-4d24-9004-2e59c0f9d0e3",
                                "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                                "text": "Beim starken Gravitationslinseneffekt kann das Licht verschiedene Wege zum Beobachter nehmen und multiple Bilder der Quelle entstehen."
                            },
                            {
                                "example_id": "d7391511-e628-44af-86ea-893ce4c843e1",
                                "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                                "text": "Die Übereinstimmung der Spektren schien der Annahme zweier unabhängiger Galaxien zu widersprechen, die unverzerrte Form schloss Gravitationslinseneffekte durch Vordergrundgalaxien aus."
                            },
                            {
                                "example_id": "c8d6a7b3-b853-439b-9d04-a9e302b89f43",
                                "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                                "text": "Diese ungebundenen Exoplaneten sind indirekt über Gravitationslinseneffekte nachgewiesen worden."
                            },
                            {
                                "example_id": "cf9dff52-59ad-45f3-b8ce-2151488e1c42",
                                "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                                "text": "Dieser Gravitationslinseneffekt zählt heute zu den gängigen astronomischen Methoden, um die ansonsten unsichtbare Dunkle Materie im All aufzuspüren."
                            },
                            {
                                "example_id": "101aa271-1147-4e28-9706-d2291669d330",
                                "sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                                "text": "Der starke Gravitationslinseneffekt wurde aber bereits 1979, also vor 38 Jahren anhand des „Doppelquasars“ Q0957+561 nachgewiesen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea3dae39-7d86-42d7-bbb7-7e999497322f",
                        "source_entry_id": "4c6771e8-70eb-317c-a133-f91c49420bb8",
                        "source_sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
                        "source_sense_description": "Physik, Astronomie: Ablenkung von Lichtstrahlen durch schwere Massen",
                        "target_lang_word": "gravitational lensing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravitational lensing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc1a8933-1b0e-3266-8b18-ba84d8b01deb",
                                        "entry_id": "ea4b8c47-7bd9-39c6-bc25-bbaa14aebd81",
                                        "glosses": [
                                            "The action of a highly-massive object (such as a star, galaxy, or black hole) that acts as a gravitational lens and focuses light from a light source (such as another star or galaxy) that passes behind it as observed from the Earth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcb0dd26-0335-4c9f-907f-ced89059c37d",
                        "source_entry_id": "4c6771e8-70eb-317c-a133-f91c49420bb8",
                        "source_sense_id": "24fb348f-4806-32a3-8287-ba0c0db64d36",
