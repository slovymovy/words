                    {
                        "sense_id": "64d71b26-0027-3076-85f9-3863c24940c7",
                        "entry_id": "5ef75682-d3e7-3968-9ce9-fd2c6640c8d3",
                        "glosses": [
                            "Personne qui tient, qui gère certains établissements."
