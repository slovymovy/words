            "senses": [
                {
                    "sense_id": "fb9966a2-b63d-3aca-a917-35c94cbaa786",
                    "sense_definition": "The wood derived from gymnosperm trees (usually coniferous trees like pine or fir), regardless of its physical hardness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wood_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The furniture maker prefers working with <w>softwood</w> because it is easier to cut.",
                            "target_lang_translations": {
                                "ru": "Мебельщик предпочитает работать с <w>древесиной хвойных пород</w>, потому что её легче распиливать."
                            }
                        },
                        {
                            "text": "Pine is a common type of <w>softwood</w> used for interior framing and paper production.",
                            "target_lang_translations": {
                                "ru": "Сосна — это распространенный вид <w>хвойной древесины</w>, используемый для внутренних каркасов и производства бумаги."
                            }
                        }
                    ],
                    "antonyms": [
                        "hardwood"
                    ],
                    "common_phrases": [
                        "softwood lumber",
                        "softwood timber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесина хвойных или других голосеменных деревьев (например, сосны или пихты), независимо от её фактической твердости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древесина хвойных пород",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "хвойная древесина",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "мягкая древесина",
                                "target_lang_sense_clarification": "буквальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                    "sense_definition": "A conifer or other gymnosperm tree that produces softwood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tree_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This fast-growing <w>softwood</w> has been planted extensively across the region for timber.",
                            "target_lang_translations": {
                                "ru": "Это быстрорастущее <w>хвойное дерево</w> широко высаживалось по всему региону ради древесины."
                            }
                        },
                        {
                            "text": "Forestry workers replaced the damaged deciduous trees with a resilient species of <w>softwood</w>.",
                            "target_lang_translations": {
                                "ru": "Работники лесного хозяйства заменили поврежденные лиственные деревья выносливой <w>хвойной породой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "conifer"
                    ],
                    "antonyms": [
                        "hardwood"
                    ],
                    "common_phrases": [
                        "softwood species",
                        "softwood trees"
                    ],
                    "target_lang_definitions": {
