                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "roaring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28fede79-d6da-3ba1-b86e-fcc4a5f4ca24",
                                        "entry_id": "6cca775f-42c6-32a9-9d15-f0bc2d231efd",
                                        "glosses": [
                                            "A loud, deep, prolonged sound, as of a large beast; a roar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55581106-01d5-43d2-b285-dc1f0641fa9b",
                                                "sense_id": "28fede79-d6da-3ba1-b86e-fcc4a5f4ca24",
                                                "text": "[…] those wild eyes that watch the wave\nIn roarings round the coral reef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720215d0-c104-3da5-bc94-33a2184fe398",
                                        "entry_id": "6cca775f-42c6-32a9-9d15-f0bc2d231efd",
                                        "glosses": [
                                            "An affection of the windpipe of a horse, causing a loud, peculiar noise in breathing under exertion."
                                        ],
