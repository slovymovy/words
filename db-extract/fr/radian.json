                    {
                        "form_id": "38da8f44-0a56-421b-a66e-04df8c8273dd",
                        "entry_id": "168f58eb-8cf0-3e40-ae9c-7ad7133c31a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "radians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dd2ceb6-ba44-3036-81a5-f1d2a1ca532e",
                        "entry_id": "168f58eb-8cf0-3e40-ae9c-7ad7133c31a1",
                        "glosses": [
                            "Unité de mesure de l’angle plan du Système international, dont le symbole est rad. C’est l’angle qui sous-tend un arc de cercle de longueur égale à son rayon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2193ca7-bfc1-4445-abcf-f115da770d3a",
                                "sense_id": "2dd2ceb6-ba44-3036-81a5-f1d2a1ca532e",
                                "text": "L’angle droit mesure π/2 radians."
                            },
                            {
                                "example_id": "05fd698b-f9aa-4549-90bb-cdeb4df2c0a7",
                                "sense_id": "2dd2ceb6-ba44-3036-81a5-f1d2a1ca532e",
                                "text": "Un triangle équilatéral a des angles de π/3 radians."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e56068fb-ed0b-4943-840d-e39a32ba91c0",
                        "source_entry_id": "168f58eb-8cf0-3e40-ae9c-7ad7133c31a1",
                        "source_sense_id": "2dd2ceb6-ba44-3036-81a5-f1d2a1ca532e",
                        "source_sense_description": "Unité de mesure de l’angle plan",
                        "target_lang_word": "Radiant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radiant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af780d94-575e-3635-a786-fe0ba8754103",
                                        "entry_id": "a46f06d1-9cb1-3656-bc66-f3640e30144a",
                                        "glosses": [
                                            "ebener Winkel im Bogenmaß, bei dem das Verhältnis von Kreisbogen und Radius gleich 1 ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af5a339-7d1a-4494-a625-f3cc97ecd363",
                                                "sense_id": "af780d94-575e-3635-a786-fe0ba8754103",
                                                "text": "Der Winkel kann in Altgrad oder Neugrad angegeben werden (Gradmaß α) oder aber in Radiant (Bogenmaß Xα), der dem Winkel α entsprechenden Länge des Kreisbogens auf dem Einheitskreis."
                                            },
                                            {
                                                "example_id": "a875f2a4-1dff-4e41-8751-ab76879ef7fb",
                                                "sense_id": "af780d94-575e-3635-a786-fe0ba8754103",
                                                "text": "Ingenieure schreiben bei ihren Berechnungen die Einheit Radiant (rad) explizit hinzu, um Umrechnungsfehler zu anderen Winkelmaßen (Grad, Gon) auszuschließen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "165a601e-2eb6-3f2f-8ff3-81b0c307766a",
                                        "entry_id": "a46f06d1-9cb1-3656-bc66-f3640e30144a",
                                        "glosses": [
                                            "scheinbarer Ausgangspunkt eines Schwarms von Meteoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b52577ad-58a7-4f4c-94c7-6c253ed1462a",
                                                "sense_id": "165a601e-2eb6-3f2f-8ff3-81b0c307766a",
                                                "text": "Die Zwillinge mit ihren hellen Hauptsternen Castor und Pollux standen übrigens Pate bei der Namensgebung für den Geminiden-Schwarm, weil die Sternschnuppen aus genau dieser Richtung zu fallen scheinen - diesen Ausgangspunkt der Meteorbahnen bezeichnen die Astronomen als Radiant."
                                            },
                                            {
                                                "example_id": "d08f4f6f-6877-40cb-8cbd-27856067a450",
                                                "sense_id": "165a601e-2eb6-3f2f-8ff3-81b0c307766a",
                                                "text": "Im vorliegenden Fall wird das Sternbild Löwe (lateinisch: Leo) zum Ausstrahlungspunkt (Radiant) und Paten der Leoniden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
