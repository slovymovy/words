                    {
                        "sense_id": "03c195eb-fb8a-3d46-8357-a4cfa8eaf853",
                        "entry_id": "7163918f-9f40-38c7-83c7-307f19226e99",
                        "glosses": [
                            "Traits distinctifs, singularités que l’on remarque dans les actions extérieures des particuliers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf78a36-cae2-4af0-b102-f5990794b230",
                                "sense_id": "03c195eb-fb8a-3d46-8357-a4cfa8eaf853",
                                "text": "Tu n’as pas mal décrit sa figure et ses manières."
                            },
                            {
                                "example_id": "f7fa1a08-1a8d-4ab6-99bb-18c3fdd1d282",
                                "sense_id": "03c195eb-fb8a-3d46-8357-a4cfa8eaf853",
                                "text": "Il savait qu’il était en Amérique, une grande et puissante nation, dont les citoyens avaient des manières sèches et humoristiques, se servaient à tout propos de revolvers et de couteaux à virole […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a5e504-6b70-4996-8427-edbd630dc77d",
                        "source_entry_id": "7163918f-9f40-38c7-83c7-307f19226e99",
                        "source_sense_id": "03c195eb-fb8a-3d46-8357-a4cfa8eaf853",
