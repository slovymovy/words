                "senses": [
                    {
                        "sense_id": "e8736de5-7677-3ba7-827e-e5546a93cc72",
                        "entry_id": "57afae01-545a-3065-b6d9-e98b003384c5",
                        "glosses": [
                            "Zwischensequenz in einem Computerspiel, in der ein Spieler schnell eine Reihe oder Kombination von Tasten drücken muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8460ca82-a01d-4960-bb96-cf14ddaab60d",
                                "sense_id": "e8736de5-7677-3ba7-827e-e5546a93cc72",
                                "text": "„Eigene und gegnerische Angriffe per Quick-Time-Event (QTE) können wir perfektionieren oder parieren, sofern das Timing stimmt.“"
                            },
                            {
                                "example_id": "4272bf7c-3080-4c68-92a8-7e54ed793216",
                                "sense_id": "e8736de5-7677-3ba7-827e-e5546a93cc72",
                                "text": "„Nun stürzt ihr euch zwangsläufig in ein Quick-Time-Event welches ihr überstehen solltet, um nicht vor die Hunde zu gehen.“"
                            },
                            {
                                "example_id": "b2aff9f0-cb97-4268-9e7f-2441bd4ee5d7",
                                "sense_id": "e8736de5-7677-3ba7-827e-e5546a93cc72",
                                "text": "„In \"Heavy Rain\" ist das Liebesspiel ein Quick-Time-Event, ein Tastendrücken im richtigen Moment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
