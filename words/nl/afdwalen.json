{
    "word_family": [
        "dwalen",
        "dwaalspoor",
        "verdwalen",
        "omdwalen",
        "dwaling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cd3cbf8-f61c-3e8c-aa10-9aec2395edbb",
                    "sense_definition": "de aandacht verliezen en aan andere dingen gaan denken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mentale focus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de lange presentatie <w>dwaalden</w> zijn gedachten steeds <w>af</w> naar de vakantie.",
                            "target_lang_translations": {
                                "en": "During the long presentation, his thoughts kept <w>wandering</w> to the holiday."
                            }
                        },
                        {
                            "text": "Het is lastig om niet <w>af</w> te <w>dwalen</w> als het onderwerp zo saai is.",
                            "target_lang_translations": {
                                "en": "It is difficult not to <w>drift off</w> when the subject is so boring."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstrooid raken"
                    ],
                    "antonyms": [
                        "focussen",
                        "concentreren"
                    ],
                    "common_phrases": [
                        "gedachten dwalen af",
                        "aandacht dwaalt af"
                    ],
                    "target_lang_definitions": {
                        "en": "to lose focus and start thinking about other things"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "of the mind or thoughts"
                            },
                            {
                                "target_lang_word": "drift off",
                                "target_lang_sense_clarification": "to lose concentration"
                            },
                            {
                                "target_lang_word": "get sidetracked",
                                "target_lang_sense_clarification": "to lose focus on a task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d3d34f5-af61-3672-b7f6-b1fe6bdb36c3",
                    "sense_definition": "fysiek van de juiste route of het pad afraken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaars <w>dwaalden</w> in de dichte mist <w>af</w> van het gemarkeerde pad.",
                            "target_lang_translations": {
                                "en": "The hikers <w>strayed</w> from the marked path in the thick fog."
                            }
                        },
                        {
                            "text": "Pas op dat je niet <w>afdwaalt</w> van de route, want het bos is erg groot.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>wander off</w> the route, because the forest is very large."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwijken",
                        "verdwalen"
                    ],
                    "antonyms": [
                        "koers houden"
                    ],
                    "common_phrases": [
                        "van het pad afdwalen",
                        "van de route afdwalen"
                    ],
                    "target_lang_definitions": {
                        "en": "to physically deviate from the correct route or path"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stray",
                                "target_lang_sense_clarification": "to move away from a path or group"
                            },
                            {
                                "target_lang_word": "wander off",
                                "target_lang_sense_clarification": "to walk away from a route"
                            },
                            {
                                "target_lang_word": "deviate",
                                "target_lang_sense_clarification": "to depart from a set course"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}