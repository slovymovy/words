                ],
                "senses": [
                    {
                        "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                        "entry_id": "6b4319ae-8bc5-3bc3-848a-bd10734fe08b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8b1766-3911-4a97-bc25-63057fc68f2b",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Frau Bayerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f305fea0-df6f-49f8-b796-3a87a06fedcd",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Herr Bayerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "066c054f-66e9-4b7d-84e7-fb5c34701d08",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Die Bayerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "740ab6a3-ff8c-4cec-b0be-146f5b35690e",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Der Bayerle trägt nie die Schals, die die Bayerle ihm strickt."
                            },
                            {
                                "example_id": "c4e1e3c5-b5ce-4c70-ace8-b82eb90c86b1",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bayerle kommt, geht der Herr Bayerle.“"
                            },
                            {
                                "example_id": "5b09b344-be9d-46bd-aea2-da08fed699d9",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Bayerle kommt und geht."
                            },
                            {
                                "example_id": "5a93e4cc-cd0c-4f59-b8ef-3aca6dbe6c37",
                                "sense_id": "5bc7a547-a88a-3015-8745-39b8bd34f502",
                                "text": "Bayerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
