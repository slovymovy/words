                ],
                "senses": [
                    {
                        "sense_id": "8b3f2e00-2e4f-3b99-a872-a66c29a579f3",
                        "entry_id": "fe988446-7e85-3ef8-9fed-f724ea09f582",
                        "glosses": [
                            "Bezeichnung einer Tierart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2e7b77-59b3-4396-9dbf-187636d7d3b4",
                                "sense_id": "8b3f2e00-2e4f-3b99-a872-a66c29a579f3",
                                "text": "„Es gibt wohl keine bessere Möglichkeit, die Schüler mit der Farbenfrische und Ausdruckskraft unserer Sprache bekannt zu machen, als ihnen die Bilder zu enthüllen, die in den volkstümlichen Pflanzen- und Tiernamen […] enthalten sind […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67ac6827-0187-39d9-9cab-a63604a45c5b",
                        "entry_id": "fe988446-7e85-3ef8-9fed-f724ea09f582",
                        "glosses": [
                            "individuell vergebene Bezeichnung für ein einzelnes Tier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf2a9d2-e311-4686-9319-58b86e975151",
                                "sense_id": "67ac6827-0187-39d9-9cab-a63604a45c5b",
                                "text": "„Vermutlich weil die meisten Beiträge zu Tiernamen bislang eher anekdotischer Natur waren oder aus bloßen Namensammlungen bestanden, hat sich die onomastische Forschung nicht um diesen vermeintlich unseriösen Namentyp gekümmert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
