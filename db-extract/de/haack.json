                        ],
                        "form": "die Haacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                        "entry_id": "ae1af2dd-093a-3845-b983-e91d6ed03bab",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbf6f02-e48a-4cdb-971c-a5a21f9d2f25",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Frau Haack ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8436fb16-2cae-40be-bb57-e5084785ba04",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Herr Haack wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "101b5f95-1278-4438-9e12-582128058ca1",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Die Haacks fliegen heute nach Stockholm."
                            },
                            {
                                "example_id": "49c47f4e-5003-434b-89fd-9c1ac4a69ea0",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Der Haack trägt nie die Pullover, die die Haack ihm strickt."
                            },
                            {
                                "example_id": "4a31cdf0-359f-4028-be72-9928da8be4a9",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haack kommt, geht der Herr Haack.“"
                            },
                            {
                                "example_id": "dd698422-3499-4638-ba60-c5eda6342d0e",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Haack kommt und geht."
                            },
                            {
                                "example_id": "47247799-750c-4c09-83e0-87d8fa1c5892",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "Haacks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f10ce109-2c13-4a08-a363-4aae23f5f64f",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "An verregneten Herbsttagen ist Familie Haacks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "95afb3b1-69e5-4148-bb4d-0088749c3d95",
                                "sense_id": "bf25384f-a5f2-33c8-aadf-142aa017feb9",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Haack das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
