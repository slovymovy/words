                    {
                        "sense_id": "dacb672d-925e-3c9d-84ee-779cd9da08a1",
                        "entry_id": "03c8da2d-2791-3c87-bed4-eddef4c351fc",
                        "glosses": [
                            "de nis met omlijsting van een (buiten-)deur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7c7518-2040-4a07-8f98-09651cc54dfa",
                                "sense_id": "dacb672d-925e-3c9d-84ee-779cd9da08a1",
                                "text": "In het portaal konden we even schuilen voor de regen."
                            }
                        ]
                    },
                    {
                        "sense_id": "996a15c4-c040-3951-8cc1-97e7e00d10f0",
                        "entry_id": "03c8da2d-2791-3c87-bed4-eddef4c351fc",
                        "glosses": [
                            "de ingang van een tunnel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca97a80-a451-4b7f-b457-c089a97cd0f7",
                                "sense_id": "996a15c4-c040-3951-8cc1-97e7e00d10f0",
                                "text": "Het portaal van een moderne tunnel is maar sober uitgevoerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a62a194-60c8-322f-b766-8a651f0c882d",
                        "entry_id": "03c8da2d-2791-3c87-bed4-eddef4c351fc",
                        "glosses": [
                            "de overspanning dwars over een (spoor-)weg waaraan verkeerborden, camera's e.d. en bovenleidingen, worden bevestigd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dcd6322-94a3-46a2-8e57-749b42fcb52f",
                                "sense_id": "5a62a194-60c8-322f-b766-8a651f0c882d",
                                "text": "Het portaal wordt ondersteund door portaalpoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7f873d1-42e2-3965-88db-222b25fb7b5a",
                        "entry_id": "03c8da2d-2791-3c87-bed4-eddef4c351fc",
                        "glosses": [
                            "op internet een website of pagina die een overzicht tracht te scheppen over een bepaald onderwerp door middel van links"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb652d97-2ca3-4baf-bd60-690661d7cf4f",
                        "source_entry_id": "03c8da2d-2791-3c87-bed4-eddef4c351fc",
                        "source_sense_description": "1,2 portaal (entree)",
                        "target_lang_word": "Portal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Portal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a562717f-40a9-36d6-8e2c-17ff683e1c13",
                                        "entry_id": "c34e6b59-8b61-307b-8b6b-350d32d4979d",
                                        "glosses": [
                                            "Tor, Zugang, Pforte, architektonisch verzierter Eingang und Ausgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83f6be1-f5f7-45b7-8dbd-872303bd3673",
                                                "sense_id": "a562717f-40a9-36d6-8e2c-17ff683e1c13",
                                                "text": "„Das gewaltige Portal schloß eine mit Eisen bekleidete Türe, die, wenn sie verrammelt war, nicht leicht gesprengt werden konnte.“"
                                            },
                                            {
                                                "example_id": "d733d177-67ad-4007-862a-19f804e930f8",
                                                "sense_id": "a562717f-40a9-36d6-8e2c-17ff683e1c13",
                                                "text": "„Es ist kein vierstöckiges Mietshaus, sondern ein anspruchsvolles Gebäude, es hat keine gewöhnliche Haustür, sondern ein Portal mit spiegelnden Türen, die von ein paar ionischen Säulen eingerahmt sind, es enthält keine Wohnungen, sondern Säle.“"
                                            },
                                            {
                                                "example_id": "ab364a34-662b-4103-8714-323c44d40055",
                                                "sense_id": "a562717f-40a9-36d6-8e2c-17ff683e1c13",
                                                "text": "„Natürlich gibt es dort keine verriegelten Türen, denn alle diese Pforten und Portale sind türenlos; aber in des entthronten Herrschers innerste Hallen und Höhlen konnten wir nicht eindringen.“"
                                            },
                                            {
                                                "example_id": "da9dda0d-e3e2-487b-8a27-969c5a2f1eb2",
                                                "sense_id": "a562717f-40a9-36d6-8e2c-17ff683e1c13",
                                                "text": "„Sie lief jetzt nicht mehr, die schwarze Handtasche baumelte in ihrer Hand, und ich drehte für einen Augenblick das Fernlicht auf, weil ich die Straße nicht überschauen konnte, und dann errötete ich vor Scham, als mein Scheinwerfer voll auf das Portal einer kleinen Kirche fiel, in die Hedwig gerade hineinging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "756535e1-e877-3b4a-8548-ecd80e3cd480",
                                        "entry_id": "c34e6b59-8b61-307b-8b6b-350d32d4979d",
                                        "glosses": [
                                            "zentraler Zugang, über den man auf individuell zugeschnittene, unternehmensinterne und externe Informationen und Dienste zugreifen kann; als vereinfachten Spezialfall hiervon gibt es im Internet eine spezielle Form einer Homepage, die meist als Startseite zu einem bestimmten Thema gestaltet ist."
                                        ],
                                        "tags": [
                                            "EDV",
                                            "IT"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd68e664-ec99-42dd-a73f-4659889aa66b",
                                                "sense_id": "756535e1-e877-3b4a-8548-ecd80e3cd480",
                                                "text": "„Das ideale Portal eröffnet einen gemeinsamen, personalisierten Zugang zu Daten, Expertisen und Anwendungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "777a2722-c130-31e5-a977-69b151f836f6",
                                        "entry_id": "c34e6b59-8b61-307b-8b6b-350d32d4979d",
                                        "glosses": [
                                            "Objekt, das beim Hineingehen eine Teleportation auslöst"
                                        ],
                                        "tags": [
                                            "Fiktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffa5d6c4-2abd-49e0-abbe-ba4bbd3b58f2",
                                                "sense_id": "777a2722-c130-31e5-a977-69b151f836f6",
                                                "text": "„Man konnte eine Laserkanone auf böse Alienroboter abfeuern, die durch ein Portal in einer Wand sprangen.“"
                                            },
                                            {
                                                "example_id": "99e6f2f0-df93-4de4-ad06-ea3144af5359",
                                                "sense_id": "777a2722-c130-31e5-a977-69b151f836f6",
                                                "text": "„Sobald ihr euch einem Portal nähert, beginnt es damit, sich ein Stück weit zu öffnen.“"
                                            },
                                            {
                                                "example_id": "300e721a-94d7-4d3b-9998-c0c3aa106a25",
                                                "sense_id": "777a2722-c130-31e5-a977-69b151f836f6",
                                                "text": "„Durch ein Portal können wir durch die Zeit reisen, um den Mordfall zu lösen, indem wir die Opfer immer wieder befragen und die Stadt erkunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47381801-a20b-412f-b5f1-83328a8fd10c",
