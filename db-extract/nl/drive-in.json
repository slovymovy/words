                                                "sense_id": "f76f3bf4-db20-3b25-859a-58a276822339",
                                                "text": "The restaurant’s drive-through window had a turntable of bulletproof glass designed to allow transactions while preventing robberies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drive-through",
