{
    "word_family": [
        "blockage",
        "blocker",
        "blocking",
        "blockhead",
        "blocky",
        "unblock"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e9e0020-7b4f-3a7d-86ba-bc5f9049816c",
                    "sense_definition": "To fill or obstruct something so that it is not possible to pass.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The narrow pipe was <w>blocked</w> by fallen leaves and dirt.",
                            "target_lang_translations": {
                                "ru": "Узкая труба была <w>засорена</w> опавшими листьями и грязью."
                            }
                        },
                        {
                            "text": "You are <w>blocking</w> the road and I cannot get my car through.",
                            "target_lang_translations": {
                                "ru": "Вы <w>преграждаете</w> дорогу, и я не могу проехать на своей машине."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop"
                    ],
                    "antonyms": [
                        "clear",
                        "open"
                    ],
                    "common_phrases": [
                        "block the road",
                        "block the pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнить или перекрыть что-либо так, чтобы проход стал невозможен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засорять",
                                "target_lang_sense_clarification": "о трубах, каналах"
                            },
                            {
                                "target_lang_word": "заблокировать",
                                "target_lang_sense_clarification": "перекрыть доступ"
                            },
                            {
                                "target_lang_word": "преграждать",
                                "target_lang_sense_clarification": "создавать препятствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23d356ad-0776-33d2-827f-4d92c36ab10b",
                    "sense_definition": "To prevent something or someone from passing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obstruct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A broken-down car is <w>blocking</w> the traffic on the highway.",
                            "target_lang_translations": {
                                "ru": "Сломавшийся автомобиль <w>блокирует</w> движение на шоссе."
                            }
                        },
                        {
                            "text": "The police <w>blocked</w> the entrance to the building for safety.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>перекрыла</w> вход в здание в целях безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "stop"
                    ],
                    "antonyms": [
                        "allow"
                    ],
                    "common_phrases": [
                        "block the traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать проходу кого-либо или проезду чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "движение или вход"
                            },
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "дорогу или доступ"
                            },
                            {
                                "target_lang_word": "загораживать",
                                "target_lang_sense_clarification": "путь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "554eb1ca-d123-3d43-9e8c-e7951c1b6633",
                    "sense_definition": "To bar a person from contacting you via telephone or social media.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_ban",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to send you a message, but I think you <w>blocked</w> me.",
                            "target_lang_translations": {
                                "ru": "Я пытался отправить тебе сообщение, но, кажется, ты меня <w>заблокировал</w>."
                            }
                        },
                        {
                            "text": "She decided to <w>block</w> him after he sent too many spam emails.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>заблокировать</w> его после того, как он прислал слишком много спама."
                            }
                        }
                    ],
                    "antonyms": [
                        "unblock"
                    ],
                    "common_phrases": [
                        "block a user"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запретить человеку связываться с вами по телефону или в социальных сетях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "пользователя"
                            },
                            {
                                "target_lang_word": "забанить",
                                "target_lang_sense_clarification": "в соцсетях"
                            },
                            {
                                "target_lang_word": "черный список",
                                "target_lang_sense_clarification": "добавить в список"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f8056f-be94-3419-a2d0-a4b80ff326e5",
                    "sense_definition": "To prevent something from happening or someone from doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His plan to take over the business was <w>blocked</w> by the boss.",
                            "target_lang_translations": {
                                "ru": "Его план по захвату бизнеса был <w>пресечен</w> боссом."
                            }
                        },
                        {
                            "text": "The committee <w>blocked</w> the new law from being passed.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>заблокировал</w> принятие нового закона."
                            }
                        }
                    ],
                    "antonyms": [
                        "approve",
                        "permit"
                    ],
                    "common_phrases": [
                        "block a plan",
                        "block a move"
                    ],
                    "target_lang_definitions": {
                        "ru": "Препятствовать совершению чего-либо или действиям кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "планам или действиям"
                            },
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "законопроект или решение"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef0425c-7e6e-303a-9227-da4dd855d2dc",
                    "sense_definition": "To impede an opponent or an opponent's play in a sport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>blocked</w> the basketball player's shot at the last second.",
                            "target_lang_translations": {
                                "ru": "Он <w>заблокировал</w> бросок баскетболиста в последнюю секунду."
                            }
                        },
                        {
                            "text": "The defenders worked hard to <w>block</w> every attempt to score.",
                            "target_lang_translations": {
                                "ru": "Защитники усердно работали, чтобы <w>блокировать</w> каждую попытку забить гол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block a shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мешать противнику или его игре в спорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "удар или игрока"
                            },
                            {
                                "target_lang_word": "ставить блок",
                                "target_lang_sense_clarification": "в волейболе или баскетболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8ab3bdd-d1b1-3089-b940-92922a810799",
                    "sense_definition": "To shape or sketch out the main features of something roughly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creative_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When drawing a scene, first <w>block</w> the main features and then fill in the detail.",
                            "target_lang_translations": {
                                "ru": "Рисуя сцену, сначала <w>набросайте</w> основные черты, а затем прорабатывайте детали."
                            }
                        },
                        {
                            "text": "The artist <w>blocked</w> out the shapes on the canvas before painting.",
                            "target_lang_translations": {
                                "ru": "Художник <w>наметил</w> формы на холсте перед началом работы красками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наметить или набросать основные черты чего-либо в общих чертах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "основные формы"
                            },
                            {
                                "target_lang_word": "компоновать",
                                "target_lang_sense_clarification": "объекты на холсте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "150b055c-e83f-36bf-98fa-b6e444677f0f",
                    "sense_definition": "To specify the positions and movements of actors for a play or film.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creative_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very difficult to <w>block</w> this scene convincingly with so many actors.",
                            "target_lang_translations": {
                                "ru": "Было очень трудно <w>выстроить мизансцену</w> убедительно с таким количеством актеров."
                            }
                        },
                        {
                            "text": "The director spent the afternoon <w>blocking</w> the final sequence of the movie.",
                            "target_lang_translations": {
                                "ru": "Режиссер провел вторую половину дня, <w>расписывая движения</w> в финальной сцене фильма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block a scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять положение и движения актеров для спектакля или фильма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мизансценировать",
                                "target_lang_sense_clarification": "выстраивать сцену"
                            },
                            {
                                "target_lang_word": "разводить",
                                "target_lang_sense_clarification": "актеров по сцене"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4ab95c-6a09-3700-8667-7dc178e6fd34",
                    "sense_definition": "To stretch or mould a knitted item or hat into the desired shape.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>blocked</w> the mittens by wetting them and pinning them to cardboard.",
                            "target_lang_translations": {
                                "ru": "Я <w>придала форму</w> варежкам, намочив их и приколов к картону."
                            }
                        },
                        {
                            "text": "You should <w>block</w> your sweater after washing it to keep its shape.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>расправить</w> свитер после стирки, чтобы он сохранил форму."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растягивать или придавать форму вязаному изделию или шляпе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формовать",
                                "target_lang_sense_clarification": "придавать форму"
                            },
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "вязание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ed1c123-7f27-3ae3-841c-b8c3282da153",
                    "sense_definition": "A substantial, often approximately cuboid, piece of any substance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child built a tall tower using a wooden <w>block</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок построил высокую башню, используя деревянный <w>кубик</w>."
                            }
                        },
                        {
                            "text": "We need a large <w>block</w> of ice to keep the drinks cold.",
                            "target_lang_translations": {
                                "ru": "Нам нужен большой <w>кусок</w> льда, чтобы напитки оставались холодными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block of ice",
                        "block of stone",
                        "wooden block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массивный, часто кубический кусок какого-либо вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "строительный или каменный"
                            },
                            {
                                "target_lang_word": "брусок",
                                "target_lang_sense_clarification": "деревянный или ледяной"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "материала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d936c98-8d93-332d-8005-365e35eff6fb",
                    "sense_definition": "A contiguous group of urban lots or buildings surrounded by streets.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "urban_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going for a quick walk around the <w>block</w>.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь быстро прогуляться вокруг <w>квартала</w>."
                            }
                        },
                        {
                            "text": "There is a small grocery store just one <w>block</w> away from here.",
                            "target_lang_translations": {
                                "ru": "Всего в одном <w>квартале</w> отсюда есть небольшой продуктовый магазин."
                            }
                        }
                    ],
                    "synonyms": [
                        "city block"
                    ],
                    "common_phrases": [
                        "around the block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа городских участков или зданий, окруженная улицами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квартал",
                                "target_lang_sense_clarification": "городской"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3bfff97-55a5-3876-9eca-708926c76a15",
                    "sense_definition": "The distance from one street to another in a city built on a grid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "urban_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The place you are looking for is two long <w>blocks</w> east of here.",
                            "target_lang_translations": {
                                "ru": "Место, которое вы ищете, находится в двух длинных <w>кварталах</w> к востоку отсюда."
                            }
                        },
                        {
                            "text": "I couldn't walk three <w>blocks</w> with that heavy backpack.",
                            "target_lang_translations": {
                                "ru": "Я не мог пройти и трех <w>кварталов</w> с этим тяжелым рюкзаком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "city block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстояние от одной улицы до другой в городе с сетчатой планировкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квартал",
                                "target_lang_sense_clarification": "как мера расстояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "621f1404-527a-369b-8c36-18ca66d0a26d",
                    "sense_definition": "A large building divided into separate parts, such as flats or offices.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a modern <w>block</w> of flats near the city center.",
                            "target_lang_translations": {
                                "ru": "Они живут в современном жилом <w>комплексе</w> недалеко от центра города."
                            }
                        },
                        {
                            "text": "The new office <w>block</w> is made entirely of glass and steel.",
                            "target_lang_translations": {
                                "ru": "Новое офисное <w>здание</w> полностью сделано из стекла и стали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block of flats",
                        "office block",
                        "tower block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое здание, разделенное на отдельные части, такие как квартиры или офисы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус",
                                "target_lang_sense_clarification": "здания"
                            },
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "многоквартирный дом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b92e3248-3369-3679-aa3b-0addad49e989",
                    "sense_definition": "Something that prevents something else from passing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a <w>block</w> in the pipe that means the water cannot get through.",
                            "target_lang_translations": {
                                "ru": "В трубе возник <w>засор</w>, из-за которого вода не может пройти."
                            }
                        },
                        {
                            "text": "The road was closed because of a physical <w>block</w> on the path.",
                            "target_lang_translations": {
                                "ru": "Дорога была закрыта из-за физического <w>препятствия</w> на пути."
                            }
                        }
                    ],
                    "synonyms": [
                        "barrier",
                        "blockage",
                        "obstruction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что препятствует проходу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преграда",
                                "target_lang_sense_clarification": "физическая"
                            },
                            {
                                "target_lang_word": "засор",
                                "target_lang_sense_clarification": "в трубе"
                            },
                            {
                                "target_lang_word": "препятствие",
                                "target_lang_sense_clarification": "на пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0271f39b-11b9-3fbd-9bc5-73bbf6adbb11",
                    "sense_definition": "A logical grouping or apportionment of like things treated as a unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logical_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher assigned a <w>block</w> of time for the students to study.",
                            "target_lang_translations": {
                                "ru": "Учитель выделил <w>отрезок</w> времени для самостоятельной работы студентов."
                            }
                        },
                        {
                            "text": "We made a <w>block</w> reservation for ten people at the hotel.",
                            "target_lang_translations": {
                                "ru": "Мы сделали <w>групповое</w> бронирование на десять человек в отеле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "block of time",
                        "block reservation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Логическая группировка или распределение похожих вещей, рассматриваемых как единое целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блок",
                                "target_lang_sense_clarification": "времени или информации"
                            },
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "услуг или предложений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "658c3ef8-3944-33f6-b113-683cf775ca9e",
                    "sense_definition": "Interference or obstruction of cognitive or creative processes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author suffered from writer's <w>block</w> and couldn't finish the chapter.",
                            "target_lang_translations": {
                                "ru": "Автор страдал от творческого <w>кризиса</w> и не мог закончить главу."
                            }
                        },
                        {
