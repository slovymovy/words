                ],
                "senses": [
                    {
                        "sense_id": "f75ee8a9-a8a2-36ef-82cc-e678677790a1",
                        "entry_id": "27ad1dd2-481e-3215-ac60-263552ccc091",
                        "glosses": [
                            "Sonner souvent et sans utilité."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c76b4a3a-a184-458f-9450-38b86cc0b2ec",
                                "sense_id": "f75ee8a9-a8a2-36ef-82cc-e678677790a1",
                                "text": "Par instant une clameur s'élevait ; ils se courbaient en un effort commun ; les grelots des quatre chevaux sonnaillaient ; […]."
                            },
                            {
                                "example_id": "b088ea3c-c4d7-4976-aa91-9d66ee158814",
                                "sense_id": "f75ee8a9-a8a2-36ef-82cc-e678677790a1",
                                "text": "Le tram arrivait en sonnaillant, rouge et jaune, éclairé, comme les cafés, avec des têtes qui dodelinaient à chaque cahot."
                            },
                            {
                                "example_id": "239ffbc9-b8f4-4b46-b26b-76eae15ff5bb",
                                "sense_id": "f75ee8a9-a8a2-36ef-82cc-e678677790a1",
                                "text": "La voie de Luçon était débloquée ; mais si à Nantes Charette avait sonnaillé en avance, les Angevins et les Poitevins sonnailleront trop tard à Saint-Gemmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c717dfe2-d698-3bc1-a50c-6e45e6401132",
                        "entry_id": "27ad1dd2-481e-3215-ac60-263552ccc091",
                        "glosses": [
                            "Faire sonner les cloches des troupeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5229ad92-9e9c-400f-a66b-28707beb2b33",
                                "sense_id": "c717dfe2-d698-3bc1-a50c-6e45e6401132",
                                "text": "Quand Chamonix étonne, éblouit par l’énormité de ses glaces, l’architecture hardie de ses granits, le val Montjoie charme le voyageur par des lignes plus douces, l’opulence des forêts, l’agreste harmonie des grands alpages où sonnaillent jour et nuit les troupeaux."
                            }
                        ]
                    }
                ],
