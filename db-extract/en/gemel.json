                    {
                        "translation_id": "890c543b-4c1d-4a99-8f01-434054a7ca61",
                        "source_entry_id": "414fcce8-9c9b-347c-9285-4048a582385d",
                        "source_sense_id": "398433d3-f70e-3b27-950f-130787793c5d",
                        "source_sense_description": "veraltet für Drehgelenk",
                        "target_lang_word": "Drehgelenk",
