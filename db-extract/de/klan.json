                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1ca0643-5539-34e9-bc7f-961c0b6e5f09",
                        "entry_id": "75778d89-8f90-3484-9633-ae883cd40c80",
                        "glosses": [
                            "Personengruppe mit Gemeinsamkeiten, zum Beispiel familiären, beruflichen oder politischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1181bc79-fe36-4bb7-82b7-23747205b7a7",
                                "sense_id": "b1ca0643-5539-34e9-bc7f-961c0b6e5f09",
                                "text": "Der Guru gehörte zum Klan des Tennisprofis."
                            },
                            {
                                "example_id": "b7bc38ba-a7ef-4f86-970b-107bb8448ad0",
                                "sense_id": "b1ca0643-5539-34e9-bc7f-961c0b6e5f09",
                                "text": "Das ist ein ganzer Klan, der jeden Sonntag zum Fußballplatz zieht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aad35518-3b42-3e8d-8ca5-bff84206a8e2",
                        "entry_id": "75778d89-8f90-3484-9633-ae883cd40c80",
                        "glosses": [
                            "Kurzwort für Ku-Klux-Klan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5439838-640f-4369-b05f-0965bf57a460",
                                "sense_id": "aad35518-3b42-3e8d-8ca5-bff84206a8e2",
                                "text": "„Jede Wahl, jede politische Versammlung wurde fortan vom Klan und ähnlichen Gruppen mit Massakern an Schwarzen und deren Verbündeten begleitet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
