                                    {
                                        "sense_id": "a6d0664b-eb7c-3fee-8fb2-5adf36929ae9",
                                        "entry_id": "113f3f96-e1eb-3e85-ac70-a0afdc709ce6",
                                        "glosses": [
                                            "Of or pertaining to Brabant or its people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959b5a34-11c5-45af-bd38-0e959fb1c209",
                                                "sense_id": "a6d0664b-eb7c-3fee-8fb2-5adf36929ae9",
                                                "text": "The Brabantian Calvinists emigrated en masse to Holland after the Sack of Antwerp in the 1580s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334d59f7-be02-33d0-b2d1-f994ab63d934",
                                        "entry_id": "113f3f96-e1eb-3e85-ac70-a0afdc709ce6",
                                        "glosses": [
                                            "Of or pertaining to the Brabantian dialect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9ee2f3-7a43-421f-8710-95ad9f379759",
                                                "sense_id": "334d59f7-be02-33d0-b2d1-f994ab63d934",
                                                "text": "That is a Brabantian accent, not a Limburgish one!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Brabantian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad6e399-a662-397b-9543-fca472fbf405",
                                        "entry_id": "7437e109-1b7b-3640-884d-b1228f922ff6",
                                        "glosses": [
                                            "The Dutch dialect mainly spoken in North Brabant (the Netherlands), Antwerp and Flemish Brabant provinces (Belgium)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cba6173-8263-4561-898f-167a70024868",
                                                "sense_id": "3ad6e399-a662-397b-9543-fca472fbf405",
                                                "text": "He speaks Brabantian with his schoolmates, and Belgian Standard Dutch in the classroom and with unfamiliar teachers in the playground, a classic example of diglossia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Brabantian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00e695d4-b0e0-394d-bd92-a4118ddd83ba",
                                        "entry_id": "dc077e2c-e0a3-3d1f-8dcf-5da021deb772",
                                        "glosses": [
                                            "A person from the respective provinces or historic region of Brabant (especially if Brabantian-speaking)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59bf8006-2928-4fb2-9d89-29541431aabe",
                                                "sense_id": "00e695d4-b0e0-394d-bd92-a4118ddd83ba",
                                                "text": "The Brabantians used to be known as rather reticent and stubborn, in contrast to their more open and louder Northern neighbors, i.e. the Dutch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
