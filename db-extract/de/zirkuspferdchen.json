                        "glosses": [
                            "kleines Zirkuspferd (auch übertragen für auftretende Künstler)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04432d23-0ca3-48bf-a2b9-37e9b6abe201",
                                "sense_id": "5983fb26-0fee-3461-944a-6c1d1df9d27b",
                                "text": "„Wir spielen Zirkus und schlüpfen in verschiedene Rollen: Zirkuspferdchen, Clowns, Raubkatzen, Seiltänzer und vieles mehr.“"
                            },
                            {
                                "example_id": "a67e6be6-29c6-4020-888a-ec11ca5db992",
                                "sense_id": "5983fb26-0fee-3461-944a-6c1d1df9d27b",
                                "text": "„Die Gestaltung besteht aus Musterpapieren in Rosa, Gelb und Rot, die auf den Türen die Parade von vier Zirkuspferdchen rahmen.“"
                            },
                            {
                                "example_id": "7e8a8a46-5d85-44fe-99b2-260891e92d9f",
                                "sense_id": "5983fb26-0fee-3461-944a-6c1d1df9d27b",
                                "text": "„Tief drin scheinen die Gefühle zu brodeln, auch wenn die Darsteller so artig trippeln wie Zirkuspferdchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
