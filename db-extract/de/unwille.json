                "senses": [
                    {
                        "sense_id": "f5bf5306-1628-3fc6-a426-dbc060bcf365",
                        "entry_id": "ed3984d3-bf2e-3932-b4a4-6993cc69ce24",
                        "glosses": [
                            "Einstellung/Gefühl eines starken Missfallens gegen jemanden oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12915e61-07b6-4a42-81dd-22f07f278413",
                                "sense_id": "f5bf5306-1628-3fc6-a426-dbc060bcf365",
                                "text": "„Die Gesichter waren verschlafen, Unwille lag auf ihnen, der Unwille, aus dem wenigstens animalisch erwärmten Bett in den Frost der Straße, aus der Ruhe in harte Fron zu müssen.“"
                            },
                            {
                                "example_id": "7b5a4937-5b41-4f9f-910d-a41f0a98f1f3",
                                "sense_id": "f5bf5306-1628-3fc6-a426-dbc060bcf365",
                                "text": "„Eines Abends hatte Obram seine Frau gefragt, ob sie unter den Leuten irgendwelchen Unwillen bemerkt habe.“"
                            },
                            {
                                "example_id": "9faf6242-966b-4e5b-b65e-87450a9aad8a",
                                "sense_id": "f5bf5306-1628-3fc6-a426-dbc060bcf365",
                                "text": "„Die Herren von der Suite sahen sich einen Augenblick lang gegenseitig an, und auf allen Gesichtern lag ein Ausdruck des Unwillens und des Vorwurfs.“"
                            },
                            {
                                "example_id": "5e7b5615-a360-4308-9481-810f655ae2c3",
                                "sense_id": "f5bf5306-1628-3fc6-a426-dbc060bcf365",
                                "text": "„Der junge Mann hatte den Kopf gänzlich verloren und schon bei seinem Eintritte in die Verhörstube dieses durch einen Trotz, einer Hintansetzung alles Anstandes bewiesen, der die sämtlichen Offiziere mit Unwillen erfüllte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
