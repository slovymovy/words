                    },
                    {
                        "translation_id": "370dedaf-1957-40a0-a836-0863472f7e33",
                        "source_entry_id": "0695b82f-b59f-31be-97f1-8ba71c9b5edd",
                        "source_sense_id": "c2549e09-0ae2-3699-b57c-cb26006c433d",
                        "target_lang_word": "mouldy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mouldy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0c715f7-52b9-3acd-9e6d-9fb3c5b44135",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Covered with mould."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e234a05b-6169-3079-8965-0eb56bc645e2",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Showing signs of neglect; disused."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c22df386-e8d6-39c3-89d7-53476e3836d7",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Worthless; lousy; rotten."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5fee45-f701-470f-8dd0-b91144d45e48",
                                                "sense_id": "c22df386-e8d6-39c3-89d7-53476e3836d7",
                                                "text": "'Go cuddle up to your mouldy old papers,' she shouted at him. 'See how warm they'll keep you.' She slammed the door and made to walk off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "814a1869-7498-3287-8f2a-0673225f0089",
                                        "entry_id": "6762a3fe-528e-301c-b110-44dcd1427c96",
                                        "glosses": [
                                            "Gray-headed, whether from age or hair powder."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "130b8d35-cb4e-493d-9926-3df08c9d0df4",
                                                "sense_id": "814a1869-7498-3287-8f2a-0673225f0089",
                                                "text": "Let him be great, as e'er he will, / He's rotten at the heart's core still; / Yet counsel from his mouldy pate, / Supports the trembling chair of state, / And scatters with unsparing hand, / A thousand miseries o'er the land; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bb80ff9-f158-4bce-b320-189521ac1f2b",
                        "source_entry_id": "0695b82f-b59f-31be-97f1-8ba71c9b5edd",
                        "source_sense_id": "c2549e09-0ae2-3699-b57c-cb26006c433d",
                        "target_lang_word": "musty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Affected by dampness or mould; damp, mildewed, mouldy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b9b2d-3fad-4ae5-9026-9407badb53a3",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "[W]hẽ his wordes be wel ſifted, men ſhall find little fine flowre in thẽ, but all very muſtie branne, not worthy ſo muche as to fede either horſe or hogges."
                                            },
                                            {
                                                "example_id": "6b6b5eb2-a4cd-4f65-9e57-53656cd5eff2",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "O vve muſt not regard vvhat he ſaies man, a Trout, a ſhallovv foole, he ha's no more braine than a Butterflie, a meer ſtuft ſuit, he looks like a muſtie Bottle, nevv vvickerd, his head's the Corke, light, light."
                                            },
                                            {
                                                "example_id": "85434760-8798-4679-8855-a823affad806",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "[W]aſt thou faine poore father, / To houill thee vvith ſvvine and rogues forlorne, / In ſhort and muſtie ſtravv, alack, alack, / Tis vvonder that thy life and vvits at once / Had not concluded all, […]"
                                            },
                                            {
                                                "example_id": "8c1cc3bb-35c5-4a52-acad-0fc24f666ccc",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "[H]ave your vvorms vvell ſcovvred and not kept in ſovvre or muſtie moſs; […]"
                                            },
                                            {
                                                "example_id": "6153319e-116a-4a98-8740-511445ad2703",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "[C]ome prithee let's be gone out of this ungrateful Air of his old Houſe; a pox on't, I can ſmell the muſty Bed-mats, and Kitchen-dreſſers, above half a Mile before I come to't."
                                            },
                                            {
                                                "example_id": "dd4dc454-2689-471d-bb46-0e28ddd5204c",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "[I]n ſcarce and dear Times the Huſbandman hath little to ſell to advance his Stock, and the Buyers are uſually furniſhed vvith muſty bad Corn from Foreign Parts (vvho often buy our Corn vvhen cheap, and ſell it to us again vvhen dear) or from ſuch as vvere ignorant of the vvays of preſerving it."
                                            },
                                            {
                                                "example_id": "c594ca7a-1aba-49bd-861f-b21822841dcb",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "Undaunted vvas my heart, nor could appal / The muſtieſt volume of the ſtall; / VVhere'er I turn'd, the giant ſpiders fled, / And trembling moths retreated as I read; […]"
                                            },
                                            {
                                                "example_id": "cea48a52-4c35-4665-8336-0abe3941fd0c",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "And pray, novv, tell me, hovv can it be vvorth one's beſt days, one's gayeſt hours, the very flovver of one's life—all to be ſacrificed to plodding over muſty grammars and lexicons, merely to cut a figure juſt for about tvvo minuts once or tvvice in a year?"
                                            },
                                            {
                                                "example_id": "423734a0-4317-4c01-8940-8f6d9080afb6",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "At theſe laſt vvords, forth cravvl'd an ancient Dame, / Sharp-nos'd, half ſtarv'd, and Avarice her name; / […] / Sav'd of the muſtieſt bread the crumbs, and ſees / A dinner in the ſcrapings of a cheeſe: […]"
                                            },
                                            {
                                                "example_id": "ca476bce-2ab8-4553-94d0-44ecf920bcad",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "Bradley assenting, went with him into an early public-house, haunted by unsavoury smells of musty hay and stale straw, […]"
                                            },
                                            {
                                                "example_id": "0dbf3e40-dc9d-4aef-8197-df3216484761",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "It was a thin book bound in faded morocco, with a copper-plate engraving as a frontispiece; the pages were musty with age and stained with mould."
                                            },
                                            {
                                                "example_id": "797e4ba5-d82d-4263-8c45-fa3c83518dd8",
                                                "sense_id": "bf4fbc7c-e72f-3520-88e1-f7e6dd3bebbc",
                                                "text": "Reize already has a strong and spirited jump, bounding higher than most every other fighter. That's what happens when you're not weighed down with all that musty, old armor!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Having an odour or taste of mould; also (generally), having a stale or unfresh odour or taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba22eb84-13cd-4eca-9b5d-39bb5864e485",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "musty food    musty furniture    a musty odour"
                                            },
                                            {
                                                "example_id": "10630d5c-8089-4520-9d57-7b84792ba881",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "You had muſty vittaile, and he hath holpe to eate it, he is a very valiaunt trencher man, he hath an excellent ſtomacke."
                                            },
                                            {
                                                "example_id": "edbff8b3-3a70-4b71-959e-5356b5f7d0ae",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "Being entertain'd for a perfumer, as I was ſmoaking a muſty roome, comes me the prince and Claudio, hand in hand in ſad conference: […]"
                                            },
                                            {
                                                "example_id": "fffa3330-6072-41ea-9447-222b3d592b65",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "Well, I haue almost mard their market, for Gentlemen especially, those that loue to smell sweete, for they are the worst Milliners in a kingdome, and their sutes beare the mustiest perfume of anything breathing, vnlesse it were an Usurers Night-cappe againe: […]"
                                            },
                                            {
                                                "example_id": "2b9564e6-e796-48c0-89ef-b9d896ada9a1",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "'Sbuds! this Veniſon is muſty."
                                            },
                                            {
                                                "example_id": "607f68fb-ce0d-48af-9fbe-4e6c5d4a17c4",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "He knovvs to live, vvho keeps the middle ſtate, / And neither leans on this ſide, or on that: / Nor ſtops, for one bad Cork, his Butler's pay, / Svvears, like Albutius, a good Cook avvay; / Nor lets, like Nævius, ev'ry error paſs, / The muſty vvine, foul cloth, or greaſy glaſs."
                                            },
                                            {
                                                "example_id": "02cbf52b-f744-4744-a597-9fd649a06814",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "I was terribly afraid, from what I had heard of Blackwater Park, of fatiguing antique chairs, and dismal stained glass, and musty, frowzy hangings, and all the barbarous lumber which people born without a sense of comfort accumulate about them, in defiance of all consideration due to the convenience of their friends."
                                            },
                                            {
                                                "example_id": "705b4510-1523-47d2-93cc-1d6f19f176ac",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "So, after a spell, he decided to make the best of it and shoved us into the front parlor. […] It looked like a tomb and smelt pretty nigh as musty and dead-and-gone."
                                            },
                                            {
                                                "example_id": "6fbbeae9-828d-47b6-8feb-91f4583f2845",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "It was a close, musty, ill-ventilated place, since its inmate seldom left it."
                                            },
                                            {
                                                "example_id": "3b32144b-a72f-4228-a94f-d76617471e5c",
                                                "sense_id": "3d1d657c-703d-37b3-a5ca-11019ba09a94",
                                                "text": "In the same category was the peculiar musty smell which pervaded the old City & South London Railway, the pioneer deep-level tube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcba34cd-ece3-329e-8da0-36fadeed5a72",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Characteristic of or relating to mould or mouldiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128e8ff7-fa0b-46d2-9216-632c642fba80",
                                                "sense_id": "bcba34cd-ece3-329e-8da0-36fadeed5a72",
                                                "text": "Not knowing what \"swipes\" might be, I thought I would run the risk and try it; but it proved a miserable beverage, with a musty, sour flavor, as if it had been a decoction of spoiled pickles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccd6d3bb-5e79-3f99-844a-83b94229d507",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Of attitudes, ideas, writing, or other abstract things: no longer fresh or interesting; outdated, stale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d4dfb6-b06f-4309-94af-0fbb55c8b233",
                                                "sense_id": "ccd6d3bb-5e79-3f99-844a-83b94229d507",
                                                "text": "An antiquarie is an honest man, for he had rather scrape a piece of copper out of the durt, than a crowne out of Plodion's standish. I know manie wise gentlemen of this mustie vocation, […]"
                                            },
                                            {
                                                "example_id": "13226991-beb6-4a02-b892-5e445c368dbf",
                                                "sense_id": "ccd6d3bb-5e79-3f99-844a-83b94229d507",
                                                "text": "[W]hile the graſſe grovves, the Prouerbe is ſomething muſty."
                                            },
                                            {
                                                "example_id": "e5df950a-2396-4c00-8b07-8967cff0abeb",
                                                "sense_id": "ccd6d3bb-5e79-3f99-844a-83b94229d507",
                                                "text": "Have done, I beg you, vvith your muſty Reflections: You but interrupt the Examination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e0b1c4-00cc-32a8-b8b4-95c2aac1bace",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Of a person: boring and unadventurous; also, old-fashioned, stuck in the past."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251252c1-d31e-4766-a02b-06fad507ffed",
                                                "sense_id": "68e0b1c4-00cc-32a8-b8b4-95c2aac1bace",
                                                "text": "[T]hey ſettle upon their ovvn dregs, and grovv muddy and muſty vvith long eaſe, and their proſperity befooleth them to their ovvn deſtruction."
                                            },
                                            {
                                                "example_id": "ccde4a94-a852-44c7-a3b0-de15b97b8155",
                                                "sense_id": "68e0b1c4-00cc-32a8-b8b4-95c2aac1bace",
                                                "text": "[B]eing married to a bookish man, who has no knowledge of the world, she is forced to take their affairs into her own hands, and to spirit him up now and then, that he may not grow musty, and unfit for conversation."
                                            },
                                            {
                                                "example_id": "c1f3df68-d41e-44be-86a3-e99915cac775",
                                                "sense_id": "68e0b1c4-00cc-32a8-b8b4-95c2aac1bace",
                                                "text": "My friend the doctor was a thorough antiquary: a little rusty, musty old fellow, always groping among ruins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea258b18-fffa-3fde-a25d-0612847fc26a",
                                        "entry_id": "7429dfbc-256f-3ef6-a516-4ba79c08aab0",
                                        "glosses": [
                                            "Bad-tempered, grumpy, irritable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3cbd4e3-b725-4949-9e84-3d7805e86207",
                                                "sense_id": "ea258b18-fffa-3fde-a25d-0612847fc26a",
                                                "text": "The ill-vvounded Don Quixote vvas exceeding muſty and melancholy, vvith his face bound vp, and ſcarred not by the hand of God, but by the nayles of a Cat (misfortunes annexed to Knight Errantry) ſixe dayes paſt ere hee came abroad: […]"
                                            },
                                            {
                                                "example_id": "1f14b89b-9afd-4803-baa2-dfc781b263c8",
                                                "sense_id": "ea258b18-fffa-3fde-a25d-0612847fc26a",
                                                "text": "He is monſtrous vexed, and muſty, at my Cheſſe-play; […]"
                                            },
                                            {
                                                "example_id": "4fbf09fb-093a-42e8-b818-4cba2d489411",
                                                "sense_id": "ea258b18-fffa-3fde-a25d-0612847fc26a",
                                                "text": "VVhat a devil makes thee in ſo muſty a humour? Thou art as dull and dumpiſh as a fellovv that had been drunk over night vvith Ale, and had done nothing but drunk Coffee, talked Politicks, and read Gazettes all this morning."
                                            },
                                            {
