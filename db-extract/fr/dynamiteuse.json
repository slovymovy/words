                        "sense_id": "057a1955-aff0-323f-9382-bb741375a87e",
                        "entry_id": "7bd9035b-c2ee-31ec-92c7-907ead51382c",
                        "glosses": [
                            "Femme qui dynamite, qui fait exploser une charge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb02bdb5-c844-4fbf-b263-af5a7a7e5032",
                                "sense_id": "057a1955-aff0-323f-9382-bb741375a87e",
                                "text": "«Je ne suis pas quelqu’un qui est super à l’aise en partant. Ce n’était pas évident. Devant les caméras, il faut souvent que tu recommences et que tu répètes. Il faut tout dire en détail. Je ne suis pas habituée d’expliquer de cette manière», raconte la dynamiteuse qui a été filmée pendant plusieurs mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6fb0d9d-c0c1-3b7e-b569-7785456fc364",
                        "entry_id": "7bd9035b-c2ee-31ec-92c7-907ead51382c",
                        "glosses": [
                            "Destructrice."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a22dfe50-ef24-41a4-9ab1-4ce32659b7d5",
                                "sense_id": "f6fb0d9d-c0c1-3b7e-b569-7785456fc364",
                                "text": "Athlète. Communicante. Influenceuse. Dynamiteuse d’idées. Stella Akakpo est tout ça à la fois."
                            }
                        ]
                    }
                ],
