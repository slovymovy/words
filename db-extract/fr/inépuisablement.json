                    {
                        "sense_id": "f34fc4df-d072-3dfb-ab2c-e11965feda99",
                        "entry_id": "81ed9ecf-1bfd-3125-82ef-6032c520740c",
                        "glosses": [
                            "D’une manière inépuisable ; sans jamais tarir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8e84e0-d615-4e29-8e4a-233010e31527",
                                "sense_id": "f34fc4df-d072-3dfb-ab2c-e11965feda99",
                                "text": "Il y a en nous une raison primitive et un principe d’intelligence, d’où naissent continuellement et inépuisablement toutes nos pensées."
                            },
                            {
                                "example_id": "3211d816-7684-4bc8-9fa0-cf1149a818df",
                                "sense_id": "f34fc4df-d072-3dfb-ab2c-e11965feda99",
                                "text": "Au zénith enfin, elle éclaire tout un couloir de mer, riche fleuve de lait, qui, avec le mouvement du navire, descend vers nous, inépuisablement, dans l'Océan obscur."
                            }
                        ]
                    }
                ],
