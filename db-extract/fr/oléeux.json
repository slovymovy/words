                        "glosses": [
                            "De l'aspect de l'huile."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7a87bc41-0be7-4bc2-95fa-50cd97a8b121",
                                "sense_id": "6edc9146-713e-324a-96d4-7f43ba2f5210",
                                "text": "Il contient toujours du protoplasma, souvent de l'amidon, des liquides d'aspect oléeux, de la chlorophylle, quelquefois une matière colorante bleue."
                            },
                            {
                                "example_id": "5c3d16dc-08e8-455e-a176-a11d9385cbd4",
                                "sense_id": "6edc9146-713e-324a-96d4-7f43ba2f5210",
                                "text": "Le liquide, d'une couleur de café au lait, d'une odeur semblable à la vanille, et résultant de la réunion du principe âcre oléeux mêlé à la gomme et à un peu d'extrait, s'évapore dans l’appareil jusqu’à la réduction d'environ 1500 grammes de liquide ; […]."
                            }
                        ]
