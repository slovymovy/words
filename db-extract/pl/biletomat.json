                    {
                        "translation_id": "110b8385-3119-47f7-9738-6adc70993131",
                        "source_entry_id": "b3a374cc-b5b2-3861-864d-b2cac82718b0",
                        "source_sense_id": "91595e66-1a4f-3e08-a9b5-5d43b76b7eaf",
                        "target_lang_word": "vending machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vending machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                        "entry_id": "bfecb651-26fe-31c7-bcb7-ecb94edad81d",
                                        "glosses": [
                                            "An automatic machine that dispenses merchandise (often food or beverages) in return for payment (originally coins; now also often paper money, credit cards, and wirelessly via digital payment apps)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2eb514-b91c-4704-b222-86815d7b1f94",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "Meronyms: bill acceptor, card swipe, change slot, coin return, coin slot, flavor strip"
                                            },
                                            {
                                                "example_id": "97490405-058c-4e77-9d72-913e9ca4bb8b",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "It is not clear to all operators of vending machines, though, that their future lies in dispensing meals, rather than snacks or candy."
                                            },
                                            {
                                                "example_id": "48deb037-dce3-43ee-8113-1d4f26affd51",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "Passengers may find themselves in a catch-22 situation, unable to buy a ticket for any number of reasons, ranging from an out-of-order ticket vending machine to a lengthy queue to use one, and yet then fall foul of the penalty fare regime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a45bf3c-6665-460e-b76a-4815710b7fca",
                        "source_entry_id": "b3a374cc-b5b2-3861-864d-b2cac82718b0",
                        "source_sense_id": "91595e66-1a4f-3e08-a9b5-5d43b76b7eaf",
                        "target_lang_word": "Fahrkartenautomat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrkartenautomat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9bc1d0-1bbf-347f-acf4-a434fa959539",
                                        "entry_id": "b3e27436-67a7-3865-b652-a2fafcf3a521",
                                        "glosses": [
                                            "Gerät, an dem man als Fahrgast selbstständig Fahrscheine lösen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3f137f-fb69-46ea-a0b6-45f66d46fa4f",
                                                "sense_id": "ab9bc1d0-1bbf-347f-acf4-a434fa959539",
                                                "text": "Der Fahrkartenautomat am Bahnsteig ist defekt."
                                            },
                                            {
                                                "example_id": "e7b1cf0a-6cf2-437d-9dbc-e444331e65ef",
                                                "sense_id": "ab9bc1d0-1bbf-347f-acf4-a434fa959539",
                                                "text": "„Mit einem erstaunlichen Maß an Alltagsklugheit drängelte er sich routiniert am Fahrkartenautomaten vor, rannte, um die verstopfte Rolltreppe zu umgehen, die Stufen hinunter und drückte sich mit einem lehmigen Ausdruck von Selbstverständlichkeit in das überfüllte Abteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
