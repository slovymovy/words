                                        "glosses": [
                                            "Person, die dem Militarismus anhängt, das heißt, militärische Ordnung und Werte als Vorbild erachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04df8dfd-e3f2-4587-859e-c589416ddaf7",
                                                "sense_id": "198f0ff0-252e-3b94-9e53-813c170652b7",
                                                "text": "„Bellizist, Militarist, Technokrat, Wegbereiter beziehungsweise Sympathisant des Nationalsozialismus, elitärer Ästhet – so lauten zusammengefasst die seit 1945 vorgetragenen Verdikte seiner Gegner über das Skandalon Jünger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
