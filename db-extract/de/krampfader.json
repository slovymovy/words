                "senses": [
                    {
                        "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                        "entry_id": "05441821-a632-34d6-850e-99c5f2eda07e",
                        "glosses": [
                            "defekte Vene, in der das Blut nicht mehr zurückfließt (meist äußerlich sichtbar)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3cdafc-008e-46c3-a2f9-49749d1bfd5e",
                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                "text": "Sie hat sich die Krampfadern an den Beinen ziehen lassen."
                            },
                            {
                                "example_id": "ad3ea67c-69c8-4cc4-b607-4426f56cb322",
                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                "text": "„Herrliche Zeiten ohne motorisierte Schützeneinheiten, in denen heute dafür gesorgt wird, daß auch Leute mit Krampfadern zu ihrem Militärdienst kommen!“"
                            },
                            {
                                "example_id": "3893f0bb-8645-4035-94fb-83a435541b0c",
                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                "text": "„Ihre dickschenkligen Beine waren von Krampfadern durchzogen.“"
                            },
                            {
                                "example_id": "5b473965-79f2-446d-b89e-dd2dd1c6e6ed",
                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                "text": "„Die ältere Frau hatte Krampfadern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
