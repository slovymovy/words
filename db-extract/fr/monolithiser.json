                "senses": [
                    {
                        "sense_id": "0e143bd3-6ee7-34f8-b21d-c87b122f0422",
                        "entry_id": "08e62f77-3708-3fdb-b1ec-dbf8ba28602e",
                        "glosses": [
                            "Donner un caractère monolithique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66645843-2775-4af1-a7b3-285606014fa5",
                                "sense_id": "0e143bd3-6ee7-34f8-b21d-c87b122f0422",
                                "text": "Il convient en effet de donner une définition qui sorte ce concept du flou, sans toutefois le monolithiser : c’est-à-dire en lui gardant sa capacité de conférer une certaine unité à la diversité qu’il recouvre, et non de l’absorber."
                            },
                            {
                                "example_id": "53dc3c67-efdc-4bb5-bc82-da6152b5ecab",
                                "sense_id": "0e143bd3-6ee7-34f8-b21d-c87b122f0422",
                                "text": "Je crois que c'est plutôt toi qui trouve^([sic]) plus confortable pour la discussion de monolithiser mes opinions."
                            },
                            {
                                "example_id": "88ff7724-a5d1-4223-a26e-c46ecd8021ff",
                                "sense_id": "0e143bd3-6ee7-34f8-b21d-c87b122f0422",
                                "text": "Pourtant, la revendication tend à se monolithiser."
                            }
                        ]
                    }
