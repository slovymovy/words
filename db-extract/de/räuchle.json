                ],
                "senses": [
                    {
                        "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                        "entry_id": "28c5741f-22ac-308a-bf81-6ea25bd59e2f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e62b15-9466-46aa-93b9-cdd37b355392",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Frau Räuchle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "de200162-bd2b-4e45-abdc-7bcdcbbdda3a",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Herr Räuchle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d9fa6b6c-fed1-47e6-bf36-a42ec961d3b0",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Die Räuchles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7073e7cd-83ae-4d2b-af40-23dfc4a92277",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Der Räuchle trägt nie die Schals, die die Räuchle ihm strickt."
                            },
                            {
                                "example_id": "32b6fe47-e3f8-4692-8fa6-4bf9f1905ba6",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Räuchle kommt, geht der Herr Räuchle.“"
                            },
                            {
                                "example_id": "6df75b84-8056-4c1c-97e1-87e318315f6f",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Räuchle kommt und geht."
                            },
                            {
                                "example_id": "efc7ddc1-6c27-4008-88ae-1bb2969918ed",
                                "sense_id": "4fd0e1c8-e58c-3a5a-8324-b597a86afe73",
                                "text": "Räuchles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
