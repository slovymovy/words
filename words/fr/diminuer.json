                {
                    "sense_id": "f21845a2-13bf-396a-88dc-a2f926f358dc",
                    "sense_definition": "Rendre quelque chose plus petit, moins nombreux ou d'une valeur inférieure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "baisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche des solutions efficaces pour <w>diminuer</w> ses dépenses d'énergie.",
                            "target_lang_translations": {
                                "en": "The company is looking for effective ways to <w>reduce</w> its energy costs.",
                                "ru": "Компания ищет эффективные способы <w>сократить</w> расходы на энергию.",
                                "de": "Das Unternehmen sucht nach wirksamen Lösungen, um seine Energiekosten zu <w>senken</w>.",
                                "es": "La empresa busca soluciones eficaces para <w>reducir</w> sus gastos de energía.",
                                "zh": "这家公司正在寻找有效的办法来<w>减少</w>能源开支。"
                            }
                        },
                        {
                            "text": "Le conducteur doit <w>diminuer</w> sa vitesse à l'approche de cette école.",
                            "target_lang_translations": {
                                "en": "The driver must <w>reduce</w> their speed as they approach this school.",
                                "ru": "Водитель должен <w>снизить</w> скорость при приближении к этой школе.",
                                "de": "Der Autofahrer muss bei Annäherung an diese Schule seine Geschwindigkeit <w>verringern</w>.",
                                "es": "El conductor debe <w>reducir</w> la velocidad al acercarse a esta escuela.",
                                "zh": "司机接近这所学校时必须<w>降低</w>车速。"
                            }
                        }
                    ],
