                ],
                "senses": [
                    {
                        "sense_id": "29031ca3-5fa8-38ea-ba95-c80840dbc1e3",
                        "entry_id": "86b2220f-00b3-39c6-aa79-1d00e771252e",
                        "glosses": [
                            "herzhafte Soße, die hauptsächlich aus Tomaten besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4691580-f0dd-4f01-a91d-8082b0ec55eb",
                                "sense_id": "29031ca3-5fa8-38ea-ba95-c80840dbc1e3",
                                "text": "Viele Kinder geben als Leibspeise Spaghetti mit Tomatensoße an."
                            },
                            {
                                "example_id": "6095c6fd-ed7f-4b6c-827f-d375db8e313f",
                                "sense_id": "29031ca3-5fa8-38ea-ba95-c80840dbc1e3",
                                "text": "„Papa hat eine Forelle mit Butterkartoffeln und viel Salat gegessen, und ich habe Nudeln mit Tomatensoße gegessen, eine riesige, gute Portion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5113058a-2002-4e11-aefb-31ecea3de1b9",
                        "source_entry_id": "86b2220f-00b3-39c6-aa79-1d00e771252e",
                        "source_sense_id": "29031ca3-5fa8-38ea-ba95-c80840dbc1e3",
                        "source_sense_description": "herzhafte Soße, die hauptsächlich aus Tomaten besteht",
                        "target_lang_word": "tomato sauce",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tomato sauce",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe19ba9-bd41-3847-8bfd-2f3f473cab63",
                                        "entry_id": "d161baa2-1d1f-3c39-8f37-d1dcced85e7a",
                                        "glosses": [
                                            "A thick sauce made from tomatoes for pasta etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df137b34-ae19-44a9-b56d-79a1b47e92e4",
                                                "sense_id": "dfe19ba9-bd41-3847-8bfd-2f3f473cab63",
                                                "text": "Russian Tomato Sauce will keep, tightly covered, in the refrigerator for 10 days."
                                            },
                                            {
                                                "example_id": "72ce5f3c-6cec-4bf7-b975-7f2ad2709981",
                                                "sense_id": "dfe19ba9-bd41-3847-8bfd-2f3f473cab63",
                                                "text": "Classical tomato sauce, as explained by Escoffier, is made with a roux, but this is rarely done in modern kitchens."
                                            },
                                            {
                                                "example_id": "be980861-3fa7-487e-a4da-9f318c2e951f",
                                                "sense_id": "dfe19ba9-bd41-3847-8bfd-2f3f473cab63",
                                                "text": "But in the summer, fresh tomato sauce should be a staple; peeling the tomatoes—which is optional—is undeniably a bit of work (seeding takes only a second), but the flavor of the sauce is much better than canned, thee texture is rich and silky, and the color much prettier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b190caf7-a144-335a-9c7b-79901afdc924",
                                        "entry_id": "d161baa2-1d1f-3c39-8f37-d1dcced85e7a",
                                        "glosses": [
                                            "Tomato ketchup, used as a condiment."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Brunei",
                                            "India",
                                            "Malaysia",
                                            "Myanmar",
                                            "New-Zealand",
                                            "Pakistan",
                                            "Singapore",
                                            "South-Africa",
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79637fae-03fb-4d2b-8382-47462b9ff108",
                                                "sense_id": "b190caf7-a144-335a-9c7b-79901afdc924",
                                                "text": "A plastic tomato sauce bottle, which could have been cut in half to make a flower pot, was quickly surveyed along with other trophies, and received the death sentence. “In the bin, Bob.”"
                                            },
                                            {
                                                "example_id": "be592903-967c-4c71-bcee-631f42216baa",
                                                "sense_id": "b190caf7-a144-335a-9c7b-79901afdc924",
                                                "text": "1980 January-May, Laurence Le Guay, Cruising World, page 98,\nI quickly learned that there is a hell of a difference between tomato sauce and ketchup and that there is an even greater difference when it comes to mayonnaise: real American or the pseudo Australian — and I had always believed this to be a French concoction."
                                            },
                                            {
                                                "example_id": "5d730dea-ee42-4997-9575-1e9bdc9f865a",
                                                "sense_id": "b190caf7-a144-335a-9c7b-79901afdc924",
                                                "text": "The event was a BBQ in the peaceful and picturesque System Garden at the University of Melbourne, Parkville campus. Food was plentifil and included a variety of sausages and veggie burgers, onions, bread and tomato sauce in addition to soft drinks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
