                    {
                        "translation_id": "416a035e-b360-4fe8-ac83-65abf1fafd8f",
                        "source_entry_id": "39da3bfd-b931-3be0-9a4f-b87fa47b0353",
                        "source_sense_description": "sound in speech",
                        "target_lang_word": "ημίφωνο",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ημίφωνο",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2e5388-7c48-3674-b499-b00ed7ef7d0f",
                                        "entry_id": "b2f62ed8-409f-3c19-aec9-11fbfab38b59",
                                        "glosses": [
                                            "φθόγγος που ο τρόπος άρθρωσής του είναι μεταξύ φωνήεντος και συμφώνου. Χαρακτηριστικά ημίφωνα είναι οι φθόγγοι /ʝ/ και /w/"
                                        ],
                                        "tags": [
                                            "φωνητική",
                                            "γενικά"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f096bd44-ebc0-4977-8d90-98b786e35ebe",
                                                "sense_id": "9e2e5388-7c48-3674-b499-b00ed7ef7d0f",
                                                "text": "※ ημίφωνο - Λεξικό γλωσσολογικών όρων - Digital PanGloss, όροι στο Κέντρο Ελληνικής Γλώσσας (2006‑08)\nΦθόγγος ο οποίος βρίσκεται, ως προς τον τρόπο άρθρωσής του, ανάμεσα στα φωνήεντα και στα σύμφωνα χωρίς να μπορεί να υπαχθεί σε καμιά από τις δύο κατηγορίες. Τα ημίφωνα παράγονται με κλείσιμο της στοματικής κοιλότητας που δεν είναι ωστόσο ικανό να δημιουργήσει φραγμό ή τριβή (και επομένως δεν μπορούν να χαρακτηριστούν σύμφωνα) ούτε και επαρκές για την άρθρωση ενός καθαρού φωνήεντος. Θεωρούνται μεταβατικοί φθόγγοι, καθώς η γλώσσα μετακινείται, «γλιστρά» (glides) γρήγορα είτε από το προηγούμενο φωνήεν είτε προς το επόμενο. Τα συνηθέστερα ημίφωνα είναι το μπροστινό (ουρανικό) [j] και το πίσω (υπερωικό) [w]. H κοινή νέα ελληνική διαθέτει μόνο το μπροστινό ημίφωνο, για το οποίο υπάρχει πλέον η τάση να πραγματώνεται συμφωνικά: π.χ. παιδιά [pe'dja] > [ped'ʝa] (το σύμβολο [j] του ΔΦΑ χρησιμοποιόταν τόσο για το μπροστινό ημίφωνο όσο και για το αντίστοιχο ουρανικό σύμφωνο, μέχρι την καθιέρωση του [ʝ] για το δεύτερο). Τα αρχαία ελληνικά διέθεταν και το πίσω ημίφωνο στο οποίο αντιστοιχούσε το γράφημα Ϝ (δίγαμμα)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf6c9a4-7fa4-3ace-a920-c123463da044",
                                        "entry_id": "b2f62ed8-409f-3c19-aec9-11fbfab38b59",
                                        "glosses": [
                                            "οι φθόγγοι [i] και [u] μπορούν να μετατραπούν σε ημίφωνα όταν σε γρήγορο λόγο αποτελούν μία συλλαβή με το προηγούμενο ή με το επόμενο φωνήεν"
                                        ],
                                        "tags": [
                                            "φωνητική",
                                            "στα νέα ελληνικά"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c1802d-828e-4d98-9a7a-23307b35f593",
                                                "sense_id": "bbf6c9a4-7fa4-3ace-a920-c123463da044",
                                                "text": "ο τύπος βοήθα (προφορά /voˈiθa/ > βόηθα (προφορά /ˈvoi̯.θa/"
                                            },
                                            {
                                                "example_id": "6a997fb9-b0a5-41f3-9432-c8499b431247",
                                                "sense_id": "bbf6c9a4-7fa4-3ace-a920-c123463da044",
                                                "text": "ο αριθμός εννέα προφέρεται /eˈne.a/ > το εννιά προφέρεται /eˈɲa/"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54109c40-efb3-3f03-bda7-0a4c5bd32b93",
                                        "entry_id": "b2f62ed8-409f-3c19-aec9-11fbfab38b59",
                                        "glosses": [
                                            "τα εξακολουθητικά σύμφωνα (σ, λ, ρ, μ, ν) σε αντίθεση με τα άφωνα (ή στιγμιαία)"
                                        ],
                                        "tags": [
                                            "γραμματική",
                                            "της αρχαίας ελληνικής"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7437f4bc-fe18-4627-b324-5cbcad7eb06a",
                                                "sense_id": "54109c40-efb3-3f03-bda7-0a4c5bd32b93",
                                                "text": "Οι φθόγγοι που είναι ημίφωνα στα αρχαία ελληνικά υποδιαιρούνται (όπως παριστάνονται με γράμματα) στα υγρά λ, ρ, στα ένρινα μ, ν και στο συριστικό σ (ς). Παλαιότερα ημίφωνα: ϝ (δίγαμμα), j (jot)."
                                            },
                                            {
                                                "example_id": "ac4975d1-1e61-4b0f-9c68-1879ee47e93f",
                                                "sense_id": "54109c40-efb3-3f03-bda7-0a4c5bd32b93",
                                                "text": "Κεφάλαιο: Φθόγγοι και γράμματα - Οικονόμου, Μιχ. Χ., Γραμματική της Αρχαίας Ελληνικής Γλώσσας, Γυμνασίου Λυκείου, ΥΠΠΕΘ χ.χ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
