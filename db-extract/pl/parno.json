                                        "examples": [
                                            {
                                                "example_id": "1d05131a-dfd6-404f-95c5-e91218868d33",
                                                "sense_id": "bfc36da0-527b-3755-a68a-494d072749a1",
                                                "text": "V letním parnu se silnice rozehřály, tekl asfalt a ohýbaly se koleje."
                                            }
                                        ]
