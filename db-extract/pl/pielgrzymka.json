                                    },
                                    {
                                        "sense_id": "1c33aea2-e05c-3de5-b6c5-52bc936f3b09",
                                        "entry_id": "4cc499d5-88c8-31fa-9c1a-cfb8e9aa7a56",
                                        "glosses": [
                                            "cesta na posvátné místo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78bbafd6-aa7b-46fc-ae00-aeaf9e7ca7d1",
                                                "sense_id": "1c33aea2-e05c-3de5-b6c5-52bc936f3b09",
                                                "text": "Pouť je pro mě oslavou veškeré svobody, kterou ve svém životě mám."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68250b2-7162-328b-88ce-729c9cca909b",
                                        "entry_id": "4cc499d5-88c8-31fa-9c1a-cfb8e9aa7a56",
                                        "glosses": [
                                            "akce se zábavními atrakcemi"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17bd18f0-73ee-4dd2-a3be-5ce8d99c1500",
                        "source_entry_id": "b3ec7ecd-3658-373b-b268-aceedadaa41d",
                        "source_sense_id": "7bab547f-daa8-31bc-b499-31ea18a5a360",
                        "target_lang_word": "pèlerinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pèlerinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Voyage que fait un pèlerin vers un lieu de dévotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf88bb6c-574e-4e36-8f35-022cfdf69df4",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Autrefois on venait en pèlerinage chercher certaine huile bénite qu’on y distribuait et qui avait, disait-on, le privilège de rendre l’ouïe aux sourds."
                                            },
                                            {
                                                "example_id": "40dd5eed-859b-4215-abd8-12b6242e0a03",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Mais elle était si chancelante, ses os paraissaient si minces qu’on craignit d’abord d’aller à Braux, au pèlerinage de Saint Vincent pour la faire passer sous le châsse miraculeuse qui délie les petits pas et chasse les podagres."
                                            },
                                            {
                                                "example_id": "5b4cc815-68af-45f6-b013-0d7c4125f286",
                                                "sense_id": "b511d3c8-8333-3a95-ae60-af5bab461a8e",
                                                "text": "Mais Lourdes est à plus de mille kilomètres de Lunéville. Le risque que M. l’inspecteur d’école primaire apprît qu’un de ses instituteurs avait fait un de ces voyages que la morale laïque réprouve et qu’on appelle pèlerinage… était minime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafe1f2e-bee9-3b1a-a042-df21117deb47",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Visite à la tombe d’un saint, d’un grand homme, de morts que l’on veut honorer d’une sorte de culte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17eec480-7020-3483-b736-faa98e1dc412",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Lieu où un pèlerin va en dévotion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b3a16b0-85b4-4636-8de8-ac4389e1fe00",
                                                "sense_id": "17eec480-7020-3483-b736-faa98e1dc412",
                                                "text": "Dame de Lorette est un des plus fameux pèlerinages de la chrétienté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0c3a13-99c2-3b5b-8466-d59845c1ebac",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Ensemble des pèlerins qui se rendent en ce lieu ou qui participent à ce voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ce0c788-f1b0-46b2-bc8c-8ec7aeffa851",
                                                "sense_id": "1a0c3a13-99c2-3b5b-8466-d59845c1ebac",
                                                "text": "Cette soirée, tout le pèlerinage se retrouve aux lieux saints et se mêle aux pèlerins suisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e8220fd-1240-3736-a922-c94840adc32b",
                                        "entry_id": "6dbb6a8b-8fa9-37ba-be4e-b3015a94bcb1",
                                        "glosses": [
                                            "Tout voyage vers un lieu porteur de sens : familial, sentimental, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce7689db-bc48-4ee7-9516-40095b21efb9",
                                                "sense_id": "9e8220fd-1240-3736-a922-c94840adc32b",
                                                "text": "Mais demain, jour des Morts, c’est un pèlerinage que j’accomplirai respectueusement, tout en pensant à la belle Angélique de Longueval."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
