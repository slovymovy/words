                                        "glosses": [
                                            "bez wydarzeń, które mogłyby zakłócić spokój"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a7f731-ab89-4829-b3b6-f838cb2c2465",
                                                "sense_id": "aa0cb4bb-e507-3e26-8988-3813defbf006",
                                                "text": "W naturze spokojnie było, cicho, niekiedy tylko listek zwiędły, oderwany od drzewa pierwszym podmuchem jesieni, unosił się w powietrzu sam jeden i smętnie opadał na ziemię."
                                            },
                                            {
                                                "example_id": "ee12fbf9-748e-4f0c-9d9c-03dcc44e4c4a",
                                                "sense_id": "aa0cb4bb-e507-3e26-8988-3813defbf006",
                                                "text": "Czas upływał nam spokojnie i leniwie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "c61545a7-1d75-3dea-8bdc-744e359b0ef5",
                                        "entry_id": "e779cb83-f2be-3ca3-b35d-e9274a3a418b",
                                        "glosses": [
                                            "monotonnie, jednostajnie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52469d7f-1727-4f9f-97bc-8dbbecc4b7e6",
                                                "sense_id": "c61545a7-1d75-3dea-8bdc-744e359b0ef5",
                                                "text": "Drzewa szumiały spokojnie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "f863637b-1955-3b02-85b4-78734c315678",
                                        "entry_id": "e779cb83-f2be-3ca3-b35d-e9274a3a418b",
                                        "glosses": [
                                            "bez problemu, z łatwością, na pewno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4085c347-aa1a-4aad-8d8d-a386d572c674",
                                                "sense_id": "f863637b-1955-3b02-85b4-78734c315678",
                                                "text": "Spokojnie zdążysz, masz jeszcze godzinę czasu."
                                            }
                                        ],
