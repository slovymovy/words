{
    "word_family": [
        "holder",
        "holding",
        "behold",
        "uphold",
        "withhold",
        "threshold",
        "stronghold",
        "household"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e78adb5-8097-34b4-a631-b30c5bbb19b0",
                    "sense_definition": "To grasp or grip something with your hands or arms.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>hold</w> the pencil like this to improve your handwriting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>держите</w> карандаш вот так, чтобы улучшить свой почерк."
                            }
                        },
                        {
                            "text": "You should <w>hold</w> tight to the railing while walking down the steep stairs.",
                            "target_lang_translations": {
                                "ru": "Вам следует крепко <w>держаться</w> за перила, когда спускаетесь по крутой лестнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "grasp",
                        "grip",
                        "clutch"
                    ],
                    "antonyms": [
                        "release"
                    ],
                    "common_phrases": [
                        "hold tight",
                        "hold hands",
                        "hold onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать или удерживать что-либо руками или в руках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держать",
                                "target_lang_sense_clarification": "в руках"
                            },
                            {
                                "target_lang_word": "удерживать",
                                "target_lang_sense_clarification": "не давать упасть или вырваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51e3fb7d-5114-3ac9-91cd-8d69e2f1e4ce",
                    "sense_definition": "To contain, store, or have the capacity for something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "containment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This small package <w>holds</w> six bottles of water for the trip.",
                            "target_lang_translations": {
                                "ru": "Эта маленькая упаковка <w>вмещает</w> шесть бутылок воды для поездки."
                            }
                        },
                        {
                            "text": "The new stadium can <w>hold</w> up to fifty thousand excited fans.",
                            "target_lang_translations": {
                                "ru": "Новый стадион может <w>вместить</w> до пятидесяти тысяч восторженных болельщиков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold water",
                        "hold capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержать, хранить или иметь вместимость для чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмещать",
                                "target_lang_sense_clarification": "иметь объем"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "внутри себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8de25c76-cef0-3413-9b8c-2ad505729078",
                    "sense_definition": "To organise or conduct an event, meeting, or election.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local elections will be <w>held</w> on the first Sunday of next month.",
                            "target_lang_translations": {
                                "ru": "Местные выборы будут <w>проведены</w> в первое воскресенье следующего месяца."
                            }
                        },
                        {
                            "text": "They decided to <w>hold</w> a meeting to discuss the new project details.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>провести</w> собрание, чтобы обсудить детали нового проекта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a meeting",
                        "hold an event",
                        "hold a trial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или проводить мероприятие, встречу или выборы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "мероприятие или собрание"
                            },
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "организовывать событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a725b29-d52d-3d4f-b974-897acbabecf3",
                    "sense_definition": "To reserve something for someone, such as a seat or a room.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "reservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you please <w>hold</w> a table for us at seven o'clock tonight?",
                            "target_lang_translations": {
                                "ru": "Не могли бы вы <w>забронировать</w> для нас столик на семь часов вечера?"
                            }
                        },
                        {
                            "text": "The store will <w>hold</w> the dress for you until tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Магазин <w>придержит</w> платье для вас до завтрашнего утра."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a table",
                        "hold a reservation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резервировать что-либо для кого-то, например, место или номер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бронировать",
                                "target_lang_sense_clarification": "резервировать"
                            },
                            {
                                "target_lang_word": "придержать",
                                "target_lang_sense_clarification": "сохранить для кого-то на время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf911949-c13c-3aaf-b453-c2b88cd76c93",
                    "sense_definition": "To cause someone or something to wait or be delayed.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>hold</w> the elevator for me while I grab my bag.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>придержите</w> лифт для меня, пока я заберу свою сумку."
                            }
                        },
                        {
                            "text": "The heavy traffic will <w>hold</w> us up for at least twenty minutes.",
                            "target_lang_translations": {
                                "ru": "Сильные пробки <w>задержат</w> нас как минимум на двадцать минут."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold the elevator",
                        "hold the line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо или что-либо ждать или задерживаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "препятствовать движению или вызывать ожидание"
                            },
                            {
                                "target_lang_word": "придержать",
                                "target_lang_sense_clarification": "не давать уйти или закрыться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c569dccb-8989-3651-b74a-65aefb3bcb2f",
                    "sense_definition": "To maintain a particular opinion or belief; to consider or opine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>holds</w> that passive index funds are better than actively managed ones.",
                            "target_lang_translations": {
                                "ru": "Она <w>считает</w>, что пассивные индексные фонды лучше активно управляемых."
                            }
                        },
                        {
                            "text": "Many people <w>hold</w> the view that education should be free for everyone.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>придерживаются</w> мнения, что образование должно быть бесплатным для всех."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a view",
                        "hold a belief",
                        "hold the opinion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придерживаться определенного мнения или убеждения; считать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "мнения или взглядов"
                            },
                            {
                                "target_lang_word": "считать",
                                "target_lang_sense_clarification": "полагать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "320f7c3e-076e-302c-a990-24fefe768fc4",
                    "sense_definition": "To remain valid, true, or applicable in a certain situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The same rule <w>holds</w> in land as well as all other commodities.",
                            "target_lang_translations": {
                                "ru": "Это же правило <w>действует</w> как для земли, так и для всех остальных товаров."
                            }
                        },
                        {
                            "text": "We need to check if this theory still <w>holds</w> true after the experiment.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проверить, <w>остается</w> ли эта теория верной после эксперимента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold true",
                        "hold good"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться в силе, быть верным или применимым в определенной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставаться в силе",
                                "target_lang_sense_clarification": "о правиле или законе"
                            },
                            {
                                "target_lang_word": "быть верным",
                                "target_lang_sense_clarification": "о теории или утверждении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75add2f6-1c0a-34d7-aec4-ea94ddc0b482",
                    "sense_definition": "To request that a specific ingredient be omitted from a food or drink order.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a ham and cheese sandwich, but please <w>hold</w> the mustard.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел сэндвич с ветчиной и сыром, но, пожалуйста, <w>без</w> горчицы."
                            }
                        },
                        {
                            "text": "He ordered a large pepperoni pizza and asked them to <w>hold</w> the onions.",
                            "target_lang_translations": {
                                "ru": "Он заказал большую пиццу пепперони и попросил <w>не класть</w> лук."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold the mustard",
                        "hold the onions"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in restaurants and diners."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просьба исключить определенный ингредиент из заказа еды или напитков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "не добавлять ингредиент"
                            },
                            {
                                "target_lang_word": "не класть",
                                "target_lang_sense_clarification": "исключить из блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "870732ba-d375-3992-8ec0-149e32be9271",
                    "sense_definition": "To be in possession of illegal drugs, especially for the purpose of selling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The undercover officer asked the suspect if he was <w>holding</w> any product.",
                            "target_lang_translations": {
                                "ru": "Офицер под прикрытием спросил подозреваемого, есть ли у него <w>при себе</w> товар."
                            }
                        },
                        {
                            "text": "He was arrested because the police found out he was <w>holding</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Его арестовали, потому что полиция узнала, что он <w>торгует</w> (имеет при себе) в парке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Drug culture terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь при себе нелегальные наркотики, особенно с целью продажи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь при себе",
                                "target_lang_sense_clarification": "о запрещенных веществах"
                            },
                            {
                                "target_lang_word": "хранить",
                                "target_lang_sense_clarification": "незаконно владеть"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc7bc906-ec15-3a56-a7d9-a7faed44b4e6",
                    "sense_definition": "A physical grasp or grip on something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must keep a firm <w>hold</w> on the handlebars while riding the bike.",
                            "target_lang_translations": {
                                "ru": "Вы должны крепко <w>держаться</w> за руль во время езды на велосипеде."
                            }
                        },
                        {
                            "text": "He lost his <w>hold</w> on the rope and fell into the water.",
                            "target_lang_translations": {
                                "ru": "Он <w>выпустил</w> веревку из рук и упал в воду."
                            }
                        }
                    ],
                    "synonyms": [
                        "grip",
                        "grasp",
                        "clutch"
                    ],
                    "antonyms": [
                        "release"
                    ],
                    "common_phrases": [
                        "firm hold",
                        "get a hold",
                        "lose one's hold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое удержание или захват чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "сила удержания"
                            },
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "способ удержания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a435dca8-a643-36f2-9f82-0dc2eeab8756",
                    "sense_definition": "The cargo area of a ship or an aircraft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched our luggage being loaded into the <w>hold</w> of the plane.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как наш багаж загружают в <w>трюм</w> самолета."
                            }
                        },
                        {
                            "text": "The ship's <w>hold</w> was filled with grain destined for the foreign port.",
                            "target_lang_translations": {
                                "ru": "Корабельный <w>трюм</w> был заполнен зерном, предназначенным для иностранного порта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cargo hold",
                        "ship's hold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грузовой отсек корабля или самолета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трюм",
                                "target_lang_sense_clarification": "на корабле"
                            },
                            {
                                "target_lang_word": "грузовой отсек",
                                "target_lang_sense_clarification": "в самолете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a1e731c-5d14-374d-bed8-dfbb0adb919d",
                    "sense_definition": "A state of waiting on a telephone line until someone is available to speak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "telephony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was put on <w>hold</w> for twenty minutes before a representative answered.",
                            "target_lang_translations": {
                                "ru": "Меня заставили <w>ждать</w> на линии двадцать минут, прежде чем ответил представитель."
                            }
                        },
                        {
                            "text": "The company uses pleasant music to entertain customers while they are on <w>hold</w>.",
                            "target_lang_translations": {
                                "ru": "Компания использует приятную музыку, чтобы развлечь клиентов, пока они находятся в режиме <w>ожидания</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on hold",
                        "put on hold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние ожидания на телефонной линии до момента ответа оператора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "режим ожидания",
                                "target_lang_sense_clarification": "на телефоне"
                            },
                            {
                                "target_lang_word": "удержание вызова",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ae85fa-eafa-3360-871c-e1757ba9dca9",
                    "sense_definition": "Power, influence, or control over someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law no longer has a <w>hold</w> on you, and you are free to go.",
                            "target_lang_translations": {
                                "ru": "Закон больше не имеет над вами <w>власти</w>, и вы свободны."
                            }
                        },
                        {
                            "text": "War has a strong <w>hold</w> on our cultural imagination as an inevitable force.",
                            "target_lang_translations": {
                                "ru": "Война имеет сильное <w>влияние</w> на наше культурное воображение как неизбежная сила."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a hold on",
                        "strong hold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Власть, влияние или контроль над кем-либо или чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "власть",
                                "target_lang_sense_clarification": "контроль над кем-то"
                            },
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "воздействие на мысли или чувства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4c1dcce-8baf-3e90-812c-9a79f60319cb",
                    "sense_definition": "Gracious, friendly, or faithful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the proper moment, I stepped forward with a gay heart and a <w>hold</w> one.",
                            "target_lang_translations": {
                                "ru": "В нужный момент я шагнул вперед с веселым и <w>преданным</w> сердцем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Милостивый, дружелюбный или верный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "верный"
                            },
                            {
                                "target_lang_word": "милостивый",
                                "target_lang_sense_clarification": "доброжелательный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}