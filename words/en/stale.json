                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устаревший",
                                "target_lang_sense_clarification": "о данных или кэше"
                            },
                            {
                                "target_lang_word": "неактуальный",
                                "target_lang_sense_clarification": "об информации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14851296-4dba-3690-b9ba-ccaaa00c842b",
                    "sense_definition": "Having been in place for some time; not recent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers should be careful when approaching a <w>stale</w> green light that might change soon.",
                            "target_lang_translations": {
                                "ru": "Водителям следует быть осторожными при приближении к <w>давно горящему</w> зеленому сигналу светофора, который может скоро измениться."
                            }
                        },
                        {
                            "text": "The trail was difficult to follow because the scent had become <w>stale</w> over several hours.",
                            "target_lang_translations": {
                                "ru": "Идти по следу было трудно, так как запах за несколько часов успел <w>ослабеть</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stale green light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий уже некоторое время; несвежий, старый (о следах, сигналах)."
                    },
                    "translations": {
                        "ru": [
