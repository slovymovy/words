                ],
                "senses": [
                    {
                        "sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                        "entry_id": "4dd6544d-acb9-3cd0-a20c-69d5e2e1e515",
                        "glosses": [
                            "Action de dérailler ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c38b451-6e2c-4d28-8b63-3f43879ebe47",
                                "sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                                "text": "Il s’est produit un déraillement sur telle ligne."
                            },
                            {
                                "example_id": "8ed9c349-f406-4234-9da4-e2a04dbf89a9",
                                "sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                                "text": "Victime d’un déraillement."
                            },
                            {
                                "example_id": "188f70ec-71db-40af-bbba-5f232f1359f3",
                                "sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                                "text": "D’une manière générale, on peut dire que les causes ayant provoqué le déraillement sont multiples, et c’est le cumul de leurs effets respectifs qui amène l’accident."
                            },
                            {
                                "example_id": "92503ee0-0c19-4d82-afd8-e1bbd411524f",
                                "sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                                "text": "À cette époque on disait qu’en France, il n’y avait plus que deux services qui fonctionnaient bien : celui du chemin de fer et celui du déraillement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bed77ec2-3221-40f4-a70b-a5daa02c10c1",
                        "source_entry_id": "4dd6544d-acb9-3cd0-a20c-69d5e2e1e515",
                        "source_sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                        "target_lang_word": "Entgleisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entgleisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e51c203e-98cb-330b-9e34-0057f871ef3b",
                                        "entry_id": "82552a66-78c0-3064-986a-a10526bc01a5",
                                        "glosses": [
                                            "Verunglücken eines Schienenfahrzeugs dadurch, dass es aus den Schienen springt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f4b2e7-3989-471e-9f55-46078e576471",
                                                "sense_id": "e51c203e-98cb-330b-9e34-0057f871ef3b",
                                                "text": "„»Wenige Minuten vor der Entgleisung erhielt der Lokführer einen Anruf auf seinem Diensttelefon«, teilte das Gericht mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                        "entry_id": "82552a66-78c0-3064-986a-a10526bc01a5",
                                        "glosses": [
                                            "Verletzung einer sozialen Norm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6f34186-6e44-4b59-a8ac-80b99d8e52ad",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„Dass er es geschafft hat, sich nach derartigen Entgleisungen an der Macht zu halten, sorgte bei vielen Menschen auf dem Kontinent für echtes Entsetzen.“"
                                            },
                                            {
                                                "example_id": "5206cc32-8d8f-4b5c-ad6d-b9380ae6dbcb",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„Es ist bei weitem nicht seine [Donald Trumps] erste rassistische Entgleisung – und er ist auch bei weitem nicht der einzige Politiker, der sich solch rassistischer Sprache bedient.“"
                                            },
                                            {
                                                "example_id": "78fdf0e9-8483-4cd3-972e-97cac148091a",
                                                "sense_id": "2be9639e-e4c5-318a-b638-bc833046b8f0",
                                                "text": "„‚[…] Dass der Hohe Repräsentant in Bosnien und Herzegowina, Christian Schmidt, nun in Budapest die Ereignisse in Srebrenica als eine ‚genocide-style situation‘ beschreibt, ist in mildester Interpretation eine schwere rhetorische Entgleisung.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa274986-4599-4e76-8129-4aafe51f390e",
                        "source_entry_id": "4dd6544d-acb9-3cd0-a20c-69d5e2e1e515",
                        "source_sense_id": "c9f66a67-6287-34a8-9a5d-f4e8689156ec",
                        "target_lang_word": "derailment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derailment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66ed180f-0ed1-3163-ad31-b01f8bdb07dc",
                                        "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                                        "glosses": [
                                            "The action of a locomotive or train leaving the rails along which it runs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e9af55-4b8d-411c-8446-5d96a6f3805a",
                                                "sense_id": "66ed180f-0ed1-3163-ad31-b01f8bdb07dc",
                                                "text": "The length ganger saw the train passing with the van derailed and promptly telephoned the Sandbach signalman, who restored his signals to danger, but not in time to stop the train before the final derailment occurred."
                                            },
                                            {
                                                "example_id": "7b8aa8ee-50fe-4e98-a5a5-436ed1e7fde2",
                                                "sense_id": "66ed180f-0ed1-3163-ad31-b01f8bdb07dc",
                                                "text": "In retrospect, it was small wonder that Railtrack found its finances under pressure, as with ever increasing demand there was an inevitable effect on infrastructure renewals. Matters came to a head with the Hatfield accident on October 17 2000, when there was a high-speed derailment as a result of deferred track maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ba83fc-2874-3fa7-9cc9-82f521e91165",
                                        "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                                        "glosses": [
                                            "An instance of diverting a conversation or debate from its original topic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d01e33de-7520-3b48-b340-aca83b1611ee",
                                        "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                                        "glosses": [
                                            "An instance of thwarting or frustrating something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed9a04ec-3ba5-430c-94bf-fd46cde786d4",
                                                "sense_id": "d01e33de-7520-3b48-b340-aca83b1611ee",
                                                "text": "But when the second stage set in, in which man became preponderantly self-conscious, he inevitably set about deflecting sex-activities to his own private pleasure and advantage; he employed his budding intellect in scheming the derailment of passion and desire from tribal needs and, Nature's uses to the poor details of his own gratification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49be30dc-c476-31bc-848d-955197b7fc29",
                                        "entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                                        "glosses": [
                                            "A pattern of discourse (in speech or writing) that is a sequence of unrelated or only remotely related ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
