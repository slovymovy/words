                                "target_senses": [
                                    {
                                        "sense_id": "8e0b40a6-daf4-3aa8-8ec2-15535e419f10",
                                        "entry_id": "48aae0f4-cdca-3e1d-97c8-6d38a650981a",
                                        "glosses": [
                                            "das Eintreiben, der Einzug von fälligen Geldforderungen (bei Banken, Behörden, Betrieben)"
                                        ],
                                        "tags": [
                                            "Bankwesen; Finanzwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63911917-1b96-4e7a-a65e-c2ff97dca87e",
                                                "sense_id": "8e0b40a6-daf4-3aa8-8ec2-15535e419f10",
                                                "text": "Das anwaltliche Inkasso unterscheidet sich grundsätzlich vom Inkasso durch Inkassounternehmen."
                                            },
                                            {
                                                "example_id": "c86c56d6-4700-405a-a8c1-77ec89b7bef6",
                                                "sense_id": "8e0b40a6-daf4-3aa8-8ec2-15535e419f10",
                                                "text": "Die Kosten des Inkassos durch das Inkassounternehmen stellen als Verzugsschaden die Inkassokosten dar und sind vom Schuldner zu erstatten."
                                            }
