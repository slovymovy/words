                                "example_id": "676bda12-4324-4bee-868b-778c14198cc8",
                                "sense_id": "8ad1a3ff-6d54-37d3-bf05-372b7bf7f98a",
                                "text": "Naast hem liep zijn vriend Nesvitski, een lange, buitengewoon gezette stafofficier met een vriendelijk, glimlachend, knap gezicht en vochtige ogen."
                            },
                            {
                                "example_id": "18ae4950-de42-4b47-a4e7-a31b8aaa36c6",
                                "sense_id": "8ad1a3ff-6d54-37d3-bf05-372b7bf7f98a",
                                "text": "Eind 2013 keerde Tuinman als majoor terug bij Defensie. Hij werkt nu als stafofficier bij de afdeling Bestuursondersteuning van het Commando Landstrijdkrachten in Utrecht."
                            }
                        ]
