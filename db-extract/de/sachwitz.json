                "senses": [
                    {
                        "sense_id": "c07743d7-5a86-3a57-a448-6efb5b031b0f",
                        "entry_id": "1fef7b72-6f6d-3cac-92c1-bba2f0d72205",
                        "glosses": [
                            "Witz, der sich einem bestimmten Sachverhalt widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7845a1d4-571e-46c6-8520-e7df31103884",
                                "sense_id": "c07743d7-5a86-3a57-a448-6efb5b031b0f",
                                "text": "„Auch der politische Sachwitz, der politische Themen oder Ansichten, politisches Handeln oder Konstellationen in den Mittelpunkt stellt, ist verhältnismäßig selten.“"
                            },
                            {
                                "example_id": "6e1bae72-f3be-40cf-812f-f6a3c65158b7",
                                "sense_id": "c07743d7-5a86-3a57-a448-6efb5b031b0f",
                                "text": "„Der Lügenwitz ist mehr Sachwitz als Wortwitz.“"
                            },
                            {
                                "example_id": "016c60ee-8861-4e00-a3cb-b6fa1e2107d2",
                                "sense_id": "c07743d7-5a86-3a57-a448-6efb5b031b0f",
                                "text": "„Witze können danach in die Kategorien Sprach- und Sachwitze differenziert werden.“"
                            },
                            {
                                "example_id": "5dac4e6c-930a-4342-b847-fdc7f0191a2a",
                                "sense_id": "c07743d7-5a86-3a57-a448-6efb5b031b0f",
                                "text": "„Trotz dieser grundsätzlichen Sprachgebundenheit des Witzes, die man sehen muss, kann man aber unterscheiden zwischen Sprachwitzen und solchen, die dies nicht sind: Sprachwitze also und Sachwitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
