                                "target_senses": [
                                    {
                                        "sense_id": "898cbf43-d699-346c-a60a-5c10b0d81284",
                                        "entry_id": "8ff8a27d-1b97-3576-a143-b10161c7da03",
                                        "glosses": [
                                            "Unable (or partially able) to hear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4733ffed-62d0-448e-b823-fbac18514312",
                                                "sense_id": "898cbf43-d699-346c-a60a-5c10b0d81284",
                                                "text": "My brother has been deaf since sustaining injuries in the war."
                                            },
                                            {
                                                "example_id": "aacbe7b3-a908-4794-bd01-faf00c83e75a",
                                                "sense_id": "898cbf43-d699-346c-a60a-5c10b0d81284",
                                                "text": "It's important for TV shows to provide closed captioning for the deaf."
                                            },
                                            {
                                                "example_id": "be70090f-2ad3-4f33-8fde-75c17a503be4",
                                                "sense_id": "898cbf43-d699-346c-a60a-5c10b0d81284",
                                                "text": "Come on my right hand, for this ear is deaf."
                                            },
                                            {
                                                "example_id": "7dfb19be-d776-455d-b18e-a0aaf0807bfc",
                                                "sense_id": "898cbf43-d699-346c-a60a-5c10b0d81284",
                                                "text": "Deaf vvith the noyſe I took my haſty flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e9e11b8-e12b-3844-8033-74295cba931f",
                                        "entry_id": "8ff8a27d-1b97-3576-a143-b10161c7da03",
                                        "glosses": [
                                            "Unwilling to listen or be persuaded; determinedly inattentive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd849794-ad2d-4c9d-aff3-edaf0a23fcd7",
                                                "sense_id": "2e9e11b8-e12b-3844-8033-74295cba931f",
                                                "text": "Those people are deaf to reason."
                                            },
                                            {
                                                "example_id": "b473ffbd-7cc6-4ff8-8e3c-e61c8d0907c0",
                                                "sense_id": "2e9e11b8-e12b-3844-8033-74295cba931f",
                                                "text": "O, that men's ears should be / To counsel deaf, but not to flattery!"
                                            },
                                            {
                                                "example_id": "df8688ae-f3b1-4f90-9c0a-621847e12fb3",
                                                "sense_id": "2e9e11b8-e12b-3844-8033-74295cba931f",
                                                "text": "The curioſity of the lady was highly inflamed, to know the hiſtory of the parrot's tranſmigration, which ſhe intreated the bird with all her eloquence to relate; but he preſented a deaf ear to her importunity, and, like a painted nightingale, remained ſilent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590494b6-1b6b-359b-9243-f88abbf42bae",
                                        "entry_id": "8ff8a27d-1b97-3576-a143-b10161c7da03",
                                        "glosses": [
                                            "Of or relating to the community of deaf people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15322bb-0e47-4ced-8332-830611d53ce2",
                                                "sense_id": "590494b6-1b6b-359b-9243-f88abbf42bae",
                                                "text": "The best place to fight Hollywood deafism is in our deaf schools. If we give our children understanding and appreciation of our rich culture and sign language, the students will gain a deaf heritage and become more creative, more aware, and more assertive global deaf citizens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b3944c6-7208-383f-8d85-ffd41be17871",
                                        "entry_id": "8ff8a27d-1b97-3576-a143-b10161c7da03",
                                        "glosses": [
                                            "Obscurely heard; stifled; deadened."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee76a8c1-9db4-4e8e-806c-b21d052fe0dc",
                                                "sense_id": "9b3944c6-7208-383f-8d85-ffd41be17871",
                                                "text": "A deaf murmur through the squadron went."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caa6f204-c212-3cc1-8183-24840063d5cd",
                                        "entry_id": "8ff8a27d-1b97-3576-a143-b10161c7da03",
                                        "glosses": [
                                            "Decayed; tasteless; useless."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b8784c2-ac07-4ab2-81aa-f6252296df52",
                                                "sense_id": "caa6f204-c212-3cc1-8183-24840063d5cd",
                                                "text": "a deaf nut; deaf corn"
                                            },
                                            {
                                                "example_id": "7bf4f5f0-b446-42b3-b5e6-f8fec4ef5a58",
                                                "sense_id": "caa6f204-c212-3cc1-8183-24840063d5cd",
                                                "text": "If the season be unkindly and intemperate, they [peppers] will catch a blast; and then the seeds will be deafe, void, light, and naught."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff5515dd-b849-3692-b240-17265cc56b19",
                                        "entry_id": "a3fba768-3ac8-33c9-bb74-1d02ed078be9",
                                        "glosses": [
                                            "A deaf person."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d72288-4a32-49f6-949d-5f913c28db78",
                                                "sense_id": "ff5515dd-b849-3692-b240-17265cc56b19",
                                                "text": "Among the second group of philanthropic educational institutions the institutes for the deafs and dumbs must be mentioned."
                                            },
                                            {
                                                "example_id": "689d49d3-77ad-4cf2-8e9a-f0772fcf929d",
                                                "sense_id": "ff5515dd-b849-3692-b240-17265cc56b19",
                                                "text": "Negotiations for South Vietnam's political future and the enforcement of cease-fire between two sides progressed like a conversation between two deafs."
                                            },
                                            {
                                                "example_id": "5353e2a9-9e9f-4d46-8e42-34e10f09ec19",
                                                "sense_id": "ff5515dd-b849-3692-b240-17265cc56b19",
                                                "text": "\"I work with the blind mostly. Some deafs too,\" I told her."
                                            },
                                            {
                                                "example_id": "bd5340f3-bbe8-456f-a007-9c6309fcf1d2",
                                                "sense_id": "ff5515dd-b849-3692-b240-17265cc56b19",
                                                "text": "Two deafs did not always make deaf babies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "deaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1cd9e0-c18f-3dd7-b792-826f78eabb17",
                                        "entry_id": "494093b4-a456-3f2f-afd3-569a22bc97f4",
                                        "glosses": [
                                            "To deafen."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cdadc45-255b-4aee-8f74-e1400bcc7c6c",
                                                "sense_id": "ef1cd9e0-c18f-3dd7-b792-826f78eabb17",
                                                "text": "It is enough, my hearing shall be punish'd With what shall happen, -- 'gainst the which there is No deafing -- but to hear, not taint mine eye With dread sights that it may shun."
                                            },
                                            {
                                                "example_id": "b8cde600-18b7-4ca3-9705-f1700216b984",
                                                "sense_id": "ef1cd9e0-c18f-3dd7-b792-826f78eabb17",
                                                "text": "Svvift as a VVhirl-vvind to the Nurſe he flyes; / And deafs his ſtormy Subjects vvith his cries."
                                            },
                                            {
                                                "example_id": "d64a170e-3a16-4f28-9790-1175c54d9f6e",
                                                "sense_id": "ef1cd9e0-c18f-3dd7-b792-826f78eabb17",
                                                "text": "Shall we, I say, that have been so long civil and wealthy in peace, famous and invincible in war, fortunate in both, we that have been ever able to aid any of our neighbours (but never deafed any of their ears with any of our supplications for assistance) shall we, I say, without blushing, abase ourselves so far, as to imitate these beastly Indians, slaves to the Spaniards, refuse to the world, and as yet aliens from the holy covenant of God?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
