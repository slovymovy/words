                            {
                                "target_lang_word": "соцзащита",
                                "target_lang_sense_clarification": "органы или учреждения социальной защиты"
                            },
                            {
                                "target_lang_word": "опека",
                                "target_lang_sense_clarification": "разг. органы опеки и попечительства"
                            }
                        ]
                    }
                }
            ]
        },
