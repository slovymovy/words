                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Roes</w> jij ook zo snel van die sterke drank?",
                            "target_lang_translations": {
                                "en": "Do you also <w>get intoxicated</w> so quickly from that strong drink?"
                            }
                        },
                        {
                            "text": "Waarom <w>roes</w> je zo na dat ene drankje?",
                            "target_lang_translations": {
                                "en": "Why do you <w>get so dazed</w> after just that one drink?"
                            }
                        }
                    ],
                    "traits": [
