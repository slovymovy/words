                        "entry_id": "7d90b5d7-df40-3ab6-bb45-9e2acde96f42",
                        "glosses": [
                            "The quality of being in tune with something"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b172ed6a-4b5d-4f7c-8e12-a26575d1eaa3",
                                "sense_id": "0c4f87f0-6cff-3255-be5d-b7f7332b1389",
                                "text": "We read Izaak Walton for his tone, for his perfect attunement to the quiet streams and flowered meadows and bosky hills of the Thames valley long ago."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9765ac3-27f4-3f01-958f-0264ef0f4e0a",
                        "entry_id": "7d90b5d7-df40-3ab6-bb45-9e2acde96f42",
                        "glosses": [
                            "The process of attuning or becoming attuned"
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "65c0a3e6-7627-4032-ade5-e3677a333592",
                                "sense_id": "e9765ac3-27f4-3f01-958f-0264ef0f4e0a",
                                "text": "Deford's bio embodies one of the most perverse notions of modernity, namely that homosexuality is unmasculine and therefore incompatible with the manly attunement of body and spirit that is called for in athletics."
                            },
                            {
                                "example_id": "e9ef540c-5d7f-48c2-bfce-363c32266a39",
                                "sense_id": "e9765ac3-27f4-3f01-958f-0264ef0f4e0a",
                                "text": "My attunement to this power is accomplished."
                            }
                        ]
                    }
