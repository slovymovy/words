            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81b2896b-cfe3-36b9-84f6-627b1473fec0",
                    "sense_definition": "Quitter ou abandonner un lieu en grand nombre ou de façon durable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'été, les habitants <w>désertent</w> la ville pour aller sur la côte."
                        },
                        {
                            "text": "Quand la pluie a commencé à tomber, la foule a rapidement <w>déserté</w> le parc."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "déserter la ville",
                        "déserter les rues"
                    ]
                },
                {
                    "sense_id": "9c82d615-f24f-3d25-984e-190839b24b89",
                    "sense_definition": "Abandonner illégalement son poste militaire ou ses obligations dans les forces armées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce soldat a décidé de <w>déserter</w> l'armée pour ne pas participer aux combats."
                        },
                        {
                            "text": "Pendant cette guerre éprouvante, plusieurs recrues ont <w>déserté</w> leur régiment en pleine nuit."
                        }
                    ],
                    "synonyms": [
                        "fuir"
                    ],
                    "common_phrases": [
                        "déserter l'armée",
                        "déserter son poste"
                    ]
                },
                {
                    "sense_id": "74efb1a0-9182-3c53-9098-776a7232b788",
                    "sense_definition": "Cesser de soutenir ou renoncer à une cause, un parti politique ou un engagement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la crise interne, de nombreux militants ont choisi de <w>déserter</w> le parti."
                        },
                        {
                            "text": "Il est accusé d'avoir <w>déserté</w> la cause qu'il défendait depuis tant d'années."
                        }
                    ],
                    "synonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "déserter un parti",
                        "déserter une cause"
                    ]
                }
            ]
        }
    ]
