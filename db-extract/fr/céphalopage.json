                        "glosses": [
                            "Monstre formé de deux individus soudés par le front de l’un et l’occiput de l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890181dc-2443-4262-bef2-56ccb4489823",
                                "sense_id": "7712f5b3-159c-36a0-a9a1-5e8145ea0c9e",
                                "text": "Un céphalopage, et de même un pygopage, peuvent, par un simple changement de situation, placer leurs corps bout à bout, ou bien l’un à côté de l’autre, ou même encore perpendiculairement l’un à l’autre, comme je m’en suis assuré depuis par l’examen d’un céphalopage."
                            }
                        ]
