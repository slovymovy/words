                "senses": [
                    {
                        "sense_id": "01d7da13-ef42-36ae-9451-24ff17cc1ad8",
                        "entry_id": "1748312f-785a-3968-803b-d694ba1ca80f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным самшит"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77210533-2b20-4f12-b3d8-2156d735e44b",
                                "sense_id": "01d7da13-ef42-36ae-9451-24ff17cc1ad8",
                                "text": "На лацкане пиджака виднеется орден Красного Знамени, а на локте висит жёлтая самшитовая палка, купленная в прошлом году в Сочи."
                            },
                            {
                                "example_id": "864cd8f5-2da2-46a2-897c-858cce6c3545",
                                "sense_id": "01d7da13-ef42-36ae-9451-24ff17cc1ad8",
                                "text": "Я сидел по-турецки в самшитовом кресле (к запахам дома прибавлялся аромат самшита!) и читал книги Гиацинтова."
                            }
                        ]
                    }
