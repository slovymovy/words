                    {
                        "translation_id": "377dca4a-06a6-402b-8bc4-eb9b0aad5254",
                        "source_entry_id": "e0628a72-e6a0-3caa-b0ca-4e9e331e81d8",
                        "source_sense_id": "0ea34131-5849-3d6e-99b3-ea2c00f87cc2",
                        "source_sense_description": "het geraamte van de borst",
                        "target_lang_word": "Brustkorb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brustkorb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b4210b-af6d-3392-87d3-05891b5cc71f",
                                        "entry_id": "99f4ef21-ec03-3d9b-ad30-8376a56a92b1",
                                        "glosses": [
                                            "ein bei Wirbeltieren (einschließlich des Menschen) ausgebildetes Knochengerüst, welches aus den Rippen, der oberen Wirbelsäule und dem Brustbein besteht und zur Umschließung des Herzens und der Lunge dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b35f174-8c12-4a5c-94d8-4ea050dfbfde",
                                                "sense_id": "40b4210b-af6d-3392-87d3-05891b5cc71f",
                                                "text": "„Da habe ich eine Webseite gefunden, die sich auf 'Probemzonen' der Männer spezialisiert hat. Da braucht man nur auf die Oberarme, den Brustkorb, die Hüfte oder sonst etwas in der Grafik klicken … zack, schon ist die Lösung da.“"
                                            },
                                            {
                                                "example_id": "e8bebda6-5488-4189-ab61-0ce4e056a24b",
                                                "sense_id": "40b4210b-af6d-3392-87d3-05891b5cc71f",
                                                "text": "»Den Brustkorb hat es ihm sehr stark zusammengedrückt, weshalb er keine Luft mehr kriegte«, sagt Hoppler weiter."
                                            },
                                            {
                                                "example_id": "aae3bff7-9d75-4d65-9453-9ec6fb74ed35",
                                                "sense_id": "40b4210b-af6d-3392-87d3-05891b5cc71f",
                                                "text": "„Mir kam es so vor, als juckte mir der Hintern bis zum Brustkorb.“"
                                            },
                                            {
                                                "example_id": "40ae980b-f047-4602-a656-13a23b806732",
                                                "sense_id": "40b4210b-af6d-3392-87d3-05891b5cc71f",
                                                "text": "„Ein langes Schweigen folgte, und Sylvias Herz pochte so heftig, dass es ihr fast den Brustkorb sprengte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "427af8fe-5b2e-409b-880a-da4b0f02292a",
                        "source_entry_id": "e0628a72-e6a0-3caa-b0ca-4e9e331e81d8",
