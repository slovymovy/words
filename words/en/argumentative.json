    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "282e7692-6b00-33f1-acca-76912da03292",
                    "sense_definition": "Often arguing or ready to dispute with others; quarrelsome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He becomes aggressive and <w>argumentative</w> whenever anyone questions his decisions.",
                            "target_lang_translations": {
                                "pl": "Staje się agresywny i <w>kłótliwy</w>, ilekroć ktoś kwestionuje jego decyzje."
                            }
                        },
                        {
                            "text": "The meeting took twice as long because two <w>argumentative</w> colleagues refused to compromise.",
                            "target_lang_translations": {
                                "pl": "Spotkanie trwało dwa razy dłużej, ponieważ dwóch <w>kłótliwych</w> kolegów odmawiało pójścia na kompromis."
                            }
                        }
                    ],
                    "synonyms": [
                        "quarrelsome",
                        "contentious",
                        "disputatious"
                    ],
                    "antonyms": [
                        "unargumentative",
                        "nonargumentative"
                    ],
                    "common_phrases": [
                        "become argumentative",
                        "argumentative person"
                    ],
                    "target_lang_definitions": {
                        "pl": "Często się kłócący, skłonny do dyskusji, sporów lub sprzeczek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kłótliwy",
                                "target_lang_sense_clarification": "skłonny do kłótni i sporów z ludźmi"
                            },
                            {
                                "target_lang_word": "zaczepny",
                                "target_lang_sense_clarification": "prowokujący spory lub kłótnie"
                            },
                            {
                                "target_lang_word": "swarliwy",
                                "target_lang_sense_clarification": "skłonny do swarów, zadziorny (bardziej książkowo)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f95156fd-eb34-39e1-8ddf-d83daf8859c0",
                    "sense_definition": "Pertaining to argumentation or presenting a reasoned case or logical line of thought.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each student must write an <w>argumentative</w> essay defending their perspective on the topic.",
                            "target_lang_translations": {
                                "pl": "Każdy student musi napisać esej <w>argumentacyjny</w>, broniąc swojego punktu widzenia na ten temat."
                            }
                        },
                        {
                            "text": "The lawyer laid out an <w>argumentative</w> framework that clearly convinced the jury.",
                            "target_lang_translations": {
                                "pl": "Prawnik przedstawił logiczną strukturę <w>argumentacyjną</w>, która wyraźnie przekonała ławę przysięgłych."
                            }
                        }
                    ],
                    "synonyms": [
                        "discursory"
                    ],
                    "common_phrases": [
                        "argumentative essay",
                        "argumentative writing"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotyczący argumentacji, oparty na przedstawianiu uzasadnionych racji lub logicznego toku myślenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "argumentacyjny",
                                "target_lang_sense_clarification": "odnoszący się do argumentacji lub używający argumentów"
                            },
                            {
                                "target_lang_word": "dyskursywny",
                                "target_lang_sense_clarification": "oparty na logicznym wywodzie i uzasadnianiu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}