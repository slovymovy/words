                                    },
                                    {
                                        "sense_id": "a85efdb9-af25-3072-afb0-abda65e7bd30",
                                        "entry_id": "2c2d0500-1277-3d02-af84-616616422d28",
                                        "glosses": [
                                            "A light, slightly greenish, yellow colour."
                                        ],
