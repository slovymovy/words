                                                "sense_id": "ec4507f4-3868-3cd8-9150-6416eaed6f1c",
                                                "text": "Pourquoi demander le consentement des epsilons ?"
                                            },
                                            {
                                                "example_id": "92a47bbc-42e9-428f-af5a-69812aac6d55",
                                                "sense_id": "ec4507f4-3868-3cd8-9150-6416eaed6f1c",
