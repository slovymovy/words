                                    {
                                        "sense_id": "8c703ec8-ca5a-3920-9a61-146d7667c858",
                                        "entry_id": "88f05145-100e-3b7a-a3d3-763cf568811e",
                                        "glosses": [
                                            "slepé vášnivé nadšení, obvykle pro určitou víru nebo přesvědčení, s charakteristickou nesnášenlivostí k odlišným názorům"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aac20aa3-c843-4ab9-a954-ea94e4803e0d",
                                                "sense_id": "8c703ec8-ca5a-3920-9a61-146d7667c858",
                                                "text": "Fanatismus některých vědců působí téměř jako fanatismus náboženský."
                                            },
                                            {
                                                "example_id": "70b32f25-7a91-4d51-b4f4-ecf02a408de5",
                                                "sense_id": "8c703ec8-ca5a-3920-9a61-146d7667c858",
                                                "text": "Fanatismus doktorů theologických pod obojí překážel souhlasnému zvelebování věd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30439a3b-69a6-4069-9776-f6ea5367df82",
