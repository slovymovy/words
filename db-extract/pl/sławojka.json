                "senses": [
                    {
                        "sense_id": "d3e917d3-058e-3182-846d-40c56ed77b91",
                        "entry_id": "e80336b8-1ce3-3247-ac68-1142ab6b25a1",
                        "glosses": [
                            "outhouse"
                        ],
                        "tags": [
                            "dated",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "bd0d7058-c51f-42a4-97f9-d0f3a201b74d",
                                "sense_id": "d3e917d3-058e-3182-846d-40c56ed77b91",
                                "text": "Skacze na drugą stronę. Jest na sąsiednim podwórzu. Ale od ulicy słychać niemieckie wrzaski. W rogu podwórza sławojka.",
                                "translation": "He jumps to the other side. He's in the neighboring yard. But from the streets he could hear Germans yelling. In the corner there was an outhouse.",
                                "english": "He jumps to the other side. He's in the neighboring yard. But from the streets he could hear Germans yelling. In the corner there was an outhouse."
                            },
                            {
                                "example_id": "c4810094-2f5e-4bbb-b6af-58b3e0a2b15d",
                                "sense_id": "d3e917d3-058e-3182-846d-40c56ed77b91",
                                "text": "Ten Straszewicz i Parnicki to naprawdę dowód, że gdyby nawet znalazł się Pan na pustyni, gdzie stałaby jedna jedyna sławojka, a na niej napis: »Klucz u dozorcy«, to Pan by klucz zdobył.",
                                "translation": "This Straszewicz and Parnicki are good proof that even if he was foudn in the desert, where there'd be one lonely outhouse with the enscription \"The caretaker's key\", then he would get the key.",
                                "english": "This Straszewicz and Parnicki are good proof that even if he was foudn in the desert, where there'd be one lonely outhouse with the enscription \"The caretaker's key\", then he would get the key."
                            },
                            {
                                "example_id": "e834acf5-0502-4117-87a8-73dbdbb22543",
                                "sense_id": "d3e917d3-058e-3182-846d-40c56ed77b91",
                                "text": "Trzeba się jedynie nastawić na warunki syberyjskie: sławojka zamiast toalety i balia zimnej wody muszą nam wystarczyć za całodzienną higienę.",
                                "translation": "You have to just adjust to Siberian conditions: an outhouse instead of a toilet and a washtub of cold water has to last for a whole day's worth of cleaning.",
                                "english": "You have to just adjust to Siberian conditions: an outhouse instead of a toilet and a washtub of cold water has to last for a whole day's worth of cleaning."
                            }
                        ]
                    }
