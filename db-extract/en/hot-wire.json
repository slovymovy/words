                ],
                "senses": [
                    {
                        "sense_id": "dadf5709-490a-37e6-9752-8600df93957d",
                        "entry_id": "fe65f56c-8af1-3a7b-ae78-61fb4e4f9013",
                        "glosses": [
                            "To start an automobile engine by bypassing the ignition key wiring."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d188e8c-2c42-3e2e-bc75-052f9690087e",
                        "entry_id": "fe65f56c-8af1-3a7b-ae78-61fb4e4f9013",
                        "glosses": [
                            "To steal a vehicle by bypassing the ignition key's security."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "91e8b803-7df1-44b1-83a2-833f73a0816e",
                                "sense_id": "0d188e8c-2c42-3e2e-bc75-052f9690087e",
                                "text": "Never broke into a car, never hotwired a car. Never broke into a truck. 'I shall not cause harm to any vehicle nor the personal contents thereof, nor through inaction let the personal contents thereof come to harm' It's what I call the Repo Code, kid!"
                            },
                            {
                                "example_id": "17e26ca7-5ee8-48ee-a490-d11602d393a1",
                                "sense_id": "0d188e8c-2c42-3e2e-bc75-052f9690087e",
                                "text": "His attitude grew worse and his crimes escalated: he broke into garages in his neighborhood, he hot-wired cars, and his punches grew harder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "727fb6d3-46c7-4844-bfc9-18cb504312c3",
                        "source_entry_id": "fe65f56c-8af1-3a7b-ae78-61fb4e4f9013",
                        "source_sense_description": "hot-wire",
                        "target_lang_word": "kurzschließen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurzschließen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3a6bd52-da54-3d26-bdb2-25e1621b9fe9",
                                        "entry_id": "20319051-8089-3735-ac9e-848bf3234e47",
                                        "glosses": [
                                            "zwei elektrische Leitungen, die Spannung führen, direkt miteinander verbinden und dadurch einen Schalter, Widerstand oder dergleichen überbrücken; einen Kurzschluss hervorrufen, verursachen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec09f20-c7dd-4b4e-b96e-fb01ef8932d9",
                                                "sense_id": "e3a6bd52-da54-3d26-bdb2-25e1621b9fe9",
                                                "text": "„Sie schlugen bei parkenden Wagen die Scheiben ein, schlossen den Motor kurz und fuhren davon.“"
                                            },
                                            {
                                                "example_id": "9fe3da23-4f52-47ec-9fc1-b8295de2bd42",
                                                "sense_id": "e3a6bd52-da54-3d26-bdb2-25e1621b9fe9",
                                                "text": "„Stehen die Signale auf ‚Fahrt frei‘, schließt ein Schalter diese Schwingkreise kurz – sie üben dann keinen Einfluß auf die Schwingkreise des Triebfahrzeuges aus.“"
                                            },
                                            {
                                                "example_id": "24608391-99ee-4380-844f-acd51c21ca5c",
                                                "sense_id": "e3a6bd52-da54-3d26-bdb2-25e1621b9fe9",
                                                "text": "„Mit Nachschlüsseln, die der BND beschafft hatte, öffneten die drei Männer das Haupt- und das Zusatzschloß der Feuertür zum Gefangenentrakt, schlossen die über der Tür liegenden Kontakte der Alarmanlage kurz und betraten unbehelligt den Zellenflur.“"
                                            },
                                            {
                                                "example_id": "d8fcd361-c144-4495-ba53-1cadeb9843e2",
                                                "sense_id": "e3a6bd52-da54-3d26-bdb2-25e1621b9fe9",
                                                "text": "„Es war Winter, erinnert sich Karotte, und weil der Käfer, den der Friseur fuhr, nach dem Kino nicht ansprang, hat ihn Karotte kurzgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6b1a496-6c0b-3e97-8f3c-aaf57de6a4b8",
                                        "entry_id": "20319051-8089-3735-ac9e-848bf3234e47",
                                        "glosses": [
                                            "verbinden und aufeinander abstimmen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb617e9-b070-4b75-b5ae-f79c60a559fe",
                                                "sense_id": "d6b1a496-6c0b-3e97-8f3c-aaf57de6a4b8",
                                                "text": "„Die Forderung nach einer stärkeren Pädagogisierung des Unterrichts und nach einer Demokratisierung der Entscheidungsstrukturen ist nicht ohne weiteres mit der Neutralisierung der Staatsbürgerrolle vereinbar, und noch weniger mit dem ökonomischen Systemimperativ, das Schulsystem vom Grundrecht auf Bildung zu entkoppeln und mit dem Beschäftigungssystem kurzzuschließen.“"
                                            },
                                            {
                                                "example_id": "41879f1d-7d7f-4477-bf80-ae7ebc50425f",
                                                "sense_id": "d6b1a496-6c0b-3e97-8f3c-aaf57de6a4b8",
                                                "text": "„In den drei erotischen Essays des ersten Teils enttarnt Zizek die ‚Minne als Masochismus‘, liest Otto Weininger mit David Lynch und schließt Curtiz’ Casablanca und Kierkegaard kurz.“"
                                            },
                                            {
                                                "example_id": "66044859-1524-469f-839e-e94dcd6b4923",
                                                "sense_id": "d6b1a496-6c0b-3e97-8f3c-aaf57de6a4b8",
                                                "text": "„Vielleicht hätte sich sogar Hobbes für eine derart plumpe Argumentation geniert, denn seine misanthropische Prämisse war noch nicht so simpel mit den Axiomen der kapitalistischen Volkswirtschaftslehre kurzgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                        "entry_id": "20319051-8089-3735-ac9e-848bf3234e47",
                                        "glosses": [
                                            "direkt kontaktieren zwecks schnellen Austauschs von Informationen, zwecks kurzer Absprache und dergleichen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative",
                                            "rare",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230249b5-6dda-4f91-a7c8-1455e950b33b",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "„Ich muss mich mit dem Controller kurzschließen, mit den Zahlen hier scheint etwas nicht zu stimmen.“"
                                            },
                                            {
                                                "example_id": "2a3f8611-38f1-460b-8e57-45b9f7ec223f",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "[Der römische Bürgermeister] Gianni Alemanno bei einer Pressekonferenz: „Vor wenigen Tagen habe ich mich mit dem Kulturminister kurzgeschlossen. […]“"
                                            },
                                            {
                                                "example_id": "dcb12caa-f50d-4e6d-a94f-5604291cc176",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "„Damit der ‚gute Stern auf allen Straßen‘ (Werbeslogan) auch bei dieser Fahrzeug-Gattung nicht verblasse, schlossen sie sich mit der Wolfsburger Zentrale kurz.“"
                                            },
                                            {
                                                "example_id": "ea2e72ab-fc3b-46bd-8ffa-ae1230f9c674",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "„Mit ihnen schließt er sich ‚unter der Hand‘ kurz, abseits der offiziellen diplomatischen Kanäle, sobald eine Sache heikel oder gefährlich wird.“"
                                            },
                                            {
                                                "example_id": "12d9cefe-1153-4733-8ec4-22972720d81b",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "„Tölke war über die Kritik überrascht: ‚Wir sind als Planer von universitätsinternen Vorgängen ausgeschlossen. Man schließt uns nicht kurz.‘“"
                                            },
                                            {
                                                "example_id": "975b9f0a-4bd0-4024-ae8a-082380aeb659",
                                                "sense_id": "fa14a081-2996-3729-bfb1-7919e8a693be",
                                                "text": "Da es schwer ist, die Hand über ein weitverzweigtes soziales Netzwerk wie Facebook zu halten, griff die chinesische Regierung zum letzten Mittel und blockierte den Dienst komplett. Auch der Kurznachrichtendienst Twitter, mit dem sich Oppositionelle kurzschließen könnten, und Googles Videoplattform YouTube etwa werden in China unterdrückt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                        "entry_id": "20319051-8089-3735-ac9e-848bf3234e47",
                                        "glosses": [
                                            "(logisch) falsch schlussfolgern; einen Kurzschluss ableiten, ziehen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d94541-fe7a-4305-8b82-707d717e7a77",
                                                "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                                "text": "„Nun, Herr Vechna schließt zu kurz: Dienstpflicht für sich und allein wäre noch unproblematisch. Das Mißtrauen jedoch gilt nicht dem Dienst, sondern seinem Ziel, dem möglichen Krieg, dem Dienste für den Krieg.“"
                                            },
                                            {
                                                "example_id": "19a3341a-1082-42d6-bd1b-ad87425e23cc",
                                                "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                                "text": "„‚Das sind solide acht Prozent‘, schließt Thadden kurz.“"
                                            },
                                            {
                                                "example_id": "07fd9dff-438a-4fd1-a914-b9472d8e3f68",
                                                "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                                "text": "„Deswegen, so schlossen Mayer und sein Senat kurz, sei Schily der Mittelsmann.“"
                                            },
                                            {
                                                "example_id": "ec919ec4-37dd-47b7-8aee-3d742fb02713",
                                                "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                                "text": "„Daraus schlossen schon die frühen Fabier schlicht und allzu kurz, daß die Unternehmergewinne, vor allem die Erträge von Investitionen, ebenso sinnlose Renten seien, die irgendwelchen Kapitalisten zuflössen, weil sie eine Gelegenheit ausnutzen könnten, zu der sie selbst nichts beigetragen hätten.“"
                                            },
                                            {
                                                "example_id": "8039603c-31c4-48b7-b1ef-6e2cc4db9946",
                                                "sense_id": "8d3d5668-f314-3ea7-b1a3-e20919a3c9ed",
                                                "text": "„Ebenso bedenklich wie die augenfällige Fehlbewertung der Tatsachen war die Begründung der angeblichen Gefahr, die von den Reisenden ausgegangen sei: Wer zu einer Demonstration Helme mitnehme, so schlossen die Richter kurz, werde womöglich auch gewalttätig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
