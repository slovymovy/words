                    "sense_id": "1bc70e15-1564-329b-a876-3b8d0a42981e",
                    "sense_definition": "zonder het gewenste resultaat te bereiken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vruchteloosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij trachtte <w>vergeefs</w> een ongeluk te voorkomen.",
                            "target_lang_translations": {
                                "en": "He tried <w>in vain</w> to prevent an accident.",
                                "ru": "Он <w>напрасно</w> пытался предотвратить несчастный случай."
                            }
                        },
                        {
                            "text": "Een paar jaar geleden had Sinterklaas wekenlang <w>vergeefs</w> gezocht.",
                            "target_lang_translations": {
                                "en": "A few years ago, Sinterklaas had searched <w>fruitlessly</w> for weeks.",
                                "ru": "Несколько лет назад Синтерклаас неделями <w>тщетно</w> искал."
                            }
                        }
                    ],
                    "synonyms": [
                        "tevergeefs"
                    ],
                    "common_phrases": [
                        "vergeefs zoeken",
                        "vergeefs wachten",
                        "vergeefs proberen"
                    ],
                    "target_lang_definitions": {
                        "en": "without achieving the desired result",
                        "ru": "без достижения желаемого результата"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in vain",
                                "target_lang_sense_clarification": "without success"
                            },
                            {
                                "target_lang_word": "to no avail",
                                "target_lang_sense_clarification": "without any success or effect"
                            },
                            {
                                "target_lang_word": "fruitlessly",
                                "target_lang_sense_clarification": "without producing any useful results"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "напрасно",
                                "target_lang_sense_clarification": "безрезультатно"
                            },
                            {
                                "target_lang_word": "тщетно",
                                "target_lang_sense_clarification": "бесполезно"
                            },
                            {
                                "target_lang_word": "впустую",
                                "target_lang_sense_clarification": "без толку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f704544-f300-37e5-9a92-d30f3458d0dd",
                    "sense_definition": "geen resultaat opleverend of zonder succes",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vruchteloosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed een <w>vergeefse</w> poging om een ongeluk te voorkomen.",
                            "target_lang_translations": {
                                "en": "He made a <w>futile</w> attempt to prevent an accident.",
                                "ru": "Он предпринял <w>напрасную</w> попытку предотвратить несчастный случай."
                            }
                        },
                        {
                            "text": "Al zijn harde werk was helaas <w>vergeefs</w>.",
                            "target_lang_translations": {
                                "en": "All his hard work was unfortunately <w>in vain</w>.",
                                "ru": "Вся его тяжелая работа, к сожалению, была <w>напрасной</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tevergeefs"
                    ],
                    "common_phrases": [
                        "vergeefse poging",
                        "vergeefse moeite",
                        "vergeefse hoop"
                    ],
                    "target_lang_definitions": {
                        "en": "yielding no result or without success",
                        "ru": "не приносящий результата или безуспешный"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "futile",
                                "target_lang_sense_clarification": "incapable of producing any useful result; pointless"
                            },
                            {
                                "target_lang_word": "vain",
                                "target_lang_sense_clarification": "producing no result; useless"
                            },
                            {
                                "target_lang_word": "useless",
                                "target_lang_sense_clarification": "not fulfilling or not expected to fulfill any intended purpose or desired outcome"
                            },
                            {
                                "target_lang_word": "abortive",
                                "target_lang_sense_clarification": "failing to produce the intended result"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "напрасный",
