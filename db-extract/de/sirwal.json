                        "examples": [
                            {
                                "example_id": "ec53a60a-6fa1-44dc-b3a6-73251cc6b276",
                                "sense_id": "dbb340e3-dee2-322c-9994-708b86e40770",
                                "text": "„Unter dem langen schwarzen Gewand, der Galabiyya, trägt er den Sirwal (weiße Baumwollhose), dazu eine schwarze Weste und selbstverständlich Vollbart.“"
                            }
                        ],
