                ],
                "senses": [
                    {
                        "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                        "entry_id": "6733b51f-9cc4-3c71-bdc4-30f7f40a9f1f",
                        "glosses": [
                            "Störung oder Zusammenbruch des Finanzsystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c52a43-8afe-48d6-b418-0d019d40fc7e",
                                "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                                "text": "„Die neue Finanzkrise scheint die USA deutlich stärker zu treffen als Deutschland.“"
                            },
                            {
                                "example_id": "0f756c19-a07e-42d7-9e61-13824b75cf82",
                                "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                                "text": "Die internationale Finanzkrise ist in der zweiten Jahreshälfte von 2008 eines der wichtigsten politischen Themen."
                            },
                            {
                                "example_id": "97d08814-61ad-4386-9af1-86e8ff7b4104",
                                "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                                "text": "„Als 2008 die Finanzkrise ausbrach, war er mit Ehefrau und zwei seiner vier Kinder vor Australien, auf Weltumsegelung.“"
                            },
                            {
                                "example_id": "ae757886-dd92-4309-8266-52b39fd78fce",
                                "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                                "text": "„Dann erklärte er mir geduldig, wodurch die Finanzkrise entstand, welche Kräfte dafür verantwortlich waren und warum das Ganze einfach irgendwann passieren musste.“"
                            },
                            {
                                "example_id": "a797a8ea-4441-4cba-93ed-80ca6b1ec712",
                                "sense_id": "df2924f8-dbab-3141-b352-e443edfc12fb",
                                "text": "„In der Finanzkrise 2008/09 sind Amerika und halb Europa beinahe zusammengebrochen, nur die Deutschen nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
