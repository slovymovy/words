                                "target_senses": [
                                    {
                                        "sense_id": "774029f0-37d9-3038-b364-767ff26654a2",
                                        "entry_id": "b1d9fbad-3a82-3b03-89eb-bb6a98cfa521",
                                        "glosses": [
                                            "Tracts of land covered in natural vegetation that are largely undeveloped and uncultivated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f87eb2-db30-4c68-8b38-074d0edfc16b",
                                                "sense_id": "774029f0-37d9-3038-b364-767ff26654a2",
                                                "text": "Mad terror had scattered them, men, women, and children, through the bush, and they had never returned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8454442c-0a3f-36a6-aba4-5f6892f88c23",
                                        "entry_id": "b1d9fbad-3a82-3b03-89eb-bb6a98cfa521",
                                        "glosses": [
                                            "Tracts of land covered in natural vegetation that are largely undeveloped and uncultivated.",
                                            "The countryside area of Australia that is less arid and less remote than the outback; loosely, areas of natural flora even within conurbations."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "often",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "505651e8-0e13-4fb2-babb-e9db5170a40e",
                                                "sense_id": "8454442c-0a3f-36a6-aba4-5f6892f88c23",
                                                "text": "I remember, about five years ago, I was greatly annoyed by a ghost, while doing a job of fencing in the bush between here and Perth."
                                            },
                                            {
                                                "example_id": "e7afedad-138a-4963-9533-cfcefbd1b8dc",
                                                "sense_id": "8454442c-0a3f-36a6-aba4-5f6892f88c23",
                                                "text": "Little Dot had lost her way in the bush."
                                            },
                                            {
                                                "example_id": "07ff4064-37f0-4b82-a1c5-a3fb35f1a11d",
                                                "sense_id": "8454442c-0a3f-36a6-aba4-5f6892f88c23",
                                                "text": "The theme of children lost in the bush is a well-worked one in Australian art and literature."
                                            },
                                            {
                                                "example_id": "3aca2915-cc18-4a97-94dc-845dd5c37c60",
                                                "sense_id": "8454442c-0a3f-36a6-aba4-5f6892f88c23",
                                                "text": "The findings of the Intergovernmental Panel on Climate Change suggest Australia may have to jettison tracts of the bush unless there is a massive investment in climate-change adaptation and planning."
                                            }
                                        ]
                                    },
