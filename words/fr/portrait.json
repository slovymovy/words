    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a3e852a-fb15-35e8-b8e8-25d317d976fa",
                    "sense_definition": "Représentation artistique (peinture, dessin, gravure) du visage ou du corps d'une personne réelle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a exposé un magnifique <w>portrait</w> de sa femme dans la galerie."
                        },
                        {
                            "text": "Ce musée conserve de nombreux <w>portraits</w> de souverains européens du dix-septième siècle."
                        }
                    ],
                    "common_phrases": [
                        "peindre un portrait",
                        "portrait officiel"
                    ]
                },
                {
                    "sense_id": "6f521d2b-fe53-34ee-92ff-10aa0d114817",
                    "sense_definition": "Photographie montrant une personne de près, en particulier son visage.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "art_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a pris un superbe <w>portrait</w> de son fils avec son nouvel appareil photo."
                        },
                        {
                            "text": "Pour refaire votre passeport, vous devez fournir un <w>portrait</w> récent et net."
                        }
                    ],
                    "synonyms": [
                        "photo",
                        "photographie"
                    ],
                    "common_phrases": [
                        "mode portrait",
                        "faire un portrait"
                    ]
                },
                {
                    "sense_id": "dc9260bf-15ca-315f-a23d-07e39aea2e80",
                    "sense_definition": "Description orale ou écrite de l'apparence physique, des traits de caractère ou de la vie d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a dressé un <w>portrait</w> captivant de cette femme politique dans son article."
                        },
                        {
                            "text": "Le roman commence par le <w>portrait</w> détaillé d'un vieux professeur solitaire."
                        }
                    ],
                    "synonyms": [
                        "description",
                        "évocation"
                    ],
                    "common_phrases": [
                        "dresser le portrait",
                        "portrait psychologique"
                    ]
                },
                {
                    "sense_id": "2d83e3f6-1378-3641-aadc-8231416ecc6f",
                    "sense_definition": "Personne qui ressemble de manière frappante à une autre, physiquement ou moralement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ressemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite fille a les yeux de son père, elle est son <w>portrait</w> tout craché."
                        },
                        {
                            "text": "En grandissant, il est devenu le parfait <w>portrait</w> de son grand-père maternel."
                        }
                    ],
                    "synonyms": [
                        "sosie",
                        "copie"
                    ],
                    "common_phrases": [
                        "portrait craché"
                    ]
                },
                {
                    "sense_id": "17922bda-c307-3bf7-a013-3971b60b88c7",
                    "sense_definition": "Format ou orientation d'un document ou d'une image dont la hauteur est supérieure à la largeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez imprimer ce document en format <w>portrait</w> pour que tout tienne sur une seule page."
                        },
                        {
                            "text": "La photo a été prise en orientation <w>portrait</w> plutôt qu'en largeur."
                        }
                    ],
                    "antonyms": [
                        "paysage"
                    ],
                    "common_phrases": [
                        "format portrait",
                        "orientation portrait"
                    ]
                },
                {
                    "sense_id": "cd058e4f-4e55-386e-824d-d096dbf6846f",
                    "sense_definition": "Description générale, vue d'ensemble ou bilan montrant l'état global d'une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce rapport dresse un <w>portrait</w> alarmant de la situation économique du pays."
                        },
                        {
                            "text": "L'auteur nous offre un <w>portrait</w> fidèle de la société française du dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "tableau",
                        "bilan",
                        "panorama"
                    ],
                    "common_phrases": [
                        "portrait global",
                        "portrait fidèle"
                    ]
                },
                {
                    "sense_id": "c746a969-9951-3ad3-b8d1-e01828cb581b",
                    "sense_definition": "Visage, figure d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le film policier, le malfaiteur menaçait de lui abîmer le <w>portrait</w>."
                        },
                        {
                            "text": "Il est rentré de la bagarre avec le <w>portrait</w> complètement tuméfié."
                        }
                    ],
                    "synonyms": [
                        "figure",
                        "visage",
                        "poire",
                        "bobine"
                    ],
                    "common_phrases": [
                        "démolir le portrait",
                        "refaire le portrait"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                }
            ]
        }
    ]
