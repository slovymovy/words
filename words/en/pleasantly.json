{
    "word_family": [
        "pleasant",
        "pleasantness",
        "unpleasant",
        "unpleasantly"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                    "sense_definition": "In a way that gives pleasure or is enjoyable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He smiled <w>pleasantly</w> at everyone he met on the street.",
                            "target_lang_translations": {
                                "ru": "Он <w>приятно</w> улыбался всем, кого встречал на улице."
                            }
                        },
                        {
                            "text": "We were <w>pleasantly</w> surprised by the warm welcome at the hotel.",
                            "target_lang_translations": {
                                "ru": "Мы были <w>приятно</w> удивлены теплым приемом в отеле."
                            }
                        }
                    ],
                    "synonyms": [
                        "agreeably",
                        "nicely",
                        "delightfully"
                    ],
                    "antonyms": [
                        "unpleasantly",
                        "disagreeably"
                    ],
                    "common_phrases": [
                        "pleasantly surprised"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятным, доставляющим удовольствие образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятно",
                                "target_lang_sense_clarification": "общее обозначение приятного способа действия"
                            },
                            {
                                "target_lang_word": "мило",
                                "target_lang_sense_clarification": "в значении дружелюбного или симпатичного поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                    "sense_definition": "In a humorous or facetious manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pleasantly</w> remarked that the situation was quite absurd.",
                            "target_lang_translations": {
                                "ru": "Он <w>шутливо</w> заметил, что ситуация довольно абсурдна."
                            }
                        },
                        {
                            "text": "The host <w>pleasantly</w> joked about the lack of food at the party.",
                            "target_lang_translations": {
                                "ru": "Хозяин <w>игриво</w> пошутил по поводу нехватки еды на вечеринке."
                            }
                        }
                    ],
                    "synonyms": [
                        "jokingly",
                        "facetiously"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В шутливой или ироничной манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутливо",
                                "target_lang_sense_clarification": "в манере, предполагающей шутку"
                            },
                            {
                                "target_lang_word": "игриво",
                                "target_lang_sense_clarification": "в легкой, несерьезной манере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f90d169c-2574-3dc9-90b0-9c86da04dff9",
                    "sense_definition": "In a light or gentle manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The breeze blew <w>pleasantly</w> through the open window.",
                            "target_lang_translations": {
                                "ru": "В открытое окно <w>приятно</w> дул ветерок."
                            }
                        },
                        {
                            "text": "The sun warmed the garden <w>pleasantly</w> during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Солнце <w>приятно</w> согревало сад в течение дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "gently",
                        "lightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко, мягко, ненавязчиво."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "о воздействии природных явлений"
                            },
                            {
                                "target_lang_word": "легко",
                                "target_lang_sense_clarification": "о ненавязчивом, комфортном ощущении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}