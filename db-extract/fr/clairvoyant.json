                    },
                    {
                        "form_id": "d2631926-ac1c-4790-9d22-576fc96a5189",
                        "entry_id": "4203cf98-1b9c-3602-82e2-deb57dfc8ca8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "clairvoyantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79a41db8-0cec-3ac5-89d3-c0f6f15d44a3",
                        "entry_id": "4203cf98-1b9c-3602-82e2-deb57dfc8ca8",
                        "glosses": [
                            "Qui voit clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64499612-1d19-4d7b-9191-3f485775b9e1",
                                "sense_id": "79a41db8-0cec-3ac5-89d3-c0f6f15d44a3",
                                "text": "Si je suis aveugle, ma tendresse est clairvoyante, et je vous engage à surveiller ma fille."
                            },
                            {
                                "example_id": "58304f2c-3bea-4108-ba9c-e38e1a9edb1b",
                                "sense_id": "79a41db8-0cec-3ac5-89d3-c0f6f15d44a3",
                                "text": "Dans une belle préface, à la fois sensible et clairvoyante, M. Louis Gillet nos raconte la vie de Katherine Mansfield."
                            }
                        ]
                    },
                    {
                        "sense_id": "d96c6b1a-3e4e-33d8-b94f-7bdf55c4b5a3",
                        "entry_id": "4203cf98-1b9c-3602-82e2-deb57dfc8ca8",
                        "glosses": [
                            "Qui est intelligent, éclairé et pénétrant dans les affaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0a287e-3b3c-4367-8502-04d12dd81c5b",
                                "sense_id": "d96c6b1a-3e4e-33d8-b94f-7bdf55c4b5a3",
                                "text": "Lorsque l’on ne peut faire autrement que d’affronter le mauvais temps, les forces humaines se décuplent et l’esprit devient plus clairvoyant."
                            },
                            {
                                "example_id": "e2a4c23b-d0ae-46fe-b947-dbd26ef7c0e6",
                                "sense_id": "d96c6b1a-3e4e-33d8-b94f-7bdf55c4b5a3",
                                "text": "Les persécutés ont été manifestement plus clairvoyants que le persécuteur."
                            },
                            {
                                "example_id": "232593cf-21b1-4e75-ac95-913b34bb08f2",
                                "sense_id": "d96c6b1a-3e4e-33d8-b94f-7bdf55c4b5a3",
                                "text": "Cette situation, qu’il avait essayé de cacher jusqu’alors, la nature menaçait d’en dévoiler le secret, même aux moins clairvoyants."
                            },
                            {
                                "example_id": "3b7d9aa5-f2d1-4527-bd02-a125ea9440dc",
                                "sense_id": "d96c6b1a-3e4e-33d8-b94f-7bdf55c4b5a3",
                                "text": "Les flibustiers sont gens hardis et surtout clairvoyants et rusés comme des singes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86ceba69-52c1-4c39-911c-cd7b45319848",
                        "source_entry_id": "4203cf98-1b9c-3602-82e2-deb57dfc8ca8",
                        "source_sense_id": "79a41db8-0cec-3ac5-89d3-c0f6f15d44a3",
                        "source_sense_description": "Qui voit clair",
                        "target_lang_word": "clear-sighted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clear-sighted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1684485-2d8a-3683-91a3-c7b910113510",
                                        "entry_id": "55fa20b6-2545-35b7-926d-ae21084bda9f",
                                        "glosses": [
                                            "Having sharp vision."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce74b797-3c7d-334f-a7da-f0fcbcb20971",
                                        "entry_id": "55fa20b6-2545-35b7-926d-ae21084bda9f",
                                        "glosses": [
                                            "Acutely perceptive or discerning; perspicacious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "731c478b-1d85-4eac-9c5c-2364f3321c0c",
                                                "sense_id": "ce74b797-3c7d-334f-a7da-f0fcbcb20971",
                                                "text": "Who can form even a likely guess as to what is to succeed, even the best-informed and clearest-sighted Russian, except as to his own immediate neighborhood? The proceedings of one neighborhood cannot in the least be inferred from those of another."
                                            },
                                            {
                                                "example_id": "ec0b251a-c138-4773-a870-5618495b0365",
                                                "sense_id": "ce74b797-3c7d-334f-a7da-f0fcbcb20971",
                                                "text": "Even the clearer-sighted prisoners make their own compromises with reality. An amiable artist (Lon Huber) had left his hiding place for a walk even though he knew the danger, while the best-informed of the lot, a Marxist electrician (Tim O’Hare), lives his own life as a historical abstraction amid a larger class struggle."
                                            },
                                            {
                                                "example_id": "4309fa6d-ce5e-4285-9139-5fea1b42818c",
                                                "sense_id": "ce74b797-3c7d-334f-a7da-f0fcbcb20971",
                                                "text": "Eventually, in 1970, at a Meeting in Aberdeen, he appeared drunk and stated that his word was of such consequence that the Bible was no longer necessary - a bombshell that caused a number of clearer-sighted Brethren to protest and break away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9528cfef-efdc-4efd-84d7-bc87c1e96a49",
                        "source_entry_id": "4203cf98-1b9c-3602-82e2-deb57dfc8ca8",
