                "senses": [
                    {
                        "sense_id": "700949b7-3c84-305f-bd3c-56c0469d0eaa",
                        "entry_id": "b7c5122d-b60a-3a5d-b9f4-4a986d96aa1a",
                        "glosses": [
                            "Démarche qui vise l’unité psycho-corporelle. Elle est fondée sur la prise de conscience des sensations corporelles et s’est développée dans le contexte de la culture occidentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d699903c-9cd1-4344-ba20-f0c9c3bffaaa",
                                "sense_id": "700949b7-3c84-305f-bd3c-56c0469d0eaa",
                                "text": "Ce que recherche l’eutonie n'est pas une disparition absolue de toutes les tensions mais l’anéantissement de toute tension inutile au geste effectué."
                            },
                            {
                                "example_id": "0df25452-b564-43c6-87be-eabd5a7f6230",
                                "sense_id": "700949b7-3c84-305f-bd3c-56c0469d0eaa",
                                "text": "Créée par Gerda Alexander dans les années 1950, l’eutonie, qui signifie « bon tonus », est fondée sur la prise de conscience de tous les éléments du corps et l’observation des sensations."
                            }
                        ]
                    }
                ],
