                                                "example_id": "b42439a3-10aa-457e-aa0e-ed021a3731d3",
                                                "sense_id": "38779058-1490-387e-b669-0ee46e974756",
                                                "text": "„Dort traf ein Päckchen ein, aus dem Kabel hingen.“"
                                            },
                                            {
                                                "example_id": "6c969526-d726-4b5c-a1b7-8aa4cd180941",
                                                "sense_id": "38779058-1490-387e-b669-0ee46e974756",
                                                "text": "„Zwei Wochen später kamen wir ihm bei der Auflösung einer Klosterbibliothek zuvor, weil Amalia in einer Nacht-und-Nebel-Aktion das Kabel der Einspritzanlage seines Autos durchgeschnitten hatte.“"
                                            },
                                            {
                                                "example_id": "3bf67f50-0e01-4dc2-9fe0-80a858eeab38",
                                                "sense_id": "38779058-1490-387e-b669-0ee46e974756",
                                                "text": "„Das Kabel der Nachttischlampe war lang genug, um bis in den Schrank unter der Dachschräge zu reichen.“"
                                            }
                                        ],
