                ],
                "senses": [
                    {
                        "sense_id": "2f8a1148-025c-30be-bc40-565bad9f10e4",
                        "entry_id": "e0adb214-b085-34c9-9982-3ba1a62ad63f",
                        "glosses": [
                            "flache, gewölbte Flasche, die für das Mitführen von kleinen Mengen Alkohol am Körper konzipiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32f46227-4737-45f6-8a85-b017bab122e0",
                                "sense_id": "2f8a1148-025c-30be-bc40-565bad9f10e4",
                                "text": "Nachdem er einen Schluck vom Schnaps getrunken hatte, steckte er den Flachmann wieder in seine Jackentasche."
                            },
                            {
                                "example_id": "aa2755a2-b24b-4145-ae70-fdfc44220b9d",
                                "sense_id": "2f8a1148-025c-30be-bc40-565bad9f10e4",
                                "text": "„Zwischen den Lokalitäten, zwischen Wohnung und Club, werden Hotdogs gegessen und der Schnaps aus kleinen Flachmännern weitergetrunken.“"
                            },
                            {
                                "example_id": "edc15c7f-99ef-4a9f-bcb4-c7acd355e668",
                                "sense_id": "2f8a1148-025c-30be-bc40-565bad9f10e4",
                                "text": "„Kanther fingerte aus seiner Manteltasche einen Flachmann hervor und nahm einen kräftigen Schluck von einem Gesöff, das verdächtig nach Absinth roch.“"
                            },
                            {
                                "example_id": "ebf0e241-7075-41e6-8b17-b9943a9f1b7b",
                                "sense_id": "2f8a1148-025c-30be-bc40-565bad9f10e4",
                                "text": "„Ab und zu blieb er stehen, nahm einen Schluck aus seinem Flachmann und starrte Thomas an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
