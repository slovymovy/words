                                    {
                                        "sense_id": "28f1afb5-c0da-3bc3-8eb1-0e3f4b0a9473",
                                        "entry_id": "be22e7a9-ca1a-3f78-a456-ee9be1a8bdb6",
                                        "glosses": [
                                            "Qui permet de lutter contre le diabète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52f41d2-9df2-4db8-87dc-c83c7688440a",
                                                "sense_id": "28f1afb5-c0da-3bc3-8eb1-0e3f4b0a9473",
                                                "text": "« La cannelle a des propriétés antidiabétiques, antiseptiques, digestives, et régulatrices de beaucoup de bactéries au niveau du microbiote », énumère Aline Mercan, médecin spécialiste de la phytothérapie et de la nutrition, et autrice du Manuel de phytothérapie écoresponsable (éd. Terre vivante)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidiabétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4882fd-b676-37f3-87f1-7298b8553df3",
                                        "entry_id": "82ac1df1-ba75-39fb-88fb-819c60af0cbc",
                                        "glosses": [
                                            "Médicament destiné à lutter contre le diabète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b40b186f-ea9f-44df-8252-d5dbdea8abfc",
                                                "sense_id": "8c4882fd-b676-37f3-87f1-7298b8553df3",
                                                "text": "Ce traitement qui fascine autant, c’est l’Ozempic (sémaglutide), un antidiabétique détourné à des fins d’amaigrissement."
                                            },
                                            {
                                                "example_id": "fced2868-8db0-49a5-9141-db70c79acd5c",
                                                "sense_id": "8c4882fd-b676-37f3-87f1-7298b8553df3",
                                                "text": "Ce schéma paraît plus complet que les résultats quantitatifs rapportés par les auteurs américains : en particulier le rôle des glandes salivaires dans l’élimination de l’antidiabétique semble leur avoir échappé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
