                        "examples": [
                            {
                                "example_id": "d31165e1-a9e7-4a81-936e-9cf0475bbdb4",
                                "sense_id": "4d7e33a0-81d2-34ac-9b1c-932731980b19",
                                "text": "De bankaandelen doen het op korte termijn beregoed, maar de huidige opleving wordt ook wel beschouwd als een crap rally, al het slechte gaat omhoog, omdat het zo hard gedaald is.\""
                            },
                            {
                                "example_id": "fd06b25b-8696-465c-bdc9-e7264906e22e",
                                "sense_id": "4d7e33a0-81d2-34ac-9b1c-932731980b19",
                                "text": "Marjan de Feijter van De Feijterhof in Itterbeck vertelde het publiek waarom haar varkens zo’n beregoed leven hebben, en de brigade van Het Seminar deelde verrassende hapjes uit."
                            }
                        ]
                    }
