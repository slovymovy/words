                "senses": [
                    {
                        "sense_id": "7ea4a6e1-cc3d-35c3-9b00-037a259ffd9a",
                        "entry_id": "b3dd5683-545c-3f6f-a2ad-1a824e5457d7",
                        "glosses": [
                            "Maya (ancient Mesoamerican civilization)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8088fef9-55fd-487d-bbeb-5ad3c47bcc98",
                                "sense_id": "7ea4a6e1-cc3d-35c3-9b00-037a259ffd9a",
                                "text": "Beide mexikanischen Staaten bilden die Westgrenze der einstigen Mayakultur.",
                                "translation": "Both Mexican states form the western border of the former Maya culture.",
                                "english": "Both Mexican states form the western border of the former Maya culture."
                            },
                            {
                                "example_id": "3e4fe745-1ad7-4531-8d10-ccfddd626a7c",
                                "sense_id": "7ea4a6e1-cc3d-35c3-9b00-037a259ffd9a",
                                "text": "Nach Zerstörung der Mayakultur durch die spanischen Eroberer zerstreuten sich die Ureinwohner über den gesamten Kontinent.",
                                "translation": "After the destruction of the Mayan culture by the Spanish conquistadors, the indigenous people scattered across the entire continent.",
                                "english": "After the destruction of the Mayan culture by the Spanish conquistadors, the indigenous people scattered across the entire continent."
                            },
                            {
                                "example_id": "28017c21-6f58-47dd-b047-9b402052a1d5",
                                "sense_id": "7ea4a6e1-cc3d-35c3-9b00-037a259ffd9a",
                                "text": "Einblicke in die heute noch gebräuchlichen Rituale und Traditionen, die in direkter Verbindung mit den berühmten Vorfahren aus Tikal, Palenque, und anderen Städten der Hochblüte der Mayakultur stehen.",
                                "translation": "Insights into the rituals and traditions still in use today, which are directly linked to the famous ancestors from Tikal, Palenque, and other cities of the heyday of Mayan culture.",
                                "english": "Insights into the rituals and traditions still in use today, which are directly linked to the famous ancestors from Tikal, Palenque, and other cities of the heyday of Mayan culture."
                            },
                            {
                                "example_id": "bd7b6d1f-8ae2-4e08-98f1-3112acabe744",
                                "sense_id": "7ea4a6e1-cc3d-35c3-9b00-037a259ffd9a",
                                "text": "Daraus ist zu sehen, dass sich aus der Region des Isthmus von Tehuantepec der wichtigste Strang vermutlich über die Küstenregion von Guatemala nach Süden ausdehnte, während ein anderer schon sehr früh zum Zentrum der Mayakultur gelangte.",
                                "translation": "This shows that from the region of the Isthmus of Tehuantepec the most important strand probably extended southwards across the coastal region of Guatemala, while another strand reached the centre of the Maya culture very early on.",
                                "english": "This shows that from the region of the Isthmus of Tehuantepec the most important strand probably extended southwards across the coastal region of Guatemala, while another strand reached the centre of the Maya culture very early on."
                            }
                        ]
                    }
