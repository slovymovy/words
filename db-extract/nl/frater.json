                    {
                        "translation_id": "d3026016-e328-4d2d-972e-dd55a40a1c11",
                        "source_entry_id": "1ab353dd-94d9-3a11-9ec3-1a1898e0786c",
                        "source_sense_id": "b2b64d9f-9ae1-3eb0-9f2b-793aa35a4b61",
