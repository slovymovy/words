                                        "glosses": [
                                            "Pitch-black; of the blackest black."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abc0a53-c66d-43a3-b58c-7693cb727997",
                                                "sense_id": "5b75a2b3-37af-3c85-8da4-eb2297ab7519",
                                                "text": "Year after year unto her feet, / She lying on her couch alone, / Across the purpled coverlet, / The maiden's jet-black hair has grown, […]"
                                            }
                                        ]
