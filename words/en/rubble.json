{
    "word_family": [
        "rubbly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                    "sense_definition": "The broken remains of an object, usually rock, masonry, or destroyed buildings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "debris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earthquake reduced the entire historic district to a pile of <w>rubble</w>.",
                            "target_lang_translations": {
                                "ru": "Землетрясение превратило весь исторический район в груду <w>обломков</w>."
                            }
                        },
                        {
                            "text": "Rescue workers searched through the <w>rubble</w> of the collapsed building for survivors.",
                            "target_lang_translations": {
                                "ru": "Спасатели искали выживших под <w>завалами</w> рухнувшего здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "debris",
                        "ruins",
                        "wreckage"
                    ],
                    "common_phrases": [
                        "pile of rubble",
                        "buried under rubble",
                        "reduced to rubble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушенные остатки объекта, обычно камня, кирпичной кладки или разрушенных зданий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обломки",
                                "target_lang_sense_clarification": "разрушенных зданий или конструкций"
                            },
                            {
                                "target_lang_word": "щебень",
                                "target_lang_sense_clarification": "мелкий битый камень или кирпич"
                            },
                            {
                                "target_lang_word": "руины",
                                "target_lang_sense_clarification": "остатки разрушенного строения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                    "sense_definition": "A mass or stratum of fragments of rock lying under the soil and derived from the neighbouring rock.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The overlying beds are composed of such calcareous <w>rubble</w> and flints, rudely stratified.",
                            "target_lang_translations": {
                                "ru": "Вышележащие пласты состоят из такого известнякового <w>щебня</w> и кремня, грубо стратифицированных."
                            }
                        },
                        {
                            "text": "Geologists analyzed the layer of <w>rubble</w> beneath the topsoil to determine the area's history.",
                            "target_lang_translations": {
                                "ru": "Геологи проанализировали слой <w>обломочной породы</w> под почвой, чтобы определить историю этого района."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса или пласт обломков горных пород, лежащих под почвой и образовавшихся из соседних пород."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щебень",
                                "target_lang_sense_clarification": "геологические обломки пород под почвой"
                            },
                            {
                                "target_lang_word": "обломочная порода",
                                "target_lang_sense_clarification": "скопление каменных обломков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c9de155-140c-34bb-bf85-a98a64033ebd",
                    "sense_definition": "The whole of the bran of wheat before it is sorted into pollard, bran, and other components.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "milling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the traditional milling process, the <w>rubble</w> is collected before being separated into finer grades.",
                            "target_lang_translations": {
                                "ru": "В процессе традиционного помола собирают <w>несортированные отруби</w>, прежде чем разделить их на более мелкие фракции."
                            }
                        },
                        {
                            "text": "The miller examined the coarse <w>rubble</w> to assess the quality of the wheat husk.",
                            "target_lang_translations": {
                                "ru": "Мельник осмотрел грубые <w>отруби</w>, чтобы оценить качество пшеничной шелухи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical milling contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вся масса пшеничных отрубей до их сортировки на мелкие отруби и другие компоненты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несортированные отруби",
                                "target_lang_sense_clarification": "в мукомольном производстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69bc4804-2cb4-3955-ad6d-8dbd6e670e53",
                    "sense_definition": "To reduce or break down into rubble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy artillery fire threatened to <w>rubble</w> the ancient fortress within days.",
                            "target_lang_translations": {
                                "ru": "Огонь тяжелой артиллерии грозил за несколько дней <w>превратить в руины</w> древнюю крепость."
                            }
                        },
                        {
                            "text": "The demolition crew managed to <w>rubble</w> the old concrete structure safely.",
                            "target_lang_translations": {
                                "ru": "Строителям удалось безопасно <w>разрушить</w> старую бетонную конструкцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "demolish",
                        "pulverize",
                        "wreck"
                    ],
                    "antonyms": [
                        "build",
                        "construct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превратить или разрушить в груду обломков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превратить в руины",
                                "target_lang_sense_clarification": "разрушить до основания"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "превратить в обломки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}