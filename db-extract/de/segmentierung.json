                ],
                "senses": [
                    {
                        "sense_id": "b3ccff4e-4a9a-3a84-9856-ddd232146d50",
                        "entry_id": "5c116c19-7436-3282-9a4b-2812eb8395b1",
                        "glosses": [
                            "Aufteilung, Zerlegung von etwas"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                        "entry_id": "5c116c19-7436-3282-9a4b-2812eb8395b1",
                        "glosses": [
                            "Analyseverfahren des Taxonomischen Strukturalismus: (Zerlegung) einer größeren Einheit in ihre Bestandteile, Konstituenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ddd5f0-8641-43da-86de-b74a95065103",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "Durch Segmentierung von Wörtern erhält man Laute, Silben oder Morphe."
                            },
                            {
                                "example_id": "586c5ee2-1449-49a5-ad93-5238437084fc",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "„Segmentierung und Klassifizierung (durch Distribution) sind nicht nur der Kern der Linguistik bei Harris, sondern sind die Hauptaufgaben der deskriptiven Linguistik in ihrer zweiten Entwicklungsphase.“"
                            },
                            {
                                "example_id": "c8f461f4-4552-4277-ba78-56176c07a3f2",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "„Die Diskussion über Segmentierung und Identifizierung rührt daher, dass man meint, mit einem Wort, das mit einem Begriff assoziiert ist, eine reale Entität exakt bestimmen, erfassen zu können.“"
                            },
                            {
                                "example_id": "5c4f2806-0651-4783-a873-52b7d0bb6823",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "„Inkohärente Segmentierungen findet man aber nicht nur bei singulären Fällen aus der großen Klasse der lexikalischen Morphe, sondern auch bei der Segmentierung von Flexionsendungen.“"
                            },
                            {
                                "example_id": "887b2e31-3d2d-4e15-a0a2-36ad72cf93c9",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "„Die Segmentierung von Wörtern in Morphe kann man unterschiedlich durchführen.“"
                            },
                            {
                                "example_id": "3a7b0156-5ca2-4217-ae3b-af0a03875c72",
                                "sense_id": "37a5acee-2791-3a50-94b9-20791ef92764",
                                "text": "„Zahlreiche amerikanische Arbeiten der frühen sechziger Jahre orientieren sich zunächst an den Methoden des klassischen Strukturalismus, in dem distributionelle Regularitäten durch Segmentierung und Klassifizierung ausfindig gemacht wurden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
