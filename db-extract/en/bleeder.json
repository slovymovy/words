                "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                "word": "bleeder",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9d20a602-266d-48da-99e9-424408cf7027",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "bleeders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d53abab-0e7e-3cf6-b75f-2819cea0c9bb",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "A person who is easily made to bleed, or who bleeds in unusually large amounts, particularly a hemophiliac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f4d34c-7129-49a5-b47e-9a32f2814595",
                                "sense_id": "1d53abab-0e7e-3cf6-b75f-2819cea0c9bb",
                                "text": "And then finally to pass on to the rising generation there were Sean's two little girls Rose and Cerise, aged five and four respectively, and these innocent little girlies were bleeders like their papa and mama […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5943f3bf-f793-3871-a4f8-861291a40d1c",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "A blood vessel that requires cauterization etc. to stop it from bleeding during surgery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40318713-8c45-4b7c-bb46-bc717edbcd8b",
                                "sense_id": "5943f3bf-f793-3871-a4f8-861291a40d1c",
                                "text": "Ligate or cauterize small subcutaneous bleeders and identify the linea alba."
                            }
                        ]
                    },
                    {
                        "sense_id": "33b8d724-af32-3126-9dcc-6956b1d36f47",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "Anything that saps a resource produced by something else."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "16e4da4f-1a1c-354e-a22a-1fa9da1181b2",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "A valve designed to release a small amount of excess pressure from a system."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bcdad1f0-5f95-3c20-b746-c7928d95a562",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "A troublesome fellow or thing; a blighter."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b46b01bf-e811-4f5d-b90b-b82adda12784",
                                "sense_id": "bcdad1f0-5f95-3c20-b746-c7928d95a562",
                                "text": "His brother caught three hundred cran when the seas were lavish, / Threw the bleeders back in the sea and went upon the parish."
                            },
                            {
                                "example_id": "a7c97fe7-b966-408f-a44a-516d9a101477",
                                "sense_id": "bcdad1f0-5f95-3c20-b746-c7928d95a562",
                                "text": "‘Well, what did the old bleeder say?’ said Opus Fluke."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5bb892e-21e7-3bc6-8c53-2d68938a3ce1",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "Synonym of scratch hit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ca12d84b-1010-351e-ab07-786791a9c3c1",
                        "entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
                        "glosses": [
                            "A person who menstruates (used in the context of transgender inclusivity)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb219c9-42ab-4325-9ab5-cf9e87124ed4",
                                "sense_id": "ca12d84b-1010-351e-ab07-786791a9c3c1",
                                "text": "Vostral (2008) sees menstrual technology as focused on allowing women to “pass” as non-bleeders, speaking to the sense of the female body as dysfunctional, problematic, and “out of control.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8d78b4e-e282-44a2-8cb4-3e9761b6f195",
                        "source_entry_id": "10b0a856-b7e9-3e92-9c86-2c195754b3a7",
