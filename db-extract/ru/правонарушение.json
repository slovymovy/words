                    {
                        "translation_id": "d48e0874-988d-461a-9f50-e986ec1208e6",
                        "source_entry_id": "5af3e611-5f86-37fa-9251-624b44500e03",
                        "source_sense_id": "5e9ad109-ee3a-3d94-83a4-fff2ada2267c",
                        "target_lang_word": "trespass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trespass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1268718-1bd8-3c71-a94d-a40c33d38c46",
                                        "entry_id": "950c3311-86d8-3123-898f-f25989bac40b",
                                        "glosses": [
                                            "An intentional interference with another's property or person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0f030e-a78b-4a0a-a2ef-5a888eaa0816",
                                                "sense_id": "d1268718-1bd8-3c71-a94d-a40c33d38c46",
                                                "text": "External infrastructure issues such as severe weather and trespass caused 17.1% of [train] cancellations, [...]."
                                            },
                                            {
                                                "example_id": "6fc44609-ba2d-4d40-b5cd-e36d4e02aa88",
                                                "sense_id": "d1268718-1bd8-3c71-a94d-a40c33d38c46",
                                                "text": "Network Rail has produced a free downloadable comic highlighting the consequences of railway trespass. Between March 23 and April 26, there were 1,024 trespass incidents on the railway. [...] it is based on the company's award-winning safety film 18, which shows the dangers of trespass, especially around electrified lines."
                                            },
                                            {
                                                "example_id": "88e0b183-fe6e-4238-bc59-96670ef5823e",
                                                "sense_id": "d1268718-1bd8-3c71-a94d-a40c33d38c46",
                                                "text": "Newark Mayor Ras Baraka \"committed trespass and ignored multiple warnings\" to leave Delaney Hall, a facility being run by Immigration and Customs Enforcement (ICE), according to acting US attorney for New Jersey Alina Habba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c75bedb-90b6-3e66-ad86-3cf9b953cbf0",
                                        "entry_id": "950c3311-86d8-3123-898f-f25989bac40b",
                                        "glosses": [
                                            "sin"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156b8926-701f-4ac8-9752-cb39948ff454",
                                                "sense_id": "0c75bedb-90b6-3e66-ad86-3cf9b953cbf0",
                                                "text": "Forgive us our trespasses, as we forgive those who trespass against us"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trespass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85082aec-611b-3dd6-817c-3e5d6548a622",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To commit an offence; to sin."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c9765b-f0ad-4841-89a8-8fa755436b0a",
                                                "sense_id": "85082aec-611b-3dd6-817c-3e5d6548a622",
                                                "text": "In the time of his distress did he trespass yet more against the Lord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375d0582-c051-3a47-b775-9a15b47283e2",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To offend against, to wrong (someone)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b8be478-628c-47cb-afab-4fc1f034e7fe",
                                                "sense_id": "375d0582-c051-3a47-b775-9a15b47283e2",
                                                "text": "And forgeve us oure trespases, even as we forgeve them which trespas us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874f4d74-860c-3d3f-b76c-dfc2635b73cc",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To go too far; to put someone to inconvenience by demand or importunity; to intrude."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b05de14a-2bd8-44ce-af87-4e7824fffdf3",
                                                "sense_id": "874f4d74-860c-3d3f-b76c-dfc2635b73cc",
                                                "text": "to trespass upon the time or patience of another"
                                            },
                                            {
                                                "example_id": "4c76601b-ab1d-4f04-9c15-48bc298432d6",
                                                "sense_id": "874f4d74-860c-3d3f-b76c-dfc2635b73cc",
                                                "text": "\"Indeed I have, sir,\" was her answer. \"She is a great deal too ill to be moved. Mr. Jones says we must not think of moving her. We must trespass a little longer on your kindness.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09aac67-8e4c-32fa-b99a-d1f6b4376aa7",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To enter someone else's property illegally."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31aca443-bf73-3ba5-ae07-dc824a6a1ff0",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To pass beyond a limit or boundary; hence, to depart; to go."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "287239eb-a442-4b12-829b-05a0ab171e06",
                                                "sense_id": "31aca443-bf73-3ba5-ae07-dc824a6a1ff0",
                                                "text": "1523–1525, Jean Froissart, John Bourchier, 2nd Baron Berners (translator), Froissart's Chronicles\nSoon after this, noble Robert de Bruce […] trespassed out of this uncertain world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f054ba-6772-3b4b-b377-537055b0021c",
                                        "entry_id": "15b848b0-bdf4-385e-8557-74b06d634369",
                                        "glosses": [
                                            "To subject [someone] to a trespass notice, formally notifying them that they are prohibited from entry to a property, such that any current or future presence there will constitute trespass, (especially) criminal trespass"
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe506f0-cf4a-4e0d-857b-99f508592696",
                                                "sense_id": "25f054ba-6772-3b4b-b377-537055b0021c",
                                                "text": "The dean trespassed the streaker from his university."
                                            },
                                            {
                                                "example_id": "6978efe4-33ec-47b2-ae4f-a64d50dc9b2f",
                                                "sense_id": "25f054ba-6772-3b4b-b377-537055b0021c",
                                                "text": "A year ago a sheep-man was allowing his flocks to trespass on another public-domain licensee. At his third offense, after warnings, he was \"trespassed\" and given a fairly stiff fine and a warning that a fourth offense would cost him his grazing rights."
                                            },
                                            {
                                                "example_id": "06fe9bf6-63a9-4076-9ff3-c15fc98951da",
                                                "sense_id": "25f054ba-6772-3b4b-b377-537055b0021c",
                                                "text": "\"I only grabbed your arm because I wanted to trespass you,\" the man said.\n\"What the hell does that mean?\" I replied.\nThe man walked into the building and came out with a laminated plastic card, like the one police use when they are reading suspects their rights. He read a warning: \"You are hereby notified that you are trespassing on private property. If you do not leave this property, you will be guilty of trespass under Nevada Revised Statutes... etc., etc.\"\nHaving been so \"trespassed,\" I then decided it was prudent to leave."
                                            },
                                            {
                                                "example_id": "54e336b9-3b3f-4fc5-8acf-ac07367082a3",
                                                "sense_id": "25f054ba-6772-3b4b-b377-537055b0021c",
                                                "text": "The entire police force has in effect been trespassed from a Wellington property to stop officers checking whether a heavy-sleeping offender is complying with an overnight bail curfew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
