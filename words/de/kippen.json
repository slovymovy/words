                    ]
                },
                {
                    "sense_id": "3440a00a-a1bc-3123-bd9b-7a0bcb36e2d9",
                    "sense_definition": "Eine Flüssigkeit oder Schüttgut durch Neigen eines Behälters ausschütten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schuetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Koch <w>kippte</w> die restliche Gemüsebrühe vorsichtig in den großen Topf."
                        },
                        {
                            "text": "Der Lastwagen <w>kippte</w> den Sand direkt vor das Garagentor."
