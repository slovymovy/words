                        "entry_id": "f434e87e-d642-3914-8363-575a874bcd24",
                        "glosses": [
                            "To move by hopping or with a hopping motion."
                        ],
                        "tags": [
                            "informal",
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "89fb6515-cf3b-40ef-bc2e-cfcbff8e529f",
                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                "text": "Placing the hoops in this position makes skirts hip hop with a swirl."
                            },
                            {
                                "example_id": "edc6efe1-6060-45d4-b0ed-d9c8e29f59d1",
                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                "text": "I have a bunny and he goes hip hop, I often wonder if he cannot stop."
                            },
                            {
                                "example_id": "8e7c33b4-3eb1-482c-b0ae-0ce7d9a48946",
                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                "text": "Like magic, the frog hip-hopped out of her thoughts and the starlings came fluttering back and Sammy was there."
                            }
                        ]
                    },
                    {
                        "sense_id": "b63f4736-e8f2-3934-92fb-80de58a2432d",
                        "entry_id": "f434e87e-d642-3914-8363-575a874bcd24",
                        "glosses": [
                            "To perform hip-hop music."
                        ],
                        "tags": [
