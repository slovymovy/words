                    {
                        "translation_id": "a7cbea3e-96d1-4d98-b86f-83e9babffb77",
                        "source_entry_id": "60bdb6df-c429-35eb-9c5a-257d594f98a2",
                        "source_sense_description": "действие",
                        "target_lang_word": "saturation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saturation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef168681-55b7-3bd6-900f-82f80b17b1eb",
                                        "entry_id": "12add6a8-5dfe-3cee-aeab-258e72071400",
                                        "glosses": [
                                            "Action ou résultat de saturer, atteinte d'un seuil maximum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c49bfc1-206c-42f6-8281-b76142246b1f",
                                                "sense_id": "ef168681-55b7-3bd6-900f-82f80b17b1eb",
                                                "text": "Le bébé pleure parfois après avoir beaucoup joué, […]. Son pleur est alors l’expression de sa saturation. Il a besoin de calme. Pas la peine d'en rajouter en faisant les marionnettes ou en l'emmenant en balade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d299f51-daa5-35f1-bfe7-beb062686768",
                                        "entry_id": "12add6a8-5dfe-3cee-aeab-258e72071400",
                                        "glosses": [
                                            "État d’un liquide ayant absorbé la quantité maximale d’une substance en solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dad93f2-fd31-463b-ba3d-068b31acdd3a",
                                                "sense_id": "3d299f51-daa5-35f1-bfe7-beb062686768",
                                                "text": "Porter à saturation."
                                            },
                                            {
                                                "example_id": "be9510d7-65d5-4b18-86cb-26186a9fec6a",
                                                "sense_id": "3d299f51-daa5-35f1-bfe7-beb062686768",
                                                "text": "Jusqu’à saturation."
                                            },
                                            {
                                                "example_id": "1c87b4be-088f-4def-8047-036207323b58",
                                                "sense_id": "3d299f51-daa5-35f1-bfe7-beb062686768",
                                                "text": "Être à saturation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78fe6d71-f006-3f88-9570-e2690b2cc972",
                                        "entry_id": "12add6a8-5dfe-3cee-aeab-258e72071400",
                                        "glosses": [
                                            "Vivacité de la coloration, intensité de la teinte d’une couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2093b1e-e453-4901-ac8d-49b5153e70c8",
                                                "sense_id": "78fe6d71-f006-3f88-9570-e2690b2cc972",
                                                "text": "Dans un premier temps, les trois couleurs primaires permettent d’apprécier tel ou tel stimulus coloré. Mais quels sont les rapports réciproques de teinte, de ton, de saturation et de surface ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dffc59f-5c82-3759-a2a9-ceb531b0ef03",
                                        "entry_id": "12add6a8-5dfe-3cee-aeab-258e72071400",
                                        "glosses": [
                                            "Caractère d’une couleur traduisant la proximité des sensations produites par cette couleur et la couleur pure de même ton et de même luminosité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6c169f2-945f-3fb6-9e2f-a871b64aaf09",
                                        "entry_id": "12add6a8-5dfe-3cee-aeab-258e72071400",
                                        "glosses": [
                                            "Taux de saturation de l’hémoglobine."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
