{
    "word_family": [
        "rugissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9fa8e7c2-3451-33f3-bfcf-db67d561bc1c",
                    "sense_definition": "Pousser un cri puissant et rauque, en parlant des grands félins comme le lion ou le tigre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au loin dans la savane, on pouvait entendre le lion <w>rugir</w> pour marquer son territoire."
                        },
                        {
                            "text": "La tigresse s'est mise à <w>rugir</w> dès qu'elle a senti une menace pour ses petits."
                        }
                    ],
                    "common_phrases": [
                        "rugir comme un lion"
                    ]
                },
                {
                    "sense_id": "82cde87c-b3f1-3cb2-b4ea-0f1eefee9d66",
                    "sense_definition": "Pousser des cris violents sous l'effet d'une émotion intense, en particulier la fureur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_humaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur s'est mis à <w>rugir</w> de colère en découvrant l'erreur commise par son équipe."
                        },
                        {
                            "text": "Face à cette terrible injustice, l'accusé a <w>rugi</w> de désespoir devant les juges impassibles."
                        }
                    ],
                    "synonyms": [
                        "hurler"
                    ],
                    "antonyms": [
                        "chuchoter",
                        "murmurer"
                    ],
                    "common_phrases": [
                        "rugir de colère",
                        "rugir de rage"
                    ]
                },
                {
                    "sense_id": "b6f47c6c-f61c-3029-bd67-05bed162dcd0",
                    "sense_definition": "Produire un bruit sourd, puissant et continu, en parlant du vent, des flots ou d'un moteur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune pilote adore faire <w>rugir</w> le moteur de sa nouvelle voiture de sport."
                        },
                        {
                            "text": "Pendant toute la nuit, la tempête a fait <w>rugir</w> les vagues contre les falaises de l'île."
                        }
                    ],
                    "synonyms": [
                        "gronder"
                    ],
                    "common_phrases": [
                        "faire rugir le moteur"
                    ]
                }
            ]
        }
    ]
}