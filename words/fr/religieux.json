                        "femme religieuse"
                    ]
                },
                {
                    "sense_id": "a78589a1-cd3e-3766-bd0e-c7112927edbd",
                    "sense_definition": "Qui évoque le recueillement ou inspire un respect profond, quasi sacré.",
