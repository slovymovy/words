                "senses": [
                    {
                        "sense_id": "34494b3c-03e0-37ff-9e6e-b0ca931f7083",
                        "entry_id": "0aecafbc-a111-3594-8690-9ee7cf9a1e71",
                        "glosses": [
                            "Wissen um die Schädlichkeit einer Maßnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8ae65b-9b6c-4304-aa8a-1a00a71e1a1c",
                                "sense_id": "34494b3c-03e0-37ff-9e6e-b0ca931f7083",
                                "text": "Viele Gegenanzeigen findet man in den Packungsbeilagen von Medikamenten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "782231f3-7540-36e3-a746-7c87e4fee433",
                        "entry_id": "0aecafbc-a111-3594-8690-9ee7cf9a1e71",
                        "glosses": [
                            "Anzeige, mit der auf eine Anzeige der Gegenpartei reagiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff250adc-da65-43fc-bc51-7dd29ca2aa3a",
                                "sense_id": "782231f3-7540-36e3-a746-7c87e4fee433",
                                "text": "„Sie revanchierte sich mit einer Gegenanzeige, weil die gestohlenen beiden Laibe frisch gebacken waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
