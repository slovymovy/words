                                    {
                                        "sense_id": "3f64f666-434f-3300-b99e-115440b850ed",
                                        "entry_id": "1a356f25-ca82-3368-926a-dfcd18e69e84",
                                        "glosses": [
                                            "Activité du détaillant, consistant à vendre des marchandises à l’unité ou par petite quantité à un client dans un magasin, une boutique, au marché ou par correspondance à l’aide d'un catalogue ou d’un site Internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e5e6d6-78de-4bbe-92a7-cab37287eb36",
                                                "sense_id": "3f64f666-434f-3300-b99e-115440b850ed",
                                                "text": "Il ne faut pas se le dissimuler, il n’y a presque plus que le commerce de détail qui se fasse avec des métaux. Le commerce en grand n’emploie communément que des échanges réciproques & des lettres de change."
                                            },
                                            {
                                                "example_id": "ca04a5ba-d3c6-44af-afa8-cb0c187facd6",
                                                "sense_id": "3f64f666-434f-3300-b99e-115440b850ed",
                                                "text": "Ainsi le locataire d’une boutique destinée à l’exercice d’un commerce de détail ne contrevient pas à son bail en établissant dans une autre rue un commerce de gros, et en allant lui-même habiter au siège de cet établissement, si d’ailleurs il continue par l’intermédiaire d’un commis l’exploitation de son commerce de détail."
                                            }
                                        ]
                                    }
