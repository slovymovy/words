                ],
                "senses": [
                    {
                        "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                        "entry_id": "2389b50d-5940-3ed4-805b-dd678a4bb627",
                        "glosses": [
                            "Lärm, der vom Verkehr ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172f5ff1-32f1-4afb-9d51-5e689f71b9c9",
                                "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                                "text": "„Ihr Fremdenführer, dessen Redeschwall im Verkehrslärm unterging, fuchtelte wild mit den Armen und deutete auf das gegenüberliegende Gebäude.“"
                            },
                            {
                                "example_id": "60c0520c-2d98-46f2-84bb-15a6463b5d3a",
                                "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                                "text": "„Vor Verkehrslärm schützt die Verkehrslärmschutzverordnung.“"
                            },
                            {
                                "example_id": "bc38bc4e-4c9f-4c2e-a73b-7d20f8a980ef",
                                "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                                "text": "„Er muss auch in der Lage sein, aus dem allgemeinen Verkehrslärm die bedrohlichen und dringlichen Verkehrsgeräusche herauszufiltern.“"
                            },
                            {
                                "example_id": "2809b5b9-7efb-4fd5-a263-cb7471b31e0d",
                                "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                                "text": "„Das Risiko, einen Herzinfarkt zu erleiden, ist demnach bei Männern, die längere Zeit in Gebieten mit hohem Verkehrslärm wohnen, um 30 Prozent erhöht.“"
                            },
                            {
                                "example_id": "80880c11-c83b-4a46-aa9c-a9478041801f",
                                "sense_id": "acbf6106-5ed1-362c-a010-d3d3045b0502",
                                "text": "„Ohne Übertreibung gehört der Verkehrslärm zu den größten Umweltproblemen unserer Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
