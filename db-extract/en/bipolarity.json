                ],
                "senses": [
                    {
                        "sense_id": "ca711856-afff-357f-92a7-558e6427ea4c",
                        "entry_id": "368f52a2-45e4-3c1d-980b-f15b63a24a29",
                        "glosses": [
                            "The state of being bipolar."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "716ef166-52bb-4040-a59b-c43ba1ab93af",
                                "sense_id": "ca711856-afff-357f-92a7-558e6427ea4c",
                                "text": "The 1990s confirmed the United States as the world's sole superpower. Bipolarity had disappeared with the Soviet Union; contrary to predictions, Germany and Japan had not yet turned economic muscle into military might to create a new era of “multipolarity.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39871e88-1e8f-4a9a-afa4-db873b97e5a1",
                        "source_entry_id": "368f52a2-45e4-3c1d-980b-f15b63a24a29",
                        "source_sense_id": "ca711856-afff-357f-92a7-558e6427ea4c",
                        "source_sense_description": "state of being bipolar",
                        "target_lang_word": "bipolarité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bipolarité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09ebe094-2183-3b95-a556-68007f5c3164",
                                        "entry_id": "f3474d6b-23a3-38b8-8723-d927ef08b82a",
                                        "glosses": [
                                            "État d’un corps qui, animé d’électricité magnétique, a deux pôles doués d’une vertu contraire."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988f04e2-3c4a-4de6-9243-bc0a40c708ea",
                                                "sense_id": "09ebe094-2183-3b95-a556-68007f5c3164",
                                                "text": "La bipolarité d’un aimant."
                                            },
                                            {
                                                "example_id": "29432007-241d-4dc0-97a5-aec0ebf91346",
                                                "sense_id": "09ebe094-2183-3b95-a556-68007f5c3164",
                                                "text": "La pile voltaïque présente la bipolarité, ayant deux pôles, un positif, l’autre négatif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a095df-44ed-3571-a872-e0ba6c87d748",
                                        "entry_id": "f3474d6b-23a3-38b8-8723-d927ef08b82a",
                                        "glosses": [
                                            "Manifestation ou caractère du trouble bipolaire, auparavant appelé psychose maniaco-dépressive, trouble maniaco-dépressif ou maniaco-dépression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dcecf1d-3c92-4454-a274-31aee8a6bf71",
                                                "sense_id": "52a095df-44ed-3571-a872-e0ba6c87d748",
                                                "text": "Le principe de base du spectre de la bipolarité est que ces états cliniques phénotypiques de type unipolaire chez les apparentés de bipolaires devrait très probablement correspondre à des génotypes bipolaires"
                                            },
                                            {
                                                "example_id": "7a60e2dc-7317-4489-8aae-12dbd9964cec",
                                                "sense_id": "52a095df-44ed-3571-a872-e0ba6c87d748",
                                                "text": "Lucile partage avec Garouste un certain nombre de points communs, à commencer par la maladie dont ils ont souffert tous les deux, longtemps appelée psychose maniaco-dépressive et qu’on appelle aujourd’hui bipolarité."
                                            },
                                            {
                                                "example_id": "5f0177ab-d682-40df-b145-a867290bb2ad",
                                                "sense_id": "52a095df-44ed-3571-a872-e0ba6c87d748",
                                                "text": "Je ne suis pas bipolaire. Or grâce à la littérature, je peux mieux appréhender la manière dont la bipolarité est vécue à travers une subjectivité mise en forme, en mots, ce que ne permet pas la lecture d'un manuel de psychiatrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b7d8ce-4350-3a18-a682-82761cfbd9b3",
                                        "entry_id": "f3474d6b-23a3-38b8-8723-d927ef08b82a",
                                        "glosses": [
                                            "Possibilité de vivre à la fois aux deux pôles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce14cfde-e8c3-4f08-80cb-21b30603014e",
                                                "sense_id": "94b7d8ce-4350-3a18-a682-82761cfbd9b3",
                                                "text": "Il fut l’avocat de la bipolarité des organismes et soutint longtemps la permanence des océans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
