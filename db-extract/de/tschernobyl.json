                            "singular"
                        ],
                        "form": "(dem) Tschernobyl"
                    },
                    {
                        "form_id": "38b27e0b-e3c7-4a19-96e3-ae8642cee4c8",
                        "entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "(das) Tschernobyl"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                        "entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "glosses": [
                            "russische Schreibweise der ukrainischen Stadt Tschornobyl (Чорнобиль)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf564b8-db8e-42a7-8e67-4dd9b6ea6ccf",
                                "sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                                "text": "Sie stammt aus Tschernobyl."
                            },
                            {
                                "example_id": "e97b3036-f39d-4de7-8fad-8baefac608e9",
                                "sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                                "text": "„Vor Zufällen ist niemand sicher, auch vor terroristischen Akten nicht, von Kriegshandlungen ganz zu schweigen. Eine Situation wie die in Tschernobyl kann sich also im Prinzip wiederholen.“"
                            },
                            {
                                "example_id": "aae259db-7d5f-4c71-80ce-d3c254fa13d4",
                                "sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                                "text": "„Weißrussische Behörden bestätigten zwar am Freitag ausgedehnte Flächenbrände in der Todeszone von Tschernobyl.“"
                            },
                            {
                                "example_id": "7582dfbd-e521-4343-a2e2-08f229c0f953",
                                "sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                                "text": "„In dieser misslichen Lage erreicht uns die Nachricht, dass in Tschernobyl ein Bison gestorben ist, der einst dorthin verbracht wurde, um das Gras in der Todeszone kurz zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b233d7d-f393-3560-88f7-2c5307f33123",
                        "entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "glosses": [
                            "Metonym für die schwere Reaktorkatastrophe, die sich 1986 in der Stadt ereignete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "948e2930-77a8-440a-afcf-1b2dfc2575da",
                                "sense_id": "3b233d7d-f393-3560-88f7-2c5307f33123",
                                "text": "Viele Menschen fragen sich, ob Tschernobyl sich wiederholen könnte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5f4c41e-4915-45dd-bf56-cccd86c73e3e",
                        "source_entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "source_sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                        "target_lang_word": "Chernobyl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chernobyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbb8293-68a4-3bf2-a148-d69a29186aab",
                                        "entry_id": "18ad0192-f64a-3925-94df-da36100aa6df",
                                        "glosses": [
                                            "A partially abandoned city and ghost town in northern Ukraine, known as the site of a nuclear disaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a747a90-5623-4251-8315-bf06b9e7aa0c",
                                                "sense_id": "cdbb8293-68a4-3bf2-a148-d69a29186aab",
                                                "text": "A couple of oil shocks, a Chernobyl meltdown, and a Gulf War later, his basic message - the need to emphasize efficiency and renewable resources over oil and nuclear power - is still a minority view,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e982a328-c067-3574-b7e6-0b35d3544858",
                                        "entry_id": "18ad0192-f64a-3925-94df-da36100aa6df",
                                        "glosses": [
                                            "The 1986 nuclear accident which resulted in the abandonment of the aforementioned city."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2005ada0-1ba8-4a35-878d-8a1a5bf711aa",
                                                "sense_id": "e982a328-c067-3574-b7e6-0b35d3544858",
                                                "text": "After Chernobyl, very few nuclear power plants were built for years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Chernobyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2fbea54-44ce-3764-ba3f-31761299db96",
                                        "entry_id": "5c34522e-f785-3cb0-98df-a1337da5a51f",
                                        "glosses": [
                                            "A major nuclear-energy accident."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6197ebf-a046-4110-bcb0-42632dc75508",
                                                "sense_id": "e2fbea54-44ce-3764-ba3f-31761299db96",
                                                "text": "Many secret cities were Chernobyls in slow motion."
                                            },
                                            {
                                                "example_id": "024c06ba-6a8f-421a-9ae8-c1f2e1bf4cdd",
                                                "sense_id": "e2fbea54-44ce-3764-ba3f-31761299db96",
                                                "text": "The effects of a Chernobyl disaster in my community would probably be barely noticeable."
                                            },
                                            {
                                                "example_id": "e72c8fec-bb6a-4f79-99a9-58fd411b28ca",
                                                "sense_id": "e2fbea54-44ce-3764-ba3f-31761299db96",
                                                "text": "So those would be a lot of Chernobyls that the ecosystem would have to deal with."
                                            },
                                            {
                                                "example_id": "de4110e0-384b-4b1b-b70d-9414740e6772",
                                                "sense_id": "e2fbea54-44ce-3764-ba3f-31761299db96",
                                                "text": "It has to be handled properly with great accuracy and no room for mistakes, because if we do have like a Chernobyl catastrophe, God forbid, it could wipe out our entire people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc91c5a6-83c5-4b8d-be63-7be775bf5dd4",
                        "source_entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "source_sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
                        "target_lang_word": "Tchernobyl",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tchernobyl",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cde0b442-8490-354f-bf1a-4c5537053875",
                                        "entry_id": "10535900-b880-3724-8d31-4f0a41fc5db2",
                                        "glosses": [
                                            "Ville d’Ukraine, située dans l'oblast de Kiev."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66f44b76-88af-4e0f-8d69-68f14e2f5e7e",
                                                "sense_id": "cde0b442-8490-354f-bf1a-4c5537053875",
                                                "text": "En outre, contrairement à celui de Tchernobyl, ils sont munis d’une enceinte de confinement, qui restreindrait le relâchement de la radioactivité en cas d’accident grave."
                                            },
                                            {
                                                "example_id": "86ec4edf-7a63-4622-a8ce-8dd618d12282",
                                                "sense_id": "cde0b442-8490-354f-bf1a-4c5537053875",
                                                "text": "Les cure-dents de notre auberge en disaient autant sur le pays que l’entretien du réseau routier. A contrario, dans l’Ukraine socialiste des années 1980, les lampadaires cassés présageaient Tchernobyl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64e1d542-edb1-46fd-83db-0b2d5443c456",
                        "source_entry_id": "f768b48a-abac-3d19-904e-776a02f12892",
                        "source_sense_id": "52f54bc0-8412-3600-b82d-b78eb13be9ba",
