                "senses": [
                    {
                        "sense_id": "71b3302a-8a36-3500-8662-6ce3c34371fb",
                        "entry_id": "c0ad4b02-d2d3-3a02-a076-816e5fa066c1",
                        "glosses": [
                            "uit zaad opgekweekte plant, het stadium volgend op de kiemplant, waarin de eerste blaadjes verschijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42c5234c-eb25-4ce0-92a2-10ee2f43a672",
                                "sense_id": "71b3302a-8a36-3500-8662-6ce3c34371fb",
                                "text": "Bij de opkweek van bosbomen wordt ook gebruikt gemaakt van zaailingen."
                            },
                            {
                                "example_id": "171a69e3-d328-4087-bd5d-0e7aa23aeae9",
                                "sense_id": "71b3302a-8a36-3500-8662-6ce3c34371fb",
                                "text": "Ik wied, ik volg mijn diepste wet\nals ik de naakte zaailing zet;\nik richt mij op, ik buig mij neer.\nEen tuinman ben ik en niets meer."
                            }
                        ]
                    },
                    {
                        "sense_id": "40a3e19c-1297-36ea-beb3-83b2fb64ef7a",
                        "entry_id": "c0ad4b02-d2d3-3a02-a076-816e5fa066c1",
                        "glosses": [
                            "vrouwelijke, zaaddragende plant van hennep of vlas\\nDeze benaming houdt vooral verband met de hennepteelt voor vezels, omdat de vrouwelijke planten voor dat doel later werden geoogst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c50a83-5a3c-4ea5-bd01-5c78b95d45d9",
                                "sense_id": "40a3e19c-1297-36ea-beb3-83b2fb64ef7a",
                                "text": "Ook de tegenstelling tussen de geslachtsbenamingen zaailing (‘zaaddragend’) en gelling (‘onvruchtbaar’ dus ‘niet-zaaddragend’) berust derhalve op een logisch benoemingsprincipe."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b5d59bb-682b-31c5-bb79-86a7878f959b",
                        "entry_id": "c0ad4b02-d2d3-3a02-a076-816e5fa066c1",
                        "glosses": [
                            "gezwel dat is ontstaan door kwaadaardige cellen die zich vanuit een oorspronkelijk gezwel door het lichaam hebben verplaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe628528-7cf2-4443-a722-d1d385ad098f",
                                "sense_id": "8b5d59bb-682b-31c5-bb79-86a7878f959b",
                                "text": "Er is eerder sprake van een multifocaal ontstaan dan van een \"zaailing\" of metastase."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec55c2eb-79a3-4c9a-bb2a-5c9c394e0f38",
                        "source_entry_id": "c0ad4b02-d2d3-3a02-a076-816e5fa066c1",
                        "source_sense_id": "71b3302a-8a36-3500-8662-6ce3c34371fb",
                        "source_sense_description": "uit zaad opgekweekte plant, het stadium volgend op de kiemplant",
                        "target_lang_word": "Sämling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sämling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                        "entry_id": "7e9328c2-41c9-30bf-9020-90b87bb3becf",
                                        "glosses": [
                                            "junge, aus Samen durch Keimung selbstständig hervorgegangene oder vom Menschen gezogene Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375bee3b-5abd-4231-8601-3a18c476d8a2",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Fast 40.000 Sämlinge zieht Klaus Olbricht in Dresden jährlich aus Kreuzungen heran."
                                            },
                                            {
                                                "example_id": "d0c5a7bb-855b-4d7c-bd6c-8fbbb47aad7f",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Vor der Haustür war aus einem Sämling ein Vogelbeerbaum gewachsen, die Beeren hatten die gleiche Farbe wie die roten Ziegel auf dem Dach."
                                            },
                                            {
                                                "example_id": "e59dd2fe-9ca4-4415-8ff2-9fcd21e3902b",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Silbrig glitzernde Schleimspuren auf Wegen und Tischen, erschreckende Fraßbilder an zarten Gewächsen, spurlos verschwundene Sämlinge, und die neue Mandragora, von der wir eine zauberkräftige Alraunwurzel zu gewinnen hofften, ist rettungslos dahin: Alle reden wieder von den Schnecken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                        "entry_id": "7e9328c2-41c9-30bf-9020-90b87bb3becf",
                                        "glosses": [
                                            "Kurzform für die Rebsorte Sämling 88"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7d34aa-9212-4c7f-90f8-240cc10068c6",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Sämling, der österreichische Begriff für die klassische Scheurebe, hat als typische Aromen tropische Früchte und Pfirsich im Gepäck."
                                            },
                                            {
                                                "example_id": "55b41d1c-e9f3-419c-a058-a8fed7dec3bf",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Die 2006er Auslese von Tschida vom Neusiedlersee, eine Cuvée aus Sämling, Chardonnay und Weißburgunder, passt trotz ihrer Lieblichkeit mit feinen Säure perfekt zu den Früchten des Nachtischs."
                                            },
                                            {
                                                "example_id": "ed92c1ec-460d-4a1d-966f-9b795f2eb469",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Dieser besteht aus Sämling und Sauvignon Blanc, hat eine absolut spannenden exotischen Duft, Zitrus-Töne, ist spritzig und leicht am Gaumen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
