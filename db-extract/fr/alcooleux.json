                "senses": [
                    {
                        "sense_id": "95336c9f-3339-30bd-889d-9cc42149c221",
                        "entry_id": "c894231c-2f4a-3456-b34c-fc1248e84039",
                        "glosses": [
                            "Fort en alcool."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6e79254a-b8d8-4601-8d70-51c1852cdb28",
                                "sense_id": "95336c9f-3339-30bd-889d-9cc42149c221",
                                "text": "Le danger, c’est d’arriver à des vins trop alcooleux, les vins à 14 % d’alcool, ce n’est pas Bordeaux."
                            },
                            {
                                "example_id": "3af4b2c4-fa8a-4934-bc9d-eea2a42b8e82",
                                "sense_id": "95336c9f-3339-30bd-889d-9cc42149c221",
                                "text": "Peu alcooleux (40°), peu puissant, le Fujimi révèle une touche de fumée."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e609c3f-80df-33d5-b32a-80ca1ff3e19b",
                        "entry_id": "c894231c-2f4a-3456-b34c-fc1248e84039",
                        "glosses": [
                            "Qui présente un goût marqué d’alcool en bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e34c58c-65fb-4058-a846-f8b36d197792",
                                "sense_id": "1e609c3f-80df-33d5-b32a-80ca1ff3e19b",
                                "text": "Il est vrai que les rouges secs de la région ont parfois tendance à être alcooleux, tout en présentant des notes de pruneaux et autres fruits cuits."
                            },
                            {
                                "example_id": "0413f6ff-00f5-4366-a62f-a41bae5c4ca1",
                                "sense_id": "1e609c3f-80df-33d5-b32a-80ca1ff3e19b",
                                "text": "Trop froid, le vin se referme et ne se livre pas ; trop chaud, il donne une sensation alcooleuse et brûlante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9233e46b-ff9a-4996-ac96-7d5fb1e569fb",
                        "source_entry_id": "c894231c-2f4a-3456-b34c-fc1248e84039",
                        "target_lang_word": "boozy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boozy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a8f8909-693e-3cf0-aee6-772396d33684",
                                        "entry_id": "93f8f3b2-7060-30da-8197-e6e014c2a91f",
                                        "glosses": [
                                            "Intoxicated by alcohol."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71e1bb91-fa96-3b12-ad8b-9d9df6586dc8",
                                        "entry_id": "93f8f3b2-7060-30da-8197-e6e014c2a91f",
                                        "glosses": [
                                            "Inclined to consume a significant amount of alcohol."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587a9c9d-48a9-4bf9-bfee-49eb472a57f3",
                                                "sense_id": "71e1bb91-fa96-3b12-ad8b-9d9df6586dc8",
                                                "text": "Dirty Davy had brought with him his chief clerk, who was a facetious personage, and boozy, and on the confidential footing of a common rascality with his master, who, after the fashion of Harry V. in his nonage, condescended in his frolics and his cups to men of low estate […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df9f0c9-2997-3d73-951a-04d69849292b",
                                        "entry_id": "93f8f3b2-7060-30da-8197-e6e014c2a91f",
                                        "glosses": [
                                            "Involving a large consumption of alcohol."
                                        ],
                                        "tags": [
                                            "of an event"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a89722-a6ba-4224-b55e-f6d0e7ec7535",
                                                "sense_id": "4df9f0c9-2997-3d73-951a-04d69849292b",
                                                "text": "We all had hangovers after a boozy weekend in town."
                                            },
                                            {
                                                "example_id": "7efc3131-970d-49f1-9381-9a7d659f7d08",
                                                "sense_id": "4df9f0c9-2997-3d73-951a-04d69849292b",
                                                "text": "Once the concert was over I settled back into my boozy routine, wine at home with my family, cognac in my studio when I was composing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                                        "entry_id": "93f8f3b2-7060-30da-8197-e6e014c2a91f",
                                        "glosses": [
                                            "Containing or cooked with alcohol."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be37364f-6cfa-4546-b570-910490e5bb67",
                                                "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                                                "text": "For dessert, the hosts treated us to a helping of boozy apple pie."
                                            },
                                            {
                                                "example_id": "ee18010c-9507-4d3c-a529-c69e9ed9ee31",
                                                "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                                                "text": "You embodied that good done-in mama who gives and gives like a fountain of boozy chicken soup to a rat race of men."
                                            },
                                            {
                                                "example_id": "b4044447-245b-4d8a-b6bc-d4594922affb",
                                                "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                                                "text": "Now both sitting, we shoveled into the whorls of the boozy ice cream peach orchard, sweet, tart and cold, filling while it offered the same medicinal stomach coating as a shot glass of Pepto Bismal, only much more to my taste."
                                            },
                                            {
                                                "example_id": "6a341909-c97f-433a-905b-439d84ec0b86",
                                                "sense_id": "0bb1c5a4-720e-3b78-8a0a-ca86bdf27d36",
                                                "text": "Sweetened crème fraîche ties the compote together with the slightly bitter, boozy caramel sauce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
