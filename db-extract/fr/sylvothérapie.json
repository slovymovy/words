                ],
                "senses": [
                    {
                        "sense_id": "b5ec98e3-3411-3291-8961-1459aa1ed437",
                        "entry_id": "718a916f-1868-397f-99f1-068b309a4e8f",
                        "glosses": [
                            "Traitement de certaines affections physiques ou psychologiques par le contact avec les arbres en forêt."
                        ],
                        "tags": [
                            "Médecine non conventionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "8e8759cb-d53d-40ce-b71b-8ac258ee0f00",
                                "sense_id": "b5ec98e3-3411-3291-8961-1459aa1ed437",
                                "text": "En Italie, la sylvothérapie fait partie du cursus des naturopathes à l’université ; on y rappelle le pouvoir purificateur de la chlorophylle sur l’air et les bienfaits pour l’organisme de la concentration d’ions négatifs."
                            },
                            {
                                "example_id": "28d01eb4-2225-4537-aa34-ad6d38b37483",
                                "sense_id": "b5ec98e3-3411-3291-8961-1459aa1ed437",
                                "text": "C’est l’idée de la sylvothérapie, ou thérapie forestière, qui invite le marcheur, parfois accompagné d’un guide, à repérer ce qui se passe en soi et autour de soi."
                            },
                            {
                                "example_id": "8ea9a91a-ed27-4c4e-b7c7-e024973c7432",
                                "sense_id": "b5ec98e3-3411-3291-8961-1459aa1ed437",
                                "text": "La sylvothérapie est un mode de soin qui repose sur une idée simple : le contact avec les arbres peut apporter de meilleures sensations de bien-être psycho-physique."
                            }
                        ]
                    }
                ],
