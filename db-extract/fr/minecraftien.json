                "senses": [
                    {
                        "sense_id": "d0cb6415-a163-3745-adc6-998aace2a2a7",
                        "entry_id": "876bee02-3638-32d6-9eeb-491328f23bb6",
                        "glosses": [
                            "Personne qui joue au jeu vidéo Minecraft."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "0be5a8a0-6ba0-4891-a28c-3a2f1ee9f02b",
                                "sense_id": "d0cb6415-a163-3745-adc6-998aace2a2a7",
                                "text": "Malgré les promesses de Billy, je n’ai eu aucune nouvelle de lui ajourd’hui. Je commence à regretter de lui avoir donné cette potion, surtout après qu’il a avoué être un voleur. Une fiole, ça vaut beaucoup d’argent. Il est peut-être allé la vendre à un minecraftien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97ca0b41-0035-4fc5-987e-bfde7c9ea125",
                        "source_entry_id": "876bee02-3638-32d6-9eeb-491328f23bb6",
                        "source_sense_id": "d0cb6415-a163-3745-adc6-998aace2a2a7",
