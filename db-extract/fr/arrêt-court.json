                "senses": [
                    {
                        "sense_id": "349f6547-3a96-3be3-a215-37336dca163e",
                        "entry_id": "c7fe057e-9693-3d34-98d2-0845bfc75e91",
                        "glosses": [
                            "Joueur défensif de baseball qui joue entre le deuxième et le troisième but."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db49644-6d42-4a28-96bc-79382d786039",
                        "source_entry_id": "c7fe057e-9693-3d34-98d2-0845bfc75e91",
                        "source_sense_id": "349f6547-3a96-3be3-a215-37336dca163e",
                        "target_lang_word": "shortstop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shortstop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                        "entry_id": "899f7381-901f-3cb3-84ed-5eecfc8a43d5",
                                        "glosses": [
                                            "Alternative form of short-stop (to play shortstop)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4149211-2204-4676-b05e-3c4a6842e2fd",
                                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                                "text": "He captained the Tecumsehs of London, Ontario, (International Association) in 1878; shortstopped for Cincinnati in 1879; stayed out of baseball in 1880; and finished as shortstop for Boston (NL) in 1881."
                                            },
                                            {
                                                "example_id": "aedd9de5-0bf1-4ac3-9c0c-f0c72caa6dfc",
                                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                                "text": "Managed and shortstopped by George Wright and full of league stalwarts—Joe Start, Paul Hines, and Jim O'rourke—they also had 1-year-old phenom Monte Ward as primary moundsman (teams now generally used multiple pitchers)."
                                            },
                                            {
                                                "example_id": "50e86053-0686-4f62-a766-50cd1e72c0ce",
                                                "sense_id": "d24d2cab-fb74-39d3-b8ed-dfa077a41bcd",
                                                "text": "He shortstopped for a few years for the Houston Astros when they won the World Series twice in a row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                        "entry_id": "899f7381-901f-3cb3-84ed-5eecfc8a43d5",
                                        "glosses": [
                                            "Alternative form of short-stop (to cause to stop short)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f03e11-aaa7-4a79-a654-1cf6a6137b95",
                                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                                "text": "In the polymerization of BD by Ti-, Co- and Ni-based catalyst systems the polymerization has to be shortstopped at a specific monomer conversion in order to avoid the formation of gel."
                                            },
                                            {
                                                "example_id": "9f75d293-8b49-4aa2-81a7-cacbcafb65a2",
                                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                                "text": "They will be shortstopped in the port for lease by the government, then continue their journey by military train."
                                            },
                                            {
                                                "example_id": "c6ddb31b-70ed-4b4c-9f9c-73cb6da3fe40",
                                                "sense_id": "9229d2c2-b60c-3d03-833f-394882e3fda3",
                                                "text": "Although he successfully shortstopped the assault on his two teammates, the enemy soldiers now concentrated their fire directly on him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shortstop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393c02bc-fed9-3657-bc5d-5253ee20c41e",
                                        "entry_id": "d83ed7f4-2efc-3aeb-8b43-ed44e8fb0386",
                                        "glosses": [
                                            "The infield defensive player that stands between the second baseman and the third baseman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3009939-f7a1-40a7-aaef-3768112aa4bb",
                                                "sense_id": "393c02bc-fed9-3657-bc5d-5253ee20c41e",
                                                "text": "The shortstop ranged deep into the hole to make the stop."
                                            },
                                            {
                                                "example_id": "5bc2b3e8-80d7-42e6-be4c-cb24bbf16b0f",
                                                "sense_id": "393c02bc-fed9-3657-bc5d-5253ee20c41e",
                                                "text": "“Your father was the best baseball player anyone had ever seen.” Excited but halting, her voice ran on past all obstacles. “We watched him play shortstop, and my father said he was the best, and my brothers too. The Cardinals sent a man down to talk to him about one of their teams.” Like an ancient marineress, she would not let go. She meant the St. Louis Cardinals’ farm teams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b45dce-7e17-3523-a5c7-b1bf9b3289f4",
                                        "entry_id": "d83ed7f4-2efc-3aeb-8b43-ed44e8fb0386",
                                        "glosses": [
                                            "A nimble defender."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68bc181-9cc2-44ee-bafb-ff75df9695c4",
                                                "sense_id": "f4b45dce-7e17-3523-a5c7-b1bf9b3289f4",
                                                "text": "I'll play shortstop when we make our proposal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ca419d-4f34-3373-8ddb-86f9a3b4930a",
                                        "entry_id": "d83ed7f4-2efc-3aeb-8b43-ed44e8fb0386",
                                        "glosses": [
                                            "A player who is short of money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d8ca92-811b-49e2-aec4-bfbac09535cc",
                                                "sense_id": "97ca419d-4f34-3373-8ddb-86f9a3b4930a",
                                                "text": "The shortstops and desperados were not permitted to play in this marker crap game."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
