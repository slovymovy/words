{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37ef13cf-c9bb-3013-9a0b-3a5e72268d0b",
                    "sense_definition": "A small hairnet or cap worn by women to keep their hair in place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_accessory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory worker kept her hair tidy by wearing a simple <w>snood</w>.",
                            "target_lang_translations": {
                                "pl": "Pracownica fabryki dbała o porządek we włosach, nosząc prostą <w>siatkę</w>."
                            }
                        },
                        {
                            "text": "She pulled her hair back and secured it inside a vintage <w>snood</w>.",
                            "target_lang_translations": {
                                "pl": "Związała włosy i zabezpieczyła je wewnątrz zabytkowej <w>siatki</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hairnet"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rodzaj siatki lub czepka noszonego przez kobiety w celu podtrzymania włosów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "siatka na włosy",
                                "target_lang_sense_clarification": "ogólne określenie siatki podtrzymującej włosy"
                            },
                            {
                                "target_lang_word": "czepek",
                                "target_lang_sense_clarification": "nakrycie głowy podtrzymujące włosy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7fc349d-555c-35fd-85b6-552499781a2c",
                    "sense_definition": "A band or ribbon used to hold hair in place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_accessory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied her long hair back with a decorative <w>snood</w>.",
                            "target_lang_translations": {
                                "pl": "Związała swoje długie włosy ozdobną <w>opaską</w>."
                            }
                        },
                        {
                            "text": "The historical costume included a traditional <w>snood</w> made of silk ribbon.",
                            "target_lang_translations": {
                                "pl": "Historyczny kostium zawierał tradycyjną <w>opaskę</w> wykonaną z jedwabnej wstążki."
                            }
                        }
                    ],
                    "synonyms": [
                        "headband",
                        "ribbon"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the historical Scottish hair-band."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Opaska lub wstążka używana do podtrzymywania włosów (historycznie w Szkocji)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "opaska",
                                "target_lang_sense_clarification": "ozdobna opaska do włosów"
                            },
                            {
                                "target_lang_word": "wstążka",
                                "target_lang_sense_clarification": "historyczna ozdoba do włosów"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29d67fd9-e656-3239-9bef-a4d51b05ccc8",
                    "sense_definition": "A piece of clothing worn around the neck to keep it warm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrapped a thick wool <w>snood</w> around her neck before going outside.",
                            "target_lang_translations": {
                                "pl": "Owinęła szyję grubym, wełnianym <w>kominem</w>, zanim wyszła na zewnątrz."
                            }
                        },
                        {
                            "text": "The knitted <w>snood</w> kept him warm during the cold winter hike.",
                            "target_lang_translations": {
                                "pl": "Dzianinowy <w>komin</w> zapewniał mu ciepło podczas mroźnej zimowej wędrówki."
                            }
                        }
                    ],
                    "synonyms": [
                        "neckwarmer",
                        "cowl"
                    ],
                    "target_lang_definitions": {
                        "pl": "Część garderoby noszona wokół szyi dla ochrony przed zimnem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "komin",
                                "target_lang_sense_clarification": "dzianinowy szalik w formie tuby"
                            },
                            {
                                "target_lang_word": "golf",
                                "target_lang_sense_clarification": "część odzieży chroniąca szyję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "967f5b3c-8a1c-3292-87ef-86ed7d1fbd80",
                    "sense_definition": "The flap of erectile red skin on the beak of a male turkey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The male turkey displayed his bright red <w>snood</w> to attract a mate.",
                            "target_lang_translations": {
                                "pl": "Indyk prezentował swoje jaskrawoczerwone <w>korale</w>, aby przyciągnąć partnerkę."
                            }
                        },
                        {
                            "text": "The <w>snood</w> on the turkey's beak changed color when it became excited.",
                            "target_lang_translations": {
                                "pl": "<w>Korale</w> na dziobie indyka zmieniały kolor, gdy ptak stawał się podekscytowany."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mięsisty wyrostek skórny nad dziobem indyka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "korale",
                                "target_lang_sense_clarification": "mięsiste wyrostki u indyka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e0dcf85-ddef-3e86-825f-710034ca2f1c",
                    "sense_definition": "A short line used to attach a fishhook to a longer fishing line.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman carefully tied the <w>snood</w> to the main fishing line.",
                            "target_lang_translations": {
                                "pl": "Wędkarz ostrożnie przywiązał <w>przypon</w> do głównej żyłki."
                            }
                        },
                        {
                            "text": "He checked that the <w>snood</w> was strong enough to hold the heavy fish.",
                            "target_lang_translations": {
                                "pl": "Sprawdził, czy <w>przypon</w> jest wystarczająco mocny, by utrzymać ciężką rybę."
                            }
                        }
                    ],
                    "synonyms": [
                        "snell"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótki odcinek żyłki służący do przymocowania haczyka do głównej linki wędkarskiej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przypon",
                                "target_lang_sense_clarification": "odcinek żyłki z haczykiem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c53481da-7ed7-3191-a8af-c3c849120f32",
                    "sense_definition": "To keep hair in place using a snood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>snooded</w> her hair neatly before starting her work.",
                            "target_lang_translations": {
                                "pl": "Starannie <w>upięła włosy w siatce</w>, zanim rozpoczęła pracę."
                            }
                        },
                        {
                            "text": "The dancers <w>snooded</w> their hair to keep it from falling during the performance.",
                            "target_lang_translations": {
                                "pl": "Tancerki <w>upięły włosy w siatkach</w>, aby nie opadały podczas występu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Utrzymywać włosy w miejscu za pomocą siatki lub czepka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "upinać w siatce",
                                "target_lang_sense_clarification": "czynność zabezpieczania włosów"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}