                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подкова",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef05c34-56f0-3e97-bd7d-2271fc486ad4",
                                        "entry_id": "f35b35a0-b3b5-3154-b64c-b93d047c44ac",
                                        "glosses": [
                                            "металлическая скоба, прибиваемая снизу к краю копыта ездового животного (лошади, осла, вола) для предохранения от механических повреждений и предотвращения скольжения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf03d2b-f756-4d08-9c84-21f62803ba63",
                                                "sense_id": "8ef05c34-56f0-3e97-bd7d-2271fc486ad4",
                                                "text": "Прелестная золотисто-рыжая кобыла косила круглым чёрным, налитым кровью глазом, водила ушами и чуть заметно переступала с ноги на ногу, точно пробуя подковы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa304d7e-bea0-3660-b5ca-da4ebc2add13",
                                        "entry_id": "f35b35a0-b3b5-3154-b64c-b93d047c44ac",
                                        "glosses": [
                                            "металлическая скоба или пластина, прибиваемая снизу к краю подошвы (на носок или каблук) сапога или иной обуви для предохранения от механических повреждений и предотвращения скольжения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd59f58-eb84-40d7-b84f-c1518384580e",
                                                "sense_id": "aa304d7e-bea0-3660-b5ca-da4ebc2add13",
                                                "text": "Он был рябоват, от его волос сладко пахло карамельками, он с грохотом носил солдатские сапоги с подковами и часы с цепочкой, и из-под его халата у него остро выпирал значок, похожий на орден."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8151f33-93bf-3884-ad40-8ff0e3706fd5",
                                        "entry_id": "f35b35a0-b3b5-3154-b64c-b93d047c44ac",
                                        "glosses": [
                                            "предмет или расположение чего-либо в форме дуги, подковы [1]"
                                        ],
