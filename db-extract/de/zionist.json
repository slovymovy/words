                        ],
                        "form": "den Zionisten"
                    },
                    {
                        "form_id": "f72ea5c7-8a20-49a3-be66-16f551973610",
                        "entry_id": "318eb0b0-95ae-348b-899b-242fc931870d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Zionisten"
                    },
                    {
                        "form_id": "e57b5a09-1033-4773-8584-18d16415c639",
                        "entry_id": "318eb0b0-95ae-348b-899b-242fc931870d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zionisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                        "entry_id": "318eb0b0-95ae-348b-899b-242fc931870d",
                        "glosses": [
                            "Anhänger des Zionismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a779153-ae73-4cb9-b169-36b42bdb1f2f",
                                "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                                "text": "„Im Zusammenhang mit dem Ha'avara-Abkommen zwischen den Zionisten und Deutschland ging es darum, eine eigene Schifffahrtsgesellschaft (die Palestine Shipping Company) zu begründen und die Auswanderung von Juden aus dem deutschen Reichsgebiet zu organisieren.“"
                            },
                            {
                                "example_id": "4d792c76-e08c-4b2b-8069-adafd954e306",
                                "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                                "text": "„Die traditionelle Feindschaft zwischen Bundisten und Zionisten verschärfte ihre konträren Interpretationen der Ereignisse selbst am Rande der Auslöschung.“"
                            },
                            {
                                "example_id": "c57e5785-84c5-4141-98c7-fc88fd641cf8",
                                "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                                "text": "„Ein kleiner Exkurs in die Geschichte zeigt, dass das auch schon bei den frühen Zionisten so war.“"
                            },
                            {
                                "example_id": "32fb51e0-3dd5-40fb-8235-b3ce2fcd12f6",
                                "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                                "text": "„Marek fuhr fort und erzählte mit Genugtuung, daß er schon immer Zionist gewesen sei, und bewunderte sich selbst dafür, daß er es schon in so jungem Alter gewagt hatte, sich gegen seine Eltern aufzulehnen, und damit sein Leben gerettet hatte.“"
                            },
                            {
                                "example_id": "317e18a4-8bcb-4f78-b4b6-ee6b7bb052bf",
                                "sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                                "text": "„Natürlich kann Antizionismus auch ein verdeckter Antisemitismus sein. Es gibt eine lange und unschöne Geschichte davon, wie \"Zionisten\" als Codewort für das Wort \"Juden\" gebraucht wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56544d87-b2d0-4299-a2b5-9b6be259bb0d",
                        "source_entry_id": "318eb0b0-95ae-348b-899b-242fc931870d",
                        "source_sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                        "source_sense_description": "Anhänger des Zionismus",
                        "target_lang_word": "Zionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a65d7184-4896-3e3a-95cf-3343069086d3",
                                        "entry_id": "4359d452-d008-310b-a9fe-212328a98336",
                                        "glosses": [
                                            "An advocate of Zionism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad22caa5-b28f-4da4-a78e-63f5c6fac187",
                                                "sense_id": "a65d7184-4896-3e3a-95cf-3343069086d3",
                                                "text": "More than those who are merely pro-Israel, Zionists (1) see contemporary Israeli society as presenting a challenge to their Jewish life in the Diaspora; (2) believe Israel offers a greater chance of a fulfilling and secure Jewish life; and (3) are confronted with the possibility of settling in Israel and attracted to it. Thus, while most American Jews are pro-Israel, far fewer are Zionists in the classical sense."
                                            },
                                            {
                                                "example_id": "4432e6ce-a585-415c-b67c-bcfd25783d5b",
                                                "sense_id": "a65d7184-4896-3e3a-95cf-3343069086d3",
                                                "text": "These investigations indicate that although a large proportion of American Jews call themselves Zionists, their meanings of Zionism are closer to what some investigators have called pro-Israelism. According to the still common Israeli definition of a Zionist as one who views the Diaspora negatively and considers the settlement of Jews in Israel as essential, the vast majority of American Jews would not be considered Zionists."
                                            },
                                            {
                                                "example_id": "7cd0ae46-2092-49aa-b994-a86e22a4b138",
                                                "sense_id": "a65d7184-4896-3e3a-95cf-3343069086d3",
                                                "text": "Most Zionists hoped for a state of their own, but early in the 20th century, writers like Hillel Solotaroff and Chaim Zhitlowsky, both Yiddish-speaking immigrant intellectuals in New York, imagined another alternative: a federation of self-governing anarchist communes in Palestine that would defend Jewish life without relying on state power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aac0f3e-bf9f-3143-a221-bcbfcfa47901",
                                        "entry_id": "4359d452-d008-310b-a9fe-212328a98336",
                                        "glosses": [
                                            "A believer in the African Zionism religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Zionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3545db66-178e-3603-8778-114b5604faca",
                                        "entry_id": "43734279-114a-3e31-98f9-8e01f99f474e",
                                        "glosses": [
                                            "Of or relating to Zionism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1332824-bda1-3d29-9c77-b2aa9d7b5597",
                                        "entry_id": "43734279-114a-3e31-98f9-8e01f99f474e",
                                        "glosses": [
                                            "Of or relating to a Zionist or Zionists."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d6c60c3-ab34-446b-bfdd-a1d968a3676b",
                                                "sense_id": "e1332824-bda1-3d29-9c77-b2aa9d7b5597",
                                                "text": "Two, out of millions, who gave their lives and were prepared to sacrifice everything in the fight against fascist and racist Nazi Germany. And I salute you and I pay tribute to you and I think you should be very proud that in the last few weeks you've stood firm and you have refused to be intimidated by the threats of a small bunch of Zionist hoodlums whose behavior is an insult to the stature of Jews all over the world and to their great and heroic record of struggle against fascism and oppression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a3317b-8465-3883-8674-8c984e1667bd",
                                        "entry_id": "43734279-114a-3e31-98f9-8e01f99f474e",
                                        "glosses": [
                                            "Of or relating to Israel or Israelis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0301e11f-4ae5-3e4d-b672-4062ec9109e6",
                                        "entry_id": "43734279-114a-3e31-98f9-8e01f99f474e",
                                        "glosses": [
                                            "Of or relating to the African Zionism religion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ccdfaf9-3b4a-4994-8e0f-0ba7b27d61ab",
                        "source_entry_id": "318eb0b0-95ae-348b-899b-242fc931870d",
                        "source_sense_id": "59ec0d22-bddb-3eee-8513-d76a6e957e34",
                        "source_sense_description": "Anhänger des Zionismus",
                        "target_lang_word": "sioniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sioniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b91d40b2-d567-3ab5-b32e-3f3a9936e59f",
                                        "entry_id": "58b03fc7-693b-3d68-a70f-0eb8d22a2201",
                                        "glosses": [
                                            "Qui concerne le sionisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cf7538-722f-4118-be78-5812aba5aaa5",
                                                "sense_id": "b91d40b2-d567-3ab5-b32e-3f3a9936e59f",
                                                "text": "Lorsque Leon Kellner, ami de Herzl, décide de réorganiser, contre la corruption et la démagogie, toute la vie sioniste à Czernowitz, ils donnent de leur temps."
                                            },
                                            {
                                                "example_id": "10f864ed-9b84-4d6e-aa98-038d7fae3cc6",
                                                "sense_id": "b91d40b2-d567-3ab5-b32e-3f3a9936e59f",
                                                "text": "Ainsi, la question palestinienne divisa la France où parallèlement à la politique officielle, elle aussi clivée, des réseaux clandestins sionistes comme proarabes se constituèrent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sioniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10e2ca88-334b-3925-97f2-d01220990134",
                                        "entry_id": "537509f4-d0a9-3250-95be-3000e9f78318",
                                        "glosses": [
                                            "Partisan du sionisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e7d9d5-4391-4b97-9528-16f8a217e6af",
                                                "sense_id": "10e2ca88-334b-3925-97f2-d01220990134",
                                                "text": "Qu'il sonne à la porte, il se frotterait à Papa, essuierait une bordée de hurlements, car mon père, en sioniste fanatique, abhorrait tout ce qui ressemblait de près ou de loin à la Diaspora comme les gardeuses d'oie, les pogroms et les marieurs."
                                            },
                                            {
                                                "example_id": "930bc9bf-ea1e-4220-a3df-2aa9f6df9acb",
                                                "sense_id": "10e2ca88-334b-3925-97f2-d01220990134",
                                                "text": "Une jeune camarade de ma section vient, voici quelques semaines, d’un ton mystérieux et inquiet me demander : es-tu sioniste ? Je lui répondais que si être pour l’existence de l’état d’Israël c’était être sioniste, j’étais désolé de la décevoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
