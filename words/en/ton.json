        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef5e2c33-71d1-354e-9762-70a3816bf07a",
                    "sense_definition": "A very large number or amount of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>ton</w> of homework to finish before tomorrow.",
                            "target_lang_translations": {
                                "ru": "У меня <w>куча</w> домашней работы, которую нужно закончить до завтра.",
                                "zh": "明天之前我还有<w>大量</w>的家庭作业要完成。"
                            }
                        },
                        {
                            "text": "They made <w>tons</w> of money selling their old house.",
                            "target_lang_translations": {
                                "ru": "Они заработали <w>кучу</w> денег на продаже своего старого дома.",
                                "zh": "他们卖掉旧房子赚了<w>一大笔</w>钱。"
                            }
                        },
                        {
                            "text": "Don't worry, we have <w>tons</w> of time to catch the train.",
                            "target_lang_translations": {
                                "ru": "Не волнуйся, у нас <w>вагон</w> времени, чтобы успеть на поезд.",
                                "zh": "别担心，我们有<w>充裕</w>的时间去赶火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lot",
                        "load",
                        "heap",
                        "pile",
                        "abundance",
                        "mass",
                        "mountain",
                        "slew",
                        "plenty",
                        "much"
                    ],
                    "common_phrases": [
                        "a ton of",
                        "tons of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used hyperbolically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большое количество чего-либо.",
                        "zh": "指非常大的数量或金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "разг. большое количество"
