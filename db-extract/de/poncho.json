                "senses": [
                    {
                        "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                        "entry_id": "fe7979fc-ea61-393f-ace8-28201915f687",
                        "glosses": [
                            "Kleidung: mantelartiger Umhang ohne Ärmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b10208-cdb7-4886-9d38-33aa629ba504",
                                "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                                "text": "„Wiebke hatte ihren fusseligen weißen Poncho an und winkte Papa noch nach, als der Zug schon lange verschwunden war.“"
                            },
                            {
                                "example_id": "7e4ba1e4-a98e-4cf6-a144-745014237d87",
                                "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                                "text": "„Um mein einziges Paar geschlossener Schuhe zu schonen, zog ich trotz Kälte die Trekkingsandalen an und kämpfte in kurzer Hose, nur mit einem wasserdichten Poncho bewaffnet, gegen den Regen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42ed3586-bbbb-4174-a3a8-c9a183347647",
                        "source_entry_id": "fe7979fc-ea61-393f-ace8-28201915f687",
                        "source_sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                        "source_sense_description": "Kleidung: mantelartiger Umhang ohne Ärmel",
                        "target_lang_word": "poncho",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poncho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d36f4f-b326-3637-ac61-d5893e7eec35",
                                        "entry_id": "82d58600-4cdd-35a5-9bd9-82a85098aadb",
                                        "glosses": [
                                            "A simple garment, made from a rectangle of cloth, with a slit in the middle for the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e8d481-2de0-4a0d-be66-d69618f8d2ce",
                                                "sense_id": "c7d36f4f-b326-3637-ac61-d5893e7eec35",
                                                "text": "Garibaldi, with his cowboy's poncho, red shirt and the black ostrich feathers in his wide hat […]"
                                            },
                                            {
                                                "example_id": "fdb5c277-1f62-4e71-845a-8dd99c0476c7",
                                                "sense_id": "c7d36f4f-b326-3637-ac61-d5893e7eec35",
                                                "text": "It was a gringo in a poncho. It was not really accurate to his suits worn today, but Julia would understand the symbolism that he was adapting to the culture and expectations while far away from home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                        "entry_id": "82d58600-4cdd-35a5-9bd9-82a85098aadb",
                                        "glosses": [
                                            "A similar waterproof garment, today typically of rubber with a hood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0566129-83f9-4591-bdd2-408b11cdb171",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "[…] spreading over my bedding an indian-rubber poncho to exclude the rain."
                                            },
                                            {
                                                "example_id": "677d16fb-bbd3-4e05-9cb4-c581a2dd84ea",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "I […] took my seat between Juan and Ambrosio, protected from the rain by an India-rubber poncho."
                                            },
                                            {
                                                "example_id": "7717a31a-b581-4b50-996e-46589cd02c83",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "1857, Solomon Nunes Carvalho, Incidents of Travel and Adventure in the Far West, p. 48 (1857), p. 48 (1858):"
                                            },
                                            {
                                                "example_id": "07d72399-3d8b-4d9c-a023-22e7e03788a7",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "I found it necessary while doing guard to cover myself with my India-rubber poncho, to prevent my clothes from becoming saturated with water."
                                            },
                                            {
                                                "example_id": "47e2e228-88aa-435b-a289-32b98421f4f6",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "The following list of articles is deemed a sufficient outfit for one man upon a three months’ expedition, viz.: […] 1 gutta percha poncho"
                                            },
                                            {
                                                "example_id": "da2bf4ac-ed54-4c6d-805c-03e5b360f519",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "[…] when near the old church in Manchester he was run against by a man whom he supposed to be a drunken man, who was dressed in a poncho overcoat."
                                            },
                                            {
                                                "example_id": "a77c8b45-a4bb-453d-b233-6973d9108200",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "It is about the size of the rubber poncho used in the United States, […]"
                                            },
                                            {
                                                "example_id": "2be283e6-6d14-4a66-86a5-1d5f047b1f07",
                                                "sense_id": "094f6163-6faf-3bde-bd85-f41aaebe90c7",
                                                "text": "If you have to hike all day in a poncho, your pants will be wet thigh-high before long (never mind how fast you'll get wet if you have to go through wet brush or grass)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff4ea805-fc74-430b-bab7-c335eb08eac1",
                        "source_entry_id": "fe7979fc-ea61-393f-ace8-28201915f687",
