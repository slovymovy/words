        "ru-extract.jsonl": [
            {
                "entry_id": "6878b415-ee71-3d2a-8509-e0d135798ab3",
                "word": "грузно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc5c247c-7e71-31ba-b9e1-9404e039230d",
                        "entry_id": "6878b415-ee71-3d2a-8509-e0d135798ab3",
                        "glosses": [
                            "наречие к грузный; неповоротливо и медленно (в силу большого веса); тяжело (о походке)"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "335d4eaa-a318-453f-862a-30be469f9941",
                                "sense_id": "bc5c247c-7e71-31ba-b9e1-9404e039230d",
                                "text": "Грузно садится за стол и пьёт водку."
                            },
                            {
                                "example_id": "b89fb0f1-fcc3-469a-9477-5628e68d4fb2",
                                "sense_id": "bc5c247c-7e71-31ba-b9e1-9404e039230d",
                                "text": "Напутствовавши меня таким образом, он сделал быстрый полуоборот и, грузно ступая, направился к анфиладе, на всём протяжении которой, покуда он шёл, раздавался шум отодвигаемых стульев."
                            },
                            {
                                "example_id": "efebeee5-9a37-4930-a3a8-3c1f69ac8b8c",
                                "sense_id": "bc5c247c-7e71-31ba-b9e1-9404e039230d",
                                "text": "Быстрейший из гонцов, как грузно он ступает ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff151ba0-198a-3dd2-bce6-97e8af051348",
                        "entry_id": "6878b415-ee71-3d2a-8509-e0d135798ab3",
                        "glosses": [
                            "тяжело (о весе)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94dca388-dec5-449e-8a6b-7c3492d5390e",
                                "sense_id": "ff151ba0-198a-3dd2-bce6-97e8af051348",
                                "text": "Больше и крепче всех других он был в козацком обозе; двойною крепкою шиною были обтянуты дебелые колеса его; грузно был он навьючен, укрыт попонами, крепкими воловьими кожами и увязан туго засмоленными веревками."
                            },
                            {
                                "example_id": "3d24b889-d998-443b-a4b2-a95d7696295a",
                                "sense_id": "ff151ba0-198a-3dd2-bce6-97e8af051348",
                                "text": "Серая, большая, некрашеная лодка, грузно усевшись в воду, покачнулась и повернулась лениво, точно не хотела уходить от берега."
                            }
                        ]
                    }
