                        "source_entry_id": "8c77e172-0116-3c7a-920f-0ffb0216134a",
                        "source_sense_id": "4b15df53-7889-39ba-889c-e33a80000902",
                        "target_lang_word": "angiotensine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angiotensine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a2f025-3a0c-34de-9ed8-199d3f57dd8c",
                                        "entry_id": "ec23d129-6c08-3879-9045-98a217f92540",
                                        "glosses": [
                                            "Peptide impliqué dans la maintenance du volume et de la tension artérielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc82c605-0168-4cf0-b815-e50035959ed9",
                                                "sense_id": "a0a2f025-3a0c-34de-9ed8-199d3f57dd8c",
                                                "text": "Une variante particulière du gène DCP, qui code pour l’enzyme de conversion de l’angiotensine, peut faire la différence entre quelqu’un qui peinerait à l’effort physique et un athlète de haut niveau dans des sports d’endurance."
                                            },
                                            {
                                                "example_id": "d200aadb-6e7b-42da-b5c6-098da63f7163",
                                                "sense_id": "a0a2f025-3a0c-34de-9ed8-199d3f57dd8c",
                                                "text": "La sécrétion de l’aldostérone est sous la dépendance du système rénine-angiotensine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
