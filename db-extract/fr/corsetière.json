                        "examples": [
                            {
                                "example_id": "55f902d2-c25a-48ee-a864-7966c70b84ad",
                                "sense_id": "b24a330c-a6c8-380e-9010-9ac8dbc11db1",
                                "text": "J’ai demandé à Juliette : « Qui sont ces femmes ? » Juliette m’a répondu, une fois : « C’est la corsetière », une autre fois : « C’est la brodeuse… »"
                            },
                            {
                                "example_id": "148262d7-2168-4460-aeb5-1dc647ef699e",
                                "sense_id": "b24a330c-a6c8-380e-9010-9ac8dbc11db1",
                                "text": "Sous l’aiguille de la machine, un délicat ruban de dentelle fait de la résistance. « C’est Tchernobyl » grommelle la couturière."
                            }
                        ]
                    }
