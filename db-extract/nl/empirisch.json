                        "source_sense_id": "b7afd6c8-c08e-3d2a-90ef-5e0ec291d512",
                        "source_sense_description": "wat op ervaring of proefneming berust",
                        "target_lang_word": "empirisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empirisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7339d320-f968-3a70-aa43-4300dd3f6928",
                                        "entry_id": "7978c07b-975f-3c6f-8606-242da359cc64",
                                        "glosses": [
                                            "auf Erfahrung beruhend; aus Erfahrung gewonnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55955f15-0e2f-43ab-9dbb-4e78870883c9",
                                                "sense_id": "7339d320-f968-3a70-aa43-4300dd3f6928",
                                                "text": "Der Fan. Jenes unberechenbare Wesen, das den Fußball eigentlich erst schön, aber manchmal auch verdammt hässlich macht. Grund genug, sich mit ihm empirisch auseinander zusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "061a5d9c-7d9b-37ba-9f3b-c9882ab5273b",
                                        "entry_id": "7978c07b-975f-3c6f-8606-242da359cc64",
                                        "glosses": [
                                            "wissenschaftliche Erkenntnis (zum Beispiel aus Versuchen entnommen), die nachvollziehbar beschrieben wird beziehungsweise wiederholbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d079a8-404f-4580-8dc3-429514388dd5",
                                                "sense_id": "061a5d9c-7d9b-37ba-9f3b-c9882ab5273b",
                                                "text": "Jede Theorie sollte empirisch überprüft werden."
                                            },
                                            {
                                                "example_id": "4bbd9f14-f0b7-4efc-a808-057b97bc05a0",
                                                "sense_id": "061a5d9c-7d9b-37ba-9f3b-c9882ab5273b",
                                                "text": "„IQ-Tests sind die empirischsten und wissenschaftlich vernünftigsten Mittel, das menschliche Gehirn präzise zu analysieren, doch sie lassen das Metaphysische und das Unerklärliche völlig außen vor.“"
                                            },
                                            {
                                                "example_id": "50b42333-0b0a-4f11-9495-efb74f5aa56c",
                                                "sense_id": "061a5d9c-7d9b-37ba-9f3b-c9882ab5273b",
                                                "text": "„Nur dann wäre in dieser Sicht ein wissenschaftlicher Gottesbeweis gelungen, wenn der Unterschied empirisch feststellbar wäre, den seine Existenz bzw. Nichtexistenz für eine naturwissenschaftliche Beschreibung der Wirklichkeit machen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe38676-3160-473a-9ea8-f34ca6ff9e9f",
                        "source_entry_id": "c4948156-3c93-3867-bad4-853c9f9759b1",
                        "source_sense_id": "b7afd6c8-c08e-3d2a-90ef-5e0ec291d512",
                        "source_sense_description": "wat op ervaring of proefneming berust",
                        "target_lang_word": "empiric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empiric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90c2dfcf-90c2-338f-a9a3-3b517772c768",
                                        "entry_id": "b16ba5ee-d820-3745-bc9a-dc0203de283d",
                                        "glosses": [
                                            "Empirical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "empiric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb393b63-97f8-3acc-a829-66ce5455e6c4",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "A member of a sect of ancient physicians who based their theories solely on experience."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11f2e58b-f57b-3e4c-b63a-0d2c8870e05b",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "Someone who is guided by empiricism; an empiricist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                        "entry_id": "dea12dff-2d8d-3b3c-8962-0621bf799c5a",
                                        "glosses": [
                                            "Any unqualified or dishonest practitioner; a charlatan; a quack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da81ec46-037f-4888-a549-fc14fb8dba6b",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "An empiric oftentimes, and a silly chirurgeon, doth more strange cures than a rational physician."
                                            },
                                            {
                                                "example_id": "1a3a4877-399b-4c85-8626-90033637ca70",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "[…] Paracelsus and some few other sooty Empiricks, rather then (as they are fain to call themselves) Philosophers, having their eyes darken'd, and their Brains troubl'd with the smoke of their own Furnaces, began to rail at the Peripatetick Doctrine, which they were too illiterate to understand […]"
                                            },
                                            {
                                                "example_id": "633c3aed-4303-4a6c-82d8-ac147a8bf65e",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "[…] and must therefore swallow down Opinions, as silly People do Empiricks['] Pills, without knowing what they are made of[…]"
                                            },
                                            {
                                                "example_id": "87061e60-65b3-4071-9621-16a083b35646",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "The fact is, that since a good, sound, honest, efficient, automatic, nonmetallic currency and standard was tampered with in 1893, India has been a happy hunting-ground for any empiric who conjured with a new scheme of currency, no matter how fantastic."
                                            },
                                            {
                                                "example_id": "cfe0f8a1-713a-4e55-bb93-8165936eeb36",
                                                "sense_id": "ac538b4d-0f7d-385e-81cd-d155e34de719",
                                                "text": "To the disgust of doctors, the royal family at Versailles allowed one Brun, a wandering empiric […], to administer a proprietary ‘sovereign remedy’ to the ailing monarch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51fa9740-77e5-4b4b-85da-36ca0e3b8d1e",
                        "source_entry_id": "c4948156-3c93-3867-bad4-853c9f9759b1",
