                                        "sense_id": "51dcf2ed-755a-3170-a50c-1cc28bbdec96",
                                        "entry_id": "f03efcc8-8165-3302-9eb0-a76674cdf66f",
                                        "glosses": [
                                            "The study of the effects of time on biological systems, especially the effects of periodicity"
                                        ],
