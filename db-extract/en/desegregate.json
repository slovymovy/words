                        "examples": [
                            {
                                "example_id": "6ad0610a-e974-4c6d-b138-0c754d1e9bb7",
                                "sense_id": "8633e9df-3d78-3d4a-8f79-eff890cc31e2",
                                "text": "What was the goal of the \"swim-ins\" held in St. Augustine? In 1964, black Americans were eager to desegregate Florida beaches. They targeted St. Augustine during the city's 300th year celebration."
                            },
                            {
                                "example_id": "75d2f796-5cd7-43b3-93da-55266f29ff4e",
                                "sense_id": "8633e9df-3d78-3d4a-8f79-eff890cc31e2",
                                "text": "During the 1960 Christmas vacation holiday, John and I decided on our own to desegregate a Greyhound bus in Nashville. That was before the Freedom Rides."
                            }
                        ]
                    }
