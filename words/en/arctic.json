        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9eba4403-2f81-3b17-8ab7-11662bf1473a",
                    "sense_definition": "The region of the Earth located north of the Arctic Circle, containing the North Pole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geo_region",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Scientists are studying how climate change affects the ice in the <w>Arctic</w>.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как изменение климата влияет на льды в <w>Арктике</w>.",
                                "zh": "科学家们正在研究气候变化如何影响<w>北极</w>的冰层。"
                            }
                        },
                        {
                            "text": "Explorers have traveled to the <w>Arctic</w> for centuries to map its frozen lands.",
                            "target_lang_translations": {
                                "ru": "Исследователи веками путешествовали в <w>Арктику</w>, чтобы нанести на карту её замерзшие земли.",
                                "zh": "几个世纪以来，探险家们一直前往<w>北极</w>绘制其冰封之地的地图。"
                            }
                        }
                    ],
                    "synonyms": [
                        "North Pole"
                    ],
                    "antonyms": [
                        "Antarctic"
                    ],
                    "common_phrases": [
                        "the Arctic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Северная полярная область Земли, расположенная к северу от Северного полярного круга.",
                        "zh": "地球北极圈以北的区域，包含北极点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Арктика",
                                "target_lang_sense_clarification": "регион"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "北极",
                                "target_lang_sense_clarification": "地理区域"
                            }
                        ]
                    }
                }
            ]
        },
