                                            {
                                                "example_id": "c5bf7cc1-92e3-4ca4-9b6a-78883df8587c",
                                                "sense_id": "0a492443-9b04-3916-bc7c-cbbc3664a437",
                                                "text": "„Der hier zu beobachtende Vorgang ist folgender: Die Bedeutung eines Lexems der Spendersprache wird im Zuge der Übernahme in die Sondersprache Masematte antonymisch verkehrt.“"
                                            },
                                            {
                                                "example_id": "3cddf74c-805c-4bef-8adf-e79380635aec",
                                                "sense_id": "0a492443-9b04-3916-bc7c-cbbc3664a437",
                                                "text": "„Das Wort verfügt also über zwei Bedeutungen (Homonymie, Polysemie oder Homophonie), die eine antonymische Opposition bilden.“"
                                            },
                                            {
                                                "example_id": "17599501-b3d2-4f4d-a9a8-fa4d9bf6e644",
                                                "sense_id": "0a492443-9b04-3916-bc7c-cbbc3664a437",
                                                "text": "„…; mit ihm werden unterschiedslos semantische (synonymische wie antonymische, hyponymische wie hyperonymische), wortbildnerische und grammatische Beziehungen hergestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
