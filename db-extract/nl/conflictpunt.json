                        "examples": [
                            {
                                "example_id": "26fdcae9-8a9e-4760-b773-2bddc0c704d8",
                                "sense_id": "1061534f-2c7b-347b-9234-177f8d5d26ef",
                                "text": "Het grote conflictpunt was altijd al de olie: veel inkomsten van de regering in het noorden van het land komen uit oliebronnen in het zuiden. De tegenstellingen tussen noord en zuid werden almaar groter toen in 1954 de burgeroorlog uitbrak."
                            },
                            {
                                "example_id": "7f0a74af-1934-4daa-858e-bb853e69a6d0",
                                "sense_id": "1061534f-2c7b-347b-9234-177f8d5d26ef",
                                "text": "Een van de aanwezigen sprak tegen persbureau Reuters van een stormachtige laatste sessie die om 02.00 uur 's nachts door Guterres werd beëindigd. Belangrijkste conflictpunt zou zijn dat de Turken vasthouden aan het handhaven van militairen op het eiland en het recht willen houden om in te kunnen grijpen. De Turken stuurden in juli 1974 militairen naar het eiland die het noordelijke deel bezetten. De invasie eindigde in de verdeling van Cyprus langs de door de VN bewaakte Groene Lijn."
                            }
                        ]
