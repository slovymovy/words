                                "target_senses": [
                                    {
                                        "sense_id": "981d594d-6179-360d-85d3-3f41e2da3b3c",
                                        "entry_id": "f2b1d764-48fb-31a9-8bd1-cdb13cbfe86d",
                                        "glosses": [
                                            "Einwohner von Teheran, in Teheran geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf895d8e-1a01-4410-b8b8-e0e2f40006fb",
                                                "sense_id": "981d594d-6179-360d-85d3-3f41e2da3b3c",
                                                "text": "„Obwohl sie schon vor Jahren offiziell in Valiasr-Straße umbenannt wurde, heißt sie bei vielen Teheranern noch immer so wie vor der Revolution: Pahlavi-Straße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Teheraner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e678950-b53c-348b-af1e-b13d7d2030e8",
                                        "entry_id": "dd8e2730-550e-3fcf-b10d-809948bec34f",
                                        "glosses": [
                                            "sich auf Teheran beziehend, aus Teheran kommend, zu Teheran gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c820bf70-addb-4f04-a88e-e93fdc3ff972",
                                                "sense_id": "9e678950-b53c-348b-af1e-b13d7d2030e8",
                                                "text": "„Es war das Jahr, in dem die Hisbollah in die erste Krise seit ihrer Gründung geriet, nachdem ihr Schutzherr Ayatollah Khomeini im Sommer mit siebenundachtzig Jahren in einem Teheraner Krankenhaus verstorben war.“"
                                            },
                                            {
                                                "example_id": "115e950c-a15e-4a73-a9eb-99a95ba095e0",
                                                "sense_id": "9e678950-b53c-348b-af1e-b13d7d2030e8",
                                                "text": "„Während der Fahrt versuchte der junge Mann, sich auf das Teheraner Alltagsleben zu konzentrieren, das draußen vor den Fenstern vorbeizog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
