                "translations": [
                    {
                        "translation_id": "2d578445-18a1-4e5b-8052-49b7d4b62c47",
                        "source_entry_id": "2e01233c-f63e-3fb5-98d2-b86038a70c78",
                        "source_sense_id": "8ca26682-8f6f-35da-8b70-e8af0a6d30af",
                        "source_sense_description": "Pflanze, die aus wirtschaftlichen Gründen angebaut wird",
                        "target_lang_word": "Nutzpflanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nutzpflanze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                                        "entry_id": "3fd1ba59-69ab-33e9-be07-103500b9dad6",
                                        "glosses": [
                                            "Pflanzensorten, die einen Nutzen für den Menschen bringen, zum Beispiel zur Ernährung oder als Tierfutter dienen, beziehungsweise wirtschaftlich angebaut werden können, zum Beispiel Weizen oder Mais"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89987a2-ced3-495e-b049-622a6c80fe99",
                                                "sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                                                "text": "Der Kürbis gehört zu den ältesten Nutzpflanzen auf der Erde."
                                            },
                                            {
                                                "example_id": "f9469f1e-288d-4be3-8118-e2e6ce865587",
                                                "sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                                                "text": "„Denn angesichts des Klimawandels mit den erwarteten zunehmenden Hitze- und Trockenperioden spielen stressresistente Nutzpflanzen eine immer größere Rolle in der Landwirtschaft.“"
                                            },
                                            {
                                                "example_id": "f432aa8d-aa51-40a6-b238-02f568f5c5d7",
                                                "sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                                                "text": "Nach Schätzungen des Bundesamtes für Naturschutz (BfN) ist die Vielfalt der Nutzpflanzen seit Beginn des 20. Jahrhunderts um 90 Prozent eingebrochen."
                                            },
                                            {
                                                "example_id": "42ce4de6-2ff2-48b8-bd55-b596c403f1a3",
                                                "sense_id": "96593f42-6749-3ce7-9258-b62e816f4f90",
                                                "text": "„Harbert war ständig auf der Suche nach neuen Nutzpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
