                "senses": [
                    {
                        "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                        "entry_id": "4b223473-75e1-3c04-956d-b7e1cff2e79f",
                        "glosses": [
                            "Narben bildender Umbau des Lungengerüsts mit Vermehrung des Kollagens in den Septen der Alveolen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dbe150d-1f18-4851-a090-39ccd3fc3314",
                                "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                                "text": "Die Diagnose trägt den Namen »Lungenfibrose«. Eine Bindegewebskrankheit der Lunge, die verhindert, dass das Organ genügend Sauerstoff ins Blut transportiert."
                            },
                            {
                                "example_id": "3e4c7832-4ecf-4649-aa4d-ffebc365ab26",
                                "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                                "text": "Ich leide seit einigen Jahren an einer Autoimmunerkrankung. Eine Lungenfibrose hat dann über mehrere Jahre dazu geführt, dass die Lunge komplett versagte."
                            },
                            {
                                "example_id": "089b7ce8-1c99-4ddd-9b10-b979cf00aaab",
                                "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                                "text": "Die häufigsten Erkrankungen, die zu einer Lungentransplantation führen, sind COPD (chronisch-obstruktive Lungenerkrankung) und Emphysem, auch Lungenfibrose und Cystische Fibrose sind häufige Ursachen."
                            },
                            {
                                "example_id": "eabf6be9-7ee8-43e0-bfaf-51f2f8d7f7b1",
                                "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                                "text": "Norwegens Kronprinzessin Mette-Marit ist an der chronischen Lungenfibrose erkrankt und wird deshalb weniger offizielle Termine wahrnehmen."
                            },
                            {
                                "example_id": "ba2da039-b17c-41a7-aede-06eed3d247c9",
                                "sense_id": "166b8638-166a-3fbf-9798-0330cab06165",
                                "text": "Das Präparat Pirfenidon kann bei leichter bis mittelschwerer Lungenfibrose eingesetzt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
