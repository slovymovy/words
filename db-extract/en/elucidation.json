                ],
                "senses": [
                    {
                        "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                        "entry_id": "5c6304ae-c9bd-370f-b164-ea2c182fefc0",
                        "glosses": [
                            "A making clear; the act of elucidating or that which elucidates, as an explanation, an exposition, an illustration"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e37df257-9aff-4902-a1b8-c2f88fdb03d8",
                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                "text": "The essay might, undoubtedly, have been rendered much more complete by a collection of a greater number of facts in elucidation of the general argument."
                            },
                            {
                                "example_id": "6cdde770-df5d-4e35-bafe-8913540d664f",
                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                "text": "At a time like the present when Eastern æsthetics are attracting the attention of scholars in all quarters, and particularly when the great field of Buddhist art is coming more into focus, a view of a little-known aspect of this subject may perhaps be the humble means of assisting in the elucidation of some of the complex problems with which this study is surrounded."
                            },
                            {
                                "example_id": "a5c4575a-9f91-46e2-833b-138aab51e6a3",
                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                "text": "This note does not arrive at any conclusions not previously obtained by Bastable, Marshall and Pigou, but it shows the nature of the slip which led Edgeworth to conclusions contrary to theirs, and demonstrates the applicability of Marshall's \"offer curve\" apparatus to the elucidation of this problem."
                            },
                            {
                                "example_id": "391fc9c5-1afc-48b9-8093-5f11b51e0d6c",
                                "sense_id": "4ed40a59-1f1f-3d1f-a920-9eb187f2e479",
                                "text": "2016, December 6, Christopher Hooton writing in The Independent, Westworld: Ed Harris doesn’t have a clue what’s going on either\nThe finale might not provide much elucidation, a feature-length instalment that bombarded the viewer with information."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "955125ad-4d3d-4089-902c-da9b7095b7b6",
