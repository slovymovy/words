                    {
                        "translation_id": "849848d0-b409-41c0-a34a-edd3ff7c8a79",
                        "source_entry_id": "d1ec9451-d9b7-3340-9a51-4ccb3a9f60da",
                        "source_sense_id": "7bb6d1b6-9bc5-39bc-b434-52233a3f5fdb",
                        "source_sense_description": "vonnis van een rechter",
                        "target_lang_word": "sentence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sentence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0306ebc-38a9-32ed-aaf9-7186a94e16df",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "The decision or judgement of a jury or court; a verdict."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a606d52-65be-4175-9a1b-414fcbe5742a",
                                                "sense_id": "d0306ebc-38a9-32ed-aaf9-7186a94e16df",
                                                "text": "The court returned a sentence of guilt in the first charge, but innocence in the second."
                                            },
                                            {
                                                "example_id": "fde4773c-36c9-45c3-b753-3bfee7d7971c",
                                                "sense_id": "d0306ebc-38a9-32ed-aaf9-7186a94e16df",
                                                "text": "A branch that has played a significant part in the history of its territory is under sentence at the end of the summer timetables, so far as its passenger services are concerned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54585825-d093-33d6-bf51-8cbbe530f2ee",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "The judicial order for a punishment to be imposed on a person convicted of a crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d99ae94-e85f-4f84-8501-3989f73a10da",
                                                "sense_id": "54585825-d093-33d6-bf51-8cbbe530f2ee",
                                                "text": "The judge declared a sentence of death by hanging for the infamous child rapist."
                                            },
                                            {
                                                "example_id": "16055f34-8317-4fce-9b45-8f0915d9d63e",
                                                "sense_id": "54585825-d093-33d6-bf51-8cbbe530f2ee",
                                                "text": "The murderer, he recalled, had been tried and sentenced to imprisonment for life, but was pardoned by a merciful governor after serving a year of his sentence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1b854a-ff2c-32f1-9470-73b793f5db71",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "A punishment imposed on a person convicted of a crime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58cafd7e-63bd-3574-822b-01f2c359380e",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "A saying, especially from a great person; a maxim, an apophthegm."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd535c7-01b0-4d88-9f35-8337f63fda43",
                                                "sense_id": "58cafd7e-63bd-3574-822b-01f2c359380e",
                                                "text": "Men (saith an ancient Greek sentence) are tormented by the opinions they have of things, and not by things themselves."
                                            },
                                            {
                                                "example_id": "daa49c43-221c-408a-a110-edef5046a5a7",
                                                "sense_id": "58cafd7e-63bd-3574-822b-01f2c359380e",
                                                "text": "I am told that she writes well, and that all her letters are full of sentences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27536ea6-e5e2-307f-b288-f74e6dbec64e",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "A grammatically complete series of words consisting of a subject and predicate, even if one or the other is implied. In modern writing, when using e.g. the Latin, Greek or Cyrillic alphabets, typically beginning with a capital letter and ending with a full stop or other punctuation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e498533-31e4-4d82-a09e-675f4cf6a762",
                                                "sense_id": "27536ea6-e5e2-307f-b288-f74e6dbec64e",
                                                "text": "Near-synonym: clause"
                                            },
                                            {
                                                "example_id": "4105ac26-affc-47a5-b826-84f625d92294",
                                                "sense_id": "27536ea6-e5e2-307f-b288-f74e6dbec64e",
                                                "text": "The children were made to construct sentences consisting of nouns and verbs from the list on the chalkboard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a272c039-5860-3388-ad4b-2910feabc259",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "A formula with no free variables."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da1290dd-fbc8-3a05-aa67-50f77a8e7b3d",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "Any of the set of strings that can be generated by a given formal grammar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "560cf404-0a9c-368e-9732-f71f0560bc55",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "Sense; meaning; significance."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab191b75-802e-44e8-b6c3-7749fbfb6160",
                                                "sense_id": "560cf404-0a9c-368e-9732-f71f0560bc55",
                                                "text": "Noght o word spak he moore than was neede, / And that was seyd in forme and reverence / And short and quyk and ful of hy sentence […]"
                                            },
                                            {
                                                "example_id": "d1fb5028-d842-461c-af9a-d84163a97e57",
                                                "sense_id": "560cf404-0a9c-368e-9732-f71f0560bc55",
                                                "text": "now to the discourse itself, voluble enough, and full of sentence, but that, for the most part, either specious rather than solid, or to his cause nothing pertinent."
                                            },
                                            {
                                                "example_id": "7ab35f5c-0e30-4b9b-9fa7-826bcf7b56d5",
                                                "sense_id": "560cf404-0a9c-368e-9732-f71f0560bc55",
                                                "text": "Full of high sentence, but a bit obtuse; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74261ac-67b2-3ed8-9789-1a1d356a1f0e",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "One's opinion; manner of thinking."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86203f50-752d-47e9-9db3-f0b5d3800e14",
                                                "sense_id": "f74261ac-67b2-3ed8-9789-1a1d356a1f0e",
                                                "text": "My sentence is for open war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f1f238-b1ee-34d0-aa6f-02fa934a2621",
                                        "entry_id": "c15171d7-5e48-3322-946e-db3f84751e30",
                                        "glosses": [
                                            "A pronounced opinion or judgment on a given question."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa56aaef-7d97-4b54-8d36-343ae6ea538e",
                                                "sense_id": "f8f1f238-b1ee-34d0-aa6f-02fa934a2621",
                                                "text": "[I]f it may bee lawfull to iudge or giue any ſentence thereof, it [the author of the book of Ruth] was either Samuell, or ſome other godly Prophet vnder the raigne of Saule, [...]"
                                            },
                                            {
                                                "example_id": "48eecb19-4731-4390-b40c-384bc6216baf",
                                                "sense_id": "f8f1f238-b1ee-34d0-aa6f-02fa934a2621",
                                                "text": "By them [Martin Luther's works] we might pass sentence upon his doctrines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sentence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                        "entry_id": "c9e62bf1-48ab-3909-ad7e-7bac4dab6410",
                                        "glosses": [
                                            "To declare a sentence on a convicted person; to condemn to punishment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee9e575-5241-4976-b27f-cc8b1ac17478",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "The judge sentenced the embezzler to ten years in prison, along with a hefty fine."
                                            },
                                            {
                                                "example_id": "1d6ce3c5-5034-47e0-88c7-24338fd9e8b9",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "Nature herself is sentenced in your doom."
                                            },
                                            {
                                                "example_id": "b3a56733-6a02-4f8c-b39d-d4a087ac54a3",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "1900, Charles W. Chesnutt, The House Behind the Cedars, Chapter I,\nThe murderer, he recalled, had been tried and sentenced to imprisonment for life, but was pardoned by a merciful governor after serving a year of his sentence."
                                            },
                                            {
                                                "example_id": "c2e95808-34bf-4022-ba92-1340747f8aec",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "Moreover, in 2002 two EPB officials in Yangcheng County, Shanxi Province, were sentenced to jail for failing to stop a chemical plant from discharging toxic waste into the drinking-water system."
                                            },
                                            {
                                                "example_id": "865f2921-9eb9-497b-aef7-604447f5dd56",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "On Thursday, a court in south China's Hunan province sentenced a Chinese journalist, Yang Xiaoqing, to one year in jail for extortion after he wrote articles about official corruption."
                                            },
                                            {
                                                "example_id": "63ff468e-9cf9-42af-9df1-3888577b32c6",
                                                "sense_id": "68212051-7803-37b9-aa43-8d74f34cda4e",
                                                "text": "And at that point, we have sentenced a child to motherhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b8c4d85-d032-396f-aea9-77bf036cff32",
                                        "entry_id": "c9e62bf1-48ab-3909-ad7e-7bac4dab6410",
                                        "glosses": [
                                            "To decree, announce, or pass as a sentence."
                                        ],
                                        "tags": [
                                            "especially",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d18a0f59-08a9-4cae-8062-1fd896852828",
                                                "sense_id": "7b8c4d85-d032-396f-aea9-77bf036cff32",
                                                "text": "“We are empowered to deliver thee to prison; yea, the law commands us to sentence death upon the abettors of this mischief.[…]\""
                                            },
                                            {
                                                "example_id": "c7b34c9d-91df-4490-918d-4e412786a8dd",
                                                "sense_id": "7b8c4d85-d032-396f-aea9-77bf036cff32",
                                                "text": "So as far as the older generation of German Lutherans were concerned, the abolition of the mother language sentenced death upon the church as they knew it."
                                            },
                                            {
                                                "example_id": "ea7b8d3d-2336-4ffa-a501-f65e1f8bff38",
                                                "sense_id": "7b8c4d85-d032-396f-aea9-77bf036cff32",
                                                "text": "But little did I know, As I cleared away that snow, I'd sentenced death upon that rose, For late that night it simply froze. I'd taken its one chance away, As I stripped it of its quilt that day. I learned a lesson late that night, ..."
                                            },
                                            {
                                                "example_id": "9cf32723-8339-4b1b-9262-f08090506aa4",
                                                "sense_id": "7b8c4d85-d032-396f-aea9-77bf036cff32",
                                                "text": "[…] upholding Idaho statute mandating that court \"shall\" sentence death upon finding an aggravating circumstance \"unless\" it finds outweighing mitigating circumstances because satisfies individualized sentencing requirement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f12fa56-4487-3c6a-a115-5053fa8d72fd",
                                        "entry_id": "c9e62bf1-48ab-3909-ad7e-7bac4dab6410",
                                        "glosses": [
                                            "To utter sententiously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3741e2e-ecf9-4018-a8f6-93349fc7de2b",
                                                "sense_id": "5f12fa56-4487-3c6a-a115-5053fa8d72fd",
                                                "text": "Let me heare one wise man sentence it, rather then twenty Fooles, garrulous in their lengthened tattle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53b53aed-618c-444d-b1b7-2e397d947e1b",
                        "source_entry_id": "d1ec9451-d9b7-3340-9a51-4ccb3a9f60da",
                        "source_sense_id": "7bb6d1b6-9bc5-39bc-b434-52233a3f5fdb",
                        "source_sense_description": "vonnis van een rechter",
                        "target_lang_word": "verdict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                        "entry_id": "cfcac4e9-095d-3bc8-9bdd-897e7abef19d",
                                        "glosses": [
                                            "A decision on an issue of fact in a civil or criminal case or an inquest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80c5063-062d-4f24-9534-12e5e8d17d64",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "The jury returned a “not guilty” verdict."
                                            },
                                            {
                                                "example_id": "f1635dab-d44a-4053-bbdd-0340611a2ff2",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            },
                                            {
                                                "example_id": "f06bf05e-2199-4dcf-ae0b-d189f947372a",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "When his body was retrieved, it was apparent that he had not raised his hands to cover his face. Had he suffered some sort of fit or seizure? The coroner’s verdict was accidental death."
                                            },
                                            {
                                                "example_id": "3b774a8f-3c2f-48fa-bd6c-76b54e5c820a",
                                                "sense_id": "1a54d9b1-f4de-344f-b7c4-fd40f5a466b1",
                                                "text": "The Supreme Court said Monday that unanimous jury verdicts are required in state criminal trials for serious offenses, handing a victory to criminal defendants including petitioner Evangelisto Ramos, who was convicted of murder in Louisiana on a 10-2 vote. […] “We took this case to decide whether the Sixth Amendment right to a jury trial – as incorporated against the States by way of the Fourteenth Amendment – requires a unanimous verdict to convict a defendant of a serious offense,” Gorsuch wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691cbe5f-dfa3-3bba-9ad0-92e6656d9d29",
                                        "entry_id": "cfcac4e9-095d-3bc8-9bdd-897e7abef19d",
                                        "glosses": [
                                            "An opinion or judgement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707e5cb5-8cd8-421d-b0ee-f5e06c0bf8ba",
                                                "sense_id": "691cbe5f-dfa3-3bba-9ad0-92e6656d9d29",
                                                "text": "a “not out” verdict from the umpire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
