                    {
                        "translation_id": "f6d94753-9c8f-4061-8ad7-21248c16cf12",
                        "source_entry_id": "e1650e8b-4e90-3975-8398-16286770f087",
                        "source_sense_description": "a large wasp, of the genus Vespa, with a brown-and-yellow-striped body",
                        "target_lang_word": "frelon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frelon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                        "entry_id": "3c1fc5cf-d3f1-35a9-b017-2d861357bbae",
                                        "glosses": [
                                            "Sorte de grosse guêpe, de nom scientifique Vespa crabro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f18dea-8197-4519-8883-7314411101e2",
                                                "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                                "text": "Un frelon qui bourdonne."
                                            },
                                            {
                                                "example_id": "ae905863-f686-464a-9c29-1dc07ea2a7a5",
                                                "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                                "text": "Le champ mort et désert, où les frelons autrefois bourdonnaient seuls autour des fleurs grasses, dans le silence écrasant du soleil."
                                            },
                                            {
                                                "example_id": "f1e5c20d-ed71-4753-b9b1-aa700c1bc2dc",
                                                "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                                "text": "Au bout de cette petite lande apparaissait le hameau du Frelin. — Or, j’aimais ce nom de Frelin, il me semblait dériver de ces gros frelons terribles des bois de la Limoise, qui nichaient dans le cœur de certains chênes et qu’on détruisait au printemps en allumant de grands feux alentour."
                                            },
                                            {
                                                "example_id": "d84d840b-72a9-465a-93c9-3b2c0e693a72",
                                                "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                                "text": "Bavardage délicieux, désordonné, vagabond, nous bruissons comme deux frelons au-dessus du jardin."
                                            },
                                            {
                                                "example_id": "1106e7d7-b601-4ef9-a37a-d4acacdc1401",
                                                "sense_id": "f433e8fb-bb02-3437-8172-1b48dc8bde06",
                                                "text": "Comme des frelons défendent un nid en cas d'attaque, les VE volent en essaim pour s'attacher aux envahisseurs et les tuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40c2017f-dfe2-3234-acb7-645795755a70",
                                        "entry_id": "3c1fc5cf-d3f1-35a9-b017-2d861357bbae",
                                        "glosses": [
                                            "Gens inutiles à la société."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d232558-8c5a-488d-983b-0dbf9f845f12",
                                                "sense_id": "40c2017f-dfe2-3234-acb7-645795755a70",
                                                "text": "– Vous êtes les vrais parasites de la société… Une légion de frelons inutiles dans la ruche où l’on travaille… Des paons qui font la roue dans la basse-cour et qui picorent les grains de choix sur l’écuelle de la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1edafcae-db7a-3c80-b469-9db316907ec7",
                                        "entry_id": "3c1fc5cf-d3f1-35a9-b017-2d861357bbae",
                                        "glosses": [
                                            "Gens incapables et envieux qui décrient les ouvrages d’autrui et qui les pillent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3788eadd-40f1-4521-841c-aac9ed68abb7",
                                                "sense_id": "1edafcae-db7a-3c80-b469-9db316907ec7",
                                                "text": "Ce frelon littéraire, bourdonnant son sot orgueil, pillant partout le miel que de laborieuses abeilles ont produit, et le débitant sous son nom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fbeb8fa-835d-3577-95cd-5278e75bdd07",
                                        "entry_id": "3c1fc5cf-d3f1-35a9-b017-2d861357bbae",
                                        "glosses": [
                                            "Frère, frérot (pour désigner une personne proche, sans nécessairement un lien familial)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83017f5d-d722-4284-907f-f0176dec0ada",
                                                "sense_id": "4fbeb8fa-835d-3577-95cd-5278e75bdd07",
                                                "text": "Les yeux, c’est le reflet de l’âme\nDonc, frelon, quand tu dis « wesh »\nFaut r’garder dans les yeux\nMais l’mec a dit « wesh », a téma ses pieds"
                                            },
                                            {
                                                "example_id": "34e048e7-e895-4f57-ad62-ea61aa9ca72d",
                                                "sense_id": "4fbeb8fa-835d-3577-95cd-5278e75bdd07",
                                                "text": "Ils disent que je ne suis plus leur frelon, que j’ai le bras grave long\nQue depuis j’ai pris le melon, que je veux lécher tous les mamelons"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "704b8d85-5af2-4cc4-ae28-289047b239d2",
                        "source_entry_id": "e1650e8b-4e90-3975-8398-16286770f087",
                        "source_sense_description": "a large wasp, of the genus Vespa, with a brown-and-yellow-striped body",
                        "target_lang_word": "Hornisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hornisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Art der Faltenwespen, die der Gattung der Großwespen (siehe [2]) angehört"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f963c8c-5cb3-4440-bbf2-7111958ffa1c",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "Der Stich einer Hornisse ist nicht gefährlicher als derjenige einer Biene."
                                            },
                                            {
                                                "example_id": "6650826b-a9a5-4fe0-9685-8320d6bbd210",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Zwei Hornissen stachen ihn fast zu gleicher Zeit, er brüllte vor Entsetzen und warf sein Gewehr weg.“"
                                            },
                                            {
                                                "example_id": "f4f17b4a-d17b-40e9-8c95-b1002ed5b9cb",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Dann flog eine Hummel in den Hochstand, die so groß war, daß sie auch eine Hornisse sein konnte.“"
                                            },
                                            {
                                                "example_id": "29ca2752-b58a-4424-a94f-6a6dbcd94895",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Bald schwärmten Fliegen, Wespen und Hornissen um das tote Tier; sie mussten es in den Graben werfen und dem Ungeziefer überlassen.“"
                                            },
                                            {
                                                "example_id": "77f124ae-924e-4daa-93eb-259b8e5568be",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Drohnen, Hornissen, Schmetterlinge fliegen unsachlich herum und stossten gegen die Stockwände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Sammelbezeichnung für die Gattung Vespa oder Großwespen"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508af155-d770-4495-b6d5-2451dba44341",
                                                "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                                "text": "Die Gattung der Hornissen zählt zu der Familie der Faltenwespen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
