                        "glosses": [
                            "członek nieformalnej frakcji rywalizującej o władzę w PZPR opowiadającej się za złagodzeniem dyktatury w państwie i zwiększeniem zakresu swobód obywatelskich"
                        ],
                        "tags": [],
                        "examples": [
