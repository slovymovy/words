                        "source_entry_id": "d16d1de2-cea5-3c32-b7f2-899f85763cee",
                        "source_sense_id": "70db41ef-656c-3365-ab0b-4c2778decac5",
                        "source_sense_description": "Verbrennungsmotor, bei dem der Verbrennungsdruck durch einen rotierenden Kreiskolben in Bewegung umgesetzt wird",
                        "target_lang_word": "moteur à piston rotatif",
                        "target_lang_code": "fr",
