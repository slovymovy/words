                "senses": [
                    {
                        "sense_id": "d41eefa1-3512-323e-948f-415ffadd66ac",
                        "entry_id": "17c1e3bf-2be6-361f-9a8a-ab18c0b85d0c",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным харизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3348d48c-f05f-413e-9bf0-11dca6604bda",
                                "sense_id": "d41eefa1-3512-323e-948f-415ffadd66ac",
                                "text": "Лицом мужчина был похож на тов. Л. Берия, крепко севшего на диету. Только без харизматичного пенсне."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b71a428-d8e0-301b-9445-19d2bfbab10d",
                        "entry_id": "17c1e3bf-2be6-361f-9a8a-ab18c0b85d0c",
                        "glosses": [
                            "обладающий харизмой, наделённый ею"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768d53a9-00ea-45b8-aa48-54fa941e73fd",
                                "sense_id": "1b71a428-d8e0-301b-9445-19d2bfbab10d",
                                "text": "Сильный, харизматичный лидер, такой как Рой Эш, легко может подменить реальность своим собственным видением ситуации."
                            }
                        ]
                    }
