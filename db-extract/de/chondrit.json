                ],
                "senses": [
                    {
                        "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                        "entry_id": "c3534a08-84fe-3c6f-b85d-de725f28e434",
                        "glosses": [
                            "weitgehend aus Chondren aufgebauter Steinmeteorit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8413512f-09a4-401f-8763-bbe9cdbaa254",
                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                "text": "Auch Chondrite sind Kollisionsschutt, gehörten jedoch zu Himmelskörpern, die niemals aufschmolzen."
                            },
                            {
                                "example_id": "b32a166f-62be-4d71-a826-a2544f1e6b5e",
                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                "text": "Schon bald erwies sich der Murchison-Meteorit als wahrer Schatz für die Forschung. Er gehört zu den primitiven kohligen Chondriten, die seit ihrer Entstehung im solaren Urnebel vor 4,56 Milliarden Jahren fast unverändert erhalten geblieben sind."
                            },
                            {
                                "example_id": "a80ce52b-5906-47cc-b877-75c0cc4b96fd",
                                "sense_id": "34297918-321b-3b31-9a10-69c92d12a182",
                                "text": "Bischoff: „Gewöhnliche Chondrite, mit rund 70 Prozent die häufigste Klasse, enthalten hauptsächlich das Mineral Olivin. Neuschwanstein besitzt dagegen überhaupt kein Olivin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                        "entry_id": "c3534a08-84fe-3c6f-b85d-de725f28e434",
                        "glosses": [
                            "pflanzlichen Fossilien ähnelnde Verzweigungen in Gesteinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7fe474-39d2-4ec1-ac56-5db67c74e392",
                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                "text": "Das ausgeschiedene Sediment ist heller, weil Verwertbares verdaut wurde; Chondriten werden diese Spuren genannt. Früher wurden sie als Seegrasabdrücke angesprochen, aufgrund ihrer Ähnlichkeit mit diesen Pflanzen."
                            },
                            {
                                "example_id": "5889c80b-6b59-4b6c-aa51-8c2210591d95",
                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                "text": "Die hier gefundenen fiederförmig geästeten Chondriten ähneln im Gegensatz zu den andersgeformten Chondriten der Oberkreide, den Unterkreideformen, was aus dem Wienerwald bestätigt werden kann."
                            },
                            {
                                "example_id": "445899d9-6c81-431c-8361-1b7b69a5fe6e",
                                "sense_id": "bf8b2e3d-c47a-34a2-9897-fcc07b9c8bb9",
                                "text": "Auch andere bituminöse und pflanzliche Reste wie Fucoiden und Chondriten kann man in diesen Schichten finden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
