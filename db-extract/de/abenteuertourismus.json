                                "example_id": "ebf99f46-1638-4baf-ac7d-3556f2a6bffe",
                                "sense_id": "34c6b86d-497a-3248-b500-b36467a5dda3",
                                "text": "„Je nach Ziel oder Art der Reise differenziert man unter anderem in Städtetourismus, Skitourismus, Rucksacktourismus oder Abenteuertourismus.“"
                            },
                            {
                                "example_id": "2b76c73c-b884-4584-bf63-d2ee3293b2ad",
                                "sense_id": "34c6b86d-497a-3248-b500-b36467a5dda3",
                                "text": "„Grönland hofft, den Abenteuertourismus – wie etwa Wandern und Kajakfahren – sowie den Kreuzfahrtverkehr steigern zu können.“"
                            }
                        ],
