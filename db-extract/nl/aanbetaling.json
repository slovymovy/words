                    {
                        "sense_id": "92a85c2f-55ba-3abb-8d41-53b77be679e1",
                        "entry_id": "3f1ec1b0-1a45-3d53-b81d-da75884204da",
                        "glosses": [
                            "een eerste betaling bij het kopen van iets op afbetaling of in termijnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d5fb7bb-70a5-4887-a6e0-2c3e06b4e0d9",
                                "sense_id": "92a85c2f-55ba-3abb-8d41-53b77be679e1",
                                "text": "Heeft u de aanbetaling al gedaan?"
                            },
                            {
                                "example_id": "45814094-8b43-4f7e-884d-d82cb02aaa38",
                                "sense_id": "92a85c2f-55ba-3abb-8d41-53b77be679e1",
                                "text": "Ik had het grootste deel van wat ik met De verstekeling had verdiend, gebruikt voor een aanbetaling op een flat hier en zette die vol met rare dingen waar je in het dagelijks leven niets aan hebt: een suikerspinmachine, een opblaasbad, zo'n groot toetsenbord waar je op moet dansen."
                            },
                            {
                                "example_id": "10aafe20-5560-4a34-9265-675cdd6519ac",
                                "sense_id": "92a85c2f-55ba-3abb-8d41-53b77be679e1",
                                "text": "Meiler vroeg of ze een aanbetaling op de vijftigduizend wilde; Franzen schudde haar hoofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a0eae2-c268-4487-bf60-9d031a96a56c",
