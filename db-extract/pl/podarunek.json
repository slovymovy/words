                "forms": [],
                "senses": [
                    {
                        "sense_id": "8af314e5-c19d-395e-82fc-4606cefb9bc5",
                        "entry_id": "561c957f-feb5-3991-b80e-6c4969475dfc",
                        "glosses": [
                            "dar, prezent, to, co się komuś darowuje"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9606a7a-4534-464c-8944-e63816e9d4c4",
                        "source_entry_id": "561c957f-feb5-3991-b80e-6c4969475dfc",
                        "source_sense_id": "8af314e5-c19d-395e-82fc-4606cefb9bc5",
                        "target_lang_word": "gift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cafdb44-ece2-3198-942f-20d701f48ed3",
                                        "entry_id": "48b463d1-2d65-3fa4-bfd4-7b77ec3e9dcb",
                                        "glosses": [
                                            "Something given to another voluntarily, without charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e25644-e8d9-4bc5-be38-f4b7fce62893",
                                                "sense_id": "5cafdb44-ece2-3198-942f-20d701f48ed3",
                                                "text": "She gave him a cell phone as a birthday gift."
                                            },
                                            {
                                                "example_id": "7c3b81c2-ef76-4fe2-8d25-fdfd7eb84cad",
                                                "sense_id": "5cafdb44-ece2-3198-942f-20d701f48ed3",
                                                "text": "“I thank you for the gift, Dr. Yueh,” Paul said, speaking formally. “It will be our secret. If there is a gift or favor you wish from me, please do not hesitate to ask.”\n\"I . . . need for nothing,\" Yueh said."
                                            },
                                            {
                                                "example_id": "62151752-4b21-47d2-aea3-0fce1d8d9ef9",
                                                "sense_id": "5cafdb44-ece2-3198-942f-20d701f48ed3",
                                                "text": "But now I know, but now I really know / Of only one thing I am truly very sure / Love is a gift, love is a gift"
                                            },
                                            {
                                                "example_id": "1212a5db-f2c3-4a41-bba8-c0eadee4378e",
                                                "sense_id": "5cafdb44-ece2-3198-942f-20d701f48ed3",
                                                "text": "She bought the model as a surprise gift for a friend who is a lifelong HST fan and railwayman, and who will soon be celebrating a milestone birthday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb98179a-036e-3541-b988-e14a9131742a",
                                        "entry_id": "48b463d1-2d65-3fa4-bfd4-7b77ec3e9dcb",
                                        "glosses": [
                                            "A talent or natural ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f2cc006-3702-40a4-a494-98b569920f84",
                                                "sense_id": "cb98179a-036e-3541-b988-e14a9131742a",
                                                "text": "She had a gift for playing the flute."
                                            },
                                            {
                                                "example_id": "b28a622f-b2ea-40a3-9b28-c721446c0e7f",
                                                "sense_id": "cb98179a-036e-3541-b988-e14a9131742a",
                                                "text": "“[…] it is not fair of you to bring against mankind double weapons! Dangerous enough you are as woman alone, without bringing to your aid those gifts of mind suited to problems which men have been accustomed to arrogate to themselves.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6b316d-5f81-3168-9703-8784909505db",
                                        "entry_id": "48b463d1-2d65-3fa4-bfd4-7b77ec3e9dcb",
                                        "glosses": [
                                            "Something gained incidentally, without effort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b335a2b4-3fdc-3bfa-82c1-e75a4b394045",
                                        "entry_id": "48b463d1-2d65-3fa4-bfd4-7b77ec3e9dcb",
                                        "glosses": [
                                            "The act, right, or power of giving or bestowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb19d1a7-bf2d-47ad-9f45-151be1f91096",
                                                "sense_id": "b335a2b4-3fdc-3bfa-82c1-e75a4b394045",
                                                "text": "The office is in the gift of the President."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f893d1-1c99-3716-95c9-2ef23d02fa30",
                                        "entry_id": "efd055e1-25ac-3fc1-be66-0f8be2f8bc40",
                                        "glosses": [
                                            "To give as a gift or donation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db9be403-cca9-3146-8983-387ef4214806",
                                        "entry_id": "efd055e1-25ac-3fc1-be66-0f8be2f8bc40",
                                        "glosses": [
                                            "To give away, to concede easily."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67510eb2-832a-4267-85e1-4655d4d69ca5",
                                                "sense_id": "db9be403-cca9-3146-8983-387ef4214806",
                                                "text": "Chelsea threw away two points when substitute Salomon Kalou gifted Valencia a penalty five minutes from time with a needless handball."
                                            },
                                            {
                                                "example_id": "9cb4f37e-3552-4991-93e5-b3b35691c450",
                                                "sense_id": "db9be403-cca9-3146-8983-387ef4214806",
                                                "text": "They drove on, every rise in the road lifting their sightline clear of the drystone dykes along the roadside, gifting glimpses of the firth and the islands, the blue peaks of Arran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0272fdbf-0b0b-4eee-bb7b-244728ea1fc9",
                        "source_entry_id": "561c957f-feb5-3991-b80e-6c4969475dfc",
