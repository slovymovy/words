                        "sense_id": "c361a66e-c2e3-35d8-8139-5ecf832696e1",
                        "entry_id": "619a95a8-f905-34a3-a57e-f3cd23f29220",
                        "glosses": [
                            "ukryta reklama towarów, usług, firm itp. zamieszczona w przestrzeni ( publikacji) o charakterze niereklamowym,"
                        ],
                        "tags": [
                            "np."
                        ],
                        "examples": [
                            {
                                "example_id": "82083934-c0ab-4607-ad31-3645dd398e2e",
                                "sense_id": "c361a66e-c2e3-35d8-8139-5ecf832696e1",
                                "text": "Ach ta kryptoreklama, ileż z nią kłopotu… Na potrzeby serialu produkuje się własne naklejki na szampana i na każdą butelkę wina pokazywaną na ekranie"
                            },
                            {
                                "example_id": "e631040b-ab12-4cbb-b939-be58c90762fa",
                                "sense_id": "c361a66e-c2e3-35d8-8139-5ecf832696e1",
                                "text": "Tajemnicą poliszynela są opowieści o artykułach pisanych i publikowanych za pieniądze (czyli tzw. kryptoreklamie), o prezentach, jakie dziennikarze uczestniczący w konferencjach prasowych dostają od wielkich firm i koncernów"
                            }
                        ],
