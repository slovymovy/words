                "senses": [
                    {
                        "sense_id": "a6c331f0-abfc-398b-97ed-7664f2eb1262",
                        "entry_id": "6ca6cdb2-1a4a-38b8-b9a7-ec7d482e26ce",
                        "glosses": [
                            "Gemeinschaft aus Eltern und wenigen Kindern"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ad51f7bf-ae0d-4783-b826-9c90ffafd989",
                                "sense_id": "a6c331f0-abfc-398b-97ed-7664f2eb1262",
                                "text": "Eine Kernfamilie bestehend aus den Eltern und 12 Kindern ist keine Kleinfamilie."
                            },
                            {
                                "example_id": "8e73a059-0ca4-430c-8ca1-8c3887bdda99",
                                "sense_id": "a6c331f0-abfc-398b-97ed-7664f2eb1262",
                                "text": "Nach dem Zweiten Weltkrieg entwickelte sich die Form der Kleinfamilie mit höchstens drei Kindern zum Idealtyp einer gesellschaftlichen Lebensgemeinschaft."
                            },
                            {
                                "example_id": "e7151041-d250-4512-9d2f-99b89b156c7a",
                                "sense_id": "a6c331f0-abfc-398b-97ed-7664f2eb1262",
                                "text": "„Schuld an allem Elend auf der Welt war die traditionelle Kleinfamilie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
