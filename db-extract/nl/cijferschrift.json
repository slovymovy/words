                        "examples": [
                            {
                                "example_id": "6ebc29e3-a4dc-4a64-ac61-c07c2b7473e3",
                                "sense_id": "d4de9439-2496-3f5a-852f-5f12aa45a526",
                                "text": "Qua muzieknotatie die organisten gebruiken, is het notenschrift het meest ingeburgerd (85 procent). Daarnaast wordt klavarskribo gehanteerd. Een enkeling (vier organisten) gebruikt het cijferschrift, twintig mensen zeggen niets voor zich te hebben."
                            },
                            {
                                "example_id": "c965cead-9ec3-41b1-b033-d209e43b3c88",
                                "sense_id": "d4de9439-2496-3f5a-852f-5f12aa45a526",
                                "text": "In de hoek van de grote woonkamer staat een pijporgel. Met trappedalen. „Ik ben nooit verder gekomen dan het cijferschrift, maar m’n zoon speelt er op.”"
                            }
                        ]
                    },
