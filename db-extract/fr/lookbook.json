                        "entry_id": "b42a8e4f-d28b-38ad-8b79-dfc5b4b68404",
                        "glosses": [
                            "Livre de photographies présentant un mannequin, une collection de mode ou le travail d’un photographe."
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "f5596bd1-8d7d-49e9-a08b-e89b4aba9573",
                                "sense_id": "46e96cb8-0040-37ea-a61d-80cc133d14fb",
                                "text": "Pour présenter sa nouvelle collection de prêt-à-porter féminin (saison printemps-été 2014), Kiton n’a pas opté pour un lookbook ou un défilé."
                            },
                            {
                                "example_id": "37633115-9925-4678-a1ab-e716da60e148",
                                "sense_id": "46e96cb8-0040-37ea-a61d-80cc133d14fb",
                                "text": "Ce prix coup de cœur de Christian Dior Parfums récompense un étudiant de 4ᵉ ou de 5ᵉ par la mise à disposition d’un maquilleur professionnel et de produits Dior pour la réalisation de son prochain lookbook."
                            }
                        ]
                    }
                ],
