                        "entry_id": "fa1a38d0-5b52-3846-b8d1-dc64254cd5b5",
                        "glosses": [
                            "eine Untergruppe innerhalb der semitischen Sprachen, deren Sprachen bis auf das Hebräische ausgestorben sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e57cda-e923-4c9d-a927-cd8194f3a5ba",
                                "sense_id": "d892a952-e836-34d9-ab32-c4dc01562613",
                                "text": "Sprechen Sie Kanaanäisch?"
                            },
                            {
                                "example_id": "591737f8-3ad6-4838-9579-e481d230b4fb",
                                "sense_id": "d892a952-e836-34d9-ab32-c4dc01562613",
                                "text": "„Zum Nordwestsemitischen gehören Kanaanäisch und das jüngere Aramäisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433e9f57-13eb-4110-b00a-1334cf0553d9",
                        "source_entry_id": "fa1a38d0-5b52-3846-b8d1-dc64254cd5b5",
                        "source_sense_id": "d892a952-e836-34d9-ab32-c4dc01562613",
                        "target_lang_word": "Canaanite",
