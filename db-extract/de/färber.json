                                    {
                                        "sense_id": "9ad0ee5a-1330-35a3-a5e5-3e0c073dcb15",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "One who, or that which, dips (immerses something, or itself, into a liquid)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec831f7e-3489-4fa4-8209-051932e74c47",
                                                "sense_id": "9ad0ee5a-1330-35a3-a5e5-3e0c073dcb15",
                                                "text": "A chocolate dipper dips the cream centers into warm chocolate by hand; when taken out the creams are shaped [...]"
                                            },
                                            {
                                                "example_id": "0359690d-82f5-4f15-91ba-f716fb9719a6",
                                                "sense_id": "9ad0ee5a-1330-35a3-a5e5-3e0c073dcb15",
                                                "text": "When the engine runs the dipper dips in the oil once in every revolution of the crankshaft and the oil is splashed on the cylinder walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4389375-000c-30d9-bf91-e03317e21d83",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "Any of various small passerine birds of the genus Cinclus that live near fast-flowing streams and feed along the bottom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8b39c8f-e4b4-39ac-b6c9-961a857b5beb",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "A cup-shaped vessel with a long handle, for dipping into and ladling out liquids; a ladle or scoop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93a09548-18b2-34b8-8aa9-fa274784f0aa",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "The control in a vehicle that switches between high-beam and low-beam (i.e. dips the lights), especially when used to signal other vehicles."
                                        ],
                                        "tags": [
                                            "India",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86a04238-0fa6-3c51-b486-54c880a1687c",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "Any snack food intended to be dipped in sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e09f187-984b-43c7-a088-6b5ecb2599e4",
                                                "sense_id": "86a04238-0fa6-3c51-b486-54c880a1687c",
                                                "text": "chicken dippers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a5a799-259d-3af5-b229-45b9c2eb41da",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "Someone who dips chewing tobacco or snuff."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b960eb02-0c13-3316-93d4-9ca3008b577b",
                                        "entry_id": "4ed277ab-fd77-36f0-94fc-73cfa9878139",
                                        "glosses": [
                                            "A pickpocket."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a88b040-8f86-4a12-91b5-7f1a92630e7b",
                                                "sense_id": "b960eb02-0c13-3316-93d4-9ca3008b577b",
                                                "text": "It is doubtful if the Victorian Londoner needed any warning, for the artful mobsmen, toolers, whizzers and dippers, together with their stickman accomplices, were everywhere in the crowds, in the underground, on railway trains […]"
                                            }
                                        ]
                                    },
