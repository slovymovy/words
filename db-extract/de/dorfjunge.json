                "senses": [
                    {
                        "sense_id": "9f2ee9e2-4997-3f63-af96-b08152691c2a",
                        "entry_id": "8e5dd22b-9724-32ce-94ef-f2e9a30ab684",
                        "glosses": [
                            "Junge, der aus einem Dorf stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b1e574-0025-44fb-aab6-fbc42a08e9be",
                                "sense_id": "9f2ee9e2-4997-3f63-af96-b08152691c2a",
                                "text": "„Die Erwachsenen ließen mich meistens in Ruhe, aber vor den Dorfjungen musste ich mich in Acht nehmen.“"
                            },
                            {
                                "example_id": "2e746d42-f69f-4cbc-b44b-a056d60771f6",
                                "sense_id": "9f2ee9e2-4997-3f63-af96-b08152691c2a",
                                "text": "„Er war einfach zu rundlich und gut genährt für einen typischen Dorfjungen, der noch nie in den Genuss von Milch gekommen ist, abgesehen von der seiner Mutter.“"
                            },
                            {
                                "example_id": "094c3f2e-25ae-4a7a-a899-697d6f32d4e9",
                                "sense_id": "9f2ee9e2-4997-3f63-af96-b08152691c2a",
                                "text": "„Ich war der naive Dorfjunge, der sich in das smarte Mädchen aus der Großstadt verliebt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
