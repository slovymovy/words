        "fr-extract.jsonl": [
            {
                "entry_id": "40d942a3-2d53-3f9f-8ad4-99e00853cfc6",
                "word": "absoute",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "acaedcf5-eb46-46ec-8a03-4f02cf128de8",
                        "entry_id": "40d942a3-2d53-3f9f-8ad4-99e00853cfc6",
                        "tags": [
                            "plural"
                        ],
                        "form": "absoutes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b52420b0-faa9-3dc6-8934-21ca557cec5c",
                        "entry_id": "40d942a3-2d53-3f9f-8ad4-99e00853cfc6",
                        "glosses": [
                            "Prière qui termine une cérémonie funèbre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7bea187a-9fc1-486c-b15d-4756f2b48bbe",
                                "sense_id": "b52420b0-faa9-3dc6-8934-21ca557cec5c",
                                "text": "Il ne songeait plus qu’aux deux cents mètres qui le séparaient de son église, aux huit cents qu’il faudrait refaire en sens inverse, après l’absoute, pour conduire Emma au cimetière."
                            },
                            {
                                "example_id": "ba4c8635-1804-4918-93e8-85257245e987",
                                "sense_id": "b52420b0-faa9-3dc6-8934-21ca557cec5c",
                                "text": "Elle va rester ainsi, prostrée, jusqu'à l'absoute. Mais il lui faut bien se relever, repartir dans le même arroi jusqu'au cimetière où soudain le cirque recommence…"
                            },
                            {
                                "example_id": "666faed9-ab2c-4d93-96b2-c0a6eb33342a",
                                "sense_id": "b52420b0-faa9-3dc6-8934-21ca557cec5c",
                                "text": "Comment pourrais-je refuser une sépulture à un homme baptisé ? Et pourquoi ne pas lui donner l’absoute ?"
                            },
                            {
                                "example_id": "4ee4249d-5748-4b01-82ff-70f6b24252b5",
                                "sense_id": "b52420b0-faa9-3dc6-8934-21ca557cec5c",
                                "text": "Le curé a donné l’absoute."
                            }
                        ]
                    },
                    {
                        "sense_id": "4496518f-94fa-36c3-9677-d38dc59fa455",
                        "entry_id": "40d942a3-2d53-3f9f-8ad4-99e00853cfc6",
                        "glosses": [
                            "Absolution publique et solennelle qui se donnait au peuple le jeudi saint au matin, ou le mercredi saint au soir dans les cathédrales."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
