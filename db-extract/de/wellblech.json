                ],
                "senses": [
                    {
                        "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                        "entry_id": "683b6e92-5be7-3e35-8576-71f70b300556",
                        "glosses": [
                            "dünne Metallplatte, die zur Erhöhung der Stabilität wellenförmig gebogen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527755b7-853e-4153-af73-d1d0c3ff15ba",
                                "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                                "text": "Wellblech wird unter anderem genutzt, um einfache Dächer zu decken."
                            },
                            {
                                "example_id": "eb41e849-58f3-4baf-9592-0cfe2844d65f",
                                "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                                "text": "„Auf der einen Seite des Fjordes lagern zwei Boote in einer Lagerhalle aus Wellblech, eingezwängt zwischen den Felsen, in der Bucht gegenüber liegt das hellgelbe Gerippe eines Zwergwals, an dem blaues Ölzeug zum Trocknen hängt.“"
                            },
                            {
                                "example_id": "8208e177-f30c-4cac-a2d9-680fdf9ed59f",
                                "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                                "text": "„Der Wind fuhr lautstark unter das Wellblech; schiefe Metallfenster quietschten in ihren Angeln.“"
                            },
                            {
                                "example_id": "34c94be2-b522-4b90-b283-6e3812a52fe2",
                                "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                                "text": "„Der Supermarkt ist ein Zentrum der vierhundert Inseln, ein Flachbau aus Wellblech und festzementierten Platten, mit Parkplätzen, Wäscherei und verstreuten Containern, das umgebende Gelände ist steinig und weit, zwei ramponierte Kiefern, ein halber Zaun.“"
                            },
                            {
                                "example_id": "1c62bc20-ec38-4169-9d45-c9ae0c267ed3",
                                "sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                                "text": "„Sie parkten vor einem mit weißem Wellblech verkleideten Bungalow mit blauem Dach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21965d26-dbbf-45b4-81a6-7cadad428e21",
                        "source_entry_id": "683b6e92-5be7-3e35-8576-71f70b300556",
                        "source_sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                        "source_sense_description": "dünne Metallplatte, die zur Erhöhung der Stabilität wellenförmig gebogen wurde",
                        "target_lang_word": "corrugated iron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrugated iron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "412e0fdf-200d-324f-ac33-8b4cc571eceb",
                                        "entry_id": "99e1302e-81e4-3ef3-a857-8263a43084c0",
                                        "glosses": [
                                            "An iron sheet building material, usually galvanised, which has been pressed into corrugations."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ca9b2c-1b20-47dc-b34a-b887773603f3",
                                                "sense_id": "412e0fdf-200d-324f-ac33-8b4cc571eceb",
                                                "text": "A special reserved enclosure with sandbags and a corrugated iron roof was set aside for three members of the Royal Family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "149edd61-5994-46f6-8494-c27f16e784cb",
                        "source_entry_id": "683b6e92-5be7-3e35-8576-71f70b300556",
                        "source_sense_id": "b5dfe22f-386c-3fa4-89f8-928c9978ac51",
                        "source_sense_description": "dünne Metallplatte, die zur Erhöhung der Stabilität wellenförmig gebogen wurde",
                        "target_lang_word": "tôle ondulée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tôle ondulée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7e2be6-31a3-3c8c-831b-2b412e5f2e03",
                                        "entry_id": "9d9b5c9e-50be-3345-8f28-b28ddf6440f7",
                                        "glosses": [
                                            "Sorte de plaque mince de métal, galvanisée ou peinte, dont la rigidité est assurée par ses plis arrondis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa8bf82-8bf5-4e9f-b161-57a33e98a325",
                                                "sense_id": "ed7e2be6-31a3-3c8c-831b-2b412e5f2e03",
                                                "text": "Pourquoi construire d’inconfortables maisons en planches et en tôle ondulée quand le feuillage des cocotiers peut vous fournir des abris toujours frais ?"
                                            },
                                            {
                                                "example_id": "f4f9a8f7-4de7-4ee2-9b2b-a1369867905b",
                                                "sense_id": "ed7e2be6-31a3-3c8c-831b-2b412e5f2e03",
                                                "text": "Il s’affirmait qu’il avait construit des routes, transformé un pays, arraché aux paillotes des champs les milliers de paysans nichés dans des huttes de tôle ondulée autour de ses usines, […]."
                                            },
                                            {
                                                "example_id": "bb6856a9-4ea7-4a03-b578-2821e8c88a3f",
                                                "sense_id": "ed7e2be6-31a3-3c8c-831b-2b412e5f2e03",
                                                "text": "L’uniformité des blocs était fréquemment rompue par la présence de matériaux divers, poutres, plaques de tôle ondulée, briques, épars entre les murs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "417a6871-74b2-387e-8495-f5cb3c221a6b",
                                        "entry_id": "9d9b5c9e-50be-3345-8f28-b28ddf6440f7",
                                        "glosses": [
                                            "Aspect déformé en vagues transversales au sens de circulation que l'on peut voir sur des routes en terre ou en autres matériaux peu stables."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7300c554-9e94-44fa-8aef-a506da923331",
                                                "sense_id": "417a6871-74b2-387e-8495-f5cb3c221a6b",
                                                "text": "La tôle ondulée consiste en une organisation des matériaux libres de la chaussée en bandes perpendiculaires à l'axe de la route, qui affectent toute la largeur de la plateforme, et même ses parties les moins circulées."
                                            },
                                            {
                                                "example_id": "e7475e24-e6c0-4938-a02f-2d94507f165d",
                                                "sense_id": "417a6871-74b2-387e-8495-f5cb3c221a6b",
                                                "text": "En cas de tôle ondulée, il faut aller soit lentement, soit très vite, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
