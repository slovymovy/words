                    "semantic_group_id": "irytacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Denerwuje</w> mnie twoje ciągłe spóźnianie się na spotkania.",
                            "target_lang_translations": {
                                "en": "Your constant lateness to meetings <w>annoys</w> me.",
                                "ru": "Меня <w>раздражает</w> твоё постоянное опоздание на встречи.",
                                "nl": "Het <w>irriteert</w> me dat je steeds te laat komt voor afspraken.",
                                "de": "Dein ständiges Zuspätkommen zu Treffen <w>nervt</w> mich.",
                                "fr": "Ton retard permanent aux rendez-vous m'<w>énerve</w>.",
                                "it": "Mi <w>innervosisce</w> il tuo continuo ritardo agli appuntamenti.",
                                "cs": "<w>Rozčiluje</w> mě tvoje neustálé pozdní příchody na schůzky.",
                                "tr": "Buluşmalara sürekli geç kalman beni <w>sinirlendiriyor</w>.",
                                "es": "Me <w>pone nervioso</w> que siempre llegues tarde a las reuniones.",
                                "zh": "你开会老是迟到，真<w>惹</w>我<w>生气</w>。"
                            }
                        },
                        {
                            "text": "Głośna muzyka sąsiadów bardzo mnie <w>denerwuje</w>.",
                            "target_lang_translations": {
                                "en": "The neighbors' loud music <w>irritates</w> me a lot.",
                                "ru": "Громкая музыка соседей меня очень <w>нервирует</w>.",
                                "nl": "De harde muziek van de buren <w>ergert</w> me heel erg.",
                                "de": "Die laute Musik der Nachbarn <w>nervt</w> mich sehr.",
                                "fr": "La musique forte des voisins m'<w>énerve</w> beaucoup.",
                                "it": "La musica ad alto volume dei vicini mi <w>irrita</w> molto.",
                                "cs": "Hlasitá hudba od sousedů mě hrozně <w>štve</w>.",
                                "tr": "Komşuların yüksek sesli müziği beni çok <w>rahatsız ediyor</w>.",
                                "es": "La música alta de los vecinos me <w>irrita</w> mucho.",
                                "zh": "邻居放的大声音乐<w>使</w>我非常<w>烦躁</w>。"
                            }
