                                                "sense_id": "bc91a611-5ad3-3700-ba08-c2da43cc9a75",
                                                "text": "Oh, da sitzt du aber in einer bösen Klemme!"
                                            },
                                            {
                                                "example_id": "5852226f-6b60-4c88-a3c3-398287baa6ea",
                                                "sense_id": "bc91a611-5ad3-3700-ba08-c2da43cc9a75",
