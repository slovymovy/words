                                "target_senses": [
                                    {
                                        "sense_id": "83e4f948-d13a-3443-a4ab-d96a9b83e356",
                                        "entry_id": "19423abc-c4a0-3f68-b3f9-6ef1cc0f0242",
                                        "glosses": [
                                            "A collection of varying but related items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d13f60-9d19-4436-9a2a-c9ec4422ee20",
                                                "sense_id": "83e4f948-d13a-3443-a4ab-d96a9b83e356",
                                                "text": "This box has an assortment of chocolates. There's a picture on the cover so you know which is which."
                                            },
                                            {
                                                "example_id": "c3f2cb91-39a1-456d-b654-f7ae9cd6fbe7",
                                                "sense_id": "83e4f948-d13a-3443-a4ab-d96a9b83e356",
                                                "text": "The tool and die department stocks various hardware assortments, such as cap screws in most thread sizes and assorted lengths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da357a93-1219-40ea-9fb8-49c10132d065",
                        "source_entry_id": "476c82a5-d868-31fc-9801-c9bf3e7ef4d9",
                        "source_sense_id": "169393a9-1e3e-38f1-94a2-110e502e74a4",
                        "target_lang_word": "Sortiment",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sortiment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5243d8e-cf5e-33af-b7d5-8fd8bc2e407a",
                                        "entry_id": "2fa7bda5-2b62-3298-8c61-bfbedc717be7",
                                        "glosses": [
                                            "alle angebotenen und ausgewählten Artikel eines Handelsunternehmens"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51531b76-ac25-476b-90bc-1d74a38b5082",
                                                "sense_id": "c5243d8e-cf5e-33af-b7d5-8fd8bc2e407a",
                                                "text": "„Die Zusammenstellung von verschiedenen Artikeln zu einem Sortiment ist eine spezifische Dienstleistung von Handelsbetrieben.“"
                                            },
                                            {
                                                "example_id": "c6b307c7-f274-49b0-ac62-61c01067b57c",
                                                "sense_id": "c5243d8e-cf5e-33af-b7d5-8fd8bc2e407a",
                                                "text": "„Zu seinem Sortiment gehört auch der \"Spaghetti-Kürbis\", der im Wasser nach etwa einer Dreiviertelstunde Kochzeit Fäden zieht, die dem dünnen italienischen Teig-Klassiker gleichen.“"
                                            },
                                            {
                                                "example_id": "b407822f-0d6e-4760-8b46-db3795dd142c",
                                                "sense_id": "c5243d8e-cf5e-33af-b7d5-8fd8bc2e407a",
                                                "text": "„Und vermutlich ist das der Grund, warum ihn die Isländer noch immer in ihrem Sortiment haben.“"
                                            },
                                            {
                                                "example_id": "2051643e-1320-4474-a617-85a09a1d8993",
                                                "sense_id": "c5243d8e-cf5e-33af-b7d5-8fd8bc2e407a",
                                                "text": "„Ein durchschnittlicher Supermarkt führt ein Sortiment von vierzigtausend Artikeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c566e2a6-eb3b-40cc-b23d-9b797657965e",
                        "source_entry_id": "476c82a5-d868-31fc-9801-c9bf3e7ef4d9",
