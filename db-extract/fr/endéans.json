                                                "sense_id": "47a53b48-bc13-3efe-8a76-9348124f987f",
                                                "text": "within his hearing; her within five seconds of breaking the record; within an inch of falling overboard"
                                            },
                                            {
                                                "example_id": "ef870e7a-2da6-4b04-81b5-ebed5771892d",
                                                "sense_id": "47a53b48-bc13-3efe-8a76-9348124f987f",
                                                "text": "England struck back with a fine try from Ben Foden and closed to within seven points with three minutes left when Mark Cueto capitalised on a break from replacement Matt Banahan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63bc3dc-8976-3dd5-ad18-aff0b1d879a3",
                                        "entry_id": "91923abb-093b-3035-b4c6-0e9515bfa747",
                                        "glosses": [
                                            "Before the specified duration ends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34fc9f8b-9017-4070-bc31-5377c73593de",
                                                "sense_id": "d63bc3dc-8976-3dd5-ad18-aff0b1d879a3",
                                                "text": "Leave here within three days."
                                            },
                                            {
                                                "example_id": "6dfc7f42-50d1-4092-8122-128e88142ae9",
                                                "sense_id": "d63bc3dc-8976-3dd5-ad18-aff0b1d879a3",
                                                "text": "On October 6, 1927, Warner Bros. released The Jazz Singer, the first sound-synched feature film, prompting a technological shift of unprecedented speed and unstoppable force. Within two years, nearly every studio release was a talkie."
                                            },
                                            {
                                                "example_id": "8feb5da4-c1be-4b8d-9e7f-038b3ac060f1",
                                                "sense_id": "d63bc3dc-8976-3dd5-ad18-aff0b1d879a3",
                                                "text": "And Netherlands, backed by a typically noisy and colourful travelling support, started the second period in blistering fashion and could have had four goals within 10 minutes"
                                            }
                                        ]
                                    }
                                ]
                            },
