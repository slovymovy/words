                                "sense_id": "a47e904d-baf2-3ff9-a7fd-b300aaa862c8",
                                "text": "Die kerel deelde rake klappen uit."
                            },
                            {
                                "example_id": "7a77c8c4-b243-4904-88da-52bd6f905697",
                                "sense_id": "a47e904d-baf2-3ff9-a7fd-b300aaa862c8",
                                "text": "Maar goed, toen Paul en Emil ons naderden op dat zonnige terras in Aken, was het meteen raak tussen Paul en Marjo."
                            },
                            {
                                "example_id": "607df320-f89f-4ee6-b281-85d87fabe1e2",
                                "sense_id": "a47e904d-baf2-3ff9-a7fd-b300aaa862c8",
                                "text": "Ik bleef het proberen maar gooide pas na een kwartier raak."
                            }
