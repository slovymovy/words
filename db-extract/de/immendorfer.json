                "senses": [
                    {
                        "sense_id": "3cd4d213-7c45-346a-8684-192c0a8eb265",
                        "entry_id": "7a9da1d2-814f-3a6b-9f67-0ceafe1e4438",
                        "glosses": [
                            "ein Einwohner oder ein Bewohner eines der Orte oder Teilorte namens Immendorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffaf4860-e980-4bc6-ac26-efb2adfa02e0",
                                "sense_id": "3cd4d213-7c45-346a-8684-192c0a8eb265",
                                "text": "„Nichts erhitzte mehr die Gemüter der Immendorfer als die Ende der sechziger Jahre drohende Auflösung der selbstständigen Gemeinde.“"
                            },
                            {
                                "example_id": "879c1131-18fb-41eb-beb9-c107e35b7725",
                                "sense_id": "3cd4d213-7c45-346a-8684-192c0a8eb265",
                                "text": "„Die Immendorfer sind verunsichert: Bei den Anschlusskosten für die Abwasser-Entsorgung hat die Verwaltung jegliches Fingerspitzengefühl vermissen lassen.“"
                            },
                            {
                                "example_id": "89d3a787-5687-43ff-8fb8-46948474216c",
                                "sense_id": "3cd4d213-7c45-346a-8684-192c0a8eb265",
                                "text": "„In der Folgezeit wurden die Immendorfer wieder stärker und drängten nun auf den Führungstreffer. Dieser sollte eine Viertelstunde vor Schluss fallen als die Werther-Abwehr einen Ball nicht aus dem Gefahrenherd befördern konnte und der Gästestürmer zur Führung einnetzte.“"
                            },
                            {
                                "example_id": "e8884d87-2a36-420a-af32-cbf8167e2f70",
                                "sense_id": "3cd4d213-7c45-346a-8684-192c0a8eb265",
                                "text": "Die Immendorfer unterstützen von jeher ihre Vereine."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
