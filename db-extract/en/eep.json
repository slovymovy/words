            {
                "entry_id": "da8cbab3-d78a-33d8-9894-bf6673145f2d",
                "word": "eep",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ab45ef6a-eb36-40ca-a095-744d37ba0e62",
                        "entry_id": "da8cbab3-d78a-33d8-9894-bf6673145f2d",
                        "tags": [
                            "plural"
                        ],
                        "form": "eeps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "761b3109-6c7c-3369-8afe-4c507c60625c",
                        "entry_id": "da8cbab3-d78a-33d8-9894-bf6673145f2d",
                        "glosses": [
                            "A short scream or yelp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7517d186-eb1d-4411-900c-680628825dd4",
                                "sense_id": "761b3109-6c7c-3369-8afe-4c507c60625c",
                                "text": "She encouraged them to express their teeny-tiniest selves with an “eep.”"
                            },
                            {
                                "example_id": "05c5e511-840c-4620-9c7f-2702cd2a7758",
                                "sense_id": "761b3109-6c7c-3369-8afe-4c507c60625c",
                                "text": "\"Then the peepers begin on a high key, with a singularly sweet and lucid voice, somewhere betwixt a silver-whistle and a glass-bell, smacking little of the mid: 'Eep!-eep-eep-eep! ee ee-ee! eepee! eepee-peepee! peep-eep! eepepee! eepepee! eepepee!' accompanied by a few trills long continued...\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
