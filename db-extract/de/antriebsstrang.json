                                "target_senses": [
                                    {
                                        "sense_id": "650bde7f-dda2-330b-812b-0525f85ea2d5",
                                        "entry_id": "06a11144-9f7e-32e1-800e-9b5755abf9ae",
                                        "glosses": [
                                            "alle onderdelen die er voor zorgen dat een voertuig in beweging gebracht kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d89ac1-9f1d-4ed8-8e7c-93388477bd13",
                                                "sense_id": "650bde7f-dda2-330b-812b-0525f85ea2d5",
                                                "text": "Het chassis, de banden, de carrosserie en de batterij zijn voor elk team hetzelfde. Dit om de ontwikkelingskosten te drukken. De aandrijflijn mag door de teams zelf worden gebouwd. De auto's hebben tijdens de race een vermogen van 200 kW en een topsnelheid van 280 kilometer per uur."
                                            },
                                            {
                                                "example_id": "597fe0bf-b51d-42a0-82fb-5009b754c5cc",
                                                "sense_id": "650bde7f-dda2-330b-812b-0525f85ea2d5",
                                                "text": "Het steunhart kan uitkomst bieden voor mensen met uitbehandeld hartfalen die niet in aanmerking komen voor een harttransplantatie. Het steunhart neemt de pompfunctie van het hart over en wordt geplaatst in de linker hartkamer. Het steunhart is verbonden aan een kleine computer met een aandrijflijn die via de buik het lichaam ingaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
