                ],
                "senses": [
                    {
                        "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                        "entry_id": "425ce816-c175-3abc-90f8-5807fff6b68d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ab6a9bc-41a6-417a-8dfd-c9ace016dbb0",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Frau Gäbele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3ef9e268-eab6-408e-af55-b0d03b185c4d",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Herr Gäbele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cc550814-9440-4229-a9bc-a100cdd08673",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Die Gäbeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6472f1b9-b2dc-4c4d-bcbc-a6a03a00d9ac",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Der Gäbele trägt nie die Schals, die die Gäbele ihm strickt."
                            },
                            {
                                "example_id": "f5fbaf80-662c-4b3c-824f-30e12788c385",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gäbele kommt, geht der Herr Gäbele.“"
                            },
                            {
                                "example_id": "b7e7debd-d13f-44d3-8d38-6d473f88eb89",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Gäbele kommt und geht."
                            },
                            {
                                "example_id": "18512823-bde5-4d8e-913e-f7ab9ae633c6",
                                "sense_id": "e8bcd088-0ba7-3f3c-92a0-18e378a09c3b",
                                "text": "Gäbeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
