                "senses": [
                    {
                        "sense_id": "4e277b30-d3ca-35d1-b293-9ba8d481c4de",
                        "entry_id": "503dc016-bb7d-343a-aa60-052b9aac359b",
                        "glosses": [
                            "Rendre riche en phosphate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164a3d1a-115a-433d-a74a-d26d46f7c381",
                                "sense_id": "4e277b30-d3ca-35d1-b293-9ba8d481c4de",
                                "text": "Le sablage qui était l'opération la plus employée jusqu'à ce jour pour le traitement préalable des métaux à phosphatiser présente l'inconvénient d'être long et de laisser parfois des poussières à la surface des métaux."
                            },
                            {
                                "example_id": "40bf826a-6fcf-4b0b-b25d-0ad9d953045e",
                                "sense_id": "4e277b30-d3ca-35d1-b293-9ba8d481c4de",
                                "text": "Jamais du reste on n’a vu sur des sargasses de test de foraminiferes se phosphatiser; encore moins des « esquilles d’os de poisson » ne se rencontrent-elles pas sur les fucus nageant."
                            }
                        ]
                    }
