                "senses": [
                    {
                        "sense_id": "0024bbd0-a33b-3740-9b3f-fc8b9d126bb8",
                        "entry_id": "7a1b5f16-a775-328c-a7b3-164ed58c9b73",
                        "glosses": [
                            "To disturb; to unsettle; to arouse or irritate from a calm state."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "01b492ac-ae68-4ede-9384-a761115ea27e",
                                "sense_id": "0024bbd0-a33b-3740-9b3f-fc8b9d126bb8",
                                "text": "Take out your ire on the unneighborly generators of noises that unsoothe the nerves."
                            },
                            {
                                "example_id": "fd995e01-a367-406c-bd21-558e97dd1297",
                                "sense_id": "0024bbd0-a33b-3740-9b3f-fc8b9d126bb8",
                                "text": "Now it is overlooked by instructions, thrown out with the visual equivalent of a sergeant-major's bark, designed not to harmonize but to be dissonant, to abolish tranquillity, and to unsoothe and unsettle the soul."
                            },
                            {
                                "example_id": "ad2f88fa-09b6-4071-9075-0840e176e552",
                                "sense_id": "0024bbd0-a33b-3740-9b3f-fc8b9d126bb8",
                                "text": "And don't you just love the image of a tall mountain of a man using his big hands to soothe a child . . . or unsoothe a woman?"
                            }
                        ]
                    }
                ],
