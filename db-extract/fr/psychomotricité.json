                                "target_senses": [
                                    {
                                        "sense_id": "5cb9170e-1b25-3018-a2c8-a11c5be39063",
                                        "entry_id": "777e7cf1-034c-38d6-bb72-8a4be2ba0ddb",
                                        "glosses": [
                                            "The mental control of the muscles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7feea7d9-3dfd-44b1-b404-6fdda42f2fc9",
                                                "sense_id": "5cb9170e-1b25-3018-a2c8-a11c5be39063",
                                                "text": "In actual fact it is not a technique in itself since each therapist in psychomotricity, once trained, may use all the body techniques discussed here."
                                            }
                                        ]
                                    }
