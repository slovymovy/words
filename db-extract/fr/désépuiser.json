                "senses": [
                    {
                        "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                        "entry_id": "acfc9251-a947-3626-a350-7f1b56e3f561",
                        "glosses": [
                            "Remettre en forme après épuisement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a7f3fb3-ba64-44e1-864b-e2390b80ddb1",
                                "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                                "text": "On marche sur le sentier des douaniers, on se pose sur les rochers, on sort une canne à pêche… et la beauté des paysages, le grand ouvert de l’horizon, la fraicheur de l’eau, vous débarrassent de toute la sueur de la semaine… et l’immense épuisette vous désépuise en transformant les soucis en crevettes grises dégoulinantes et frétillantes !"
                            },
                            {
                                "example_id": "cde27dd7-5da1-4c28-8a4b-b0705a1f876d",
                                "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                                "text": "Vu ce qui précède, on peut bien trouver quelques euros pour \" désépuiser \" le CRS, en améliorant son moral et l'apport en protéines."
                            },
                            {
                                "example_id": "2872b5fb-b666-4617-afc2-1e8b75fb9eb7",
                                "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                                "text": "Nous n'aspirons qu'à parler dans l'intégrité de notre parole, donc à désépuiser le langage."
                            },
                            {
                                "example_id": "18b577cd-fef2-440d-aaf3-ad3a60ff8517",
                                "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                                "text": "Tout d'abord parce qu'on ne saurait raviver un épuisement, même s'il est possible de « désépuiser », ou plutôt de « réinvestir » une oeuvre."
                            },
                            {
                                "example_id": "9548835f-6c49-48d4-93ba-0b46b9b13c89",
                                "sense_id": "2a397b46-c690-34b5-b141-a79f7c93c70d",
                                "text": "Enfin puisque j'évoquais « Star Wars X-wing », là aussi la boîte de base épuisée va se désépuiser et on espère pour un certain temps."
                            }
                        ]
                    }
                ],
