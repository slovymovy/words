                                        "entry_id": "9bfb9f5f-98be-326c-b83c-41c94e63fa53",
                                        "glosses": [
                                            "Profanity, especially words derived from Old English."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202e0985-b73e-48da-ba00-7cd151485043",
                                                "sense_id": "a9d0be54-bbfe-3a8c-9dc7-856cdd8b64c7",
                                                "text": "Sometimes these chairmen are authoritarians, who wield the budget-book as a weapon - the junior staff members have some Anglo-Saxon words for them"
                                            },
                                            {
                                                "example_id": "958b0b46-d97d-4135-ae45-cfa087a938ce",
                                                "sense_id": "a9d0be54-bbfe-3a8c-9dc7-856cdd8b64c7",
                                                "text": "I haven't eaten in two days. What's left to puke? You may remark that my vocabulary has taken a turn for the Anglo-Saxon."
                                            },
                                            {
                                                "example_id": "850ff720-4cf5-498b-80fc-7025d87b8210",
                                                "sense_id": "a9d0be54-bbfe-3a8c-9dc7-856cdd8b64c7",
                                                "text": "How fucked up is that? (Pardon my Anglo-Saxon)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Anglo-Saxon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b575933-f3ae-3315-8744-1c0aac698db2",
                                        "entry_id": "ee122024-7fba-3cf1-966f-5c5e90ea5d9d",
                                        "glosses": [
                                            "A member of the Germanic peoples who settled in England during the early fifth century."
                                        ],
