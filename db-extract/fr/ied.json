                                    {
                                        "sense_id": "013be397-294f-38d1-a2fd-7337c6bfb7b7",
                                        "entry_id": "ee59ca04-9009-3c40-93ba-336264f23cb6",
                                        "glosses": [
                                            "Abkürzung von Unkonventionelle Spreng- und Brandvorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2209eb-578b-4724-91c7-4fd7c8198398",
                                                "sense_id": "013be397-294f-38d1-a2fd-7337c6bfb7b7",
                                                "text": "„Sie haben folgende Aufgaben zu erfüllen:[…]• Entschärfen unkonventioneller Spreng- und Brandvorrichtungen (USBV).“"
                                            },
                                            {
                                                "example_id": "67d4be5f-43d1-4417-97c1-13834b7b0bde",
                                                "sense_id": "013be397-294f-38d1-a2fd-7337c6bfb7b7",
                                                "text": "„Zusätzlich wurden 21 Einsätze zur Entschärfung unkonventioneller Spreng- bzw. Brandvorrichtungen (USBV/IED) durchgeführt.“"
                                            },
                                            {
                                                "example_id": "6af736d7-70b2-4010-ac29-ac6ac986726d",
                                                "sense_id": "013be397-294f-38d1-a2fd-7337c6bfb7b7",
                                                "text": "„Blieben also 28 Stunden im Jahr für die allgemeine Fortbildung zum Waffengesetz, zu gefährlichen und verbotenen Gegenständen, zum Erkennen von USBV, Auswertung von Röntgenbildern usw.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
