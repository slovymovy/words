                "senses": [
                    {
                        "sense_id": "65187854-dec9-3511-b08e-3cbf5bdf6a36",
                        "entry_id": "e843fd80-f16b-3533-b89b-c215ae03e4ec",
                        "glosses": [
                            "Verteilung von etwas, bei der die einzelnen Partien unterschiedlich viel besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfdb05a-3287-45c3-ad6e-6fdaac623617",
                                "sense_id": "65187854-dec9-3511-b08e-3cbf5bdf6a36",
                                "text": "„Andererseits gibt es keinerlei Garantie dafür, dass die Ungleichverteilung des Kapitals nicht wieder auf die Rekordwerte steigt, die wir aus der Vergangenheit kennen.“"
                            },
                            {
                                "example_id": "402c1a5c-0920-4b10-98c1-e276b28f4112",
                                "sense_id": "65187854-dec9-3511-b08e-3cbf5bdf6a36",
                                "text": "„Tatsächlich war die Ungleichverteilung grotesk, und es war das größte Versäumnis der Friedensverhandlungen, dieses Problem ausgespart zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
