                    },
                    {
                        "translation_id": "bdde67c9-b693-4b30-8ab3-1f6c455d8cc9",
                        "source_entry_id": "8238ead8-4db4-3cd6-bd9f-7103f6e0c10b",
                        "source_sense_id": "cb60d5d3-ca10-372b-ba1f-16ee82b3f9f1",
                        "target_lang_word": "falerne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "falerne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                        "entry_id": "371c90b7-555c-3bfa-8a02-a70abe3c7cd5",
                                        "glosses": [
                                            "Vin des environs de Falerne en Campanie, qui avait une grande réputation."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b046cb-c731-4ea6-b998-bdecc6dc2c40",
                                                "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                                "text": "Le falerne écumait dans de larges cratères\nCeints de myrtes fleuris."
                                            },
                                            {
                                                "example_id": "3df0a951-57e4-45c9-8b26-fdd3bc82106f",
                                                "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                                "text": "La vertu du vieux Caton,\nChez les Romains tant prônée,\nÉtait souvent, nous dit-on,\nDe falerne enluminée."
                                            },
                                            {
                                                "example_id": "ccd75faf-aa39-4e93-89b4-e7a9b4a00487",
                                                "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                                "text": "Lenglumé.– Moi, d’abord, j’ai le vin tendre… j’ai le falerne tendre !… comme dit Horace… Horatius !…\nMistingue.– Coclès…\nLenglumé.– Non… Flaccus ! Tu dois connaître ça, un prix de vers latins !"
                                            },
                                            {
                                                "example_id": "6f9bd651-89ef-4090-abe6-fc9c83ec35f8",
                                                "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                                "text": "– Sors une bouteille ou deux de falerne, que demain nous viendrons siffler avec toi. On rira."
                                            },
                                            {
                                                "example_id": "06d6ad48-2b8f-490a-b05c-cd46db35713e",
                                                "sense_id": "d1753f15-599f-3777-bd6c-907c33c3ce93",
                                                "text": "A l'orgie latine succédèrent les ébats des Barbares, dignes héritiers de ces Romains gorgés de falerne et de sang, épuisés de stupre, sombrés dans les velléités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fba38806-a81b-4a57-ad51-ca6a0ec10bfb",
