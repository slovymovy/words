                    },
                    {
                        "translation_id": "ae8062d5-c483-4c75-a87b-9136e277427e",
                        "source_entry_id": "9e58282c-46f7-39b2-ae4d-62420f5b2489",
                        "source_sense_id": "445159f2-e543-317c-87a6-e8c8a47a95d4",
