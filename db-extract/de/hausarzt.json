                        ],
                        "form": "die Hausärzte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                        "entry_id": "9bc624e7-e9ac-35a1-b94f-776041c66f01",
                        "glosses": [
                            "Arzt, den man bei gesundheitlichen Beschwerden meist zuerst aufsucht und der gegebenenfalls auch Hausbesuche macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308d6af3-8d8d-4de7-a03f-565a7741ca2b",
                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                "text": "Meist ist der Hausarzt mit der gesundheitlichen Verfassung seiner Patienten am besten vertraut."
                            },
                            {
                                "example_id": "4b7f458b-c0e7-41ce-bfce-e0c3a5c19564",
                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                "text": "„Um neun Uhr tauchte Doktor Aaron auf, der alte Hausarzt, ein Greis von überraschender Beweglichkeit.“"
                            },
                            {
                                "example_id": "9b36ea6e-8a33-4ae1-a768-d265516dee4e",
                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                "text": "„Mit seinem Hausarzt schien er so etwas wie eine Vereinbarung getroffen zu haben.“"
                            },
                            {
                                "example_id": "81ff67e0-ccad-4ec0-a250-164150031b32",
                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                "text": "„Der Hausarzt veranlasste verschiedene Untersuchungen.“"
                            },
                            {
                                "example_id": "7d3b730a-bc84-4484-8666-3375b899f773",
                                "sense_id": "38fa042e-9a11-3d31-88af-b85be1cf39e3",
                                "text": "„Nur mein Hausarzt murrt, denn jedes Mal beim jährlichen Checkup beschimpft er mich als unheilbar gesund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
