                "senses": [
                    {
                        "sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                        "entry_id": "b78dc20d-149f-32f3-87f9-9b32a38720f5",
                        "glosses": [
                            "człowiek biorący łapówki"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2c400c-e97e-4e95-80b7-30eac135612b",
                                "sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                                "text": "Każdego roku prokuratura wychwytuje dziesiątki łapowników najróżniejszego szczebla."
                            },
                            {
                                "example_id": "940936e2-8b93-4305-a245-1cc449a53146",
                                "sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                                "text": "Przez jakiś czas po upadku komunizmu łapownictwo niewątpliwie zmalało, a nawet wyrzucono niektórych szczególnie bezczelnych łapowników w urzędach miejskich i gminnych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8df6f22-e923-44f4-81e4-9689b6735a7c",
                        "source_entry_id": "b78dc20d-149f-32f3-87f9-9b32a38720f5",
                        "source_sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                        "target_lang_word": "grafter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grafter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd36678c-41da-30f0-b45c-0c453d224ae6",
                                        "entry_id": "e31a1062-5361-3fd6-9787-f3aa45b0de2c",
                                        "glosses": [
                                            "One who inserts scions on other stocks, or propagates fruit by engrafting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56764441-81f1-3d40-a713-6a6f37361b5f",
                                        "entry_id": "e31a1062-5361-3fd6-9787-f3aa45b0de2c",
                                        "glosses": [
                                            "An instrument by which grafting is facilitated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "240cc085-2317-3965-97d1-06941b0830d6",
                                        "entry_id": "e31a1062-5361-3fd6-9787-f3aa45b0de2c",
                                        "glosses": [
                                            "The original tree from which a scion has been taken for grafting upon another tree."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b4ece23-4f10-3fb9-ba42-1c8b525d8d70",
                                        "entry_id": "e31a1062-5361-3fd6-9787-f3aa45b0de2c",
                                        "glosses": [
                                            "Someone who works in market stalls."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92230e9c-2204-356b-bcde-c6a4957bd904",
                                        "entry_id": "e31a1062-5361-3fd6-9787-f3aa45b0de2c",
                                        "glosses": [
                                            "a hard worker who puts in long hours"
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grafter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc64972b-f540-3765-9cb4-cf26966f94c9",
                                        "entry_id": "60b15f8e-f4fe-31a5-92f6-412de45ddf12",
                                        "glosses": [
                                            "A corrupt person, one who receives graft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815083cf-4165-447e-998b-dfbe053f33ad",
                                                "sense_id": "bc64972b-f540-3765-9cb4-cf26966f94c9",
                                                "text": "If the people are corrupt; if everybody is a grafter, as our pessimistic friends would have us believe, Roosevelt would be unpopular. His popularity is proof that the people, as a whole, are honest."
                                            },
                                            {
                                                "example_id": "dc857bcc-6f94-4aac-a6c7-d1ad646c6f6a",
                                                "sense_id": "bc64972b-f540-3765-9cb4-cf26966f94c9",
                                                "text": "It is rather confused rhetoric to call a grafter a thief. His crime is not that he filches money from the safe but that he betrays a trust."
                                            },
                                            {
                                                "example_id": "8a0396c5-dfea-47ef-8227-d7b15495d70b",
                                                "sense_id": "bc64972b-f540-3765-9cb4-cf26966f94c9",
                                                "text": "2007, Rebecca Menes, \"Limiting the Reach of the Grabbing Hand: Graft and growth in American Cities, 1880 to 1930\", in Edward L. Glaeser, Claudia Goldin (eds.), Corruption and Reform: Lessons from America's Economic History, National Bureau of Economic Research Conference Report, The University of Chicago Press, →ISBN, page 64.\nRapid city growth rewarded the circumspect grafter with opportunities for what one famous Tammany Hall politician termed “honest graft” […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c943fa8-f716-4646-98da-9a0a86ee0ae6",
                        "source_entry_id": "b78dc20d-149f-32f3-87f9-9b32a38720f5",
                        "source_sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                        "target_lang_word": "concussionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concussionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dae81879-daec-3076-9f16-5cd6098653e0",
                                        "entry_id": "81c126ec-99bc-391e-812c-b6be1d19e3b7",
                                        "glosses": [
                                            "Celui ou celle qui commet des concussions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99f0605-85f9-4c22-ae9a-68f51d08b696",
                                                "sense_id": "dae81879-daec-3076-9f16-5cd6098653e0",
                                                "text": "Le parti adverse est un parti de concussionnaires, d’ennemis du peuple, traîtres à la patrie, vendus à l’ennemi, à quelque parti que tu appartiennes […]"
                                            },
                                            {
                                                "example_id": "ad4d580a-2ad6-4121-9010-f09dbbde2481",
                                                "sense_id": "dae81879-daec-3076-9f16-5cd6098653e0",
                                                "text": "— Un filou, qu’il est, une âme vénale, un concussionnaire, un gredin, il a pillé le Trésor !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "concussionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc49df9-770b-3e18-a5f0-10d6c6e19c51",
                                        "entry_id": "09399636-e003-3c5f-a402-f54b79005686",
                                        "glosses": [
                                            "Qui commet des concussions (par apposition)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63ef4c55-ccbd-42d7-a3c6-634af9aadb1d",
                                                "sense_id": "0dc49df9-770b-3e18-a5f0-10d6c6e19c51",
                                                "text": "Moïse accumulait les ennemis, non seulement parmi la population, mais aussi chez les élites corrompues et concussionnaires."
                                            },
                                            {
                                                "example_id": "2801107a-48f6-4567-8bc3-97e90fdaf05f",
                                                "sense_id": "0dc49df9-770b-3e18-a5f0-10d6c6e19c51",
                                                "text": "Un ministre concussionnaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f093e1a4-9ca8-4128-98f1-540fd0526701",
                        "source_entry_id": "b78dc20d-149f-32f3-87f9-9b32a38720f5",
                        "source_sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
                        "target_lang_word": "exacteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exacteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4bc63a-512d-334e-9853-784f7d99b664",
                                        "entry_id": "a8eaed45-74df-349d-b05d-901de8a107a1",
                                        "glosses": [
                                            "Ancien collecteur d'impôts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a8f3e6-9c41-4b5f-9416-fa56f71d70b0",
                                                "sense_id": "bc4bc63a-512d-334e-9853-784f7d99b664",
                                                "text": "Qu'il était besoin de ces consolations, à la fin du quatrième siècle et au cinquième, quand les barbares du dehors et du dedans, les exacteurs fiscaux, les Ariens, les Donatistes, les Visigoths, les Vandales mettaient l'Empire pourri en pièces, […]."
                                            },
                                            {
                                                "example_id": "03c4fe83-461c-4d03-a992-8ca91354b67b",
                                                "sense_id": "bc4bc63a-512d-334e-9853-784f7d99b664",
                                                "text": "Le granger talonné par son maître, le favetier poursuivi par l’agent du seigneur, le contribuable par l’exacteur, le débiteur par son créancier étaient ainsi amenés à hypothéquer leur patrimoine en totalité ou en partie pour sûreté de la dette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cacf7adb-7628-305e-a98e-f74b4c5166f7",
                                        "entry_id": "a8eaed45-74df-349d-b05d-901de8a107a1",
                                        "glosses": [
                                            "Celui qui commet une exaction, des exactions."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7258ac13-c0f6-4ff6-b424-4c9ceb868404",
                                                "sense_id": "cacf7adb-7628-305e-a98e-f74b4c5166f7",
                                                "text": "Par l’équité, un roi fait prospérer le pays, mais l'exacteur le mène à la ruine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6726d2ee-0c77-4c67-9c0f-3ce1fde331f9",
                        "source_entry_id": "b78dc20d-149f-32f3-87f9-9b32a38720f5",
                        "source_sense_id": "4c9e9080-209b-39d7-a794-6c93f46bb85d",
