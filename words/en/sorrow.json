{
    "word_family": [
        "sorrowful",
        "sorrowfully",
        "sorrowfulness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6cc4304-d6c9-3233-8f4a-67090f2b6003",
                    "sense_definition": "A feeling of deep distress or unhappiness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safe and general antidote against <w>sorrow</w> is employment.",
                            "target_lang_translations": {
                                "ru": "Надежное и универсальное лекарство от <w>горя</w> — это работа.",
                                "de": "Das sichere und allgemeine Gegenmittel gegen <w>Kummer</w> ist Arbeit."
                            }
                        },
                        {
                            "text": "She felt deep <w>sorrow</w> after hearing the bad news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала глубокую <w>печаль</w>, услышав плохие новости.",
                                "de": "Sie empfand tiefe <w>Trauer</w>, nachdem sie die schlechten Nachrichten gehört hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "sadness",
                        "grief",
                        "unhappiness",
                        "misery"
                    ],
                    "common_phrases": [
                        "deep sorrow",
                        "express sorrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокой печали, огорчения или душевной боли.",
                        "de": "Ein Gefühl tiefer Traurigkeit, Betrübnis oder seelischen Schmerzes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "го́ре",
                                "target_lang_sense_clarification": "сильная, глубокая печаль, часто связанная с тяжелой утратой"
                            },
                            {
                                "target_lang_word": "печа́ль",
                                "target_lang_sense_clarification": "спокойное, глубокое переживание грусти"
                            },
                            {
                                "target_lang_word": "тоска́",
                                "target_lang_sense_clarification": "тягостное душевное состояние, сочетающее грусть и тревогу"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trauer",
                                "target_lang_sense_clarification": "tiefe emotionale Reaktion auf einen Verlust oder Schmerz"
                            },
                            {
                                "target_lang_word": "Kummer",
                                "target_lang_sense_clarification": "anhaltendes Gefühl der Niedergeschlagenheit oder Sorge"
                            },
                            {
                                "target_lang_word": "Traurigkeit",
                                "target_lang_sense_clarification": "allgemeiner Zustand des traurig Seins"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39ef67ae-34ca-3fae-ab96-b7c59281eaea",
                    "sense_definition": "An event or situation that causes unhappiness or grief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parting is such sweet <w>sorrow</w>.",
                            "target_lang_translations": {
                                "ru": "Разлука — это такая сладкая <w>печаль</w>.",
                                "de": "Abschiednehmen ist ein so süßer <w>Schmerz</w>."
                            }
                        },
                        {
                            "text": "His sudden departure was a great <w>sorrow</w> to his family.",
                            "target_lang_translations": {
                                "ru": "Его внезапный отъезд стал большим <w>горем</w> для его семьи.",
                                "de": "Sein plötzlicher Abschied war ein großes <w>Leid</w> für seine Familie."
                            }
                        }
                    ],
                    "synonyms": [
                        "misfortune",
                        "affliction",
                        "distress"
                    ],
                    "common_phrases": [
                        "great sorrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или ситуация, вызывающая несчастье или скорбь.",
                        "de": "Ein Ereignis oder eine Situation, die Unglück oder Leid verursacht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "го́ре",
                                "target_lang_sense_clarification": "несчастье, беда, источник глубоких страданий"
                            },
                            {
                                "target_lang_word": "печа́ль",
                                "target_lang_sense_clarification": "причина или источник грусти"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Leid",
                                "target_lang_sense_clarification": "schmerzhafte Erfahrung oder Unglück"
                            },
                            {
                                "target_lang_word": "Kummer",
                                "target_lang_sense_clarification": "Quelle oder Ursache für Sorgen und Betrübnis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54732213-7918-3160-a671-5a3b210887c5",
                    "sense_definition": "To feel or show deep sadness or grief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>sorrow</w> for those who have passed away.",
                            "target_lang_translations": {
                                "ru": "Не <w>скорбите</w> о тех, кто ушел из жизни.",
                                "de": "Man sollte nicht um diejenigen <w>trauern</w>, die von uns gegangen sind."
                            }
                        },
                        {
                            "text": "The <w>sorrowing</w> mother sat alone in the quiet room.",
                            "target_lang_translations": {
                                "ru": "<w>Скорбящая</w> мать сидела одна в тихой комнате.",
                                "de": "Die <w>trauernde</w> Mutter saß allein im stillen Zimmer."
                            }
                        }
                    ],
                    "synonyms": [
                        "grieve",
                        "mourn",
                        "lament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать или выражать глубокую печаль или скорбь.",
                        "de": "Tiefe Traurigkeit oder Leid empfinden oder zeigen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скорбе́ть",
                                "target_lang_sense_clarification": "глубоко переживать, выражать скорбь (часто по умершим)"
                            },
                            {
                                "target_lang_word": "горева́ть",
                                "target_lang_sense_clarification": "предаваться горю, печалиться о чем-либо"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "trauern",
                                "target_lang_sense_clarification": "seelischen Schmerz über einen Verlust ausdrücken"
                            },
                            {
                                "target_lang_word": "bekümmert sein",
                                "target_lang_sense_clarification": "sich in einem Zustand der Sorge oder Trauer befinden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2dab8a4-a66b-374e-87b6-495d693df886",
                    "sense_definition": "To feel regret or sadness about a specific situation or defect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>sorrow</w> his lost opportunities in life.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>сожалеть</w> об упущенных в жизни возможностях.",
                                "de": "Er begann, seine verlorenen Lebenschancen zu <w>bedauern</w>."
                            }
                        },
                        {
                            "text": "It is natural to <w>sorrow</w> a mistake that cannot be fixed.",
                            "target_lang_translations": {
                                "ru": "Естественно <w>горевать</w> об ошибке, которую нельзя исправить.",
                                "de": "Es ist natürlich, einen Fehler zu <w>bedauern</w>, der nicht mehr korrigiert werden kann."
                            }
                        }
                    ],
                    "synonyms": [
                        "regret",
                        "deplore"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать сожаление или грусть по поводу конкретной ситуации или ошибки.",
                        "de": "Bedauern oder Traurigkeit über eine bestimmte Situation oder einen Fehler empfinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сожале́ть",
                                "target_lang_sense_clarification": "испытывать чувство досады или огорчения из-за чего-то"
                            },
                            {
                                "target_lang_word": "горева́ть",
                                "target_lang_sense_clarification": "печалиться о чем-то неисправимом"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bedauern",
                                "target_lang_sense_clarification": "Reue oder Mitleid bezüglich einer Sache empfinden"
                            },
                            {
                                "target_lang_word": "sich grämen",
                                "target_lang_sense_clarification": "sich wegen etwas Unabänderlichem quälen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a010c44-ad4c-3a0c-9f2b-b257f130a632",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Sorrow</w> attended the meeting this morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Сорроу</w> присутствовал на собрании сегодня утром.",
                                "de": "Herr <w>Sorrow</w> nahm heute Morgen an der Sitzung teil."
                            }
                        },
                        {
                            "text": "The research was conducted by Dr. <w>Sorrow</w>.",
                            "target_lang_translations": {
                                "ru": "Исследование было проведено доктором <w>Сорроу</w>.",
                                "de": "Die Forschung wurde von Dr. <w>Sorrow</w> durchgeführt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сорроу",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sorrow",
                                "target_lang_sense_clarification": "Eigenname (Familienname)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}