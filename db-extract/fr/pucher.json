                        "entry_id": "e673a2e6-06e5-36f1-b1bb-1fc325d93450",
                        "glosses": [
                            "Puiser avec le pucheux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "11ba8a28-0e9c-45b4-8d7b-1ce5f38e83a2",
                                "sense_id": "c8bcfa3c-f1f8-3adc-ad1c-0b09328fec97",
                                "text": "On avait une belle mare au bout du jardin. Là, on « puchait » un petit peu d’eau. On arrosait un peu tout, les carottes, les choux, les haricots."
                            },
                            {
                                "example_id": "b3ac7f7c-f829-4053-927b-d819b02abb66",
                                "sense_id": "c8bcfa3c-f1f8-3adc-ad1c-0b09328fec97",
                                "text": "Elle demeurait près de la buse de la Saâne où elle puchait l'eau nécessaire à la lessive."
                            }
                        ]
                    }
