                        "examples": [
                            {
                                "example_id": "b714aa43-8af4-40ff-adf7-6dccf311c000",
                                "sense_id": "f666e79d-2a45-3c31-8cd2-243766edf68d",
                                "text": "13 / VI–43 Мой расчёт не оправдался, план рухнул, антреприза потерпела крах."
