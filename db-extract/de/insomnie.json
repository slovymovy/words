                        "entry_id": "69c0e9f8-958f-3f5f-bec2-f43259e4871e",
                        "glosses": [
                            "Schlaflosigkeit, welche über einen längeren Zeitraum anhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0d86321-67b5-408c-a9eb-d1c9f4d91b60",
                                "sense_id": "4f95fd40-246a-306c-a261-63ffcdf77deb",
                                "text": "„Wer an Insomnie leidet, hat Probleme mit dem Einschlafen, wacht nachts häufig auf und schläft insgesamt zu wenig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
