                "senses": [
                    {
                        "sense_id": "422337ae-07d8-38ee-9046-95aad3f55270",
                        "entry_id": "687c34eb-5c04-3471-ba72-cf8ecd987583",
                        "glosses": [
                            "Vérifier de façon extrêmement poussée, à plusieurs reprises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb5daed0-e7ab-46ea-9dfc-bfcbba05a089",
                                "sense_id": "422337ae-07d8-38ee-9046-95aad3f55270",
                                "text": "La météo est vérifiée, archi-vérifiée."
                            },
                            {
                                "example_id": "762e5e19-c4c6-44bd-a240-abd5caf6001d",
                                "sense_id": "422337ae-07d8-38ee-9046-95aad3f55270",
                                "text": "Avant d'y de mettre les composants sur leurs supports, je vous conseille de vérifier, archi-vérifier la continuité de toutes les pistes et l'absence absolue de court-circuit sur la plaque."
                            },
                            {
                                "example_id": "ce93a8bd-26f4-4c3e-8a97-0afb65ec2d14",
                                "sense_id": "422337ae-07d8-38ee-9046-95aad3f55270",
                                "text": "Et comment vas-tu faire pour la vider et la revider afin de vérifier, re-vérifier, archi-vérifier que tu n'as pas oublié tes moufles et ton bonnet ?"
                            }
                        ]
                    }
