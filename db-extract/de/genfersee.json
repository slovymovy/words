                            {
                                "example_id": "d02385da-df93-4bbb-a9f9-57d5469de18b",
                                "sense_id": "d4ad59a3-5731-3ca2-8616-31f8872ed21e",
                                "text": "Der Genfersee ist an der tiefsten Stelle 310 m tief."
                            },
                            {
                                "example_id": "8ca636c6-1e2e-4503-8558-e0f2fd0241ac",
                                "sense_id": "d4ad59a3-5731-3ca2-8616-31f8872ed21e",
                                "text": "Unseren letzten Urlaub verbrachten wir am Genfersee."
                            },
                            {
                                "example_id": "6fc49001-4473-496a-b9da-44f2c925c779",
                                "sense_id": "d4ad59a3-5731-3ca2-8616-31f8872ed21e",
                                "text": "Der Genfersee liegt in der Schweiz und in Frankreich."
                            },
                            {
                                "example_id": "7c450971-8b7c-427d-bf96-09ba96f692bd",
                                "sense_id": "d4ad59a3-5731-3ca2-8616-31f8872ed21e",
                                "text": "Das Lagerfeuer am Genfersee erlosch erst am frühen Morgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
