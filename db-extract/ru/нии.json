                                            {
                                                "example_id": "953de8d4-cc5f-42e2-a272-554f90c3c4ee",
                                                "sense_id": "6c9541b3-8de8-3979-ad21-caaf7a4d5d53",
                                                "text": "There is also in these matters of Science (though many scientific men would doubtless deny this) a great deal of \"Fashion\"."
                                            },
                                            {
                                                "example_id": "660e9004-68ad-4760-a8d5-70ed67f50d29",
                                                "sense_id": "6c9541b3-8de8-3979-ad21-caaf7a4d5d53",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d4b620-3aef-3d0b-9f69-b37e37fc1c60",
                                        "entry_id": "fb74352a-bd70-3642-85e8-85416c8d8876",
                                        "glosses": [
                                            "Related or connected to science:",
                                            "Derived from or consistent with the scientific method."
                                        ],
