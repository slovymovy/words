                "senses": [
                    {
                        "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                        "entry_id": "38e18d51-b742-3bac-9d6e-9a80ee2760ec",
                        "glosses": [
                            "thieves'; thievish"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "23d52668-186b-441e-ab41-2797f129a3a6",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "воровско́й зако́н",
                                "translation": "the law of the underworld",
                                "english": "the law of the underworld"
                            },
                            {
                                "example_id": "28a8c480-0125-44d5-a4f2-bc0538a83c2f",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "воровско́й жарго́н",
                                "translation": "thieves' cant/patter",
                                "english": "thieves' cant/patter"
                            },
                            {
                                "example_id": "25be1f09-431c-48a5-8a9e-f9c07bcdf04b",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "воровско́й прито́н",
                                "translation": "den of thieves",
                                "english": "den of thieves"
                            },
                            {
                                "example_id": "c53cb585-65dc-404b-a750-85f30b246a4d",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "воровски́е приёмы",
                                "translation": "thievish methods",
                                "english": "thievish methods"
                            },
                            {
                                "example_id": "fcc2b4d7-e38c-45ec-9c4a-1de339e66896",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "воровски́м мане́ром",
                                "translation": "like a thief; thievishly",
                                "english": "like a thief; thievishly"
                            },
                            {
                                "example_id": "6ce0765c-0dff-4748-ac13-68e3234c0228",
                                "sense_id": "7a3513cc-1d27-3043-b30d-8b6df5226fa1",
                                "text": "Суп и ря́бчик осты́ли. И почему́-то тепе́рь вся э́та рестора́нная ро́скошь, бы́вшая на столе́, показа́лась мне ску́дною, воровско́ю, похо́жею на По́лю.",
                                "translation": "The soup and the grouse got cold. And for some reason all the restaurant dainties on the table struck me as poor, thievish, like Polya.",
                                "english": "The soup and the grouse got cold. And for some reason all the restaurant dainties on the table struck me as poor, thievish, like Polya."
                            }
                        ]
