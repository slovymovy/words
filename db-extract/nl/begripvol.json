                    {
                        "sense_id": "338e0eb6-7ea4-36d1-af58-71b2b92845a7",
                        "entry_id": "cb4a214e-dfe8-3664-9abc-0a2ff583c886",
                        "glosses": [
                            "met veel begrip; met veel inlevingsvermogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe5b093e-f21a-4551-a408-795e368192be",
                                "sense_id": "338e0eb6-7ea4-36d1-af58-71b2b92845a7",
                                "text": "De begripvolle docente hield rekening met alle redenen die de leerlingen aangaven waarom ze hun huiswerk niet gemaakt hadden."
                            },
                            {
                                "example_id": "70b3b7e9-1d62-4336-af8b-20658aac7f47",
                                "sense_id": "338e0eb6-7ea4-36d1-af58-71b2b92845a7",
                                "text": "Hierna knikte hij begripvol tegen zijn vrouw, die hem vanuit de deuropening duidelijk maakte dat ze op het punt stond om naar bed te gaan."
                            },
                            {
                                "example_id": "dd8213fa-4249-4561-ac26-cf06a8d15307",
                                "sense_id": "338e0eb6-7ea4-36d1-af58-71b2b92845a7",
                                "text": "En zij, streng maar begripvol: 'U had het niet beter kunnen doen. In naam van het land en de koning, handhaaf de orde en stop dat communistische tuig!' Driss stond op en ging voor het meisje staan. Ze keek niet op, maar Slaoui zag dat ze rilde."
                            }
                        ]
                    }
