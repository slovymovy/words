                                        "sense_id": "7fbd97d7-c708-3e26-99a8-be7e3877f21e",
                                        "entry_id": "293d97c6-47d0-3a2c-b033-d51733a5e44b",
                                        "glosses": [
                                            "A rapper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9d4025f-9b09-4e27-ba1c-5a3c0eb0b435",
                        "source_entry_id": "7792a5a1-581a-3e71-9ce7-24c6bd2d82f8",
                        "source_sense_id": "73128250-8976-38b5-be55-a3e63d523856",
                        "source_sense_description": "Person, die bestimmend und verantwortlich auf die Abläufe eines Spielgeschehens einwirkt",
                        "target_lang_word": "emcee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emcee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40214c0c-043b-3989-9cdb-d95a63c637d1",
                                        "entry_id": "2261b9aa-edfc-349b-ad9e-98b52a260064",
                                        "glosses": [
                                            "Alternative form of MC in its senses as",
                                            "Master of ceremonies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b72622-1e41-4614-a27a-81d7b19e7c78",
                                                "sense_id": "40214c0c-043b-3989-9cdb-d95a63c637d1",
                                                "text": "\"I'm the emcee for tonight,\" he proclaimed. \"I'll announce your program.\""
                                            },
                                            {
                                                "example_id": "667140e1-b6a8-4d5a-bb12-59942c2a584a",
                                                "sense_id": "40214c0c-043b-3989-9cdb-d95a63c637d1",
                                                "text": "The emcee of the event, Ed Bejarana, called Borrenpohl a \"little girl,\" at the town hall, saying: \"This little girl does not want to leave. She spoke up and now does not want to suffer the consequences.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b2f52d-fda5-3543-ac2d-05bc7e8892f3",
                                        "entry_id": "2261b9aa-edfc-349b-ad9e-98b52a260064",
                                        "glosses": [
                                            "Alternative form of MC in its senses as",
                                            "A rapper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b0cc87-73ac-4e67-afdb-80b372da3c89",
                                                "sense_id": "b3b2f52d-fda5-3543-ac2d-05bc7e8892f3",
                                                "text": "[…] mutating into all-star line-ups of emcees spitting hot bars over familiar beats, then to a single crew spitting bars over familiar beats, then eventually to a single crew (or artist) spitting bars over unfamiliar beats."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
