                "senses": [
                    {
                        "sense_id": "039ebcf8-aa66-3c06-a3f9-8c062717a04c",
                        "entry_id": "5363b318-e786-3a7c-966d-9131b7902b28",
                        "glosses": [
                            "Herrschaftsgebiet der Daker, das von der Donau, dem Dnister und dem Schwarzen Meer begrenzt wurde"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c4b6216d-770c-4ca2-9f6d-2efe55cc1321",
                                "sense_id": "039ebcf8-aa66-3c06-a3f9-8c062717a04c",
                                "text": "„Die Finanzierung dieses riesigen Aufbauprogramms verband Trajan mit dem Ausweis einer weiteren Tugend, der virtus (Mannhaftigkeit). Die konnte ein Kaiser am besten durch siegreiche Feldzüge demonstrieren. In Dakien (dem heutigen Rumänien) eröffnete sich ein ideales Feld dafür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d2fb74fc-e5a1-32e6-80fa-9d46ec14cf31",
                        "entry_id": "5363b318-e786-3a7c-966d-9131b7902b28",
                        "glosses": [
                            "römische Provinz"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "326401ee-1cf3-469e-b690-ecd388b0c2d4",
                                "sense_id": "d2fb74fc-e5a1-32e6-80fa-9d46ec14cf31",
                                "text": "„Der Bruder ist dabei weder heilig noch eilig, sondern gehört in die Riege der billigen Jakobs und ist nach der ehemaligen römischen Provinz Dakien benannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
