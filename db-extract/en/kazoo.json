                "senses": [
                    {
                        "sense_id": "87441735-c99d-3a4b-81bd-622b8ae36eb4",
                        "entry_id": "c53d1d53-b8fd-3afd-9540-0e2ef3135e04",
                        "glosses": [
                            "A simple musical instrument (a membranophone) consisting of a pipe with a hole in it, producing a buzzing sound when the player hums into it."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feee33c6-6b8a-44ce-bede-e9d21d756c07",
                        "source_entry_id": "c53d1d53-b8fd-3afd-9540-0e2ef3135e04",
                        "source_sense_id": "87441735-c99d-3a4b-81bd-622b8ae36eb4",
                        "source_sense_description": "a simple musical instrument consisting of a pipe with a hole in it",
                        "target_lang_word": "kazoo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazoo",
