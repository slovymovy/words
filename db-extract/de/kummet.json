                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6930a5cd-82e5-3f4f-a477-2545c2dd3700",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Ornement, bijou qui fait le tour du cou."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bd2b24e-0261-3176-a2cf-e058c0480b06",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Ornement, bijou qui fait le tour du cou.",
                                            "Rangée de perles ou de pierres précieuses que les femmes portent au cou pour se parer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dfcb0c-dc1a-47b4-93c7-15a9aee1b682",
                                                "sense_id": "8bd2b24e-0261-3176-a2cf-e058c0480b06",
                                                "text": "Des Soudanais vendent des porte-cigarettes en ivoire, des colliers pour les femmes, des fouets de cuir."
                                            },
                                            {
                                                "example_id": "8718b833-a7f8-4728-8eec-3e740eba6152",
                                                "sense_id": "8bd2b24e-0261-3176-a2cf-e058c0480b06",
                                                "text": "Enfiler un collier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c1c1e6-387f-34cc-9fa6-6e4eaf4e69a6",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Ornement, bijou qui fait le tour du cou.",
                                            "Chaîne d’or que portent les chevaliers à laquelle est suspendu le signe de leur ordre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c3a2ca9-d5b5-41eb-b404-9c9243585d15",
                                                "sense_id": "b6c1c1e6-387f-34cc-9fa6-6e4eaf4e69a6",
                                                "text": "Le collier de l’ordre de la Toison d’or. On dit également, par ellipse,"
                                            },
                                            {
                                                "example_id": "defbb778-1752-4349-b4f0-f1d62ddfb237",
                                                "sense_id": "b6c1c1e6-387f-34cc-9fa6-6e4eaf4e69a6",
                                                "text": "Le collier de la Toison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06cdc8e-34c8-3ee4-bf02-6c4383279bdd",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Cercle de cuir, de métal, etc., que l’on met autour du cou de quelques animaux."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "205eebe3-974e-4822-b339-6e034b01cd41",
                                                "sense_id": "b06cdc8e-34c8-3ee4-bf02-6c4383279bdd",
                                                "text": "La reine mère se leva, prit la petite chienne par son collier et la retint."
                                            },
                                            {
                                                "example_id": "df358d57-aa96-4896-bac3-e77a8dc5aa7d",
                                                "sense_id": "b06cdc8e-34c8-3ee4-bf02-6c4383279bdd",
                                                "text": "Le berger regagna paisiblement les bords de la Nied, s’assit à l’ombre d’un pommier, et se mit à raccommoder le collier à clous de son chien de garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c79ae7c-8e6d-3ebd-a4f0-9f2c68cb99db",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Marque naturelle en forme de cercle, qui se voit quelquefois autour du cou des quadrupèdes, des oiseaux, et qui est différente par sa couleur du reste de leur poil ou de leur plumage."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7750fa03-bfec-46d4-8ac0-33b79256e05d",
                                                "sense_id": "6c79ae7c-8e6d-3ebd-a4f0-9f2c68cb99db",
                                                "text": "Un chien noir qui a un collier blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "708cf96d-5868-3adc-b35f-8a90e306b53d",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Partie du harnais des chevaux d’attelage qui est faite de bois ou de cuir et rembourrée et à laquelle les traits sont attachés."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3c497c-d7b2-4db2-9ef3-cb1cf89377ee",
                                                "sense_id": "708cf96d-5868-3adc-b35f-8a90e306b53d",
                                                "text": "Sur toutes les routes qui sillonnaient le pays et se dirigeaient vers ce grand centre comme les rayons d’une roue au même sommet, on entendait tinter des colliers de chevaux, rouler des chariots lourds, claquer des fouets et retentir des voix brutales. C’était la vilaine limite où l’on commence, par la laideur de la banlieue, à entrer dans l’activité du tourbillon de Paris."
                                            },
                                            {
                                                "example_id": "e563bbdc-5db0-4842-aed9-8001eff706ea",
                                                "sense_id": "708cf96d-5868-3adc-b35f-8a90e306b53d",
                                                "text": "D’après M. Gourdon les bœufs du Midi qui travaillent au joug ont les muscles du cou bien plus développés que les grands animaux du Nord qui font leur service au collier."
                                            },
                                            {
                                                "example_id": "3813527f-3832-4231-ab66-c44183d2a737",
                                                "sense_id": "708cf96d-5868-3adc-b35f-8a90e306b53d",
                                                "text": "Le collier est le meilleur harnais, particulièrement bien adapté aux équidés. Il est constitué d’une armature pour son adaptation sur l’animal, d’un rembourrage pour le confort et la protection et d’un dispositif d’attelage pour l’outil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f66229b-f0bb-3f07-b287-7283715f3276",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Cheval de collier ; cheval propre à tirer."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac38013b-0a4b-303e-a397-cff2a8a8a0b5",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Travail pénible et routinier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "337cca77-1ed4-4453-9bc5-7e22e90e51a4",
                                                "sense_id": "ac38013b-0a4b-303e-a397-cff2a8a8a0b5",
                                                "text": "– Moi, que veux-tu ? l’idée d’un collier quelconque me fait horreur. Je deviens stupide, dès qu’il s’agit d’un examen, d’un concours."
                                            },
                                            {
                                                "example_id": "af6ebc89-0469-4df8-be8e-f8099782f39f",
                                                "sense_id": "ac38013b-0a4b-303e-a397-cff2a8a8a0b5",
                                                "text": "Depuis l’âge de douze ans, il était une bête de somme. Rien de plus qu’une bête qui travaille pour sa nourriture. Il avait commencé avec son père, et, depuis, il n’avait jamais lâché le collier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b75acc1-b2f5-3d60-a951-70bd171b2c5d",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Astragale taillé en perles, en olives qui entoure le fût d’une colonne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba0eec07-64ac-3403-9d61-f1e9a0f07c5e",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Partie du cou du bœuf qui reste attachée aux épaules quand on détache la tête."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c60d51e-9412-41ef-9578-fcf047a21ff5",
                                                "sense_id": "ba0eec07-64ac-3403-9d61-f1e9a0f07c5e",
                                                "text": "Je tendais la main ; elle [une vache] avançait le museau. Ou si, m’enhardissant, je lui grattais le long pli de chair du collier, elle allongeait démesurément la tête, clignait les yeux, laissait un file et salive couler sur mon bras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dec708f-63f6-3eec-9aad-994945c8c500",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Barbe allant d’une tempe à l’autre en passant par le menton."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf4c6ed-4f28-42df-a9f3-413190f127b1",
                                                "sense_id": "3dec708f-63f6-3eec-9aad-994945c8c500",
                                                "text": "La tenue idéale pour un auto-stoppeur est le short blanc bien repassé, […]. La barbe, le collier et les moustaches ne bénéficient pas d’un préjugé favorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dab4fe4-6b43-35b7-b931-5b7cd6b790ad",
                                        "entry_id": "f0b658e0-5e51-3917-a962-73256e09e90c",
                                        "glosses": [
                                            "Ensemble constitué des écouteurs, du microphone et des câbles portés autour du cou par les téléphonistes."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6140e7a-6850-4b25-bfe3-e9333e12b45f",
                                                "sense_id": "3dab4fe4-6b43-35b7-b931-5b7cd6b790ad",
                                                "text": "Il faut que je reprenne le collier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
