                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8096b9b-f0dd-4ba0-b13a-bc798c4bc761",
                                "sense_id": "0f680337-18e2-3a9f-a929-9bdc0bc5d96d",
                                "text": "„Für die Probenentnahme braucht sie ein Fass mit flüssigem Stickstoff, Latexhandschuhe, Pinzette, Skalpell.“"
                            },
                            {
                                "example_id": "c8c08222-8441-40ba-8ee2-126dd8c2331c",
                                "sense_id": "0f680337-18e2-3a9f-a929-9bdc0bc5d96d",
                                "text": "„Bei der Tat trug K. eine Wolfsmaske und weiße Latexhandschuhe.“"
                            },
                            {
                                "example_id": "d301965d-ce90-489a-aadd-c2deb26117dc",
                                "sense_id": "0f680337-18e2-3a9f-a929-9bdc0bc5d96d",
                                "text": "„Sie streiften sich Latexhandschuhe über und machten sich an die Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
