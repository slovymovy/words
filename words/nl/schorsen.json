    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d3b4b0a-c4e9-3582-aea5-cd43347a0a3b",
                    "sense_definition": "een officiële bijeenkomst of procedure tijdelijk onderbreken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onderbreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voorzitter besloot de zitting te <w>schorsen</w> voor een korte pauze.",
                            "target_lang_translations": {
                                "en": "The chairman decided to <w>adjourn</w> the session for a short break."
                            }
                        },
                        {
                            "text": "Het beraad is <w>geschorst</w> tot woensdagmiddag uit piëteit voor de familie.",
                            "target_lang_translations": {
                                "en": "The deliberations have been <w>suspended</w> until Wednesday afternoon out of respect for the family."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderbreken",
                        "opschorten",
                        "verdagen"
                    ],
                    "antonyms": [
                        "hervatten",
                        "voortzetten"
                    ],
                    "common_phrases": [
                        "de zitting schorsen",
                        "de vergadering schorsen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in een formele of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily interrupt or adjourn an official meeting or procedure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adjourn",
                                "target_lang_sense_clarification": "of a meeting or session"
                            },
                            {
                                "target_lang_word": "suspend",
                                "target_lang_sense_clarification": "to temporarily stop a process"
                            },
                            {
                                "target_lang_word": "recess",
                                "target_lang_sense_clarification": "to take a break during a session"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e84ec31a-0db4-3b4e-a708-24d065f04543",
                    "sense_definition": "iemand tijdelijk uit een functie of lidmaatschap ontzetten als strafmaatregel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachten worden ambtshalve <w>geschorst</w> in afwachting van het onderzoek.",
                            "target_lang_translations": {
                                "en": "The suspects are <w>suspended</w> from office pending the investigation."
                            }
                        },
                        {
                            "text": "De voetballer werd voor drie wedstrijden <w>geschorst</w> na een zware overtreding.",
                            "target_lang_translations": {
                                "en": "The football player was <w>suspended</w> for three matches after a serious foul."
                            }
                        }
                    ],
                    "antonyms": [
                        "aanstellen",
                        "toelaten"
                    ],
                    "common_phrases": [
                        "iemand ambtshalve schorsen",
                        "voor onbepaalde tijd schorsen"
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily remove someone from a position, job, or membership as a disciplinary measure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspend",
                                "target_lang_sense_clarification": "from a job, school, or sports"
                            },
                            {
                                "target_lang_word": "debar",
                                "target_lang_sense_clarification": "to exclude from a right or privilege"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10a9fd9-098a-33e9-b4da-c7e6272ec668",
                    "sense_definition": "de bast of schors van een boom verwijderen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bewerken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De houthakkers moesten de boomstammen eerst <w>schorsen</w> voordat ze verwerkt konden worden.",
                            "target_lang_translations": {
                                "en": "The loggers first had to <w>debark</w> the tree trunks before they could be processed."
                            }
                        },
                        {
                            "text": "Het is een zwaar karwei om al deze eikenbalken handmatig te <w>schorsen</w>.",
                            "target_lang_translations": {
                                "en": "It is a tough job to <w>bark</w> all these oak beams by hand."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontschorsen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "minder gebruikelijk dan ontschorsen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To remove the bark from a tree or log."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bark",
                                "target_lang_sense_clarification": "to strip the outer layer of a tree"
                            },
                            {
                                "target_lang_word": "debark",
                                "target_lang_sense_clarification": "to remove bark from wood"
                            },
                            {
                                "target_lang_word": "peel",
                                "target_lang_sense_clarification": "to strip off the outer skin or bark"
                            }
                        ]
                    }
                }
            ]
        },
        {
