                                "target_senses": [
                                    {
                                        "sense_id": "647f9c14-3524-3260-acd0-d7c31e5c7bd2",
                                        "entry_id": "39b14139-556c-3c90-b833-27150473fdb7",
                                        "glosses": [
                                            "A clear, colorless, highly flammable liquid with a low boiling point and chemical formula CH₃-CH₂-O-CH₂-CH₃. Used as a solvent and in the past as a general anesthetic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb0cdcb-2a82-459a-a4f7-3afc7327daba",
                                                "sense_id": "647f9c14-3524-3260-acd0-d7c31e5c7bd2",
                                                "text": "Volatiles of kecap manis and its raw materials were extracted using Likens-Nickerson apparatus with diethyl ether as the extraction solvent. The extracts were then dried with anhydrous sodium sulfate, concentrated using a rotary evaporator followed by flushing using nitrogen until the volume was about 0.5 ml."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a0c22c-4df1-4ef0-9e65-b4737853298b",
                        "source_entry_id": "273f32fe-a998-3516-91b1-0d6bf5831896",
                        "source_sense_id": "64abe1de-c882-3b69-b47c-b3a0d3b65ded",
                        "source_sense_description": "Ether mit der Strukturformel C₂H₅-O-C₂H₅",
                        "target_lang_word": "éther diéthylique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éther diéthylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f7f848-758a-3687-abc5-a5619f100d55",
                                        "entry_id": "8c017481-f5ec-3191-9880-ac3259fb2a21",
                                        "glosses": [
                                            "Substance chimique incolore, très inflammable et volatile, utilisée comme solvant et comme anesthésique général en biologie (et autrefois en médecine)."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab138341-5a52-47c4-ba2e-7cc4415935bd",
                                                "sense_id": "d6f7f848-758a-3687-abc5-a5619f100d55",
                                                "text": "Rincer la fiole et la pierre ponce plusieurs fois avec de l’éther diéthylique (100 ml en tout) et verser l'eau de lavage dans l'ampoule à décanter. Boucher et secouer vigoureusement."
                                            }
                                        ]
