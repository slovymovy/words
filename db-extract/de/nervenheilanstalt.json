                                    {
                                        "sense_id": "66e748c7-5234-336a-925f-26641906ed8d",
                                        "entry_id": "aaf0425a-732f-3b19-995d-8682713d0937",
                                        "glosses": [
                                            "Établissement qui regroupe plusieurs professionnels de la santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fddfb03-47b8-4219-89b8-3bcc2aeb52f2",
                                                "sense_id": "66e748c7-5234-336a-925f-26641906ed8d",
                                                "text": "La maison de santé de Chamberet peine à trouver un médecin généraliste supplémentaire et un dentiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9143689-29f7-47d6-8d34-feff9caad281",
                        "source_entry_id": "3872c3cc-f0d2-3c38-a60a-5ed5ddccbeec",
                        "source_sense_id": "a342e1a4-4e56-35af-b542-168d5450f226",
                        "source_sense_description": "veraltet: Einrichtung, in der versucht wird, psychische Krankheiten zu heilen; Psychiatrie",
                        "target_lang_word": "santé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "santé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                        "entry_id": "44be324c-3eaa-3afa-ad10-c40ec7ed97e0",
                                        "glosses": [
                                            "État sain de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ecdd1e7-853f-4ef8-ac72-03095f502e07",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "Impossible de voir deux plus belles santés que celles de ces honnêtes gentlemen ; impossible aussi de rencontrer deux physionomies plus candides."
                                            },
                                            {
                                                "example_id": "7773fece-3ba4-409b-976a-90b5baf52640",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "Ils se plaisaient à simuler leurs maux passés, pour en rappeler l’image à tous les yeux et mieux jouir de la santé présente."
                                            },
                                            {
                                                "example_id": "f2857ab7-4720-427f-9ea4-5eddaec13eb3",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "[], mais on peut aussi être tout à la fois très riche et très malheureux, car l'argent ne donne ni la santé, ni le contentement de soi-même, et il ne préserve pas de l'ennui, cette plaie des oisifs opulents."
                                            },
                                            {
                                                "example_id": "04426724-7503-467f-9186-5c1df810a613",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "Le Danemark, avec le souci le plus louable de la santé physique et morale de ses sujets, interdit absolument l’importation de l’alcool au Groenland."
                                            },
                                            {
                                                "example_id": "d1b443ec-2c16-4361-a3e5-b41efaf8b5d9",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "— Elle n’a pas de santé… Elle s’est évanouie pendant la messe et on a dû la transporter à la sacristie…"
                                            },
                                            {
                                                "example_id": "4332bdbc-01d4-4edc-8767-73b65acfb31a",
                                                "sense_id": "0698c32a-2bb2-3fca-b8a3-e9572cda7623",
                                                "text": "Selon l’OMS, « la santé est un état de complet bien-être physique, mental et social, et ne consiste pas seulement en une absence de maladie »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bddbbd49-a5f2-39b6-a389-fd22c841dc25",
                                        "entry_id": "44be324c-3eaa-3afa-ad10-c40ec7ed97e0",
                                        "glosses": [
                                            "Bon état du moral, de la raison."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "484c5411-8e90-43e9-abbf-aa3ba4951a19",
                                                "sense_id": "bddbbd49-a5f2-39b6-a389-fd22c841dc25",
                                                "text": "La gauche « qui ne sait plus ce qu’elle veut » ne se contente plus de se taire, mais prend l’habitude de faire sien le grand discours de régression d’une droite dont elle envie la bonne santé, d’une droite à l’entrain réactionnaire communicatif."
                                            },
                                            {
                                                "example_id": "785589b3-a0b3-431e-b3b2-f58902868f51",
                                                "sense_id": "bddbbd49-a5f2-39b6-a389-fd22c841dc25",
                                                "text": "La santé de l’esprit. La santé de l’âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a58aa6-7396-39f7-a7e6-1aa75f9c24c8",
                                        "entry_id": "44be324c-3eaa-3afa-ad10-c40ec7ed97e0",
                                        "glosses": [
                                            "État de l’organisme, bon ou mauvais ; manière dont on se porte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7565fbda-66d8-4279-9be1-999a155d1919",
                                                "sense_id": "a8a58aa6-7396-39f7-a7e6-1aa75f9c24c8",
                                                "text": "Il s’était exempté de voisiner, en prétextant de ses occupations, de ses habitudes et de sa santé, qui ne lui permettaient pas, disait-il, de revenir la nuit par une route le long de laquelle brouillassait la Thune."
                                            },
                                            {
                                                "example_id": "1ac86b22-b4b6-47d0-976d-db0d531f0cbe",
                                                "sense_id": "a8a58aa6-7396-39f7-a7e6-1aa75f9c24c8",
                                                "text": "Sa santé ne lui permet pas d’habiter Paris. Son état de santé l’oblige à se reposer. Bulletin de santé."
                                            },
                                            {
                                                "example_id": "1d8345a6-1a14-4661-8492-76df0999e972",
                                                "sense_id": "a8a58aa6-7396-39f7-a7e6-1aa75f9c24c8",
                                                "text": "Elle n’était pas jolie. Blanche, rose, l’oreille petite, le cheveu fin, mais trop de joues, trop de santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b0b79f-6f6c-3e56-981a-e1fc92a6182d",
                                        "entry_id": "44be324c-3eaa-3afa-ad10-c40ec7ed97e0",
                                        "glosses": [
                                            "Verre bu en souhaitant à quelqu’un d’être en bonne santé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c52e5c2-9c07-46a1-9b12-f30b873df36d",
                                                "sense_id": "f3b0b79f-6f6c-3e56-981a-e1fc92a6182d",
                                                "text": "Hourra pour l’Ange-Gardien ! et pour ses habitants ! cria le général en élevant son verre et en le vidant d’un seul trait… […] Voilà de bon vin, Moutier. Ça fait plaisir de boire des santés avec un vin comme ça !"
                                            },
                                            {
                                                "example_id": "b21a7a46-3c6d-466b-8b54-bbba80468fc9",
                                                "sense_id": "f3b0b79f-6f6c-3e56-981a-e1fc92a6182d",
                                                "text": "Le maître-d’école fit même un joli discours en réponse à cette santé, et chacun fit honneur aux mets appétissants préparés par madame Montépel, qui avait la réputation d’être la meilleure « fricoteuse » des environs."
                                            },
                                            {
                                                "example_id": "00f2617c-7ebf-464b-bfcc-6ea5fa019738",
                                                "sense_id": "f3b0b79f-6f6c-3e56-981a-e1fc92a6182d",
                                                "text": "On le voyait à tous les repas de funérailles où l’on a besoin de quelqu’un pour porter les santés et stimuler la gaieté générale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7b845aa-617c-35bc-9abb-99fbdc9ef782",
                                        "entry_id": "44be324c-3eaa-3afa-ad10-c40ec7ed97e0",
                                        "glosses": [
                                            "Lieu où l’on retient en quarantaine, après leur débarquement, les voyageurs arrivant d’un pays où règne une maladie épidémique ou contagieuse."
                                        ],
                                        "tags": [
                                            "Dans les ports de mer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b889395f-0bd2-4977-b213-7b162ef3781c",
                                                "sense_id": "d7b845aa-617c-35bc-9abb-99fbdc9ef782",
                                                "text": "Vers les quatre heures, nous étions en vue de Gibraltar, attendant que la santé (c’est ainsi que l’on appelle les agents du lazaret) voulût bien venir prendre nos papiers avec des pincettes, et voir si d’aventure nous n’apportions pas dans nos poches quelque fièvre jaune, quelque choléra bleu, ou quelque peste noire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "santé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd3ea7d-4575-3020-8431-31e79a1d985a",
                                        "entry_id": "5b8a1f8a-ebcc-36af-b30f-e000cf75d7cc",
                                        "glosses": [
                                            "Se dit au moment de trinquer lorsque l’on porte un toast."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44222010-03ca-3d95-a76a-7ef8771ea2e3",
                                        "entry_id": "5b8a1f8a-ebcc-36af-b30f-e000cf75d7cc",
                                        "glosses": [
                                            "Formule de politesse que l’on adresse à une personne qui vient d’éternuer."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
