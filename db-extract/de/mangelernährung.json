                    {
                        "form_id": "9126a500-7887-4051-8939-31f5e5c2bd89",
                        "entry_id": "8bc0e347-5cf6-3f21-8128-6ecf8087957f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Mangelernährung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                        "entry_id": "8bc0e347-5cf6-3f21-8128-6ecf8087957f",
                        "glosses": [
                            "unzureichende Ernährung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9789d5-f9fb-40a8-bfca-8ad35de5dd97",
                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                "text": "„Auch in der Demokratischen Republik Kongo leiden als Folge des Bürgerkriegs nach Angaben von Unicef noch immer 1,9 Millionen Kinder unter Mangelernährung.“"
                            },
                            {
                                "example_id": "ad1da35a-303c-4c46-96f2-96c36c5c787d",
                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                "text": "„Wer nicht schon der hohen Kindersterblichkeit zum Opfer gefallen war, litt häufig unter Mangelernährung, Strapazen und Krankheiten.“"
                            },
                            {
                                "example_id": "d9842af0-289d-43ae-9453-a8e67e5ede8b",
                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                "text": "„Über Monate andauernde Unterkühlung, Frostbeulen und Mangelernährung haben ihre Spuren hinterlassen.“"
                            },
                            {
                                "example_id": "e0093c79-a2b5-42be-92f1-12988f44e7f3",
                                "sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                                "text": "„Durch Mangelernährung bedingte Eisenarmut führte bei vielen Bewohnern des Chaco Canyons zu Durchfall und Atemwegserkrankungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66474688-c2fe-47f0-95f1-b61c6f792ec0",
                        "source_entry_id": "8bc0e347-5cf6-3f21-8128-6ecf8087957f",
                        "source_sense_id": "a3ff7030-9ab3-3bcc-ab01-de7ccf5c5cc6",
                        "source_sense_description": "unzureichende Ernährung",
                        "target_lang_word": "dénutrition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dénutrition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce35f5d0-5399-34cc-af06-a843d655bd77",
                                        "entry_id": "7b71f094-da58-3874-9234-b48b0ba36bff",
                                        "glosses": [
                                            "Insuffisance qualitative et quantitative de l’alimentation entrainant des pertes de masse grasse et de masse musculaire."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85db8b75-0068-4878-a882-d7131144c0f1",
                                                "sense_id": "ce35f5d0-5399-34cc-af06-a843d655bd77",
                                                "text": "La dénutrition est habituellement due à un manque général de plusieurs nutriments, spécialement les nutriments fournissant de l'énergie."
                                            },
                                            {
                                                "example_id": "93bf2a93-0874-4e11-a8aa-12d5c38bf7a6",
                                                "sense_id": "ce35f5d0-5399-34cc-af06-a843d655bd77",
                                                "text": "La famine, l’âge avancé, l’anorexie mentale sont autant de situations qui engendrent une dénutrition de l’individu."
                                            },
                                            {
                                                "example_id": "a5d55526-83b5-4b50-a5d3-dbb8b6b2e121",
                                                "sense_id": "ce35f5d0-5399-34cc-af06-a843d655bd77",
                                                "text": "Le jeûne est une drogue puissante et peu onéreuse, on oublie souvent de le dire. L’état de dénutrition anesthésie la douleur, les émotions, les sentiments, et fonctionne, dans un premier temps, comme une protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ca3836-3071-327b-8f3d-18dfc193e865",
                                        "entry_id": "7b71f094-da58-3874-9234-b48b0ba36bff",
                                        "glosses": [
                                            "État d’un tissu où la désassimilation l’emporte sur l’assimilation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15efdfa0-eb0b-47e8-939c-a8ca8cfd3845",
                                                "sense_id": "18ca3836-3071-327b-8f3d-18dfc193e865",
                                                "text": "Contrairement à l’opinion répandue, le café et le thé n’empêcheraient pas la dénutrition des tissus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
