                    },
                    {
                        "form_id": "adad1aea-07db-4a93-b7f0-4054a3e2fe7b",
                        "entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                        "tags": [
                            "feminine"
                        ],
                        "form": "sénatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                        "entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                        "glosses": [
                            "Homme membre d’un sénat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f696491-7f69-4bdc-88fa-5dbfc55937d0",
                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                "text": "La démocrate américaine Catherine Cortez Masto a remporté, samedi, l’État du Nevada, octroyant à son parti 50 sénateurs sur 100."
                            },
                            {
                                "example_id": "97d9cb80-0bc7-485b-8df9-374f8b21d362",
                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                "text": "Si parfois j’ai pu désirer d’être sénateur, c’est que j’imagine que, sans tarder peut-être, ce mandat fournira de belles occasions de se faire assommer, fusiller, des formes de trépas, enfin, bien préférables à une longue maladie qui vous tue lentement et par démolitions successives."
                            },
                            {
                                "example_id": "1d25c2c2-da92-48be-b92b-734d99e3d04b",
                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                "text": "Les députés ne sont que ce qu’on les a fait, et les sénateurs aussi, comme de juste."
                            },
                            {
                                "example_id": "7bab7a3e-0abb-450d-9c83-b4c5401ac7be",
                                "sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                                "text": "Rome a eu l’équivalent des purges et procès à grand spectacle, et de la maladie du soupçon ; tout sénateur était soupçonnable, et il en fut ainsi jusqu’à la fin de l’Empire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba12043f-9987-4136-9ced-071cbb3cba11",
                        "source_entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                        "source_sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                        "source_sense_description": "(Politique) Membre d’un sénat",
                        "target_lang_word": "Senator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                                        "entry_id": "622b82a8-77ea-3757-bc12-7ffed05594fa",
                                        "glosses": [
                                            "Mitglied eines Senats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d087a89-bd1a-4a4e-916d-830ebdd3b75a",
                                                "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                                                "text": "Der Senator für Stadtentwicklung traf sich gestern mit dem Bürgermeister."
                                            },
                                            {
                                                "example_id": "44dc5fec-313e-4a38-8746-e7a33efc764b",
                                                "sense_id": "513e3b9a-4385-3661-9808-6a07733780f8",
                                                "text": "„Er kochte vor Wut angesichts dieses Senators, der die stumpfsinnige Korrektheit und Beschränktheit seiner Denkweise ganz einfach auf diese ganz neu aufgetauchten Aufgaben des Adels übertragen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01013feb-2586-4b8e-95ed-e064c9b04827",
                        "source_entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                        "source_sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
                        "source_sense_description": "(Politique) Membre d’un sénat",
                        "target_lang_word": "Senatorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senatorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                        "entry_id": "540477e9-8c85-3f55-8bf6-be03f56b8b18",
                                        "glosses": [
                                            "weibliches Mitglied eines Senats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12f5926-0e99-4a50-8f19-887a93e9ffd6",
                                                "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                                "text": "„Hillary Clinton ist seit nunmehr fast einem Vierteljahrhundert im öffentlichen Bewusstsein allgegenwärtig, als First Lady, Senatorin, oberste Diplomatin und in jüngster Zeit vor allem als Rednerin, deren Honorare für einen abendlichen Auftritt in der Grössenordnung von einer Viertelmillion Dollar liegen.“"
                                            },
                                            {
                                                "example_id": "9ea390f2-6f91-44a2-820c-e6f61a9109e9",
                                                "sense_id": "967611e7-ed2f-3b5b-b2ab-2340452e4a1e",
                                                "text": "„In der neuen rot-rot-grünen Regierung ist die Linken-Politikerin als Senatorin für Stadtentwicklung und Wohnen zuständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07b35acd-e769-446a-9b62-7f0202608d18",
                        "source_entry_id": "2331db95-524c-3efc-b2a1-2812f0809633",
                        "source_sense_id": "6bb49b7c-2af3-30fc-ba29-d741f782e051",
