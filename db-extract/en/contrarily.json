                                    {
                                        "sense_id": "937e9bab-ca4c-3c55-a545-e5f13919308d",
                                        "entry_id": "ac84df2f-1c4b-39f5-8c5e-7c8c2553674b",
                                        "glosses": [
                                            "w sposób przeciwny, odwrotny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38cd4519-606c-47e6-a01d-3b70600f01d9",
                                                "sense_id": "937e9bab-ca4c-3c55-a545-e5f13919308d",
                                                "text": "Jeżeli dwie chmury naelektryzowane przeciwnie natkną się na siebie, przeskoczy między nimi dwoma iskra."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
