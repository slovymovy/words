                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a725acbf-964a-3215-8ff6-ffb81ef0fa69",
                        "entry_id": "f2c2504d-8bba-3184-8cd5-320ef4b149c3",
                        "glosses": [
                            "Région située pour l’essentiel au sud-ouest de la Pologne, une petite partie se trouvant en République tchèque et une petite partie en Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0e8ccc-ba4a-4c1f-8db2-e99bbd5a6b4c",
                                "sense_id": "a725acbf-964a-3215-8ff6-ffb81ef0fa69",
                                "text": "Entre la Slovaquie et la Tchéquie proprement dite ou le royaume de Bohème, s’étend le duché de Moravie, qui, avec plusieurs districts de Silésie, fait également partie intégrante du territoire des Tchéquo-Slaves."
                            },
                            {
                                "example_id": "10dadd5c-0ac5-4bf6-a2d2-7eed2748865b",
                                "sense_id": "a725acbf-964a-3215-8ff6-ffb81ef0fa69",
                                "text": "En laissant Hitler démembrer la Tchécoslovaquie, annexer la Bohème, la Moravie et la Silésie, nous ne lui avons rien montré d’autre qu’une certaine faiblesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "f96235a6-0334-338a-bc3f-bdb3948c17ee",
                        "entry_id": "f2c2504d-8bba-3184-8cd5-320ef4b149c3",
                        "glosses": [
                            "Voïvodie de Pologne."
                        ],
                        "tags": [],
                        "examples": []
                    }
