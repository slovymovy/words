                                    {
                                        "sense_id": "6ecad436-9369-3c9b-9dc1-77bba557ce25",
                                        "entry_id": "d60df30e-350e-399c-aa24-48c96a58bc63",
                                        "glosses": [
                                            "Omission of conjunctions, especially for rhetorical effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e3f466e-1a1f-44d8-b898-c6263e172a24",
                                                "sense_id": "6ecad436-9369-3c9b-9dc1-77bba557ce25",
                                                "text": "Asyndeton, or the Loose language... as thus. I saw it, I said it, I will sweare it."
                                            },
                                            {
                                                "example_id": "78e11600-efc1-498d-a136-83f6a68bce1f",
                                                "sense_id": "6ecad436-9369-3c9b-9dc1-77bba557ce25",
                                                "text": "Asyndeton the Cop'latives denies. Faith, Justice, Truth, Religion, Mercy dies."
                                            },
                                            {
                                                "example_id": "bf3ddd74-6f9f-4fab-9c2b-d91a4f4a4f2e",
                                                "sense_id": "6ecad436-9369-3c9b-9dc1-77bba557ce25",
                                                "text": "Asyndeton the copulative denies;\nAnd sometimes haste and rage sometimes implies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
