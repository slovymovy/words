                "senses": [
                    {
                        "sense_id": "24a66b13-21f0-3b1f-a0e1-5b522e4c0f6e",
                        "entry_id": "6af01cca-87ab-3143-a955-b66576f3b16e",
                        "glosses": [
                            "papirosa (strong Russian cigarette made with dark tobacco, no filter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89717aaa-a17e-408a-a98c-1aaf9a8ca5fe",
                                "sense_id": "24a66b13-21f0-3b1f-a0e1-5b522e4c0f6e",
                                "text": "На крыльце он долго искал в карманах спичек, хлопая себя по бокам, нашёл и тронулся по улице с незажжённой папиросой во рту.",
                                "translation": "On the porch he searched in his pockets for some matches, patting his sides, found them eventually and set off down the street with an unlit cigarette in his mouth.",
                                "english": "On the porch he searched in his pockets for some matches, patting his sides, found them eventually and set off down the street with an unlit cigarette in his mouth."
                            }
                        ]
                    }
                ],
