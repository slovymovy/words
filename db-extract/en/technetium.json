                                        "sense_id": "ede4d42c-5d9e-3946-bc83-168dba579696",
                                        "entry_id": "7b97c5fd-5ee1-3867-9fbc-bd5cf8eabd2d",
                                        "glosses": [
                                            "scheikundig element met symbool Tc en atoomnummer 43. Het is een zilvergrijs overgangsmetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1613c5-9090-4707-944f-a1bc0b3bee6f",
                                                "sense_id": "ede4d42c-5d9e-3946-bc83-168dba579696",
                                                "text": "Technetium komt van nature niet op aarde voor, maar een radioactieve vorm kan in kernreactoren vervaardigd worden en vindt toepassing in de kankerbestrijding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d323f12-b363-40d7-b32f-ae9d0a7bdfbe",
                        "source_entry_id": "974dce5d-263c-3a65-808b-e0a552ac3052",
                        "source_sense_id": "e5fc3ca3-e945-3a8b-a40c-3e4f967270ad",
                        "source_sense_description": "chemical element",
                        "target_lang_word": "technétium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technétium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                        "entry_id": "049177b7-7e30-3f9c-98c0-a07b201afdbc",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 43 et de symbole Tc, qui fait partie de la série des métaux de transition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "674e27ec-163e-43a4-a88d-763416e99823",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "Le technétium ne possède pas d’isotope stable."
                                            },
                                            {
                                                "example_id": "ff30eb60-740d-43d1-959c-60e2badfa0fe",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "Le technétium s’appela d’abord masurium."
                                            },
                                            {
                                                "example_id": "579e00e8-11cb-4159-bd8e-369107b1dc5a",
                                                "sense_id": "ec43d29c-a850-36d3-951e-cde220e715d2",
                                                "text": "En 1937, il [Emilio Segré] découvrit le technétium, le premier élément chimique (de numéro atomique 43) à avoir été produit artificiellement (technetos veut dire « artificiel » en grec)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e156be3c-0c73-4923-87f3-e4a1cf1cc45d",
                        "source_entry_id": "974dce5d-263c-3a65-808b-e0a552ac3052",
                        "source_sense_id": "e5fc3ca3-e945-3a8b-a40c-3e4f967270ad",
                        "source_sense_description": "chemical element",
                        "target_lang_word": "Technetium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Technetium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                        "entry_id": "5a1df0ea-672b-325b-9859-96e021c0a8a7",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 43, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fb50c0-f227-4bd8-aeb5-ad12a6c7b28c",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Technetium ist ein radioaktives Metall, das in der häufigen Pulverform mattgrau erscheint.“"
                                            },
                                            {
                                                "example_id": "94c3b13f-afa0-4feb-8ad5-576c5858cc2b",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Überalterte Kernreaktoren kommen nicht nach mit der Produktion von Technetium.“"
                                            },
                                            {
                                                "example_id": "ba4f1537-e0bd-4019-9d1c-adb33fd41433",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Segrè und Perrier kochten die Probe in Chemikalien aus und stießen dabei auf das Element 43, das sie später Technetium nannten, hergeleitet vom altgriechischen Wort technētós, ‚künstlich‘.“"
                                            },
                                            {
                                                "example_id": "5aa1d07b-37b5-428b-b2ab-c6d7fd0d4271",
                                                "sense_id": "42d3a679-28c3-3136-b536-e2e124c552fe",
                                                "text": "„Die Folge war ein Engpass bei der Versorgung mit Technetium für die Krebsdiagnostik - auch in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "827e3ed3-d98d-4131-bddc-3b5f5eee6eb2",
                        "source_entry_id": "974dce5d-263c-3a65-808b-e0a552ac3052",
