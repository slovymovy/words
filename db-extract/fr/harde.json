                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f4918f0-0519-3eba-b0ba-0fc8e7757312",
                        "entry_id": "68828fdc-9f8c-3bf6-8298-e614714074db",
                        "glosses": [
                            "Linge ou sous-vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f69fa9-1406-4d56-9153-85ac34f4d34b",
                                "sense_id": "4f4918f0-0519-3eba-b0ba-0fc8e7757312",
                                "text": "Il débarrassa l’unique chaise des hardes s’y entassant pour que le comte s’y assît, tandis que lui-même prenait place sur le lit, en désordre."
                            },
                            {
                                "example_id": "d711f3ac-b85e-4d86-87e2-fe51bdc70fbd",
                                "sense_id": "4f4918f0-0519-3eba-b0ba-0fc8e7757312",
                                "text": "Mes vieilles hardes avaient été mises au rebut ; je portais maintenant la même tunique de couventine que les protégées."
                            },
                            {
                                "example_id": "f38bf7f3-35c1-4e13-bf72-310544c7e397",
                                "sense_id": "4f4918f0-0519-3eba-b0ba-0fc8e7757312",
                                "text": "ligne à harde"
                            }
                        ]
                    }
                ],
