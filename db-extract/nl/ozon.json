        "nl-extract.jsonl": [
            {
                "entry_id": "19988fdf-cd3f-36f9-b677-cf15a98e1f10",
                "word": "ozon",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "086d5543-33f9-3a98-b66d-9f5ea9b5ff73",
                        "entry_id": "19988fdf-cd3f-36f9-b677-cf15a98e1f10",
                        "glosses": [
                            "een vorm van zuurstof met drie zuurstofatomen in plaats van twee dat wordt gebruikt om te oxideren en te desinfecteren"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c05e7728-ab37-428e-a070-151d335b3699",
                        "source_entry_id": "19988fdf-cd3f-36f9-b677-cf15a98e1f10",
                        "source_sense_id": "086d5543-33f9-3a98-b66d-9f5ea9b5ff73",
                        "source_sense_description": "(scheik.) een vorm van zuurstof met drie zuurstofatomen inplaats van twee",
                        "target_lang_word": "Ozon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ozon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                        "entry_id": "d43ee71b-6128-3d33-99e8-3e72af89fd91",
                                        "glosses": [
                                            "farblose, aggressive, giftige Verbindung aus drei Sauerstoffatomen, die sich durch UV-Strahlung oder elektrische Entladung in der Luft bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a047d258-b7cc-4852-bcfc-63975a8957ec",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "Ozon spielt in der Stratosphäre eine wichtige Rolle beim Filtern von UV-Strahlen."
                                            },
                                            {
                                                "example_id": "742e2ae2-31d4-4e08-9fdc-9605774ed58f",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "„In der Atmosphäre ist Ozon unterschiedlich verteilt und spielt somit im Klimakreislauf verschiedene Rollen.“"
                                            },
                                            {
                                                "example_id": "c36c8d6d-14f2-4028-8db6-70e88478554a",
                                                "sense_id": "b5352d95-d0c4-3ff0-9605-559cd7c1c99b",
                                                "text": "„Das ultraviolette Licht eines eingeschalteten Solariums spaltet kleine Mengen Sauerstoff der atmosphärischen Luft und bildet das instabile Ozon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fa4f357-dcdb-3f56-8bae-15bca3e9c53c",
                                        "entry_id": "d43ee71b-6128-3d33-99e8-3e72af89fd91",
                                        "glosses": [
                                            "frische Luft"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98692808-7593-4d60-8ff8-19a8f6c4fa99",
                                                "sense_id": "4fa4f357-dcdb-3f56-8bae-15bca3e9c53c",
                                                "text": "„Das ist der fast im Raum verlorene Laut, der kosmische Ozon eines anderen Stückes, worin Geister in goldenen Kähnen den himmlischen See befahren und der klingende Lauf glänzender Lieder sich niederringelt, - hinauf wallt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e54c3ab0-bd99-4389-a2d1-fd3e3a7b20c6",
                        "source_entry_id": "19988fdf-cd3f-36f9-b677-cf15a98e1f10",
                        "source_sense_id": "086d5543-33f9-3a98-b66d-9f5ea9b5ff73",
                        "source_sense_description": "(scheik.) een vorm van zuurstof met drie zuurstofatomen inplaats van twee",
                        "target_lang_word": "ozone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2215439a-3f46-3779-a165-e02057ff4e1a",
                                        "entry_id": "a0a2a1c0-da3a-3b53-a188-b20866706914",
                                        "glosses": [
                                            "An allotrope of oxygen (symbol O₃) having three atoms in the molecule instead of the usual two; it is a toxic gas, generated from oxygen by electrical discharge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a5f299-2d3a-4aa3-9766-f910fe7c5f94",
                                                "sense_id": "2215439a-3f46-3779-a165-e02057ff4e1a",
                                                "text": "Lightning flashed again, the thunder came a second later. It rained harder. The smell of ozone was strong. You could feel the charge in the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                        "entry_id": "a0a2a1c0-da3a-3b53-a188-b20866706914",
                                        "glosses": [
                                            "Fresh air, especially that breathed at the seaside and smelling of seaweed."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "920cfe3b-94fa-4026-8f6a-1390e545b362",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "A patent obtained in England, and specified far from clearly, for obtaining ozone by boiling seaweed,†† may be mentioned as a curiosity, and also the credulity with which ozone-baths, prepared in this manner, find a ready sale, in spite of, or perhaps rather on account of, their high price."
                                            },
                                            {
                                                "example_id": "3622afa1-061d-49a7-8dde-dad898207cf9",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "To Ramsgate baths she sped, in quest / Of seaweed and ozone ; / For seaweed and ozone were best, / They said, to give her tone."
                                            },
                                            {
                                                "example_id": "56a4eac3-6d6f-4fd7-b39f-8f6a96623336",
                                                "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                                                "text": "It's got the lot: fresh sea air, ozone, seaweed. You could cut the air with a knife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ozone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                        "entry_id": "344bf4c2-c09b-3808-8757-7dc980f240a1",
                                        "glosses": [
                                            "To treat with ozone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9461f6-a0db-4ae1-ad97-e4c3885a3f52",
                                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                                "text": "Whenever it exists, as it usually does, even where the tide water freshens at the ebb, it seems to have a purifying tendency, probably by ozoning the superincumbent atmosphere."
                                            },
                                            {
                                                "example_id": "a169e060-f40c-4232-a1c8-59e1913071e8",
                                                "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                                                "text": "I worked nonstop to make the house safe. Periodically I ozoned the first-floor bathroom, but it still made us sick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2982f23-be6b-4a30-9c41-e92ef95c2330",
                        "source_entry_id": "19988fdf-cd3f-36f9-b677-cf15a98e1f10",
                        "source_sense_id": "086d5543-33f9-3a98-b66d-9f5ea9b5ff73",
                        "source_sense_description": "(scheik.) een vorm van zuurstof met drie zuurstofatomen inplaats van twee",
                        "target_lang_word": "ozone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d262a980-60d5-3977-a037-1a2a35134139",
                                        "entry_id": "1e4c6e41-9d90-32d6-8d08-1b28af17c2c6",
                                        "glosses": [
                                            "Molécule composée de trois atomes d’oxygène (formule chimique O₃)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c108335a-56f7-4849-9429-3a1e292ca68c",
                                                "sense_id": "d262a980-60d5-3977-a037-1a2a35134139",
                                                "text": "Les molécules d’ozone sont instables et leur atomes se recombinent spontanément pour former du dioxygène."
                                            },
                                            {
                                                "example_id": "ca70ac66-6470-4c34-bbc7-249e1edeeb53",
                                                "sense_id": "d262a980-60d5-3977-a037-1a2a35134139",
                                                "text": "L’azote réactif de l’atmosphère, sous forme d’oxydes d’azote (NOx), est l’une des principales sources d’ozone (O₃)."
                                            },
                                            {
                                                "example_id": "581ab333-236a-49de-8cc4-44215955c21a",
                                                "sense_id": "d262a980-60d5-3977-a037-1a2a35134139",
                                                "text": "Au-dessus de la tropopause se trouve la stratosphère ; elle s’étend jusqu’à 40 à 60 km d’altitude et joue un rôle protecteur pour les êtres vivants puisque l’ozone qu’elle contient en grande quantité (90 % du total de la colonne atmosphérique avec un maximum vers 25 km) absorbe le rayonnement solaire ultraviolet de longueur d’onde inférieure à environ 300 nm, qui est dangereux pour les organismes vivants."
                                            },
                                            {
                                                "example_id": "53b1ae8e-350e-48f1-8846-bcc32e40ecbe",
                                                "sense_id": "d262a980-60d5-3977-a037-1a2a35134139",
                                                "text": "Le SCISAT est encore opérationnel, il continue d’envoyer régulièrement des données sur notre atmosphère et sur l’état de la couche d’ozone, 17 ans après sa mise en orbite."
                                            }
                                        ]
                                    }
                                ]
                            },
