                    "target_lang_definitions": {
                        "ru": "Фактическое удержание или контроль над имуществом, независимо от юридического права собственности.",
                        "zh": "对某物的实际控制或占用，不一定具有法律所有权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владе́ние",
                                "target_lang_sense_clarification": "фактическое обладание в юридическом контексте"
                            }
