                        "examples": [
                            {
                                "example_id": "d2642092-0384-4d6d-a62a-ad7b728bc562",
                                "sense_id": "6806c9ce-62ff-3ae4-82e1-2c36c5c70de7",
                                "text": "Een kanonskogel in je bloemenperk: Een keukenpot uit de Middeleeuwen, een kanonskogel van een paar eeuwen oud. Rond het huis kun je allerlei archeologische vondsten doen. In de tentoonstelling ' Archeologie uit je achtertuin' laat het Rijksmuseum van Oudheden in Leiden de meest interessante objecten zien."
                            },
                            {
                                "example_id": "2d64d2a0-de2f-4c53-bd70-bd0c166ac7cf",
                                "sense_id": "6806c9ce-62ff-3ae4-82e1-2c36c5c70de7",
                                "text": "Met hun idee van letters, die tevens dienen als ontmoetingsplek, moestuin en bloemenperk, sleepten zij de zogeheten Wise Owl Award in de wacht."
                            }
                        ]
                    }
