                "senses": [
                    {
                        "sense_id": "8b890ad9-1cd4-3c11-9a5b-6fc06df9c0d1",
                        "entry_id": "294cc00e-34b1-3172-9e44-a8fea59320e5",
                        "glosses": [
                            "имеющий несколько граней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516e6a8e-771f-4ce8-90d2-08352c90d27e",
                                "sense_id": "8b890ad9-1cd4-3c11-9a5b-6fc06df9c0d1",
                                "text": "Я достал из колодца свежей воды, ковшом разлил по гранёным стаканам…"
                            }
                        ]
                    },
                    {
                        "sense_id": "ba34c9b6-6349-3896-a407-829079db2e66",
                        "entry_id": "294cc00e-34b1-3172-9e44-a8fea59320e5",
                        "glosses": [
                            "подвергшийся гранению, то есть обработанный резкой и шлифовкой; имеющий рисунок, нанесенный таким способом"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08be1ce7-60cc-4938-b433-8c328e7908dd",
                        "source_entry_id": "294cc00e-34b1-3172-9e44-a8fea59320e5",
                        "target_lang_word": "taillé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taillé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa6a6fc-5917-383c-b358-525de4a0aa9b",
                                        "entry_id": "49ee732c-77e8-36c0-a4e5-6fee81d813f8",
                                        "glosses": [
                                            "Fait, proportionné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11660229-a176-4727-bf23-7893228793bc",
                                                "sense_id": "1fa6a6fc-5917-383c-b358-525de4a0aa9b",
                                                "text": "Ce M. Gauthier était un gros jeune homme taillé en hercule."
                                            },
                                            {
                                                "example_id": "2a5bda52-f365-4b89-89df-15d23c161f12",
                                                "sense_id": "1fa6a6fc-5917-383c-b358-525de4a0aa9b",
                                                "text": "Cet homme est bien taillé."
                                            },
                                            {
                                                "example_id": "380694e9-01f5-486e-a4f7-107d856b7c61",
                                                "sense_id": "1fa6a6fc-5917-383c-b358-525de4a0aa9b",
                                                "text": "Il est taillé en Hercule : Il a une forte carrure."
                                            },
                                            {
                                                "example_id": "58b6eaca-4189-4215-8f25-232caa2ff998",
                                                "sense_id": "1fa6a6fc-5917-383c-b358-525de4a0aa9b",
                                                "text": "Mais la plus forte tête du salon jaune était à coup sûr le commandant Sicardot, le beau-père d’Aristide. Taillé en Hercule, le visage rouge brique, couturé et planté de bouquets de poil gris, il comptait parmi les plus glorieuses ganaches de la grande armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49036e00-7e0c-3bd8-a5c9-2e0c3ca4d4b3",
                                        "entry_id": "49ee732c-77e8-36c0-a4e5-6fee81d813f8",
                                        "glosses": [
                                            "Préparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27acf314-7a53-4880-a3e9-eceb6fc1b952",
                                                "sense_id": "49036e00-7e0c-3bd8-a5c9-2e0c3ca4d4b3",
