                        "cross_references": [
                            {
                                "target_word": "Nicaraguan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e04b7df-7544-3aa2-a83d-d6629c9936ef",
                                        "entry_id": "3aeecd1a-ca93-319a-b09e-97957f139ae7",
                                        "glosses": [
                                            "Of, from, or pertaining to Nicaragua or the people of Nicaragua."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e1b247-2468-4542-b286-93a7c36db046",
                                                "sense_id": "1e04b7df-7544-3aa2-a83d-d6629c9936ef",
                                                "text": "Widespread anti-regime protests in 2018 were also met with brutal force, with Nicaraguan security forces killing hundreds of people, injuring thousands and arbitrarily detaining many, according to Human Rights Watch. Tens of thousands of Nicaraguans have fled the country."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nicaraguan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e29819e-7cfe-304d-8dd4-fe2c68c2629c",
                                        "entry_id": "a22d0942-4431-3cf4-8cff-ba250639bdfa",
                                        "glosses": [
                                            "A person from Nicaragua or of Nicaraguan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc6e388-5377-4a85-a4c9-eb11791a42b7",
                                                "sense_id": "4e29819e-7cfe-304d-8dd4-fe2c68c2629c",
                                                "text": "Widespread anti-regime protests in 2018 were also met with brutal force, with Nicaraguan security forces killing hundreds of people, injuring thousands and arbitrarily detaining many, according to Human Rights Watch. Tens of thousands of Nicaraguans have fled the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3af9431b-5560-4884-bc89-511731c661e8",
                        "source_entry_id": "01f153bd-8320-333b-95ba-66025de23f3b",
                        "source_sense_id": "951544b5-f8ac-3e99-a469-e7b462a49d08",
                        "source_sense_description": "Staatsbürger von Nicaragua",
                        "target_lang_word": "Nicaraguayen",
