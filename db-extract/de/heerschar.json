                ],
                "senses": [
                    {
                        "sense_id": "6677eb89-9a9f-3896-87bd-f27d2cff4efc",
                        "entry_id": "b8e8ed42-5bb6-30e7-bc85-68feb64288ae",
                        "glosses": [
                            "Teil der aktiven Streitkräfte"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "9f81026e-7205-4388-bd7d-e59eb08a6e42",
                                "sense_id": "6677eb89-9a9f-3896-87bd-f27d2cff4efc",
                                "text": "„Die gallischen Heerscharen durchbrachen die Befestigung und griffen die römischen Truppen von vorne und hinten an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09dbd6f9-ae0a-3785-8139-1a0eae91cb97",
                        "entry_id": "b8e8ed42-5bb6-30e7-bc85-68feb64288ae",
                        "glosses": [
                            "große Anzahl an Personen oder Tieren"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "cb08b181-baf2-494f-b89b-36ef2e8e6448",
                                "sense_id": "09dbd6f9-ae0a-3785-8139-1a0eae91cb97",
                                "text": "Es fielen Heerscharen von Heuschrecken über die Felder her."
                            },
                            {
                                "example_id": "45cfb311-875f-456c-9c63-ff86d7dddffd",
                                "sense_id": "09dbd6f9-ae0a-3785-8139-1a0eae91cb97",
                                "text": "„Ganze Heerscharen von Wissenschaftlern stehen am Straßenrand und grüßen und grüßen und grüßen.“"
                            },
                            {
                                "example_id": "b8ec2b6a-d515-49e1-a1cc-cb9550db29f1",
                                "sense_id": "09dbd6f9-ae0a-3785-8139-1a0eae91cb97",
                                "text": "[…] „bevor es ans Steuerzahlen geht, beschäftigen Konzerne wie Siemens, E.ON, BMW, Allianz und Co. ganze Heerscharen an Finanzbuchhaltern und Beratern, um sich künstlich arm zu rechnen. Natürlich ganz legal.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6cc543ee-f4d0-39fe-b903-68e974c1ec92",
                        "entry_id": "b8e8ed42-5bb6-30e7-bc85-68feb64288ae",
                        "glosses": [
                            "Gesamtheit der Engel"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "10964f82-407f-4189-97b0-41070f31d1d8",
                                "sense_id": "6cc543ee-f4d0-39fe-b903-68e974c1ec92",
                                "text": "„In den 1947 entdeckten Schriftrollen vom Toten Meer wird Michael als ‚Fürst des Lichts‘ bezeichnet, der die Heerscharen Gottes gegen die Mächte des Bösen unter Belial führt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95820283-b5cb-4d71-9010-3d40bab505a3",
                        "source_entry_id": "b8e8ed42-5bb6-30e7-bc85-68feb64288ae",
                        "source_sense_id": "6677eb89-9a9f-3896-87bd-f27d2cff4efc",
                        "source_sense_description": "veraltet: Teil der aktiven Streitkräfte",
                        "target_lang_word": "army",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "army",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab68b2b-e9e1-4a84-99c5-4078db97f7e8",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "An army never can be commanded or controlled by civilians."
                                            },
                                            {
                                                "example_id": "51a6749c-e3f9-470a-8c41-f224df6c3f8f",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "The army was sent in to quell the uprising."
                                            },
                                            {
                                                "example_id": "19c28783-bbf8-48ab-b2a4-5ab2c14ed225",
                                                "sense_id": "cd3cbc26-102d-34cc-89de-bc7f2e486834",
                                                "text": "This taut, soldierly, professional story is something of a stranger among American novels about war making. Angry civilians have writ ten most of the best fiction on the subject, from “Three Soldiers” through “Catch‐22,” to make the point (with a good deal of literary overkill) that wars are mass insanity and that armies are madhouses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788b475b-f6b1-354b-99cb-269bbb3271c3",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations.",
                                            "Used absolutely for that entire branch of the armed forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee373808-9281-4fe8-a670-35bed4f729b8",
                                                "sense_id": "788b475b-f6b1-354b-99cb-269bbb3271c3",
                                                "text": "The army received a bigger share of this year's budget increase than the navy or air force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985d988e-d99d-39be-b4a6-74fe457de1f6",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large, highly organized military force, concerned mainly with ground (rather than air or naval) operations.",
                                            "Within a vast military, a very large tactical contingent (e.g. a number of divisions)."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139361a7-cc6d-4578-8bdd-fe1aa8ec3762",
                                                "sense_id": "985d988e-d99d-39be-b4a6-74fe457de1f6",
                                                "text": "The Fourth Army suffered such losses that its remainders were merged into the Second Army, also deployed on the Western front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5e14e3-46b3-3a47-b4e2-5f452237365c",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "The governmental agency in charge of a state's army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083a6792-4619-49d4-bc22-2166a170a1cd",
                                                "sense_id": "ec5e14e3-46b3-3a47-b4e2-5f452237365c",
                                                "text": "The army opposed the legislature's involvement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large group of people working toward the same purpose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434d7327-5f8d-48a2-a6dc-b310177a5d32",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "It took an army of accountants to uncover the fraud."
                                            },
                                            {
                                                "example_id": "ae549a28-2e20-47a3-a40a-bc01bbf2f8e8",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "On sunny days the beaches draw armies of tourists of all kinds."
                                            },
                                            {
                                                "example_id": "8d140a33-631a-4ad1-8a51-e8e1c9a42683",
                                                "sense_id": "fb56809a-e446-38f1-8bad-eac1f5261ac3",
                                                "text": "Mr. Tenev, 33, is now in the hot seat again after Robinhood abruptly curtailed its customers’ trading last week amid a frenzy in stocks such as GameStop, which were driven sky high by an army of online investors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f74180c5-d23d-34b9-a3cb-58c360799080",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "A large group of social animals working toward the same purpose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a360a72-c85a-49d3-aa8a-b1e3a7438ae8",
                                                "sense_id": "f74180c5-d23d-34b9-a3cb-58c360799080",
                                                "text": "Our house is being attacked by an army of ants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f94cb81-b2c9-3151-be29-666f692a6b8a",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "Any multitude."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6ef3da-68f3-4df4-a8d0-e2674eb2cc1c",
                                                "sense_id": "2f94cb81-b2c9-3151-be29-666f692a6b8a",
                                                "text": "There was an army of construction cranes working on building the skyscraper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                        "entry_id": "fafb6f31-bc68-3274-9c39-c5e0c3bd6553",
                                        "glosses": [
                                            "The military as a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ffa4567-e5a2-4ae2-bfa1-6d9a212458b3",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "The People's Liberation Army Navy of China."
                                            },
                                            {
                                                "example_id": "92d79fb6-5d0a-4f21-a980-bc3b011de71e",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "The Yugoslav Army consisted of the War Navy, Ground Forces, and Air Force."
                                            },
                                            {
                                                "example_id": "f7a8df7b-76a3-4491-8a31-d0acd38541ca",
                                                "sense_id": "0e7918c8-451f-3a15-a0c8-c6be1441b1ca",
                                                "text": "Iran's army consists of the Navy, Ground Forces, and Air Force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34302dd0-b96e-457d-91a1-6de4710842e5",
                        "source_entry_id": "b8e8ed42-5bb6-30e7-bc85-68feb64288ae",
                        "source_sense_id": "09dbd6f9-ae0a-3785-8139-1a0eae91cb97",
                        "source_sense_description": "übertragen: große Anzahl an Personen oder Tieren",
                        "target_lang_word": "multitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                        "entry_id": "01e605a7-d50d-340b-8789-d82a4cf3cc48",
                                        "glosses": [
                                            "A great amount or number, often of people; abundance, myriad, profusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a7adbe-eba6-499a-85f5-c8abd1cc77ee",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "Do I contradict myself? / Very well then I contradict myself, / (I am large, I contain multitudes.)"
                                            },
                                            {
                                                "example_id": "d048a759-0609-44e2-a932-40eb57a6bad0",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "A torrential rain poured down from the floodgates of the angry heavens upon the bared heads of the assembled multitude which numbered at the lowest computation five hundred thousand persons."
                                            },
                                            {
                                                "example_id": "b86d6253-c4ab-4e23-a9b8-e029c4fb8f52",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "On the other hand, to arrive after dusk, when the multitude of garish little public-houses are lit up, giving glimpses of crowded jostling bars and taprooms, is an introduction to a fine city well calculated to affect even the most nonchalant."
                                            },
                                            {
                                                "example_id": "13f28a42-51a2-4cee-9e71-33842e62922f",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "We found Pop Glossop in his pantry polishing silver, and put in our order. He seemed a little surprised at the inrush of such a multitude, but on learning that our tongues were hanging out obliged with a bottle of the best […]"
                                            },
                                            {
                                                "example_id": "c1bff754-c375-43df-8ae3-ff408bd98ff2",
                                                "sense_id": "0e7e7386-8d59-322b-ba08-e511852b31b5",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5433a94b-7540-31da-ac9d-ca7d9e42effb",
                                        "entry_id": "01e605a7-d50d-340b-8789-d82a4cf3cc48",
                                        "glosses": [
                                            "The mass of ordinary people; the masses, the populace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291d4a46-abf3-4795-a52a-bd68769bc076",
                                                "sense_id": "5433a94b-7540-31da-ac9d-ca7d9e42effb",
                                                "text": "Thou shalt not follow a multitude to do evil"
                                            },
                                            {
