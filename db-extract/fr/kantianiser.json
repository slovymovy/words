                "senses": [
                    {
                        "sense_id": "02ebf2d5-81a6-331b-9e40-fd5fed4eb009",
                        "entry_id": "b309d7e8-1d9f-36af-958e-a1bb076d3c4e",
                        "glosses": [
                            "Donner un caractère kantien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18ad28d-a70f-4c5e-99d8-20fb111f61ef",
                                "sense_id": "02ebf2d5-81a6-331b-9e40-fd5fed4eb009",
                                "text": "Certes Guéroult a-t-il tendance à « kantianiser » Descartes, mais il nous semble avoir pleinement raison lorsqu’il analyse ce passage comme une tentative cartésienne d’identifier ce que sont les « conditions de possibilité » de toute représentation, quel que soit l’état de vigilance de l’esprit."
                            },
                            {
                                "example_id": "0c9a1967-8694-4780-9de2-d38737dbabe9",
                                "sense_id": "02ebf2d5-81a6-331b-9e40-fd5fed4eb009",
                                "text": "Il y a deux points où cette tendance constante (et inconsciente) à kantianiser Leibniz a entraîné l'auteur à de fausses interprétations."
                            },
                            {
                                "example_id": "506dbea0-9241-414a-9589-ce0b907482f5",
                                "sense_id": "02ebf2d5-81a6-331b-9e40-fd5fed4eb009",
                                "text": "Kantianiser Eichmann à Jérusalem ?"
                            }
                        ]
                    }
