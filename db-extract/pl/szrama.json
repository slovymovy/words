                "translations": [
                    {
                        "translation_id": "db09ef26-d395-485d-ab74-a52224d3c875",
                        "source_entry_id": "775ebdd2-cf6a-3231-a152-30434f947554",
                        "source_sense_id": "5f0e801c-f9ab-3019-8e86-397483d4c265",
                        "target_lang_word": "шрам",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шрам",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd8b12b-65d8-3f94-bff5-4339d1543649",
                                        "entry_id": "1b45c040-95f6-338d-b988-c8523ce724db",
                                        "glosses": [
                                            "след от зажившей раны или язвы на коже"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad49f4b-15e6-4a0a-b29a-437a4eece40a",
                                                "sense_id": "4fd8b12b-65d8-3f94-bff5-4339d1543649",
                                                "text": "Черты его лица вообще были правильны, но обезображены шрамом на лбу, этим неизгладимым знаком буйной жизни."
                                            },
                                            {
                                                "example_id": "7a4c3cc7-a256-4075-b654-8129f97e4976",
                                                "sense_id": "4fd8b12b-65d8-3f94-bff5-4339d1543649",
                                                "text": "Рядом с ним, обнимая его за талию, сидел околоточный надзиратель, молодой человек с чёрными усами и со шрамом на правой щеке."
                                            },
                                            {
                                                "example_id": "0fe2215b-11ef-4c80-944c-8a262a74ca77",
                                                "sense_id": "4fd8b12b-65d8-3f94-bff5-4339d1543649",
                                                "text": "Должно быть, это был весьма глубокий разрез, если шрам остался на всю жизнь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
