                "forms": [],
                "senses": [
                    {
                        "sense_id": "7c51ce9a-a71d-3dd8-8ce0-e904027e5fcd",
                        "entry_id": "ea49e504-a793-3a9b-9b50-817e28dc5c08",
                        "glosses": [
                            "Trading où un même actif est acheté rapidement et de multiples fois pour profiter des petites variations de sa valeur avec un moindre risque."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "513050b4-6402-4abf-9e47-4349dbb85a49",
                                "sense_id": "7c51ce9a-a71d-3dd8-8ce0-e904027e5fcd",
                                "text": "Parce que les scalpers doivent rester scotchés à leurs écrans, le scalping convient mieux à ceux qui peuvent (et veulent) rester concentrés des heures durant sur leur trading. Réussir dans le scalping requiert une forte capacité de concentration et un esprit vif."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a3b43ce-be94-3ad8-9f60-825a5ed981d5",
                        "entry_id": "ea49e504-a793-3a9b-9b50-817e28dc5c08",
                        "glosses": [
                            "Pratique consistant à acheter de grandes quantités d'un article avec l'intention de les revendre à des tarifs supérieurs au prix ordinaire."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a7d4a2-2a48-47a0-9bf5-05de7912511a",
                                "sense_id": "5a3b43ce-be94-3ad8-9f60-825a5ed981d5",
                                "text": "« Frustrés » et « en colère », les Britanniques amateurs de jeux vidéos dénoncent le scalping de consoles."
                            }
                        ]
                    }
