                "senses": [
                    {
                        "sense_id": "c08ed134-124e-38b8-a287-08b6a2fc0c4e",
                        "entry_id": "aa50fa31-fc0c-36d2-9b68-f877a3104437",
                        "glosses": [
                            "Lieu destiné à la samba, aux défilés des écoles de samba."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8748ce8a-808a-4d64-9565-b2de92e008d1",
                                "sense_id": "c08ed134-124e-38b8-a287-08b6a2fc0c4e",
                                "text": "« Je n’ai réalisé ce qui se passait que lors de la nuit du Carnaval quand j’étais au milieu du sambodrome à danser devant des millions de gens » s’exclame Dora."
                            },
                            {
                                "example_id": "56af45e2-fe53-461b-adaa-cc3a366de641",
                                "sense_id": "c08ed134-124e-38b8-a287-08b6a2fc0c4e",
                                "text": "Il tient un sambodrome chez les squatts de la 4ᵉ Rue."
                            },
                            {
                                "example_id": "26a528f9-da6e-4b9d-9dcf-bb553e160048",
                                "sense_id": "c08ed134-124e-38b8-a287-08b6a2fc0c4e",
                                "text": "C’est l’architecte Niemeyer, le constructeur de Brasilia, qui réalisa ce sambodrome pour la bagatelle de 500 milliards d’anciens francs."
                            },
                            {
                                "example_id": "330177fc-4eb0-408d-8c79-e96deda80c85",
                                "sense_id": "c08ed134-124e-38b8-a287-08b6a2fc0c4e",
                                "text": "Tous les ans, les douze écoles de samba se disputent le prestigieux titre de « championne du carnaval » lors de deux nuits de défilés sur le sambodrome de Rio. — (« À Rio, un important incendie ravage les ateliers du Carnaval », nouvelObs.fr, 7 février 2011)"
                            }
                        ]
                    }
                ],
