                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e6b84c-9b43-4d9a-9df9-1f5e804189cf",
                                "sense_id": "e57dd9da-dc5e-3b26-b798-df7e6e83e4fb",
                                "text": "Omdat het niet als urgent werd beschouwd, liet de centralist weten dat het waarschijnlijk meer dan twee uur zou duren voordat er een surveillancewagen langs kon komen."
                            },
                            {
                                "example_id": "7c77e4af-630c-4cbe-8498-be00412de3d9",
                                "sense_id": "e57dd9da-dc5e-3b26-b798-df7e6e83e4fb",
                                "text": "In Noorwegen is kritiek ontstaan op het optreden van de politie. Die deed er meer dan een uur over om bij de gekaapte bus te komen. Een woordvoerder zegt dat de dichtstbijzijnde surveillancewagen 90 kilometer moest afleggen en dat de rit langer duurde door sneeuwval."
                            }
                        ]
                    }
