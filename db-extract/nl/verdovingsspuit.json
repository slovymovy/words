                        "glosses": [
                            "injectie met een slaapverwekkend middel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df1ec1a-19ce-46d1-bf45-91d7717273a9",
                                "sense_id": "f5a4b4df-361d-3e7a-a8fd-9b7f065fdd8f",
                                "text": "Volgens de ANWB heeft het schaap uiteindelijk bijna tien kilometer over de snelweg gelopen, van Breukelen tot Vinkeveen. Rijkswaterstaat stelde een snelheidsbeperking in en medewerkers probeerden het schaap te vangen. Ook kwam een dierenarts met een verdovingsspuit, maar die hoefde niet in actie te komen."
                            }
                        ]
