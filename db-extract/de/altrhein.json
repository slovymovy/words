                        "entry_id": "75215f0e-6569-3fb5-827b-4694bce0846c",
                        "glosses": [
                            "alle durch die Rheinkorrekturen stillgelegten Arme und Schlingen vom Quell- bis zum Mündungsgebiet"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "1c819c7a-8a8b-4cd0-961f-382cf1bdf685",
                                "sense_id": "e14ec100-65b8-3381-beb5-57889c49efc4",
                                "text": "„Die Altrheine sind hochwichtig als Fischbrutstätten.“"
                            },
                            {
                                "example_id": "ff0a1f7c-61a5-472c-94e4-f639d1cd5a08",
                                "sense_id": "e14ec100-65b8-3381-beb5-57889c49efc4",
                                "text": "„Im Sommer sparen wir uns allerdings all diese Formalitäten und schwimmen dann durch den Altrhein in die Schweiz.“"
                            },
                            {
                                "example_id": "1cb9fdb8-e2a3-4d63-89e7-12b6cb984afa",
                                "sense_id": "e14ec100-65b8-3381-beb5-57889c49efc4",
                                "text": "„Der kleine See ist der Altrhein und was hinter ihm liegt, die Insel Flotzgrün.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
