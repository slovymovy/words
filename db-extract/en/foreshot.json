                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "289dd1f9-a880-3016-89f8-065c641c4bc8",
                        "entry_id": "4a7ecbd9-33fb-3dba-8ac6-cfdc94dde02c",
                        "glosses": [
                            "The foreground of a photographic image."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f0a5b2-e91f-4d2c-905b-566fdf69335b",
                                "sense_id": "289dd1f9-a880-3016-89f8-065c641c4bc8",
                                "text": "It was obviously an Aspen Valley resident because she recognised the stabling in the background, but the tall dark bay horse in the foreshot didn't look familiar."
                            }
                        ]
