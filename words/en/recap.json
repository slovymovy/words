{
    "word_family": [
        "recapitulate",
        "recapitulation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48baff84-2f7d-33e7-9568-e9aca5a8bea8",
                    "sense_definition": "To summarize or state again the main points of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before we begin with today's agenda, Alice, would you please <w>recap</w> the decisions that were made last week?",
                            "target_lang_translations": {
                                "ru": "Прежде чем мы перейдем к сегодняшней повестке дня, Элис, не могла бы ты <w>резюмировать</w> решения, принятые на прошлой неделе?",
                                "zh": "在开始今天的议程之前，爱丽丝，请你<w>总结</w>一下上周做出的决定好吗？"
                            }
                        },
                        {
                            "text": "Let me <w>recap</w> the main points of our discussion so far.",
                            "target_lang_translations": {
                                "ru": "Позвольте мне <w>подытожить</w> основные моменты нашей дискуссии на данный момент.",
                                "zh": "让我来<w>概括</w>一下我们目前讨论的要点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summarise",
                        "summarize",
                        "sum up"
                    ],
                    "common_phrases": [
                        "recap the main points",
                        "briefly recap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратко изложить или повторить основные моменты чего-либо.",
                        "zh": "简要重述或总结某事的主要观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "подводить итог"
                            },
                            {
                                "target_lang_word": "подытожить",
                                "target_lang_sense_clarification": "сделать краткий обзор"
                            },
                            {
                                "target_lang_word": "кратко повторить",
                                "target_lang_sense_clarification": "основные тезисы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总结",
                                "target_lang_sense_clarification": "概括要点"
                            },
                            {
                                "target_lang_word": "概括",
                                "target_lang_sense_clarification": "简要说明"
                            },
                            {
                                "target_lang_word": "重述",
                                "target_lang_sense_clarification": "再次陈述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9486f4cd-f0d5-31df-aa07-0aa3d83b0c1f",
                    "sense_definition": "To seal something again with a cap.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They're planning to <w>recap</w> those oil wells permanently.",
                            "target_lang_translations": {
                                "ru": "Они планируют окончательно <w>загерметизировать</w> эти нефтяные скважины.",
                                "zh": "他们计划永久性地将那些油井<w>封好</w>。"
                            }
                        },
                        {
                            "text": "Always <w>recap</w> the bottle tightly after use to prevent the liquid from evaporating.",
                            "target_lang_translations": {
                                "ru": "Всегда плотно <w>закрывайте</w> бутылку после использования, чтобы предотвратить испарение жидкости.",
                                "zh": "使用后请务必将瓶子<w>盖紧</w>，以防液体蒸发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recap the bottle",
                        "recap the pen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова закрыть что-либо крышкой или колпачком.",
                        "zh": "再次盖上盖子或瓶盖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "крышкой или колпачком"
                            },
                            {
                                "target_lang_word": "закупорить",
                                "target_lang_sense_clarification": "повторно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盖上",
                                "target_lang_sense_clarification": "盖好盖子"
                            },
                            {
                                "target_lang_word": "重新封好",
                                "target_lang_sense_clarification": "再次密封"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a489d486-9172-3315-b676-f0289b4d0ea1",
                    "sense_definition": "To replace the worn tread on a tire by gluing on a new outer portion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tire_repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They buy a lot of camelback because they <w>recap</w> a lot of truck tires for trailer fleets.",
                            "target_lang_translations": {
                                "ru": "Они покупают много протекторной резины, потому что <w>восстанавливают</w> много грузовых шин для прицепов.",
                                "zh": "他们购买大量的胎面胶，因为他们要为拖车队<w>翻新</w>许多卡车轮胎。"
                            }
                        },
                        {
                            "text": "It is often cheaper to <w>recap</w> truck tires than to buy brand new ones.",
                            "target_lang_translations": {
                                "ru": "Часто дешевле <w>наварить</w> грузовые шины, чем покупать новые.",
                                "zh": "翻新卡车轮胎通常比购买全新的轮胎更便宜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retread#Verb"
                    ],
                    "common_phrases": [
                        "recap a tire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить изношенный протектор на шине, наклеив новую внешнюю часть.",
                        "zh": "通过粘贴新的外层来更换轮胎磨损的胎面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать протектор",
                                "target_lang_sense_clarification": "на шине"
                            },
                            {
                                "target_lang_word": "наваривать",
                                "target_lang_sense_clarification": "шину"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻新",
                                "target_lang_sense_clarification": "指轮胎翻新"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9718680c-9606-339f-9708-364bbffe0048",
                    "sense_definition": "To replace capacitors in electronic equipment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage amplifier sounded much better after I decided to <w>recap</w> the entire power supply circuit.",
                            "target_lang_translations": {
                                "ru": "Винтажный усилитель зазвучал намного лучше после того, как я решил <w>перепаять конденсаторы</w> во всей цепи питания.",
                                "zh": "在我决定<w>更换</w>整个电源电路的电容后，这台老式放大器的音质好多了。"
                            }
                        },
                        {
                            "text": "You might need to <w>recap</w> the motherboard if you see any leaking components.",
                            "target_lang_translations": {
                                "ru": "Возможно, вам придется <w>заменить конденсаторы</w> на материнской плате, если вы увидите подтекающие компоненты.",
                                "zh": "如果你看到有元件漏液，可能需要<w>更换</w>主板上的电容。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "recap the board"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used within electronics repair communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить конденсаторы в электронном оборудовании.",
                        "zh": "更换电子设备中的电容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепаивать конденсаторы",
                                "target_lang_sense_clarification": "в электронике"
                            },
                            {
                                "target_lang_word": "менять кондеры",
                                "target_lang_sense_clarification": "жаргон ремонтников"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更换电容",
                                "target_lang_sense_clarification": "电子维修术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "111310fd-3607-31a1-860e-a574f6ae71cc",
                    "sense_definition": "A short summary or a <w>recapitulation</w> of previous events or points.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "summary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before we begin with today's agenda, Alice will give us a <w>recap</w> of recent decisions.",
                            "target_lang_translations": {
                                "ru": "Прежде чем мы перейдем к сегодняшней повестке дня, Элис представит нам <w>краткий обзор</w> последних решений.",
                                "zh": "在开始今天的议程之前，爱丽丝将为我们做一个关于近期决定的<w>总结</w>。"
                            }
                        },
                        {
                            "text": "The news program started with a quick <w>recap</w> of the day's top stories.",
                            "target_lang_translations": {
                                "ru": "Программа новостей началась с быстрого <w>обзора</w> главных событий дня.",
                                "zh": "新闻节目以对当天头条新闻的快速<w>概括</w>开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summary",
                        "summing-up"
                    ],
                    "common_phrases": [
                        "quick recap",
                        "brief recap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое изложение или повторение предыдущих событий или пунктов.",
                        "zh": "对之前事件或要点的简短总结。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краткий обзор",
                                "target_lang_sense_clarification": "прошедшего"
                            },
                            {
                                "target_lang_word": "резюме",
                                "target_lang_sense_clarification": "подведение итогов"
                            },
                            {
                                "target_lang_word": "пересказ",
                                "target_lang_sense_clarification": "основных моментов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总结",
                                "target_lang_sense_clarification": "简要概述"
                            },
                            {
                                "target_lang_word": "概括",
                                "target_lang_sense_clarification": "要点回顾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f89bc9cd-e2bc-3ad2-bf07-a6bee74997d0",
                    "sense_definition": "A tire that has had new tread glued on.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tire_repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to buy <w>recaps</w> because he didn't trust them not to come apart on the highway.",
                            "target_lang_translations": {
                                "ru": "Он отказался покупать <w>восстановленные шины</w>, потому что не верил, что они не развалятся на трассе.",
                                "zh": "他拒绝购买<w>翻新胎</w>，因为他不相信它们在高速公路上不会散架。"
                            }
                        },
                        {
                            "text": "Stacy noted that the tire had been a <w>recap</w> created by gluing a new outer portion of tread onto the worn core.",
                            "target_lang_translations": {
                                "ru": "Стейси заметила, что шина была <w>наваркой</w>, созданной путем наклеивания нового внешнего слоя протектора на изношенную основу.",
                                "zh": "斯泰西注意到这个轮胎是通过在磨损的胎体上粘贴新的外层胎面而制成的<w>翻新胎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retread#Noun"
                    ],
                    "common_phrases": [
                        "buy recaps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шина, на которую был наклеен новый протектор.",
                        "zh": "已经过翻新处理、贴上新胎面的轮胎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановленная шина",
                                "target_lang_sense_clarification": "с новым протектором"
                            },
                            {
                                "target_lang_word": "наварка",
                                "target_lang_sense_clarification": "разговорное о шине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻新胎",
                                "target_lang_sense_clarification": "经过翻新的轮胎"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb9793cf-1e8d-365c-98bf-dd82a47c9f8b",
                    "sense_definition": "A leveraged recapitalization accomplished by increasing the debt to equity ratio.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A survey of private equity firms found that most firms are comfortable with a debt/equity ratio of 4:1 following a dividend <w>recap</w>.",
                            "target_lang_translations": {
                                "ru": "Опрос частных инвестиционных компаний показал, что большинство из них устраивает соотношение долга к капиталу 4:1 после дивидендной <w>рекапитализации</w>.",
                                "zh": "一项针对私募股权公司的调查发现，大多数公司在进行股息<w>资本重组</w>后，都能接受4:1的债务权益比。"
                            }
                        },
                        {
                            "text": "The company's board approved a leveraged <w>recap</w> to return value to the shareholders.",
                            "target_lang_translations": {
                                "ru": "Совет директоров компании одобрил <w>рекапитализацию</w> с использованием заемных средств для возврата стоимости акционерам.",
                                "zh": "公司董事会批准了一项杠杆<w>资本重组</w>计划，以回报股东。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dividend recap",
                        "leveraged recap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in business and finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекапитализация за счет заемных средств путем увеличения соотношения долга к собственному капиталу.",
                        "zh": "通过提高债务权益比率来实现的杠杆资本重组。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекапитализация",
                                "target_lang_sense_clarification": "финансовая структура"
                            },
                            {
                                "target_lang_word": "изменение структуры капитала",
                                "target_lang_sense_clarification": "через заем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资本重组",
                                "target_lang_sense_clarification": "财务结构调整"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}