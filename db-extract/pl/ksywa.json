                ],
                "senses": [
                    {
                        "sense_id": "9e0c3433-b8f4-3efc-a88a-4f47fe1933b5",
                        "entry_id": "1fa8fed5-2acb-3e68-9447-defa70ac1064",
                        "glosses": [
                            "przezwisko, pseudonim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a16b53-4cf5-4518-9155-497040836f32",
                                "sense_id": "9e0c3433-b8f4-3efc-a88a-4f47fe1933b5",
                                "text": "Derek Klivian. Który nienawidził swojego imienia i upierał się, by przyjaciele wołali go ksywą z dzieciństwa, tą, którą Wedge uważał za niedorzeczną, gdy jest się osobą dorosłą lub próbuje się nią zostać"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "54cf8a95-cd7a-3009-915e-0c5f72efa4c2",
                        "entry_id": "1fa8fed5-2acb-3e68-9447-defa70ac1064",
                        "glosses": [
                            "gwara przestępcza"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6c8b946-c032-46a1-8715-92f139ea1803",
                        "source_entry_id": "1fa8fed5-2acb-3e68-9447-defa70ac1064",
                        "source_sense_id": "54cf8a95-cd7a-3009-915e-0c5f72efa4c2",
                        "target_lang_word": "феня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "феня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9c68d5f6-d2ca-36f4-b12b-87beec9427dc",
                                        "entry_id": "58864738-cebc-36ef-8119-f7c9cd41600d",
                                        "glosses": [
                                            "разг., жарг. криминальный жаргон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977cb81d-aeff-46c1-83dd-adda57af7c64",
                                                "sense_id": "9c68d5f6-d2ca-36f4-b12b-87beec9427dc",
                                                "text": "Я захохотал, сообразив, что Мишка меня неправильно понял — на «фене», блатном языке, «розы» означают драгоценные камни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76e16049-c7b4-3fcc-81f3-ec37a5c211e0",
                                        "entry_id": "58864738-cebc-36ef-8119-f7c9cd41600d",
                                        "glosses": [
                                            "истор. язык, сформировавшийся на Руси в эпоху Средневековья и первоначально использовавшийся бродячими торговцами офенями"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3301bd9-493e-3a97-82f5-735caf4ca466",
                                        "entry_id": "58864738-cebc-36ef-8119-f7c9cd41600d",
                                        "glosses": [
                                            "разг. любой жаргон или сленг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f662e0c0-cdae-4252-85fb-58236cbcdd6e",
                                                "sense_id": "f3301bd9-493e-3a97-82f5-735caf4ca466",
                                                "text": "Ныне мат заполонил издания, стал официальной феней депутатского корпуса."
                                            },
                                            {
                                                "example_id": "020139ef-83c4-457e-b310-a39b1e7a9a98",
                                                "sense_id": "f3301bd9-493e-3a97-82f5-735caf4ca466",
                                                "text": "Наморщив лоб, Татарский несколько секунд вспоминал, как этот феномен назывался на профессиональной фене, а вспомнив, достал книжечку и открыл ее на букву «Н», где была «недвижимость»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
