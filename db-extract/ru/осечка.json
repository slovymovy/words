                    },
                    {
                        "sense_id": "8c2910c2-933f-358a-9e2e-388e04eca094",
                        "entry_id": "11cc6933-5392-3056-b01e-790d67741b04",
                        "glosses": [
                            "перен., разг. промах, неудача в каком-либо деле"
