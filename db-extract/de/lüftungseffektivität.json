                    {
                        "sense_id": "81a2751b-77b6-328f-96c8-afee6031f4a9",
                        "entry_id": "b719f20f-eb2b-3da1-a643-edd5dce33687",
                        "glosses": [
                            "Kennzahl die beschreibt wie schnell verbrauchte Luft aus einem Raum entfernt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ebb23c-4591-4a22-81f7-23ea29bb7e87",
                                "sense_id": "81a2751b-77b6-328f-96c8-afee6031f4a9",
                                "text": "„Die Lüftungseffektivität bezeichnet die Fähigkeit eines Lüftungssystems, die Lufterneuerung und den Schadstoffabtransport im Raum sicherzustellen.“"
                            },
                            {
                                "example_id": "85eaf384-c261-4073-9434-c1ad4e1eb87c",
                                "sense_id": "81a2751b-77b6-328f-96c8-afee6031f4a9",
                                "text": "„Die Lüftungseffektivität beschreibt, wie schnell verbrauchte Luft aus einem Raum entfernt wird.“"
                            },
                            {
                                "example_id": "0ec48cc1-512e-405c-8874-c6afc5c125a2",
                                "sense_id": "81a2751b-77b6-328f-96c8-afee6031f4a9",
                                "text": "„Die Lüftungseffektivität ist eine charakteristische Kenngröße für die unterschiedlichen Lüftungsanlagen.“"
                            },
                            {
                                "example_id": "186f8e85-6219-47ee-87f5-dbc0aa25d8bb",
                                "sense_id": "81a2751b-77b6-328f-96c8-afee6031f4a9",
                                "text": "„Die Qualität eines Quelllüftungssystems kann durch die Kenngrößen der Lüftungseffektivität beschrieben werden.“"
                            }
                        ],
