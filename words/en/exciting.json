    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8c5d7dd6-dd98-3ad1-851b-c826fdfe39fa",
                    "sense_definition": "Creating or producing feelings of great enthusiasm and eagerness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have some very <w>exciting</w> news to share with you today.",
                            "target_lang_translations": {
                                "ru": "У нас есть очень <w>волнующие</w> новости, которыми мы хотим поделиться с вами сегодня.",
                                "tr": "Bugün sizinle paylaşacağımız çok <w>heyecan verici</w> haberlerimiz var."
                            }
                        },
                        {
                            "text": "The football match was <w>exciting</w> until the very last minute.",
                            "target_lang_translations": {
                                "ru": "Футбольный матч был <w>захватывающим</w> до самой последней минуты.",
                                "tr": "Futbol maçı son dakikasına kadar <w>heyecanlı</w> geçti."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrilling",
                        "exhilarating",
                        "stimulating",
                        "electrifying",
                        "gripping",
                        "fascinating"
                    ],
                    "antonyms": [
                        "boring",
                        "unexciting"
                    ],
                    "common_phrases": [
                        "exciting news",
                        "exciting opportunity",
                        "exciting adventure",
                        "exciting time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный энтузиазм, интерес или радостное волнение.",
                        "tr": "Büyük heyecan, coşku ve istek uyandıran."
                    },
                    "translations": {
