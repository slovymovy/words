                                    {
                                        "sense_id": "af83b55c-e700-32c1-9c79-ba6108651202",
                                        "entry_id": "e9a9e4cf-5fcd-394b-ad91-839596137333",
                                        "glosses": [
                                            "Not functioning properly."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608eae5d-bf6c-4662-aef6-e2d6881359f7",
                                                "sense_id": "af83b55c-e700-32c1-9c79-ba6108651202",
                                                "text": "The lift is always out of order."
                                            },
                                            {
                                                "example_id": "8af66780-3723-4817-a3b4-6f3b5efe1be0",
                                                "sense_id": "af83b55c-e700-32c1-9c79-ba6108651202",
                                                "text": "With the lift in the block still out of order, they climbed the flights and flights of steps. When Dad finally put the key in the front door, both were weary beyond words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfed0af-50d9-3498-8b24-1c532f795ec2",
                                        "entry_id": "e9a9e4cf-5fcd-394b-ad91-839596137333",
                                        "glosses": [
                                            "Inappropriate or unsuitable."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f61065e-33cb-4bfb-b523-44bc938d229e",
                                                "sense_id": "7bfed0af-50d9-3498-8b24-1c532f795ec2",
                                                "text": "I suppose my remarks about his wife were out of order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "777b2359-de11-34a3-99d8-787a9d0d3d69",
                                        "entry_id": "e9a9e4cf-5fcd-394b-ad91-839596137333",
                                        "glosses": [
                                            "Not in order: not according with e.g. the procedural rules governing formal meetings of a deliberative body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49f12084-018d-370d-b028-6a2119478f71",
                                        "entry_id": "e9a9e4cf-5fcd-394b-ad91-839596137333",
                                        "glosses": [
                                            "untidy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c18cba6c-1895-4aba-a3ed-13637b7afa66",
                                                "sense_id": "49f12084-018d-370d-b028-6a2119478f71",
                                                "text": "Architas Tarentinus returning from a war, where he had beene Captaine generall, found his house all out of order, husbandrie all spoiled, and by the ill government of his Bailife, his ground all waste and unmanured […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "out of order",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab5ce7f2-8429-37c9-8f1d-27ac160ff682",
                                        "entry_id": "5869989c-0d07-3786-b739-8cc52fc5bb30",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a88e9f7-28a7-4c31-ae8d-c0faf1706414",
                        "source_entry_id": "7a8a4ac4-5b39-32b0-9671-e09d1f979d15",
                        "source_sense_id": "e5b2257b-ccdd-3590-a7f4-b5af7a4c6fa2",
                        "target_lang_word": "капут",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "капут",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fafab598-5518-3c96-8e83-ad621d3481bc",
                                        "entry_id": "84971cd2-3340-3721-a4bb-26b165c714b1",
                                        "glosses": [
                                            "разг. гибель, конец, смерть"
                                        ],
                                        "tags": [
                                            "кому., чему."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50da942c-8891-4d48-94ce-5bec46be3f2c",
                                                "sense_id": "fafab598-5518-3c96-8e83-ad621d3481bc",
                                                "text": "Вытащили Семёна Ивановича, протянули его на тюфяк, но сразу заметили, что много хлопотать было нечего, что капут совершенный; руки его костенеют, а сам еле держится."
                                            },
                                            {
                                                "example_id": "a55dfe77-7bd4-4b75-9bc1-e0a3b9c1278f",
                                                "sense_id": "fafab598-5518-3c96-8e83-ad621d3481bc",
                                                "text": "Только что кончил, глядь, перед ним опять докучливый Иван Петрович, и уже навеселе. — Капут твоему упрямству, Николаша, — сказал он. — Супротив меня ты огрызаешься, а как заговорят другие, вот посмотри, и слов не найдёшь."
                                            },
                                            {
                                                "example_id": "4e03297b-f69e-4414-b1bd-60371717587a",
                                                "sense_id": "fafab598-5518-3c96-8e83-ad621d3481bc",
                                                "text": "Сказывают: теперь пареньку-то капут, потому он в азартности в своей весь рот немцу-то паполы разорвал."
                                            },
                                            {
                                                "example_id": "bf5b8303-896d-458d-9121-62bc8d7706e8",
                                                "sense_id": "fafab598-5518-3c96-8e83-ad621d3481bc",
                                                "text": "Если это соглашение состоится, думалось мне, то всё кончено — либеральным идеям капут."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "капут",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f7036221-09db-343e-b830-87a32c10302c",
                                        "entry_id": "e9ed63d9-187f-3c4f-a49b-8cab5d530ab8",
                                        "glosses": [
                                            "разг., предик. о безнадёжной, проигрышной ситуации, гибели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4114b1-36c1-4d8c-9d6e-9819e7b25932",
                                                "sense_id": "f7036221-09db-343e-b830-87a32c10302c",
                                                "text": "« — Коли так будешь продолжать, то тут тебе и капут!»"
                                            },
                                            {
                                                "example_id": "e1e0a800-e28d-473a-b79b-5000065c87dd",
                                                "sense_id": "f7036221-09db-343e-b830-87a32c10302c",
                                                "text": "— Мы люди сухие, постные, — огрызнулся тот, — а вот ваше благородие… вам капут… хе, хе, хе!"
                                            },
                                            {
                                                "example_id": "5deb5e20-1e0d-4be8-b619-f61d359e7ba1",
                                                "sense_id": "f7036221-09db-343e-b830-87a32c10302c",
                                                "text": "Гриф идёт переваливаясь, а иногда в припрыжку и, добравшись до добычи, начинает рвать куски и жадно глотать их. Тут-то ему и капут. Гремит выстрел, и птица падает мёртвою."
                                            },
                                            {
                                                "example_id": "87ff650e-9793-4e63-816f-794612bd89a8",
                                                "sense_id": "f7036221-09db-343e-b830-87a32c10302c",
                                                "text": "— Надо думать, что теперь ему капут… сгинет вконец."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
