                        "sense_id": "a18dcf07-373a-3715-ac1e-a76b820b8cff",
                        "entry_id": "9dba3619-11da-39c8-9a7b-a384f4d8c4b1",
                        "glosses": [
                            "Fraxinus excelsior een soort loofboom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61414f02-369c-4f47-b05d-eea1541922f3",
                                "sense_id": "a18dcf07-373a-3715-ac1e-a76b820b8cff",
                                "text": "De eiken, berken, elzen en die ene essenboom zouden er nog zijn als ik er niet meer was."
                            },
                            {
                                "example_id": "095f32ba-5dc3-4c6b-b14d-928c63dce00e",
                                "sense_id": "a18dcf07-373a-3715-ac1e-a76b820b8cff",
                                "text": "Groot-Brittannië heeft een verbod uitgevaardigd op de import van essenbomen. De regering wil zo voorkomen dat de schimmelziekte chalara fraxinea zich verder verspreid. Het verbod gaat vandaag in."
                            }
                        ]
                    }
