                                                "sense_id": "1d37712b-936f-36c0-9eb4-a120f8933615",
                                                "text": "This call is operative not merely on the level of abstract theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f8c3d7-09bd-3936-8aef-5a5fe2957df7",
                                        "entry_id": "c6a40a62-def6-3686-88d1-e0ae6de92cce",
                                        "glosses": [
                                            "Producing the appropriate or designed effect; efficacious."
                                        ],
                                        "tags": [],
                                        "examples": [
