                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae6bd5-f99d-417e-96cc-d1266cbcf2b9",
                                                "sense_id": "8f892ee7-21b0-3def-89ab-4db2b34b724a",
                                                "text": "Cuando Miguel de Santiago volvió a aspirar el aire libre de la ciudad natal, su espíritu era ya presa del ascetismo de su siglo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
