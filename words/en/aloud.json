{
    "word_family": [
        "loud",
        "loudly",
        "loudness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7c871284-71e8-3d0b-bb07-f7db92c8ac0c",
                    "sense_definition": "In a voice that can be heard, rather than silently or in one's head.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "audibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the student to read the story <w>aloud</w> to the class.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика прочитать рассказ классу <w>вслух</w>.",
                                "zh": "老师让学生给全班同学<w>出声地</w>读了这个故事。"
                            }
                        },
                        {
                            "text": "Sometimes it helps to read <w>aloud</w> when you are trying to understand a difficult text.",
                            "target_lang_translations": {
                                "ru": "Иногда помогает чтение <w>вслух</w>, когда вы пытаетесь понять сложный текст.",
                                "zh": "当你试图理解一篇难懂的文章时，<w>出声地</w>朗读有时会有帮助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "audibly",
                        "out loud"
                    ],
                    "antonyms": [
                        "silently",
                        "quietly",
                        "mentally"
                    ],
                    "common_phrases": [
                        "read aloud",
                        "think aloud",
                        "speak aloud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Голосом, который можно услышать, а не про себя или в уме.",
                        "zh": "用可以听见的声音，而不是默读或在心里想。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вслух",
                                "target_lang_sense_clarification": "произнося слова голосом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出声地",
                                "target_lang_sense_clarification": "发出声音地"
                            },
                            {
                                "target_lang_word": "大声地",
                                "target_lang_sense_clarification": "能够被他人听见地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caaea191-5d09-3551-b2ad-72c2b03b601a",
                    "sense_definition": "With a strong or powerful volume; loudly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "audibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She laughed <w>aloud</w> at the funny joke her friend told.",
                            "target_lang_translations": {
                                "ru": "Она <w>громко</w> рассмеялась над смешной шуткой, которую рассказал её друг.",
                                "zh": "她听了朋友讲的笑话，<w>大声地</w>笑了出来。"
                            }
                        },
                        {
                            "text": "He cried <w>aloud</w> in pain after bumping his toe against the table.",
                            "target_lang_translations": {
                                "ru": "Он <w>громко</w> вскрикнул от боли, ударившись пальцем ноги о стол.",
                                "zh": "他的脚趾撞到桌子后，<w>大声地</w>痛叫了一声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loudly",
                        "vociferously"
                    ],
                    "antonyms": [
                        "softly",
                        "quietly"
                    ],
                    "common_phrases": [
                        "laugh aloud",
                        "cry aloud"
                    ],
                    "target_lang_definitions": {
                        "ru": "С большой силой звука; громко.",
                        "zh": "以很大的音量；响亮地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громко",
                                "target_lang_sense_clarification": "с сильным звуком"
                            },
                            {
                                "target_lang_word": "во весь голос",
                                "target_lang_sense_clarification": "очень громко"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大声地",
                                "target_lang_sense_clarification": "音量很大地"
                            },
                            {
                                "target_lang_word": "响亮地",
                                "target_lang_sense_clarification": "声音洪亮地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa70a2bb-d3fa-3a67-b3f7-673e1b11aeaa",
                    "sense_definition": "Spoken or produced with sound rather than being silent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "audibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your meditation practice can be <w>aloud</w> or it can be completely silent.",
                            "target_lang_translations": {
                                "ru": "Ваша медитация может проходить <w>вслух</w> или в полной тишине.",
                                "zh": "你的冥想练习可以是<w>有声的</w>，也可以是完全静默的。"
                            }
                        },
                        {
                            "text": "The prayer was <w>aloud</w>, filling the small room with a gentle humming sound.",
                            "target_lang_translations": {
                                "ru": "Молитва произносилась <w>вслух</w>, наполняя маленькую комнату нежным гулом.",
                                "zh": "祈祷是<w>有声的</w>，柔和的嗡嗡声充盈了整个小房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vocal",
                        "spoken"
                    ],
                    "antonyms": [
                        "silent",
                        "unspoken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносимый или создаваемый со звуком, а не бесшумный.",
                        "zh": "通过发声表达或产生，而不是静默的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вслух",
                                "target_lang_sense_clarification": "произносимый голосом"
                            },
                            {
                                "target_lang_word": "голосовой",
                                "target_lang_sense_clarification": "связанный с произнесением звуков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有声的",
                                "target_lang_sense_clarification": "伴随声音的"
                            },
                            {
                                "target_lang_word": "出声的",
                                "target_lang_sense_clarification": "非默读或静默的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}