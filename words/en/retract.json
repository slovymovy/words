{
    "word_family": [
        "retraction",
        "retractable",
        "retractor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a3ac01e-ae5e-39b3-bf6e-72a6b2221dad",
                    "sense_definition": "To pull something back or inside.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The airplane <w>retracts</w> its wheels immediately after taking off.",
                            "target_lang_translations": {
                                "cs": "Letadlo ihned po vzletu <w>zatáhne</w> podvozek.",
                                "pl": "Samolot <w>chowa</w> koła natychmiast po starcie."
                            }
                        },
                        {
                            "text": "The turtle will <w>retract</w> its head into its shell when it feels threatened.",
                            "target_lang_translations": {
                                "cs": "Když se želva cítí ohrožená, <w>vtáhne</w> hlavu do krunýře.",
                                "pl": "Żółw <w>wciągnie</w> głowę do skorupy, kiedy poczuje się zagrożony."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdraw"
                    ],
                    "antonyms": [
                        "extend",
                        "protrude"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zatáhnout nebo vtáhnout něco zpět nebo dovnitř.",
                        "pl": "Wciągnąć lub schować coś z powrotem do środka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vtáhnout",
                                "target_lang_sense_clarification": "pohyb dovnitř nebo zpět do prostoru"
                            },
                            {
                                "target_lang_word": "zatáhnout",
                                "target_lang_sense_clarification": "fyzické zatažení něčeho zpět"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chować",
                                "target_lang_sense_clarification": "np. podwozie lub pazury"
                            },
                            {
                                "target_lang_word": "wciągać",
                                "target_lang_sense_clarification": "np. głowę do skorupy lub brzuch"
                            },
                            {
                                "target_lang_word": "wciągnąć",
                                "target_lang_sense_clarification": "dokonana forma wciągania czegoś do środka"
                            },
                            {
                                "target_lang_word": "schować",
                                "target_lang_sense_clarification": "dokonana forma ukrycia lub wsunięcia czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221052eb-fb00-3983-b3d2-2ebd7d6893a2",
                    "sense_definition": "To take back or withdraw something that has been said or written.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper had to <w>retract</w> the false story about the politician.",
                            "target_lang_translations": {
                                "cs": "Noviny musely <w>odvolat</w> nepravdivý příběh o politikovi.",
                                "pl": "Gazeta musiała <w>odwołać</w> nieprawdziwy artykuł o polityku."
                            }
                        },
                        {
                            "text": "He refused to <w>retract</w> his statement despite the mounting evidence against him.",
                            "target_lang_translations": {
                                "cs": "Odmítl <w>odvolat</w> své prohlášení navzdory přibývajícím důkazům proti němu.",
                                "pl": "Odmówił <w>wycofania</w> swojego oświadczenia pomimo piętrzących się dowodów przeciwko niemu."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdraw",
                        "take back",
                        "recant",
                        "disavow"
                    ],
                    "antonyms": [
                        "affirm",
                        "confirm",
                        "maintain"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vzít zpět nebo odvolat něco, co bylo řečeno nebo napsáno.",
                        "pl": "Wycofać lub odwołać coś, co zostało powiedziane lub napisane."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odvolat",
                                "target_lang_sense_clarification": "prohlásit své předchozí tvrzení za neplatné"
                            },
                            {
                                "target_lang_word": "vzít zpět",
                                "target_lang_sense_clarification": "obecné vyjádření pro zrušení svého výroku"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odwołać",
                                "target_lang_sense_clarification": "uznać wcześniejsze oświadczenie za nieważne"
                            },
                            {
                                "target_lang_word": "wycofać",
                                "target_lang_sense_clarification": "zrezygnować ze swoich słów lub twierdzeń"
                            },
                            {
                                "target_lang_word": "cofnąć",
                                "target_lang_sense_clarification": "np. oświadczenie lub zarzuty"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec70b17b-e810-37da-ac0a-7d08531b6496",
                    "sense_definition": "An act of withdrawing a statement or mistake.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist issued a formal <w>retract</w> regarding the inaccurate report.",
                            "target_lang_translations": {
                                "cs": "Novinář vydal formální <w>odvolání</w> ohledně nepřesné reportáže.",
                                "pl": "Dziennikarz opublikował formalne <w>odwołanie</w> dotyczące niedokładnego reportażu."
                            }
                        },
                        {
                            "text": "The company published a <w>retract</w> to correct the misinformation in their advertisement.",
                            "target_lang_translations": {
                                "cs": "Společnost zveřejnila <w>opravu</w>, aby napravila dezinformace ve své reklamě.",
                                "pl": "Firma opublikowała <w>sprostowanie</w>, aby poprawić wprowadzające w błąd informacje w swojej reklamie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt odvolání tvrzení nebo přiznání chyby.",
                        "pl": "Akt odwołania wcześniejszego oświadczenia lub sprostowania błędu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odvolání",
                                "target_lang_sense_clarification": "formální akt zrušení předchozího tvrzení"
                            },
                            {
                                "target_lang_word": "oprava",
                                "target_lang_sense_clarification": "náprava chybných informací v textu"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odwołanie",
                                "target_lang_sense_clarification": "oficjalne wycofanie wcześniejszych słów"
                            },
                            {
                                "target_lang_word": "sprostowanie",
                                "target_lang_sense_clarification": "korekta błędnych informacji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}