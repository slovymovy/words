                                "target_senses": [
                                    {
                                        "sense_id": "ecf3d77e-40f9-3ae1-aa33-7d5cf8ef8693",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A hard external covering of an animal.",
                                            "The calcareous or chitinous external covering of mollusks, crustaceans, and some other invertebrates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f48ed6-3001-4a8e-aeb8-2bda1af7f678",
                                                "sense_id": "ecf3d77e-40f9-3ae1-aa33-7d5cf8ef8693",
                                                "text": "In some mollusks, as the cuttlefish, the shell is concealed by the animal's outer mantle and is considered internal."
                                            },
                                            {
                                                "example_id": "bb59622c-0f9b-452d-ae6c-37fd943b5f2f",
                                                "sense_id": "ecf3d77e-40f9-3ae1-aa33-7d5cf8ef8693",
                                                "text": "Genuine mother-of-pearl buttons are made from sea shells."
                                            },
                                            {
                                                "example_id": "a43c2792-15de-4418-a90e-7277893cdbfa",
                                                "sense_id": "ecf3d77e-40f9-3ae1-aa33-7d5cf8ef8693",
                                                "text": "[…] if with thee the roaring wells\n⁠Should gulf him fathom-deep in brine;\n⁠And hands so often clasp’d in mine,\nShould toss with tangle and with shells."
                                            }
                                        ]
                                    },
