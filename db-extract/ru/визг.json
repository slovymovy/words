                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kreischen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43972523-6f50-3ab8-b205-04684b805555",
                                        "entry_id": "e971bd01-0727-386b-b6b1-2fc60264605e",
                                        "glosses": [
                                            "lautes hohes (durchdringendes) Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a17846-d204-4637-9cb2-b7ec59fe1113",
                                                "sense_id": "43972523-6f50-3ab8-b205-04684b805555",
                                                "text": "„Kreischen, Grunzen, Hecheln, Aufschreien, Bellen - Wissenschaftler haben insgesamt zwölf verschiedene Lautäußerungen bei Schimpansen identifiziert.“"
                                            },
                                            {
                                                "example_id": "97a6fe56-d83d-43de-aed5-3410792d91c1",
                                                "sense_id": "43972523-6f50-3ab8-b205-04684b805555",
                                                "text": "„Eine ungebührliche Lärmerregung […] liegt vor, wenn im dicht verbauten Wohngebiet an einer Hausmauer mindestens acht indische Krähen (Beos) in einer Voliere gehalten werden, da die Beos beim Zusammenhalten mehrerer Tiere verstärkt eine Vielzahl von Lebensäußerungen im Form von Kreischen, Pfeifen und ähnlichen Geräuschen in beträchtlicher Lautstärke von sich geben.“"
                                            },
                                            {
                                                "example_id": "4277d465-99e9-4982-bd15-92eb683e04de",
                                                "sense_id": "43972523-6f50-3ab8-b205-04684b805555",
                                                "text": "„Er hatte sich jetzt warmgeredet, und sein Gefasel war so wohltuend wie das Kreischen eines Brettes, das im Sägewerk zersägt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af9bbde-483e-498c-b74d-e0313f5fc899",
                        "source_entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "source_sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "target_lang_word": "Gekreische",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gekreische",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "495e8930-8ad6-3c29-a707-30f94a1bd961",
                                        "entry_id": "8f185a1d-0257-3e44-b1f9-de6c3fc78a8c",
                                        "glosses": [
                                            "großer Lärm durch anhaltendes Kreischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d0df4f-99db-40f0-826b-10696f1b4150",
                                                "sense_id": "495e8930-8ad6-3c29-a707-30f94a1bd961",
                                                "text": "„Lautes Gekreische brandete auf und senkte sich in Kaskaden von den Rängen auf die Bühne herab, wo die fünf Backstreet Boys so munter und gut gelaunt herum standen, als würden sie gerade duschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef004b93-5131-4e89-a835-0cc1cfa31815",
                        "source_entry_id": "f09c6820-65dd-3d49-b997-797ba824d032",
                        "source_sense_id": "7984e6d8-7f9e-3b6a-b2b3-9e7d8524d45b",
                        "target_lang_word": "glapissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glapissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7411fbc-1c88-3377-9d0b-e70dc6daf0b5",
                                        "entry_id": "94f2716e-76a2-3797-a2dc-53508f1e824a",
                                        "glosses": [
                                            "Cri aigu que fait entendre un animal qui glapit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "548cb9f8-c308-4137-89ee-6e90d05a5563",
                                                "sense_id": "a7411fbc-1c88-3377-9d0b-e70dc6daf0b5",
                                                "text": "Le rugissement des lions, le hennissement des chevaux, le braiement des ânes, le bêlement des béliers, le mugissement des taureaux, le grognement des cochons, des sangliers et des verrats, le raîment des cerfs, la voix grêle des gazelles, le murmure amoureux des rongeurs, les cris inarticulés des singes, les hautes clameurs des alouettes, le triste hurlement des hyènes, le glapissement des renards, le gromellement des blaireaux, &c. ; enfin tous ces accens divers dont résonnent les forêts et les déserts sauvages, ne sont dans les animaux que l’expression des desirs^([sic]) d’amour."
                                            },
                                            {
                                                "example_id": "621681f7-a076-485e-9eaa-d849b2d834a2",
                                                "sense_id": "a7411fbc-1c88-3377-9d0b-e70dc6daf0b5",
                                                "text": "[…], je passe une nuit excellente dans mon lit de camp, et mon long sommeil réparateur n’est interrompu que pendant quelques instants par des aboiements furibonds répondant aux glapissements lointains d’un chacal."
                                            },
                                            {
                                                "example_id": "bc0ac5a6-d876-4755-a893-a7ba63ae0a7d",
                                                "sense_id": "a7411fbc-1c88-3377-9d0b-e70dc6daf0b5",
                                                "text": "Le cajolement du geai se mêlait au croassement de la corneille ; dès les premiers signes de l’automne, leur chant couvrait le glapissement lugubre des grues qui descendaient vers le sud, se déployant en un vol fluide et ondulant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6322beb6-370d-3005-b43b-14e8351b43b8",
                                        "entry_id": "94f2716e-76a2-3797-a2dc-53508f1e824a",
                                        "glosses": [
                                            "Cri humain de même tonalité."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c893d6e6-a40f-4ea6-a574-44073b50e821",
                                                "sense_id": "6322beb6-370d-3005-b43b-14e8351b43b8",
                                                "text": "Le Carcan rentrait des champs ; il fut mis au courant de l’affaire et bientôt mêla son organe tonitruant aux glapissements de sa conjointe."
                                            },
                                            {
                                                "example_id": "198d61f3-2c56-4e23-9292-2d4db9766121",
                                                "sense_id": "6322beb6-370d-3005-b43b-14e8351b43b8",
                                                "text": "Allumant France-Inter, il tomba sur une émission qui décortiquait l’actualité culturelle de la semaine ; les chroniqueurs s’esclaffaient bruyamment, leurs glapissements convenus et leurs rires étaient d’une vulgarité insoutenable."
                                            },
                                            {
                                                "example_id": "53c15797-9b90-4ee9-98ec-bb325bd731e3",
                                                "sense_id": "6322beb6-370d-3005-b43b-14e8351b43b8",
                                                "text": "Rien ne lui échappait : le susurrement sucré de la jeune vedette héroïne, le parler guttural du caïd sans scrupules, les nasillements du faux-frère, les jacassements de la commère, le jargon du bellâtre amoureux, [..] les glatissements du foudre de guerre, les glapissements de la grue de service, les piaillements de la valetaille, les gloussements de la poule émoustillée, les hôlements du maître-chanteur, les frigottements de sa victime […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
