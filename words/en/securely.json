    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bb0ba900-94cd-3ecc-9321-e21ae0362e41",
                    "sense_definition": "In a way that is safe, firm, or tight, so that something is not likely to be lost, moved, or broken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "safety and stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure that your seatbelt is <w>securely</w> fastened before the plane takes off.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что ваш ремень безопасности <w>надёжно</w> пристегнут перед взлетом самолета."
                            }
                        },
                        {
                            "text": "The heavy boxes were <w>securely</w> stowed in the back of the truck to prevent them from sliding.",
                            "target_lang_translations": {
                                "ru": "Тяжелые коробки были <w>надёжно</w> уложены в кузове грузовика, чтобы они не скользили."
                            }
                        },
                        {
                            "text": "You should store your passport <w>securely</w> in the hotel safe while you are at the beach.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>безопасно</w> хранить свой паспорт в сейфе отеля, пока вы находитесь на пляже."
                            }
                        }
                    ],
                    "synonyms": [
                        "safely"
                    ],
                    "antonyms": [
                        "insecurely",
                        "loosely"
                    ],
                    "common_phrases": [
                        "securely fastened",
                        "securely stowed",
                        "securely attached",
                        "locked securely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способом, обеспечивающим безопасность, прочность или плотность прилегания, чтобы вещь не потерялась, не сдвинулась и не сломалась."
                    },
                    "translations": {
                        "ru": [
                            {
