{
    "word_family": [
        "priser",
        "prisable",
        "dépriser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b22c2c8e-ce8c-332f-a43f-68054af0b21a",
                    "sense_definition": "Somme d'argent nécessaire pour acquérir une chose ou bénéficier d'un service.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quel est le <w>prix</w> de ce manteau bleu affiché en vitrine ?"
                        },
                        {
                            "text": "Ce magasin propose des articles de qualité à un <w>prix</w> très abordable."
                        }
                    ],
                    "synonyms": [
                        "coût",
                        "montant",
                        "tarif"
                    ],
                    "common_phrases": [
                        "bas prix",
                        "hausse des prix",
                        "prix coûtant",
                        "prix d'ami"
                    ]
                },
                {
                    "sense_id": "791caabd-7eed-35d1-a42b-3d549d4414c0",
                    "sense_definition": "Récompense accordée au vainqueur d'une compétition, d'un concours ou pour honorer un mérite particulier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écrivaine a reçu un prestigieux <w>prix</w> pour son dernier roman."
                        },
                        {
                            "text": "Il a remporté le premier <w>prix</w> de ce concours de dessin à l'école."
                        }
                    ],
                    "synonyms": [
                        "distinction",
                        "récompense",
                        "trophée"
                    ],
                    "common_phrases": [
                        "premier prix",
                        "prix Nobel",
                        "remise des prix"
                    ]
                },
                {
                    "sense_id": "ed96a29c-abb8-3cd9-8ebe-bb229c73a4df",
                    "sense_definition": "Sacrifice ou conséquence pénible qu'il faut assumer pour obtenir quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sacrifice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a réussi cet examen difficile au <w>prix</w> de nombreuses nuits de travail."
                        },
                        {
                            "text": "Le succès ne doit jamais s'obtenir au <w>prix</w> de sa propre santé."
                        }
                    ],
                    "synonyms": [
                        "coût",
                        "rançon"
                    ],
                    "common_phrases": [
                        "au prix de",
                        "payer le prix",
                        "à tout prix"
                    ]
                },
                {
                    "sense_id": "91475f7e-b49d-3e77-a587-d2a9ac6d811c",
                    "sense_definition": "Compétition sportive ou épreuve au cours de laquelle les concurrents disputent une récompense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote a remporté ce grand <w>prix</w> automobile après une course intense."
                        },
                        {
                            "text": "Plusieurs cavaliers se disputent ce <w>prix</w> prestigieux sur le circuit équestre."
                        }
                    ],
                    "synonyms": [
                        "compétition",
                        "course",
                        "épreuve"
                    ],
                    "common_phrases": [
                        "Grand Prix"
                    ]
                },
                {
                    "sense_id": "c8494282-af2d-30fa-8e72-53074fcfe989",
                    "sense_definition": "Valeur morale, estime ou grande importance affective accordée à quelqu'un ou à quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "valeur_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Votre soutien indéfectible a un <w>prix</w> inestimable à mes yeux."
                        },
                        {
                            "text": "Il attache beaucoup de <w>prix</w> aux conseils bienveillants de ses professeurs."
                        }
                    ],
                    "synonyms": [
                        "mérite",
                        "valeur"
                    ],
                    "common_phrases": [
                        "attacher du prix",
                        "avoir du prix"
                    ]
                },
                {
                    "sense_id": "bc18d12e-9505-3ba9-b0aa-4812052a9dc3",
                    "sense_definition": "Personne ou ouvrage ayant remporté une récompense ou une distinction renommée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chercheur reconnu est un <w>prix</w> Nobel de médecine depuis l'an dernier."
                        },
                        {
                            "text": "Le jeune musicien est un premier <w>prix</w> du Conservatoire de Paris."
                        }
                    ],
                    "synonyms": [
                        "lauréat"
                    ]
                },
                {
                    "sense_id": "b529b11f-8149-344d-bf82-7bbb5c85eacb",
                    "sense_definition": "Châtiment ou punition subie en conséquence directe d'une faute ou d'un méfait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sacrifice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coupable a finalement reçu le juste <w>prix</w> de ses trahisons répétées."
                        },
                        {
                            "text": "Cette défaite cuisante fut le triste <w>prix</w> de son imprudence et de son orgueil."
                        }
                    ],
                    "synonyms": [
                        "châtiment",
                        "expiation",
                        "salaire"
                    ]
                }
            ]
        }
    ]
}