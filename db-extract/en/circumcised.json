                                                "sense_id": "0c996d01-8aca-31a3-9b90-364c503f6007",
                                                "text": "À mort, le Turc ! À mort, le pourceau circoncis !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2357d4a-d51e-3fe4-9565-403af3cd4be1",
