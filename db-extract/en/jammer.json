                                                "sense_id": "8237f9a5-13d6-3149-9a05-4ac81796bedb",
                                                "text": "Es ist ein Jammer, in welchem Zustand das Haus nun ist."
                                            },
                                            {
                                                "example_id": "6924f18e-031b-4cc1-8415-4e6a47944fd5",
                                                "sense_id": "8237f9a5-13d6-3149-9a05-4ac81796bedb",
