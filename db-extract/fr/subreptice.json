                                    {
                                        "sense_id": "4a7db53c-901c-390d-9358-42d9ee8b9a4c",
                                        "entry_id": "ba00b995-ccc9-35bf-bc06-39ac038463d2",
                                        "glosses": [
                                            "Stealthy, furtive, well hidden, covert (especially movements)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e5f522-df07-46f2-83a4-f91efc462547",
                                                "sense_id": "4a7db53c-901c-390d-9358-42d9ee8b9a4c",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            },
                                            {
                                                "example_id": "b91e4b82-e674-455b-af80-fe192a4c92aa",
                                                "sense_id": "4a7db53c-901c-390d-9358-42d9ee8b9a4c",
                                                "text": "It is also worth noting the case law on prisoners' correspondence which establishes that interception of a person's communications need not be surreptitious in order to amount to an interference with respect to Art 8 (1) [ECHR]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "177a2f96-964e-40cb-a0cc-384017e97b08",
                        "source_entry_id": "8fa20b8b-19a1-35ab-835b-94fe8303719b",
                        "target_lang_word": "heimelijk",
