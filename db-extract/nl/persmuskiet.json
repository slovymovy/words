                                    {
                                        "sense_id": "a30e5f85-bc4f-3a0f-8377-3347a4a71585",
                                        "entry_id": "3c8fab0a-5322-392e-adb2-c1f34a6d7760",
                                        "glosses": [
                                            "A keen investigative reporter."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf29cff-445a-4da8-a741-b6c527f46356",
                                                "sense_id": "a30e5f85-bc4f-3a0f-8377-3347a4a71585",
                                                "text": "You didn’t have to peek out the door to know who was tearing her heart out in the street, keening over her dead brother even while the cops and newshawks were on their way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
