                        "form": "die Arbeiterschaft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54efb57f-85b8-312b-8171-9e362ee848fe",
                        "entry_id": "7e1f283d-983d-382f-889e-3bd25cba068e",
                        "glosses": [
                            "Kollektiv der Arbeiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6efed4-a41d-4efb-b38b-81b63c4770df",
                                "sense_id": "54efb57f-85b8-312b-8171-9e362ee848fe",
                                "text": "„Wir haben kein Recht, die Arbeiterschaft zu einem Kampf aufzurufen, der zur sicheren Niederlage, zu sinnlosem Blutvergießen führt.“"
                            },
                            {
                                "example_id": "8f366ae7-d960-4caa-aaeb-c7feac2a637a",
                                "sense_id": "54efb57f-85b8-312b-8171-9e362ee848fe",
                                "text": "„Die extreme Armut in der zu Ende gehenden Monarchie, die schweren Lebensbedingungen der Arbeiterschaft, besonders der Frauen in den Ziegelfabriken und der Heimarbeiterinnen, veranlassen sie zu ihrem sozialpolitischen Engagement.“"
                            },
                            {
                                "example_id": "c45af7a0-ef2a-4487-b697-c4165f572865",
                                "sense_id": "54efb57f-85b8-312b-8171-9e362ee848fe",
                                "text": "„Die ZANLA setzte wie Mao auf die Bauern als Träger der Revolution statt auf die städtische Arbeiterschaft, wie es der klassische Marxismus tat.“"
                            },
                            {
                                "example_id": "ba0aace5-79e1-4faa-b9d0-87e113d4f815",
                                "sense_id": "54efb57f-85b8-312b-8171-9e362ee848fe",
                                "text": "„Verelendet die Arbeiterschaft eines Landes, hat das negative Auswirkungen auf die großen Unternehmen, die auf gesunde, relativ zufriedene Lohnempfänger angewiesen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
