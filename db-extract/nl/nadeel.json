                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désavantage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e383107-9e2f-3e29-b79b-c107d8a8c94c",
                                        "entry_id": "a4961a24-da47-3aca-8df3-09d894706b3a",
                                        "glosses": [
                                            "Infériorité en quelque genre que ce soit qui empêche de réussir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c2ea8e-0aa9-4f00-b63d-9617af459738",
                                                "sense_id": "2e383107-9e2f-3e29-b79b-c107d8a8c94c",
                                                "text": "Il était fils unique d’un homme riche, et il faut bien des années pour effacer ce désavantage, si envié par la plupart des hommes."
                                            },
                                            {
                                                "example_id": "c7fe881d-f190-4ee2-b898-cf36ebf1779f",
                                                "sense_id": "2e383107-9e2f-3e29-b79b-c107d8a8c94c",
                                                "text": "Le crépuscule a partout la même transparence: on ne peut deviner de quel côté s'est couché le soleil, et l'armée française, qui sait si mal s'orienter, n'en a point ce soir le désavantage."
                                            },
                                            {
                                                "example_id": "7a9a997a-53e9-4e5e-b52f-785464dc5b49",
                                                "sense_id": "2e383107-9e2f-3e29-b79b-c107d8a8c94c",
                                                "text": "Voyez bien, avant de vous déterminer, les avantages et les désavantages de la situation que l’on vous offre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a2804aa-38a2-3263-96b6-5f54824db0dd",
                                        "entry_id": "a4961a24-da47-3aca-8df3-09d894706b3a",
                                        "glosses": [
                                            "Préjudice, dommage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f9bacd-a6c5-4395-88ab-4b4e373d9e7e",
                                                "sense_id": "7a2804aa-38a2-3263-96b6-5f54824db0dd",
                                                "text": "On ne fera rien à votre désavantage."
                                            },
                                            {
                                                "example_id": "1d539a97-bc78-452f-8cb0-a7006d76e5fb",
                                                "sense_id": "7a2804aa-38a2-3263-96b6-5f54824db0dd",
                                                "text": "L’affaire a tourné à leur désavantage."
                                            }
                                        ]
                                    }
                                ]
                            },
