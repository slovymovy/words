                                        "sense_id": "fe7da560-dde8-3e9a-9432-7cfb74f3fe09",
                                        "entry_id": "6bba940f-2fe4-34c6-b694-ee3f11a330a5",
                                        "glosses": [
                                            "iets dat getuigt van te grote vasthoudendheid"
                                        ],
                                        "tags": [],
                                        "examples": []
