                                                "sense_id": "1e1f78dd-c162-3425-8c71-c2ca814f6106",
                                                "text": "the cheese hoop, or cylinder in which the curd is pressed in making cheese"
                                            },
                                            {
                                                "example_id": "c0eae92f-cc8a-42fa-a83a-0249d4551ae3",
                                                "sense_id": "1e1f78dd-c162-3425-8c71-c2ca814f6106",
