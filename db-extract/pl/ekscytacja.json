                    {
                        "translation_id": "155c2447-7a1e-43d9-98fe-a06e382fce2f",
                        "source_entry_id": "eb804fb8-3a63-3294-ac84-c8e2dccff8fc",
                        "source_sense_id": "2a56fe6d-5eed-3bb0-a29e-3710f85a7781",
                        "target_lang_word": "concitazione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concitazione",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3f5e6d-aea3-3d21-8915-d1b2c02f3947",
                                        "entry_id": "e35cc95c-1740-30e9-9004-d2f4cb8286c1",
                                        "glosses": [
                                            "trasporto emotivo, talvolta quasi incontenibile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a4291a-310d-4389-b03d-dc22a7559b73",
                                                "sense_id": "5f3f5e6d-aea3-3d21-8915-d1b2c02f3947",
                                                "text": "in uno stato non del tutto consapevole, avviene appunto che una concitazione sia dovuta ad un'illusione per cui invero si è perplessi"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85129001-02dd-3fdd-a35c-d8741afad0f7",
                                        "entry_id": "e35cc95c-1740-30e9-9004-d2f4cb8286c1",
                                        "glosses": [
                                            "veloce battito del cuore di qualcuno tale da far sopravvenire in modo quasi estremo una condizione propria, negativa ma in genere invece per lo più positiva, comunque precedentemente potenziale"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36149f2-806c-46d1-aebb-c7bd68cca5c5",
                                                "sense_id": "85129001-02dd-3fdd-a35c-d8741afad0f7",
                                                "text": "pur se già conosciuta, vivere ogni cosa buona come se fosse nuova, permette di giungere ad una concitazione sana, ammirevole, apprezzata e di sollievo pressoché estatico"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb9d104-8e0b-3121-a89c-6076ca35a62d",
                                        "entry_id": "e35cc95c-1740-30e9-9004-d2f4cb8286c1",
                                        "glosses": [
                                            "clamore di più persone assieme"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dfd4e6a-65bf-4406-9717-1b493244aa06",
                                                "sense_id": "5eb9d104-8e0b-3121-a89c-6076ca35a62d",
                                                "text": "Ai mondiali di calcio in cui l'Italia era favorita, d'improvviso il cronista: \"La concitazione per l'evento sportivo dell'anno è evidente, signori!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b5596d1-8559-4721-9811-268e8c019878",
                        "source_entry_id": "eb804fb8-3a63-3294-ac84-c8e2dccff8fc",
