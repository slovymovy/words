                ],
                "senses": [
                    {
                        "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                        "entry_id": "f2621fbd-28c6-3d24-adf9-33016d240a61",
                        "glosses": [
                            "ein nicht-theologischer Lehrstuhl an einer staatlichen Universität in der Bundesrepublik Deutschland (vor allen Dingen in Bayern), bei dessen Besetzung die römisch-katholische Kirche in die Entscheidungsfindung mit einbezogen wird"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6fe4a9-de6f-4c0e-95ed-5a22e91aaf68",
                                "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                                "text": "„Klotz stellte den großen Vorteil für die Bayernpartei heraus, wenn ein mit hoher kirchlicher Zustimmung auf den wichtigen Würzburger Konkordatslehrstuhl für Geschichte berufener Professor Kultusminister werden würde, […]“"
                            },
                            {
                                "example_id": "095064b3-5815-408d-b895-a9fdb7c74a3b",
                                "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                                "text": "„Schließlich war man auch in München bemüht, den Konkordatslehrstuhl von Rintelens weiter von einem Philosophen vertreten zu lassen.“"
                            },
                            {
                                "example_id": "d1f16d75-ab73-4cec-bac7-e98f6889b538",
                                "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                                "text": "„Nur ein einziger Protestant hatte 2007 in Bayern einen Konkordatslehrstuhl inne, aber der war katholisch verheiratet und hatte sich verpflichtet, seine Kinder katholisch zu erziehen.“"
                            },
                            {
                                "example_id": "c716f647-de2a-4275-bb3f-d4e16af7e7a2",
                                "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                                "text": "„Um den Protestanten Hermann Heimpel auf den ebenfalls vakanten Konkordatslehrstuhl für Mittelalterliche Geschichte berufen zu können, entschloß sich das Ministerium Ende 1945, die Konkordatsbindung kurzerhand auf den Lehrstuhl für Mittlere und Neue Geschichte zu übertragen, den der Katholik Schnabel erhalten sollte.“"
                            },
                            {
                                "example_id": "6b22657e-40ad-44ec-a609-608de1c66920",
                                "sense_id": "8e57c74b-93bb-32fa-adee-3cc351ab2600",
                                "text": "„Sein Lehrstuhl wurde 1978 vom Bayerischen Staat in einen Konkordatslehrstuhl umgewandelt, womit entschieden war, daß sein Nachfolger Katholik sein und der Bischof von Bamberg seine Einwilligung zur Berufung geben mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
