                    "frequency": "Middle",
                    "semantic_group_id": "forme_convexe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soldat se tient droit et <w>bombe</w> le torse avec une grande fierté devant ses camarades."
                        },
                        {
