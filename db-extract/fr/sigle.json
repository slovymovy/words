                                                "example_id": "528dde44-2341-429f-abdc-281f77aa64dd",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Some teachers festoon every spare inch of wall with vocabulary choices or maths techniques to use, which look great at first, but to some children might appear quite daunting. You'll probably see unfamiliar acronyms such as Walt (We Are Learning To). Be sure to ask what they stand for and how they are used in practice."
                                            },
                                            {
                                                "example_id": "d51ee229-a35f-480c-993a-eada4ce53cd0",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Traders have reportedly come up with the acronym TACO, which stands for “Trump always chickens out,” to take advantage of the trade environment created by the president’s habit of threatening to impose tariffs on countries, and then backing off at the last moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the beginning letters or syllables of other words (as \\\"Benelux\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54a5f48-efbf-42ed-950f-55493fd665e2",
                                                "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                                "text": "Acronyms or telescoped names like nabisco from National Biscuit Company."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d6d3a1-1a41-37c2-9b6c-3ffbb4936f6c",
                                        "entry_id": "a67936bd-d1d4-37b8-9350-48e1e0c5813f",
                                        "glosses": [
                                            "To form into an acronym."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
