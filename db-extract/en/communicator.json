                                        "glosses": [
                                            "Qui met en communication, qui communique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923cfcbe-0041-40d9-802f-9b7c3f022342",
                                                "sense_id": "9ac6bb1a-bfaa-3d19-9f34-445f4ea0b675",
                                                "text": "La voilà déjà [Mme Guyon], dans son opinion, communicatrice des grâces."
