                ],
                "senses": [
                    {
                        "sense_id": "8a254977-b0aa-3639-8ea6-f161d40dcd74",
                        "entry_id": "26bd34a5-68ec-3601-a48f-eafcb1f9397f",
                        "glosses": [
                            "Fett, dass von Tieren stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5a93d6-7453-407a-bb1f-2407b5cb1e0f",
                                "sense_id": "8a254977-b0aa-3639-8ea6-f161d40dcd74",
                                "text": "„Sie sahen denn auch gar nicht ein, warum die bei der Einführung eines neuen Gewehrs verteilten Patronen, die Schutzhülsen hatten, die mit Tierfett eingeschmiert waren, die indischen Soldaten in Gewissensnöte brachten.“"
                            },
                            {
                                "example_id": "f3f989d6-ecd2-48a2-99c8-ef085c0da46d",
                                "sense_id": "8a254977-b0aa-3639-8ea6-f161d40dcd74",
                                "text": "„Der Anlass - so banal dieser auch klingen mag - zeigt, wie sehr in Südasien kulturelle Aspekte eine Rolle spielen: Die Briten hatten ein neues Gewehr eingeführt, dessen Patronen mit Tierfett geschmiert waren.“"
                            },
                            {
                                "example_id": "098df348-81d0-4444-a0d8-ac34b0d40222",
                                "sense_id": "8a254977-b0aa-3639-8ea6-f161d40dcd74",
                                "text": "„Man muss nur Tierfett mit der Asche von verbrannten Blättern heiß machen un dann einkochen lassen, bis das da übrig is.“"
                            },
                            {
                                "example_id": "0c92279f-7918-4f8e-b588-642084eb52e4",
                                "sense_id": "8a254977-b0aa-3639-8ea6-f161d40dcd74",
                                "text": "„Die Tierfette stammen vom Rind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
