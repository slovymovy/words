                "senses": [
                    {
                        "sense_id": "06f13ab2-aa2d-31fc-bde6-1e7ef2858b72",
                        "entry_id": "21e8f340-0d68-3a56-9cc5-e6c844b097ca",
                        "glosses": [
                            "Faire subir un 4-0 à un adversaire dans une série."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84642bdb-c921-4053-8dbf-0e0435d675d4",
                                "sense_id": "06f13ab2-aa2d-31fc-bde6-1e7ef2858b72",
                                "text": "Pratiquement condamnés à se faire «sweeper» (encaisser un 4-0 dans une série) et de voir Golden State célébrer leur titre dans leur vestiaire, les coéquipiers de LeBron James ont sorti une prestation de haut vol et ont complètement étouffé les Californiens (137-116)."
                            },
                            {
                                "example_id": "41d70a78-d2e5-493b-a537-f1b6f2acdbc8",
                                "sense_id": "06f13ab2-aa2d-31fc-bde6-1e7ef2858b72",
                                "text": "Ce qui est triste, c'est que les Cavs ont sweepé les Hawks sans jouer au basket."
                            },
                            {
                                "example_id": "e3a59b36-a5b9-4426-b2e1-1407eeb223cd",
                                "sense_id": "06f13ab2-aa2d-31fc-bde6-1e7ef2858b72",
                                "text": "Les équipes de LeBron James ont sweepé leur premier adversaire en playoffs lors des quatre dernières années."
                            }
                        ]
                    }
