                                        "glosses": [
                                            "Zeitung mit sehr auffälliger Aufmachung, die sich vor allem mit Trivialthemen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80ae604-b079-4cc1-b81a-8df123bba253",
                                                "sense_id": "fcb14167-6b91-3175-bb56-01e6b51e19cf",
                                                "text": "„Ein Held wie er im Bilderbuch oder Deutschlands größtem Boulevardblatte steht: ‚Magic Baggio‘, barbusig abgelichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
