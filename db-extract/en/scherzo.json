                        "glosses": [
                            "A piece of music or a movement from a larger piece such as a symphony; especially, a piece of music played in a playful manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df2e8a84-b1a0-4062-9a11-a3040b492b68",
                                "sense_id": "9f0f4879-d5bf-3b56-a79b-d31026f84e0b",
                                "text": "At seven Val knocked – three shorts and one long, out of the scherzo of Beethoven’s Fifth – and I rushed to open."
                            }
                        ]
                    }
                ],
