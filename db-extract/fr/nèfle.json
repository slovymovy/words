        "fr-extract.jsonl": [
            {
                "entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                "word": "nèfle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4aedf43-f3a3-431b-a8f3-93f382cd5768",
                        "entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                        "tags": [
                            "plural"
                        ],
                        "form": "nèfles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02fbe766-077d-30f6-b6b4-e5a70735dbff",
                        "entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                        "glosses": [
                            "Fruit comestible du néflier (Mespilus germanica) charnu en forme de toupie déprimée au sommet et surmontée des cinq dents persistantes du calice. C’est un piridion : la chair entoure cinq noyaux qui contiennent de l’acide cyanhydrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308ad887-38a5-443e-a5c2-fca5ea878611",
                                "sense_id": "02fbe766-077d-30f6-b6b4-e5a70735dbff",
                                "text": "Mais la récolte faite, les cerises passées, venait le tour des pêches, puis les raisins, et après les raisins ces belles nèfles brunes qu’on cueille presque sous la neige."
                            },
                            {
                                "example_id": "fb38e2ba-81d2-4cb7-96a0-dca1f080b550",
                                "sense_id": "02fbe766-077d-30f6-b6b4-e5a70735dbff",
                                "text": "Comme l’âme est par vous blessée et parfumée,\nTriste Automne, couleur de nèfle et de fumée !…"
                            },
                            {
                                "example_id": "7437f2a6-66c2-4539-8754-3731b967e2e8",
                                "sense_id": "02fbe766-077d-30f6-b6b4-e5a70735dbff",
                                "text": "La nèfle est de peu d’agrément : de saveur terne comme de chair ; molle sous la dent comme sous le doigt […] Tout de même, l’hiver, quand le « cabinet » est vide, la vaste armoire où l’on couche ici les fruits sur lit de paille, elle donne quelque illusion, elle apporte comme un arrière-goût des pulpes parfumées."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb79084f-4e85-32bc-bd6b-99a477ea674d",
                        "entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                        "glosses": [
                            "Synonyme de nèfle du Japon, fruit du néflier du Japon (Eriobotrya japonica)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b376b367-dbd9-4864-aa94-5e34fad607d1",
                                "sense_id": "bb79084f-4e85-32bc-bd6b-99a477ea674d",
                                "text": "C’était à cette saison où les fruit d’or des nèfles mûrissaient parmi les feuilles épaisses, à cette saison où le lourd brouillard recouvrait les champs de fève et de moutarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "19da67e6-e3c6-3357-97a4-f5fd1ac241fd",
                        "entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                        "glosses": [
                            "Rien ou peu de chose."
                        ],
                        "tags": [
                            "colloquial",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "59c45e22-1b0b-47b6-aa95-135d7e18b9be",
                                "sense_id": "19da67e6-e3c6-3357-97a4-f5fd1ac241fd",
                                "text": "Toutes ces nuits de planque dans des bagnoles pourraves alors que vous pétiez dans la soie, ces centaines de crevures arrêtées et aussitôt relâchés par des juges à la mords moi le nœud. Qu’est-ce que j’y ai gagné ? Des nèfles !"
                            },
                            {
                                "example_id": "ed7fd11a-aa4e-43aa-a1f3-7ca4e222e4bc",
                                "sense_id": "19da67e6-e3c6-3357-97a4-f5fd1ac241fd",
                                "text": "– Ça donne quoi chez vous ?\n – Des nèfles ! À les entendre, tous des enfants de chœur ! Du coup, on bertillonne ! Ce sera toujours des archives pour l’identification !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6acfb52a-0a11-4b16-b64e-653814f78987",
                        "source_entry_id": "313f0a06-f14a-3bbf-96fa-815efe912e11",
                        "target_lang_word": "Mispel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mispel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2009b290-962e-3597-8a90-c45c6ba8e0d5",
                                        "entry_id": "38d46c39-6181-31ea-b29e-e0e302a8bd8c",
                                        "glosses": [
                                            "die Pflanzengattung Mespilus (deutsch: Mispeln)"
                                        ],
                                        "tags": [
                                            "Biologische Taxonomie, im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca04d6e5-be7d-4991-ab86-b8b9bbaf3edf",
                                                "sense_id": "2009b290-962e-3597-8a90-c45c6ba8e0d5",
                                                "text": "Von der Birne abgesehen, braucht nur der Weißdorn und die Mispel genannt zu werden, die fast ebenso große herrliche Blüten besitzt wie der Apfelbaum."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ed2c951-5034-34a8-8cd9-7d76b7f0212f",
                                        "entry_id": "38d46c39-6181-31ea-b29e-e0e302a8bd8c",
                                        "glosses": [
                                            "aus Vorderasien stammender, bis zu fünf Meter hoher Baum mit großen, weißen Blüten und orangen Früchten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77bcc787-66b9-4185-96f6-ab6c72cd26a8",
                                                "sense_id": "6ed2c951-5034-34a8-8cd9-7d76b7f0212f",
                                                "text": "Von der Birne abgesehen, braucht nur der Weißdorn und die Mispel genannt zu werden, die fast ebenso große herrliche Blüten besitzt wie der Apfelbaum."
                                            },
                                            {
                                                "example_id": "39183c63-cca6-4676-a3d2-56f87a7eeab6",
                                                "sense_id": "6ed2c951-5034-34a8-8cd9-7d76b7f0212f",
                                                "text": "Im Mittelalter wurde die Mispel bei uns in Klostergärten, Bauerngärten und auf Streuobstwiesen angebaut."
                                            },
                                            {
                                                "example_id": "acb23ed0-a8da-4508-8244-9b0ccca49fb3",
                                                "sense_id": "6ed2c951-5034-34a8-8cd9-7d76b7f0212f",
                                                "text": "Ein Hof im Stil der Alhambra mit Wasserspielen, Mispeln und Palmen hinter blau-weiß gekachelten Mauern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c983fe1-aa53-3f15-9c53-5ba503dff7e1",
                                        "entry_id": "38d46c39-6181-31ea-b29e-e0e302a8bd8c",
                                        "glosses": [
                                            "apfelförmige Frucht von [1] mit säuerlichem, aromatischem Geschmack, die erst im überreifen Zustand essbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703af8ad-9e7d-45a8-a884-294ae8298200",
                                                "sense_id": "9c983fe1-aa53-3f15-9c53-5ba503dff7e1",
                                                "text": "Das Dessert in Pepas Restaurant ist bereits Ausdruck eines neuen Selbstbewusstseins: Nísperos, Mispeln mit Fenchelschaum und Safran-Eis."
                                            },
                                            {
                                                "example_id": "3614af14-345a-4284-9f56-c571161e24ae",
                                                "sense_id": "9c983fe1-aa53-3f15-9c53-5ba503dff7e1",
                                                "text": "Nach längerer Aufbewahrung wird die Gerbsäure in den Mispeln abgebaut, sie werden weich, musartig und schmecken aromatisch-fruchtig."
                                            },
                                            {
                                                "example_id": "a7063425-ed4f-45e5-9608-3b1518a02344",
                                                "sense_id": "9c983fe1-aa53-3f15-9c53-5ba503dff7e1",
                                                "text": "Die Mispel und der Spierling sind herb, wenn man sie pflückt: Ein wenig Streu und Harren, und ihre Reife glückt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
