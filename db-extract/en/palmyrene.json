                "senses": [
                    {
                        "sense_id": "66f6370d-b7cc-3b90-b709-95df3a64f5a5",
                        "entry_id": "642360b7-0587-38fa-bb14-cedbd3ce431e",
                        "glosses": [
                            "An extinct Western Aramaic dialect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93b9661f-30f9-4528-9e1d-5e9631c41af8",
                                "sense_id": "66f6370d-b7cc-3b90-b709-95df3a64f5a5",
                                "text": "The first panel is a bilingual text in Greek and Palmyrene, the second entirely in Palmyrene, and the third and fourth entirely in Greek."
                            },
                            {
                                "example_id": "991ef3a9-cdf3-44c0-a5b4-bb117dbf28da",
                                "sense_id": "66f6370d-b7cc-3b90-b709-95df3a64f5a5",
                                "text": "In one such inscription, Odaenathus is referred to in Palmyrene simply as Ras Tadmor without any indicators of Roman rank."
                            },
                            {
                                "example_id": "481a9e33-6b84-4b0b-b0c8-0456346b2040",
                                "sense_id": "66f6370d-b7cc-3b90-b709-95df3a64f5a5",
                                "text": "The auxiliaries also occasionally left behind bilingual dedications in Palmyrene with Greek or Latin."
                            }
                        ]
                    }
                ],
