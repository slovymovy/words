                                                "sense_id": "ac62f867-e64e-384d-b5dd-7f1a496e757d",
                                                "text": "alcune città presentano quartieri in cui domina l'inciviltà"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44d5ef57-3dc2-34ac-bc0c-c023a908a0a5",
                                        "entry_id": "dbe99ebc-807d-33f2-baad-337199b9d251",
                                        "glosses": [
                                            "incapacità di accettare gli altri, nelle situazioni in cui sarebbe possibile ed accettabile"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e15a07-3ba6-45bd-81fb-7e051f527388",
                                                "sense_id": "44d5ef57-3dc2-34ac-bc0c-c023a908a0a5",
                                                "text": "il razzismo è una forma d'inciviltà"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0577d9-3168-39ab-a4a5-dc24a220fadf",
                                        "entry_id": "dbe99ebc-807d-33f2-baad-337199b9d251",
                                        "glosses": [
                                            "propensione al litigio, facilità nel far sfociare un atteggiamento in collera, violenza e/o ostilità"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e76a72d-583e-41cc-beed-6d12023b13bc",
                                                "sense_id": "6d0577d9-3168-39ab-a4a5-dc24a220fadf",
                                                "text": "talvolta l'inciviltà non può essere sanata"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77266e3d-d0e4-3359-9177-e0e8e7fdd880",
                                        "entry_id": "dbe99ebc-807d-33f2-baad-337199b9d251",
                                        "glosses": [
                                            "mancanza di un legame profondamente sentito con leggi di uno Stato democratico o monarchico entro la legalità dei governi e tra i cittadini"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f6d338-f350-48d5-aa61-8eb5f116f23c",
                                                "sense_id": "77266e3d-d0e4-3359-9177-e0e8e7fdd880",
                                                "text": "la scala verso il risveglio politico-sociale delle menti è l'ultima e determinante sconfitta dell'inciviltà"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
