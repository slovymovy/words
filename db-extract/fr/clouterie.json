                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98112564-35ef-41c4-b1ea-82b5094d7f5b",
                                "sense_id": "ec67dcf2-5f7c-3089-8b69-651e79fd1b45",
                                "text": "Car si tu examines mon empire tu t'en iras voir les forgerons et les trouveras forgeant des clous et se passionnant pour les clous et te chantant les cantiques de la clouterie."
                            },
                            {
                                "example_id": "33fa66c8-5a4f-401d-a547-40c067eb4d45",
                                "sense_id": "ec67dcf2-5f7c-3089-8b69-651e79fd1b45",
                                "text": "Le chemin devient une ruelle qui passe un pont en dos d’âne sur un torrent le long duquel on devine en hauteur, plusieurs scieries, clouteries et martinets."
                            }
                        ]
