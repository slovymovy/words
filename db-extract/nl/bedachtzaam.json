                        "sense_id": "df74639c-fde7-3724-8353-11d7801d6683",
                        "entry_id": "38514a2d-a1d0-34c4-bdd6-046f5f311e67",
                        "glosses": [
                            "goed doordacht iets doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8708711-1d09-401b-8c21-5f06197d9f33",
                                "sense_id": "df74639c-fde7-3724-8353-11d7801d6683",
                                "text": "De inbreker was bedachtzaam en liet geen sporen achter."
                            },
                            {
                                "example_id": "7dec184e-e11d-484d-adb2-21c6d081edd0",
                                "sense_id": "df74639c-fde7-3724-8353-11d7801d6683",
                                "text": "Ze was bescheiden en bedachtzaam en kon haar gedachtes genuanceerd verwoorden."
                            },
                            {
                                "example_id": "3b37f6a3-fa77-48a3-b4ec-aac62a4a0066",
                                "sense_id": "df74639c-fde7-3724-8353-11d7801d6683",
                                "text": "En als nu de zogenaamde raadgevers van de KGB, of was het de NKVD in die tijd, die achter de schermen aan de touwtjes trokken bij het Slânskj-proces, als schurken werden bestempeld, dan werd ook de Sovjet-Unie schurkachtig genoemd, of niet? Tot zover knikte iedereen bedachtzaam instemmend."
                            }
                        ]
                    }
