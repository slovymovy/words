                                        "glosses": [
                                            "tiefe Bewusstlosigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6108fb3c-2a90-457a-9bd5-2e359ae8195f",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "Er fiel ins Koma."
                                            },
                                            {
                                                "example_id": "b4b9cf86-8046-483d-bac9-3186f4968d53",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "Sie liegt schon seit einem Monat im Koma."
                                            },
                                            {
                                                "example_id": "01e6c96a-14ce-4f76-b751-0c565b44ed9f",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "Dieser Patient ist aus dem Koma erwacht."
                                            },
                                            {
                                                "example_id": "8d8ec649-8e29-435d-875d-60a18f6ad679",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "Wir mussten ihn in ein künstliches Koma versetzen."
                                            },
                                            {
                                                "example_id": "8b56b5a6-aae1-4479-9500-15a79d0efa75",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "„Zwei Tage und zwei Nächte schläft sie wie im Koma durch.“"
                                            },
                                            {
                                                "example_id": "17d7b18e-3e25-4f80-9699-ecceb1494bd8",
                                                "sense_id": "dbeefa79-8800-3d08-9210-eb8afbe121f8",
                                                "text": "„Ivan Goll stürzte die Treppe hoch, öffnete die Tür und fand Claire im Koma vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Koma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74728f1f-ba1c-38d6-bff7-8f6ba4220e4b",
                                        "entry_id": "2d927c5c-3a05-3401-a6e9-546e626661df",
