                "senses": [
                    {
                        "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                        "entry_id": "d9f4376e-978d-3f1e-89a8-46d9a4b81b32",
                        "glosses": [
                            "Beförderung eines Intensivpatienten zu einem anderen Ort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33538f15-54be-416c-a4a8-3a89215dc9dc",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„Sollte es sich um einen arztbegleiteten Verlegungs- oder Intensivtransport eines Schwergewichtigen handeln, muss im Vorfeld ein sogenanntes Arzt-Arzt-Gespräch stattfinden.“"
                            },
                            {
                                "example_id": "5c4e575a-ecec-466b-9913-f67e9a9897e3",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„‚Die Vorbereitungen für den Intensivtransport sind auch fertig‘, erklärte der Notarzt seinem Kollegen.“"
                            },
                            {
                                "example_id": "b303905b-218d-4675-918f-2662b621b133",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„Alternativ kann ein Intensivtransport auch in einem Intensivtransporthubschrauber durchgeführt werden.“"
                            },
                            {
                                "example_id": "a5369f60-1454-4f59-a27a-cea5ea15b5f3",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„Die deutsche interdisziplinäre Vereinigung für Intensiv- und Notfallmedizin (DIVI) hat im Jahr 2004 einige Empfehlungen für den Intensivtransport formuliert.“"
                            },
                            {
                                "example_id": "6e2e5458-2ed8-4086-a802-6c77d4a7e7f5",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„Der Intensivtransport von Covid-19-Patienten ist aufwendig, wie der Rettungsmediziner Gräsner Anfang Dezember bei der Jahrestagung der DIVI Anfang erklärte.“"
                            },
                            {
                                "example_id": "27b4719d-f340-47c3-baec-f67b8e243b73",
                                "sense_id": "c56f7fd7-13ee-320a-ac02-8f72268d502f",
                                "text": "„Luftrettungsstationen spielen mittlerweile eine zentrale Rolle in der Notfallrettung, aber auch im Intensivtransport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
