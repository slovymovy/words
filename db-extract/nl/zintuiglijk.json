                ],
                "senses": [
                    {
                        "sense_id": "39a447fe-d6e2-328a-8e4b-1601fc9e6283",
                        "entry_id": "d7bd5645-1f6b-318b-80c6-86329734df7a",
                        "glosses": [
                            "betrekking hebben op de zintuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db5e4d6-4884-495a-8468-a49800c30494",
                                "sense_id": "39a447fe-d6e2-328a-8e4b-1601fc9e6283",
                                "text": "Bea Schreurs is vrijwilliger voor de gehandicapte sporters in Rijssen. Elke maandag vertrekt deze badjuf van beroep rond etenstijd van het ene zwembad om net na etenstijd op het andere zwembad weer het water in te springen en daar de vrijwilligers te begeleiden die met de lichamelijk en zintuiglijk gehandicapten zwemmen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6faa0d3-1a12-3520-a19f-421195cbe512",
                        "entry_id": "d7bd5645-1f6b-318b-80c6-86329734df7a",
                        "glosses": [
                            "van waarnemingen dat deze gedaan worden door de zintuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c0aa80-e8b9-4841-b1a5-9c02d9613093",
                                "sense_id": "f6faa0d3-1a12-3520-a19f-421195cbe512",
                                "text": "Intussen had hij tot zijn verbazing vastgesteld dat de beslissing van de Asser synode in 1926 dat de slang in het paradijs „zintuiglijk waarneembaar” had gesproken, het gewone Bijbelonderzoek in gereformeerde kring blokkeerde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2763d5e-c500-4042-8522-ac7f95bbb7ce",
                        "source_entry_id": "d7bd5645-1f6b-318b-80c6-86329734df7a",
                        "source_sense_id": "f6faa0d3-1a12-3520-a19f-421195cbe512",
                        "source_sense_description": "betrekking hebbend op de waarneming via de zintuigen",
                        "target_lang_word": "sensorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3d4909-7b69-3f08-9065-4c5de895e28a",
                                        "entry_id": "1cb01681-51a2-343b-84a7-0ea99b3ddb74",
                                        "glosses": [
                                            "Of or pertaining to sensation or the senses; sensory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a015d41a-622d-418c-9e2b-1fed10e26ede",
                                                "sense_id": "eb3d4909-7b69-3f08-9065-4c5de895e28a",
                                                "text": "Esquivel invites the reader to re-assess conventional approaches to literature and to experience the pleasure, through flagrant sight-gags, such as when Tita drops the apricots on Pedro’s head (38), and, especially, through the sensorial stimuli—the scents, tastes, colors and textures—induced by food."
                                            },
                                            {
                                                "example_id": "66f46f3d-6691-4ff2-a0a9-0d6e7a845a27",
                                                "sense_id": "eb3d4909-7b69-3f08-9065-4c5de895e28a",
                                                "text": "Five years ago, I began to create a mixture of print/digital work that emerged as a popular series called “Reactive Books.” In this endeavor, I focused on developing not just “interactive” media, but “reactive” media, where the interaction hits at a more sensorial level."
                                            },
                                            {
                                                "example_id": "991cda9c-9862-4f5a-a512-70e37cde38f0",
                                                "sense_id": "eb3d4909-7b69-3f08-9065-4c5de895e28a",
                                                "text": "Combined with the scent of stale air inside the tent and the snores of another person nearby, the sensorial collage conjured memories of brighter days camping with his father the king… even hunting trips with his younger brother before Dolvek had become so insufferable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2b441c7-3de3-4775-89bc-a308907220bc",
                        "source_entry_id": "d7bd5645-1f6b-318b-80c6-86329734df7a",
                        "source_sense_id": "f6faa0d3-1a12-3520-a19f-421195cbe512",
                        "source_sense_description": "betrekking hebbend op de waarneming via de zintuigen",
                        "target_lang_word": "sensory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7efc38d2-cc71-3993-bc12-1746b51302a4",
                                        "entry_id": "bcf6cfc1-768a-3d86-896f-a2153fada3af",
                                        "glosses": [
                                            "Of the physical senses or sensation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34af32f8-ccae-4765-a19e-ca392758e3e8",
                                                "sense_id": "7efc38d2-cc71-3993-bc12-1746b51302a4",
                                                "text": "The Species of things are perceived rather there whereto they are carried. But every ſenſory Nerve each in its place carries the Species to the beginning of the ſpinal Marrow, and therefore each in their place are judged and received by the Soul, in the beginning of the ſpinal Marrow."
                                            },
                                            {
                                                "example_id": "fd6b4622-5e1f-42ac-941d-a70fb23030d6",
                                                "sense_id": "7efc38d2-cc71-3993-bc12-1746b51302a4",
                                                "text": "It is evident that in the ancestor of these two groups the first pair of appendages became early adapted for purely sensory purposes, and were naturally projected far in advance of the mouth, forming the antennæ."
                                            },
                                            {
                                                "example_id": "32cccc34-8fd8-4082-9c97-4ba150433ea1",
                                                "sense_id": "7efc38d2-cc71-3993-bc12-1746b51302a4",
                                                "text": "Findings of the sensory analysis panel at NWFSC [the Northwest Fisheries Science Center], which tested and classified flesh characteristics of both Pacific and giant grenadier, are averaged and summarized in Table 10."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cffab92-8516-3ec1-8367-0e415ef8dc12",
                                        "entry_id": "bcf6cfc1-768a-3d86-896f-a2153fada3af",
                                        "glosses": [
                                            "Conveying nerve impulses from the sense organs to the nerve centers."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5c4f32-4a1f-412a-b2c7-e90382853331",
                                                "sense_id": "2cffab92-8516-3ec1-8367-0e415ef8dc12",
                                                "text": "sensory neurons"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sensory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd8eea1-3aeb-3264-87de-b57646c5623c",
                                        "entry_id": "a132c6cd-dc68-32ce-9dd7-cdf4b4d4c27e",
                                        "glosses": [
                                            "The sensorium."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4681a6f-2d94-4be8-b2d3-615f85dac769",
                                                "sense_id": "cdd8eea1-3aeb-3264-87de-b57646c5623c",
                                                "text": "Is not the Senſory of Animals that place to which the ſenſitive Subſtance is preſent, and into which the ſenſible Species of Things are carried through the Nerves and Brain, that there they may be perceived by their immediate preſence to that ſubſtance ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2966abe2-72c3-35d0-b27d-a9a6196c2018",
                                        "entry_id": "a132c6cd-dc68-32ce-9dd7-cdf4b4d4c27e",
                                        "glosses": [
                                            "An organ or faculty of sense."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d62b705-0cab-4749-9320-66edb2f954dc",
                                                "sense_id": "2966abe2-72c3-35d0-b27d-a9a6196c2018",
                                                "text": "BOth of them ſpread themſelues in Round, and fill a whole Floare or Orbe, vnto certaine Limits : and are carried a great way : And doe languiſh and leſſen by degrees, according to the Diſtance of the Obiects from the Senſories."
                                            },
                                            {
                                                "example_id": "164fcb38-1250-40b3-ace0-e69fda80e197",
                                                "sense_id": "2966abe2-72c3-35d0-b27d-a9a6196c2018",
                                                "text": "Dr. Burnet, late Bishop of Sarum, on 4 Heb. v. 13, anatomically describing the texture of the eye[…]so God who made this sensorie, did with the greatest ease and at once see all that was don thro’ the vast universe, even to the very thought as well as action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
