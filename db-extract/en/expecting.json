                        "entry_id": "f8c5df9b-26f4-3dd2-b3fb-52f9b887147b",
                        "glosses": [
                            "Of a woman, female animal, or couple, in expectation of giving birth; pregnant."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c506bdf-bcfb-4834-9071-4ce21232b4cb",
                                "sense_id": "d17660e4-082f-3093-ac99-d39ff93d83bb",
                                "text": "When is the new couple expecting?"
                            },
                            {
                                "example_id": "d96ef49b-bde6-437c-a862-9018fb706da0",
                                "sense_id": "d17660e4-082f-3093-ac99-d39ff93d83bb",
                                "text": "The expecting mother is enthusiastic about learning childcare."
                            }
                        ]
                    },
                    {
                        "sense_id": "88fa84f1-0c17-36df-a0ba-998fbd366f24",
                        "entry_id": "f8c5df9b-26f4-3dd2-b3fb-52f9b887147b",
                        "glosses": [
                            "Expectant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60f6c7e-6568-412a-846f-fe18ac9c1e88",
                                "sense_id": "88fa84f1-0c17-36df-a0ba-998fbd366f24",
                                "text": "Dunscomb was in the sanctum, while a single clerk and three or four clients, countryment of decent exterior and very expecting countenances, occupied the outer room ."
                            },
                            {
                                "example_id": "c656bc21-b1a5-4ba7-b200-ccf6e7e2eb1c",
                                "sense_id": "88fa84f1-0c17-36df-a0ba-998fbd366f24",
                                "text": "Parma, unwilling to fight an action which might force France into the field, raised the siege; and Alençon, having strengthened the garrison, thrown in supplies, saved his credit with the Low Countries, and at all events, compromised himself, fell back into his expecting attitude, waiting for Elizabeth to reward him ."
                            },
                            {
                                "example_id": "da98ce60-69ab-4bd3-babe-e9caf0f8bec5",
                                "sense_id": "88fa84f1-0c17-36df-a0ba-998fbd366f24",
                                "text": "\"Hello!?!\" she said in a very expecting tone."
                            }
                        ]
                    }
