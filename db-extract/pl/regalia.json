                                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                                        "glosses": [
                                            "The emblems, symbols, or paraphernalia indicative of royalty or any other sovereign status; such as a crown, orb, sceptre or sword."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a33d8b8-594b-4592-a026-1421f40a5f10",
                                                "sense_id": "7f5c1d41-274c-33f0-b41d-ab9fff7fbe9e",
                                                "text": "THE INTHRONIZATION. The King ascended the Theatre, accompanied by the two Bishops his Supporters, the Great Officers of State, the Lords carrying the Swords, and the Lords who had borne Their Majesties' Regalia, and was Inthroned by the Archbishops, Bishops, and the other Peers, who then stood about the steps of the Throne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f38f8527-c1b5-3bb6-b9f0-5a809c665dc6",
                                        "entry_id": "963a37e7-5213-3bce-9c0b-bd0a52ee2d98",
                                        "glosses": [
                                            "Decorations or insignia indicative of an office or membership of an order or society; such as freemasonry."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    },
