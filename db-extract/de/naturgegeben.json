                    {
                        "form_id": "c107fba2-da69-4746-a909-a8e6257c11c6",
                        "entry_id": "c2d0afc6-7c62-3529-a760-fcf051eae84b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind naturgegeben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "646c6db4-3aa4-3666-bec5-7098960e1e35",
                        "entry_id": "c2d0afc6-7c62-3529-a760-fcf051eae84b",
                        "glosses": [
                            "der Natur entsprechend geschehen und deshalb nicht änderbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670aeeb0-a715-40cc-b4e0-4154bbcfbf64",
                                "sense_id": "646c6db4-3aa4-3666-bec5-7098960e1e35",
                                "text": "„Bislang hatte ich dies auf eine naturgegebene Kurzlebigkeit der Familie zurückgeführt, doch nun grübelte ich lange über diese vorzeitigen Tode nach und fing an, sie mit den Fantastereien des Alten in Verbindung zu bringen, der häufig von einem Fluch sprach, der seit Jahrhunderten verhindere, dass die Träger meines Titels älter als 32 Jahre würden.“"
                            },
                            {
                                "example_id": "425a6838-681c-4d0e-ac61-25f29e9ad418",
                                "sense_id": "646c6db4-3aa4-3666-bec5-7098960e1e35",
                                "text": "„Kein Urteil hätte sie daran gehindert, die Angehörigen indigener Kulturen als unterlegene Wesen zu behandeln, die ihren naturgegebenen Herren mit Gewalt unterworfen werden mussten.“"
                            },
                            {
                                "example_id": "28aed072-8050-49db-b09f-7372c36d0af0",
                                "sense_id": "646c6db4-3aa4-3666-bec5-7098960e1e35",
                                "text": "„Indem sowohl die Rassenentstehung selbst als auch ihre Trennung angeblich naturgegeben waren, glaubte Hofmeyr eine Art naturwissenschaftliche Begründung für die Politik Verwoerds entwickeln zu können.“"
                            },
                            {
                                "example_id": "e02bd744-8832-4e93-8547-95a1c2d21598",
