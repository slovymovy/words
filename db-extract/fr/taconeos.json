                "senses": [
                    {
                        "sense_id": "caa76ce7-d9b6-3fd8-b4c0-f5423f68159c",
                        "entry_id": "818cafe8-ec73-3600-83f6-63e835604b83",
                        "glosses": [
                            "Rythme de martèlement des talons dans le flamenco."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca5db82-4aea-4fd8-bfea-7e89ea49cd32",
                                "sense_id": "caa76ce7-d9b6-3fd8-b4c0-f5423f68159c",
                                "text": "La plupart [des danses] étaient exécutées par une seule personne et rentraient dans la classe des zapateados ou des taconeos, scandées à coup de pied et de talon sur le plancher."
                            },
                            {
                                "example_id": "abddda8f-8982-4b32-8a2d-064500d73b8e",
                                "sense_id": "caa76ce7-d9b6-3fd8-b4c0-f5423f68159c",
                                "text": "La sueur brouillait son mascara, marquait ses aisselles ; son peigne tombait, au rythme accéléré des taconeos, elle ne se souciait que de danser, danser mieux encore."
                            },
                            {
                                "example_id": "abc80330-f194-40ed-a21f-5b334b8f901d",
                                "sense_id": "caa76ce7-d9b6-3fd8-b4c0-f5423f68159c",
                                "text": "Le taconeos du zapateado, contrairement aux autres taconeos, marque un rythme à 6/8 et est réservé aux femmes."
                            }
                        ]
                    }
                ],
