                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33eb65b1-9bcd-4ff0-8a99-66f3dc7a503f",
                                "sense_id": "65ff0f3a-e35d-3e7a-b40c-2c2419e5e0fb",
                                "text": "W 1657 r. na Ryn najechali Tatarzy hetmana Gosiewskiego, którzy spalili zamek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d2df5f97-fa7e-3024-aa84-2716bfc3e879",
                        "entry_id": "d6a794b7-636b-3469-aaea-8f9441177a49",
                        "glosses": [
                            "toponim, nazwa kilku wsi w Polsce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d286184a-03ad-4009-93e5-57ee2cb09b30",
                                "sense_id": "d2df5f97-fa7e-3024-aa84-2716bfc3e879",
                                "text": "Jadąc przez Ryn, widzieliśmy bociany."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "00f93767-35cb-32ec-bc17-1faeac2d3a8e",
                        "entry_id": "d6a794b7-636b-3469-aaea-8f9441177a49",
                        "glosses": [
