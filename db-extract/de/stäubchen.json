                                        ],
                                        "tags": [
                                            "no-present-participle",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc96eb0d-7513-3559-9990-5763aa2569d0",
                                        "entry_id": "ee1a6481-f79b-3d8f-bf9b-117b9cb41519",
                                        "glosses": [
                                            "Forming subjunctive expressions of wish: may."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "no-present-participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb2cbd6-2bd0-4bd6-8cc0-179e4d06331c",
                                                "sense_id": "cc96eb0d-7513-3559-9990-5763aa2569d0",
                                                "text": "‘I shall not take Vengeance into my own Hands. The Goddess will do what She will.’ ‘So mote it be,’ said the Grandmaster."
                                            }
                                        ]
                                    }
                                ]
