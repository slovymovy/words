                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34dbffb6-9e4f-4456-a33a-8907b72e56f6",
                                                "sense_id": "6fa242fb-b133-3795-9cc9-7aa7c8c43f82",
                                                "text": "„Fast wie im Gregorianischen Choral singt eine Männergruppe eine einstimmige Linie, die durchaus eine alte Antiphon sein könnte, eine jener refrainartigen Melodien, die in der frühen römischen Liturgie (von der Gemeinde) im Wechsel zu den Psalmen (des Chores) gesungen wurden.“"
                                            },
                                            {
                                                "example_id": "d9341e0f-e5b7-40e8-9d3a-b6358e8afb55",
                                                "sense_id": "6fa242fb-b133-3795-9cc9-7aa7c8c43f82",
                                                "text": "„Die herbeigerufenen Ratsherren schauen zu, wie Jetzer auf dem Altar zur Antiphon Ave Regina Coelorum sein Passionsspiel vorführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
