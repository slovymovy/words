                    {
                        "translation_id": "46c49ca3-a304-42f4-b0a1-f5d40b6b9b87",
                        "source_entry_id": "23a6d0ae-b2d7-3c2e-b575-4abc8cb2ad35",
                        "target_lang_word": "Diebin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diebin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36007e3f-b247-34dd-bda7-7641b505fe5c",
                                        "entry_id": "8440cf18-5917-3bb8-96b2-79ba15b4cee4",
                                        "glosses": [
                                            "weibliche Person, die einen Diebstahl begangen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6ab7e1-ee52-4cc9-838d-0f3261a2cff7",
                                                "sense_id": "36007e3f-b247-34dd-bda7-7641b505fe5c",
                                                "text": "Im Supermarkt um die Ecke wurde heute Morgen eine Diebin erwischt."
                                            },
                                            {
                                                "example_id": "af995844-5dcb-4123-bc2d-2bc3a34f7fa6",
                                                "sense_id": "36007e3f-b247-34dd-bda7-7641b505fe5c",
                                                "text": "Es wurden in diesem Monat schon vierzehn Diebinnen in diesem Geschäft überführt."
                                            },
                                            {
                                                "example_id": "bcfcc35a-4710-4424-824f-84e43d0db7d0",
                                                "sense_id": "36007e3f-b247-34dd-bda7-7641b505fe5c",
                                                "text": "„Als notorische Diebin stiehlt sie die Uhr des Erzählers, als ebenso notorische Lügnerin gibt sie sich Don José gegenüber als Baskin aus.“"
                                            },
                                            {
                                                "example_id": "40c1feb3-a3a1-4a18-96a7-760b0476ab14",
                                                "sense_id": "36007e3f-b247-34dd-bda7-7641b505fe5c",
                                                "text": "„Dabei ging von ihr das Gerücht, dass sie eine Lügnerin und Diebin sei, eine »salope«, also eine Schlampe, überhaupt eine ganz schreckliche Person, die man möglichst weit von sich fernhalten solle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bad8c28a-8716-4de0-b3e0-407e6487f1ed",
                        "source_entry_id": "23a6d0ae-b2d7-3c2e-b575-4abc8cb2ad35",
                        "target_lang_word": "thief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thief",
