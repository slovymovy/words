                    {
                        "sense_id": "43981dfa-14ca-3988-90d1-92b1e6aeb73c",
                        "entry_id": "c65ca9de-539e-3ea1-bcae-3ac1abf97939",
                        "glosses": [
                            "eine Anzahl an Lebensmitteln, die aus einem hohen Anteil an Zucker bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d37788a-b98f-406e-9d68-19e1e06c40a7",
                                "sense_id": "43981dfa-14ca-3988-90d1-92b1e6aeb73c",
                                "text": "Maria kauft für die Geburtstagsfeier in der Konditorei etwas Zuckerwerk."
                            },
                            {
                                "example_id": "354c163a-3a8a-4681-8129-cacd88ec37e1",
                                "sense_id": "43981dfa-14ca-3988-90d1-92b1e6aeb73c",
                                "text": "„Er hatte den Kindern versprochen, mit Schätzen und Zuckerwerk heimzukehren.“"
                            },
                            {
                                "example_id": "49da2d7b-da88-48b1-a39a-afe168077270",
                                "sense_id": "43981dfa-14ca-3988-90d1-92b1e6aeb73c",
                                "text": "„Bei der ›Corsa dei Barberi‹ unterhielt sich die Familie Mengs, mit der ich hingegangen war, damit, in die Landauer, die wir überholten, Zuckerwerk zu werfen, von dem ich ihnen einen Sack voll gekauft hatte.“"
                            },
                            {
                                "example_id": "8119e751-8f03-402d-b3d2-7f8f265eef2b",
                                "sense_id": "43981dfa-14ca-3988-90d1-92b1e6aeb73c",
                                "text": "„Er sieht seine kleine Schwester, die ihn anlächelt, während ein Wesen aus Zuckerwerk neben ihr hockt und ihre Eingeweide verspeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
