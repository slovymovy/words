                    {
                        "sense_id": "062fbd31-a319-306c-8dba-f4634a59e1d4",
                        "entry_id": "76709b21-2573-3dc7-ba8d-6dc6f16e38fe",
                        "glosses": [
                            "das Ausscheiden von breiigem bis flüssigem Stuhlgang; siehe auch Durchfall"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "25ec80ee-ed20-43ba-90e6-bc44dbf1b98b",
                                "sense_id": "062fbd31-a319-306c-8dba-f4634a59e1d4",
                                "text": "Wie aus heiterem Himmel hatte ich plötzlich Dünnschiss."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38de5ada-95e9-4b82-bed0-db025df7a116",
                        "source_entry_id": "76709b21-2573-3dc7-ba8d-6dc6f16e38fe",
                        "source_sense_id": "062fbd31-a319-306c-8dba-f4634a59e1d4",
                        "source_sense_description": "umgangssprachlich, derb: das Ausscheiden von breiigem bis flüssigem Stuhlgang; siehe auch Durchfall",
                        "target_lang_word": "chiasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cc6e6f-1eaa-393e-a55b-8649297163bb",
                                        "entry_id": "682f6164-fd60-3857-ac53-5b80523aae8d",
                                        "glosses": [
                                            "Excréments de mouche, de ver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                        "entry_id": "682f6164-fd60-3857-ac53-5b80523aae8d",
                                        "glosses": [
                                            "Diarrhée."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6978054e-cc22-44e1-be82-432a0d86cd3e",
                                                "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                                "text": "Il battit le briquet et enflamma l’alcool dont les mains d’Angelo étaient recouvertes : « Vaut mieux des cloques que la chiasse par ce temps-ci, croyez-moi. D’ailleurs, ça brûle juste les poils."
                                            },
                                            {
                                                "example_id": "2c6add78-51ab-47f8-aac3-a33dcec30c0d",
                                                "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                                "text": "Il y a les coteaux de Bry, où s’attrapent les épidémies de chiasse de reines-claudes et de mirabelles."
                                            },
                                            {
                                                "example_id": "150d9be8-1aa2-4dea-8734-f2ace902a7af",
                                                "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                                "text": "La chiasse était, en effet, le lot habituel des deux catégories de détenus qui peuplaient le Petit Camp."
                                            },
                                            {
                                                "example_id": "1cdbd6ab-70e1-4159-868c-f4693a8117ba",
                                                "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                                "text": "– Neptune [un chien] a eu les chiasses mardi, vous savez, eh bien elle l’a soigné.\nUne chiasse toute seule, c’est bien trop mesquin.\n– Je sais, dis-je, nous en sommes quittes pour un nouveau tapis dans le hall."
                                            },
                                            {
                                                "example_id": "c0f84e3d-d65e-417e-b228-558c8dbd3458",
                                                "sense_id": "746f537b-f15b-3f5f-b4dd-ef3deae79eb2",
                                                "text": "J’ai la chiasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a20ccb3-7c99-3eae-8cdd-30f8f9c9d423",
                                        "entry_id": "682f6164-fd60-3857-ac53-5b80523aae8d",
                                        "glosses": [
                                            "Écume des métaux en fusion."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85604313-d9dc-4f3a-8909-6934cd605f38",
                                                "sense_id": "4a20ccb3-7c99-3eae-8cdd-30f8f9c9d423",
                                                "text": "Chiasse de fer, de cuivre, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f3c66d-cf59-313a-8982-80b51bc2db0f",
                                        "entry_id": "682f6164-fd60-3857-ac53-5b80523aae8d",
                                        "glosses": [
                                            "Malchance, poisse, Ennui, dérangement."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78d121f-8617-49e4-9779-dcf6fc88101f",
                                                "sense_id": "e3f3c66d-cf59-313a-8982-80b51bc2db0f",
                                                "text": "Quelle chiasse, quel manque de chance, cette crevaison !"
                                            },
                                            {
                                                "example_id": "497c213a-81bc-45f6-b5d2-c233cc58fe77",
                                                "sense_id": "e3f3c66d-cf59-313a-8982-80b51bc2db0f",
                                                "text": "Quelle chiasse, ce repas de famille dimanche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f8be98-1150-3a05-97c4-2486a9230dde",
                                        "entry_id": "682f6164-fd60-3857-ac53-5b80523aae8d",
                                        "glosses": [
                                            "Personne extrêmement dérangeante, agaçante."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c5354b3-ce91-4bb9-a625-ce3ccff39b91",
                                                "sense_id": "d3f8be98-1150-3a05-97c4-2486a9230dde",
                                                "text": "Attends une seconde. OK, ce type est un saladier de chiasse, mais tu détestes te mettre en colère."
                                            }
                                        ]
                                    }
                                ]
                            },
