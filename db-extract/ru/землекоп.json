                        "source_sense_id": "b173c594-6088-338e-86b2-54445161e7d2",
                        "target_lang_word": "terrassier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrassier",
