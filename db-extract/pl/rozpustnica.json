                        "target_lang_word": "poběhlice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poběhlice",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "414010f8-7c16-37c4-bc77-45aa5dddbedf",
                                        "entry_id": "9ac8d6d8-9e2c-3558-9049-1ef579348610",
                                        "glosses": [
                                            "žena, jež se často toulá, bez stálého bydliště či působiště"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ec577f-19d0-411a-93f4-d197ed87aaad",
                                                "sense_id": "414010f8-7c16-37c4-bc77-45aa5dddbedf",
                                                "text": "„Jsem poběhlice po celém světě a všude jsem něco nasála,“ říká o sobě známá cukrářka se smíchem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea455f0-08ba-347b-bea9-5ec1d8eb14db",
                                        "entry_id": "9ac8d6d8-9e2c-3558-9049-1ef579348610",
                                        "glosses": [
                                            "promiskuitní žena nebo žena špatné pověsti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b46d4f10-342c-4e62-9f6f-3e432f0008c0",
                                                "sense_id": "6ea455f0-08ba-347b-bea9-5ec1d8eb14db",
                                                "text": "Z roztomilé disneyovské hvězdičky se postupem času stala lascivní poběhlice, jejíž dlouhé jazysko olízalo kdeco."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ece9eca-9151-4bbb-8920-016797ac1f6d",
                        "source_entry_id": "5d989388-48b8-33d3-9836-5cfe944a04e0",
                        "source_sense_id": "2a50ea75-b974-3fca-a8f6-55caabd9431f",
