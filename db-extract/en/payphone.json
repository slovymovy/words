                                        "sense_id": "9a68fdb7-2764-325c-a673-e6a85b7a4fd6",
                                        "entry_id": "ad02c2e4-55bc-3f5b-bad9-aa258d142081",
                                        "glosses": [
                                            "öffentliches Gerät zur Übermittlung von akustischen Signalen, welches nach Bezahlung benutzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
