                                                "sense_id": "3525c465-5634-34ef-ab88-c59756b0ae04",
                                                "text": "„Ist okay. Bis halb drei … tschüß.“"
                                            },
                                            {
                                                "example_id": "3a5b9a5c-b1c6-4a31-ad93-214ae493583f",
                                                "sense_id": "3525c465-5634-34ef-ab88-c59756b0ae04",
                                                "text": "„»[…] Bis dahin, auf Wiederhören.« »Ja, tschüss.«“"
                                            }
                                        ],
