                "senses": [
                    {
                        "sense_id": "9975d01c-b4ee-3f6e-adec-d94e2ad8591a",
                        "entry_id": "9c818ac1-0d75-33ba-837c-fa217187f5b4",
                        "glosses": [
                            "Folterinstrument, mit dem eine große Zugspannung auf die Gliedmaßen des Opfers erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03d0d47-410a-4ffe-a724-591967274105",
                                "sense_id": "9975d01c-b4ee-3f6e-adec-d94e2ad8591a",
                                "text": "Die Folter auf der Streckbank gehörte zur hochnotpeinlichen Befragung."
                            },
                            {
                                "example_id": "d155ec4d-67dc-4fb1-9c9e-4557a143847d",
                                "sense_id": "9975d01c-b4ee-3f6e-adec-d94e2ad8591a",
                                "text": "„Sie besaßen kein einziges Folterinstrument, keine Streckbank, nicht einmal ein Kabel, das diesen Namen verdient hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfb5d57b-6043-4581-ac26-9122066c83b2",
                        "source_entry_id": "9c818ac1-0d75-33ba-837c-fa217187f5b4",
                        "source_sense_id": "9975d01c-b4ee-3f6e-adec-d94e2ad8591a",
                        "source_sense_description": "Folterinstrument, mit dem eine große Zugspannung auf die Gliedmaßen des Opfers erzeugt wird",
                        "target_lang_word": "banc de torture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "97c1d47c-734c-41bc-b0d0-1f660e356706",
                        "source_entry_id": "9c818ac1-0d75-33ba-837c-fa217187f5b4",
                        "source_sense_id": "9975d01c-b4ee-3f6e-adec-d94e2ad8591a",
                        "source_sense_description": "Folterinstrument, mit dem eine große Zugspannung auf die Gliedmaßen des Opfers erzeugt wird",
                        "target_lang_word": "chevalet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevalet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97cf158d-0929-35f1-a5b4-0a9e63778b20",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Ce qui sert aux artisans, dans différents métiers, à tenir l’ouvrage élevé ou baissé, pour travailler plus commodément."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be4b3f2b-4e66-48c7-93c7-422904eb3acc",
                                                "sense_id": "97cf158d-0929-35f1-a5b4-0a9e63778b20",
                                                "text": "Et quand Hervé traversa le grand salon, où des panneaux en glaces alternaient avec des tentures de lampas blanc, où des statues de marbre posées sur des socles d’ébène coudoyaient des tableaux de maîtres placés sur des chevalets dorés, où de vastes fauteuils-duchesse entouraient majestueusement la cheminée, Hervé revit par la pensée les sévères boiseries de chêne, les meubles vermoulus et les portraits d’ancêtres de la grande galerie où son père recevait les châtelains des environs."
                                            },
                                            {
                                                "example_id": "cd30332f-2eb4-42be-b4d4-5ba8fc2b26ef",
                                                "sense_id": "97cf158d-0929-35f1-a5b4-0a9e63778b20",
                                                "text": "Sur chaque navire, […], les hommes amènent la vergue, la posent sur deux chevalets, ferlent la voile ; arc-boutés, ils font basculer les quatre cents kilos du mât trapu sur son emplanture, le couchent, sortent les avirons, les empoignent de leurs mains crispées par le froid, prennent la cadence de nage. Les Vikings remontent vers Rouen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9658fc8b-946a-3179-8d94-1c8d282a3b84",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Support amovible sur lequel le peintre pose et appuie le tableau auquel il travaille."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da4cbdc3-061d-3f0a-a219-6b5a46262f37",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Support servant à tenir élevées les cordes d’un instrument à cordes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e89c9e52-2936-494d-aa76-a3f0df787557",
                                                "sense_id": "da4cbdc3-061d-3f0a-a219-6b5a46262f37",
                                                "text": "Sa table, son chevalet, son manche, son fond en érable, le sillet d’ébène, les chevilles qui sont en buis, tout est magnifique dans cet instrument de musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914da932-e075-357f-b2f1-92bc0730070f",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Machine avec un rouleau pour passer les câbles d’un lieu à un autre."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1b403f8-464d-3af2-8c77-c050402ce24f",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Instrument de supplice ou de torture sur un cheval de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b5198d-5a1d-4028-aa3a-4291a8c842f5",
                                                "sense_id": "e1b403f8-464d-3af2-8c77-c050402ce24f",
                                                "text": "Les patients se groupent comme ils peuvent sur ce chevalet d’une nouvelle espèce, auprès duquel les grils de saint Laurent et de Guatimozin sont des lits de roses, car il était du moins possible de s’y retourner."
                                            },
                                            {
                                                "example_id": "1151fab9-3759-4ed8-b2e4-49bb66d0a718",
                                                "sense_id": "e1b403f8-464d-3af2-8c77-c050402ce24f",
                                                "text": "Pendant mille ans nous avons garrotté l’humanité sur les chevalets ensanglantés ; de nouveau nous lui tenaillerons les chairs avec des fers rougis pour que la foi pénètre en son cœur."
                                            },
                                            {
                                                "example_id": "0d74113f-4510-4c5f-ad72-05ba93abd0d6",
                                                "sense_id": "e1b403f8-464d-3af2-8c77-c050402ce24f",
                                                "text": "Dans ce livre, peinture des malheurs qu’endurèrent les chrétiens sous la persécution romaine, est racontée l’histoire – avec une gravure à l’appui – d’une jeune vierge qu’on supplicie, liée à un chevalet, en lui désarticulant peu à peu bras et jambes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8137d5-f453-309c-86a9-d253f50f760f",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Support sur lequel on pose ses lettres."
                                        ],
                                        "tags": [
                                            "Scrabble"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95da96ba-258e-337e-b792-2e1928f17f05",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Balisage en forme de croix couchée."
                                        ],
                                        "tags": [
                                            "Randonnée"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c04fe2d7-0799-31be-bf60-6e776020f1b2",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Position de la main sur la table de billard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9320e5e1-1035-31bc-8d64-32d5aecbe9a2",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Support servant à soutenir une arme à feu."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a288ddee-5099-4549-a7f4-b4435b26a158",
                                                "sense_id": "9320e5e1-1035-31bc-8d64-32d5aecbe9a2",
                                                "text": "Toute activité était éteinte. Plus personne ne faisait rien : qu’attendre. Car, la balle frappait à droite, à gauche, comme envoyée par un tireur posté et qui aurait eu son arme sur chevalet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f4c43f-7ef7-3245-be15-6c5c3afe7b47",
                                        "entry_id": "a7a2db6c-ba3b-3ff7-80d0-1ec294a607a4",
                                        "glosses": [
                                            "Support permettant le transport de marchandises de surfaces planes (panneaux de bois, vitres, panneaux en béton préfabriqué, ...)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
