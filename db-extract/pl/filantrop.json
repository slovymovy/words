                "senses": [
                    {
                        "sense_id": "8bb76ebf-7244-301d-b384-6c565859ce7b",
                        "entry_id": "13174fac-dc3e-32cf-8913-e63741a6914a",
                        "glosses": [
                            "człowiek zajmujący się działalnością dobroczynną, wspomagający biednych i potrzebujących"
                        ],
                        "tags": [],
