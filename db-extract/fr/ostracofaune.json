                "senses": [
                    {
                        "sense_id": "9f6c742a-4ac9-3152-bb21-eff11c3453d7",
                        "entry_id": "8f1051a4-3bf5-3fba-a585-290d1b9ce59b",
                        "glosses": [
                            "Ensemble des crustacés microscopiques de la classe des ostracodes vivant en un lieu et une époque donnés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d469279c-490f-4b6a-a73d-2b48f999d4cc",
                                "sense_id": "9f6c742a-4ac9-3152-bb21-eff11c3453d7",
                                "text": "Cette analyse basée sur l’ostracofaune de plus de 200 échantillons de surface des lacs Titicaca et Poopo (Bolivie) est la première du genre."
                            },
                            {
                                "example_id": "89d09c03-3804-4fd5-a65a-2eb3a84c6692",
                                "sense_id": "9f6c742a-4ac9-3152-bb21-eff11c3453d7",
                                "text": "L’ostracofaune révèle également des extensions anciennes des herbiers littoraux bien au-delà de leurs limites actuelles."
                            },
                            {
                                "example_id": "05daf850-45b7-4176-a3fb-8f4418aed3ee",
                                "sense_id": "9f6c742a-4ac9-3152-bb21-eff11c3453d7",
                                "text": "L’ostracofaune se compose à 98 % de Cyprideis torosa, ce qui traduit le confinement du milieu."
                            }
                        ]
                    }
                ],
