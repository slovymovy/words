                    {
                        "sense_id": "93458cf5-c5ad-39b5-ad02-3f20abd859b5",
                        "entry_id": "40a0425a-a0ea-3c14-ba9d-5b80d08a663d",
                        "glosses": [
                            "de zekerheid die iemand heeft in denken en handelen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bdddd6b3-c792-4e8a-b65a-fc21efd00f52",
                                "sense_id": "93458cf5-c5ad-39b5-ad02-3f20abd859b5",
                                "text": "De wisselvalligheid in zijn spel tegen Fognini was drie dagen later tegen Paire zeker nog niet verdwenen. Murray leverde in de eerste set zijn tweede en derde servicegame in, maar de 28-jarige Fransman miste eveneens de nodige zuiverheid en vastheid in zijn slagen. Bij 5-5 was de strijd in de eerste set nog helemaal open. In de tiebreak sloeg Murray echter genadeloos toe (7-1)."
                            }
                        ]
                    },
                    {
                        "sense_id": "27674cd3-fd8f-3969-988a-40eed4d814a1",
                        "entry_id": "40a0425a-a0ea-3c14-ba9d-5b80d08a663d",
                        "glosses": [
                            "een sterke samenhang hebbend en daardoor moeilijk te veranderen en hard aanvoelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8989a181-5d6b-4f4b-ad71-b953b428aef0",
                                "sense_id": "27674cd3-fd8f-3969-988a-40eed4d814a1",
                                "text": "Amsterdammers hebben hun voorronde op zondag 27 september, de dag dat ook de finale in het Amsterdam Food Center aan de Jan van Galenstraat wordt gehouden. De jury beoordeelt de ballen op rulheid, vastheid, sappigheid, smaak, vorm, braadtechniek en uiterlijk."
                            }
                        ]
                    }
