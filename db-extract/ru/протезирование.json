                                        "examples": [
                                            {
                                                "example_id": "3cbb4959-7fea-4236-8ce3-90596810828b",
                                                "sense_id": "4c842c76-1e6b-3593-9631-fdf7efd2361b",
                                                "text": "„Der sich in der zahnärztlichen Prothetik vollziehende Paradigmenwechsel von einem vorwiegend restaurativ und technisch geprägten Ansatz zu einer präventiven und biologischen Orientierung beeinflusst zunehmend die orale Rehabilitation.“"
                                            },
                                            {
                                                "example_id": "827122be-2645-40b3-af14-c9fb87b0c166",
                                                "sense_id": "4c842c76-1e6b-3593-9631-fdf7efd2361b",
                                                "text": "„Der Weltmarktführer in der Prothetik, bei Orthesen und Rollstühlen engagiert sich im Behindertensport und ist seit mehr als 30 Jahren der Topsponsor bei paralympischen Sommer- und Winterspielen.“"
                                            }
