                {
                    "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                    "sense_definition": "Horloge d'appartement, souvent posée sur un meuble ou fixée à un mur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "horlogerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille <w>pendule</w> du salon sonne toutes les heures avec une grande précision."
                        },
                        {
                            "text": "Il a installé une <w>pendule</w> murale dans la cuisine pour toujours savoir l'heure."
                        }
                    ],
                    "synonyms": [
                        "horloge"
                    ],
                    "common_phrases": [
                        "pendule murale",
                        "pendule de cheminée"
                    ]
                },
                {
                    "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                    "sense_definition": "Corps pesant suspendu à un point fixe et qui oscille librement sous l'effet de la gravité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le physicien a mesuré la période d'oscillation du <w>pendule</w> avec beaucoup d'attention."
                        },
                        {
                            "text": "Dans ce musée des sciences, le <w>pendule</w> de Foucault prouve la rotation de la Terre."
                        }
                    ],
                    "synonyms": [
                        "balancier"
                    ],
                    "common_phrases": [
                        "oscillation du pendule",
                        "pendule de Foucault"
                    ]
                },
                {
                    "sense_id": "1a2bc7e8-840f-3996-b55e-37122ea1fdb3",
                    "sense_definition": "Petit objet pesant suspendu à un fil qu'utilisent les radiesthésistes pour trouver des choses cachées.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "esoterisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le radiesthésiste utilise un <w>pendule</w> pour tenter de localiser des sources d'eau souterraines."
                        },
                        {
                            "text": "Elle tient le <w>pendule</w> entre ses doigts au-dessus d'une carte pour chercher un objet perdu."
