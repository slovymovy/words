                                    {
                                        "sense_id": "1d1aeee7-d519-3583-895b-b9fbf919f257",
                                        "entry_id": "e6d03acf-c8b8-3247-b45e-8134f5bb98c6",
                                        "glosses": [
                                            "Prunk, Prachtentfaltung"
