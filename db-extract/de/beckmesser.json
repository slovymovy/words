                ],
                "senses": [
                    {
                        "sense_id": "40854c6a-99a0-3670-bb27-7e7b6a76823d",
                        "entry_id": "5a311c38-a379-3405-9000-7d3a14922dc2",
                        "glosses": [
                            "pedantischer, rechthaberischer, engstirniger Kritiker, der vor lauter Kleinigkeiten das Ganze aus den Augen verliert"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "f38d806a-5b26-4e7d-a934-d1fbb12c327b",
                                "sense_id": "40854c6a-99a0-3670-bb27-7e7b6a76823d",
                                "text": "„Das war der Haken, an dem die Eingesessenen ihre persönliche Nörgelkritik anbringen und höfischer als die Höflinge sich aufspielen konnten: Wagners unerhörte Anmaßung und Formlosigkeit, sich von der Königsloge aus für den Beifall zu bedanken! Die Beckmesser der zünftigen Meistersingerei stürzten sich mit heißen Köpfen in die Redaktionsstuben, um das neue Werk nach allen Regeln ihrer Kunst als eitle Stümperei und größenwahnsinnige Impotenz zu vernichten.“"
                            },
                            {
                                "example_id": "8d90f01c-5604-4c23-bcd3-9d5b6a8cbf91",
                                "sense_id": "40854c6a-99a0-3670-bb27-7e7b6a76823d",
                                "text": "„Nur noch die Pauken so glaubte es der Beckmesser gehört zu haben hielten durch und begleiteten den Gesang auf der Bühne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85742f80-d63a-4610-958d-e42b6b3db26a",
                        "source_entry_id": "5a311c38-a379-3405-9000-7d3a14922dc2",
                        "source_sense_id": "40854c6a-99a0-3670-bb27-7e7b6a76823d",
                        "source_sense_description": "pedantischer, rechthaberischer, engstirniger Kritiker",
                        "target_lang_word": "carper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                        "entry_id": "86f03ca2-bd4b-384f-aef7-d4bc0b4f2683",
                                        "glosses": [
                                            "A person who habitually carps, who talks too much and regularly finds fault."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee6a533-cb37-41cd-a81b-a823a18115e5",
                                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                                "text": "Shame not these woods, / By putting on the cunning of a carper."
                                            },
                                            {
                                                "example_id": "4b3540e6-693a-400f-9dc6-09958c02726e",
                                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                                "text": "Come, let my carper to his life now look,\nAnd find there darker lines than in my book\nHe findeth any […]"
                                            },
                                            {
                                                "example_id": "0c2b2bf8-4499-4f1c-909d-d281ca486fe4",
                                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                                "text": "He censures everything, this zealous carper."
                                            },
                                            {
                                                "example_id": "0431307e-2d12-4dd5-8a64-7d14cc8fd52f",
                                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                                "text": "What is this sort of piece going to do when confronted with row upon row of coldly sober carpers?"
                                            },
                                            {
                                                "example_id": "6eb3870b-371a-49d9-b978-f6e9ab2ff9f8",
                                                "sense_id": "2218ff1b-bed7-32a5-b4d8-4663644d2dae",
                                                "text": "[…] Lady Tipper […] shook her head in wounded defiance of all the carpers and whiners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2facfe28-fa01-4880-9c04-b65f11078a39",
                        "source_entry_id": "5a311c38-a379-3405-9000-7d3a14922dc2",
