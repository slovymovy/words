                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undocumented immigrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9afd09af-6014-3e90-b0a2-1b64209b20df",
                                        "entry_id": "9cd974fc-3a2c-34c7-92d6-da5de1aeda06",
                                        "glosses": [
                                            "An immigrant who has entered a country (often as a migrant worker) and has no documentation authorizing them to (still) be present there."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edd2479-b942-46c6-aadc-c9be94877225",
                                                "sense_id": "9afd09af-6014-3e90-b0a2-1b64209b20df",
                                                "text": "All the research studies found a very low rate of social service utilization by undocumented immigrants."
                                            },
                                            {
                                                "example_id": "c11fa9d1-4de3-418a-be6b-e5634fac8dba",
                                                "sense_id": "9afd09af-6014-3e90-b0a2-1b64209b20df",
                                                "text": "Rulings that ensure from these cases apply to varying degrees to undocumented immigrant students as well as to legal immigrant students."
                                            },
                                            {
                                                "example_id": "f2fd066e-2837-40e3-a392-8c89a08d3990",
                                                "sense_id": "9afd09af-6014-3e90-b0a2-1b64209b20df",
                                                "text": "However, an accompanied undocumented immigrant child should not be removed from his or her family , unless there are grounds for removal in terms of section 14(4) of the Child Care Act, 1983."
                                            },
                                            {
                                                "example_id": "fe577bdf-eb19-4fc0-8e9c-d89f35d0a089",
                                                "sense_id": "9afd09af-6014-3e90-b0a2-1b64209b20df",
                                                "text": "In the Atlanta suburb of Lilburn, ICE agents arrested Walter Valladares, a 53-year-old undocumented immigrant from Honduras, according to family members who spoke with CNN."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
