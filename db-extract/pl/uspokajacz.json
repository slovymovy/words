                        "entry_id": "9e6236c3-6794-3b64-a94b-ea53070a1cc1",
                        "glosses": [
                            "ten, kto wprowadza spokój, ład, porządek"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ce14272c-dfab-4afb-9148-ed64700390d1",
                                "sense_id": "350eb2d1-12d0-3cf2-9a16-377442ab454a",
                                "text": "Pfuel zaopatrzony w działa i w bagnety, przyjeżdżał jako rozjemca i uspokajacz i ażeby wedle nowo zdobytych przez swój naród zasad wolności i braterstwa kraj uspokoić i sprawiedliwość komu należało wymierzyć, ogłosił prawo doraźne, na mocy którego każdy Polak schwytany z bronią w ręku miał być natychmiast rozstrzelany …"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
