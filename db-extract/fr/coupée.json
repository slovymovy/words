                "senses": [
                    {
                        "sense_id": "20065ef5-08f3-3583-947a-bdd78a85d85f",
                        "entry_id": "8a781333-f88d-3316-90b8-4cf8ba217701",
                        "glosses": [
                            "Coupure du pont d’un navire de commerce dont l’arrière est exhaussé pour donner aux cabines plus d’élévation."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71868fbc-e79b-3573-a090-c8edce828048",
                        "entry_id": "8a781333-f88d-3316-90b8-4cf8ba217701",
                        "glosses": [
                            "Ouverture dans le bordé pour monter ou descendre d'un navire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1b2f48a-5697-42cb-b66b-c51464450f68",
                                "sense_id": "71868fbc-e79b-3573-a090-c8edce828048",
                                "text": "À la coupée du navire, Tartarin fut reçu par l’officier de service et conduit dans une cabine des premières avec les plus grands égards."
                            },
                            {
                                "example_id": "f211dc44-e1c1-41a7-8e5d-fa78363aee1d",
                                "sense_id": "71868fbc-e79b-3573-a090-c8edce828048",
                                "text": "L’Itabera illumine le quai. Je trouve le bateau admirable.[…]. Des voyageurs montent à la coupée et en descendent. Nous la gravissons à notre tour."
                            },
                            {
                                "example_id": "c0c1e938-4e90-424a-90e7-f10d6590627b",
                                "sense_id": "71868fbc-e79b-3573-a090-c8edce828048",
                                "text": "Tous deux virent alors une forme souple et toute noire se glisser vers la coupée, dans l'intention évidente de quitter le bord."
                            },
                            {
                                "example_id": "ea8ae2e4-119e-446f-ad08-757567353c69",
                                "sense_id": "71868fbc-e79b-3573-a090-c8edce828048",
                                "text": "Clappique regardait la coupée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
