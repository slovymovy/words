                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba4a39e5-d063-4ebe-86ec-7595e2906053",
                                                "sense_id": "3b13e122-9d54-3bed-9855-240f82c2a79d",
                                                "text": "Il faut alors recourir à un systémique qui, en pénétrant la plante et en étant véhiculé par la sève, empoisonnera le puceron trop gourmand."
                                            }
                                        ]
