                ],
                "senses": [
                    {
                        "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                        "entry_id": "a8817973-6fb3-3921-b409-e6d9d76bcaae",
                        "glosses": [
                            "Sportgattung, bei der sich ein Mensch mit oder ohne ein Fluggerät im Luftraum bewegt, beziehungsweise bei dem ein unbemanntes Fluggerät durch die Luft bewegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea31c7e-14f6-4e78-ae92-e35165644a3e",
                                "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                                "text": "„Wir schreiben hier über den Motorflug, weil sich hier die Nöte des westdeutschen Luftsportes besonders kraß abzeichnen.“"
                            },
                            {
                                "example_id": "eecc16b7-4c3c-4083-a063-bd184c2c4385",
                                "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                                "text": "„Das ganze Spektrum der Faszination Luftsport stellt der Verdener Luftfahrt-Verein bei seinem Tag der offenen Tür an diesem Sonntag, 19. Mai, auf dem Flugplatz in Scharnhorst vor.“"
                            },
                            {
                                "example_id": "6d453578-00d4-440f-8d04-7e95a332e90c",
                                "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                                "text": "„Die Ergebnisse wurden als Empfehlungen an den DAeC weitergeleitet, denn beschließen können die Segelflieger nichts, weil sie bislang – ebenso wie die Motorflieger, Modellflieger, Ballonfahrer und Fallschirmsportler – keine selbständige Sparte innerhalb des DAeC bilden, der den gesamten Luftsport beim Internationalen Luftfahrt-Verband (FAI) vertritt.“"
                            },
                            {
                                "example_id": "ac813096-2c61-4be2-a605-9f8d00fa4056",
                                "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                                "text": "„Die technischen Fortschritte erlauben es dem Menschen allerdings erst seit dem 19. Jahrhundert, Luftsport zu betreiben. Mit unterschiedlichen Flug- und Luftsportarten kann man der Illusion vom Fliegen ein Stückchen näher kommen – mal mehr und mal weniger riskant.“"
                            },
                            {
                                "example_id": "60850926-18e8-408a-9e42-4244aa559db7",
                                "sense_id": "0f816c31-5f5e-3ea9-bb0e-f2250700cd5c",
                                "text": "„Zu den Hobby-Sportarten aus Sicht des Rechnungshofes zählen Golf, Bergsteigen, Billard, Bowling, Kegeln, Luftsport, Motorsport, Motorbootyachtsport, Schach, Tanzen, Tauchen und Wandern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
