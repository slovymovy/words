                    {
                        "translation_id": "def3c3e6-4a39-4ca8-b075-05ef7c16217b",
                        "source_entry_id": "5e4c7f32-bc6f-3c92-badb-d1f0674416bc",
                        "source_sense_id": "87fedf08-62b2-3569-b73c-2f45a00214fc",
                        "target_lang_word": "éthylique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éthylique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c009807-aefc-3b5d-b7e8-2a998685a74e",
                                        "entry_id": "3d9b5eb8-b7f1-32e7-b262-d7b031342644",
                                        "glosses": [
                                            "Qui contient de l’éthyle ou, par extension, de l’alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1630a0e1-cf59-4f6e-a0ae-7e23f27aa4e4",
                                                "sense_id": "1c009807-aefc-3b5d-b7e8-2a998685a74e",
                                                "text": "À l’aldéhyde éthylique CH₃.CHO correspond un dérivé trichloré, CCl₃.CHO, le chloral, très employé sous forme d’hydrate."
                                            },
                                            {
                                                "example_id": "d4bfa3f9-838b-4eff-8501-8850527ff7c8",
                                                "sense_id": "1c009807-aefc-3b5d-b7e8-2a998685a74e",
                                                "text": "L’alcool éthylique ou éthanol se trouve dans toutes les boissons alcoolisées, c’est aussi un désinfectant, un carburant, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a57ac748-0e67-3817-91a2-b15fbb3c28cb",
                                        "entry_id": "3d9b5eb8-b7f1-32e7-b262-d7b031342644",
                                        "glosses": [
                                            "Qui est lié à une trop forte consommation d’alcool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e75224-4ef5-40df-ac9a-03c072ba1d08",
                                                "sense_id": "a57ac748-0e67-3817-91a2-b15fbb3c28cb",
                                                "text": "Il a fait un coma éthylique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02d73393-06fb-3793-83f7-c80fb61d32d4",
                                        "entry_id": "3d9b5eb8-b7f1-32e7-b262-d7b031342644",
                                        "glosses": [
                                            "Alcoolique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b6a3a1-a977-45de-bb55-a73115d5282f",
                                                "sense_id": "02d73393-06fb-3793-83f7-c80fb61d32d4",
                                                "text": "C'est une erreur, les statistiques du XIXᵉ siècle démontrent que les misérables des fabriques cotonnières ou sidérurgiques se suicidaient très peu, et n'étaient absolument pas éthyliques, au contraire de leur bourgeois et petits commerçants."
                                            },
                                            {
                                                "example_id": "c4bfe0de-eeeb-4a2d-a6ac-efacca761669",
                                                "sense_id": "02d73393-06fb-3793-83f7-c80fb61d32d4",
                                                "text": "En chuchotant, on se souvient des coups de fil désespérés d’une Laeticia confrontée pour la première fois aux excès éthyliques de son mari, ces semaines entières où elle restait barricadée dans sa chambre après ses multiples fausses couches, les coups de fil répétés à Bernadette Chirac et à Philippe Douste-Blazy afin de faire progresser le dossier d’adoption de Jade."
                                            },
                                            {
                                                "example_id": "b0abfb61-cb12-42df-b147-178ae50a7e15",
                                                "sense_id": "02d73393-06fb-3793-83f7-c80fb61d32d4",
                                                "text": "L’éthylique concept de l’émission « Les Recettes pompettes », qui doit être diffusée à partir du 13 avril sur YouTube, n’a pas été du goût du ministère de la santé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éthylique",
