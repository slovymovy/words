                        ],
                        "form": "gogoles"
                    },
                    {
                        "form_id": "65279347-1dae-42bb-a5d3-65b9d408f53a",
                        "entry_id": "f8cd74bb-017d-3025-a913-7890b768657b",
                        "tags": [
                            "masculine"
                        ],
                        "form": "gogol"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90441052-1790-3993-8fd8-81153183670d",
                        "entry_id": "f8cd74bb-017d-3025-a913-7890b768657b",
                        "glosses": [
                            "Sotte ; demeurée ; imbécile."
                        ],
                        "tags": [
                            "offensive",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "934851d3-708a-4ff8-9239-96785afcfd0a",
                                "sense_id": "90441052-1790-3993-8fd8-81153183670d",
                                "text": "— Marie ? Complétement stone ! M'a regardé passer comme une gogole, elle m'a même souri, elle m'a dit un truc, ses lèvres bougeaient mais y’avait rien qui sortait, gogole, j’te dis !"
                            },
                            {
                                "example_id": "d63fe13a-329e-4cf1-8081-52286daba79e",
                                "sense_id": "90441052-1790-3993-8fd8-81153183670d",
                                "text": "— Mais me regardez pas comme ça ! s'énerva-t-elle. J'suis pas une gogole, je retrouve un disparu sur quatre avec mon pendule !"
                            },
                            {
                                "example_id": "7c038080-9d7c-4158-b497-b29ca2f0ee3b",
                                "sense_id": "90441052-1790-3993-8fd8-81153183670d",
                                "text": "— Hé Véronique, tu confonds une sonnerie et un interrupteur.\n— Faut pas nous prendre pour des gogoles, merde !."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4041b56-c208-47d4-8f52-22da53b474f7",
                        "source_entry_id": "f8cd74bb-017d-3025-a913-7890b768657b",
                        "source_sense_id": "90441052-1790-3993-8fd8-81153183670d",
                        "target_lang_word": "gimp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gimp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28c426f3-87d1-32da-8532-59cdc9e80299",
                                        "entry_id": "a7289c50-f347-305d-ab7d-caeca1b4e35f",
                                        "glosses": [
                                            "A narrow ornamental fabric or braid of silk, wool, or cotton, often stiffened with metallic wire or coarse cord running through it, used as trimming for dresses, curtains, furniture, etc. Also guimpe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ceea29-1135-459a-af1a-282bd4933ee6",
                                                "sense_id": "28c426f3-87d1-32da-8532-59cdc9e80299",
                                                "text": "They sat about in black and shiny and flouncey clothing adorned with gimp and beads, eating great quantities of cake, drinking much tea in a stately manner and reverberating remarks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a653cf0-75a4-3e9c-90ac-9d81c776549a",
                                        "entry_id": "a7289c50-f347-305d-ab7d-caeca1b4e35f",
                                        "glosses": [
                                            "Any coarse or reinforced thread, such as a glazed thread employed in lacemaking to outline designs, or silk thread used as a fishing leader, protected from the bite of fish by a wrapping of fine wire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43355594-5531-4158-a1e4-bef50c2fe500",
                                                "sense_id": "1a653cf0-75a4-3e9c-90ac-9d81c776549a",
                                                "text": "I'm a fisher of men and my gimp is doing a saltarello over every body of water to fetch up what it may."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae4cb70-12b6-35fd-beba-2af6d6fa4361",
                                        "entry_id": "a7289c50-f347-305d-ab7d-caeca1b4e35f",
                                        "glosses": [
                                            "The plastic cord used in the plaiting and knotting craft scoubidou (lanyard making); or, the process itself."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d4f9fca-26dd-39c3-af21-e6f08a3b4a11",
                                        "entry_id": "a7289c50-f347-305d-ab7d-caeca1b4e35f",
                                        "glosses": [
                                            "Gumption."
                                        ],
                                        "tags": [
                                            "Northeastern",
                                            "US",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8003789d-0aeb-4d9c-a3f7-5588b5d15f3f",
                                                "sense_id": "7d4f9fca-26dd-39c3-af21-e6f08a3b4a11",
                                                "text": "Love them and encourage them, but put some 'gimp' into them."
                                            },
                                            {
                                                "example_id": "4b8d5413-7ec5-4f88-a1c5-98e7b83c18ff",
                                                "sense_id": "7d4f9fca-26dd-39c3-af21-e6f08a3b4a11",
                                                "text": "You haven't got gimp enough to, any more than you could smash the rest of that pint, instead of swallowing it. You're a weakling..."
                                            },
                                            {
                                                "example_id": "b7930974-abd7-44b8-b849-07637cb56568",
                                                "sense_id": "7d4f9fca-26dd-39c3-af21-e6f08a3b4a11",
                                                "text": "When people put a lot on what their folks used to do, it always means they haven't got gimp enough left to do anything themselves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gimp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67f4faa3-416a-393d-ab55-eff52d0413ec",
                                        "entry_id": "f1f90921-b439-3ce0-bfda-f3a3e0f4486c",
                                        "glosses": [
                                            "Of yarn, cord, thread, etc., to wrap or wind (surround) with another length of yarn or wire in a tight spiral, often by means of a gimping machine, creating 'gimped yarn', etc. Also, generally, to wrap or twist with string or wire. See gimped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c9f002-2b8c-44f2-837c-ac65b1a293d0",
                                                "sense_id": "67f4faa3-416a-393d-ab55-eff52d0413ec",
                                                "text": "It consists of seventy fine spun cotton threads, gimped or tied around with thread by a machine similar to that for wrapping bonnet wire."
                                            },
                                            {
                                                "example_id": "6d350808-61c8-43d7-a1f5-d189d4aa314c",
                                                "sense_id": "67f4faa3-416a-393d-ab55-eff52d0413ec",
                                                "text": "...low strings later than the mid-seventeenth century are commonly gimped (wound with fine wire on a moderate core) to allow sufficient tension without excessive mass or stiffness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9129ad-f0c8-3e4c-a277-15107998198f",
                                        "entry_id": "f1f90921-b439-3ce0-bfda-f3a3e0f4486c",
                                        "glosses": [
                                            "To notch or indent; to jag or make jagged; to edge with serrations or grooves."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2177d26e-3c8e-4b68-b7f7-9b78b9cd46e3",
                                                "sense_id": "cf9129ad-f0c8-3e4c-a277-15107998198f",
                                                "text": "They are prettier cut and gimped in the shape of wheels."
                                            },
                                            {
                                                "example_id": "93dde3e7-c183-4a6f-95ec-4f8bba2f05d5",
                                                "sense_id": "cf9129ad-f0c8-3e4c-a277-15107998198f",
                                                "text": "This active material consists of a tape of pure lead, which is gimped whilst cold with deep grooves and ridges..."
                                            },
                                            {
                                                "example_id": "a787268e-63bf-4194-8928-ec956cbef6dc",
                                                "sense_id": "cf9129ad-f0c8-3e4c-a277-15107998198f",
                                                "text": "Each hole is filled by a rosette of pure lead made by rolling up lead strip or tape which has been gimped or corrugated."
                                            },
                                            {
                                                "example_id": "5455e40e-35a3-46b6-b210-d4f284549dc1",
                                                "sense_id": "cf9129ad-f0c8-3e4c-a277-15107998198f",
                                                "text": "In some cases the leather has to be decorated with perforations while its edges may be serrated or gimped."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gimp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fef9a2cc-8b0c-3790-8a3a-61620a13d750",
                                        "entry_id": "0faacfd0-94a9-3b86-9915-54ded90f2a2e",
                                        "glosses": [
                                            "A person who is lame due to a crippling of the legs or feet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d58417-b097-4137-9501-3ec5bb29ce57",
                                                "sense_id": "fef9a2cc-8b0c-3790-8a3a-61620a13d750",
                                                "text": "(person)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0325e2-1f55-34e2-8350-66c216316c17",
                                        "entry_id": "0faacfd0-94a9-3b86-9915-54ded90f2a2e",
                                        "glosses": [
                                            "A crippled leg."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10d5f449-49e8-30cb-89c7-f2f20045aa59",
                                        "entry_id": "0faacfd0-94a9-3b86-9915-54ded90f2a2e",
                                        "glosses": [
                                            "A limp or a limping gait."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f89b584-2b8c-4542-a40c-6ad44d4b83ca",
                                                "sense_id": "10d5f449-49e8-30cb-89c7-f2f20045aa59",
                                                "text": "She walks with a gimp in one leg, which is why she is called Madame La Gimp..."
                                            },
                                            {
                                                "example_id": "71383109-2ae8-4966-bac6-f03cae492b2c",
                                                "sense_id": "10d5f449-49e8-30cb-89c7-f2f20045aa59",
                                                "text": "...Flat-wheel Walter...who is called by this name because he walks with a gimp on one side..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6c3a38-436d-3d2a-bd86-86f079b6cc8f",
                                        "entry_id": "0faacfd0-94a9-3b86-9915-54ded90f2a2e",
                                        "glosses": [
                                            "A name-calling word, generally for a person who is perceived to be inept, deficient or peculiar."
                                        ],
