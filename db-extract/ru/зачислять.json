                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dcbd280-fa7a-4da3-a932-7d74cef1aedc",
                        "source_entry_id": "f158d261-56ea-3051-a08e-1384e2e1f543",
                        "target_lang_word": "enlist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c10df03-97da-3a10-8cae-c83838ba99d7",
                                        "entry_id": "d1b6679c-ba5c-3e22-8af3-9d2353571f01",
                                        "glosses": [
                                            "To enter on a list; to enroll; to register."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f2532c5-fdb4-3525-92b3-c5e2e82b0732",
                                        "entry_id": "d1b6679c-ba5c-3e22-8af3-9d2353571f01",
                                        "glosses": [
                                            "To voluntarily join a cause or organization, especially military service."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38035938-a5f2-49d4-b560-0e54ada8282a",
                                                "sense_id": "8f2532c5-fdb4-3525-92b3-c5e2e82b0732",
                                                "text": "The army wants potential soldiers to enlist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac414cf-b9bd-33e8-97f0-418a5a74563e",
                                        "entry_id": "d1b6679c-ba5c-3e22-8af3-9d2353571f01",
                                        "glosses": [
                                            "To recruit the aid or membership of others."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f318b0fa-e333-4499-adf9-4c9d183a6727",
                                                "sense_id": "5ac414cf-b9bd-33e8-97f0-418a5a74563e",
                                                "text": "We enlisted fifty new members."
                                            },
                                            {
                                                "example_id": "4a352213-bb3c-4d29-a4d6-69b05654d4ed",
                                                "sense_id": "5ac414cf-b9bd-33e8-97f0-418a5a74563e",
                                                "text": "“The Emperor visited east-central China (江與京洛), and enlisted 400,000 soldiers and 500 Wu ships to cross the seas and go to P’ing-jang, (the Kao-li capital).”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c77d7a5-c303-3c9d-aa00-812c34a7a3eb",
                                        "entry_id": "d1b6679c-ba5c-3e22-8af3-9d2353571f01",
                                        "glosses": [
                                            "To secure; to obtain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba874a89-1f70-4aca-a25d-faa6784803fc",
                                                "sense_id": "8c77d7a5-c303-3c9d-aa00-812c34a7a3eb",
                                                "text": "They enlisted the government's support."
                                            },
                                            {
                                                "example_id": "92a32a6d-f9e2-4ee5-aca9-0da67bb60170",
                                                "sense_id": "8c77d7a5-c303-3c9d-aa00-812c34a7a3eb",
                                                "text": "“I have tried, as I hinted, to enlist the co-operation of other capitalists, but experience has taught me that any appeal is futile that does not impinge directly upon cupidity. […]”"
