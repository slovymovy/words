                ],
                "senses": [
                    {
                        "sense_id": "6c1cf01d-6f57-3e97-922b-448f66aa2f6a",
                        "entry_id": "42b1112d-8f4e-3f1c-a62a-472c8d708a7e",
                        "glosses": [
                            "Person, welche sich für die Durchführung einer Studie zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806d9f2a-7366-445e-b0f9-d77a0d51e462",
                                "sense_id": "6c1cf01d-6f57-3e97-922b-448f66aa2f6a",
                                "text": "„Wer ein TV-Programm sieht, in dem viel Alkohol vorkommt, trinkt dabei doppelt so viele alkoholische Getränke wie der Zuschauer eines Programms ohne hochprozentigen Inhalt. Das hat eine holländische Studie nachgewiesen. […] Am häufigsten griffen diejenigen Studienteilnehmer zu Kühlschrank-Drinks, die ‚American Pie‘ plus Alkoholwerbung sahen. Sie konsumierten im Schnitt während des Films drei 0,2-Liter-Flaschen alkoholische Getränke.“"
                            },
                            {
                                "example_id": "d27cf0de-71cc-477d-b116-a9eb08d596ec",
                                "sense_id": "6c1cf01d-6f57-3e97-922b-448f66aa2f6a",
                                "text": "Mehr als ein Viertel der Studienteilnehmer gab an, sie hätten als Kind geschlafwandelt, aber nicht mehr in den letzten Jahren."
                            },
                            {
                                "example_id": "6824b75e-526d-450d-aa31-6c2c542ee880",
                                "sense_id": "6c1cf01d-6f57-3e97-922b-448f66aa2f6a",
                                "text": "„37 Prozent der Studienteilnehmer ‚lieben ihren Sprachassistenten so sehr, dass sie sich wünschten, er wäre eine reale Person.‘ […] Das Einzige, was uns dazu noch einfällt: Wo die Liebe hinfällt …“"
                            },
                            {
                                "example_id": "2c008588-450a-4667-b86f-c69f1b9f214c",
                                "sense_id": "6c1cf01d-6f57-3e97-922b-448f66aa2f6a",
                                "text": "„Die biologische Uhr der Studienteilnehmer habe einen starken Effekt auf ihre Aufwachzeit gehabt, nicht nur ihre Wecker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
