                    }
                ],
                "translations": [
                    {
                        "translation_id": "fda5d711-0ea4-436a-b45a-7961527d9f53",
                        "source_entry_id": "61d3597f-8fec-3083-89d0-f45c16bd689b",
                        "source_sense_id": "7e15410a-62bd-3e0c-8336-c7a425b64bb9",
                        "target_lang_word": "streamer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "streamer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb3738d-f2f5-3a7d-8a9b-1fbfce25374c",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A long, narrow flag, or piece of material used or seen as a decoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd07df2-d9be-405d-bc78-0809ab424997",
                                                "sense_id": "1cb3738d-f2f5-3a7d-8a9b-1fbfce25374c",
                                                "text": "Brave Rupert from afar appears, / Whose waving streamers the glad general knows."
                                            },
                                            {
                                                "example_id": "1e155f2a-ba1a-4745-af60-100539f1666a",
                                                "sense_id": "1cb3738d-f2f5-3a7d-8a9b-1fbfce25374c",
                                                "text": "A second squire held aloft his master's lance, from the extremity of which fluttered a small banderole, or streamer, bearing a cross of the same form with that embroidered upon his cloak."
                                            },
                                            {
                                                "example_id": "e9e66e82-9317-4f91-957a-33076faf4e4f",
                                                "sense_id": "1cb3738d-f2f5-3a7d-8a9b-1fbfce25374c",
                                                "text": "Nothing could well resemble less a typical English street than […] the multifarious awnings, banners, and streamers, […]"
                                            },
                                            {
                                                "example_id": "881f02fb-91d4-408f-922b-29987d520562",
                                                "sense_id": "1cb3738d-f2f5-3a7d-8a9b-1fbfce25374c",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c406fb84-5753-35e4-ae74-c941e24fb52a",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "Strips of paper or other material used as confetti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16505370-7602-4e75-9593-399bece5d1bb",
                                                "sense_id": "c406fb84-5753-35e4-ae74-c941e24fb52a",
                                                "text": "[…] from a cancan to a gothic tableau featuring mock-beheaded women at the windows of the Conciergerie with red streamers that looked like macabre spurting blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fff3543-f3a2-325b-93e9-3d9d0e3e1fb1",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A newspaper headline that runs along the top of a page."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00f438fd-2b26-3a52-91ca-4f8a13fad19a",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A data storage system, mainly used to produce backups, in which large quantities of data are transferred to a continuously moving tape; a tape drive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "430be0aa-8f94-36db-bf2c-279403ff048b",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "Any mechanism for streaming data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b90f1cb-196f-4c00-bdf0-a09f0befd172",
                                                "sense_id": "430be0aa-8f94-36db-bf2c-279403ff048b",
                                                "text": "However, integration of a bandwidth estimation algorithm into an adaptive video streamer is not an easy task. Firstly, bandwidth estimation requires sending extra burst packets that brings a considerable overhead into the system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2945eb-ae7a-3a72-b904-581107187df1",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A subscription service that streams content to an audience."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3310d762-f14d-4c89-a948-873721901d48",
                                                "sense_id": "0e2945eb-ae7a-3a72-b904-581107187df1",
                                                "text": "For starters, the business models for American broadcasters like NBC and streamers like Netflix (or Hulu, or Amazon) are drastically different."
                                            },
                                            {
                                                "example_id": "4723b942-6471-429f-b8be-d87046be9727",
                                                "sense_id": "0e2945eb-ae7a-3a72-b904-581107187df1",
                                                "text": "So where HBO used to boast that it was “not TV,” modern streamers send the message, “We’ll give you a whole lot of TV.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f8880d-6dd2-3429-887d-d653e1804d3e",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A person who streams activities on their computer (especially video gaming) to a live online audience."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a0f6b09-01bc-40d2-b627-66d47f24b1f8",
                                                "sense_id": "78f8880d-6dd2-3429-887d-d653e1804d3e",
                                                "text": "Most streamers are on Twitch"
                                            },
                                            {
                                                "example_id": "793c9742-338c-4e3f-bcad-3438c2043ae4",
                                                "sense_id": "78f8880d-6dd2-3429-887d-d653e1804d3e",
                                                "text": "There was perhaps no group of creators more prepared for the horrors of 2020 than streamers. Sitting in front of their cameras, often alone, talking for hours to the camera is what they do, and many are excellent at it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f6cd519-81b4-3a73-a46e-2d25d1b3d8f3",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "In fly fishing, a variety of wet fly designed to mimic a minnow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc8aba2e-b5c7-4f55-9e63-3235353b5cbe",
                                                "sense_id": "9f6cd519-81b4-3a73-a46e-2d25d1b3d8f3",
                                                "text": "Kuster meanwhile nymphed the middle of the Snag. When I joined him, I threw my streamer between the main channel's flow and the skinnier side-channel flow, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af2bc54-fd7e-36b8-848f-66ce1a2a05c2",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "One who searches for stream tin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69be1860-2f13-3137-b7de-9863cd2e255b",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A stream or column of light shooting upward from the horizon, constituting one of the forms of the aurora borealis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b15e5c-3339-4638-94f1-ff3277381ee0",
                                                "sense_id": "69be1860-2f13-3137-b7de-9863cd2e255b",
                                                "text": "While overhead the North's dumb streamers shoot."
                                            },
                                            {
                                                "example_id": "c551922d-d60d-4827-a821-4184b736eba7",
                                                "sense_id": "69be1860-2f13-3137-b7de-9863cd2e255b",
                                                "text": "The moon was indeed at the full, and the northern streamers were shining brilliantly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0543d7-fff2-3124-abba-c668d0891498",
                                        "entry_id": "b60de8f9-6ee4-3c35-a29c-485abf703071",
                                        "glosses": [
                                            "A pupil belonging to a particular stream (division by perceived ability)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113ef0b7-0290-45c9-b392-dae34db4fee8",
                                                "sense_id": "fc0543d7-fff2-3124-abba-c668d0891498",
                                                "text": "Since he also demonstrated that the A-streamers in his sample showed enhancement of measured intelligence over their primary school careers while the B-streamers showed deterioration, it can be seen what a far-reaching effect such decisions may have had upon child performance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
