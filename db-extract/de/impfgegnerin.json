                    {
                        "translation_id": "527f982a-e4b8-428d-a470-9ab055ae8e2b",
                        "source_entry_id": "ac5bb776-6606-3f85-a86a-f283eb6799d1",
                        "source_sense_id": "e8a5a5b7-bcfe-339e-8fc6-26b70710481e",
                        "source_sense_description": "weibliche Person, die Impfungen ablehnt",
                        "target_lang_word": "anti-vaxxer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anti-vaxxer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a34d7f-d976-3cd7-882c-0f87a54b0bbb",
                                        "entry_id": "587a9464-4337-388d-80b9-367bf3bb6f5a",
                                        "glosses": [
                                            "A person who opposes vaccination, as for its purported dangerous effects."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59673a2a-f348-41e9-b641-3fd16ee9a846",
                                                "sense_id": "b3a34d7f-d976-3cd7-882c-0f87a54b0bbb",
                                                "text": "Janice D'Arcy reports at the Washington Post on the latest measles outbreak traced back to anti-vaccination fanatics, but this time, instead of an outbreak being traced back to a Whole Foods or a nursery school---the usual places where the kids of yuppie anti-vaxxers have a chance to expose and be exposed---the trail for this one leads back to the Super Bowl."
                                            },
                                            {
                                                "example_id": "f687239a-32ca-4dae-b24b-4aa295d449cf",
                                                "sense_id": "b3a34d7f-d976-3cd7-882c-0f87a54b0bbb",
                                                "text": "Like everyone else (other than anti-vaxxers, I guess), I was delighted to see the good news about the Pfizer vaccine hopefully being rolled out before Christmas."
                                            },
                                            {
                                                "example_id": "56929966-139c-4ba6-a796-a85f4e9e2460",
                                                "sense_id": "b3a34d7f-d976-3cd7-882c-0f87a54b0bbb",
                                                "text": "She acknowledged the existence of a “cohort of anti-vaxers”, as well as “valid” scepticism among other parts of society given the speed at which the vaccine has been developed. But the bigger issue, she said, will be how they manage a drip feed in supply."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
