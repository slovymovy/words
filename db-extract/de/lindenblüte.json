                    }
                ],
                "translations": [
                    {
                        "translation_id": "810c205c-f7da-4884-982c-66813ec3a7c0",
                        "source_entry_id": "5416df76-6a7a-3343-b435-15bf9346f339",
                        "source_sense_id": "2efc9b61-8215-3b87-a745-262da4ad2069",
                        "source_sense_description": "Botanik: Blüte des Lindenbaumes; blühender Fruchtstand des einhäusigen Laubbaumes Linde",
                        "target_lang_word": "tilleul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tilleul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95bffe00-0058-34be-8a51-7b24e0879ac6",
                                        "entry_id": "cc93c819-70b8-3c2e-8f67-8caaef80d022",
                                        "glosses": [
                                            "Tilia, genre d’arbres de la famille des Malvacées dont les fleurs odorantes et les bractées sont utilisées en infusions apaisantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89d9493-feb1-4c64-9d89-0fbf42642c02",
                                                "sense_id": "95bffe00-0058-34be-8a51-7b24e0879ac6",
                                                "text": "On prit l’habitude de passer les soirées sous un immense tilleul à quelques pas de la maison."
                                            },
                                            {
                                                "example_id": "f0d2bd5d-8c7b-49a1-8d79-f03486d62967",
                                                "sense_id": "95bffe00-0058-34be-8a51-7b24e0879ac6",
                                                "text": "La feuille du tilleul a la forme d’un cœur, dit Henri Heine. Battling en attrapa une pour décorer Céline."
                                            },
                                            {
                                                "example_id": "20b4e87d-149f-424f-ab69-a666574e41b8",
                                                "sense_id": "95bffe00-0058-34be-8a51-7b24e0879ac6",
                                                "text": "En été, la feuille, sorte de carte d’identité, permet d’identifier l’arbre. Celle du tilleul est simple… Son pourtour finement denté dessine une forme plus ou moins parfaite de cœur à la base et se termine en pointe au sommet. À cause de cette base échancrée, la feuille est dite cordée ou encore cordiforme… de manière alterne… distiques."
                                            },
                                            {
                                                "example_id": "881fc783-c744-4099-b83e-8c6df08522f8",
                                                "sense_id": "95bffe00-0058-34be-8a51-7b24e0879ac6",
                                                "text": "Une allée de tilleuls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec0ca64-fc52-3ced-8034-507cbe9770c7",
                                        "entry_id": "cc93c819-70b8-3c2e-8f67-8caaef80d022",
                                        "glosses": [
                                            "Inflorescence séchée de l’arbre servant à faire les tisanes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "541fd80b-458f-40f3-8dd2-c5d23b29eb88",
                                                "sense_id": "8ec0ca64-fc52-3ced-8034-507cbe9770c7",
                                                "text": "Une infusion de tilleul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c7a7a5-12e6-308f-b1ad-814a6a4cf93f",
                                        "entry_id": "cc93c819-70b8-3c2e-8f67-8caaef80d022",
                                        "glosses": [
                                            "Boisson, infusion préparée à partir de ces inflorescences."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66686da-562a-4dbb-b776-1a2b0fe02eea",
                                                "sense_id": "c7c7a7a5-12e6-308f-b1ad-814a6a4cf93f",
                                                "text": "Mets-en dix. Dans son tilleul. Dix cachets de gardénal. Mais tu n’oseras pas."
                                            },
                                            {
                                                "example_id": "79f0d66f-871f-4391-98dc-f2db4249d684",
                                                "sense_id": "c7c7a7a5-12e6-308f-b1ad-814a6a4cf93f",
                                                "text": "— Je boirais volontiers un tilleul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f076dee7-a192-3e40-b0f5-abbf64d9dcf4",
                                        "entry_id": "cc93c819-70b8-3c2e-8f67-8caaef80d022",
                                        "glosses": [
                                            "Bois issu de l’arbre du même nom, très apprécié pour son homogénéité et son travail facile."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8e3927-49ab-43ca-807c-9243c3890563",
                                                "sense_id": "f076dee7-a192-3e40-b0f5-abbf64d9dcf4",
                                                "text": "Dans l’art sacré orthodoxe, le tilleul est le seul bois autorisé pour les icônes."
                                            }
                                        ]
                                    }
                                ]
                            },
