                "translations": [
                    {
                        "translation_id": "cd7bdfd4-f598-46d7-9726-aa8197a7f423",
                        "source_entry_id": "487867e5-6acf-37ee-bbef-d947d9c600ff",
                        "source_sense_id": "2c958cf8-a23e-3b59-9e0b-92670a18c76b",
                        "source_sense_description": "Botanik: Halbschmarotzer; Gattung, die zu der Familie der Sommerwurzgewächse zählt",
                        "target_lang_word": "eyebright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eyebright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                        "entry_id": "f51271b7-ed40-3b99-bb72-e9545bcab4ec",
                                        "glosses": [
                                            "Any of the flowering plants of the genus Euphrasia, originally as used to treat eye infections."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a907e23d-a19d-46e5-874c-9ad99da665d2",
                                                "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                                "text": "Paracelsus had been recommending the plant eyebright for bad eyes in the sixteenth century; it was still in widespread use in the eighteenth."
                                            },
                                            {
                                                "example_id": "0d9d940a-f345-4bb6-b5d5-636fc61d3d53",
                                                "sense_id": "db25dc1c-4bc5-3362-9255-e1bb772e58a7",
                                                "text": "He looks for eyebright, a tiny flowering herb he has seen before, and which he knows would make a good eye-wash: not to be found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9a39031-518d-4727-83bc-f246f60d14b5",
                        "source_entry_id": "487867e5-6acf-37ee-bbef-d947d9c600ff",
                        "source_sense_id": "2c958cf8-a23e-3b59-9e0b-92670a18c76b",
                        "source_sense_description": "Botanik: Halbschmarotzer; Gattung, die zu der Familie der Sommerwurzgewächse zählt",
                        "target_lang_word": "euphraise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphraise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                                        "entry_id": "cec44850-1b3d-3e2d-9467-2ba07297090d",
                                        "glosses": [
                                            "Une plante hémiparasite, assez petite (20 cm de hauteur au maximum), aux feuilles dentées, opposées ou alternes et aux fleurs blanches ou roses, parfois striées de noir et parois avec une tache jaune sur le lobe du milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9d1eaf-007d-4c9d-a884-bbb2bcb4c77f",
                                                "sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                                                "text": "Les chaumes des Vosges sont recouvertes par un gazon composé du gaillet du Hartz, du serpolet, d’euphraises, de joncées et de graminées à feuillage menu, surtout des espèces des genres Luzule, Agrostide, Flouve, Fétuque et Nardus"
                                            },
                                            {
                                                "example_id": "16c78416-799d-4ffd-9785-c34dad579ae9",
                                                "sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                                                "text": "Les euphraises sont des plantes toxiques ; une espèce est médicinale."
                                            },
                                            {
                                                "example_id": "7344bee9-9ecc-4241-b5fc-e55c4513c9ed",
                                                "sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                                                "text": "La chenille de la mélanthie agréable se nourrit sur l'euphraise officinale."
                                            },
                                            {
                                                "example_id": "0ce4c801-bb87-44ba-899b-9cebb264484f",
                                                "sense_id": "f68e8339-1f66-3dde-96b8-2ab0e984a06c",
                                                "text": "Petite fleur rampante, considére comme une « mauvaise » herbe par les jardiniers, l’euphraise médicinale ne paie pas de mine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17aaf66f-1199-45bb-826c-082ccd741d1a",
                        "source_entry_id": "487867e5-6acf-37ee-bbef-d947d9c600ff",
