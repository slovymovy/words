                        "entry_id": "83eaad02-982f-39f1-8cf6-e9f742bf0954",
                        "glosses": [
                            "toestand waarbij het regent op een plaats waar gelijktijdig de zon schijnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f11dbd7-f72d-4615-8162-ee2a9e7633d1",
                                "sense_id": "4d4aae65-2e42-3cfd-9d6a-b31370e7d79a",
                                "text": "Het woord ‘duivelskermis’ verwijst naar het meteorologisch fenomeen dat wel eens ‘kermis in de hel’ genoemd wordt: je regent nat terwijl je in het volle, warme zonlicht staat."
                            }
                        ]
