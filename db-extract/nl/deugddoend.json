                        "sense_id": "5ca5d67f-5c05-32c8-8316-1b61433f8684",
                        "entry_id": "e5409359-d608-39e0-962f-990bb40dde7a",
                        "glosses": [
                            "van iets dat je ervan opknapt; van iets dat je ervan uitrust; van iets dat het je goed doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b533b2-8698-4694-92f7-e6420ebe9655",
                                "sense_id": "5ca5d67f-5c05-32c8-8316-1b61433f8684",
                                "text": "Na een cadeautje ter attentie te hebben ontvangen, sprak Swings nog even zijn verdere ambities uit voor 2018. De 27-jarige Herentenaar begon na een deugddoende skivakantie opnieuw aan de voorbereiding op de zomer."
                            },
                            {
                                "example_id": "cbd621d9-aaaa-43ca-8da0-251c4d2a339a",
                                "sense_id": "5ca5d67f-5c05-32c8-8316-1b61433f8684",
                                "text": "Na een deugddoende pauze tijdens het All-Star Weekend en slechts twee wedstrijden op woensdag stonden er donderdag alweer zes partijen op het programma in de NBA. En die leverden heel wat spektakel op."
                            }
                        ]
                    }
