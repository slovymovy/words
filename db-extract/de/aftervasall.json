                "senses": [
                    {
                        "sense_id": "5a16ae1c-22c0-3ce8-b264-39139f415158",
                        "entry_id": "52b10439-af88-37af-92b9-7c7d38db942f",
                        "glosses": [
                            "Vasall, dessen Lehnsgeber sein Lehen selbst von einem höher gestellten Lehnsherren empfangen hat"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "00c11c7e-3823-4eb0-ae84-11989f240bd9",
                                "sense_id": "5a16ae1c-22c0-3ce8-b264-39139f415158",
                                "text": "„Amalrich erließ in seinen ersten Regierungsjahren die so genannte Assise sur la ligece (siehe Haute Cour von Jerusalem), die Aftervasallen vor Willkürakten ihrer Lehnsherren schützen sollte, und zugleich dazu diente, diese nachgeordneten Vasallen an den König zu binden, […].“"
                            },
                            {
                                "example_id": "7caf8081-620e-41d7-af9c-4a0544077637",
                                "sense_id": "5a16ae1c-22c0-3ce8-b264-39139f415158",
                                "text": "„Er [Gottfried VI.] war ein Vasall des Grafen von Blois, der die Grafenrechte auf Châteaudun hielt, und damit zugleich ein Aftervasall des Grafen von Champagne, welcher der Oberherr von Blois war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
