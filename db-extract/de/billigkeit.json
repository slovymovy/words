                    {
                        "translation_id": "74a7d150-063d-40a1-b740-6478dbfbf717",
                        "source_entry_id": "5a9249de-62f8-3401-998f-61883b271e1a",
                        "source_sense_id": "3cef5266-4bc4-320e-bf40-e5404573e34d",
