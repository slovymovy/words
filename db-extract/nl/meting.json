                                "target_senses": [
                                    {
                                        "sense_id": "30422ad5-482b-3da2-8ba5-60da898add72",
                                        "entry_id": "d4792299-6c26-396b-aa44-f2167ba8ebd2",
                                        "glosses": [
                                            "The act of measuring."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d558962c-747a-3050-b968-692861386325",
                                        "entry_id": "d4792299-6c26-396b-aa44-f2167ba8ebd2",
                                        "glosses": [
                                            "Value (quantity, magnitude, extent or amount) determined by an act of measuring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350f9fa5-e4a6-4cdf-90dc-f1f20531af29",
                                                "sense_id": "d558962c-747a-3050-b968-692861386325",
                                                "text": "Risk is everywhere.[…]For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you. “The Norm Chronicles”[…]aims to help data-phobes find their way through this blizzard of risks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "978111b8-3084-4873-8b1b-b3d610e6cf4c",
                        "source_entry_id": "17b584b8-2511-316d-a5d0-b496e18ce80f",
                        "source_sense_id": "e5d631c2-89f7-30fe-a63d-3244b4d7bc37",
                        "target_lang_word": "mesurage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesurage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b23c2b2e-1782-36a4-bc44-c7ae99a9067a",
                                        "entry_id": "12cfb13c-47a2-3936-bfc0-32610668df66",
                                        "glosses": [
                                            "Action de mesurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b111a58e-bbc4-4fb4-8419-59e37ea118d4",
                                                "sense_id": "b23c2b2e-1782-36a4-bc44-c7ae99a9067a",
                                                "text": "Il est commode de se servir d’une pipette jaugeuse pour le mesurage rapide des 90ᶜᵐ³ d’eau."
                                            },
                                            {
                                                "example_id": "e85c933d-b8fe-4cbd-b6a0-84ec10a802b3",
                                                "sense_id": "b23c2b2e-1782-36a4-bc44-c7ae99a9067a",
                                                "text": "Le sel était alors déchargé sous la surveillance d’un receveur et d’un « commis aux descentes » qui assistaient également à son mesurage et à son « empotassement » par masses séparées dans des salles situées à l’abri des inondations."
                                            },
                                            {
                                                "example_id": "1b8c29aa-f498-4be7-a1f0-5cacfef52f30",
                                                "sense_id": "b23c2b2e-1782-36a4-bc44-c7ae99a9067a",
                                                "text": "Inquiets de son silence ou de ses réponses trop brèves (il ne manœuvrait plus que péniblement la manette de sa radio), ses plus proches voisins, les hommes et les chiens stationnés à quelque trois cent miles de là, firent l’effort de le rejoindre et de le ramener à travers la banquise presque infranchissable, interrompant ses mesurages du pôle antarctique, et aussi sans doute cette vision de l’absolu et de l’illimité qui n’apparaît que quand tout le reste a été vécu et franchi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38ce730-9a78-3a67-bef3-1f816369fa69",
                                        "entry_id": "12cfb13c-47a2-3936-bfc0-32610668df66",
                                        "glosses": [
                                            "Ensemble d’opérations ayant pour but de déterminer une valeur d’une grandeur. — (terme et définition entérinés, entre autres, par l’AFNOR, l’ISO, le Bureau international des poids et mesures (BIPM), la Commission électrotechnique internationale (CEI) et l’Organisation internationale de métrologie légale (OIML))"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
