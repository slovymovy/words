                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8843109a-35c5-43e3-bda5-be29fc0bd75d",
                                                "sense_id": "9f2422d4-a314-3957-ab1f-283f089bda45",
                                                "text": "New Zealand wasted a swag of chances to lose their opening women′s hockey World Cup match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2af3e0-6566-3c5c-8b1f-5fd262b283dd",
                                        "entry_id": "117996b0-6c1a-339c-8911-a448f5f2eba0",
