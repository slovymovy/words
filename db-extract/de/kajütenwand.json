                "senses": [
                    {
                        "sense_id": "576cf44b-0b02-3416-9113-2f3cca7d9f1e",
                        "entry_id": "131009a2-50c5-3364-9c60-34da5123c634",
                        "glosses": [
                            "Wand einer Kajüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f024981-732d-4a86-b067-c6605d0d6a45",
                                "sense_id": "576cf44b-0b02-3416-9113-2f3cca7d9f1e",
                                "text": "„Trotzdem, was auch immer hier vorging, es beunruhigte ihn so sehr, dass er an die gegenüberliegende Kajütenwand ging und einen Blick aus dem Fenster warf.“"
                            },
                            {
                                "example_id": "f40e9754-9f1c-4f21-a2a8-a6ac99137fad",
                                "sense_id": "576cf44b-0b02-3416-9113-2f3cca7d9f1e",
                                "text": "„In der Kajüte war es schon fast dunkel; Suttree spazierte auf dem schmalen Deck umher, zog mit dem Bein einen Hocker heran, nahm Platz und lehnte sich, die Füße auf die Reling gestützt, an die Kajütenwand.“"
                            },
                            {
                                "example_id": "c74a6034-8a8b-4bb3-8908-963cbcf9ceba",
                                "sense_id": "576cf44b-0b02-3416-9113-2f3cca7d9f1e",
                                "text": "„Und ich krümmte mich an die Kajütenwand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
