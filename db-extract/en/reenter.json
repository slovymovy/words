                        ],
                        "form": "reentered"
                    },
                    {
                        "form_id": "a80fc15d-5a72-4f6c-8100-00c9826851ee",
                        "entry_id": "c619169d-42a0-3143-a260-94a93ed80c87",
                        "tags": [
                            "past"
                        ],
                        "form": "reentered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                        "entry_id": "c619169d-42a0-3143-a260-94a93ed80c87",
                        "glosses": [
                            "To enter again; return into."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "39f6b9a9-940c-46ca-8e8a-96a75c6659f9",
                                "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                                "text": "The shuttle reentered the atmosphere."
                            },
                            {
                                "example_id": "96f0b432-ec09-4ff4-a5c7-520a384b1ba1",
                                "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                                "text": "It is no accident that capital punishment is reentering our society on the wave of the conservative reaction to the permissiveness and laxity of the past two decades."
                            },
                            {
                                "example_id": "16b07cab-70cf-4f84-b197-a8b69f1be0da",
                                "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                                "text": "At least five people appeared briefly on the roof of the building, and squatters could be seen tossing firecrackers and building materials out of a window and shouting obscenities as the police moved into the area. But when officers finally reentered the building about 2 A.M., they found no one."
                            },
                            {
                                "example_id": "c5e9a3f2-44c2-4c8e-be27-909e18f2a6de",
                                "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                                "text": "Could this policy have helped to cut the crime rate significantly, especially in areas like New York with disproportionately large concentrations of undocumented and recent immigrants, some of whom were deeply involved in illegal activities? The crackdown could have made a difference if the deportables were in fact expelled, if alien ex-cons who wanted to reenter New York and wreak more havoc could not get back in the country, and if this get-tough policy had the intended effect of deterring unlawful impulses among recent immigrants who were not yet naturalized citizens"
                            },
                            {
                                "example_id": "ae9ca5c7-2b35-49b1-893b-15e43199bec9",
                                "sense_id": "3f388610-aa91-3055-934d-6472cda091d2",
                                "text": "As the zoogleal slime reenters the wastewater, excess solids and waste products are stripped off the media as sloughings. These sloughings are transported with the wastewater flow to a settling tank for removal."
                            }
                        ]
                    },
                    {
                        "sense_id": "73d5c736-55f1-301b-9bd1-dc1469ae56b7",
                        "entry_id": "c619169d-42a0-3143-a260-94a93ed80c87",
                        "glosses": [
                            "To enter again; retype, reinput."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dcda479f-4440-47f3-a38b-cefd96f54d84",
                                "sense_id": "73d5c736-55f1-301b-9bd1-dc1469ae56b7",
                                "text": "We had to reenter a day's worth of data into the system."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f1d7f4d-c2da-3718-8bfa-5d54c0064f9d",
                        "entry_id": "c619169d-42a0-3143-a260-94a93ed80c87",
                        "glosses": [
                            "To cut deeper where the aqua fortis has not bitten sufficiently."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27055e1f-f568-492f-91fd-3991451f2085",
                        "source_entry_id": "c619169d-42a0-3143-a260-94a93ed80c87",
                        "source_sense_description": "to enter again",
                        "target_lang_word": "rentrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rentrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Entrer de nouveau, entrer après être sorti, revenir à."
                                        ],
                                        "tags": [
                                            "Sauf au Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef314c30-8394-4d65-9701-ee807ceaaeff",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "La mer est dure et houleuse, le remorquage pénible. A midi, la remorque casse et le motor yacht me quitte fort vite en me saluant, car il désire rentrer avant l'arrivée du grain."
                                            },
                                            {
                                                "example_id": "c0646c3e-3dda-41be-9d24-b9ad408be212",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "Les truands se dissimulaient dans toutes les encoignures des maisons, et gare au bon bourgeois cousu d'or, qui rentrait trop tard chez lui."
                                            },
                                            {
                                                "example_id": "b6cb6cb0-06bd-41f1-a25e-ac852491aea0",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "Avant que le train atteignît la station de Ghéok-Tepé, je suis rentré dans le wagon."
                                            },
                                            {
                                                "example_id": "a262a818-b7d3-492f-90bf-00d8c3fc83ef",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "Daumier montre à ses lecteurs ce qui se passe lorsque les louis-philippards se rendent à la revue et veulent rentrer chez eux. Ils sont trempés par l'eau qui tombe à foison."
                                            },
                                            {
                                                "example_id": "ba8e74ad-da28-46bb-912c-90097bac7edb",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "Il faisait un froid de gueux. Dans la ville, sous un ciel plus que sombre les rares passants se pressaient de rentrer au plus tôt chez eux ou à leur travail, pour ceux qui en avaient."
                                            },
                                            {
                                                "example_id": "454f8daa-522e-4f25-9e41-8490769a86f5",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "Rentrer en soi-même, faire réflexion sur soi-même."
                                            },
                                            {
                                                "example_id": "ab41002a-d15a-4a4e-a458-65950dd08b85",
                                                "sense_id": "5b6f3081-b250-3cfc-beb5-f288865827d6",
                                                "text": "La Reine réfléchit un moment, comme pour rentrer en elle-même, en mettant son doigt sur ses lèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca027853-1496-3407-96cf-3c415fc0eca5",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Entrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "210d8e88-4be7-4158-ac4c-4f0519a2c112",
                                                "sense_id": "ca027853-1496-3407-96cf-3c415fc0eca5",
                                                "text": "Elle est rentrée dans l’armée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a525f7-fe42-3fe1-a643-9ce89414e249",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Recouvrer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5a7805f-7605-4ec3-a808-05c9fa56e691",
                                                "sense_id": "b2a525f7-fe42-3fe1-a643-9ce89414e249",
                                                "text": "Rentrer dans son bien, dans ses droits."
                                            },
                                            {
                                                "example_id": "a432c2b3-dfd9-410d-bf11-50d2cd0de1dd",
                                                "sense_id": "b2a525f7-fe42-3fe1-a643-9ce89414e249",
                                                "text": "Rentrer dans ses débours. recouvrer les sommes que l’on a dépensées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9ba72f-994b-3ce2-833b-7045fcfac4e9",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Pénétrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb668f0-a885-4692-8d12-ea8503e49729",
                                                "sense_id": "ac9ba72f-994b-3ce2-833b-7045fcfac4e9",
                                                "text": "La bataille s’est livrée avant qu'il y arrivât. Il a échappé au désastre et il s’est replié sur Paris, où il est rentré, trois jours avant que l’investissement fût complet."
                                            },
                                            {
                                                "example_id": "b88727b5-f98a-4575-be69-efc4ffce24db",
                                                "sense_id": "ac9ba72f-994b-3ce2-833b-7045fcfac4e9",
                                                "text": "Il pleuvait, je suis rentré dans le hall pour m'abriter."
                                            },
                                            {
                                                "example_id": "b343096b-5fbd-4a5f-9197-dd9714d66c27",
                                                "sense_id": "ac9ba72f-994b-3ce2-833b-7045fcfac4e9",
                                                "text": "Faire rentrer quelqu’un sous terre, accabler quelqu’un, le confondre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3daf55-f9c2-3e8d-95b0-dd2117cc1621",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "S’emboîter ou s’enfoncer dans une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931e4cca-85f6-4c7e-a20e-f5afa7f78a02",
                                                "sense_id": "2e3daf55-f9c2-3e8d-95b0-dd2117cc1621",
                                                "text": "Il n'y avait aucun risque de collision, car le schnorchel avait été rentré pour cette raison même, et le submersible vivait sur ses réserves d'air."
                                            },
                                            {
                                                "example_id": "0d094feb-37f6-4b90-9923-3cdeee9fdd9d",
                                                "sense_id": "2e3daf55-f9c2-3e8d-95b0-dd2117cc1621",
                                                "text": "Tous ces vêtements ne rentreront jamais dans ma valise."
                                            },
                                            {
                                                "example_id": "4e93c53c-4812-4418-8a77-9530a9bd22bb",
                                                "sense_id": "2e3daf55-f9c2-3e8d-95b0-dd2117cc1621",
                                                "text": "Le cou lui rentre dans les épaules, Son cou s’enfonce entre ses épaules."
                                            },
                                            {
                                                "example_id": "5580ce7d-cd88-4450-a428-e6b817903873",
                                                "sense_id": "2e3daf55-f9c2-3e8d-95b0-dd2117cc1621",
                                                "text": "Les jambes me rentrent dans le corps, je suis très fatigué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abaffc8-d272-3375-ae4a-81886af23959",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Enfoncer, percuter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d11c573-a4e0-45ad-b2f4-d0a84fc5428c",
                                                "sense_id": "3abaffc8-d272-3375-ae4a-81886af23959",
                                                "text": "Un camion est rentré dans ma portière."
                                            },
                                            {
                                                "example_id": "02bfb047-572e-45e9-9c53-b9f900a43ac6",
                                                "sense_id": "3abaffc8-d272-3375-ae4a-81886af23959",
                                                "text": "La rue est verglacée. Le voisin est rentré dans un arbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "929a2ae9-45f6-3eeb-84da-09d6361a1403",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Être contenu, renfermé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9103c499-3a9d-46b4-a7b9-7531f16f4854",
                                                "sense_id": "929a2ae9-45f6-3eeb-84da-09d6361a1403",
                                                "text": "Le second article de la loi rentre dans le premier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c76faa-7c38-389c-b9a1-a3977ed2465a",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Reprendre le travail, après les vacations, après les vacances, après une interruption pour congé-maladie ou autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327f079e-b3e2-4ee8-965c-ea8359b60e92",
                                                "sense_id": "a1c76faa-7c38-389c-b9a1-a3977ed2465a",
                                                "text": "Les tribunaux, les collèges rentrent à telle époque."
                                            },
                                            {
                                                "example_id": "6561a22e-f5e3-4712-b9fa-a79c67a28d2b",
                                                "sense_id": "a1c76faa-7c38-389c-b9a1-a3977ed2465a",
                                                "text": "Ce comédien rentre ce soir dans le rôle d’Oreste."
                                            },
                                            {
                                                "example_id": "9c06cd34-b62e-4ef5-91b0-a42d933f69ba",
                                                "sense_id": "a1c76faa-7c38-389c-b9a1-a3977ed2465a",
                                                "text": "Et qu'ont-ils à rentrer chaque année les artistes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faaed80d-8ccf-3b19-802e-eda5cee9ca7c",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Arriver, être touché, être perçu, en parlant des revenus, des sommes à recouvrer,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214decff-1221-4ce5-a099-66bd0914057a",
                                                "sense_id": "faaed80d-8ccf-3b19-802e-eda5cee9ca7c",
                                                "text": "Ce revenu a peine à rentrer."
                                            },
                                            {
                                                "example_id": "ea5142a9-2c48-4d88-863f-0d0610ae5399",
                                                "sense_id": "faaed80d-8ccf-3b19-802e-eda5cee9ca7c",
                                                "text": "Il doit lui rentrer des fonds dans quelques jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375ff513-b9c8-3419-9dd3-725d2a070611",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Il se dit des humeurs dont on arrête l’épanchement au-dehors."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25f82728-c071-4d81-afe8-d908249af1d4",
                                                "sense_id": "375ff513-b9c8-3419-9dd3-725d2a070611",
                                                "text": "Un charlatan lui a fait rentrer ses dartres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c7aa50-daab-3ec8-bb00-73ac3be2af06",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Repasser la pointe ou le burin dans les tailles déjà faites, pour les approfondir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e718d265-d6b6-3e0d-8d64-86b264959211",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "il se dit des cartes que l’on prend au talon à la place de celles qu’on a écartées."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36ba69f-3900-433a-ba7d-9a8bd9623d65",
                                                "sense_id": "e718d265-d6b6-3e0d-8d64-86b264959211",
                                                "text": "Il m’est rentré deux as, deux atouts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Porter ou reporter dedans, ramener dedans ce qui était dehors."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8301dde9-e526-4102-8934-7b63b1b87ff5",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "Je vais rentrer les enfants."
                                            },
                                            {
                                                "example_id": "0f2f872d-9ad1-4a89-a6c3-c0df4319e9d5",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "C’est l’heure de rentrer les bestiaux."
                                            },
                                            {
                                                "example_id": "ec846c16-477f-42c6-a781-32eb06304c73",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "Rentrer des marchandises dans le magasin."
                                            },
                                            {
                                                "example_id": "4d882ee3-6d2f-4e6a-a655-62dca1f95f86",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "Rentrer des pots de fleurs, des orangers."
                                            },
                                            {
                                                "example_id": "8bec2d39-bc85-4880-85a4-f1db86826b9f",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "Voici le moment de rentrer les foins."
                                            },
                                            {
                                                "example_id": "bdff7a31-e92f-43f8-9313-b229a341ad28",
                                                "sense_id": "db57d95f-503c-35a2-ad12-07d91942a088",
                                                "text": "J’ai pas de conseils à te donner, mais si tu ne votes pas pour ma liste, tu peux te fouiller pour que je te prête le carcan pour rentrer tes foins et faire tes charrois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63e1f27e-4a90-3e99-b1bc-99fecb6aba44",
                                        "entry_id": "3c120647-c096-3661-85a7-a7c9d3aae8be",
                                        "glosses": [
                                            "Renfoncer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b6e194-5027-4538-863f-1a175fce0936",
                                                "sense_id": "63e1f27e-4a90-3e99-b1bc-99fecb6aba44",
                                                "text": "Rentrer, faire rentrer une ligne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34b01cc8-35cd-4855-afd8-6054598a5a4e",
