                                        "entry_id": "edc5dddc-0ef0-3e19-93d4-220962f86bcb",
                                        "glosses": [
                                            "eine glykosidische Verbindung aus einem Fructose- und einem Glucose-Baustein"
                                        ],
                                        "tags": [
                                            "Organik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e95047f-7786-4314-b322-901da99954d8",
                                                "sense_id": "348db08e-0e54-396d-b1ef-659023c9f699",
                                                "text": "Jeder hat reine Saccharose als normalen Haushaltszucker bei sich zu Hause."
                                            }
                                        ],
