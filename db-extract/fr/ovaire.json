        "fr-extract.jsonl": [
            {
                "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                "word": "ovaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b1e1101-0dcb-4be7-bbec-e067d86722c8",
                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                        "tags": [
                            "plural"
                        ],
                        "form": "ovaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8caf0c44-0758-3fd3-8b92-d6979dc1c294",
                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                        "glosses": [
                            "Organe pair du système reproducteur femelle, présent chez la plupart des animaux, où sont produits les ovules."
                        ],
                        "tags": [
                            "Reproduction"
                        ],
                        "examples": [
                            {
                                "example_id": "e6e81b1c-c815-4b33-9165-2a9e3509932e",
                                "sense_id": "8caf0c44-0758-3fd3-8b92-d6979dc1c294",
                                "text": "C’est l’hormone de l’ovaire (folliculine) qui fait apparaître le plumage particulier de la poule, qui suscite le rut chez les mammifères."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                        "glosses": [
                            "Glande reproductrice située dans le pelvis de la femme, latéralement à l’utérus, qui produit les ovocytes et sécrète les hormones sexuelles féminines (œstrogènes, progestérone)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2821b7be-afe9-4904-acfd-f8b6b96257fd",
                                "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                                "text": "[Charcot] découvre les zones hystérogènes, [et] peut, en maniant adroitement les ovaires, enrayer ou accélérer les crises."
                            },
                            {
                                "example_id": "99953d8f-01ee-4c71-a763-486d17211a12",
                                "sense_id": "b6c5c526-d60b-34b1-a3ba-5a764725e2fb",
                                "text": "La fausse puberté précoce isosexuelle est secondaire à une sécrétion œstrogénique anormale par une tumeur de l’ovaire ou des surrénales sans maturation ovarienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a7c2d35-65b3-33f7-bb95-1a9c5bef9be4",
                        "entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                        "glosses": [
                            "Partie inférieure du pistil des plantes à fleurs, contenant les ovules et se transformant en fruit après la fécondation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e4f2dc-07e3-4d65-9154-3f7a590d1ebd",
                                "sense_id": "9a7c2d35-65b3-33f7-bb95-1a9c5bef9be4",
                                "text": "L’auxine est normalement apportée dans l’ovule par le pollen et l’on pense que la pollinisation doit stimuler la production d’auxine par l’ovaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9ea60fe-cb74-431d-acd9-0f3312cdf9c0",
                        "source_entry_id": "b1cf7482-39d9-34b1-a66d-9d7c54a7e183",
                        "source_sense_id": "8caf0c44-0758-3fd3-8b92-d6979dc1c294",
                        "source_sense_description": "Anatomie, Reproduction, Médecine",
                        "target_lang_word": "Eierstock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eierstock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                        "entry_id": "eb3050fe-827e-3426-8053-7872d2e007ae",
                                        "glosses": [
                                            "paarig angelegtes, primäres, weibliches Geschlechtsorgan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4eff880-9975-43b0-a07e-f65cbc5dbc7b",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "In den Eierstöcken werden die Eizellen gebildet."
                                            },
                                            {
                                                "example_id": "2a45ce32-1fc7-4f7e-8588-ce7fc74c0a67",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Der Eierstock […] produziert die weiblichen Hormone und die Eizellen, die vom Eileiter […] aufgefangen werden, wo die Befruchtung stattfindet.“"
                                            },
                                            {
                                                "example_id": "15e6b491-900e-4ad2-84e0-d72aa6b85c6c",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Sie lernten, zu was der Hoden nutze war, die Funktion der Eierstöcke, und was es mit den Follikeln auf sich hatte.“"
                                            },
                                            {
                                                "example_id": "2b519126-eb98-4e0c-a222-6f23611d3dde",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Eierstöcke, optimal in Szene gesetzt und illuminiert, könnten so aussehen.“"
                                            },
                                            {
                                                "example_id": "e50780fe-047a-4230-8c02-dfd3491c32cc",
                                                "sense_id": "8f4b685b-2c6c-37e6-950a-160908deb3cb",
                                                "text": "„Zwischen ihnen stand die Gräfin Bellin als La Vallière, mit dem Gesicht eines gefallenen Engels und vielen Rubinen; Ravic erinnerte sich, ihr vor einem Jahr die Eierstöcke operiert zu haben – auf eine Diagnose Durants hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
