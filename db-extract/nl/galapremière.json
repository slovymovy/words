                        "examples": [
                            {
                                "example_id": "b3d650b1-afdd-417f-87fe-929eacf3e4d3",
                                "sense_id": "47bbe453-1978-31b2-9b37-d67c282589b1",
                                "text": "Die winteravond in het Lenkomtheater vergaap ik me aan hun peperdure pakken en avondjurken, waarmee ze een galapremière in het Londense Covent Garden lijken te willen imiteren."
                            },
                            {
                                "example_id": "3d041618-fe93-4232-99a7-6f932165a0b2",
                                "sense_id": "47bbe453-1978-31b2-9b37-d67c282589b1",
                                "text": "Michiel de Ruyter is niet alleen een historische held uit de 17de eeuw. Hij is ook een voorbeeld voor het vaderland, anno 2015, vindt regisseur Roel Reiné. Voor de galapremière van de avondvullende film die hij maakte over de legendarische admiraal zegt hij: \"Ik wil met deze film het gevoel geven dat je weer trots mag zijn op Nederland\"."
                            }
