                    {
                        "translation_id": "9a6d4f16-b080-48cc-9799-d59b720cbfb1",
                        "source_entry_id": "bd039f8b-b3d0-37b7-b287-4b75d91dace4",
                        "source_sense_id": "ad46f54f-f58e-3a13-9e55-5f2d898c4a3a",
