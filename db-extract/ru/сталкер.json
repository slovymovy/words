                    {
                        "sense_id": "2557362e-3ccb-32af-81d5-04c246df0f18",
                        "entry_id": "9d93b6ba-6a45-3c05-88d8-60a04e75b33a",
                        "glosses": [
                            "any person, whose occupation or activity is dangerously similar to those of characters from \\\"Roadside Picnic\\\"."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1c7d077-5c00-4c14-8852-8926918a964a",
                                "sense_id": "2557362e-3ccb-32af-81d5-04c246df0f18",
                                "text": "черно́быльский ста́лкер",
                                "translation": "a Chernobyl stalker, a guide to the Zone of alienation near Chernobyl",
                                "english": "a Chernobyl stalker, a guide to the Zone of alienation near Chernobyl"
                            },
                            {
                                "example_id": "daaa2013-0779-425c-b5c5-955b12d960e6",
                                "sense_id": "2557362e-3ccb-32af-81d5-04c246df0f18",
                                "text": "Никако́й ста́лкер, е́сли он совсе́м не свихну́лся, на пу́шечный вы́стрел к Зо́не не подойдёт, когда́ зна́ет, что за ним следя́т.",
                                "translation": "No stalker, unless he’s completely nuts, will go anywhere near the Zone when he knows he’s being watched.",
                                "english": "No stalker, unless he’s completely nuts, will go anywhere near the Zone when he knows he’s being watched."
                            }
                        ]
                    }
