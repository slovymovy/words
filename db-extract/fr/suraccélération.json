                        "examples": [
                            {
                                "example_id": "fd6c60d4-759f-4671-9c70-b4ac5755aacb",
                                "sense_id": "8457b664-fbe6-3c71-a02e-550356983687",
                                "text": "Dans le cas d'un système animé d'un mouvement de rotation uniforme autour d'un axe, la suraccélération d'entraînement est égale au produit du cube de la vitesse angulaire parla distance du mobile à l'axe de rotation."
                            }
                        ]
