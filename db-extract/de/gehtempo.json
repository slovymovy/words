                ],
                "senses": [
                    {
                        "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                        "entry_id": "76339137-0132-3024-8566-60729d3105c7",
                        "glosses": [
                            "Tempo, das beschreibt, wie schnell jemand beim Gehen vorankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e51240f8-a1c4-4038-bb08-ec5a7903235c",
                                "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                                "text": "„Mit dem Alter kann sich das eigene Gehtempo verlangsamen.“"
                            },
                            {
                                "example_id": "29f427e9-038b-49d3-81c6-b5ff03c1dc53",
                                "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                                "text": "„Im gemütlichen Gehtempo gelangt man in etwa 2,5 Stunden entlang des rot-markierten Wegs hinauf zur Hütte.“"
                            },
                            {
                                "example_id": "193bcfc7-9844-45cf-9e89-a9e9925d6acf",
                                "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                                "text": "„Ihr braucht dazu lediglich ein kleines Materialpaket und je nach Gehtempo, Lust und Laune zwischen ¾ – 1,5 Stunden Zeit.“"
                            },
                            {
                                "example_id": "5f24d482-a3f2-49c4-99f4-bcfc024be2be",
                                "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                                "text": "„Da unser Gehtempo aber grundsätzlich als sehr moderat einzustufen ist, gibt es da keine großen Aha-Erlebnisse.“"
                            },
                            {
                                "example_id": "6043afb5-4c54-4431-85d1-3d6562cb0a6a",
                                "sense_id": "a6017c61-fdde-3610-b405-c73cb376bbd8",
                                "text": "„Ich persönlich fühlte mich trotz meines weit höheren Gehtempos und trotz der Tatsache, die letzten 300 Höhenmeter doppelt gemacht zu haben, außerordentlich gut und auch weiterhin leistungsbereit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
