                "senses": [
                    {
                        "sense_id": "07d86cee-b949-3d0c-b5f8-1ad0c5434b60",
                        "entry_id": "12720030-e222-3a88-b75f-f7c0433dbf48",
                        "glosses": [
                            "истор., религ. особое место, стол или очаг, на котором приносились жертвы божеству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3672650e-b8a2-4e60-98a1-23c577e6d6d3",
                                "sense_id": "07d86cee-b949-3d0c-b5f8-1ad0c5434b60",
                                "text": "И устроил Ной жертвенник Господу; и взял из всякого скота чистого, и из всех птиц чистых, и принёс во всесожжение на жертвеннике."
                            }
                        ]
                    },
                    {
                        "sense_id": "126bb1f2-974b-358e-a849-d05b445e4524",
                        "entry_id": "12720030-e222-3a88-b75f-f7c0433dbf48",
                        "glosses": [
                            "религ. столик в северной части алтаря православной церкви, на котором приготовляются Святые Дары для совершения таинства"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7a04938-20f4-4186-ae21-f94c7d73c62b",
                        "source_entry_id": "12720030-e222-3a88-b75f-f7c0433dbf48",
                        "source_sense_description": "алтарь",
                        "target_lang_word": "altar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "A table or similar flat-topped structure used for religious rites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6987d35-b598-4133-a4c4-d30a702078e4",
                                                "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                                "text": "To hawke, or els to hunt\nFrom the auter to the funt,\nWyth cry unreverent,\nBefore the sacrament,\nWythin the holy church bowndis,\nThat of our fayth the grownd is."
                                            },
                                            {
                                                "example_id": "0628b922-aac3-4f5c-bbcc-128b9058480b",
                                                "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                                "text": "Wax models of the pudenda of both sexes were regularly placed before the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fef163-0e44-3d07-a5a5-b51222ec540f",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "A raised area around an altar in a church; the sanctuary."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9adf4a1a-09a8-3610-bd59-a003b8c71702",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "Any (real or notional) place where something is worshipped or sacrificed to."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b000cddc-3780-4b18-9761-0b085caf2772",
                                                "sense_id": "9adf4a1a-09a8-3610-bd59-a003b8c71702",
                                                "text": "[…]now marking the end of ascetic rationalism, the monadology no longer implied a sacrifice of individuality on the altar of rationality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
