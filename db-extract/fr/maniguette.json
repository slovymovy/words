                ],
                "senses": [
                    {
                        "sense_id": "334527c2-6565-31bb-92e3-2cccc8cea3e4",
                        "entry_id": "920b5fc1-480b-3477-bf9b-a1834988b4ff",
                        "glosses": [
                            "Aframomum melegueta, plante herbacée, rhizomateuse de la famille des Zingibéracées (Zingiberaceae), originaire de Guinée équatoriale et dont les graines sont utilisées comme épice au goût poivré et piquant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e76704c-b3a7-42b1-a77b-3be183dd9a5d",
                                "sense_id": "334527c2-6565-31bb-92e3-2cccc8cea3e4",
                                "text": "Puis lorsque le prix du poivre noir s’envole , la maniguette le remplace."
                            }
                        ]
                    },
                    {
                        "sense_id": "afede4c5-9710-3ae5-ba1f-8cbddc4e7734",
                        "entry_id": "920b5fc1-480b-3477-bf9b-a1834988b4ff",
                        "glosses": [
                            "Graine de cette plante."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "2368bc9d-42a2-4e57-b904-028adebb452f",
                                "sense_id": "afede4c5-9710-3ae5-ba1f-8cbddc4e7734",
                                "text": "Une cuillère à café de maniguette rehausse un plat mijoté et se marie particulièrement bien avec la viande d’agneau, le parfum vanillé, le café et le chocolat."
                            }
                        ]
                    }
                ],
