                            },
                            {
                                "target_lang_word": "stunt",
                                "target_lang_sense_clarification": "an acrobatic or physical feat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac44f8e5-ee2f-3589-bda3-214fa884126a",
                    "sense_definition": "Het verkleinwoord van <w>kunst</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diminutief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn schilderij is misschien geen meesterwerk, maar het is toch een aardig <w>kunstje</w>.",
                            "target_lang_translations": {
                                "en": "His painting might not be a masterpiece, but it is still a nice little piece of <w>art</w>."
                            }
                        },
                        {
                            "text": "Zij verstaat het <w>kunstje</w> om met weinig geld toch heel lekker te koken.",
                            "target_lang_translations": {
                                "en": "She has the <w>knack</w> of cooking very delicious meals with little money."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het kunstje verstaan"
