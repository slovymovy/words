                                        "sense_id": "7077653a-7154-3a2f-b5e9-9949b363700c",
                                        "entry_id": "08cad199-8083-3be6-b149-61390083436f",
                                        "glosses": [
                                            "Qualifie les plantes qui croissent de préférence dans un milieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc30b832-92d9-496c-b9ac-61aa952344e2",
                                                "sense_id": "7077653a-7154-3a2f-b5e9-9949b363700c",
                                                "text": "Notons que Corrigiola littoralis n’est pas une espèce exclusive des graviers fluviatiles, mais seulement une élective ou une préférante de ces stations."
