{
    "word_family": [
        "reproduction",
        "reproductive",
        "reproducible",
        "reproducer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17bb271b-4221-380d-b36c-ea70d3ebcec2",
                    "sense_definition": "To produce an image or copy of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new printer can <w>reproduce</w> high-quality images with incredible detail.",
                            "target_lang_translations": {
                                "ru": "Новый принтер может <w>воспроизводить</w> высококачественные изображения с невероятной детализацией."
                            }
                        },
                        {
                            "text": "It is illegal to <w>reproduce</w> copyrighted material without the owner's permission.",
                            "target_lang_translations": {
                                "ru": "Незаконно <w>копировать</w> материалы, защищенные авторским правом, без разрешения владельца."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifold"
                    ],
                    "common_phrases": [
                        "reproduce an image",
                        "reproduce copyrighted material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать изображение или копию чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспроизводить",
                                "target_lang_sense_clarification": "создавать копию или изображение"
                            },
                            {
                                "target_lang_word": "копировать",
                                "target_lang_sense_clarification": "делать дубликат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86f9aea6-ff0a-309d-884d-b3deb78bfa14",
                    "sense_definition": "To generate or propagate offspring or organisms sexually or asexually.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most mammals <w>reproduce</w> sexually, while some simple organisms use asexual methods.",
                            "target_lang_translations": {
                                "ru": "Большинство млекопитающих <w>размножаются</w> половым путем, в то время как некоторые простые организмы используют бесполые методы."
                            }
                        },
                        {
                            "text": "The study examines how certain bacteria <w>reproduce</w> rapidly in warm environments.",
                            "target_lang_translations": {
                                "ru": "В исследовании изучается, как определенные бактерии быстро <w>размножаются</w> в теплой среде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reproduce offspring",
                        "ability to reproduce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить потомство или размножаться половым или бесполым путем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размножаться",
                                "target_lang_sense_clarification": "биологический процесс"
                            },
                            {
                                "target_lang_word": "воспроизводиться",
                                "target_lang_sense_clarification": "о популяции или организмах"
                            },
                            {
                                "target_lang_word": "плодиться",
                                "target_lang_sense_clarification": "давать потомство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cebc3e6-c9fc-32c9-b419-c18a0a8659c2",
                    "sense_definition": "To produce again or to recreate a specific condition or result.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recreation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists have struggled to <w>reproduce</w> the results of the original experiment.",
                            "target_lang_translations": {
                                "ru": "Ученые изо всех сил пытались <w>воспроизвести</w> результаты оригинального эксперимента."
                            }
                        },
                        {
                            "text": "The chef tried to <w>reproduce</w> the exact flavor of the sauce he had in Italy.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар пытался <w>воссоздать</w> тот самый вкус соуса, который он пробовал в Италии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reproduce the results",
                        "reproduce the effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать заново или воссоздавать определенное условие или результат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспроизводить",
                                "target_lang_sense_clarification": "повторять результат или опыт"
                            },
                            {
                                "target_lang_word": "воссоздавать",
                                "target_lang_sense_clarification": "восстанавливать условия или вкус"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7486041f-7d8e-3603-8402-5c1e2628ba48",
                    "sense_definition": "To bring something to mind or to recall a memory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_recall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was able to <w>reproduce</w> the entire conversation from memory during the trial.",
                            "target_lang_translations": {
                                "ru": "Во время суда он смог по памяти <w>воспроизвести</w> весь разговор целиком."
                            }
                        },
                        {
                            "text": "The witness struggled to <w>reproduce</w> the details of the suspect's face.",
                            "target_lang_translations": {
                                "ru": "Свидетелю было трудно <w>воссоздать</w> в памяти черты лица подозреваемого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reproduce from memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать в воображении или восстанавливать в памяти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспроизводить",
                                "target_lang_sense_clarification": "восстанавливать в памяти"
                            },
                            {
                                "target_lang_word": "воссоздавать",
                                "target_lang_sense_clarification": "детально вспоминать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}