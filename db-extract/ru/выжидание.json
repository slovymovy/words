                "translations": [
                    {
                        "translation_id": "b7dfd11a-66c4-47a1-b9b5-e50df1cb47ee",
                        "source_entry_id": "61bac6f5-9638-33ca-8819-3f62b42490cb",
                        "source_sense_id": "6426d9da-47fe-342c-ace0-92d64ccb3306",
                        "target_lang_word": "attente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "État de la personne qui attend, ou temps pendant lequel on attend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb980070-d703-4827-bfd7-dbcb497ade17",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "[…], et le 2 août au matin, le 29ᵉ Dragons rejoint la 56ᵉ Division de cavalerie chargée d'assurer la couverture dans la région de Mézières. Pendant trois jours, il demeure « en attente » à Guignicourt-sur-Vence : attente longue à tous, car les nouvelles sont rares […]."
                                            },
                                            {
                                                "example_id": "3a846cf6-b155-4559-984f-96d5d1efa676",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "« J’ai attendu ce moment toute ma vie. » Dès les premières heures de l’ouverture de l’appel à témoignage le 21 septembre 2021, les témoignages ont été adressés en très grand nombre avec l’expression de cette attente si longue, toute une vie. La CIIVISE devait être à la hauteur de cette attente."
                                            },
                                            {
                                                "example_id": "6f855060-0341-4191-829c-dc42f22907f4",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "Passer la nuit dans l’attente. — Être dans l’attente, être en attente de quelque chose."
                                            },
                                            {
                                                "example_id": "ebcc8fa5-9ee4-4a51-a7c0-8c71679a16fa",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "Il nous tient dans l’attente de ce qu’il veut faire. — L’attente d’une décision."
                                            },
                                            {
                                                "example_id": "eb19d961-144f-4b5f-a229-465811aafe6d",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "Si vous prêtez à cet homme, vous y perdrez et l’argent et l’attente. — Vous n’y perdrez que l’attente."
                                            },
                                            {
                                                "example_id": "83f2b7f3-8870-4384-8e4f-25c1d716eeec",
                                                "sense_id": "5500de49-bc39-3a05-afaf-bc6dbe37822c",
                                                "text": "Longue attente. — Ennuyeuse attente. — Attente pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dfe598e-0fa2-3756-8ae0-6e64c562c4bc",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Espérance, opinion qu’on a conçue de quelqu’un, de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff382bf-daee-473e-a8cf-fa5572b52cea",
                                                "sense_id": "4dfe598e-0fa2-3756-8ae0-6e64c562c4bc",
                                                "text": "Cet enfant a répondu à l’attente qu’on avait de lui."
                                            },
                                            {
                                                "example_id": "861cd79d-c5ea-4037-8f5d-327036d893de",
                                                "sense_id": "4dfe598e-0fa2-3756-8ae0-6e64c562c4bc",
                                                "text": "Il a rempli notre attente. — Il a surpassé notre attente. — Le succès n’a point trompé notre attente. — Son attente sera frustrée."
                                            },
                                            {
                                                "example_id": "dd468668-7397-4768-a12b-b9b43303348f",
                                                "sense_id": "4dfe598e-0fa2-3756-8ae0-6e64c562c4bc",
                                                "text": "L’attente publique. — Cela est arrivé contre l’attente générale, contre l’attente de tout le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5435b1fb-9fb2-369f-9611-04a9a6b911eb",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Chose qu’on ne regarde que comme un commencement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e74cc0-d120-4f94-b68e-5db9456f7fe3",
                                                "sense_id": "5435b1fb-9fb2-369f-9611-04a9a6b911eb",
                                                "text": "C’est un poste, c’est une situation d’attente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f97b5cca-dad0-31f8-abc7-b4aac9e20b42",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Action de compter sur quelqu’un, sur quelque chose, une espérance, une prévision (répondre à l’attente de ses amis, contre toute attente)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "732f2a7e-bffa-39f8-b9a5-6c0a9f28c88d",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "État recherché par un individu qui entretient ainsi un plaisir qui va cesser au moment où l’objet de l’attente sera réalisé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f262899-346e-39dc-b6d3-67671221f978",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Standards, besoins, désirs des clients d’une entreprise, des usagers d’une administration, etc, ; ce qu’ils attendent ; ce à quoi ils s’attendent."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2eb3290-0ed7-4bb5-8f81-84a9a7e1679d",
                                                "sense_id": "4f262899-346e-39dc-b6d3-67671221f978",
                                                "text": "Et si, en plus des efforts coûteux déployés pour satisfaire les attentes de nos clients, l’on travaillait ces attentes elles-mêmes, de sorte à les rendre plus facilement accessibles ?"
                                            },
                                            {
                                                "example_id": "f8d898e8-6be8-4de5-9fee-070946749919",
                                                "sense_id": "4f262899-346e-39dc-b6d3-67671221f978",
                                                "text": "Hier, les professionnels de santé membres de l’Alsas (association locale de santé), ont présenté le questionnaire que les usagers de santé sont invités à remplir avant le 15 août. L’association souhaite recueillir l’opinion et les attentes des habitants concernant les offres de soins de la commune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13a40933-f794-3bdb-bd7a-534d0177c6dc",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Ellipse de armature d’attente."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fa38246-67be-3ea5-adcd-0c50c4aa0f56",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Pierre disposée en saillie d’un mur en attente de faire la liaison avec une future construction, elle constitue un arrachement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fad91681-7f6b-31c5-9626-6f9491a3107e",
                                        "entry_id": "fcd13b74-e6c6-3442-96ce-357bc8bcf7fb",
                                        "glosses": [
                                            "Insigne porté sur la couture de l’épaule de la veste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d6ff33-b65d-471d-a6ea-3cb9f5bc8e3b",
                                                "sense_id": "fad91681-7f6b-31c5-9626-6f9491a3107e",
                                                "text": "Les attentes brodées or portées sur les épaules des vestons bleus et des manteaux par les officiers subalternes sont différentes (14 mm de largeur) de celles des officiers supérieurs (16 mm de largeur),pour une longueur commune de 90 mm."
                                            }
                                        ]
                                    }
                                ]
                            },
