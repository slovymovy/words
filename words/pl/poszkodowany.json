                    "sense_definition": "osoba, która poniosła szkodę lub doznała uszczerbku na zdrowiu, mieniu albo prawach w wyniku wypadku, przestępstwa lub innego zdarzenia",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze natychmiast udzielili pomocy i przewieźli <w>poszkodowanego</w> do najbliższego szpitala miejskiego.",
                            "target_lang_translations": {
