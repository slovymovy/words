                        "source_entry_id": "663a9a8d-6849-3bd9-8879-a3035eb63758",
                        "source_sense_id": "09958584-89d5-351b-848e-2849955f4e1d",
                        "source_sense_description": "Qui est pâle et défait",
                        "target_lang_word": "haggard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                        "entry_id": "4de61672-8b12-34b6-8f48-b4fe361b52af",
                                        "glosses": [
                                            "Looking exhausted, worried, or poor in condition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecc01dd1-7c0f-477e-8eb4-af505caff30b",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "Pale and haggard faces."
                                            },
                                            {
                                                "example_id": "126416dc-8243-4144-8afd-b039e5e28e5b",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "A gradual descent into a haggard and feeble state."
                                            },
                                            {
                                                "example_id": "a7ec94f9-b8d9-499d-9f78-d07d2d4bf6e6",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "The years of hardship made her look somewhat haggard."
                                            },
                                            {
                                                "example_id": "7e02ec16-727a-42ef-a7d8-7fc3f5de68e7",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "Staring his eyes, and haggard was his look."
                                            },
                                            {
                                                "example_id": "a73ae5d6-07ba-44e8-8cd3-1853d5dff3d8",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "Then there was a pale, care-wrinkled woman, not old, but haggard, and already with streaks of gray among her hair, like silver ribbons; one of those women, naturally delicate, whom you at once recognize as worn to death by a brute—probably, a drunken brute—of a husband, and at least nine children."
                                            },
                                            {
                                                "example_id": "87becfd9-f960-4641-b63a-7ecb2812840d",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "I looked at the morning / After being up all night / I looked at my haggard face in the bathroom light / I looked out the window / And I saw that ragged soul take flight"
                                            },
                                            {
                                                "example_id": "1d026cd2-d39c-446d-b47d-901462884e44",
                                                "sense_id": "4db0bf00-ed79-344e-adeb-a4335faed68d",
                                                "text": "By the end of two weeks there isn't a county in England where he hasn't pledged his holiness six different ways — which is not to deny that intermittently he has visions of himself as a haggard apostle of the life renounced, converting beautiful women and millionaires to Christian poverty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a34591-3f08-3867-a356-7480edf259be",
                                        "entry_id": "4de61672-8b12-34b6-8f48-b4fe361b52af",
                                        "glosses": [
                                            "Wild or untamed"
                                        ],
                                        "tags": [
                                            "of an animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05e9927-f318-4e9a-b7c0-6cfed466c225",
                                                "sense_id": "02a34591-3f08-3867-a356-7480edf259be",
                                                "text": "a haggard or refractory hawk"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haggard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7acd19ff-cc0b-3868-845e-7499f403666b",
                                        "entry_id": "d404df0c-e50c-3344-97fa-031410d819b1",
                                        "glosses": [
                                            "A hunting bird captured as an adult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dfefd03-d262-4f66-b422-81d792d081a6",
                                                "sense_id": "7acd19ff-cc0b-3868-845e-7499f403666b",
                                                "text": "No, truly, Ursula, she is too disdainful;\nI know her spirits are as coy and wild\nAs haggards of the rock."
                                            },
                                            {
                                                "example_id": "f76ecebd-8b9b-4bbd-8717-dcdee67c7a6c",
                                                "sense_id": "7acd19ff-cc0b-3868-845e-7499f403666b",
                                                "text": "1856, John Henry Walsh, Manual of British Rural Sports\nHAGGARDS may be trapped in this country but with the square-net, or the bow-net, but in either case great difficulty is experienced"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f234f14-c7bb-3681-ba25-d86f8e7d1c82",
                                        "entry_id": "d404df0c-e50c-3344-97fa-031410d819b1",
                                        "glosses": [
                                            "A young or untrained hawk or falcon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b13707-192f-397b-a2cf-02da5ef26161",
                                        "entry_id": "d404df0c-e50c-3344-97fa-031410d819b1",
                                        "glosses": [
                                            "A fierce, intractable creature."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ebde747-49c4-4ed1-819c-0d1649ed68ce",
                                                "sense_id": "34b13707-192f-397b-a2cf-02da5ef26161",
                                                "text": "I have loved this proud disdainful haggard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6e13bd-5c09-3590-ba0f-888e4e743c89",
                                        "entry_id": "d404df0c-e50c-3344-97fa-031410d819b1",
                                        "glosses": [
                                            "A hag."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde6e0b3-904b-4e54-a6b5-ba1b65dbe15f",
                                                "sense_id": "8e6e13bd-5c09-3590-ba0f-888e4e743c89",
                                                "text": "In a dark Grott the baleful Haggard lay,\nBreathing black Vengeance, and infecting Day"
                                            }
                                        ]
                                    }
                                ]
                            },
