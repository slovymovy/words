                        "examples": [
                            {
                                "example_id": "991b83b4-dd53-4790-8d27-0992a59c3d37",
                                "sense_id": "8dbdcf99-97e5-3348-a1aa-7ce37013899a",
                                "text": "Het label had eigenlijk al twee jaar geleden ingevoerd moeten worden. De invoerdatum is uitgesteld om het wetenschappelijke comité achter het label meer tijd te geven om imperfecties te corrigeren. Dat comité bestaat uit onafhankelijke wetenschappers, waaronder twee Nederlanders."
                            },
                            {
                                "example_id": "13c605f6-fcaf-4f89-a6d9-0a0b48c4d9f4",
                                "sense_id": "8dbdcf99-97e5-3348-a1aa-7ce37013899a",
                                "text": "Ook vindt het ministerie dat ondernemers die wel door de maatregel getroffen zullen worden nog ruim de tijd hebben om zich voor te bereiden. De invoerdatum staat, voorlopig, op 1 januari 2022."
                            }
                        ]
                    }
