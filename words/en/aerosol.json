                    "frequency": "Middle",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Natural <w>aerosols</w> in the atmosphere include smoke, dust, and sea salt particles."
                        },
                        {
                            "text": "Scientists study how tiny atmospheric <w>aerosols</w> reflect sunlight back into space."
                        }
                    ],
                    "common_phrases": [
