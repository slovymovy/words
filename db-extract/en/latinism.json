                        "entry_id": "f6c01182-0c92-337b-bbe4-78a3a06a2374",
                        "glosses": [
                            "Any word or phrase borrowed from Latin, or suggestive of Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef6f0fc-ba3f-4bdf-871d-8c3ccdb55330",
                                "sense_id": "47b9dd5e-c46a-37ab-9b37-55609fd23439",
                                "text": "[discussing numquam in the Old French portion of the Oaths of Strasbourg] a Latinizing spelling, maybe a pure Latinism, not surviving in modern French (but cf. Old French onques < umquam ‘ever’). Note the double negative, literally ‘will never make no pact’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
