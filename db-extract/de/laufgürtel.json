                ],
                "senses": [
                    {
                        "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                        "entry_id": "494dd7b0-6396-32d2-ad90-a451e1d468c3",
                        "glosses": [
                            "speziell für Läufer entwickelter Gürtel; Gürtel, der zur Aufbewahrung oder Befestigung kleiner Gegenstände (zum Beispiel Trinkflasche, Handy, Schlüssel) beim Laufen gedacht ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "68487810-0f0f-4b59-be82-c84aa213e86c",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Die neue CaniX Leash für Läufer hat eine Länge von 1,7 m gestreckt und verfügt neben der Handschlaufe/Anbindung an den Laufgürtel über eine weitere Handschlaufe vorne am Karabiner – ideal um den Hund zum Startbereich zu bringen und zu starten.“"
                            },
                            {
                                "example_id": "003241bb-4838-4325-a770-0f9a9fca5fd3",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Mit Hilfe eines Soft-Schäkels kannst du zudem die Leine mit wenigen Handgriffen vom Laufgürtel lösen.“"
                            },
                            {
                                "example_id": "70242fe6-779e-4abb-946e-2a2b42362f66",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Zudem wurde gemeinsam mit dem Upcycling-Label Bridge & Tunnel im Rahmen eines Rücknahmeprogramms für eigene gebrauchte Produkte ein Laufgürtel upgecycelt.“"
                            },
                            {
                                "example_id": "5d6e4403-5edd-4b76-8704-33f6edfafaed",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Weil die Mama Moni sich immer beschwert hatte, dass ihr das Handy beim Laufen so schwer in der Hosentasche hängt oder sie ihre Klamotten immer so organisieren muss, dass irgendein Kleidungsstück Taschen hat, hatte ihr eine ganz liebe Freundin einen Laufgürtel geliehen.“"
                            },
                            {
                                "example_id": "22197525-89ae-4350-bf2f-8e38cf43ba15",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Für Läufer gibt es auch Laufgürtel mit Trinkflaschen, die es ermöglichen, während des Laufs hydratisiert zu bleiben.“"
                            },
                            {
                                "example_id": "168f8a59-e949-43fc-9d20-177119773132",
                                "sense_id": "ac5305de-a9e5-3a01-8fb3-6409247adfde",
                                "text": "„Bevor man sich für ein bestimmtes Modell entscheidet, sollte man sich Gedanken darüber machen, für welchen Zweck man den Laufgürtel hauptsächlich nutzen möchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
