        "nl-extract.jsonl": [
            {
                "entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                "word": "aanslingeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd0d08a1-6f06-36ce-b067-515d11741f14",
                        "entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                        "glosses": [
                            "door een draaibeweging op gang brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb89ad93-152a-4e42-a1ae-71878e1494b3",
                                "sense_id": "cd0d08a1-6f06-36ce-b067-515d11741f14",
                                "text": "Volgende week wordt zijn nieuwste vlog verwacht. ,,Ik ga de komende filmpjes dingen doen die er nog nooit van gekomen zijn, zoals schaapsscheren, sushi maken en een draaiorgel aanslingeren onder het mom van ík durf het bijna niet te vragen'.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "98e28a4e-291a-3038-91c6-b8dbbafad3bf",
                        "entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                        "glosses": [
                            "een onderwerp ter sprake brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fcdbd03-4d53-49b6-a6d7-3215057d1481",
                                "sense_id": "98e28a4e-291a-3038-91c6-b8dbbafad3bf",
                                "text": "Directeur Henk Kesler van de profsectie liet geen ruimte voor discussie. \"De BeNe-liga is achterhaald. Leuk dat Michael het aanslingert, maar wij gaan het niet doen. De clubs gaan erover en die zijn tegen. Ze willen evenmin een onderzoek. De prioriteiten van de clubs liggen elders.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5c5fc015-bfe3-34d1-8a94-24703cdeac9b",
                        "entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                        "glosses": [
                            "met een zigzagbeweging naderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0700b8ba-84e9-4dbb-be3f-8756caf64314",
                                "sense_id": "5c5fc015-bfe3-34d1-8a94-24703cdeac9b",
                                "text": "In een uitzending uit 1985 van zijn tv-programma Wondere Wereld komt Chriet Titulaer aanslingeren op zijn fiets. Bakbeest van een telefoon op het stuur. Zegt met zijn zachte g: „Managers willen voor hun gezondheid wel op de fiets, maar ze moeten bereikbaar zijn. Dat kan, de fietstelefoon is er, al is-ie wel zwaar door de grote accu. De PTT zoekt honderd proefpersonen, u kunt u aanmelden.” De belfiets was een 1 april-grap. Niemand kon toen bevroeden hoe dicht die aanschuurde tegen onze werkelijkheid van bellende bakfietsmoeders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "805713df-01e1-4e62-96da-73819967abd3",
                        "source_entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                        "source_sense_id": "cd0d08a1-6f06-36ce-b067-515d11741f14",
                        "source_sense_description": "door een draaibeweging op gang brengen",
                        "target_lang_word": "crank up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crank up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc430c3-8bb5-3b51-952b-68499c1b6034",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To start something mechanical, an act that often used to involve cranking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04f1bca-f995-442f-a07d-516c3177b2e0",
                                                "sense_id": "edc430c3-8bb5-3b51-952b-68499c1b6034",
                                                "text": "Let's crank up the old motorcycle and take it for a spin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689aa270-43c8-35df-83f2-45b9d58a2c5e",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To muster up the mental energy to do something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a8dc8e-8e15-45bc-885d-5eefd3562689",
                                                "sense_id": "689aa270-43c8-35df-83f2-45b9d58a2c5e",
                                                "text": "I kept thinking: this has nothing to do with my interests, with what I believe is a desirable subject for literature. I was doing it as a performance. I kept cranking myself up to perform, to meet the demands of the genre. I know this sounds terribly inartistic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d38c641-f84e-3e47-bd68-5da17e58404e",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To prepare (something)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1639418-2905-34d3-9803-18c49dee4f2e",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To increase, as the volume, power or energy of something."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b057da0-5b18-4203-bf3b-f96f96dc9c7a",
                                                "sense_id": "d1639418-2905-34d3-9803-18c49dee4f2e",
                                                "text": "He cranked up the volume to 11."
                                            },
                                            {
                                                "example_id": "acccc0df-d594-4b88-b237-8be0f3984781",
                                                "sense_id": "d1639418-2905-34d3-9803-18c49dee4f2e",
                                                "text": "And it was not until Ryan Shawcross's towering header was cleared off the line by Danny Murphy on the stroke of half-time that Stoke started to crank up the pressure and suggest they were capable of getting back into the match."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ad00dcf-761f-336b-81eb-dafbba60d7aa",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To describe in praiseworthy terms; to promote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7b856c-4f56-4ae8-bef5-73cbd7fefbb7",
                                                "sense_id": "6ad00dcf-761f-336b-81eb-dafbba60d7aa",
                                                "text": "Was the great machine ever what it was cranked up to be?"
                                            },
                                            {
                                                "example_id": "bc2344b6-2d65-4441-ac2b-7bbd6129e5fe",
                                                "sense_id": "6ad00dcf-761f-336b-81eb-dafbba60d7aa",
                                                "text": "Let's hope your ol' buddy Majors is all he's cranked up to be, for we're about to introduce him to what you yanks refer to as hard ball."
                                            },
                                            {
                                                "example_id": "85b79f0c-1fe7-4869-bee1-b14dcc446cb4",
                                                "sense_id": "6ad00dcf-761f-336b-81eb-dafbba60d7aa",
                                                "text": "That whole campaign was a damp squib, they cranked it up as a real possibility that Scotland might win, and when we actually got there it didn't happen like that, and everybody came home quite early with their tails between their legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fb3098-a3c7-35da-9b5b-9c7a5369191e",
                                        "entry_id": "7e999dba-9511-39cf-a546-45d41e0272a5",
                                        "glosses": [
                                            "To inject heroin."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c906e276-b63d-4739-a7f2-a73080407a0b",
                        "source_entry_id": "5c8a9ce3-6dba-3d76-a609-ffb468ab81a0",
                        "source_sense_id": "cd0d08a1-6f06-36ce-b067-515d11741f14",
                        "source_sense_description": "een onderwerp ter sprake brengen",
                        "target_lang_word": "begin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                        "entry_id": "b06c9806-8cd1-3173-8ebe-e1d22d467f47",
                                        "glosses": [
                                            "To start, to initiate or take the first step into something."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03ca2b7-d34a-4f86-b94a-41c494f9a50d",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "I began playing the piano at the age of five."
                                            },
                                            {
                                                "example_id": "4972f403-c0c3-4702-bec9-d4ee99aee0f1",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Now that everyone is here, we should begin the presentation."
                                            },
                                            {
                                                "example_id": "b469963e-ec2d-42a9-8edc-6be94a099d01",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "The program begins at 9 o’clock on the dot."
                                            },
                                            {
                                                "example_id": "b5473a71-14ab-40ac-8f2c-7285992ad71e",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "I rushed to get to class on time, but the lesson had already begun."
                                            },
                                            {
                                                "example_id": "b1ba140b-cf0b-4412-9261-fda3a720e745",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "The Apoſtle begins our Knowledge in the Creatures, which lead us to the Knowledge of God, if we will make uſe of our Reaſon: [...]"
                                            },
                                            {
                                                "example_id": "ba1b65be-78a5-4bba-8ade-2b902a4973fe",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Ye Nymphs of Solyma! begin the ſong: / To heav'nly themes ſublimer ſtrains belong."
                                            },
                                            {
                                                "example_id": "4c22f447-bd94-4d18-a897-6c6b3d7ecdf4",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "c987cdb9-049a-4b45-aafd-888f776b9121",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "0109ff86-20c8-43fc-bc9a-8d93c574da4d",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "As Andrew, in particular, began to work on renovation and improvement, his talk about this began to be peppered with references to 'bodgery' — 'When I look at it, all I see is bodgery, he says recurrently, with a mixture of exclamation and despair."
                                            },
                                            {
                                                "example_id": "eba37df4-0fb1-43ca-bd08-dbe399ee5798",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Similarly, the biotech giant Cargill has begun manufacturing a polymer from vegetable oils that is used in polyurethane foams, which is found in beddings, furniture and car-seat headrests."
                                            },
                                            {
                                                "example_id": "7f99df18-64b0-4f5c-bfa7-a5bcfde5a134",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "State begins fouling and UCLA misses a couple of front-end free throws on one-and-ones."
                                            },
                                            {
                                                "example_id": "93f96515-79f7-43e4-b576-084037a14e71",
                                                "sense_id": "469eeda4-d5eb-3c04-9644-e536c8393963",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3f8184-10bf-3b75-aa9b-5137807a7ddf",
                                        "entry_id": "b06c9806-8cd1-3173-8ebe-e1d22d467f47",
                                        "glosses": [
                                            "To come into existence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28fe68aa-ad4d-4ade-8e36-6105d080a1fb",
                                                "sense_id": "6a3f8184-10bf-3b75-aa9b-5137807a7ddf",
                                                "text": "Vast chain of being! which from God began."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "begin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5444810-b250-308c-94b3-7bc408d7742a",
                                        "entry_id": "164c1dc4-1eb4-3e6d-b30e-d709845d587d",
                                        "glosses": [
                                            "Beginning; start."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb29036a-fdee-4f6d-9980-f455eb1efd8b",
                                                "sense_id": "d5444810-b250-308c-94b3-7bc408d7742a",
                                                "text": "In prayer, in the light, I see my kin / I touch my tree, my roots, my begin"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
