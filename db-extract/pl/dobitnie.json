        "pl-extract.jsonl": [
            {
                "entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                "word": "dobitnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                        "entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                        "glosses": [
                            "stanowczo i jasno, często głośno i w obrazowy sposób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "651fe054-bf97-4b46-bc67-b6ccb274f332",
                                "sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                                "text": "Wiktor dobitnie wyraził swój sprzeciw."
                            },
                            {
                                "example_id": "04b530f0-63d9-45e6-a13d-51b74b1961ed",
                                "sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                                "text": "Trybunał Konstytucyjny jak i sądy administracyjne dobitnie podkreślały w swych orzeczeniach zasadę samodzielności jednostek samorządu terytorialnego i jej ochronę prawną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5a72f8e-3c00-4a73-bcca-d315fc04bd3f",
                        "source_entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                        "source_sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                        "target_lang_word": "distinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                        "entry_id": "1f7f69ac-9ac5-3c15-9fe6-5b93d07b8175",
                                        "glosses": [
                                            "In a distinct manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b7c8ad-6f9a-4d63-93e4-423615b8f2d5",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "I distinctly remember the voice of my deceased grandmother."
                                            },
                                            {
                                                "example_id": "59ebcc5d-34fd-46d6-a259-95a81ece9046",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "About ten months ago a report reached my ears that a Dutchman had constructed a telescope, by the aid of which visible objects, although at a great distance from the eye of the observer, were seen distinctly as if near; […]"
                                            },
                                            {
                                                "example_id": "6b4671bb-65bf-4869-955d-5f8f218c0e36",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy."
                                            },
                                            {
                                                "example_id": "4e0abc77-efc2-4fce-8d94-fbe6beef251d",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "\"Aloud,\" he said distinctly, \"the Seven Words are spoken thus. Melenkurion abatha. Duroc minas mill. Harad khabaal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "462ae20f-6745-4083-a5cb-d8790d954f21",
                        "source_entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                        "source_sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                        "target_lang_word": "forcibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forcibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                        "entry_id": "4c8de312-391b-3753-9411-fbe961eb997e",
                                        "glosses": [
                                            "In a forcible manner, by force, against one's will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cbd237-300c-481c-8f90-5e8d326d022b",
                                                "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                                "text": "And suddenly; where injury of chance / Puts back leave-taking, justles roughly by / All time of pause, rudely beguiles our lips / Of all rejoindure, forcibly prevents / Our lock'd embrasures […]"
                                            },
                                            {
                                                "example_id": "4f7a22bc-afce-43f4-a4ba-b9147f928fe2",
                                                "sense_id": "a97a0e63-0d6c-3162-a072-24ad87312387",
                                                "text": "“Now get out of here,” and he grabbed Rokoff and Paulvitch each by the scruff of the neck and thrust them forcibly through the doorway, giving each an added impetus down the corridor with the toe of his boot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb3b4d1a-9312-38ea-a7b5-faa544d54f9f",
                                        "entry_id": "4c8de312-391b-3753-9411-fbe961eb997e",
                                        "glosses": [
                                            "In a forcible manner, with force, with powerful effect, powerfully, strongly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1152af4e-1bc5-4baf-9a3d-7e1a1e9a58f9",
                                                "sense_id": "eb3b4d1a-9312-38ea-a7b5-faa544d54f9f",
                                                "text": "It was now cold, winter weather: forcibly recalling to his mind under what circumstances he had first travelled that road, and how many vicissitudes and changes he had since undergone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbfd43ba-5b2a-40eb-8049-a7f42809cb3c",
                        "source_entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                        "source_sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                        "target_lang_word": "pointedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pointedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7eeed5a-1571-3324-91ba-10e1298ef2aa",
                                        "entry_id": "0d12347b-118e-3f9e-9346-fbe139b5d4e5",
                                        "glosses": [
                                            "explicitly; with emphasis; so as to make a point, especially with criticism"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9405ed0-b653-41d3-9361-119240654960",
                                                "sense_id": "b7eeed5a-1571-3324-91ba-10e1298ef2aa",
                                                "text": "The film echoes a central question from all the Wick films, though: is he a natural-born murderer? Or a good man underneath it all? \"This is who you are,\" the Marquis tells him. \"A killer.\" The question is pointedly unresolved here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf60957-7eb2-3bec-9a9f-169e88e38fcc",
                                        "entry_id": "0d12347b-118e-3f9e-9346-fbe139b5d4e5",
                                        "glosses": [
                                            "wittily or pithily"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7286fbcb-826b-464b-a806-ed57e280561a",
                        "source_entry_id": "c8d12e60-5a0b-3cac-896d-6152d3bdd507",
                        "source_sense_id": "278ec30c-6cb1-37b2-bf66-dc23b1e5a1bc",
                        "target_lang_word": "emphatically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emphatically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd93356-3822-30ad-8c8b-1c02459a1a1f",
                                        "entry_id": "317814f5-7e37-3551-9ec8-757b5f0e7183",
                                        "glosses": [
                                            "In an emphatic manner; with emphasis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfea19d5-05fd-4c9c-9cda-08f67a697078",
                                                "sense_id": "7bd93356-3822-30ad-8c8b-1c02459a1a1f",
                                                "text": "Perhaps, at, another time, Ralph’s obstinacy and dislike would have been proof against any appeal from such a quarter, however emphatically urged; but now, after a moment’s hesitation, he went into the hall for his hat, and returning, got into the coach without speaking a word."
                                            },
                                            {
                                                "example_id": "6b58cc69-4448-4d68-bb8b-ba64af48846f",
                                                "sense_id": "7bd93356-3822-30ad-8c8b-1c02459a1a1f",
                                                "text": "Dos Santos, who has often been on the fringes at Spurs since moving from Barcelona, whipped in a fantastic cross that Pavlyuchenko emphatically headed home for his first goal of the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7eb7435-81df-390b-9aff-29f16aed7e6c",
                                        "entry_id": "317814f5-7e37-3551-9ec8-757b5f0e7183",
                                        "glosses": [
                                            "Most definitely; truly."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11196d9-fb29-4c62-84bb-cfb02a4fc429",
                                                "sense_id": "b7eb7435-81df-390b-9aff-29f16aed7e6c",
                                                "text": "He was indeed emphatically a popular writer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd7cbc12-5075-3d56-85f0-0cd42e584c1d",
                                        "entry_id": "317814f5-7e37-3551-9ec8-757b5f0e7183",
                                        "glosses": [
                                            "Not really, but apparently."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f1fc84-04c6-4bde-aaa3-ad2a84fea390",
                                                "sense_id": "fd7cbc12-5075-3d56-85f0-0cd42e584c1d",
                                                "text": "I must be taken neither really nor emphatically , but only emblematically: for being the Hierogliphick of celerity, and swifter than other animals, men best expreſſed their velocity by incurvity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
