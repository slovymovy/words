                        "source_sense_id": "6b299481-b3e6-3180-9a65-fbe375485fea",
                        "target_lang_word": "restart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2f3447-23db-3846-acda-1ba696ad595c",
                                        "entry_id": "691de0ee-62a5-3ae5-82a3-dd3812ba582d",
                                        "glosses": [
                                            "The act of starting something again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b7e7eaf-a1de-4c09-8e90-bc2d6e59dde5",
                                                "sense_id": "fa2f3447-23db-3846-acda-1ba696ad595c",
                                                "text": "After the restart of my browser, the problem went away."
                                            },
                                            {
                                                "example_id": "dfd95ebb-8115-4f3a-a4ac-dd6226085476",
                                                "sense_id": "fa2f3447-23db-3846-acda-1ba696ad595c",
                                                "text": "We were stopped by signal soon after this and from the restart we had to lift our vast train up the 1 in 200 to Survilliers."
                                            },
                                            {
                                                "example_id": "e2ffee02-28da-442a-b0fe-3098a43661bb",
                                                "sense_id": "fa2f3447-23db-3846-acda-1ba696ad595c",
                                                "text": "England looked to put width on the ball after the restart, Armitage very nearly going over in the corner only for the video referee to decide his foot was in touch. But Armitage did get on the score-sheet five minutes later, Ben Foden straightening and putting the London Irish man in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "restart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "324ff5e5-12ee-3986-b9ce-08e82c67ec41",
                                        "entry_id": "8d67ec9c-7014-334d-a2de-4b20eb0e5821",
                                        "glosses": [
                                            "To start again."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0a4ff34-4947-4d73-a33c-5e3aed63e21f",
                                                "sense_id": "324ff5e5-12ee-3986-b9ce-08e82c67ec41",
                                                "text": "All attempts to restart the engine failed."
                                            },
                                            {
                                                "example_id": "83391ede-ba0a-4738-b849-4706426863d2",
                                                "sense_id": "324ff5e5-12ee-3986-b9ce-08e82c67ec41",
                                                "text": "Another view of Ashchurch station on August 18, 1961, with \"Royal Scot\" 4-6-0 No. 46148 The Manchester Regiment restarting a Worcester-Cheltenham stopping train and a Class 4 2-6-0 at the branch platform on a train from Redditch."
                                            },
                                            {
                                                "example_id": "5ac49ec7-3d74-4a71-9094-ed8640237af9",
                                                "sense_id": "324ff5e5-12ee-3986-b9ce-08e82c67ec41",
                                                "text": "As of May 12, Crossrail was liaising with contractors to enable physical work at stations to restart. This had been suspended on March 24 due to the COVID-19 outbreak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc64eac-4f1a-3382-a653-255058b3873e",
                                        "entry_id": "8d67ec9c-7014-334d-a2de-4b20eb0e5821",
                                        "glosses": [
                                            "Synonym of reboot."
                                        ],
