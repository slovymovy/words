                        "entry_id": "3755d8b1-d55d-3f91-9591-77602b45f8f7",
                        "glosses": [
                            "geräuchertes und gepökeltes Bauchfleisch vom Schwein; häufig mit anhaftender Schwarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b9c604-cc98-481d-a44d-0f36b4f6074e",
                                "sense_id": "a0888c70-d66b-3741-aac7-d1d85b11f966",
                                "text": "Ich esse morgens oft Frühstücksspeck."
                            },
                            {
                                "example_id": "35fd5ad8-bdde-4b26-8548-e997e24b39de",
                                "sense_id": "a0888c70-d66b-3741-aac7-d1d85b11f966",
                                "text": "„Er öffnete den Kühlschrank und holte Eier, etwas Frühstücksspeck, der schon kurz vor dem Ablaufdatum stand, ein paar bräunliche Pilze und Zwiebeln raus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
