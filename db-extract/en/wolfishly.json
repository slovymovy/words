                        "entry_id": "a7f4a3b7-eb91-3e7f-9ab0-625a8f8e0c53",
                        "glosses": [
                            "In a wolfish way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6081b37e-37fc-4fc7-84e5-ef638a53f250",
                                "sense_id": "1abcd1db-20a1-34fb-837b-f208524c46cf",
                                "text": "I […] filled up an interval of silence by attempting to caress the canine mother, who had left her nursery, and was sneaking wolfishly to the back of my legs, her lip curled up, and her white teeth watering for a snatch."
                            },
                            {
                                "example_id": "0a4d498e-6b38-4bc3-a596-8de88e4b3a3d",
                                "sense_id": "1abcd1db-20a1-34fb-837b-f208524c46cf",
                                "text": "He told me he would have roasted their toes rather than be baulked. I believe him. His men believed him too. They didn’t cheer aloud, being a dumb pack, but made ready wolfishly."
                            },
                            {
                                "example_id": "ea006315-99e5-422d-afb2-7cc9db342fd4",
                                "sense_id": "1abcd1db-20a1-34fb-837b-f208524c46cf",
                                "text": "Spade grinned wolfishly, showing the edges of teeth far back in his jaw."
                            },
                            {
                                "example_id": "9627ff4a-1b6e-4ca8-b837-10e75fef01aa",
                                "sense_id": "1abcd1db-20a1-34fb-837b-f208524c46cf",
                                "text": "They took the plates. They ate silently, wolfishly, and wiped up the grease with the bread."
                            }
                        ]
                    }
