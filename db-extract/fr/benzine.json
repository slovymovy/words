        "fr-extract.jsonl": [
            {
                "entry_id": "8b418580-6b9b-3975-9444-51ac059f53d0",
                "word": "benzine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "652ace17-d64e-4b7d-91a8-ad5e2819d1ed",
                        "entry_id": "8b418580-6b9b-3975-9444-51ac059f53d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "benzines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a2b7f7e-6bfb-3d3a-94f8-8eafd58a48b1",
                        "entry_id": "8b418580-6b9b-3975-9444-51ac059f53d0",
                        "glosses": [
                            "Benzène."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0fb17ff4-042e-43ca-8581-e00a68f77221",
                                "sense_id": "4a2b7f7e-6bfb-3d3a-94f8-8eafd58a48b1",
                                "text": "Il est probable que la décomposition par la chaleur de l'acide acétique et des composés du même ordre à équivalents plus élevés, étant opérée dans des conditions déshydrogénantes, formera, outre la benzine, toute la série des carbures analogues."
                            },
                            {
                                "example_id": "cab92d05-12e7-47f6-a40a-9c2561458222",
                                "sense_id": "4a2b7f7e-6bfb-3d3a-94f8-8eafd58a48b1",
                                "text": "Je ne sache pas que la benzine ait été administrée à l'intérieur à titre de vermicide. Son emploi a été borné jusqu’ici au traitement de l’infection trichineuse."
                            },
                            {
                                "example_id": "69c0eb14-b330-42ae-ba99-9717959120e7",
                                "sense_id": "4a2b7f7e-6bfb-3d3a-94f8-8eafd58a48b1",
                                "text": "L'extraction des graisses se fait par un dissolvant des matières grasses: benzine, sulfure de carbone, alcool, etc."
                            },
                            {
                                "example_id": "7c6a45e2-0f6e-4259-bfda-7411c278ed41",
                                "sense_id": "4a2b7f7e-6bfb-3d3a-94f8-8eafd58a48b1",
                                "text": "Le voyage à la ville est devenu pour la vieille fille une joie bimensuelle, à laquelle elle se prépare d’avance, en faisant des gammes et en nettoyant ses gants à la benzine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffed4850-7002-3eb6-9056-e1b9ddc6b757",
                        "entry_id": "8b418580-6b9b-3975-9444-51ac059f53d0",
                        "glosses": [
                            "Essence."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e60f71fa-b3cf-4f34-9f48-d5f8b1e68b27",
                                "sense_id": "ffed4850-7002-3eb6-9056-e1b9ddc6b757",
                                "text": "Peut-être qu’ils trouvent, et que c’est pas idiot de trouver que payer des impôts sur, euh, la benzine, pour eux qui ont des bas revenus, que ça serait, que ça soit difficile ; mais que ils seraient tout-à-fait prêts à reconnaître qu’il faut faire quelque chose pour pas que ça s’empire au niveau climatique."
                            },
                            {
                                "example_id": "081a798e-e941-4466-bcdd-2dda4313e601",
                                "sense_id": "ffed4850-7002-3eb6-9056-e1b9ddc6b757",
                                "text": "17 août 1940 – Alléluia ! M. Blanchet a généreusement offert ses derniers litres de « benzine » pour qu’on puisse me ramener chez moi."
                            }
                        ]
                    }
