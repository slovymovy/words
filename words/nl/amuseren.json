                    "sense_definition": "zichzelf vermaken of plezier hebben met een bepaalde activiteit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plezier hebben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>amuseren</w> zich de hele middag in de speeltuin.",
                            "target_lang_translations": {
                                "en": "The children are <w>enjoying themselves</w> in the playground all afternoon."
                            }
                        },
                        {
                            "text": "Ik hoop dat jullie je goed <w>amuseren</w> op het feestje vanavond.",
                            "target_lang_translations": {
                                "en": "I hope you <w>have a good time</w> at the party tonight."
                            }
                        }
                    ],
                    "synonyms": [
