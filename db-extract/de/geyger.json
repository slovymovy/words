                ],
                "senses": [
                    {
                        "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                        "entry_id": "c6ca9ce7-d61a-3a99-87b5-78a2bcf00ce7",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1185a120-4478-4dd0-a382-55e0c8912d1c",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Frau Geyger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "556d42e7-af39-4b90-8c6a-c023b8f1ffd1",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Herr Geyger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ed139d88-47e6-417a-9d86-5905c32976bc",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Die Geygers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "74fe0c19-7e89-422b-a786-5f3d4357cfaa",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Der Geyger trägt nie die Schals, die die Geyger ihm strickt."
                            },
                            {
                                "example_id": "febab6d2-9b7c-4c64-94e3-6e18346dfb56",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geyger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "6eacaeb0-63a6-4ba3-8fc9-fd5a973c6240",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Geyger kommt und geht."
                            },
                            {
                                "example_id": "e74e0ed7-77fd-4c5c-8d31-efe666a41a08",
                                "sense_id": "3eb007b7-8775-3c13-888d-d92b50483a09",
                                "text": "Geygers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
