                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaming computer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eceeb48-f9a4-3a95-9285-dac64f3043e3",
                                        "entry_id": "f9c17f1b-3149-39a9-ad6c-07b312b94146",
                                        "glosses": [
                                            "a personal computer designed for playing video games"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdffc88e-de81-4a80-a765-bef582ffd7d4",
                                                "sense_id": "3eceeb48-f9a4-3a95-9285-dac64f3043e3",
                                                "text": "“I wanted the ultimate gaming computer, something so fast I wouldn't have to worry about speed for years,” says the high-school student from Yorktown, Virginia."
                                            },
                                            {
                                                "example_id": "7b2b2f4e-4ac4-47b8-8649-9f92998141ca",
                                                "sense_id": "3eceeb48-f9a4-3a95-9285-dac64f3043e3",
                                                "text": "Developers run algorithms in real time through equipment from VoodooPC - a designer and manufacturer of high-performance gaming computer systems acquired by HP last year[…]"
                                            },
                                            {
                                                "example_id": "294d4818-6874-4a51-87a0-0afc98fa3955",
                                                "sense_id": "3eceeb48-f9a4-3a95-9285-dac64f3043e3",
                                                "text": "The gaming computer in the research lab used during this study was separated from the main area with screens and resided in its own cubicle to avoid distraction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
