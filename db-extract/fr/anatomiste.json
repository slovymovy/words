                                "target_senses": [
                                    {
                                        "sense_id": "47b3e3af-620d-3f54-8995-9997e34a6a5f",
                                        "entry_id": "d5813087-d753-393d-abf7-9419f85fd0c9",
                                        "glosses": [
                                            "een persoon die kennis draagt van de (menselijke) anatomie"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a3d1931-acbc-488a-aba5-0cbe13fbdcba",
                                                "sense_id": "47b3e3af-620d-3f54-8995-9997e34a6a5f",
                                                "text": "Verder hield hij zijn ontdekking stil, en nam zich voor de Leidse hoogleraar Franciscus Deleboe Sylvius te vragen of andere anatomen de uitvoergang al kenden."
                                            },
                                            {
                                                "example_id": "13b70f52-894a-4ae7-957e-37bd317f8401",
                                                "sense_id": "47b3e3af-620d-3f54-8995-9997e34a6a5f",
                                                "text": "\" Polly volgt zijn advies op en besluit voor zichzelf dat William Hewson, de Britse chirurg, anatoom en fysioloog, haar man zal worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a1333a-f05f-404e-b6fc-d7e2ae1940af",
                        "source_entry_id": "e6769474-d515-33ac-8909-3fca23cfe732",
