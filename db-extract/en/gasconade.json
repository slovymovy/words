                "senses": [
                    {
                        "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                        "entry_id": "d03339fd-e848-38c4-983a-f678c5667989",
                        "glosses": [
                            "To talk boastfully."
                        ],
                        "tags": [
                            "derogatory",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4f5cb50f-7346-4c73-8b82-200657241b70",
                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                "text": "The Frenchman, not being able to bring the precise number, received only, as the first month's pay, 2,000 rupees. He demanded an audience, talked loud, and gasconaded."
                            },
                            {
                                "example_id": "b8a8eb5d-37e7-46cf-a3b9-5cef485ab516",
                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                "text": "[…]he gasconaded on the theme of his personal exploits in the Seven Years' War of France in Spain, as if he had been as prime a sword-player as Murat[…]"
                            },
                            {
                                "example_id": "6d66fa21-d380-46e0-89f2-a76ebd49f74d",
                                "sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                                "text": "For two hours, [Khrushchev] gasconaded about the tenfold revaluation of the ruble and the abolition of the Soviet income tax by 1965."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "313382b8-d0bf-4058-bd25-ec18b71b012e",
                        "source_entry_id": "d03339fd-e848-38c4-983a-f678c5667989",
                        "source_sense_id": "a12e7a22-d242-3272-a4b5-6fa36cace792",
                        "source_sense_description": "To talk boastfully",
                        "target_lang_word": "gasconner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gasconner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1046de-3d98-3548-b542-4381c55707d2",
                                        "entry_id": "f6bc5756-0e41-384d-abc9-121a095b0d3d",
                                        "glosses": [
                                            "Parler avec l’accent gascon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f354df-3691-4222-8ba9-9e212c98df13",
                                                "sense_id": "4c1046de-3d98-3548-b542-4381c55707d2",
                                                "text": "Godefroid ne grasseyait pas, ne gasconnait pas, ne normandisait pas, il parlait purement et correctement, et mettait fort bien sa cravate, comme Finot."
                                            },
                                            {
                                                "example_id": "395ff3f3-ce85-46a3-ad06-4258ddfe3a1f",
                                                "sense_id": "4c1046de-3d98-3548-b542-4381c55707d2",
                                                "text": "Les nobliaux normands y ont ainsi implanté leur rester, au détriment de demeurer, seul correct, toute âme bien née sachant de race qu’on ne reste pas dans tel endroit mais qu’on y demeure. Les gascons ont fait pis car on les entend s’écrier à haute voix : « Monseigneur Futile m’a dit de faire telle chose… », alors qu'il eût à l’évidence pour une âme de qualité fallu dire : « m’a dit que je fisse ». Voilà, voilà une façon de gasconner qui « ne vaut rien » !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7569850c-38e8-3899-8ace-9a76e0dc229e",
                                        "entry_id": "f6bc5756-0e41-384d-abc9-121a095b0d3d",
                                        "glosses": [
                                            "Dire des gasconnades."
                                        ],
                                        "tags": [
