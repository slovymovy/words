                "senses": [
                    {
                        "sense_id": "ca3e000c-a82c-31bf-bfc6-60a0850709dc",
                        "entry_id": "8c20ebfe-b067-3683-be80-ff5b393ff594",
                        "glosses": [
                            "Gobelet spartiate qui cache à la vue la couleur de l’eau et retient dans ses bords la boue qui peut s’y trouver."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "6563459c-1abd-4a98-911e-5a9818056c9f",
                                "sense_id": "ca3e000c-a82c-31bf-bfc6-60a0850709dc",
                                "text": "Les anses des vaisseaux de petite dimension, celles du cothon entre autres, s’appelaient les mains ; le verre à boire était muni de doigts."
                            },
                            {
                                "example_id": "4fdbf7b2-0fbf-441b-8dd7-7d53a0ba71f6",
                                "sense_id": "ca3e000c-a82c-31bf-bfc6-60a0850709dc",
                                "text": "Voilà d’où vient la réputation du cothon laconien, ce gobelet si commode, surtout aux soldats en campagne, comme l’assure Critias : sa couleur empêchait qu’ils n’aperçussent la malpropreté des eaux qu’on est quelquefois obligé de boire, et dont la vue les eût dégoûtés ; d’ailleurs les ordures qui s’y trouvaient étaient retenues par les rebords rentrants du vase, et il ne venait à la bouche que ce qu’il y avait de pur."
                            }
                        ]
                    },
                    {
                        "sense_id": "28d3cc63-10f9-3cd8-8967-ee6ac4fc695d",
                        "entry_id": "8c20ebfe-b067-3683-be80-ff5b393ff594",
                        "glosses": [
                            "« Port phénicien creusé à la main puis relié à la mer par un chenal »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ce5be1-1c4c-4382-a449-3c8408d1956c",
                                "sense_id": "28d3cc63-10f9-3cd8-8967-ee6ac4fc695d",
                                "text": "Le bassin de Motya passait toutefois pour l’un des trois cothons bien conservés du monde méditerranéen, de sorte que la révélation par l’équipe de Lorenzo Nigro des erreurs de Joseph Whitaker n’est pas une mince affaire."
                            }
                        ]
                    }
