                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72c6bb65-1c47-3476-966e-4521e4d622ec",
                                        "entry_id": "f4918cbb-805a-3054-b87f-5c87aa183ceb",
                                        "glosses": [
                                            "Incluirse en alguna acción o hecho."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "participar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f38bbe99-63ad-3892-801b-9ef054f42851",
                                        "entry_id": "96ed37f7-424c-35e7-81b0-a02af5d51457",
                                        "glosses": [
                                            "Dar parte, noticiar, comunicar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3bfc1b-373e-4322-8ea3-50f4213ac8c2",
                                                "sense_id": "f38bbe99-63ad-3892-801b-9ef054f42851",
                                                "text": "Y con estos pensamientos en el alma, dijo Simmias, ¿querías abandonarnos sin participárnoslos?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19d8ce8f-6824-4b59-a539-e4dbee22ae82",
                        "source_entry_id": "2ebcec2d-f863-3613-a93c-666f7015c6ae",
                        "source_sense_id": "fe29e1e5-6fac-3d6d-86b0-8145fa4d5f52",
                        "target_lang_word": "participer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "participer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edfd7011-d570-34ff-b57e-16d5dbf9de79",
                                        "entry_id": "2c8227ed-d121-32ff-af16-38564c158755",
                                        "glosses": [
                                            "Agir en commun, à quelque action, avec autrui ; coopérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1b1015-77e4-4903-8dcb-9ec3a7d7ef57",
                                                "sense_id": "edfd7011-d570-34ff-b57e-16d5dbf9de79",
                                                "text": "Les légionnaires du centurion Marcus, officier d’Arles, participaient vendredi 12 août à une marche expérimentale sur quatre kilomètres entre Le Fâ et Arces-sur-Gironde."
                                            },
                                            {
                                                "example_id": "0a17359a-caef-444c-a7e8-d2084766c4ef",
                                                "sense_id": "edfd7011-d570-34ff-b57e-16d5dbf9de79",
                                                "text": "Ils le mirent au courant de leur projet de rébellion contre le monarque pour venger la mort de leur père et l’incitèrent à y participer aussi."
                                            },
                                            {
                                                "example_id": "858bbe41-bb8b-4d13-b8f0-c807d3bfc50f",
                                                "sense_id": "edfd7011-d570-34ff-b57e-16d5dbf9de79",
                                                "text": "Ah, mais c’est pas possible, ça ! J’ai pas envie, de participer ! À rien ! C’est pas mon genre, de participer ! Jamais je participerai ! À part à vos obsèques, bande de cons !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b56833-0b6a-3542-a887-61f64118e2f6",
                                        "entry_id": "2c8227ed-d121-32ff-af16-38564c158755",
                                        "glosses": [
                                            "Vivre quelque chose en commun avec autrui ; communier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c167cecb-c466-4bea-95ac-f1783428541b",
                                                "sense_id": "e5b56833-0b6a-3542-a887-61f64118e2f6",
                                                "text": "Dans l’après-midi, alors que les invités terminaient le repas de fête, au milieu de la grande salle de l’auberge, la tante alla prendre Gaspard dans son berceau pour le faire participer au toast que l’on portait en son honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e4b177-379c-3e56-90e4-378f64cfe4ad",
                                        "entry_id": "2c8227ed-d121-32ff-af16-38564c158755",
                                        "glosses": [
                                            "Souscrire ou s’associer aux sentiments d’autrui."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e1e4f20-aaf4-4c66-ba2b-5881840c15ce",
                                                "sense_id": "38e4b177-379c-3e56-90e4-378f64cfe4ad",
                                                "text": "A tous, mais spécialement à Danièle, sa femme, et aux membres de sa famille, la Direction des Cahiers et l’École tout entière veulent dire combien ils participent à leur chagrin, et ressentent le même vide."
                                            },
                                            {
                                                "example_id": "8c9d2cc8-3635-4378-9f5a-8c1f3945d950",
                                                "sense_id": "38e4b177-379c-3e56-90e4-378f64cfe4ad",
                                                "text": "La reine Anne d’Autriche écrivit au duc une lettre où elle lui déclara qu’elle participait à sa douleur. Richelieu lui emboîta le pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bec0360-f06c-3475-80d4-a4e7314a9f1c",
                                        "entry_id": "2c8227ed-d121-32ff-af16-38564c158755",
                                        "glosses": [
                                            "Payer sa part de ; cotiser pour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3a5290-93ad-4026-825b-833009fa6107",
                                                "sense_id": "0bec0360-f06c-3475-80d4-a4e7314a9f1c",
                                                "text": "De temps en temps, son mari participait aux frais du ménage avec l’argent qu’il soutirait à ses parents. Lassée de cette situation, elle s’est décidée à partir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e90566d-3222-3243-a75e-cab2c185d8ba",
                                        "entry_id": "2c8227ed-d121-32ff-af16-38564c158755",
                                        "glosses": [
                                            "Recevoir sa part de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d433da3-d418-4d6e-a75f-8ee0a426c282",
                                                "sense_id": "3e90566d-3222-3243-a75e-cab2c185d8ba",
                                                "text": "A côté des sociétés où l’associé-travailleur ne participait qu’aux bénéfices et non à la propriété même du capital social, il y en avait d’autres où l’apport de l’associé-capitaliste était fait en propriété."
                                            }
                                        ]
