                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The punishment inflicted on the prisoners was <w>medieval</w> in its cruelty.",
                            "target_lang_translations": {
                                "ru": "Наказание, которому подверглись заключенные, было <w>средневековым</w> по своей жестокости.",
                                "zh": "对囚犯施加的惩罚其残忍程度简直是<w>野蛮</w>的。",
                                "es": "El castigo infligido a los prisioneros fue <w>medieval</w> por su crueldad.",
                                "tr": "Mahkumlara uygulanan ceza, acımasızlığı bakımından <w>barbarca</w> idi.",
                                "de": "Die Strafe, die den Gefangenen zugefügt wurde, war in ihrer Grausamkeit <w>mittelalterlich</w>."
                            }
                        },
                        {
                            "text": "If you don't pay the money, they might get <w>medieval</w> on you.",
                            "target_lang_translations": {
                                "ru": "Если ты не заплатишь деньги, они могут обойтись с тобой <w>по-средневековому</w>.",
                                "zh": "如果你不付钱，他们可能会对你采取<w>野蛮</w>手段。",
                                "es": "Si no pagas el dinero, podrían ponerse <w>medievales</w> contigo.",
                                "tr": "Eğer parayı ödemezsen, sana <w>barbarca</w> davranabilirler.",
                                "de": "Wenn du das Geld nicht bezahlst, könnten sie <w>mittelalterlich</w> mit dir umspringen."
                            }
                        }
