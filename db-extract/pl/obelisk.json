                "senses": [
                    {
                        "sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "glosses": [
                            "pomnik w formie wysokiego, smukłego słupa, najczęściej o czworobocznej podstawie, wykonanego z jednego bloku skalnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54218b11-7223-4d8b-9236-b9db5f5634fb",
                                "sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                                "text": "W siedemdziesiątą trzecią rocznicę tej katastrofy postawiono w mieście pamiątkowy obelisk."
                            },
                            {
                                "example_id": "4df6b8eb-9186-4f2c-959e-a833e15b87f5",
                                "sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                                "text": "O dawnym gmachu muzeum informuje tablica pamiątkowa przy obelisku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f74a4ea0-a106-49e9-b344-a6e4a8fe5e01",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "obelisk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "A tall, square, tapered, stone monolith topped with a pyramidal point, frequently used as a monument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be524519-0b33-4272-9f14-c9d44892094b",
                                                "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                                "text": "\"The clay envelope is Sumerian. It is from the third millennium B.C. It was dug up from the city of Eridu is southern Iraq. The black stele or obelisk is the Code of Hammurabi, which dates from about 1750 B.C."
                                            },
                                            {
                                                "example_id": "f7e0c672-0922-47d8-9c1a-c23633753029",
                                                "sense_id": "568990dc-fb6c-3993-80d5-40008cfbd9f7",
                                                "text": "The Washington Monument is often described as an obelisk, and sometimes even as a \"true obelisk,\" even though it is not. A true obelisk is a monolith, a pylon formed out of a single piece of stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4ef0cb-cd44-32d8-99c0-4b579d27ac50",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "Synonym of obelus.",
                                            "A symbol resembling a horizontal line (–), sometimes together with one or two dots (for example, ⨪ or ÷), which was used in ancient manuscripts and texts to mark a word or passage as doubtful or spurious, or redundant."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0201f43-2cf6-3e98-8eef-226859fdfa4f",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "Synonym of obelus.",
                                            "A dagger symbol (†), which is used in printed matter as a reference mark to refer the reader to a footnote, marginal note, etc.; beside a person's name to indicate that the person is deceased; or beside a date to indicate that it is a person's death date."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26c9dd0e-1e38-3da4-89d5-2b7068394105",
                                        "entry_id": "538ea57c-d679-3575-bfd6-13cd742ff298",
                                        "glosses": [
                                            "An RNA structure similar to a viroid, with a rod-like secondary structure, which comprises its own phylogenetic group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "940f8d79-2fca-38a6-b83c-f7e7d505dc39",
                                        "entry_id": "51b4ca04-4dd2-3897-8ec2-34a3f95c7b80",
                                        "glosses": [
                                            "To adopt the obelisk posture; to point the tip of the abdomen towards the sun."
                                        ],
                                        "tags": [
                                            "of a dragonfly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b667fab3-5b5e-40a3-9d6b-e5b0c3608c06",
                                                "sense_id": "940f8d79-2fca-38a6-b83c-f7e7d505dc39",
                                                "text": "Dragonflies that spend the day in full sun may obelisk to minimize the sunlight striking the body. An obelisking dragonfly looks like it's doing a headstand[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7da788c9-3939-417f-9bc4-d6b4998f8482",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "obelisk",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obelisk",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "aa4ad1ab-0b71-329d-b3eb-c91e7a8322ba",
                                        "entry_id": "8d77af16-fe6b-342e-973a-dae00feedfbc",
                                        "glosses": [
                                            "kamenný sloup ve tvaru čtyřbokého jehlanu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9165c72-7283-4b25-859a-8badb0cbd1b9",
                                                "sense_id": "aa4ad1ab-0b71-329d-b3eb-c91e7a8322ba",
                                                "text": "Londýn, podobně jako Paříž, Řím a York chtěl na svých březích hostiti nějakou památku staroegyptskou, a k tomu vyvolen obelisk darovaný anglické vládě Mohamedem Alim a převezený r. 1877 do Anglie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e62d1a61-29a2-4762-bda1-1018766ddf43",
                        "source_entry_id": "3c0acc3c-11c1-3e6e-9f0d-55380c02d06b",
                        "source_sense_id": "7ad91d8a-1b82-3e04-b771-b374bb0a0e4a",
                        "target_lang_word": "obélisque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obélisque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                                        "glosses": [
                                            "Monument quadrangulaire en forme d’aiguille, élevé sur un piédestal et ordinairement monolithe."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f0f7cd-13f8-4282-9925-ba451ae4a9ea",
                                                "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                                                "text": "Entre l’obélisque de Paris et son frère resté à Louxor, il n’y a plus de ressemblance aucune, et c’est miracle que le nôtre ait su prendre une beauté nouvelle en abandonnant sur la terre égyptienne tout ce qui lui donnait signification et grandeur."
                                            },
                                            {
                                                "example_id": "27fcee14-338d-4ae3-b4fb-91425cd718d0",
                                                "sense_id": "757cace8-80cc-3afd-904d-403f11c232a6",
                                                "text": "Cherchez à prononcer entre celui qui a gravé des canards sur les obélisques égyptiens et celui qui a bostonné pendant vingt ans avec du Bousquet, monsieur de Valois, mademoiselle Cormon, le Président du Tribunal, le Procureur du Roi, l’abbé de Sponde, madame Granson, e tutti quanti ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee917101-9d5f-39f9-bbf3-9ac00287e6a2",
                                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                                        "glosses": [
                                            "Monument moderne ayant la même forme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4c8e25-2a1e-441d-a624-fc9b199bdd6b",
                                                "sense_id": "ee917101-9d5f-39f9-bbf3-9ac00287e6a2",
                                                "text": "Obélisque indiquant un rendez-vous de chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc20d22-86e6-36e9-b3b0-5d1de2bfcd4b",
                                        "entry_id": "c4c6ab0f-8a83-33b7-87b2-de1e5e42f28d",
                                        "glosses": [
                                            "Meuble représentant le monument du même nom dans les armoiries."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f146117-bd82-4a58-8c7f-5306027bf047",
                                                "sense_id": "edc20d22-86e6-36e9-b3b0-5d1de2bfcd4b",
                                                "text": "D’azur à l’obélisque d’argent accosté de deux grues affrontées du même, au chef de gueules aux deux otelles d’argent posées l’une sur l’autre, l’une en bande, l’autre en barre accostées d’une demi-croix de Toulouse d’or, le tout accosté de deux lions affrontés du même issant des flancs, à la fasce ondée d’argent brochant sur le trait de la partition chargée d’un roc d’échiquier d’or, qui est de la commune de Roques de Midi-Pyrénées → voir illustration « armoiries avec un obélisque »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
