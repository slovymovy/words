                        "target_lang_word": "justaucorps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "justaucorps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                        "entry_id": "8b5503f1-331e-32b8-af58-4fa357aa6b5b",
                                        "glosses": [
                                            "Pourpoint, vêtement qui serre le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2845c4df-9d8d-4315-b295-163fd7f76abe",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "Othon […] se fit indiquer le tailleur le mieux assorti de la ville, changea ses habits de velours et de soie contre un justaucorps de drap vert serré avec une ceinture de cuir."
                                            },
                                            {
                                                "example_id": "fdfe375b-892e-4eda-8e5d-249ed06366b5",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "Une fille en foulard et justaucorps sauta de la voiture, et se mis à secouer le portail à coups de poings dignes d’un homme."
                                            },
                                            {
                                                "example_id": "24821b80-8444-4a25-9134-0debc8538d34",
                                                "sense_id": "b5e2e767-64de-3a67-83e4-2df0403294f4",
                                                "text": "La guerre de 1914 était responsable de quelques lacunes dans le vocabulaire de mon père, qui les transmit à plusieurs générations. Il nous disait par exemple qu’un autodidacte est un monsieur qui conduit lui-même son automobile ou que la grande surprise se manifeste par un justaucorps subit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b760572b-4767-3161-a39e-0bb6a6837c97",
                                        "entry_id": "8b5503f1-331e-32b8-af58-4fa357aa6b5b",
                                        "glosses": [
                                            "Vêtement moulant utilisé pour faire de la gymnastique, avec ou sans manche."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478d1218-c933-480e-a76f-ec186818b3e8",
                                                "sense_id": "b760572b-4767-3161-a39e-0bb6a6837c97",
                                                "text": "Une femme en justaucorps faisait faire des jumping jacks à un groupe d’adhérentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
