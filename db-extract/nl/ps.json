                        "source_sense_id": "0e98e4eb-73fc-3016-8788-50cf58cce409",
                        "source_sense_description": "de afkorting voor Parti Socialiste, een sociaaldemocratische Franstalige partij in Brussel en Wallonië",
                        "target_lang_word": "PS",
                        "target_lang_code": "de",
