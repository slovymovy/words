                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стипендия",
                                "target_lang_sense_clarification": "для обучения"
                            },
                            {
                                "target_lang_word": "грант",
                                "target_lang_sense_clarification": "для исследований"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "scholarship",
                                "target_lang_sense_clarification": "for students"
