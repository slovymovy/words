                "senses": [
                    {
                        "sense_id": "d276b596-8b0f-37ff-b803-cf8de529ccc0",
                        "entry_id": "a115b4a6-2b85-313b-9cbb-61244ce3d45b",
                        "glosses": [
                            "iemand die zielig is en dus medelijden verdient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e1ebeb9-0392-4f38-9dfc-918935876d93",
                                "sense_id": "d276b596-8b0f-37ff-b803-cf8de529ccc0",
                                "text": "Van de meeste technische ontwikkelingen kunnen wij meeprofiteren. Met wij bedoel ik dan vooral onze leiding. Niet lang nadat we telefoons konden gebruiken, werden bij ons de eerste stumperds veroordeeld op basis van bewijs uit telefoongesprekken. Niet lang nadat er harddisks waren, kon de inhoud daarvan ook tegen je worden gebruikt."
                            },
                            {
                                "example_id": "96f4ef7e-9810-47c4-8d14-fd06b930e980",
                                "sense_id": "d276b596-8b0f-37ff-b803-cf8de529ccc0",
                                "text": "De finale werd op gang gefloten. Frankrijk dicteerde de wet, Ronaldo had een marginale rol, kwam niet bij de bal. Vaak zag je hem in een hoekje van het tv-scherm boos gesticuleren naar de minder begaafde stervelingen die God tegen alle afspraken in met de Portugese nationaliteit had bedacht, stumperds die niet eens bij machte waren hem alleen voor doel te brengen."
                            },
                            {
                                "example_id": "babc994b-902c-4f4f-99f8-b183f096e956",
                                "sense_id": "d276b596-8b0f-37ff-b803-cf8de529ccc0",
                                "text": "De man, die niet voor rechter Stoov verscheen, vernielde op 18 juli van dit jaar een ruit van winkelcentrum de Havenpassage in Almelo. Toen hij hiervoor door agenten werd aangehouden, noemde hij ze ‘dikke stumperds’. De man, die volgens de rechter een ‘behoorlijk strafblad’ heeft, herinnerde zich de gebroken ruit niet, omdat hij behoorlijk gedronken had. Hij heeft voor het vergrijp twee dagen vastgezeten in het arrestantencentrum in Borne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084b2cbc-9717-4795-9c69-b5c9794f3054",
                        "source_entry_id": "a115b4a6-2b85-313b-9cbb-61244ce3d45b",
                        "source_sense_id": "d276b596-8b0f-37ff-b803-cf8de529ccc0",
                        "source_sense_description": "zielenpoot",
                        "target_lang_word": "wretch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wretch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4d245d-ff05-3d68-85e5-ec15c54877fb",
                                        "entry_id": "2acc76de-3cf0-355a-b27f-87587898dc2f",
                                        "glosses": [
                                            "An unhappy, unfortunate, or miserable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a90643e-905d-44ce-94ac-32473261177f",
                                                "sense_id": "fe4d245d-ff05-3d68-85e5-ec15c54877fb",
                                                "text": "The poor wretch, who lay motionless a long time, just began to recover his senses as a stage-coach came by."
                                            },
                                            {
                                                "example_id": "f2d88805-061d-4124-bd4a-5ef4120e07fd",
                                                "sense_id": "fe4d245d-ff05-3d68-85e5-ec15c54877fb",
                                                "text": "The four unhappy wretches labouring under sentence of banishment were freed from their fetters, to rejoin their former society; and three days given as holidays to every convict in the colony."
                                            },
                                            {
                                                "example_id": "bbec5ec1-25bd-4e94-8c4a-3677947818d8",
                                                "sense_id": "fe4d245d-ff05-3d68-85e5-ec15c54877fb",
                                                "text": "And his subjects wrung all they could wring / Out of temple and palace and store. / But when there seemed no more to bring, / His captors convicted the king / Of once having started a war, / And strangled the wretch with a string."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                                        "entry_id": "2acc76de-3cf0-355a-b27f-87587898dc2f",
                                        "glosses": [
                                            "An unpleasant, annoying, worthless, or despicable person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "004f69ad-4f8f-482f-b7bd-ebb5bd87ac34",
                                                "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                                                "text": "Swear to me but, thou bold wretch! said she, swear to me, that Pamela Andrews is really and truly thy lawful wife, without sham, without deceit, without double-meaning; and I know what I have to say!"
                                            },
                                            {
                                                "example_id": "03d97576-ae53-4108-8fe9-aedda6cae915",
                                                "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                                                "text": "I asked that selfish wretch, Winterblossom, to walk down with me to view her distress, and the heartless beast told me he was afraid of infection!"
                                            },
                                            {
                                                "example_id": "9dba1944-45ad-43de-8b26-114aa1e20d06",
                                                "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                                                "text": "[…]Alaeddin ate and drank and was cheered and after he had rested and had recovered spirits he cried, \"Ah, O my mother, I have a sore grievance against thee for leaving me to that accursed wight who strave to compass my destruction and designed to take my life. Know that I beheld Death with mine own eyes at the hand of this damned wretch, whom thou didst certify to be my uncle;[…]"
                                            },
                                            {
                                                "example_id": "03bdf4c4-ad8d-4317-844a-aa433dd8f99d",
                                                "sense_id": "6fb2f663-cf0b-3be6-a933-b87f38441b9f",
                                                "text": "How I cursed my selfishness and the folly that had kept me lingering by Ayesha's side while my dear boy lay dying! Alas and alas! how easily the best of us are lighted down to evil by the gleam of a woman's eyes! What a wicked wretch was I!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8549f5d0-e796-32c9-9552-9f79e8f83cf1",
                                        "entry_id": "2acc76de-3cf0-355a-b27f-87587898dc2f",
                                        "glosses": [
                                            "An exile."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
