                                                "sense_id": "b786bc09-bc91-39c4-8076-306daa1255f0",
                                                "text": "We're going on a safari in Kenya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1905258f-95b1-3245-8168-51d7bc5ee088",
