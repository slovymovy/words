{
    "word_family": [
        "опоздание",
        "опоздавший",
        "поздний",
        "поздно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1f95a8c-2abb-3815-93f1-2184298973d5",
                    "sense_definition": "Приходить позже назначенного времени или не успевать к началу какого-либо события.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "быть не вовремя",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я часто <w>опаздываю</w> на работу из-за пробок.",
                            "target_lang_translations": {
                                "en": "I am often <w>late</w> for work because of traffic jams."
                            }
                        },
                        {
                            "text": "Не <w>опаздывай</w> на встречу, пожалуйста.",
                            "target_lang_translations": {
                                "en": "Please don't be <w>late</w> for the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "задерживаться"
                    ],
                    "antonyms": [
                        "успевать"
                    ],
                    "common_phrases": [
                        "опаздывать на работу",
                        "опаздывать на встречу"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive after the scheduled time or to miss the beginning of an event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be late",
                                "target_lang_sense_clarification": "General term for arriving after the expected time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a916ab2a-7f62-3d39-957f-0f5e23f844f5",
                    "sense_definition": "Не успевать выполнить какое-либо действие или задачу к установленному сроку.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "быть не вовремя",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты <w>опаздывают</w> со сдачей курсовых работ.",
                            "target_lang_translations": {
                                "en": "Students are <w>behind schedule</w> with submitting their term papers."
                            }
                        },
                        {
                            "text": "Мы <w>опаздываем</w> с подготовкой проекта к сроку.",
                            "target_lang_translations": {
                                "en": "We are <w>behind schedule</w> with preparing the project by the deadline."
                            }
                        }
                    ],
                    "synonyms": [
                        "отставать",
                        "запаздывать"
                    ],
                    "antonyms": [
                        "успевать"
                    ],
                    "common_phrases": [
                        "опаздывать со сроками"
                    ],
                    "target_lang_definitions": {
                        "en": "To fail to complete a task or action by the established deadline."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be behind schedule",
                                "target_lang_sense_clarification": "To be delayed in completing a project or task."
                            },
                            {
                                "target_lang_word": "miss a deadline",
                                "target_lang_sense_clarification": "To fail to finish something by the required date."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}