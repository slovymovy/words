                    },
                    {
                        "translation_id": "4b83cd4d-2397-4133-84cb-15a2ef95da68",
                        "source_entry_id": "0564fd86-601e-38e9-8254-9f7409aef91d",
                        "source_sense_id": "127b10fa-526f-3b15-a24a-766326a4f179",
                        "source_sense_description": "small cardboard box in which matches are kept",
                        "target_lang_word": "Streichholzschachtel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streichholzschachtel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                        "entry_id": "f78b61b9-76ed-31e3-b3ee-18def6ffe1ac",
                                        "glosses": [
                                            "Behälter für Streichhölzer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0c201d-df61-461d-a86d-281ecb386499",
                                                "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                                "text": "Die Streichholzschachtel sollte trocken gehalten werden."
                                            },
                                            {
                                                "example_id": "540537f8-a7b7-4e38-91e4-7ec483fd4cb2",
                                                "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                                "text": "„Er suchte nach der Streichholzschachtel und schlurfte zurück ins Wohnzimmer.“"
                                            },
                                            {
                                                "example_id": "dd5cfd2f-e4f1-4658-b4c1-3792e78339c8",
                                                "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                                "text": "„Dass der Kongress an der Copacabana stattfand, hatte selbstverständlich rein gar nichts damit zu tun, dass die Frauen dort Badeanzüge tragen, die in einer Streichholzschachtel Platz haben.“"
                                            },
                                            {
                                                "example_id": "42ede024-d1c1-4bd3-9e0b-102cd97a287d",
                                                "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                                "text": "„Der japanische Samurai öffnete eine Streichholzschachtel, und es flog eine Hummel heraus.“"
                                            },
                                            {
                                                "example_id": "43a5eb8a-9698-42e8-9b4d-6099ffb0a7e1",
                                                "sense_id": "e03d32f5-e22f-305d-9016-9ddeb3b0603b",
                                                "text": "„Eine Weile später warf er den nass gewordenen Stumpen weg, zog eine neue, trockene Zigarre aus der Tasche und reichte Margrét die Streichholzschachtel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
