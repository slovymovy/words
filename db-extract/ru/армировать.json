                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5879d46d-1f74-45d6-a259-527c8cc5943a",
                                                "sense_id": "8c85129a-0ae4-3626-9633-e7a2a8e0d024",
                                                "text": "Das Erschleichen der Einbürgerung durch falsche Angaben ist mit Strafe bewehrt."
                                            }
                                        ],
