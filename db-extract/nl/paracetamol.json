                                                "sense_id": "6503f699-1154-3138-81ff-1cb3af1d770a",
                                                "text": "J’ai un sacré mal de tête, je vais prendre deux paracétamols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
