                        "examples": [
                            {
                                "example_id": "488a49a2-e679-45f5-9c38-47fee6b2af79",
                                "sense_id": "ed65174a-7327-37f5-9b87-408d3cfbf5e9",
                                "text": "Von dem großen Baum blieb nur noch ein Stumpen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7dd279b-ec9f-36aa-97e7-611e890c07fe",
                        "entry_id": "262b45ca-3ebd-3518-8fdf-1e5b77f4f181",
                        "glosses": [
                            "maschinell hergestellte Zigarre mit stumpf abgeschnittenen Enden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27848321-c9c4-4e64-a946-2482bc6c49ac",
                                "sense_id": "e7dd279b-ec9f-36aa-97e7-611e890c07fe",
                                "text": "Mein Opa rauchte seinen Stumpen mit großer Leidenschaft."
                            },
                            {
                                "example_id": "f629681d-1f4f-4c32-9030-43000ee57bfa",
                                "sense_id": "e7dd279b-ec9f-36aa-97e7-611e890c07fe",
                                "text": "„Eine Weile später warf er den nass gewordenen Stumpen weg, zog eine neue, trockene Zigarre aus der Tasche und reichte Margrét die Streichholzschachtel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "10aa8562-0ce5-3186-9c21-35c120e3bf39",
                        "entry_id": "262b45ca-3ebd-3518-8fdf-1e5b77f4f181",
                        "glosses": [
                            "Filz, der zu einem Hut verarbeitet wird und dafür bereits grob vorgeformt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e615f54-b532-4a18-a768-8082745a93ef",
                                "sense_id": "10aa8562-0ce5-3186-9c21-35c120e3bf39",
                                "text": "Vom Stumpen zum fertigen Hut sind noch einige Arbeitsschritte erforderlich."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
