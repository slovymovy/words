                                                "sense_id": "743bdf39-7372-338b-98a7-c3aad14c28a2",
                                                "text": "Das Floß konnte viel Oblast transportieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e90efeb-c3c6-3120-aebd-6e311e7b205f",
