                ],
                "senses": [
                    {
                        "sense_id": "7df766ce-3e9c-384e-9818-c1fd85b4c9aa",
                        "entry_id": "ebd926a9-8666-393b-b7c4-dccda016cbc4",
                        "glosses": [
                            "Something that prevents sound from traveling through it, such as is put on walls so adjacent areas are not disturbed by noise."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6861b627-b1a7-4c8c-bfb9-6fe9d21b1150",
                                "sense_id": "7df766ce-3e9c-384e-9818-c1fd85b4c9aa",
                                "text": "Until the soundproofing is installed, I don't think I'll be able to get to sleep here."
                            }
                        ]
                    },
                    {
                        "sense_id": "2aa759a8-2b8c-3145-bb63-37c93a96472a",
                        "entry_id": "ebd926a9-8666-393b-b7c4-dccda016cbc4",
                        "glosses": [
                            "The act of installing material to dampen sound."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c7df3e08-3412-448b-8517-72dacf2caf71",
                                "sense_id": "2aa759a8-2b8c-3145-bb63-37c93a96472a",
                                "text": "The soundproofing will take place today."
                            }
                        ]
                    }
                ],
                "translations": [
