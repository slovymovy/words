                                                "sense_id": "49aa84a4-5584-34b5-b63c-076b77dd0d32",
                                                "text": "\"...miracolo! Bellissimo!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d4d015b-608a-3a75-84d9-c948b4e9388d",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "espressione sarcastica"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "702ce7d2-15ed-41b8-b44a-63ceb2076ffd",
                                                "sense_id": "8d4d015b-608a-3a75-84d9-c948b4e9388d",
                                                "text": "\"Miracolo!! Ha ammesso di aver sbagliato!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cfb06a-f5f2-3ee2-ad99-82cf00cc7064",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "espressione con tono confidenziale e scherzoso"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed3d6eb-d004-4ae6-8542-d97c5e694bf4",
                                                "sense_id": "65cfb06a-f5f2-3ee2-ad99-82cf00cc7064",
                                                "text": "\"Miracolo, hai capito...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75395219-9f66-31f3-ae53-90a3e8712385",
                                        "entry_id": "f023237a-506c-3e81-9524-1abbab451c71",
                                        "glosses": [
                                            "riferimento a qualcosa di innovativo e/o spesso con capovolgimenti positivi quasi “rivoluzionari” o comunque sorprendenti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e136d862-259d-45a0-be47-a14302f16072",
                                                "sense_id": "75395219-9f66-31f3-ae53-90a3e8712385",
                                                "text": "internet è stato proprio un miracolo della modernità"
                                            },
                                            {
                                                "example_id": "b988b3c4-13f5-4619-a962-e77642dec9e9",
                                                "sense_id": "75395219-9f66-31f3-ae53-90a3e8712385",
                                                "text": "L’anziano, ancora lucido e forte, disse con tono serio e deciso: “Caro Dottore… Questa cura farmacologica è un vero e proprio miracolo! Ah, sì!”"
                                            }
                                        ]
                                    }
