                    {
                        "sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "glosses": [
                            "rodzaj greckiego żywicznego wina produkowanego na terenie Attyki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30413fb5-ae6f-4c9b-8773-a7da44c32f8f",
                                "sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                                "text": "Do obiadu podano nam szklaneczkę retsiny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cd3fb789-592c-3a94-965d-d4a965111779",
                        "entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "glosses": [
                            "butelka lub szklanka retsiny (1.1)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "627008b3-a5f3-4d6d-bf84-7ae660b33a48",
                                "sense_id": "cd3fb789-592c-3a94-965d-d4a965111779",
                                "text": "Z urlopu w Grecji przywiozłem dwie retsiny."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60e058e6-0a50-41ed-8bb1-7ffd46ce05e0",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "retsina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retsina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a1a5d82-c976-314c-b273-90aeab36a30f",
                                        "entry_id": "aa7f092d-f69f-35fe-af5d-9d053b3bc66a",
                                        "glosses": [
                                            "A Greek resinated white or rosé wine of a sort that has been produced for at least 2700 years."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a654ea6-41ba-49ad-acbd-f91aa54dc6a7",
                                                "sense_id": "9a1a5d82-c976-314c-b273-90aeab36a30f",
                                                "text": "She serves the smooth retsina / She keeps me safe and warm / It's just the calm before the storm"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f94858-5680-400e-b42f-b22a956cb7c8",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "retsina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "58a87d13-7017-427b-a494-79586f34204a",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "retsina",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retsina",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7b3e0e-a505-3fdc-97e3-0656ec257538",
                                        "entry_id": "253e5162-dc04-3748-9c75-01113a5b124e",
                                        "glosses": [
                                            "Vin blanc ou rosé d'origine grecque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284dd95e-12ea-4cbf-8e85-9547cbedb654",
                                                "sense_id": "6b7b3e0e-a505-3fdc-97e3-0656ec257538",
                                                "text": "— Parfait, conclut la Mastodonte, vous étiez donc chez le Chinois et vous buviez du retsina.\n— Non, de l'ouzo. Leur retsina n'est pas bon. Il est trouble, il sent mauvais."
                                            },
                                            {
                                                "example_id": "f0ec60b2-6d6e-4fc1-b0f7-757b3e74173c",
                                                "sense_id": "6b7b3e0e-a505-3fdc-97e3-0656ec257538",
                                                "text": "Patras, reconstruite après un tremblement de terre au début du siècle, est sans grand intérêt. Mais on y mange bien, la retsina et le café grec plein de marc sont succulents, et tout est si bon marché que non seulement on peut boire et manger à volonté, mais aussi dormir dans de vrais hôtels, sans heure de lever, sans contrainte de dortoir, sans règlement aucun, la liberté, quoi."
                                            },
                                            {
                                                "example_id": "3638b66c-6835-42f9-9606-26a07ccde8a1",
                                                "sense_id": "6b7b3e0e-a505-3fdc-97e3-0656ec257538",
                                                "text": "– Mademoiselle Frangopoulou, allez-y doucement sur le retsina. Je n’ai pas envie que vous me refassiez le coup de l’évanouissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19539b3b-193b-4c50-94b5-7fc0bfcd69cb",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "retsina",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e19fd2e4-5431-468e-b658-edce28099fc6",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "retsina",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retsina",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e180976c-8c76-32fe-b127-a7e278ceca7b",
                                        "entry_id": "7b76a4da-8e92-362e-9251-57fe542565e1",
                                        "glosses": [
                                            "Griekse wijn; witte harswijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e8f883-f41d-4466-bd1c-65cf7fa9baab",
                                                "sense_id": "e180976c-8c76-32fe-b127-a7e278ceca7b",
                                                "text": "Nu Nederland zich weer langzaam begint op te maken voor het aanheffen van O denneboom, is de associatie met de bekendste – of beter gezegd beruchtste – Griekse wijn ook snel gelegd: retsina. Decennialang stond deze met hars van de Aleppo-den gemixte wijn synoniem voor Grieks wit."
                                            },
                                            {
                                                "example_id": "4f6221fa-b779-42de-90b0-3f1c3c730262",
                                                "sense_id": "e180976c-8c76-32fe-b127-a7e278ceca7b",
                                                "text": "Alom geliefd en bekend: de Griekse dranken en gerechten, dikwijls met een beschermde naam. Enkele voorbeelden: Ouzo, Metaxa, Retsina, feta, yoghurt en mezes."
                                            },
                                            {
                                                "example_id": "63b618f9-516d-4671-b2e8-b924ddc835c2",
                                                "sense_id": "e180976c-8c76-32fe-b127-a7e278ceca7b",
                                                "text": "Jammer, want Griekenland is in de mode en er is veel moois te zien. Dat ontdekte ik afgelopen weken toen ik er privé op vakantie was. Voor het eerst hadden we een retourtje naar het land van Plato, Zeus, de Acropolis, souvlaki en retsina geboekt en trokken we al hoppend langs de eilanden. Modewise is er namelijk veel te beleven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d258424a-bf81-4a15-85aa-247fd333a353",
                        "source_entry_id": "06d94ec2-c1c0-39a4-899d-043e3bd83c29",
                        "source_sense_id": "8ca390bc-7fe9-3c2a-80ac-f31002b75079",
                        "target_lang_word": "Retsina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Retsina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a25099a-ac05-323d-bc13-a52cbefb7bcb",
                                        "entry_id": "77feccbf-955d-332e-a4d2-342b11a26ba8",
                                        "glosses": [
                                            "trockener, weißer Tafelwein aus Griechenland, der mit Harz versetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bd9a11-55c5-43a5-abac-357e8999805e",
                                                "sense_id": "7a25099a-ac05-323d-bc13-a52cbefb7bcb",
                                                "text": "„Die Hauptrebsorte des Retsinas ist Savatiano, oft verschnitten mit Assyrtiko oder Rhoditis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
