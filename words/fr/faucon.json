                },
                {
                    "sense_id": "fea2c7b3-d77b-3e27-a208-53814b1ef950",
                    "sense_definition": "Figure héraldique représentant ce rapace de profil sur un écu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier portait un blason orné d'un <w>faucon</w> d'argent aux ailes déployées."
                        },
                        {
                            "text": "On distingue un <w>faucon</w> sur le sceau officiel de cette ancienne lignée."
                        }
                    ]
                }
