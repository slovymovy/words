                "senses": [
                    {
                        "sense_id": "dc78f53f-0a46-34c8-93bd-e396798d873c",
                        "entry_id": "aa5e0003-7c4a-3efb-8317-89cacb8eb164",
                        "glosses": [
                            "Relatif aux Xiongnus, peuples nomades vivant en Mongolie, en Transbaïkalie et en Chine du Nord du IIIᵉ au IIᵉ av. J.-C."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda4d850-c3c1-4b36-a20a-e31d6a2d4673",
                                "sense_id": "dc78f53f-0a46-34c8-93bd-e396798d873c",
                                "text": "La civilisation xiongnue apparaît en Asie centrale au cours du IIIᵉ siècle avant notre ère."
                            },
                            {
                                "example_id": "ce19bb00-eece-4547-a5c2-cfe557f92bae",
                                "sense_id": "dc78f53f-0a46-34c8-93bd-e396798d873c",
                                "text": "IIᵉ siècle av. J.-C. > Premiers écrits mentionnant des tribus mongoles : les Xiongnu. Invasion xiongnue repoussée par la Chine."
                            },
                            {
                                "example_id": "34a4cfbb-99c8-46d5-b001-20e4b741876f",
                                "sense_id": "dc78f53f-0a46-34c8-93bd-e396798d873c",
                                "text": "Shi Le, de la tribu des Jie (une des cinq tribus xiongnues), est un général du Han Zhao et contrôle son propre territoire du Zhao antérieur conquis durant la révolte des Wu Hu."
                            },
                            {
                                "example_id": "f6fcf350-3128-4067-9fe6-dd5b6e99c50e",
                                "sense_id": "dc78f53f-0a46-34c8-93bd-e396798d873c",
                                "text": "L’existence de grands cimetières xiongnu est témoin de l’emploi de lieux fixes dans la culture xiongnu sans être aucunement le produit de l’influence chinoise."
                            }
                        ]
                    }
                ],
