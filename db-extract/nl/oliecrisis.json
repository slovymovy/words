                        "translation_id": "2a53b6b8-9373-48cd-9b1c-1c8ef54c12c9",
                        "source_entry_id": "19f077a8-8411-3cf6-8480-c376ca33aca6",
                        "source_sense_id": "1330e1a7-23ac-3798-ad53-ba3d1f8fff3c",
                        "target_lang_word": "Ölkrise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ölkrise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                        "entry_id": "69dc3d4b-7cb9-3d60-895a-cbb9eb58a226",
                                        "glosses": [
                                            "zugespitzte politische und wirtschaftliche Problemsituation durch weniger zur Verfügung stehendes Erdöl oder Rohöl, ausgelöst durch anhaltenden Preisanstieg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e56c44-2a66-4036-b8e8-86d1887449c7",
                                                "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                                "text": "„Die Ölkrise heute ist anders.“"
                                            },
                                            {
                                                "example_id": "3bc5fe76-fad0-487d-b6fd-67387ecb6714",
                                                "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                                "text": "„Und auf den Yom-Kippur-Krieg folgt im Winter 1973/74 in der Bundesrepublik die erste Ölkrise mit autofreien Sonntagen und Tempo 100 auf allen Autobahnen.“"
                                            },
                                            {
                                                "example_id": "89b9966f-ae53-43d8-8b2b-66c1c2247dee",
                                                "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                                "text": "„Die Opec-Länder haben aus vergangenen Ölkrisen gelernt. Sie steigern ihre Ölförderung - und halten den Westen so weiter am Tropf.“"
                                            },
                                            {
                                                "example_id": "d8d774e6-caa6-4d1a-a8fa-3469c78860ac",
                                                "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                                "text": "„Von den Auswirkungen dieser Ölkrise bleibt kein westeuropäisches Land verschont; England und Frankreich aber haben am schwersten daran zu tragen.“"
                                            },
                                            {
                                                "example_id": "253b4c38-7988-4021-90b0-0a093be6b24e",
                                                "sense_id": "4b7e9dfc-bba5-3885-93e7-b505424c1b09",
                                                "text": "„Wegen der Ölkrise durften sonntags keine Autos fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
