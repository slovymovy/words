                    {
                        "sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                        "entry_id": "09de3c31-4847-32c5-b549-93169ec6016e",
                        "glosses": [
                            "iemand die bekwaam is in het doen van allerlei verschillende klusjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18650805-7795-4ca5-9718-8d3bbc0b7997",
                                "sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                                "text": "Hij is echt een manusje-van-alles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7744cc6b-f989-4e82-b4ab-e46bead5f4f5",
                        "source_entry_id": "09de3c31-4847-32c5-b549-93169ec6016e",
                        "source_sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                        "source_sense_description": "iemand die bekwaam is in het doen van allerlei verschillende klusjes",
                        "target_lang_word": "handyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                        "entry_id": "823af978-d327-38a9-ae09-a19e873edac5",
                                        "glosses": [
                                            "A person who does small tasks and odd jobs, especially building repairs and the like."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a74268b-384d-465b-a9ca-da0d5165ccf8",
                                                "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                                "text": "I complained that the heat was not working, and the landlord sent the handyman to fix it."
                                            },
                                            {
                                                "example_id": "62bb315a-0852-4fe8-a61f-b4c79827a8f5",
                                                "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                                "text": "There was one thing she wanted; she said to hubby dear, / \"The time would pass more quickly if I had a rocking chair.\" / [...] As Strings is such a handyman, by night the job was done / He took that thing upstairs and said, \"Now try this out for fun.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "handyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                        "entry_id": "f79d5fe6-8e62-39c1-9b62-154543a62267",
                                        "glosses": [
                                            "To work as a handyman; to do odd jobs."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62bd5c7a-341f-4af6-9177-781f77f47b79",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "Instead I walk, uncertainly across the concrete backyard my father and his friends handymanned into existence so proudly, so that none of us would ever have to play in dirt, in muck, in mud again."
                                            },
                                            {
                                                "example_id": "e93b38c7-7273-4d37-9448-0b4a9c3ce33d",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "My daddy worked too hard at Buck's Sporting Goods by day plus handymanning in the evenings, and my mother spent too many hours fixing trays at the meat-and-three for me to act like we had neither pot nor window. Let the record show that we had both."
                                            },
                                            {
                                                "example_id": "cbb43741-319c-474d-9a7d-0bf3b447b634",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "They handymanned all week. And every night Grandad would come in with rosy cheeks and a huge appetite and compliment my mom on what a great cook she was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1357ed3f-3d5e-47d8-9506-9868fbba490d",
                        "source_entry_id": "09de3c31-4847-32c5-b549-93169ec6016e",
                        "source_sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                        "source_sense_description": "iemand die bekwaam is in het doen van allerlei verschillende klusjes",
                        "target_lang_word": "jack-of-all-trades",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jack-of-all-trades",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643739b0-fbd5-38b3-bf04-cd2ecf387e14",
                                        "entry_id": "7931cc1a-1ac0-38c5-8463-a8553bc1f80a",
                                        "glosses": [
                                            "Alternative form of jack of all trades."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816bbdcb-caad-4a88-83c7-39ff94644fd2",
                                                "sense_id": "643739b0-fbd5-38b3-bf04-cd2ecf387e14",
                                                "text": "A fellow can always get some sort of a job—I was coming up here to see if they needed an extra clerk or a waiter, or chauffeur, or anything that meant a roof and something to eat—but I suppose they don't need a jack-of-all-trades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c969285b-ec10-472c-9f38-8ab45a47fec1",
                        "source_entry_id": "09de3c31-4847-32c5-b549-93169ec6016e",
                        "source_sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                        "source_sense_description": "iemand die bekwaam is in het doen van allerlei verschillende klusjes",
                        "target_lang_word": "homme à tout faire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme à tout faire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ebcd84a-d014-3bd5-b6dc-8a6adabc2f59",
                                        "entry_id": "3857f7a4-3bbd-311a-872b-6601892f0649",
                                        "glosses": [
                                            "Homme employé aux menus travaux, sans spécialité particulière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0292516f-b8f2-451a-aec6-270aeeb6035d",
                        "source_entry_id": "09de3c31-4847-32c5-b549-93169ec6016e",
                        "source_sense_id": "c488153d-41c3-3768-91eb-d5ed2ed0803c",
                        "source_sense_description": "iemand die bekwaam is in het doen van allerlei verschillende klusjes",
                        "target_lang_word": "factotum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "factotum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79352bd0-d48c-3930-b133-822cb78a76ba",
                                        "entry_id": "41e304a2-c3a6-31fc-9609-c8adf5e2a74c",
                                        "glosses": [
                                            "Personne qui s’occupe de tout dans une maison où elle est employée."
                                        ],
                                        "tags": [
                                            "Latinisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c52c901f-edf8-41fc-8c66-6f572a9b6458",
                                                "sense_id": "79352bd0-d48c-3930-b133-822cb78a76ba",
                                                "text": "Sans rien dire, je découvris ma boîte de biscuit, et je constatai la disparition de plusieurs galettes... Mon factotum n'avait pu résister à la tentation et m'en avait volé cinq ou six."
                                            },
                                            {
                                                "example_id": "7896be2a-c41a-4376-a044-b547c7d2b23d",
                                                "sense_id": "79352bd0-d48c-3930-b133-822cb78a76ba",
                                                "text": "Zéphirine avait amené son factotum à faire l’homme de petite santé : elle le ouatait, l’embéguinait, le médicinait ; elle l’empâtait de mets choisis comme un bichon de marquise ; elle lui ordonnait ou lui défendait tel ou tel aliment ; elle lui brodait des gilets, des bouts de cravates et des mouchoirs ; elle avait fini par l’habituer à porter de si jolies choses qu’elle le métamorphosait en une sorte d’idole japonaise."
                                            },
                                            {
                                                "example_id": "ab0ce02a-4147-41e4-807c-1572af80ab8c",
                                                "sense_id": "79352bd0-d48c-3930-b133-822cb78a76ba",
                                                "text": "Ils virent des notaires de vieille souche, des grossistes dont les camions sillonnaient le quart de la France, des industriels prospères, des gentlemen-farmers qu’escortaient en tout temps une meute de grands chiens roux et de factotums aux aguets."
                                            },
                                            {
                                                "example_id": "f4b3642b-9e81-4810-88cc-c32c91c24c85",
                                                "sense_id": "79352bd0-d48c-3930-b133-822cb78a76ba",
                                                "text": "Il avait recouvré l’usage d’une main. Il s’en servait pour écrire à sa fille des protestations indignées sur de petits billets que monsieur Milch, le factotum, passait sous la porte de madame depuis sept heures du matin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "factotum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47b9625f-f9f6-319c-9866-581cd1ce1a06",
                                        "entry_id": "fb8de401-12e5-33d6-afd9-d1bb7725266c",
                                        "glosses": [
                                            "Qui s’occupe de tout, qui règle tous les problèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce8dea5-00a1-4a38-9b25-f9d6ce20b807",
                                                "sense_id": "47b9625f-f9f6-319c-9866-581cd1ce1a06",
                                                "text": "Un chic fou, ces étymologies bidons — bidons, vraiment : quand on connaît l’effroyable polysémie de la préposition meta et les neutralités factotum du verbe phero […]."
                                            },
                                            {
                                                "example_id": "edf78886-4676-45b6-948a-e01a2794f664",
                                                "sense_id": "47b9625f-f9f6-319c-9866-581cd1ce1a06",
                                                "text": "Tu auras une lettre de recommandation pour un évêque factotum du cardinal archevêque de Naples"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
