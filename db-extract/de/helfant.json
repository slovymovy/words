                            {
                                "example_id": "1514ef9b-abe7-4850-a71e-640e28649d79",
                                "sense_id": "01dabeb7-7016-3945-93a6-c5c6f80ae9d5",
                                "text": "„Sprach Gott zuᵒ ym. Für hyehär den Helfant, vnd wend sein hynder teyl dahyn.“"
                            },
                            {
                                "example_id": "ac68f33c-e845-48e6-ab3a-a7cdd24606a9",
                                "sense_id": "01dabeb7-7016-3945-93a6-c5c6f80ae9d5",
                                "text": "„Ein Helfant ist vnder allen Thiern das gröst, das verstendigst, vnd sterckest, vnd ein gehorsam Thier, Wann er schläfft, leint er sich an ein Baum, da wirt er von den Jägern gestellt vnd gefangen, Er hat ein starcken Zan, der ist von natur weiß vnd poliert, den braucht er wie ein hand, Diser Zan wirt Helfenbein genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
