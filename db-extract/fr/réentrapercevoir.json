                        "glosses": [
                            "Apercevoir de manière fugitive quelque chose qu’on avait déjà vu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1e8285-6843-4807-bfe7-97203d4ea6e0",
                                "sense_id": "f8517b45-23c8-34ec-93e5-725bfc8fec7a",
                                "text": "Les nuages étaient tellement denses que, le temps de réentrapercevoir un morceau de ciel, il avait disparu."
                            },
                            {
                                "example_id": "514afdf4-7094-4b39-85a9-42bc79b375e8",
                                "sense_id": "f8517b45-23c8-34ec-93e5-725bfc8fec7a",
                                "text": "Au fur et à mesure que nous poursuivions notre route, noue réentrapercevions de plus en plus le refuge où nous nous rendions."
                            }
                        ]
                    }
