                        "sense_id": "0338303f-4f90-362d-973c-6edaaabb6c6c",
                        "entry_id": "635a053b-4386-390a-95a8-887975db67f7",
                        "glosses": [
                            "To deform in such a manner that part of the rod or bolt is displaced sideways, offset from the longitudinal axis of the part, but remains parallel with the part's main longitudinal axis, with the final shape somewhat resembling a crankshaft."
                        ],
                        "tags": [
                            "of a straight bolt or rod"
                        ],
                        "examples": [
                            {
                                "example_id": "177b4787-7f60-4e14-a2a8-d36181f41baa",
                                "sense_id": "0338303f-4f90-362d-973c-6edaaabb6c6c",
                                "text": "The attachment of the inboard end of the gear beam was damaged but remained intact; the drag strut fuse pin had 'crankshafted' in a direction indicating that a load had been applied in tension but this had also remained intact."
                            }
                        ]
