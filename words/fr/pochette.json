                        "pochette de soie"
                    ]
                },
                {
                    "sense_id": "10c8b71a-3834-3515-92f9-de52e45ce18f",
                    "sense_definition": "Petite poche appliquée sur un vêtement ou cousue à l'intérieur d'un bagage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant gardait les mains bien au chaud dans les <w>pochettes</w> de son tablier."
                        },
                        {
                            "text": "Ce sac à dos dispose d'une <w>pochette</w> secrète très pratique pour voyager."
