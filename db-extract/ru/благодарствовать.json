                                "target_senses": [
                                    {
                                        "sense_id": "7192f0d0-67cb-3a7a-b53b-59f26018bcf8",
                                        "entry_id": "643e80f0-81c4-3745-974c-08c40236114a",
                                        "glosses": [
                                            "Used as an expression of gratitude: thanks; many thanks."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6c0ca5-cd54-4fec-9f84-0c118b1b8d73",
                                                "sense_id": "7192f0d0-67cb-3a7a-b53b-59f26018bcf8",
                                                "text": "Gramércy, liegé King, / This is to me a comforting: / I tell you sickerly / For to have land or lede / Or other riches, so God me speed, / It is too much for me."
                                            },
                                            {
                                                "example_id": "cbac16a1-a761-41b8-a2ae-32e3e9c72464",
                                                "sense_id": "7192f0d0-67cb-3a7a-b53b-59f26018bcf8",
                                                "text": "\"Gramercy! good fellow,\" cried Prince John, \"thou pleasest me—Here, Isaac, lend me a handful of byzants.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebca328e-82c7-3654-becf-d383eb3ea9a9",
                                        "entry_id": "643e80f0-81c4-3745-974c-08c40236114a",
                                        "glosses": [
                                            "Used as an exclamation expressing surprise or sudden strong feelings."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
