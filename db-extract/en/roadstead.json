                        "target_lang_word": "Reede",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reede",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                        "entry_id": "267b90d6-6448-3bbe-8969-0b7694fb0f8a",
                                        "glosses": [
                                            "Ankerplatz vor dem Hafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676f5ad3-cfce-42c4-a200-4293277cd154",
                                                "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                                "text": "Das Schiff liegt schon drei Tage auf Reede."
                                            },
                                            {
                                                "example_id": "79350be4-8d17-4eda-bbb5-9abcaed9bce6",
                                                "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                                "text": "„Das Schiff blieb noch vierzehn Tage auf Reede liegen…“"
                                            },
                                            {
                                                "example_id": "4d8b6d46-10ad-4058-93f2-bda91c412dc0",
                                                "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                                "text": "„Er weist auf die See, dorthin, wo mehrere Dhaus auf Reede liegen.“"
                                            },
                                            {
                                                "example_id": "60b534d2-384d-4b53-8663-acfd6ba2d5e3",
                                                "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                                "text": "„Zunächst fuhren wir in den Hafen von Batavia und klarierten das Schiff ein, dann segelten wir zu einer Reede namens Tegal, um Reis zu laden.“"
                                            },
                                            {
                                                "example_id": "c40d31f4-5e8e-498e-9bb2-a59969f1d297",
                                                "sense_id": "57958653-b24f-3782-a6b7-23f8f26dc050",
                                                "text": "„Das Islandschiff lag draußen auf der Reede und hatte schon einige Segel gehißt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
