                "senses": [
                    {
                        "sense_id": "dbd287f2-bc3c-3ab6-b6ea-653ebdd1c498",
                        "entry_id": "4d902e66-2daf-3b1b-9012-f57b500acd74",
                        "glosses": [
                            "Faire des broum ! broum ! comme un moteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75db0464-103a-4dea-8546-77d16e4d6db9",
                                "sense_id": "dbd287f2-bc3c-3ab6-b6ea-653ebdd1c498",
                                "text": "Sans compter qu'ensuite, je prends un malin plaisir à faire broum-broumer le gromono comme il adore le faire."
                            }
                        ]
                    },
                    {
                        "sense_id": "04451a92-7585-3f9f-a7f2-6dc5b94cae88",
                        "entry_id": "4d902e66-2daf-3b1b-9012-f57b500acd74",
                        "glosses": [
                            "Grommeler des broum ! broum !"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb0da5b-d193-48fe-b160-fb24c44bc395",
                                "sense_id": "04451a92-7585-3f9f-a7f2-6dc5b94cae88",
                                "text": "L’ancien militaire fit tourner sa canne plombée, sortit en broum-broumant, et parut stupéfait de voir Lucien montant dans le bel équipage qui stationnait sur les boulevards."
                            }
                        ]
                    }
