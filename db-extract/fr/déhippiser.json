                "senses": [
                    {
                        "sense_id": "ea60725a-d21c-39be-858a-52c9a37d3cb3",
                        "entry_id": "fc45b8cf-469d-38f3-a202-6662ac47d625",
                        "glosses": [
                            "Enlever son caractère hippie à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce2d20b-2165-4854-92fd-cb7bc7e79284",
                                "sense_id": "ea60725a-d21c-39be-858a-52c9a37d3cb3",
                                "text": "Le head-band (tressé de ses vrais cheveux) accentue encore le look, et la petite chemise blanche elle, déhippise un peu pour donner ce coté bobo chic ..."
                            },
                            {
                                "example_id": "d269a31b-cb59-4ff0-88c2-579aca032d0c",
                                "sense_id": "ea60725a-d21c-39be-858a-52c9a37d3cb3",
                                "text": "Il est instrumental, décomposé et suffisamment germanique pour ressembler à un Krautrock qui aurait passé tout ce temps à se déhippiser – en vain."
                            },
                            {
                                "example_id": "3d798eeb-353b-4a0d-b722-19c4606510e4",
                                "sense_id": "ea60725a-d21c-39be-858a-52c9a37d3cb3",
                                "text": "(...) mais on peut répéter l'opération avec les orcs en les débourinant, avec les edn en les déhippisant, avec les trolls en leur faisant faire une cure de désintox etc."
                            }
                        ]
                    }
