{
    "word_family": [
        "splenetic",
        "splenic",
        "splenectomy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f16e9319-1be7-3735-86f9-f9564c04d2fe",
                    "sense_definition": "An organ in the abdomen that filters blood and helps the immune system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spleen</w> is located in the upper left part of the abdomen.",
                            "target_lang_translations": {
                                "ru": "<w>Селезёнка</w> расположена в верхней левой части брюшной полости."
                            }
                        },
                        {
                            "text": "A severe injury to the abdomen can sometimes cause the <w>spleen</w> to rupture.",
                            "target_lang_translations": {
                                "ru": "Серьёзная травма живота иногда может привести к разрыву <w>селезёнки</w>."
                            }
                        }
                    ],
                    "synonyms": [],
                    "target_lang_definitions": {
                        "ru": "Орган в брюшной полости, который фильтрует кровь и участвует в работе иммунной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "селезёнка",
                                "target_lang_sense_clarification": "анатомический орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40d3145d-ba26-37dd-9f4d-e003d5d693c2",
                    "sense_definition": "A feeling of spite, bad temper, or resentment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He vented his <w>spleen</w> on his colleagues after the meeting.",
                            "target_lang_translations": {
                                "ru": "После собрания он <w>выместил свою злобу</w> на коллегах."
                            }
                        },
                        {
                            "text": "She spoke with such <w>spleen</w> that everyone in the room felt uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Она говорила с такой <w>желчью</w>, что всем в комнате стало не по себе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vent one's spleen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary contexts to describe intense, bitter anger."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство злобы, раздражения или негодования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злость",
                                "target_lang_sense_clarification": "чувство сильного раздражения или гнева"
                            },
                            {
                                "target_lang_word": "желчь",
                                "target_lang_sense_clarification": "переносное значение: язвительность, злобность"
                            },
                            {
                                "target_lang_word": "раздражение",
                                "target_lang_sense_clarification": "состояние недовольства или гнева"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca51acdc-ebce-31e7-a167-f1c5cd1e8b34",
                    "sense_definition": "To cause someone to feel annoyed or irritated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant complaining <w>spleened</w> everyone in the office.",
                            "target_lang_translations": {
                                "ru": "Его постоянные жалобы <w>раздражали</w> всех в офисе."
                            }
                        },
                        {
                            "text": "It <w>spleens</w> me when people interrupt during a serious discussion.",
                            "target_lang_translations": {
                                "ru": "Меня <w>раздражает</w>, когда люди перебивают во время серьёзного обсуждения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство досады или раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать чувство досады"
                            },
                            {
                                "target_lang_word": "досаждать",
                                "target_lang_sense_clarification": "причинять неприятности, раздражать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}