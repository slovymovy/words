                        "entry_id": "6b0fca93-127e-382e-9e67-cce47f0b73e9",
                        "glosses": [
                            "De la nature de la roche appelée granodiorite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1319dd-45c4-43b6-a700-4ed52aad7f09",
                                "sense_id": "b0a76fac-a5a6-3b2e-b275-0c2e2decb216",
                                "text": "Dans cet article, nous étudions le comportement du quartz dans un matériau polyminéral (matériau granodioritique du massif du Néouvielle) soumis à une déformation hétérogène."
                            },
                            {
                                "example_id": "89d4c118-0be4-4653-91bb-87ee85c0e929",
                                "sense_id": "b0a76fac-a5a6-3b2e-b275-0c2e2decb216",
                                "text": "La granodiorite cadomienne située à l’Ouest du Massif d’Ecouves appartient à la partie orientale du massif granodioritique de La Ferté-Macé."
                            },
                            {
                                "example_id": "f48f91da-5720-4ff4-8ead-23296b5ccb91",
                                "sense_id": "b0a76fac-a5a6-3b2e-b275-0c2e2decb216",
                                "text": "La plage de Montjoyeux est constituée d’un orthogneiss granodioritique migmatitique appartenant au complexe de l’Île de Cayenne, recoupé par des filons volcaniques."
                            }
                        ]
                    }
