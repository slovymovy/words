                "senses": [
                    {
                        "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                        "entry_id": "4c0ee5af-6bdd-37a0-bff3-15c5f5688c01",
                        "glosses": [
                            "genau festgelegtes Verfahren zur Zerlegung sprachlicher Ausdrücke in ihre Silben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16509737-f2a4-4acc-a731-a458cba0f475",
                                "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                                "text": "„Genannt sei an dieser Stelle in erster Linie Lehfeldt (1971) selbst, der in Anlehnung an eine der wichtigsten strukturalistischen Silbentheorien (Pulgram 1970) einen Silbentrennungsalgorithmus entworfen hat, der in der Folgezeit mehrfach erweitert und präzisiert worden ist (…).“"
                            },
                            {
                                "example_id": "0730ee37-b572-4276-8fa7-ffae24a449d0",
                                "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                                "text": "„So sind zum Beispiel die Silbentrennungsalgorithmen von CMS und Layoutsoftware oftmals sehr verschieden.“"
                            },
                            {
                                "example_id": "d7a78237-f3ca-4a16-bc73-1dce3fb841a2",
                                "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                                "text": "„Wenn die Wörterbücher das Wort nicht enthalten, wird der Umbruchpunkt anhand der integrierten Silbentrennungsalgorithmen ermittelt.“"
                            },
                            {
                                "example_id": "a3d65aca-c1dd-4e4f-92ab-e465c3a45a33",
                                "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                                "text": "„Zusammengesetzte Wörter sind für den Silbentrennungsalgorithmus nicht ohne Hilfe zu erkennen: Der kapitale »Zwölfender« sieht für den Computer aus wie ein Zwöl-fen-der.“"
                            },
                            {
                                "example_id": "c9a39660-e61c-40bb-9040-2b8186f7c050",
                                "sense_id": "1d03c846-fbef-3388-a644-a1946126857c",
                                "text": "„Statt das Wort auf Rechtschreibfehler hin zu untersuchen, wendet sie einen Silbentrennungsalgorithmus an, um die möglichen Silbentrennungspunkte im Wort zu bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
