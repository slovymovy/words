                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c0ada3-a2bd-4896-9236-d5c60ad2de24",
                                                "sense_id": "4d5a05d0-01b2-368e-90ac-a310e82644e8",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "steps",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "878da21f-c1cf-39f9-8bf7-1223e68ae4c5",
                                        "entry_id": "d9b0fef0-d95c-3bca-9139-550b3031366c",
                                        "glosses": [
                                            "a course followed by a person in walking or as walking"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb0b9d70-032f-4ba7-918f-e4d43956cf59",
                                                "sense_id": "878da21f-c1cf-39f9-8bf7-1223e68ae4c5",
                                                "text": "She followed the steps of the girl beside her"
                                            },
                                            {
                                                "example_id": "aab7f363-ba02-4deb-b412-669042a0719d",
                                                "sense_id": "878da21f-c1cf-39f9-8bf7-1223e68ae4c5",
                                                "text": "Her mother was a writer and Con had always determined to follow in her steps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245c6fe4-8c37-30c5-96bc-51d8f6ff32ba",
                                        "entry_id": "d9b0fef0-d95c-3bca-9139-550b3031366c",
                                        "glosses": [
                                            "a flight of stairs, especially out of doors"
                                        ],
                                        "tags": [
