                    {
                        "sense_id": "63a087d9-946b-3664-a218-957e0751d1a6",
                        "entry_id": "020b8f72-2a28-3a04-8a85-7ae8fe2ab9bb",
                        "glosses": [
                            "Umwandlung bestehender Aktien einer Aktiengesellschaft in eine größere Anzahl von neuen Aktien mit einem geringeren Nennwert je Aktie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b171e775-7484-48a9-b47f-8e939facce65",
                                "sense_id": "63a087d9-946b-3664-a218-957e0751d1a6",
                                "text": "„Berücksichtigt man alle Splits des Microsoft-Papiers, wäre eine Aktie von damals heute über 7000 Dollar wert.“"
                            },
                            {
                                "example_id": "3d24045f-1005-436b-8510-3e7615020881",
                                "sense_id": "63a087d9-946b-3664-a218-957e0751d1a6",
                                "text": "„Um seine Aktie zumindest optisch zu verbilligen und ihre Handelbarkeit zu verbessern, hat sich Ebay nun zu einem Split entschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
