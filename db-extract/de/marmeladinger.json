                        "entry_id": "2e25a3b3-4b94-3834-a74f-c6202a1ac750",
                        "glosses": [
                            "Deutscher, Norddeutscher"
                        ],
                        "tags": [
                            "umgangssprachlich; aus Sicht eines Österreichers",
