                ],
                "senses": [
                    {
                        "sense_id": "8de78a38-3be8-31e8-bdfe-05609210955d",
                        "entry_id": "5ab70951-4f25-31a1-a758-4683c2b08e5d",
                        "glosses": [
                            "Genre de singes platyrhiniens, arboricoles, de l’Amérique équatoriale (forêts des bords de l’Amazone), très grêles et à queue préhensile."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5460f24c-a273-463f-b0d7-1fb1b23fe48b",
                                "sense_id": "8de78a38-3be8-31e8-bdfe-05609210955d",
                                "text": "Ainsi, chez les atèles, ce sont les mâles qui présentent des liens forts et affiliatifs avec d'autres mâles apparentés, tandis que les femelles migrent entre les groupes."
                            }
                        ]
                    },
                    {
                        "sense_id": "78e3bad8-b602-3d45-a912-94a9543c4edb",
                        "entry_id": "5ab70951-4f25-31a1-a758-4683c2b08e5d",
                        "glosses": [
                            "Athénien qui, par honneur, était exempt de l'impôt."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "cf6e7e71-2ad7-45a2-ac9a-f6cbbdb8975f",
                                "sense_id": "78e3bad8-b602-3d45-a912-94a9543c4edb",
                                "text": "Si l'on peut faire fond sur ce chiffre, il semblerait que, dans chacune des dix tribus, on ait levé parmi les atèles, 30 archers, tandis que les trois premières classes fournissaient 600 hoplites et 10 cavaliers par tribu."
                            }
                        ]
                    }
                ],
