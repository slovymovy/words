                {
                    "sense_id": "9cfbf378-478f-3b8d-abce-0a4d428005ad",
                    "sense_definition": "Происходить в течение какого-либо времени.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Урок будет <длиться> сорок пять минут.",
                            "target_lang_translations": {
                                "en": "The lesson will <last> forty-five minutes.",
                                "de": "Der Unterricht wird 45 Minuten <dauern>."
                            }
                        },
                        {
                            "text": "Этот ремонт не может <длиться> вечно.",
                            "target_lang_translations": {
                                "en": "This renovation cannot <last> forever.",
                                "de": "Diese Renovierung kann nicht ewig <dauern>."
                            }
                        },
                        {
                            "text": "Молчание <длилось> несколько минут, пока кто-то не заговорил.",
                            "target_lang_translations": {
                                "en": "The silence <lasted> a few minutes until someone spoke.",
                                "de": "Das Schweigen <dauerte> einige Minuten, bis jemand das Wort ergriff."
                            }
                        }
                    ],
                    "synonyms": [
                        "продолжаться"
                    ],
                    "antonyms": [
                        "заканчиваться",
                        "прекращаться"
                    ],
                    "common_phrases": [
                        "длиться вечно",
                        "долго длиться",
                        "длиться бесконечно",
                        "длиться годами"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue or exist for a particular period of time.",
                        "de": "Über einen bestimmten Zeitraum hinweg stattfinden oder bestehen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "continue for a duration"
                            },
                            {
                                "target_lang_word": "continue",
                                "target_lang_sense_clarification": "persist without stopping"
                            },
                            {
                                "target_lang_word": "go on",
                                "target_lang_sense_clarification": "happen continuously"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dauern",
