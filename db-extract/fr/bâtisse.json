        "fr-extract.jsonl": [
            {
                "entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                "word": "bâtisse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fac2a49-2164-4423-9a39-c84e73531f04",
                        "entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bâtisses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1cf51ccc-1466-3e85-b4fb-4ea8fc366116",
                        "entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                        "glosses": [
                            "Action ou manière de bâtir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "216a1fbb-efd7-4fb1-b4cb-3bd3666b7041",
                                "sense_id": "1cf51ccc-1466-3e85-b4fb-4ea8fc366116",
                                "text": "La petite maison simple et sans étages […] est appelée à disparaître également, la fureur de la bâtisse, qui sévit malgré une intense crise économique, ne s'arrêtant pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "476c0ef4-110b-3b40-9695-6333679f54e3",
                        "entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                        "glosses": [
                            "Maçonnerie d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "98e90985-fdc9-3596-94c1-184cd17f3cf3",
                        "entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                        "glosses": [
                            "Construction faite sans art."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "12576245-2a01-4341-9afc-747a31e4460e",
                                "sense_id": "98e90985-fdc9-3596-94c1-184cd17f3cf3",
                                "text": "Nous descendîmes sur la promenade, je marchai devant le vieux château, bâtisse du dixième siècle, entourée de fossés, flanquée de douze tours massives ; […]."
                            },
                            {
                                "example_id": "15cc75b8-8473-4f4d-b21a-707a74a32d39",
                                "sense_id": "98e90985-fdc9-3596-94c1-184cd17f3cf3",
                                "text": "[…] ; çà et là, dans la distance, une bâtisse blanche entourée de figuiers de Barbarie et d’aloës ou un groupe de huttes ou de tentes."
                            },
                            {
                                "example_id": "e3985e9d-1efe-47cd-91e5-19bc2197a24d",
                                "sense_id": "98e90985-fdc9-3596-94c1-184cd17f3cf3",
                                "text": "Comme aux très anciennes bâtisses, l'auvent du toit dévale presque jusqu'au sol, en guise de hangar."
                            },
                            {
                                "example_id": "040a8de9-d03a-41a3-8895-97b1305e6a43",
                                "sense_id": "98e90985-fdc9-3596-94c1-184cd17f3cf3",
                                "text": "À l’instar de sa localisation, une vieille bâtisse fougeraise, la Tivabro est décorée à la mode Bretagne d'antan, avec goût et sans folklore tartignole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "436f21f4-064a-441e-85b4-f63189fe2e08",
                        "source_entry_id": "58141c1a-acc5-3e8f-8387-97e7529e832f",
                        "target_lang_word": "Bau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05c230b9-f525-315a-9f77-584df59ff0d8",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Errichtung eines Hauses oder Bauwerkes"
                                        ],
                                        "tags": [
                                            "Nomen Actionis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc675843-06cf-4a73-8588-d6c5ab70fec4",
                                                "sense_id": "05c230b9-f525-315a-9f77-584df59ff0d8",
                                                "text": "Der Bau eines Hauses ist teuer."
                                            },
                                            {
                                                "example_id": "9d6df174-0780-4bc0-99c1-c98481cc86ab",
                                                "sense_id": "05c230b9-f525-315a-9f77-584df59ff0d8",
                                                "text": "„Das schönste an meinem Bau ist aber seine Stille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30418d64-c361-3bd1-879e-7f152830e4c8",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Tätigkeit des Bauens, Errichtung; Herstellung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99df9027-c353-40ba-bee6-3a1edaf1a949",
                                                "sense_id": "30418d64-c361-3bd1-879e-7f152830e4c8",
                                                "text": "„Ziel war die Entwicklung und der Bau einer einsatzfähigen Atombombe.“"
                                            },
                                            {
                                                "example_id": "81a9c76c-3b87-4f6c-b95d-08bf4639d629",
                                                "sense_id": "30418d64-c361-3bd1-879e-7f152830e4c8",
                                                "text": "„Jeder Bau einer Anlage erfordert Mut zu Entscheidungen, jeder Fortschritt ein kalkuliertes Risiko.“"
                                            },
                                            {
                                                "example_id": "0e8ad3e3-c1c4-4247-baa6-5912757f3cf4",
                                                "sense_id": "30418d64-c361-3bd1-879e-7f152830e4c8",
                                                "text": "[DDR:] „Die Entscheidung der SED zum Bau der Berliner Mauer stand schon längst fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "88c9e256-40eb-3311-8b1d-02c1547ca6fb",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Ort, an dem gerade ein Bauwerk errichtet wird; Baustelle"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f6ba318-0ae5-4097-9389-cf333f725c7f",
                                                "sense_id": "88c9e256-40eb-3311-8b1d-02c1547ca6fb",
                                                "text": "Er arbeitet auf dem Bau."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Haus; Gebäude; Bauwerk"
                                        ],
                                        "tags": [
                                            "Nomen Acti",
                                            "mit Plural 1, Ergebnis des Bauens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24a2d6c-3b15-4bf4-9978-11c463fe4360",
                                                "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                                "text": "Das ist ein schöner Bau."
                                            },
                                            {
                                                "example_id": "53761809-8454-43ed-8e87-bde29c053ede",
                                                "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                                "text": "„Der Bau wurde nie fertig, trotz der soliden Grundmauern.“"
                                            },
                                            {
                                                "example_id": "7ecd89c1-b3bf-40e4-bfc2-8966d12aa13c",
                                                "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                                "text": "„Weiter sagte er, er wolle uns in den nächsten Tagen noch einige prachtvolle neue Bauten des modernen Bauens zeigen.“"
                                            },
                                            {
                                                "example_id": "aec2032f-2cda-4dc6-86ce-9aece3712a4e",
                                                "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                                "text": "„Diese Brücke ist sehr primitiv. Jenseits derselben aber steigt das Herrenhaus auf, ein gelbgetünchter Bau mit hohem Dach und zwei Blitzableitern.“"
                                            },
                                            {
                                                "example_id": "630fd1ce-7d71-4cce-92d1-f06de67c64ee",
                                                "sense_id": "133e2677-4e60-3e8b-b382-654540c1dc73",
                                                "text": "„Sie bauten einen eigenen Tempeltyp, den Umgangstempel, halb keltischer Bau, halb römischer Tempel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9b9c9e0f-3c52-387b-9e9b-abe4dbefa33e",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "in den Boden gegrabener Unterschlupf mancher Tiere, zum Beispiel des Fuchses"
                                        ],
                                        "tags": [
                                            "Tierwelt",
                                            "mit Plural 2, Ergebnis des Bauens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ef8d20f-c997-4e1f-80ae-4ac2ff91cd1c",
                                                "sense_id": "9b9c9e0f-3c52-387b-9e9b-abe4dbefa33e",
                                                "text": "Die Füchse verschwinden in ihren Bauen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0ef03ce3-d793-3497-ab05-c2c5a441e677",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Art und Weise der Konstruktion: Aufbau; Struktur; Gliederung"
                                        ],
                                        "tags": [
                                            "Handwerk",
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d6b6e18-fd17-4d3f-85b2-de76088830a6",
                                                "sense_id": "0ef03ce3-d793-3497-ab05-c2c5a441e677",
                                                "text": "„Diese drei Szenen sind wichtige Stufen im Bau des Dramas, jede ist notwendig für die einheitliche Handlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "35623857-faa5-32ef-b28c-619eb45b0aa2",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Art und Weise der Formung durch die Natur; Aufbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4456bde2-91e9-425c-917d-b2ccd1b093c3",
                                                "sense_id": "35623857-faa5-32ef-b28c-619eb45b0aa2",
                                                "text": "„Der besondere Bau des Ohrs ermöglicht uns, […] Schallwellen aufzunehmen und zu entschlüsseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "ad10fcfc-224d-399c-acd0-a447ceb117a1",
                                        "entry_id": "1db18a31-f196-3b3c-a7f7-504c383c787d",
                                        "glosses": [
                                            "Gebäude, in dem Verbrecher eingesperrt werden; Gefängnis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ae41121-85dd-4026-9bcf-15f9904d07db",
                                                "sense_id": "ad10fcfc-224d-399c-acd0-a447ceb117a1",
                                                "text": "Der Gauner musste für zwei Jahre in den Bau."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b019d87-b9f7-3c72-83af-a9bf55634fc8",
                                        "entry_id": "52353ec5-fcf3-33a8-85bb-f06b330e8461",
                                        "glosses": [
                                            "deutscher Name der dänischen Gemeinde Bov in Nordschleswig (Sønderjylland), in der Nähe von Flensburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f96742-1d79-4da3-a073-d2a1a93bf749",
                                                "sense_id": "4b019d87-b9f7-3c72-83af-a9bf55634fc8",
                                                "text": "„Das Kirchspiel Bau gehörte seit frühen Zeiten zur Wiesharde mit den Zentralorten Großenwiehe und Handewitt und kam mit dieser im Mittelalter zum Amt Flensburg.“"
                                            },
                                            {
                                                "example_id": "7ee9fe6c-d8cb-423f-af23-e43103ec3aec",
                                                "sense_id": "4b019d87-b9f7-3c72-83af-a9bf55634fc8",
                                                "text": "Wohnt Dein Vetter in Bau oder in Westrefeld?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
