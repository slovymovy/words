    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7371014-a209-3370-b668-cebad6420cdb",
                    "sense_definition": "Suffering from an injury or physical harm.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>injured</w> player had to be carried off the field on a stretcher.",
                            "target_lang_translations": {
                                "ru": "<w>Травмированного</w> игрока пришлось уносить с поля на носилках.",
                                "zh": "那名<w>受伤的</w>运动员不得不被担架抬离了赛场。"
                            }
                        },
                        {
                            "text": "She was badly <w>injured</w> in the car accident and needed surgery.",
                            "target_lang_translations": {
                                "ru": "Она серьезно <w>пострадала</w> в автокатастрофе, и ей потребовалась операция.",
                                "zh": "她在车祸中严重<w>受伤</w>，需要进行手术。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hurt",
                        "wounded"
                    ],
                    "antonyms": [
                        "uninjured",
                        "unhurt",
                        "healthy",
                        "whole"
                    ],
                    "common_phrases": [
                        "seriously injured",
                        "badly injured",
                        "critically injured",
                        "injured party",
                        "injured pride"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий от травмы или физического увечья.",
                        "zh": "身体受到伤害或处于受伤状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травмированный",
                                "target_lang_sense_clarification": "получивший физическую травму"
                            },
                            {
                                "target_lang_word": "раненый",
                                "target_lang_sense_clarification": "имеющий рану"
                            },
                            {
                                "target_lang_word": "пострадавший",
                                "target_lang_sense_clarification": "жертва происшествия"
                            }
                        ],
