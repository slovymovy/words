                        "form": "conciliatrice"
                    },
                    {
                        "form_id": "7f243a5f-b679-40f0-bf60-eb8d526900ea",
                        "entry_id": "6dcea5bc-3503-39ae-ac5e-5249dbbaeb38",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "conciliatrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60dc15d8-6bb0-3a5c-b003-b1c9f802cfa0",
                        "entry_id": "6dcea5bc-3503-39ae-ac5e-5249dbbaeb38",
                        "glosses": [
                            "Qui concilie ou qui s’efforce de concilier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2a43f0-6d21-495f-9db2-08d284994859",
                                "sense_id": "60dc15d8-6bb0-3a5c-b003-b1c9f802cfa0",
                                "text": "Lorsque le prieur eut achevé ce qu’il considérait comme un avant-propos conciliateur, son compagnon dit brièvement et avec emphase : […]."
                            },
                            {
                                "example_id": "97b834e3-33b3-430d-85d6-1f9f866b5114",
                                "sense_id": "60dc15d8-6bb0-3a5c-b003-b1c9f802cfa0",
                                "text": "Le résultat de cette proposition conciliatrice fut que les deux jeunes gens […] se prirent par le bras, et, ajustant leurs épées, se dirigèrent vers la porte de l’hôtellerie, sur le seuil de laquelle se tenait l’hôte."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "86f8b19d-54ec-3e6c-9a7d-7b27e761dc81",
                "word": "conciliateur",
