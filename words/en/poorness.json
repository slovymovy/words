{
    "word_family": [
        "poor",
        "poorly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4194efb3-618b-35ee-9a86-37d5929bc2c4",
                    "sense_definition": "The state of having little or no money or material possessions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>poorness</w> of the region made it difficult for families to afford basic healthcare.",
                            "target_lang_translations": {
                                "ru": "<w>Бедность</w> региона затрудняла семьям доступ к базовому медицинскому обслуживанию."
                            }
                        },
                        {
                            "text": "Widespread <w>poorness</w> remains a significant challenge for the developing nation.",
                            "target_lang_translations": {
                                "ru": "Широко распространенная <w>бедность</w> остается серьезной проблемой для развивающейся страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "poverty",
                        "destitution",
                        "penury"
                    ],
                    "antonyms": [
                        "wealth",
                        "affluence"
                    ],
                    "common_phrases": [
                        "widespread poorness",
                        "extreme poorness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нехватки или отсутствия денег или материальных ценностей; бедность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедность",
                                "target_lang_sense_clarification": "общее состояние нехватки материальных средств"
                            },
                            {
                                "target_lang_word": "нищета",
                                "target_lang_sense_clarification": "крайняя степень бедности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc2c9c5-a285-3dd5-8f4c-23834ec2e34a",
                    "sense_definition": "The state of being of low quality or lacking in necessary features.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>poorness</w> of the soil prevented the farmers from growing a successful crop.",
                            "target_lang_translations": {
                                "ru": "<w>Низкое качество</w> почвы помешало фермерам собрать хороший урожай."
                            }
                        },
                        {
                            "text": "Critics noted the <w>poorness</w> of the writing in the author's latest novel.",
                            "target_lang_translations": {
                                "ru": "Критики отметили <w>низкое качество</w> текста в последнем романе автора."
                            }
                        }
                    ],
                    "synonyms": [
                        "inferiority",
                        "mediocrity"
                    ],
                    "antonyms": [
                        "excellence",
                        "quality"
                    ],
                    "common_phrases": [
                        "poorness of quality",
                        "poorness of soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние низкого качества или отсутствие необходимых характеристик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкое качество",
                                "target_lang_sense_clarification": "неудовлетворительные характеристики чего-либо"
                            },
                            {
                                "target_lang_word": "несовершенство",
                                "target_lang_sense_clarification": "наличие недостатков или изъянов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}