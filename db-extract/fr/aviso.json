                "entry_id": "ae2eebe8-2ea3-332b-98c4-1dbed0f33beb",
                "word": "aviso",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8fdc4554-f20a-4960-8220-a9b5fbfc3d91",
                        "entry_id": "ae2eebe8-2ea3-332b-98c4-1dbed0f33beb",
                        "tags": [
                            "plural"
                        ],
                        "form": "avisos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93af73aa-0841-392a-b434-040a1845da89",
                        "entry_id": "ae2eebe8-2ea3-332b-98c4-1dbed0f33beb",
                        "glosses": [
                            "Petit navire de guerre chargé de porter des paquets, des ordres, des avis, etc., et d’observer les mouvements de l’ennemi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d5469c-883d-44d2-bd00-eb8adb1c2b75",
                                "sense_id": "93af73aa-0841-392a-b434-040a1845da89",
                                "text": "Quand je m’éveillai le lendemain, le Valdemar était mouillé dans la baie de Faxa, à quelques encablures de la terre, entre une canonnière danoise et l’aviso français le Dupleix."
                            },
                            {
                                "example_id": "e3eaab87-7792-4df2-976b-019041faf555",
                                "sense_id": "93af73aa-0841-392a-b434-040a1845da89",
                                "text": "Orsenna, aujourd’hui, passait pour ne plus entretenir dans une base ruinée que quelques avisos du caractère le moins agressif, dont l’unique fonction est de faire à la belle saison la police de la pêche sur les bancs d’éponges."
                            },
                            {
                                "example_id": "089eecf7-4b2b-4b28-a91a-72ac2bf450d8",
                                "sense_id": "93af73aa-0841-392a-b434-040a1845da89",
                                "text": "Je lui expliquai ma situation et appris à mon tour que l’aviso se rendait en Angleterre..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b26f028-5945-48cb-b0a4-19b42881c643",
                        "source_entry_id": "ae2eebe8-2ea3-332b-98c4-1dbed0f33beb",
                        "source_sense_id": "93af73aa-0841-392a-b434-040a1845da89",
                        "target_lang_word": "Aviso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aviso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe6c8f4e-f7b3-37d7-af00-d9e609e4e4a5",
                                        "entry_id": "8dcc0cc6-6aa8-34c7-9ac3-c73663c95fbc",
                                        "glosses": [
                                            "kleines, schnelles Kriegsschiff zur Nachrichtenübermittlung"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eeb1e52-48d0-4f07-993e-8e96150e1c26",
                                                "sense_id": "fe6c8f4e-f7b3-37d7-af00-d9e609e4e4a5",
                                                "text": "„Hinter dem Fort kommt der weite Bogen des Port Vauban, ein großer Naturhafen, in dem Fischerboote und die Avisos der italienischen Kriegsmarine dümpelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aviso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fec127a0-c971-3984-932d-436ba7c103ef",
                                        "entry_id": "c0c79a7e-9fcd-3e79-9deb-f613f4af4b5d",
                                        "glosses": [
                                            "meist schriftliche Anzeige oder Ankündigung, insbesondere einer Sendung an den Empfänger"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ee617d-d61b-4b25-86ad-0b4ea6050344",
                                                "sense_id": "fec127a0-c971-3984-932d-436ba7c103ef",
                                                "text": "„Werther Freund! Ihre Empfangsbestätigung über mein Aviso von meiner neuen Wohnung haben wir erhalten und uns damit getröstet, daß Sie wenigstens noch unter den ‚Vegitirenden‘ weilen!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
