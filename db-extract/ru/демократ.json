                "senses": [
                    {
                        "sense_id": "b2652d3b-f1fe-35b0-a69d-3ba591b74d10",
                        "entry_id": "f3d635fa-6c49-3c82-bb68-f299ef624914",
                        "glosses": [
                            "последователь демократической идеологии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73e048a2-65bb-434a-9b84-62824874cbe5",
                                "sense_id": "b2652d3b-f1fe-35b0-a69d-3ba591b74d10",
                                "text": "— Что же вы пешком? Вы бы на машине! — Ничего! крикнул Гун в ответ. — Я на своих на двоих! Я демократ!"
                            }
                        ]
                    },
                    {
                        "sense_id": "efeaa53f-a604-3e12-8aea-6f4c44f7dae9",
                        "entry_id": "f3d635fa-6c49-3c82-bb68-f299ef624914",
