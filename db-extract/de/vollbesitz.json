                "senses": [
                    {
                        "sense_id": "2c064c57-8b3a-33f6-af26-a1cb0db06475",
                        "entry_id": "5a332017-7548-3156-a8b8-8cf5a8f08300",
                        "glosses": [
                            "die ungeteilte Sachherrschaft an einer Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97517e44-5f85-4c96-be60-03f0f36267c2",
                                "sense_id": "2c064c57-8b3a-33f6-af26-a1cb0db06475",
                                "text": "Nach Auszug des Mieters befindet sich die Wohnung wieder im Vollbesitz des Eigentümers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "423da8c7-7d53-374d-959f-73c7d82a2436",
                        "entry_id": "5a332017-7548-3156-a8b8-8cf5a8f08300",
                        "glosses": [
                            "uneingeschränkte Inhaberschaft"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f8641d71-86e9-46d0-916b-52e75d050dad",
                                "sense_id": "423da8c7-7d53-374d-959f-73c7d82a2436",
                                "text": "Nach ihrer Genesung war Agnes augenscheinlich wieder im Vollbesitz ihrer Kräfte."
                            },
                            {
                                "example_id": "cfef8677-397b-4450-893a-ccc8ce63ca3b",
                                "sense_id": "423da8c7-7d53-374d-959f-73c7d82a2436",
                                "text": "„Ich hab's probiert, und wie ihr seht, bin ich im Vollbesitz meiner geistigen und körperlichen Kräfte, wie Arnulf sagen würde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
