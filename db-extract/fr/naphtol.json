                        "glosses": [
                            "Phénol obtenu à partir du naphtalène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17945745-118b-44af-ac5a-7bdd7d4ae9f6",
                                "sense_id": "3e3a1bc6-82c7-3b3a-baa2-edeadbe60ea1",
                                "text": "En partant de la naphtaline, on obtient deux naphtols α et β ayant pour formule C₁₀H₇(OH). Le naphtol β est très employé comme antiseptique."
                            },
                            {
                                "example_id": "73019072-6609-4002-ab8b-40dceab3e485",
                                "sense_id": "3e3a1bc6-82c7-3b3a-baa2-edeadbe60ea1",
                                "text": "Le naphtol ne donne pas cette réaction, bien qu'il soit isomère au thymol."
                            }
                        ]
                    }
