                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w znaczeniu zapłacić"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pay a specific amount of money for something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay",
                                "target_lang_sense_clarification": "to give money in exchange for something"
                            },
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "to spend or pay money for an item"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25240ff2-9ba9-390b-9802-33ebac171e8b",
                    "sense_definition": "ulec komuś, pozwolić się pokonać lub oszukać (używane zwrotnie: dać się)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rywalizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo ogromnej presji rywali drużyna nie <w>dała</w> się pokonać.",
                            "target_lang_translations": {
                                "en": "Despite tremendous pressure from their rivals, the team didn't <w>let themselves</w> be defeated."
                            }
                        },
                        {
                            "text": "Uważaj podczas zakupów przez internet, aby nie <w>dać</w> się oszukać nieznajomym.",
                            "target_lang_translations": {
                                "en": "Be careful when shopping online so you don't <w>get</w> scammed by strangers."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to give in, allow oneself to be beaten, tricked, or overcome (used reflexively: dać się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give in",
                                "target_lang_sense_clarification": "to yield or surrender"
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to succumb or give way"
                            },
                            {
                                "target_lang_word": "let oneself",
                                "target_lang_sense_clarification": "to allow oneself to be defeated or tricked"
                            }
                        ]
