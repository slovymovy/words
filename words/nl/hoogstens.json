    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cfcf1a72-75f8-3937-a8b8-52113c616fce",
                    "sense_definition": "niet meer dan een bepaald aantal of een bepaalde hoeveelheid",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limiet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde <w>hoogstens</w> vijftig euro betalen voor die tweedehands fiets.",
                            "target_lang_translations": {
                                "en": "He wanted to pay <w>at most</w> fifty euros for that second-hand bicycle."
                            }
                        },
                        {
                            "text": "Er waren <w>hoogstens</w> tien mensen aanwezig bij de kleine vergadering.",
                            "target_lang_translations": {
                                "en": "There were <w>at most</w> ten people present at the small meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "hooguit",
                        "op z'n hoogst",
                        "ten hoogste"
                    ],
                    "antonyms": [
                        "minstens",
                        "tenminste"
                    ],
                    "common_phrases": [
                        "hoogstens een uur",
                        "hoogstens een paar"
                    ],
                    "target_lang_definitions": {
                        "en": "not more than a certain number or a certain amount"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at most",
                                "target_lang_sense_clarification": "indicating a maximum limit"
                            },
                            {
                                "target_lang_word": "at the most",
                                "target_lang_sense_clarification": "referring to a maximum quantity"
                            },
                            {
                                "target_lang_word": "not more than",
                                "target_lang_sense_clarification": "specifying an upper bound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67315238-0f4e-3984-b150-d576635a91ff",
                    "sense_definition": "geeft een uiterste, vaak tegenvallende mogelijkheid aan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limiet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winst voor een aannemer kon in zo'n project <w>hoogstens</w> matig worden.",
                            "target_lang_translations": {
                                "en": "The profit for a contractor in such a project could be mediocre <w>at best</w>."
                            }
                        },
                        {
                            "text": "Zijn bijdrage aan het project was <w>hoogstens</w> symbolisch te noemen.",
                            "target_lang_translations": {
                                "en": "His contribution to the project could be called symbolic <w>at most</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hooguit"
                    ],
                    "common_phrases": [
                        "hoogstens matig",
                        "hoogstens redelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates an extreme, often disappointing or minimal possibility"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at best",
                                "target_lang_sense_clarification": "indicating the most optimistic but still limited outcome"
                            },
                            {
                                "target_lang_word": "at most",
                                "target_lang_sense_clarification": "suggesting a limit to a quality or potential"
                            }
                        ]
                    }
                }
            ]
        }
    ]
