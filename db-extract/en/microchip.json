                "senses": [
                    {
                        "sense_id": "3516eb9d-9335-344e-99dc-4648ff179b82",
                        "entry_id": "ac3bd42e-cd89-3af6-a6ff-65ded868fdb8",
                        "glosses": [
                            "To fit (an animal) with a microchip."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5ae9d17b-de98-4f79-a6c9-5a76670d594a",
                                "sense_id": "3516eb9d-9335-344e-99dc-4648ff179b82",
                                "text": "Still, doing something to protect your cat is better than doing nothing, so you should have your cat microchipped in the groin area with a registered ID."
                            },
                            {
                                "example_id": "9cee319f-9dcc-4ef3-bef8-3cd2c06c7a4d",
                                "sense_id": "3516eb9d-9335-344e-99dc-4648ff179b82",
                                "text": "In Britain, where the British BeeKeepers Association (BBKA) has been urging members to microchip their hives for some time, the continuing mystery and the belief that the crimes are inside jobs are taking their toll."
                            },
                            {
                                "example_id": "060f1efa-24d6-4a4b-9daf-0a1ed05e5979",
                                "sense_id": "3516eb9d-9335-344e-99dc-4648ff179b82",
                                "text": "In February, Skip Daly, a Democrat in the Nevada State Assembly, introduced a bill to make involuntary microchip implants illegal; he later amended it to include voluntary microchipping as well."
                            }
                        ]
                    }
