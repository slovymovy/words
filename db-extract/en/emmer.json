                                "target_senses": [
                                    {
                                        "sense_id": "b7519876-f423-3936-9e65-5c9a9bffc43e",
                                        "entry_id": "6661ebc7-39e7-3113-9976-da5ec1c51fbc",
                                        "glosses": [
                                            "Celui qui fabrique ou qui vend de l’amidon ^([1])."
                                        ],
