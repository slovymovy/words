                    {
                        "translation_id": "ec25bdb6-985f-4b9f-a4d8-8772abca969b",
                        "source_entry_id": "82d25e00-66ff-3ba9-bb05-dfc70b728e63",
                        "source_sense_id": "5e2f775e-6c50-3cb2-a56d-b14b54db83ea",
                        "source_sense_description": "obtrusively pushy",
                        "target_lang_word": "wichtigtuerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wichtigtuerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                        "entry_id": "f75a69ed-0d00-344c-95c9-e3cc386ffd3a",
                                        "glosses": [
                                            "Verhalten einer Person, die vermeintlich besonders wichtig ist oder vermeintlich besonders wichtige Dinge macht"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa31d3c8-523d-4c02-832a-f8019e90a262",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Mit seinem wichtigtuerischen Gehabe kann er einem ziemlich auf den Geist gehen.“"
                                            },
                                            {
                                                "example_id": "c3735668-b0ad-4d8a-948a-fbc87fe4895b",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Der Gefängnisdirektor, ein wichtigtuerischer, cholerischer, aber unfähiger Mann macht den Häftlingen das Leben schwer,“ […]."
                                            },
                                            {
                                                "example_id": "85998347-cf36-4600-90d1-54cd5b09460a",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„»Gideon St. Claire. Das ist wohl der wichtigtuerischste, überheblichste Schnösel ...«“"
                                            },
                                            {
                                                "example_id": "fea36ce8-171f-4f47-b56a-884b847fcc38",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„In einem psychologischen Gutachten wurde zudem der Belastungszeuge als wichtigtuerisch, eigenwillig und unglaubwürdig bezeichnet.“"
                                            },
                                            {
                                                "example_id": "9ff5a8cf-b1cf-4bca-8ed6-009c26829c1d",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Man kann das Radio oder Fernsehen anmachen, wann man will, ewig ist da jemand zu hören, zu sehen, der wichtigtuerisch nach seinem Werdegang befragt wird, und noch wichtigtuerischer antwortet er dem Fragenden.“"
                                            },
                                            {
                                                "example_id": "709a1c24-fb15-4c11-be2e-7412b78857b8",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Stattdessen reift etwas anderes: Die Erkenntnis, wie sehr im Fußball wichtigtuerisch herumgeschwätzt wird.“"
                                            },
                                            {
                                                "example_id": "9d5d4ce3-a4f8-422b-a44b-8b2ff050c77e",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "[Plitwitzer Wasserfälle:] »Nichts darf hier verändert werden«, sagt der Reporter wichtigtuerisch, »auch nicht von Filmgesellschaften, die hier mit Vorliebe die Romane von Karl May ins Bild setzen.«"
                                            },
                                            {
                                                "example_id": "b46b9f76-5f8f-4690-8cf3-4484e99736b1",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "[Salzburger Festspiele:] „Es spricht für sich, dass wilde Buh-Gewitter wie in Bayreuth an der Salzach ausgesprochen selten sind.“ […] „Protestrufe gegen Regisseure oder Sänger werden in diesen Kreisen als vulgär oder wichtigtuerisch abgetan.“"
                                            },
                                            {
                                                "example_id": "a2b43d44-4736-4e65-bc6c-c7e29fa80d8a",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Graeber besaß noch etwas von dem Habitus früherer Revolutionäre und Intellektueller, die wichtigtuerische Aufgeblasenheit mancher akademischer Linker war nicht seine Sache, er war da viel bescheidener.“"
                                            },
                                            {
                                                "example_id": "91e5d696-4dd2-4043-92b4-1bdbe137a6e7",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Vielleicht gibt es Zuhörer, die das Geschilderte als übertrieben, überspitzt, wichtigtuerisch empfinden. Mag sein.“"
                                            },
                                            {
                                                "example_id": "3a4d00a0-37de-45e5-bf31-5ca931c2446b",
                                                "sense_id": "d4958c6b-5400-3a4f-a8df-a4054ea8269b",
                                                "text": "„Ein Kommentar zum Volksentscheid? »Dazu sage ich nichts«, so eine Deutsche, die seit mehreren Jahren in der Schweiz arbeitet. Sonst entspreche sie nur dem Bild, das viele Eidgenossen von ihren Landsleuten hätten: vorlaut und wichtigtuerisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09835d0c-30bc-4cc4-95b9-790395e55ec9",
                        "source_entry_id": "82d25e00-66ff-3ba9-bb05-dfc70b728e63",
