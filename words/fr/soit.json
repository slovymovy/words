                    "sense_definition": "Troisième personne du singulier du présent du subjonctif du verbe <w>être</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut que chacun <w>soit</w> attentif pendant la présentation."
