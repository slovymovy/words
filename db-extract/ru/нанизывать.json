                ],
                "translations": [
                    {
                        "translation_id": "19e041af-59be-4732-80c3-f6471fc9c989",
                        "source_entry_id": "43897af8-90e4-3f98-be72-00b0d97998d0",
                        "target_lang_word": "enfiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6d28ee6-1930-3468-a5dc-031ee0b14656",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Traverser d’un fil par une ouverture pratiquée à cet effet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804599df-5efc-4168-9973-b29fda96fd74",
                                                "sense_id": "e6d28ee6-1930-3468-a5dc-031ee0b14656",
                                                "text": "Enfiler une aiguille, un chapelet, un bracelet."
                                            },
                                            {
                                                "example_id": "625f1de6-a1d9-4e61-bfe7-ef9fa78f46c2",
                                                "sense_id": "e6d28ee6-1930-3468-a5dc-031ee0b14656",
                                                "text": "Il avait besoin de vivre dans le sillage d’une femme, fallût-il pour cela enfiler les aiguilles et planter des clous dans les murs !"
                                            },
                                            {
                                                "example_id": "17005509-2d6b-491a-b7f2-abbbe0f33147",
                                                "sense_id": "e6d28ee6-1930-3468-a5dc-031ee0b14656",
                                                "text": "M. Carrière souriait un peu de son assurance et comparait l’essai de son savant confrère aux efforts d’une vieille qui cherche à enfiler son aiguille en la tenant bien fixe ente la lampe et ses lunettes. Un moment, le fil passe si près du trou qu’elle s’écrie : « M’y voilà ! » Hélas ! non ; il s’en faut de la largeur d’un atome ; c’est à recommencer."
                                            },
                                            {
                                                "example_id": "d79c1580-7ffb-412d-9d80-492503e191be",
                                                "sense_id": "e6d28ee6-1930-3468-a5dc-031ee0b14656",
                                                "text": "Cela ne s’enfile pas comme des perles : Se dit de certaines choses qui sont plus difficiles à faire qu’il ne paraît."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08b8e5c4-5244-331a-ac6e-778e5c3310dc",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "On dit aussi, au jeu de bague : Enfiler un anneau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "805546b1-4401-3227-bceb-dcbe5ade55fd",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Munir de ses cordes un violon ou un autre instrument à cordes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676caca9-49f7-4134-8a0f-add25c38c04a",
                                                "sense_id": "805546b1-4401-3227-bceb-dcbe5ade55fd",
                                                "text": "Son violoncelle de 1695, construit par Matteo Goffriller, ainsi que son violoncelle de 1865 fait par Giovanni Francesco Pressenda et destiné pour le répertoire moderne, sont donc enfilés avec du boyau."
                                            },
                                            {
                                                "example_id": "f42e45eb-332f-4e63-92b3-67e80e43d486",
                                                "sense_id": "805546b1-4401-3227-bceb-dcbe5ade55fd",
                                                "text": "Les tenues de violon comprennent généralement un jeu de cordes qui sont enfilées sur l’instrument ou incluses dans l’étui à enfiler par l’acheteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0205eb1-76a8-30b2-9cef-92583205c6c0",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Raconter, en continu, des choses sans suite."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10b095fb-3953-403a-8cbe-628ff10cb6a6",
                                                "sense_id": "f0205eb1-76a8-30b2-9cef-92583205c6c0",
                                                "text": "Là-dessus elle avait enfilé une histoire, en prenant pour point de départ les récits de Rosalie …."
                                            },
                                            {
                                                "example_id": "849c2a0b-b9fc-4a98-8089-3315f44d4663",
                                                "sense_id": "f0205eb1-76a8-30b2-9cef-92583205c6c0",
                                                "text": "Au milieu de la catastrophe, Trump pérore tous les jours à la télévision, enfilant mensonges, approximations et bravades autosatisfaites, l’œil rivé sur son propre audimat et sur l’audience qu’il recueille sur les réseaux sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "066dbab0-8f49-3045-a59a-c0eaa832b54f",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "S’engager dans."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811b3a0f-ef42-4577-b368-fe5b668a306d",
                                                "sense_id": "066dbab0-8f49-3045-a59a-c0eaa832b54f",
                                                "text": "Lucie Thirache enfila une petite rue, s’enfonça sous une grande porte."
                                            },
                                            {
                                                "example_id": "12e6ff49-65b0-418d-bb02-ee5a98b7ea5d",
                                                "sense_id": "066dbab0-8f49-3045-a59a-c0eaa832b54f",
                                                "text": "Tout en causant, Alain et lui avaient passé le grand bras de la Seine, traversé la Cité et enfilé le pont Saint-Michel, au bout duquel commence le quartier Latin."
                                            },
                                            {
                                                "example_id": "1ab46cd4-97a4-49c8-a170-cabf6cfbd87f",
                                                "sense_id": "066dbab0-8f49-3045-a59a-c0eaa832b54f",
                                                "text": "Martine courut chercher le landau, et trois heures n’étaient pas sonnées, lorsque les deux chevaux enfilèrent la route de Nice, dévalant la pente qui descendait jusqu’au pont de la Viorne."
                                            },
                                            {
                                                "example_id": "4a373bde-a854-4e93-b228-cc0eed723c60",
                                                "sense_id": "066dbab0-8f49-3045-a59a-c0eaa832b54f",
                                                "text": "La bise enfile l’étendue, houle dans les sapinières à longue et morne plainte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8de48e3-5b70-36c8-b44d-2163515df7cf",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Prendre en enfilade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fe7ceb-81c7-4712-b55f-ee5336c63d69",
                                                "sense_id": "b8de48e3-5b70-36c8-b44d-2163515df7cf",
                                                "text": "Enfiler une tranchée, un bâtiment."
                                            },
                                            {
                                                "example_id": "be68ceb6-b774-4436-b022-62ff15fc4c98",
                                                "sense_id": "b8de48e3-5b70-36c8-b44d-2163515df7cf",
                                                "text": "Être enfilé par l’avant, par l’arrière, de l’avant à l’arrière, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e0070aa-6d60-3aa2-88e8-1ef6cf560a3c",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Percer de la pointe d’une arme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d958e24-c723-43b6-91fa-694d71077d13",
                                                "sense_id": "7e0070aa-6d60-3aa2-88e8-1ef6cf560a3c",
                                                "text": "Mon oncle avait une longue canne, terminée par une brochette de fer, au moyen de laquelle il enfilait les limaces et les escargots, mangeurs de salades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55472c1f-573a-3aa4-9b3b-34980241c7db",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "En parlant du Jeu, engager quelqu’un dans une partie désavantageuse, l’entraîner dans une grosse perte."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3790b835-2770-48c4-adba-1ddd46c23848",
                                                "sense_id": "55472c1f-573a-3aa4-9b3b-34980241c7db",
                                                "text": "Il s’est laissé enfiler et a fait une perte considérable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c99eaa3f-45a0-320f-87e9-6c9e240264a8",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Pénétrer lors de rapports sexuels."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1ccf863-353b-4ca1-aac0-19bd2359cb4e",
                                                "sense_id": "c99eaa3f-45a0-320f-87e9-6c9e240264a8",
                                                "text": "Mme d'Hocquincourt se jette à sa tête, il l’enfile."
                                            },
                                            {
                                                "example_id": "04529ea0-f360-4e82-8475-a507099b40f4",
                                                "sense_id": "c99eaa3f-45a0-320f-87e9-6c9e240264a8",
                                                "text": "À genoux dans la boue, le pantalon sur les chevilles, le vieux enfile le gamin qui arbore une expression satisfaite."
                                            },
                                            {
                                                "example_id": "6007504a-f8bb-412f-b6e6-fb14e21d3d26",
                                                "sense_id": "c99eaa3f-45a0-320f-87e9-6c9e240264a8",
                                                "text": "L’on y pouvait suivre le parcours sulfureux d’un archange diabolique qui, après avoir perverti la mère, le père, le fils, la bonne, pénétrait dans la porcherie et enfilait le verrat, ce dont le ministre de l’Agriculture avait gémi."
                                            },
                                            {
                                                "example_id": "67e626ae-41f8-41a7-acf2-cedb02f058c0",
                                                "sense_id": "c99eaa3f-45a0-320f-87e9-6c9e240264a8",
                                                "text": "Y fait ni une ni deux, y quitte son bénard, s’couche à côté de la bonne femme, lui p’lote les miches, sort sa clarinette, et entreprend d’l’enfiler en levrette à la surprenante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6171db15-0b65-3b75-97ad-e52bc5b11117",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Mettre, passer un membre allongé (ex: des bras, jambes, (doigts de) mains) dans un vêtement (ex: des bas, un pantalon, des gants)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa7a4a7-b213-41e2-b6a7-0492aeda1ade",
                                                "sense_id": "6171db15-0b65-3b75-97ad-e52bc5b11117",
                                                "text": "Lui-même chaussa en un tournemain ses vieux croquenots mal cirés, avachis et trop grands, puis enfila son pantalon qui lui pendait disgracieusement par derrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36dfefc1-48c9-33d6-8b32-900a06bf2580",
                                        "entry_id": "a8bfd1b0-aa29-3ff9-a8df-30cbefa5f18c",
                                        "glosses": [
                                            "Mettre, passer un vêtement rapidement (ex: un manteau, un pardessus, un pull)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e303a3c-9613-43c8-ad45-5b051fe74480",
                                                "sense_id": "36dfefc1-48c9-33d6-8b32-900a06bf2580",
                                                "text": "Préviens ta femme de ton arrivée. Ça me laissera le temps de passer tranquillement mon froc et de ne pas enfiler, dans la précipitation, mon slip à l'envers."
                                            },
                                            {
                                                "example_id": "b0550ed9-569b-41ea-9f5e-3e4b09914b1e",
                                                "sense_id": "36dfefc1-48c9-33d6-8b32-900a06bf2580",
                                                "text": "Très bien, très bien... Je vais vous l'enfiler, votre combinaison."
                                            },
                                            {
                                                "example_id": "d1300b3e-3b99-4617-af0d-fe6aeaf5e281",
                                                "sense_id": "36dfefc1-48c9-33d6-8b32-900a06bf2580",
                                                "text": "Alors que j'atteins Châtelet-sur-Sormonne, il commence à pleuvoir. Je m'arrête immédiatement pour enfiler ma parka et protéger mon sac à dos à l'aide d'une housse de protection."
                                            },
                                            {
                                                "example_id": "bfe44e8c-76a3-4452-b8d8-f2ba1311a2f3",
                                                "sense_id": "36dfefc1-48c9-33d6-8b32-900a06bf2580",
                                                "text": "Je suis vite montée enfiler quelque chose de plus confortable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
