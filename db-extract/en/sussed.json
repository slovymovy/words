    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "61bbe85f-9a31-32e2-8d1c-e3d15d31da79",
                "word": "sussed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "77d9161e-134a-3645-b5ce-71b93a4cb835",
                        "entry_id": "61bbe85f-9a31-32e2-8d1c-e3d15d31da79",
                        "glosses": [
                            "Sorted, organised; figured out, understood."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd6e43d-fef4-4530-a638-c54b9b26ac40",
                                "sense_id": "77d9161e-134a-3645-b5ce-71b93a4cb835",
                                "text": "Chippenham's hardly the romantic capitol of the world m′boy, but I see exactly what you′re saying, though I think you′ve got it more sussed than all us."
                            },
                            {
                                "example_id": "a037e60a-3ac0-4dbc-a9fe-9a6f8916cc6e",
                                "sense_id": "77d9161e-134a-3645-b5ce-71b93a4cb835",
                                "text": "‘You mean you were still on dial-up?’ He laughed. ‘For someone who does what you do, I can′t believe you′re not more sussed.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                        "entry_id": "61bbe85f-9a31-32e2-8d1c-e3d15d31da79",
                        "glosses": [
                            "Well-informed; in the know, savvy."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "41f1f9b3-ba11-4521-a3a1-c07a08a1e3e7",
                                "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                                "text": "“But he didn′t, he just got lucky. When you′re lucky like that, though, people start to look up to you ... They reckon you′re more sussed than others.”"
                            },
                            {
                                "example_id": "2ea2a3f7-94dd-484d-a85a-12fb812e9ff1",
                                "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                                "text": "She certainly seemed a lot more sussed than Martie remembered her."
                            },
                            {
                                "example_id": "a7648111-eba3-4633-a5c3-9b9c8092354f",
                                "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                                "text": "Patric′s one of the most sussed beings in the industry, but the schizophrenia that comes from being unable to reconcile a love of music with a desire to make lots of bucks seems to have affected everyone."
                            },
                            {
                                "example_id": "5dac3e44-d585-4ae0-bbca-dbd2ac732be2",
                                "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                                "text": "[…] for example J-17′s February issue carried an informative quiz, ‘Are you sussed about sex?’"
                            },
                            {
                                "example_id": "f1cb89e3-bdd2-485f-8e87-fd05b6bf32e9",
                                "sense_id": "826eea5b-0255-3470-8921-00835f07bbee",
                                "text": "Their replacement came in the form of Liz Shaw (Caroline John), a rather more sussed female ‘companion’ than most of her predecessors."
                            }
                        ]
                    }
                ],
