                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0115658-a98c-3237-a980-832bbc0b0140",
                        "entry_id": "e8a7c67c-4bf7-37c8-9e51-44b2b473e7ef",
                        "glosses": [
                            "an eine Leiche erinnernd, wie eine Leiche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cca4c72-11dc-41ec-b2b2-de29349de71a",
                                "sense_id": "a0115658-a98c-3237-a980-832bbc0b0140",
                                "text": "„Eine grüne Sonne kroch über den Horizont und badete ihn in ihrem leichenhaften Glanz.“"
                            },
                            {
                                "example_id": "b537bff5-84a4-43a7-b488-ea6f7287f1b6",
                                "sense_id": "a0115658-a98c-3237-a980-832bbc0b0140",
                                "text": "„Sary war in keiner Weise kreativ veranlagt, aber ein dahin gehend begabterer Beobachter hätte den Mann im Gesamten wohl als leichenhaft beschrieben – und mit einem leichten Silberblick (aus blauen Augen), der eine Neigung zu misanthropischen Enthüllungen andeutete.“"
                            },
                            {
                                "example_id": "efac7423-5185-490b-ba22-b1755feb44a6",
                                "sense_id": "a0115658-a98c-3237-a980-832bbc0b0140",
                                "text": "„Die leichenhafte Frau an der Spitze der Schlange schluckte.“"
                            },
                            {
