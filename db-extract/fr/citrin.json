                "senses": [
                    {
                        "sense_id": "9691cc0d-d229-38ee-b489-e28a96b0879d",
                        "entry_id": "adba8263-6fb2-3af3-a184-e2b1b9710f89",
                        "glosses": [
                            "Qui est de couleur de citron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a22972-3a6b-4801-a6e6-9cecc7c6d52e",
                                "sense_id": "9691cc0d-d229-38ee-b489-e28a96b0879d",
                                "text": "SANTAL, s. m. (Botan. exot.) bois des Indes orientales, dont nous connoissons trois especes : le jaune ou le citrin, le blanc, & le rouge. Le santal citrin, santalum citrinum J. B. est un bois pesant, solide, ayant des fibres droites."
                            },
                            {
                                "example_id": "85490294-11a1-4621-8cfd-b4139ebf1fd0",
                                "sense_id": "9691cc0d-d229-38ee-b489-e28a96b0879d",
                                "text": "C’est une substance résineuse, séche, inflammable, transparente, d’un jaune pâle ou citrin, en gouttes semblables au mastic, d’un goût résineux, d’une odeur pénétrante & suave quand on la brule."
                            },
                            {
                                "example_id": "81ddce7b-6a73-47ed-a56c-542ad20f7261",
                                "sense_id": "9691cc0d-d229-38ee-b489-e28a96b0879d",
                                "text": "Le liquide prélevé est citrin clair, transparent."
                            }
                        ]
                    }
                ],
