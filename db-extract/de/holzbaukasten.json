                        "entry_id": "29a6f4a6-7825-3d50-98f3-cfa8d01447b3",
                        "glosses": [
                            "Satz von Bausteinen aus Holz zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30db06e3-67e2-42f5-ae49-ce6b98ba3f03",
                                "sense_id": "a1841954-6b36-394e-9d22-da7ee018fe0c",
                                "text": "„Mit vier verschiedenen Holzbaukästen sollen Kinder ab acht Jahre eine alte Bockwindmühle, ein Wasserrad, einen Wind- sowie einen Radarmotor basteln.“"
                            },
                            {
                                "example_id": "a09ca14b-64eb-406b-93af-13b32472ad07",
                                "sense_id": "a1841954-6b36-394e-9d22-da7ee018fe0c",
                                "text": "„Mit dem Geld wird Kinderheimleiterin Renate Müller zwei große Holzbaukästen anschaffen.“"
                            }
                        ],
