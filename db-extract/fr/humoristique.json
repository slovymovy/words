        "fr-extract.jsonl": [
            {
                "entry_id": "daf26ccd-08ad-3bbd-8df2-49b2ebd46032",
                "word": "humoristique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b8bddc26-5f4e-49f2-ba9d-4a49582ff16f",
                        "entry_id": "daf26ccd-08ad-3bbd-8df2-49b2ebd46032",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "humoristiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57c9de65-c8b0-34c7-96ad-9684b292503b",
                        "entry_id": "daf26ccd-08ad-3bbd-8df2-49b2ebd46032",
                        "glosses": [
                            "Qui a le caractère de l’humour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac90d717-52ba-4289-901b-47c6402d46fe",
                                "sense_id": "57c9de65-c8b0-34c7-96ad-9684b292503b",
                                "text": "Une feuille humoristique de Berlin raconte qu'un étranger, frais débarqué dans cette ville, se plaignait de n'y point trouver de décrotteurs; rien d'étonnant, lui fut-il répondu, ils sont tous kreisdirector (sous-préfets) en Alsace-Lorraine."
                            },
                            {
                                "example_id": "9b493a6d-5304-46a5-94e6-b4fd96699aa6",
                                "sense_id": "57c9de65-c8b0-34c7-96ad-9684b292503b",
                                "text": "Il savait qu’il était en Amérique, une grande et puissante nation, dont les citoyens avaient des manières sèches et humoristiques, se servaient à tout propos de revolvers et de couteaux à virole, […]."
                            },
                            {
                                "example_id": "3a1529f4-8a5e-4143-9b29-7feab61b6d3f",
                                "sense_id": "57c9de65-c8b0-34c7-96ad-9684b292503b",
                                "text": "[…] parce qu'il nous a semblé que ce sketch par son thème et par ses procédés humoristiques permettaient de mettre en relief des éléments liés à une culture particulière d'une part et au fonctionnement universel de l'humour."
                            },
                            {
                                "example_id": "f960027f-a398-42de-b441-29c8aff5782b",
                                "sense_id": "57c9de65-c8b0-34c7-96ad-9684b292503b",
                                "text": "Comme son copain le brocardait quant à sa façon de se vêtir ( « T’es toujours fagoté comme l’as de pique ! » ), le président avait baptisé son club L’As de pique. Sensible au clin d’œil humoristique, Langsamer en avait été le premier adhérent."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b9109a7-2ef7-329d-bf83-9bace39a2016",
                        "entry_id": "daf26ccd-08ad-3bbd-8df2-49b2ebd46032",
                        "glosses": [
                            "Relatif aux humeurs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "00fcbc74-73e0-4dfb-be2d-4edd8ddc13ba",
                                "sense_id": "6b9109a7-2ef7-329d-bf83-9bace39a2016",
                                "text": "C’est une sorte de fièvre qui agite le mécanisme humoristique de l’homme, car cette fièvre n’est ni dans le sang, ni dans le cerveau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5cfdabc-4076-47ac-9316-1a750a79c421",
                        "source_entry_id": "daf26ccd-08ad-3bbd-8df2-49b2ebd46032",
                        "target_lang_word": "humorous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humorous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da27db8d-9ef6-39b8-80ba-27b7d22982b9",
                                        "entry_id": "fa8b81a3-d2c3-36e0-808b-16b993d63331",
                                        "glosses": [
                                            "Full of humor or arousing laughter; funny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23679c7-74f2-4a11-81f3-2dbb577f9205",
                                                "sense_id": "da27db8d-9ef6-39b8-80ba-27b7d22982b9",
                                                "text": "The waiters were so humorous - one even did a backflip for us, when we asked him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc718c8c-b2a3-34cc-bfb4-e5f9852b043e",
                                        "entry_id": "fa8b81a3-d2c3-36e0-808b-16b993d63331",
                                        "glosses": [
                                            "Showing humor; witty, jocular."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3da7d54-1ec0-3cdb-b8ce-cc8889e0b5c6",
                                        "entry_id": "fa8b81a3-d2c3-36e0-808b-16b993d63331",
                                        "glosses": [
                                            "Damp or watery."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecd7bd10-a095-328e-82da-09cda06ac003",
                                        "entry_id": "fa8b81a3-d2c3-36e0-808b-16b993d63331",
                                        "glosses": [
                                            "Dependent on or caused by one's humour or mood; capricious, whimsical."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7030173-0e50-4ab7-9605-394d118b22f1",
                                                "sense_id": "ecd7bd10-a095-328e-82da-09cda06ac003",
                                                "text": "[S]uch is now the Duke's condition\nThat he misconstrues all that you have done.\nThe Duke is humorous; what he is, indeed,\nMore suits you to conceive than I to speak of."
                                            },
                                            {
                                                "example_id": "48a601ec-b994-456a-a9cc-183041926496",
                                                "sense_id": "ecd7bd10-a095-328e-82da-09cda06ac003",
                                                "text": "It is a melancholy humor[…]that firſt put this humorous conceipt [translating resverie] of writing into my head."
                                            },
                                            {
                                                "example_id": "66795bc9-e09b-47d3-b575-2f7024fbc1df",
                                                "sense_id": "ecd7bd10-a095-328e-82da-09cda06ac003",
                                                "text": "I felt at this time as if I could have been fond of him too, if he would have let me; but I was timid from my childhood, and before long my dread of his displeasure […] conquered my humorous inclination to love one who was so handsome, so accomplished, so indulgent and devoted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
