                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf84c9b2-8ca7-398b-911e-bd7e2056413f",
                        "entry_id": "6029606b-728e-3f1a-b22c-e4ef405fd632",
                        "glosses": [
                            "gebrautes Getränk, besonders Bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1caa89e6-03f8-4eed-b276-3773072e7ee1",
                                "sense_id": "bf84c9b2-8ca7-398b-911e-bd7e2056413f",
                                "text": "Regionale Bierbrauer wollen ihr Gebräu unter Heimatschutz stellen."
                            },
                            {
                                "example_id": "528a245a-e3a5-4c66-a012-4803c63e94b4",
                                "sense_id": "bf84c9b2-8ca7-398b-911e-bd7e2056413f",
                                "text": "Anderswo im Amazonas werden DMThaltige Pflanzen, wie Psychotria veridis, dem als Ayahuasca oder Yagé bekannten Gebräu zugesetzt."
                            },
                            {
                                "example_id": "52bc8199-a843-4fa2-931a-dc73f71db7ed",
                                "sense_id": "bf84c9b2-8ca7-398b-911e-bd7e2056413f",
                                "text": "„Die Wirtin von den »Drei Schwänen«, in der Annahme, dieser Gast käme von weit her und müsse sogleich etwas verzehren, schickte ihm ihre Magd mit einem Gebräu und allerlei Speisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54fdb878-496a-3e03-8115-f0ec451841f7",
                        "entry_id": "6029606b-728e-3f1a-b22c-e4ef405fd632",
                        "glosses": [
                            "(minderwertiges, nicht wirklich gelungenes) Getränk"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "ea4eb89e-a060-475e-b6b8-111babafd77b",
                                "sense_id": "54fdb878-496a-3e03-8115-f0ec451841f7",
                                "text": "Dieses Gebräu ist unser erster Versuch, selbst einen Obstwein herzustellen."
                            },
                            {
                                "example_id": "4a8ea0aa-528e-48c3-a64b-eadfdfe4e394",
                                "sense_id": "54fdb878-496a-3e03-8115-f0ec451841f7",
                                "text": "Dieses Gebräu soll Kaffee sein? Das kannst du selber trinken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e3747aec-956a-3564-b731-701704a02865",
                        "entry_id": "6029606b-728e-3f1a-b22c-e4ef405fd632",
                        "glosses": [
                            "eine (üble) Mischung"
                        ],
                        "tags": [
                            "meist abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "e144e09f-8ee6-49af-abe7-373594d22a1d",
                                "sense_id": "e3747aec-956a-3564-b731-701704a02865",
                                "text": "„In Ländern wie Algerien, Tunesien, Libyen und Ägypten vermengen sich Demografie, Gerontokratie und Melancholie zu einem gefährlichen Gebräu.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
