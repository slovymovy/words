                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c9bee3d-eec4-431e-b299-b995f8dd9c57",
                                "sense_id": "06e6c92b-e72e-3f67-858e-0f2715315ad3",
                                "text": "„Im Bereich des Adjektivs wirken komisch besonders die falschen Steigerungsformen.“"
                            },
                            {
                                "example_id": "a14097f6-5365-4f9a-a350-f65b71c19ba1",
                                "sense_id": "06e6c92b-e72e-3f67-858e-0f2715315ad3",
                                "text": "„Steigerungsformen verwendet man, wenn man etwas miteinander vergleichen will.“"
                            },
                            {
                                "example_id": "93f48bf6-94ec-4e98-bc6a-107df5f3a588",
                                "sense_id": "06e6c92b-e72e-3f67-858e-0f2715315ad3",
                                "text": "„Eine Steigerungsform hat das Ägyptische nicht.“"
                            }
                        ],
