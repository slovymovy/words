                    {
                        "sense_id": "abe5f3fe-4140-3071-94ad-ce4cb9c1d7dc",
                        "entry_id": "20effba9-c36b-3d73-bece-93e859260f15",
                        "glosses": [
                            "sposób walki morskiej polegający na zetknięciu się dwóch okrętów i prowadzeniu walki wręcz na ich pokładach w celu zdobycia wrogiego okrętu lub jego późniejszego zatopienia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a44004a7-abf3-4b93-b508-6981bb895f0c",
                                "sense_id": "abe5f3fe-4140-3071-94ad-ce4cb9c1d7dc",
                                "text": "Dla celów abordażu okręty oprócz marynarzy zabierały również żołnierzy piechoty morskiej, którzy wraz z częścią załogi dostawali się na okręt nieprzyjaciela"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5b1063e4-1838-32f0-be9f-75f13791efd7",
                        "entry_id": "20effba9-c36b-3d73-bece-93e859260f15",
                        "glosses": [
                            "odpowiednik abordażu (1.1) w przestrzeni kosmicznej między dwoma statkami kosmicznymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147b7398-d1a6-46a7-ad13-5df2493b63e9",
                                "sense_id": "5b1063e4-1838-32f0-be9f-75f13791efd7",
                                "text": "Z tego względu celowo wybrał bardziej ukradkowe podejście, czyli abordaż kanonierki, zamiast frontalnego ataku za sterami „Wściekłego Psa”"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
