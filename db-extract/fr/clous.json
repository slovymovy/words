                "senses": [
                    {
                        "sense_id": "8d047ceb-21ff-3d09-9ea9-7bf0d516178d",
                        "entry_id": "7e3e3b5d-a73c-3380-94ac-27bae644cccb",
                        "glosses": [
                            "Zone protégée par des clous dans un passage clouté."
                        ],
                        "tags": [
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e7e47de-6170-4483-91b3-acb9415bf0ae",
                                "sense_id": "8d047ceb-21ff-3d09-9ea9-7bf0d516178d",
                                "text": "Blanche revint sur ses pas et traversa dans les clous à une dizaine de mètres devant eux, à l'angle du boulevard et de la place. Ils la rejoignirent et reprirent la mission."
                            },
                            {
                                "example_id": "e3e74461-a9fe-4c34-86c5-8cb9959bdfc9",
                                "sense_id": "8d047ceb-21ff-3d09-9ea9-7bf0d516178d",
                                "text": "Il voulut se remettre à toréer les autos ; il se plaça un peu en avant des clous, de telle sorte que les voitures arrivaient sur lui avec un élan diminué."
                            },
                            {
                                "example_id": "cd0ed5b1-3b5f-4067-b55f-ef45936cbc24",
                                "sense_id": "8d047ceb-21ff-3d09-9ea9-7bf0d516178d",
                                "text": "Sur les clous, il brandit le quotidien en scandant son titre, comme Jean Seberg dans À bout de souffle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
