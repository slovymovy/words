                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a00e5e8-e802-4659-931e-1d9228fc40c6",
                        "source_entry_id": "a3750246-ccaa-315e-9cd9-ab7595568725",
                        "source_sense_id": "3cd61e31-75e0-334f-b416-122622314731",
                        "target_lang_word": "confessor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confessor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "One who confesses faith in Christianity in the face of persecution, but who is not martyred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04760061-451e-48c8-9dd1-2ff1058a999d",
                                                "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                                "text": "Long before Edward I, the English had a King Edward who they considered a martyr and a King Edward who they considered a confessor."
                                            },
                                            {
                                                "example_id": "fbb3db82-4e2e-4906-aa74-4b99423f92f7",
                                                "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                                "text": "Confessors provided the troubled Church with an alternative sort of authority based on their sufferings, particularly when arguments began about how and how much to forgive those Christians who had given way to imperial orders – the so-called ‘lapsed’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b7f1f44-5480-34cb-99c9-687a08de60a8",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "One who confesses to having done something wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a420d761-edc3-4206-b3eb-439df9f710d4",
                                                "sense_id": "0b7f1f44-5480-34cb-99c9-687a08de60a8",
                                                "text": "Near-synonym: confessant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b932fd-043c-3f9c-b665-1cd5d9a00475",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "A priest who hears confession and then gives absolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f50f0c30-67e5-3f18-a2aa-4f99260be7e2",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "Someone who acts as listener and helper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a214c5c-6ec0-4bb0-98aa-353cd4546785",
                                                "sense_id": "f50f0c30-67e5-3f18-a2aa-4f99260be7e2",
                                                "text": "They do not feel connected to any gay/lesbian communities. Nor do they feel able to establish relationships with anyone who can support them. Thus an inexperienced but sincere young heterosexual actor can find himself playing not only role model but also confessor and phantom friend to people in great need."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f2d698e-ecb3-48b6-886d-e6710eb3f53f",
                        "source_entry_id": "a3750246-ccaa-315e-9cd9-ab7595568725",
                        "source_sense_id": "3cd61e31-75e0-334f-b416-122622314731",
                        "target_lang_word": "zpovědník",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zpovědník",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "44483d3b-b72c-300c-93b7-8604787f0f47",
                                        "entry_id": "c84be917-f8b4-3501-a0fb-83a66c9c860a",
                                        "glosses": [
                                            "kněz vedoucí zpověď čili poskytující svátost smíření"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc44abd7-7b08-400a-a077-8e0077655699",
                        "source_entry_id": "a3750246-ccaa-315e-9cd9-ab7595568725",
                        "source_sense_id": "3cd61e31-75e0-334f-b416-122622314731",
                        "target_lang_word": "confesseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c2f0a81-0d63-3814-9991-3f5c252022e2",
                                        "entry_id": "262da5ad-5876-3822-bfbe-3cef8237728f",
                                        "glosses": [
                                            "Celui qui, dans l’Église primitive, avait confessé la foi de Jésus-Christ, jusqu’à souffrir des tourments, mais sans mourir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9faeba13-82bb-40ed-a7d6-d6f5297786fe",
                                                "sense_id": "4c2f0a81-0d63-3814-9991-3f5c252022e2",
                                                "text": "La fête d’un confesseur. - Les confesseurs de la foi."
                                            },
                                            {
                                                "example_id": "6e84c84b-e02f-4285-b271-cc7617d337ae",
                                                "sense_id": "4c2f0a81-0d63-3814-9991-3f5c252022e2",
                                                "text": "« Je veux lire le Nouveau Testament dans l’original, fit-il avec l’énergie d’un confesseur de la foi devant un préfet romain. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e174cab-2bf8-3ec2-a92c-70472f538a88",
                                        "entry_id": "262da5ad-5876-3822-bfbe-3cef8237728f",
                                        "glosses": [
                                            "Prêtre qui entend en confession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d87b77f-b10a-435a-86ab-ddf9ddc7744f",
                                                "sense_id": "6e174cab-2bf8-3ec2-a92c-70472f538a88",
                                                "text": "[…] les pères et mères de famille qui avaient entendu les dernières paroles de Gilles de Retz, jeûnèrent trois jours pour lui mériter la miséricorde divine, qu’on ne doute pas qu’il ait obtenue, son confesseur étant un des plus habiles de l’époque."
                                            },
                                            {
                                                "example_id": "ad27d62c-4315-46f9-9ed6-ccc0056863ca",
                                                "sense_id": "6e174cab-2bf8-3ec2-a92c-70472f538a88",
                                                "text": "Henri IV est le grand-père de Louis XIV, Cotton, le grand-oncle du P. la Chaise : deux royautés, deux dynasties, celle des rois, celle des confesseurs jésuites."
                                            },
                                            {
                                                "example_id": "378c51df-1c6f-4073-894f-a3cef823beeb",
                                                "sense_id": "6e174cab-2bf8-3ec2-a92c-70472f538a88",
                                                "text": "Mais une vieille demoiselle change plus facilement de confesseur qu’elle ne change d’opinion."
                                            },
                                            {
                                                "example_id": "000bd6b5-50aa-4bd7-996c-83fabe8b8ee4",
                                                "sense_id": "6e174cab-2bf8-3ec2-a92c-70472f538a88",
                                                "text": "Les jeux érotiques commencent évidemment dès l'enfance, se poursuivent de plus belle entre adolescents ou jeunes adultes (ainsi le maraîchinage en Vendée) et tout cela tracasse beaucoup les confesseurs. En revanche, les participants s'y livrent « sans rougir »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
