                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8615ef4d-9884-3966-80b3-cf95921c4efb",
                        "entry_id": "fdd250c3-bd96-3b53-892d-baa800eb5ba6",
                        "glosses": [
                            "de neiging om al te veel te willen praten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d580a3c-4713-4342-8a23-35887cb5904a",
                                "sense_id": "8615ef4d-9884-3966-80b3-cf95921c4efb",
                                "text": "Het werk vlotte sneller, maar toch drong er nog een overbodige praatzucht in door."
                            },
                            {
                                "example_id": "d22f42a7-687e-4ea4-972e-d236401fbc8d",
                                "sense_id": "8615ef4d-9884-3966-80b3-cf95921c4efb",
                                "text": "Van de dieren en de lelies valt te leren dat de mens zich niet moet afbeulen op deze aarde, maar blij, eenvoudig, rustig, vertrouwend zijn weg moet gaan. „Alle wereldse zorgen komen eruit voort dat een mens er niet genoeg aan wil hebben mens te zijn, dat hij in het bezorgd vergelijken haakt naar de verschillen.” De heiden heeft immers zorgen voor de dag van morgen, „die onzalige dag, die de uitvinding is van praatzucht en ongehoorzaamheid.”"
                            }
                        ]
                    }
                ],
