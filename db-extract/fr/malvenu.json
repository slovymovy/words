                        "glosses": [
                            "Qui n’est pas développé normalement, en parlant des êtres ou des choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f707fd-7253-4f74-a5fa-459fcf2a0314",
                                "sense_id": "e276a6cd-8d75-3f9a-8f50-dc2dcae92a86",
                                "text": "Un arbre mal venu."
