                        "entry_id": "d2dca1e7-bf1a-30ec-b547-d269fdb651b5",
                        "glosses": [
                            "aktionsreicher, zumeist von spektakulär inszenierten Kampf- und Gewaltszenen beherrschter Film"
                        ],
                        "tags": [
                            "Film"
                        ],
                        "examples": [
                            {
                                "example_id": "1e32b0ba-426b-484c-9172-2564fdffef78",
                                "sense_id": "ca0ba538-7a85-3f2f-a33e-3332ace6dd91",
                                "text": "„Terminator“ ist ein Actionfilm."
                            },
                            {
                                "example_id": "d70362f5-6e81-4f84-a5eb-48cf6e3c110e",
                                "sense_id": "ca0ba538-7a85-3f2f-a33e-3332ace6dd91",
                                "text": "„Die tragende Rolle des Einzelnen wird selbst in Hollywood-Filmen widergespiegelt: In jedem dritten Actionfilm bekommt ein ganz normaler Typ plötzlich den Job aufgebrummt, ganz allein die Stadt, den Staat oder gar die Welt zu retten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
