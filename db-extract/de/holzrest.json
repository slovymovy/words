                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7521808f-36e7-4f6a-a2fc-53fe700ef7b2",
                                "sense_id": "f83b3c18-8205-32c3-9389-70e694a49ba0",
                                "text": "„In der Mitte des Platzes türmte sich eine Pyramide aus alten Möbeln, Holzresten und sogar einer alten, abblätternden Tür.“"
                            },
                            {
                                "example_id": "ec72b7fb-4bda-476c-96c0-40448558bbf8",
                                "sense_id": "f83b3c18-8205-32c3-9389-70e694a49ba0",
                                "text": "„Sie schauten sich um - Russell und Shaw duckten sich hinter einen Haufen aus Holzresten und Gipskartonplatten.“"
                            },
                            {
                                "example_id": "96eb826a-59f2-4ba8-835a-f151945ba501",
                                "sense_id": "f83b3c18-8205-32c3-9389-70e694a49ba0",
                                "text": "„Ich humpelte ein paar Schritte nach rechts, schaute unter die Werkbank und wurde fündig: ein Haufen aussortierter Holzreste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
