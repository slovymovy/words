                ],
                "senses": [
                    {
                        "sense_id": "f25803ca-4476-3596-b643-b95d3a2fce64",
                        "entry_id": "48595b88-50b4-3a0b-88e2-84efd67a4eb1",
                        "glosses": [
                            "eine Person der deutschen Minderheiten, deren Familien teilweise seit Generationen in Ostmitteleuropa, Osteuropa, Südosteuropa und Asien gelebt haben und die gemäß dem Bundesvertriebenengesetz als deutsche Volkszugehörige nach dem 1. Januar 1993 nach Deutschland übersiedelt sind. Vorher benannte man sie nach dem Bundesvertriebenengesetz als Aussiedler."
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "23f47304-e620-4946-b08e-9da5eaeb1930",
                                "sense_id": "f25803ca-4476-3596-b643-b95d3a2fce64",
                                "text": "Seit 1993 kamen ca. 1,6 Mio. Spätaussiedler nach Deutschland."
                            },
                            {
                                "example_id": "f47b62a6-ec6b-445b-87f1-5826220c4ea9",
                                "sense_id": "f25803ca-4476-3596-b643-b95d3a2fce64",
                                "text": "„Wer die Spätaussiedler aufgrund eines vermeintlich liberalen Nationalitätsverständnisses ausgrenzt, verkennt allerdings, daß sie in den Herkunftsgebieten als Deutsche abgestempelt waren und darunter oft erheblich zu leiden hatten;…“"
                            },
                            {
                                "example_id": "3c6ffd17-6cca-459d-90b4-37639ab4b12d",
                                "sense_id": "f25803ca-4476-3596-b643-b95d3a2fce64",
                                "text": "„Mein Vater galt als Spätaussiedler, weil der Boden, auf dem sein Vater geboren wurde, bis 1945 deutsch war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
