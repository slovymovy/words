                ],
                "senses": [
                    {
                        "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                        "entry_id": "cfbfd1c3-f9c1-3058-8b40-0b7c1759d271",
                        "glosses": [
                            "die Form eines Fadens habende Speichelmenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1428ac1-67ed-4fe9-9d79-ce2b673bcead",
                                "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                                "text": "„Als es den Mund öffnet, spannen sich Speichelfäden zwischen seinen Lippen.“"
                            },
                            {
                                "example_id": "1215e3ef-55d7-4e84-a215-cb857a0110e2",
                                "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                                "text": "„Ein Zittern ergreift seinen Körper, und als er den Mund öffnet, sieht man nur, wie die Speichelfäden und Bläschen sofort gefrieren.“"
                            },
                            {
                                "example_id": "99b882ee-aa85-4db8-add2-f885445b7a46",
                                "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                                "text": "„Nackt und an einen Stuhl gefesselt, der in einer Pfütze aus Schweiß, Urin und Blut des großen Mannes stand, hatten ihm lange Speichelfäden aus den Mundwinkeln gehangen, während er delirierte.“"
                            },
                            {
                                "example_id": "862312c3-f7f4-44f4-9d92-ae32dd9d8d7d",
                                "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                                "text": "„Ein Speichelfaden sickert ihr aus dem schlaffen Mundwinkel, und dann stürzt sie mir vor die Füße.“"
                            },
                            {
                                "example_id": "0f7099aa-1c4b-4d84-b754-bd2618e5eb84",
                                "sense_id": "37d8c13e-4ec1-3a4f-b796-3ba145e50eba",
                                "text": "„Das Bild ihres Nachbarn, der ihre blutverschmierten Brüste mit seinem öligen kleinen Schwanz fickte, bohrte sich in ihren Geist, und sie erbrach sich wieder und wieder, bis nur noch bittere grüne Speichelfäden herauskamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
