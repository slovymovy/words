                "senses": [
                    {
                        "sense_id": "b9e7bb7f-7806-3035-9bce-92a01a31a7fb",
                        "entry_id": "a3f4c4d7-26d4-3736-96cf-9a09c0cef3df",
                        "glosses": [
                            "Satzteil (Konstituente), dessen Kopf (Kern) ein Nomen (Substantiv oder Pronomen) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe72424e-784e-4dc7-8eb6-6e67a4bc0446",
                                "sense_id": "b9e7bb7f-7806-3035-9bce-92a01a31a7fb",
                                "text": "In dem Satz: \"Das Bild ist ziemlich bunt\" ist das Syntagma \"Das Bild\" eine Nominalphrase, in der das Substantiv \"Bild\" der Kopf (Kern) der Konstruktion ist."
                            },
                            {
                                "example_id": "a139cff0-66fe-4349-81f5-1ec591a0474e",
                                "sense_id": "b9e7bb7f-7806-3035-9bce-92a01a31a7fb",
                                "text": "„Diese Nominalphrase disambiguiert in den meisten Fällen die Homonymien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02536e52-6f79-414e-b784-94d7c9fc9870",
                        "source_entry_id": "a3f4c4d7-26d4-3736-96cf-9a09c0cef3df",
                        "source_sense_id": "b9e7bb7f-7806-3035-9bce-92a01a31a7fb",
                        "source_sense_description": "Linguistik: Satzteil (Konstituente), dessen Kopf (Kern) ein Nomen (Substantiv oder Pronomen) ist",
                        "target_lang_word": "noun phrase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noun phrase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdfbb8c7-bab6-3cca-8b9c-d19deba949b6",
                                        "entry_id": "9e11b310-fa98-3663-803e-6acf3755a432",
                                        "glosses": [
                                            "A phrase that has a noun (or indefinite pronoun) as its head or performs the same grammatical function as a noun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adde9e65-c52f-4403-9d4a-167daf51e9ae",
                                                "sense_id": "cdfbb8c7-bab6-3cca-8b9c-d19deba949b6",
                                                "text": "The term \"restaurant supply service\" is a noun phrase, as are \"red blood cell\" and \"happy cat\"."
                                            },
                                            {
                                                "example_id": "5250df02-c40a-46f4-914a-916f8f5b6ab0",
                                                "sense_id": "cdfbb8c7-bab6-3cca-8b9c-d19deba949b6",
                                                "text": "Many collocations are noun phrases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7191e34d-bd4d-4943-831d-d23a909afad5",
                        "source_entry_id": "a3f4c4d7-26d4-3736-96cf-9a09c0cef3df",
                        "source_sense_id": "b9e7bb7f-7806-3035-9bce-92a01a31a7fb",
                        "source_sense_description": "Linguistik: Satzteil (Konstituente), dessen Kopf (Kern) ein Nomen (Substantiv oder Pronomen) ist",
                        "target_lang_word": "locution nominale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locution nominale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbb26a5-47df-352c-be32-4a1054a23d57",
                                        "entry_id": "8ca5db1f-be74-3d40-bacd-b9345ed17490",
                                        "glosses": [
                                            "Syntagme nominal composé de plusieurs mots, figé par l’usage, ou lexicalisé, pouvant être substitué à un nom dans une phrase pour constituer une nouvelle phrase grammaticalement correcte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1693314f-de92-49f2-8c27-0ebd5a7a4fd0",
                                                "sense_id": "1bbb26a5-47df-352c-be32-4a1054a23d57",
                                                "text": "Il a une vue perçante. / Il a un œil de lynx."
                                            },
                                            {
                                                "example_id": "e62d23d8-10cd-46d8-ba0a-04a119aba000",
                                                "sense_id": "1bbb26a5-47df-352c-be32-4a1054a23d57",
                                                "text": "M. Dupont est un inadapté. / M. Dupont est un canard boiteux."
                                            },
                                            {
                                                "example_id": "b2fcb364-fb22-40b2-ad7e-dc7ab89350d4",
                                                "sense_id": "1bbb26a5-47df-352c-be32-4a1054a23d57",
                                                "text": "Par exemple, oreille est un nom, mais feuille de chou, une locution nominale ; échouer, un verbe, mais faire chou blanc, une locution verbale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
