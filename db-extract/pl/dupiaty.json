                        ],
                        "examples": [
                            {
                                "example_id": "b2fb2e04-1fac-4360-ac8b-363b4804ff9b",
                                "sense_id": "2fe424bd-f450-326c-9ae3-4029d51fa433",
                                "text": "Ten telefon jest jakiś dupiaty – mam go od tygodnia, a już się zepsuł."
                            },
                            {
                                "example_id": "0fdea1c4-bb8b-46ce-bb93-c44bd031b135",
                                "sense_id": "2fe424bd-f450-326c-9ae3-4029d51fa433",
                                "text": "Ten film był naprawdę dupiaty; po półgodzinie chciało mi się spać."
                            },
                            {
                                "example_id": "4a049612-7429-4033-9e85-cb18a50a7ac2",
                                "sense_id": "2fe424bd-f450-326c-9ae3-4029d51fa433",
                                "text": "Na tak dupiatej imprezie nie byłem od dawna."
