                                        "entry_id": "96e5393d-6901-3f61-83c0-d3bdefdaec75",
                                        "glosses": [
                                            "астрон. угол, измеренный по горизонту, между плоскостью меридиана точки наблюдения и вертикальной плоскостью, проходящей через данную точку и какое-либо светило"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
