                "senses": [
                    {
                        "sense_id": "3d1710d8-8b96-3908-9870-947b45c53edd",
                        "entry_id": "5e85f182-3b2f-3c6f-b0fe-5caad8b3602d",
                        "glosses": [
                            "(hypothetische) chemische Verbindung, bei der Neon als Bestandteil enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18e83ce-94a4-495b-ba29-7160ff15a7cf",
                                "sense_id": "3d1710d8-8b96-3908-9870-947b45c53edd",
                                "text": "„Neonverbindungen mögen in der Zukunft an jeder Ecke erhältlich sein, hier in der Gegenwart sind sie jedoch etwas schwerer zu bekommen.“"
                            },
                            {
                                "example_id": "7019e1be-11da-4725-83a7-99cedb82c224",
                                "sense_id": "3d1710d8-8b96-3908-9870-947b45c53edd",
                                "text": "„Die gleichen Rechnungen wurden auch für die entsprechende Neonverbindung durchgeführt (W.P. Kraemer).“"
                            },
                            {
                                "example_id": "77c15d70-418c-4a1e-b38d-e683d0534e54",
                                "sense_id": "3d1710d8-8b96-3908-9870-947b45c53edd",
                                "text": "„Das wesentlich leichtere Edelgas Neon blieb bei Druckexperimenten bis 5 Mbar ein Isolator – nicht überraschend, da auch keine Neonverbindungen bekannt sind. Man erwartet jedoch, daß Neon bei 20 Mbar metallischen Charakter annehmen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
