                ],
                "senses": [
                    {
                        "sense_id": "731d3559-57eb-3b73-aec3-91c484c7eae4",
                        "entry_id": "4f2ec16b-cc0e-3e2f-8a08-b563005a3526",
                        "glosses": [
                            "состоящий из серебристого и белого цветов, представляющий собой соединение, сочетание этих цветов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc795229-4d60-4d3d-912b-03bbbb7f54fb",
                                "sense_id": "731d3559-57eb-3b73-aec3-91c484c7eae4",
                                "text": "Серебристо-белый и голубой цвет так красиво идут к её лицу и светлым льняным волосам."
                            },
                            {
                                "example_id": "8a430503-17b1-457e-b7c9-dfece28f7a99",
                                "sense_id": "731d3559-57eb-3b73-aec3-91c484c7eae4",
                                "text": "Да и что за красивая птица сама чайка! Серебристо-белая, грациозная, она великолепна, когда, широко разбросив крылья, сверкает высоко над вами, кокетливо ныряя в синем небе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "632d0e17-eef8-46fb-a49c-c6c2f05816a1",
                        "source_entry_id": "4f2ec16b-cc0e-3e2f-8a08-b563005a3526",
                        "source_sense_id": "731d3559-57eb-3b73-aec3-91c484c7eae4",
                        "target_lang_word": "silvery-white",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silvery-white",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d57378ba-dbce-321f-a8b9-e265d30fc0f9",
                                        "entry_id": "d9fe1da6-885e-3c2a-8bf3-f7834d10d89a",
                                        "glosses": [
                                            "Resembling silver in color, with a whiter hue than silver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26a1af96-ce9b-4423-82f8-8f178120ae47",
                                                "sense_id": "d57378ba-dbce-321f-a8b9-e265d30fc0f9",
                                                "text": "Then they saw a silvery-white orb hanging in the air in front of Lupin, who said, “Riddikulus!” almost lazily."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
