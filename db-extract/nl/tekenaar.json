                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547131bd-78ec-4f5b-b9b2-08d768740916",
                                                "sense_id": "2eda32e2-13ac-3a0e-af08-58674f040ebe",
                                                "text": "It was after the building and successful trials of the \"Lord Nelson\" engine on the Southern Railway that Sir Henry Fowler, then C.M.E. of the L.M.S.R., sent his chief draughtsman, Herbert Chambers, to Waterloo with the proposed weight diagram of a new 4-6-0 engine (to be known as a \"Royal Scot\" class), and to discuss the proposal with Mr. Clayton."
                                            }
                                        ]
                                    },
