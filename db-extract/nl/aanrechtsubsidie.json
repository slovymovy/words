                        "glosses": [
                            "een heffingskorting die men krijgt als de niet werkende partner onvoldoende verdient om te kunnen profiteren van de algemene heffingskorting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a48c47-b175-4dcd-9415-73a65bd81f61",
                                "sense_id": "7b2a918b-d405-3fef-81a6-546ce8880e01",
                                "text": "Huwelijksquotiënt: de aftrek voor niet-werkende partners van kostwinners heet in de volksmond de 'aanrechtsubsidie'. Hieraan sleutelen is niet populair bij de Christen-Unie, want die partij is pleitbezorger van het traditionele gezin, met één ouder die thuisblijft."
                            },
                            {
                                "example_id": "9baaeaa9-f509-4a25-9769-9fe6d93b5be2",
                                "sense_id": "7b2a918b-d405-3fef-81a6-546ce8880e01",
                                "text": "De overheid mag de algemene heffingskorting voor de niet-werkende partner in eenverdienersgezinnen, ook wel aanrechtsubsidie genoemd, afbouwen naar nul."
                            }
                        ]
                    }
