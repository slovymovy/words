{
    "word_family": [
        "diffidence",
        "diffidently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e354bca-f2ef-32f5-b2f0-032fe68fb68e",
                    "sense_definition": "Shy and lacking self-confidence; reserved or hesitant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>diffident</w> smile and looked down at his shoes when introduced to the group.",
                            "target_lang_translations": {
                                "ru": "Он <w>робко</w> улыбнулся и посмотрел на свои туфли, когда его представили группе."
                            }
                        },
                        {
                            "text": "Despite her vast knowledge on the subject, she remained too <w>diffident</w> to speak up during meetings.",
                            "target_lang_translations": {
                                "ru": "Несмотря на обширные знания по теме, она оставалась слишком <w>неуверенной в себе</w>, чтобы высказываться на совещаниях."
                            }
                        }
                    ],
                    "synonyms": [
                        "timid",
                        "modest"
                    ],
                    "antonyms": [
                        "confident",
                        "bold"
                    ],
                    "common_phrases": [
                        "diffident smile",
                        "diffident manner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застенчивый, робкий и неуверенный в себе; сдержанный или нерешительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуверенный в себе",
                                "target_lang_sense_clarification": "испытывающий недостаток веры в свои силы"
                            },
                            {
                                "target_lang_word": "застенчивый",
                                "target_lang_sense_clarification": "склонный стесняться в общении"
                            },
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "боязливый, нерешительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ddbab57-1baf-3cd6-aab9-9ee88de115b8",
                    "sense_definition": "Lacking trust or confidence in others; suspicious or distrustful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After being betrayed repeatedly, he grew deeply <w>diffident</w> of strangers offering assistance.",
                            "target_lang_translations": {
                                "ru": "После неоднократных предательств он стал крайне <w>недоверчиво</w> относиться к незнакомцам, предлагающим помощь."
                            }
                        },
                        {
                            "text": "The diplomat remained <w>diffident</w> of the promises made by the opposing council.",
                            "target_lang_translations": {
                                "ru": "Дипломат по-прежнему <w>с недоверием относился</w> к обещаниям, данным советом оппонентов."
                            }
                        }
                    ],
                    "antonyms": [
                        "trusting"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to mean distrustful of others"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не доверяющий другим; подозрительный или недоверчивый (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоверчивый",
                                "target_lang_sense_clarification": "склонный к недоверию и сомнениям"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "относящийся с подозрением к окружающим"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}