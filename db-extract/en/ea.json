                    {
                        "sense_id": "477302ee-1d39-370b-9fa9-78d68db737e6",
                        "entry_id": "57e8d16b-e077-3d6d-b0cf-717117e6457f",
                        "glosses": [
                            "Initialism of effective altruism."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c1e58fd1-be24-4659-8ece-e62f03b7f158",
                                "sense_id": "477302ee-1d39-370b-9fa9-78d68db737e6",
                                "text": "[…] Christine Emba’s Sept. 6 op-ed, “The trouble with ‘longtermism,’ ” countered this philosophy’s occasional fanaticism with glib reductiveness. Moreover, she tarred with the same brush the spirit of the entire effective altruism (EA) movement — the giveaway at the start is that EA is derided for being “obsessed with ‘doing good better.’ ”"
                            },
                            {
                                "example_id": "eb1d227e-0c58-488a-bb97-5fa9679c818e",
                                "sense_id": "477302ee-1d39-370b-9fa9-78d68db737e6",
                                "text": "This is the language of effective altruism — or E.A. — a philanthropic movement premised on the use of reason and data to do good. Bankman-Fried had long flaunted his E.A. bona fides to distinguish himself from other crypto billionaires."
                            }
                        ]
