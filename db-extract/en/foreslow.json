                    {
                        "sense_id": "bf6336c9-832a-3e43-aded-55052b2e80a8",
                        "entry_id": "a69650f2-23c7-3382-a420-fd315ed6d40a",
                        "glosses": [
                            "To be slow or tardy; to slow down."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b95f83c9-b4d3-47e8-80b9-25a720d63111",
                                "sense_id": "bf6336c9-832a-3e43-aded-55052b2e80a8",
                                "text": "Furthermore all that are carried with circular motion, seem to foreslow, and to move with more than one motion."
                            }
                        ]
                    },
                    {
                        "sense_id": "22ba3cd6-af52-3b38-b4fb-0fb5fe899ea5",
                        "entry_id": "a69650f2-23c7-3382-a420-fd315ed6d40a",
                        "glosses": [
                            "To slow, hinder, delay, impede."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd55cd75-fb6d-4cb4-b20d-dfdc681f7fc1",
                                "sense_id": "22ba3cd6-af52-3b38-b4fb-0fb5fe899ea5",
                                "text": "No stream, no wood, no mountain could foreslow / Their hasty pace."
                            },
                            {
                                "example_id": "5f8236f3-3e54-4d15-93bb-6c6bb83665e1",
                                "sense_id": "22ba3cd6-af52-3b38-b4fb-0fb5fe899ea5",
                                "text": "Then rise, ye blessed flocks! and home apace,\nLest night with stealing steps do you foreslow"
                            }
                        ]
                    }
