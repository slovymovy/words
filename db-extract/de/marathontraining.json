                "senses": [
                    {
                        "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                        "entry_id": "afca3d07-2ab5-33a8-9538-75e618b0f6a5",
                        "glosses": [
                            "Training, das ein Läufer systematisch durchführt, um seine Leistungsfähigkeit speziell für einen Marathonlauf aufzubauen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "66847cbf-7949-4b57-a7ee-b4c6801cfad3",
                                "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                                "text": "„Bones verdankte seinen Spitznamen der Tatsache, dass er wegen seines mörderischen Marathontrainings nur Haut und Knochen war.“"
                            },
                            {
                                "example_id": "b0bced27-ea1a-40f1-a1b8-4589dcafcaae",
                                "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                                "text": "„Ich laufe erst in 15 Wochen, werde aber trotzdem schon jetzt mit dem eigentlichen Marathontraining einsteigen, damit ich mich langsamer steigern kann.“"
                            },
                            {
                                "example_id": "69fc5556-72d3-4151-860b-315e9947106d",
                                "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                                "text": "„Für das Marathontraining muss man die Ernährung natürlich bedarfsgerecht anpassen!“"
                            },
                            {
                                "example_id": "ffb0e286-0560-4ae0-8caa-bea69ae91a63",
                                "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                                "text": "„Am 10. Januar 2022 werden Oliver und ich wieder gemeinsam mit euch einen Vortrag zum Thema zielgerichtetes Halb- oder und Marathontraining abhalten.“"
                            },
                            {
                                "example_id": "0b54c2cb-4146-4508-8396-3329fa185130",
                                "sense_id": "3bac8a26-514d-3e2c-9508-8e62132ffdf2",
                                "text": "„Da Sie sich der Aufgabe verschrieben haben, finden Sie hier einige häufige Missverständnisse, die manche Leute haben, und einige Tipps, wie Sie diese Fehler beim Marathontraining vermeiden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
