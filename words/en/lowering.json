                    "frequency": "Low",
                    "semantic_group_id": "menacing_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared at the intruder with a <w>lowering</w> gaze that made everyone nervous.",
                            "target_lang_translations": {
                                "ru": "Он уставился на незваного гостя <w>мрачным</w> взглядом, который заставил всех нервничать.",
                                "nl": "Hij staarde naar de indringer met een <w>nors</w> blik die iedereen zenuwachtig maakte."
                            }
                        },
                        {
                            "text": "Her <w>lowering</w> brows showed clearly that she was not pleased with the news.",
                            "target_lang_translations": {
                                "ru": "Её <w>насупленные</w> брови ясно показывали, что она не довольна новостями.",
                                "nl": "Haar <w>gefronsde</w> wenkbrauwen lieten duidelijk zien dat ze niet blij was met het nieuws."
                            }
                        }
                    ],
                    "synonyms": [
                        "frowning",
                        "scowling",
                        "sullen",
                        "glowering"
                    ],
                    "common_phrases": [
                        "lowering brows",
                        "lowering look",
                        "lowering countenance"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание выражения лица, которое является хмурым, угрюмым или выглядит сердитым и угрожающим.",
                        "nl": "Beschrijft een gezichtsuitdrukking die fronsend, nors of boos en dreigend is."
