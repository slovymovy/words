                    "sense_id": "dd59c34e-d9dc-3898-96bc-8368995b5351",
                    "sense_definition": "taki, który niesie śmierć, wiąże się z zabójstwem lub dotyczy mordercy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zabijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja odkryła <w>morderczy</w> plan przestępców na kilka godzin przed atakiem.",
                            "target_lang_translations": {
                                "ru": "Полиция раскрыла <w>убийственный</w> план преступников за несколько часов до нападения."
                            }
                        },
                        {
                            "text": "W jego oczach pojawił się nagle <w>morderczy</w> błysk gniewu.",
                            "target_lang_translations": {
                                "ru": "В его глазах внезапно появился <w>кровожадный</w> блеск гнева."
                            }
                        }
                    ],
                    "synonyms": [
                        "zabójczy"
                    ],
                    "common_phrases": [
                        "morderczy instynkt",
                        "morderczy plan",
                        "morderczy zamiar"
                    ],
                    "target_lang_definitions": {
                        "ru": "несущий смерть, связанный с убийством или характерный для убийцы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийственный",
                                "target_lang_sense_clarification": "несущий смерть или гибель"
                            },
                            {
                                "target_lang_word": "смертоносный",
                                "target_lang_sense_clarification": "способный убить, гибельный"
                            },
                            {
                                "target_lang_word": "кровожадный",
                                "target_lang_sense_clarification": "о взгляде, намерении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e236905e-696d-35d9-8aa4-166b22ad3428",
                    "sense_definition": "niezwykle ciężki, wyczerpujący i wyniszczający siły fizyczne lub psychiczne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wysilek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ukończeniu maratonu w pełnym słońcu zawodnicy narzekali na <w>mordercze</w> tempo biegu.",
                            "target_lang_translations": {
                                "ru": "После завершения марафона под палящим солнцем спортсмены жаловались на <w>убийственный</w> темп бега."
                            }
                        },
                        {
                            "text": "To był naprawdę <w>morderczy</w> trening i wszyscy potrzebowali dłuższego odpoczynku.",
                            "target_lang_translations": {
                                "ru": "Это была действительно <w>изнурительная</w> тренировка, и всем требовался длительный отдых."
                            }
                        }
                    ],
                    "synonyms": [
