                        "glosses": [
                            "(meist menschliche) Figur aus Gummi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d774b9-97b7-44b4-a1d6-d2a57ee3ad60",
                                "sense_id": "35eb6861-fa4d-3092-9351-721d08d0dc3a",
                                "text": "„Nein, zum Teufel, es war eine dieser aufblasbaren Gummipuppen, mit denen es manche Kerle treiben.“"
                            },
                            {
                                "example_id": "0950a3a3-c064-4007-98e6-b8db37ae6fde",
                                "sense_id": "35eb6861-fa4d-3092-9351-721d08d0dc3a",
                                "text": "„Kaum hatte er den Sitz verlassen, wurde dort automatisch eine Gummipuppe aufgeblasen, die seinen Platz einnahm – ein vielfach erprobter Trick aus den Zeiten des Kalten Krieges.“"
                            },
                            {
                                "example_id": "91fe1ecb-2dd0-44e8-9024-146d9685a944",
                                "sense_id": "35eb6861-fa4d-3092-9351-721d08d0dc3a",
                                "text": "„Fred rastet aus, fällt über den Mann her, der da auf dieser langhaarigen Blondine liegt, packt ihn, zerrt ihn von der Frau - und findet eine Gummipuppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
