                                "target_senses": [
                                    {
                                        "sense_id": "79780513-3e6f-3221-8caa-a67305813040",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "Either of two books in the New Testament (1 Timothy and 2 Timothy) which are epistles to Timothy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11f38539-b9da-3c8a-b5c0-966370e5240a",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "A companion of Paul mentioned in the Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4774e67a-9a2e-4db9-8981-445f375e9424",
                                                "sense_id": "11f38539-b9da-3c8a-b5c0-966370e5240a",
                                                "text": "Unto Timothie my own sonne in the Faith: Grace, mercie, and peace from God our Father, and Iesus Christ our Lord."
                                            },
                                            {
                                                "example_id": "ff795482-4551-461a-9d90-6f659cf04137",
                                                "sense_id": "11f38539-b9da-3c8a-b5c0-966370e5240a",
                                                "text": "In a letter to his disciple Timothy, Paul expresses a prohibition against women teaching men, but we know, and he knew, that Timothy was instructed by his mother and grandmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887b0394-6ddf-35a4-9c0b-17c2482c1fce",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "A male given name from Ancient Greek of biblical origin, also borne by early Christian saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e69e36-871e-4b1c-baf3-d3ebac7727de",
                                                "sense_id": "887b0394-6ddf-35a4-9c0b-17c2482c1fce",
                                                "text": "The name Timothy was an inspiration of Cherry's own. - - - \"Now then, TIMOTHY!\" and this she said with a rapid forte crescendo movement which made her mother laugh and also with a jerk which spilt the milk on the little one's forehead. \"Well, mother,\" says Cherry gaily, \"I've christened him at all events.\" And Timothy being a distinctive name, and a scriptural one, it was retained as the appellative of this mite,"
                                            },
                                            {
                                                "example_id": "3bc0496e-945a-42b4-a22a-abc17f4060b4",
                                                "sense_id": "887b0394-6ddf-35a4-9c0b-17c2482c1fce",
                                                "text": "O Timothy Tim / Has ten pink toes, / And ten pink toes / Has Timothy Tim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516156ca-eb96-35d9-8f27-5bae1d2b9646",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "An unincorporated community in Tennessee, United States; named for early postmaster Timothy Stephens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1b192de-d9cc-3fc3-b877-be514c88e9b5",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "A rare English surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9ab800d-60fd-3b44-9b83-6226ed9b55b2",
                                        "entry_id": "26845292-8d0c-3eb0-8474-7192d703f0dd",
                                        "glosses": [
                                            "A surname from Irish, a rare adopted anglicization for Mac Tomaltaigh (“son of Tomaltach”) (Tumulty)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
