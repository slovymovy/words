                "senses": [
                    {
                        "sense_id": "e3c6b1a6-3921-30e6-882f-f5d63db30b54",
                        "entry_id": "ea93a4c5-1326-3ea6-a8c0-74c8421e58a8",
                        "glosses": [
                            "Tenter fortement, pour faire désirer quelque chose d’inaccessible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee881e4-879e-422d-90c8-4668e0695f99",
                                "sense_id": "e3c6b1a6-3921-30e6-882f-f5d63db30b54",
                                "text": "Pris d’un effroi soudain, il traversa l’avenue en hâte et s’encourut vers le nord, résolu à ne plus se tantaliser par des spectacles et des bruits si alléchants et si troublants."
                            }
                        ]
                    },
