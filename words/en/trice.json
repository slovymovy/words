    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56a2d626-67e3-3b68-b34a-f63c95fcd016",
                    "sense_definition": "A very short time, a moment, or an instant (almost exclusively used in the phrase 'in a trice').",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cleaned up the spilled milk in a <w>trice</w> before anyone noticed.  ",
                            "target_lang_translations": {
                                "de": "Er wischte die verschüttete Milch im <w>Nu</w> auf, bevor es jemand bemerkte."
                            }
                        },
                        {
                            "text": "She solved the difficult puzzle in a <w>trice</w>.",
                            "target_lang_translations": {
                                "de": "Sie löste das schwere Rätsel im <w>Handumdrehen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "instant",
                        "jiffy",
                        "moment",
                        "flash"
                    ],
                    "common_phrases": [
                        "in a trice"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein sehr kurzer Zeitraum, ein Moment oder ein Augenblick (fast ausschließlich in der Redewendung 'in a trice' verwendet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Augenblick",
                                "target_lang_sense_clarification": "kurzer Moment"
                            },
                            {
                                "target_lang_word": "Nu",
                                "target_lang_sense_clarification": "im Nu (sehr schnell)"
                            },
                            {
                                "target_lang_word": "Moment",
                                "target_lang_sense_clarification": "kurzer Zeitraum"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c44f11fc-b734-3896-9847-42e5ee27dc6b",
                    "sense_definition": "To pull, haul, or pull sharply, especially using a rope or pulley.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors had to <w>trice</w> up the sails to prevent them from catching the wind.",
                            "target_lang_translations": {
                                "de": "Die Matrosen mussten die Segel <w>hochbinden</w>, damit sie nicht vom Wind erfasst wurden."
                            }
                        },
                        {
                            "text": "They will <w>trice</w> the heavy cargo onto the deck using a strong rope.",
                            "target_lang_translations": {
                                "de": "Sie werden die schwere Fracht mit einem starken Seil an Deck <w>hieven</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "haul",
                        "hoist"
                    ],
                    "common_phrases": [
                        "trice up"
                    ],
                    "target_lang_definitions": {
                        "de": "Ziehen, hieven oder ruckartig ziehen, besonders mit einem Seil oder Flaschenzug."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufheißen",
                                "target_lang_sense_clarification": "Nautisch: hochziehen"
                            },
                            {
                                "target_lang_word": "hochziehen",
                                "target_lang_sense_clarification": "mit einem Seil"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ec06c6ce-c240-3bd6-9139-c6c740a8c628",
                    "sense_definition": "A English family surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Trice</w> arrived at the office early this morning.",
                            "target_lang_translations": {
                                "de": "Herr <w>Trice</w> traf heute Morgen früh im Büro ein."
                            }
                        },
                        {
                            "text": "We invited the <w>Trice</w> family to our dinner party.",
                            "target_lang_translations": {
                                "de": "Wir haben Familie <w>Trice</w> zu unserer Dinnerparty eingeladen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein englischer Familienname."
                    },
                    "translations": {
