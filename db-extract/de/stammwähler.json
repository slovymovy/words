                        "glosses": [
                            "Wähler, der über viele Jahre hinweg die gleiche Partei wählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d81a4f-99c4-470b-b14e-931c3181d608",
                                "sense_id": "9c636ace-00cd-3fe4-b297-e9a4840834e5",
                                "text": "Der klassische Stammwähler ist immer seltener anzutreffen."
                            },
                            {
                                "example_id": "8111e554-ca61-4850-8cff-db04eb8c29f1",
                                "sense_id": "9c636ace-00cd-3fe4-b297-e9a4840834e5",
                                "text": "„In derselben Umfrage wurde auch gefragt, ob sich die jeweiligen Wahlberechtigten selber als Stamm- oder Wechselwähler einstufen – 51 Prozent sehen sich als Stammwähler, der Rest bekennt sich als Wechselwähler (42 Prozent) oder war noch nicht so oft wählen.“"
                            }
                        ],
