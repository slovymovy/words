            {
                "entry_id": "b6aa8be6-2814-3788-9407-4219098c76f8",
                "word": "iconolâtre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "341702ec-c00b-46c7-bd06-6e02be2bbd47",
                        "entry_id": "b6aa8be6-2814-3788-9407-4219098c76f8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
