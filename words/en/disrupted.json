                            }
                        },
                        {
                            "text": "Heavy rain led to a <w>disrupted</w> supply chain across the entire region.",
                            "target_lang_translations": {
                                "nl": "Zware regenval leidde tot een <w>verstoorde</w> toeleveringsketen in de hele regio."
                            }
                        }
                    ],
                    "synonyms": [
