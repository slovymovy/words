                "senses": [
                    {
                        "sense_id": "8c685dd3-b9b3-3624-afc9-ae705ca91400",
                        "entry_id": "1df67fff-5a24-352d-b208-a9c4432d5fbb",
                        "glosses": [
                            "Dialecte du ikoma-nata-isenye, langue bantoue de Tanzanie, E45 dans la classification de Guthrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454b2adb-1ae4-4d01-bd8b-6c13feca85dd",
                                "sense_id": "8c685dd3-b9b3-3624-afc9-ae705ca91400",
                                "text": "On ne voit pas comment le bulu et le fang auraient emprunté au kuba et au nata. De la même façon, le mbochi et le bobangi n’ont pas emprunté aux langues bantu orientales : comment ? Le tonga et le tumbuka ont-ils emprunté au kongo ?"
                            },
                            {
                                "example_id": "fd293312-3705-4e07-b078-3a846b5d7a6d",
                                "sense_id": "8c685dd3-b9b3-3624-afc9-ae705ca91400",
                                "text": "Dans certaines langues telles le kutu (G37), le nata (E45), le gisu (J31), le kinande (J42) etc. nous rencontrons un pré-préfixe suivi d’un préfixe."
                            }
                        ]
                    }
