                ],
                "senses": [
                    {
                        "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                        "entry_id": "31b2fa7c-db9a-3ed4-a448-b0ec05278528",
                        "glosses": [
                            "Anhänger des Mithraskults"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af38063a-4f3a-41e0-a316-897852a45ba4",
                                "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                                "text": "„Wie die Mitrhäer ehren die Christen den Sonntag und begehen das Fest der Wintersonnenwende am 25. Dezember, dem Tag von Sol Invictus.“"
                            },
                            {
                                "example_id": "c6906da3-cfff-4b93-b3b5-747ccb922218",
                                "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                                "text": "„Die Denkmäler erinnern daran, daß vor 1500 Jahren eine wichtige Entscheidung am seidenen Faden hing, nämlich die, ob wir heute vielleicht alle Mithräer wären statt Christen.“"
                            },
                            {
                                "example_id": "5c9ebf7f-30a2-4a14-881a-5c9da9720997",
                                "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                                "text": "„Vielleicht war der Stifter des Bildes, der seiner kleinen Lagergemeinde auf seinem Grund und Boden einen gottesdienstähnlichen Raum schaffen ließ, ein wohlhabender Mann oder gar der Vorsteher, der pater patrum, der Mithräer.“"
                            },
                            {
                                "example_id": "69874cd1-2ecf-4f76-b847-fc449bed91a8",
                                "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                                "text": "„Er hoffte, dass Massimo nichts von den Mithräern und der goldenen Statue verraten hatte.“"
                            },
                            {
                                "example_id": "7d892a70-d20d-4030-a5a5-323a7133775e",
                                "sense_id": "5fbc730b-73c5-362a-9750-9ce736dcf160",
                                "text": "„Auf ein schnelleres Durchschreiten des gesamten Tierkreises lassen beispielsweise die Aussagen der Anhänger des Zervan, Zoroasters und der Mithräer schließen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
