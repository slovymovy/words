{
    "word_family": [
        "gazetteer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ca62d98-88ee-3ff6-a7e8-15f572a97bfe",
                    "sense_definition": "An official periodical publication published by a government containing legal and state notices, and in some cases, legislations, subsidiary legislations and bills.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "official_publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new environmental regulations were officially published in the government <w>gazette</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Новые экологические нормы были официально опубликованы в правительственном <w>вестнике</w> вчера."
                            }
                        },
                        {
                            "text": "You should check the official <w>gazette</w> to see the latest legal appointments.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить официальный <w>бюллетень</w>, чтобы увидеть последние юридические назначения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "official gazette",
                        "government gazette"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное периодическое издание, выпускаемое правительством и содержащее правовые и государственные уведомления, а в некоторых случаях — законодательные акты и законопроекты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официальный вестник",
                                "target_lang_sense_clarification": "правительственное издание"
                            },
                            {
                                "target_lang_word": "правительственная газета",
                                "target_lang_sense_clarification": "официальный орган печати"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a0da528-b97f-3994-aeed-c76e7d95865a",
                    "sense_definition": "A newspaper; a printed sheet published periodically.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "newspaper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>gazette</w> has been reporting on community events for over a century.",
                            "target_lang_translations": {
                                "ru": "Местная <w>газета</w> сообщает о событиях общины уже более века."
                            }
                        },
                        {
                            "text": "He enjoyed reading the morning <w>gazette</w> while having his coffee.",
                            "target_lang_translations": {
                                "ru": "Ему нравилось читать утреннюю <w>газету</w> за чашкой кофе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily gazette",
                        "local gazette"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the names of older newspapers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Газета; периодическое печатное издание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газета",
                                "target_lang_sense_clarification": "периодическое издание"
                            },
                            {
                                "target_lang_word": "вестник",
                                "target_lang_sense_clarification": "часто в названиях газет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "501db3f4-218a-3ccd-a2c9-e50536a02490",
                    "sense_definition": "To publish something in an official gazette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "official_announcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>gazette</w> the new law to ensure it took immediate effect.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>опубликовать в официальном вестнике</w> новый закон, чтобы он вступил в силу немедленно."
                            }
                        },
                        {
                            "text": "Once they <w>gazette</w> the notice, the public will have thirty days to respond.",
                            "target_lang_translations": {
                                "ru": "Как только они <w>опубликуют уведомление</w> в официальной печати, у общественности будет тридцать дней на ответ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gazette the notice",
                        "gazette the regulations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опубликовать что-либо в официальном правительственном вестнике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опубликовать в официальном вестнике",
                                "target_lang_sense_clarification": "о законе или указе"
                            },
                            {
                                "target_lang_word": "обнародовать",
                                "target_lang_sense_clarification": "через официальную печать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b8cc25b-766f-3d9e-a824-824aeda00792",
                    "sense_definition": "To announce the status of someone in an official gazette, typically regarding military appointments or bankruptcies.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official_announcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Benjamin had already been <w>gazetted</w> captain and Kopp was in process of being <w>gazetted</w> major.",
                            "target_lang_translations": {
                                "ru": "Бенджамин уже был <w>назначен</w> капитаном приказом в вестнике, а Копп находился в процессе получения чина майора."
                            }
                        },
                        {
                            "text": "The officer was <w>gazetted</w> for his bravery during the recent campaign.",
                            "target_lang_translations": {
                                "ru": "Офицер был <w>упомянут в официальном приказе</w> за храбрость во время недавней кампании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gazetted captain",
                        "gazetted major"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявить о статусе кого-либо в официальном вестнике, обычно в отношении военных назначений или банкротств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опубликовать приказ о назначении",
                                "target_lang_sense_clarification": "в официальном вестнике"
                            },
                            {
                                "target_lang_word": "объявить в официальной печати",
                                "target_lang_sense_clarification": "о статусе или чине"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}