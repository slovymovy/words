                                    {
                                        "sense_id": "167daa65-9249-303f-bd80-5d1ae5d0f361",
                                        "entry_id": "55a60fa8-2da4-3b92-b14d-fa039fa6beeb",
                                        "glosses": [
                                            "apparaat waarmee men thee kan zetten"
                                        ],
                                        "tags": [
                                            "huishouden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2386f8c3-23a1-45f5-9fb9-9cead3ea5862",
                                                "sense_id": "167daa65-9249-303f-bd80-5d1ae5d0f361",
                                                "text": "En verdomd: de oven, de samowar – ze werden een eeuw geleden al door Chagall vereeuwigd in tekeningen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
