                                        "entry_id": "00b06362-e04b-39ee-869b-40db29b9b616",
                                        "glosses": [
                                            "een persoon van het vrouwelijk geslacht die op professionele manier boeken of verhalen schrijft"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
