                                    {
                                        "sense_id": "e7c6adba-2276-3d6f-84c8-48161bf4e670",
                                        "entry_id": "e78c97a2-757b-3864-a206-074d619b3420",
                                        "glosses": [
                                            "sich selbst überbewertend, hochmütig auf andere herabsehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "390fba3d-6b89-4283-a7b7-eaf3382d3a16",
                                                "sense_id": "e7c6adba-2276-3d6f-84c8-48161bf4e670",
                                                "text": "Er wirkt immer so überheblich."
                                            },
                                            {
                                                "example_id": "bbbeb9cf-2f6f-4ecd-bc3f-e19ae49094c5",
                                                "sense_id": "e7c6adba-2276-3d6f-84c8-48161bf4e670",
                                                "text": "Das war völlig unnötig und überheblich."
                                            },
                                            {
                                                "example_id": "5e219c81-63eb-4572-8d15-787d78e39371",
                                                "sense_id": "e7c6adba-2276-3d6f-84c8-48161bf4e670",
                                                "text": "Das ist ein Urteil mit überheblicher Schärfe."
                                            }
                                        ],
