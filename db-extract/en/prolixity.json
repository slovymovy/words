                "word": "prolixity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f8e886a6-53af-4e12-b272-62ca85c4a6ba",
                        "entry_id": "4a9d11da-b795-33c4-a77f-aec4ece4f71b",
                        "tags": [
                            "plural"
                        ],
                        "form": "prolixities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                        "entry_id": "4a9d11da-b795-33c4-a77f-aec4ece4f71b",
                        "glosses": [
                            "Long-windedness, tiresome length, excess of words."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8495fef1-5cbc-4ca4-a2d9-e8835fcc3a3f",
                                "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                                "text": "Of Skelton's one excursion into dramatic form, Magnificence, not much need be said. [...] Its fault, a fatal one in drama, is its prolixity, but cut by at least two-thirds it might act very much better than one imagines."
                            },
                            {
                                "example_id": "6ec06b17-faca-4a01-a8b6-280ab4900ace",
                                "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                                "text": "Must I then for twenty-three mortal days endure the prolixity of that tedious woman?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cddea0f-67db-4af9-ade9-ec7be12df2fd",
                        "source_entry_id": "4a9d11da-b795-33c4-a77f-aec4ece4f71b",
                        "source_sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                        "source_sense_description": "An excess of words",
