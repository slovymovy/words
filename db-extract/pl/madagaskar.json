                    {
                        "translation_id": "525c3218-e64d-453d-85be-0e1ea0001b30",
                        "source_entry_id": "b3357a25-3db0-369f-97bb-2c45fd328c09",
                        "source_sense_id": "c4610e11-6166-378f-b539-31074fe1aaa5",
