                ],
                "senses": [
                    {
                        "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                        "entry_id": "7cd01c8b-7417-37a0-9bde-9f8f7cff2b28",
                        "glosses": [
                            "Vers aus dem Koran"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c8eab8-13d6-425c-ba2e-130ba4f4dff4",
                                "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                                "text": "„Die First Lady sprach einige Koranverse, blies auf die Milch und knallte sie auf seinen Nachttisch, wohl wissend, dass er sie nicht trinken würde.“"
                            },
                            {
                                "example_id": "0c831c94-9bb2-454a-895d-4fea53d1071e",
                                "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                                "text": "„In Anlehnung an einen Koranvers, in dem der Gottesdiener al-Chidr mit Moses bricht, bat sie um Scheidung.“"
                            },
                            {
                                "example_id": "be3019d9-7505-4a1a-bd4b-de5a498e5ac3",
                                "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                                "text": "„Nenne mir ein einziges Hadith, einen einzigen Koranvers, in dem das Englische an sich oder durch analogische Herleitung als haram bezeichnet wird?“"
                            },
                            {
                                "example_id": "97f4254b-3c03-4ba8-97f0-9db94a2c6ef2",
                                "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                                "text": "„Eine Schachtel mit rosa Papiertüchern verspricht ‚Dry Days, Dry Nights‘, und ein zur Tugend der Reinlichkeit mahnender Koranvers, der in einem goldenen Rahmen die Wand ziert, trägt das Logo von Ciba-Geigy: eine Stubenfliege im Todeskampf.“"
                            },
                            {
                                "example_id": "f0703097-1113-47b4-8fa5-6eb20ad6fabd",
                                "sense_id": "a87667cb-ead5-31f5-9a1c-0e93a429d3b6",
                                "text": "„Der Todesfahrer Bilal Fahs hatte gleich zwei Testamente verfasst, das eine für Familie und Freunde, das andere für AMAL-Chef Nabih Berri, dessen Leibgarde er angehört hatte. Beiden waren Koranverse vorangestellt, in denen das islamische Martyrium gepriesen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
