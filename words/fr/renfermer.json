                    "antonyms": [
                        "libérer",
                        "relâcher"
                    ]
                },
                {
                    "sense_id": "a915c436-2c52-3a7d-a995-8de2a2cb435e",
                    "sense_definition": "Restreindre ou maintenir une action, un propos dans des limites strictes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a choisi de <w>renfermer</w> son propos aux seuls aspects financiers."
                        },
                        {
                            "text": "Il est préférable de <w>renfermer</w> ce débat dans un cadre juridique strict."
