{
    "word_family": [
        "sneeringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21761fc0-0ab6-32da-ba21-0e63289e3154",
                    "sense_definition": "A facial expression where one slightly raises one corner of the upper lip, indicating scorn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain wore a cold <w>sneer</w> as he looked down at the defeated hero.",
                            "target_lang_translations": {
                                "tr": "Kötü adam, yenilmiş kahramana tepeden bakarken yüzünde soğuk bir <w>alaycı gülüş</w> vardı.",
                                "cs": "Padouch měl na tváři chladný <w>úšklebek</w>, když shlížel na poraženého hrdinu."
                            }
                        },
                        {
                            "text": "She could not hide the <w>sneer</w> on her face when she heard his ridiculous excuse.",
                            "target_lang_translations": {
                                "tr": "Onun saçma sapan bahanesini duyduğunda yüzündeki <w>dudak bükme</w> ifadesini gizleyemedi.",
                                "cs": "Nedokázala skrýt <w>úšklebek</w> na tváři, když slyšela jeho směšnou výmluvu."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl",
                        "grimace"
                    ],
                    "antonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "cold sneer"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin üst dudağının bir köşesini hafifçe kaldırarak yaptığı, küçümseme belirten yüz ifadesi.",
                        "cs": "Výraz obličeje, při kterém člověk mírně pozvedne jeden koutek horního rtu, což vyjadřuje pohrdání."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alaycı gülüş",
                                "target_lang_sense_clarification": "Dudak bükerek yapılan küçümseyici ifade"
                            },
                            {
                                "target_lang_word": "dudak bükme",
                                "target_lang_sense_clarification": "Küçümseme veya beğenmeme ifadesi"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "úšklebek",
                                "target_lang_sense_clarification": "výraz obličeje vyjadřující pohrdání"
                            },
                            {
                                "target_lang_word": "úsměšek",
                                "target_lang_sense_clarification": "posměšný nebo pohrdavý výraz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a43b1dd1-444f-3619-aeb2-8241ad254b20",
                    "sense_definition": "A display of contempt or scorn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dismissive <w>sneer</w> made it clear that he did not respect their opinion.",
                            "target_lang_translations": {
                                "tr": "Onun umursamaz <w>küçümsemesi</w>, fikirlerine saygı duymadığını açıkça gösteriyordu.",
                                "cs": "Jeho odmítavý <w>posměšek</w> dal jasně najevo, že si jejich názoru neváží."
                            }
                        },
                        {
                            "text": "The politician faced many <w>sneers</w> from the crowd during his controversial speech.",
                            "target_lang_translations": {
                                "tr": "Politikacı, tartışmalı konuşması sırasında kalabalıktan gelen birçok <w>alaycı tepkiyle</w> karşılaştı.",
                                "cs": "Politik čelil během svého kontroverzního projevu mnoha <w>posměškům</w> z davu."
                            }
                        }
                    ],
                    "synonyms": [
                        "contempt",
                        "scorn",
                        "disdain"
                    ],
                    "antonyms": [
                        "admiration",
                        "respect"
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçümseme veya hor görme göstergesi.",
                        "cs": "Projev pohrdání nebo výsměchu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "küçümseme",
                                "target_lang_sense_clarification": "Birine veya bir şeye değer vermeme durumu"
                            },
                            {
                                "target_lang_word": "hor görme",
                                "target_lang_sense_clarification": "Aşağılayıcı bir tavır sergileme"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "posměšek",
                                "target_lang_sense_clarification": "projev výsměchu"
                            },
                            {
                                "target_lang_word": "pohrdání",
                                "target_lang_sense_clarification": "postoj vyjadřující nízkou úctu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c686dee-3c99-3796-a845-31a653741a95",
                    "sense_definition": "To raise a corner of the upper lip slightly, especially in scorn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>sneer</w> at the suggestion as if it were beneath him.",
                            "target_lang_translations": {
                                "tr": "Öneri sanki seviyesinin altındaymış gibi <w>dudak bükmeye</w> başladı.",
                                "cs": "Začal se nad tím návrhem <w>ušklíbat</w>, jako by byl pod jeho úroveň."
                            }
                        },
                        {
                            "text": "She watched him <w>sneer</w> while he read the critical review of his work.",
                            "target_lang_translations": {
                                "tr": "Çalışması hakkındaki eleştirel incelemeyi okurken onun <w>alaycı bir şekilde dudak büktüğünü</w> izledi.",
                                "cs": "Sledovala, jak se <w>ušklíbá</w>, zatímco četl kritickou recenzi své práce."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoff",
                        "mock"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle küçümseyerek üst dudağın bir köşesini hafifçe kaldırmak.",
                        "cs": "Mírně pozvednout koutek horního rtu, zejména s pocitem pohrdání."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dudak bükmek",
                                "target_lang_sense_clarification": "Küçümseyici bir yüz ifadesi takınmak"
                            },
                            {
                                "target_lang_word": "alaycı bir şekilde gülümsemek",
                                "target_lang_sense_clarification": "Küçümseme içeren bir ifadeyle gülmek"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ušklíbat se",
                                "target_lang_sense_clarification": "dělat pohrdavý obličej"
                            },
                            {
                                "target_lang_word": "pohrdavě se usmívat",
                                "target_lang_sense_clarification": "vyjadřovat pohrdání úsměvem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f975399-12d2-3c8f-8fb6-55395636c925",
                    "sense_definition": "To utter something with a contemptuous expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>sneer</w> at those who are trying their best to help you.",
                            "target_lang_translations": {
                                "tr": "Sana yardım etmek için ellerinden geleni yapanlarla <w>alay etme</w>.",
                                "cs": "Nesmíš se <w>posmívat</w> těm, kteří se ti snaží ze všech sil pomoci."
                            }
                        },
                        {
                            "text": "He <w>sneered</w> a sarcastic comment that silenced the entire room.",
                            "target_lang_translations": {
                                "tr": "Tüm odayı sessizliğe gömen alaycı bir yorumu <w>küçümseyerek söyledi</w>.",
                                "cs": "S <w>posměchem</w> utrousil sarkastickou poznámku, která celou místnost umlčela."
                            }
                        }
                    ],
                    "synonyms": [
                        "mock",
                        "ridicule"
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçümseyici bir ifadeyle bir şey söylemek.",
                        "cs": "Říci něco s pohrdavým výrazem."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alay etmek",
                                "target_lang_sense_clarification": "Küçümseyici sözler söylemek"
                            },
                            {
                                "target_lang_word": "küçümseyerek konuşmak",
                                "target_lang_sense_clarification": "Aşağılayıcı bir tonla ifade etmek"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "posmívat se",
                                "target_lang_sense_clarification": "vyjadřovat výsměch slovy"
                            },
                            {
                                "target_lang_word": "vysmívat se",
                                "target_lang_sense_clarification": "ironicky nebo pohrdavě komentovat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}