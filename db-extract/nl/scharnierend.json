                "senses": [
                    {
                        "sense_id": "c0ae8efa-93fa-3563-b883-ca254ebeeec9",
                        "entry_id": "e343d590-7fa2-3b6d-8a8a-d9f170f759a7",
                        "glosses": [
                            "van iets dat het draait om een hengsel of scharnier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f499698e-6fb6-44dc-8304-97e7e368874f",
                                "sense_id": "c0ae8efa-93fa-3563-b883-ca254ebeeec9",
                                "text": "De speciale scharnierende deur voor mindervaliden krijgt geen klink. Medewerkers achter de informatiebalie gaan de elektronische deur straks bedienen."
                            },
                            {
                                "example_id": "bbb331c8-bdb6-4db8-bf41-8a6404c6f88f",
                                "sense_id": "c0ae8efa-93fa-3563-b883-ca254ebeeec9",
                                "text": "De Beluga XL heeft een opvallend bol hoofd en een verlaagde cockpit. Het wonderlijke ontwerp is nodig om een enorme scharnierende laaddeur mogelijk te maken."
                            },
                            {
                                "example_id": "6bec01a0-a960-4a02-aae3-d7cd0e5005c1",
                                "sense_id": "c0ae8efa-93fa-3563-b883-ca254ebeeec9",
                                "text": "Aan boord uiteraard alle mogelijke luxe. Bijzonder zijn bijvoorbeeld de ‘naar achteren’ scharnierende suicide doors. Achterin de koffer van de kolos vind je optioneel een paar met leer beklede stoeltjes en tafeltje terug om te nippen van de champagne na een succesvolle jachtpartij."
                            }
                        ]
                    }
