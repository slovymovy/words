                                    {
                                        "sense_id": "14dea782-6262-32f3-8526-49fd15250fda",
                                        "entry_id": "b6fc3e29-2062-3e3a-89db-a3ae1be4256f",
                                        "glosses": [
                                            "Petite pyramide quadrangulaire qui termine les obélisques et les pyramides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cee0856-2f97-4a34-915d-9767e3a86827",
                                                "sense_id": "14dea782-6262-32f3-8526-49fd15250fda",
                                                "text": "Entre la haute barrière et le littoral, le sol, ou plutôt le champ de glace, affreusement convulsionné, hérissé d'hummocks, d'aiguilles rompues, de tronçons renversés, de pyramidions culbutés, houleux comme une mer qui se fût subitement figée au plus fort d'une tempête, n'était plus reconnaissable."
                                            },
                                            {
                                                "example_id": "f7a61f1c-ef0a-4858-9188-12b7517e0b14",
                                                "sense_id": "14dea782-6262-32f3-8526-49fd15250fda",
                                                "text": "Avec le mécénat de la Fondation Bergé-Saint Laurent, un pyramidion doré a alors été installé mais sans sa pointe, pour des raisons techniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264c73ef-edaa-359d-9a8e-ec05b1ca383f",
                                        "entry_id": "b6fc3e29-2062-3e3a-89db-a3ae1be4256f",
                                        "glosses": [
                                            "Style d’aménagement de toiture développé au début du XXᵉ siècles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fb68e9a-5f8b-4b49-907a-a6010e80b2f5",
                        "source_entry_id": "89de44cb-fc04-3d6f-ae27-119cbf8fb55b",
                        "source_sense_id": "c793b073-3143-33cb-9f11-f0e679636e57",
                        "source_sense_description": "miniature pyramid",
                        "target_lang_word": "Pyramidion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pyramidion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                        "entry_id": "9e3a7405-4b91-3c4a-9aca-a604be98eff6",
                                        "glosses": [
                                            "pyramidenförmiger Abschlussstein eines Obelisken oder einer Pyramide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4886b941-dee2-4f1d-b788-c3b99306f2aa",
                                                "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                                "text": "„Diesem Steinraub fielen auch die Spitze der Pyramide, das Pyramidion, und die obersten Lagen zum Opfer.“"
                                            },
                                            {
                                                "example_id": "ded5071e-dff6-488e-a7ac-4d2724b3f99f",
                                                "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                                "text": "„Durch seine hellere messingähnliche Farbe wurde das Elektrum noch glänzender als das reine Gold. Dies war vielleicht der Grund, warum die Pyramidien der Obelisken mit Elektrum überzogen wurden.“"
                                            },
                                            {
                                                "example_id": "0d409bb5-ad18-40d0-bfd9-c6de40dab2d7",
                                                "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                                "text": "„Die Pyramidia an der Spitze der Hatschepsut-Obelisken waren mit derselben Darstellung geschmückt, die sich allerdings auf die beiden Hauptpersonen beschränkte, Amon und die Königin […].“"
                                            },
                                            {
                                                "example_id": "06642a59-e59d-404d-97a7-6ead30a5eec8",
                                                "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                                "text": "„Die Abwesenheit von Hieroglyphen auf denselben Flächen, von denen die Pyramidien von Granit gewöhnlich bedeckt sind, und besonders das Muster der beiden Obelisken von Heliopolis, von denen wir sprechen werden, sind Thatsachen, welche große Wahrscheinlichkeiten begründen, um anzunehmen, daß die beiden Obelisken von Luxor mit Außenwerken von Erz gekrönt waren.“"
                                            },
                                            {
                                                "example_id": "541e3a6f-50be-4342-8ad5-67a3d207942e",
                                                "sense_id": "35704f2a-3144-33ad-b79b-5771cfab3b14",
                                                "text": "„Ein Charakteristikum dieser späten Pyramiden ist das Fehlen einer eigenen Spitze, des Pyramidions.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
