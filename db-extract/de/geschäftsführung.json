                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85f4ec5-9cc9-4337-99f0-8bea91760dca",
                                                "sense_id": "70e1a6b8-d1da-3f52-bd89-a5bd95264269",
                                                "text": "Paganini tenait la bourse, il avait la gérance du fonds social ce qui n’étonnera personne."
                                            },
                                            {
                                                "example_id": "be4b34a1-bce6-4f95-bf0a-2b4ce873b4c9",
                                                "sense_id": "70e1a6b8-d1da-3f52-bd89-a5bd95264269",
                                                "text": "M. Noris était agriculteur, c’est-à-dire qu’il avait passé sa vie à ne rien faire, car on ne saurait appeler « travail » la gérance de deux domaines."
                                            },
                                            {
                                                "example_id": "7cc40f4f-8656-46c6-8a74-49c923d1c0ad",
                                                "sense_id": "70e1a6b8-d1da-3f52-bd89-a5bd95264269",
                                                "text": "Horreur des gérances, des régences féminines."
                                            },
                                            {
