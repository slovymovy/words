                ],
                "senses": [
                    {
                        "sense_id": "59cb069e-4250-3175-b738-fc35620d5847",
                        "entry_id": "2e8253a5-d68b-306a-91fe-feb96e399d9c",
                        "glosses": [
                            "heerser over een inheems volk met een hoogstaande cultuur dat vanaf de dertiende eeuw tot de Spaanse overheersing (in 1533) leefde in een gebied rondom hun hoofdstad Cuzco in het huidige Peru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63f8f5d-0f2d-48eb-a7df-4888153c78dc",
                                "sense_id": "59cb069e-4250-3175-b738-fc35620d5847",
                                "text": "De heersende Inca (koning) ging na een eclips dagenlang vasten en trok zich dan terug uit het openbare leven."
                            },
                            {
                                "example_id": "2686bcbe-540c-45ac-a12f-db3f28744256",
                                "sense_id": "59cb069e-4250-3175-b738-fc35620d5847",
                                "text": "Iedere Inca liet namelijk voor zichzelf een paleis bouwen dat na zijn overlijden automatisch zijn laatste rustplaats annex tempel werd."
                            }
                        ]
                    },
                    {
                        "sense_id": "20d02aa7-301a-3c14-ad35-628ba6939372",
                        "entry_id": "2e8253a5-d68b-306a-91fe-feb96e399d9c",
                        "glosses": [
                            "iemand die behoort tot een inheems volk met een hoogstaande cultuur dat vanaf de dertiende eeuw tot de Spaanse overheersing (in 1533) leefde in een gebied rondom hun hoofdstad Cuzco in het huidige Peru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9105943f-1cf2-4e09-a153-9ce59b7a6bb9",
                                "sense_id": "20d02aa7-301a-3c14-ad35-628ba6939372",
                                "text": "Niet iedere Inca mocht op de cocaplanten kauwen. Alleen de leiders van het volk en de mensen die zwaar werk moesten doen mochten de cocaplant kauwen."
                            },
                            {
                                "example_id": "9538e7bd-74d0-4ea7-93d8-eead441d2749",
                                "sense_id": "20d02aa7-301a-3c14-ad35-628ba6939372",
                                "text": "Op zijn tweeëntwintigste jaar vertrok de Inca naar Spanje, waar hij de rest van zijn leven zou blijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94a1714a-c032-4a2d-a58b-112c200ec522",
                        "source_entry_id": "2e8253a5-d68b-306a-91fe-feb96e399d9c",
                        "target_lang_word": "inca",
