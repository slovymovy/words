                                    },
                                    {
                                        "sense_id": "eefbe367-ee87-34d3-b78d-0829259657f0",
                                        "entry_id": "f85d7ef1-dd59-3fbf-8890-dce2908c435a",
                                        "glosses": [
                                            "Causing exhaustion; very tiring."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70cfcbdf-ee30-4cdb-9ed5-e229ed555e3a",
                                                "sense_id": "eefbe367-ee87-34d3-b78d-0829259657f0",
                                                "text": "Wolsey saw in what imminent peril the revenues of the Church were from the exhaustive squandering and grasping covetousness of the Court."
                                            },
                                            {
                                                "example_id": "24ad276d-553e-42c4-ad62-6b01212e864e",
                                                "sense_id": "eefbe367-ee87-34d3-b78d-0829259657f0",
                                                "text": "Chopping and hauling wood was exhaustive work. Scraping the flesh off the heavy hides and hanging them to dry also taxed her physical strength."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
