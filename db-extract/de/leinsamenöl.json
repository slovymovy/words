                "senses": [
                    {
                        "sense_id": "331b767c-eac1-3b88-82e1-5a4405b448b3",
                        "entry_id": "a2e859b0-7e45-37e4-9649-6775601369cc",
                        "glosses": [
                            "aus den Samen des Flachses gewonnenes Pflanzenöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad59279-48b9-409b-93c3-16582bcd7c53",
                                "sense_id": "331b767c-eac1-3b88-82e1-5a4405b448b3",
                                "text": "„Zum Vergleich erhielten die Mäuse in einem zweiten Durchgang Futter, das mit Leinsamenöl angereichert war, dieses ist reich an n-3-Fettsäuren. “"
                            },
                            {
                                "example_id": "343c9648-1067-4717-95bf-f60d31ef3050",
                                "sense_id": "331b767c-eac1-3b88-82e1-5a4405b448b3",
                                "text": "„Im Brief wird von der ehemaligen Sprinterin geschildert, wie Coach Graham sie mit The Clear vertraut machte: Indem er versicherte, es handele sich um Leinsamenöl und sei lediglich ein Nahrungsergänzungsmittel, von dem sie zwei Tropfen unter die Zunge träufeln müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
