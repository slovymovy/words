                ],
                "senses": [
                    {
                        "sense_id": "391b4fad-be44-3d47-8af3-1d7f025c2a90",
                        "entry_id": "d5a3e886-2a9a-3c4f-91c1-2528e277f054",
                        "glosses": [
                            "enormity (large size of something)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0b3f53bc-c8c2-4d60-9892-e47aac10071f",
                                "sense_id": "391b4fad-be44-3d47-8af3-1d7f025c2a90",
                                "text": "Ale czemże jest to Słońce nasze, ktorego ogrom nas przeraża, a szyk budowy układu zachwyca?",
                                "translation": "But what is this Sun of ours, whose enormity terrifies us, and whose structure fascinates us?",
                                "english": "But what is this Sun of ours, whose enormity terrifies us, and whose structure fascinates us?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a84ecd6-bff1-3552-87a5-8cec735e4447",
                        "entry_id": "d5a3e886-2a9a-3c4f-91c1-2528e277f054",
                        "glosses": [
                            "bulk, myriad, multitude (large amounts of something)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "7e97d86b-4925-40f4-a89b-92aa97351711",
                                "sense_id": "5a84ecd6-bff1-3552-87a5-8cec735e4447",
                                "text": "Pan Szymon Gajowiec poza urzędowymi pracami, które mu ogrom czasu zabierały, i niezależnie od tych prac prowadził po nocach swą własną robotę.",
                                "translation": "The lord Szymon Gajowiec, outside bureaucratic work, which took up a massive amount of his time, and regardless of this work he ran his own operations at night.",
                                "english": "The lord Szymon Gajowiec, outside bureaucratic work, which took up a massive amount of his time, and regardless of this work he ran his own operations at night."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2ed8fa8-5e29-3c36-b985-7edb1b2a9b6d",
                        "entry_id": "d5a3e886-2a9a-3c4f-91c1-2528e277f054",
                        "glosses": [
                            "enormity (very large object)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "93d84ef0-9d7d-4ed5-9e17-7c05fc89c704",
                                "sense_id": "a2ed8fa8-5e29-3c36-b985-7edb1b2a9b6d",
                                "text": "Warszawa-ogrom, rozsiadła na przestrzeni mil, z sosnowymi parkami, tonąca w drzewach [...]",
                                "translation": "Warsaw - the giant, ensconced over the space of miles, with pine parks, swimming in trees …",
                                "english": "Warsaw - the giant, ensconced over the space of miles, with pine parks, swimming in trees …"
                            }
                        ]
                    }
