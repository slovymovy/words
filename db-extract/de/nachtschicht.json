                        "form": "die Nachtschicht"
                    },
                    {
                        "form_id": "b5ee084b-2999-4999-9af1-82efba0a88f5",
                        "entry_id": "9ddbeb4f-def0-38d9-9023-1edb6b91adfc",
                        "tags": [
                            "accusative",
