                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "fda3d407-c52f-38c9-b19f-89ca6d6fd2c6",
                                        "entry_id": "81d0303b-d4ab-34e0-a1b3-87e8287adb23",
                                        "glosses": [
                                            "Acción y efecto de tratar"
                                        ],
                                        "tags": [],
