                        "examples": [
                            {
                                "example_id": "a61bd62f-382c-4f12-8c06-671bb31cfdca",
                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                "text": ",,Proef deze eens, zegt Anne ondertussen, ,,Een l'Oppidum uit 2014, op basis van syrah en cinsault. Die moet je na één jaar drinken, dan ruik en proef je de volle frisheid van fruit."
                            },
                            {
                                "example_id": "49185f36-fba2-455a-ac20-8529a2a305fc",
                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                "text": "De rode Spaanse wijn komt van de Bodega van stervoetbal André Iniesta (FC Barcelona). De A.I.8 tinto uit Castilla la Mancha is een blend van tempranillo en syrah."
                            },
                            {
                                "example_id": "e3d00646-d214-425d-84c3-17e7dcb8ad12",
                                "sense_id": "67f22285-9ee3-3ccb-8f95-3ff717689770",
                                "text": "De lijn bestaat uit twee watertjes zonder bubbels en twee met, in de smaken cabernet, merlot, syrah en petit verdot (de blauwe druiven voor rode wijn) en riesling en gewürztraminer (wit)."
                            }
                        ]
