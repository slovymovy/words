                    {
                        "translation_id": "2fe721e9-49d0-4eaa-8fee-5078c50b78e6",
                        "source_entry_id": "1ff233be-16e4-314d-80e8-34824ca23919",
                        "source_sense_id": "b1f2d5d9-5182-36a7-9497-0cd5d35989ed",
