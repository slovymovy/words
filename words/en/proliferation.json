{
    "word_family": [
        "proliferate",
        "proliferative",
        "proliferator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "102a9d64-0ceb-3f2a-abd7-71773ecdeb97",
                    "sense_definition": "A rapid increase in the number or amount of something; a large-scale spread or growth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proliferation</w> of smartphones has changed the way people communicate globally.",
                            "target_lang_translations": {
                                "ru": "<w>Распространение</w> смартфонов изменило то, как люди общаются во всем мире."
                            }
                        },
                        {
                            "text": "We are seeing a rapid <w>proliferation</w> of online courses available to students everywhere.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдаем стремительный <w>рост</w> числа онлайн-курсов, доступных студентам повсюду."
                            }
                        }
                    ],
                    "synonyms": [
                        "expansion",
                        "growth",
                        "spread",
                        "multiplication"
                    ],
                    "antonyms": [
                        "reduction",
                        "decline",
                        "decrease"
                    ],
                    "common_phrases": [
                        "rapid proliferation",
                        "proliferation of technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое увеличение количества или объема чего-либо; масштабное распространение или рост."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "увеличение охвата или частоты встречаемости"
                            },
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "увеличение показателей или количества"
                            },
                            {
                                "target_lang_word": "увеличение",
                                "target_lang_sense_clarification": "прибавление в объеме или размере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "573aee9b-f63e-3576-a896-62ac0eda82ae",
                    "sense_definition": "The spread of nuclear, chemical, or biological weapons to countries that do not already possess them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "International treaties were signed to prevent the <w>proliferation</w> of nuclear weapons.",
                            "target_lang_translations": {
                                "ru": "Были подписаны международные договоры, чтобы предотвратить <w>распространение</w> ядерного оружия."
                            }
                        },
                        {
                            "text": "The government is working hard to combat <w>proliferation</w> by controlling dual-use technology.",
                            "target_lang_translations": {
                                "ru": "Правительство усердно работает над борьбой с <w>распространением</w> оружия, контролируя технологии двойного назначения."
                            }
                        }
                    ],
                    "synonyms": [
                        "spread"
                    ],
                    "antonyms": [
                        "disarmament",
                        "non-proliferation"
                    ],
                    "common_phrases": [
                        "nuclear proliferation",
                        "combat proliferation",
                        "weapons proliferation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in political or military contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространение ядерного, химического или биологического оружия в страны, которые им еще не обладают."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространение",
                                "target_lang_sense_clarification": "в контексте оружия массового уничтожения"
                            },
                            {
                                "target_lang_word": "пролиферация",
                                "target_lang_sense_clarification": "специальный политический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63573902-e008-3905-a159-25e4ce4b50bf",
                    "sense_definition": "The process by which an organism or cells produce others of their kind; biological reproduction or cell growth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drug was designed to inhibit the <w>proliferation</w> of cancer cells in the body.",
                            "target_lang_translations": {
                                "ru": "Препарат был разработан для подавления <w>пролиферации</w> раковых клеток в организме."
                            }
                        },
                        {
                            "text": "Scientists studied the cell <w>proliferation</w> under various laboratory conditions.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали <w>размножение</w> клеток в различных лабораторных условиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduction",
                        "propagation",
                        "multiplication"
                    ],
                    "common_phrases": [
                        "cell proliferation",
                        "biological proliferation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific or technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого организм или клетки производят себе подобных; биологическое размножение или рост клеток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролиферация",
                                "target_lang_sense_clarification": "разрастание ткани путем деления клеток"
                            },
                            {
                                "target_lang_word": "размножение",
                                "target_lang_sense_clarification": "биологическое воспроизводство"
                            },
                            {
                                "target_lang_word": "разрастание",
                                "target_lang_sense_clarification": "увеличение ткани в объеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a08289d-4fb7-34f4-9485-ff5e14c53a9a",
                    "sense_definition": "The result of a gradual buildup or accumulation of material or items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proliferation</w> of sediment at the river mouth caused navigation issues for ships.",
                            "target_lang_translations": {
                                "ru": "<w>Скопление</w> отложений в устье реки вызвало проблемы с навигацией для судов."
                            }
                        },
                        {
                            "text": "Over the years, a <w>proliferation</w> of documents had filled the archive to capacity.",
                            "target_lang_translations": {
                                "ru": "За годы <w>накопление</w> документов заполнило архив до отказа."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulation",
                        "buildup",
                        "accretion"
                    ],
                    "antonyms": [
                        "depletion"
                    ],
                    "common_phrases": [
                        "gradual proliferation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат постепенного накопления или скопления материалов или предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накопление",
                                "target_lang_sense_clarification": "постепенное собирание чего-либо"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "результат сосредоточения предметов в одном месте"
                            },
                            {
                                "target_lang_word": "разрастание",
                                "target_lang_sense_clarification": "увеличение масштабов чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}