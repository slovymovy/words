                                        "sense_id": "46d44b43-ec5a-3be6-b5e7-88511872c7ef",
                                        "entry_id": "2c2d0500-1277-3d02-af84-616616422d28",
                                        "glosses": [
                                            "An informer or snitch; a squealer."
                                        ],
                                        "tags": [
