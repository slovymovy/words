                ],
                "senses": [
                    {
                        "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                        "entry_id": "efb65abb-48c5-3a1f-89a7-637a2b8d4111",
                        "glosses": [
                            "Person, die in einer Paarung mit einer anderen in einem Spielgeschehen kooperiert, auch gegen Spielgegner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57769b55-8ca6-4d58-a6c5-410af3fad850",
                                "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                                "text": "„Konfliktgegner sind auf dieser Ebene die beiden Spielpartner, wobei vermerkt werden muß, dass beide nur durch das Spiel miteinander in Konflikt geraten.“"
                            },
                            {
                                "example_id": "8a964ad5-5c73-424a-b9f5-382dacd02e16",
                                "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                                "text": "„Denn bei einem Spiel zweier Gruppen mit einem Ball auf zwei Ziele […] müssen die Spielpartner als Mitspieler einander helfen.“"
                            },
                            {
                                "example_id": "543ec6ac-b0ca-4ae2-a656-c7a0f9d937e4",
                                "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                                "text": "„Sie fordern auf, gerecht und fair zu sein, dem für alle verbindlichen Spielgedanken zu folgen, den Gegenspieler dabei nicht als Feind, sondern als Spielpartner zu sehen.“"
                            },
                            {
                                "example_id": "d41a1b0b-0822-4d60-ba4b-afde0d05b16c",
                                "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                                "text": "„Beachvolleyball-Olympiasieger Julius Brink will im kommenden Jahr mit einem neuen Spielpartner angreifen.“"
                            },
                            {
                                "example_id": "f7f72a7c-d148-4f3d-bb15-f0f0d75a90b4",
                                "sense_id": "eb03bfbf-8f9d-3156-821f-04bf4a6a9c7f",
                                "text": "„Er trieb sich mit seinem Spielpartner Branden Grace am Samstag regelrecht zu Top-Leistungen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                        "entry_id": "efb65abb-48c5-3a1f-89a7-637a2b8d4111",
                        "glosses": [
                            "Spieler, die miteinander ein Spiel betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de627ae-0468-41ce-859e-1540d0fcc997",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Die ausgeformten Spiele (games), die eine bestimmte Regel oder einen festgelegten Verlauf haben, sind zum größten Teil auf Spielpartner angewiesen.“"
                            },
                            {
                                "example_id": "68bf4a6b-7983-4f79-bfa3-eda9b5191f22",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Sandspiel und Bauen, Spiele mit Farben, Ton und Knete lassen sich besonders gut auf die Weise betreiben, die das Parallelspiel charakterisiert, die also ermöglicht, dass die Kinder beieinander sind, einander zugucken, sich auch gegenseitig in Gang halten, aber nicht aufeinander als Spielpartner angewiesen sind.“"
                            },
                            {
                                "example_id": "8be75305-3ddf-4b85-9bbf-fcb397db06d2",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Die Spielinhalte beruhen auf realen Erfahrungen, die in vorgestellten Situationen reproduziert und durch die Interaktionen mit realen Spielpartnern mit unterschiedlichen Erfahrungen, Erwartungen und Bedürfnissen modifiziert werden.“"
                            },
                            {
                                "example_id": "03c1d68e-89c8-492b-8097-b28f2b619335",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Jeder Raum, ob Wald, Stube oder Strand, kann zum Spielraum, jeder Partner, ob Tier, Mensch, Wasser oder Fels, kann zum Spielpartner, jedes Instrument, ob Fahrrad, Auto oder Rasenmäher, kann zum Spielgerät werden.“"
                            },
                            {
                                "example_id": "c2d98446-82a9-4f28-af3e-3c770063b5df",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Das ist ja eine Sorge vieler Eltern: Mensch, hoffentlich bekommt unser Sprößling einen Spielpartner.“"
                            },
                            {
                                "example_id": "3c6738cd-7fae-491c-8a2b-fb134a710bfe",
                                "sense_id": "9ef3cc27-c4fc-367d-b252-c6d14fd3d696",
                                "text": "„Je klarer der zeitliche und örtliche Rahmen der Begegnung festgesetzt ist, desto lustvoller können die Spielpartnerinnen und Spielpartner sich darauf einlassen, ihr gewöhnliches Ich für eine Weile zu transzendieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
