                "senses": [
                    {
                        "sense_id": "1a4314b7-f508-3d88-beeb-e975c9138289",
                        "entry_id": "0b57a2a8-fc13-3ca6-b73b-bbeafce55adb",
                        "glosses": [
                            "betrekking hebbend op vernieuwingen en uitvindingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b931687-fb4e-4667-b1b2-4526236c138c",
                                "sense_id": "1a4314b7-f508-3d88-beeb-e975c9138289",
                                "text": "\"Heel origineel en innoverend\", noemt burgemeester Hein Bloemen het concept voor de groene camping. Bij wijze van proef wil Berkelland er dan ook graag aan meewerken. Zij het onder voorwaarden: het gaat om een eenmalig experiment, waarvan geen precedentwerking mag uitgaan. Ook kan het niet zo zijn dat de caravanhomes op termijn worden veranderd in zomerhuisjes of vervangen door stacaravans."
                            },
                            {
                                "example_id": "5ca8d24a-158d-4c5b-b528-411027bd6603",
                                "sense_id": "1a4314b7-f508-3d88-beeb-e975c9138289",
                                "text": "Herenmodezaak Henk ter Horst, Riwald Recycling en Buurtzorg Nederland zijn door de jury van EnergiekAlmelo genomineerd voor de EnergiekAlmelo Award. De prijs wordt toegekend voor innoverend en maatschappelijk verantwoord ondernemen. De uitreiking heeft plaats tijdens het symposium van EnergiekAlmelo op woensdag 26 november in het Theaterhotel. Het symposium begint om 15.30 uur. De toegang is gratis."
                            }
                        ]
                    }
