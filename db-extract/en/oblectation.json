                        "examples": [
                            {
                                "example_id": "01376782-11e0-41b8-bc2c-81a7cfc459bb",
                                "sense_id": "dac4a8f6-7b10-3e21-b737-fbda350ee4ad",
                                "text": "\"No, sir, though I am myself of a strong temperament, I abhor ebriety, and detest those who swallow wine gulae causa, for the oblectation of the gullet […]\""
                            },
                            {
                                "example_id": "900f30cd-200b-47b8-9bd0-e9a6d10b3631",
                                "sense_id": "dac4a8f6-7b10-3e21-b737-fbda350ee4ad",
                                "text": "Whereof the first is called oblectation, which is a certain quietness or assentation of the mind or will, because it obeys, and not willingly consents to that pleasantness which the senses hold forth […]"
                            }
                        ]
