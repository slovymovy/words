                ],
                "senses": [
                    {
                        "sense_id": "b178ac89-0562-328e-8ccf-4434eae344d5",
                        "entry_id": "5d0672ab-ec43-396e-b039-8e19f8874a1c",
                        "glosses": [
                            "дорога, проложенная по снегу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90ae22d0-b9f8-40ad-b844-e986bb48e503",
                                "sense_id": "b178ac89-0562-328e-8ccf-4434eae344d5",
                                "text": "Ехали зимником весьма трудною дорогою по Иртышу и Тоболу .."
                            },
                            {
                                "example_id": "8485f9dd-7688-4209-a57c-62c724798cee",
                                "sense_id": "b178ac89-0562-328e-8ccf-4434eae344d5",
                                "text": "Вот он едет зимником по реке, перед самыми окнами моего дома, с возом на мельницу .."
                            },
                            {
                                "example_id": "6d9857dc-3eae-4796-9b98-d3a10e590efb",
                                "sense_id": "b178ac89-0562-328e-8ccf-4434eae344d5",
                                "text": "На круглой поляне, примкнувшей к проезжему зимнику, ярко пылал .. костёр .."
                            },
                            {
                                "example_id": "c908a7e3-6ac0-43ed-b8bc-52d07847d9d4",
                                "sense_id": "b178ac89-0562-328e-8ccf-4434eae344d5",
                                "text": "А в лесу есть зимник, по нему зимой выволакивают на тракторных санях лесины."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9526456-2c60-354c-a8f0-e232e369e958",
                        "entry_id": "5d0672ab-ec43-396e-b039-8e19f8874a1c",
                        "glosses": [
                            "небольшое утеплённое помещение, строение, в котором живут зимой"
                        ],
                        "tags": [],
                        "examples": []
                    }
