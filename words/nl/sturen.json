                    "frequency": "High",
                    "semantic_group_id": "besturen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapitein <w>stuurde</w> het grote schip veilig de haven binnen.",
                            "target_lang_translations": {
                                "en": "The captain <w>steered</w> the large ship safely into the harbor.",
                                "ru": "Капитан благополучно <w>направил</w> большой корабль в гавань.",
