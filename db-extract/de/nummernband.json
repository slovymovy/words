                "senses": [
                    {
                        "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                        "entry_id": "3bf5989b-0b53-3d63-8053-726c8c132922",
                        "glosses": [
                            "ein Bereich von (normalerweise) ganzen Zahlen, oft für einen bestimmten Anwendungszweck reserviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5905243-093c-4b12-8545-9fe7f3a2448c",
                                "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                                "text": "„Die Hauptaufgabe von GS1 ist die Verwaltung und Vergabe von international verbreiteten Nummernsystemen wie der European Article Number (EAN). Firmen, die solche Nummernsysteme einführen wollen, müssen bei GS1 ein entsprechendes Nummernband lizenzieren.“"
                            },
                            {
                                "example_id": "a6a9af6c-3e35-4a7b-a0e2-57febda72538",
                                "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                                "text": "„Als Nummer des Datenbausteins nimmt die Systemfunktion die kleinste freie Nummer in dem Nummernband, das durch die Eingangsparameter LOW_LIMIT und UP_LIMIT vorgegeben wird.“"
                            },
                            {
                                "example_id": "0f59d9e9-1ac7-42a9-8d1d-4cd0feb87dee",
                                "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                                "text": "„Bezogen auf die IEC-Nummern wird seit Anfang 1997 ein neues, 5-stelliges System (Nummernband von 60000–69999) verwendet.“"
                            },
                            {
                                "example_id": "dede5d8f-9d23-425b-8617-38baf5ce560a",
                                "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                                "text": "„Ab 2010 werden die Normen zur Referenzkennzeichnung als gemeinsame IEC/ISO-Norm im 80000-er Nummernband herausgegeben, …“"
                            },
                            {
                                "example_id": "38ff1f13-615c-415a-969f-3b6f69cbbe20",
                                "sense_id": "48889672-4ad9-300a-be30-ad438e330626",
                                "text": "„Für diese automatisch ergänzten F-Bausteine müssen Sie hier ein Nummernband reservieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                        "entry_id": "3bf5989b-0b53-3d63-8053-726c8c132922",
                        "glosses": [
                            "ein Gurt zur Befestigung von Startnummern (speziell beim Triathlon)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0d3a10-05d8-4f8a-b0d0-8d196d9852ce",
                                "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                                "text": "Das Nummernband erlaubt einen schnelleren Wechsel zwischen den Disziplinen und stellt beim Triathlon somit einen Wettbewerbsvorteil dar."
                            },
                            {
                                "example_id": "d440d016-0ab0-4f89-a529-0be6a39f386e",
                                "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                                "text": "„Ein Helfer schaut auf mein Nummernband.“"
                            },
                            {
                                "example_id": "5c778920-d034-45dd-81b1-97c48e9318b1",
                                "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                                "text": "„Die Startnummer wird am Besten an einem Nummernband befestigt.“"
                            },
                            {
                                "example_id": "766b6ab1-881b-4bc7-b2c4-bef0891d1411",
                                "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                                "text": "„Neo aus, Helm auf, Radbrille auf, Nummernband um und ab geht die Post.“"
                            },
                            {
                                "example_id": "d7f88508-9933-41c9-af07-1b2d402f93be",
                                "sense_id": "08910b4b-3440-3240-9097-f90428c8024f",
                                "text": "„Laufkleidung abends zurechtlegen, die Startnummer anheften, …, vier Energie-Gels an das Nummernband befestigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
