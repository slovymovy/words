                                                "sense_id": "8aa69559-1016-3be2-a79f-f3b90ce6c536",
                                                "text": "Taiyakis are made right here, all during the day, and are especially yummy when they when they are immediately made and hot off the grill. They are also great as a mid-morning or afternoon snack."
                                            },
                                            {
                                                "example_id": "09d7da8c-808e-43ab-b93a-e8f2c9be85da",
                                                "sense_id": "8aa69559-1016-3be2-a79f-f3b90ce6c536",
                                                "text": "A woman fed a brood of lettuce hens taiyakis."
                                            },
                                            {
                                                "example_id": "4f250bb5-ece5-4cdc-9853-39d74306ce9f",
                                                "sense_id": "8aa69559-1016-3be2-a79f-f3b90ce6c536",
                                                "text": "Another stall there, Mama, does croissant taiyakis, fish-shaped pastries with a choice of custardy fillings."
                                            }
