                ],
                "senses": [
                    {
                        "sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
                        "entry_id": "b85ab63d-5087-33f1-9669-31fc537aceca",
                        "glosses": [
                            "iemand die tijdens de coronapandemie de maatregelen tegen de verspreiding van het coronavirus niet naleeft"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c2767319-b43f-4977-874a-0a3a7553d082",
                                "sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
                                "text": "Die covidioot hield midden tijdens de coronacrisis een feestje met 100 bezoekers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a26ca02d-7a1b-4650-9df9-2484e1c28e3b",
                        "source_entry_id": "b85ab63d-5087-33f1-9669-31fc537aceca",
                        "source_sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
                        "source_sense_description": "iemand die tijdens de coronapandemie de maatregelen tegen de verspreiding...",
                        "target_lang_word": "Covidiot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Covidiot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22cb245d-fc16-33c6-9257-1d68f5b3be14",
                                        "entry_id": "24bb643d-7cd8-3d14-92d1-80fe1ff3a821",
                                        "glosses": [
                                            "Person, die die vom Coronavirus verursachte Krankheit Covid-19 nicht ernst nimmt oder für übertrieben geschildert bis hin zu frei erfunden hält"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2209dafa-6eca-4a4f-9792-429d18ebd37c",
                                                "sense_id": "22cb245d-fc16-33c6-9257-1d68f5b3be14",
                                                "text": "„«Dieser Covidiot protestiert gegen Maskenpflicht».“"
                                            },
                                            {
                                                "example_id": "b625790c-0b9c-4633-9e73-d636494c8cf8",
                                                "sense_id": "22cb245d-fc16-33c6-9257-1d68f5b3be14",
                                                "text": "„Dieses Kofferwort hat auch immer etwas dabei, nämlich Überheblichkeit gegenüber den \"Covidioten\".“"
                                            },
                                            {
                                                "example_id": "23236d1d-717b-4a3e-bb21-7b95bdb5f5b3",
                                                "sense_id": "22cb245d-fc16-33c6-9257-1d68f5b3be14",
                                                "text": "„An Neuschöpfungen wie „Abstrichzentrum“, „Beherbergungsverbot“ oder „Covidiot“ wird klar – Sprache reagiert auf eine veränderte Wirklichkeit.“"
                                            },
                                            {
                                                "example_id": "dcfaf49f-4535-4be6-907b-5288d30fc014",
                                                "sense_id": "22cb245d-fc16-33c6-9257-1d68f5b3be14",
                                                "text": "„»Zugespitzt: Bist du nicht für die Maßnahmen, dann bist du zugleich für das Ableben aller alten Menschen. Stellst du Fragen, bist du schnell ein sogenannter \"Covidiot\".«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74d61a7a-99dd-4a19-981a-fc9bb408479a",
                        "source_entry_id": "b85ab63d-5087-33f1-9669-31fc537aceca",
                        "source_sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
                        "source_sense_description": "iemand die tijdens de coronapandemie de maatregelen tegen de verspreiding...",
                        "target_lang_word": "Covidiotin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Covidiotin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                        "entry_id": "285209b1-2de7-302d-ad15-c12e55cf1852",
                                        "glosses": [
                                            "weibliche Person, die die vom Coronavirus verursachte Krankheit Covid-19 nicht ernst nimmt oder für übertrieben geschildert bis hin zu frei erfunden hält"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d33810-a70c-48e7-b9ea-bf5029277b7b",
                                                "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                                "text": "„Und so kann auch ein Instagram-Liebling mit über einer Million Followern, gut bezahlten Sponsorenverträgen und luxuriösem Lifestyle ganz schnell zur „Covidiotin“ erklärt werden.“"
                                            },
                                            {
                                                "example_id": "349c067b-4c34-4da5-b5ad-cdcf69f5c37a",
                                                "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                                "text": "„Dagegen wurden maskenlose Covidiotinnen und Covidioten liebevoll begleitet und manchmal auch umarmt und mit Blumen beschenkt.“"
                                            },
                                            {
                                                "example_id": "e3cd2277-709c-40ab-9284-8586920789a3",
                                                "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                                "text": "„Bei einer Zwischenlandung in Frankfurt verwies der Kapitän die Covidiotin deshalb des Flugzeuges, doch die Frau weigerte sich, die Maschine zu verlassen.“"
                                            },
                                            {
                                                "example_id": "cf0e664f-ef7d-4d22-9b78-7cf8adfaff7d",
                                                "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                                "text": "„Barbara Morawietz, die die Demo der Querdenker organisiert hatte, schilderte, wie sie, die ehemalige SPD- und Grünen-Wählerin, zur „Covidiotin“ geworden sei, wie sie sich selbstironisch bezeichnete: […]“"
                                            },
                                            {
                                                "example_id": "fa526aa0-03bf-4220-bd57-52c91d57ec1d",
                                                "sense_id": "0c756ce3-8428-3e05-b4bd-daef47d068e4",
                                                "text": "„Vergessen waren die ›Covidiotinnen‹ und ihre Verschwörungstheorien, ihre Allianz mit Rassisten und Nazis, ihre menschenverachtende Rücksichtslosigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113e402f-5b3e-44e5-be12-20c1850f667b",
                        "source_entry_id": "b85ab63d-5087-33f1-9669-31fc537aceca",
                        "source_sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
                        "source_sense_description": "iemand die tijdens de coronapandemie de maatregelen tegen de verspreiding...",
                        "target_lang_word": "covidiot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "covidiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8e8e2d3-a2ae-3a9e-b388-c5b89f106b73",
                                        "entry_id": "496e2a7a-7484-3a6b-b2a6-92fc576d4bf9",
                                        "glosses": [
                                            "A person who is foolishly reckless with respect to avoiding contracting or spreading COVID-19."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "humorous",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c1ac14a-fd2f-4c76-93c4-71bbd2a18f6a",
                                                "sense_id": "a8e8e2d3-a2ae-3a9e-b388-c5b89f106b73",
                                                "text": "Photoshop-skilled social media users altered the poster board to read as 'We have no idea what we're doing' and 'Trump is a Covidiot'"
                                            },
                                            {
                                                "example_id": "792ce01b-1569-4447-afb0-69d9eb8ba095",
                                                "sense_id": "a8e8e2d3-a2ae-3a9e-b388-c5b89f106b73",
                                                "text": "The aura of invincibility seemed to ooze off of these entitled covidiots, the term coined to describe those deciding to blissfully and willfully ignore measures put in place to mitigate the spread of the virus."
                                            },
                                            {
                                                "example_id": "72aa8d16-3298-4337-a371-abf1bccb4476",
                                                "sense_id": "a8e8e2d3-a2ae-3a9e-b388-c5b89f106b73",
                                                "text": "A Covidiot party attended by a large number of people was shut down by police in Clydebank.[…] A total of 37 Fixed Penalty Notices were issued for 'breaching Covid regulations'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3904274a-8963-46df-90f7-7df77990b6b8",
                        "source_entry_id": "b85ab63d-5087-33f1-9669-31fc537aceca",
                        "source_sense_id": "176457a5-ec4b-31f9-8e24-20661cb6ec22",
