                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77e69f1-3d3b-434c-a706-dc5a029560dd",
                                "sense_id": "da707e75-0f2a-3c68-8d1b-49e88a77c822",
                                "text": "Le propre d’une telle image, lorsqu’elle est possible, est de re-sensorialiser le sens."
                            },
                            {
                                "example_id": "2aab9b54-1de2-4e2b-9314-fba4c6b50d21",
                                "sense_id": "da707e75-0f2a-3c68-8d1b-49e88a77c822",
                                "text": "Elle re-sensorialise dans l’œuvre d’art, bien que par des voies détournées et tout en restant libre, les invisibles objets de la pensée."
                            }
                        ]
