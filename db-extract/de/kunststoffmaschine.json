                "senses": [
                    {
                        "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                        "entry_id": "8da4a731-a455-3326-873e-5537a893cd35",
                        "glosses": [
                            "thermisches, mechanisches Produktionsmittel für Polymere und Polymerprodukte"
                        ],
                        "tags": [
                            "Kunststoffverarbeitung"
                        ],
                        "examples": [
                            {
                                "example_id": "c753fd24-d7d3-4dd4-8397-e09586880c30",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„Die meisten Kunststoffmaschinen, also die Spritzgießmaschinen, sind nach wie vor hydraulisch angetrieben, da sich damit hohe Kräfte mit relativ wenig Aufwand erzeugen lassen.“"
                            },
                            {
                                "example_id": "e594d054-e280-4b7a-ae8d-565514370477",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„Ganz gleich, ob Spritzgießen, Extrusion, Blasformen, Thermoformen, Gummi/Reifen oder Handling: Optimale Kunststoffmaschinen realisieren Sie mit Lösungen und Produkten von Siemens in jedem Fall schneller und kostengünstiger.“"
                            },
                            {
                                "example_id": "f61362fc-4d80-4f77-861c-8a0d0c9f611a",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„Mit Leasing sind Ihre Kunststoffmaschinen und Geräte immer auf dem neuesten und zuverlässigsten Stand der Technik.“"
                            },
                            {
                                "example_id": "ca2f9a02-2be5-4e37-b33e-b6f37dbc7c5e",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„Als international tätige Headhunter in Bereich Kunststoffmaschinen verfügen wir über ein erstklassiges und internationales Netzwerk.“"
                            },
                            {
                                "example_id": "e7c6cb79-e1a9-430b-9c18-8ea5858eee9b",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„An den unterschiedlichen Bewegungsachsen einer Kunststoffmaschine montiert, verbessern die absolut messenden Positionssensoren den Produktionsprozess erheblich.“"
                            },
                            {
                                "example_id": "63f1f383-db93-4e9c-9277-118f6e29bdc3",
                                "sense_id": "9e78e82c-750e-3504-9104-7210b8be0a2b",
                                "text": "„Gussheizelemente aus Alu und Messing dienen hauptsächlich der Beheizung von Kunststoffmaschinen und für Werkzeuge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
