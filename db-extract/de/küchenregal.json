                        "examples": [
                            {
                                "example_id": "f2cd4074-ba07-427f-b90e-f4debeb67d17",
                                "sense_id": "684992ec-501c-330d-b86f-c9a1b8d8c45d",
                                "text": "„Monatelang hebt man die Hefte im Küchenregal auf, um sich an einem Dezembernachmittag voll Übermut in das Abenteuer zu stürzen.“"
                            },
                            {
                                "example_id": "331ca008-8b59-4fe2-887f-1ab764e7e48c",
                                "sense_id": "684992ec-501c-330d-b86f-c9a1b8d8c45d",
                                "text": "„Den Kühlschrank haben wir schon ausgeräumt, die Küchenregale ebenfalls.“"
                            }
                        ],
