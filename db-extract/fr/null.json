                                            {
                                                "example_id": "2bdcd25f-4b50-41ae-bb9a-a39f19078555",
                                                "sense_id": "97e60218-ecd9-3bb0-b88e-cff9b365f68a",
                                                "text": "Since no date of birth was entered for the patient, his age is null."
                                            }
