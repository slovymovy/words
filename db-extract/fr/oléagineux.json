                                "target_senses": [
                                    {
                                        "sense_id": "1374079d-b7dc-32c8-bb59-de76929acc14",
                                        "entry_id": "b3e1bb1d-87e2-3bef-b8d0-32a948fcc33c",
                                        "glosses": [
                                            "Öl enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad24392-6bac-4aea-ab14-0e4998d22533",
                                                "sense_id": "1374079d-b7dc-32c8-bb59-de76929acc14",
                                                "text": "„Die Qualität von Pflanzenölen ist sowohl von der Art der Herstellung des Öls als auch von Herstellung der ölhaltigen Früchte und Saaten abhängig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "994eb56d-f850-4a4c-be21-ebe38cbcf723",
                        "source_entry_id": "7ed8baa3-9c9a-31f2-858f-603dd383fabc",
                        "source_sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
                        "target_lang_word": "oleaginous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oleaginous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc7ed69b-68ba-349c-b92e-48640adb6289",
                                        "entry_id": "bf508f6e-7a98-382f-8d80-12dc06ba6a9b",
                                        "glosses": [
                                            "Oily, greasy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "370a7abb-e25e-4da9-bcf0-eb47588d5196",
                                                "sense_id": "bc7ed69b-68ba-349c-b92e-48640adb6289",
                                                "text": "[…] the use of Linseed-oyl, Tar, or such oleaginous Matter, tends much to their Preservation and Duration."
                                            },
                                            {
                                                "example_id": "0408e710-99b8-471d-89a6-821e9799f407",
                                                "sense_id": "bc7ed69b-68ba-349c-b92e-48640adb6289",
                                                "text": "Looking back, it seemed to me that a slight oleaginous mist was still hovering round the chair."
                                            },
                                            {
                                                "example_id": "392bb541-b97a-4001-8ef5-454519c2436f",
                                                "sense_id": "bc7ed69b-68ba-349c-b92e-48640adb6289",
                                                "text": "His once-black hair had faded to the color of used steel wool and now covered his bony skull in a peculiar oleaginous fuzz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a46d068-533a-36dd-aee4-c5efd5b8e058",
                                        "entry_id": "bf508f6e-7a98-382f-8d80-12dc06ba6a9b",
                                        "glosses": [
                                            "Falsely or affectedly earnest; persuasively suave."
                                        ],
                                        "tags": [
                                            "of manner or speech"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b07801-94c9-4088-8731-1b262c21a8da",
                                                "sense_id": "7a46d068-533a-36dd-aee4-c5efd5b8e058",
                                                "text": "The oleaginous salesman convinced me to buy a more expensive car."
                                            },
                                            {
                                                "example_id": "067da7fd-6f0b-42a7-8a60-a9f0aa74b861",
                                                "sense_id": "7a46d068-533a-36dd-aee4-c5efd5b8e058",
                                                "text": "Cruz was obviously analogizing Bernie Sanders to the Bolsheviks and Hillary Clinton to the Mensheviks. The oleaginous Texan is an erudite slyboots, but his history is off-kilter."
                                            },
                                            {
                                                "example_id": "947c1e58-a5f4-4eb3-9a22-001b3465f098",
                                                "sense_id": "7a46d068-533a-36dd-aee4-c5efd5b8e058",
                                                "text": "The oleaginous Mike Pence, with his talent for toadyism and appetite for obsequiousness, could, Trump knew, become America’s most repulsive public figure."
                                            },
                                            {
                                                "example_id": "60a9c570-607b-4cb8-be96-2f681f375437",
                                                "sense_id": "7a46d068-533a-36dd-aee4-c5efd5b8e058",
                                                "text": "She runs a mentoring scholarship programme for women, administered by a tiresome, oleaginous would-be conductor, played by Mark Strong, and there are rumours that this is a source of young women with whom Tár has affairs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca38ce6-2b44-4971-a9bf-7dfe7f921bf7",
                        "source_entry_id": "7ed8baa3-9c9a-31f2-858f-603dd383fabc",
                        "source_sense_id": "410d5e77-0e59-381d-8e83-9cb82f52cefc",
