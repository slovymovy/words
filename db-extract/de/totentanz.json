                        "cross_references": [
                            {
                                "target_word": "dodendans",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b65837be-733c-3cfb-9575-f8b8afd5143d",
                                        "entry_id": "c4a0aea2-503c-3270-bc08-3e147dab3634",
                                        "glosses": [
                                            "de (vermeende) dans van De Dood die de levenden naar het hiernamaals brengt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52fc2a4e-a477-481f-8c37-df77d3f4f7b1",
                                                "sense_id": "b65837be-733c-3cfb-9575-f8b8afd5143d",
                                                "text": "De andere brug, de Spreuerbrücke, ligt meer stroomopwaarts, en is beschilderd met zo’n zeventig schilderingen over een dodendans, waarin de ”man met de zeis” centraal staat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cedc595-3928-33ab-bd66-38c5da3a0ec2",
                                        "entry_id": "c4a0aea2-503c-3270-bc08-3e147dab3634",
                                        "glosses": [
                                            "extatische dans op het kerkhof"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55df3b56-246b-48b7-ab11-f30f2fc8d40f",
                                                "sense_id": "7cedc595-3928-33ab-bd66-38c5da3a0ec2",
                                                "text": "Hoe zie je daar het bloed op? Nu eens in helder contrast, dan weer ton sur ton. Boksen is een dodendans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
