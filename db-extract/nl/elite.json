                ],
                "senses": [
                    {
                        "sense_id": "f7c239d1-f2d7-3f88-b771-05a8b0656aa7",
                        "entry_id": "ef2b02ee-abd3-3c49-97b0-15dfcd0c7dc8",
                        "glosses": [
                            "kleine, besloten groep van vooraanstaande, bevoorrechte mensen met buitengewone privileges en soms buitengewone kwalificaties waardoor zij op een bepaald vlak de hoogste positie innemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e72c999-52ef-45ce-9397-8b84cda1c968",
                                "sense_id": "f7c239d1-f2d7-3f88-b771-05a8b0656aa7",
                                "text": "‘tot op heden is in geen enkel westers land een autoritaire, rechts-populistische partij of politicus aan de macht gekomen zonder de medewerking van gevestigde conservatieve elites.’"
                            },
                            {
                                "example_id": "637c8510-1f6a-4eb4-9e91-e9b6b50a044c",
                                "sense_id": "f7c239d1-f2d7-3f88-b771-05a8b0656aa7",
                                "text": "'Niet alleen Swift, ontzeg Russische elite elke toegang tot het Westen'"
                            },
                            {
                                "example_id": "a4b7aa5a-7c5e-4217-8fd3-46fb889b0549",
                                "sense_id": "f7c239d1-f2d7-3f88-b771-05a8b0656aa7",
                                "text": "Geweld werd tot het nobele verheven en maffiosi werden gepositioneerd als de elite van de natie."
                            },
                            {
                                "example_id": "c6bd9559-d8ef-446c-947d-2f8eca23e8f0",
                                "sense_id": "f7c239d1-f2d7-3f88-b771-05a8b0656aa7",
                                "text": "Het veld werd in de loop van de tijd gevarieerder, al bleef een achtergrond in het gymnasium noodzakelijk voor een succesvolle carrière, wat deelname aan atletiek de facto beperkte tot de elite en de stedelijke 'middenklasse'."
                            }
                        ]
                    },
                    {
                        "sense_id": "012268e9-a894-3494-bea3-650222a4cae9",
                        "entry_id": "ef2b02ee-abd3-3c49-97b0-15dfcd0c7dc8",
                        "glosses": [
                            "in de benaming van een product suggererend dat iets van hele goede kwaliteit is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae23d0c-806a-492f-8aca-c5af9fd982ab",
                                "sense_id": "012268e9-a894-3494-bea3-650222a4cae9",
                                "text": "De Autobianchi A112 lijkt meer een auto voor het gewone volk dan een auto voor de elite."
                            }
                        ]
                    }
