                        {
                            "text": "According to local legend, the king had <w>sired</w> many children across the realm."
                        }
                    ]
                },
                {
                    "sense_id": "a29b09e1-cf2b-3067-bffc-fc1ade15b05e",
                    "sense_definition": "In fantasy fiction, to transform someone into a vampire.",
