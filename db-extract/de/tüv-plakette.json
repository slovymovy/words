                        ],
                        "examples": [
                            {
                                "example_id": "33bd0d10-69b0-44cb-8aa1-6257b1bfdd48",
                                "sense_id": "748b3d51-2de3-3feb-8528-5fb72e4a6b3a",
                                "text": "Bevor sein Wagen die ersehnte TÜV-Plakette erhielt, musste Herr Müller allerhand Reparaturen vornehmen lassen."
                            },
                            {
                                "example_id": "e15f0cdf-e765-4415-9213-936442b72350",
                                "sense_id": "748b3d51-2de3-3feb-8528-5fb72e4a6b3a",
                                "text": "Für Igor mit seiner alten Rostlaube steht alle zwei Jahre wieder der Kampf um die TÜV-Plakette an."
                            }
