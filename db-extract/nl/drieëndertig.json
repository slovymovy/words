                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5714c4a-2c3a-475a-96fd-61a774f94e1b",
                                "sense_id": "832f870f-9e65-3b60-a36d-8108ae772b71",
                                "text": "Het is weer de drieëndertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "6f749514-be95-4b26-a0db-7db96a8a8b34",
                                "sense_id": "832f870f-9e65-3b60-a36d-8108ae772b71",
                                "text": "Haar vierendertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieëndertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "d603891a-e4a5-344d-a81b-6d6e1f95cf07",
                        "entry_id": "4b3f1672-2e3f-3d1b-a6e1-e8801a2e3e5d",
                        "glosses": [
                            "groep van 33 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43af1f85-9bf8-422b-a6f0-d624bb0d4e1e",
                                "sense_id": "d603891a-e4a5-344d-a81b-6d6e1f95cf07",
                                "text": "De drieëndertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
