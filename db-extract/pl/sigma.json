                    {
                        "translation_id": "952c9261-38b3-4bd3-8c3f-bf37a3f192b5",
                        "source_entry_id": "2cb4407f-90e6-3d54-a0fb-5594931f6445",
                        "source_sense_id": "36134bc2-bdd1-30c9-8e44-e4ffc9315b0b",
                        "target_lang_word": "sigma male",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sigma male",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f638dd35-e089-375f-8e2f-0fe01cccb124",
                                        "entry_id": "91a125ff-e11d-36f5-8405-6347d79c32cb",
                                        "glosses": [
                                            "A self-reliant and assertive male who occupies a position outside a social or group hierarchy; a lone wolf or maverick."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "humorous",
                                            "neologism",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd26f27-3e1e-4f31-bdfd-5cee6347eb65",
                                                "sense_id": "f638dd35-e089-375f-8e2f-0fe01cccb124",
                                                "text": "I was the timid boy, but now developed in the Sigma Male. Captain of my own tug boat, but soon I'll have that Yacht to Sail."
                                            },
                                            {
                                                "example_id": "27c9553a-2719-43a8-88f9-d1652071b8d9",
                                                "sense_id": "f638dd35-e089-375f-8e2f-0fe01cccb124",
                                                "text": "Recently, chatter on social media has people buzzing about the oh-so-rare sigma male."
                                            },
                                            {
                                                "example_id": "054c5b46-6e86-424c-adab-43199863ff74",
                                                "sense_id": "f638dd35-e089-375f-8e2f-0fe01cccb124",
                                                "text": "You can be a piece of shit and be an alpha male, but you can't be a piece of shit and be a high value man. Sigma male is getting closer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
