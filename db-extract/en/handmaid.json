                    {
                        "sense_id": "a4d8609b-5fef-3de3-816a-8a7f4c77511c",
                        "entry_id": "b9ed4618-783d-3a95-838a-5d306cac32ec",
                        "glosses": [
                            "A maid that waits at hand; a female servant or attendant."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "eea1c989-3a5a-4484-aa3e-96be2afd4354",
                                "sense_id": "a4d8609b-5fef-3de3-816a-8a7f4c77511c",
                                "text": "And on my servants and on my handmaidens I will pour out in those days of my Spirit; and they shall prophesy:"
                            }
                        ]
                    },
                    {
                        "sense_id": "5184017f-8377-3ed5-8937-bb13e345e4af",
