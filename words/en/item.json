                    "sense_definition": "A specific question or problem on a test or assessment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "test_question",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>item</w> on the exam was particularly difficult to answer.",
                            "target_lang_translations": {
                                "ru": "Это <w>задание</w> на экзамене было особенно трудным.",
                                "tr": "Sınavdaki bu <w>soruyu</w> cevaplamak özellikle zordu."
                            }
                        },
                        {
                            "text": "The test consists of fifty multiple-choice <w>items</w>.",
                            "target_lang_translations": {
                                "ru": "Тест состоит из пятидесяти <w>вопросов</w> с множественным выбором.",
                                "tr": "Test elli çoktan seçmeli <w>sorudan</w> oluşmaktadır."
                            }
                        }
                    ],
