                "senses": [
                    {
                        "sense_id": "00471c23-9093-3730-bcbb-3b8f821dbc02",
                        "entry_id": "00750622-e229-36de-a448-b943c12f4f49",
                        "glosses": [
                            "een verwarmingsinstallatie die via mechanische arbeid warmte onttrekt aan een koude omgeving en deze toevoert aan een warmere omgeving"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98bb56ce-ab84-4b76-ab1c-255e308b240f",
                        "source_entry_id": "00750622-e229-36de-a448-b943c12f4f49",
                        "source_sense_id": "00471c23-9093-3730-bcbb-3b8f821dbc02",
                        "source_sense_description": "een verwarmingsinstallatie die via mechanische arbeid warmte onttrekt aan een koude omgeving en deze toevoert aan een warmere omgeving",
                        "target_lang_word": "Wärmepumpe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wärmepumpe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                        "entry_id": "7802b01c-4d68-32ab-b946-9f4d4343bef5",
                                        "glosses": [
                                            "Gerät mit einem Kompressor, das Gebäude heizt, indem es Wärmeenergie von außen (beispielsweise aus der Luft oder dem oberflächennahen Erdboden) mit Hilfe einer im Kreislauf gepumpten Flüssigkeit überträgt"
                                        ],
                                        "tags": [
                                            "Energie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52db075-b43b-4cc9-83e1-709e01f8c848",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Auch wenn die meiste Energie aus der Umgebung genommen wird: Wärmepumpen brauchen zusätzlichen Strom, um den Elektromotor für Kompressor, Pumpen und Ventilatoren zu betreiben.“"
                                            },
                                            {
                                                "example_id": "5a4e5caa-da11-4126-b5e5-5cd8bc7028ba",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Am besten fürs Klima ist es, wenn die Wärmepumpe mit Ökostrom betrieben wird.“"
                                            },
                                            {
                                                "example_id": "f32e486c-da68-437e-a91a-97513c5e5a5d",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "Mit einer Wärmepumpe erzeugt man aus einer Kilowattstunde Strom ca. drei bis vier Kilowattstunden Wärme."
                                            },
                                            {
                                                "example_id": "93344101-e7ef-4219-b571-6c5d662d14e9",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„»Wärmepumpen nutzen erneuerbare Energien und können aus einer Einheit Strom drei bis vier Einheiten Wärme erzeugen«, so der Bereichsleiter für klimaneutrale Gebäude.“"
                                            },
                                            {
                                                "example_id": "db3c7182-e46c-4b41-9942-6404f14cde20",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Wärmepumpen nutzen Umweltwärme aus Luft, Wasser oder Erde und sind klimafreundlich.“"
                                            },
                                            {
                                                "example_id": "ffdd6bec-b096-465e-bc3d-1507d01d2e49",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Es gibt verschiedene Arten von Wärmepumpen, sie alle funktionieren nach demselben Prinzip und entziehen entweder dem Wasser, der Erdreich oder der Luft Wärmeenergie.“"
                                            },
                                            {
                                                "example_id": "4943aeb1-e223-4f56-a7d1-b3e390d8fe5c",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Öl und Gas sind teuer und sie befeuern den Klimawandel. Kein Wunder, dass immer mehr Hauseigentümer auf Wärmepumpen setzen.“"
                                            },
                                            {
                                                "example_id": "60933793-8ebf-4f7c-a0b3-5c28eec5f87e",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Eine Wärmepumpe ist eine erhebliche Investition.“"
                                            },
                                            {
                                                "example_id": "52b126cc-f0e9-401d-bda1-a4a6bf215320",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Wärmepumpen sind wesentlich teurer als Gas- oder Ölbrenner, denn die Technik ist aufwendig, die Konstruktion komplexer.“"
                                            },
                                            {
                                                "example_id": "492ddd59-51fb-4806-8468-8b81280e135f",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "[2022:] „Wärmepumpen, die mit Strom betrieben werden, sind kaum noch zu bekommen.“"
                                            },
                                            {
                                                "example_id": "8a6afca5-d90a-4e03-ae6c-674c79368ea4",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Allerdings braucht die Wärmepumpe für ihren Betrieb in der Regel Strom.“"
                                            },
                                            {
                                                "example_id": "3e9dc72e-9d2d-4ecc-9e88-95ca81e9f145",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Die Wärmepumpe ist prinzipiell ein geniales Gerät: Man investiert eine Einheit Strom und gewinnt dadurch drei, vier oder sogar fünf Einheiten Wärme - gleichsam gratis aus der Umwelt.“"
                                            },
                                            {
                                                "example_id": "b2feba8e-f5cf-437b-ae27-dc84db0dfa82",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Mit einer Wärmepumpe lassen sich Heizkosten reduzieren. Man bekommt die etwa dreifache Wärmemenge für eine Energieeinheit an Arbeit am Kompressor.“"
                                            },
                                            {
                                                "example_id": "4c574ab8-6fea-44a7-81f0-f3e200af950f",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Bei neuen gedämmten Gebäuden sind Wärmepumpen effizienter.“"
                                            },
                                            {
                                                "example_id": "eb626226-c75a-4747-bb5e-79abcb17b77f",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Heizungsrohre in den Fußböden oder extragroße Heizkörper machen eine Wärmepumpe erst wirklich effizient.“"
                                            },
                                            {
                                                "example_id": "1bd60ef8-eb0a-4ae4-aad5-6becb043b024",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„»Jedes Grad weniger für die Temperatur des Heizungswasser verbessert die Effizienz der Wärmepumpe um 3,5 Prozent«, sagt Werner Schenk, Experte für Wärmepumpen an der Hochschule München der DW.“"
                                            },
                                            {
                                                "example_id": "0dd675b2-6ed6-4563-b1c3-beed9bb87aeb",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Zusätzliche Heizkörper oder eine Fußbodenheizung senken die nötige Vorlauftemperatur und erhöhen so die Effizienz der Wärmepumpe.“"
                                            },
                                            {
                                                "example_id": "b36baf25-c425-4ae7-a22d-703151963130",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Grundsätzlich können Wärmepumpen Heiztemperaturen von über 70 Grad erzeugen und damit auch ungedämmte Häuser mit alten Heizköpern heizen.“"
                                            },
                                            {
                                                "example_id": "6bf35eff-3dbe-48af-92d9-6fc06d131489",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Ob sich im Altbau eine Wärmepumpe nachrüsten lässt, dafür gibt es einen einfachen Test: An einem sehr kalten Tag im Winter die Vorlauftemperatur begrenzen.“"
                                            },
                                            {
                                                "example_id": "47f65e5b-4f11-414b-8132-e6ec7572dffa",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Die EU schreibt zudem vor, dass in den nächsten Jahren zunehmend umweltfreundliche Kältemittel in Wärmepumpen und Klimaanlagen eingesetzt werden müssen.“"
                                            },
                                            {
                                                "example_id": "05c78221-1c61-4f98-acce-15d665694fd9",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Für den Tausch einer Gas- oder Ölheizung gegen eine Wärmepumpe gibt es aber auch einen Zuschuss von bis zu 35 Prozent auf die gesamten Investitionskosten.“"
                                            },
                                            {
                                                "example_id": "a510d4be-eed6-4a42-b6eb-39d41557fe64",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "[Bis zum Jahr 2030 werden] „für die Klimaziele aber 4,5 bis 6 Millionen Wärmepumpen benötigt.“"
                                            },
                                            {
                                                "example_id": "5150b099-3fcf-48a0-a2e1-611abb4d6efe",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Reinhard Kuhn hat in seinem neuen Haus in Burgthann eine Wärmepumpe mit Photovoltaik kombiniert. Wärme und Strom produziert er fast ausschließlich selbst.“"
                                            },
                                            {
                                                "example_id": "0a3fd825-05c8-4aee-980e-ebf4acca9637",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„Moderne Wärmepumpen können umschalten und dann auch kühlen.“"
                                            },
                                            {
                                                "example_id": "e62f81c0-8737-48ad-b46c-465feefaee16",
                                                "sense_id": "67df5444-906f-3ede-9830-a91bf1248366",
                                                "text": "„In jedem zweiten Neubau wird laut Statistischem Bundesamt eine Wärmepumpe eingebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
