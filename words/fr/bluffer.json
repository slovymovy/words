{
    "word_family": [
        "bluff",
        "bluffeur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3bf86af-a46d-31b3-8a7a-a420063b3c05",
                    "sense_definition": "Impressionner vivement ou étonner quelqu'un par ses qualités ou ses actes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "impressionner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La performance de ce jeune musicien a complètement <w>bluffé</w> le public."
                        },
                        {
                            "text": "Ses connaissances en histoire continuent de me <w>bluffer</w> chaque jour."
                        }
                    ],
                    "synonyms": [
                        "épater",
                        "impressionner",
                        "étonner"
                    ],
                    "common_phrases": [
                        "bluffer le public",
                        "se faire bluffer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou courant"
                        }
                    ]
                },
                {
                    "sense_id": "ce563ee7-203a-394e-b6d6-a2a4833b2a38",
                    "sense_definition": "Dans un jeu de cartes, faire croire à ses adversaires que l'on possède une meilleure ou une moins bonne main qu'en réalité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'avait aucune bonne carte mais il a décidé de <w>bluffer</w> jusqu'au bout."
                        },
                        {
                            "text": "Tu <w>bluffes</w> souvent au poker pour pousser les autres à se coucher."
                        }
                    ],
                    "common_phrases": [
                        "bluffer au poker"
                    ]
                },
                {
                    "sense_id": "2fb70a00-b065-391d-8ad7-293ec4a5866c",
                    "sense_definition": "Chercher à intimider ou tromper autrui par une attitude trompeuse pour obtenir un avantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intimider",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le négociateur tente de <w>bluffer</w> afin de masquer ses faiblesses."
                        },
                        {
                            "text": "Ne te laisse pas intimider, il <w>bluffe</w> pour gagner du temps."
                        }
                    ],
                    "synonyms": [
                        "feindre",
                        "tromper",
                        "leurrer"
                    ]
                },
                {
                    "sense_id": "077670a4-650f-330b-9fc2-c9b3fb64c666",
                    "sense_definition": "Fasciner, séduire ou charmer quelqu'un de manière inattendue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impressionner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès leur première rencontre, cette femme l'a totalement <w>bluffé</w> par son charme."
                        },
                        {
                            "text": "Elle sait comment <w>bluffer</w> son entourage grâce à son élégance naturelle."
                        }
                    ],
                    "synonyms": [
                        "séduire",
                        "charmer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage familier"
                        }
                    ]
                }
            ]
        }
    ]
