                                "sense_id": "36091736-e139-33dc-8321-262593ce6ef9",
                                "text": "„Boss, gehe aus der Schusslinie! Ich habe das Reh im Visier!“"
                            },
                            {
                                "example_id": "4491d9f4-7f4a-401b-bce9-08390181f408",
                                "sense_id": "36091736-e139-33dc-8321-262593ce6ef9",
                                "text": "„Nein, ich interessiere mich nur für die Tiere, die bisweilen in der Schusslinie sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
