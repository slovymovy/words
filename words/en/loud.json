                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сильный или едкий запах; часто используется для описания высококачественной марихуаны.",
                        "tr": "Çok güçlü veya keskin bir kokuya sahip olan.",
                        "zh": "具有强烈或刺鼻的气味；常用于描述高质量的大麻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о запахе"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о запахе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "keskin",
                                "target_lang_sense_clarification": "koku için"
                            },
                            {
                                "target_lang_word": "ağır",
                                "target_lang_sense_clarification": "yoğun koku"
                            }
                        ],
                        "zh": [
