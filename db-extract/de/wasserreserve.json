                "senses": [
                    {
                        "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                        "entry_id": "d6739b1d-aa82-3632-a53f-5beb2f8c30ce",
                        "glosses": [
                            "Vorrat an Wasser, der für späteren Verbrauch vorgesehen ist"
                        ],
                        "tags": [
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c39c5e5f-3499-46c4-9f6f-f9564a7794b6",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Seit Monaten regnet es in Katalonien kaum, die Wasserreserven sind knapp.“"
                            },
                            {
                                "example_id": "b57d22a6-953d-4021-b861-97739c913a05",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Die Schweiz weist Wasserreserven im Umfang von schätzungsweise 340 Milliarden m³ auf.“"
                            },
                            {
                                "example_id": "7d5a58c8-cf17-4b56-8461-716a7bccce68",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Dank des ergiebigen Regens der letzten 6 Wochen sind die Grundwasserspeicher randvoll. Selbst eine andauernde Trockenheit in den nächsten Monaten wäre keine ernste Gefahr für unsere Wasserreserven.“"
                            },
                            {
                                "example_id": "406e3366-2435-4a70-899a-3564dfba36b4",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "[Saudi-Arabien:] „Experten schätzen deshalb, dass die unterirdischen Wasserreserven 2050 verbraucht sein werden.“"
                            },
                            {
                                "example_id": "2a36c788-c95c-4fa7-82fe-5ffe6956b126",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Die Golanhöhen mit ihren Wasserreserven, die einen Großteil des Landes versorgen, sind ebenso wie der Gipfel des Hermon, der die gesamte Region überragt, strategisch wichtig für den israelischen Staat.“"
                            },
                            {
                                "example_id": "33dd4e40-e838-40c4-8bdf-e9b58c73e7bc",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "[Namibia:] „Bereits zu jenem Zeitpunkt gingen die Wasserreserven zur Neige, doch jetzt ist der Damm nahezu leer.“"
                            },
                            {
                                "example_id": "b9e6dc97-7ec7-4085-8c7c-b8d96e4a7181",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Nach dem Sechs-Tage-Krieg von 1967 wurde den Dörfern und Städten im Westjordanland die Kontrolle über diese wichtige Wasserreserve entzogen.“"
                            },
                            {
                                "example_id": "ae29e27a-ae63-46aa-b9ce-3df6fb7a7236",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Wie kein anderes Land setzt China auf Staudammprojekte, um den steigenden Energiebedarf zu decken und als Wasserreserve für die Landwirtschaft, die immer mehr Menschen ernähren muss.“"
                            },
                            {
                                "example_id": "be9ac7b2-46e4-480e-98e4-8eb29c7a7f40",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„»Auf dieser Datenbasis können die verfügbaren Wasserreserven in den Regionen besser ermittelt werden«, sagte der Sprecher.“"
                            },
                            {
                                "example_id": "fda9bfcb-15b1-47ec-9c77-f9ab3cb91710",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Das Wasserwerk an der Neiße in Görlitz ist wegen des Hochwassers außer Betrieb. Die Stadtwerke Görlitz teilten am Sonntag mit, dass die Wasserreserve für knapp einen Tag reiche.“"
                            },
                            {
                                "example_id": "c3244cc3-f38f-402c-8573-b417b77d6251",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Ohne Wasser, zu wenig Strom: Damit das nicht eintrifft, will die Elektrizitätskommission Elcom eine Wasserreserve schaffen. Die Produzenten sollen eine gewisse Menge Wasser in ihren Stauseen zurückhalten, um die Turbinen anzuwerfen, wenn der Strom knapp ist.“"
                            },
                            {
                                "example_id": "cc77a6fe-a80c-4efd-bef3-ed7559439e1a",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Die Wasserreserven in den Alpen wären auch nicht genügend gross, um während Wochen und Monaten die Schweiz flächendeckend und rund um die Uhr mit Strom zu versorgen.“"
                            },
                            {
                                "example_id": "239ab0fd-18d1-41b8-a64f-1f1ec4fe583c",
                                "sense_id": "0a273165-4270-3595-8f1c-300a8bfa944a",
                                "text": "„Ich hielt meine beiden Plastikflaschen unter den rostigen Hahn und füllte meine Wasserreserven auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
