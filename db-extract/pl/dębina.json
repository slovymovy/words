                        "translation_id": "b43cff64-efc1-4763-8a1c-d25a163f8686",
                        "source_entry_id": "a3f87ba7-e21d-3b23-b9b8-67e19d8563fd",
                        "source_sense_id": "8e23bc32-ae69-3590-9a02-f3f34e1ce1ae",
