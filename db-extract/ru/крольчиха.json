                "senses": [
                    {
                        "sense_id": "d5cdfa8f-2623-36bf-bd8e-1955c88873d5",
                        "entry_id": "051dd4ff-6554-38f3-a838-dab2ba463623",
                        "glosses": [
                            "female equivalent of кро́лик (królik): female rabbit (doe)"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "fd04ea35-4f9f-4adb-9e7b-1014daa7cf14",
                                "sense_id": "d5cdfa8f-2623-36bf-bd8e-1955c88873d5",
                                "text": "Крольчи́ха мо́жет вести́ себя́ агресси́вно, защища́я своё пото́мство.",
                                "translation": "A female rabbit may behave aggressively protecting her offspring.",
                                "english": "A female rabbit may behave aggressively protecting her offspring."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7f0d509-024b-3d82-9f52-f28abf150b5c",
                        "entry_id": "051dd4ff-6554-38f3-a838-dab2ba463623",
                        "glosses": [
                            "mother of many children"
                        ],
                        "tags": [
                            "derogatory",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9cffe859-8016-4330-a7ae-4b711d295116",
                                "sense_id": "f7f0d509-024b-3d82-9f52-f28abf150b5c",
                                "text": "Но крольчи́ха-мать в очередно́й раз ки́нула своего́ ребёнка, на сей раз ста́ршую дочь.",
                                "translation": "But that overly fertile mom once again abandoned her child, this time her eldest daughter.",
                                "english": "But that overly fertile mom once again abandoned her child, this time her eldest daughter."
                            }
                        ]
                    }
                ],
