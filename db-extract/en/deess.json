                        "examples": [
                            {
                                "example_id": "ca3f1472-b81d-4cfc-a43a-a3ddb02a6459",
                                "sense_id": "12c331dd-5aba-304b-82d6-7692994672e0",
                                "text": "He does so much magnifie Nature and her actings in all this material world, as he gives just cause of suspicion that he hath made her a kind of joint deess with God in the affairs thereof."
                            },
                            {
                                "example_id": "9f2ce88a-d6e6-455e-8924-09c04b2a403b",
                                "sense_id": "12c331dd-5aba-304b-82d6-7692994672e0",
                                "text": "The Hindus \"take the bull by the horns\" and boldly make \"sítlá\" (small-pox) a goddess, an incarnation of Bhawáni, deëss of destruction-reproduction."
                            }
                        ]
                    }
