                "senses": [
                    {
                        "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                        "entry_id": "76a83a69-4405-3db9-9bf7-c19dba6b8ffc",
                        "glosses": [
                            "Adresse, die verwendet wird, um die richtige Adresse geheimzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a946ad-6e9f-4429-8980-22b751f9fabf",
                                "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                                "text": "Unter einer Deckadresse betrieb er einen schwunghaften Handel mit Kinderpornografie."
                            },
                            {
                                "example_id": "89f5e4a0-6118-4072-893e-b04cc4c6f943",
                                "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                                "text": "„[…] — durch Beobachtung dieses Verkehrs sind wir voriges Jahr, erinnern Sie sich, in der Sache Wielands, auf die Spur der Deckadresse von Arlsberg gekommen, — […].“"
                            },
                            {
                                "example_id": "6eb1d78d-26a2-40e9-9e8b-d81c59a422b7",
                                "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                                "text": "„Kannst du mir wenigstens eine Deckadresse mitgeben, an die wir dir Material schicken können?“"
                            },
                            {
                                "example_id": "12196796-a9cd-4763-a6f5-11241704ab04",
                                "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                                "text": "„Selbst nahe Freunde wußten seine schwedische Adresse nicht; seine gesamte Korrespondenz leitete er über eine Deckadresse in Zürich.“"
                            },
                            {
                                "example_id": "778d3e50-4bf7-42bc-830d-70d1be0bde34",
                                "sense_id": "3e4daacf-6450-30a3-8b41-7242448e391b",
                                "text": "„Die Deckadresse (DA) stellte eine unpersönliche Verbindung zwischen operativem Mitarbeiter und dem lM dar. Der Inhaber einer Deckadresse nahm Postsendungen nach außen hin als rechtmäßiger Empfanger an und gab sie unter konspirativen Bedingungen an den operativen Mitarbeiter weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
