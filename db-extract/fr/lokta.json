                        "entry_id": "679bea8c-5a5d-358a-8384-0087f3a0c707",
                        "glosses": [
                            "Synonyme de laurier du Népal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928748df-42e0-4ae0-85eb-bffdb98f6c80",
                                "sense_id": "ac88afc5-f302-3899-800f-c3ea928b899e",
                                "text": "Il s’agit d’ingrédients naturels dont des poudres de santal, de dammar, de nard, de cannelle, de girofle, enroulés dans une feuille de papier fabriquée à partir de la fibre d’écorce de lokta, le « laurier du Népal »."
                            },
                            {
                                "example_id": "6e3571a9-bf37-4b69-9715-8057670c9f8a",
                                "sense_id": "ac88afc5-f302-3899-800f-c3ea928b899e",
                                "text": "Pour information, le lokta est un laurier du Népal : un petit arbuste qui pousse au-dessus de 3000 mètres d'altitude dans les contreforts himalayens."
                            }
                        ]
                    },
                    {
                        "sense_id": "112a3f0b-d559-3633-83e2-cc407ae1a814",
                        "entry_id": "679bea8c-5a5d-358a-8384-0087f3a0c707",
                        "glosses": [
                            "Papier obtenu à partir de son écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5b50e8-219e-456d-8291-bad9a06d53b2",
                                "sense_id": "112a3f0b-d559-3633-83e2-cc407ae1a814",
                                "text": "Les loktas sont parfaits pour l'encadrement, les meubles en carton, le cartonnage et tous les loisirs créatifs grâce à la belle matière du papier."
                            }
                        ]
                    }
