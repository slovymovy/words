                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd070a9-112e-4685-bd79-213429d1cb25",
                                                "sense_id": "ba5c58a5-c4ee-3847-bfaf-98253df63de5",
                                                "text": "Die Gang brach nachts ins Haus ein."
                                            },
                                            {
                                                "example_id": "30e1dd38-31c5-475d-b76b-f535324affa5",
                                                "sense_id": "ba5c58a5-c4ee-3847-bfaf-98253df63de5",
                                                "text": "„Die Gang verstellte dem Fotografen den Weg und stellte ihm die Frage, was er denn hier mache.“"
                                            }
                                        ],
