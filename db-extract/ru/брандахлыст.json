                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee93c99f-d067-3aaa-996e-be5b10d2ba83",
                        "entry_id": "f2ad50bf-e58c-3f36-91a6-e66e03c36e56",
                        "glosses": [
                            "устар., разг. плохой, слишком жидкий напиток, пища"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c8ad61b-09fd-48f7-bc02-efa59fd88c9f",
                                "sense_id": "ee93c99f-d067-3aaa-996e-be5b10d2ba83",
                                "text": "Утренний завтрак упростился: вместо шоколада — хотя бы слабого — давали брандахлыст с флотилией чаинок…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e6e4369-6156-4f73-9b32-e91ba1a9fd2e",
                        "source_entry_id": "f2ad50bf-e58c-3f36-91a6-e66e03c36e56",
                        "source_sense_id": "ee93c99f-d067-3aaa-996e-be5b10d2ba83",
                        "source_sense_description": "плохая еда, питьё",
                        "target_lang_word": "wish-wash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wish-wash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed2e6d51-255d-3e0e-86fc-e8b1b830a84e",
                                        "entry_id": "e9a07dfb-9129-33af-8ff5-b3ecd3d9d443",
                                        "glosses": [
                                            "Any weak, thin drink."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04847fd9-7625-42ca-9a5c-5dc08597417d",
                                                "sense_id": "ed2e6d51-255d-3e0e-86fc-e8b1b830a84e",
                                                "text": "Between the result of the above, and the ordinary wish-wash served as coffee, the difference is too great to be expressed."
                                            },
                                            {
                                                "example_id": "1373748c-49b8-4369-bdc4-64460aeab897",
                                                "sense_id": "ed2e6d51-255d-3e0e-86fc-e8b1b830a84e",
                                                "text": "The famous bohemian cafés, the Dôme, the Coupole and the Rotonde, still remained; the hooded iron stove still warmed the regulars settled beside the round tables from the wintry streets; the waiter, with the unvarying rudeness of Paris, served the \"national coffee,\" that grayish-brown wish-wash which passed for coffee in Paris and which, like everything labeled \"national,\" roused the suspicion that it wasn't what it was called but only resembled the real thing."
                                            },
                                            {
                                                "example_id": "ec7fc0a6-4bf4-425e-9610-ab03c43b25ad",
                                                "sense_id": "ed2e6d51-255d-3e0e-86fc-e8b1b830a84e",
                                                "text": "They got 250 grams of bread and wish-wash for breakfast; in the evening, he who had worked got kasha, wish-wash, and bread."
                                            },
                                            {
                                                "example_id": "1f3233f5-83a3-4303-a9d0-7dd8bba38d93",
                                                "sense_id": "ed2e6d51-255d-3e0e-86fc-e8b1b830a84e",
                                                "text": "It consisted of bread and for the first course \"the usual wish-wash” (balanda), “so-called soup in which several pieces of congealed cabbage floated.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                        "entry_id": "e9a07dfb-9129-33af-8ff5-b3ecd3d9d443",
                                        "glosses": [
                                            "Talk, music, or art, or ideas that lack any value, substance, originality, or meaning; dreck."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d561c1-b568-48b2-8ab5-28abdef9715f",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "It is a thing that fails altogether to interest; a wish-wash that only serves to pass the time."
                                            },
                                            {
                                                "example_id": "e0cb12c9-bb47-4657-9c86-a304344ed70c",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "They confined their sermons on Sunday to the decorous wish-wash in which average men treated in a harmless way subjects to which the people were indifferent."
                                            },
                                            {
                                                "example_id": "b81660cb-92e3-4d4c-a7b0-dd956713fde5",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "it is a clearing away of the wish-wash which assumes that lack of national distinction is an international virtue."
                                            },
                                            {
                                                "example_id": "b0d109f4-a83e-407d-b995-d49697714421",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "What I am doing is asking the senator to explain why Labor has come up with such wish-wash on this matter."
                                            },
                                            {
                                                "example_id": "1b09f7ce-e327-4a58-b72f-4c3e4346d743",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "But then all of that seems to be a bunch of wish-wash—nothing more than lip service."
                                            },
                                            {
                                                "example_id": "256db151-7e64-4160-9fed-b1da7e839f5b",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "This simile is accurate only if the object of analysis is considered in a void, but in the context of \"an old Germanic culture\" the performance loses its value and becomes only a \"wish-wash.\""
                                            },
                                            {
                                                "example_id": "352035d3-31c9-4897-bf68-940e0ff86163",
                                                "sense_id": "4e7254fa-6bcb-3929-8b24-c3fff319945a",
                                                "text": "And Ralph Vaughan Williams 'is now a solitary figure, for his influence has served to produce a steady trickle of pentatonic wish-wash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0757405-0b55-3cf5-90d4-9fc9c196fca5",
                                        "entry_id": "e9a07dfb-9129-33af-8ff5-b3ecd3d9d443",
                                        "glosses": [
                                            "The sound of liquid sloshing"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7cbcc56-ed74-4bcc-aff6-fc6b744e5abd",
                                                "sense_id": "a0757405-0b55-3cf5-90d4-9fc9c196fca5",
                                                "text": "Martha steadily turned and turned, and the cream within the snowy white sycamore box went 'wish-wash, wish-wash, wish-wash, playing, after all, a very delicious tune in the young farmer's ears, for it suggested yellow butter, and yellow butter suggested sovereigns, and sovereigns suggested home comforts and saving, and above all, the turning of that handle suggested the winning of just the very wife to occupy that home."
                                            },
                                            {
                                                "example_id": "a59b0dbe-88ec-41e8-bdcc-075bfd9ffc33",
                                                "sense_id": "a0757405-0b55-3cf5-90d4-9fc9c196fca5",
                                                "text": "Then in the morning the washing of the deck; rush comes an engine pipe on the floor–ceases, is renewed, flourishes about, rushes again; then suddenly half a dozen brooms, wish-wash, wish-wash, scrib-scrub, scratching and roaring alternately."
                                            },
                                            {
                                                "example_id": "dbfb7394-677b-48e9-bc77-cd0a29cc49b1",
                                                "sense_id": "a0757405-0b55-3cf5-90d4-9fc9c196fca5",
                                                "text": "As they lay there, dazedly reliving the adventure that had brought them to this place, they heard the sound of the wish-wash-wish of lapping water."
                                            },
                                            {
                                                "example_id": "d216af50-8825-4126-999a-f278da8a35ce",
                                                "sense_id": "a0757405-0b55-3cf5-90d4-9fc9c196fca5",
                                                "text": "Yet at these moments, that sound was not a single sound. There was another beat in the warmth of the wish-wash."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wish-wash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                        "entry_id": "ed0d470d-609e-3cb1-a694-ddea36bb7c87",
                                        "glosses": [
                                            "Vapid; lackluster; mediocre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674ad6ca-4362-4f5d-b714-915c9a5df9cd",
                                                "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                                "text": "Of course we fear to address ourselves to those gentlemen whose reading is limited to the daily newspaper and novels of the wish-wash order."
                                            },
                                            {
                                                "example_id": "22308279-1a20-4262-8fc7-92d74a485fc3",
                                                "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                                "text": "To suit a degraded English taste, foreigners like the late Mr. Lŏhr, had to write down to the level of the wish-wash drawing-room ballad."
                                            },
                                            {
                                                "example_id": "63094350-e35e-43f7-bf97-e3c29d4b310d",
                                                "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                                "text": "After-effects are in this case in absolute opposition to first impressions —indeed nothing could better betoken a variation of the wish-wash order than that it should be instantly appreciated."
                                            },
                                            {
                                                "example_id": "8e060e30-4264-45f9-9d3e-4760c8d7cbf3",
                                                "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                                "text": "With an example of the wish-wash composer, and his wish-wash lady love, before my eyes, I could only congratulate the Philistines."
                                            },
                                            {
                                                "example_id": "259cc6cc-2774-4c97-91d1-0f1aad316da9",
                                                "sense_id": "1179924e-26b8-3e43-bff4-fb29f48c5810",
                                                "text": "By the time it gets to that point they are already disccouraged because they have been discouraged from the fact that they are looked upon as the wish-wash, that they are not going to make it in the entertainment industry and right there that is a discouraging factor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78cb225-43c8-38c7-b1cd-ff10f075a41b",
                                        "entry_id": "ed0d470d-609e-3cb1-a694-ddea36bb7c87",
                                        "glosses": [
                                            "Unfocussed, meandering or impulsive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca060411-9052-4582-99b5-537201566fda",
                                                "sense_id": "f78cb225-43c8-38c7-b1cd-ff10f075a41b",
                                                "text": "While you are sitting by the side of the placid Thames, under shades of your own planting, planning the operations of a next winter's campaign, we are in the wish-wash way at Margate, amidst deep caverns, high cliffs, and expanded waters, enjoying the less calm, but more sublime objects of Nature."
                                            },
                                            {
                                                "example_id": "2221a3e0-c57e-4c90-b3cb-0265b03dccb6",
                                                "sense_id": "f78cb225-43c8-38c7-b1cd-ff10f075a41b",
                                                "text": "Be nothing, do nothing, say nothing, and the world will let you slip into eternity damned by your own wish-wash, willy-nilly life."
                                            },
                                            {
                                                "example_id": "9d0c44c4-4a18-4445-b7a5-69ec9faa52fc",
                                                "sense_id": "f78cb225-43c8-38c7-b1cd-ff10f075a41b",
                                                "text": "he had a wish-wash way of regarding matters."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wish-wash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                        "entry_id": "2eaf83ee-9727-3710-bebd-4d6c8e48f9c0",
                                        "glosses": [
                                            "To slosh around."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df1c6661-9df6-4626-bf41-beb9a2d3ae8b",
                                                "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                                "text": "And that night, with the stars jumping and the air lating cold (for we were up in the 40's), and the John wish-washing through the seas at three leagues the hour, MacMuir told me the story of Mungo Maxwell."
                                            },
                                            {
                                                "example_id": "48c8f4c2-ea0e-4640-9463-445bca0b8de1",
                                                "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                                "text": "A little scalloped cove where weedy creatures Trail in and out, wish-washing on the tide ."
                                            },
                                            {
                                                "example_id": "4f659b15-8fc3-4715-83c3-226c6e7b1090",
                                                "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                                "text": "The sea doesn't care about you and me, It goes on all the time Wish-wish-washing away out there (In a way that tells you it doesn't care) With a sort of wistful weary rhyme, The sad old song of the sea."
                                            },
                                            {
                                                "example_id": "d8049615-1478-468f-8071-c6aa80f439ab",
                                                "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                                "text": "Where the waves wish-wash, and the foghorn blows, And the blowfish nibble at your toes - oes - oes, The blowfish nibble at your toes."
                                            },
                                            {
                                                "example_id": "3bc56336-63f4-4f25-a336-bd5a5c2013bf",
                                                "sense_id": "649af032-b149-3a1b-aaa9-20959dd39274",
                                                "text": "This you will understand when I tell you that in consequence of these same defects I have had water an inch or two deep in my cabin, wish-washing about ever since we left Madeira."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84487c80-26b5-3ec2-91fd-0f1fee0828cf",
                                        "entry_id": "2eaf83ee-9727-3710-bebd-4d6c8e48f9c0",
                                        "glosses": [
                                            "To behave in a wishy-washy manner, to vacillate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a77cf8b-a40e-47e0-b5aa-278394d0ccc3",
                                                "sense_id": "84487c80-26b5-3ec2-91fd-0f1fee0828cf",
                                                "text": "Hain't been a fair election in 15 years to my knowing, and I am confident about what I am talking about, but I am getting sick and tired of this wish-washing about eating tickets; have known them to do this after election."
                                            },
                                            {
                                                "example_id": "cfac58b8-a87b-42a8-bfb9-39a16980fa69",
                                                "sense_id": "84487c80-26b5-3ec2-91fd-0f1fee0828cf",
                                                "text": "With his eyes glued on the fall elections, President Truman is wish-washing this country into certain war with Russia ."
                                            },
                                            {
                                                "example_id": "dcaac7ed-ee10-4cb5-be48-020ed01348b5",
                                                "sense_id": "84487c80-26b5-3ec2-91fd-0f1fee0828cf",
                                                "text": "What would your brother do if he found out you were drawing up blood pacts and then wish-washing your way through them?"
                                            },
                                            {
                                                "example_id": "8031f097-a620-4649-ac82-a34b904233cc",
                                                "sense_id": "84487c80-26b5-3ec2-91fd-0f1fee0828cf",
                                                "text": "For someone who went on a whole rant about sentimental wish-washing and the pitfall of emotions, he sure did a whole lot of wish-washing and pitfalling himself back in his days, didn't he?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5c5445b-8c9e-49c3-b3ac-1fb0f5265c72",
                        "source_entry_id": "f2ad50bf-e58c-3f36-91a6-e66e03c36e56",
