                "senses": [
                    {
                        "sense_id": "a63fa542-3556-3d9a-86aa-e0be6eb2ccd4",
                        "entry_id": "4c2762dc-e123-312b-99d5-952ad5345103",
                        "glosses": [
                            "The middle of the anterior margin of the foramen magnum of the skull."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b603270f-f00d-45ed-9601-e38756f60136",
                                "sense_id": "a63fa542-3556-3d9a-86aa-e0be6eb2ccd4",
                                "text": "In order to determine the distance of the zygomaxillare and the first molar from the basion (or prosthion), isosceles triangles were constructed from the measurements, which on one hand had the basion for the apex, the distance connecting both molar middle points as the base and the basion-first molar distance as the legs (Fig. 4. A), and on the other hand they had the distance between both zygomaxillaria as the base and the basion-zygomaxillaria as the base and the basion-zygomaxillary distance as the legs (Fig. 4. B)."
                            },
                            {
                                "example_id": "1b81f5bd-499d-46e5-aaaa-7d3fab773c47",
                                "sense_id": "a63fa542-3556-3d9a-86aa-e0be6eb2ccd4",
                                "text": "Additional skull measurements, taken with small sliding calipers, were from zygomaxillare, the lowest point on the zygomatic-maxillary suture, to the points of alveolare, basion and nasion."
                            },
                            {
                                "example_id": "17e8acb2-4bd7-46f0-acf9-51559a7455d2",
                                "sense_id": "a63fa542-3556-3d9a-86aa-e0be6eb2ccd4",
                                "text": "The tectorial membrane limits extension, while odontoid impaction on the basion limits flexion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
