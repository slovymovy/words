                        "glosses": [
                            "To explicate again; to analyze or explain again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc1ea59d-9167-4557-83d8-222a1cb2de0a",
                                "sense_id": "b1be333b-a91d-3dff-88ee-dc9e72ec9154",
                                "text": "He was to reexplicate the poem, as his professor was not satisfied with his work."
                            },
                            {
                                "example_id": "67f415ac-a4f4-46a3-9b5a-77adee152f29",
                                "sense_id": "b1be333b-a91d-3dff-88ee-dc9e72ec9154",
                                "text": "When one refers to a case, one has to reexplicate the case and indicate why it is relevant in the present dispute."
                            },
                            {
                                "example_id": "16399cfc-5bbf-483f-b609-663c0605f1a1",
                                "sense_id": "b1be333b-a91d-3dff-88ee-dc9e72ec9154",
                                "text": "In addition to this periodization and the appended bibliography of materials which rearticulate and reexplicate the 'peoplehood' to whom the concept of Italicity may be appropriate, the following sources are included: […]"
                            },
                            {
                                "example_id": "35235424-b497-4fc3-8304-57a069fc66c9",
                                "sense_id": "b1be333b-a91d-3dff-88ee-dc9e72ec9154",
                                "text": "Yet Mami makes me repeat and reexplicate everything I say as though she's a dim-witted, illiterate, recently arrived, monolingual refugee."
                            },
                            {
                                "example_id": "3ed62855-349c-4d21-8d33-8b0c2be62862",
                                "sense_id": "b1be333b-a91d-3dff-88ee-dc9e72ec9154",
                                "text": "[…] there ARE patterns that repeat themselves from novel to novel and that when they are recognized, they can be used to reexplicate the novels that have gone before them or those that follow: […]"
                            }
                        ]
                    }
