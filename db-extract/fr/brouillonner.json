                                "example_id": "95890a0e-c542-493a-b5f1-8e592bb75754",
                                "sense_id": "6fd9831a-43b2-3c72-aae1-79363a9fad7c",
                                "text": "Il n’aime pas Blanqui, et à la première ligne qu’il brouillonne, rejette sur lui la responsabilité de l’attaque et de la condamnation."
                            },
                            {
                                "example_id": "99f3e690-5643-47a7-8bae-1cddf950e78c",
                                "sense_id": "6fd9831a-43b2-3c72-aae1-79363a9fad7c",
                                "text": "Pendant que je rage, les autres « brouillonnent » déjà."
                            }
                        ]
