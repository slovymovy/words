                        "entry_id": "f6408dbb-4658-326b-8c80-345224e32ab2",
                        "glosses": [
                            "The faction of the Industrial Workers of the World in the 20th century which favored direct action."
                        ],
                        "tags": [
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3fd9974e-9820-45b8-a340-7485e7d34615",
                                "sense_id": "6100e868-a552-3120-84f9-6b60e3fd4009",
                                "text": "When De Leon broke with the I. W. W. in 1908 there were again members of the Party who declaimed against his abandoning the I. W. W. - members who had no sympathy with the bummery element."
                            },
                            {
                                "example_id": "a27b661f-df03-47e8-9ec1-348c26535ff6",
                                "sense_id": "6100e868-a552-3120-84f9-6b60e3fd4009",
                                "text": "But the hour belonged to the bummery. Proclaiming a millennial vision of “One Big Union,” the hobo insurgents won the day, ousting the home-guard and dedicating the IWW to direct economic action exclusively."
                            }
                        ]
                    }
