                        "glosses": [
                            "A thin frame in a printing press that holds the sheet of paper in position and acts as a mask."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37fecc3e-e054-45ee-a7e6-67b7e898ca6b",
                                "sense_id": "e35823e1-aa8e-300c-bb89-487da5e73b68",
                                "text": "And while the Tympan is coming, he slips his Left Hand Fingers from under the Frisket to the hither outer corner of it, as well to keep the Sheet close to the Tympan in its position, as to avoid the jobbing of the lower side of the Frisket against the small square shoulder"
                            },
                            {
                                "example_id": "12186de4-1441-4a77-9111-3b14aa585ed7",
                                "sense_id": "e35823e1-aa8e-300c-bb89-487da5e73b68",
                                "text": "As the pressman returns the inkballs to the inkstone, the journeyman closes the frisket and tympan."
                            }
                        ]
                    }
