                        ]
                    },
                    {
                        "translation_id": "5c7fdb3f-c60d-4972-be21-5ccb95fee265",
                        "source_entry_id": "ae4a8e67-6e9a-3a07-a693-59bd423df080",
                        "source_sense_id": "135770d6-04f5-30f2-8fe4-fccd63838c04",
                        "target_lang_word": "Hongkong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hongkong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80b687c3-6209-3f3e-8ef7-ec8c3c667ca9",
                                        "entry_id": "f4ed98e9-2119-3d1e-a24a-549d9ea58571",
                                        "glosses": [
                                            "eine Metropole und Sonderverwaltungszone im Süden Chinas mit gut 7 Millionen Einwohnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89010847-7b23-4a9c-9290-bdac0d673f1e",
                                                "sense_id": "80b687c3-6209-3f3e-8ef7-ec8c3c667ca9",
                                                "text": "„Das besiedelbare Territorium Hongkongs gehört, nach Monaco mit rund 16000 Personen pro km², zu den am dichtesten besiedelten Gebieten der Welt, wobei die Bevölkerungsdichte des gesamten Territoriums immer noch bei etwa 6.700 Personen pro km² liegt.“"
                                            },
                                            {
                                                "example_id": "94512485-d8f9-49fc-81a5-11de1111f1d5",
                                                "sense_id": "80b687c3-6209-3f3e-8ef7-ec8c3c667ca9",
                                                "text": "„In Hongkong muss man für eine eigene Grabstelle innerhalb der Stadtgrenzen mittlerweile umgerechnet 28000 Euro bezahlen.“"
                                            },
                                            {
                                                "example_id": "ae9c324c-3780-4883-b83f-802aaaefff35",
                                                "sense_id": "80b687c3-6209-3f3e-8ef7-ec8c3c667ca9",
                                                "text": "„Die Universität von Hongkong hat eine Skulptur zur Erinnerung an die Opfer der blutigen Niederschlagung der Demokratiebewegung 1989 in China von ihrem Campus entfernen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
