                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intimate",
                                "target_lang_sense_clarification": "referring to a close personal relationship"
                            },
                            {
                                "target_lang_word": "heartfelt",
                                "target_lang_sense_clarification": "referring to sincere and deep emotions"
                            },
                            {
                                "target_lang_word": "tender",
                                "target_lang_sense_clarification": "referring to gentle and loving affection"
                            }
                        ]
