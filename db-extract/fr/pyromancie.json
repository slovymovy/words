            {
                "entry_id": "89977977-eb3d-3ff0-bb9f-d98aa45b046d",
                "word": "pyromancie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8cc6ece-b479-47e6-91f7-6b98f00aaed1",
                        "entry_id": "89977977-eb3d-3ff0-bb9f-d98aa45b046d",
                        "tags": [
