                    "sense_id": "cd933597-5d71-3699-9f1d-ef97a1b8ad44",
                    "sense_definition": "een bak waar het afval in wordt gedeponeerd totdat de vuilnisdienst het ophaalt",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "afvalbeheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>prullenbakken</w> op het werk worden iedere dag geleegd.",
                            "target_lang_translations": {
                                "en": "The <w>bins</w> at work are emptied every day."
                            }
                        },
                        {
                            "text": "Gooi dat papier maar direct in de <w>prullenbak</w> naast je bureau.",
                            "target_lang_translations": {
                                "en": "Just throw that paper directly into the <w>wastepaper basket</w> next to your desk."
                            }
                        }
                    ],
                    "synonyms": [
                        "afvalbak",
                        "vuilnisbak"
                    ],
                    "common_phrases": [
