                                        "entry_id": "4c8c723e-ecb9-3058-9bbb-63f11140be5c",
                                        "glosses": [
                                            "jenseits des Atlantischen Ozeans befindlich, auf der anderen Seite des Atlantiks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c0449d-5d9e-463f-9ff6-c3a178972334",
                                                "sense_id": "42918452-e174-3068-b513-5434f6be7575",
                                                "text": "„Die transatlantischen Beziehungen bleiben die Grundlage deutscher und europäischer gemeinsamer Sicherheit.“"
                                            },
                                            {
                                                "example_id": "1a3579a9-f1dd-4284-9f0c-53634ad90ef6",
                                                "sense_id": "42918452-e174-3068-b513-5434f6be7575",
                                                "text": "„Denn hier verlaufen zahlreiche transatlantische Datenkabel, die das Rückgrat der Kommunikation zwischen Europa und Nordamerika darstellen.“"
                                            },
                                            {
                                                "example_id": "d8294c3c-fa8f-4aca-b38c-4d96c63dbafa",
                                                "sense_id": "42918452-e174-3068-b513-5434f6be7575",
                                                "text": "„Eine besondere Art von Handel war der mit Menschen innerhalb des afrikanischen Kontinents und der sogenannte transatlantische Sklavenhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
