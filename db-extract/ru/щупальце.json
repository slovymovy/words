                "senses": [
                    {
                        "sense_id": "8489c25c-5a6e-3ad6-bc9e-8ecc0be3b1a9",
                        "entry_id": "c9a04f07-55df-366e-803c-c35e93a768aa",
                        "glosses": [
                            "зоол. тонкий удлиненный подвижной придаток у рта насекомых, червей, ракообразных и некоторых других животных, служащий как орган осязания, хватания"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b9584f28-3d97-3ee8-8e2c-dbeee2acaad1",
                        "entry_id": "c9a04f07-55df-366e-803c-c35e93a768aa",
                        "glosses": [
                            "перен. ритор. неодобр. употребляется для обозначения чего-нибудь, что захватывает, поглощает, забирает целиком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98255387-bd19-4015-80eb-d0cd20e60405",
                                "sense_id": "b9584f28-3d97-3ee8-8e2c-dbeee2acaad1",
                                "text": "Щупальца капитализма в колониальных странах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0108b4ad-d202-4efb-b241-8a8f4fe7939f",
                        "source_entry_id": "c9a04f07-55df-366e-803c-c35e93a768aa",
                        "target_lang_word": "tentacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9da89e88-3068-3efd-b9fc-8370383d45e9",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "An elongated, boneless, flexible organ or limb of some animals, such as the octopus and squid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f5d6f5-53d2-4f08-8881-d55b87ccec0b",
                                                "sense_id": "9da89e88-3068-3efd-b9fc-8370383d45e9",
                                                "text": "With one blow of the axe, Captain Nemo cut this formidable tentacle, that slid wriggling down the ladder."
                                            },
                                            {
                                                "example_id": "a5281b25-a168-4aa9-b699-91de3b8b1132",
                                                "sense_id": "9da89e88-3068-3efd-b9fc-8370383d45e9",
                                                "text": "1897, H. G. Wells, The Crystal Egg\nThe body was small, but fitted with two bunches of prehensile organs, like long tentacles, immediately under the mouth."
                                            },
                                            {
                                                "example_id": "782f81b5-a0d7-4cad-a788-509ab76667bc",
                                                "sense_id": "9da89e88-3068-3efd-b9fc-8370383d45e9",
                                                "text": "1936, H. P. Lovecraft, The Shadow Out of Time\nSurmounting this head were four slender grey stalks bearing flower-like appendages, whilst from its nether side dangled eight greenish antennae or tentacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3463bc30-b650-3f4b-b2f2-fe6fc784a790",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "One of the glandular hairs on the leaves of certain insectivorous plants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef4c5aa6-1223-357e-b9d0-c05e413f02e0",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "An insidious reach or influence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bcde729-a677-49dc-af91-c4898ece45fd",
                                                "sense_id": "ef4c5aa6-1223-357e-b9d0-c05e413f02e0",
                                                "text": "the tentacles of the criminal underworld"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5c26c2-8e98-3a7c-9697-141648bf0dfa",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "Something like a zoological limb."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8041aaf8-2bd1-4271-b723-8ba64d350a5d",
                                                "sense_id": "4b5c26c2-8e98-3a7c-9697-141648bf0dfa",
                                                "text": "New extensions into the outer London dormitory areas also have been constructed, and at the present moment the tentacles of London's Underground are slowly but surely extending eastwards into Essex to relieve congestion on the suburban lines of the former Great Eastern Railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78dfaaa-0d14-385a-a915-d324cc4b5d34",
                                        "entry_id": "29ee065c-1360-3488-9024-8fc0938a36cb",
                                        "glosses": [
                                            "An officer employed to drive out to troops and transmit back requests for support via a special radio link."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ba3aad-447b-49cc-a601-43ca854255a2",
                                                "sense_id": "b78dfaaa-0d14-385a-a915-d324cc4b5d34",
                                                "text": "A joint RAF/Army staffed Air Support Control (ASC) headquarters was established at each army corps and each armoured division, linked to the forward brigades by a 'tentacle' equipped with two-way wireless telegraphy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tentacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ade012db-6fa4-3241-a94c-b27113c978e4",
                                        "entry_id": "9859ced9-2d2b-3663-895f-f5b09be39c4f",
                                        "glosses": [
                                            "to move like a tentacle"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d8b1f20-4838-4bac-9780-2877a6080386",
                        "source_entry_id": "c9a04f07-55df-366e-803c-c35e93a768aa",
                        "target_lang_word": "tentacule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tentacule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3076ff8f-4441-37a1-be29-f51993ab6a8e",
                                        "entry_id": "221d9810-7942-3d07-a0ec-abf3e64a45d5",
                                        "glosses": [
                                            "Appendice charnu et mobile dont plusieurs animaux sont pourvus, et qu’ils tendent en avant, soit pour tâter le terrain ou les objets environnants, soit pour saisir leur proie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83ab28b-758c-456d-9733-86e96a19e948",
                                                "sense_id": "3076ff8f-4441-37a1-be29-f51993ab6a8e",
                                                "text": "Chez de nombreuses espèces de pieuvres, on peut savoir si elles sont mâles ou femelles grâce à la présence d'une rainure sous le troisième tentacule droit."
                                            },
                                            {
                                                "example_id": "19d072b9-b8ac-4b7b-9cba-4fdd30c0fb49",
                                                "sense_id": "3076ff8f-4441-37a1-be29-f51993ab6a8e",
                                                "text": "La plupart des zoophytes ont des tentacules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86312eec-883e-3f2e-b5b5-7b671aeb6e6e",
                                        "entry_id": "221d9810-7942-3d07-a0ec-abf3e64a45d5",
                                        "glosses": [
                                            "Tout ce qui attrape, enserre, agrippe, etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d356332-96cd-44ec-b915-ad54e0bc3f94",
                                                "sense_id": "86312eec-883e-3f2e-b5b5-7b671aeb6e6e",
                                                "text": "Toutes sortes de firmes, par le moyen de leurs succursales, lancent vers lui, ou plutôt vers son escarcelle, leurs tentacules émoustillants, titillants et aspirants."
                                            },
                                            {
                                                "example_id": "daf5cba6-a97c-4683-97e1-daefbd03018d",
                                                "sense_id": "86312eec-883e-3f2e-b5b5-7b671aeb6e6e",
                                                "text": "Quelques cirrhus couvraient déjà le ciel de leurs tentacules."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
