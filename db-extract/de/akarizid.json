                "translations": [
                    {
                        "translation_id": "c94dd47e-282f-4fad-b1c4-c2b3c12c4c92",
                        "source_entry_id": "09ea23ac-2ce5-3f44-80a1-4cee19b2cb3b",
                        "source_sense_id": "4153be68-bd61-3abb-be21-393b6623aeab",
                        "source_sense_description": "Pestizid zur Bekämpfung von Milben (Ordnung Acarina der Spinnentiere)",
                        "target_lang_word": "acaricide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acaricide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2df5d7f6-2fc6-396b-a8ae-809ee1d088ee",
                                        "entry_id": "99666981-461c-357b-a2c8-fe01fc453f34",
                                        "glosses": [
                                            "Any substance which kills acarids (mites and ticks)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123fc146-2365-466b-b917-8d1251d34518",
                                                "sense_id": "2df5d7f6-2fc6-396b-a8ae-809ee1d088ee",
                                                "text": "“Twelve pesticides commonly applied to citrus groves are slated for study in the project’s plots,” reports Tom S. Bellows, UC Riverside assistant entomologist. They include four acaricides (Morestan, Kelthane, Pictran, Vendex), four thripsicides (Cygon, Carzol, Orthene, Sabadilla), and four scalicides (Parathion, Supracide, Lorsban, Sevin)."
                                            },
                                            {
                                                "example_id": "0df802e4-2ab7-44e0-8da8-c9cd8f04e478",
                                                "sense_id": "2df5d7f6-2fc6-396b-a8ae-809ee1d088ee",
                                                "text": "Diagnostic doses of six acaricides (fenothiocarb, endosulfan, chlorfenapyr, tebufenpyrad, cyenopyrafen and cyflumetofen) resulted in a 68.0~71.8% mortality rate (on average) in the test mite populations, whereas the remaining six acaricides (monocrotophos, omethoate, bifenthrin, abamectin, etoxazole and bifenazate) caused slightly reduced mortality rates (on average 36.5~59.3%)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c879556-c50f-429c-bf85-9add097f41c3",
                        "source_entry_id": "09ea23ac-2ce5-3f44-80a1-4cee19b2cb3b",
                        "source_sense_id": "4153be68-bd61-3abb-be21-393b6623aeab",
                        "source_sense_description": "Pestizid zur Bekämpfung von Milben (Ordnung Acarina der Spinnentiere)",
                        "target_lang_word": "acaricide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acaricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7394e5a5-3333-3f80-b1d5-034e59a9b985",
                                        "entry_id": "3ed909b6-2389-38ae-b126-61560a0417bc",
                                        "glosses": [
                                            "Qui élimine les acariens."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd33f56d-b621-433b-b6bf-654e3e627714",
                                                "sense_id": "7394e5a5-3333-3f80-b1d5-034e59a9b985",
                                                "text": "Les oeufs portés par les disques sont placés à la mi-hauteur d’une cuve à saturation de chromatographie dont le fond contient le produit acaricide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acaricide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3df7c1-5019-31d3-8a17-a3e01a7e38ee",
                                        "entry_id": "62529abd-22c1-3c9d-a8cb-9c5f70db9a80",
                                        "glosses": [
                                            "Produit qui élimine les acariens."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67227f97-6840-41f1-805a-66509c0f8209",
                                                "sense_id": "9f3df7c1-5019-31d3-8a17-a3e01a7e38ee",
                                                "text": "Dans ce cas, l’addition d’un acaricide à l’aphicide ajoute donc de façon toujours significative 20,1 % de production."
                                            },
                                            {
                                                "example_id": "27acf547-73b3-456d-be9e-10bd1052b38d",
                                                "sense_id": "9f3df7c1-5019-31d3-8a17-a3e01a7e38ee",
                                                "text": "Les produits qui tuent les acariens, y compris les tiques, sont aussi appelés acaricides ou tiquicides."
                                            },
                                            {
                                                "example_id": "9cc4ff24-cf77-4bf5-9e38-a4dff2d17205",
                                                "sense_id": "9f3df7c1-5019-31d3-8a17-a3e01a7e38ee",
                                                "text": "La résistance au fluvalinate, l’acaricide le plus utilisé dans la lutte contre varroa a été détectée en premier lieu en Italie (1992-1993), puis dans d’autres pays européens (1994-1996) et aux États-Unis (1996-1997), ainsi que dans d’autres pays."
                                            },
                                            {
                                                "example_id": "5c6ae845-bbc6-4f8f-bb53-9b45829a937b",
                                                "sense_id": "9f3df7c1-5019-31d3-8a17-a3e01a7e38ee",
                                                "text": "D’une part, seuls les produits biocides de type 8, 14, 15, 18 et 23 tels que définis à l’annexe V de l’arrêté du 19 mai 2004 sont visés. Il s’agit des types de produits suivants : produits de protection du bois (TP 8) ; rodenticides, c’est-à-dire les produits utilisés pour lutter contre les souris, les rats ou autres rongeurs (TP 14) ; avicides, c’est-à-dire les produits utilisés pour lutter contre les oiseaux (TP 15) ; insecticides, acaricides et produits utilisés pour lutter contre les autres arthropodes (TP 18) et produits utilisés pour lutter contre des vertébrés nuisibles (TP 23)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
