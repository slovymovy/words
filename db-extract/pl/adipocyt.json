                        "glosses": [
                            "adipocyte (a type of cell, present in adipose tissue, where fat is stored as a source of energy)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b98e87-c4b5-4950-a0d2-ffc61b7ecf21",
                                "sense_id": "8dd5b9ec-1df1-38ea-b001-8bbe148d4598",
                                "text": "[…] cytoplazmie adipocytu owadów kontrolnych widoczne są liczne wakuole zawierające […]",
                                "translation": "[…] in the cytoplasm of the adipocyte of insects numerous vacuoles containing […]",
                                "english": "[…] in the cytoplasm of the adipocyte of insects numerous vacuoles containing […]"
                            },
