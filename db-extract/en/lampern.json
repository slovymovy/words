                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47822a88-e488-4a52-91c9-0acb91d37ddf",
                                "sense_id": "6164ed6b-b8c8-3aca-a669-9f10952769ad",
                                "text": "[…]if thou woldest an eel or a laumprun holde with streite hondis, how myche strengerli thou thristis, so myche the sunnere it shal sliden awey."
                            },
                            {
                                "example_id": "b61e4195-e797-40ef-92b8-9c2997f38535",
                                "sense_id": "6164ed6b-b8c8-3aca-a669-9f10952769ad",
                                "text": "LAmprayes or Lampurnes bee partly of the nature of Eeles[…]."
                            },
                            {
                                "example_id": "cc5b8c85-9c34-4401-81d9-7591f87f9c8e",
                                "sense_id": "6164ed6b-b8c8-3aca-a669-9f10952769ad",
                                "text": "The Lampern is called Petromyzon Fluviatilis, becauſe this fiſh at certain ſeaſons goes to the ſea."
                            },
                            {
                                "example_id": "a056611a-5581-4179-9c51-9ba82a69b5e0",
                                "sense_id": "6164ed6b-b8c8-3aca-a669-9f10952769ad",
                                "text": "The Lampern, Lampetra fluviatilis, is white, with greenish back; it reaches a length of sixteen inches."
                            },
                            {
                                "example_id": "dfd38c56-0b62-4523-a5bd-0fcc6d5ebf77",
                                "sense_id": "6164ed6b-b8c8-3aca-a669-9f10952769ad",
                                "text": "Lampetra fluviatilis (the lampern or river lamprey) undergoes a spawning migration in British rivers during the period between November and February, after which the animals spend from 4 to 6 months in fresh water prior to spawning."
                            }
