                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c648364d-51e4-48e0-b8c9-58d4301d0c21",
                                                "sense_id": "5ab79a9d-cd52-36ab-af49-72e6037c8ff1",
                                                "text": "hydraulics system"
                                            },
                                            {
                                                "example_id": "2d0e009a-a86a-4082-a952-2d3754516b96",
                                                "sense_id": "5ab79a9d-cd52-36ab-af49-72e6037c8ff1",
                                                "text": "The brakes work on the principle of hydraulics."
