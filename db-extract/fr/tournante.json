                    {
                        "translation_id": "130069a7-a723-41e4-9a9b-327b130081b0",
                        "source_entry_id": "4b5b48ac-7018-3767-9cf7-d0d147810280",
                        "source_sense_id": "bccf4110-068c-344f-894f-48b5eb49fba6",
