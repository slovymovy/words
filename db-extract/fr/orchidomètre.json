                        "glosses": [
                            "Perles de calibres croissants reliées par une ficelle permettant de mesurer le volume des testicules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ddadac-21a9-4319-a540-bda6d2be89aa",
                                "sense_id": "581da274-20ac-305a-8594-6405c76b9f58",
                                "text": "- Lena, on a des couilles de Chinois ?\nKlemet n’en crut pas ses oreilles. Le pédiatre le regardait à nouveau, attendant la réponse de Lena qui ne tarda pas.\n- Non, docteur, nous n’avons que l’orchidomètre standard.\n- Merci, Lena."
                            },
                            {
                                "example_id": "1fa1f1ae-12ba-46d2-b658-29e73078ea94",
                                "sense_id": "581da274-20ac-305a-8594-6405c76b9f58",
                                "text": "Non, l’orchidomètre n’a rien à voir avec les orchidées! Il s’agit en fait d’un appareil pour mesurer le volume des testicules."
                            }
                        ]
                    }
