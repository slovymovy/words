                                                "sense_id": "cc1a81ed-c8e2-3693-bfd7-48b50cfa9427",
                                                "text": "L'acetone è il chetone più semplice esistente"
                                            },
                                            {
                                                "example_id": "97f3fbb2-1080-4b1f-8cd8-01e737ad744b",
                                                "sense_id": "cc1a81ed-c8e2-3693-bfd7-48b50cfa9427",
                                                "text": "L'acetone è utilizzato per rimuovere lo smalto per unghie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09b8cec9-d7b0-37b0-a135-724439f4f97a",
                                        "entry_id": "0c86a9f5-2deb-33f6-96b0-d7bc2d8d6ec6",
