                                        "entry_id": "83499221-eeae-3fe7-9b8f-e120291c3f92",
                                        "glosses": [
                                            "přízvisko Jidáše Iškariotského, apoštola, který zradil Ježíše, a jeho otce Šimona Iškariotského"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5067b92c-617c-4a2d-ba05-2e3ab24e95ad",
                                                "sense_id": "5e521433-87a6-38a9-a3e4-bd2c74d14773",
                                                "text": "Řekl jemu Judas, ne onen Iškariotský: Pane, jakž jest to, že sebe nám zjeviti chceš, a ne světu?"
                                            },
                                            {
                                                "example_id": "4970fa53-761a-4dd5-8417-3bccbc1e9955",
                                                "sense_id": "5e521433-87a6-38a9-a3e4-bd2c74d14773",
                                                "text": "…autoři si totiž dovolili předpokládat, že středoškolsky vzdělaný člověk by mohl vědět, že Iškariotský, jenž zradil za třicet stříbrných, se jmenoval Jidáš."
                                            },
                                            {
                                                "example_id": "d3a020ee-7d31-4e56-9118-e49860d42a97",
                                                "sense_id": "5e521433-87a6-38a9-a3e4-bd2c74d14773",
                                                "text": "Ještě před večeří ďábel vnukl do srdce Jidáše, syna Šimona Iškariotského, že ho má zradit."
                                            }
                                        ]
                                    }
