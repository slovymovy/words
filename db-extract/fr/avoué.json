            {
                "entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
                "word": "avoué",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6c3dc49b-d6c9-4c30-8a4a-4fba832aa4c3",
                        "entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
                        "tags": [
                            "plural"
                        ],
                        "form": "avoués"
                    },
                    {
                        "form_id": "777b31e2-96e0-47f2-97f8-429de4be6568",
                        "entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
                        "tags": [
                            "feminine"
                        ],
                        "form": "avouée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                        "entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
                        "glosses": [
                            "Officier ministériel, autrefois appelé procureur, dont la fonction est de représenter les parties devant les tribunaux et de faire en leur nom tous les actes de procédure nécessaires."
                        ],
                        "tags": [
                            "Métier",
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "bc617990-7da5-42e2-a75e-824a9a671f75",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Mais comme il voulait concourir plus tard pour une chaire de professeur à l’École et qu’il n’avait pas d’argent, Deslauriers acceptait à Troyes une place de maître clerc chez un avoué."
                            },
                            {
                                "example_id": "056102f9-10fd-47e1-b365-03e11fddf5de",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Deux jours après, je passai devant le conseil de guerre, qui, après plaidoirie d’un avoué allemand, me condamna à mort pour espionnage."
                            },
                            {
                                "example_id": "e07e3fad-545d-420a-820e-02e1a9ff315c",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Avoué de première instance."
                            },
                            {
                                "example_id": "4c80cc44-b048-4adc-9c9b-6565d38b2fb4",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Avoué à la Cour d’appel."
                            },
                            {
                                "example_id": "11d1c9e0-3168-471c-b3da-862dcf712dbc",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Une étude d’avoué."
                            },
                            {
                                "example_id": "99a54307-d1c0-48db-a877-9eeecd20b14e",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Clerc d’avoué."
                            },
                            {
                                "example_id": "7c7ed9c9-67cf-42e5-af5f-219bbd6b30b9",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Constituer avoué."
                            },
                            {
                                "example_id": "c6b92c93-2c54-4e5c-adc2-5035f0c30458",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "Acte, signification d’avoué à avoué."
                            },
                            {
                                "example_id": "b3b99f77-99d8-4f32-8588-4c9e42193c93",
                                "sense_id": "0f078549-5547-3163-8e4e-25677715a0ba",
                                "text": "L’avoué du demandeur, du défendeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "be630040-a260-3fdf-8948-96ff612edcbb",
                        "entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
                        "glosses": [
                            "Seigneur qui se chargeait d’être le protecteur, le défenseur des droits d’une église."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "00c59875-985c-4774-874d-8610efdcb65c",
                                "sense_id": "be630040-a260-3fdf-8948-96ff612edcbb",
                                "text": "L’avoué de Cîteaux."
                            },
                            {
                                "example_id": "54ae74c8-fa9e-4067-b6be-ae49eb5aa772",
                                "sense_id": "be630040-a260-3fdf-8948-96ff612edcbb",
                                "text": "L’avoué de l’évêché d’Arras."
                            },
                            {
                                "example_id": "77860e8e-3325-4917-9e7c-30d1023ef040",
                                "sense_id": "be630040-a260-3fdf-8948-96ff612edcbb",
                                "text": "Godefroid de Bouillon, avoué du Saint-Sépulcre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02cb2493-0fc0-42a2-bb92-585699b351ae",
                        "source_entry_id": "1314597d-a3e3-31fb-969d-fb8f3e6de505",
