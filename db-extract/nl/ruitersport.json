                            {
                                "example_id": "54e7f2d1-afa1-4ad3-81ce-31627bc9749f",
                                "sense_id": "05bbd2e5-8507-3e8e-8615-3a3db7b6459a",
                                "text": "Onthoud basisbegrippen uit de ruitersport en hippologie en gebruik ze gedoseerd en terloops in jullie gesprekken."
                            },
                            {
                                "example_id": "d825f180-7a5a-4462-8fe9-0abe8834742e",
                                "sense_id": "05bbd2e5-8507-3e8e-8615-3a3db7b6459a",
                                "text": "Twee toppaarden blijven in ieder geval tot en met de Wereldruiterspelen in Tryon voor de Nederlandse ruitersport behouden. Don VHP Z en Glock's Zonik zijn door Stichting Nederlands Olympiade Paard (NOP) tot en met september vastgelegd."
                            },
                            {
                                "example_id": "f47e2878-5062-4217-a2f8-f87441753682",
                                "sense_id": "05bbd2e5-8507-3e8e-8615-3a3db7b6459a",
                                "text": "Chung, die aan ruitersport doet, zou in Aalborg zijn aangehouden op verdenking van het illegaal in Denemarken zijn. Zuid-Korea had Interpol gevraagd naar Chung te zoeken, omdat justitie haar in eigen land wil verhoren."
                            }
                        ]
