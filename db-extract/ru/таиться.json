                            {
                                "example_id": "a92eed49-ec97-4c82-8b61-b7ec31a4a32a",
                                "sense_id": "ba22e831-6b92-31a1-84a9-28d493ebf2aa",
                                "text": "не таи́сь от меня́",
                                "translation": "don't conceal anything from me; don't hold anything back from me",
                                "english": "don't conceal anything from me; don't hold anything back from me"
                            }
