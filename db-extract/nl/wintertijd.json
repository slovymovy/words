                                "target_senses": [
                                    {
                                        "sense_id": "11c9bfe4-7e5c-3ff5-98dc-4018ef1cc403",
                                        "entry_id": "54b07151-3902-38ec-9b7f-4aed0bcdfb03",
                                        "glosses": [
                                            "Jahreszeit nach dem Herbst und vor dem Frühling, auf der nördlichen Halbkugel Zeit von Dezember bis März"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f39dfe-dcfa-414d-8ba3-9c8d06a1f903",
                                                "sense_id": "11c9bfe4-7e5c-3ff5-98dc-4018ef1cc403",
                                                "text": "Im Winter ist es kalt, es liegt oft Schnee."
                                            },
                                            {
                                                "example_id": "9bde84dd-f656-492b-8474-fd1b4b88b685",
                                                "sense_id": "11c9bfe4-7e5c-3ff5-98dc-4018ef1cc403",
                                                "text": "„Als wir aus Nizza abfuhren, war Sommer - einen Tag später hatten wir in Amsterdam Regen und Winter.“"
                                            },
                                            {
                                                "example_id": "b2d90690-4481-4054-acc7-58403f6ab7ea",
                                                "sense_id": "11c9bfe4-7e5c-3ff5-98dc-4018ef1cc403",
                                                "text": "„Im Winter legte er sich die Laufbahn selbst per Schneefräse frei.“"
                                            },
                                            {
                                                "example_id": "b4bf308a-ddd0-4b0e-bc2b-659a49aea12c",
                                                "sense_id": "11c9bfe4-7e5c-3ff5-98dc-4018ef1cc403",
                                                "text": "„Im Folgejahr war der Winter dagegen kalt und trocken, der Main fror von Mitte Januar bis Anfang März zu, und Vater Rhein rührte sich im Februar bei Köln vor Frost nicht mehr von der Stelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
