                                                "example_id": "a0bea3b6-c801-428c-9445-1a2ee0da48a7",
                                                "sense_id": "1c120c66-554b-3c0c-8316-42e08a288d9b",
                                                "text": "Die UNESCO führt Tschuktschisch, das noch von 10.000 Menschen gesprochen wird, als „gefährdet“."
                                            },
                                            {
                                                "example_id": "b4478f5f-b58b-478f-9d1e-9280289765f7",
                                                "sense_id": "1c120c66-554b-3c0c-8316-42e08a288d9b",
                                                "text": "„Auch als er langsam das Tschuktschische verstand, blieb ihm der Sinn der allegorischen Reden, Beschwörungen und Gebete verborgen.“"
