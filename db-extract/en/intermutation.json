                        "examples": [
                            {
                                "example_id": "bd563bd1-202c-4f7b-9e87-0562c69acc8e",
                                "sense_id": "f47cf07d-c78e-36b1-8923-c85adf419635",
                                "text": "Schnabl, Stadler, Frost, and Schuster recently showed that error, expressed as mutual intermutation between reactive molecular species significantly affects the ability of a system to bifurcate into complex, chaotic oscillations."
                            },
                            {
                                "example_id": "3cac8951-e918-4f57-88a0-0149f6e1ad42",
                                "sense_id": "f47cf07d-c78e-36b1-8923-c85adf419635",
                                "text": "Although Plato follows his pre-Socratic predecessors in their attempt to bring the four element theory into greater accord with empirical phenomena and agrees with them that these bodies are transformed one into the other, his general theory, unfortunately, does not allow him to account for the intermutation of all four of these primary bodies. His failure to incorporate earth within the cycle of intermutation leads him to suggest that its transformation is purely illusory."
                            }
                        ]
                    }
