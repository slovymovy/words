                        "entry_id": "1dae1c44-133e-3b45-a618-1a521db9c948",
                        "glosses": [
                            "paling, fence (especially a wooden one)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0f4ec2d0-c357-4823-9fb4-14a4b23d407a",
                                "sense_id": "da142473-f379-3d5a-8f46-b81bc1d25cb0",
                                "text": "W ten sposób, bardzo już pomęczeni, dotarliśmy do jakiegoś obozu, gdzie stały drewniane baraki, otoczone parkanem z drutów kolczastych.",
                                "translation": "In this way, already very tired, we reached some camp, where there stood wooden barracks surrounded by a fence of barbed wire.",
                                "english": "In this way, already very tired, we reached some camp, where there stood wooden barracks surrounded by a fence of barbed wire."
                            }
                        ]
                    }
