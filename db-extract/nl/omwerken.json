                                    {
                                        "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                        "entry_id": "c557369d-f563-3684-9ab6-0b326542bd82",
                                        "glosses": [
                                            "To write again, differently; to modify; to revise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f053e1c-3795-403f-898c-164d64431bbf",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "The editor asked me to rewrite my article for a non-technical audience."
                                            },
                                            {
                                                "example_id": "9843148c-14e1-419c-9fb0-1bd61ebb3145",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "If we are going to rewrite all of those diagrams and change the duties of all of those staff, it will take a few weeks."
                                            },
                                            {
                                                "example_id": "150b3e06-0b19-4a73-8b95-3ebe19e20111",
                                                "sense_id": "5d79d2e3-e6d3-3f25-aa01-ad5a49017738",
                                                "text": "The conservative establishment will have to ask themselves, what else they can do? […] And even though they rewrite the electoral rules in their favour, their parties still lose the election."
                                            }
                                        ]
                                    },
