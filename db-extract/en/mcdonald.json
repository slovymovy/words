                    {
                        "sense_id": "ccdd151a-5619-3e28-8634-fa078c7be98e",
                        "entry_id": "53b637ac-eb77-33d9-b0aa-0591d598ee95",
                        "glosses": [
                            "Alternative form of McDonald's."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "attributive",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0aa282-e75a-4bc4-835d-a370765fc5ed",
                                "sense_id": "ccdd151a-5619-3e28-8634-fa078c7be98e",
                                "text": "Over a life time the average American consumes more than 50 tons of food. For meat eaters this could include about 2,450 chickens, 118 turkeys, 33 pigs, and 12 cows. For many of us, this total could also include about 6,500 hot dogs, 20,000 M&M’s, 35,000 cookies, 70,000 cups of coffee and 1,800 McDonald meals."
                            },
                            {
                                "example_id": "4745fe28-7f02-40ab-a955-81c36a82b18f",
                                "sense_id": "ccdd151a-5619-3e28-8634-fa078c7be98e",
                                "text": "Later that evening, Maia and I took a taxi downtown to the largest McDonald Restaurant in the world. […] We were told, and later witnessed long strands of cars pulling up to purchase already bagged McDonald meals from private entrepreneurs, long after the restaurant had closed."
                            },
                            {
                                "example_id": "65b7b262-de62-47a8-b950-144979d4b3f8",
                                "sense_id": "ccdd151a-5619-3e28-8634-fa078c7be98e",
                                "text": "I would always attempt to get some type of protein like a hamburger or chicken sandwich from McDonald’s. […] French fries is not a safe food for me because I would often choke on several fries causing me the need to purge- so, no McDonald meals."
                            }
                        ]
                    }
