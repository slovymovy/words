                                        "sense_id": "b35bcfd8-2cf9-3f54-bdff-095ccc25a95b",
                                        "entry_id": "6d4823c8-91f1-3e3f-a22e-69c1b3e29201",
                                        "glosses": [
                                            "Someone who presents a petition to a court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5470b593-cc3f-3b0c-aabd-709a7df556e8",
                                        "entry_id": "6d4823c8-91f1-3e3f-a22e-69c1b3e29201",
                                        "glosses": [
                                            "Someone who presents a petition to some person in authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d60d32c-ab2e-410b-a9c2-604a181b0d64",
                                                "sense_id": "5470b593-cc3f-3b0c-aabd-709a7df556e8",
                                                "text": "Ethel was in mourning: they had judged it the most fitting habit for a petitioner; it was certainly one most becoming to the wearer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45cb9dc2-f034-4752-abcf-23af962e00e6",
                        "source_entry_id": "860fbbad-3a74-3d35-8702-8ab0a951d0a4",
                        "source_sense_id": "2b64f4e4-9df3-3fa1-a91c-c6f6e3ef1cc9",
                        "target_lang_word": "Petent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                        "entry_id": "55e3c178-0817-3dd8-ba8f-33070127dae3",
                                        "glosses": [
                                            "(männliche^☆) Person, die bei amtlichen Stellen eine Eingabe (= Petition) macht, einen Antrag stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537ad4ac-57f7-4064-81d8-f52c293c7776",
                                                "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                                "text": "Es gibt hin und wieder Petenten, die uns ständig mit ihren aussichtslosen Eingaben beschäftigen."
                                            },
                                            {
                                                "example_id": "04f3b8bf-ba71-4beb-8a0d-92751fd04616",
                                                "sense_id": "57cd0282-8e29-34bf-85c5-e3c5c2b8a309",
                                                "text": "„Der starke Mann im Weißen Haus, der seine humanitäre Einstellung einer religiösen Erziehung als Quäker verdankte, hatte ein Einsehen und gab dem Anliegen der Petenten statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f984428-5660-4f69-8ebb-c93154965653",
                        "source_entry_id": "860fbbad-3a74-3d35-8702-8ab0a951d0a4",
                        "source_sense_id": "2b64f4e4-9df3-3fa1-a91c-c6f6e3ef1cc9",
                        "target_lang_word": "Interessent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interessent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4619cd21-9bcd-3436-b9c9-3f53ad3b03d2",
                                        "entry_id": "b92f6a02-c79b-334b-bded-ac7691abc46c",
                                        "glosses": [
                                            "jemand, der an einer Sache interessiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4411a4-eb24-456d-bf99-0a2648c21317",
                                                "sense_id": "4619cd21-9bcd-3436-b9c9-3f53ad3b03d2",
                                                "text": "Er untersucht in einer Studie die Zukunft des Car-Sharings in Deutschland bis 2020 und hat festgestellt, dass sich die Zahl der Nutzer von der Zahl der Interessenten um Größenordnungen unterscheidet."
                                            },
                                            {
                                                "example_id": "87471c2a-75bf-4365-a331-ab48e1029fce",
                                                "sense_id": "4619cd21-9bcd-3436-b9c9-3f53ad3b03d2",
                                                "text": "Wer zu den Interessenten an einer Partnerschaft mit oder einem Kauf von Zielpunkt ist, ist nicht bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5252aa16-7b32-35ad-b38a-1d3ef5537ba7",
                                        "entry_id": "b92f6a02-c79b-334b-bded-ac7691abc46c",
                                        "glosses": [
                                            "jemand, der einen Kauf in Erwägung zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc9a31c-9ced-4ddc-989a-6126deb6d239",
                                                "sense_id": "5252aa16-7b32-35ad-b38a-1d3ef5537ba7",
                                                "text": "Wer zu den Interessenten an einer Partnerschaft mit oder einem Kauf von Zielpunkt ist, ist nicht bekannt."
                                            },
                                            {
                                                "example_id": "83dc271b-fe8d-4004-a4cf-05943bd59eb9",
                                                "sense_id": "5252aa16-7b32-35ad-b38a-1d3ef5537ba7",
                                                "text": "Auch zwei Tage später ist lediglich eine Not-Seite online, die Interessenten direkt zu den Downloads leitet."
                                            },
                                            {
                                                "example_id": "4a963718-26c4-4b65-bad9-7d817af3c7f7",
                                                "sense_id": "5252aa16-7b32-35ad-b38a-1d3ef5537ba7",
                                                "text": "Zudem war immer wieder zu hören, es gebe auch ernstzunehmende ausländische Interessenten."
                                            },
                                            {
                                                "example_id": "f8da6873-c938-45a1-97cd-0137197a13bb",
                                                "sense_id": "5252aa16-7b32-35ad-b38a-1d3ef5537ba7",
                                                "text": "„Der Bauträger hat längst neue Interessenten für das Reihenhaus gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f10ba2e1-122a-328b-83fc-8e84ea33b564",
                                        "entry_id": "b92f6a02-c79b-334b-bded-ac7691abc46c",
                                        "glosses": [
                                            "ein Bewerber für eine Aufgabe, Position, einen Job und andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2891aa9-60e7-4d37-96fb-6a605a76e8ab",
                                                "sense_id": "f10ba2e1-122a-328b-83fc-8e84ea33b564",
                                                "text": "Immer mehr Firmen bieten Interessenten die Möglichkeit, sich online zu bewerben."
                                            },
                                            {
                                                "example_id": "883e7969-2247-4599-b6fb-2d3b975c3b67",
