                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "8db8b4fd-f121-4596-936c-f4b097558fe0",
                                "sense_id": "81332c4e-7134-3858-a95e-314af1d517cf",
                                "text": "Andernach war im frühen Mittelalter eine fränkische Königspfalz."
                            },
                            {
                                "example_id": "b1e8591d-6770-4679-85ed-be8b768ecce1",
                                "sense_id": "81332c4e-7134-3858-a95e-314af1d517cf",
                                "text": "\"[…] Für Andernach hat Venantius Fortunatus die spätrömische Stadtmauer geradezu als typisches Kennzeichen herausgestellt. Es ist wohl denkbar, daß die Türme der Mauer in […] Andernach der Holzdächer und ihres Innenausbaus entbehrten, da diese möglicherweise niedergebrannt waren. […]\""
                            },
                            {
                                "example_id": "8ad23242-05d7-41b4-af17-886920d6f417",
                                "sense_id": "81332c4e-7134-3858-a95e-314af1d517cf",
                                "text": "„Unser Zug fährt zurück nach Andernach.“"
                            }
                        ],
