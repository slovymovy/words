        "nl-extract.jsonl": [
            {
                "entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                "word": "overspoelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70c57019-22cd-3c6f-aa23-921305751df8",
                        "entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                        "glosses": [
                            "iets met te veel vullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e077cf37-5f36-4dd8-aa37-b4a9dcb2e2b4",
                                "sense_id": "70c57019-22cd-3c6f-aa23-921305751df8",
                                "text": "Het heeft weinig zin om de markt te overspoelen met potentiële bestsellers, vindt Swart. „Een jaar heeft altijd een aantal bestsellers, dat worden er op deze manier niet ineens dertig meer. De feitelijke marktomvang verandert namelijk niet zo veel.”"
                            },
                            {
                                "example_id": "f2bd6d5a-56f8-4daa-834c-91ab53bced6d",
                                "sense_id": "70c57019-22cd-3c6f-aa23-921305751df8",
                                "text": "En dan is er nog de kwestie van niet-Opec-lid Rusland. Als dat land niet meedoet en de wereld blijft overspoelen met goedkope olie, heeft de productiebeperking van de Opec ook weinig zin. Saoedi-Arabië doet daarom zijn uiterste best de Russen aan boord te krijgen. Maar die spelen hun eigen spel. Met ruim 11 miljoen vaten per dag produceren zij nu meer dan ooit sinds het uiteenvallen van de Sovjet-Unie."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d27b203-7f1f-3bab-bcf9-0b539e976c19",
                        "entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                        "glosses": [
                            "bedekken met een vloeistof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb31fba3-1a5d-4dbf-83ce-58ad1bb6d244",
                                "sense_id": "3d27b203-7f1f-3bab-bcf9-0b539e976c19",
                                "text": "Maar zelfs degenen die klimaat als toetssteen voor de toekomst beschouwen, hebben moeite om zich die toekomst voor te stellen. Is de +2-gradenwereld er straks écht een waarin mensen bij bosjes sterven zodra zij zich in de Golfstaten op straat begeven, waar verwoestende golven de delta’s van Azië overspoelen, wekelijkse hurricanes de VS teisteren en Nederland slechts overleeft achter extra hoge dijken zonder dat we ooit meer buiten schaatsen? Het lijkt zo ver en zo onwaarschijnlijk, een rampenfilm, maar daarin is er altijd een held die de baan van de aarde aanpast of een nieuwe drijvende samenleving sticht."
                            }
                        ]
                    },
                    {
                        "sense_id": "963dbd65-5d69-3e36-87e4-08af87fe366a",
                        "entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                        "glosses": [
                            "een band of draad van de ene naar de andere haspel brengen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5398c220-6194-4968-8d62-df4664da78d5",
                        "source_entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                        "source_sense_id": "70c57019-22cd-3c6f-aa23-921305751df8",
                        "source_sense_description": "bedekken met een vloeistof",
                        "target_lang_word": "inundate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inundate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f81f25c9-a91a-30a5-9ed7-24b39e5aa163",
                                        "entry_id": "bf68c756-726c-302d-9982-7fa3301e9583",
                                        "glosses": [
                                            "To cover with large amounts of water; to flood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c29f89-2873-4c01-9f75-41b1313285b4",
                                                "sense_id": "f81f25c9-a91a-30a5-9ed7-24b39e5aa163",
                                                "text": "The Dutch would sometimes inundate the land to hinder the Spanish army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                        "entry_id": "bf68c756-726c-302d-9982-7fa3301e9583",
                                        "glosses": [
                                            "To overwhelm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d982d5c-bc39-4b31-b0d2-98170ae5d600",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "The agency was inundated with phone calls."
                                            },
                                            {
                                                "example_id": "cb15a592-07b8-4456-b3df-c2159db33ca7",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "I don't know any quarter in England where you get such undeniable mutton—mutton that eats like mutton, instead of the nasty watery, stringy, turnipy stuff, neither mutton nor lamb, that other countries are inundated with."
                                            },
                                            {
                                                "example_id": "0775774e-351f-4e1e-87ca-543f228685b6",
                                                "sense_id": "6637c90b-20c9-35f2-8cc7-2d6faf42a955",
                                                "text": "That books are pouring off the world’s presses at unprecedented rates is a fact often alluded to as a flood that is inundating libraries and the book trades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f10935fd-8ec7-4528-b442-6458acb206ad",
                        "source_entry_id": "ac3c5b0c-5698-3c81-85fa-1f0f6e387cf9",
                        "source_sense_id": "963dbd65-5d69-3e36-87e4-08af87fe366a",
                        "source_sense_description": "een band of draad van de ene naar de andere haspel brengen",
                        "target_lang_word": "rewind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rewind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78b2235f-65e0-38cb-9e15-eee8f478f030",
                                        "entry_id": "4214dfe3-71e1-324b-82de-5f2ae8e667de",
                                        "glosses": [
                                            "To wind (something) again."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c178c17b-682e-42ab-8478-3fcd1e638072",
                                                "sense_id": "78b2235f-65e0-38cb-9e15-eee8f478f030",
                                                "text": "A Myrish crossbowman poked his head out a different window, got off a bolt, and ducked down to rewind."
                                            },
                                            {
                                                "example_id": "60c448f5-0139-415d-a1c8-76938b441d08",
                                                "sense_id": "78b2235f-65e0-38cb-9e15-eee8f478f030",
                                                "text": "[…] she was winding and rewinding bandages that were dripping in blood, smiling strangely at her as the plasma spilled from buckets all over the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51866e91-a24d-34ee-8bc9-0b26a1cb211f",
                                        "entry_id": "4214dfe3-71e1-324b-82de-5f2ae8e667de",
                                        "glosses": [
                                            "To wind (something) back, now especially of a cassette or a video tape, CD, DVD etc.; to go back on a video or audio recording."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264266d3-bfe7-4652-8800-df8f706738a0",
                                                "sense_id": "51866e91-a24d-34ee-8bc9-0b26a1cb211f",
                                                "text": "If you need to reload film, the cassette can be rewound slightly by turning the hub located on one end of its spool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3439ab01-5e9f-3c42-9f64-bdea01d783df",
                                        "entry_id": "4214dfe3-71e1-324b-82de-5f2ae8e667de",
                                        "glosses": [
                                            "To go back or think back to a previous moment or place, or a previous point in a discourse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7cb4c48-98d0-429e-84a9-99d5b5f3f1ec",
                                                "sense_id": "3439ab01-5e9f-3c42-9f64-bdea01d783df",
                                                "text": "If I had a time machine / And if life was a movie scene / I'd rewind, and I'd tell me / \"Ru-u-u-u-u-u-u-un\""
                                            },
                                            {
                                                "example_id": "63da4713-57d2-4241-9c56-0bf6dfc102dc",
                                                "sense_id": "3439ab01-5e9f-3c42-9f64-bdea01d783df",
                                                "text": "To understand Russia, you have to dive deep into its history — boyars and czars, Pushkin and Pasternak, Stalin and Stalingrad. To understand the perils of underestimating Russia, you don't have to go back that far. Just rewind to 2001, when George W. Bush naively sized up Vladimir Putin as a leader he could work with, a conclusion Bush reached when he looked into the Russian leader's eyes and \"found him to be very straightforward and trustworthy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rewind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28956a37-6266-31ea-9582-bdbe12d0a235",
                                        "entry_id": "2d1b9324-3264-3d09-85e8-dd005691a84f",
                                        "glosses": [
                                            "The act of rewinding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dda2dbc5-5851-3718-9207-e0a16328e496",
                                        "entry_id": "2d1b9324-3264-3d09-85e8-dd005691a84f",
                                        "glosses": [
                                            "A button or other mechanism for rewinding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9b5fa1-155d-423a-b5be-16589fcdbd27",
                                                "sense_id": "dda2dbc5-5851-3718-9207-e0a16328e496",
                                                "text": "I meant to pause the picture, but hit the rewind by mistake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
