                        "examples": [
                            {
                                "example_id": "01606055-32d0-4e99-a535-ad87ed3266d2",
                                "sense_id": "384f32f5-be03-3cc4-86b7-03bb07f82b52",
                                "text": "Rassurez-vous, pas besoin de savoir dessiner pour doodler sur votre papier cadeau !"
                            },
                            {
                                "example_id": "0770a1ce-5e14-4642-89f4-fbf2c5ddbe06",
                                "sense_id": "384f32f5-be03-3cc4-86b7-03bb07f82b52",
                                "text": "Que faire, que faire avec tout ces papiers qui ont reçu pleins de bavures....je doodle par dessus, je peins ou je pose du modeling paste à l'aide d'un pochoir pour créer un autre structure."
                            },
