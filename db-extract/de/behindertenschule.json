                "senses": [
                    {
                        "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                        "entry_id": "03ce737a-531d-30aa-ac27-41ed5a9781a7",
                        "glosses": [
                            "Schule, die sich auf die Förderung von Behinderten spezialisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924a855b-b85a-45f7-b6b1-ee4e3e3b9453",
                                "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                                "text": "„Seinen Wechsel vom Deutschlehrer und Leiter einer Behindertenschule zum Karikaturisten vor gut 25 Jahren bereut Westergaard nicht.“"
                            },
                            {
                                "example_id": "b81eadc6-0034-4981-821a-b57bba071e48",
                                "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                                "text": "„In Kpalimé arbeite ich seit bald einem Jahr in einer Behindertenschule als Assistent.“"
                            },
                            {
                                "example_id": "e685abb4-c994-46bf-a9ab-32830ca4a04d",
                                "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                                "text": "„‚[…] Eine Lehrerin hat schließlich zu ihm gesagt, er gehöre auf eine Behindertenschule‘, erinnert sich die Mutter.“"
                            },
                            {
                                "example_id": "105f8010-1a2d-4fe3-ad65-6ec515e65b8e",
                                "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                                "text": "„Das Land Sachsen unterstützt die Sanierung der Behindertenschule «Janusz Korczak» in Chemnitz mit 2,2 Millionen Euro.“"
                            },
                            {
                                "example_id": "0543b981-2642-4c57-9007-f993d41a2740",
                                "sense_id": "f5ab1509-8e78-3691-8acd-5dfda8493c64",
                                "text": "„Jährlich geben die Stipendiaten rund 200 kostenlose Konzerte, organisiert von LMN, in sozialen Einrichtungen wie Krankenhäusern, Behindertenschulen und -heimen, Sterbehospizen, Haftanstalten und Obdachlosenstätten.“"
                            }
                        ],
