{
    "word_family": [
        "establish",
        "establishment",
        "disestablish",
        "reestablish"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d850868-e449-3acd-8367-01d19be9381d",
                    "sense_definition": "Having been in existence for a long time and therefore recognized and generally accepted.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "recognized_and_accepted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>established</w> writer with several best-selling novels to her name.",
                            "target_lang_translations": {
                                "ru": "Она — <w>признанный</w> писатель, на счету которой несколько бестселлеров."
                            }
                        },
                        {
                            "text": "The company has become an <w>established</w> brand in the global market.",
                            "target_lang_translations": {
                                "ru": "Компания стала <w>известным</w> брендом на мировом рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "estd."
                    ],
                    "antonyms": [
                        "unestablished",
                        "new"
                    ],
                    "common_phrases": [
                        "established brand",
                        "established writer",
                        "established practice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в течение длительного времени и поэтому признанный и общепринятый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признанный",
                                "target_lang_sense_clarification": "о человеке, бренде, авторитете"
                            },
                            {
                                "target_lang_word": "уважаемый",
                                "target_lang_sense_clarification": "заслуживший авторитет"
                            },
                            {
                                "target_lang_word": "укоренившийся",
                                "target_lang_sense_clarification": "о практике, традиции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32cff919-ba38-3c36-a46b-8b71e9f045c9",
                    "sense_definition": "Explicitly defined, described or recognized as a reference.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defined_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must follow the <w>established</w> guidelines to ensure safety during the experiment.",
                            "target_lang_translations": {
                                "ru": "Мы должны следовать <w>установленным</w> правилам для обеспечения безопасности во время эксперимента."
                            }
                        },
                        {
                            "text": "There are <w>established</w> procedures for handling customer complaints.",
                            "target_lang_translations": {
                                "ru": "Существуют <w>определенные</w> процедуры для работы с жалобами клиентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "established guidelines",
                        "established procedures",
                        "established rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "Явно определенный, описанный или признанный в качестве ориентира или стандарта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "установленный",
                                "target_lang_sense_clarification": "о правилах, процедурах, нормах"
                            },
                            {
                                "target_lang_word": "общепринятый",
                                "target_lang_sense_clarification": "о порядке действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0927e0ad-802d-3bcc-9f19-9520ed0bf800",
                    "sense_definition": "Of a religion, church etc.: formally recognized by a state as being official within that area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Church of England is the <w>established</w> church in the country.",
                            "target_lang_translations": {
                                "ru": "Англиканская церковь является <w>государственной</w> церковью в стране."
                            }
                        },
                        {
                            "text": "They debated whether having an <w>established</w> religion was beneficial for modern society.",
                            "target_lang_translations": {
                                "ru": "Они спорили о том, полезна ли <w>официальная</w> религия для современного общества."
                            }
                        }
                    ],
                    "antonyms": [
                        "disestablished"
                    ],
                    "common_phrases": [
                        "established church",
                        "established religion"
                    ],
                    "target_lang_definitions": {
                        "ru": "О религии, церкви и т. д.: официально признанный государством в качестве государственной религии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "государственный",
                                "target_lang_sense_clarification": "о церкви или религии"
                            },
                            {
                                "target_lang_word": "официальный",
                                "target_lang_sense_clarification": "о статусе религии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c68f4b51-ec36-3033-8ff7-60bc3901b26e",
                    "sense_definition": "Of any social or economic entity: part of the establishment (“groups with socioeconomic power”).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "socioeconomic_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protest was directed against <w>established</w> political parties.",
                            "target_lang_translations": {
                                "ru": "Протест был направлен против <w>традиционных</w> политических партий."
                            }
                        },
                        {
                            "text": "He wanted to challenge the <w>established</w> order of the financial elite.",
                            "target_lang_translations": {
                                "ru": "Он хотел бросить вызов <w>устоявшемуся</w> порядку финансовой элиты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "established order",
                        "established elite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к истеблишменту (группам, обладающим социально-экономической властью)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правящий",
                                "target_lang_sense_clarification": "о классах, элите"
                            },
                            {
                                "target_lang_word": "укоренившийся",
                                "target_lang_sense_clarification": "о политическом или социальном порядке"
                            },
                            {
                                "target_lang_word": "традиционный",
                                "target_lang_sense_clarification": "о партиях, институтах власти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4bf87e5-affd-3502-989c-4dea0a25d6d7",
                    "sense_definition": "simple past and past participle of <w>establish</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>established</w> new rules for the upcoming competition.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>установил</w> новые правила для предстоящего соревнования."
                            }
                        },
                        {
                            "text": "Once the connection was <w>established</w>, they began transmitting the data.",
                            "target_lang_translations": {
                                "ru": "Как только соединение было <w>установлено</w>, они начали передачу данных."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола establish (учреждать, устанавливать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "установил",
                                "target_lang_sense_clarification": "прошедшее время от 'установить'"
                            },
                            {
                                "target_lang_word": "учредил",
                                "target_lang_sense_clarification": "прошедшее время от 'учредить'"
                            },
                            {
                                "target_lang_word": "установленный",
                                "target_lang_sense_clarification": "причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}