                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c1dbc1-cdb6-477b-853c-897134392fc2",
                                                "sense_id": "823087e5-3655-37ea-b7d7-a58bb432d966",
                                                "text": "Kurt Hahn war ein deutscher Pädagoge."
                                            },
                                            {
                                                "example_id": "bdb368a9-002a-4818-93c7-3c79786225fe",
                                                "sense_id": "823087e5-3655-37ea-b7d7-a58bb432d966",
                                                "text": "Herr Hahn wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "5a0d1818-03e8-4eab-bfc3-614713a8d7c3",
                                                "sense_id": "823087e5-3655-37ea-b7d7-a58bb432d966",
                                                "text": "Die Hahns fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "de6755c3-b74e-45de-bdde-9bb5a13992d3",
                                                "sense_id": "823087e5-3655-37ea-b7d7-a58bb432d966",
                                                "text": "Der Hahn trägt nie die Pullover, die die Hahn ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
