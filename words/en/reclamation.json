{
    "word_family": [
        "reclaim",
        "reclaimable",
        "unreclaimed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e391833-249f-3b0b-b29d-c1cc42d35557",
                    "sense_definition": "The process of converting wasteland, wetlands, or underwater areas into land suitable for cultivation, building, or other use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land_recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city expanded into the bay through extensive land <w>reclamation</w> projects.",
                            "target_lang_translations": {
                                "ru": "Город расширился в сторону залива благодаря масштабным проектам по <w>намыву и освоению земель</w>."
                            }
                        },
                        {
                            "text": "Environmentalists expressed concern about how the <w>reclamation</w> of coastal wetlands might disrupt local wildlife.",
                            "target_lang_translations": {
                                "ru": "Экологи выразили обеспокоенность тем, как <w>осушение</w> прибрежных водно-болотных угодий может нарушить жизнь местной фауны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "land reclamation",
                        "coastal reclamation",
                        "reclamation project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс освоения и улучшения непригодных земель, болот или прибрежных участков для сельского хозяйства или строительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелиорация",
                                "target_lang_sense_clarification": "улучшение земель"
                            },
                            {
                                "target_lang_word": "рекультивация",
                                "target_lang_sense_clarification": "восстановление нарушенных земель"
                            },
                            {
                                "target_lang_word": "освоение земель",
                                "target_lang_sense_clarification": "ввод новых земель в оборот"
                            },
                            {
                                "target_lang_word": "намыв территории",
                                "target_lang_sense_clarification": "создание искусственной суши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c23e68ec-8a4c-38ac-b723-0401ebc975f0",
                    "sense_definition": "The act of regaining, recovering, or restoring something from a damaged, abandoned, or lost condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reclamation</w> of discarded materials helps the factory reduce industrial waste.",
                            "target_lang_translations": {
                                "ru": "<w>Вторичная переработка</w> выброшенных материалов помогает фабрике сокращать промышленные отходы."
                            }
                        },
                        {
                            "text": "Historians celebrated the cultural <w>reclamation</w> of lost traditions by younger generations.",
                            "target_lang_translations": {
                                "ru": "Историки приветствовали культурное <w>возрождение</w> утраченных традиций молодым поколением."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery",
                        "restoration",
                        "salvage"
                    ],
                    "common_phrases": [
                        "water reclamation",
                        "material reclamation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение, восстановление или повторное использование того, что было утрачено, повреждено или заброшено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "возвращение к прежнему состоянию"
                            },
                            {
                                "target_lang_word": "вторичная переработка",
                                "target_lang_sense_clarification": "утилизация и повторное использование материалов"
                            },
                            {
                                "target_lang_word": "возврат",
                                "target_lang_sense_clarification": "обретение заново"
                            },
                            {
                                "target_lang_word": "регенерация",
                                "target_lang_sense_clarification": "восстановление ресурсов или сырья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}