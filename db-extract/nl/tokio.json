                        "translation_id": "b61a905f-e1bc-4b47-b2fa-50b73a1181f8",
                        "source_entry_id": "aed54bdd-93c2-3b2f-a91d-5640fc2fef8e",
                        "source_sense_id": "c0749df0-4d3c-3604-9195-22852d52b92f",
