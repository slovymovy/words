        "fr-extract.jsonl": [
            {
                "entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                "word": "Émilie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0df9763-a25f-4312-aeda-0be28265b17a",
                        "entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Émile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                        "entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18fc941b-e2d4-49f6-8b7c-9d11672293e7",
                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                "text": "Hakim Belaroussi (institut Capeline), Nelly El Shafey (Hypsome), Capucine Huguet (Capucine H), Émilie Geissler (restauration de tableaux), Marie-Cécile Kfouri (restauration et conservation de peintures) et Ève Mallet-Mire (architecture de design d’intérieur) viennent rejoindre les précédents lauréats."
                            },
                            {
                                "example_id": "f5dd29ff-ebc1-477c-855c-fcae9468e1d4",
                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                "text": "Le duo formé d’Émilie Satt et Jean-Karl Lucas, en couple à la ville, sort ce vendredi son troisième album studio"
                            },
                            {
                                "example_id": "e3b8e886-5d46-4572-b92d-5f45cca2c692",
                                "sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                                "text": "Les enseignantes ont également participé à ces remises. À savoir : Élisa Petit, Emmie Bourrel, Émilie Chastagner, Flora Guyonnet, Aurélie Decarre, Karine Narsou et de la directrice Catherine Munoz."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c80f3fde-bb6b-46e0-8a1e-793138a67cb8",
                        "source_entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                        "source_sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                        "target_lang_word": "Emilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6078e597-3d04-49bb-b283-421ce9dd13fe",
                        "source_entry_id": "86ff37a9-7e5e-3ed3-8312-0bbd88325784",
                        "source_sense_id": "ac9ac2e6-862d-3936-9d52-4802eed2ddca",
                        "target_lang_word": "Emily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                        "entry_id": "d4302808-c701-3edb-b8a0-74c14517124a",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2143c47f-1faf-468c-94e8-d03c3215c263",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "1380s-1390s, Geoffrey Chaucer, The Canterbury Tales: The Knight's Tale\nI am thy mortal foe, and it am I\nThat so hot loveth Emily the bright,\nThat I would die here present in her sight."
                                            },
                                            {
                                                "example_id": "7a0365c5-e934-4593-9f6b-69fe69d11428",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "People will please their fancies, and every lady has her favourite names. I myself have several, and they are mostly short and simple. - - - Emily, in which all womanly sweetness seems bound up - perhaps this is the effect of association of ideas - I have known so many charming Emilys"
                                            },
                                            {
                                                "example_id": "6b82a160-2ca3-4ed3-b423-54698169bd31",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "This may have accounted for Emma's Christian name, for it had seemed to Beatrix unfair to call her daughter Emily, a name associated with her grandmother's servants rather than the author of The Wuthering Heights, so Emma had been chosen, perhaps with the hope that some of the qualities possessed by the heroine of the novel might be perpetuated."
                                            },
                                            {
                                                "example_id": "713fb3a1-2471-43a7-8af3-55986f475bca",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "Emily. Em-il-y, three syllables, like a knock on the door of destiny. Such an odd, old-fashioned name, compared to those Kylies and Traceys and Jades — names that reeked of Impulse and grease and stood out in gaudy neon colours — whilst hers was that muted, dusky pink, like bubblegum, like roses —"
                                            },
                                            {
                                                "example_id": "efd10cc5-e7ae-4dbb-8e2c-602fa8fce3cc",
                                                "sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
                                                "text": "Emily Sisson set a new record for an American woman when she finished second at the Bank of America Chicago Marathon Sunday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
