                ],
                "senses": [
                    {
                        "sense_id": "ffc9b3fe-d938-3542-bc7e-aea03bbf8da9",
                        "entry_id": "bc8dda05-860b-30af-b54b-c2be08b86d95",
                        "glosses": [
                            "Mesocricetus auratus een veel als huisdier gehouden knaagdier uit de familie Cricetidae"
                        ],
                        "tags": [
                            "knaagdieren"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce9b3d4-6718-4cf8-8a1e-c9afe709690e",
                                "sense_id": "ffc9b3fe-d938-3542-bc7e-aea03bbf8da9",
                                "text": "Het is trouwens alleen de Syrische hamster (goudhamster) die gevoelig is voor winterslaap. Dwerghamsters hebben er voor zover bekend geen last van."
                            },
                            {
                                "example_id": "165ed1ae-6d05-480c-ae0c-8d0fe5a1ad71",
                                "sense_id": "ffc9b3fe-d938-3542-bc7e-aea03bbf8da9",
                                "text": "Zelfs een goudhamster onderhouden kost al 300 euro per jaar, blijkt uit cijfers die de Wageningen Universiteit in november publiceerde."
                            },
                            {
                                "example_id": "2a01730e-a0a9-468f-887d-9d091dd68caa",
                                "sense_id": "ffc9b3fe-d938-3542-bc7e-aea03bbf8da9",
                                "text": "„Voor onze kinderen ging er een wereld open. Van goudhamsters tot kippen, konijnen en poezen en we hadden de ruimte om onze hobby’s uit te oefenen. De kinderen moesten op de fiets naar Schagen voor de middelbare school en om te stappen, maar daar krijg je karakter van, zei onze oude buurvrouw altijd.”"
                            },
                            {
                                "example_id": "b37cd877-f5c3-4d9c-af0a-225252e1d92e",
                                "sense_id": "ffc9b3fe-d938-3542-bc7e-aea03bbf8da9",
                                "text": "Zowel de veiligheid van de Syrische goudhamster in Nederlandse huisgezinnen als het welzijn van angorakonijnen op boerderijen ver weg in China werd maandag besproken in de Tweede Kamer."
                            }
                        ]
                    }
                ],
