                "senses": [
                    {
                        "sense_id": "40b3ac68-d00c-3018-a6fb-0d19fb88be6d",
                        "entry_id": "22bed3e1-2913-3205-8e8d-f0b28c40d7e3",
                        "glosses": [
                            "bauliche Gesamtheit aller vorbeugenden Sicherheitsmaßnahmen, die die Ausbreitung von Lärm (= subjektiv störender Schall) mittels Hindernisse verhindern oder dessen lokale Auswirkungen begrenzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08276e5f-cf88-490e-a5f0-4b78981d7a1f",
                                "sense_id": "40b3ac68-d00c-3018-a6fb-0d19fb88be6d",
                                "text": "„In Andisleben fordern die Anwohner eine Lärmschutzwand um den Verkehrslärm der Bundesstraße 4 vom Dorf fern zu halten.“"
                            },
                            {
                                "example_id": "4f47f94d-2217-4077-a12b-3436d44f66c5",
                                "sense_id": "40b3ac68-d00c-3018-a6fb-0d19fb88be6d",
                                "text": "„Der Bau von Lärmschutzwänden kostet den Steuerzahler oder Investor viel Geld.“"
                            },
                            {
                                "example_id": "4758293d-1a97-458e-b02b-59b3c33bf103",
                                "sense_id": "40b3ac68-d00c-3018-a6fb-0d19fb88be6d",
                                "text": "„Gegen das Grünau-Quartier hin soll eine Lärmschutzwand aus unterschiedlich getrübtem Glas entstehen.“"
                            },
                            {
                                "example_id": "cd964903-a5d1-4788-8c53-6b54111238a8",
                                "sense_id": "40b3ac68-d00c-3018-a6fb-0d19fb88be6d",
                                "text": "„Als wirtschaftlichste und wirkungsvollste aktive Lärmschutzmaßnahme werden vom Projektträger Lärmschutzwände von 3 m Höhe ab Gleisbett vorgeschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
