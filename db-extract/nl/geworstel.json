                                                "example_id": "55e9e7c7-c12a-480a-9097-ba3a90de3472",
                                                "sense_id": "881519ba-4cda-38e9-9a6e-f7747ccb10fd",
                                                "text": "All the strugglings of genius in thee, have never equalled the strugglings of virtue in him."
                                            }
                                        ]
