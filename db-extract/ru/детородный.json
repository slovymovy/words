                                    },
                                    {
                                        "sense_id": "4c5b2e42-1d49-3666-8e21-cb6559d95c70",
                                        "entry_id": "198817c5-d669-3284-af95-18814c763c6b",
                                        "glosses": [
                                            "Of or relating to the genitalia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f149922-001c-401e-953d-cceb50ea19c1",
                                                "sense_id": "4c5b2e42-1d49-3666-8e21-cb6559d95c70",
                                                "text": "In countless Hollywood movies we see the story of two soldiers or sailors on leave; for them the pursuit of women is simply a way of relieving a genital pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34dd4904-1844-3032-9fa7-77cb10bfcd22",
                                        "entry_id": "198817c5-d669-3284-af95-18814c763c6b",
                                        "glosses": [
                                            "Of or relating to psychosexual development during puberty."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "genital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                        "entry_id": "d849191d-783a-34ed-8b1f-8bc1be4d4bd7",
                                        "glosses": [
                                            "A genital organ."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c908204-e3c7-489a-9de3-c372f6268f2e",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "( b ) the masturbation [...] served as evidence that his genital was not injured (\"fixing feet\")"
                                            },
                                            {
                                                "example_id": "35226421-85d8-474c-94b9-cab607d74edc",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "David told of his fears of castration and his concern that his genital was not as large as another boy's on the ward, and perhaps would never be."
                                            },
                                            {
                                                "example_id": "e26206d5-f7e2-43d1-82c6-e4f0257ad79f",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "[…] the anxiety and distress that his genital was dirty, disgusting and dangerous to his mother (myself); the dread of the bad internalized penis and his own faeces and urine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
