                ],
                "senses": [
                    {
                        "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                        "entry_id": "27ae932b-e7d7-3a25-9aab-70f83d5e7cd7",
                        "glosses": [
                            "Abend vor Weihnachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7027941a-7858-4a7f-83aa-419ff4c24caf",
                                "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                                "text": "Am Weihnachtsabend findet die Bescherung statt."
                            },
                            {
                                "example_id": "923924c8-9991-4e4d-916c-7aba4bb7c9b4",
                                "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                                "text": "„In der alten Backstube, dort in der kleinen Stadt, wurde sie am Weihnachtsabend geboren.“"
                            },
                            {
                                "example_id": "f6891a7a-0cce-4e73-aa50-8bf984390f5e",
                                "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                                "text": "„Schon am zweiten Weihnachtsabend drängte Hugo zurück nach Köln.“"
                            },
                            {
                                "example_id": "d4b49fd7-2ea6-47ee-8ad1-4e1907a51d80",
                                "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                                "text": "„Als der Weihnachtsabend herannaht, fürchten wir uns zunächst.“"
                            },
                            {
                                "example_id": "2f1ad085-5013-4b07-a5a2-cac3f0007d42",
                                "sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                                "text": "„Am Weihnachtsabend teilte sie mir mit, daß sie ihren Liebhaber zurückerwarte, am Stephanstag mit ihm in die Oper gehen und am dritten Feiertag mit ihm in der Villa soupieren solle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc06beb7-73dd-4daa-9d4f-7dc5c93c3ac5",
                        "source_entry_id": "27ae932b-e7d7-3a25-9aab-70f83d5e7cd7",
                        "source_sense_id": "09ca2138-b7ed-3d4b-934e-4db5807ae04b",
                        "source_sense_description": "der 24. Dezember",
                        "target_lang_word": "Christmas Eve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christmas Eve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fafb242a-0771-3117-afd6-c5140bd57395",
                                        "entry_id": "2f69bc12-ec2b-36df-ba20-89dabd2f05dd",
                                        "glosses": [
                                            "The evening before Christmas Day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                        "entry_id": "2f69bc12-ec2b-36df-ba20-89dabd2f05dd",
                                        "glosses": [
                                            "The day before Christmas Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d22bd3-b93f-4bf9-b6b2-383128702613",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "This Collect is to be repeated every day with the other Collects in Advent, until Christmas-Eve."
                                            },
                                            {
                                                "example_id": "972ebf89-cde5-4c61-abce-1fa45cf73673",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "With trembling fingers did we weave\n⁠The holly round the Chrismas hearth;\n⁠A rainy cloud possess’d the earth,\nAnd sadly fell our Christmas-eve."
                                            },
                                            {
                                                "example_id": "d01780cf-1603-4579-b8f0-414b47654ade",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "Why was the cock supposed to crow all Christmas Eve (\"The bird of dawning singeth all night long\")?"
                                            },
                                            {
                                                "example_id": "fd067689-b964-4159-aa33-1fb2bea0ffde",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "The family celebrated Christmas Eves together in the military stockade, sleeping on mattresses on the floor of Ninoy’s cell."
                                            },
                                            {
                                                "example_id": "e186699d-d9e4-4acf-bd04-f9dbc6b5e721",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "Brad led Matthew into the family room where they celebrated Christmas Eves and told Matthew, “Papa’s gone. He’s in heaven, and we’ll never see him again.”"
                                            },
                                            {
                                                "example_id": "eca0f13a-e9e2-4693-93ea-b40d66aa9bc5",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "And I was mourning the future, too. That Wally wouldn’t spend Christmas Eves with both of his parents, dressed up like a Santa or a Christmas pudding, overindulged in the morning."
                                            },
                                            {
                                                "example_id": "7a6cebe3-77a8-483d-9fb2-2975043487ca",
                                                "sense_id": "9afff126-c3a5-38fe-9883-724e5a171a83",
                                                "text": "In 1965, all Coventry's banks closed at noon on Christmas Eve for the first time, to \"enable bank staff to get away at a reasonable time\". […] On Christmas Day itself there will be no trains, for recent experience has shown that few wish to travel then, even on services which had been drastically reduced: earlier closing of shops and offices on Christmas Eve is the chief reason for this change in the pattern of travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e151fd4-35d7-4b95-b71d-740d0e8cd479",
                        "source_entry_id": "27ae932b-e7d7-3a25-9aab-70f83d5e7cd7",
