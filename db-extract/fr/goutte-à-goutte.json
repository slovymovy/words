        "fr-extract.jsonl": [
            {
                "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                "word": "goutte-à-goutte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "280a3c4b-881d-4c08-bfac-3eb2c1e321b7",
                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "tags": [],
                        "form": "goutte à goutte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "glosses": [
                            "Mode d'administration d'une solution médicamenteuse par perfusion. Dispositif permettant ce mode d'administration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2d5a372-000e-4c66-8a80-06734550cd30",
                                "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                                "text": "Presque aussitôt, deux infirmières accoururent pour assister le réveil des patients et les aider à se débarrasser du goutte-à-goutte qui depuis plusieurs heures diffusait dans leur organisme une solution médicamenteuse à base de DMT, un puissant psychotrope hallucinogène."
                            },
                            {
                                "example_id": "2abb17c0-ea17-4fff-ad16-7b6d41c8b7ae",
                                "sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                                "text": "Sur la gauche, relié au bras de maman, il y avait un goutte-à-goutte. De son nez sortait un tuyau en plastique transparent qui, à travers des machineries compliquées, aboutissait à un bocal."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d678fcd-68d4-3721-8c54-f48fa5e488f1",
                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "glosses": [
                            "Arrosage par micro-irrigation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f310a20-4016-460a-a8fb-103ca67da7d9",
                                "sense_id": "0d678fcd-68d4-3721-8c54-f48fa5e488f1",
                                "text": "Le goutte-à-goutte économise de l’eau, réduit les risques de maladies et gagne du temps !"
                            }
                        ]
                    },
                    {
                        "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                        "entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "glosses": [
                            "Écoulement lent et en très petite quantité d’un liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3bb1e33-0ae9-4a34-974b-8d9453f156f1",
                                "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                                "text": "[…] entre des façades à encorbellement reliées par des cordes à linge d’où tombaient le goutte à goutte des lessives."
                            },
                            {
                                "example_id": "328ed08f-7b53-4cf7-9a63-37ea30cfa85b",
                                "sense_id": "82650680-de83-3662-b284-7b1e5b6fbb22",
                                "text": "Assis dans un fauteuil du salon, le visage entre les mains, j’entendais, çà et là, le goutte-à-goutte philharmonique et obsédant des dernières poches d’eau qui se vidaient à l’étage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e983d24-bfd3-41c7-8f50-d9ef8595833b",
                        "source_entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "source_sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                        "source_sense_description": "Mode d’administration d’une solution médicamenteuse",
                        "target_lang_word": "Tropf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tropf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                        "entry_id": "05fbe601-a8ca-3810-8dab-9c569724dd55",
                                        "glosses": [
                                            "Vorrichtung für eine medizinische Infusion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405c520c-e968-46fc-8344-a8a0551fd43d",
                                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                                "text": "Sie lag im Koma und wurde mit dem Tropf ernährt."
                                            },
                                            {
                                                "example_id": "4a2413bd-fefc-4052-8c85-48bf7096a9d6",
                                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                                "text": "„Die Schwester kam und hängte ein kleines Fläschchen vom Tropf ab und ein neues hinzu.“"
                                            },
                                            {
                                                "example_id": "3b24338e-fe38-4c11-baa8-38801e11e977",
                                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                                "text": "„Eigentlich müsste es längst pleite und verwüstet sein und am Tropf hängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                                        "entry_id": "05fbe601-a8ca-3810-8dab-9c569724dd55",
                                        "glosses": [
                                            "armer oder bedauernswerter Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29bb3c8-6fab-4b25-bd76-4f7e1bb7e64e",
                                                "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                                                "text": "Lass ihn in Frieden, der arme Tropf hat's schwer genug."
                                            },
                                            {
                                                "example_id": "134fbb02-fd42-4d44-84f5-3ab74bbac6ae",
                                                "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                                                "text": "„Die Komödie lässt den armen Tropf neben all den glücklichen Paaren nicht nur im Regen stehen, sondern tunkt ihn in die Traufe des Wahnsinns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc0913a5-2dc3-3be0-b963-8e5aacb54000",
                                        "entry_id": "05fbe601-a8ca-3810-8dab-9c569724dd55",
                                        "glosses": [
                                            "einfältiger, geistig „minderbemittelter“ Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baaf02f8-92e5-4fe8-bad6-70f65cc3937e",
                                                "sense_id": "dc0913a5-2dc3-3be0-b963-8e5aacb54000",
                                                "text": "Der Tropf hat nicht einmal gemerkt, welches Kleinod er da so gut wie verschenkt hat, grinste der Schmied."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e465ef49-a89d-4191-bb56-13c0b9e6c915",
                        "source_entry_id": "aeb90ab5-c10d-3d8a-ab41-27a51b355961",
                        "source_sense_id": "bb5ee308-ffca-32cb-b079-8e5619c93f61",
                        "source_sense_description": "Mode d’administration d’une solution médicamenteuse",
                        "target_lang_word": "drip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "622a6ac4-f132-3b30-b177-a26094cf5fcb",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To fall one drop at a time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25675a9f-ca1f-470b-b852-406ab7f9a179",
                                                "sense_id": "622a6ac4-f132-3b30-b177-a26094cf5fcb",
                                                "text": "Listening to the tap next door drip all night drove me mad!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "030a7e63-858b-3570-ac28-6a6b7f677a37",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To leak slowly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c14e72-0ea1-445a-a5d8-651e379f9e20",
                                                "sense_id": "030a7e63-858b-3570-ac28-6a6b7f677a37",
                                                "text": "Does the sink drip, or have I just spilt water over the floor?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To let fall in drops."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff73f2c-4a35-48f6-a576-52e6e61ace67",
                                                "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                                                "text": "After putting oil on the side of the salad, the chef should drip a little vinegar in the oil."
                                            },
                                            {
                                                "example_id": "801b71f4-80d6-4a58-9524-0bc00387a8de",
                                                "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                                                "text": "My broken pen dripped ink onto the table."
                                            },
                                            {
                                                "example_id": "39c3af2a-45e0-4f38-ad3f-905f5caf9bc6",
                                                "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                                                "text": "c. 1726, Alexander Pope (probable author), The Lamentation of Glumdalclitch\nWhich from the thatch drips fast a shower of rain."
                                            },
                                            {
                                                "example_id": "31d3a00f-d529-4bb2-a40c-97e7ac9858f7",
                                                "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd592233-77a0-37e1-848a-b3192501ca07",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To have a superabundance of (something)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c57cc44b-3c4a-4e3b-a4b8-5797b46905ee",
                                                "sense_id": "dd592233-77a0-37e1-848a-b3192501ca07",
                                                "text": "The Old Hall simply drips with masterpieces of the Flemish painters."
                                            },
                                            {
                                                "example_id": "a50013de-76ba-487e-9458-5d1cd43363fc",
                                                "sense_id": "dd592233-77a0-37e1-848a-b3192501ca07",
                                                "text": "The duchess was dripping with jewels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8220eaa9-0179-3236-b3bb-1e475e913209",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To rain lightly; to drizzle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d47f99-ba36-4304-acc6-b72abf6cacb3",
                                                "sense_id": "8220eaa9-0179-3236-b3bb-1e475e913209",
                                                "text": "The weather isn't so bad. I mean, it's dripping, but you're not going to get so wet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a9c108f-ebf1-3d0b-bb4e-c2a19e2aa636",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To be wet, to be soaked."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26e7d236-cb3a-35f0-8dca-29ca5fe895c8",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "To whine or complain consistently; to grumble."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e474b7a1-ede3-42e6-b437-9f64a9456194",
                                                "sense_id": "26e7d236-cb3a-35f0-8dca-29ca5fe895c8",
                                                "text": "The Women's Royal Naval Service was integrated with the Royal Navy in November 1993. […] Men interviewed by Public Eye (April, 1994) said they should 'stop dripping about it' and that women should learn to 'take it like a man […]"
                                            },
                                            {
                                                "example_id": "9dabac53-0323-41bf-9e18-4748033eb747",
                                                "sense_id": "26e7d236-cb3a-35f0-8dca-29ca5fe895c8",
                                                "text": "The government had been slowly running down the Royal Navy Organisation to save money on various peoples' budgets, so now we had to sub-contract ships to go to war! So stop dripping and \"make it so\", all those admirals can't be wrong!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de77da7-4d18-359c-b1ea-c6dda4e15af2",
                                        "entry_id": "f3ee4eb8-cf63-3c32-947f-75be835ca30b",
                                        "glosses": [
                                            "Be impressive or attractive."
                                        ],
                                        "tags": [
                                            "slang",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd24fd39-1573-427b-ad0a-acb76143345b",
                                                "sense_id": "6de77da7-4d18-359c-b1ea-c6dda4e15af2",
                                                "text": "I'm sorry for drippin', but drip is what I do. And one of these days, I'm gon' get dressed and drip all over you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "A drop of a liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e67270-60d0-4e88-aaa0-bb4f06e63840",
                                                "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                                                "text": "I put a drip of vanilla extract in my hot cocoa."
                                            },
                                            {
                                                "example_id": "37798008-6c63-443b-9198-1822fdd4d40c",
                                                "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                                                "text": "I need a bucket to catch the drips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9905df42-8b93-31be-8052-1605fb905e50",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "A falling or letting fall in drops; act of dripping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdaae55c-b123-4cdd-b603-be820ac5fcb6",
                                                "sense_id": "9905df42-8b93-31be-8052-1605fb905e50",
                                                "text": "the light drip of the suspended oar"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd60452-8186-386a-82ba-678b814e67db",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "An apparatus that slowly releases a liquid, especially one that intravenously releases drugs into a patient's bloodstream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c811363b-060c-4ae5-bffe-b960acff60e7",
                                                "sense_id": "fdd60452-8186-386a-82ba-678b814e67db",
                                                "text": "He's not doing so well. The doctors have put him on a drip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "A limp, ineffectual, or uninteresting person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de90b92-23bc-42b7-b42d-4f9f6d8d0814",
                                                "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                                "text": "He couldn't even summon up the courage to ask her name... what a drip!"
                                            },
                                            {
                                                "example_id": "fc71de75-f09b-4aa2-b2b2-bab845cc8200",
                                                "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                                                "text": "Because most of the blokes I fancy think l'm stupid and pointless—and, so, they just bonk me and then leave me. And the kind of blokes that do fancy me, I think are drips. I can't even be bothered to bonk them. Which does sort of leave me a bit nowhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd775a85-2b77-380e-a0ab-58ce38c5bd5a",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "That part of a cornice, sill course, or other horizontal member, which projects beyond the rest, and has a section designed to throw off rainwater."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "Style; swagger; fashionable and/or expensive clothing."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dedbaa04-cb4d-47f5-970a-ae7559872591",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "His drip is looking fine, especially the Supreme t-shirt."
                                            },
                                            {
                                                "example_id": "49df4d5d-8a5d-412b-b00b-94aa896db10e",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "Hailey decided to show off her drip with a soft, white fluff jacket […]"
                                            },
                                            {
                                                "example_id": "dbb58375-7f86-47fd-80d8-58d640b372fa",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "The cold weather can't stop your drip."
                                            },
                                            {
                                                "example_id": "385526c3-27ef-4cd3-b31a-1181d90f48ce",
                                                "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                                                "text": "Staying true to their purpose, all this exciting drip will be available at the most pocket-friendly prices."
                                            }
                                        ]
                                    }
                                ]
                            },
