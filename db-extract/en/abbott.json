                        "target_lang_word": "Labbé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Labbé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2783d5c-ce4d-3ece-a79e-a4a16ac8f7b9",
                                        "entry_id": "e4f532f3-1e25-3220-b56b-232351b5d157",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61eb81e9-83d2-4cf8-a2ef-98f5144d602b",
                                                "sense_id": "c2783d5c-ce4d-3ece-a79e-a4a16ac8f7b9",
                                                "text": "Labbé a cette solide réputation de rapporter ses voitures en un morceau en fin de course."
                                            },
                                            {
                                                "example_id": "2272af33-de1d-4346-81a5-51f6e0b8d346",
                                                "sense_id": "c2783d5c-ce4d-3ece-a79e-a4a16ac8f7b9",
                                                "text": "Elle y incarne une mère dont les certitudes basculent lorsque son fils, joué par Guillaume Labbé, est accusé de violer son petit-fils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f65c4fb2-4674-48c6-9157-6aacc0b65601",
                        "source_entry_id": "8454ba66-1b95-3768-99b4-ce920e0c1e99",
                        "source_sense_description": "surnames derived from the equivalents of “abbot”",
                        "target_lang_word": "Abt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ceffd2d-7686-36d1-abf9-e5e42890a6b9",
                                        "entry_id": "41d889aa-161f-3fd9-aed0-32d777310dc4",
                                        "glosses": [
                                            "ein Vorsteher und geistlicher Leiter eines Klosters im Rang einer Abtei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fe89df-2458-4551-8ac9-d13d82fbe138",
                                                "sense_id": "0ceffd2d-7686-36d1-abf9-e5e42890a6b9",
                                                "text": "„Der Vatikan habe die Wahl des Abtes bestätigt, teilte das Kloster am Montagabend mit.“"
                                            },
                                            {
                                                "example_id": "9acd021d-6bc6-4d73-911f-733491292f54",
                                                "sense_id": "0ceffd2d-7686-36d1-abf9-e5e42890a6b9",
                                                "text": "„Nach dem Ende des Abendessens machte der Abt ernst.“"
                                            },
                                            {
                                                "example_id": "9c5900f6-5936-4822-b694-0c971f375dda",
                                                "sense_id": "0ceffd2d-7686-36d1-abf9-e5e42890a6b9",
                                                "text": "„Natascha kam, der Abt erteilte ihr den Segen und riet ihr, sich an Gott und seine Heiligen um Trost und Hilfe zu wenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Abt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56ca2f68-f9d3-3757-afe0-d10bb12586fa",
                                        "entry_id": "d91edf30-ed31-37e6-aec0-97b46603824b",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118f1c75-19b4-411c-bbbb-1a309c19397d",
                                                "sense_id": "56ca2f68-f9d3-3757-afe0-d10bb12586fa",
                                                "text": "Doktor Abt hat mir die Weisheitszähne gezogen."
                                            },
                                            {
                                                "example_id": "3c50ae96-c28c-4766-9d28-448ca1365cb8",
                                                "sense_id": "56ca2f68-f9d3-3757-afe0-d10bb12586fa",
                                                "text": "Abts fahren jedes Jahr nach Plön zu Camping."
                                            },
                                            {
                                                "example_id": "7d70b0e6-37a0-4323-9862-a356b2cb02d3",
                                                "sense_id": "56ca2f68-f9d3-3757-afe0-d10bb12586fa",
                                                "text": "Der Abt schwört auf Mercedes und die Abt auf BMW."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
