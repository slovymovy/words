                                "target_senses": [
                                    {
                                        "sense_id": "2af1daea-229a-3ff8-a307-08d607d8a247",
                                        "entry_id": "33eef6e2-2bf9-3f41-8116-d0484e538ee6",
                                        "glosses": [
                                            "Relatif à un paradigme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52242ff1-4157-4ead-bd9b-771301b755c1",
                                                "sense_id": "2af1daea-229a-3ff8-a307-08d607d8a247",
                                                "text": "Les liens syntagmatiques augmentent entre 5 et 6 ans et décroissent ensuite pour laisser place à des réponses d’ordre paradigmatique ; celles-ci s’établissent à des rythmes différents pour les unités des diverses classes grammaticales."
                                            },
                                            {
                                                "example_id": "5f05e3b1-3421-4cf1-b886-6523a7b31c2b",
                                                "sense_id": "2af1daea-229a-3ff8-a307-08d607d8a247",
                                                "text": "Enfin, vint pour moi le jour d’une embuscade véritable, paradigmatique, eidétique même, très bien préparée."
                                            },
                                            {
                                                "example_id": "9a02cad1-1a3f-4651-b17d-dcf3c4c2198a",
                                                "sense_id": "2af1daea-229a-3ff8-a307-08d607d8a247",
                                                "text": "Peut-être est-ce là cette révolution, cette transformation, ce soulèvement paradigmatique dont nous parlons tant, qui nous préoccupent tant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
