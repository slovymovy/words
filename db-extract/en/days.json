                            {
                                "example_id": "be71d565-ae2f-40e8-8102-d0c20b23b517",
                                "sense_id": "775a86ab-bba7-37e8-bde5-2b9bd5103fce",
                                "text": "She works days at the garage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d3c3266-92cb-46ad-9a6b-43e6ac4c7a8a",
                        "source_entry_id": "17d14ec3-fb1e-37a1-85dc-171086cc47dd",
                        "source_sense_id": "775a86ab-bba7-37e8-bde5-2b9bd5103fce",
                        "source_sense_description": "during the day",
                        "target_lang_word": "tagsüber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tagsüber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc0d545-08da-3923-8de7-32b826a4c3b6",
                                        "entry_id": "370f88ac-d92b-3a01-b1bf-39d8d5976ae5",
                                        "glosses": [
                                            "während des Tages; im Verlauf des Tages"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa8a420-076e-41b4-a6f6-852daa334c54",
                                                "sense_id": "9cc0d545-08da-3923-8de7-32b826a4c3b6",
                                                "text": "Tagsüber sitze ich an der Doktorarbeit und nachts gehe ich in die Disko."
                                            },
                                            {
                                                "example_id": "91dc4c66-0032-4e6a-b6ec-adfd2eac793c",
                                                "sense_id": "9cc0d545-08da-3923-8de7-32b826a4c3b6",
                                                "text": "Auch tagsüber gehen die Studenten in die Kneipen und trinken ein Bier."
                                            },
                                            {
                                                "example_id": "5d8a407a-3173-49ce-8302-27bad4218149",
                                                "sense_id": "9cc0d545-08da-3923-8de7-32b826a4c3b6",
                                                "text": "„Tagsüber bleiben die Zellentüren offen, wir gehen im Käfig des schmalen Korridors auf und ab, auf und ab, draußen vorm Gitter wachen Tag und Nacht die Wärter.“"
                                            },
                                            {
                                                "example_id": "9a43bb0f-d145-463a-b322-261812eed9d0",
                                                "sense_id": "9cc0d545-08da-3923-8de7-32b826a4c3b6",
                                                "text": "„Tagsüber ist es hier ziemlich voll, aber morgens und abends halten sich die Menschenmassen in Grenzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2994a780-29f9-4d58-bc97-f64627e845ca",
                        "source_entry_id": "17d14ec3-fb1e-37a1-85dc-171086cc47dd",
                        "source_sense_id": "775a86ab-bba7-37e8-bde5-2b9bd5103fce",
                        "source_sense_description": "during the day",
                        "target_lang_word": "tags",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tags",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b09de98-8d4e-3785-905a-72c8f2540ff5",
                                        "entry_id": "d254e535-16ec-3330-817d-2087357df2da",
                                        "glosses": [
                                            "am (hellen) Tag, den Tag über"
                                        ],
                                        "tags": [
                                            "Zeitangabe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee72ba5-d5a5-4d72-a66f-d07579219f09",
                                                "sense_id": "0b09de98-8d4e-3785-905a-72c8f2540ff5",
                                                "text": "„Die Krise bewältigen und nebenbei Wahlen gewinnen, das ist der gemeinsame Konflikt von Union und Sozialdemokraten, sie müssen tags regieren und abends in den Hallen der Republik Schattenboxen üben.“"
                                            },
                                            {
                                                "example_id": "c0d57f03-4957-4be5-b79d-73c66ae1ecbd",
                                                "sense_id": "0b09de98-8d4e-3785-905a-72c8f2540ff5",
                                                "text": "„In beiden Fragen berät er sich mit einem Mann, der ihm nicht nur die Antworten liefert, sondern ihn tags darauf auch auf seiner Reise begleiten wird.“"
                                            },
                                            {
                                                "example_id": "1d856f6e-4b7d-4985-bfaa-7b840db91beb",
                                                "sense_id": "0b09de98-8d4e-3785-905a-72c8f2540ff5",
                                                "text": "„Ich besuchte sie tags darauf, und sie erzählte mir, daß ihr Freund gekommen sei, um sich von ihr bis zu den Weihnachtsfeiertagen zu verabschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
