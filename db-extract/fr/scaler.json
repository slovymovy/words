                "senses": [
                    {
                        "sense_id": "1f33d8fa-a324-38f6-bd2c-2a4d4e80c31c",
                        "entry_id": "87c3a888-64b6-3ec0-b402-73a691991b8f",
                        "glosses": [
                            "S’agrandir rapidement en augmentant la masse salariale et en modifiant en profondeur la structure interne de l’entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a7cdb7-b131-4dd8-a642-b257d57a6b59",
                                "sense_id": "1f33d8fa-a324-38f6-bd2c-2a4d4e80c31c",
                                "text": "En réalité, il existe 4 modèles principaux pour scaler une entreprise : augmenter son nombre de clients, augmenter ses ventes, augmenter son panier moyen et enfin, augmenter ses tarifs."
                            },
                            {
                                "example_id": "ae1b4820-d03b-4dbf-bdc2-e1339bbdabde",
                                "sense_id": "1f33d8fa-a324-38f6-bd2c-2a4d4e80c31c",
                                "text": "Pour scaler, le défi est de réussir à standardiser ses processus opérationnels tout en gardant une forte culture agile (rythme soutenable, motivation, qualité… ) car c’est ce que vos salariés sont venus chercher."
                            }
                        ]
                    }
