                        "source_sense_id": "a61a2eb7-3426-3924-926c-acce163eabd0",
                        "source_sense_description": "scientific name for white blood cell — see also white blood cell",
                        "target_lang_word": "leucocyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leucocyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                        "entry_id": "1db42ec7-1466-3889-a460-75c8e9490746",
                                        "glosses": [
                                            "Globule blanc du sang, de la lymphe et de nombreux tissus, qui est pourvu d’un noyau, contrairement aux hématies ou globules rouges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c149ea71-255d-465b-9412-d8f3c198d5e4",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "Mais outre ces leucocytes, il y a dans le pus sécrété par les plaies un bactérien qui possède aussi la propriété de provoquer la formation du pus en plus grande quantité, quand il est introduit dans les tissus vivants ; […]."
                                            },
                                            {
                                                "example_id": "2493d702-6f54-42aa-9701-cb481199ec17",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "Finalement cette formation s’est dégagée du leucocyte."
                                            },
                                            {
                                                "example_id": "71e1e35e-6551-47a0-b6a8-1e9f03b37e5f",
                                                "sense_id": "40e1bead-2e02-3806-8205-945c01b32c34",
                                                "text": "La première ligne de défense est composée d’un ensemble de cellules appelées leucocytes (ou globules blancs) qui circulent dans les tissus et le flux sanguin. Ces cellules sont plus grandes et moins nombreuses que les érythrocytes ou globules rouges, qui transportent l’oxygène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec925350-c04c-4583-97f3-51dd95a3f7cf",
