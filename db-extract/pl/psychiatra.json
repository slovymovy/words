                    },
                    {
                        "translation_id": "7d4b7c59-ea9b-4eae-9389-ea6b1903f86d",
                        "source_entry_id": "fdd5f6d7-6e5c-38d3-b160-f8fef40e20cf",
                        "source_sense_id": "72d23350-98a3-3720-a7b4-d550f3a46068",
                        "target_lang_word": "psychiater",
