                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verschillende soorten <w>schorsen</w> kunnen worden gebruikt als bodembedekker in de tuin.",
                            "target_lang_translations": {
                                "en": "Different types of <w>barks</w> can be used as ground cover in the garden."
