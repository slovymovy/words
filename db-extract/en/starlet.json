                                "target_senses": [
                                    {
                                        "sense_id": "89a7fbaa-ca74-3f97-a644-90b20df0cc9e",
                                        "entry_id": "4ae58489-162b-389b-a1c7-11eeffd19221",
                                        "glosses": [
                                            "Filmschauspielerin, die ihren Beruf aufgenommen hat und einmal ein Star werden könnte/möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
