                                "example_id": "218f2035-f592-4886-b98b-d1201b09f467",
                                "sense_id": "de13f56a-a675-323e-9a28-9578b6189c64",
                                "text": "1917, Franziska zu Reventlow, Das Logierhaus zur schwankenden Weltkugel - Kapitel 10",
