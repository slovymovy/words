                "senses": [
                    {
                        "sense_id": "39413518-873a-3c6d-a3a9-9c6702dcce8d",
                        "entry_id": "26ccd09c-02e9-3bd9-bbdf-526b0a79af4b",
                        "glosses": [
                            "das Bundesland betreffende Aktions-/Entscheidungsebene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d5c234-8471-4a62-a3c2-a7a0f09e77de",
                                "sense_id": "39413518-873a-3c6d-a3a9-9c6702dcce8d",
                                "text": "„Die Kompetenzen der unterschiedlichen Bereiche für die Ausbildung im Betrieb oder in der Schule verteilen sich dabei auf Bundes- und Länderebene.“"
                            },
                            {
                                "example_id": "66f24aad-227d-44e5-a895-908dc703ccf3",
                                "sense_id": "39413518-873a-3c6d-a3a9-9c6702dcce8d",
                                "text": "„Auch auf Länderebene, den Kantonen, können wir zu wichtigen Sachfragen unsere Stimme abgeben.“"
                            },
                            {
                                "example_id": "a4c26a64-15b9-43a9-bebe-720741b75bc2",
                                "sense_id": "39413518-873a-3c6d-a3a9-9c6702dcce8d",
                                "text": "„Unabhängig von den Verhandlungen auf Bundesebene einigten sich die Vertreter der beiden Verlegerorganisationen auf der Länderebene häufig schneller über die Fusion ihrer Organisationen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
