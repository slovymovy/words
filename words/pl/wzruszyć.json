{
    "word_family": [
        "wzruszać",
        "wzruszenie",
        "wzruszający",
        "wzruszająco",
        "poruszyć",
        "ruszyć"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb08e00e-97f9-31f0-a14a-f46d5ac66d7b",
                    "sense_definition": "wywołać w kimś silne, głębokie emocje, zwykle czułość lub współczucie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten piękny film bardzo mnie <w>wzruszył</w> i sprawił, że zacząłem płakać.",
                            "target_lang_translations": {
                                "ru": "Этот прекрасный фильм меня очень <w>растрогал</w> и заставил расплакаться."
                            }
                        },
                        {
                            "text": "Jej szczere podziękowania zdołały <w>wzruszyć</w> do łez wszystkich zebranych gości.",
                            "target_lang_translations": {
                                "ru": "Её искренние слова благодарности смогли <w>растрогать</w> до слёз всех собравшихся гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "poruszyć",
                        "rozczulić",
                        "przejąć"
                    ],
                    "common_phrases": [
                        "wzruszyć do łez"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызвать в ком-то сильные, глубокие эмоции, обычно нежность или сочувствие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрогать",
                                "target_lang_sense_clarification": "вызвать умиление или сочувствие"
                            },
                            {
                                "target_lang_word": "взволновать",
                                "target_lang_sense_clarification": "вызвать глубокие душевные переживания"
                            },
                            {
                                "target_lang_word": "тронуть",
                                "target_lang_sense_clarification": "задеть за живое, вызвать эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94028e4c-65ee-3c8c-a45c-dea4a2cc0275",
                    "sense_definition": "unieść i opuścić ramiona na znak obojętności, bezradności lub niewiedzy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy zapytałem go o drogę, tylko <w>wzruszył</w> ramionami i poszedł dalej.",
                            "target_lang_translations": {
                                "ru": "Когда я спросил у него дорогу, он лишь <w>пожал</w> плечами и пошёл дальше."
                            }
                        },
                        {
                            "text": "Nie wiedząc co odpowiedzieć na to trudne pytanie, lekko <w>wzruszyła</w> ramionami.",
                            "target_lang_translations": {
                                "ru": "Не зная, что ответить на этот трудный вопрос, она слегка <w>пожала</w> плечами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wzruszyć ramionami"
                    ],
                    "target_lang_definitions": {
                        "ru": "приподнять и опустить плечи в знак безразличия, беспомощности или незнания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожать",
                                "target_lang_sense_clarification": "в устойчивом выражении о плечах"
                            },
                            {
                                "target_lang_word": "подернуть",
                                "target_lang_sense_clarification": "слегка приподнять плечи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44df894d-6b7e-30bc-9624-eb22eafbe7ec",
                    "sense_definition": "ulec silnym emocjom, przeżyć stan głębokiego przejęcia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziadek bardzo się <w>wzruszył</w>, kiedy wnuki niespodziewanie złożyły mu życzenia.",
                            "target_lang_translations": {
                                "ru": "Дедушка очень <w>растрогался</w>, когда внуки неожиданно поздравили его."
                            }
                        },
                        {
                            "text": "Na widok starego rodzinnego domu nie mogła się nie <w>wzruszyć</w>.",
                            "target_lang_translations": {
                                "ru": "При виде старого семейного дома она не могла не <w>растрогаться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozczulić się",
                        "przejąć się"
                    ],
                    "target_lang_definitions": {
                        "ru": "поддаться сильным эмоциям, испытать состояние глубокого волнения или умиления (wzruszyć się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрогаться",
                                "target_lang_sense_clarification": "испытать умиление или сочувствие"
                            },
                            {
                                "target_lang_word": "расчувствоваться",
                                "target_lang_sense_clarification": "проявить чрезмерную чувствительность"
                            },
                            {
                                "target_lang_word": "умилиться",
                                "target_lang_sense_clarification": "испытать чувство нежности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed9dc1b-f5d7-3600-bfbb-7168d17c63d6",
                    "sense_definition": "poruszyć, rozluźnić lub spulchnić coś ubitego bądź spójnego, na przykład ziemię",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fizyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed posadzeniem nowych roślin ogrodnik musiał dokładnie <w>wzruszyć</w> ziemię motyką.",
                            "target_lang_translations": {
                                "ru": "Перед посадкой новых растений садовнику нужно было тщательно <w>взрыхлить</w> землю тяпкой."
                            }
                        },
                        {
                            "text": "Deszcz zmiękczył glebę, dzięki czemu łatwiej było <w>wzruszyć</w> twarde grządki.",
                            "target_lang_translations": {
                                "ru": "Дождь размягчил почву, благодаря чему стало легче <w>разрыхлить</w> твёрдые грядки."
                            }
                        }
                    ],
                    "synonyms": [
                        "spulchnić",
                        "rozluźnić"
                    ],
                    "common_phrases": [
                        "wzruszyć ziemię"
                    ],
                    "target_lang_definitions": {
                        "ru": "пошевелить, разрыхлить или взрыхлить что-то плотное или слежавшееся, например, землю"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыхлить",
                                "target_lang_sense_clarification": "сделать рыхлым, например, почву"
                            },
                            {
                                "target_lang_word": "разрыхлить",
                                "target_lang_sense_clarification": "нарушить плотность земли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
