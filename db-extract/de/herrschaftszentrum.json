                "senses": [
                    {
                        "sense_id": "f128247a-4058-34c3-be22-0e824a08bac8",
                        "entry_id": "d78452e5-3914-331d-91a8-e9a03cf97d87",
                        "glosses": [
                            "Ort, von dem aus Herrschaft ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec6fc1b8-8b45-4f0a-8a27-083c1643d9d9",
                                "sense_id": "f128247a-4058-34c3-be22-0e824a08bac8",
                                "text": "„Seit der Mitte des 11. Jahrhunderts, als die Seldschuken von Norden her vorrückten, mussten die Ghaznaviden ihr Herrschaftszentrum nach Lahore verlagern, das damit zum wichtigsten Zentrum islamischer und persischer Kultur auf dem Indischen Subkontinent avancierte.“"
                            },
                            {
                                "example_id": "0d11d3e5-f478-492d-8b60-5770526d9ae0",
                                "sense_id": "f128247a-4058-34c3-be22-0e824a08bac8",
                                "text": "„Es war ein Herrschaftszentrum mit einer Blütezeit zwischen etwa 1000 und 1200 n.Chr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
