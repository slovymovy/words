                        "examples": [
                            {
                                "example_id": "be9df9f2-45f0-4237-988f-1af2145cedf4",
                                "sense_id": "915b1e53-19c4-3cde-ba7f-c04ac0b7b0d8",
                                "text": "Mais elle manque encore de chair et de substance pour toucher à cet « existentialisme kinétique » vers lequel elle veut tendre, selon la chouette expression du chorégraphe trouvée dans le programme."
                            },
                            {
                                "example_id": "dc29ec6f-c21e-4051-8667-db39089a07b8",
                                "sense_id": "915b1e53-19c4-3cde-ba7f-c04ac0b7b0d8",
                                "text": "« On travaille avec différentes disciplines, le corps est une partie du spectacle, où résonnent différents champs d’action, d’idées et d’émotions », indique Kristel van Issum, qui insiste toutefois sur les qualités kinétiques particulières du corps, excavées et sculptées au fil des improvisations."
                            }
                        ]
                    }
