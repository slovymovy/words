                        "examples": [
                            {
                                "example_id": "1d0eb1b0-ffb9-48e3-8987-3eb199ba6f6f",
                                "sense_id": "a80f64b6-9bfd-3819-8368-cd0afe8df388",
                                "text": "Maar er zijn momenten geweest dat ik het gevoel had dat ik verschrikkelijk tekortschoot. Ik ben erg, misschien overdreven, plichtbewust, en als ik mijn carrière overzie heeft me dat vaak parten gespeeld."
                            },
                            {
                                "example_id": "4fe48e88-4e8c-4609-9301-90bec02c68e9",
                                "sense_id": "a80f64b6-9bfd-3819-8368-cd0afe8df388",
                                "text": "Hij had zich toen een goed onderhandelaar getoond. Hij was bovendien een trouw en plichtbewust medewerker."
                            }
                        ]
                    }
