                                "example_id": "d0ab774c-2aaf-4eae-b8ab-c290de4baabb",
                                "sense_id": "f6a18492-e3a8-332b-9da7-b082909df828",
                                "text": "„Die schwache Wirtschaftslage führt zu mehr Bürgergeldempfängern und damit zu höheren Sozialausgaben.“"
                            },
                            {
                                "example_id": "294c4436-1c77-4866-b5ce-b112adc205f3",
                                "sense_id": "f6a18492-e3a8-332b-9da7-b082909df828",
                                "text": "„Wir, die das nicht betrifft, sehen es vielleicht mit Wohlwollen, wenn man den wuchernden Sozialausgaben mit der Heckenschere zu Leibe rückt.“"
                            }
