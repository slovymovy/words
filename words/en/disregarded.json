                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>disregarded</w> the warning signs and walked onto the thin ice.",
                            "target_lang_translations": {
                                "nl": "Zij <w>negeerde</w> de waarschuwingsborden en liep het dunne ijs op."
