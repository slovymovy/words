                ],
                "translations": [
                    {
                        "translation_id": "1269492a-bd27-49ee-86c0-909121e45ffd",
                        "source_entry_id": "aef4485e-09b0-35c6-8496-9bb00d527b14",
                        "target_lang_word": "lie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To rest in a horizontal position on a surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83cf3469-4b41-489d-8f67-1e3ee555cd75",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "The book lies on the table; the snow lies on the roof; he lies in his coffin."
                                            },
                                            {
                                                "example_id": "e4fe9363-025f-48f8-aa62-c064c9c5e3af",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "Under an oak were lying asleep a pair of shepherds."
                                            },
                                            {
                                                "example_id": "bd738adb-8b2e-4099-9459-8d0634d5b470",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "Though ye haue lien among the pots, yet shall yee bee as the wings of a doue, couered with siluer, and her feathers with yellow gold."
                                            },
                                            {
                                                "example_id": "e105d265-8a4f-4f60-bde3-e004bf5adf47",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "The watchful traveller […] / Lay down again, and closed his weary eyes."
                                            },
                                            {
                                                "example_id": "89227fdb-8d09-498a-88e0-62d4802d6bbc",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "Our uninquiring corpses lie more low / Than our life's curiosity doth go."
                                            },
                                            {
                                                "example_id": "d4c18814-fd47-47f1-bd0d-80048d16b93d",
                                                "sense_id": "0bc4b833-695d-3f43-ad1b-3dfebd4ce1d1",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom. Whirling wreaths and columns of burning wind, rushed around and over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c13e0d5-254f-3348-a1f3-346d94ea952d",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To be placed or situated."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3aac3a7-2750-4f8c-963c-1f138df139bc",
                                                "sense_id": "3c13e0d5-254f-3348-a1f3-346d94ea952d",
                                                "text": "Ying-yang county lies 70 li southwest of the modern Teng-feng county, Honan."
                                            },
                                            {
                                                "example_id": "78f6b4f2-0d1b-45f4-80eb-ba21b7c9a074",
                                                "sense_id": "3c13e0d5-254f-3348-a1f3-346d94ea952d",
                                                "text": "Hepaticology, outside the temperate parts of the Northern Hemisphere, still lies deep in the shadow cast by that ultimate \"closet taxonomist,\" Franz Stephani—a ghost whose shadow falls over us all."
                                            },
                                            {
                                                "example_id": "1682dec8-b9bc-42ca-be24-c27d2af792c2",
                                                "sense_id": "3c13e0d5-254f-3348-a1f3-346d94ea952d",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f527859-b5ba-365b-a9ff-a523d0290cbc",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To abide; to remain for a longer or shorter time; to be in a certain state or condition."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44870d8-25b0-46a4-8623-078df02f4a6e",
                                                "sense_id": "2f527859-b5ba-365b-a9ff-a523d0290cbc",
                                                "text": "to lie waste; to lie fallow; to lie open; to lie hidden; to lie grieving; to lie under one's displeasure; to lie at the mercy of the waves"
                                            },
                                            {
                                                "example_id": "54d47853-371a-4e46-99bd-d71983936205",
                                                "sense_id": "2f527859-b5ba-365b-a9ff-a523d0290cbc",
                                                "text": "The paper does not lie smooth on the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa6dde2f-0f7b-3896-ac72-677ccd9bd84d",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "Used with in: to be or exist; to belong or pertain; to have an abiding place; to consist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eac48bf-6321-458b-987f-0c520335baea",
                                                "sense_id": "aa6dde2f-0f7b-3896-ac72-677ccd9bd84d",
                                                "text": "Envy lies between beings equal in nature, though unequal in circumstances."
                                            },
                                            {
                                                "example_id": "dfbdf5f5-3306-4294-93e4-4b85f68905e3",
                                                "sense_id": "aa6dde2f-0f7b-3896-ac72-677ccd9bd84d",
                                                "text": "He that thinks that diversion may not lie in hard labour, forgets the early rising and hard riding of huntsmen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de3a7d0-01df-3612-b0e6-86f45498492a",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "Used with with: to have sexual relations with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc3f54d-c29b-4e4c-9a89-b7e2944f4bcc",
                                                "sense_id": "3de3a7d0-01df-3612-b0e6-86f45498492a",
                                                "text": "And it came to passe after these things, that his masters wife cast her eyes vpon Ioseph, and shee said, Lie with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53ed40e-94a2-3dca-85ef-971dc6cb3de3",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "Used with on/upon: to be incumbent (on); to be the responsibility of a person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "811425c3-7e47-3023-98b9-86348f4de4c3",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To lodge; to sleep."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ab10f1-1bb9-4b5e-811b-c8a7ba216ba3",
                                                "sense_id": "811425c3-7e47-3023-98b9-86348f4de4c3",
                                                "text": "While I was now trifling at home, I saw London, […] where I lay one night only."
                                            },
                                            {
                                                "example_id": "fbc53e0f-e959-4478-8d65-d7070241895a",
                                                "sense_id": "811425c3-7e47-3023-98b9-86348f4de4c3",
                                                "text": "Mr. Quinion lay at our house that night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acef32db-ca57-35ae-b68e-c05f6b013b96",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To be still or quiet, like one lying down to rest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc42f09-90a2-4c4e-84bc-9e2696c537eb",
                                                "sense_id": "acef32db-ca57-35ae-b68e-c05f6b013b96",
                                                "text": "The Wind is lowd, and will not lie till the Ship be cleard of the dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c1df157-67ad-318d-afe0-ea8ba8c5365c",
                                        "entry_id": "c69c7ec3-648f-34f4-9f88-05c28dd378f2",
                                        "glosses": [
                                            "To be sustainable; to be capable of being maintained."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ee1688-88d5-45db-baca-fb6dfb4bd08f",
                                                "sense_id": "2c1df157-67ad-318d-afe0-ea8ba8c5365c",
                                                "text": "An appeal lies in this case from the ordinary to the arches."
                                            }
                                        ]
                                    }
                                ]
                            },
