                                        "examples": [
                                            {
                                                "example_id": "2d599f83-57f2-443a-be0c-fe8f531a5e61",
                                                "sense_id": "7df19dd2-0a1e-33a3-98e1-cf76484299c6",
                                                "text": "Kunstmatige voeding kan enteraal, in het maag-darmkanaal, of parenteraal, rechtstreeks in de bloedbaan, worden toegediend met een infuus of een sonde."
                                            },
                                            {
                                                "example_id": "84a64b8f-4f2c-4a96-8b98-3a24c708dc08",
                                                "sense_id": "7df19dd2-0a1e-33a3-98e1-cf76484299c6",
                                                "text": "Een zuiver anaphylactische reactie ziet hij dus in hooikoorts niet, maar hij geeft toe, dat er reden is, de hooikoorts als een afweer-reactie tegen het, door de abnormaal doorlaatbare slijmvliezen of huid parenteraal aangevoerde, eiwit op te vatten (dus een sóórt anaphylaxie), die echter verhinderd kan worden door een immuunserum tegen de sensibiliseerende stof."
                                            }
                                        ]
