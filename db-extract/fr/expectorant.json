                "translations": [
                    {
                        "translation_id": "b7e84cc7-80a5-4656-a1c6-52c31de506b1",
                        "source_entry_id": "1c45653b-31e4-3bad-b2f6-13c0631194ae",
                        "source_sense_id": "1f5f689c-933d-3015-9d0e-77187c6d0376",
