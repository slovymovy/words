                                        "glosses": [
                                            "Personne qui se drogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f6e712-919a-4075-9379-bf81ac23ea64",
                                                "sense_id": "b8810c64-8af8-38a9-a544-6f269be77ec0",
                                                "text": "— Les gars des Stups prétendent que beaucoup de drogués prennent de la méthédrine quand ils ne peuvent se procurer de l’héro. Apparemment, ça les aide à supporter les douleurs du manque."
                                            },
                                            {
                                                "example_id": "508bdb52-3519-434f-b948-6fe03bcf29b9",
                                                "sense_id": "b8810c64-8af8-38a9-a544-6f269be77ec0",
                                                "text": "Il est assuré que personne ne remarque rien, de même que les drogués peuvent aller dix fois par jour se faire leur fix aux toilettes sans prendre en compte que ça nuit à leur secret tant qu'on ne le leur a pas fait explicitement remarquer, […]."
                                            },
                                            {
                                                "example_id": "9bfcf427-3354-434b-bf13-e09e34ea020d",
                                                "sense_id": "b8810c64-8af8-38a9-a544-6f269be77ec0",
                                                "text": "J’ai peur qu’il ne replonge, la drogue est si présente dans ce milieu et un drogué restera toujours un drogué..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe0e560-a6ab-349e-b2db-93e36f5dc8a8",
                                        "entry_id": "6335e6bd-cd52-3b0f-afd8-a820093b00be",
                                        "glosses": [
                                            "Personne souffrant d’une dépendance à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3d5ab4-8531-4d8c-b121-1e8e6f6d5702",
                                                "sense_id": "dfe0e560-a6ab-349e-b2db-93e36f5dc8a8",
                                                "text": "C’est un drogué de jeux vidéo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drogué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8a77fe-996e-3420-9f57-3dfa5cb690a2",
                                        "entry_id": "cd98115c-de9b-3837-aeaf-5e6e648a8a96",
                                        "glosses": [
                                            "Participe passé du verbe droguer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f20479e-c1a2-4e4e-964c-cfa2ca12083d",
                                                "sense_id": "1a8a77fe-996e-3420-9f57-3dfa5cb690a2",
                                                "text": "Il a drogué leur boisson."
                                            },
                                            {
                                                "example_id": "e43abc34-b8be-4a79-a5ff-235977d0b298",
                                                "sense_id": "1a8a77fe-996e-3420-9f57-3dfa5cb690a2",
                                                "text": "Elles se sont droguées durant toute leur vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce53b4b0-fb03-4d42-ab91-32a28f6ed5e3",
                        "source_entry_id": "f514ac8f-a1c7-3523-9390-4b0a3b64076c",
                        "source_sense_id": "17beeca1-2e61-33ed-9500-505840c555ce",
                        "source_sense_description": "Verslaafd persoon",
                        "target_lang_word": "accro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0194767b-5a90-3c94-ab0d-fe319e13358f",
                                        "entry_id": "c4ed90a4-42d3-3c37-9f43-3143c8b941b0",
                                        "glosses": [
                                            "Personne dépendante d’une drogue."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ead36e-2cf7-4da5-b11e-ac7951abf801",
                                                "sense_id": "0194767b-5a90-3c94-ab0d-fe319e13358f",
                                                "text": "Les accros à la nicotine ont du mal à croire à l'existence de cette étrange créature : la fumeuse occasionnelle. Si vous appartenez à cette catégorie, vous n'en êtes pourtant guère satisfaite. Sinon, vous ne seriez pas en train de lire ce livre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec57c50-27f6-357a-9390-99f1335b8334",
                                        "entry_id": "c4ed90a4-42d3-3c37-9f43-3143c8b941b0",
                                        "glosses": [
                                            "Personne qui est passionnée par quelqu’un ou par quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c00304-af4b-48ad-8953-6a811029a355",
                                                "sense_id": "3ec57c50-27f6-357a-9390-99f1335b8334",
                                                "text": "Mais malgré mon malaise, je regarderai, complètement accro, comme chaque année."
                                            },
                                            {
                                                "example_id": "596c3798-1a1c-47de-a41e-f30e9234f22d",
                                                "sense_id": "3ec57c50-27f6-357a-9390-99f1335b8334",
                                                "text": "Les accros seront tous devant leur télé le jour de la finale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ecff7e0-ded2-3d08-819f-13daf8e48115",
                                        "entry_id": "5c0d789f-42be-3b77-a4da-b5de2a099954",
                                        "glosses": [
                                            "Se dit d'une personne dépendante à une drogue."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d538df4a-31af-4b37-9aed-776ea50c1da3",
                                                "sense_id": "0ecff7e0-ded2-3d08-819f-13daf8e48115",
                                                "text": "\"Fumer tue\", lit-on sur les paquets de cigarettes. On confirme. […]. Car, si fumer nuit à la santé de votre entourage, vous aussi, vous allez déguster pour peu que vous soyez accro à la nicotine. Au point qu'il va falloir porter un gilet pare-balles si l'on goûte aux volutes d'une \"nuit grave\"."
                                            },
                                            {
                                                "example_id": "770234be-9106-4b8f-b727-942d7fc21003",
                                                "sense_id": "0ecff7e0-ded2-3d08-819f-13daf8e48115",
                                                "text": "Mince à la fin, ce n'est pas parce que ta mère est accro aux médocs et t’oblige à te tenir à carreau et que ton père est une carpette, que tu dois les laisser tomber. '"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f97c1c2-7efd-3db9-b57b-82d5296d1a40",
                                        "entry_id": "5c0d789f-42be-3b77-a4da-b5de2a099954",
                                        "glosses": [
                                            "Qui se rapporte à une personne qui est passionnée par quelqu’un ou par quelque chose."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09f60803-f04b-4775-8bb8-751d45ef2c19",
                                                "sense_id": "7f97c1c2-7efd-3db9-b57b-82d5296d1a40",
                                                "text": "Elizabeth II était visiblement accro à Twin Peaks. C’est ce qu’avait confié le compositeur de la série, Angelo Badalamenti, au New Musical Express."
                                            },
                                            {
                                                "example_id": "66f8b53d-4680-4c08-8c81-9019c86e615c",
                                                "sense_id": "7f97c1c2-7efd-3db9-b57b-82d5296d1a40",
                                                "text": "Je suis devenu dépendant d’une drogue dure. Un junkie, voilà ce que je suis. Accro à ma propre psyché et tributaire de mon moi captif. Passionné, aussi, par la somme de révélations sur le drôle de type que je suis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
