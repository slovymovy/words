                ],
                "senses": [
                    {
                        "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                        "entry_id": "f1a73c51-008f-3b81-a73d-b9627815d32a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2aa6c09-aefe-40bd-9ce5-f5b4e3a3b87c",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Frau Merkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "75f2054b-d38e-42ef-9e30-1fae49392b5d",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Herr Merkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "149a8496-ea05-423a-94a2-1034a4f5595b",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Die Merkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ce37ba46-2977-4971-8d64-2d4d65fcb98a",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Der Merkle trägt nie die Schals, die die Merkle ihm strickt."
                            },
                            {
                                "example_id": "605ddc72-6cd8-49cd-afdc-56fd24d07519",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Merkle kommt, geht der Herr Merkle.“"
                            },
                            {
                                "example_id": "6518f68f-139c-4c8a-b8a4-4f1374a9e240",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Merkle kommt und geht."
                            },
                            {
                                "example_id": "098c7f5e-33df-4b6f-8393-9afb5375620c",
                                "sense_id": "49b87619-d2dc-3f04-8b43-bdc02a13316d",
                                "text": "Merkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
