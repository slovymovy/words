                "senses": [
                    {
                        "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                        "entry_id": "a2b1e583-5b7f-354e-9024-23666a5edba7",
                        "glosses": [
                            "die Sprache des gleichnamigen Volks im östlichen Himalaja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f025fee-7e33-45c5-8328-9c3771d44ee0",
                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                "text": "„Im Lepcha nun ergibt sich eine Verschiebung: der bilabiale Nasal ist hier der am häufigsten bei Ableitungen auftretende Nasal.“"
                            },
                            {
                                "example_id": "4e99f667-d7d2-47c7-94ee-c7c421c443a8",
                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                "text": "„Sikkim ist ein vielsprachiges Land. Im Zentrum ist die Landessprache Lepcha oder Rong.“"
                            },
                            {
                                "example_id": "371e95fa-3858-4d7b-9d52-54232ad573f9",
                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                "text": "„Auch die Arbeit von Yasuda (1976), der die Urheimat der Japaner im Himalaya-Gebiet ansetzte und das Lepcha neben das Japanische stellte, gehört in dieselbe Kategorie sprachgenetischer Versuche.“"
                            },
                            {
                                "example_id": "1883f8c1-4853-4f80-a8df-15d41fdcdfc7",
                                "sense_id": "76a19324-9c55-336a-a178-767ff8b00861",
                                "text": "„Oft mögen es Fremdwörter sein, die für ehrerbietiger gelten, als die einheimischen Ausdrücke, zuweilen sind es wohl auch zierliche Umschreibungen; meist aber ist das für gemein geltende Wort das ursprünglichere. So im Lepcha lōm, Strasse gegenüber ta-mo, a-mik, Auge, gegenüber čan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
