                "senses": [
                    {
                        "sense_id": "e8cc18db-b0d4-368b-95a9-e67edf6af169",
                        "entry_id": "8fa07d7b-90a8-301c-baed-d4c537310158",
                        "glosses": [
                            "Methode, mit der man feststellen kann, inwiefern etwas zutrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4cc871-f057-4b7e-89ef-a3abb4c74f8b",
                                "sense_id": "e8cc18db-b0d4-368b-95a9-e67edf6af169",
                                "text": "„Zur Beurteilung und Prüfung von Schleifscheiben werden an das angewendete Prüfverfahren zahlreiche Anforderungen gestellt.“"
                            },
                            {
                                "example_id": "7343e2d7-6d00-4702-887c-d17135b8b8da",
                                "sense_id": "e8cc18db-b0d4-368b-95a9-e67edf6af169",
                                "text": "„Je nach Verfahren und nationalen Vorschriften werden mit diesen Prüfverfahren manchmal Werkstoffe allein, oft aber auch Werkstoffverbunde in anwendungsgerechtem Einbauzustand beurteilt.“"
                            },
                            {
                                "example_id": "6aa2d0ec-1191-4f0d-a280-60ff18f8c6c9",
                                "sense_id": "e8cc18db-b0d4-368b-95a9-e67edf6af169",
                                "text": "„Das Prüfverfahren kann nur die jeweilige Krankenkasse einleiten, für die das Krankenhaus die Krankenhausbehandlung als Sachleistung erbringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
