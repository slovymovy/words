                    {
                        "translation_id": "3005908d-124b-4988-bc49-23cc003fd62c",
                        "source_entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                        "source_sense_id": "817210d5-0f82-387a-8855-44259aedb691",
                        "source_sense_description": "zeitlich nach dem vorher Gesagten oder Geschehenen",
                        "target_lang_word": "à la suite de quoi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la suite de quoi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df56e050-54d5-342e-9229-21949e3e230d",
                                        "entry_id": "01b65ebb-2606-35ba-881a-610a7b3cbb05",
                                        "glosses": [
                                            "Et venant ensuite, comme conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d22df54-b8fd-4d48-9825-3a5cebc9e211",
                                                "sense_id": "df56e050-54d5-342e-9229-21949e3e230d",
                                                "text": "C’est les Jésuites qui ont fait assassiner Henri IV ; c’est encore eux qui ont fait révoquer l’Édit de Nantes, à la suite de quoi tous les protestants ont été obligés de quitter la France ; […]."
                                            },
                                            {
                                                "example_id": "b4254b8e-545c-4e3e-bb5a-1e718d5b4a68",
                                                "sense_id": "df56e050-54d5-342e-9229-21949e3e230d",
                                                "text": "Or, le bruit se répandit bientôt que le juif avait jeté l’hostie dans une cuve d’eau bouillante, à la suite de quoi l’eau aurait rougi sans s’altérer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7147186c-f32e-4bb4-a3dd-ce2551364113",
                        "source_entry_id": "e827aa3b-093a-321b-955f-851e9fba0744",
                        "source_sense_id": "dab41ffb-7457-3b4c-8f15-62e8a0fec376",
                        "source_sense_description": "räumlich auf etwas auf das man zeigt",
                        "target_lang_word": "là-dessus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "là-dessus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Sur cela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbe0a64-15eb-4eb9-acd4-2d3c00babb7e",
                                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                                "text": "Tu vas me déclouter toutes les planches de ce couvercle qui est là et tu le mettras là-dessus, sur sa caisse."
                                            },
                                            {
                                                "example_id": "bd9b3485-a9b6-4ed2-8aa5-27252b0cbc8c",
                                                "sense_id": "dc8c66ca-e37b-3176-99a0-f9e035b1c03a",
                                                "text": "— Mais le diable a soufflé là-dessus, de son haleine fiévreuse et empestée, et les pires billevesées ont pris leur vol. L'homme a inventé les dieux et il a crée l'amour avec son cortège de sensibleries ridicules ou criminelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Sur ce sujet, sur cette affaire, sur la réalité de telle ou telle chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b64bce-513b-4af9-bb70-b0c7b9feedac",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Pourquoi revenir toujours là-dessus ?"
                                            },
                                            {
                                                "example_id": "82b29f6c-1ad8-4a33-b2d7-10375c738b8d",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Que n’a-t-on pas écrit là-dessus ?"
                                            },
                                            {
                                                "example_id": "66f90f99-4095-412c-889d-afd1e780d316",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Vous pouvez compter là-dessus."
                                            },
                                            {
                                                "example_id": "5d152874-0221-4326-8a1d-3d77ed30ab10",
                                                "sense_id": "a6ea31aa-ff9c-33e5-99b0-5347e6a1739f",
                                                "text": "Nous pouvons travailler là-dessus demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                                        "entry_id": "57a0475f-e240-33a1-b72e-d01e6d17cf42",
                                        "glosses": [
                                            "Aussitôt après cela, après ces mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c208e75d-1baf-4a92-a628-0a97da39a7e8",
                                                "sense_id": "45fe6614-3860-3d4e-a65e-59a55cd8daed",
                                                "text": "On me l’a dit : il faut que je me venge.\nLà-dessus, au fond des forêts,\nLe Loup l’emporte, et puis le mange,\nSans autre forme de procès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
