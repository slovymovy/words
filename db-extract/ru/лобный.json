                                "example_id": "b3d862c5-f65a-43f4-9c1a-af63d739766e",
                                "sense_id": "ea47acaa-10e6-3173-855b-98f1ef90cada",
                                "text": "Лобная, теменная и затылочная кости черепа могут ими сильно истончаться и даже продырявливаться."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6830e3d-ab4d-3ef6-914a-026433607729",
                        "entry_id": "4c55c228-7ea0-328a-9d40-078701145ef1",
                        "glosses": [
                            "свойственный лбу, характерный для него"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3db78646-3218-386e-9184-a0136dc2acae",
                        "entry_id": "4c55c228-7ea0-328a-9d40-078701145ef1",
                        "glosses": [
                            "расположенный на лбу"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79b79fe0-06ca-491d-b5e1-ed1b9c1044bd",
                        "source_entry_id": "4c55c228-7ea0-328a-9d40-078701145ef1",
                        "target_lang_word": "frontal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frontal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cda024b9-5c4c-3f02-baab-b38ba28bf99b",
                                        "entry_id": "d2e74875-db6b-3639-bd56-ff8982179ea2",
                                        "glosses": [
                                            "Qui a rapport ou qui appartient au front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da8bb6a-afd3-4099-9160-922e7a09fb3e",
                                                "sense_id": "cda024b9-5c4c-3f02-baab-b38ba28bf99b",
                                                "text": "Les muscles frontaux. — Os frontal. — Sinus frontaux."
                                            },
                                            {
                                                "example_id": "b3e27764-9d23-498e-804a-da4b1853b001",
                                                "sense_id": "cda024b9-5c4c-3f02-baab-b38ba28bf99b",
                                                "text": "Ils se séparèrent devant la porte de l’établissement en échangeant du feu pour une dernière cigarette. Comme ils tenaient encore leur chapeau à la main, leurs fronts congestionnés se touchèrent et le colonel recula subitement comme s’il eût craint de révéler, par ce contact, le secret qu’abritait son os frontal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "545ee9aa-5b51-3dd1-b640-e76a1bf28ece",
                                        "entry_id": "d2e74875-db6b-3639-bd56-ff8982179ea2",
                                        "glosses": [
                                            "Qui est situé sur le front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2ff52e-d24f-4fa9-b1a1-e0e7c1937a2e",
                                                "sense_id": "545ee9aa-5b51-3dd1-b640-e76a1bf28ece",
                                                "text": "À la bride et au mors arabe on ajoute, aux grandes occasions, une large bande frontale ornée de franges et un gros gland pendant au cou du cheval."
                                            },
                                            {
                                                "example_id": "e7bdb726-94e6-4f83-a594-5378bac71e1b",
                                                "sense_id": "545ee9aa-5b51-3dd1-b640-e76a1bf28ece",
                                                "text": "La Vierge aux paupières endolories écartait la main gauche en un geste rapace, tandis que l’autre main se crispait, avec des doigts surprotecteurs, sur un enfant agenouillé (à la forte calvitie frontale) qui priait, béni à distance par un autre chérubin, lequel s’appuyait à un androgyne au regard louche et à la bouche pincée, tendant, sans aucun souci des convenances, un index indécent en direction de son vis-à-vis."
                                            },
                                            {
                                                "example_id": "0f45e816-bce5-4bb9-b910-cf97df33fa70",
                                                "sense_id": "545ee9aa-5b51-3dd1-b640-e76a1bf28ece",
                                                "text": "On sortit de l’abri à la lampe frontale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "579ee8a7-663b-341a-a883-86a6a75f813b",
                                        "entry_id": "d2e74875-db6b-3639-bd56-ff8982179ea2",
                                        "glosses": [
                                            "Qui est situé de front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43e6a5c-5f12-4f12-85da-dfa21b61c6b3",
                                                "sense_id": "579ee8a7-663b-341a-a883-86a6a75f813b",
                                                "text": "Tous ces dépôts constituent une véritable moraine frontale vers laquelle se dirigent les stries NE.-SW. visibles sur les bancs de poudingue affleurant à quelque distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bdb2e3-e1b6-3e5f-8263-9f002be3f3db",
                                        "entry_id": "d2e74875-db6b-3639-bd56-ff8982179ea2",
                                        "glosses": [
                                            "Qui attaque frontalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d5eed2-0cc2-4a7e-8b27-5c584e6f7496",
                                                "sense_id": "c1bdb2e3-e1b6-3e5f-8263-9f002be3f3db",
                                                "text": "J’ai beaucoup lu sur Péguy, ce fils de rempailleuse de chaises devenu Normalien, dreyfusard acharné, socialiste de sang et de flammes, polémiste frontal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frontal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18e42bba-41d1-361d-a1ea-055cf975c581",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Synonyme de os frontal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656bdd67-2d04-4f6f-8051-28ce811497a6",
                                                "sense_id": "18e42bba-41d1-361d-a1ea-055cf975c581",
                                                "text": "La première de ces remarques concerne la solidarité des quinze muscles du visage qui sont synergiquement contractés et dont les plus importants sont : le frontal, l’orbiculaire des paupières, le transverse du nez, l’élévateur de l’aile du nez et de la lèvre supérieure, le petit zygomatique, le grand zygomatique et le rieur ; tous plus ou moins congénères, en sorte que la contraction des uns facilite celle des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4625ead-ee21-368e-87f8-3e6f7cf94b8c",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Surface visible, face au client, utilisée sur un rayonnage pour la présentation d’un produit. Le terme féminin frontale est admis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb8cd194-f8d2-32d6-b234-4c49638369ef",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Pièce d’armure qui recouvre le front d’un cheval caparaçonné."
                                        ],
                                        "tags": [
                                            "Armurerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6396ac3-f3db-45a9-bc7a-acb1b9714e18",
                                                "sense_id": "bb8cd194-f8d2-32d6-b234-4c49638369ef",
                                                "text": "Des chevaux blancs étaient là, une centaine peut-être, et qui mangeaient de l’orge sur une planche au niveau de leur bouche. Ils avaient tous la crinière peinte en bleu, les sabots dans des mitaines de sparterie, et les poils d’entre les oreilles bouffant sur le frontal, comme une perruque."
                                            },
                                            {
                                                "example_id": "ce0a43f9-493d-4c4c-9821-db5c7dea6c33",
                                                "sense_id": "bb8cd194-f8d2-32d6-b234-4c49638369ef",
                                                "text": "Son harnachement lui sied à merveille : la haute selle arabe est couverte d’une housse de drap vert brodée de soie assortie; la sangle, le poitrail, le frontal sont de la même couleur et agrémentés de fils de métal; la boucle du poitrail et les larges étriers sont dorés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2719c7-4ab6-39e3-a743-e87f9fb2d060",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Sorte de coussin en paille tressée, en tissu ou en peau, qui se met sous le joug des bovins."
                                        ],
                                        "tags": [
                                            "Centre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b083da02-525d-45fc-9355-b267a1000b03",
                                                "sense_id": "dd2719c7-4ab6-39e3-a743-e87f9fb2d060",
                                                "text": "Voyez comme nos paysans entendent bien l’art sans le savoir ! Quel peintre, quel sculpteur eût imaginé cette coiffure d’un style si large et si simple ! Ce frontal de paille tressée, qui ressemble à un diadème, et cet entrecroisement ingénieux des courroies qui embrassent les cornes et le joug ! vraiment ceci doit être de tradition antique, et jamais le bœuf Apis n’a été plus majestueusement couronné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aad8d5b-fd79-36a9-96c2-c863a5bad411",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Pièce d'armure qui recouvre le front et descend sur le nez dans les casques de la Grèce antique."
                                        ],
                                        "tags": [
                                            "Armurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8135e67d-b6bb-385e-bbde-d9e604b101b7",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Ancien instrument de torture qui consiste en un système de cordes qui serre le front du supplicié."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2be3512-b36f-3abb-a2d7-2b8d8a9e471a",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Cataplasme que l'on pose sur le front."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6181b97d-0cb7-3678-b184-eaa0cc22d7e9",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Outils dont les facteurs de clavecins se servent pour faire les ornements appelés trèfles, sur la partie antérieure des touches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79d1e222-3e03-3286-83c3-6a5e4cc06e21",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Martinet dont les cames travaillent dans le sens du soulèvement face au marteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f582e93-ab59-438b-b66f-ee74c84ca60a",
                                                "sense_id": "79d1e222-3e03-3286-83c3-6a5e4cc06e21",
                                                "text": "Le frontal est aussi appelé marteau à l'anglaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04ba625-11db-3515-98ac-ca3ec4d54068",
                                        "entry_id": "1fba7cdd-08a5-3f99-80f7-f24664051f16",
                                        "glosses": [
                                            "Serveur frontal : machine qui reçoit les connexions des utilisateurs."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca69a088-a00a-498a-8259-416dd2886f83",
                                                "sense_id": "d04ba625-11db-3515-98ac-ca3ec4d54068",
                                                "text": "Un frontal reçoit des requêtes depuis les clients POP3, IMAP4 et HTTP et grâce à Active Directory, il redirige les demandes vers un serveur Exchange principal qui stocke les boîtes aux lettres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
