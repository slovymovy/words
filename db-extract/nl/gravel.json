                                "sense_id": "db9e0419-f3af-3686-907a-1005c53d6eb1",
                                "text": "Hij speelt eigenlijk altijd het liefst op gravel."
                            }
                        ]
                    },
                    {
                        "sense_id": "11f17845-c5a2-3526-b598-7c5e3afc63e9",
