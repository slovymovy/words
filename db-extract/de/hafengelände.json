                        "examples": [
                            {
                                "example_id": "08a5dde6-3f24-4534-82bd-7dd1fea64ff5",
                                "sense_id": "1bbedb2e-06dc-3085-8e98-e979fd3b5d79",
                                "text": "„Die Innenstadt wird im Süden vom Hafengelände und im Norden von einer Verkehrsstraße begrenzt.“"
                            },
                            {
                                "example_id": "e9026d3b-dfb8-4484-93d6-67e20f7bfc19",
                                "sense_id": "1bbedb2e-06dc-3085-8e98-e979fd3b5d79",
                                "text": "„Ohne Pferde und Wagen, nur mit Koffern und Taschen in den Händen, wurden die Götzlacker von den Soldaten über das Hafengelände getrieben .“"
                            }
                        ],
