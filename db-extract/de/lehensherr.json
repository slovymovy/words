                        "glosses": [
                            "Seigneur féodal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524c9148-c22e-4001-a9e2-b3c1d7c0b983",
                                "sense_id": "a68fbda2-6404-3862-bf0a-6e07596d6a2b",
                                "text": "Je nach Stellung des Ritters innerhalb seines Standes musste er (...) die eigenen Abgaben an seinen Lehensherrn entrichten sowie den sogenannten Zehnt von seinen Untergebenen einfordern.",
                                "translation": "En fonction de sa position au sein de sa classe, le chevalier devait (...) payer ses impôts auprès de son seigneur féodal et demander la dîme auprès de ses sujets."
                            }
                        ]
                    }
