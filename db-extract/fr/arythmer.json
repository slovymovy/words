                        "sense_id": "9dadf66c-4b24-338b-aed0-95a1c3b60993",
                        "entry_id": "fe20ffb8-e4c0-342a-b39c-5e7187af1870",
                        "glosses": [
                            "Rendre arythmique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc90909b-1aec-4b1f-bb69-5a1f4417f343",
                                "sense_id": "9dadf66c-4b24-338b-aed0-95a1c3b60993",
                                "text": "Mais Yacine donne à son souffle, à sa foulée la longueur juste La rythmant l’arythmant comme le tétramètre, qu’informent les tam-tams de vie Buvant l’oxygène vert, comme une boisson tonique Quand c’est déjà la cloche de l’angoisse, la clameur de l’espoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "90182767-cb2e-35d4-9be4-e683980f6f17",
                        "entry_id": "fe20ffb8-e4c0-342a-b39c-5e7187af1870",
                        "glosses": [
                            "Devenir arythmique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0502e2c0-4c8f-406f-b5eb-6076df9ffd30",
                                "sense_id": "90182767-cb2e-35d4-9be4-e683980f6f17",
                                "text": "Son pouls s’arythmait, elle perdait l’appétit."
                            }
                        ]
                    }
