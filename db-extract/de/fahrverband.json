                "senses": [
                    {
                        "sense_id": "aedb3a46-163d-3044-88fb-1c0363af59c8",
                        "entry_id": "f454e4b8-7846-3c8e-b0e7-d3065e9f3e38",
                        "glosses": [
                            "Verein, in dem sich Anhänger und Aktive der Sportart Fahren sammeln"
                        ],
                        "tags": [
                            "Reitsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2a6603f6-3835-46ac-beb6-d67c165789fb",
                                "sense_id": "aedb3a46-163d-3044-88fb-1c0363af59c8",
                                "text": "„Ein blassblauer Stempel verrät mir, dass er vom Oberbayerischen Reit- und Fahrverband kommt. Mit etwas zittrigen Fingern reiße ich den Umschlag auf und hole ein ordentlich zusammengefaltetes Blatt Papier heraus.“"
                            },
                            {
                                "example_id": "8823fd86-18dd-44ae-8d34-ff2128c971e7",
                                "sense_id": "aedb3a46-163d-3044-88fb-1c0363af59c8",
                                "text": "„Bei der Ausweisung des Reitpfads arbeitet die Hessische Forstverwaltung eng mit dem Hessischen Reit- und Fahrverband zusammen.“"
                            },
                            {
                                "example_id": "e93710d6-28b2-4fb1-a26d-fb473c73c95b",
                                "sense_id": "aedb3a46-163d-3044-88fb-1c0363af59c8",
                                "text": "„Die zu ehrenden Einzelreiter oder Vereine werden aufgrund bestimmter Kriterien vom Hessischen Reit- und Fahrverband empfohlen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
