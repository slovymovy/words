                "translations": [
                    {
                        "translation_id": "ece76471-458f-4d7b-acb3-b8d6e69baf62",
                        "source_entry_id": "05606180-fd85-34e7-b72a-1f06875ee7f9",
                        "source_sense_id": "15a62bce-6dee-3ba0-af9a-454daf4849ac",
                        "target_lang_word": "автоматический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "автоматический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4b955cbe-845b-3a12-8b54-5859ce4c9cb4",
                                        "entry_id": "e409e577-8ada-3f26-b527-2c42daf6a33f",
                                        "glosses": [
                                            "связанный с автоматикой, основанный на её применении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4971866e-0749-4d48-8242-df7f3cba8d4c",
                                                "sense_id": "4b955cbe-845b-3a12-8b54-5859ce4c9cb4",
                                                "text": "Сейчас внешний мир это — закапанный стеарином фонарь, стенные дощечки, выкрашенные под дуб, ручка автоматического тормоза у двери и перед самыми глазами, в стенке ножом выковыренная, надпись: «Маруся. Моя Любовь. Май 11 год»."
                                            },
                                            {
                                                "example_id": "2fe7533a-eac8-40ce-abb3-7f34daa35b42",
                                                "sense_id": "4b955cbe-845b-3a12-8b54-5859ce4c9cb4",
                                                "text": "На покрытие исчисленных по смете расходов обращаются все ожидаемые в предстоящем сметном году неокладные поступления и сборы, как то: проценты с поселковых капиталов, плата за лечение, доходы с поселковых имуществ, сооружений и предприятий, сбор с промысловых свидетельств, лошадей, автоматических экипажей и т. п."
                                            },
                                            {
                                                "example_id": "43462bec-16e4-4b47-b40f-13d05f117f63",
                                                "sense_id": "4b955cbe-845b-3a12-8b54-5859ce4c9cb4",
                                                "text": "Автоматическое вибропрессование песчаных форм под высоким давлением."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b6edaa-d54d-3697-bccc-21120e8f7ca9",
                                        "entry_id": "e409e577-8ada-3f26-b527-2c42daf6a33f",
                                        "glosses": [
                                            "перен. непроизвольный, машинальный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56a18cb0-e043-4186-b191-3c931371198c",
                                                "sense_id": "60b6edaa-d54d-3697-bccc-21120e8f7ca9",
                                                "text": "На самом деле, вышеуказанные автоматические движения глаз вполне допустимы, ибо, например, при опытах со сосредоточиванием на определённом действии, связанном с известным интересом, как доказано у нас опытами, могло быть констатировано автоматическое смещение пальца руки в приборе Sommer’a в сторону представляемого движения, хотя для самого лица это смещение остаётся незамеченным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43c69b9-9084-3b17-89b5-6aef10df1c4a",
                                        "entry_id": "e409e577-8ada-3f26-b527-2c42daf6a33f",
                                        "glosses": [
                                            "имеющий механизм, после выстрела производящий перезаряжение и повторный выстрел, что позволяет вести непрерывный огонь"
                                        ],
                                        "tags": [
                                            "об оружии"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43cc407f-d8f1-43e4-a319-7527facb7362",
                                                "sense_id": "b43c69b9-9084-3b17-89b5-6aef10df1c4a",
                                                "text": "автоматическая пушка"
                                            },
                                            {
                                                "example_id": "b4a69dc9-94eb-47d2-9d83-159f3167d744",
                                                "sense_id": "b43c69b9-9084-3b17-89b5-6aef10df1c4a",
                                                "text": "автоматический пистолет"
                                            }
                                        ]
                                    }
                                ]
                            }
