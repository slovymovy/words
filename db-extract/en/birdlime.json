                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa75f5a6-6956-4daf-a961-97561643e8e1",
                        "source_entry_id": "95a971fa-11a8-34f5-9586-d4889aeaad69",
                        "source_sense_id": "4ab49aff-cd4b-34ac-90f3-7cd91997da7c",
                        "source_sense_description": "add birdlime",
                        "target_lang_word": "engluer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engluer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a84de148-43f0-306c-bf0e-e4ddd192b3ee",
                                        "entry_id": "cd521f48-df3d-3f25-a061-d79a4db4fc92",
                                        "glosses": [
                                            "Enduire de glu ou de toute matière gluante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d2877e-3332-4ea7-b3a7-8e4597d7f8a3",
                                                "sense_id": "a84de148-43f0-306c-bf0e-e4ddd192b3ee",
                                                "text": "Engluer de petites branches pour prendre des oiseaux. Le pétrole déversé par la marée noire englue la plage."
                                            },
                                            {
                                                "example_id": "08df3c8b-9658-40b0-be58-17138b40ff5d",
                                                "sense_id": "a84de148-43f0-306c-bf0e-e4ddd192b3ee",
                                                "text": "Sur l’un de ses flancs, le domaine d’Osman Bay était bordé par la Chirine Daria, petite rivière encaissée entre des berges d’argile boueuse, et si lente que l’on distinguait à peine le mouvement de l’eau à travers les molécules de terre rougeâtre qui l’engluaient et les crottes de moutons qu’elle charriait par centaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beddbaf3-14ed-3fc6-b743-c1ff6a1f36d3",
                                        "entry_id": "cd521f48-df3d-3f25-a061-d79a4db4fc92",
                                        "glosses": [
                                            "Prendre à la glu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559bde70-7921-4b28-a98e-a0d5fa8740ab",
                                                "sense_id": "beddbaf3-14ed-3fc6-b743-c1ff6a1f36d3",
                                                "text": "Bien qu'il s'attaque de préférence à d'assez grosses bestioles, le crapaud ne dédaigne pas, à l'occasion, de mobiliser sa langue pour engluer quelques pucerons."
                                            },
                                            {
                                                "example_id": "4f4bff17-ac6f-4074-8e1c-e57cf9fbf7e7",
                                                "sense_id": "beddbaf3-14ed-3fc6-b743-c1ff6a1f36d3",
                                                "text": "En Lorraine, ils engluent les petits oiseaux chanteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf0b687-d3b5-3cae-a3db-250b6058ec59",
                                        "entry_id": "cd521f48-df3d-3f25-a061-d79a4db4fc92",
                                        "glosses": [
                                            "Prendre dans un piège duquel la victime ne peut échapper."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18df6fab-b95b-4dc5-9336-7e5b7ee0f8b0",
                                                "sense_id": "baf0b687-d3b5-3cae-a3db-250b6058ec59",
                                                "text": "Puis il se peut que tu parviennes avant le mariage à engluer Barutel dans tes spéculations..."
                                            },
                                            {
                                                "example_id": "0e966070-6f89-4190-a8c3-b9379f0719ac",
                                                "sense_id": "baf0b687-d3b5-3cae-a3db-250b6058ec59",
                                                "text": "[…], d'aussi loin que le me rappelle j’ai été englué des pieds jusqu'à la tête, agoni de reproches ou de compliments qui ne me concernaient pas le moins du monde, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "310264a2-5ab6-3c71-8b7c-527cf6f581a7",
                                        "entry_id": "cd521f48-df3d-3f25-a061-d79a4db4fc92",
                                        "glosses": [
                                            "S’enferrer, s’empêtrer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffeb2233-517f-4634-a4a3-a3a76c87d8ad",
                                                "sense_id": "310264a2-5ab6-3c71-8b7c-527cf6f581a7",
                                                "text": "De l'argent, de quoi effacer jusqu'au souvenir de cette mistoufle tenace dans laquelle ils s'étaient d'heure en heure englués."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
