                    "frequency": "Middle",
                    "semantic_group_id": "relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village est situé au fond d'une <w>cuvette</w> abritée des vents violents."
                        },
                        {
                            "text": "L'air froid s'accumule souvent dans la <w>cuvette</w> pendant les nuits d'hiver."
