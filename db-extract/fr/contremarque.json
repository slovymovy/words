                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0d8cc8-5e42-472e-a338-939e7815e9bc",
                                "sense_id": "5bc7cdef-b3d2-3217-b60d-6bae6206611d",
                                "text": "Mettre une contremarque à un ballot. - Faire une contremarque à de la vaisselle d’argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e1513bc-f69f-3cac-b4d7-ca5d5437a737",
