                            {
                                "example_id": "6121da75-74e3-49d8-912d-e0939564dc67",
                                "sense_id": "3c5e97f8-23ca-3dee-8cc5-c2ccf19ac2f7",
                                "text": "Het moet dan ook mogelijk zijn in een genetische gemanipuleerde ui het gen voor LFS uit te schakelen, zonder afbreuk te doen aan de specifieke uiengeur en -smaak."
                            },
                            {
                                "example_id": "2f712ef7-8a93-4e7c-9b26-ea336f211233",
                                "sense_id": "3c5e97f8-23ca-3dee-8cc5-c2ccf19ac2f7",
                                "text": "Eigenlijk is er gewoon nog zo goed als niets op te eten buiten, hoe een grazig gevoel je ook al ontwikkelt. Tot je ineens een onmiskenbare uiengeur ruikt."
                            },
                            {
                                "example_id": "b7960ddc-890c-4e3e-ba1e-c92b17c611f7",
                                "sense_id": "3c5e97f8-23ca-3dee-8cc5-c2ccf19ac2f7",
                                "text": "De opstijgende uiengeur stuurt de enige twee wortelvliegen die nog overwogen een aanslag te beramen absoluut naar huis."
                            }
                        ]
                    }
