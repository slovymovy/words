                                                "sense_id": "88ac02e2-d73c-3265-8d8f-180e8cda12a1",
                                                "text": "По жёлтому лицу её пробежала надменная презрительная улыбка."
                                            },
                                            {
                                                "example_id": "9a2a24c2-5007-421e-9223-5aa0679c4a14",
                                                "sense_id": "88ac02e2-d73c-3265-8d8f-180e8cda12a1",
                                                "text": "Состроил презрительную гримасу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f83d9ad-2369-3458-900d-823525eef300",
                                        "entry_id": "e2750bd2-cb8d-324c-9d4b-61cbee475723",
                                        "glosses": [
                                            "устар. то же, что презренный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4d9d25c-dd0e-45ea-8071-ed7eb9a80bc5",
                                                "sense_id": "1f83d9ad-2369-3458-900d-823525eef300",
