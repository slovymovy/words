                        "examples": [
                            {
                                "example_id": "5ca6bbce-2419-4c86-ae53-6d298f528711",
                                "sense_id": "e595a570-d7dd-3922-ab95-025b8458e684",
                                "text": "Volgens de onderzoekers zorgt dopinggebruik ervoor dat het aantal celkernen in het spierweefsel toeneemt. Deze celkernen zorgen ervoor dat de spiermassa toeneemt tijdens het trainen. Het muizenonderzoek lijkt aan te tonen dat die celkernen na het dopinggebruik nog heel lang actief blijven."
                            },
                            {
                                "example_id": "dd5fa0f9-dcbf-4d35-9938-c2536b517aa3",
                                "sense_id": "e595a570-d7dd-3922-ab95-025b8458e684",
                                "text": "Mitochondriale ziekte kan leiden tot spierdystrofie, waarbij het spierweefsel geleidelijk wordt afgebroken. Gevolg daarvan is toenemende zwakheid van de spieren en invaliditeit. De ziekte kan ook invloed hebben op het hart en de lever. \"Het kan een vreselijke impact hebben op de mensen die het erven\", zegt Davies."
                            }
                        ]
