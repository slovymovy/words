                                "sense_id": "b3d4fc61-7212-325c-b53e-6df4776fa038",
                                "text": "Meine Unlust gegenüber dieser Partei steigt zurzeit jeden Tag an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
