                        "entry_id": "429a2ec1-e9a0-367a-a0f2-26cbd6ac0ae0",
                        "glosses": [
                            "A person who rallies support for any cause."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "eea803f2-f141-4736-a727-449982f7f9d9",
                                "sense_id": "08e4148f-9814-3c00-a558-89ec32012127",
                                "text": "Given these sentiments, it is unsurprising that ultranationalists have been the main cheerleaders of closer Russia-North Korea relations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef6273aa-cdda-472f-8c45-9196ab5647ab",
