    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                "word": "punchy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "698cd3b2-1d91-41b8-b067-e5d2d9d4e221",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "tags": [
                            "comparative"
                        ],
                        "form": "punchier"
                    },
                    {
                        "form_id": "defd5e43-e9e6-4ce8-80a9-38356f284303",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "tags": [
                            "superlative"
                        ],
                        "form": "punchiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "glosses": [
                            "Having a punch; effective; forceful; spirited; vigorous."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "0f651581-e3d1-4aa5-a191-5eef32a05e51",
                                "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                                "text": "Best cuts: \"The Evil Dude,\" \"Kung Fu, Too!\" \"Mama Love,\" \"New Orleans\" (with a punchy vocal by Teresa Brewer)."
                            },
                            {
                                "example_id": "67a3ee67-344d-454f-a71d-256d3eb0e30f",
                                "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                                "text": "Some of the punchiest passages in \"The Lady and the Panda\" are quotations from Harkness's own writing."
                            },
                            {
                                "example_id": "a82da60d-b1c5-4938-aad9-3e37e65f8c4f",
                                "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                                "text": "Malcolm’s tighter, punchier rhythm tone is consistent with the use of any of these big 100-watters (a Marshall Super Bass would be particularly bold in this department), and this was clearly another key ingredient—partnered with his Filter’Tron-loaded Gretsch—in the unparalleled chunk of the AC/DC rhythm assault."
                            },
                            {
                                "example_id": "7c59373e-390b-44ca-9b2a-3b5deca3e896",
                                "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                                "text": "It’s a really great experience: Keys feel punchy with a not too loud clicking and clacking, along with a nice feel when actually pushing the key."
                            },
                            {
                                "example_id": "42647559-4f82-4380-a8eb-bb27c4c5ef28",
                                "sense_id": "a159ba8f-da69-3762-9a8f-95c91d83b54e",
                                "text": "The show had a considerable footprint on YouTube, but Piker helped it adapt to punchier formats that were better suited to Facebook and Instagram."
                            }
                        ]
                    },
                    {
                        "sense_id": "54db7c70-c5f4-38cc-ae80-0fa24cdfd289",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "glosses": [
                            "Involving or resembling a punch with the fist."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a830cbd2-d5aa-40f8-a8fc-6defa7153d09",
                                "sense_id": "54db7c70-c5f4-38cc-ae80-0fa24cdfd289",
                                "text": "Apart from the problemette with the punchy bits, I've got only one reservation with the game and that's that the tie-in element is a bit shaky to say the least."
                            },
                            {
                                "example_id": "6cc7a77d-7e95-4325-a4a1-b3d5681ca83a",
                                "sense_id": "54db7c70-c5f4-38cc-ae80-0fa24cdfd289",
                                "text": "Francine leans down and her body tenses, shoulders reddening as she makes a sharp, punchy gesture. It doesn't look like a couple in love."
                            }
                        ]
                    },
                    {
                        "sense_id": "066379b9-ef39-330a-8eec-8f3bba1dcc85",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "glosses": [
                            "Punchable; punchworthy."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f3d855c4-94cf-4c1c-a019-5dc0276dc33d",
                                "sense_id": "066379b9-ef39-330a-8eec-8f3bba1dcc85",
                                "text": "Even with his punchy face, Roman nose and big ears, Jack Drawbaugh will command most of the attention for the 1-14-mile marathon route tomorrow at Sunland Park."
                            },
                            {
                                "example_id": "c37d8857-634f-453a-a285-68f4ebd607ff",
                                "sense_id": "066379b9-ef39-330a-8eec-8f3bba1dcc85",
                                "text": "I've always hated Robbie Williams downright stupid face, Hopefully the Gallaghers will break his legs aswell."
                            },
                            {
                                "example_id": "5aeaf1d0-39e1-4914-9311-1d674eb9a524",
                                "sense_id": "066379b9-ef39-330a-8eec-8f3bba1dcc85",
                                "text": "Punchy face Marty and dickless Rathbun are toast in all areas but a few freezone type dim wits who think Elrongs^([sic]) story about his almost gettinr^([sic]) run over by a train on Venus was really hot, The cult is over, but its criminal empire will go on for a while yet.."
                            }
                        ]
                    },
                    {
                        "sense_id": "141b20fa-916e-3445-a1e4-8947659cdd7b",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "glosses": [
                            "Behaving or appearing punch-drunk, reacting poorly."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3e546734-6970-42a4-aad3-10a26175f74d",
                                "sense_id": "141b20fa-916e-3445-a1e4-8947659cdd7b",
                                "text": "I was so sleep-deprived I was starting to get punchy."
                            },
                            {
                                "example_id": "61541dfc-60a9-42c9-a598-06d5f45db7a1",
                                "sense_id": "141b20fa-916e-3445-a1e4-8947659cdd7b",
                                "text": "“It has been weeks since any of us have had even a moment of slumber.” “It's actually been only, like, 14 hours, but they get a little punchy when they don't get their sleep.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "b12adc0b-1116-30cc-bccb-a2e9c56753f9",
                        "entry_id": "0eece734-e43e-3a79-8453-3f4d55d16670",
                        "glosses": [
                            "Of groomed snow: unable to support the weight of a skier, especially when the skier’s weight is all on one ski, resulting in a ski punching through the surface of the snow."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
