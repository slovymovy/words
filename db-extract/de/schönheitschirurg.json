                "senses": [
                    {
                        "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                        "entry_id": "4b3655d1-ac0b-39d6-81c3-620e24cc4473",
                        "glosses": [
                            "Chirurg, der sich auf kosmetische Operationen spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24ece05-c8db-4aeb-bc45-88580dd756ba",
                                "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                                "text": "Die Schönheitschirurgen verwahren sich entschieden gegen den Vorwurf der Geschäftemacherei."
                            },
                            {
                                "example_id": "cd27ee1e-42cf-4e47-a145-42c4b7f99824",
                                "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                                "text": "„Je näher man ihm kam, desto pergamentener wurde seine Haut, mit jener Art von Straffheit, die nur das Werk eines Schönheitschirurgen sein konnte.“"
                            },
                            {
                                "example_id": "3fb3737c-b9d6-4aaf-99e1-9aed9b289b90",
                                "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                                "text": "„Ich selber bin viel zu feige, um zum Schönheitschirurgen zu gehen: Ich hätte Angst vor der Narkose.“"
                            },
                            {
                                "example_id": "d9a93205-9389-408b-8f18-5217a7d6a636",
                                "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                                "text": "„Im Iran habe ich ihn offenbar vor lauter Gerede über Immobilienpreise und Schönheitschirurgen immer überhört.“"
                            },
                            {
                                "example_id": "2ad70d62-623d-4ceb-aeec-2be75f0cfc4f",
                                "sense_id": "77ae4d3c-4ddc-30d6-a2da-2b3995d2f334",
                                "text": "„Dr. Gerhard Sattler ist einer der bekanntesten Schönheitschirurgen der Republik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
