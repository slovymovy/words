                ],
                "senses": [
                    {
                        "sense_id": "0dfdcf17-4fd4-39b8-b32f-2c66b5d49192",
                        "entry_id": "01b393d1-69f6-3cdd-981e-318775652c8f",
                        "glosses": [
                            "Geschoss, das aus einer Schusswaffe ab 30 cm Gesamtlänge abgefeuert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd27322-8a2f-4d83-9338-e33cb1e56184",
                                "sense_id": "0dfdcf17-4fd4-39b8-b32f-2c66b5d49192",
                                "text": "„Eine Gewehrkugel aus der Nachbarwohnung hat am Sonntag in Floridsdorf nur knapp eine Frau verfehlt.“"
                            },
                            {
                                "example_id": "ded7a7d1-4136-4175-bbaf-e97452a73936",
                                "sense_id": "0dfdcf17-4fd4-39b8-b32f-2c66b5d49192",
                                "text": "„Wir stehen hinter der Grabenwand und lauern, Gewehrkugeln spritzen lichtzuckend in die Erde, Querschläger surren, Leuchtkugeln entfalten sich, schweben mit weißfahlem Schein über den Drahtverhauen, alle Geräusche vermischen sich mit den Stimmen der Nacht.“"
                            },
                            {
                                "example_id": "def48634-74e3-4504-b5dd-eb75ac227548",
                                "sense_id": "0dfdcf17-4fd4-39b8-b32f-2c66b5d49192",
                                "text": "„Manfred hatte von seinem Vater eine Sammlung von Gewehrkugeln geerbt: belgische, französische, polnische; aus Kupfer und aus Messing.“"
                            },
                            {
                                "example_id": "21dbcb04-303c-46c5-b7d3-fdee36f638a8",
                                "sense_id": "0dfdcf17-4fd4-39b8-b32f-2c66b5d49192",
                                "text": "„Ein paar Gewehrkugeln kamen von drüben gezirpt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
