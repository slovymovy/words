                    {
                        "sense_id": "7f133710-50c4-3970-b459-178496f4003e",
                        "entry_id": "2715f922-0ef7-3401-b916-5d84088da65d",
                        "glosses": [
                            "Personne ayant des origines raciales diverses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67143097-0a76-418e-8b8e-602af5eaef0e",
                                "sense_id": "7f133710-50c4-3970-b459-178496f4003e",
                                "text": "Oui, les cheveux et les yeux sont bien d’un sang-mêlé, si les ongles aussi ressemblent aux miens, mon espoir augmentera encore."
                            },
                            {
                                "example_id": "3b5267ea-f37b-466b-b87b-261fa5652b99",
                                "sense_id": "7f133710-50c4-3970-b459-178496f4003e",
                                "text": "L’homme était un vieux sang-mêlé, blanc et indien, il s’appelait Nuage Rouge, un nom emprunté à de glorieux ancêtres."
                            },
                            {
                                "example_id": "51dfc278-e252-4b4b-9407-b083b639bb16",
                                "sense_id": "7f133710-50c4-3970-b459-178496f4003e",
                                "text": "Quelques années auparavant, des sang-mêlé nés dans la réserve étaient morts sans que l'on connaisse le mal qui les avait frappés."
                            }
                        ]
                    },
