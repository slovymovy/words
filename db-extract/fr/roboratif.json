                                    {
                                        "sense_id": "3d5308cc-57ab-3d06-b328-bd3a62f69fc0",
                                        "entry_id": "6bc48bfd-5bb1-3fc2-89ee-805180c9692c",
                                        "glosses": [
                                            "krachtiger makend; steviger makend; groter makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d5c04c-1008-434a-8de4-47a4c46cdf7c",
                                                "sense_id": "3d5308cc-57ab-3d06-b328-bd3a62f69fc0",
                                                "text": "Dat veroorzaakt een zichzelf versterkende vicieuze cirkel van voordelen die van generatie op generatie worden doorgegeven."
                                            },
                                            {
                                                "example_id": "59582e9c-3fb7-403c-a244-a07a9624275d",
                                                "sense_id": "3d5308cc-57ab-3d06-b328-bd3a62f69fc0",
                                                "text": "Dat heeft een versterkende werking, want je bereikt er iedereen mee. Veel mensen staan daar heus bij stil. Maar als er jonge meisjes worden vermist of vermoord, is Facebook op de eerste plaats een kanaal om emoties te uiten.\""
                                            },
                                            {
                                                "example_id": "1a06e5f5-1182-4800-bc8a-f17497ad8b79",
                                                "sense_id": "3d5308cc-57ab-3d06-b328-bd3a62f69fc0",
                                                "text": "Woensdagavond is in de grote As Soennah Moskee in Den Haag een belangrijke bijeenkomst, met ook joodse vertegenwoordigers. ‘Beide zijn wij geloofsgemeenschappen die in ons land te maken hebben met bedreigingen en aanslagen. Op deze avond willen wij de samenleving onze inspanning tonen om angst en onzekerheid om te zetten in een versterkende kracht.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
