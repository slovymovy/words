                "translations": [
                    {
                        "translation_id": "b530662f-cc15-428f-8191-09f15f8d8665",
                        "source_entry_id": "b7279062-57d5-3b34-90fc-432a9b52e4e8",
                        "target_lang_word": "mousseux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousseux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                                        "entry_id": "694de960-9cbf-39db-a7f1-a20a3e7dc400",
                                        "glosses": [
                                            "Qui ressemble à de la mousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c55b17-b5bf-4ceb-87f9-197044c2d637",
                                                "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                                                "text": "Un tapis mousseux."
                                            },
                                            {
                                                "example_id": "dfaa4253-c4fd-44c6-bec5-d45d9496b080",
                                                "sense_id": "11f0da11-f3f8-3fb9-9985-1bab24d79508",
                                                "text": "Schwann, quand je le connus, devait être âgé de soixante ans ; il était petit, mince, fluet, léger comme une danseuse ; ses cheveux mousseux, crépelés, complètement blancs, d'un blanc de lune et de lait, s'envolaient autour de son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                        "entry_id": "694de960-9cbf-39db-a7f1-a20a3e7dc400",
                                        "glosses": [
                                            "Qui mousse, qui fait beaucoup de mousse ou qui pétille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5e043d-d96c-4b9c-986a-91f12f8540fd",
                                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                                "text": "Cidre mousseux."
                                            },
                                            {
                                                "example_id": "ff92b60a-9395-4210-99a0-da2b13f62326",
                                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                                "text": "Bière mousseuse."
                                            },
                                            {
                                                "example_id": "0dc2fce0-c880-4053-9ad0-027856dc8982",
                                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                                "text": "Vin mousseux."
                                            },
                                            {
                                                "example_id": "05edbc93-ce74-4f67-a563-f4623c8322d9",
                                                "sense_id": "56269c73-d89f-38c6-8704-1e9a3d205dd6",
                                                "text": "Rose mousseuse (se dit parfois pour rose moussue.)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mousseux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                        "entry_id": "a47fdee9-7349-30ec-92a3-98f5002ab07c",
                                        "glosses": [
                                            "Vin pétillant."
                                        ],
                                        "tags": [],
                                        "note": "ne s’emploie pas en parlant du champagne",
                                        "examples": [
                                            {
                                                "example_id": "f68be465-d239-43f1-b8a6-fc9b87a86b83",
                                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                                "text": "Mouin, j’avais préparé un ripage de concombres, un colombo, un gratin de christophines ; j’avais acheté du rosé et du mousseux…"
                                            },
                                            {
                                                "example_id": "1ee90e93-2f44-49b2-96dc-ec31e3130a13",
                                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                                "text": "Dans les mousseux à prise de mousse naturelle, comme l’Asti du Piémont, le jus de raisin est enflaconné avant la fin de sa fermentation et c’est la transformation du sucre résiduel qui crée la pression."
                                            },
                                            {
                                                "example_id": "5d8c5042-19ce-4124-93c7-f8977ce8b21e",
                                                "sense_id": "f06774af-c5d2-34d8-877d-640628844da5",
                                                "text": "Les Parisiens ne prennent jamais les bateaux-mouches et peu d’entre eux sont montés un jour sur la tour Eiffel. Ou alors il y vont, obligés, quand ils reçoivent la visite de Léo, le cousin de province, pourvoyeur en mousseux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f18718ca-8484-47e9-9b36-16a104aed418",
                        "source_entry_id": "b7279062-57d5-3b34-90fc-432a9b52e4e8",
                        "target_lang_word": "moussant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moussant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                        "entry_id": "9610a836-28b3-3dc0-82b8-d0921037da94",
                                        "glosses": [
                                            "Qui mousse, produit de la mousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b18ac6-16b2-40e0-b3d7-1d489654c7f6",
                                                "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                                "text": "On peut donc classer les bières en quatre genres principaux, savoir : nᵒ 1 les bières anglaises (porter, ale, stout, etc.) fortes, capiteuses, et pour la plupart épaisses et moussantes …"
                                            },
                                            {
                                                "example_id": "bdc13739-e848-4864-9264-a14a03656cb8",
                                                "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                                "text": "Voici une découverte qui révolutionne les laboratoires et émerveille les chimistes : c’est une substance super-moussante entièrement nouvelle, qui permet enfin de dégraisser le poil, au lieu de l’amollir seulement. Les gouttes magiques d’Emulsor mettent le poil entièrement « à nu ». Enfin le rasoir entame le poil à fleur de peau et le tranche net, du premier coup, sans « déraper ». Plus de « feu du rasoir » ! Plus de « feu du savon » !"
                                            },
                                            {
                                                "example_id": "d775148f-d5e4-419b-b5ae-ec7e3963e3a0",
                                                "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                                "text": "L’huile de palme brute est riche en bêtacarotène ce qui lui donne sa couleur orange. Chauffée quelques minutes, elle blanchit. Elle donne un savon moussant et dur."
                                            },
                                            {
                                                "example_id": "a12657ab-cdd3-4432-9ded-e6f4e94de8fa",
                                                "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                                "text": "Salez et poivrez si nécessaire. Fouettez la soupe pour l’émulsionner et la rendre un peu moussante."
                                            },
                                            {
                                                "example_id": "0b987e4a-8cf3-4ff4-a672-2d6ab5ea29fa",
                                                "sense_id": "a7a83dcd-a5e3-3a8d-bba0-c8914ed98124",
                                                "text": "Et je m’endormirai calmement, enveloppée dans la chaleur moite du bain moussant, dans un ultime soupir bienheureux pour ne plus jamais me réveiller."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moussant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0102ec-12e0-3101-bcc0-a655366a5be9",
                                        "entry_id": "d4378b20-d26e-3096-a8ac-6b5350376004",
                                        "glosses": [
                                            "Participe présent du verbe mousser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50304509-0b84-4978-bc09-a2787ee4656e",
                        "source_entry_id": "b7279062-57d5-3b34-90fc-432a9b52e4e8",
                        "target_lang_word": "écumeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écumeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1989e97c-1c2c-30a6-928e-7070ddcc7d4b",
                                        "entry_id": "2a2e983c-b9ff-3499-b72e-46397fa72868",
                                        "glosses": [
                                            "Qui est chargé d’écume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f772df9c-101c-4168-886f-0a0d75691c74",
                                                "sense_id": "1989e97c-1c2c-30a6-928e-7070ddcc7d4b",
                                                "text": "Je ressusciterai les cités submergées,\nEt celles dont le sable a couvert les monceaux ;\nDans leur lit écumeux j’enfermerai les eaux ;\nEt les petits enfants des nations vengées,\nNe sachant plus ton nom, riront dans leurs berceaux !"
                                            },
                                            {
                                                "example_id": "200f2261-bd5d-48ee-aa3b-bc3ed49391e5",
                                                "sense_id": "1989e97c-1c2c-30a6-928e-7070ddcc7d4b",
                                                "text": "Le buffle passa le long du fourré, grondant, naseaux écumeux et martelant le sol de ses sabots."
                                            },
                                            {
                                                "example_id": "312a3de3-0fcb-4699-95e2-14aa4fd9003e",
                                                "sense_id": "1989e97c-1c2c-30a6-928e-7070ddcc7d4b",
                                                "text": "[…] la voici, c’est elle, penchée par-dessus le garde-fou, toute nue, éblouie, comme fascinée par l’ouaiche écumeuse qui semble sourdre de la poupe ; […]."
                                            },
                                            {
                                                "example_id": "b435cc8a-bf39-482a-bb45-b644ea708c8f",
                                                "sense_id": "1989e97c-1c2c-30a6-928e-7070ddcc7d4b",
                                                "text": "Tantôt en familles, tantôt en bouquets, tantôt en touffes, ils attirent le regard et la main et je souhaiterais les caresser si la Déesse n’accélérait maintenant son allure, sa robe bruissant comme une écumeuse haute marée qui se hâterait vers le but désiré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba6ec3fc-e80c-407f-8cbc-80c940a162be",
                        "source_entry_id": "b7279062-57d5-3b34-90fc-432a9b52e4e8",
                        "target_lang_word": "spumeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spumeux",
