                                "target_senses": [
                                    {
                                        "sense_id": "b6fba8f3-b324-3b31-841e-57d7283de2a0",
                                        "entry_id": "f39a0e62-5237-38a4-8b6b-1e8d90ac2aff",
                                        "glosses": [
                                            "A structure used to smoke food to preserve it and to add flavor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbdb6543-395c-484e-8994-2b3b572d64ed",
                                                "sense_id": "b6fba8f3-b324-3b31-841e-57d7283de2a0",
                                                "text": "Snakes hang thick from the cypress trees / Like sausage on a smokehouse wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "707ee777-1b4e-33a9-8ffe-ed1209af452f",
                                        "entry_id": "f39a0e62-5237-38a4-8b6b-1e8d90ac2aff",
                                        "glosses": [
                                            "A structure in which freshly harvested tobacco is cured or preserved by smoking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f65ec9d7-ca56-469d-a6a5-d3449313e0cc",
                        "source_entry_id": "6a087846-c971-3b32-9302-7ecce08aa9ff",
                        "source_sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                        "source_sense_description": "Pièce réservée aux fumeurs.",
                        "target_lang_word": "Raucherzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raucherzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f26530b8-0364-3cb3-9edf-810cc6921c51",
                                        "entry_id": "63dc4cb1-2592-3ea7-b986-1a95e5c07376",
                                        "glosses": [
                                            "Zimmer, in dem geraucht werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec1d769-d579-40f0-a0d9-d811c85e8f72",
                                                "sense_id": "f26530b8-0364-3cb3-9edf-810cc6921c51",
                                                "text": "„Von einer großzügigen Eingangshalle mit gewundener Treppe gelangt man in ein knappes Dutzend Räume, darunter ein Salon, ein Esszimmer, ein Raucherzimmer, ein Arbeitszimmer plus Bibliothek und im Obergeschoss mindestens fünf Schlafräume.“"
                                            },
                                            {
                                                "example_id": "86e33c54-1d45-4c1b-b555-d385ea598d1b",
                                                "sense_id": "f26530b8-0364-3cb3-9edf-810cc6921c51",
                                                "text": "„Im Raucherzimmer konnte ich zwei vertrocknete Männer sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
