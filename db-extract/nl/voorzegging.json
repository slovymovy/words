                        "examples": [
                            {
                                "example_id": "b698c889-e928-4d4b-a9c3-eec42f0f2ef5",
                                "sense_id": "7d250e67-d4cf-331a-a569-dbfeaa141a22",
                                "text": "De oude vader zuchtte met doffe pijn: hij gevoelde dat de aaklige voorzegging van Willem zich kon bewaarheden; want Johanna van Navarra was een boze vrouw; echter liet hij zijn mistroostigheid niet blijken en sprak: \"Het is niet redelijk, Willem, dat men zich bedroeve met smartelijke vooruitzichten."
                            },
                            {
                                "example_id": "4ff20d0b-44e1-4f2b-9775-530f3e5c98f6",
                                "sense_id": "7d250e67-d4cf-331a-a569-dbfeaa141a22",
                                "text": "Zijn droefheid was echter veel verminderd, want hij gaf geloof aan de voorzegging van de geneesheer."
                            },
                            {
                                "example_id": "1fd42f0b-8c4d-45f0-b5c7-e274e63950a0",
                                "sense_id": "7d250e67-d4cf-331a-a569-dbfeaa141a22",
                                "text": "\" Jan van Gistel verbleekte bij de plechtige voorzegging des grijsaards."
                            }
                        ]
                    }
