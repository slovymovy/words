        "ru-extract.jsonl": [
            {
                "entry_id": "d5761fe1-273c-3c1f-a057-270b5997f996",
                "word": "зазорно",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69f3cef0-7db3-3c86-88f5-7508002d8c8d",
                        "entry_id": "d5761fe1-273c-3c1f-a057-270b5997f996",
                        "glosses": [
                            "оценка какой-либо ситуации, чьих-либо действий как постыдных, достойных осуждения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5604a9f5-3ef7-46d1-a6d0-7f115a2351fa",
                                "sense_id": "69f3cef0-7db3-3c86-88f5-7508002d8c8d",
                                "text": "Слаб был тоже и выпить, и, когда наступал ему срок, то хмельной по городу бежит нагишом и вопит; город не знатный, а всё зазорно."
                            }
                        ]
                    },
                    {
                        "sense_id": "88899295-9c07-3cbc-beda-a3465a6808e1",
                        "entry_id": "d5761fe1-273c-3c1f-a057-270b5997f996",
                        "glosses": [
                            "предик. неприлично, стыдно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fae6a2-2e1f-40c1-97ca-ead66c21e171",
                                "sense_id": "88899295-9c07-3cbc-beda-a3465a6808e1",
                                "text": "Не одну неделю тут старался в одиночку. Из сил выбиваться стал, а толку не видит. Давно бы отстать надо, а ему это зазорно."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a0cab36-68b1-3674-8c15-1a8ec3346b21",
                        "entry_id": "d5761fe1-273c-3c1f-a057-270b5997f996",
                        "glosses": [
                            "наречие к зазорный"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "ccb86a6f-b44c-4199-a0f7-1053e3aa336a",
                                "sense_id": "0a0cab36-68b1-3674-8c15-1a8ec3346b21",
                                "text": "Уж вечно где-нибудь сидят да играют, а иногда и такое делается, что зазорно рассказывать."
                            },
                            {
                                "example_id": "056dbbc1-61ff-49e5-885d-de7d31b3c20b",
                                "sense_id": "0a0cab36-68b1-3674-8c15-1a8ec3346b21",
                                "text": "― Претит мне это, словно бы жжет оно как-то… Больно уж зазорно выходит, ваше благородие, да и незачем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "978293fc-9d20-4724-b7e9-1cab201dbd6f",
                        "source_entry_id": "d5761fe1-273c-3c1f-a057-270b5997f996",
                        "source_sense_description": "наречие",
                        "target_lang_word": "honteusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honteusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c31c6a35-f198-35b6-bc38-87167516f415",
                                        "entry_id": "cf5b93d0-6413-359c-8276-106029e0ea36",
                                        "glosses": [
                                            "D’une manière honteuse ou ignominieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc31c70-672c-4207-9317-2c1a496dbfe4",
                                                "sense_id": "c31c6a35-f198-35b6-bc38-87167516f415",
                                                "text": "Vous irez à la fin honteusement exclus Trouver au magasin Pyrame et Régulus."
                                            },
                                            {
                                                "example_id": "4360849f-8d3b-4f75-8a21-2fc53736ec24",
                                                "sense_id": "c31c6a35-f198-35b6-bc38-87167516f415",
                                                "text": "Malgré mes vœux, seigneur, honteusement déçus."
                                            },
                                            {
                                                "example_id": "7111e42b-35ad-4a6c-942a-7e38fb345f23",
                                                "sense_id": "c31c6a35-f198-35b6-bc38-87167516f415",
                                                "text": "Enfin, quand il [Tigrane] fut assez près de Pompée, prenant son diadème, il voulut le mettre à ses pieds, et, se prosternant honteusement à terre, lui embrasser les genoux."
                                            },
                                            {
                                                "example_id": "8fa770c9-97a3-4ac5-a96d-82a2f8e90f9c",
                                                "sense_id": "c31c6a35-f198-35b6-bc38-87167516f415",
                                                "text": "Il [un empereur de la Chine] établit le premier des prix pour la vertu ; les lois, partout ailleurs, étaient honteusement bornées à punir les crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b548894-920a-3e37-a7f6-65426a41d397",
                                        "entry_id": "cf5b93d0-6413-359c-8276-106029e0ea36",
                                        "glosses": [
                                            "En éprouvant une certaine honte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21be7eb0-5cec-4beb-a3dc-35799b156175",
                                                "sense_id": "7b548894-920a-3e37-a7f6-65426a41d397",
                                                "text": "Nous dormîmes honteusement jusqu'à huit heures, et je ne sais combien de temps nous aurions prolongé cette grasse matinée, si l’hôtesse n'était venue nous apporter le café, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
