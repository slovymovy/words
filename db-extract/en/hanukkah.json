                                "target_senses": [
                                    {
                                        "sense_id": "9699e091-ecec-3299-abb0-3f62b796fa4a",
                                        "entry_id": "f496ce4c-d123-3a4c-b2a1-9d7081181d13",
                                        "glosses": [
                                            "Fête religieuse juive ayant lieu entre fin novembre et fin décembre (25 Kislev)."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8354a269-b35e-474d-b1af-fbb574176358",
                                                "sense_id": "9699e091-ecec-3299-abb0-3f62b796fa4a",
                                                "text": "Leur arrivée coïncide avec Hanoukka ou la fête des Lumières, une importante célébration juive d'une durée de huit jours."
                                            },
                                            {
                                                "example_id": "792f08ff-0678-4862-99b6-cc6ed5d33aec",
                                                "sense_id": "9699e091-ecec-3299-abb0-3f62b796fa4a",
                                                "text": "Or, le retour au rituel juif à l’intérieur du Temple, lieu le plus sacré du judaïsme, est justement commémoré par la fête juive de Hanoukka."
                                            },
                                            {
                                                "example_id": "cced478a-c2c9-49da-9557-166523f94ba7",
                                                "sense_id": "9699e091-ecec-3299-abb0-3f62b796fa4a",
                                                "text": "– Un vrai miracle de Noël, dit-elle. Ou plutôt, de Hanoukka, pour nous..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4afcafc-4db9-4cd1-b728-ee8dd54f4083",
                        "source_entry_id": "430e7c03-d249-359a-af08-87fa0ff64cbd",
                        "source_sense_id": "cab6877c-e049-37b4-9931-e520f5d7958a",
                        "source_sense_description": "the Jewish festival",
                        "target_lang_word": "Chanukka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chanukka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8d04fc-65f6-3674-b890-1e92ceb799af",
                                        "entry_id": "aceb0cc1-e890-3c83-af5e-bbe12423b9b5",
                                        "glosses": [
                                            "jährlich am 25. Kislew beginnendes, acht Tage währendes jüdisches Fest zum Gedenken an die Wiedereinweihung des Herodianischen Tempels im Jahre 164 vor unserer Zeitrechnung"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "929ce7d1-55bd-48f0-a66b-11e7b85fb7fd",
                                                "sense_id": "6e8d04fc-65f6-3674-b890-1e92ceb799af",
                                                "text": "„In jenen europäischen Ländern, in denen das Chanukka-Fest oft zur selben Zeit wie Weihnachten gefeiert wird, ist Chanukka auch ein Familienfest geworden, welches sogar die der Religion fernstehenden Juden feiern. […] Zu Chanukka darf übrigens gearbeitet werden, jedoch nicht während jener halben Stunde, wenn die Kerzen brennen.“"
                                            },
                                            {
                                                "example_id": "1eaf353a-3695-4c9a-91b4-a22f923f4ceb",
                                                "sense_id": "6e8d04fc-65f6-3674-b890-1e92ceb799af",
                                                "text": "„Wir können es kaum erwarten, und weil Chanukka eher ist als Weihnachten, gelten die meisten Vorbereitungen eben diesem Feiertag.“"
                                            },
                                            {
                                                "example_id": "8567f232-1fc1-4223-830e-90db1016b71c",
                                                "sense_id": "6e8d04fc-65f6-3674-b890-1e92ceb799af",
                                                "text": "„Im milden Schein der Kerzen widerspiegelte sich die ganze Assimilation des jüdischen Zweiges - Chanukka stand niemandem im Wege, am wenigsten Lea.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9924fad9-6da9-3617-8985-0f2dd1d00b3d",
                                        "entry_id": "aceb0cc1-e890-3c83-af5e-bbe12423b9b5",
