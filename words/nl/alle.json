                    "sense_id": "1d8f636f-f359-3e19-9cc3-58ed259df60d",
                    "sense_definition": "Elk lid van een groep of de gehele hoeveelheid; zonder uitzondering.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "all_every",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alle</w> bewoners van ons flatgebouw hebben daar bezwaar tegen gemaakt.",
                            "target_lang_translations": {
                                "ru": "<w>Все</w> жильцы нашего дома возразили против этого.",
                                "en": "<w>All</w> residents of our apartment building objected to that.",
                                "pl": "<w>Wszyscy</w> mieszkańcy naszego bloku zgłosili przeciwko temu sprzeciw.",
                                "de": "<w>Alle</w> Bewohner unseres Wohnblocks haben dagegen Einspruch erhoben.",
                                "fr": "<w>Tous</w> les habitants de notre immeuble s'y sont opposés.",
                                "it": "<w>Tutti</w> i residenti del nostro condominio hanno obiettato a riguardo.",
                                "cs": "<w>Všichni</w> obyvatelé našeho bytového domu proti tomu podali námitku.",
                                "tr": "Apartmanımızın <w>bütün</w> sakinleri buna itiraz etti.",
                                "es": "<w>Todos</w> los residentes de nuestro edificio de apartamentos se opusieron a eso."
                            }
                        },
                        {
                            "text": "Ik heb nog <w>alle</w> tijd om de loterij te winnen.",
                            "target_lang_translations": {
