        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f2079e0a-56d5-311c-827f-bee2c6b80668",
                "word": "whippoorwill",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e37b39bd-d861-4ddd-a1b5-a28bbb1b15cc",
                        "entry_id": "f2079e0a-56d5-311c-827f-bee2c6b80668",
                        "tags": [
                            "plural"
                        ],
                        "form": "whippoorwills"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ccf456d-ef4f-3b9c-8cea-3724fbd0384e",
                        "entry_id": "f2079e0a-56d5-311c-827f-bee2c6b80668",
                        "glosses": [
                            "A nocturnal insectivorous bird of North America (Antrostomus vociferus, syn. Caprimulgus vociferus), a type of nightjar, named after its characteristic call."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101433fa-5f54-493e-93a8-fe69cd0c6d0d",
                                "sense_id": "4ccf456d-ef4f-3b9c-8cea-3724fbd0384e",
                                "text": "“Seems like I heard a whippoorwill callinʼ, and I thought to myself, Go on away from here, weʼll whip ole Will when we find him.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6ffcfd9-e2bb-37a8-92a5-cd29fa6dda02",
                        "entry_id": "f2079e0a-56d5-311c-827f-bee2c6b80668",
                        "glosses": [
                            "The distinctive call of the above bird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b714309-8743-457d-bed0-323377e4072d",
                                "sense_id": "e6ffcfd9-e2bb-37a8-92a5-cd29fa6dda02",
                                "text": "The bird sang his whippoorwills all night."
                            },
                            {
                                "example_id": "7fb1be46-125d-4038-a3e5-da84e79f4034",
                                "sense_id": "e6ffcfd9-e2bb-37a8-92a5-cd29fa6dda02",
                                "text": "From across the road a bird sang 'Whippoorwill, whippoorwill!'"
                            },
                            {
                                "example_id": "89d39991-c17e-427e-bde5-da18aa20b492",
                                "sense_id": "e6ffcfd9-e2bb-37a8-92a5-cd29fa6dda02",
                                "text": "Somewhere in the darkness a few cold-sounding frogs lamented the lost summer, and the bird which the Chippewa called muck-a-wiss sang whippoorwill."
                            },
                            {
                                "example_id": "6aa5aa35-5e3f-405f-86a1-99572633edf9",
                                "sense_id": "e6ffcfd9-e2bb-37a8-92a5-cd29fa6dda02",
                                "text": "For I'm sure 'tis a bird that now sings 'Whippoorwill, Whippoorwill, whippoorwill, whippoorwill, whippoorwill!'"
                            }
                        ]
                    }
                ],
                "translations": [
