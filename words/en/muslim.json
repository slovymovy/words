    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2ef67c0-92b0-38fa-99e8-e18c5b439151",
                    "sense_definition": "A person who follows the religion of Islam.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Muslims</w> around the world fast during the holy month of Ramadan.",
                            "target_lang_translations": {
                                "ru": "Многие <w>мусульмане</w> во всем мире постятся во время священного месяца Рамадан.",
                                "zh": "世界各地的许多<w>穆斯林</w>会在斋月期间封斋。"
                            }
                        },
                        {
                            "text": "She is a devout <w>Muslim</w> who prays five times a day.",
                            "target_lang_translations": {
                                "ru": "Она набожная <w>мусульманка</w>, которая молится пять раз в день.",
                                "zh": "她是一位虔诚的<w>穆斯林</w>，每天祈祷五次。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-Muslim"
                    ],
                    "common_phrases": [
                        "practicing Muslim",
                        "devout Muslim",
                        "Muslim community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, исповедующий религию ислам.",
                        "zh": "信仰伊斯兰教的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусульманин",
                                "target_lang_sense_clarification": "мужской род / общее значение"
                            },
                            {
                                "target_lang_word": "мусульманка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穆斯林",
                                "target_lang_sense_clarification": "指伊斯兰教徒，不分性别"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "16524950-ec6c-3740-9b13-bc15d3b6244e",
                    "sense_definition": "Relating to the religion of Islam or its followers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We learned about <w>Muslim</w> art and architecture in our history class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали <w>мусульманское</w> искусство и архитектуру на уроке истории.",
                                "zh": "我们在历史课上学习了<w>伊斯兰</w>艺术和建筑。"
                            }
                        },
                        {
                            "text": "The <w>Muslim</w> population in the city has grown significantly in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Мусульманское</w> население города значительно выросло за последние годы.",
                                "zh": "近年来，该市的<w>穆斯林</w>人口显著增长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Islamic"
                    ],
                    "antonyms": [
                        "non-Muslim"
                    ],
                    "common_phrases": [
                        "Muslim world",
                        "Muslim country",
                        "Muslim culture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к религии ислам или её последователям.",
                        "zh": "与伊斯兰教或其信徒有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусульманский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穆斯林的",
                                "target_lang_sense_clarification": "形容词，表示与穆斯林相关"
                            },
                            {
                                "target_lang_word": "伊斯兰",
                                "target_lang_sense_clarification": "常用于修饰文化、艺术等名词"
                            }
                        ]
                    }
                }
            ]
        },
