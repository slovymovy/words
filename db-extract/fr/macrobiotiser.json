                "senses": [
                    {
                        "sense_id": "2e62c50c-004b-3da6-bef6-7aa0ed449075",
                        "entry_id": "399fc435-38c4-3408-8a6c-e0be9e02d000",
                        "glosses": [
                            "Donner un caractère macrobiotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04491f03-ebac-4b56-9ec3-9c3115163d49",
                                "sense_id": "2e62c50c-004b-3da6-bef6-7aa0ed449075",
                                "text": "Merci Mme Rivière pour votre livre aussi simple que pratique qui m'aide au quotidien à \"macrobiotiser\" ma vie en cuisinant autrement."
                            },
                            {
                                "example_id": "458d93ba-a7e3-4cc3-b346-0a2492fba7f7",
                                "sense_id": "2e62c50c-004b-3da6-bef6-7aa0ed449075",
                                "text": "Et après cette phrase obscure, un caquètement métallique comme pourrait en faire une sorte de poule macrobiotisée."
                            },
                            {
                                "example_id": "4556547b-4fa4-4117-8298-5a0042631138",
                                "sense_id": "2e62c50c-004b-3da6-bef6-7aa0ed449075",
                                "text": "Aux Etats-Unis, il a d'abord été le légume préféré des post-soixante-huitards macrobiotisés, louant ses vertus détoxifiantes et sa richesse en nutriments."
                            }
                        ]
                    }
