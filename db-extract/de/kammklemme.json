                "senses": [
                    {
                        "sense_id": "b3f74a10-5811-30c4-9580-4709fc7cc65a",
                        "entry_id": "7f41c79b-72ec-3dee-acaf-0eaaa98c3a75",
                        "glosses": [
                            "Beschlag auf einem Segelboot aus Kunststoff oder Metall, der dem Fixieren von Tauen (Schoten, Fallen, Streckern, etc.) dient"
                        ],
                        "tags": [
                            "Seglersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "3518153f-dfbe-483b-80e9-c574470a5921",
                                "sense_id": "b3f74a10-5811-30c4-9580-4709fc7cc65a",
                                "text": "Die Kammklemme (Clamcleat) hat keine beweglichen Teile. Sie bekneift in einem geriffelten Spalt und wird vornehmlich für Traveller-Stopper, Schwert- und Ruderfall verwendet."
                            },
                            {
                                "example_id": "c3599f5f-8706-4d9d-9131-3345a153e5a0",
                                "sense_id": "b3f74a10-5811-30c4-9580-4709fc7cc65a",
                                "text": "Die Curryklemme hat die gleiche Funktion, wie die Kammklemme: Halten einer Leine, Schot oder eines Falls."
                            }
                        ],
