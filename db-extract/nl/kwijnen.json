                        "entry_id": "9d1ecc67-fb33-35ca-8368-8f2307a5162a",
                        "glosses": [
                            "een levend wezen dat steeds minder levendig wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6eebb9-65e4-4b1b-aa43-7480297c0921",
                                "sense_id": "83bd44d0-28d0-313f-ab53-9331d5a0b6f9",
                                "text": "Konijnen willen een maatje, maar kwijnen vaak weg in eenzaamheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "142780a3-c3dc-3c02-ad70-5d28adc4544d",
