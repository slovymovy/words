                "senses": [
                    {
                        "sense_id": "cd6dfd93-76f8-34e0-8399-ac260ba0a252",
                        "entry_id": "ef89ebfc-40fe-340b-9a29-5bd26b8f5882",
                        "glosses": [
                            "One who abridges, a person who shortens written works."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9e44e4-5996-40c7-889f-98045175a583",
                                "sense_id": "cd6dfd93-76f8-34e0-8399-ac260ba0a252",
                                "text": "[…] while the abilities of the nine-hundredth abridger of the History of England, or of the man who collects and publishes in a volume some dozen lines of Milton, Pope, and Prior, with a paper from the Spectator, and a chapter from Sterne, are eulogized by a thousand pens—there seems almost a general wish of decrying the capacity and undervaluing the labour of the novelist, and of slighting the performances which have only genius, wit, and taste to recommend them."
                            },
                            {
                                "example_id": "b6c44341-5b54-4d7b-9c9d-6eb2a1b507f9",
                                "sense_id": "cd6dfd93-76f8-34e0-8399-ac260ba0a252",
                                "text": "I am an abridger. When I tell people, at a party for instance, that I am an abridger, their faces cloud with confusion and I always have to explain. What I do is take the written work of other people and compress it."
                            }
                        ]
                    }
                ],
