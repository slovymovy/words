                ],
                "senses": [
                    {
                        "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                        "entry_id": "10231a6c-7cbf-3329-bb63-338dd59a21ab",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a17044-e6a1-464f-9c26-7f9ca1db10c3",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Frau Dahl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "81166b5b-ee72-44f8-8dcc-6745c17f4391",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Herr Dahl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ea12c60e-8c68-42d9-abb4-2370550b4b95",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Die Dahls fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "cc23ef82-1b84-43f5-bcab-b0a7ac00448c",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Der Dahl trägt nie die Pullover, die die Dahl ihm strickt."
                            },
                            {
                                "example_id": "044c37a9-c207-4d0f-99d0-49bfc25d8f8c",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dahl kommt, geht der Herr Dahl.“"
                            },
                            {
                                "example_id": "7a46674f-9666-40c6-93bf-bcde9029985f",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Dahl kommt und geht."
                            },
                            {
                                "example_id": "4bb9c9bb-8f58-4b78-8881-a1ac3dd35f56",
                                "sense_id": "101715aa-fe33-3cd6-a7f5-abd4c581c02d",
                                "text": "Dahls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
