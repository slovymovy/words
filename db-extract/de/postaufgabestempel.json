                ],
                "senses": [
                    {
                        "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                        "entry_id": "728eb0d0-e4ac-3fd8-ad85-06e817d3f1f1",
                        "glosses": [
                            "Stempel der Post bei Einreichung des Postgutes"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3da75f-aecc-4061-ad11-4a1e5e660c3a",
                                "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                                "text": "„Diese Karte vom Rathaus mit Stadtwappen wurde im Farbkunstdruckverfahren hergestellt, trägt den Postaufgabestempel Duderstadt vom 13. Juni 1903 und den Ankunftsstempel Homburg v.d.H. vom 16. Juni 1903.“"
                            },
                            {
                                "example_id": "0764e8d8-55f3-4d3f-9d58-36dcab9ae710",
                                "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                                "text": "„Sie war Anlass zur Schaffung der ersten amtlichen Postaufgabestempel der Thurn-und-Taxis-Post, die dann Vorbilder für die Poststempel vieler altdeutscher Postverwaltungen wurden.“"
                            },
                            {
                                "example_id": "06c3b023-24d8-484d-a6fa-c650c63e076d",
                                "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                                "text": "„Da die die betreffenden Schriftsätze enthaltenden Kuverts nicht im Akt aufbewahrt wurden und seither beinahe ein Jahr verstrichen ist, läßt sich wohl kaum mehr verifizieren, wie es zu diesem Vermerk kam und ob das Datum mit dem Postaufgabestempel übereinstimmt.“"
                            },
                            {
                                "example_id": "3d9d6899-7529-4eb2-8c1c-e583d45f4534",
                                "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                                "text": "„An dem Datum des Briefes und dem Postaufgabestempel erkannte der Offerent Schmitz, daß die Annahmeerklärung im postalischen Verkehr irregeleitet sein mußte.“"
                            },
                            {
                                "example_id": "63797237-be26-4116-9f99-dd6ab4e4d3c7",
                                "sense_id": "45aa38fe-77ba-397b-92fb-dc1dbf4ee26e",
                                "text": "„Hingegen trägt der Briefumschlag des Berufungsurteils den Postaufgabestempel vom 4. September 1961.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
