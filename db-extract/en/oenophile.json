                "entry_id": "e5411331-d39b-301a-91f8-1c1f4e07e905",
                "word": "oenophile",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e26c8778-8ea2-4a74-ac53-723c8b6e2f3e",
