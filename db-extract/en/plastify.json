                "senses": [
                    {
                        "sense_id": "ad043f8c-7e02-31cd-9321-ab31b8e30f72",
                        "entry_id": "19b002fe-1241-306e-acd2-6ff1d43dcfca",
                        "glosses": [
                            "To make or become plastic or malleable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adaea93e-6bfc-443e-a7f7-90efb716fd7d",
                                "sense_id": "ad043f8c-7e02-31cd-9321-ab31b8e30f72",
                                "text": "Mixer 4 may be any conventional single screw or twin-screw extruder equipped with heating means to plastify the thermoplastic resin mix therein."
                            },
                            {
                                "example_id": "bae140f8-ba93-43ed-8d3f-9659198d5c4e",
                                "sense_id": "ad043f8c-7e02-31cd-9321-ab31b8e30f72",
                                "text": "At a soft initial deformation response, all cross-sections or loaded layers within the gauge length of the specimen may not plastify due to the variation of the actual load-bearing area along the specimen."
                            },
                            {
                                "example_id": "34ce2753-0fbb-4ec1-a1dd-3dbd4691e9e0",
                                "sense_id": "ad043f8c-7e02-31cd-9321-ab31b8e30f72",
                                "text": "Some materials have a distinctly defined yield point, e.g. most steels, whereas other materials start to plastify gradually at very low stresses."
                            },
                            {
                                "example_id": "0080ebb3-8035-4acf-8caf-8563b9762387",
                                "sense_id": "ad043f8c-7e02-31cd-9321-ab31b8e30f72",
                                "text": "Oh. Well, I can't identify the spell that was cast – other than that it required a large amount of magic – which would fit in with a shrink and plastify."
                            }
                        ]
                    }
                ],
