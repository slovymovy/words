                    },
                    {
                        "translation_id": "cf632bda-7de9-4808-9e95-df5f1cbcf871",
                        "source_entry_id": "3487ae79-38e9-3501-a747-c3c00502f7a3",
                        "source_sense_id": "f88218e9-dd13-306a-8c47-22688841f658",
                        "target_lang_word": "Schachspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schachspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                        "entry_id": "bfc99ecf-11f4-3c62-a9c3-d3274ca9dc1e",
                                        "glosses": [
                                            "(männliche^☆) Person, die das Schachspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fa8a2e-527f-4ddc-af91-824b1c4eb3d9",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "Schachspieler müssen über eine hohe Konzentrationsfähigkeit verfügen."
                                            },
                                            {
                                                "example_id": "19a0f7d5-59a2-492e-96b8-854ce7174cd3",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Der Sultan wollte durchaus seinem Feind das Gefühl schenken, einen wirklich großen Schachspieler geschlagen zu haben, den zweitbesten der Welt vielleicht.“"
                                            },
                                            {
                                                "example_id": "deedf783-b689-4bb4-86e2-59a744794cb3",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Ob im Herbst 2020 im Museumsquartier drei Wochen lang die Köpfe der beiden besten Schachspieler der Welt rauchen, entscheidet sich im Frühjahr.“"
                                            },
                                            {
                                                "example_id": "9a0c732a-ebb4-4d91-ad72-9073617f71b1",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Indessen heißt rechnen noch nicht analysieren. Ein Schachspieler zum Beispiel tut das eine, ohne sich um das andere im mindesten zu kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
