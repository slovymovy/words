{
    "word_family": [
        "foresee",
        "foreseeable",
        "foresight"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a0ee5ef-bfcb-3b4b-8d6b-bc74fc23dc49",
                    "sense_definition": "Alternative spelling of <w>foresee</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "foresee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>forsee</w> what will happen in the next decade.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>предвидеть</w>, что произойдет в следующем десятилетии."
                            }
                        },
                        {
                            "text": "No one could <w>forsee</w> the sudden change in the global economy.",
                            "target_lang_translations": {
                                "ru": "Никто не мог <w>предугадать</w> внезапное изменение в мировой экономике."
                            }
                        }
                    ],
                    "synonyms": [
                        "foresee",
                        "predict",
                        "anticipate"
                    ],
                    "common_phrases": [
                        "forsee the future",
                        "difficult to forsee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова foresee (предвидеть, прогнозировать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвидеть",
                                "target_lang_sense_clarification": "знать заранее о будущих событиях"
                            },
                            {
                                "target_lang_word": "прогнозировать",
                                "target_lang_sense_clarification": "делать прогноз на будущее"
                            },
                            {
                                "target_lang_word": "предугадывать",
                                "target_lang_sense_clarification": "угадывать то, что произойдет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bfa53b6-5df4-3d91-95cd-d2ba96c600bc",
                    "sense_definition": "To neglect, overlook, disregard, or despise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "neglect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could I <w>forsee</w> the sunken rocks of life and avoid them?",
                            "target_lang_translations": {
                                "ru": "Мог ли я <w>пренебречь</w> подводными камнями жизни и избежать их?"
                            }
                        },
                        {
                            "text": "He chose to <w>forsee</w> his duties, leading to the project's ultimate failure.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пренебречь</w> своими обязанностями, что привело к полному провалу проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "neglect",
                        "overlook",
                        "disregard",
                        "ignore"
                    ],
                    "antonyms": [
                        "attend",
                        "heed",
                        "regard"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is archaic and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пренебрегать, упускать из виду, игнорировать или презирать (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "не уделять должного внимания"
                            },
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "умышленно не замечать"
                            },
                            {
                                "target_lang_word": "упускать из виду",
                                "target_lang_sense_clarification": "не замечать или забывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d977270-5e43-3e0f-b93f-99cc25b31c21",
                    "sense_definition": "To oversee, superintend, or direct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "superintend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was appointed to <w>forsee</w> the daily operations of the new facility.",
                            "target_lang_translations": {
                                "ru": "Менеджер был назначен, чтобы <w>контролировать</w> ежедневную деятельность нового объекта."
                            }
                        },
                        {
                            "text": "It was her responsibility to <w>forsee</w> the entire construction process from start to finish.",
                            "target_lang_translations": {
                                "ru": "В ее обязанности входило <w>курировать</w> весь процесс строительства от начала до конца."
                            }
                        }
                    ],
                    "synonyms": [
                        "oversee",
                        "superintend",
                        "supervise",
                        "direct"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is archaic and largely replaced by oversee."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наблюдать, контролировать, заведовать или руководить (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курировать",
                                "target_lang_sense_clarification": "направлять работу, контролировать"
                            },
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "следить за ходом процесса"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "управлять процессом или работой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}