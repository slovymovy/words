    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72794fda-a184-33e7-b097-5d8d142157cf",
                    "sense_definition": "A common misspelling of the word <w>sense</w>.",
                    "learner_level": "A1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It makes no <w>sense</w> to go out in this heavy rain.",
                            "target_lang_translations": {
                                "ru": "Нет никакого <w>смысла</w> выходить на улицу в такой сильный дождь."
                            }
                        },
                        {
                            "text": "She has a good <w>sense</w> of humor.",
                            "target_lang_translations": {
                                "ru": "У нее хорошее <w>чувство</w> юмора."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная орфографическая ошибка слова sense (смысл, чувство)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смысл",
                                "target_lang_sense_clarification": "значение или логика"
                            },
                            {
                                "target_lang_word": "чувство",
                                "target_lang_sense_clarification": "ощущение или восприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a9f36d3-0239-3a1b-85b3-10bdb417788d",
                    "sense_definition": "An archaic form of <w>sense</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text used the word <w>sence</w> to describe human perception.",
                            "target_lang_translations": {
                                "ru": "В старом тексте использовалось слово <w>чувство</w> для описания человеческого восприятия."
                            }
                        },
                        {
                            "text": "In historical literature, one might encounter the spelling <w>sence</w> for the modern word <w>sense</w>.",
                            "target_lang_translations": {
                                "ru": "В исторической литературе можно встретить написание <w>чувство</w> вместо современного слова sense."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This spelling is no longer used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма написания слова sense."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувство",
                                "target_lang_sense_clarification": "устаревшее написание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "f5485a75-1bb2-3006-88f7-b5305bbba0b3",
                    "sense_definition": "An alternative spelling of <w>since</w> used as a conjunction.",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alternative_spelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Since</w> it is raining, we should stay inside.",
                            "target_lang_translations": {
                                "ru": "<w>Поскольку</w> идет дождь, нам следует остаться дома."
                            }
                        },
                        {
                            "text": "I have been happy <w>since</w> I moved here.",
                            "target_lang_translations": {
                                "ru": "Я счастлив <w>с тех пор</w>, как переехал сюда."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This spelling is non-standard and generally considered an error."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестандартное написание союза since (поскольку, так как)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поскольку",
                                "target_lang_sense_clarification": "причинно-следственная связь"
                            },
                            {
                                "target_lang_word": "так как",
                                "target_lang_sense_clarification": "причинно-следственная связь"
                            }
                        ]
                    }
                }
            ]
        },
        {
