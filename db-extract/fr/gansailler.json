                                "example_id": "534bf266-9245-4ba7-b4e8-d8d8f7213708",
                                "sense_id": "81971e0e-276c-33ad-926b-9ca960c32700",
                                "text": "Comme toi, les filles ne demandent qu’à se faire gansailler dans mon lit !"
