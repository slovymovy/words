                "senses": [
                    {
                        "sense_id": "05a11243-fc66-3860-ac40-75ba8d84d669",
                        "entry_id": "b8c2703a-a30f-3003-a68f-2085c1e27d8b",
                        "glosses": [
                            "Gerichtsverfahren zur Klärung der Rechtslage, das als Beispiel für ähnliche, künftige Fälle durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517aba0b-38b4-4035-8025-87a517e1ab5a",
                                "sense_id": "05a11243-fc66-3860-ac40-75ba8d84d669",
                                "text": "„Eine außergerichtliche Einigung zwischen den Parteien soll wegen der verbindlichen Klärungen im Musterverfahren nun wahrscheinlicher sein.“"
                            },
                            {
                                "example_id": "e7981c43-85dc-4f2b-b4d3-33fa174c4279",
                                "sense_id": "05a11243-fc66-3860-ac40-75ba8d84d669",
                                "text": "„Die Entscheidung zur Durchführung von Musterverfahren trifft das Gericht im eigenen Ermessen.“"
                            },
                            {
                                "example_id": "714b6c78-8be7-4ee8-aaa3-fde34dcdb5e3",
                                "sense_id": "05a11243-fc66-3860-ac40-75ba8d84d669",
                                "text": "„Nachdem die Musterverfahren rechtskräftig entschieden worden sind, kann das Gericht über die ausgesetzten Verfahren durch Beschluss entscheiden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
