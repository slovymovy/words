                    {
                        "sense_id": "264031cd-c361-398c-a05f-1e70ce64b767",
                        "entry_id": "443606c8-a079-32bd-818d-cc5c5aa7c5d6",
                        "glosses": [
                            "Celui qui invite, hôte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0aaa306-07f0-40ea-a653-267317075850",
                                "sense_id": "264031cd-c361-398c-a05f-1e70ce64b767",
                                "text": "Un naïf s'y laisse prendre [à une invitation à dîner par un avare], et tombe chez lui sur le coup de six heures : grimace de l'inviteur."
                            },
                            {
                                "example_id": "aa1eeb6c-664e-4fd3-8802-6f385769025e",
                                "sense_id": "264031cd-c361-398c-a05f-1e70ce64b767",
                                "text": "Les enfants de mon parrain et ceux de mon frère vinrent à tour de rôle nous inviter à leurs noces. On était généralement prévenu de leur arrivée et on faisait quelques préparatifs pour les recevoir : l’usage veut que l’on fasse faire bombance aux inviteurs."
                            }
                        ]
                    }
