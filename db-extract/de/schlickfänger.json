                "senses": [
                    {
                        "sense_id": "32a9a999-39c8-3322-aa3a-bf231a8be74a",
                        "entry_id": "b1d93cff-7a69-373a-84bf-cbf22d6305cb",
                        "glosses": [
                            "verschlungenes Geflecht vor einer Schlenge, einem Schutzwerk gegen Wasser; (andere) Vorrichtung, die dafür gedacht ist, den Schlamm im Wasser (Schlick) zum Sinken zu bringen"
                        ],
                        "tags": [
                            "auch für"
                        ],
                        "examples": [
                            {
                                "example_id": "4151368c-f2cd-45de-8811-076d2eb8a5f8",
                                "sense_id": "32a9a999-39c8-3322-aa3a-bf231a8be74a",
                                "text": "Zwischen den Quellerpflanzen kommt das Wasser zur Ruhe, sie fungieren als Schlickfänger und helfen bei der Anlandung, der Entstehung von Land."
                            },
                            {
                                "example_id": "d252a093-94ea-4bbd-98c8-58693d1a5422",
                                "sense_id": "32a9a999-39c8-3322-aa3a-bf231a8be74a",
                                "text": "„Die Bauart der Schlickfänger wird durch die Stärke der Flutströmung bestimmt; sie begrenzen meist Quadrate von etwa 4oom Seitenlänge, die an der Meeresseite eine Öffnung haben, durch die das Flutwasser ein- und auslaufen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
