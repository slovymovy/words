                "senses": [
                    {
                        "sense_id": "fb6de60d-8d05-3d91-bf76-4c0af713456b",
                        "entry_id": "ff9ee6d1-1bf4-31c6-910a-f8f550acdb01",
                        "glosses": [
                            "wprowadzający jakąś nowość, coś nowego w określonej dziedzinie"
