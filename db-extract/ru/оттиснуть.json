                "senses": [
                    {
                        "sense_id": "a08abdf8-424f-3c71-8721-b3c1f6d5403a",
                        "entry_id": "7333286d-250b-32d7-8d60-7a8d305d42c9",
                        "glosses": [
                            "разг. силою оттеснить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97202f6e-ae02-4396-a06d-037ec080601d",
                                "sense_id": "a08abdf8-424f-3c71-8721-b3c1f6d5403a",
                                "text": "Ему не дали договорить и оттиснули его к двери."
                            },
                            {
                                "example_id": "9169c1c4-0323-4b54-bd12-5f570c957bb3",
                                "sense_id": "a08abdf8-424f-3c71-8721-b3c1f6d5403a",
                                "text": "Ему удалось оттиснуть толпу немного назад."
                            }
                        ]
                    },
                    {
                        "sense_id": "d74a4892-3363-376e-b3d6-296d5d87a8a3",
                        "entry_id": "7333286d-250b-32d7-8d60-7a8d305d42c9",
                        "glosses": [
                            "спец. сделать оттиск; отпечатать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd22b2d-8c53-408f-82ca-379bbe0b5129",
                                "sense_id": "d74a4892-3363-376e-b3d6-296d5d87a8a3",
                                "text": "На синеватом пламени горелки расплавил кусок сургуча и края колокола припечатал к столу, а на сургучных пятнах оттиснул свой большой палец."
                            }
                        ]
                    }
