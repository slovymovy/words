                ],
                "translations": [
                    {
                        "translation_id": "fb3a3f95-31c0-4154-961b-9c8c17024a83",
                        "source_entry_id": "417fbb71-58b5-374a-b400-c4b6b1818f76",
                        "source_sense_id": "c5866aa1-3223-3b34-aa6c-0833642f0980",
