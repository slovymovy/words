                    {
                        "sense_id": "f2328d90-87dc-334f-8bba-e577e956a1de",
                        "entry_id": "cf81bbcf-1213-3514-967e-b8ff2bb92914",
                        "glosses": [
                            "die Vergrößerung eines Gewebes oder eines Organs durch vermehrte Zellteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e475fc4-c3ae-49e6-acb7-89a6f21e9e77",
                                "sense_id": "f2328d90-87dc-334f-8bba-e577e956a1de",
                                "text": "„Ein chronischer Jodmangel führt zunächst zur Hyperplasie und später Hypertrophie, d. h. zur Größenzunahme der Schilddrüse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
