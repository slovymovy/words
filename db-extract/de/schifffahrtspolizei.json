                        "glosses": [
                            "Ordnungsbehörde, deren Zuständigkeit die Seeschifffahrt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17e367e-7bd1-4879-aa77-b0b62f47dd91",
                                "sense_id": "428babe5-571f-30f7-879e-1ae3a1377675",
                                "text": "„Die Schifffahrtspolizei der Schweizerischen Rheinhäfen ist für die Belange der Grossschifffahrt (Schiffe ab 20 m Länge) auf dem Rhein sowie für deren Überwachung zuständig. Ihr Zuständigkeitsbereich erstreckt sich auf dem Rhein von der Landesgrenze (Rhein-km 170.00) bei Basel bis zur Strassenbrücke Rheinfelden (Rhein-km 149.00).“"
                            }
                        ],
