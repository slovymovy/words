                                "target_senses": [
                                    {
                                        "sense_id": "944d5caa-f90f-3699-b96b-cf8592d50ce5",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Celui qui dans une communauté, dans une maison, a la charge du linge, de la vaisselle, du pain, du vin et des liqueurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f3998f-b8ab-4b58-ba8e-dc1acb8ac9b9",
                                                "sense_id": "944d5caa-f90f-3699-b96b-cf8592d50ce5",
                                                "text": "Bon, fidèle sommelier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                        "entry_id": "168577d3-eeec-3218-bacf-dc05b18e2ba1",
                                        "glosses": [
                                            "Celui qui, dans un restaurant, a la charge de la cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c2587b-de54-4195-9a2c-8713c3af8e2c",
                                                "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                                "text": "Le défaut majeur de beaucoup de sommeliers, c’est de vouloir conclure avant d’analyser."
                                            },
                                            {
                                                "example_id": "03982327-633e-498b-bc5f-3a2c3f6a01b6",
                                                "sense_id": "6b52ff25-4930-3e86-bb3a-4267008fd33e",
                                                "text": "Savez-vous, jeune homme, qu’il fut un temps où caviste, sommelier et échanson correspondaient à trois professions bien distinctes, alors qu’aujourd’hui, les traditions se perdent, conserver, préparer et servir le vin, c’est tout un…"
                                            }
                                        ]
                                    },
