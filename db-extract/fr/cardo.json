                "senses": [
                    {
                        "sense_id": "e881309d-b5f0-3957-9525-46df98c0409b",
                        "entry_id": "61dda944-6091-323a-bb4f-4605bb1594d7",
                        "glosses": [
                            "Rue dans l’axe nord-sud, d’une ville romaine. Utilisé généralement pour désigner le cardo maximus c'est à dire la rue principale et centrale orientée nord-sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33438805-f70e-419c-b4b1-769b27eaf631",
                                "sense_id": "e881309d-b5f0-3957-9525-46df98c0409b",
                                "text": "Les fouilles révèlent en effet que certaines rues reprennent un tracé plus ancien. C’est le cas du cardo, l’axe central nord-sud qui traverse la cité, correspondant aux actuelles rues Saint-Martin, sur la rive droite, et Saint-Jacques, sur la rive gauche."
                            },
                            {
                                "example_id": "b78a3e69-26e9-4009-9590-547ac3fea8ae",
                                "sense_id": "e881309d-b5f0-3957-9525-46df98c0409b",
                                "text": "Lutèce grandit autour d’un premier axe, le cardo maximus romain, la voie principale de la ville, l’axe vertical reliant par deux ponts l’île de la Cité aux rive du fleuve."
                            },
                            {
                                "example_id": "d7f2b441-2c57-413c-abd7-121fc7989437",
                                "sense_id": "e881309d-b5f0-3957-9525-46df98c0409b",
                                "text": "À la croisée du cardo et du decumanus d’une cité, on trouvait généralement le forum."
                            },
                            {
                                "example_id": "72b93031-e274-4bf6-8b61-76d47b293ee7",
                                "sense_id": "e881309d-b5f0-3957-9525-46df98c0409b",
                                "text": "Le cardo de Paris était l’axe nord-sud qui correspondait aux actuels rue Saint-Jacques et boulevard Saint-Michel traversant notamment la montagne Sainte-Geneviève."
                            }
                        ]
                    }
                ],
