{
    "word_family": [
        "steely",
        "steeliness",
        "steelworker",
        "steelworks"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b793131-7400-3ce3-b0b5-aa9c04c92d04",
                    "sense_definition": "A strong, hard metal alloy made of iron and carbon, used extensively in construction and manufacturing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skyscraper is supported by a massive frame made of <w>steel</w>.",
                            "target_lang_translations": {
                                "ru": "Небоскреб поддерживается массивным каркасом из <w>стали</w>.",
                                "zh": "这座摩天大楼由一个巨大的<w>钢</w>框架支撑。"
                            }
                        },
                        {
                            "text": "Most kitchen knives are made of stainless <w>steel</w> to prevent rust.",
                            "target_lang_translations": {
                                "ru": "Большинство кухонных ножей сделаны из нержавеющей <w>стали</w>, чтобы предотвратить ржавчину.",
                                "zh": "大多数厨房刀具都是用不锈<w>钢</w>制成的，以防生锈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alloy",
                        "metal"
                    ],
                    "common_phrases": [
                        "stainless steel",
                        "carbon steel",
                        "structural steel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный, твердый металлический сплав железа и углерода, широко используемый в строительстве и производстве.",
                        "zh": "一种由铁和碳组成的坚硬金属合金，广泛用于建筑和制造业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сталь",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢",
                                "target_lang_sense_clarification": "金属材料"
                            },
                            {
                                "target_lang_word": "钢铁",
                                "target_lang_sense_clarification": "金属材料总称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aadfbeaf-3e65-3b32-87cf-c3564f556b9d",
                    "sense_definition": "Great hardness, strength, or determination, used figuratively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need nerves of <w>steel</w> to work as a bomb disposal expert.",
                            "target_lang_translations": {
                                "ru": "Вам нужны нервы из <w>стали</w>, чтобы работать сапером.",
                                "zh": "做拆弹专家需要有<w>钢铁</w>般的神经。"
                            }
                        },
                        {
                            "text": "She showed a will of <w>steel</w> when she refused to give up despite the difficulties.",
                            "target_lang_translations": {
                                "ru": "Она проявила волю из <w>стали</w>, когда отказалась сдаваться, несмотря на трудности.",
                                "zh": "尽管困难重重，她拒绝放弃，展现出了<w>钢铁</w>般的意志。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toughness",
                        "resilience",
                        "fortitude"
                    ],
                    "antonyms": [
                        "weakness",
                        "frailty"
                    ],
                    "common_phrases": [
                        "nerves of steel",
                        "grip of steel",
                        "heart of steel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая твердость, сила или решимость (в переносном смысле).",
                        "zh": "比喻极大的坚硬、力量或决心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сталь",
                                "target_lang_sense_clarification": "перен. твердость характера"
                            },
                            {
                                "target_lang_word": "твердость",
                                "target_lang_sense_clarification": "качество характера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢铁般",
                                "target_lang_sense_clarification": "形容意志或性格"
                            },
                            {
                                "target_lang_word": "坚毅",
                                "target_lang_sense_clarification": "形容性格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cff5bfd7-5c74-3e5b-896d-5e36f31da28c",
                    "sense_definition": "A rod of rough steel used for sharpening knives.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher ran his knife along the <w>steel</w> to hone the edge.",
                            "target_lang_translations": {
                                "ru": "Мясник провел ножом по <w>мусату</w>, чтобы заточить лезвие.",
                                "zh": "屠夫用<w>磨刀棒</w>来磨快他的刀刃。"
                            }
                        },
                        {
                            "text": "Keep the blade at a twenty-degree angle when using the sharpening <w>steel</w>.",
                            "target_lang_translations": {
                                "ru": "Держите лезвие под углом двадцать градусов при использовании <w>мусата</w>.",
                                "zh": "使用<w>磨刀棒</w>时，请保持刀刃呈二十度角。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sharpener",
                        "hone"
                    ],
                    "common_phrases": [
                        "sharpening steel",
                        "honing steel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стержень из шероховатой стали, используемый для заточки ножей.",
                        "zh": "一种用于磨快刀具的粗糙钢棒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусат",
                                "target_lang_sense_clarification": "инструмент для правки ножей"
                            },
                            {
                                "target_lang_word": "точило",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磨刀棒",
                                "target_lang_sense_clarification": "工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "773086ae-c130-3247-8cfc-6a2da9dff0f5",
                    "sense_definition": "A sword or other weapon made of steel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knights drew their <w>steel</w> and charged into the chaotic battle.",
                            "target_lang_translations": {
                                "ru": "Рыцари обнажили свою <w>сталь</w> и бросились в хаотичную битву.",
                                "zh": "骑士们拔出<w>钢剑</w>，冲进了混乱的战场。"
                            }
                        },
                        {
                            "text": "Many soldiers fell by the cold <w>steel</w> of the enemy army.",
                            "target_lang_translations": {
                                "ru": "Многие солдаты пали от холодной <w>стали</w> вражеской армии.",
                                "zh": "许多士兵倒在了敌军冰冷的<w>利刃</w>之下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blade",
                        "sword",
                        "weapon"
                    ],
                    "common_phrases": [
                        "cold steel",
                        "clash of steel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly literary or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Меч или другое холодное оружие, сделанное из стали.",
                        "zh": "用钢制成的剑或其他武器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сталь",
                                "target_lang_sense_clarification": "поэт. меч, клинок"
                            },
                            {
                                "target_lang_word": "клинок",
                                "target_lang_sense_clarification": "холодное оружие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利刃",
                                "target_lang_sense_clarification": "指代武器"
                            },
                            {
                                "target_lang_word": "钢剑",
                                "target_lang_sense_clarification": "指代武器"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "117e9c0f-2d73-3e8f-9d54-180ad46e7807",
                    "sense_definition": "Made of or consisting of steel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to bend the <w>steel</w> bar, but it was too strong.",
                            "target_lang_translations": {
                                "ru": "Он пытался согнуть <w>стальной</w> прут, но тот был слишком прочным.",
                                "zh": "他试图弯曲那根<w>钢制</w>杆，但它太结实了。"
                            }
                        },
                        {
                            "text": "The factory installed heavy <w>steel</w> doors for added security.",
                            "target_lang_translations": {
                                "ru": "Завод установил тяжелые <w>стальные</w> двери для дополнительной безопасности.",
                                "zh": "工厂安装了厚重的<w>钢制</w>门以加强安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metal"
                    ],
                    "common_phrases": [
                        "steel beam",
                        "steel frame",
                        "steel wool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из стали или состоящий из неё.",
                        "zh": "由钢制成或包含钢的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стальной",
                                "target_lang_sense_clarification": "сделанный из стали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢制",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d61810b9-d23a-33c8-9bc3-9300295e6f7a",
                    "sense_definition": "Relating to the production, manufacture, or trade of steel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "industry_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>steel</w> industry has been a major employer in this region for decades.",
                            "target_lang_translations": {
                                "ru": "<w>Сталелитейная</w> промышленность десятилетиями была основным работодателем в этом регионе.",
                                "zh": "<w>钢铁</w>工业几十年来一直是该地区的主要雇主。"
                            }
                        },
                        {
                            "text": "Economic changes have forced many local <w>steel</w> mills to close down.",
                            "target_lang_translations": {
                                "ru": "Экономические изменения вынудили закрыться многие местные <w>сталелитейные</w> заводы.",
                                "zh": "经济变革迫使许多当地的<w>钢铁</w>厂倒闭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel industry",
                        "steel mill",
                        "steel plant",
                        "steel production"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к производству, изготовлению или торговле сталью.",
                        "zh": "与钢铁的生产、制造或贸易有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сталелитейный",
                                "target_lang_sense_clarification": "относящийся к промышленности"
                            },
                            {
                                "target_lang_word": "стальной",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢铁",
                                "target_lang_sense_clarification": "行业属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7bf9b04-5e1b-31b2-b86f-6cffd4981adc",
                    "sense_definition": "Resembling steel in color (grey-blue) or hardness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky turned a cold <w>steel</w> grey just before the snow began to fall.",
                            "target_lang_translations": {
                                "ru": "Небо приобрело холодный <w>стальной</w> оттенок как раз перед тем, как начал падать снег.",
                                "zh": "下雪前，天空变成了冰冷的<w>钢灰</w>色。"
                            }
                        },
                        {
                            "text": "He fixed the stranger with a <w>steel</w> gaze that made everyone uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он устремил на незнакомца <w>стальной</w> взгляд, от которого всем стало не по себе.",
                                "zh": "他用一种<w>冷峻的</w>目光盯着那个陌生人，让在场的所有人都感到不自在。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steely",
                        "grey-blue"
                    ],
                    "common_phrases": [
                        "steel grey",
                        "steel blue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий сталь по цвету (серо-голубой) или твердости.",
                        "zh": "颜色（灰蓝色）或硬度上像钢的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стальной",
                                "target_lang_sense_clarification": "цвет или оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钢灰色",
                                "target_lang_sense_clarification": "颜色"
                            },
                            {
                                "target_lang_word": "冷峻的",
                                "target_lang_sense_clarification": "形容眼神"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25c443aa-f3cc-39c3-adda-520881e3af66",
                    "sense_definition": "To mentally prepare oneself to do something difficult, unpleasant, or painful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_prepare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>steel</w> herself before walking into the boss's office to resign.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>собраться с духом</w>, прежде чем войти в кабинет начальника, чтобы уволиться.",
                                "zh": "在走进老板办公室辞职之前，她不得不<w>鼓起勇气</w>。"
                            }
                        },
                        {
                            "text": "He <w>steeled</w> his heart against their tears and made the hard decision.",
                            "target_lang_translations": {
                                "ru": "Он <w>закалил</w> свое сердце против их слез и принял трудное решение.",
                                "zh": "他<w>磨练</w>了自己的心志，无视他们的眼泪，做出了艰难的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brace",
                        "fortify",
                        "toughen"
                    ],
                    "antonyms": [
                        "weaken",
                        "soften"
                    ],
                    "common_phrases": [
                        "steel oneself",
                        "steel one's heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психологически подготовить себя к чему-то трудному, неприятному или болезненному.",
                        "zh": "心理上为做某件困难、不愉快或痛苦的事情做好准备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закалять",
                                "target_lang_sense_clarification": "характер, волю"
                            },
                            {
                                "target_lang_word": "собраться с духом",
                                "target_lang_sense_clarification": "фразеологизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼓起勇气",
                                "target_lang_sense_clarification": "动词短语"
                            },
                            {
                                "target_lang_word": "磨练",
                                "target_lang_sense_clarification": "动词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67fbde53-157e-3460-b1c5-ce4e3ddc3c30",
                    "sense_definition": "To cover, edge, or treat with steel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_coat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith <w>steeled</w> the tip of the spear to make it penetrate armor.",
                            "target_lang_translations": {
                                "ru": "Кузнец <w>оковал сталью</w> наконечник копья, чтобы оно могло пробивать броню.",
                                "zh": "铁匠给矛尖<w>包钢</w>，使其能够穿透盔甲。"
                            }
                        },
                        {
                            "text": "They decided to <w>steel</w> the machinery parts to increase their durability.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>усилить сталью</w> детали машин, чтобы увеличить их долговечность.",
                                "zh": "他们决定对机械零件进行<w>包钢</w>处理以增加耐用性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plate",
                        "reinforce"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать, окаймлять или обрабатывать сталью.",
                        "zh": "用钢覆盖、镶边或处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оковывать сталью",
                                "target_lang_sense_clarification": "укреплять металлом"
                            },
                            {
                                "target_lang_word": "наваривать сталь",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包钢",
                                "target_lang_sense_clarification": "工艺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dbe9bf26-37ff-32bd-a5e0-8f0f5f243a97",
                    "sense_definition": "A surname.",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We have a meeting scheduled with Mr. <w>Steel</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У нас запланирована встреча с мистером <w>Стилом</w> завтра утром.",
                                "zh": "我们明天早上安排了与<w>斯蒂尔</w>先生的会面。"
                            }
                        },
                        {
                            "text": "Danielle <w>Steel</w> is a very famous author of romance novels.",
                            "target_lang_translations": {
                                "ru": "Даниэла <w>Стил</w> — очень известная писательница любовных романов.",
                                "zh": "丹妮尔·<w>斯蒂尔</w>是一位非常著名的言情小说作家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стил",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯蒂尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}