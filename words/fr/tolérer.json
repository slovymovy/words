{
    "word_family": [
        "intolérable",
        "intolérance",
        "intolérant",
        "tolérable",
        "tolérance",
        "tolérant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf47aed5-b8bd-3046-9b12-f00c7f443f91",
                    "sense_definition": "Supporter ou accepter avec patience des attitudes, des comportements ou des personnes que l'on n'approuve pas pleinement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acceptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est important d'apprendre à <w>tolérer</w> les opinions différentes des nôtres."
                        },
                        {
                            "text": "Dans cette colocation, chacun doit apprendre à <w>tolérer</w> les défauts de ses camarades."
                        }
                    ],
                    "common_phrases": [
                        "tolérer la différence",
                        "tolérer les défauts"
                    ]
                },
                {
                    "sense_id": "311860a8-7e02-384d-9151-ee431e309e9f",
                    "sense_definition": "Ne pas interdire ou ne pas réprimer une pratique, une infraction ou un manquement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction de l'école ne <w>tolère</w> aucun retard sans motif valable."
                        },
                        {
                            "text": "Bien que ce stationnement soit interdit, les agents de police le <w>tolèrent</w> le dimanche matin."
                        }
                    ],
                    "common_phrases": [
                        "tolérer les écarts",
                        "pratique tolérée"
                    ]
                },
                {
                    "sense_id": "f3a784f7-c757-351f-ac59-60b1ca031c88",
                    "sense_definition": "Supporter physiquement ou biologiquement une douleur, un aliment, un produit ou un médicament.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son organisme fragile a beaucoup de peine à <w>tolérer</w> ce traitement puissant."
                        },
                        {
                            "text": "Le malade <w>tolère</w> très bien son nouveau régime alimentaire depuis plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "endurer"
                    ],
                    "common_phrases": [
                        "tolérer un traitement",
                        "tolérer la douleur"
                    ]
                }
            ]
        }
    ]
}