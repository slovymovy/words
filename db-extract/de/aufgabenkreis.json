                ],
                "senses": [
                    {
                        "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                        "entry_id": "a6dd9324-fa64-3aa2-8bbd-90b9cf5c58bd",
                        "glosses": [
                            "Gesamtheit der Aufgaben, für die jemand oder etwas zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f22c149-312b-4b61-91c9-61e6ef713bb6",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Die Zwangsinnung hat ihren Aufgabenkreis in der sachlichen Gestaltung der handwerksmäßigen Ausbildung erhalten und sie wird darin Gutes leisten können, insofern die rechten Männer die rechte Kraft an diesen wichtigen Aufgabenkreis wenden.“"
                            },
                            {
                                "example_id": "ec63658d-7ef1-49f2-a85b-0d1a3a7129e7",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Katrin Haußmann ist Fachanwältin für Arbeitsrecht und warnt davor, ohne Rücksprache den eigenen Aufgabenkreis zu erweitern.“"
                            },
                            {
                                "example_id": "70afc951-c49e-47c5-b3a3-1cb5801aa6bb",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Das Betreuungsrecht sieht bislang nur vor, dass ein Betreuer ‚geeignet‘ sein muss, ‚in dem gerichtlich bestimmten Aufgabenkreis die Angelegenheiten des Betreuten rechtlich zu besorgen und ihn in dem hierfür erforderlichen Umfang persönlich zu betreuen‘.“"
                            },
                            {
                                "example_id": "d7a9c7c2-fd48-4b29-b0a1-809f758f4a3b",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Ich habe mich auch am Hasenbergl in die verschiedenen Aufgabenkreise außerhalb der Kirche eingebracht, und das will ich auch in Dachau machen.“"
                            },
                            {
                                "example_id": "5a540d4a-c78a-4e75-a61e-85b1afa4bcc4",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Neben Wohnungsangelegenheiten können die Aufgabenkreise eines Betreuers Finanzen, Gesundheit, Aufenthaltsbestimmung und Postangelegenheiten umfassen.“"
                            },
                            {
                                "example_id": "2af42973-cc60-418e-8000-626fa7bffae6",
                                "sense_id": "bf143831-984b-3422-add1-71405d834b91",
                                "text": "„Es lag daher wohl im Aufgabenkreise des Oberbefehlshabers Ost, als dem verantwortlichen Verwalter des Gebietes, diesem Bedürfnis Rechnung zu tragen in dem Augenblicke, als er über Mittel dazu verfügte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
