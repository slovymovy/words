                "senses": [
                    {
                        "sense_id": "d70fb41a-10f5-3cc9-acb3-e7e010b43ea3",
                        "entry_id": "c56e407d-63e1-3982-806a-6fb71a4550c7",
                        "glosses": [
                            "A south-western English surname originating as an occupation; equivalent to Fuller."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6d038815-a1a9-32db-b2a9-6906f9829b37",
                        "entry_id": "c56e407d-63e1-3982-806a-6fb71a4550c7",
                        "glosses": [
                            "A male given name transferred from the surname, of modern usage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "814c1811-7ec8-468e-9a25-583bde4f83ef",
                                "sense_id": "6d038815-a1a9-32db-b2a9-6906f9829b37",
                                "text": "Jackson Sparks and his brother, Tucker, were both struck."
                            },
                            {
                                "example_id": "69edd5b8-5454-47df-889f-0e328f02663c",
                                "sense_id": "6d038815-a1a9-32db-b2a9-6906f9829b37",
                                "text": "Tucker Carlson (also a jacket and tie guy) picked up on the hoo-ha on his Fox News show, calling the hoodie-jacket combination a “cry for help” and inviting Roger Stone, the disgraced former political operative and author of his own “Best and Worst dressed List,” to comment."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4b801cb-0163-3a63-87b4-240d92279658",
                        "entry_id": "c56e407d-63e1-3982-806a-6fb71a4550c7",
                        "glosses": [
                            "A number of places in the United States:",
                            "An unincorporated community and census-designated place in Jefferson County, Arkansas."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bdd4180d-d392-39f3-a079-bd4496c21235",
                        "entry_id": "c56e407d-63e1-3982-806a-6fb71a4550c7",
                        "glosses": [
                            "A number of places in the United States:",
                            "A city in DeKalb County, Georgia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "531cf4ed-0793-4528-988d-b3e12b1bbcaf",
                                "sense_id": "bdd4180d-d392-39f3-a079-bd4496c21235",
                                "text": "In Tucker, another Atlanta suburb, an undocumented man attending church was arrested after ICE agents arrived, pastor Luis Ortiz told CNN. He said he was in the middle of his sermon when he noticed a couple of members of his church escort the man out."
                            }
                        ]
                    },
                    {
                        "sense_id": "08a3fc86-992e-311f-b695-9eb0b341c3cb",
                        "entry_id": "c56e407d-63e1-3982-806a-6fb71a4550c7",
                        "glosses": [
                            "A number of places in the United States:",
                            "A census-designated place in Neshoba County, Mississippi."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
