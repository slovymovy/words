                        "entry_id": "3b007964-d0db-3fb5-a08a-cdd7c839188c",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительным Аттика"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bcacc05-2674-4d30-bd33-bda8808efad6",
                                "sense_id": "b0d242c3-3d10-3b17-b0e0-4173ca8670a8",
                                "text": "Мимоходом мы уже говорили, что аттический тетробол по весу равен коринфской драхме."
                            },
                            {
                                "example_id": "dc7e6df4-651f-4215-87ef-f2b6d024f1f8",
                                "sense_id": "b0d242c3-3d10-3b17-b0e0-4173ca8670a8",
                                "text": "Аттический диалект."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e8876cc-8892-38bd-83e7-c750ac3f4c05",
                        "entry_id": "3b007964-d0db-3fb5-a08a-cdd7c839188c",
                        "glosses": [
                            "устар. изысканный, утончённый"
                        ],
                        "tags": [],
                        "examples": [
