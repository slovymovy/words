                        "entry_id": "c8e17fad-0cbd-34c1-98cd-4ae5935758bc",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "mikroskopowe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f193b4e0-975e-3e65-9971-5da4cafb5a01",
                        "entry_id": "c8e17fad-0cbd-34c1-98cd-4ae5935758bc",
