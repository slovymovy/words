                        "entry_id": "a1faec9d-6e14-3ab3-a2d6-608f9a09e3ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "friaries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "602b248d-be6a-3db4-9a17-8017f9f4ecf5",
                        "entry_id": "a1faec9d-6e14-3ab3-a2d6-608f9a09e3ed",
                        "glosses": [
                            "A house or convent where friars (members of certain religious communities) live."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d4cfc6-33e7-45ca-8423-3b14e0f73d93",
                                "sense_id": "602b248d-be6a-3db4-9a17-8017f9f4ecf5",
                                "text": "For this reason, Francis asked that part of the friary garden always be left untouched, so that wild flowers and herbs could grow there, and those who saw them could raise their minds to God, the Creator of such beauty."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a60500f0-aa98-41a5-8ad6-bec38dbb0373",
                        "source_entry_id": "a1faec9d-6e14-3ab3-a2d6-608f9a09e3ed",
                        "source_sense_id": "602b248d-be6a-3db4-9a17-8017f9f4ecf5",
                        "source_sense_description": "house or dwelling of friars",
                        "target_lang_word": "Kloster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kloster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                        "entry_id": "529a3fd4-0648-38fe-b4da-2b1c7feea62f",
                                        "glosses": [
                                            "Gebäude und eventuell weitere Bauwerke, in denen Menschen (meist Mönche oder Nonnen) in einer auf die Ausübung ihres Glaubens konzentrierten Lebensweise abgeschieden zusammenleben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d0d453-c0f8-465b-8405-969d74b11357",
                                                "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                                "text": "Im frühen Mittelalter waren Klöster die Bewahrer der Kultur und Zentren der Bildung."
                                            },
                                            {
                                                "example_id": "4f515e33-234b-4d1e-842e-d6b9494bee91",
                                                "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                                "text": "„Die Richter von Northumbria haben das Kloster großzügig mit Ländereien beschenkt, die Kirche schmücken wertvolle Kreuze und Messgefäße.“"
                                            },
                                            {
                                                "example_id": "a71af1dd-65cb-4dde-bbe7-b3287a67e514",
                                                "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                                "text": "„Klöster und Private unterstützten den bettelnden Landstreicher.“"
                                            },
                                            {
                                                "example_id": "49d02e95-173d-4962-9bf2-d488b944e6ab",
                                                "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                                "text": "„Um nicht jeden Tag den Weg vom Kloster bis zu den Weinbergen zurückzulegen, richteten sich die Donaten, die für das Kloster tätigen Arbeiter, vor Ort häuslich ein.“"
                                            },
                                            {
                                                "example_id": "5b139a2b-00e9-43a5-812c-e02f5ecabc4e",
                                                "sense_id": "fd3c869f-7784-32a9-8e39-c4b285c55612",
                                                "text": "„Am Kloster begrüßt uns Mönch Habte-Giyorgis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kloster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                        "entry_id": "d1e4dd64-91ea-338f-965f-30ddea8ff57a",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b847d27-6125-4afd-91ef-4d1a0353868c",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Frau Kloster ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b4f32cbe-adcf-40d2-a470-ea2622c5e616",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Herr Kloster wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "9f6032eb-9b90-471f-8192-593677cdf730",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Die Klosters fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "0591608b-9fda-4c6c-9d48-48fcbf369c65",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Der Kloster trägt nie die Schals, die die Kloster ihm strickt."
                                            },
                                            {
                                                "example_id": "8b79e106-8ab3-49ee-bdfb-e2bcfb2d34e8",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kloster kommt, geht der Herr Kloster.“"
                                            },
                                            {
                                                "example_id": "55e325a9-bfa7-4304-9d68-01c74c0a9ff9",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Kloster kommt und geht."
                                            },
                                            {
                                                "example_id": "8a57ae7d-8c45-4ba1-9de0-dc8cde9e9d5e",
                                                "sense_id": "961b44a4-0995-3aa9-abfc-1aee97749647",
                                                "text": "Klosters kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
