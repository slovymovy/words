                        "sense_id": "f6f95f3b-e763-3d55-a4d8-2d6e3e576d1a",
                        "entry_id": "049aa1cc-f259-34f0-8918-f5e7ee58d523",
                        "glosses": [
                            "zu einer Art Knoten angeordnetes Haar am Hinterkopf, das mit Hilfsmitteln wie Haarnadeln, Haarnetz oder Ähnlichem in Form gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df22f21c-abb5-4028-bfcd-772b1d1568d8",
                                "sense_id": "f6f95f3b-e763-3d55-a4d8-2d6e3e576d1a",
                                "text": "„Ihre Gastgeberin machte sich an einer Locke grauer Haare zu schaffen, die sich aus ihrem unordentlichen Chignon gelöst hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
