                        "source_sense_id": "c36f6830-92df-3e6b-85b6-38b63fb08edb",
                        "source_sense_description": "die Kardinalzahl zwischen 99.999 und 100.001",
                        "target_lang_word": "cent mille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
