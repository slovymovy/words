                                        "entry_id": "97aa3793-b742-388d-9e95-88f49734e558",
                                        "glosses": [
                                            "Property of being insincere, lacking sincerity or truthfulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5debaabe-be17-45bf-95e3-9912a229730a",
                                                "sense_id": "0f4542a0-c5a2-3c65-9075-e39a864bcbb9",
                                                "text": "His insincerity was obvious to all; he was neither honest nor believable."
                                            }
