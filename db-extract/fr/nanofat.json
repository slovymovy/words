        "fr-extract.jsonl": [
            {
                "entry_id": "1c131b7c-cb79-3067-8fc3-c2f920427a7d",
                "word": "nanofat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea6ef722-b4da-3b0c-91d6-79cc6af4fabf",
                        "entry_id": "1c131b7c-cb79-3067-8fc3-c2f920427a7d",
                        "glosses": [
                            "Graisse provenant d’une personne et destinée à être injectée après traitement à cette même personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78dd6f4-a71b-4e64-9147-b9a35a5fb811",
                                "sense_id": "ea6ef722-b4da-3b0c-91d6-79cc6af4fabf",
                                "text": "Le Nanofat est une émulsion fluide (pour permettre l’injection cutanée) élaborée à base de graisse en provenance du corps même de la patiente."
                            },
                            {
                                "example_id": "e6eaf01e-a077-4fac-b932-7cb41ee5e2b3",
                                "sense_id": "ea6ef722-b4da-3b0c-91d6-79cc6af4fabf",
                                "text": "Grace aux techniques modernes et mini invasives de chirurgie esthétique de prélèvement de la graisse et surtout grace aux nouvelles techniques de purification, il va être possible de microcentrifuger et nanofiltrer la graisse pour ne garder que la précieuse nanofat composée des ADSC (Adipose Derived Stem Cells), graisse beaucoup plus pure et de meilleure qualité."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d5662f9-5f9f-3788-912e-b63d97344de4",
                        "entry_id": "1c131b7c-cb79-3067-8fc3-c2f920427a7d",
                        "glosses": [
                            "Technique utilisant l’injection de cette graisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d4e015-7033-4ba1-9c4d-401128f47d4a",
                                "sense_id": "7d5662f9-5f9f-3788-912e-b63d97344de4",
                                "text": "Le nanofat est une technique de micro-lipofilling qui consiste à utiliser notre propre graisse afin de la réinjecter dans le but de donner du volume ou de rajeunir l'aspect de votre peau."
                            },
                            {
                                "example_id": "cb923ff7-0ab3-4257-8087-13924f5569a5",
                                "sense_id": "7d5662f9-5f9f-3788-912e-b63d97344de4",
                                "text": "Le nanofat est une technologie de transfert graisseux qui permet une induction tissulaire dans la zone d'injection."
                            },
                            {
                                "example_id": "d8787faa-17f2-4d6f-b7c4-a2a103e3b789",
                                "sense_id": "7d5662f9-5f9f-3788-912e-b63d97344de4",
                                "text": "Le nanofat est une technique médico-chirurgicale de thérapie cellulaire."
                            },
                            {
                                "example_id": "2a1f2172-4b59-4526-ad93-b7bede923d05",
                                "sense_id": "7d5662f9-5f9f-3788-912e-b63d97344de4",
                                "text": "La nanofat répare la peau, estompe une cicatrice, lisse une ridule, mais ne comble pas les rides profondes, c’est pourquoi cette technique peut être associée à une injection complémentaire de microfat ou d’acide hyaluronique, par exemple."
                            }
                        ]
                    }
