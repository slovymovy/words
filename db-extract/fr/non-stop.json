                        "sense_id": "c625ad68-460a-3914-97c3-d9897d52118b",
                        "entry_id": "1370f303-c598-3693-8d38-6fe52a09b041",
                        "glosses": [
                            "Sans arrêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e776aa80-a096-4d5e-85d5-b2b7ec59b6d6",
                                "sense_id": "c625ad68-460a-3914-97c3-d9897d52118b",
                                "text": "Ils feraient du surf, des grillades, la chouille non-stop."
                            },
                            {
                                "example_id": "aa6f1e10-9051-40e6-975f-94dda693a1f7",
                                "sense_id": "c625ad68-460a-3914-97c3-d9897d52118b",
                                "text": "Samedi et dimanche, le moto-club va proposer, sur les hauteurs de la commune à Gorrébloué, une mythique course d’endurance tout terrain de 24 heures non-stop."
                            },
                            {
                                "example_id": "5998558d-e7c0-4ce1-8169-554c57ed4748",
                                "sense_id": "c625ad68-460a-3914-97c3-d9897d52118b",
                                "text": "Un billet pour un vol non-stop correspond, lui, à une liaison qui sera effectuée sans aucun arrêt."
                            },
                            {
                                "example_id": "404bea41-d6b6-4442-8d3b-b0c62d435a19",
                                "sense_id": "c625ad68-460a-3914-97c3-d9897d52118b",
                                "text": "En voyage non-stop depuis 7 ans 137 jours 21 heures 48 minutes 16 secondes."
                            }
                        ]
                    }
                ],
