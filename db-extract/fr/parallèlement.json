                                                "sense_id": "a3ed7314-2427-36d0-97cc-b571dbaeaa9b",
                                                "text": "Near-synonyms: synchronous (adjective), synchronously (adverb), simultaneously (adverb)"
                                            },
                                            {
                                                "example_id": "63a83c22-581f-4ed6-a98e-1edef2989db3",
                                                "sense_id": "a3ed7314-2427-36d0-97cc-b571dbaeaa9b",
                                                "text": "Translations to all five languages were done in parallel."
                                            }
