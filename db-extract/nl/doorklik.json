                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "But know that God is the strongest link."
                                            },
                                            {
                                                "example_id": "11e4d637-5a88-4d73-916b-8270c38aa2ad",
                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "The fuse is the weakest link in the system. As such, the fuse is also the most valuable link in the system."
                                            },
                                            {
                                                "example_id": "7bf5c50e-0a0e-47c9-b5f2-e0ba12cd01e7",
                                                "sense_id": "d2828297-88e1-3834-a9ba-87ed780a5eed",
                                                "text": "“[…] This is so that nobody can change the way every link must talk about the formula that I taught to make a real Chain of Universal Love and not a Chain of Love of a group or sect.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3215a7f9-52fd-3ddf-998a-37d10088fd19",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
