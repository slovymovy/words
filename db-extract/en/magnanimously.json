                ],
                "translations": [
                    {
                        "translation_id": "067b9d2c-70c7-43b4-a371-517c938018b4",
                        "source_entry_id": "d585ed5c-4218-3e12-8d14-91f7bc89ea8f",
                        "source_sense_id": "07b8573a-7cbd-3f23-8934-4fed455b5ebf",
                        "source_sense_description": "großzügig, großmütig, edel",
                        "target_lang_word": "großzügig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "großzügig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8925b4aa-7246-32fc-a545-f4753e1a32da",
                                        "entry_id": "dca7a326-838d-3de4-b0f1-d7bbaf434b1f",
                                        "glosses": [
                                            "von dem, was man besitzt, gern und viel anderen gebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39e8336-8c5f-44dd-ac86-ae4a23895ec9",
                                                "sense_id": "8925b4aa-7246-32fc-a545-f4753e1a32da",
                                                "text": "Du bist ja sehr großzügig mit dem Trinkgeld."
                                            },
                                            {
                                                "example_id": "ea8ddcd1-e713-4ca3-b72f-4fc2c079fd46",
                                                "sense_id": "8925b4aa-7246-32fc-a545-f4753e1a32da",
                                                "text": "„Selbst in den Bundesländern wird inzwischen indirekt eingeräumt, dass die Bahn in der Vergangenheit großzügig bedacht wurde.“"
                                            },
                                            {
                                                "example_id": "2c4c9f2a-dbe7-4650-919c-99308a8f7526",
                                                "sense_id": "8925b4aa-7246-32fc-a545-f4753e1a32da",
                                                "text": "„Nero bot den beiden dann großzügig das römische Bürgerrecht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02d916a1-096b-3e41-a838-9847be8c260d",
                                        "entry_id": "dca7a326-838d-3de4-b0f1-d7bbaf434b1f",
                                        "glosses": [
                                            "etwas nicht zu genau nehmend, viel Spielraum lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485a3a0b-30c6-404f-9a0a-84b3a810b713",
                                                "sense_id": "02d916a1-096b-3e41-a838-9847be8c260d",
                                                "text": "Die Vorschriften werden hier sehr großzügig gehandhabt."
                                            },
                                            {
                                                "example_id": "713773f5-7288-485f-8ea1-09fd25fe19f6",
                                                "sense_id": "02d916a1-096b-3e41-a838-9847be8c260d",
                                                "text": "„Volk und Welt hatte seine emphatisch gepriesenen Autoren nach Strich und Faden um ihr Honorar betrogen. Rolf Hochhuth sah großzügig darüber hinweg und hielt dem Verlag bis zum Untergang die Treue […].“"
                                            },
                                            {
                                                "example_id": "066e9853-d41d-4878-a165-48cc0e7625a3",
                                                "sense_id": "02d916a1-096b-3e41-a838-9847be8c260d",
                                                "text": "„Wenn sie dieses Foto fänden, wäre es für alle Welt ersichtlich, dass die Geschichte des Motorfluges, großzügig betrachtet, im fränkischen Leutershausen ihren Anfang nahm und nicht auf einer Sanddühne in North Carolina.“"
                                            },
                                            {
                                                "example_id": "18e36695-ad93-446e-9778-f35126cb99f5",
                                                "sense_id": "02d916a1-096b-3e41-a838-9847be8c260d",
                                                "text": "„Und gerade durch die großzügige Fassung jeder rechten Weissagung wird das sehr erleichtert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3a3665a-ed53-3e0a-878a-9ad6472754ec",
                                        "entry_id": "dca7a326-838d-3de4-b0f1-d7bbaf434b1f",
                                        "glosses": [
                                            "weiträumig, groß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8e65a5-bae0-40ce-9165-2ca494b2a45b",
                                                "sense_id": "c3a3665a-ed53-3e0a-878a-9ad6472754ec",
                                                "text": "„Großzügiger Garten mit Blick zum See.“"
                                            },
                                            {
                                                "example_id": "1d3efed2-5f9e-418f-b992-a16849c4a39b",
                                                "sense_id": "c3a3665a-ed53-3e0a-878a-9ad6472754ec",
                                                "text": "„Grosszügige Wohnung am Klosterplatz mit Aussicht.“"
                                            },
                                            {
                                                "example_id": "4d2d1827-8885-4b7d-b310-dab37fe7ed1b",
                                                "sense_id": "c3a3665a-ed53-3e0a-878a-9ad6472754ec",
                                                "text": "„Die reichen Weißen in den Villen an der Esplanade ließen auf der gegenüberliegenden Seite großzügige Häuser für ihre schwarzen und halbblütigen Mätressen errichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
