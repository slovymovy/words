                "senses": [
                    {
                        "sense_id": "22b22b06-99e6-3418-89f3-feb397c011dd",
                        "entry_id": "d2d2c608-5ad3-340f-b01c-14ced3667a6c",
                        "glosses": [
                            "Krieg, der geführt wird, um die Herrschaft in einer Kolonie zu gewinnen oder zu erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4898e6c3-51f7-4563-82d2-f7bdf64299bd",
                                "sense_id": "22b22b06-99e6-3418-89f3-feb397c011dd",
                                "text": "„Der Reichtum kam zum Teil noch immer aus den Kolonien, zum Beispiel von den Gummiplantagen in Malaysia, weshalb die Engländer dort drauf und dran waren, einen neuen Kolonialkrieg gegen die nationalistischen Aufständischen zu führen.“"
                            },
                            {
                                "example_id": "5687a754-04cb-4aa1-8ae0-de0e8d75a5a6",
                                "sense_id": "22b22b06-99e6-3418-89f3-feb397c011dd",
                                "text": "„Frankreich schleppte sich während des ganzen Vietnam-, später Algerienkrieges von einer Regierungskrise zur anderen, mußte mit Inflation, Währungsreform und innerer Demoralisierung für seine Kolonialkriege zahlen, mit dem Sturz der IV. Republik und Umsturzversuchen der rechtsextremen OAS gegen die V. Republik, bis de Gaulle Algerien im Vertrag von Evian freigab (1962).“"
                            },
                            {
                                "example_id": "9dd01a7d-57a3-4fa0-9c3a-b1a3806822bb",
                                "sense_id": "22b22b06-99e6-3418-89f3-feb397c011dd",
                                "text": "„Wegen des Kolonialkriegs geriet Frankreich an den Rand eines Bürgerkriegs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
