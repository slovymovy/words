                        "examples": [
                            {
                                "example_id": "340de3af-614d-4287-ae1c-ee72b8c042d6",
                                "sense_id": "c5d2d8a9-18a5-3576-8faa-e331e5b0c3f5",
                                "text": "„Als Dank dafür nimmt ihn Frankreich in die Ehrenlegion auf.“"
                            },
                            {
                                "example_id": "dccb4815-e6d8-4ba5-b74f-a458c686735d",
                                "sense_id": "c5d2d8a9-18a5-3576-8faa-e331e5b0c3f5",
                                "text": "„Die roten Bändchen, die an die Ehrenlegion erinnerten, waren auch eine Art Ordensband, des Ordens der Ehrenlegion der amerikanischen Transitäre.“"
                            },
                            {
                                "example_id": "df3711d8-218b-4959-af23-f172fc93f48a",
                                "sense_id": "c5d2d8a9-18a5-3576-8faa-e331e5b0c3f5",
                                "text": "„Endlich befreite sie ein Herr, der das Kreuz der Ehrenlegion trug; und nachdem sie ihre Namen, Vornamen und Wohnort angegeben hatten, zogen sie ab mit dem Versprechen, in Zukunft vorsichtiger zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
