                        "examples": [
                            {
                                "example_id": "f18c1d2a-52c5-44a1-b417-8a79deaf3734",
                                "sense_id": "51869444-8fb1-3a6a-af15-e666afef8df9",
                                "text": "Не в осуд слово говорится, а спроста молвится!"
                            },
                            {
                                "example_id": "c4f59d18-c00d-496b-94a2-eb43b0669ac4",
                                "sense_id": "51869444-8fb1-3a6a-af15-e666afef8df9",
                                "text": "У девушки-то золотом уши завешены, недаром пословица молвится."
                            },
                            {
                                "example_id": "3e3741b2-a5ea-4c4d-886f-a725b4e545f2",
                                "sense_id": "51869444-8fb1-3a6a-af15-e666afef8df9",
                                "text": "Не зря молвится: сердце сердцу весть подаёт."
                            }
                        ]
                    }
