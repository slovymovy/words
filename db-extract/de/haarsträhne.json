                    {
                        "form_id": "56e51b23-85b4-4c74-8837-da9b8501bb56",
                        "entry_id": "80c7683c-7da8-3aba-ac15-b0b5917f702c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Haarsträhnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c3ca86c-8e1d-3071-ab30-d801d022fc67",
                        "entry_id": "80c7683c-7da8-3aba-ac15-b0b5917f702c",
                        "glosses": [
                            "Streifen kompakt liegender oder hängender Haare"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d3ebe1-6988-4e24-aa09-29c953ab5e6a",
                                "sense_id": "1c3ca86c-8e1d-3071-ab30-d801d022fc67",
                                "text": "„Seine Brust war dunkelrot verfärbt und über und über mit blutverfilzten Haarsträhnen überzogen.“"
                            },
                            {
                                "example_id": "0dc48835-d31d-4847-94c8-248e09d85f50",
                                "sense_id": "1c3ca86c-8e1d-3071-ab30-d801d022fc67",
                                "text": "„Das Telefon hat sie bestimmt zwischen Ohr und Schulter geklemmt und ab und zu pustet sie, weil sie nasse Hände hat, eine Haarsträhne, die ihr ins Gesicht fällt, beiseite, damit sie ihr beim Sprechen nicht in den Mund rutscht.“"
                            },
                            {
                                "example_id": "32d3d3e3-cede-4584-813e-6d744f80febe",
                                "sense_id": "1c3ca86c-8e1d-3071-ab30-d801d022fc67",
                                "text": "„Sie schob sich eine Haarsträhne aus der Stirn, konnte, nein, wollte sich nicht mehr zurückhalten und fragte die Mama rundheraus, was der Papa wohl gemeint haben könnte: Sie müssten der Pepina dankbar sein?“"
                            },
                            {
                                "example_id": "46b97673-dad4-4ef2-a1b0-81201ec68f03",
                                "sense_id": "1c3ca86c-8e1d-3071-ab30-d801d022fc67",
                                "text": "„Sie konzentriert sich, sie zieht mir das Tuch tiefer ins Gesicht, klemmt eine Haarsträhne hinter mein Ohr, lockert den Knoten am Hals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
