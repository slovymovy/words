                "senses": [
                    {
                        "sense_id": "809d606e-040e-3773-b934-731dfd86a7a6",
                        "entry_id": "0455e7bb-93ab-3a3c-87f6-7ddbedb8fd2e",
                        "glosses": [
                            "Gelenk, das Oberschenkel und Unterschenkel miteinander verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a42500b-3ca6-450e-bc4b-ee13138a90df",
                                "sense_id": "809d606e-040e-3773-b934-731dfd86a7a6",
                                "text": "„Bei einem Großteil der Menschen fortgeschrittenen Alters etablieren sich Probleme mit dem Kniegelenk.“"
                            },
                            {
                                "example_id": "73824e1c-9002-4612-a4de-379d4d3b07d4",
                                "sense_id": "809d606e-040e-3773-b934-731dfd86a7a6",
                                "text": "„So bekommen in Österreich jährlich 17.000 Menschen ein neues Kniegelenk.“"
                            },
                            {
                                "example_id": "6ecd2f3e-9232-47f7-ab10-f35ec3aab192",
                                "sense_id": "809d606e-040e-3773-b934-731dfd86a7a6",
                                "text": "„Die haben vorgesorgt: Auf der Brücke haben die Schlauköpfe sogar eine Art Trampolin zum Draufstehen, damit es ihnen die Kniegelenke nicht kaputthaut, wenn sie eine Mine fangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
