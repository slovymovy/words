                                    },
                                    {
                                        "sense_id": "36ce4923-d665-39d6-8ffb-34fa959a5199",
                                        "entry_id": "0078bcbc-1c71-3c98-8b11-bd5c26467c7d",
                                        "glosses": [
                                            "A pale yellow brown as of dried flax; blonde."
                                        ],
                                        "tags": [
                                            "of hair"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1cd83b-8ba8-4acc-aa6b-11a092496fac",
                                                "sense_id": "36ce4923-d665-39d6-8ffb-34fa959a5199",
                                                "text": "The couple and their children have flaxen hair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "444df415-2bcd-4d4e-ad7f-de2ad232f039",
                        "source_entry_id": "63c2db94-2519-337e-830f-ed0839e99e10",
                        "source_sense_id": "3b9111c0-6812-3abe-b853-eb4e2f2ffaf4",
                        "source_sense_description": "een lichtgele, lichtblonde kleur zoals die van rijp vlas",
                        "target_lang_word": "filasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "749db8b0-4f8f-3e06-9a3d-0e6620264040",
                                        "entry_id": "8e5a2f06-14a0-3186-94ac-ad0f0e2065a3",
                                        "glosses": [
                                            "Assemblage, amas de filaments tirés de l’écorce du chanvre, de celle du lin, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7400f7cd-249b-4875-a650-4d10ee322520",
                                                "sense_id": "749db8b0-4f8f-3e06-9a3d-0e6620264040",
                                                "text": "Sur un hectare, on obtient environ 600 à 900 kilog. de filasse de chanvre, quand on cultive la grande variété, […]. Le petit chanvre produit 250 kilog. de filasse dont la valeur est plus élevée que celle du grand chanvre […]. Le produit d'un hectare planté en lin est d'environ 450 kilog. de filasse et 5 à 6 hectolitres de graines."
                                            },
                                            {
                                                "example_id": "5bb9da40-eae0-42c3-b435-a640e6073111",
                                                "sense_id": "749db8b0-4f8f-3e06-9a3d-0e6620264040",
                                                "text": "J’avais les cheveux encore plus couleur de filasse que maintenant."
                                            },
                                            {
                                                "example_id": "717b2eeb-15d1-4003-ad47-57ad3bc45038",
                                                "sense_id": "749db8b0-4f8f-3e06-9a3d-0e6620264040",
                                                "text": "Avant de tresser les roseaux, il fallait qu’ils subissent une préparation qui, en écrasant leurs fibres, les transformerait en grosse filasse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "filasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89d54b84-3cfe-3972-98ff-ff45b5b03e64",
                                        "entry_id": "820bd3cd-f59e-3536-8225-6029afcd9bb3",
                                        "glosses": [
                                            "Qualifie des cheveux qui ressemblent à de la filasse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a35ed9dc-5f2c-4fa1-9e0f-b5b8a4ca64dd",
                                                "sense_id": "89d54b84-3cfe-3972-98ff-ff45b5b03e64",
                                                "text": "Ses petits cheveux filasse, frisottants, hérissés autour du front, lui donnait un aspect farouche de méduse domestique […]."
                                            },
                                            {
                                                "example_id": "4bf133a2-cac8-42a4-a1b6-2fba4c39e854",
                                                "sense_id": "89d54b84-3cfe-3972-98ff-ff45b5b03e64",
                                                "text": "Et Maigret allumait sa pipe, regardait la porte s’ouvrir, un jeune homme entrer, vêtu de loques, les cheveux filasse, les yeux chassieux."
                                            },
                                            {
                                                "example_id": "d4862a43-5247-44fe-94f3-3590ac8f5526",
                                                "sense_id": "89d54b84-3cfe-3972-98ff-ff45b5b03e64",
                                                "text": "Perrine pense au chocolat chaud qu’ils vont faire chauffer sur la vieille cuisinière, le même chocolat exactement que prépare Madie quand ils rentrent de l’école ou d’avoir aidé Pata au jardin sous la pluie, finissant leur route ou leur tâche trempés comme des soupes et les cheveux filasse plaqués sur le crâne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "filasse",
                                "target_lang_code": "fr",
                                "target_senses": [
