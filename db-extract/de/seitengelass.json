                "senses": [
                    {
                        "sense_id": "63d5b025-0558-3fe4-b980-a076873fb2d1",
                        "entry_id": "06294bb6-f97a-3aea-9c5d-1fe22b34ddfe",
                        "glosses": [
                            "Raum seitlich einer Wohn- oder Gewerbeeinheit, eines Hauses oder eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeaf9620-2616-4acd-9215-6e96ede0567a",
                                "sense_id": "63d5b025-0558-3fe4-b980-a076873fb2d1",
                                "text": "„In einem Seitengelasse findet er die kleine Bibliothek der Kirche.“"
                            },
                            {
                                "example_id": "5ac15820-52f7-4a03-8b1e-f4059c762d19",
                                "sense_id": "63d5b025-0558-3fe4-b980-a076873fb2d1",
                                "text": "„Er hatte eine bemalte Büste des jungen Pharao ohne Registriernummer in einem Seitengelass verschwinden lassen.“"
                            },
                            {
                                "example_id": "e7f9a0c1-f6c0-4991-8b44-ff0800693917",
                                "sense_id": "63d5b025-0558-3fe4-b980-a076873fb2d1",
                                "text": "„Ein paar Wochen lang war er keine Stunde des Tages allein gewesen – der Augiasstall, den sein Vorgänger ihm hinterlassen, hatte zu viele Seitengelasse und Nischen, die zu reinigen waren.“"
                            },
                            {
                                "example_id": "14b20526-2504-4173-aa29-fe4cca3741bb",
                                "sense_id": "63d5b025-0558-3fe4-b980-a076873fb2d1",
                                "text": "„Zwei Pförtchen führten in zwei Seitengelasse. Das eine zeigte sich verschlossen. Das andere öffnend, stand ich in einer durch ein von Spinneweb getrübtes Rundfenster dürftig erhellten Kammer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
