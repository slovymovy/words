                "senses": [
                    {
                        "sense_id": "464e57af-63e5-31e7-9792-142170de70b7",
                        "entry_id": "6e2a1f55-a153-385b-8fc5-1985d89e9bbc",
                        "glosses": [
                            "Variante orthographique (plus rare) de relatiniser (redonner un caractère latin à)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56106da5-8568-47e5-a107-0bb89737eb02",
                                "sense_id": "464e57af-63e5-31e7-9792-142170de70b7",
                                "text": "Il fallait l’extirper, l’effacer, la détruire dans la mémoire collective et dans les pratiques juridiques pour re-latiniser les Berbères tout prédisposés à quitter la « maison de l'islam »."
                            },
                            {
                                "example_id": "798e705b-4c1f-4888-baa9-61ced14dc0c1",
                                "sense_id": "464e57af-63e5-31e7-9792-142170de70b7",
                                "text": "Il doit s'associer avec FIAT qui est latin, a une gamme essence étendue et pas d'hybride, un haut de gamme Lancia a fortifier et à \"re-latiniser\", et s'associer aussi avec des artisans susceptibles d'améliorer les performance et/ou apparence de leurs véhicules et donc de les rendre plus attractifs et commercialisés dans son réseau."
                            },
                            {
                                "example_id": "7fbc6c9f-976c-4c47-8c32-ec588c59ba1a",
                                "sense_id": "464e57af-63e5-31e7-9792-142170de70b7",
                                "text": "Les notaires médiévaux ont dû vaguement re-latiniser ce nom en Bergesio."
                            },
                            {
                                "example_id": "a2d08074-a04a-490c-af73-9386f7427a85",
                                "sense_id": "464e57af-63e5-31e7-9792-142170de70b7",
                                "text": "Quand un Djeunz entend parler de \"nitrate-fioul\", il devient bon en français : pourquoi ne pas re-latiniser la nomenclature chimique ?"
                            }
                        ]
                    }
