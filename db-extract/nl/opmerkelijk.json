                "senses": [
                    {
                        "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                        "entry_id": "b52eb207-2485-3069-a504-d0fbb6c473ce",
                        "glosses": [
                            "bijzonder genoeg om opgemerkt te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d108c99-9143-442a-9124-69a1ac7780fe",
                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                "text": "Is dat echt zoiets opmerkelijks?"
                            },
                            {
                                "example_id": "b6095f45-4d2b-43d3-970c-a10bdddf0860",
                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                "text": "Bijna vijftig jaar later zijn er opmerkelijk veel mensen die dat gevoel van toen willen beleven en als urban hippies naar muziekfestivals gaan."
                            },
                            {
                                "example_id": "6b1a4cbd-7dc6-4fa5-8c1d-eb006e94804e",
                                "sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                                "text": "Na het eten had ze een opmerkelijke gewoonte om een Snicker naast haar hoofd te leggen voor als ze in de nacht een vreetkick kreeg vanwege haar joint."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "030a9e7b-2eba-494c-bc83-0063e365460e",
                        "source_entry_id": "b52eb207-2485-3069-a504-d0fbb6c473ce",
                        "source_sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                        "source_sense_description": "bijzonder genoeg om opgemerkt te worden",
                        "target_lang_word": "bemerkenswert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bemerkenswert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                        "entry_id": "0d36f4ef-8248-3c68-b6be-20b181ba95c0",
                                        "glosses": [
                                            "Aufmerksamkeit verdienend; so beschaffen, dass es bemerkt werden sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae41f0ca-9191-4435-ad3e-ef351447a668",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Auf der Tagung wurde ein bemerkenswerter Vortrag gehalten."
                                            },
                                            {
                                                "example_id": "9018703d-8a7e-4d28-ab5a-fffc7c683747",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Ein bemerkenswerte Änderung in ihrer Strategie zur Versorgung der Internationalen Raumstation ISS deutete der neue Chef Michael Griffin am 21. Juni 2005 bei einem Sponsor-Frühstück bei der „Space Transportation Association“ mit Sitz in Maryland an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37920cf6-b00e-4c1b-b703-0093f65b17bf",
                        "source_entry_id": "b52eb207-2485-3069-a504-d0fbb6c473ce",
                        "source_sense_id": "4328d7c4-0476-3b20-b071-5dcac286040a",
                        "source_sense_description": "bijzonder genoeg om opgemerkt te worden",
                        "target_lang_word": "remarquable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remarquable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                        "entry_id": "a1abd2f2-3d5e-3ec6-84c7-eccff4e5f95d",
                                        "glosses": [
                                            "Qui mérite d’être remarqué ; qui attire l’attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bad1ae3-8e3c-400c-b10a-1598e045805f",
                                                "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                                "text": "Quant au lysol, nous avons déjà noté, à plusieurs reprises, ses remarquables propriétés insecticides, en particulier dans nos études sur l’acariose."
                                            },
                                            {
                                                "example_id": "73cb9a09-a4cc-41e2-a83a-3802b751d779",
                                                "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                                "text": "Mais pour le garder auprès de lui, il déploie sa maîtrise romanesque ultraconvaincante : par sa sobriété remarquable, par son sens souvent hilarant du micro-détail, il offre une belle densité à ses personnages."
                                            },
                                            {
                                                "example_id": "7cb5ff14-226f-4c17-833c-ed3b4c98e783",
                                                "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                                "text": "Les glaces de la mer Blanche n’avaient que peu de rapports avec celles de la banquise, et les cargos étaient précédés et convoyés par de remarquables « brise-glaces »."
                                            },
                                            {
                                                "example_id": "4457d62b-99db-447c-bcfc-133720ba75aa",
                                                "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                                "text": "En dépit du morcellement législatif des coutumes, nous avons une unité remarquable de législation en cette matière, car c’est l’Église qui seule légifère et juge."
                                            },
                                            {
                                                "example_id": "fc1fa8c7-31fb-42a3-ab37-0f0625566ebf",
                                                "sense_id": "02355c90-61df-3b32-afc4-16bea428a2dc",
                                                "text": "La fonction exponentielle possède la propriété remarquable d’être égale à sa dérivée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
