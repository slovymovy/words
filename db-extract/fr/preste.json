                                                "sense_id": "3501df70-68f6-3d3f-afff-fb5bbfd6e5b8",
                                                "text": "Hij was niet de vlugste deelnemer en daardoor verloor hij."
                                            },
                                            {
                                                "example_id": "dd6a03ba-be85-49b1-9f0d-eaabb9fc51b0",
                                                "sense_id": "3501df70-68f6-3d3f-afff-fb5bbfd6e5b8",
                                                "text": "Pietje werd er wakker van en liep vlug naar het rillende dier toe."
                                            },
                                            {
                                                "example_id": "b5608962-57eb-4f99-b570-569fb1e1548b",
                                                "sense_id": "3501df70-68f6-3d3f-afff-fb5bbfd6e5b8",
                                                "text": "Misschien vraagt hij wel waarom we de partij zo vlug willen verkopen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vlug",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb86b78-5ee5-3172-b62a-da5b4f886e21",
                                        "entry_id": "ba664857-82e2-3c00-838f-8b7b183b05c8",
