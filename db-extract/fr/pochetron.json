                        "sense_id": "1d85db92-dc23-33d6-a3c4-1229e9e995c0",
                        "entry_id": "734bfcab-f237-3d7a-b33f-9f2d2b070196",
                        "glosses": [
                            "Personne adonnée aux boissons alcoolisées."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7be2dd0b-9a86-4d43-bacd-7eae60971b88",
                                "sense_id": "1d85db92-dc23-33d6-a3c4-1229e9e995c0",
                                "text": "[…], je vénère Faulkner et je ne peux oublier qu'en vérité c'est un pochetron, un pochetron honteux qui se cachait sous des façons collet monté."
                            },
                            {
                                "example_id": "4d011c5f-c14b-41ad-ac14-2071bfb4fb0c",
                                "sense_id": "1d85db92-dc23-33d6-a3c4-1229e9e995c0",
                                "text": "Et à minuit, le père Noël va se pointer pour distribuer des bonis !\nPayés à même les poches des joueurs chroniques, des gaspilleurs d’électricité et des pochetrons !"
                            }
                        ]
                    }
