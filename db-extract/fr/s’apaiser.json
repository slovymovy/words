                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4c9969-b328-415c-9a23-9131868a659e",
                                                "sense_id": "c887f3a8-6153-3684-b006-fd7d17d84fd7",
                                                "text": "Eindelijk bedaarde de vreselijke storm en kon het reddingswerk beginnen."
                                            },
                                            {
                                                "example_id": "feb4a8ba-a28c-489d-b7b3-3431d7c06cb6",
                                                "sense_id": "c887f3a8-6153-3684-b006-fd7d17d84fd7",
                                                "text": "Langzaam voelde ik mijn hart weer tot bedaren komen."
                                            },
                                            {
                                                "example_id": "ca31ae5b-63da-45e7-bc35-edc766c77e6c",
                                                "sense_id": "c887f3a8-6153-3684-b006-fd7d17d84fd7",
                                                "text": "Was hun koning, Willem de Veroveraar, niet tijdens een geweldige storm, dankzij de heilige Nicolaas, veilig van Normandië naar Engeland gevaren? Want Nicolaas was in staat de wind en de onstuimige kracht der golven te doen bedaren!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40019bc6-4234-34a9-a706-19d2d9446270",
                                        "entry_id": "2ad69cb1-fe86-3c06-8ba0-a7f74766296c",
                                        "glosses": [
                                            "kalm maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe20fa0-c0c2-49db-9c46-30a14ad17dd9",
                                                "sense_id": "40019bc6-4234-34a9-a706-19d2d9446270",
                                                "text": "Hij kon het kind slechts bedaren door het een ijsje aan te bieden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bedaren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3383d5b3-41bd-31df-8343-d9719e09e12d",
                                        "entry_id": "fbaca17d-c3f0-3177-a0fa-228b58d05135",
