                        "form_id": "41edeb1b-db34-4be6-94a6-411be7bd3282",
                        "entry_id": "ce701d0d-c1da-3504-8d9e-4421cc4a3ee1",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Bromberges"
                    },
                    {
                        "form_id": "393ac5ce-f013-48c7-9a42-96ad91ed90ff",
                        "entry_id": "ce701d0d-c1da-3504-8d9e-4421cc4a3ee1",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Bromberg"
                    },
                    {
                        "form_id": "1d8210a9-9caa-43c1-89a8-2ed4778a2863",
                        "entry_id": "ce701d0d-c1da-3504-8d9e-4421cc4a3ee1",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Bromberg"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                        "entry_id": "ce701d0d-c1da-3504-8d9e-4421cc4a3ee1",
                        "glosses": [
                            "eine Erhöhung in Freiburg im Breisgau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3893e46-08fe-4107-9009-fe01957a097a",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "Wir waren heute auf dem Bromberg."
                            },
                            {
                                "example_id": "3b0a0db3-f904-45ca-9398-466b191ae3c7",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "„Oberhalb der Wiehre, auf dem Bromberg, gibt es einen als ‚Schlössle‘ getarnten Wasserhochbehälter mit Ausblick auf die Stadt.“"
                            },
                            {
                                "example_id": "8a24425a-5091-4d50-899e-4ed10a20f0c2",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "„Von besonderem Interesse sind an dieser Stelle drei relativ dicht beieinanderliegende Pingen am Nordhang des Bromberges oberhalb des Sternwaldecks.“"
                            },
                            {
                                "example_id": "5370958a-97f0-4d7a-9517-1de6749156e0",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "„Mit anwachsender Bevölkerung begann die Stadt, das Wasser aus den verschiedenen Quellen am Fuße des Brombergs in verschiedenen Brunnenstuben zu sammeln.“"
                            },
                            {
                                "example_id": "21f5f32f-c7bf-4d87-811f-efb85b57aff4",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "„Ende des 18. Jahrhunderts rückte die Bebauung an den Fuß des Bromberges heran und verdichtete sich in der Folgezeit […]“"
                            },
                            {
                                "example_id": "31ae42bb-8239-4acd-b5d2-440224e7f884",
                                "sense_id": "69ae61f4-03da-371f-ad07-2d24a11460db",
                                "text": "„Die Verbreitung des Grauspechtes umfasst nahezu sämtliche Waldflächen des Vogelschutzgebietes sowie die angrenzenden, noch intakten Streuobstwiesen im Bereich des Bromberges […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
