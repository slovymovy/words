            {
                "entry_id": "8688f33e-5c62-38f6-a3f1-3531e1588f45",
                "word": "Photoshop",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d78fb98e-84af-489a-91b4-aac8f31f3a05",
                        "entry_id": "8688f33e-5c62-38f6-a3f1-3531e1588f45",
                        "tags": [
                            "plural"
                        ],
                        "form": "Photoshops"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb2d20f6-16ec-3641-8b22-d3026561a7ff",
                        "entry_id": "8688f33e-5c62-38f6-a3f1-3531e1588f45",
                        "glosses": [
                            "Alternative letter-case form of photoshop (“a digitally altered image”)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "05ffe708-a959-48e8-a3f7-959087caefbc",
                                "sense_id": "cb2d20f6-16ec-3641-8b22-d3026561a7ff",
                                "text": "While the jargon inspired by this meme will live forever, the Photoshops and remixes have mostly dried up."
                            },
                            {
                                "example_id": "f960aa74-2120-4888-a46e-bd00c343bb41",
                                "sense_id": "cb2d20f6-16ec-3641-8b22-d3026561a7ff",
                                "text": "From there I kept up doing Photoshops revolving around things said on The Five, or my other favorite show, Red Eye, with plenty of Jasper adventures thrown in the mix."
                            },
                            {
                                "example_id": "d88a080a-3102-49d7-b30b-5148c7334058",
                                "sense_id": "cb2d20f6-16ec-3641-8b22-d3026561a7ff",
                                "text": "Every time a new person in my life became a target for the mob, it was hands-down more upsetting than any of the threats or creepy Photoshops or asinine accusations."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                "word": "photoshop",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8b94e69-83bc-46a2-a7ca-4e0281c719bb",
                        "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                        "tags": [
