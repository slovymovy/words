                        "glosses": [
                            "A measure of wine or spirit equal to 10 gallons; a barrel of this capacity."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "99949b23-e247-4d30-b831-50bf1f7b9283",
                                "sense_id": "e6790aee-e17e-3537-bf5f-c0151b018682",
                                "text": "And if your honour ſhould want a ſmall parcel of fine tea, or a few anchors of right Nantz, I'll be bound you ſhall be furniſhed to your heart's content."
                            },
                            {
                                "example_id": "8a5277b4-9c6f-4375-8d65-4acdf801de16",
                                "sense_id": "e6790aee-e17e-3537-bf5f-c0151b018682",
                                "text": "[I]t is quite a painful reflection how many whole crews we have made to walk the plank for no more than a stock of biscuit or an anker or two of spirit."
                            },
                            {
                                "example_id": "03cf4700-1048-4e7c-9a22-63e81425799b",
                                "sense_id": "e6790aee-e17e-3537-bf5f-c0151b018682",
                                "text": "\"God damn and blast all you hamfisted yokels!\" he was saying. \"And you, sir, down there. Take that grin off your face and be more careful, or I'll have you clapped under hatches to sail with us today. Easy, there, easy! Christ, rum at seven guineas an anker isn't meant to be dropped like pig iron!\""
                            }
                        ]
                    }
