                ],
                "senses": [
                    {
                        "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                        "entry_id": "c26553e0-068d-3a02-9ee5-42ec62469619",
                        "glosses": [
                            "Beratung für Interessierte in allen Fragen, die mit Sprache zusammenhängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45771795-af26-4c5d-bbb0-8fb76aa262d6",
                                "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                                "text": "Sprachberatung ist ein Angebot von einigen Universitäten und Sprachorganisationen (Sprachgesellschaften, Sprachvereinen, Verlagen), die anbieten, Interessierten Auskünfte zur Sprache schriftlich oder telefonisch - zum Teil gegen Entgelt - zu erteilen."
                            },
                            {
                                "example_id": "2d7150ed-c0f4-47d0-b581-2f2c85243269",
                                "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                                "text": "Die Sprachberatung kann fremdsprachige Einflüsse, Grammatik, Orthographie, Wortschatz sowie den Sprachgebrauch und alle anderen Sprachthemen betreffen."
                            },
                            {
                                "example_id": "4507f08e-8ee9-46f1-ba5e-b08aa71a8922",
                                "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                                "text": "„Was sagt die GfdS-Sprachberatung zu der Frage, wie ‚millionste‘ in Verbindung mit Ziffern zu schreiben ist?“"
                            },
                            {
                                "example_id": "babd31b7-c4ee-4d48-ab5b-04d7d454db9d",
                                "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                                "text": "„Es ist zwar nicht das erste Mal gewesen, dass wir uns mit thematisch tangierenden inhaltlichen Aspekten wie Sprachnorm, Sprachkultur, Sprachkritik oder gar mit dem Sprachgefühl beschäftigt haben, diesmal aber hatten wir einen Experten der Sprachberatung eingeladen, der professionell öffentliche Sprachberatung betreibt und demzufolge nicht nur über einen reichen Erfahrungsschatz verfügt, sondern uns auch differenzierte Einblicke in die komplexe und verantwortungsvolle Sprachberatungstätigkeit der Geschäftsstelle unserer GfdS in Wiesbaden geben konnte.“"
                            },
                            {
                                "example_id": "feaec0f9-7765-4636-9f25-6e5c6bea8ead",
                                "sense_id": "4d21e48f-8b71-31a5-8f85-1518b0f398fa",
                                "text": "„Hier liegt ein Dreh- und Angelpunkt plausibler Sprachberatung, der in populären Sprach- und Stilratgebern, in denen stets nach denselben Mustern verfahren wird, kaum erkennbar ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
