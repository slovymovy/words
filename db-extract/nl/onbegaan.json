                        "cross_references": [
                            {
                                "target_word": "insensitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560b316c-ce0b-3686-8069-fa292af546bd",
                                        "entry_id": "cd10fc36-9d6d-3718-9a73-f6b0edc44d88",
                                        "glosses": [
                                            "Expressing or feeling little or no concern, care, compassion, or consideration for the feelings, emotions, sentiments, or concerns of other people; inconsiderate or incompassionate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "268e9194-e6b6-30e0-af36-851d9de89cbb",
                                        "entry_id": "cd10fc36-9d6d-3718-9a73-f6b0edc44d88",
                                        "glosses": [
                                            "Not expressing normal physical feeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ce9269-1bf0-42b9-9873-52df276d0a4c",
                                                "sense_id": "268e9194-e6b6-30e0-af36-851d9de89cbb",
                                                "text": "It is something like the way dame Nature gathers round a foreign body an envelope of some insensitive tissue which can protect from evil that which it would otherwise harm by contact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55ccf34-a373-3fec-b847-6f58eb5b0702",
                                        "entry_id": "cd10fc36-9d6d-3718-9a73-f6b0edc44d88",
                                        "glosses": [
                                            "Not expressing normal emotional feelings; cold; tactless; undiplomatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0392c64f-a22f-4e85-b559-1a0f4ebb95d5",
                                                "sense_id": "e55ccf34-a373-3fec-b847-6f58eb5b0702",
                                                "text": "1895, Grant Allen, The British Barbarians\nSomehow, when Bertram Ingledew let it once be felt he did not wish to be questioned on any particular point, even women managed to restrain their curiosity: and he would have been either a very bold or a very insensitive man who would have ventured to continue questioning him any further."
                                            },
                                            {
                                                "example_id": "be6ce0b5-f97a-42ac-9822-b7366293f10f",
                                                "sense_id": "e55ccf34-a373-3fec-b847-6f58eb5b0702",
                                                "text": "Oh I really should have known by the time you drove me home, / By the vagueness in your eyes, your casual good-byes, / By the chill in your embrace and the expression on your face, / That told me you might have some advice to give / On how to be insensitive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
