                ],
                "senses": [
                    {
                        "sense_id": "60fc005a-c8a0-34a8-8fe3-a3500b96e952",
                        "entry_id": "f2770f34-660d-3bca-9ea0-c46b595854ee",
                        "glosses": [
                            "wartownik, zwiadowca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e539e8-5eb2-480a-a758-e9a51f3131fe",
                                "sense_id": "60fc005a-c8a0-34a8-8fe3-a3500b96e952",
                                "text": "Gdy komtur toruński [w nocy 7 września, wziąwszy załogę Nieszawy,] wtargnął do obozu Brochockiego, napotkał on aż trzy łańcuchy czat. Żołnierze krzyżaccy uprzątnęli pierwsze posterunki, ale w drugim łańcuchu czatownik zdążył krzykiem wzniecić alarm"
                            },
                            {
                                "example_id": "1f27755c-1c33-4b7b-9508-57c743c1a653",
                                "sense_id": "60fc005a-c8a0-34a8-8fe3-a3500b96e952",
                                "text": "I że przed świtem, jak czatownik tuszył [daw.; przypuszczał] / I jak niemieckie wyznawały brańce [brańcowi; jeńcowi], / Chce miasto ubiec i szturmować szańce"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6968fe59-9477-3189-87ea-a3190b52c43a",
                        "entry_id": "f2770f34-660d-3bca-9ea0-c46b595854ee",
                        "glosses": [
                            "osoba na komunikatorze internetowym, czacie; rozmówca"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ae0c323-8089-4f14-8d96-06de6a99c3cd",
                        "source_entry_id": "f2770f34-660d-3bca-9ea0-c46b595854ee",
                        "source_sense_id": "6968fe59-9477-3189-87ea-a3190b52c43a",
                        "target_lang_word": "chatter",
