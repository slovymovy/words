                        "sense_id": "8de90a83-0fff-3d5b-863a-2d9d219e5de6",
                        "entry_id": "d0cb92d5-c729-3a3d-a9c5-7d8eaa27de8d",
                        "glosses": [
                            "Chez le chaton, action de pétrir avec les coussinets de ses pattes avants les mamelles de sa mère pour stimuler la montée de lait."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9cba9dbb-ef7b-3ef6-bd40-82912a0445eb",
                        "entry_id": "d0cb92d5-c729-3a3d-a9c5-7d8eaa27de8d",
                        "glosses": [
                            "Comportement chez le chat adulte consistant à malaxer un objet, généralement moelleux, avec ses pattes avant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4611fe-107c-4ab0-b544-6b782832cc25",
                                "sense_id": "9cba9dbb-ef7b-3ef6-bd40-82912a0445eb",
                                "text": "Un chaton orphelin ou séparé de sa mère avant ses deux mois, soit l'âge de son sevrage, deviendra sans doute un adulte incapable d'associer le patounage à la sensation agréable de l'allaitement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d85760df-bb75-4b7a-8d1e-6f3e35528ec6",
                        "source_entry_id": "d0cb92d5-c729-3a3d-a9c5-7d8eaa27de8d",
                        "target_lang_word": "Milchtritt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchtritt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cdb793-2637-38ae-8b34-c58847afb127",
                                        "entry_id": "074efa86-12e8-333c-b36e-5854592e8f12",
                                        "glosses": [
                                            "Mehr oder weniger rhythmisches Treten der Jungtiere mit den Vorderpfoten gegen die Zitzen des Muttertieres unmittelbar vor und auch während des Säugens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c8cfb7-6ff1-417b-b778-e949a7cebad3",
                                                "sense_id": "f5cdb793-2637-38ae-8b34-c58847afb127",
                                                "text": "Ich beobachte gerne den Milchtritt meiner jungen Katze."
                                            },
                                            {
                                                "example_id": "a60eb328-6227-4b66-be5b-b29ec14d32db",
                                                "sense_id": "f5cdb793-2637-38ae-8b34-c58847afb127",
                                                "text": "„Nach dem Erwachen der Welpen wandern diese zügig zum Gesäuge und üben während des Säugens mit den Vorderpfoten den sogenannten Milchtritt aus, der die Milchproduktion des Muttertieres stimuliert.“"
                                            },
                                            {
                                                "example_id": "d34daf00-dea0-4890-8d39-560ef933f6f1",
                                                "sense_id": "f5cdb793-2637-38ae-8b34-c58847afb127",
                                                "text": "„Es ist eine Bettelgeste, mit der die noch blinden Welpen gegen die Zitzen der Mutter treten. Diese angeborene intuitive Bewegung wird als Milchtritt bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
