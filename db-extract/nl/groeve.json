                "translations": [
                    {
                        "translation_id": "9e714fcf-6df1-4e59-b29e-db609f8a7544",
                        "source_entry_id": "fe332914-1752-33f8-8e17-9036df818a9b",
                        "source_sense_id": "cfb3b98c-8919-3e31-a654-a4b953b2bafb",
                        "source_sense_description": "mijnbouw) een mijn waar delfstoffen gewonnen worden, onderaards of dagbouw",
                        "target_lang_word": "Grube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d13a89e-cf97-3b17-97fd-f3dc19481622",
                                        "entry_id": "fbcadd46-1221-3333-b2a6-09eca391a948",
                                        "glosses": [
                                            "natürliche oder künstlich angelegte Vertiefung im Erdboden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b44264-20e8-45c1-ab30-146b9fea2c1d",
                                                "sense_id": "2d13a89e-cf97-3b17-97fd-f3dc19481622",
                                                "text": "Die Indios bauen eine Grube, um Tapire einzufangen."
                                            },
                                            {
                                                "example_id": "34643fb3-9488-40dc-989a-0a12c5bcd687",
                                                "sense_id": "2d13a89e-cf97-3b17-97fd-f3dc19481622",
                                                "text": "„Im Oppidum Manching belegten mehr als 100 Gruben für Getreide die Bedeutung der Landwirtschaft außerhalb der Stadtmauern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                        "entry_id": "fbcadd46-1221-3333-b2a6-09eca391a948",
                                        "glosses": [
                                            "Bergwerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805352c3-efe0-46df-bfff-6191d0c2ffa9",
                                                "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                                "text": "Die Grube wurde wegen wiederholter Wassereinbrüche geschlossen."
                                            },
                                            {
                                                "example_id": "539b8a20-1b9c-4e4c-adda-8ea083f6122f",
                                                "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                                "text": "„Sie stand um vier Uhr früh auf, wenn die Männer in die Grube fuhren.“"
                                            },
                                            {
                                                "example_id": "0c525b2b-1a76-4077-ab60-fe0a162267a5",
                                                "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                                "text": "„Am nächsten Tage stieg ich wieder in die Grube hinab, wo ich viele Stunden eifrig das Handwerk eines Bergmanns ausübte.“"
                                            },
                                            {
                                                "example_id": "d28b3343-1052-4670-a89e-cfa42fbccded",
                                                "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                                "text": "„Sie drangen in die Grube vor.“"
                                            },
                                            {
                                                "example_id": "886e088f-0e27-435a-b25f-71ce772b65c4",
                                                "sense_id": "15fff24a-dd40-3bc0-8072-6d887acf6bc8",
                                                "text": "„Ein Teil der Gruben war erschöpft, bei anderen stieß die Erschließung immer tieferer Lagerstätten an technische Grenzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "35f7b30a-b9c0-34aa-9a62-cba910c717c0",
                                        "entry_id": "fbcadd46-1221-3333-b2a6-09eca391a948",
                                        "glosses": [
                                            "Grab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56536e8-e181-413b-b5d2-6bb279202fd4",
                                                "sense_id": "35f7b30a-b9c0-34aa-9a62-cba910c717c0",
                                                "text": "Der Sarg wird in die Grube herabgelassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a2f5e66f-da66-3719-bee5-811830533535",
                                        "entry_id": "fbcadd46-1221-3333-b2a6-09eca391a948",
                                        "glosses": [
                                            "Fäkaliengrube"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98797404-3c64-4728-8013-0f159ed95e5f",
                                                "sense_id": "a2f5e66f-da66-3719-bee5-811830533535",
                                                "text": "Die Grube muss mindestens einmal im Jahr geleert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Grube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e62ccd2-5dab-33ac-84ee-9ceb16cb6166",
                                        "entry_id": "cb065661-bf25-38c1-b6b1-1a9ce5c7ff2d",
                                        "glosses": [
                                            "eine Gemeinde in Schleswig-Holstein, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c86ea008-0fd8-4da3-a3d9-d08a58a12048",
                                                "sense_id": "3e62ccd2-5dab-33ac-84ee-9ceb16cb6166",
                                                "text": "Grube liegt in Deutschlands Norden."
                                            },
                                            {
                                                "example_id": "4604ea9d-7c13-49af-8d17-e071f1bbbfd2",
                                                "sense_id": "3e62ccd2-5dab-33ac-84ee-9ceb16cb6166",
                                                "text": "Grube befindet sich unweit der Ostsee."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
