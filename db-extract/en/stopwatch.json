                        "entry_id": "2566bdde-cc4d-3b84-b795-cb7d2fa3a284",
                        "glosses": [
                            "A timepiece designed to measure the amount of time elapsed between a particular time when activated and when the piece is deactivated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab472d22-86f1-482e-982a-7f85e8ccebdf",
                                "sense_id": "106bb7a2-13ad-3bb6-b629-2119bb4752e7",
                                "text": "I etched the face of a stopwatch on the back of a raindrop\nAnd did a swap for the sand in an hourglass"
                            }
                        ]
