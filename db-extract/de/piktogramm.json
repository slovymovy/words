                    {
                        "form_id": "188b2a53-e8b7-45a9-b02f-2c63a884cff3",
                        "entry_id": "05623b7f-b9fd-34dd-a0d1-4b3e7987c94c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
