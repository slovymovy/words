                "senses": [
                    {
                        "sense_id": "d34c6259-db12-3df5-854e-0cfb2c69596c",
                        "entry_id": "a258fa39-9033-3358-9aa0-e21c13587f13",
                        "glosses": [
                            "Abbau, Verminderung von etwas; das Reduzieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7368e5df-a0bb-4396-97a1-f663a8da00f2",
                                "sense_id": "d34c6259-db12-3df5-854e-0cfb2c69596c",
                                "text": "Die Reduzierung der Atomwaffen sichert die Überlebenschancen der Menschheit im Konflikt der System."
                            },
                            {
                                "example_id": "028e15e7-2eac-4f10-9712-c0bf61698047",
                                "sense_id": "d34c6259-db12-3df5-854e-0cfb2c69596c",
                                "text": "„Zur Reduzierung von Luftschadstoffen können sich Verkehrsbetriebe in Deutschland beim Kauf von sechs oder mehr Elektrobussen bis zu 80 Prozent der Mehrkosten vom Staat bezahlen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
