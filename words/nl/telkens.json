                {
                    "sense_id": "d77ccecb-2ef4-3b26-81f5-ae1c58086a08",
                    "sense_definition": "Op een herhalende manier; steeds weer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij onderbreekt me <w>telkens</w> wanneer ik iets belangrijks probeer te zeggen.",
                            "target_lang_translations": {
                                "en": "He interrupts me <w>every time</w> I try to say something important.",
                                "ru": "Он перебивает меня <w>каждый раз</w>, когда я пытаюсь сказать что-то важное.",
                                "fr": "Il m'interrompt <w>chaque fois</w> que j'essaie de dire quelque chose d'important."
                            }
                        },
                        {
                            "text": "Tijdens de vergadering moest mijn collega <w>telkens</w> hoesten door zijn verkoudheid.",
                            "target_lang_translations": {
                                "en": "During the meeting, my colleague had to cough <w>repeatedly</w> because of his cold.",
                                "ru": "Во время совещания мой коллега <w>то и дело</w> кашлял из-за простуды.",
                                "fr": "Pendant la réunion, mon collègue devait <w>sans cesse</w> tousser à cause de son rhume."
                            }
                        }
                    ],
                    "synonyms": [
                        "herhaaldelijk",
                        "steeds weer",
                        "keer op keer"
                    ],
                    "common_phrases": [
                        "telkens weer"
                    ],
                    "target_lang_definitions": {
