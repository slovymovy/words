                "senses": [
                    {
                        "sense_id": "ad424ecb-50ba-35b3-a80b-cf39e9db706c",
                        "entry_id": "46dc98d4-10e5-3ec4-b067-4d00c0711c1e",
                        "glosses": [
                            "bestimmter Tag, an dem sich die Mitglieder einer Familie treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63b8fc3-ddee-444b-babf-9cc378f6bde0",
                                "sense_id": "ad424ecb-50ba-35b3-a80b-cf39e9db706c",
                                "text": "„Wenn ich den Familientag bestimmen darf, gehen wir immer raus an die frische Luft.“"
                            },
                            {
                                "example_id": "7d45744f-2528-4dd2-9256-e8b71dff2289",
                                "sense_id": "ad424ecb-50ba-35b3-a80b-cf39e9db706c",
                                "text": "„Die Familie wünscht, daß in nächster Zeit ein Familientag zustande kommt, bei dem niemand fehlen darf.“"
                            },
                            {
                                "example_id": "36634a5c-e7b6-4f49-945c-265eb21a10c0",
                                "sense_id": "ad424ecb-50ba-35b3-a80b-cf39e9db706c",
                                "text": "„Übermorgen findet hier im Hotel der Familientag eines deutschen Freiherrengeschlechtes statt.“"
                            },
                            {
                                "example_id": "744a87aa-1b45-4070-8b9a-d96f6671dc3d",
                                "sense_id": "ad424ecb-50ba-35b3-a80b-cf39e9db706c",
                                "text": "„Der Familientag im Hause Rodríguez wurde wie immer mit viel Essen und viel Unterhaltung verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
