                "senses": [
                    {
                        "sense_id": "81320f67-6f5e-3d63-bcb6-efaf62413c6d",
                        "entry_id": "2690d159-a462-3550-9b1c-5a373f4cbe65",
                        "glosses": [
                            "taki, który przyjęty z góry jako założenie niezależne od doświadczenia, a bazujące na sądzie rozumowym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cae9d80-560d-4939-abb1-0cd4f1f86a27",
                        "source_entry_id": "2690d159-a462-3550-9b1c-5a373f4cbe65",
                        "source_sense_id": "81320f67-6f5e-3d63-bcb6-efaf62413c6d",
                        "target_lang_word": "apriorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apriorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f346742-ede5-3c1b-85f4-98c49b9c5c94",
                                        "entry_id": "35544189-6b59-3bcc-a608-e7b636e17a52",
                                        "glosses": [
                                            "rein aus Vernunftgründen erschlossen, rein durch Denken gefunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b2d9127-6867-4915-a4b9-2b413af3fea0",
                                                "sense_id": "7f346742-ede5-3c1b-85f4-98c49b9c5c94",
                                                "text": "„Alle apriorische Einsicht ist objektiv allgemein, d.h. Sie spricht in jedem Urteil, zu dem sie führt, von einer Totalität möglicher Realfälle …“"
                                            },
                                            {
                                                "example_id": "89233fe6-7059-416e-8813-fce70f5bfb77",
                                                "sense_id": "7f346742-ede5-3c1b-85f4-98c49b9c5c94",
                                                "text": "Die logische Form der Norm und die apriorische Kategorie des Sollens bleiben noch immer begrifflich miteinander verschmolzen."
                                            },
                                            {
                                                "example_id": "7e456f86-263b-4c3b-9ce4-8c8afced21c6",
                                                "sense_id": "7f346742-ede5-3c1b-85f4-98c49b9c5c94",
                                                "text": "KELSENS Grundnorm […] ist aber auch kein apriorischer Begriff, denn sie ist nicht von allgemeinster Allgemeinheit. Sie ist weder eine ursprüngliche (apriorische) Denkform aus reiner Anschauung noch eine reine Form des Denkens ohne konkret bestimmten Inhalt, die im Sinne KANTS einer unendlichen Erkenntniserweiterung dienlich sein könnte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "832531ec-54ca-4dc9-af1e-c2143e246bc8",
                        "source_entry_id": "2690d159-a462-3550-9b1c-5a373f4cbe65",
                        "source_sense_id": "81320f67-6f5e-3d63-bcb6-efaf62413c6d",
                        "target_lang_word": "априорный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "априорный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "abe67538-5a3e-35cb-b6b7-a72f6ec9a9d5",
                                        "entry_id": "69efe652-157a-3446-99ce-383d2a2e9e56",
                                        "glosses": [
                                            "филос. не зависящий от опыта, предшествующий опыту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e60344-6cdb-46d5-a0c5-b9773852ff67",
                                                "sense_id": "abe67538-5a3e-35cb-b6b7-a72f6ec9a9d5",
                                                "text": "Геолог обладает, так сказать, априорным знанием этого фундаментального принципа [актуализма], не зная его точного смысла, не обсуждая его каждый день."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
