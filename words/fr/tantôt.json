    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "14b10173-5152-3355-8c08-88d43b4248c5",
                    "sense_definition": "Employé de manière répétée pour indiquer l'alternance entre deux états ou actions différents ou opposés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alternance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent changeait de direction, soufflant <w>tantôt</w> vers le nord, <w>tantôt</w> vers l'est."
                        },
                        {
                            "text": "Son humeur est imprévisible, elle se montre <w>tantôt</w> chaleureuse et <w>tantôt</w> très distante."
                        }
                    ],
                    "synonyms": [
                        "parfois",
                        "quelquefois",
                        "de temps en temps"
                    ],
                    "common_phrases": [
                        "tantôt l'un tantôt l'autre"
                    ]
                },
                {
                    "sense_id": "fb063ff5-43d4-3590-be00-27fd1c231705",
                    "sense_definition": "Dans un court instant ou il y a peu de temps.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temps_proche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais passer te voir <w>tantôt</w> pour récupérer mes clés avant de partir."
                        },
                        {
                            "text": "Comme nous l'avons dit <w>tantôt</w>, la réunion aura lieu dans la grande salle."
                        }
                    ],
                    "synonyms": [
                        "tout à l'heure"
                    ],
                    "common_phrases": [
                        "à tantôt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régionalisme fréquent en Belgique, au Canada et dans plusieurs régions de France"
                        }
                    ]
                },
                {
                    "sense_id": "2347e3f3-05c8-329a-9ccb-79fb907faa57",
                    "sense_definition": "Durant la deuxième moitié de la journée, entre midi et le soir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apres_midi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait très beau aujourd'hui, nous irons nous promener <w>tantôt</w> dans la forêt."
                        },
                        {
                            "text": "Je dois terminer ce rapport ce matin pour pouvoir vous l'envoyer <w>tantôt</w>."
                        }
                    ],
                    "synonyms": [
                        "cet après-midi"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régional"
                        }
                    ]
                },
                {
                    "sense_id": "67ab96d0-15bb-3bb2-a1f9-d57a90b6e400",
                    "sense_definition": "Bientôt ou presque, en parlant d'une durée écoulée ou sur le point de s'achever.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "duree_proche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a <w>tantôt</w> trois ans que ce projet a commencé sans donner de résultat visible."
                        },
                        {
                            "text": "Notre grand-père a <w>tantôt</w> quatre-vingts ans mais il conserve toute son énergie."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Emploi vieilli"
                        }
                    ]
                }
            ]
        },
