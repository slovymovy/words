{
    "word_family": [
        "onnozelheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "463fc9d5-6d64-375a-b351-6458be9552d1",
                    "sense_definition": "naïef en te goeder trouw, vaak op een manier die getuigt van een gebrek aan levenservaring",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "naïviteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is een <w>onnozele</w> jongen die gelooft dat iedereen altijd de waarheid spreekt.",
                            "target_lang_translations": {
                                "en": "He is a <w>naive</w> boy who believes that everyone always tells the truth."
                            }
                        },
                        {
                            "text": "Het is nogal <w>onnozel</w> om te denken dat je zomaar een gratis auto kunt winnen.",
                            "target_lang_translations": {
                                "en": "It is quite <w>gullible</w> to think that you can just win a free car."
                            }
                        }
                    ],
                    "synonyms": [
                        "naïef",
                        "goedgelovig",
                        "argeloos"
                    ],
                    "antonyms": [
                        "achterdochtig",
                        "wereldwijs"
                    ],
                    "common_phrases": [
                        "onnozel schaap",
                        "onnozele vragen"
                    ],
                    "target_lang_definitions": {
                        "en": "naive and in good faith, often in a way that shows a lack of life experience"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naive",
                                "target_lang_sense_clarification": "lacking worldly experience or judgment"
                            },
                            {
                                "target_lang_word": "gullible",
                                "target_lang_sense_clarification": "easily deceived or tricked"
                            },
                            {
                                "target_lang_word": "simple-minded",
                                "target_lang_sense_clarification": "unsophisticated and straightforward"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a9d713d-a1a9-3fd4-913f-4db0a2664c28",
                    "sense_definition": "op een grappige of kinderachtige manier dwaas of mal",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dwaasheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop met die <w>onnozele</w> grappen en doe nu eens even serieus.",
                            "target_lang_translations": {
                                "en": "Stop with those <w>silly</w> jokes and be serious for a moment."
                            }
                        },
                        {
                            "text": "Ze trok een <w>onnozel</w> gezicht om de baby aan het lachen te maken.",
                            "target_lang_translations": {
                                "en": "She pulled a <w>funny</w> face to make the baby laugh."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaas",
                        "mal",
                        "gek",
                        "onbenullig"
                    ],
                    "antonyms": [
                        "serieus",
                        "ernstig"
                    ],
                    "common_phrases": [
                        "onnozel gezicht",
                        "onnozele grappen"
                    ],
                    "target_lang_definitions": {
                        "en": "foolish or silly in a funny or childish way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silly",
                                "target_lang_sense_clarification": "playfully foolish or lighthearted"
                            },
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "lacking good sense or judgment"
                            },
                            {
                                "target_lang_word": "daft",
                                "target_lang_sense_clarification": "mildly eccentric or silly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a7b93d7-c602-34ce-ba55-d0c1ff5cf615",
                    "sense_definition": "van weinig belang of waarde; onbeduidend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeduidendheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heel die ruzie was om een <w>onnozele</w> paraplu die iemand was vergeten.",
                            "target_lang_translations": {
                                "en": "That whole argument was over an <w>insignificant</w> umbrella that someone had forgotten."
                            }
                        },
                        {
                            "text": "Maak je toch niet druk om zo'n <w>onnozel</w> detail in het contract.",
                            "target_lang_translations": {
                                "en": "Don't worry about such a <w>trivial</w> detail in the contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeduidend",
                        "onbelangrijk",
                        "nietig"
                    ],
                    "antonyms": [
                        "belangrijk",
                        "essentieel"
                    ],
                    "common_phrases": [
                        "onnozel bedrag",
                        "onnozele fout"
                    ],
                    "target_lang_definitions": {
                        "en": "of little importance or value; insignificant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insignificant",
                                "target_lang_sense_clarification": "not important or consequential"
                            },
                            {
                                "target_lang_word": "paltry",
                                "target_lang_sense_clarification": "small or meager in amount or value"
                            },
                            {
                                "target_lang_word": "trivial",
                                "target_lang_sense_clarification": "of little value or importance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efdea5d5-e67c-3d24-9282-953c1d0c374f",
                    "sense_definition": "gebrek aan verstand tonend; dom of onverstandig",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "domheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>onnozele</w> zet om je wachtwoord aan een vreemde te geven.",
                            "target_lang_translations": {
                                "en": "It was a <w>stupid</w> move to give your password to a stranger."
                            }
                        },
                        {
                            "text": "Doe niet zo <w>onnozel</w> en denk eerst na voordat je iets zegt.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>daft</w> and think before you speak."
                            }
                        }
                    ],
                    "synonyms": [
                        "dom",
                        "onverstandig",
                        "stompzinnig"
                    ],
                    "antonyms": [
                        "slim",
                        "verstandig",
                        "pienter"
                    ],
                    "common_phrases": [
                        "onnozele opmerking"
                    ],
                    "target_lang_definitions": {
                        "en": "showing a lack of intelligence; stupid or unwise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stupid",
                                "target_lang_sense_clarification": "lacking intelligence or common sense"
                            },
                            {
                                "target_lang_word": "unwise",
                                "target_lang_sense_clarification": "not sensible or prudent"
                            },
                            {
                                "target_lang_word": "daft",
                                "target_lang_sense_clarification": "showing a lack of sense; foolish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b136ecf-1064-32ca-986d-7a20015567a5",
                    "sense_definition": "vrij van schuld of zonde; moreel zuiver",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onschuld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het feest van de <w>Onnozele</w> Kinderen wordt elk jaar op 28 december gevierd.",
                            "target_lang_translations": {
                                "en": "The Feast of the Holy <w>Innocents</w> is celebrated every year on December 28th."
                            }
                        },
                        {
                            "text": "Zij keken met een <w>onnozele</w> blik naar de wereld om hen heen.",
                            "target_lang_translations": {
                                "en": "They looked at the world around them with an <w>innocent</w> gaze."
                            }
                        }
                    ],
                    "synonyms": [
                        "onschuldig",
                        "schuldeloos",
                        "zuiver"
                    ],
                    "antonyms": [
                        "schuldig",
                        "verdorven"
                    ],
                    "common_phrases": [
                        "onnozele kinderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vaak in religieuze of historische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "free from guilt or sin; morally pure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "innocent",
                                "target_lang_sense_clarification": "free from moral wrong; sinless"
                            },
                            {
                                "target_lang_word": "guiltless",
                                "target_lang_sense_clarification": "having no guilt or blame"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}