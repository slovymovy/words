                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh, <w>barnacles</w>! I dropped my keys down the drain!",
                            "target_lang_translations": {
