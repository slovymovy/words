                                        "entry_id": "a4367a25-a914-3561-bc38-fc3c8ac008bf",
                                        "glosses": [
                                            "toestel waarin met zeer korte en gerichte elektromagnetische golven voedsel in zeer korte tijd warm kan worden gemaakt"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
