                "senses": [
                    {
                        "sense_id": "d3dcdc45-77e6-34e3-a68e-6ec04b4f299f",
                        "entry_id": "5f2fe90c-4638-3b65-afee-cbcca84121e7",
                        "glosses": [
                            "Bus, der von einer Fahrschule im Straßenverkehr zur Vorbereitung auf den Erwerb des entsprechenden Führerscheins genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3900349-ed67-434d-aae1-bb12c2d15cd1",
                                "sense_id": "d3dcdc45-77e6-34e3-a68e-6ec04b4f299f",
                                "text": "„Die Auszubildenden der KomBus aus dem ersten Lehrjahr konnten dieser Tage ihren neu gestalteten Fahrschulbus in Empfang nehmen.“"
                            },
                            {
                                "example_id": "6db05949-da97-43fc-b34e-62b00b4cc89c",
                                "sense_id": "d3dcdc45-77e6-34e3-a68e-6ec04b4f299f",
                                "text": "„Zwei Verletzte gab es am Donnerstag bei einem Unfall, an dem ein VW Golf und ein Fahrschulbus auf der A 38 zwischen Heiligenstadt und Leinefelde beteiligt waren.“"
                            }
                        ],
