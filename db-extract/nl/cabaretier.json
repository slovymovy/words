                    {
                        "sense_id": "87a2a813-fb48-331e-937a-9e03b33b46be",
                        "entry_id": "13bc766e-c661-3b0e-87a7-77161788c1ab",
                        "glosses": [
                            "een beoefenaar van het cabaret"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c69e152a-3cc7-4cc0-a214-804a30c0f108",
                                "sense_id": "87a2a813-fb48-331e-937a-9e03b33b46be",
                                "text": "Kees van Kooten is een bekende Nederlandse cabaretier zie samen werkte met Wim de Bie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c561504d-605c-45c1-bf06-38b3267c22c8",
                        "source_entry_id": "13bc766e-c661-3b0e-87a7-77161788c1ab",
                        "source_sense_id": "87a2a813-fb48-331e-937a-9e03b33b46be",
                        "source_sense_description": "een beoefenaar van de cabaretkunst",
                        "target_lang_word": "Kabarettist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabarettist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                        "entry_id": "00e14b2e-75bf-34a6-9d80-287070e57575",
                                        "glosses": [
                                            "Künstler des Kabaretts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189aa734-74a3-4cbb-a390-5deeefd15656",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Ich war auf einmal Entertainer, Conférencier, Kabarettist und nicht vorlesender Literat oder diskutierender Teilnehmer einer Talkshow.“"
                                            },
                                            {
                                                "example_id": "17e87b94-16e5-4547-8929-f1672c2de797",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Der Kabarettist wandelt sich zum Korrespondenten.“"
                                            },
                                            {
                                                "example_id": "6b665bc8-f245-4322-88eb-cc60709b008b",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Als Kabarettist und Medizinjournalist setzen Sie sich schon sehr lange mit der Medizinersprache auseinander. Bei welchen Gelegenheiten flüchten sich die Kollegen Ihrer Meinung nach am liebsten ins Ärzte-Latein?“"
                                            },
                                            {
                                                "example_id": "0c2cb2b1-f79b-49dd-afa0-061b0ab34991",
                                                "sense_id": "cfab8d79-3f31-3e69-9cfc-8630f79f6225",
                                                "text": "„Kaum zu glauben, aber ich bin einer der wenigen Kabarettisten in Deutschland, die bei der Bundeswehr waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e55febb-f5df-4688-ad16-2c6577fe8fcd",
                        "source_entry_id": "13bc766e-c661-3b0e-87a7-77161788c1ab",
                        "source_sense_id": "87a2a813-fb48-331e-937a-9e03b33b46be",
                        "source_sense_description": "een beoefenaar van de cabaretkunst",
                        "target_lang_word": "entertainer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entertainer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cd900b-a5d1-3e62-9d17-a8f6ac59097c",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "A person who entertains others, esp. as a profession, as a singer, actor, presenter, dancer, musician, magician, comedian, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d88351a-b63d-3947-b055-b0f7b3e56bb3",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "Someone who puts on a show for the entertainment or enjoyment of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "One who accommodates guests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c07bad-19dc-4214-b347-23cfc34d491b",
                                                "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                                "text": "During my sickness I was constantly and tenderly cared for by Mrs. Anderson, and at short intervals I received visits from both my children, so that upon the whole, I do not regard this as the least unpleasant portion of my life. I had the fullest sympathy of my entertainer—a blessing which had been denied for me many long years."
                                            },
                                            {
                                                "example_id": "36a89436-d374-4d2d-8410-fe1540597016",
                                                "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                                "text": "I am not an entertainer by any means. I do not own coasters or wine glasses and I’d rather spend a Saturday night figuring out what to do with my sourdough starter discard than playing hostess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e9d471c-2231-4cc6-9905-cd8128099838",
                        "source_entry_id": "13bc766e-c661-3b0e-87a7-77161788c1ab",
                        "source_sense_id": "87a2a813-fb48-331e-937a-9e03b33b46be",
                        "source_sense_description": "een beoefenaar van de cabaretkunst",
                        "target_lang_word": "animateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui anime un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17571c25-bde6-46c9-a273-2e82118da236",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Au mois de février 1867, on le retrouve parmi les animateurs de la grande grève des bronziers parisiens."
                                            },
                                            {
                                                "example_id": "82373ed9-046b-4d4f-93fc-30b5b4256b9d",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Durant quatre ans, Vigneault assume le rôle d’animateur de cette boîte qui accueille les premiers chansonniers québécois dont Raoul Roy, Clémence Desrochers, Pauline Julien, Hervé Brousseau, Jean-Pierre Ferland, Claude Gauthier, […]."
                                            },
                                            {
                                                "example_id": "fbed40ea-c815-4df4-a577-7d51757c5748",
                                                "sense_id": "693a3f3a-615e-3682-abad-28c27e48f998",
                                                "text": "Sans doute est-ce pour mieux rompre en visière avec des revues grisailleuses et assommantes que l’animateur Ayguesparse fonde en 1945 Marginales dont la centième livraison date de 1965."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0411c3-ece4-30c1-8c26-6ccfea71f81f",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui réalise l’animation d’un dessin animé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4120f52d-99c1-31f5-8128-247d5ea1b56a",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui est chargé de préparer, de présenter, d'expliquer et de coordonner les divers éléments constitutifs d'une émission télévisée ou radiophonique."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ca7fbe-5644-446f-95f1-5b3bee9ee9cf",
                                                "sense_id": "4120f52d-99c1-31f5-8128-247d5ea1b56a",
                                                "text": "Pour simplifier, on peut comparer cela à un talk-show télévisé. À côté de notre animateur préféré se tiennent les combattants de la rhétorique, bien alignés pour s'interpeller à volonté. Parfois, ils parlent tous en même temps, tant et si bien qu'il est impossible d’y comprendre quoi que ce soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa7764f0-1879-3a92-a9d0-977c3d47bd81",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Un travailleur social plus particulièrement un animateur socioculturel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5a79d5-3373-4e32-aadf-6f7659910f45",
                                                "sense_id": "fa7764f0-1879-3a92-a9d0-977c3d47bd81",
                                                "text": "De 1980 à 2000, en effet, on est passé d’un animateur « éducateur » à un professionnel d’abord gestionnaire et soucieux de réglementation autant que conscient du groupe, de ses limites et de ses conflits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77f5954-061c-36b2-8224-b4e35447ab04",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Un enseignant dans le secteur de la formation professionnelle pour adulte ou dans la réadaptation professionnelle, dénommé animateur de formation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e70880a-bad1-37e4-9545-fc47f60be860",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Celui qui passe de la musique, notamment de variétés, dans une réunion publique ou privée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffb51577-bd11-3483-9b8d-5c996d3ece09",
                                        "entry_id": "474ac058-94d3-3f5b-b892-2dc298766563",
                                        "glosses": [
                                            "Cheval qui se trouve en première position d'une course hippique et en imprime le rythme."
                                        ],
