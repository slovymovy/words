                "senses": [
                    {
                        "sense_id": "41f43aa6-d709-3c74-b8f9-3c3c5e39de9c",
                        "entry_id": "c6c1cd94-4ba6-3210-9d5e-a449d82b882e",
                        "glosses": [
                            "Kernfusion von Protonen (also Atomkernen des häufigsten Isotops ¹H des Wasserstoffs) zu Helium im Inneren von Sternen oder, im Fall einer Nova, auf der Oberfläche eines weißen Zwergs"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd9355c-9a09-44b3-988e-77048eec20f4",
                                "sense_id": "41f43aa6-d709-3c74-b8f9-3c3c5e39de9c",
                                "text": "„Eine exotherme Kernfusion ist etwa das Wasserstoffbrennen, wie es in der Sonne geschieht.“"
                            },
                            {
                                "example_id": "2c09ce6a-319a-4292-9d60-ff9aaf83aa67",
                                "sense_id": "41f43aa6-d709-3c74-b8f9-3c3c5e39de9c",
                                "text": "„Bei genügend hoher Temperatur und ausreichend hohem Druck beginnen die beim Wasserstoffbrennen erbrüteten Heliumkerne im Kern des Sterns zu fusionieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
