                ],
                "senses": [
                    {
                        "sense_id": "8f58fc42-8b27-3304-a28e-1206bc71b22b",
                        "entry_id": "378c93f9-4b0a-3847-9255-586a6ecb800d",
                        "glosses": [
                            "een poort die toegang geeft tot de (binnen)stad en onderdeel is of was van de stadsmuur of stadsomwalling, oorspronkelijk bedoeld om ongewenste gasten buiten te houden."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dde5c645-abb1-4e2a-86e4-d93040b5586c",
                        "source_entry_id": "378c93f9-4b0a-3847-9255-586a6ecb800d",
                        "source_sense_id": "8f58fc42-8b27-3304-a28e-1206bc71b22b",
                        "target_lang_word": "Stadttor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadttor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                        "entry_id": "df0a8c03-2cf8-386f-a655-cb31783bd2bd",
                                        "glosses": [
                                            "Tor in einer Stadtmauer, welches aber auch oft freistehend sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad5cbef-4286-4308-830b-6e7ef73d2a00",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "Die „Porta Nigra“ ist ehemaliges römisches Stadttor in Trier und Wahrzeichen der Stadt."
                                            },
                                            {
                                                "example_id": "fa0fb8da-aded-4438-b988-2dd2b44a0bc1",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "In Jerusalem ist die Stadtmauer samt seiner Stadttore komplett erhalten und umringen die Altstadt."
                                            },
                                            {
                                                "example_id": "4c4872d4-2b50-41c7-bb97-5e911ca49853",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "Berlins letztes erhaltenes Stadttor ist das Brandenburger Tor, da andere Stadttore entweder mit der Stadterweiterung abgerissen oder nach dem Zweiten Weltkrieg zerstört waren."
                                            },
                                            {
                                                "example_id": "0de3fe25-5c89-4554-8b3e-c5502171a316",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "Das Jülicher Stadttor, genannt „Hexenturm“, erhielt seinen Namen aufgrund der Verhandlungen, Folterungen und Aburteilungen angeblicher Zauberer und Hexen, die darin eingekerkert und inhaftiert worden waren."
                                            },
                                            {
                                                "example_id": "dc488ef5-a638-40f2-b188-ae30f4618b28",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "Der ursprüngliche Standort der Stadttore Babylons wäre im heutigen Irak, jedoch sind sie im Pergamonmuseum Berlins zu sehen."
                                            },
                                            {
                                                "example_id": "898bb84d-c5b0-4f8d-b232-bed24c492e5a",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "„Gleich erreichen wir das Stadttor und den Malerwinkel.“"
                                            },
                                            {
                                                "example_id": "10497179-ca82-4d88-b314-02220f9a0a71",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "„Als die Würdenträger nicht kamen und die Stadttore geschlossen blieben, entschloss er sich, schweren Herzens, wie er seinen Generälen sagte und wie es später in den Geschichtsbüchern stand, am nächsten Morgen die Kanonen sprechen zu lassen und die Schöne zu erobern.“"
                                            },
                                            {
                                                "example_id": "6da7b13a-8390-4841-a85c-74acaa5a92ee",
                                                "sense_id": "a8225ae3-e2f4-3e5e-90f7-02aa4fc06374",
                                                "text": "„Gleich nach dem Mittagessen führte mich Desarmoises durch das Stadttor am Po zu dem jüdischen Pferdehändler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
