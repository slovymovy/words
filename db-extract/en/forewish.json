                        "entry_id": "139bfc8b-b4a4-3359-805f-68e2497c0b0c",
                        "glosses": [
                            "To wish or desire beforehand."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6db7a4a6-9a5c-43c0-a1a2-e9442b1a9ad1",
                                "sense_id": "5da9e660-e505-3466-bd9b-8c70e72ace71",
                                "text": "[…] as in a contest one has with an enemy, by desiring he forewishes a victory still distant from him by an intervening time."
                            },
                            {
                                "example_id": "041b18dc-cf99-4c7c-adc0-01ab98bc0ad1",
                                "sense_id": "5da9e660-e505-3466-bd9b-8c70e72ace71",
                                "text": "Events were soon to prove false those predictions of catastrophe, predictions of a fate that was forewished rather than foreseen."
                            }
                        ]
                    }
