                ],
                "senses": [
                    {
                        "sense_id": "060e5bc7-6b88-3e46-b1cc-e9eef7acc857",
                        "entry_id": "d1514eed-07f0-3542-bf5e-95f8c5b1c756",
                        "glosses": [
                            "bestimmter Zeitraum (Epoche) in der Geschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "341a5022-f7f4-4278-9231-8045451b904b",
                                "sense_id": "060e5bc7-6b88-3e46-b1cc-e9eef7acc857",
                                "text": "„Mit dem Sieg der Römer gegen die Karthager und Griechen ging dann diese Geschichtsepoche der Maritimen Gesellschaften im Altertum zu Ende.“"
                            },
                            {
                                "example_id": "5e5b08d3-1a85-47c8-8489-f0b4bbd2fd50",
                                "sense_id": "060e5bc7-6b88-3e46-b1cc-e9eef7acc857",
                                "text": "„Mykene und Tyrins waren mächtige Kultur- und Handelszentren im frühen Griechenland, denen eine ganze Geschichtsepoche ihren Namen verdankt.“"
                            },
                            {
                                "example_id": "a9d6ab23-352e-437b-9f2e-325a6c31d6ae",
                                "sense_id": "060e5bc7-6b88-3e46-b1cc-e9eef7acc857",
                                "text": "„Wenn ich den Nationalsozialismus und das, was er angerichtet hat, bewerten will, muss ich jungen Menschen Angebote machen, wie sie konstruktiv mit dieser Geschichtsepoche umgehen können.“"
                            },
                            {
                                "example_id": "b21f9d69-b738-4423-8fb6-51d41035d438",
                                "sense_id": "060e5bc7-6b88-3e46-b1cc-e9eef7acc857",
                                "text": "„Das gewaltige Ereignis der französischen Revolution von 1789 beendet die Geschichtsepoche des Mittelalters nicht nur in politischer, sondern vor allem in geistiger und gesellschaftlicher Hinsicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
