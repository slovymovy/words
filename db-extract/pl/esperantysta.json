                ],
                "senses": [
                    {
                        "sense_id": "2a7c5a36-2681-35e3-931a-9a8c5aafac34",
                        "entry_id": "2927de49-e643-32ee-b31e-022aeb31d989",
                        "glosses": [
                            "osoba mówiąca językiem esperanto lub propagująca go"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7915e76b-cbc2-4c0b-883d-8070afd7b00f",
                                "sense_id": "2a7c5a36-2681-35e3-931a-9a8c5aafac34",
                                "text": "Czy twój mąż też jest esperantystą?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7578e9d-b3d2-48a4-b996-8acad90100ce",
                        "source_entry_id": "2927de49-e643-32ee-b31e-022aeb31d989",
                        "source_sense_id": "2a7c5a36-2681-35e3-931a-9a8c5aafac34",
                        "target_lang_word": "Esperantist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esperantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4c5bda-23f6-3213-943a-fcfac7a14ea1",
                                        "entry_id": "5432b410-b90e-3655-a2db-fad01aedfef2",
                                        "glosses": [
                                            "Of, relating to, or characteristic of Esperanto."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6cc0619-d264-4d43-9c51-092b6aceb008",
                                                "sense_id": "4c4c5bda-23f6-3213-943a-fcfac7a14ea1",
                                                "text": "Underlying every Esperanto enthusiast is the Esperantist ideal that the world would be a better place if everyone could understand each other better."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Esperantist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                        "entry_id": "3b794dd5-ec51-316d-9a43-97748f59ed9c",
                                        "glosses": [
                                            "A specialist or speaker of Esperanto, the international auxiliary language designed by L. L. Zamenhof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01cd761f-afb9-4041-92d4-ecec6376889f",
                                                "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                                "text": "A growing number of Esperantists all over the world are using the services of the U. E. A."
                                            },
                                            {
                                                "example_id": "b768bb4e-0c22-47b3-af14-fc6b8b172de4",
                                                "sense_id": "20533da8-da65-356b-b9c2-6e159ec4a4c4",
                                                "text": "It is said that many of the early Catholic Esperantists, in particular, were frightened by this prospect—and it is, indeed, true that the Catholic element in early Idism is striking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34bf4e31-6fd7-4dfc-ad8c-12ec65bb1325",
                        "source_entry_id": "2927de49-e643-32ee-b31e-022aeb31d989",
                        "source_sense_id": "2a7c5a36-2681-35e3-931a-9a8c5aafac34",
                        "target_lang_word": "Esperantist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esperantist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73f86ab8-ed9c-3049-a003-085a3b444a5a",
                                        "entry_id": "d733f595-3563-370a-813a-02e4d8ddc7af",
                                        "glosses": [
                                            "Person, die Esperanto spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa31eb55-8c11-4e9b-bca8-af78a4475c35",
                                                "sense_id": "73f86ab8-ed9c-3049-a003-085a3b444a5a",
                                                "text": "„Nach dem Schisma der Bewegung in Idisten und Esperantisten scheitert die Zusammenarbeit von Couturat und Ostwald nicht zuletzt an der Frage, in welchem Format die eigens gegründete Ido-Zeitschrift Progreso erscheinen soll.“"
                                            },
                                            {
                                                "example_id": "76fa1c4a-297e-4a56-9061-ba6b692c8fcb",
                                                "sense_id": "73f86ab8-ed9c-3049-a003-085a3b444a5a",
                                                "text": "„Es gelang weder den Idisten noch den Esperantisten, ihre Sprache als Welthilfssprachen durchzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cdd5bce-e20f-4fde-a51e-b906dcbb705c",
                        "source_entry_id": "2927de49-e643-32ee-b31e-022aeb31d989",
