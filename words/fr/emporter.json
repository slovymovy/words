    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98dcb8a9-db53-31d9-a7b2-b71f5196a615",
                    "sense_definition": "Prendre avec soi et déplacer d'un endroit à un autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas d'<w>emporter</w> ton parapluie car il risque de pleuvoir cet après-midi."
                        },
                        {
                            "text": "Nous avons décidé de commander des plats à <w>emporter</w> pour dîner tranquillement à la maison."
                        }
                    ],
                    "synonyms": [
                        "porter"
                    ],
                    "antonyms": [
                        "abandonner",
                        "laisser"
                    ],
                    "common_phrases": [
                        "à emporter",
                        "emporter ses affaires"
                    ]
                },
                {
                    "sense_id": "68f21917-0dc1-35c2-a248-9988ce157e67",
                    "sense_definition": "Gagner un avantage ou remporter une victoire face à des concurrents.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "victoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe a réussi à l'<w>emporter</w> sur ses adversaires après un match très disputé."
                        },
                        {
                            "text": "Après un long débat, l'avis de la présidente a fini par <w>emporter</w> la décision."
                        }
                    ],
                    "common_phrases": [
                        "l'emporter sur",
                        "l'emporter haut la main"
                    ]
                },
                {
                    "sense_id": "b11f2fac-2a79-3168-8421-28a2491fb0c5",
                    "sense_definition": "Entraîner, détacher ou déplacer avec rapidité et violence sous l'action d'une force.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent violent a failli <w>emporter</w> le toit de la cabane pendant la tempête."
                        },
                        {
                            "text": "Le nageur téméraire a été <w>emporté</w> vers le large par le courant marin."
                        }
                    ],
                    "synonyms": [
                        "arracher",
                        "enlever",
                        "entraîner"
                    ],
                    "common_phrases": [
                        "emporté par le courant",
                        "emporté par le vent"
                    ]
                },
                {
                    "sense_id": "ef6428ea-729e-3640-afd8-c2876f9d2bb9",
                    "sense_definition": "Perdre son calme et céder brusquement à une vive colère.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>emporté</w> contre son collègue dès que la discussion a tourné au vinaigre."
                        },
                        {
                            "text": "Respire calmement avant de répondre afin de ne pas t'<w>emporter</w> inutilement."
                        }
                    ],
                    "common_phrases": [
                        "s'emporter contre quelqu'un",
                        "s'emporter facilement"
                    ]
                },
                {
                    "sense_id": "66ac74e2-7233-3655-a79d-a91c5ece0852",
                    "sense_definition": "Provoquer la mort rapide d'une personne, en parlant d'une affection ou d'une maladie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une pneumonie fulgurante a malheureusement <w>emporté</w> son grand-père en quelques jours seulement."
                        },
                        {
                            "text": "Le vieil artiste a été <w>emporté</w> par une longue et douloureuse maladie."
                        }
                    ],
                    "synonyms": [
                        "enlever"
                    ],
                    "common_phrases": [
                        "emporté par la maladie"
                    ]
                },
                {
                    "sense_id": "174e6b76-e75e-3ad1-ba4c-5e5f8a5d2463",
                    "sense_definition": "Entraîner comme conséquence directe ou logique ; impliquer de plein droit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "implication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acceptation sans réserve de ce contrat <w>emporte</w> l'adhésion complète à tous ses termes."
                        },
                        {
                            "text": "La démission du directeur général va sans doute <w>emporter</w> une réorganisation du service."
                        }
                    ],
                    "synonyms": [
