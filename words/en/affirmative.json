{
    "word_family": [
        "affirm",
        "affirmation",
        "affirmatively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52fa4681-d7f5-32ac-a76d-5af1ab0d7485",
                    "sense_definition": "Expressing agreement, assent, or confirmation; asserting that something is true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee gave an <w>affirmative</w> nod to the proposed changes.",
                            "target_lang_translations": {
                                "pl": "Komitet dał <w>afirmacyjny</w> znak głową w odpowiedzi na proponowane zmiany."
                            }
                        },
                        {
                            "text": "She received an <w>affirmative</w> answer to her request for a transfer.",
                            "target_lang_translations": {
                                "pl": "Otrzymała <w>twierdzącą</w> odpowiedź na swoją prośbę o przeniesienie."
                            }
                        }
                    ],
                    "synonyms": [
                        "positive",
                        "confirmative",
                        "approving"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "affirmative answer",
                        "affirmative response",
                        "affirmative nod"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrażający zgodę, potwierdzenie lub przyzwolenie; stwierdzający, że coś jest prawdą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "afirmacyjny",
                                "target_lang_sense_clarification": "wyrażający zgodę lub poparcie"
                            },
                            {
                                "target_lang_word": "twierdzący",
                                "target_lang_sense_clarification": "odnoszący się do odpowiedzi na pytanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bf633d9-1f6a-386c-9beb-fcd246a42f88",
                    "sense_definition": "Supporting or favoring a proposition, motion, or action, especially in a vote.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board cast an <w>affirmative</w> vote to approve the annual budget.",
                            "target_lang_translations": {
                                "pl": "Zarząd oddał <w>afirmatywny</w> głos, aby zatwierdzić roczny budżet."
                            }
                        },
                        {
                            "text": "We need at least five <w>affirmative</w> votes to pass this resolution.",
                            "target_lang_translations": {
                                "pl": "Potrzebujemy co najmniej pięciu głosów <w>za</w>, aby przyjąć tę uchwałę."
                            }
                        }
                    ],
                    "synonyms": [
                        "favorable",
                        "supportive"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "affirmative vote",
                        "affirmative action"
                    ],
                    "target_lang_definitions": {
                        "pl": "Popierający propozycję, wniosek lub działanie, zwłaszcza podczas głosowania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "afirmatywny",
                                "target_lang_sense_clarification": "aprobujący, popierający (często w kontekście formalnym)"
                            },
                            {
                                "target_lang_word": "za",
                                "target_lang_sense_clarification": "głosujący na tak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e7e18ed-d908-35c8-82c3-ef68e8fe9d74",
                    "sense_definition": "A statement, word, or response that indicates agreement, assent, or acceptance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked if he would join the team, he replied in the <w>affirmative</w>.",
                            "target_lang_translations": {
                                "pl": "Zapytany, czy dołączy do zespołu, odpowiedział <w>twierdząco</w>."
                            }
                        },
                        {
                            "text": "We are still waiting for an <w>affirmative</w> from the client before we begin.",
                            "target_lang_translations": {
                                "pl": "Wciąż czekamy na <w>potwierdzenie</w> od klienta, zanim zaczniemy."
                            }
                        }
                    ],
                    "synonyms": [
                        "agreement",
                        "yes",
                        "assent"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "in the affirmative",
                        "reply in the affirmative"
                    ],
                    "target_lang_definitions": {
                        "pl": "Oświadczenie, słowo lub odpowiedź wskazująca na zgodę, przyzwolenie lub akceptację."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odpowiedź twierdząca",
                                "target_lang_sense_clarification": "potwierdzenie czegoś"
                            },
                            {
                                "target_lang_word": "zgoda",
                                "target_lang_sense_clarification": "wyrażenie akceptacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0d2eabe9-b613-3a5b-b54b-a52c4fa5eb93",
                    "sense_definition": "Used to express agreement, assent, or confirmation, especially in radio communications.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "radio_yes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Do you have visual contact with the target?\" \"<w>Affirmative</w>, we see it clearly.\"",
                            "target_lang_translations": {
                                "pl": "„Czy masz kontakt wzrokowy z celem?” „<w>Tak</w>, widzimy go wyraźnie.”"
                            }
                        },
                        {
                            "text": "The pilot responded with a quick \"<w>affirmative</w>\" before adjusting the altitude.",
                            "target_lang_translations": {
                                "pl": "Pilot odpowiedział krótkim „<w>tak</w>”, zanim skorygował wysokość."
                            }
                        }
                    ],
                    "synonyms": [
                        "yes",
                        "indeed",
                        "correct"
                    ],
                    "antonyms": [
                        "negative"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in military, aviation, or law enforcement contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Używane do wyrażenia zgody lub potwierdzenia, szczególnie w komunikacji radiowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "tak",
                                "target_lang_sense_clarification": "potwierdzenie w komunikacji"
                            },
                            {
                                "target_lang_word": "zrozumiałem",
                                "target_lang_sense_clarification": "potwierdzenie odbioru komunikatu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}