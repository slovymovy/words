                },
                {
                    "sense_id": "5ff32167-94ec-3064-9f08-d9f3b5ddec37",
                    "sense_definition": "To use up, destroy, or consume resources like money or time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This expensive project is <w>eating</w> up all of our savings.",
                            "target_lang_translations": {
                                "ru": "Этот дорогой проект <w>съедает</w> все наши сбережения."
                            }
                        },
                        {
                            "text": "Commuting to the city every day <w>eats</w> into my free time.",
                            "target_lang_translations": {
                                "ru": "Ежедневные поездки в город <w>пожирают</w> моё свободное время."
                            }
                        }
                    ],
                    "synonyms": [
                        "consume"
                    ],
                    "common_phrases": [
                        "eat up",
                        "eat into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расходовать, уничтожать или поглощать ресурсы, такие как деньги или время."
