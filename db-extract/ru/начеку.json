                        "glosses": [
                            "警戒，戒備，留意"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6136bbdf-7787-4e7e-a6f0-e40875697fee",
                                "sense_id": "2ea2b467-6068-3739-8497-e4510a7cddc2",
                                "text": "Будь начеку́.",
                                "translation": "警戒/保持警覺/小心/提防。"
                            },
                            {
                                "example_id": "a217d1df-8216-4225-857f-a7dd06cffbf9",
                                "sense_id": "2ea2b467-6068-3739-8497-e4510a7cddc2",
                                "text": "Про́сто, что́бы ты был начеку́.",
                                "translation": "只是給你提醒一下。"
                            },
                            {
                                "example_id": "13a15fda-2ecc-4990-a9ba-99f129323282",
                                "sense_id": "2ea2b467-6068-3739-8497-e4510a7cddc2",
                                "text": "Райо́нный ванда́л де́ржит мои́х сосе́дей начеку́.",
                                "translation": "鄰居的破壞行為讓我的鄰居們提心吊膽。"
                            },
                            {
                                "example_id": "8a9c4c17-b717-41e6-a6c3-4f923db94bfb",
                                "sense_id": "2ea2b467-6068-3739-8497-e4510a7cddc2",
                                "text": "Я бу́ду начеку́, е́сли произойдёт что́-то подозри́тельное.",
                                "translation": "我會留意任何可疑的事情。"
                            }
                        ]
                    }
