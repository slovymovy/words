                "senses": [
                    {
                        "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                        "entry_id": "508d09bf-d635-3441-b534-aa7e359d8da8",
                        "glosses": [
                            "typusbildende charakterliche Eigenart, Wesensart eines Spielenden beziehungsweise zu extensivem Spielen neigende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542dddba-4165-4ae8-8acc-cce89162a3e2",
                                "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                                "text": "„Zuerst zögerte er für einige Minuten, doch seiner Spielernatur erschien die Aussicht auf einen langwierigen Untergrundkampf als wenig verheißungsvoll.“"
                            },
                            {
                                "example_id": "863c4a07-4d81-479c-86e6-543d6ee7c242",
                                "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                                "text": "„Die Kategorie Wettspiel stellt eine für jede Spielernatur geeignete und für jedes Spielbedürfnis bereichernde Erfahrung dar.“"
                            },
                            {
                                "example_id": "62c98bd4-ec89-42c7-bb24-a18eb71786d5",
                                "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                                "text": "„Das Ziel dieses Volkssports also, den eine kleine Gruppe von Spielernaturen offensichtlich bewusst betreibt: möglichst lange mietfrei in der Wohnung bleiben, um dann das nächste Domizil anzusteuern.“"
                            },
                            {
                                "example_id": "7760a69a-cff5-4a08-a352-0a670311cf85",
                                "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                                "text": "„Weil der nun einen mitfühlenden, also unter Umständen mit Rot-Grün verträglichen Liberalismus vertritt, weil der eine ernste Spielernatur ist, weil der ganz gut mit der Sozialdemokratin Hannelore Kraft und der Grünen Sylvia Löhrmann kann, weil, kurzum, am nächsten Sonntag in Nordrhein-Westfalen eine Ampelkonstellation rauskommen könnte.“"
                            },
                            {
                                "example_id": "f8d920d7-e427-4cdf-8cd7-98af8c05fe89",
                                "sense_id": "a4e2adb5-2e3d-3d1c-9373-53f76c3c6a4e",
                                "text": "„Doch selbst als die Sozialdemokraten von der Spielernatur Wolfgang Schüssel, der unbekümmert seinen eigenen Pakt mit dem Teufel schloss, ausgetrickst wurden, wagte niemand in der Partei, das eherne Gebot anzuzweifeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
