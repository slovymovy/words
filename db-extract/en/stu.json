                        "examples": [
                            {
                                "example_id": "acd5913c-fd93-4780-8b2e-67be5590dbeb",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "That's a track that's weak that he got last week / Cause everybody in the stu' was like: \"That's that heat!\""
                            },
                            {
                                "example_id": "34eb6140-10b5-44a0-a476-81bd4813f57e",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "And lest you naysayers doubt it, Swizz even posted a video of Egpyt^([sic]) in the stu, adding, \"oh and to all you old ass producers mad at a 5yr old on his grind early step ya game up and get a life.\""
                            },
                            {
                                "example_id": "60f93198-a98d-42f1-a3f8-4dd804a01de9",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "My first car I might cop a Mercedes / In the stu' everyday can't be lazy"
                            },
                            {
                                "example_id": "32e9ba04-4ec4-4951-bd72-8c77f6c50f86",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "\"[W]ell ............. 'twas a pretty rough day in nyc,\" Grande tweeted. \"My friends took me to tiffany's. we had too much champagne. i bought us all rings. it was very insane and funny. & on the way back to the stu njomza was like 'bitch, this gotta be a song lol'. so we wrote it that afternoon.\""
                            },
                            {
                                "example_id": "0adc5e21-2693-4a91-92c6-c02bafb59897",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "They had a big influence on me. They had a big influence on Brooklyn period. I like the nonsense. [laughs] They were wildin'. Everyone in Brooklyn was liking that shit. They're wildin'. Their story in the stu, it gets deep."
                            },
                            {
                                "example_id": "91025388-f9c2-4d2e-a5cf-5e25e19bccd8",
                                "sense_id": "3a891813-38eb-3152-9855-fd8181be3eeb",
                                "text": "I know I can fly, cause once I tried then I done flew / Only time I really give a speech is in the stu'"
                            }
                        ]
                    }
