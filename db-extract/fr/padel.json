                        "glosses": [
                            "Sorte de tennis qui se joue sur un espace restreint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3249a179-c84e-485f-9f59-054aab187175",
                                "sense_id": "60f12512-7416-3f3a-8d50-21ed0bf467b3",
                                "text": "Pour les sports qui ne peuvent pas se pratiquer seul, à l’image du squash ou du padel, « un groupe Facebook est mis à disposition pour trouver des coéquipiers, ce qui permet de pratiquer même quand on ne connaît pas d’autres joueurs », précise Hugo Veny, employé à l’accueil de la Sport Station."
                            },
                            {
                                "example_id": "a5f78587-a5fd-45ee-a3ba-81a839d343b5",
                                "sense_id": "60f12512-7416-3f3a-8d50-21ed0bf467b3",
                                "text": "Le padel : la reconversion des ex-tennismen ?"
                            },
                            {
                                "example_id": "a5dcf8c5-481e-4166-b07b-e9a3d44a6901",
                                "sense_id": "60f12512-7416-3f3a-8d50-21ed0bf467b3",
                                "text": "Au sein de ses cinq étages, le bâtiment, rue Charles-Chaigneau à Brazza, propose des réservations payantes pour pratiquer l’escalade, le golf, la musculation, la boxe, le padel, le squash, le golf ou encore la danse urbaine."
                            }
                        ]
