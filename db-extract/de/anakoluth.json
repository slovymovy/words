                        "source_sense_id": "02d49b1a-6b6d-3f44-bfc9-c3ddee7e19bd",
                        "source_sense_description": "Linguistik: Unterbrechung der Satzstruktur während der Bildung eines Satzes",
                        "target_lang_word": "анаколуф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
