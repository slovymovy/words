                "senses": [
                    {
                        "sense_id": "fd0a2527-a8fd-3e63-97f5-5a50bc221032",
                        "entry_id": "2fd2fdb0-0d0c-3a7e-b6d5-5666f7b74315",
                        "glosses": [
                            "книжн. устар. ласкающий, нежный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f4e214-94db-47a2-aa46-bd866ae2db79",
                                "sense_id": "fd0a2527-a8fd-3e63-97f5-5a50bc221032",
                                "text": "Я, совсем в гневе, потребовал, чтобы она не морочила меня фокусами, но Рената, переменив свой ликующий голос на ласкательный, стала уговаривать меня, прижимаясь ко мне, как к возлюбленному…"
                            }
                        ]
                    },
                    {
                        "sense_id": "02ad0d92-50a2-31de-9aec-6f1875c5638c",
                        "entry_id": "2fd2fdb0-0d0c-3a7e-b6d5-5666f7b74315",
                        "glosses": [
                            "книжн. устар. льстивый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb688440-f951-4e84-bae8-20e7fe090a81",
                                "sense_id": "02ad0d92-50a2-31de-9aec-6f1875c5638c",
                                "text": "Ласкательная улыбка."
                            }
                        ]
                    },
                    {
                        "sense_id": "60950a18-4ec1-3573-ae7f-afa327fe204f",
