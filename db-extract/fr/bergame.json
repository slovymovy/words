                                                "example_id": "a2165609-3913-4ea0-8fd1-1dcf10bf2b95",
                                                "sense_id": "c5efb2ae-adfd-38f9-b812-95f245453ba3",
                                                "text": "„Der Güterverkehr in Nordost-Italien braucht eine Abzweigung nach Bergamo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
