                        "examples": [
                            {
                                "example_id": "127a122c-73f3-4fd8-9dca-befc46169769",
                                "sense_id": "ddb64c6c-499d-3d29-8720-4692b9d9b6c2",
                                "text": "„Die Spielkartensteuer ist aus Gründen der Steuervereinfachung und wegen ihres geringen Ertrags als Bagatellsteuer zum 1. Januar 1981 abgeschafft worden.“"
                            },
                            {
                                "example_id": "79741e47-1ad4-47e2-bd93-a82e5f3cd86e",
                                "sense_id": "ddb64c6c-499d-3d29-8720-4692b9d9b6c2",
                                "text": "„Notfalls führte man neue Steuern ein, um die Kunst (im Dienst der Politik) zu fördern, wie 1722 die Spielkartensteuer.“"
                            }
                        ],
