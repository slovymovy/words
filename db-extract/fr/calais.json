            {
                "entry_id": "221f4cdb-8cb0-3a3a-9cab-15a11df7bcf6",
                "word": "Calais",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b43d9530-c8e3-39f9-af9b-cc876feca933",
                        "entry_id": "221f4cdb-8cb0-3a3a-9cab-15a11df7bcf6",
                        "glosses": [
                            "Commune française, située dans le département du Pas-de-Calais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d54d9f-82e9-456c-b90e-cf97881c9e2c",
                                "sense_id": "b43d9530-c8e3-39f9-af9b-cc876feca933",
                                "text": "Rousret. C'est le nom qu'on donne à Calais aux folles ou bouteux qui servent à prendre des chevrettes & des sauterelles."
                            },
                            {
                                "example_id": "751f386e-51a6-4d02-90ba-372b30010a08",
                                "sense_id": "b43d9530-c8e3-39f9-af9b-cc876feca933",
                                "text": "Sans vouloir tomber ici dans le travers de ce voyageur qui écrivait sur son calepin : « Toutes les femmes de Calais sont acariâtres, rousses et bossues », parce que l’hôtesse de son auberge réunissait ces trois défauts, nous devons dire que nous n’avons aperçu, à ces fenêtres si bien garnies de barreaux, que de charmants visages et des physionomies d’anges."
                            }
                        ]
                    },
                    {
                        "sense_id": "c048bf98-67f0-334a-868d-fc198920c43a",
                        "entry_id": "221f4cdb-8cb0-3a3a-9cab-15a11df7bcf6",
                        "glosses": [
                            "Type de dentelle (« dentelle de Calais »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049599c6-5fd7-48fa-b78f-d70bf0a56a21",
                                "sense_id": "c048bf98-67f0-334a-868d-fc198920c43a",
                                "text": "Puis elle se frappe le front, s'écrie : « Les dentelles ! et se glisse derrière le cercueil qui bloque à demi la porte du salon pour aller y saisir des Calais et des Irlandes qui sont, paraît-il, des merveilles."
                            }
                        ]
                    }
                ],
