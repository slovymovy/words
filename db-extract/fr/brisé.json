                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c8ab2f83-c112-37d4-aa7b-32f4393cd8af",
                        "entry_id": "ce6c1552-7d2b-3b72-b94a-b28aaa12e637",
                        "glosses": [
                            "Qualifie un comble qui est disposé pour y aménager plusieurs logements."
