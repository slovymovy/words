                        "cross_references": [
                            {
                                "target_word": "acephobe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80ab8a48-7b65-332a-a6e5-4544be6d24d9",
                                        "entry_id": "1281d0d1-e968-32ec-8587-dad332a639bc",
                                        "glosses": [
                                            "A person who has a negative perception of asexuals and/or human asexuality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b646c51-b3c8-4d59-aeee-085ed1db15b9",
                                                "sense_id": "80ab8a48-7b65-332a-a6e5-4544be6d24d9",
                                                "text": "This is at the root of our oppression, that we are seen to be broken and then sometimes rejected by acephobes in the very community that is supposed to protect and love us, in the context of a world which feels like it doesn't always view us as fully \"human.\""
                                            },
                                            {
                                                "example_id": "cd5ff043-f18e-452b-b34b-f465a5e2c9f4",
                                                "sense_id": "80ab8a48-7b65-332a-a6e5-4544be6d24d9",
                                                "text": "It's a deep, shared denial among acephobes that creates the insistence that asexuality cannot or should not exist, and that it must therefore be \"fixed\" by them."
                                            },
                                            {
                                                "example_id": "02a578db-b205-4b90-8217-b13292f0adf7",
                                                "sense_id": "80ab8a48-7b65-332a-a6e5-4544be6d24d9",
                                                "text": "No book on how to navigate coming out as ace, or what to do after encountering an acephobe."
                                            },
                                            {
                                                "example_id": "98777692-d03f-4894-95be-b6cf2b63f998",
                                                "sense_id": "80ab8a48-7b65-332a-a6e5-4544be6d24d9",
                                                "text": "For quotations using this term, see Citations:acephobe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
