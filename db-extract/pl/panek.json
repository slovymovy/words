                        "cross_references": []
                    },
                    {
                        "translation_id": "a081190e-4e41-4549-91d8-7d45979bc835",
                        "source_entry_id": "a609dcb6-f3ff-3c4b-a429-ca620cd79106",
                        "source_sense_id": "c3c26ec4-46c7-364c-8ad3-65cfa28abddd",
                        "source_sense_description": "veraltet: junger Herr, junger Mann",
                        "target_lang_word": "junger Mann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ebaf932c-99ba-4fce-bd88-ad19e411bb6b",
                        "source_entry_id": "a609dcb6-f3ff-3c4b-a429-ca620cd79106",
                        "source_sense_id": "4f7931f1-04f6-3c20-8480-da140429ca7e",
                        "source_sense_description": "ironisch: allzu eingebildeter Mann; Bürschchen, Wichtigtuer",
                        "target_lang_word": "Bürschchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürschchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                        "entry_id": "1d1373e5-5166-3d5c-af62-07d206c05c78",
                                        "glosses": [
                                            "kleiner Bursche"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d7f734-5f7e-475f-b3a3-02af2cbd4aba",
                                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                                "text": "„»Geige spielen«, erwiderte das Bürschchen, gleichfalls ohne sein Spiel zu unterbrechen.“"
                                            },
                                            {
                                                "example_id": "212b0d28-8f96-42ac-9b5b-daa3f7b00aa4",
                                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                                "text": "„Ein mageres Bürschchen, mit eingefallenem Brustkasten, und was hält das Bürschchen unter dem Arm?“"
                                            },
                                            {
                                                "example_id": "7439c446-0631-4d0d-92ab-e758f3c93e8c",
                                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                                "text": "„Mit dem Gewehrkolben traktierte ein junger Cop das Kinn eines Bürschchens, das gar nicht geplündert hatte und nur hinter den Flüchtenden hergezockelt war.“"
                                            },
                                            {
                                                "example_id": "eaafc4f2-0381-49f3-828e-26dfa81bcb8b",
                                                "sense_id": "b7fde185-ba80-381a-8d3c-0c7ff708ef4d",
                                                "text": "„Seht euch das an, in dem Bürschchen erwacht die sexuelle Neugier, sagten sie in meiner Familie, als ich mit zwölf anfing, in den Büchern von Kristmann Guđmundsson zu lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d781f24-3e4b-482d-948b-e1eda1727310",
                        "source_entry_id": "a609dcb6-f3ff-3c4b-a429-ca620cd79106",
                        "source_sense_id": "4f7931f1-04f6-3c20-8480-da140429ca7e",
                        "source_sense_description": "ironisch: allzu eingebildeter Mann; Bürschchen, Wichtigtuer",
                        "target_lang_word": "Wichtigtuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wichtigtuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                                        "entry_id": "197ec1e8-1c1f-352c-be6a-702e44d89e45",
                                        "glosses": [
                                            "jemand, der sich aufspielt; jemand, der sich selbst für wichtiger hält, als er ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642a221c-7cd2-43b6-9b8e-eaace3346e2f",
                                                "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                                                "text": "Er ist nichts weiter als ein aufgeblasener Wichtigtuer. Ignoriere ihn einfach."
                                            },
                                            {
                                                "example_id": "61ab3f1e-b402-4144-9e68-7683b6b723f4",
                                                "sense_id": "aa46deca-013a-3988-8b81-b8420f3ba7e6",
                                                "text": "„Afrika reizte mich, weil es immer noch so leer ist, so unvollendet wirkt, voller Möglichkeiten, weswegen es Wichtigtuer und Analysten anzieht, Voyeure und Hobby-Philanthropen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
