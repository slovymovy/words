    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3543404-91d5-3df4-b03b-0b28e05d085b",
                    "sense_definition": "Eine anstehende Arbeit oder Aufgabe zu Ende führen oder fertigstellen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vollenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich muss heute noch viele Aufgaben für die Schule <w>erledigen</w>."
                        },
                        {
                            "text": "Hast du die Einkäufe für das gemeinsame Abendessen schon <w>erledigt</w>?"
                        }
                    ],
                    "synonyms": [
                        "abschließen",
                        "beenden",
                        "vollenden"
                    ],
                    "common_phrases": [
                        "eine Aufgabe erledigen",
                        "die Einkäufe erledigen",
                        "Formalitäten erledigen"
                    ]
                },
                {
                    "sense_id": "005ddf2c-ef40-3dc9-bc57-8e9605d0936d",
                    "sense_definition": "Gegenstandslos werden oder sich von selbst lösen, sodass kein weiteres Handeln nötig ist.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vollenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Frage hat sich von selbst <w>erledigt</w>, weil der Termin abgesagt wurde."
                        },
                        {
                            "text": "Vielen Dank für deine Hilfe, aber das Problem hat sich bereits <w>erledigt</w>."
                        }
                    ],
                    "common_phrases": [
                        "hat sich erledigt",
                        "sich von selbst erledigen"
                    ]
                },
                {
                    "sense_id": "e0bf238f-7ac3-3f17-937b-1ff1e032ec61",
                    "sense_definition": "Jemanden gesellschaftlich, beruflich oder politisch unschädlich machen oder ruinieren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vernichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Affäre um die Spendengelder hat den Minister politisch <w>erledigt</w>."
                        },
                        {
                            "text": "Mit dieser Enthüllung wollten die Reporter den korrupten Politiker endgültig <w>erledigen</w>."
                        }
                    ],
                    "synonyms": [
                        "ausschalten",
                        "fertigmachen"
                    ],
                    "common_phrases": [
