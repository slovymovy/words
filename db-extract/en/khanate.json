                "forms": [
                    {
                        "form_id": "311dee3e-7510-4a12-865b-36a3e801b0a4",
                        "entry_id": "a3422f95-82b8-3a41-964b-011bcff4e13d",
                        "tags": [
                            "plural"
                        ],
                        "form": "Khanates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e9fec6f-7c06-384d-9e29-3b08a97e084c",
                        "entry_id": "a3422f95-82b8-3a41-964b-011bcff4e13d",
                        "glosses": [
                            "Alternative form of khanate."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "efc291de-bb62-4f58-b0b8-0464fd476799",
                                "sense_id": "8e9fec6f-7c06-384d-9e29-3b08a97e084c",
                                "text": "All towns and villages within the Khanate of Khiva shall henceforward be open to Russian trade."
                            },
                            {
                                "example_id": "c31f9f47-7ea4-44a8-88f0-a615b9e1cc37",
                                "sense_id": "8e9fec6f-7c06-384d-9e29-3b08a97e084c",
                                "text": "Russian subjects are accorded the right of possessing real property in the Khanate."
                            },
                            {
                                "example_id": "52ab5883-028c-40c0-b4d1-7d65bf824ab1",
                                "sense_id": "8e9fec6f-7c06-384d-9e29-3b08a97e084c",
                                "text": "A more important fragment of the Golden Horde is that whose history is told in the seventh chapter, namely, the Khanate of Krim, or the Crimea, which was only crushed and annexed by Russia at the end of the last century."
                            }
                        ]
                    }
