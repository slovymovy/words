                "senses": [
                    {
                        "sense_id": "2dad21c1-d859-3331-a713-1f422b1a4fb8",
                        "entry_id": "754cffa9-2508-3bfb-889b-5b2507c358b9",
                        "glosses": [
                            "żywica naturalna używana do wyrobu werniksów, pozyskiwana głównie z cyprzyka czteroklapowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12692827-4e95-4458-a991-38f89560c630",
                                "sense_id": "2dad21c1-d859-3331-a713-1f422b1a4fb8",
                                "text": "Gotowy obraz pokrył werniksem żywiczno-olejowym sporządzonym z oleju lnianego, sandaraku i mastyksu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35442388-9e4b-4eba-a0fe-1fd889260cd8",
                        "source_entry_id": "754cffa9-2508-3bfb-889b-5b2507c358b9",
                        "source_sense_id": "2dad21c1-d859-3331-a713-1f422b1a4fb8",
                        "target_lang_word": "sandarac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandarac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f58b475a-3420-31d8-8dbf-49ab424c2000",
                                        "entry_id": "02707c00-f229-3890-abcc-2164e23ff529",
                                        "glosses": [
                                            "Realgar; red sulphide of arsenic."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d6a9de5-037b-31d6-b224-a3bfcc126939",
                                        "entry_id": "02707c00-f229-3890-abcc-2164e23ff529",
                                        "glosses": [
                                            "A white or yellow resin obtained from a north African tree (Tetraclinis articulata), and pulverized for pounce; probably so called from a resemblance to the mineral."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ade15fad-c158-4a2b-9731-f4c07a8ddb3d",
                                                "sense_id": "7d6a9de5-037b-31d6-b224-a3bfcc126939",
                                                "text": "Sandarach is procured from common juniper; and incense from a juniper with yellow fruit."
                                            },
                                            {
                                                "example_id": "f5c2a8d8-5bae-430a-9b0f-d5825260d489",
                                                "sense_id": "7d6a9de5-037b-31d6-b224-a3bfcc126939",
                                                "text": "Oil was also used for making varnish, by dissolving sandarac in it, and as the 'vernysshe' which appears so frequently in accounts was always bought by the pound, the term was evidently applied to the sandarac, or other similar resinous substance."
                                            },
                                            {
                                                "example_id": "a643b6b3-c17b-4e3c-9d1b-196d0616b859",
                                                "sense_id": "7d6a9de5-037b-31d6-b224-a3bfcc126939",
                                                "text": "There would have been many gums and resins in these markets for our lute-maker to bind his wood with: sandarac resin from North African pines […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4bbb10-bb96-3899-bc5a-c10e81f2cf58",
                                        "entry_id": "02707c00-f229-3890-abcc-2164e23ff529",
                                        "glosses": [
                                            "Any tree from the genus Tetraclinis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
