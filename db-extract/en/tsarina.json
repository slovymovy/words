                "senses": [
                    {
                        "sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                        "entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "glosses": [
                            "An empress of several Eastern European countries, especially Russia, or the wife of a tsar."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff00a22-64eb-4237-8074-167b53607176",
                                "sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                                "text": "The biggest Russian czarina was Catherine the Great, a German, who incidentally made Crimea part of Russia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4556d97-bd43-49f4-afb1-5473dfd37e38",
                        "source_entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "source_sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                        "source_sense_description": "empress or wife of a tsar",
                        "target_lang_word": "carevna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carevna",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e45abad2-3865-3169-8245-cd54344098ba",
                                        "entry_id": "15c55cb3-8e7b-3505-b8cb-692a3983b4b7",
                                        "glosses": [
                                            "manželka cara"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f403e5-7415-4677-b213-9c6dc4696353",
                                                "sense_id": "e45abad2-3865-3169-8245-cd54344098ba",
                                                "text": "A uvidějí, paní Müllerová, že se dostanou i na toho cara a carevnu, a může být, nedej pánbůh, i na císaře pána, když už to začli s jeho strýcem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0abbf9b-501a-34dd-a3bb-0072245e43bc",
                                        "entry_id": "15c55cb3-8e7b-3505-b8cb-692a3983b4b7",
                                        "glosses": [
                                            "titul panovnice, například v předrevolučním Rusku či Bulharsku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd65d56-692c-44dd-afd2-eb1fd0455508",
                                                "sense_id": "a0abbf9b-501a-34dd-a3bb-0072245e43bc",
                                                "text": "Ruská carevna Kateřina nebyla však nakloněna takovým plánům, nýbrž radila k míru."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d6ff00-f523-43a8-8f79-eeaa979b76e7",
                        "source_entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "source_sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                        "source_sense_description": "empress or wife of a tsar",
                        "target_lang_word": "tsarina",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsarina",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dddef3a5-36d7-3913-8df8-f00f227426d1",
                                        "entry_id": "4d811e2c-0775-39f6-a276-ade71af98905",
                                        "glosses": [
                                            "een vrouwelijke tsaar; de vrouw van de tsaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8737e6-0e89-4edf-8140-cd7a0a5e798e",
                                                "sense_id": "dddef3a5-36d7-3913-8df8-f00f227426d1",
                                                "text": "Helen Mirren kruipt voor de miniserie Catherine the Great in de huid van de iconische Russische tsarina uit de achttiende eeuw. De serie is een samenwerking van HBO en Sky en wordt uitgezonden in vier delen, zo meldt Variety."
                                            },
                                            {
                                                "example_id": "0794533f-0d13-4220-9227-6c90aec8f0c6",
                                                "sense_id": "dddef3a5-36d7-3913-8df8-f00f227426d1",
                                                "text": "Ter ere van de verjaardag van de prinses zet museum De Hermitage in Amsterdam deze dag de deuren open voor iedereen die Catharina heet, of een afgeleide daarvan zoals Kate of Katja. Zij krijgen op vertoon van een identiteitsbewijs gratis toegang tot de tentoonstelling Catharina, de Grootste (1729-1796). Deze Catharina was tsarina van Rusland in de achttiende eeuw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39968a1c-27cf-4210-bb84-18b8e72f5e82",
                        "source_entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "source_sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                        "source_sense_description": "empress or wife of a tsar",
                        "target_lang_word": "tsarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsarine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                                        "glosses": [
                                            "Impératrice de Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b0dc07-aa39-430f-b3a1-b706023f74d4",
                                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                                "text": "Catherine II (1729-1796) est la plus grande tsarine du xviiiᵉ siècle."
                                            },
                                            {
                                                "example_id": "60650ceb-e149-43aa-ae30-4d17b3670ab9",
                                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                                "text": "La tsarine Catherine Iʳᵉ édicte, le 26 avril 1727, un décret aux motivations essentiellement financières sur « l’expulsion des youpins de Russie et sur la vérification qu’ils n’emportent pas avec eux des pièces de monnaie russes en argent et en or. »"
                                            },
                                            {
                                                "example_id": "569efe26-5d38-4bb6-8220-6a416074c27e",
                                                "sense_id": "bd650f1e-b23a-3593-b222-3cef8161bd16",
                                                "text": "Le kaiser Joseph II et la tsarine Catherine II, les césars de l’Est, se rapprochaient l’un de l’autre. Le 30 avril, la flotte arriva à Krementchouk, retardée par des vents violents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                        "entry_id": "dcb3bbeb-6c99-30e5-8fae-28a5fcb1b34d",
                                        "glosses": [
                                            "Épouse d’un tsar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e47b48b3-f8d5-4474-a875-8f4721169ec4",
                                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                                "text": "Enfermées dans le terem, gynécée tatar ou byzantin, les tsarines et les tsarevnas laissaient les tsars à la grossièreté de leur sexe. La Moscovie n’eut ni châteaux ni palais ; le Kremlin n'était qu'une forteresse et un couvent, […]."
                                            },
                                            {
                                                "example_id": "68b2b63b-47d5-44f3-b5b7-765ea2384b93",
                                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                                "text": "J’y ai vu des intérieurs modestes d’une adorable propreté, les portraits du tsar et de la tsarine de Russie, pour mon étonnement, en honneur sur les murs ; j’ai pu, dans d’autres milieux, me rendre compte de l’intelligence partout reconnue de cette race « la plus pure de l’Égypte »."
                                            },
                                            {
                                                "example_id": "7f91dccf-194d-44b9-8273-648e61fe7e89",
                                                "sense_id": "30085ec1-3f62-3358-a8ca-2b8d4870c64b",
                                                "text": "Ce portrait intime de la tsarine Alexandra (1872-1918), l’épouse allemande de Nicolas II, n’est ni l’histoire d’un règne ni une biographie traditionnelle, mais l’évocation d’une existence privée…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7717b13-5eee-4461-b313-ac11ece86205",
                        "source_entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "source_sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                        "source_sense_description": "empress or wife of a tsar",
                        "target_lang_word": "tzarine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tzarine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9af08f3-adbd-3392-a27d-ae83e851679e",
                                        "entry_id": "85afd2a4-9a10-37a8-9144-2f2346bc4506",
                                        "glosses": [
                                            "Variante orthographique de tsarine."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e19aba-22f1-4d1b-8b56-5380f6624866",
                                                "sense_id": "b9af08f3-adbd-3392-a27d-ae83e851679e",
                                                "text": "« Nounou, hé, nounou ! j’ai peur ! » J’embrasse en pleurnichant ses joues ridées et molles, je tremble… Je ne sais pas si elle dormait, mais elle se lève aussitôt, s’enveloppe dans son grand châle de laine : « Tzarine des cieux ! dit-elle, faisant un signe de croix devant sa bouche ouverte dans un bâillement, va, va, enfant de minuit ! »"
                                            },
                                            {
                                                "example_id": "f67071d4-f8da-4ab0-8ae4-88d9cb8c9135",
                                                "sense_id": "b9af08f3-adbd-3392-a27d-ae83e851679e",
                                                "text": "Un jour je lui ai demandé comment elle a appris tout ce qu’elle sait et elle m’a raconté qu’après la mort de ses parents, elle était devenue une pupille de la tzarine et a été élevée à l’institut Smolny…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbef5755-5592-4395-b5ff-db816a812b75",
                        "source_entry_id": "21282168-f3db-301f-b2bf-63e96d9bf75f",
                        "source_sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
