                        "entry_id": "802c475a-42c2-3868-a1f3-46e03b61e6cb",
                        "glosses": [
                            "benaming voor dieren uit de orde Caudata, die met vier poten en een grote staat wel op hagedissen lijken, maar daarvan verschillen door een gladde huid, zonder schubben of haren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca84f44-d2f9-4243-9844-a28be0c1ed8f",
                                "sense_id": "cbb985c8-9048-31fe-a84f-6edeeabd86ea",
                                "text": "Wij hebben salamanders in onze vijver."
                            },
                            {
                                "example_id": "30ec59df-aef3-4ba4-9d04-2a261a424a7d",
                                "sense_id": "cbb985c8-9048-31fe-a84f-6edeeabd86ea",
                                "text": "Een salamander neemt een duik in het heldere water."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "679b1b82-0071-4031-a43a-f49ea2d798ee",
                        "source_entry_id": "802c475a-42c2-3868-a1f3-46e03b61e6cb",
                        "source_sense_id": "cbb985c8-9048-31fe-a84f-6edeeabd86ea",
                        "source_sense_description": "benaming voor dieren uit de orde Caudata",
                        "target_lang_word": "Salamander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salamander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb24f12e-1411-399e-9e6b-4f05e86983ec",
                                        "entry_id": "1fc18601-75ea-3cb1-88ac-c6ae58b9834b",
                                        "glosses": [
                                            "Schwanzlurch ohne Flossensäume"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4bc4fa-b253-4d78-8d8e-2109d5c6d14b",
                                                "sense_id": "eb24f12e-1411-399e-9e6b-4f05e86983ec",
                                                "text": "Es gibt Salamander, die vorwiegend im Wasser leben und solche, die vorwiegend an Land leben."
                                            },
                                            {
                                                "example_id": "12a74773-928e-47a8-9e5c-4a794214d6ed",
                                                "sense_id": "eb24f12e-1411-399e-9e6b-4f05e86983ec",
                                                "text": "„Nun steckte ich gleich dem Salamander im Feuer, nach dem mich verlangt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca080b1b-38f7-3b58-8881-36780024cac4",
                                        "entry_id": "1fc18601-75ea-3cb1-88ac-c6ae58b9834b",
                                        "glosses": [
                                            "studentisches Trinkritual, bei dem alle Anwesenden ihr Glas gleichzeitig leeren und anschließend gleichzeitig auf bestimmte Art auf den Tisch aufsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abc7b33-730b-486c-bdb1-1170c097045b",
                                                "sense_id": "ca080b1b-38f7-3b58-8881-36780024cac4",
                                                "text": "„Ad exercitium salamandri!“ - übersetzt: Zur Ausführung des Salamanders!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b67633e-ad7c-3453-9f31-9deb90feeb7e",
                                        "entry_id": "1fc18601-75ea-3cb1-88ac-c6ae58b9834b",
                                        "glosses": [
                                            "Ofen mit starker Oberhitze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee716f9-8704-4e8d-85b9-de18877881ab",
                                                "sense_id": "4b67633e-ad7c-3453-9f31-9deb90feeb7e",
                                                "text": "Vor dem Servieren kommt das Gratin nochmals kurz in den Salamander."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d5e86ab-3eb9-4752-85c7-c93bf8d3cad0",
                        "source_entry_id": "802c475a-42c2-3868-a1f3-46e03b61e6cb",
                        "source_sense_id": "cbb985c8-9048-31fe-a84f-6edeeabd86ea",
                        "source_sense_description": "benaming voor dieren uit de orde Caudata",
                        "target_lang_word": "salamander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salamander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abcc492a-ffea-38f0-a273-89a31666ffe5",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A long, slender, chiefly terrestrial amphibian of the order Caudata, superficially resembling a lizard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c29b8c7-ec25-4bb7-b41d-bb50a3c6e080",
                                                "sense_id": "abcc492a-ffea-38f0-a273-89a31666ffe5",
                                                "text": "[…]and most plainly Pierius, whose words in his hieroglyphicks are these: \"Whereas it is commonly said that a salamander extinguisheth fire, we have found by experience that it is so far from quenching hot coals, that it dyeth immediately therein.\""
                                            },
                                            {
                                                "example_id": "1f3cd715-9501-4ee2-9107-07a4229d5b4f",
                                                "sense_id": "abcc492a-ffea-38f0-a273-89a31666ffe5",
                                                "text": "Devils Lake is where I began my career as a limnologist in 1964, studying the lake’s neotenic salamanders and chironomids, or midge flies.[…]The Devils Lake Basin is an endorheic, or closed, basin covering about 9,800 square kilometers in northeastern North Dakota."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffb76e20-13b6-3a4f-88a4-e95869e5c568",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A creature much like a lizard that is resistant to and lives in fire (in which it is often depicted in heraldry), hence the elemental being of fire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de42b77-af80-40aa-b3da-d040d8cde30e",
                                                "sense_id": "ffb76e20-13b6-3a4f-88a4-e95869e5c568",
                                                "text": "“Not a chance, Ranger,” Bob Mason was speaking. “This little cuss is a salamander. He's been travelling through fire all day and there isn't a blister on him. …”"
                                            },
                                            {
                                                "example_id": "63a2dd09-2018-4982-b456-c6b1d3f61540",
                                                "sense_id": "ffb76e20-13b6-3a4f-88a4-e95869e5c568",
                                                "text": "\"There is a vulgar error,\" says the author of the Brief Natural History, p. 91, \"that a salamander lives in the fire. Yet both Galen and Dioscorides refute this opinion; and Mathiolus, in his Commentaries upon Dioscorides, a very famous physician, affirms of them, that by casting of many a salamander into the fire for tryal he found it false. The same experiment is likewise avouched by Joubertus.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151441ef-49f1-373e-8444-2a7017344440",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A metal utensil with a flat head which is heated and put over a dish to brown the top."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3340af6e-adc7-4685-83ff-311f3bf3cc1f",
                                                "sense_id": "151441ef-49f1-373e-8444-2a7017344440",
                                                "text": "The salamander, a fairly long metal utensil with a flat rounded head, was left in the fire until red hot and then used to brown the top of a dish without further cooking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d820cb-ade2-38f2-be2a-bc8caefe0980",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A small broiler (North America) or grill (Britain) that heats the food from above, used in professional cookery primarily for browning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c0fec5-c59c-4e5f-84d2-d8a72bce635c",
                                                "sense_id": "45d820cb-ade2-38f2-be2a-bc8caefe0980",
                                                "text": "The chef first put the steak under the salamander to sear the outside."
                                            },
                                            {
                                                "example_id": "6f0bc448-f683-4972-aea9-7beac4bd240a",
                                                "sense_id": "45d820cb-ade2-38f2-be2a-bc8caefe0980",
                                                "text": "Overfired grills, or salamanders, can, in addition, be used for making toast and salamandering. They have the heat source above the food[…]. This may comprise sets of burners firing below refractory or metal frets, or surface combustion plaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ddfcc3a-9f3c-39fa-ae69-b0a857b7e98c",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A pouched gopher (Geomys pinetis etc.)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b19e19fe-6363-35ec-bd70-7731247b21f3",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A large poker."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd59f4e-c7fa-47a0-b307-02149807cb56",
                                                "sense_id": "b19e19fe-6363-35ec-bd70-7731247b21f3",
                                                "text": "Multitudes had little Tin Kettles in their Houses, with Small-coal kindled, to light their Pipes withal; though in some places they use Candles, in others Salamanders"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1833ed5-e8cb-31c5-a806-1442cdcd5d25",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "Solidified material in a furnace hearth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d598de8-8fbb-4690-9224-b6366838a55c",
                                                "sense_id": "c1833ed5-e8cb-31c5-a806-1442cdcd5d25",
                                                "text": "Salamander tapping is done at the salamander base, which is the bottom-most level of the liquid pool in a blast furnace hearth. A high degree of precision is required to tap the salamander base effectively"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336afda6-39f1-3b2a-a9fb-16d4af0417d2",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A portable stove used to heat or dry buildings under construction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911eddc5-487a-4457-806e-9a64aac7dca9",
                                                "sense_id": "336afda6-39f1-3b2a-a9fb-16d4af0417d2",
                                                "text": "The necessary fires alone — the salamanders and tinner's pots — had caused dozens of small blazes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a19f219-0128-355c-95fe-15f8198a755c",
                                        "entry_id": "7485ab7f-ad4d-3894-bd7f-e8f382a4cb04",
                                        "glosses": [
                                            "A fire-eater (performer who pretends to swallow fire)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salamander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c93c1888-72ef-330b-b39d-f48a40ccc1f1",
                                        "entry_id": "2d431a91-aa7f-3b9d-8db5-09aeb5a26f55",
                                        "glosses": [
                                            "To use a salamander (cooking utensil) in a cooking process."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb0d9b62-3866-45a5-adaf-b06c717e2bf0",
                                                "sense_id": "c93c1888-72ef-330b-b39d-f48a40ccc1f1",
                                                "text": "When cold, sprinkle the custard thickly with sugar and salamander it."
                                            },
                                            {
                                                "example_id": "e5b50705-9cdd-464b-8f17-3e14dc251f27",
                                                "sense_id": "c93c1888-72ef-330b-b39d-f48a40ccc1f1",
                                                "text": "Overfired grills, or salamanders, can, in addition, be used for making toast and salamandering. They have the heat source above the food […]. This may comprise sets of burners firing below refractory or metal frets, or surface combustion plaques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a966298-ad6c-456a-aaca-c6b1cdef4c86",
                        "source_entry_id": "802c475a-42c2-3868-a1f3-46e03b61e6cb",
                        "source_sense_id": "cbb985c8-9048-31fe-a84f-6edeeabd86ea",
                        "source_sense_description": "benaming voor dieren uit de orde Caudata",
                        "target_lang_word": "salamandre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salamandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bce8c5e-e21a-3b86-924c-eb47592bcc0f",
                                        "entry_id": "bfe5c402-d2c2-3cb3-b254-0512031b8e86",
                                        "glosses": [
                                            "Amphibien à quatre pieds et à longue queue à section ronde, qui fait partie des urodèles."
                                        ],
                                        "tags": [
                                            "Batrachologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e1ac56-5da1-4318-80c7-aa82b0244819",
                                                "sense_id": "1bce8c5e-e21a-3b86-924c-eb47592bcc0f",
                                                "text": "Si la salamandre entendait et la taupe voyait, aucun homme sur terre ne vivrait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b09e17-fcb3-36e2-a201-a8c6817420ed",
                                        "entry_id": "bfe5c402-d2c2-3cb3-b254-0512031b8e86",
                                        "glosses": [
                                            "Nom générique pour désigner la Salamandre terrestre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113f5b79-4a3b-42f4-82cd-13717a1a0bca",
                                                "sense_id": "c3b09e17-fcb3-36e2-a201-a8c6817420ed",
                                                "text": "La peau de la salamandre secrète une substance laiteuse toxique et corrosive qui empêche son dessèchement et la protège des prédateurs. Elle lui permet de supporter, momentanément, la chaleur en diminuant la combustion des braises… Mais rapidement, la salamandre succombe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salamandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b428673e-4a9b-3c15-bac9-1c8a48bbf9bf",
                                        "entry_id": "01e3c279-b99d-3eab-b26d-7cf141826332",
                                        "glosses": [
                                            "Animal mythique qui a la faculté de vivre dans le feu et de s’en nourrir."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63894fc-5475-4282-bd31-f7f2b9e977e2",
                                                "sense_id": "b428673e-4a9b-3c15-bac9-1c8a48bbf9bf",
                                                "text": "C’est pourtant du sein de cette fournaise, d’où la salamandre elle-même ne sortirait que calcinée, que le lendemain d’héroïques pompiers de Rouen et d’Orléans ont eu le courage et le bonheur d’arracher le double du grand livre de l’État, dont l’autre exemplaire avait, dit-on, péri la veille dans l’incendie du ministère des finances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ae88c70-f1a0-36a7-95a6-f4f9fcbae049",
                                        "entry_id": "01e3c279-b99d-3eab-b26d-7cf141826332",
                                        "glosses": [
                                            "Nom autrefois donner à l'amiante, en raison de sa résistance au feu."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "565a698f-0128-4321-8512-39aa71befffa",
                                                "sense_id": "8ae88c70-f1a0-36a7-95a6-f4f9fcbae049",
                                                "text": "Elle contient une montagne dans laquelle se trouve une matière dont on tire la salamandre, car la salamandre n'est pas un animal comme on le dit en nos pays, mais elle sort de la terre comme vous l'allez ouïr."
                                            },
                                            {
                                                "example_id": "c2bcc804-3be8-4b69-80df-900a0667c931",
                                                "sense_id": "8ae88c70-f1a0-36a7-95a6-f4f9fcbae049",
                                                "text": "La salamandre est le nom par lequel les alchimistes désignaient l'amiante, et la légende affirme que cet animal ne craint pas le feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd35445-dcc5-3092-8b17-513f48337f03",
                                        "entry_id": "01e3c279-b99d-3eab-b26d-7cf141826332",
                                        "glosses": [
                                            "Récipient que l’on portait au four."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656c02d3-0212-43f0-989c-3e70abfe8443",
                                                "sense_id": "cdd35445-dcc5-3092-8b17-513f48337f03",
                                                "text": "Non, rien, si ce n’est, avec le sifflement de la cornue étincelante, les rires moqueurs d’un salamandre qui se fait un jeu de troubler mes méditations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19ccebfd-fcd3-3793-ba44-c657b0f7a09b",
                                        "entry_id": "01e3c279-b99d-3eab-b26d-7cf141826332",
                                        "glosses": [
                                            "Meuble représentant la salamandre fantastique dans les armoiries, généralement représentée sous la forme d’un lézard à la tête contournée, crachant du feu et posée sur un brasier appelé patience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad4898b-4525-473f-9d3e-ef032800c7b1",
                                                "sense_id": "19ccebfd-fcd3-3793-ba44-c657b0f7a09b",
                                                "text": "La Société, après avoir donné un souvenir à ces antiques paroisses, a visité l’église d’Hartennes. Cet édifice, bâti en grande partie en grès qui abondent sur ce terroir, aurait un aspect assez triste, s’il ne rachetait ce défaut par un portail de la Renaissance, en pierres de taille, décoré d’une assez jolie rosace et portant des écussons et des salamandres fantastiques."
                                            },
                                            {
                                                "example_id": "2ebabd2c-5e53-45e2-86c2-91257607e9f3",
                                                "sense_id": "19ccebfd-fcd3-3793-ba44-c657b0f7a09b",
                                                "text": "Le corps de la devise de François Iᵉʳ était une salamandre dans les flammes."
                                            },
                                            {
                                                "example_id": "300c8608-ab3d-42d8-aba5-0f05bfb19816",
                                                "sense_id": "19ccebfd-fcd3-3793-ba44-c657b0f7a09b",
                                                "text": "D’azur à la salamandre d’argent dans sa patience de gueules, qui est de la commune de Belleville du Rhône → voir illustration « armoiries avec une salamandre »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salamandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c454ceb-028a-34ee-b913-2d6f71c96b15",
                                        "entry_id": "7d7cebe2-9c5f-3a9c-a14b-b5a6c1b1eb1e",
                                        "glosses": [
                                            "Appareil de cuisine, sorte de four ne possédant que le gril supérieur, permettant de cuire, mais surtout de dorer ou de gratiner un plat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                        "entry_id": "7d7cebe2-9c5f-3a9c-a14b-b5a6c1b1eb1e",
                                        "glosses": [
                                            "Poêle à combustion lente fabriqué entre 1883 et 1953 par la société Salamandre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920d74a4-115f-475d-ae05-4611f03ab073",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Le terrible hiver 40-41 vint avec toute sa rigueur. À longueur de journée, Henriette fourrait du charbon dans la vieille salamandre de dentelles noires, avec un long tuyau coudé, traversant la vaste pièce sans cheminée."
                                            },
                                            {
                                                "example_id": "4b980914-31a5-45f8-8184-b6e650d81ba8",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "On m’emmenait dans la salle à manger et ma mère m’asseyait sur ses genoux, à côté de la salamandre qu’on appelait la « Radieuse », du nom de sa marque de fabrique. Toujours craquetante de l’ardeur du charbon, la « Radieuse » était flanquée de deux longs réservoirs d’eau, qui pouvaient bien contenir chacun une dizaine de litres dont l’évaporation, sous l’influence de la chaleur, palliait la dessiccation de l’atmosphère ; la figure de femme qui était au centre —classique effigie de du genre République— justifiait ce nom féminin de « Radieuse » et faisait de l’engin une personnification du foyer domestique."
                                            },
                                            {
                                                "example_id": "dc00d46a-dfe8-4692-838a-c9cb7e25472e",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Pas de chauffage ; l’hiver, l’appartement était glacé, à l’exception du bureau où ma mère allumait une salamandre ; même l’été, c’était toujours là que je travaillais."
                                            },
                                            {
                                                "example_id": "54c430b9-c81f-4639-aaef-7f71235aba6c",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Son doux nez est mouillé, elle soupire d’aise devant la salamandre qui rougeoie."
                                            },
                                            {
                                                "example_id": "9ff5767b-632e-4943-8343-1b9f83787e96",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "[…] en hiver, le rougeoiement de la Salamandre, les claquements du mica […]"
                                            },
                                            {
                                                "example_id": "6a20e559-8875-43cb-8bb9-5c3e30ee6370",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Cette chaleur de salamandre garnie d’anthracite, c’était le Pérou… un bonheur difficile à apprécier pour les gens d’aujourd’hui qui mijotent toujours dans les 22, 25° de leur magasin et de leur bureau."
                                            },
                                            {
                                                "example_id": "0fc77d68-d36d-4f0d-88ac-b50ac655c625",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Chacun restait dans son univers ou se calfeutrait l’hiver dans sa maison, enveloppé par la chaleur bien tiède de sa cuisinière à charbon de terre ou de boulets et d’une salamandre à anthracite."
                                            },
                                            {
                                                "example_id": "15460783-5506-42ae-8e39-d13de43e3dff",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "Après le dîner, l’odeur du bois brûlant dans la salamandre invitait à la conversation."
                                            },
                                            {
                                                "example_id": "ef9bb9af-d374-4734-b274-d48b643ca4bb",
                                                "sense_id": "1aeab741-cc9a-34d4-9d91-ffc6eaeb009d",
                                                "text": "— Cabri, il y a bien un gros poêle à bois chez ton autre Mamie, Oui? et bien on appelle parfois cela aussi une salamandre, quand c’est un poêle qui peut chauffer doucement et longtemps la maison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
