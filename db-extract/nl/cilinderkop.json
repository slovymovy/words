                        "sense_id": "f63a377b-3e57-3741-a009-6ef0ea3e936e",
                        "entry_id": "2a998bce-b1f6-3065-a3ce-d90f50608e6a",
                        "glosses": [
                            "het afneembare bovendeel van een cilinder bij een verbrandingsmotor waarin o.a. de kleppen zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b7c3ab-40a5-4555-9638-e023d8815182",
                                "sense_id": "f63a377b-3e57-3741-a009-6ef0ea3e936e",
                                "text": "Opel bouwde de auto in Duitsland en stuurde deze vervolgens naar Lotus in Engeland en zij regelden de hele zaak: eerst werd de motor vervangen door een zescilinder lijnmotor met een cilinderinhoud van 3,6 liter. Die werd vervolgens voorzien van een cilinderkop met vier kleppen en twee turbo's plus intercoolers."
                            },
                            {
                                "example_id": "af1261c1-8e9a-447f-8b59-836ac5ae1181",
                                "sense_id": "f63a377b-3e57-3741-a009-6ef0ea3e936e",
                                "text": "Als er te veel onverbrande brandstof in het uitlaatsysteem komt, kan dit een katalysator kapotmaken en problemen met de verbranding kunnen bijvoorbeeld leiden tot defecte kleppen in de cilinderkop."
                            }
                        ]
                    }
