                "senses": [
                    {
                        "sense_id": "91eab0d3-f264-3297-8248-9efe397c3bb7",
                        "entry_id": "b3c482a2-9877-3a8e-8537-15173c5c07c1",
                        "glosses": [
                            "podyachy"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3a0393b5-149b-47c6-80ef-968e81f7d92b",
                                "sense_id": "91eab0d3-f264-3297-8248-9efe397c3bb7",
                                "text": "Он с ю́ношескою впечатли́тельностью вслу́шивался в расска́зы отца́ и това́рищей его́ о ра́зных гражда́нских и уголо́вных дела́х, о любопы́тных слу́чаях, кото́рые проходи́ли че́рез ру́ки всех э́тих подья́чих ста́рого вре́мени.",
                                "translation": "Brimming with youthful impressionability, he listened to the stories of his father and his father’s friends about various civil and criminal cases and the curious incidents that passed through the hands of all these old-time copyists.",
                                "english": "Brimming with youthful impressionability, he listened to the stories of his father and his father’s friends about various civil and criminal cases and the curious incidents that passed through the hands of all these old-time copyists."
                            }
                        ]
