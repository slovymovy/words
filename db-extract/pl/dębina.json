                                                "example_id": "73658204-bde8-455c-aa51-b009885c307b",
                                                "sense_id": "ff306f11-c9a5-3d24-886b-1e1f667823f7",
                                                "text": "„Während des warm-feuchten Klimaoptimums im gesamten Atlantikum (ca. 5000–2400 v. Chr.) breiteten sich auf Kreta lichte Eichenwälder aus.“"
                                            },
                                            {
                                                "example_id": "672f0eb8-b155-4e6f-86c6-c8bc5bb6c0db",
                                                "sense_id": "ff306f11-c9a5-3d24-886b-1e1f667823f7",
                                                "text": "„Eben noch hatte Albrecht seine Pfeife geraucht und von den westfälischen Eichenwäldern erzählt, nun lag er mit den anderen links neben dem Scheunentor!“"
                                            },
                                            {
                                                "example_id": "639223a2-d746-4612-bca2-1bef1c9fcb7e",
                                                "sense_id": "ff306f11-c9a5-3d24-886b-1e1f667823f7",
                                                "text": "„Die Haine waren wohl Eichenwälder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
