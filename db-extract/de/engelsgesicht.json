                "senses": [
                    {
                        "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                        "entry_id": "db81b12d-eda5-3815-8b16-6ed70ac82144",
                        "glosses": [
                            "sehr schönes, engelsgleiches Gesicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17afc31b-bfc6-4805-a493-3872939e36fb",
                                "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                                "text": "„Es gibt einen Gewinnergriff, der jemandem gerade so viel Luft lässt, dass er nicht ohnmächtig wird, und in jener Nacht im Fight Club drosch ich auf unseren Neuling, auf dieses wunderschöne Engelsgesicht ein, zuerst mit den harten Knöcheln meiner Faust, wie ein mahlender Backenzahn, dann mit dem stumpfen Ende der Faust, als meine Knöchel von den Zähnen, die durch seine Lippen ragten, wundgeschlagen waren.“"
                            },
                            {
                                "example_id": "03d5ae0c-5d20-4463-9ffb-559d072d7b1c",
                                "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                                "text": "„Der mächtige Ire mit dem Engelsgesicht legt ein stämmiges Bein auf den Schreibtisch und betrachtet die drei roten Einträge unter seinem Namensschild.“"
                            },
                            {
                                "example_id": "4267e1ee-029b-43bc-be13-38a81b3a9cbb",
                                "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                                "text": "„Es war ein regnerischer Samstagnachmittag und Stacie kam herein; triefend nass, aber mit einem strahlenden Lächeln auf ihrem süßen Engelsgesicht.“"
                            },
                            {
                                "example_id": "44e86032-d151-4a9e-a8a6-286015ef16ce",
                                "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                                "text": "„Die Polizisten nannten ihn einen Dämon mit Engelsgesicht.“"
                            },
                            {
                                "example_id": "e92cfa95-1010-437a-a7e2-3d47fa503d87",
                                "sense_id": "33fa839c-1c4a-3416-b82a-ffb277f827c9",
                                "text": "„Doch nun wurde er zum Gospelsänger, und schon am ersten Tag wurde er auf Melinda aufmerksam, eine schöne Frau mit einem Engelsgesicht, das ihm über die Köpfe der Tenöre hinweg zulächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
