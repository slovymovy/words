                "senses": [
                    {
                        "sense_id": "b3f36bdc-5da7-30e2-a107-ec6c955c0bfa",
                        "entry_id": "73e460f7-35c5-3ebd-8f58-540d5ffe1df5",
                        "glosses": [
                            "Nom d’Hercule dont on se sert pour désigner un homme très fort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd722f0-c6f4-415e-ac7a-15d9c8df471e",
                                "sense_id": "b3f36bdc-5da7-30e2-a107-ec6c955c0bfa",
                                "text": "Socquard, alcide de naissance, pouvait porter onze cents pesant ; son coup de poing, appliqué dans le dos d’un homme, lui cassait net la colonne vertébrale ; il tordait une barre de fer, il arrêtait une voiture attelée d’un cheval."
                            },
                            {
                                "example_id": "e808f1d5-9537-41b3-b771-43c54861ea76",
                                "sense_id": "b3f36bdc-5da7-30e2-a107-ec6c955c0bfa",
                                "text": "En vertu du même privilège, ils ne se mêlent point avec le vulgaire, ils entrent à part, restent entre eux, s’emparent d’un intermède tout entier, et exécutent des groupes, des combats et des cabrioles pareils à ceux des alcides, moins la force, et à ceux des bédouins moins la légèreté."
                            }
                        ]
                    },
