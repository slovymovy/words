{
    "word_family": [
        "wassen",
        "aanwas",
        "opwassen",
        "bewas"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36527f01-b539-38b3-b056-ae8187f86b3e",
                    "sense_definition": "een groep planten van dezelfde soort die op een stuk land worden verbouwd voor de oogst",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer hoopt dit jaar op een goede opbrengst van het <w>gewas</w> op zijn land.",
                            "target_lang_translations": {
                                "en": "The farmer is hoping for a good yield from the <w>crop</w> on his land this year."
                            }
                        },
                        {
                            "text": "Door de extreme droogte is een groot deel van het <w>gewas</w> op de velden verloren gegaan.",
                            "target_lang_translations": {
                                "en": "Due to the extreme drought, a large part of the <w>crop</w> in the fields has been lost."
                            }
                        }
                    ],
                    "synonyms": [
                        "oogst",
                        "beplanting"
                    ],
                    "common_phrases": [
                        "het gewas beschermen",
                        "een gezond gewas"
                    ],
                    "target_lang_definitions": {
                        "en": "a group of plants of the same species grown on a piece of land for harvesting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crop",
                                "target_lang_sense_clarification": "plants grown for food or profit"
                            },
                            {
                                "target_lang_word": "harvest",
                                "target_lang_sense_clarification": "the yield of a crop"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2a5110d-82ee-34bf-a2c2-470cccd19cc5",
                    "sense_definition": "alles wat op een bepaalde plek groeit aan planten of vegetatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit natuurgebied vind je een zeer gevarieerd <w>gewas</w> dat nergens anders voorkomt.",
                            "target_lang_translations": {
                                "en": "In this nature reserve, you will find very varied <w>vegetation</w> that occurs nowhere else."
                            }
                        },
                        {
                            "text": "Het dichte <w>gewas</w> langs de rivier maakte het lastig om de oever te bereiken.",
                            "target_lang_translations": {
                                "en": "The dense <w>growth</w> along the river made it difficult to reach the bank."
                            }
                        }
                    ],
                    "synonyms": [
                        "vegetatie",
                        "plantengroei"
                    ],
                    "common_phrases": [
                        "weelderig gewas",
                        "dicht gewas"
                    ],
                    "target_lang_definitions": {
                        "en": "all the plants or vegetation growing in a particular place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vegetation",
                                "target_lang_sense_clarification": "plants collectively in an area"
                            },
                            {
                                "target_lang_word": "growth",
                                "target_lang_sense_clarification": "plants that have grown in a specific spot"
                            },
                            {
                                "target_lang_word": "foliage",
                                "target_lang_sense_clarification": "plant leaves collectively"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}