            {
                "entry_id": "b2fdd605-eb6a-30c7-9802-da01bce09a31",
                "word": "Airbnb",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bf31fec3-ad4f-4416-972b-e6b87f8723e1",
                        "entry_id": "b2fdd605-eb6a-30c7-9802-da01bce09a31",
                        "tags": [
                            "plural"
                        ],
                        "form": "Airbnbs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e0aa19a-2d85-34a3-a0d5-26fbcc6328be",
                        "entry_id": "b2fdd605-eb6a-30c7-9802-da01bce09a31",
                        "glosses": [
                            "The system of renting out apartments by means of an intermediary website, popularized by the company of the same name."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0fb7c275-4996-4fc8-8f28-cefae6fc3df0",
                                "sense_id": "1e0aa19a-2d85-34a3-a0d5-26fbcc6328be",
                                "text": "It's more of an Airbnb model than a proper let."
                            },
                            {
                                "example_id": "4c4b20e1-1645-451e-a980-991b1f38c19b",
                                "sense_id": "1e0aa19a-2d85-34a3-a0d5-26fbcc6328be",
                                "text": "Congratulations, you're fully qualified to be part of the Airbnb revolution! Whether you're looking to start hosting your property or want to grow your existing reputation and profits, this is the perfect destination for you."
                            },
                            {
                                "example_id": "1ddddf82-63ca-41f3-9f3b-dbcc1aa74eb4",
                                "sense_id": "1e0aa19a-2d85-34a3-a0d5-26fbcc6328be",
                                "text": "The market space in Airbnb is becoming more competitive as big money players are entering the game of home-sharing."
                            }
                        ]
                    },
                    {
                        "sense_id": "45140ba6-a995-30a3-95bb-f05f47bb86cc",
                        "entry_id": "b2fdd605-eb6a-30c7-9802-da01bce09a31",
                        "glosses": [
                            "An apartment offered for renting by means of this system."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ffc464fa-c0dd-40b3-8ad2-1dc12ece1a69",
                                "sense_id": "45140ba6-a995-30a3-95bb-f05f47bb86cc",
                                "text": "I am staying at an Airbnb for the summer."
                            },
                            {
                                "example_id": "96958423-4e96-4782-bae3-22e660ef8c0e",
                                "sense_id": "45140ba6-a995-30a3-95bb-f05f47bb86cc",
                                "text": "The thought of turning it into an Airbnb had crossed my mind – albeit only fleetingly."
                            },
                            {
                                "example_id": "fe41b78a-d40c-47b8-aad0-33c59d7bb790",
                                "sense_id": "45140ba6-a995-30a3-95bb-f05f47bb86cc",
                                "text": "I'd found an Airbnb not far from the university and, after a quick nap, met up again with Trudy, who had promised to show me the Regina ropes."
                            },
                            {
                                "example_id": "b7930caf-7e4f-4d05-be38-d8d60783c3f4",
                                "sense_id": "45140ba6-a995-30a3-95bb-f05f47bb86cc",
                                "text": "Tasteful, from a high-end store, not standard-issue teenager stuff. It was like they were living in a hotel or an Airbnb."
                            }
                        ]
                    }
                ],
