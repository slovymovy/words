                ],
                "senses": [
                    {
                        "sense_id": "2031319e-fcc0-3900-9460-02db6dd99c26",
                        "entry_id": "58658391-ccd9-3811-bb48-cfa5fab83a74",
                        "glosses": [
                            "Redonner son caractère agricole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d204df3e-2d94-4826-95a9-51b537aa1a1b",
                                "sense_id": "2031319e-fcc0-3900-9460-02db6dd99c26",
                                "text": "On n'arrivera pas à réindustrialiser la France d'aujourd'hui, de même qu'on ne pouvait « réagricoliser » celle des années 1900, mais on peut faire davantage pour lui permettre d'entrer pleinement dans l'aire post industrielle."
                            },
                            {
                                "example_id": "d458b0dd-32df-47ef-9f01-4a6d5f88adc4",
                                "sense_id": "2031319e-fcc0-3900-9460-02db6dd99c26",
                                "text": "Cependant, les cultures en villes resteront marginales, il ne s'agit pas de « réagricoliser » tout le chantier urbain."
                            }
                        ]
                    }
                ],
