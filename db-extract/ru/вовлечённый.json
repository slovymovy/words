                                        "sense_id": "52a508f7-8626-329d-957f-9b11e1700fc3",
                                        "entry_id": "5321532a-b401-3914-85f0-3e88775b035c",
                                        "glosses": [
                                            "Complicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4cdb732-1e75-44b1-bedb-8a172786f034",
                                                "sense_id": "52a508f7-8626-329d-957f-9b11e1700fc3",
                                                "text": "He related an involved story about every ancestor since 1895."
                                            },
                                            {
                                                "example_id": "08999787-acb5-461a-9a9d-652b19e56a80",
                                                "sense_id": "52a508f7-8626-329d-957f-9b11e1700fc3",
                                                "text": "Miss Price told him a long, involved story, which made out that Mrs. Otter, a humdrum and respectable little person, had scabrous intrigues."
                                            },
                                            {
                                                "example_id": "f736e91e-4c29-43eb-ba99-e63e1fd0d473",
                                                "sense_id": "52a508f7-8626-329d-957f-9b11e1700fc3",
                                                "text": "E-commerce has turned even the laying of a floor into a fiendishly involved business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea05aed1-3388-3cbf-b362-d4281200e5f2",
                                        "entry_id": "5321532a-b401-3914-85f0-3e88775b035c",
                                        "glosses": [
                                            "Associated with others, be a participant or make someone be a participant (in a crime, process, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56937d6b-e59d-4ba1-ac8c-3ac57f7a3fe8",
                                                "sense_id": "ea05aed1-3388-3cbf-b362-d4281200e5f2",
                                                "text": "The people involved in the project for three years."
                                            },
                                            {
                                                "example_id": "0c5a9c1e-3265-4761-a128-2596ee1e09e2",
                                                "sense_id": "ea05aed1-3388-3cbf-b362-d4281200e5f2",
                                                "text": "He got/was involved in a bar fight."
                                            },
                                            {
                                                "example_id": "d0563b65-5ed2-4e1e-b2d4-46e8cdc8d9ae",
                                                "sense_id": "ea05aed1-3388-3cbf-b362-d4281200e5f2",
                                                "text": "When the family wrapped up my father's will, no one tried to make me feel involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d57972-da9e-3cc5-bf3d-3db52f8e591d",
                                        "entry_id": "5321532a-b401-3914-85f0-3e88775b035c",
                                        "glosses": [
                                            "Having an affair with someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0721395d-29c3-4f33-9180-de78541dde45",
                                                "sense_id": "96d57972-da9e-3cc5-bf3d-3db52f8e591d",
                                                "text": "She has been happily involved with the same woman for almost three years. During that time, they have grown together, dealt well with their problems and have worked consistently for a loving and trusting relationship."
                                            }
