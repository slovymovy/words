                                        "examples": [
                                            {
                                                "example_id": "00d8430e-247d-4b54-a8f5-f7395de8b10d",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Les lieux qui forment le département des Ardennes, considérés géologiquement, sont constitués par le terrain ardoisier au nord, le terrain calcaire jurassique au milieu, le terrain crétacé au midi."
                                            },
                                            {
                                                "example_id": "6a2ab979-cbe1-49ae-b379-376a4e57768d",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Géologiquement parlant, ces puissantes gibbosités [pics des Alpes] sont le produit d’un entre-croisement d’au moins deux dislocations."
                                            },
                                            {
                                                "example_id": "6e42015e-706c-4f04-8db1-8c75adbb6025",
                                                "sense_id": "ad290968-30ec-3f0c-b7e6-365000400127",
                                                "text": "Il se peut que, géologiquement parlant, ce jour ne doit pas être très éloigné."
                                            }
                                        ]
