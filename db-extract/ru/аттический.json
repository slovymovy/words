                                "target_senses": [
                                    {
                                        "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                        "entry_id": "dc57053f-7dda-361c-991d-97865e3a245c",
                                        "glosses": [
                                            "Étage placé au sommet ou au milieu d’un édifice, de proportions moindres que les étages supérieurs ou inférieurs, séparé par une corniche du reste de la construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d620e54c-883f-42b4-90f6-ecfb2202fee0",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "… deux pavillons d’angles décorés de pilastres et d’attiques."
                                            },
                                            {
                                                "example_id": "40b13ff5-a943-49e6-8856-0c9391cacd8f",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "[…]: le rez-de-chaussée avec arcades et bossages, l’étage noble, l’attique enfin, surbaissé et à fenêtres carrées."
                                            },
                                            {
                                                "example_id": "27b54580-30d0-43dc-8f33-5199a5b93787",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "Rome est une ville “renversante” – à voir aussi de bas en haut, comme New York : corniches lointaines des palazzi romains, attiques inaccessibles – ce peuple de statues à l’extrémité de certaines terrasses (à Saint-Jean-de-Latran, Saint-Pierre, sur les palais du Capitole) - ; plafonds élevés où, dans le prolongement des colonnes et pilastres, des architectures peintes ouvrent sur de faux ciels, ceux de Saint-Ignace dans l’apothéose d’Ignace de Loyola, peinte par Pozzo, ceux du palais Barberini dus à Pierre de Cortone, ou encore ceux de Michel-Ange à la Sixtine."
                                            },
                                            {
                                                "example_id": "c74852b0-a4bb-4987-be26-22fe02bb0b96",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "Au-dessus du second ordre est un attique, un petit attique."
                                            },
                                            {
                                                "example_id": "76de2e89-a91b-4ce7-858f-1e07910e7068",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "On a couronné ce bâtiment d’un attique, pour en cacher le toit."
                                            },
                                            {
                                                "example_id": "c05af1eb-56cf-49d2-8e08-5a10e6e73536",
                                                "sense_id": "d978a1d9-429a-3d12-b8df-c080219bb4f7",
                                                "text": "L’attique du palais de Versailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc9397ee-bf98-3d6b-9dd5-cc4a146597c9",
                                        "entry_id": "dc57053f-7dda-361c-991d-97865e3a245c",
                                        "glosses": [
                                            "Ancienne dénomination du récessus épitympanique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
