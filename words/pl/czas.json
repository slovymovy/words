{
    "word_family": [
        "czasowy",
        "czasownik",
        "czasomierz",
        "tymczasowy",
        "ponadczasowy",
        "doczesny",
        "ówczesny",
        "dotychczasowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4387dcec-3bfb-376e-be8d-ffb9cfd7ef5c",
                    "sense_definition": "Nieprzerwany ciąg chwil, w którym zachodzą zdarzenia; okres trwania czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "general_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niestety nie mam teraz <w>czasu</w> na dłuższą rozmowę.",
                            "target_lang_translations": {
                                "ru": "К сожалению, у меня сейчас нет <w>времени</w> на долгий разговор.",
                                "zh": "很抱歉，我现在没有<w>时间</w>进行长谈。"
                            }
                        },
                        {
                            "text": "Z biegiem <w>czasu</w> człowiek uczy się na własnych błędach.",
                            "target_lang_translations": {
                                "ru": "С течением <w>времени</w> человек учится на собственных ошибках.",
                                "zh": "随着<w>时间</w>的推移，人会从自己的错误中学习。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mieć czas",
                        "wolny czas",
                        "szkoda czasu",
                        "brak czasu",
                        "z biegiem czasu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывная последовательность моментов, в которой происходят события; период длительности чего-либо",
                        "zh": "物质存在的一种客观形式，由过去、现在、将来构成的连绵不断的序列；事物持续的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "течение времени, досуг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "指客观存在的时间或空闲时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "979e2e61-96c3-3563-8199-4d73b59b8743",
                    "sense_definition": "Odpowiednia chwila lub moment na zrobienie czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "general_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To najwyższy <w>czas</w>, żebyśmy zaczęli przygotowania do wyjazdu.",
                            "target_lang_translations": {
                                "ru": "Уже самое <w>время</w> начать подготовку к отъезду.",
                                "zh": "现在是<w>时候</w>开始准备出发了。"
                            }
                        },
                        {
                            "text": "Wszystko wydarzyło się w sam <w>czas</w>, dzięki czemu uniknęliśmy kłopotów.",
                            "target_lang_translations": {
                                "ru": "Всё произошло как раз во<w>время</w>, благодаря чему мы избежали неприятностей.",
                                "zh": "一切发生得恰到好处，多亏了这一点我们才避免了麻烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pora",
                        "moment"
                    ],
                    "common_phrases": [
                        "najwyższy czas",
                        "czas na",
                        "w sam czas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий момент или время для совершения чего-либо",
                        "zh": "做某事的合适时机或时刻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "подходящий момент"
                            },
                            {
                                "target_lang_word": "пора",
                                "target_lang_sense_clarification": "подходящий момент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时候",
                                "target_lang_sense_clarification": "指某个特定的时刻"
                            },
                            {
                                "target_lang_word": "时机",
                                "target_lang_sense_clarification": "指做某事的合适机会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741c0360-3f2b-3ee1-bbbd-1c6992ffbbb6",
                    "sense_definition": "Kategoria gramatyczna czasownika określająca moment wykonywania czynności względem momentu wypowiedzi",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W języku polskim wyróżniamy <w>czas</w> przeszły, teraźniejszy i przyszły.",
                            "target_lang_translations": {
                                "ru": "В польском языке выделяют прошедшее, настоящее и будущее <w>время</w>.",
                                "zh": "波兰语中区分过去、现在和将来三种<w>时态</w>。"
                            }
                        },
                        {
                            "text": "Nauczyciel wytłumaczył nam, jak tworzyć <w>czas</w> przyszły złożony.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил нам, как образовывать сложное будущее <w>время</w>.",
                                "zh": "老师向我们解释了如何构成复合将来<w>时态</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "czas przeszły",
                        "czas teraźniejszy",
                        "czas przyszły"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическая категория глагола, определяющая момент действия по отношению к моменту речи",
                        "zh": "动词的一种语法范畴，表示动作发生的时间与说话时间的关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时态",
                                "target_lang_sense_clarification": "语法中的时间范畴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b76eaf79-08ce-392d-821d-8793d30e7a73",
                    "sense_definition": "Okres w historii lub w życiu człowieka, kojarzony z określonymi warunkami lub wydarzeniami",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moi dziadkowie często wspominają dawne <w>czasy</w> swojej młodości.",
                            "target_lang_translations": {
                                "ru": "Мои бабушка и дедушка часто вспоминают старые <w>времена</w> своей молодости.",
                                "zh": "我的祖父母经常回忆起他们年轻时的旧<w>时代</w>。"
                            }
                        },
                        {
                            "text": "Nadeszły ciężkie <w>czasy</w> dla małych przedsiębiorstw.",
                            "target_lang_translations": {
                                "ru": "Настали тяжелые <w>времена</w> для малых предприятий.",
                                "zh": "小企业迎来了艰难的<w>时期</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ciężkie czasy",
                        "dawne czasy",
                        "tamte czasy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период в истории или жизни человека, связанный с определенными условиями или событиями",
                        "zh": "历史或个人生活中的一段时期，常与特定的条件或事件相关联。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "времена",
                                "target_lang_sense_clarification": "исторический период, эпоха"
                            },
                            {
                                "target_lang_word": "эпоха",
                                "target_lang_sense_clarification": "исторический период"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时代",
                                "target_lang_sense_clarification": "指历史时期或阶段"
                            },
                            {
                                "target_lang_word": "时期",
                                "target_lang_sense_clarification": "指较长的一段时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1c85a7b-19df-3dc6-bf7e-e254c5cea474",
                    "sense_definition": "Wynik uzyskany w wyścigu lub innej konkurencji sportowej mierzonej zegarem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwycięzca maratonu osiągnął rekordowy <w>czas</w>.",
                            "target_lang_translations": {
                                "ru": "Победитель марафона показал рекордное <w>время</w>.",
                                "zh": "马拉松冠军取得了破纪录的<w>成绩</w>。"
                            }
                        },
                        {
                            "text": "Jego <w>czas</w> w biegu na sto metrów był lepszy niż rok temu.",
                            "target_lang_translations": {
                                "ru": "Его <w>время</w> в беге на сто метров было лучше, чем год назад.",
                                "zh": "他在百米赛跑中的<w>用时</w>比去年更好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rekordowy czas",
                        "najlepszy czas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат, полученный в гонке или другом спортивном состязании, измеряемый часами",
                        "zh": "在比赛或其他体育竞技中，通过计时器测得的成绩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "спортивный результат"
                            },
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "показатель времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成绩",
                                "target_lang_sense_clarification": "指比赛中取得的用时结果"
                            },
                            {
                                "target_lang_word": "用时",
                                "target_lang_sense_clarification": "指完成某项活动所花费的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "759c2fde-b8dc-3be8-87a1-2f0a7567c106",
                    "sense_definition": "System rachuby godzin przyjęty na danym obszarze",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ostatni weekend marca zmieniamy <w>czas</w> na letni.",
                            "target_lang_translations": {
                                "ru": "В последние выходные марта мы переходим на летнее <w>время</w>.",
                                "zh": "三月的最后一个周末，我们将<w>时间</w>调整为夏令时。"
                            }
                        },
                        {
                            "text": "Różnica między <w>czasem</w> polskim a brytyjskim wynosi jedną godzinę.",
                            "target_lang_translations": {
                                "ru": "Разница между польским и британским <w>временем</w> составляет один час.",
                                "zh": "波兰和英国的<w>时间</w>相差一小时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "czas letni",
                        "czas zimowy",
                        "strefa czasu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система исчисления часов, принятая на данной территории",
                        "zh": "在特定区域内采用的计时系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "система исчисления, часовой пояс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间",
                                "target_lang_sense_clarification": "指计时标准或时区"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fccce9c4-e8a8-3f74-99c4-3c6b4bd0b80b",
                    "sense_definition": "Jest odpowiednia pora na zrobienie czegoś (używane w funkcji orzecznika)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "predicative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Czas</w> już wracać do domu, bo robi się ciemno.",
                            "target_lang_translations": {
                                "ru": "<w>Пора</w> уже возвращаться домой, так как становится темно.",
                                "zh": "<w>该</w>回家了，因为天快黑了。"
                            }
                        },
                        {
                            "text": "Myślę, że <w>czas</w> wreszcie odpocząć po ciężkiej pracy.",
                            "target_lang_translations": {
                                "ru": "Думаю, что <w>пора</w> наконец отдохнуть после тяжелой работы.",
                                "zh": "我想，辛苦工作后终于<w>是时候</w>休息一下了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pora"
                    ],
                    "common_phrases": [
                        "czas spać",
                        "czas wracać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настал подходящий момент сделать что-то",
                        "zh": "表示做某事的时机已经到了。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пора",
                                "target_lang_sense_clarification": "настало время"
                            },
                            {
                                "target_lang_word": "время",
                                "target_lang_sense_clarification": "настало время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "该",
                                "target_lang_sense_clarification": "表示应当做某事"
                            },
                            {
                                "target_lang_word": "是时候",
                                "target_lang_sense_clarification": "表示到了做某事的时刻"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}