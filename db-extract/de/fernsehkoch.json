                                "example_id": "f829de91-8d2c-4939-a742-a75e5bd5e8c0",
                                "sense_id": "9a573e1c-2419-35eb-919f-53a85ff3a55d",
                                "text": "Kürzlich habe ich ein leckeres Rezept ausprobiert, das ich bei einem Fernsehkoch gesehen hatte."
                            },
