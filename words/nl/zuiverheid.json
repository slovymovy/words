    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "387c4620-85c0-3f3a-b668-614f7e2fab8d",
                    "sense_definition": "De toestand van volkomen schoon zijn en vrij zijn van vuil of verontreiniging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_puur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het laboratorium testte de <w>zuiverheid</w> van het drinkwater zorgvuldig.",
                            "target_lang_translations": {
                                "en": "The laboratory carefully tested the <w>purity</w> of the drinking water."
                            }
                        },
                        {
                            "text": "De uitzonderlijke <w>zuiverheid</w> van de lucht in de bergen deed ons goed.",
                            "target_lang_translations": {
                                "en": "The exceptional <w>purity</w> of the mountain air did us good."
                            }
                        }
                    ],
                    "synonyms": [
                        "reinheid",
                        "properheid"
                    ],
                    "antonyms": [
                        "onzuiverheid"
                    ],
                    "common_phrases": [
                        "de zuiverheid van water"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being completely clean and free from dirt or contamination."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purity",
                                "target_lang_sense_clarification": "freedom from contamination or pollution"
                            },
                            {
                                "target_lang_word": "cleanliness",
                                "target_lang_sense_clarification": "state of being clean"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7548816c-c58a-312e-8772-caedbc3a6227",
                    "sense_definition": "De mate waarin een stof of materiaal vrij is van vreemde bestanddelen of bijmengingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_puur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zuiverheid</w> van het goud bepaalt voor een groot deel de uiteindelijke waarde van de ring.",
                            "target_lang_translations": {
                                "en": "The <w>purity</w> of the gold largely determines the final value of the ring."
                            }
                        },
                        {
                            "text": "Onderzoekers controleerden de chemische <w>zuiverheid</w> van de geproduceerde medicijnen.",
                            "target_lang_translations": {
                                "en": "Researchers checked the chemical <w>purity</w> of the manufactured medicines."
                            }
                        }
                    ],
                    "antonyms": [
                        "onzuiverheid"
                    ],
                    "common_phrases": [
                        "de zuiverheid van goud"
                    ],
                    "target_lang_definitions": {
                        "en": "The degree to which a substance or material is free from foreign elements or admixtures."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purity",
                                "target_lang_sense_clarification": "chemical or material grade/composition"
                            },
                            {
                                "target_lang_word": "fineness",
                                "target_lang_sense_clarification": "purity of precious metals"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "290de663-a9cd-38d7-8f93-4bd18bff8fb4",
                    "sense_definition": "Het helder, logisch en zonder tegenstrijdigheden zijn van een redenering, gedachte of klank.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen bewonderde de <w>zuiverheid</w> van haar stem tijdens het concert.",
                            "target_lang_translations": {
                                "en": "Everyone admired the <w>clarity</w> of her voice during the concert."
                            }
                        },
                        {
                            "text": "De filosofische <w>zuiverheid</w> van zijn argumentatie maakte grote indruk op de zaal.",
                            "target_lang_translations": {
                                "en": "The philosophical <w>purity</w> of his argument made a great impression on the audience."
                            }
                        }
                    ],
                    "synonyms": [
                        "helderheid",
                        "duidelijkheid"
                    ],
                    "common_phrases": [
                        "de zuiverheid van een stem"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality of being clear, precise, and without distortion in reasoning, thought, or sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clarity",
                                "target_lang_sense_clarification": "clearness of sound or thought"
                            },
                            {
                                "target_lang_word": "purity",
                                "target_lang_sense_clarification": "clearness of tone or reasoning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14bfdb9b-bc34-3e7b-b0e4-5f04b5d4dc16",
                    "sense_definition": "Morele onberispelijkheid, kuisheid of oprechtheid van karakter en bedoelingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moreel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij twijfelden nooit aan de morele <w>zuiverheid</w> van zijn nobele bedoelingen.",
                            "target_lang_translations": {
                                "en": "They never doubted the moral <w>purity</w> of his noble intentions."
                            }
                        },
                        {
                            "text": "In traditionele verhalen symboliseert de lelie vaak onschuld en <w>zuiverheid</w>.",
                            "target_lang_translations": {
                                "en": "In traditional stories, the lily often symbolizes innocence and <w>purity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuisheid",
                        "onberispelijkheid"
                    ],
                    "common_phrases": [
                        "morele zuiverheid"
                    ],
                    "target_lang_definitions": {
                        "en": "Moral blamelessness, chastity, or sincerity of character and intentions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "purity",
                                "target_lang_sense_clarification": "moral innocence or virtue"
                            },
                            {
                                "target_lang_word": "chastity",
                                "target_lang_sense_clarification": "sexual or moral purity"
                            },
                            {
                                "target_lang_word": "innocence",
