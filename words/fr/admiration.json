    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65f1b38b-3f5a-3a54-8c73-45a976f3166a",
                    "sense_definition": "Sentiment de vive estime, d'émerveillement ou de respect inspiré par ce qui paraît beau, grand ou remarquable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune pianiste suscite l'<w>admiration</w> du public à chaque concert grâce à sa virtuosité."
                        },
                        {
                            "text": "Elle ressent une sincère <w>admiration</w> pour le dévouement sans faille de ces bénévoles."
                        }
                    ],
                    "synonyms": [
                        "émerveillement",
                        "vénération",
                        "estime"
                    ],
                    "antonyms": [
                        "mépris",
                        "dédain"
                    ],
                    "common_phrases": [
                        "susciter l'admiration",
                        "avoir de l'admiration",
                        "vouer une admiration",
                        "rempli d'admiration"
                    ]
                },
                {
                    "sense_id": "4178fa40-bc06-3bd2-95b2-c3b58a7324b4",
                    "sense_definition": "Action de regarder ou de contempler avec un vif plaisir ou un profond intérêt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée expose ces toiles rares à l'<w>admiration</w> de milliers de visiteurs enthousiastes."
                        },
                        {
                            "text": "Il est resté de longues minutes perdu dans l'<w>admiration</w> de ce paysage grandiose."
                        }
                    ],
                    "synonyms": [
                        "contemplation"
                    ],
                    "common_phrases": [
                        "offrir à l'admiration",
                        "livrer à l'admiration"
                    ]
                },
                {
                    "sense_id": "fe4d75c8-a6b2-3be9-82c4-1032d794ae3f",
                    "sense_definition": "Personne ou objet qui est la cause ou le sujet de ce sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur classique est depuis toujours la grande <w>admiration</w> de ce jeune poète."
                        },
                        {
                            "text": "Avec les années, il est resté fidèle à ses anciennes <w>admirations</w> artistiques de jeunesse."
                        }
                    ],
                    "synonyms": [
                        "idole"
                    ],
                    "common_phrases": [
                        "vieilles admirations",
                        "objet d'admiration"
                    ]
                }
            ]
        }
    ]
