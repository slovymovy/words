                        "entry_id": "04c56052-735f-344e-98ba-767d2fb317a4",
                        "glosses": [
                            "A small, slender piece of wood or cardboard serving as a component of a match."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ae63996-8fb0-4393-9d39-d9b7eb53dad1",
                                "sense_id": "e932c663-63e7-3ff1-afa1-c61214e04874",
                                "text": "A piece of wood or cardboard becomes a matchstick once the end has been dipped in a sulfurous compound to turn it into a complete match."
                            }
                        ]
                    },
                    {
                        "sense_id": "085701ec-f78b-3544-a725-99ccfaf186d2",
                        "entry_id": "04c56052-735f-344e-98ba-767d2fb317a4",
                        "glosses": [
                            "Any similarly small and thin piece."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
