                                            {
                                                "example_id": "ad874a0d-1f7e-45a4-a292-4c460940917c",
                                                "sense_id": "7b4469f6-85bc-3b73-b72e-0b656d06665e",
                                                "text": "Neon in daylight is a / great pleasure, as Edwin Denby would / write, as are light bulbs in daylight. / I stop for a cheeseburger at JULIET'S / CORNER."
                                            },
                                            {
                                                "example_id": "655b5686-cbce-4acd-90f5-de6b2f160971",
                                                "sense_id": "7b4469f6-85bc-3b73-b72e-0b656d06665e",
                                                "text": "Busy Americans (many women were working and not cooking as much) were dining on foods such as deep-fried chicken, thick slices of pizza, double cheeseburgers, and big slabs of steak."
                                            }
