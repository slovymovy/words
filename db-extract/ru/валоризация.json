                        "cross_references": [
                            {
                                "target_word": "Aufwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94bae3b9-e3b9-374d-800a-a2e7d98295a5",
                                        "entry_id": "43fa4cba-d4d8-3a0c-af53-17d005371e54",
                                        "glosses": [
                                            "Vorgang der Wertsteigerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13c0a12-f799-416e-a31f-56415b3435d2",
                                                "sense_id": "94bae3b9-e3b9-374d-800a-a2e7d98295a5",
                                                "text": "„Ob es bereits bei den frühen Kulturen zu einer Aufwertung des männlichen und einer Abwertung des weiblichen Zuständigkeitsbereichs kam oder ob diese Tendenz erst seit dem bürgerlichen Familienideal im 19. und der erleichterten Hausarbeit (u. a. durch technischen Fortschritt und kleinere Familien) im 20. Jahrhundert eintrat, ist umstritten.“"
                                            },
                                            {
                                                "example_id": "ed152204-fc3f-4e7b-82a6-e58b77761267",
                                                "sense_id": "94bae3b9-e3b9-374d-800a-a2e7d98295a5",
                                                "text": "„Muhammad Iqbal und Muhammad Ali Jinnah, die als Gründungsväter Pakistans gelten, sprachen sich stets für eine Förderung von Frauen und die Aufwertung ihrer Rolle in der Gesellschaft durch mehr Bildung und Chancengleichheit aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41c2482b-063a-4c9f-95a0-6f0e90456854",
                        "source_entry_id": "e4bb21ce-163e-3bd4-b793-2901969cd3f3",
                        "source_sense_description": "повышение цены",
                        "target_lang_word": "waloryzacja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51f0ced8-a58b-46cc-98ed-0e6721465971",
                        "source_entry_id": "e4bb21ce-163e-3bd4-b793-2901969cd3f3",
                        "source_sense_description": "повышение цены",
                        "target_lang_word": "valorisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valorisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d577cf78-a96f-369c-a208-eae5e0e36659",
                                        "entry_id": "43f2ff3c-e81b-33c4-8fc8-fa50cb5c58ab",
                                        "glosses": [
                                            "Action de mettre en valeur quelque chose ou quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be1733a-3a9b-4d52-8e2e-711606687cff",
                                                "sense_id": "d577cf78-a96f-369c-a208-eae5e0e36659",
                                                "text": "La valorisation du patrimoine juif est un processus de grande ampleur en Catalogne où la restauration des calls (nom hébreu désignant les quartiers juifs au Moyen Âge) et la récupération des témoignages du passé, ont donné des résultats notoires."
                                            },
                                            {
                                                "example_id": "ea2d5ed0-16ab-4ea5-af8f-ea383d503491",
                                                "sense_id": "d577cf78-a96f-369c-a208-eae5e0e36659",
                                                "text": "La stylique ou design est la valorisation esthétique d'un produit. Elle allie fonctionnalité et beauté. C'est un aspect fondamental lors de la mise en marché du produit."
                                            },
                                            {
                                                "example_id": "d262d41f-aede-4baa-a5d5-495c4bdfb4e1",
                                                "sense_id": "d577cf78-a96f-369c-a208-eae5e0e36659",
                                                "text": "Les trumpistes extrêmes ont l’impression d’avoir compris une vérité profonde qui échappe à la majorité. Cette seule conviction leur fournit la valorisation dont ils ont besoin pour s’enfoncer davantage dans le délire."
                                            },
                                            {
                                                "example_id": "5bb66a00-3e7c-4edf-96c1-bb7311de4607",
                                                "sense_id": "d577cf78-a96f-369c-a208-eae5e0e36659",
                                                "text": "Il avait d'ailleurs une manière étrange de les surveiller. Mais aujourd'hui, le milliardaire regrette tout ça et est favorable à la valorisation du repos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a4586e-8733-3b5a-976b-cc3cb20c7747",
                                        "entry_id": "43f2ff3c-e81b-33c4-8fc8-fa50cb5c58ab",
                                        "glosses": [
                                            "Action de valoriser, estimation de la valeur d'un bien ou d'une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66763ad0-9077-42fa-a69c-e86b55569607",
                                                "sense_id": "52a4586e-8733-3b5a-976b-cc3cb20c7747",
                                                "text": "Sur le marché du pétrole, on dit qu'on fait une valorisation spot quand cette valorisation utilise comme données d'hypothèses, les données du jour ou celle à l'instant même où cette valorisation est calculée."
                                            },
                                            {
                                                "example_id": "9381317f-adfd-47d2-97bd-7898cc51d238",
                                                "sense_id": "52a4586e-8733-3b5a-976b-cc3cb20c7747",
                                                "text": "Au total, plus de 6 000 milliards de dollars (5 474 milliards d’euros) de valorisation ont disparu en deux jours."
                                            },
                                            {
                                                "example_id": "1864951b-5305-4479-b07a-3eb3c9f296ba",
                                                "sense_id": "52a4586e-8733-3b5a-976b-cc3cb20c7747",
                                                "text": "Des trois acteurs en jeu, les investisseurs, les entreprises d’IA et les utilisateurs, les seuls à réaliser des profits sont les acteurs financiers dont les valorisations augmentent. C’est une situation de bulle typique : des plus-values élevées et des profits faibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a7b63f-75fb-32b1-8683-06da21f04c33",
                                        "entry_id": "43f2ff3c-e81b-33c4-8fc8-fa50cb5c58ab",
                                        "glosses": [
                                            "Transformation de résidus ou de sous-produits industriels alimentaires en vue de les réintroduire sur le marché à titre de nouveaux ingrédients ou comme nouveaux produits."
                                        ],
                                        "tags": [
                                            "Agroalimentaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea2b9b00-8f30-4fd0-8ac7-a57b37053456",
                                                "sense_id": "01a7b63f-75fb-32b1-8683-06da21f04c33",
                                                "text": "La valorisation de résidus agroalimentaires permet de réduire ou éliminer les coûts de disposition des résidus, tout en générant un deuxième revenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb8962c-e900-3a5c-b00b-2c1b0332cfe5",
                                        "entry_id": "43f2ff3c-e81b-33c4-8fc8-fa50cb5c58ab",
                                        "glosses": [
                                            "Nom générique des filières de traitement de déchets autres que l’enfouissement et l’abandon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf034bb-9d33-4855-be99-ce37d2e24e2e",
                                                "sense_id": "9cb8962c-e900-3a5c-b00b-2c1b0332cfe5",
                                                "text": "L’objectif fixé au niveau national est d’augmenter la quantité de déchets faisant l’objet d’une valorisation sous forme de matière, notamment organique, en orientant vers ces filières de valorisation 55 % en masse des déchets non dangereux non inertes en 2020 et 60 % en masse en 2025."
                                            },
                                            {
                                                "example_id": "5d6fea6d-b252-4936-a52c-d057d92ac4e1",
                                                "sense_id": "9cb8962c-e900-3a5c-b00b-2c1b0332cfe5",
                                                "text": "Le caractère périssable génère un risque de « stock mort », c'est-à-dire sans possibilité de commercialisation si ce n'est dans le cadre d'une valorisation des déchets."
                                            },
                                            {
                                                "example_id": "c0f22150-0afa-45e9-bc5e-9b27ed045378",
                                                "sense_id": "9cb8962c-e900-3a5c-b00b-2c1b0332cfe5",
                                                "text": "« On conserve la traçabilité de nos déchets grâce à notre outil T-Rex […], explique Thomas Gaudron, responsable de la valorisation des terres excavées à la Société du Grand Paris »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e78e55e-37c3-31cd-aeea-510a3b9c0b3b",
                                        "entry_id": "43f2ff3c-e81b-33c4-8fc8-fa50cb5c58ab",
                                        "glosses": [
                                            "Transformation de pétrole lourd ou de produits lourds en produits légers plus facilement commercialisables."
                                        ],
                                        "tags": [
                                            "Industrie pétrolière"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
