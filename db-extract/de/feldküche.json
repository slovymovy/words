                "senses": [
                    {
                        "sense_id": "e2350252-fb63-324f-a33a-3809c88300ef",
                        "entry_id": "22289a13-ff66-3085-bcfb-a11db356e32b",
                        "glosses": [
                            "Einrichtung zur Verpflegung im Freien mit Essen und Getränken, vor allem beim Militär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9533b26-9678-44e0-8774-c4b11b8a54ab",
                                "sense_id": "e2350252-fb63-324f-a33a-3809c88300ef",
                                "text": "„Ich hole Kaffee aus der Feldküche.“"
                            },
                            {
                                "example_id": "5803c7c2-dbe6-4993-91cc-e8f4d462e781",
                                "sense_id": "e2350252-fb63-324f-a33a-3809c88300ef",
                                "text": "„Am Morgen standen wir an der Feldküche herum und tranken Kaffee.“"
                            },
                            {
                                "example_id": "7a7e00f3-69ab-4298-8f37-1e0cc3264ccd",
                                "sense_id": "e2350252-fb63-324f-a33a-3809c88300ef",
                                "text": "„Zusätzlich gab es noch mobile Feldküchen und drei kleinere Einrichtungen, die kostenlos einfache, oft sehr dünne Kriegssuppe und einen Ranken Brot ausgaben.“"
                            },
                            {
                                "example_id": "06db4ed6-4405-4602-b8ff-9fc4c789e61b",
                                "sense_id": "e2350252-fb63-324f-a33a-3809c88300ef",
                                "text": "„Die requirierte Nahrung gaben sie, nachdem sie genug gegessen hatten, an die Feldküche weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
