                                "target_senses": [
                                    {
                                        "sense_id": "dac61759-4ddc-38e6-bce2-9bad834d48b8",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A device that skims.",
                                            "A sieve-like, slotted spoon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34f154d3-41be-379c-80cd-b3dc310df625",
                                        "entry_id": "66af35e6-0c11-3120-b322-336d33e6dabb",
                                        "glosses": [
                                            "A device that skims.",
                                            "A device for removing organic matter from an aquarium."
                                        ],
                                        "tags": [],
