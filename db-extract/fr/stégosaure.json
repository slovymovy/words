                                ]
                            },
                            {
                                "target_word": "estegossauro",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "c9cb22cf-985f-3d97-9f26-8d0df0d8ec12",
                                        "entry_id": "859d09ca-c5bd-399c-ba1e-6cf6e91a404e",
                                        "glosses": [
                                            "nome comum a três espécies de dinossauros quadrúpedes herbívoros (com a espécie-tipo a Stegosaurus stenops), datados do período Jurássico Superior e Cretáceo Inferior (de 156 a 140 milhões de anos atrás) e cujos fósseis foram encontrados em Portugal e nos Estados Unidos, tendo por características principais patas dianteiras curtas, presença de placas dorsais ósseas e, em algumas espécies, a existência de espigões defensivos no final da cauda"
                                        ],
                                        "tags": [
                                            "Paleontologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a39c52-f1bd-4d03-9676-e5ad77947020",
                                                "sense_id": "c9cb22cf-985f-3d97-9f26-8d0df0d8ec12",
                                                "text": "O estegossauro, membro mais conhecido dos dinossauros tireóforos, é caracterizado por uma armadura dorsal que se estende do pescoço à cauda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b39955f-ba4c-4097-b301-d6020d8c8d80",
                        "source_entry_id": "754e00d6-ca3b-31da-b7eb-33a4a7147ee1",
                        "source_sense_id": "8b34d7e8-f6a4-3193-9d64-7f9388b5af00",
                        "target_lang_word": "стегозавр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стегозавр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "94432511-9b16-3f15-9e1a-a0bc8c688944",
                                        "entry_id": "abb0f968-2333-31bd-be91-cd6c1b6dbb66",
                                        "glosses": [
                                            "зоол., палеонт. позднеюрский травоядный динозавр, благодаря шипам на хвосте и костяным пластинам на спине является одними из самых узнаваемых динозавров"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc0a45a-e585-4813-9675-a9ed45298167",
                                                "sense_id": "94432511-9b16-3f15-9e1a-a0bc8c688944",
                                                "text": "Мы встретились со стегозавром — ящером весом более пяти тонн. Он выглядит как порождение неуемной фантазии: маленькая плоская голова, огромное неуклюжее тело с выгнутой спиной, а на ней — мощные роговые щиты-пластины, и хвост, усаженный острыми костяными наростами. Кажется, перед тобой опаснейший из зверей. Но внешность обманчива: стегозавр не питался мясом и кровью, это — всего лишь травоядное животное."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
