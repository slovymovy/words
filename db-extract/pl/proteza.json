                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d597a3-f7ce-4511-9f39-5d2eccb2097f",
                                "sense_id": "4cf65180-3e62-3766-8343-e89bc9ef1cf4",
                                "text": "Proszę pomóżcie! Straciłem nogę w wypadku i zbieram na protezę!"
                            }
                        ],
