                    {
                        "translation_id": "59c88ea7-f56e-4e0d-849d-609a4579ab33",
                        "source_entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "target_lang_word": "afgrond",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afgrond",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4756c2c7-cb3a-3bce-976a-df905375c08b",
                                        "entry_id": "b614a5c7-33c5-38d9-b2c5-23d94b4b1ea3",
                                        "glosses": [
                                            "een grote steile diepte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c440f69-049f-4de4-84b0-11cd90087bdf",
                                                "sense_id": "4756c2c7-cb3a-3bce-976a-df905375c08b",
                                                "text": "Hoogtevrees is de angst in een afgrond te vallen, nietwaar?"
                                            },
                                            {
                                                "example_id": "20b371b5-1269-4263-8eed-26a31fca326d",
                                                "sense_id": "4756c2c7-cb3a-3bce-976a-df905375c08b",
                                                "text": "Waarschijnlijk wrong hij nu een arm door het kleine raam en stak een sigaret op, drie meter van de Vietnamese restauranteigenaar aan de overkant vandaan, die hem met een handgebaar groette of niet groette, afhankelijk van of hun blikken elkaar kruisten, wat de mannen het liefst vermeden - tussen hen in de smalle afgrond waarin een stroom toeristen zijn weg zocht naar de Wallen."
                                            },
                                            {
                                                "example_id": "7e70a539-3672-494a-b4b3-3ae2de4fbbd1",
                                                "sense_id": "4756c2c7-cb3a-3bce-976a-df905375c08b",
                                                "text": "Halverwege de oversteek stopte hij, keek met een grote grijns achterom, pakte zijn fototoestel en maakte een foto van de diepe afgrond en vervolgde zijn stappen naar de veiligheid van de rotsen, 20 meter verderop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "014db2b4-540f-418a-b2c8-712eced339a1",
                        "source_entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "target_lang_word": "ravijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                        "entry_id": "747d877e-c8ad-3064-ac8d-c2cb0f727a36",
                                        "glosses": [
                                            "een diepe, steile insnijding in een terrein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45cd64e7-3a94-4bf3-8670-fbcbd4abd077",
                                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                                "text": "Pas op dat je niet in het ravijn valt!"
                                            },
                                            {
                                                "example_id": "a731742e-d11d-4c32-b659-9784c9c95a90",
                                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                                "text": "Ze besloten zich vanaf een plateau in een meertje te storten. In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                                            },
                                            {
                                                "example_id": "afea71d7-4db4-4812-98b1-17525250c810",
                                                "sense_id": "9e83a71b-49fc-3014-8a16-add1b741aefb",
                                                "text": "Toen we vijf dagen later op een ochtend achter elkaar op een smalle richel langs een ravijn liepen, stopte ze opeens zo abrupt dat ik tegen haar op botste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
