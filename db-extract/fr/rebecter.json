                        "glosses": [
                            "Remettre (quelqu’un) dans un état correct, rétablir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770a1a9b-4fec-43e4-9296-f5e3306f18b8",
                                "sense_id": "1639443c-85bc-3067-b305-fa5736e29ad4",
                                "text": "Vous feriez aussi bien de trouver un docteur pour rebecter ce gars-là, dit la femme."
                            }
                        ]
                    },
                    {
                        "sense_id": "676faba2-3446-3903-b5f2-f7d9bc518606",
                        "entry_id": "3b63e3e5-7450-3a23-9997-1423a35d6c18",
                        "glosses": [
                            "Becter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
