                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3e32c78-ec13-45a4-8ed9-445cc4b9185f",
                        "source_entry_id": "fafde8e2-1272-3cf4-8979-cd1d1fddb81d",
                        "target_lang_word": "Holländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85da69da-f510-33ad-96cd-9c4b01e9da79",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "Bürger der Niederlande"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71ad5212-1474-46b8-add1-e73e86bb7b37",
                                                "sense_id": "85da69da-f510-33ad-96cd-9c4b01e9da79",
                                                "text": "Viele Holländer verbringen im Sommer in Deutschland ihren Urlaub."
                                            },
                                            {
                                                "example_id": "64a739f1-7338-442e-9d2c-259f1591519a",
                                                "sense_id": "85da69da-f510-33ad-96cd-9c4b01e9da79",
                                                "text": "„Einer trug eine große, hoch aufgebaute Teemaschine, was zweifellos bedeutete, daß Engländer oder Holländer angekommen sein mußten.“"
                                            },
                                            {
                                                "example_id": "f6572eaa-1c03-4f4e-87c0-6411e0bd2314",
                                                "sense_id": "85da69da-f510-33ad-96cd-9c4b01e9da79",
                                                "text": "„Er landete in der Stadt Amsterdam an der großen Meeresbucht, die in Holland eindringt und von den Holländern Zuidersee genannt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "265f338e-747f-3280-9828-4171ae2ff2e1",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "Bewohner der Region Holland"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f629a1e5-4f6e-39ff-9422-41dea9bf80a7",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "vierrädriges Kinderfahrzeug, das nach Art einer Draisine mit einem Handhebel angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64fbd37-6d5a-40b0-ae5c-b207dbc9fc60",
                                                "sense_id": "f629a1e5-4f6e-39ff-9422-41dea9bf80a7",
                                                "text": "„Zu häufig hatte es meine Bitten um einen Holländer, wie er dem Bruder, oder einem Roller, wie er Birgit beschert worden war, mißachtet und mich stattdessen mit einer Baumwollgarnitur aus Ägyptisch Makko oder einem Biber-Schlafanzug abgespeist, die ich zuvor in Zilli Botts Schaufenster zwischen nadelnden Tannenzweigen hatte verstauben sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "44319880-0af1-3446-acdd-d3073157e3cc",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "Käse aus Holland"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1e99a10a-19b5-328a-b44e-280aa4cfbfb1",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "scheckige kleine Kaninchenrasse"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2f809541-c1f3-376f-bc6b-778c20e78aaa",
                                        "entry_id": "77ac5bbd-83ab-3f01-9ad9-86f985b6b5c2",
                                        "glosses": [
                                            "Maschine bei der Papierherstellung aus Stoffresten (Hadern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79caac11-d144-46c4-bfb4-ff383e8b14eb",
                                                "sense_id": "2f809541-c1f3-376f-bc6b-778c20e78aaa",
                                                "text": "„Der Prozeß beginnt mit dem Füllen des Holländers mit Wasser und dem Eintragen der gekochten Hadern, worauf bei hochgestellter Walze die Rotation dieser eingeleitet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
