                ],
                "senses": [
                    {
                        "sense_id": "decb11d0-ca27-39b0-a3f5-54948bdd11b1",
                        "entry_id": "43dc22b0-4eb6-3969-b6f5-b0f711183522",
                        "glosses": [
                            "та, которая делает зло, совершает преступление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44013867-ab14-4ce5-9907-1b2cb8308bf9",
                                "sense_id": "decb11d0-ca27-39b0-a3f5-54948bdd11b1",
                                "text": "Спросили бы они Коростелёва: он знает всё и недаром на жену своего друга смотрит такими глазами, как будто она-то и есть самая главная, настоящая злодейка, и дифтерит только её сообщник."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d049cba-91dd-41a9-84cb-e2d838b572b6",
                        "source_entry_id": "43dc22b0-4eb6-3969-b6f5-b0f711183522",
                        "source_sense_id": "decb11d0-ca27-39b0-a3f5-54948bdd11b1",
                        "target_lang_word": "villain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "villain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2e6b93-1102-373a-b385-f23b5d14cff8",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "A vile, wicked person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7755ec0a-7c32-4823-aa68-ffdb23ab4103",
                                                "sense_id": "6a2e6b93-1102-373a-b385-f23b5d14cff8",
                                                "text": "Oh moſt pernicious woman! / Oh Villaine, Villaine, ſmiling damned Villaine!"
                                            },
                                            {
                                                "example_id": "eb36ea35-1628-45b7-9d7c-dff9c4940945",
                                                "sense_id": "6a2e6b93-1102-373a-b385-f23b5d14cff8",
                                                "text": "Thou ly’ſt thou ſhagge-ear’d Villaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93740700-00e4-33fc-b560-35cfe83ddb6c",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "A vile, wicked person.",
                                            "An extremely depraved person, or one capable or guilty of great crimes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f85c37c-e2e1-393a-b729-2ae3118d710e",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "A vile, wicked person.",
                                            "A deliberate scoundrel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5533417c-7b7a-3a39-878b-c667c801301e",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "A low-born, abject person."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef295b5-e058-43a6-8ee3-3da2e9ff84ad",
                                                "sense_id": "5533417c-7b7a-3a39-878b-c667c801301e",
                                                "text": "Note the preſumption of this Scythian ſlaue:\nI tel thee villaine, thoſe that lead my horſe\nHaue to their names tytles of dignitie,\nAnd dar’ſt thou bluntly cal me Baiazeth?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5190ce9a-3646-3a86-ad99-943415606fa9",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "A character who has the role of being bad, especially antagonizing the hero; an antagonist who is also evil or malevolent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456fd843-3abb-42a1-b9df-6681470ae594",
                                                "sense_id": "5190ce9a-3646-3a86-ad99-943415606fa9",
                                                "text": "Miss Phyllis Morgan, as the hapless heroine dressed in the shabbiest of clothes, appears in the midst of a gay and giddy throng; she apostrophises all and sundry there, including the villain, and has a magnificent scene which always brings down the house, and nightly adds to her histrionic laurels."
                                            },
                                            {
                                                "example_id": "63c2427e-dd09-4893-8260-53a4eed84d24",
                                                "sense_id": "5190ce9a-3646-3a86-ad99-943415606fa9",
                                                "text": "As The Dark Knight Rises brings a close to Christopher Nolan’s staggeringly ambitious Batman trilogy, it’s worth remembering that director chose The Scarecrow as his first villain—not necessarily the most popular among the comic’s gallery of rogues, but the one who set the tone for entire series."
                                            },
                                            {
                                                "example_id": "581d1b5b-fa92-46e7-a986-a79e48992d4e",
                                                "sense_id": "5190ce9a-3646-3a86-ad99-943415606fa9",
                                                "text": "In some ways, it’s a relief to see tech bros, especially AI entrepreneurs, reach full, unambiguous movie-villain status."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69575837-d8be-33ec-93c6-c9c1926ad282",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "Any opponent player, especially a hypothetical player for example and didactic purposes. Compare: hero (“the current player”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2327c56-501e-4c16-8f04-52bc9291180c",
                                                "sense_id": "69575837-d8be-33ec-93c6-c9c1926ad282",
                                                "text": "Let's discuss how to play if you are the chip leader (that is, if you have more chips than all the villains)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25fbf436-d54e-36ae-a5d7-56d0e62608b1",
                                        "entry_id": "b56b3989-7af8-3bcb-8e91-3bc9a36de9fa",
                                        "glosses": [
                                            "Archaic form of villein (“feudal tenant, peasant, serf”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
