                },
                {
                    "sense_id": "536c071a-d1d7-3510-9313-109f4178f3fc",
                    "sense_definition": "То, что создалось или возникло в результате какого-либо процесса; определенная структура или организация.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи обнаружили странное <w>образование</w> на коже пациента.",
                            "target_lang_translations": {
                                "en": "Doctors discovered a strange <w>growth</w> on the patient's skin.",
                                "tr": "Doktorlar hastanın cildinde tuhaf bir <w>oluşum</w> tespit etti.",
                                "zh": "医生在病人的皮肤上发现了一个奇怪的<w>肿块</w>。"
                            }
                        },
                        {
                            "text": "Каждое муниципальное <w>образование</w> имеет свой собственный бюджет.",
                            "target_lang_translations": {
                                "en": "Each municipal <w>entity</w> has its own budget.",
                                "tr": "Her belediye <w>birimi</w> kendi bütçesine sahiptir.",
                                "zh": "每个市政<w>单位</w>都有自己的预算。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "муниципальное образование",
                        "сложное образование",
                        "государственное образование"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that has been created or has arisen as a result of a process; a specific structure or organization.",
                        "tr": "Bir süreç sonucunda ortaya çıkan yapı, oluşum veya idari birim.",
                        "zh": "作为过程结果而产生的事物；特定的结构、组织或病理组织。"
                    },
