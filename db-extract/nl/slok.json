                                    {
                                        "sense_id": "e3756178-ab48-3486-ae3d-ebb0efca6e53",
                                        "entry_id": "dfceec72-eb62-39dc-8a70-26dffaac8b0d",
                                        "glosses": [
                                            "To drink (usually by gulping or in a greedy or unrefined manner); to quaff."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d470b1b5-0d8a-4521-96d7-adf5bf053a9d",
                                                "sense_id": "e3756178-ab48-3486-ae3d-ebb0efca6e53",
                                                "text": "That sailor can swig whisky with the best of 'em."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef82b0b-4046-30ba-a3f9-70e11a45cb4a",
                                        "entry_id": "dfceec72-eb62-39dc-8a70-26dffaac8b0d",
                                        "glosses": [
                                            "To suck."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae74fc5-02dd-47ac-9a5e-f8b43f42b098",
                                                "sense_id": "2ef82b0b-4046-30ba-a3f9-70e11a45cb4a",
                                                "text": "As sucking Colts leap when they swig the Teat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aab88ad-0c5f-3b83-bfea-254be48a99d4",
                                        "entry_id": "dfceec72-eb62-39dc-8a70-26dffaac8b0d",
                                        "glosses": [
                                            "To take up the last bit of slack in rigging by taking a single turn around a cleat, then hauling on the line above and below the cleat while keeping tension on the line."
                                        ],
                                        "tags": [],
