            {
                "entry_id": "6dd3dbbc-12f6-356b-bdd6-d2dd4989b23f",
                "word": "sylvain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc9a3606-2df9-482f-972b-cb25bf295191",
                        "entry_id": "6dd3dbbc-12f6-356b-bdd6-d2dd4989b23f",
                        "tags": [
                            "plural"
                        ],
                        "form": "sylvains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3e07ab9-b94d-3451-b0b2-7f717859c1a8",
                        "entry_id": "6dd3dbbc-12f6-356b-bdd6-d2dd4989b23f",
                        "glosses": [
                            "Divinité des forêts, dans la mythologie latine."
                        ],
                        "tags": [
                            "Mythologie romaine"
                        ],
                        "examples": [
                            {
                                "example_id": "cd72919b-24f9-4279-9839-b636d6f3bc41",
                                "sense_id": "c3e07ab9-b94d-3451-b0b2-7f717859c1a8",
                                "text": "Sur cinquante mètres de ruisseau, cinq cents baigneurs nus essaient de se laver. Ils portent tous gants et masques de hâle parmi la blancheur des peaux, et certains rougeauds font penser aux sylvains de Virgile qui se barbouillaient la face de mûres juteuses."
                            },
                            {
                                "example_id": "4a7b533b-151e-4e65-83b2-9e8969a038c4",
                                "sense_id": "c3e07ab9-b94d-3451-b0b2-7f717859c1a8",
                                "text": "[…] une scène mythologique d'Eugène Lami montrant Bacchus, Pan et Silène accompagnés de ribambelles de satyres, hémipans, aegipans, sylvains, faunes, lémures, lares, farfadets et lutins."
                            },
                            {
                                "example_id": "8d50c356-af40-4550-b6bf-eb52f203b5b2",
                                "sense_id": "c3e07ab9-b94d-3451-b0b2-7f717859c1a8",
                                "text": "Ses bandes étaient composées aussi de Satyres, Hémipans, Aegypans, Sylvains, Faunes, Lémures, Lares, Farfadets et Lutins […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c60d6626-3ca5-3ada-8e89-bf42b538a08d",
                        "entry_id": "6dd3dbbc-12f6-356b-bdd6-d2dd4989b23f",
                        "glosses": [
                            "Personne comparable au sylvain."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8ee3258d-202e-454c-8b5e-9f59a6be9ecc",
                                "sense_id": "c60d6626-3ca5-3ada-8e89-bf42b538a08d",
                                "text": "Nous nous ennuyions, nous autres, sylvains aux pieds légers, entraînés à battre le pays sans voiture, et regrettant, devant le poulet froid, nos en-cas de pain frais, d’ail et de fromage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f47bb476-1994-42a1-bb9d-9d1b70a33ba6",
                        "source_entry_id": "6dd3dbbc-12f6-356b-bdd6-d2dd4989b23f",
                        "source_sense_description": "divinité des forêts",
                        "target_lang_word": "leszy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leszy",
