                        "examples": [
                            {
                                "example_id": "a0ee5d57-bc7e-436a-978c-5c357deac266",
                                "sense_id": "eddf682d-7086-3b58-8009-fbb3e5ea76c3",
                                "text": "Verpletterend mooi, zonder dat ze iets seksbommerigs of plomps heeft, ze is niet geaffecteerd, niet speciaal bevallig of elegant, ongeveer twee kilo te zwaar voor Europese modeontwerpers die jonge anorectische jongens voor ogen hebben, ook niet vulgair à la Swimsuit Illustrated, maar trotse Amerikaanse import, het resultaat van een complex transcontinentaal project, een Latijn-Amerikaanse/Oost-Europese samenwerking"
                            }
                        ]
