                "senses": [
                    {
                        "sense_id": "144fc3ab-865e-3d8a-a0ab-bc6f0106a16c",
                        "entry_id": "c260ccfb-8c94-331c-8917-4af93214c748",
                        "glosses": [
                            "Relatif aux Francs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1dc96b-05d3-41aa-b847-dbb5eef51649",
                                "sense_id": "144fc3ab-865e-3d8a-a0ab-bc6f0106a16c",
                                "text": "Il avait composé son armée, en grande partie, de troupes gauloises et franciques."
                            }
                        ]
                    },
                    {
                        "sense_id": "802ca00b-a646-378e-857a-9b95883f0bb8",
                        "entry_id": "c260ccfb-8c94-331c-8917-4af93214c748",
                        "glosses": [
                            "Relatif aux dialectes du vieux bas allemand occidental. On parle dans ce cas plutôt de \\\"bas-francique\\"
                        ],
                        "tags": [],
                        "examples": []
