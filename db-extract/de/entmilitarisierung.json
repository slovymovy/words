                                "example_id": "785e00cd-6529-44b0-b9fe-cd0a0499bbab",
                                "sense_id": "3086c9b8-bc7b-39e0-ae98-d94e16c1d989",
                                "text": "„Die Entwilitarisierung Deutschlands war das dringlichste Anliegen der Sieger.“"
                            }
