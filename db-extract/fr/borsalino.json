                        "translation_id": "517afc14-21dc-4f2f-bf2f-95884cd6491d",
                        "source_entry_id": "0eaaf1f5-b205-3b9c-ba9f-a1a661e3bde8",
                        "source_sense_id": "281034f6-3e22-320e-82bc-e31aabc38f1d",
