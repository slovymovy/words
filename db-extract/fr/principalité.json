                ],
                "senses": [
                    {
                        "sense_id": "07dbe92c-e55c-37b2-a9ab-db4d6e994a2b",
                        "entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
                        "glosses": [
                            "Office de principal dans un collège."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7b2762-ebc5-42fb-b60a-17b276049a17",
                                "sense_id": "07dbe92c-e55c-37b2-a9ab-db4d6e994a2b",
                                "text": "Chopin rapporte un arrêt du 21 janvier 1562 qui, d'après ces principes, a décidé qu'on ne pouvoit pas se saire pourvoir d'une principalité de collège en cour de Rome, soit par prévention ou autrement."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d5a19ec-62a7-383a-8a55-41ddc82145c0",
                        "entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
                        "glosses": [
                            "Charge de cet office."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "32145644-9a50-4554-8748-15d1fecb6c02",
                                "sense_id": "4d5a19ec-62a7-383a-8a55-41ddc82145c0",
                                "text": "On remarqua une légère amélioration pendant les années suivantes, mais les bonnes études et par suite les bons élèves ne reparurent que sous la principalité de M. Berthinot, qui remplaça M. Perrineau le 4 octobre 1760."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2115358-c8e6-306a-a76a-4cb3d6629fc4",
                        "entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
                        "glosses": [
                            "Recette principale des douanes, des contributions indirectes, etc. qui centralise les fonds des recettes particulières de ces mêmes régies."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e5712313-773c-4873-83af-0867c7053d20",
                                "sense_id": "e2115358-c8e6-306a-a76a-4cb3d6629fc4",
                                "text": "Pour le commerce avec l'étranger, la principalité de Bastia est celle dont les exportations ont approché le plus des importations […]."
                            },
                            {
                                "example_id": "4f5c05a8-2819-4dd1-9fff-0346a9c5b1bf",
                                "sense_id": "e2115358-c8e6-306a-a76a-4cb3d6629fc4",
                                "text": "La principalité de Dînant comprendra, outre les bureaux qui lui seront attribués par l'article suivant, tous ceux ayant dépendu jusqu'à présent de celle de Namur, depuis Gerpinnes jusqu'à Hastier."
                            }
                        ]
                    },
                    {
                        "sense_id": "297b7d1a-89bf-3a97-a2ee-e41618770072",
                        "entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
                        "glosses": [
                            "Fait pour un anneau d'être principal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ad7f4c-81bd-4188-b0af-b4647ef0dabc",
                                "sense_id": "297b7d1a-89bf-3a97-a2ee-e41618770072",
                                "text": "Dans Q[x], étant donné deux polynômes f et g non nuls, il existe un unique couple (q,r) de polynômes tels que f = gq + r. L'existence de cette division euclidienne implique la principalité de Q[x]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f3b8976-a092-4679-aca1-5896e9b88561",
                        "source_entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
                        "source_sense_description": "histoire",
                        "target_lang_word": "headmastership",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headmastership",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eef1ecef-b2b0-338b-bb9b-76f68098a70e",
                                        "entry_id": "4f4a2680-d9ca-36a1-ab42-8e8829f83ad5",
                                        "glosses": [
                                            "The role or position of headmaster."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ab026a-3a54-4ab7-8c4e-88d4820441fa",
                                                "sense_id": "eef1ecef-b2b0-338b-bb9b-76f68098a70e",
                                                "text": "He knew where he lived, for he addressed a monthly pay cheque to him. He did not even know what disease he was suffering from. That was bad. Bad headmastership."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eef2848f-15ea-4e25-985f-c8b250cd6f46",
                        "source_entry_id": "23c57a91-9679-344d-8509-ad64cf5335e0",
