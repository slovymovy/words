                        "source_sense_id": "a27775dc-aa69-3d28-8b35-f76f023bbbd4",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Denis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
