                                    },
                                    {
                                        "sense_id": "2540449c-1890-3d39-b8ee-8199f4283132",
                                        "entry_id": "a12b26ef-cdf5-32c5-a422-30e30ef6ee49",
                                        "glosses": [
                                            "op ~ van: aangespoord door"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da54b407-b377-4e3b-8b82-ecf7d2c011a2",
                                                "sense_id": "2540449c-1890-3d39-b8ee-8199f4283132",
                                                "text": "Op instigatie van de oppositie kwam het tot een grote demonstratie die in ernstige ongeregeldheden ontaardde."
                                            }
                                        ]
