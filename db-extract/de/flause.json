                "senses": [
                    {
                        "sense_id": "ad2a5d84-7e1a-37d6-bfb8-0aa825d7c5c6",
                        "entry_id": "bfc26144-c4c1-31a4-a839-cf7e2ea3bc3e",
                        "glosses": [
                            "aberwitziger Einfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fcc415-b85e-4300-af0a-6bafd6baa36e",
                                "sense_id": "ad2a5d84-7e1a-37d6-bfb8-0aa825d7c5c6",
                                "text": "Seine Flausen verlängerten die Diskussion unnötig."
                            },
                            {
                                "example_id": "613bc3f0-25b8-4512-8fea-c06318b12fec",
                                "sense_id": "ad2a5d84-7e1a-37d6-bfb8-0aa825d7c5c6",
                                "text": "„Ich kenne keinen Menschen, der ohne diese Flausen von dem kleinen weißen Haus im Kopf auf die Insel hier oder sonst irgendwo ans Meer kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65192d99-eac9-35e3-8ced-f0f02caf6a78",
                        "entry_id": "bfc26144-c4c1-31a4-a839-cf7e2ea3bc3e",
                        "glosses": [
                            "ablenkende Flunkerei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46090309-9b59-4b0b-b655-32d876223963",
                                "sense_id": "65192d99-eac9-35e3-8ced-f0f02caf6a78",
                                "text": "Zur Erklärung hatte sie nichts als Flausen anzubieten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
