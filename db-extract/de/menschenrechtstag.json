                    {
                        "sense_id": "f9b56bd5-7bff-3747-92c7-d4a4aec96622",
                        "entry_id": "b77c01a9-d543-3e62-a635-681067878c2c",
                        "glosses": [
                            "Feiertag für die Menschenrechte, welcher am 10. Dezember (Verkündung der Allgemeinen Erklärung der Menschenrechte) gefeiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef549dbd-e2da-4ea5-928f-c0722924e208",
                                "sense_id": "f9b56bd5-7bff-3747-92c7-d4a4aec96622",
                                "text": "„Am 10. Dezember begeht die Welt den Internationalen Menschenrechtstag.“"
                            },
                            {
                                "example_id": "68bb53e6-b556-491e-a510-9d2b6ce79e2b",
                                "sense_id": "f9b56bd5-7bff-3747-92c7-d4a4aec96622",
                                "text": "„Als Teil dieses Jahresberichtes musste die sowjetische Organisation ihre Bemühungen, die Menschenrechte, den Menschenrechtstag und das Wissen über die Allgemeine Erklärung zu fördern, detailliert darlegen.“"
                            }
                        ],
