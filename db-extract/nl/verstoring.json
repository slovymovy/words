                    {
                        "translation_id": "f8281556-2d94-4d47-aea2-9d7287e73584",
                        "source_entry_id": "25c90ac0-6ff4-3a30-8abf-da0afb8fe907",
                        "source_sense_id": "79b6cddb-93aa-3313-9a17-a569e7823b39",
