                "senses": [
                    {
                        "sense_id": "2e03947e-54ad-3cd8-b8b9-80ad7789e898",
                        "entry_id": "a432a3ef-0de4-3f68-81fd-1b2f3f933704",
                        "glosses": [
                            "(hypercorrection pour amuse-gueule) Petit mets salé qui accompagne l’apéritif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3787a95c-8033-4a3f-9fa9-4a728f5d0963",
                                "sense_id": "2e03947e-54ad-3cd8-b8b9-80ad7789e898",
                                "text": "Dans les salles bourrées à craquer des restaurants du Quartier latin fréquentés par les étudiants, on se faisait servir pour quelques sous les amuse-bouches les plus succulents avant ou après un savoureux bifteck, avec en plus du vin rouge ou blanc et une longue baguette de délicieux pain blanc."
                            },
                            {
                                "example_id": "8ed9514c-ddac-4601-a83f-0c4001e51e23",
                                "sense_id": "2e03947e-54ad-3cd8-b8b9-80ad7789e898",
                                "text": "Nous avons traduit cette sensation par une poignée de pouces-pieds fumants (des crustacés) qui arrivent à table dès que l’on est assis… C’est un “amuse-bouche” et tout sauf ça."
                            }
                        ]
                    }
