                    {
                        "sense_id": "768517e5-b90a-3dcf-bae4-2222a574b443",
                        "entry_id": "e3e8b69e-5fe4-3244-a70d-27e75297af55",
                        "glosses": [
                            "A small spoon used for serving or measuring salt, equivalent to ⅛ teaspoon."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "233d40cb-5491-43cf-b092-7f6edf25d186",
                                "sense_id": "768517e5-b90a-3dcf-bae4-2222a574b443",
                                "text": "1798, Charlotte Turner Smith, The Young Philosopher, London: T. Cadell, Jun. & W. Davies, Volume 1, Chapter 3, pp. 55-56,\nHer reasons […] for disliking paupers of every description were entirely on the surface; “she hated them,” she said, “for they were nasty dirty creatures; the fellows and wenches were all thieves; she once lost a salt spoon by one of them whom Master George thought proper to bring to her door for cold victuals […] ”"
                            },
                            {
                                "example_id": "1a2b6281-e399-443a-96ed-03a0ac879cb2",
                                "sense_id": "768517e5-b90a-3dcf-bae4-2222a574b443",
                                "text": "His gleaming little service of plate was so arranged upon his sideboard as that a slack salt-spoon would have instantly betrayed itself […]"
                            },
                            {
                                "example_id": "b608a3dd-0b7a-4fcb-bbe4-e3e0da64ec6c",
                                "sense_id": "768517e5-b90a-3dcf-bae4-2222a574b443",
                                "text": "Dashed the bold fork through pies of pork;\nO’er hard-boiled eggs the saltspoon shook;"
                            },
                            {
                                "example_id": "ca6af97c-e263-4ff0-bdb5-d01c039ef9b5",
                                "sense_id": "768517e5-b90a-3dcf-bae4-2222a574b443",
                                "text": "There is no such thing as a saltspoon in Yucatan. You are expected to shake the salt out or take it out with your fingers."
                            }
                        ]
                    }
                ],
