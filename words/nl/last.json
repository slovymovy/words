    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0aff292-eede-39f6-8ac0-d09da6130503",
                    "sense_definition": "iets wat een mens hindert of ongemak veroorzaakt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb vandaag erg veel <w>last</w> van hoofdpijn door het warme weer.",
                            "target_lang_translations": {
                                "en": "I am <w>suffering</w> a lot from a headache today because of the warm weather."
                            }
                        },
                        {
                            "text": "De buren hebben vaak <w>last</w> van het lawaai van de drukke straat.",
                            "target_lang_translations": {
                                "en": "The neighbors are often <w>bothered</w> by the noise from the busy street."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder"
                    ],
                    "common_phrases": [
                        "last hebben van"
                    ],
                    "target_lang_definitions": {
                        "en": "something that hinders a person or causes discomfort"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "physical or mental discomfort"
                            },
                            {
                                "target_lang_word": "bother",
                                "target_lang_sense_clarification": "annoyance or minor hindrance"
                            },
                            {
                                "target_lang_word": "nuisance",
                                "target_lang_sense_clarification": "something causing inconvenience"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2812691-e909-3a27-965f-6f9de9be4878",
                    "sense_definition": "een zware lading of gewicht dat gedragen moet worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gewicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ezel bezweek bijna onder de zware <w>last</w> op zijn rug.",
                            "target_lang_translations": {
                                "en": "The donkey almost collapsed under the heavy <w>load</w> on its back."
                            }
                        },
                        {
                            "text": "Het schip vervoerde een kostbare <w>last</w> over de oceaan.",
                            "target_lang_translations": {
                                "en": "The ship transported a precious <w>cargo</w> across the ocean."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder"
                    ],
                    "common_phrases": [
                        "zware last"
                    ],
                    "target_lang_definitions": {
                        "en": "a heavy load or weight that must be carried"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "load",
                                "target_lang_sense_clarification": "a physical weight being carried"
                            },
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "a heavy physical load"
                            },
                            {
                                "target_lang_word": "cargo",
                                "target_lang_sense_clarification": "goods carried by a ship or vehicle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c022e735-e6cd-3718-8fd4-e2f5da89def1",
                    "sense_definition": "een mentale of morele druk die iemand ervaart",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "druk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verantwoordelijkheid voor het project was een grote <w>last</w> voor haar.",
                            "target_lang_translations": {
                                "en": "The responsibility for the project was a great <w>burden</w> for her."
                            }
                        },
                        {
                            "text": "Hij voelde een zware <w>last</w> van zijn schouders vallen na het gesprek.",
                            "target_lang_translations": {
                                "en": "He felt a heavy <w>weight</w> fall from his shoulders after the conversation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een last van de schouders"
                    ],
                    "target_lang_definitions": {
                        "en": "a mental or moral pressure that someone experiences"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burden",
                                "target_lang_sense_clarification": "a heavy emotional or mental responsibility"
                            },
                            {
                                "target_lang_word": "weight",
                                "target_lang_sense_clarification": "metaphorical pressure on one's mind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be4045fb-b850-30ff-b2b7-8aa6caaaf702",
