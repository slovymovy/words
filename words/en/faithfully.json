{
    "word_family": [
        "faith",
        "faithful",
        "faithfulness",
        "faithless",
        "faithlessness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "db456efd-a8bf-3480-98b6-2756e841ab0a",
                    "sense_definition": "In a loyal, reliable, or accurate manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyal_accurate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog followed his owner <w>faithfully</w> wherever she went.",
                            "target_lang_translations": {
                                "es": "El perro seguía a su dueña <w>fielmente</w> adondequiera que fuera."
                            }
                        },
                        {
                            "text": "The movie adaptation <w>faithfully</w> reproduced the original book.",
                            "target_lang_translations": {
                                "es": "La adaptación cinematográfica reprodujo <w>fielmente</w> el libro original."
                            }
                        }
                    ],
                    "antonyms": [
                        "unfaithfully"
                    ],
                    "common_phrases": [
                        "faithfully reproduced",
                        "serve faithfully"
                    ],
                    "target_lang_definitions": {
                        "es": "De manera leal, fiable o con exactitud respecto al original."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fielmente",
                                "target_lang_sense_clarification": "con lealtad o exactitud"
                            },
                            {
                                "target_lang_word": "con fidelidad",
                                "target_lang_sense_clarification": "de forma leal o precisa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6daa195a-91e0-3e3b-8f30-a52f15ad26ed",
                    "sense_definition": "Used as part of a formal closing formula in a letter when the recipient's name is unknown.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "epistolary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ended the formal business letter with yours <w>faithfully</w>.",
                            "target_lang_translations": {
                                "es": "Terminó la carta comercial formal con «yours <w>faithfully</w>» (<w>le saluda atentamente</w>)."
                            }
                        },
                        {
                            "text": "Because she did not know the manager's name, she signed the application yours <w>faithfully</w>.",
                            "target_lang_translations": {
                                "es": "Como no sabía el nombre del gerente, firmó la solicitud con «yours <w>faithfully</w>» (<w>atentamente</w>)."
                            }
                        }
                    ],
                    "synonyms": [
                        "yours faithfully"
                    ],
                    "common_phrases": [
                        "yours faithfully"
                    ],
                    "target_lang_definitions": {
                        "es": "Fórmula formal de despedida en cartas ('yours faithfully') cuando no se conoce el nombre del destinatario."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "atentamente",
                                "target_lang_sense_clarification": "fórmula de despedida epistolar formal"
                            },
                            {
                                "target_lang_word": "le saluda atentamente",
                                "target_lang_sense_clarification": "fórmula de cierre formal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}