                {
                    "sense_id": "65f4ed4e-a70e-3f39-9a7d-39fe8f884cc9",
                    "sense_definition": "Mieć z kimś dobre relacje, podobne poglądy i łatwość porozumiewania się (używane z zaimkiem zwrotnym „się”).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z moim bratem <w>rozumiemy</w> się bez zbędnych słów.",
                            "target_lang_translations": {
                                "ru": "Мы с братом <w>понимаем</w> друг друга без лишних слов.",
                                "en": "My brother and I <w>understand</w> each other without unnecessary words.",
                                "zh": "我和我哥哥无需多言便能<w>心有灵犀</w>。"
                            }
                        },
                        {
                            "text": "Oni <w>rozumieją</w> się nawzajem jak nikt inny w tej firmie.",
                            "target_lang_translations": {
                                "ru": "Они <w>понимают</w> друг друга как никто другой в этой фирме.",
                                "en": "They <w>understand</w> each other like no one else in this company.",
                                "zh": "在这家公司里，他们比任何人都更加<w>互相理解</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dogadywać się"
                    ],
                    "common_phrases": [
                        "rozumieć się bez słów",
                        "dobrze się rozumieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь с кем-то хорошие отношения, схожие взгляды и легкость в общении (используется с возвратным местоимением).",
                        "en": "To have good relations with someone, similar views, and ease of communication (used with a reflexive pronoun).",
                        "zh": "彼此关系融洽，观点相近且易于沟通（与反身代词连用）。"
                    },
                    "translations": {
                        "ru": [
