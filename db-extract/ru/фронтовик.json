                "senses": [
                    {
                        "sense_id": "76568423-257d-3041-816f-266dd7b11b09",
                        "entry_id": "e384a589-a593-308b-96f7-4fbdd745bdaa",
                        "glosses": [
                            "воен. военнослужащий, знаток военной службы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd0940b-b3e5-406a-9f16-04b716de1ab0",
                                "sense_id": "76568423-257d-3041-816f-266dd7b11b09",
                                "text": "Лейтенант-фронтовик, состоящий при станционной комендатуре, проверив во второй раз документы у молодоженов, поинтересовался, к кому они приехали и думают ли здесь задерживаться."
                            }
                        ]
                    },
                    {
                        "sense_id": "795b8ece-0a21-3fb0-bd57-160bb62d133d",
                        "entry_id": "e384a589-a593-308b-96f7-4fbdd745bdaa",
                        "glosses": [
                            "воен. участник фронта, военных сражений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79747a24-7d22-4c57-b0ef-f7615b480d31",
                                "sense_id": "795b8ece-0a21-3fb0-bd57-160bb62d133d",
                                "text": "Вернулся с войны еще один фронтовик ― Подберезный."
                            }
                        ]
                    }
