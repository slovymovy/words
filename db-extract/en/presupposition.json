    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                "word": "presupposition",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4b318176-f4fe-4857-9cde-9f11fcfcd01b",
                        "entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                        "tags": [
                            "plural"
                        ],
                        "form": "presuppositions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f18fc61-c55a-384f-b983-a6e6d0d18978",
                        "entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                        "glosses": [
                            "An assumption made beforehand; a preliminary conjecture or speculation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2132778d-0c44-4074-94a9-00e43ef38ad3",
                                "sense_id": "7f18fc61-c55a-384f-b983-a6e6d0d18978",
                                "text": "He made one cardinal error in his presuppositions about the relation between language and perception, but in this he was far from alone."
                            }
                        ]
                    },
                    {
                        "sense_id": "417376a7-b748-34b9-b7a1-5c84ae76bf96",
                        "entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                        "glosses": [
                            "The act of presupposing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f8397cec-e618-334f-b3d4-3bb15118d6b3",
                        "entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                        "glosses": [
                            "An assumption or belief implicit in an utterance or other use of language."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce0af188-255e-4b30-ad2f-c22a1a5f8fe7",
                                "sense_id": "f8397cec-e618-334f-b3d4-3bb15118d6b3",
                                "text": "For instance: a verb might convey someone's evaluation of it as a presupposition. To say ‘they deprived him of a visit to his parents’ presupposes that he wanted to visit (vs. ‘spare him a visit...’)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "436da0f9-9ae6-47c9-a26d-e2097ba01e2c",
                        "source_entry_id": "f6b2aeeb-6194-3bff-bd00-a9877ac15898",
                        "source_sense_description": "assumption, conjecture, speculation or something supposed without proof",
                        "target_lang_word": "veronderstelling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veronderstelling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c10ebfe8-673a-3a25-b4ff-d807bc9056ac",
                                        "entry_id": "91c385bd-591b-3627-805b-f79e76a20cbd",
                                        "glosses": [
                                            "wat verondersteld wordt; iets waarvan men denkt dat het zo is maar men niet door eigen aanschouwing weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b00517-ac01-4447-b609-655955619495",
                                                "sense_id": "c10ebfe8-673a-3a25-b4ff-d807bc9056ac",
                                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                                            },
                                            {
                                                "example_id": "98a223d8-b84e-49ef-8a9e-c49e8cb95ee3",
                                                "sense_id": "c10ebfe8-673a-3a25-b4ff-d807bc9056ac",
                                                "text": "Maar wat antwoordde mama op de vraag over Stalin? Nu, vijftien jaar later, wordt de herinnering, de hoogst onbetrouwbare herinnering, aangevuld met veronderstellingen, een soort reconstructie van wat mama geantwoord moest hebben omdat ze was wie ze was, net als wij allemaal in de familie Lauritzen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
