                "senses": [
                    {
                        "sense_id": "5fdbe0b3-9b89-3eaf-b641-861e73e1db78",
                        "entry_id": "be1646c8-01d9-3af4-9baa-72c4bcc1aa0a",
                        "glosses": [
                            "anspruchslose, minderwertige Literatur"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "d5e89ab4-d9e5-4473-b3b6-d2e7b57cda4b",
                                "sense_id": "5fdbe0b3-9b89-3eaf-b641-861e73e1db78",
                                "text": "Schon das Drehbuch zum Film war eine Kolportage, die es nicht wert war, verfilmt zu werden."
                            },
                            {
                                "example_id": "dae1abf4-2404-4562-b89c-d34e3dbc9bf3",
                                "sense_id": "5fdbe0b3-9b89-3eaf-b641-861e73e1db78",
                                "text": "„Wo der Vorwurf der Kolportage, der in unzähligen deutschen Rezensionen erhoben wird, nicht ausreicht, muß der »Nestbeschmutzer« herhalten.“"
                            },
                            {
                                "example_id": "882a03d2-493d-4579-aa91-dcedd79b939b",
                                "sense_id": "5fdbe0b3-9b89-3eaf-b641-861e73e1db78",
                                "text": "„Wieland nimmt in seinem Roman (zuerst 1789 im »Teutschen Merkur« in Fortsetzungen erschienen) die Form von Lukians »Totengesprächen« auf und lässt deren Autor und das Objekt seiner biographischen Kolportage im Elysium einander begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c428a301-9f3f-3a44-a93d-2a7cd112b113",
                        "entry_id": "be1646c8-01d9-3af4-9baa-72c4bcc1aa0a",
                        "glosses": [
                            "Verbreitung von Gerüchten"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "9e1bb2f6-a6e6-4db0-8c96-bcf4b7d8a452",
                                "sense_id": "c428a301-9f3f-3a44-a93d-2a7cd112b113",
                                "text": "Durch Verdrehung von Tatsachen streute das Blatt bewusst Gerüchte, und die meisten Leser saßen der Kolportage auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4e64a385-ff63-3bff-940a-d2959e35f517",
                        "entry_id": "be1646c8-01d9-3af4-9baa-72c4bcc1aa0a",
                        "glosses": [
                            "Bücherverkauf an der Haustür"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "62041999-4a96-4fb0-9c58-de99c5ba9238",
                                "sense_id": "4e64a385-ff63-3bff-940a-d2959e35f517",
                                "text": "Die Kolportage per se leiste für die ländliche Bevölkerung einen wichtigen Beitrag."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
