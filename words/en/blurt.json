{
    "word_family": [
        "blurting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fa551f6-2c5a-35e3-8dae-d97f82cf7580",
                    "sense_definition": "To utter something suddenly and without thinking, often revealing information that should have been kept secret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>blurted</w> out the secret before she could stop herself.",
                            "target_lang_translations": {
                                "zh": "她还没来得及控制住自己，就<w>脱口而出</w>了那个秘密。",
                                "it": "Si è <w>lasciata scappare</w> il segreto prima di riuscire a fermarsi."
                            }
                        },
                        {
                            "text": "Do not <w>blurt</w> out the answer while others are still thinking.",
                            "target_lang_translations": {
                                "zh": "当别人还在思考时，不要<w>脱口而出</w>答案。",
                                "it": "Non <w>sputare fuori</w> la risposta mentre gli altri stanno ancora pensando."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blurt out"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不假思索地突然说出某事，通常泄露了本应保密的信息。",
                        "it": "Pronunciare o rivelare qualcosa improvvisamente e senza pensare, spesso svelando informazioni che avrebbero dovuto rimanere segrete."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱口而出",
                                "target_lang_sense_clarification": "指话语未经思考突然从嘴里说出来。"
                            },
                            {
                                "target_lang_word": "失言",
                                "target_lang_sense_clarification": "指因不慎而说出不该说的话。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "lasciarsi scappare",
                                "target_lang_sense_clarification": "dire inavvertitamente qualcosa, come un segreto"
                            },
                            {
                                "target_lang_word": "sputare fuori",
                                "target_lang_sense_clarification": "dire impulsivamente qualcosa senza riflettere"
                            },
                            {
                                "target_lang_word": "farsi sfuggire",
                                "target_lang_sense_clarification": "rivelare sbadatamente parole o informazioni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3764d063-26a5-321d-b506-2edb8366913b",
                    "sense_definition": "To spurt or gush out suddenly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water <w>blurted</w> from the broken pipe in the basement.",
                            "target_lang_translations": {
                                "zh": "水从地下室破裂的管道中<w>喷涌</w>而出。",
                                "it": "L'acqua è <w>zampillata</w> dal tubo rotto nel seminterrato."
                            }
                        },
                        {
                            "text": "The old machine <w>blurted</w> oil onto the floor.",
                            "target_lang_translations": {
                                "zh": "那台旧机器将机油<w>喷溅</w>到了地板上。",
                                "it": "La vecchia macchina ha <w>schizzato</w> olio sul pavimento."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指液体或物质突然喷涌而出。",
                        "it": "Zampillare o schizzare fuori all'improvviso."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷涌",
                                "target_lang_sense_clarification": "形容液体猛烈地涌出。"
                            },
                            {
                                "target_lang_word": "迸射",
                                "target_lang_sense_clarification": "形容液体或细小物体向外飞溅。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "zampillare",
                                "target_lang_sense_clarification": "fuoriuscire a getto improvviso"
                            },
                            {
                                "target_lang_word": "schizzare",
                                "target_lang_sense_clarification": "fuoriuscire a spruzzi violenti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99502eb2-5c15-3196-8e60-87f6f86efec4",
                    "sense_definition": "An abrupt and thoughtless outburst of speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>blurt</w> surprised everyone in the quiet room.",
                            "target_lang_translations": {
                                "zh": "他突然的<w>脱口之言</w>让安静房间里的每个人都感到惊讶。",
                                "it": "La sua improvvisa <w>uscita</w> sorprese tutti nella stanza silenziosa."
                            }
                        },
                        {
                            "text": "She regretted the <w>blurt</w> as soon as the words left her mouth.",
                            "target_lang_translations": {
                                "zh": "话一出口，她就为那句<w>脱口之言</w>感到后悔。",
                                "it": "Si pentì di quella <w>parola sfuggita</w> non appena pronunciata."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指突然且不经思考的言语爆发。",
                        "it": "Un'uscita verbale improvvisa, impulsiva e non meditata."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱口之言",
                                "target_lang_sense_clarification": "指未经深思熟虑而说出的话。"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "parola sfuggita",
                                "target_lang_sense_clarification": "affermazione detta d'impulso"
                            },
                            {
                                "target_lang_word": "uscita improvvisa",
                                "target_lang_sense_clarification": "battuta o rivelazione detta senza pensare"
                            },
                            {
                                "target_lang_word": "gaffe",
                                "target_lang_sense_clarification": "indiscrezione o parola inopportuna detta per sbaglio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}