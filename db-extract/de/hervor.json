                        "sense_id": "df83997a-9192-3ac5-b188-261c0346d4b7",
                        "entry_id": "23d93d18-1e9b-33ad-9270-961fe43ec979",
                        "glosses": [
                            "von hinten nach vorn; in Richtung des Sprechenden"
                        ],
                        "tags": [
                            "meist mit einem Verb zusammengesetzt"
                        ],
                        "examples": [
                            {
                                "example_id": "6d9a670a-d1cc-420e-aefb-21939109f56b",
                                "sense_id": "df83997a-9192-3ac5-b188-261c0346d4b7",
                                "text": "Hervor aus der dunklen Ecke! Zeig dich!"
                            },
                            {
                                "example_id": "b71567dd-f863-4925-91ca-47ff7ce5a437",
                                "sense_id": "df83997a-9192-3ac5-b188-261c0346d4b7",
                                "text": "Er ist dort hervor, bei dem Gebüsch, dann hier vorbei und dann da lang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbcb98d6-f119-4827-89dd-2887f7584c0f",
                        "source_entry_id": "23d93d18-1e9b-33ad-9270-961fe43ec979",
                        "source_sense_id": "df83997a-9192-3ac5-b188-261c0346d4b7",
                        "source_sense_description": "meist mit einem Verb zusammengesetzt: von hinten nach vorn; in Richtung des Sprechenden",
                        "target_lang_word": "forth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6e44f8-ca5c-390e-9f80-dcb36e51c6d3",
                                        "entry_id": "5e0c1229-6739-38ac-8330-70258a3a5570",
                                        "glosses": [
                                            "Forward in time, place or degree."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb52d519-b616-4086-92b4-f4e822bd74fc",
                                                "sense_id": "bf6e44f8-ca5c-390e-9f80-dcb36e51c6d3",
                                                "text": "From this time forth, I never will speak word."
                                            },
                                            {
                                                "example_id": "0aae6147-81e5-4ac5-91fc-7c2fb2b79e52",
                                                "sense_id": "bf6e44f8-ca5c-390e-9f80-dcb36e51c6d3",
                                                "text": "say forth"
                                            },
                                            {
                                                "example_id": "6764c216-deb9-4e6f-8a39-612cbb9f60fd",
                                                "sense_id": "bf6e44f8-ca5c-390e-9f80-dcb36e51c6d3",
                                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a2234b4-d93b-3341-88c4-58c7a823346e",
                                        "entry_id": "5e0c1229-6739-38ac-8330-70258a3a5570",
                                        "glosses": [
                                            "Out into view; from a particular place or position."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "formal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da032ed-a5c7-434d-999b-24bc15f20c01",
                                                "sense_id": "5a2234b4-d93b-3341-88c4-58c7a823346e",
                                                "text": "The plants in spring put forth leaves."
                                            },
                                            {
                                                "example_id": "6e6aef6f-df9b-48d8-b884-9a36182fd1c7",
                                                "sense_id": "5a2234b4-d93b-3341-88c4-58c7a823346e",
                                                "text": "The robbers leapt forth from their place of concealment."
                                            },
                                            {
                                                "example_id": "836f28cd-db40-49a7-a8b6-fb83afc297d0",
                                                "sense_id": "5a2234b4-d93b-3341-88c4-58c7a823346e",
                                                "text": "A hero ventures forth from the world of common day into a region of supernatural wonder: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bcd65e3-8fae-3c52-9b1b-cc29805e4f15",
                                        "entry_id": "5e0c1229-6739-38ac-8330-70258a3a5570",
                                        "glosses": [
                                            "Beyond a (certain) boundary; away; abroad; out."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5fcd007-505a-4866-a80a-00f5d752d41b",
                                                "sense_id": "4bcd65e3-8fae-3c52-9b1b-cc29805e4f15",
                                                "text": "I have no mind of feasting forth to-night."
                                            },
                                            {
                                                "example_id": "428d1008-11fd-4044-ab94-d7f0dc95b983",
                                                "sense_id": "4bcd65e3-8fae-3c52-9b1b-cc29805e4f15",
                                                "text": "At the clashing of the cymbals the King sprang at Goldry as the panther springeth, and with the rush bare him backward and well nigh forth of the wrastling ground."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f905023-de44-3868-9cfe-caabd0571d00",
                                        "entry_id": "68e39f8d-457e-376e-be36-d75b1068dffd",
                                        "glosses": [
                                            "Forth from; out of."
                                        ],
                                        "tags": [
