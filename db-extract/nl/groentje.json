        "nl-extract.jsonl": [
            {
                "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                "word": "groentje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "df81c2b2-b8d3-4669-82da-758db88b147c",
                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "groentjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "glosses": [
                            "iemand die uit onvervarenheid nog veel fouten maakt en daar vaak voor geplaagd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf8c02f7-96f2-41a3-84d6-a94662b128d7",
                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                "text": "Hij was politiek gezien nog maar een groentje."
                            },
                            {
                                "example_id": "a129def1-2c8a-49a5-9bbf-3f6d507178ab",
                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                "text": "Zij rijden voorop in de Volvo, drie agenten in uniform in de auto achter hen: twee groentjes die net hun opleiding hebben afgerond, kerels met spierbundels en een air dat ze alle shit die ze in de maatschappij tegenkomen wel even zullen fiksen."
                            },
                            {
                                "example_id": "f69b87e6-394c-40cd-ab62-a084441cc8f7",
                                "sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                                "text": "Hardangervidda. De Spoorlijn Bergen. Daar was zijn ingenieursleven begonnen toen hij nog niet meer dan een groentje was en nu tegen het einde van dat beroepsleven was het alsof hij weer opnieuw moest beginnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "50b01ca8-3cd1-33f9-a2cf-4ca620c09d86",
                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "glosses": [
                            "Callophrys rubi een dagvlinder uit de familie Lycaenidae, de kleine pages, vuurvlinders en blauwtjes"
                        ],
                        "tags": [
                            "vlinders"
                        ],
                        "examples": [
                            {
                                "example_id": "e69d99cb-dd41-48a5-9a04-b616e2e718b1",
                                "sense_id": "50b01ca8-3cd1-33f9-a2cf-4ca620c09d86",
                                "text": "Het groentje komt in heel Europa algemeen voor op schrale graslanden, heiden en bosgebieden."
                            }
                        ]
                    },
                    {
                        "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "glosses": [
                            "groente"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1420b4c4-5002-44e5-b665-97c315337c09",
                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                "text": "Tomaat, en wortel, en komkommer, en sla, en erwtjes, en broccoli ja, de groentjes van Frank Fol daarmee eten alle kindjes hun buikje vol."
                            },
                            {
                                "example_id": "27b18ad0-3521-4521-a7a9-176474fd8687",
                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                "text": "Bak de kippenreepjes aan in wat olie en voeg er de groentjes aan toe."
                            },
                            {
                                "example_id": "430184f6-71b6-4384-a67f-2fa673cd1c4e",
                                "sense_id": "08271dba-1ee2-34b3-bef5-f71954f08d74",
                                "text": "Snijd de schoongemaakte groentjes in gelijke 'frietjes' van ongeveer 0,5 centimeter dik en 8 centimeter lang."
                            }
                        ]
                    },
                    {
                        "sense_id": "f691bf91-4342-3d38-9fea-edc465c69aaf",
                        "entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "glosses": [
                            "volksnaam voor een groen bankbiljet van f40.- van voor de Tweede Wereldoorlog."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "478c562a-38fd-4e87-af18-753070eabca1",
                        "source_entry_id": "4eb1c8d6-c7e6-304f-bf3a-f4adbfcb27ed",
                        "source_sense_id": "053cfb4a-9089-3fad-b6fb-a9270d526697",
                        "source_sense_description": "onervaren persoon",
                        "target_lang_word": "newbie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "A newcomer, someone new to something."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898b38a1-63d6-4f5e-aca7-2057722f9d17",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "He was a newbie to chemistry."
                                            },
                                            {
                                                "example_id": "5d638d75-4314-4ca2-9d9f-c131508cf3e1",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "We’ve included some other acts you already know so you’ll get a feel for what the newbies sound like."
                                            },
                                            {
                                                "example_id": "b95e1f6c-8faf-4da8-b858-d366cb3d9272",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "If you’re starting off skinny, you can probably get newbie gains for several months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868cfa58-cc8d-352c-96d0-2a530acc5131",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "A new user or participant; someone who is extremely new and inexperienced (to a game or activity). A beginner."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d942ceb-524d-3b94-bb5b-45591d52308f",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "Anything recently introduced into a setting, especially something that replaces an older version."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b453107f-19d7-4793-8b37-b99dae93fb5a",
                                                "sense_id": "3d942ceb-524d-3b94-bb5b-45591d52308f",
                                                "text": "If you find that you would prefer using the new printer most of the time, while using the original only when needed, you can make the newbie the default printer for your system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
