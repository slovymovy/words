                ],
                "senses": [
                    {
                        "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                        "entry_id": "cee637fb-46d2-3363-bc14-b87cad4a0560",
                        "glosses": [
                            "Qui est surabondant en sang et en humeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b07a80-8c9c-4199-8024-56e24d63a288",
                                "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                                "text": "État pléthorique."
                            },
                            {
                                "example_id": "bc4d45f2-18b3-4fbc-ae06-0ff85d7aab63",
                                "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                                "text": "Disposition pléthorique."
                            },
                            {
                                "example_id": "3eff2efd-75c2-4e57-886f-5d536db82ce8",
                                "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                                "text": "Tempérament pléthorique."
                            },
                            {
                                "example_id": "5859ceb5-37d1-4278-a00c-d07551cdac6c",
                                "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                                "text": "Un homme pléthorique."
                            },
                            {
                                "example_id": "3e8c40e0-94aa-4ca6-a460-ac34058f7589",
                                "sense_id": "0fb15232-7153-35d4-8ea2-54638cc4fe9b",
                                "text": "Mangeant beaucoup et ne faisant point d’exercice, il est devenu pléthorique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7e7c6de-f2b7-3387-9549-dabe48474849",
                        "entry_id": "cee637fb-46d2-3363-bc14-b87cad4a0560",
                        "glosses": [
                            "Qui contient de trop nombreux éléments ; surchargé, surabondant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5ef995ed-8fa4-4141-8bba-6cec4bb4c29d",
                                "sense_id": "d7e7c6de-f2b7-3387-9549-dabe48474849",
                                "text": "À la tête d’un commando ultraresserré à l’Élysée, patron d’une majorité pléthorique à l’Assemblée nationale, il a cru bon de gouverner seul."
                            },
                            {
                                "example_id": "d70a3687-76c0-4519-abc7-fd1716a15207",
                                "sense_id": "d7e7c6de-f2b7-3387-9549-dabe48474849",
                                "text": "Au lieu d’une équipe resserrée de 18 ministres et 4 secrétaires d’Etat, la nouvelle est pléthorique. Elle compte 42 membres, nombre qui n’avait pas été atteint depuis le premier gouvernement Juppé en 1995."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e29e84a-342b-4487-80cd-076808ef5da3",
                        "source_entry_id": "cee637fb-46d2-3363-bc14-b87cad4a0560",
                        "target_lang_word": "galore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                        "entry_id": "83e65ceb-706a-3da1-8d53-4b125f32f5f1",
                                        "glosses": [
                                            "In abundance."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "postpositional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d8aa42-8c36-4913-ab26-44991799bf52",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "After the shipwreck there was whisky galore to be had for the taking."
                                            },
                                            {
                                                "example_id": "272f5710-8b42-414b-8835-b3befa22508a",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deserveth all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "a80d6b6e-fb70-4539-b443-6cb3f27c887c",
                                                "sense_id": "2182e084-c4c9-3bbd-b518-312109bb9d95",
                                                "text": "I am the destroyer of mountains, the killer of kings, I always fly by yet I don't have wings. I can end basketball games or marriages with similar ease, and though I flow like a stream only water can freeze. I've murdered parents and children and house plants galore, yet, despite all this, you always want more. Who am I?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "galore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                        "entry_id": "23f88fa2-ae5a-397b-9ad3-8718b7680dca",
                                        "glosses": [
                                            "An abundance; plenty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f857b687-bd78-4a15-9f52-625d3cfdaab1",
                                                "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                                "text": "The usual routine of confections and pastry follows, after which a galore of fruits of all kinds, with a chassè of excellent Mocha, the immediate servitude of which, after good dining, is, I think, universally acknowledged to be a great exhiliration.^([sic – meaning exhilaration])"
                                            },
                                            {
                                                "example_id": "2c51e315-d6ee-4483-8606-5431a20a9f7e",
                                                "sense_id": "481b5000-eb66-3f21-b008-192067daeb44",
                                                "text": "I have got the Innishowen and galores of bread and cheese ready, and all the neighbours are to join us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
