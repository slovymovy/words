    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2581e0ef-ffdc-312f-8e56-b686099b32bf",
                    "sense_definition": "Teil oder Trieb einer Pflanze, aus dem durch Bewurzelung eine eigenständige neue Pflanze heranwachsen kann",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Botanik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man kann diese Zimmerpflanze ganz einfach vermehren, indem man vorsichtig einen frischen <w>Ableger</w> abschneidet."
                        },
                        {
                            "text": "Ich habe meiner Nachbarin gestern einen kleinen <w>Ableger</w> von meiner Grünlilie geschenkt."
                        }
                    ],
                    "synonyms": [
                        "Senker",
                        "Steckling"
                    ],
                    "common_phrases": [
                        "einen Ableger einpflanzen",
                        "einen Ableger ziehen"
                    ]
                },
                {
                    "sense_id": "c856cda3-e3f9-342b-9593-3b3a92b17537",
                    "sense_definition": "Neu gegründete Zweigstelle oder Tochtergesellschaft eines bereits bestehenden Unternehmens oder einer Organisation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das internationale Technologieunternehmen plant, im kommenden Jahr einen neuen <w>Ableger</w> in Berlin zu eröffnen."
                        },
                        {
                            "text": "Der europäische <w>Ableger</w> des Konzerns verzeichnete in den letzten Monaten ein deutliches Wachstum."
                        }
                    ],
                    "common_phrases": [
                        "deutscher Ableger",
                        "einen Ableger gründen"
                    ]
                },
                {
                    "sense_id": "943ccb5c-4317-3d7e-bdd7-3342fa72137a",
                    "sense_definition": "Eigenständiges Medienwerk wie eine Fernsehserie, ein Film oder ein Videospiel, das inhaltlich auf einem bereits vorhandenen Werk beruht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neue Fernsehserie ist ein beliebter <w>Ableger</w> der ursprünglichen Reihe."
                        },
                        {
                            "text": "Das Entwicklerstudio kündigte überraschend an, bald einen weiteren spielerischen <w>Ableger</w> der Marke zu veröffentlichen."
                        }
                    ],
                    "common_phrases": [
                        "ein erfolgreicher Ableger",
                        "Ableger einer Serie"
                    ]
                },
                {
                    "sense_id": "44bb475a-2022-38cd-85e9-2cbfa9830c84",
                    "sense_definition": "Kind oder Nachkomme einer Familie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am Wochenende feiert ihr ältester <w>Ableger</w> endlich seinen langersehnten Schulabschluss."
                        },
                        {
                            "text": "Die stolzen Eltern bewunderten die ersten Gehversuche ihres jüngsten <w>Ablegers</w>."
                        }
                    ],
                    "common_phrases": [
                        "der jüngste Ableger"
                    ],
