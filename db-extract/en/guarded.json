                            },
                            {
                                "example_id": "cea9361f-ba67-4851-9a20-b9ca794919b7",
                                "sense_id": "bf771581-f15a-30a5-b3fd-4b21fe7b58e5",
                                "text": "guarded optimism"
                            },
                            {
                                "example_id": "17954d4f-2c8c-48d1-90e6-ae867cf5c4eb",
                                "sense_id": "bf771581-f15a-30a5-b3fd-4b21fe7b58e5",
                                "text": "The employees reacted with guarded optimism to the new agreement reached by their trade union."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ef066b6-3355-3592-bf98-fadd268d2485",
                        "entry_id": "036675f3-ee43-3f0e-8619-889dcf8bde4c",
                        "glosses": [
                            "Cautious; restrained.",
                            "A good outcome has fair odds of happening but close monitoring is important because odds of deterioration are not low."
                        ],
                        "tags": [
                            "of prognosis"
                        ],
                        "examples": [
                            {
                                "example_id": "aab5ef55-876f-4f59-a438-4e284e24d31c",
                                "sense_id": "1ef066b6-3355-3592-bf98-fadd268d2485",
