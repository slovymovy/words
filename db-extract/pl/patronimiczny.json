                                        "entry_id": "ec985081-0088-308a-851c-b0563d518893",
                                        "glosses": [
                                            "Designación de filiación o linaje como segundo nombre o apellido de hijos u otros descendientes, derivado del respectivo nombre del padre o de algún ancestro."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d26d7162-32bd-4fd7-af18-1cc1b42d89fc",
                                                "sense_id": "10211107-f34c-352d-9ab5-90d40e5df312",
                                                "text": "Sabemos que el uso del patronímico \"-ez\" ya estaba extendido en Navarra en los siglos VIII y IX (...)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
