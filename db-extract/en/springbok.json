                                            {
                                                "example_id": "2ab498f7-0376-48b2-aecc-2e475a5fc696",
                                                "sense_id": "26633e31-b72b-31fe-8f5d-28ac1b275676",
                                                "text": "Le springbok doit son nom aux sauts impressionnants dont il est capable pour échapper à ses prédateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2320782f-3ded-3745-a912-2fcb599f6d2a",
