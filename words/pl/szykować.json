                {
                    "sense_id": "cef4a40b-3592-3fa6-9b8d-1edaa1878074",
                    "sense_definition": "czynić coś gotowym, przygotowywać coś do użycia lub na określoną okazję",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przygotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>szykować</w> kolację dla gości.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>готовить</w> ужин для гостей."
                            }
                        },
                        {
                            "text": "Kucharz zaczął <w>szykować</w> składniki na obiad.",
                            "target_lang_translations": {
                                "ru": "Повар начал <w>подготавливать</w> ингредиенты для обеда."
                            }
