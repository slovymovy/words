                "senses": [
                    {
                        "sense_id": "24836543-519f-39ea-8e49-09034b9b1659",
                        "entry_id": "b65dcbb6-d861-3dfe-a9ef-6f32bd2b5d14",
                        "glosses": [
                            "Initialism of gender-critical."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2a362160-1d0a-4087-8e27-7d494d57aa0a",
                                "sense_id": "24836543-519f-39ea-8e49-09034b9b1659",
                                "text": "GC feminism wholly rejects the notion that gender maps onto sex."
                            },
                            {
                                "example_id": "a7a9ea61-81c4-4ca5-9f4b-d14876f53ed9",
                                "sense_id": "24836543-519f-39ea-8e49-09034b9b1659",
                                "text": "One poster, who thanked her for signing the letter, commented, 'The secrecy with which GC women have to find each other is just absurd. […]"
                            },
                            {
                                "example_id": "4666a78f-c596-40cf-805b-54971ed469d0",
                                "sense_id": "24836543-519f-39ea-8e49-09034b9b1659",
                                "text": "Meanwhile, GC groups continue to lobby against amendments to the GRA, and are also campaigning against existing rights that trans people enjoy."
                            }
                        ]
                    }
                ],
