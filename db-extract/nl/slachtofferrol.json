                        "entry_id": "b35d4114-6849-3296-ae42-331ed2179d24",
                        "glosses": [
                            "het zich gedragen als een slachtoffer (o.a door boos te zijn, bij anderen schuldgevoelens op te wekken en door hulp te vragen zonder zelf actief het probleem aan te pakken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfee1cb6-9f31-4876-b6c7-43e978066898",
                                "sense_id": "b47cadc7-2480-3f8f-b822-34181292e3be",
                                "text": "Als ik geloof dat God mij kan redden, zou ik mezelf in een slachtofferrol manoeuvreren en dat is het laatste wat ik wil."
                            },
                            {
                                "example_id": "4031e8e8-9868-4ecc-a938-c0527554adb2",
                                "sense_id": "b47cadc7-2480-3f8f-b822-34181292e3be",
                                "text": "„We moeten niet in de slachtofferrol blijven hangen en we moeten door met de club. Met zijn allen de schouders eronder. Als je te lang in boosheid blijft hangen dan heb je daar alleen jezelf mee."
                            }
                        ]
                    }
