                "forms": [],
                "senses": [
                    {
                        "sense_id": "6132d752-8f2e-3328-ba22-311783ce1620",
                        "entry_id": "a821d030-9e1b-3e72-a87a-1b5fab5257cf",
                        "glosses": [
                            "Partie du membre supérieur des humains entre l’épaule (qui la relie au tronc) et le coude (qui la relie à l’avant-bras). (Synonyme : bras au sens strict.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2181a6-a1ae-412a-8e2b-03f354fde3e6",
                                "sense_id": "6132d752-8f2e-3328-ba22-311783ce1620",
                                "text": "Gabrielle, bondissant. — Qu’est-ce qu’il a dit ? (Elle descend vers le général, le saisit par l’arrière-bras de façon à lui faire faire demi-tour face à elle et, prenant du champ, lui envoie un soufflet retentissant.) Tiens !"
                            },
                            {
                                "example_id": "fbfd078c-0cbe-451e-8384-b282bf448446",
                                "sense_id": "6132d752-8f2e-3328-ba22-311783ce1620",
                                "text": "Le canon d’arrière-bras ou brassard d’arrière-bras est une pièce constitutive de l’armure. Il est relié au canon d’avant-bras (ou brassard d’avant-bras) par la cubitière."
                            },
                            {
                                "example_id": "47198c5e-6279-4ffe-983a-c32a52c614b3",
                                "sense_id": "6132d752-8f2e-3328-ba22-311783ce1620",
                                "text": "Un exercice pour se muscler les arrière-bras à la piscine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55887b3e-fa05-4fff-b52f-9379b1c7598f",
                        "source_entry_id": "a821d030-9e1b-3e72-a87a-1b5fab5257cf",
