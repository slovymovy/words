                ],
                "senses": [
                    {
                        "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                        "entry_id": "8e1d96a3-abbf-3788-94a0-4e65cd80bd10",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8cda0f8-c99b-40d7-b982-e7ed09c6c4a9",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Frau Ulman ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "033a2bab-48bc-4b8c-bf9f-2845aa71e146",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Herr Ulman wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ea46e1e8-fba9-4174-b2a8-0612e6a19a7a",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Die Ulmans fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0fe5c19a-5668-4b60-8bfa-c04d104efc5b",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Der Ulman trägt nie die Schals, die die Ulman ihm strickt."
                            },
                            {
                                "example_id": "49cf5f9b-b2ea-44c2-8b9c-2370bb7dbb6a",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulman kommt, geht der Herr Ulman.“"
                            },
                            {
                                "example_id": "2d4b311e-68a2-4393-b107-71835c8a38a5",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Ulman kommt und geht."
                            },
                            {
                                "example_id": "a13aa2d8-0ad0-42dd-8d21-36c3da6ef330",
                                "sense_id": "58d58ea7-4f23-3e7c-b53a-5c49d0f10274",
                                "text": "Ulmans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
