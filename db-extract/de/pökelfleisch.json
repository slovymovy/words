                                        "glosses": [
                                            "Action de saler les viandes ou autres provisions, pour les conserver longtemps"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16d66f57-7487-412f-bdcf-d5b311f55431",
                                                "sense_id": "aaeda7aa-780d-3293-bf44-8ac85c782a7d",
                                                "text": "La salaison du beurre, du porc frais."
                                            },
                                            {
                                                "example_id": "07ecaa8c-2aa1-4404-87af-c657771fd9b1",
                                                "sense_id": "aaeda7aa-780d-3293-bf44-8ac85c782a7d",
                                                "text": "La préparation consiste en une salaison de la viande puis le confisage proprement dit est réalisé par cuisson dans la graisse de canards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9530add1-9ad6-3415-b7fb-2e8d994fd28c",
                                        "entry_id": "dc285816-8f22-33ee-a3c4-586473b55a8f",
                                        "glosses": [
                                            "Denrées alimentaires qui ont été salées pour être conservées."
                                        ],
                                        "tags": [
