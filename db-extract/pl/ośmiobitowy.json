                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1216471-a8eb-4617-a74c-bf814abcb295",
                                                "sense_id": "6bd4aa6c-b5eb-3533-9a1a-3ce8b2f313db",
                                                "text": "I started creating 8-bit music around 2002 when I picked up nanoloop[…]"
                                            }
                                        ]
