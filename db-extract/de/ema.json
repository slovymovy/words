                "senses": [
                    {
                        "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                        "entry_id": "b20d7e04-aa81-3c25-9c12-3aad439c5dc6",
                        "glosses": [
                            "Europäische Arzneimittel-Agentur der Europäischen Union"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21fe605-3be6-4281-94f6-8254da9fdb23",
                                "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                                "text": "Die europäische Arzneimittelbehörde EMA gibt grünes Licht für den Einsatz des Covid-19-Impfstoffs von BioNTech und Pfizer."
                            },
                            {
                                "example_id": "8863d1fa-1d33-45b1-8acc-ee6c11662282",
                                "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                                "text": "Über eine Zulassung des Impfstoffes des US-Unternehmens Moderna will die EMA am 6. Januar entscheiden."
                            },
                            {
                                "example_id": "6256dc43-bf10-4c86-80c1-42fe4b650f77",
                                "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                                "text": "Die Forschungsministerin wertete die EMA-Empfehlung für Biontech auch als Erfolg der deutschen Forschungsförderung."
                            },
                            {
                                "example_id": "08012025-3277-49c6-b675-aa487e937019",
                                "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                                "text": "Die Europäische Arzneimittelagentur (EMA) hat mitgeteilt, dass bereits am 6. Januar der zuständige Ausschuss für Humanarzneimittel über die Zulassung des Covid-19-Impfstoffs mRNA-1273 des US-Herstellers Moderna beraten wird."
                            },
                            {
                                "example_id": "f1f04af2-f9e2-4338-80c9-bbcc7a2e0bf8",
                                "sense_id": "1550b871-8920-3d33-af95-6c557307aa2c",
                                "text": "Denn eine positive Empfehlung der EMA sowie eine rasche Zulassung durch die EU-Kommission auch dieses mRNA-Impfstoffs gilt als sehr wahrscheinlich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
