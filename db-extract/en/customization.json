                                        "entry_id": "dcfea4c0-51ea-367f-a31f-39696eae910c",
                                        "glosses": [
                                            "das Sicheinstellen auf jemanden; Vorgang oder Ergebnis des sich Einstellens auf etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4ab9e2-53e4-4874-b9b1-f8a219111484",
                                                "sense_id": "9a20a43e-4aa1-3e82-a48d-a0b70e172e4f",
                                                "text": "Die Anpassung an die neue Umgebung fiel den Flüchtlingen schwer."
                                            },
                                            {
                                                "example_id": "1ee75a5b-2395-48c5-94b2-6897a0e20a7f",
                                                "sense_id": "9a20a43e-4aa1-3e82-a48d-a0b70e172e4f",
                                                "text": "„Zum Staatsstreich fehlte den herrschenden Eliten die Kraft, während das liberale Bürgertum zwischen Anpassung und Opposition pendelte und die Arbeiterbewegung trotz wachsendem Zulauf politisch weitgehend ghettoisiert blieb.“"
                                            },
                                            {
                                                "example_id": "c42ee13b-bac5-4545-bd8b-b209b4666740",
                                                "sense_id": "9a20a43e-4aa1-3e82-a48d-a0b70e172e4f",
                                                "text": "„Auch auf andere Stressoren wie Trockenheit oder Verletzungen durch fressende Tiere reagieren die Pflanzen mit Anpassungen.“"
                                            },
                                            {
                                                "example_id": "1ab3536e-58c2-4446-b78c-09604be790fe",
                                                "sense_id": "9a20a43e-4aa1-3e82-a48d-a0b70e172e4f",
                                                "text": "„Herzhaft komischen Geschmack besitzt der Krautsalat, den sich die Deutschen von Yorkville im Lauf ihrer Anpassung angerichtet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe6a1874-58b0-3d1b-9f45-cd5a19da5e80",
                                        "entry_id": "dcfea4c0-51ea-367f-a31f-39696eae910c",
                                        "glosses": [
                                            "Herstellung einer erwünschten Zuordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ca535e-6b77-4be1-bba9-456ceac17d63",
                                                "sense_id": "fe6a1874-58b0-3d1b-9f45-cd5a19da5e80",
                                                "text": "Die Anpassung der Farbe des Vorhanges an den Farbton des restlichen Raumes ist gut gelungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
