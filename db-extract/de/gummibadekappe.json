                "senses": [
                    {
                        "sense_id": "4e162625-e4b3-3b3d-a9ff-13733c165056",
                        "entry_id": "88c20fdf-3bc9-3f70-8981-1a95c0c57136",
                        "glosses": [
                            "enge Mütze aus Gummi, die man beim Schwimmen trägt, um die Haare zusammenzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcfc3b32-b133-41ce-9c84-828bf7cd87bb",
                                "sense_id": "4e162625-e4b3-3b3d-a9ff-13733c165056",
                                "text": "„Heute ist sie endlich wieder einmal ohne die lästige Gummibadekappe im Wasser gewesen.“"
                            },
                            {
                                "example_id": "868fc6a1-f710-48ff-8401-bbb53b0ec6a3",
                                "sense_id": "4e162625-e4b3-3b3d-a9ff-13733c165056",
                                "text": "„Oma sei einmal mit ihrer leuchtenden Gummibadekappe wie eine unbefestigte Boje von einem Ufer zum anderen getrieben und habe das schwimmen genannt.“"
                            },
                            {
                                "example_id": "047a4a8e-e95d-4a3e-81a7-327c17932336",
                                "sense_id": "4e162625-e4b3-3b3d-a9ff-13733c165056",
                                "text": "„Jeden Morgen stürzte sich eine Riege alter Damen mit Gummibadekappen wie Seehundjunge in das eisige Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
