                "senses": [
                    {
                        "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                        "entry_id": "0b8ee0d1-8b41-3503-8025-89ed5928861f",
                        "glosses": [
                            "vorliegendes Resultat/Ergebnis, besonders im Vergleich zu einem vorher geplanten oder vermuteten Resultat"
                        ],
                        "tags": [
                            "Controlling"
                        ],
                        "examples": [
                            {
                                "example_id": "6bc091fb-e3fc-4d73-8b2a-9c71edc537be",
                                "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                                "text": "„Das erhaltene Istergebnis wird mit dem erwarteten Sollergebnis verglichen.“"
                            },
                            {
                                "example_id": "f9c9f7c9-81f3-4d3a-8c15-236bf13191f5",
                                "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                                "text": "„[…] Gründe, warum das Istergebnis nur näherungsweise errechnet werden kann.“"
                            },
                            {
                                "example_id": "a202f6e3-f8f3-4d13-8818-5ead3a1e0bd2",
                                "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                                "text": "„Überwachung ist (…) im Sinne von vergleichenden Handlungen zu interpretieren, angefangen von der bloßen Beobachtung über die Gegenüberstellung von Sollvorgaben und Istergebnis bis hin zur Urteilsbildung.“"
                            },
                            {
                                "example_id": "5dfb9de2-02c2-48b2-bf65-692829dc843b",
                                "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                                "text": "„Der Vergleich eines flexiblen Budgets mit den Istergebnissen erfüllt einen wichtigen Zweck der Leistungsbeurteilung.“"
                            },
                            {
                                "example_id": "f49b18af-0342-4c13-abe6-17aeba01ae8b",
                                "sense_id": "eff7e04d-59c6-38d6-9514-b89d1f5e726a",
                                "text": "„Würde immer ausgewertet, könnte die first best-Situation erzielt werden; in diesem Fall wären die Istergebnisse und die Ergebnisabweichungen überhaupt nicht mehr von Interesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
