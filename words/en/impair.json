{
    "word_family": [
        "impairment",
        "unimpaired"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4148654-61bd-3d30-963e-13451da152bc",
                    "sense_definition": "To weaken, damage, or affect negatively, especially in a way that diminishes strength, value, or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A lack of sleep can seriously <w>impair</w> your ability to drive safely.",
                            "target_lang_translations": {
                                "ru": "Недостаток сна может серьезно <w>ослабить</w> вашу способность безопасно управлять автомобилем."
                            }
                        },
                        {
                            "text": "Excessive noise over a long period can permanently <w>impair</w> hearing.",
                            "target_lang_translations": {
                                "ru": "Чрезмерный шум в течение длительного времени может необратимо <w>нарушить</w> слух."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder"
                    ],
                    "antonyms": [
                        "improve",
                        "enhance"
                    ],
                    "common_phrases": [
                        "impair the ability",
                        "impair cognitive function",
                        "seriously impair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослаблять, ухудшать или наносить вред, особенно снижая силу, ценность или качество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "делать более слабым, лишать прежней силы"
                            },
                            {
                                "target_lang_word": "ухудшать",
                                "target_lang_sense_clarification": "делать хуже по качеству или состоянию"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "расстраивать нормальное функционирование (например, слух, зрение)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a99f386-0f18-3a3b-b622-43c5cfdc8eba",
                    "sense_definition": "To grow worse; to deteriorate or decline in quality or strength.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper maintenance, the structural integrity of the old bridge will slowly <w>impair</w>.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего обслуживания структурная целостность старого моста будет медленно <w>ухудшаться</w>."
                            }
                        },
                        {
                            "text": "His health began to <w>impair</w> rapidly after he stopped taking his medication.",
                            "target_lang_translations": {
                                "ru": "Его здоровье начало быстро <w>ослабевать</w> после того, как он перестал принимать лекарства."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinder"
                    ],
                    "antonyms": [
                        "improve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used intransitively to mean deteriorate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухудшаться, приходить в упадок или терять силу (устаревшее непереходное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "становиться слабее по степени проявления, уменьшаться"
                            },
                            {
                                "target_lang_word": "ухудшаться",
                                "target_lang_sense_clarification": "становиться хуже"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c49109ed-94db-322a-a67b-dceae3bf44a8",
                    "sense_definition": "An impairment, deterioration, or reduction in quality or value.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal caused a severe <w>impair</w> to his public reputation.",
                            "target_lang_translations": {
                                "ru": "Скандал нанес серьезный <w>ущерб</w> его общественной репутации."
                            }
                        },
                        {
                            "text": "Any further <w>impair</w> of their resources could lead to bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Любое дальнейшее <w>истощение</w> их ресурсов может привести к банкротству."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as a noun meaning impairment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухудшение, повреждение или снижение качества либо ценности (устаревшее существительное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "процесс или результат изменения к худшему"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "вред, убыток или потеря"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3d1a5c4-5f23-3ef4-abd8-26193dba8382",
                    "sense_definition": "Not fit or appropriate; unsuitable or improper.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unsuitable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would not dignify an <w>impair</w> thought with breath.",
                            "target_lang_translations": {
                                "ru": "Он не стал бы осквернять дыхание <w>неподобающей</w> мыслью."
                            }
                        },
                        {
                            "text": "Such actions were deemed <w>impair</w> for a person of his high standing.",
                            "target_lang_translations": {
                                "ru": "Такие действия были сочтены <w>недостойными</w> для человека его высокого положения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as an adjective meaning unsuitable"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неподходящий, ненадлежащий или непристойный (устаревшее прилагательное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неподобающий",
                                "target_lang_sense_clarification": "не соответствующий правилам приличия или статусу"
                            },
                            {
                                "target_lang_word": "неподходящий",
                                "target_lang_sense_clarification": "не соответствующий требованиям или обстоятельствам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}