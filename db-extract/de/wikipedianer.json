                "senses": [
                    {
                        "sense_id": "a1cbb0bc-fb70-370c-b581-42ac7ef9404a",
                        "entry_id": "8b5566dc-56cc-3784-b06b-ab913ccb1574",
                        "glosses": [
                            "ein Wikipedia-Autor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4e91bf-421b-4844-a090-46b0d632e682",
                                "sense_id": "a1cbb0bc-fb70-370c-b581-42ac7ef9404a",
                                "text": "„Wikipedianer mit gutem Ruf in der Community haben die Fakten überprüft und schaffen so verlässliche Einträge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b154262e-b6e0-476a-b651-2d9129a3327b",
                        "source_entry_id": "8b5566dc-56cc-3784-b06b-ab913ccb1574",
                        "source_sense_id": "a1cbb0bc-fb70-370c-b581-42ac7ef9404a",
                        "source_sense_description": "ein Wikipedia-Autor",
                        "target_lang_word": "Wikipedian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wikipedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                        "entry_id": "798ff19d-6455-347a-a2ef-dc67ee4b8cb4",
                                        "glosses": [
                                            "A person who contributes to Wikipedia, especially a regular contributor well versed in the ways of the website."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b7ec545-cd76-49a2-804d-9c4c518dbd78",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "He is proud to be a Wikipedian."
                                            },
                                            {
                                                "example_id": "c9fb15e3-dbeb-4b3e-922b-0409e39f7d0e",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "That is because Wikipedians, as they call themselves, can not only contribute whatever they want but can also edit entries posted by other writers as they see fit."
                                            },
                                            {
                                                "example_id": "f6c783e0-78cc-43bd-a192-3bcdbd3532b0",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "Britannica, somewhat representative of old media in general, instinctively regards Wikipedia as a threat, whereas Wikipedians are not the least bit tempted to reciprocate."
                                            },
                                            {
                                                "example_id": "18637831-66bb-40e4-830d-f7d765810e61",
                                                "sense_id": "dd89def7-a419-3a0a-8358-f8ac7886e328",
                                                "text": "This change takes care of casual or heat-of-the-moment vandalism, but it does little to address a new category of Wikipedian somewhere between committed community member and momentarily vandalizing teenager, one that creates tougher problems."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Wikipedian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                        "entry_id": "375fb341-08f3-34ef-adaa-816f9e5e17fb",
                                        "glosses": [
                                            "Of or relating to Wikipedia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4346896f-75a0-422f-acd7-93447102cc35",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "Many scholars of Wikipedian theology theorize that if consensus is ever reached, Wikipedia will spontaneously disappear."
                                            },
                                            {
                                                "example_id": "12987809-a3bb-4fa5-baf4-099b0bd1e98d",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "In these Googlial Wikipedian times, a vast collection of wordbooks may seem slow, unnecessary or both."
                                            },
                                            {
                                                "example_id": "39b412f1-1bdc-4f5d-8819-677b9b366b64",
                                                "sense_id": "ce8102a5-9f13-3fa0-a103-715577ac58fb",
                                                "text": "If people stopped believing in the Wikipedian ideal, and used its tools for vandalism, \"it's unlikely the whole enterprise would survive a week\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e6b6627-c2ca-48dc-ad83-216090a5ae44",
                        "source_entry_id": "8b5566dc-56cc-3784-b06b-ab913ccb1574",
                        "source_sense_id": "a1cbb0bc-fb70-370c-b581-42ac7ef9404a",
                        "source_sense_description": "ein Wikipedia-Autor",
