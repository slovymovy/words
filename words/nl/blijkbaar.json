            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "af7d2a8d-a3bc-366f-9fbc-eeb58d31fd17",
                    "sense_definition": "zoals men uit bepaalde aanwijzingen kan opmaken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waarschijnlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft <w>blijkbaar</w> te veel gedronken want ze kan niet meer recht lopen.",
                            "target_lang_translations": {
                                "en": "She has <w>apparently</w> drunk too much because she can no longer walk straight."
                            }
                        },
                        {
                            "text": "Het is <w>blijkbaar</w> verboden om hier te parkeren aangezien iedereen een boete krijgt.",
                            "target_lang_translations": {
                                "en": "It is <w>evidently</w> forbidden to park here since everyone is getting a fine."
                            }
                        }
                    ],
                    "synonyms": [
                        "kennelijk",
                        "schijnbaar",
                        "ogenschijnlijk"
                    ],
                    "antonyms": [
                        "zeker",
                        "beslist"
                    ],
                    "common_phrases": [
                        "blijkbaar verboden",
                        "blijkbaar niet"
                    ],
                    "target_lang_definitions": {
                        "en": "as can be inferred from certain indications or evidence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apparently",
                                "target_lang_sense_clarification": "based on what seems to be true"
                            },
                            {
                                "target_lang_word": "evidently",
                                "target_lang_sense_clarification": "based on clear evidence"
                            },
                            {
                                "target_lang_word": "seemingly",
                                "target_lang_sense_clarification": "according to appearances"
                            }
                        ]
                    }
                }
            ]
        },
        {
