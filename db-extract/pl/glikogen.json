                        "glosses": [
                            "polisacharyd stanowiący materiał zapasowy dla komórek zwierzęcych, gromadzony głównie w wątrobie i mięśniach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00ef96a-2719-4fd6-bdc2-e854139f6f26",
                                "sense_id": "f2e0a397-0967-3d75-86d8-2dbbff55e3b5",
                                "text": "Glukoza jest magazynowana w mięśniach i wątrobie w postaci glikogenu i stamtąd uwalniana do krwi"
                            }
                        ],
