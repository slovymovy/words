                "senses": [
                    {
                        "sense_id": "36dd2985-e302-30a1-9e4f-ebfb8386fb17",
                        "entry_id": "3dedea8e-d82f-3b4e-a5d4-9a88c22954e4",
                        "glosses": [
                            "letzter Bericht, in dem alle bisher zusammengetragenen Erkenntnisse mitgeteilt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dbadff-7443-4a47-863e-b12cb1b37a93",
                                "sense_id": "36dd2985-e302-30a1-9e4f-ebfb8386fb17",
                                "text": "Bis morgen erwarte ich den Abschlussbericht von Ihnen."
                            },
                            {
                                "example_id": "7a0ae957-d8d9-4a9b-a164-8fff5d8d755f",
                                "sense_id": "36dd2985-e302-30a1-9e4f-ebfb8386fb17",
                                "text": "„In ihrem Abschlussbericht wirft die Untersuchungskommission zu den Terroranschlägen vom 11. September 2001 der US-Regierung und den Geheimdiensten schwere Versäumnisse vor.“"
                            }
                        ],
