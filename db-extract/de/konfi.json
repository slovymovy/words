                "senses": [
                    {
                        "sense_id": "b6da99bf-487b-3379-973a-f32bb939b999",
                        "entry_id": "682189f4-7720-3d96-a139-3d26b8473b9d",
                        "glosses": [
                            "festlicher Eintritt einer Person in die christlich-evangelische Gemeinde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2c070d23-e3cb-424d-9e05-2d4c1505f162",
                                "sense_id": "b6da99bf-487b-3379-973a-f32bb939b999",
                                "text": "Gestern feierten wir die Konfi."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3761244-1171-3078-8d86-ec39d5733455",
                        "entry_id": "682189f4-7720-3d96-a139-3d26b8473b9d",
                        "glosses": [
                            "weibliche Person, die im Konfirmationsunterricht auf die Konfirmation vorbereitet wird, beziehungsweise: weibliche Person, die gerade konfirmiert wird/wurde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "24cb4c6e-7aec-4a7b-9205-a80987e5bf86",
                                "sense_id": "b3761244-1171-3078-8d86-ec39d5733455",
                                "text": "Die Konfis hören dem Pastor gespannt zu."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                        "entry_id": "682189f4-7720-3d96-a139-3d26b8473b9d",
                        "glosses": [
                            "als Brotaufstrich verwendetes, mit Zucker eingekochtes Fruchtmark beziehungsweise eingekochte reife Früchte oder Beeren"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2d186f57-3974-478a-8115-9e791ebe468c",
                                "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                                "text": "„Die einen bringen am Morgen nichts runter, andere lassen es sich mit Brot, Käse, Butter und Konfi richtig gut gehen.“"
                            },
                            {
                                "example_id": "b8b48438-704b-4ba4-8b8d-641635ecf9df",
                                "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                                "text": "„Gemütliche Brunches mit hofeigenem Zopf, Rührei, Konfi, Schinken und allem was das Frühstück-Herz begehrt, werden auf vielen Bauernhöfen angeboten.“"
                            },
                            {
                                "example_id": "a994df84-00fd-401a-988b-5e37faf80326",
                                "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                                "text": "„Egal ob Birchermüesli mit diversen Früchten, Kaffee, heisse Schoggi, Konfi, Honig, Zopf, Orangensaft, Pancakes – Hauptsache, wir können uns den Bauch vollschlagen, oder?“"
                            },
                            {
                                "example_id": "a2cf62b5-9268-4ebd-94a3-e9214dbdc8c6",
                                "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                                "text": "„Nach kurzer Carfahrt genossen wir nochmals ein Frühstück mit Kaffee, Gipfeli, Butter und Konfi.“"
                            },
                            {
                                "example_id": "4276291b-9ec2-4d8f-bd19-fe1d64f90992",
                                "sense_id": "304fdd80-4b33-3339-b2e8-069b1c03a69e",
                                "text": "„Bei Zopf, Gipfeli, Wurst, Käse, Konfi und vielen weiteren Köstlichkeiten, welche Heidi und Jürg Andrist sowie Tochter Franziska angerichtet hatten, kamen die neuen Gemeindemitglieder ungezwungen ins Gespräch.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
