                                        "sense_id": "ab0829f6-00bd-373f-8a42-127bc65d2626",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "iets verbruiken tot het op is"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb3cb73-caf1-43b5-a635-567c8d9d4729",
                                                "sense_id": "ab0829f6-00bd-373f-8a42-127bc65d2626",
                                                "text": "De kinderen maakten al het snoep op voordat moeder thuis zou komen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00800c19-fd82-3536-8051-5af2ad267f9e",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "iets concluderen, begrijpen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88da1374-eaa8-4770-8143-948289b0b131",
                                                "sense_id": "00800c19-fd82-3536-8051-5af2ad267f9e",
                                                "text": "Uit wat de verdachte zei, kon de politie niets opmaken."
                                            },
                                            {
                                                "example_id": "1e76436f-a664-49e1-b781-0a27a661aa06",
                                                "sense_id": "00800c19-fd82-3536-8051-5af2ad267f9e",
                                                "text": "Ik riep omlaag om te horen of alles in orde was, maar door de wind was het te onduidelijk om te kunnen opmaken wat ze terug schreeuwden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501fd486-114a-33d0-8d78-6b3edd0c01fd",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "make-up aanbrengen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64ddcc9-81fa-42c5-8508-b1a3723de3dc",
                                                "sense_id": "501fd486-114a-33d0-8d78-6b3edd0c01fd",
                                                "text": "De meisjes maken zich voor de spiegel op."
                                            },
                                            {
                                                "example_id": "4514c674-57bf-42f7-ac0f-015c65e8c64b",
                                                "sense_id": "501fd486-114a-33d0-8d78-6b3edd0c01fd",
                                                "text": "Ze was niet of heel licht opgemaakt, zoals haar gewoonte was, behalve dan dat ze speciaal voor de gelegenheid Ferrarirode lippenstift had opgedaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96e2bf5-fd19-3ca3-bc19-33d947ccf27c",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "een tekstdocument opstellen of vormgeven"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2144f7f-4ccd-49ae-a62a-815799358565",
                                                "sense_id": "b96e2bf5-fd19-3ca3-bc19-33d947ccf27c",
                                                "text": "De vormgevers van de krant maken de gekozen artikelen op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a235410-2934-388c-b19d-9282ab4f25cd",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "uitrekenen en documenteren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2734e8e0-a2c6-314a-93d1-f699c73be93a",
                                        "entry_id": "3cff987e-620c-3340-a611-ec318c2501d6",
                                        "glosses": [
                                            "iets klaarmaken / opruimen voor gebruik"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd26251c-8462-411c-9558-98a7dd962421",
                                                "sense_id": "2734e8e0-a2c6-314a-93d1-f699c73be93a",
                                                "text": "Zijn moeder was zijn bed nog aan het opmaken."
                                            },
                                            {
                                                "example_id": "165ad5a3-06e2-4837-8965-a369c6592b73",
                                                "sense_id": "2734e8e0-a2c6-314a-93d1-f699c73be93a",
                                                "text": "De strak opgemaakte kamer wist ik in no time te transformeren tot een stinkende rotzooi."
                                            },
                                            {
                                                "example_id": "7ebe1fdf-331d-41ee-89fc-4bc15e68da53",
                                                "sense_id": "2734e8e0-a2c6-314a-93d1-f699c73be93a",
                                                "text": "Wanneer hij in zijn zolderkamer zat om de bouwtekeningen opnieuw door te nemen of wanneer een paal schuin was komen te zitten en moest worden aangepast, kon hij af en toe een pauze nemen, boven op het opgemaakte bed liggen en luisteren alsof het muziek van Beethoven of Brahms was."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "opmaken",
