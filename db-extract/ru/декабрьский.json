                "senses": [
                    {
                        "sense_id": "7932e7f5-a478-3c49-86b6-0d04616c9498",
                        "entry_id": "c441f175-0fb3-36a6-9b7e-f5f611f9cc5e",
                        "glosses": [
                            "относящийся к декабрю, свойственный декабрю, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "490271c0-ba48-4fac-8dd6-25f4e1d27977",
                                "sense_id": "7932e7f5-a478-3c49-86b6-0d04616c9498",
                                "text": "Декабрьские дни становились всё меньше, огромней делались ледяные семнадцатичасовые ночи."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f84e8b-7d5e-3056-a6e1-fcc799ea1a22",
                        "entry_id": "c441f175-0fb3-36a6-9b7e-f5f611f9cc5e",
                        "glosses": [
                            "происходящий, созданный, сделанный в декабре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c8ddb6-2c01-46fe-a57e-4a9f98c479f4",
                                "sense_id": "e7f84e8b-7d5e-3056-a6e1-fcc799ea1a22",
                                "text": "Но запрет вступит в силу лишь после декабрьских выборов…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a68fca-3747-4106-b0cb-776952cea880",
                        "source_entry_id": "c441f175-0fb3-36a6-9b7e-f5f611f9cc5e",
                        "target_lang_word": "December",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "December",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58608a79-efc5-3304-b912-eb311b5e07b6",
                                        "entry_id": "8cec428e-6184-36fb-bfa7-49c728b1b860",
                                        "glosses": [
                                            "The twelfth and last month of the Gregorian calendar, following November and preceding the January of the following year, containing the southern solstice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f86446a1-7e22-4570-b93d-47c47da312fb",
                                                "sense_id": "58608a79-efc5-3304-b912-eb311b5e07b6",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "348b486c-20b3-42b4-a48d-426b4eb52bf8",
                                                "sense_id": "58608a79-efc5-3304-b912-eb311b5e07b6",
                                                "text": "Old Oakes doe not eaſily fall: / Decembers cold hand combes my head and beard, / But May ſvvimmes in my blood; and he that vvalkes / VVithout his vvooden third legge, is never old."
                                            },
                                            {
                                                "example_id": "0b890f7e-260a-42df-88ae-ddd020a737b5",
                                                "sense_id": "58608a79-efc5-3304-b912-eb311b5e07b6",
                                                "text": "Wearing his best suit and sunglasses, the sultan of Slowjamastan officially declared independence from the United States of America at 12:26 p.m. on December 1, 2021 as he broadcast the secession live from his open-air government “office” in Dublândia, the capital of the Republic of Slowjamastan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d535fcff-ba0c-334e-b364-a31917521312",
                                        "entry_id": "8cec428e-6184-36fb-bfa7-49c728b1b860",
                                        "glosses": [
                                            "A female given name transferred from the month name [in turn from English]."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f50eefb8-8fff-4ef9-82a5-eeb83fd22e4b",
                                                "sense_id": "d535fcff-ba0c-334e-b364-a31917521312",
                                                "text": "But others were less than thrilled with this new gizmo, particularly its addictive qualities. There were reports of breakups threatened and consummated over it. “Our marriage or your Sony,” one woman told her husband, who duly sold the Walkman to a bachelor friend. A young woman named December Cole, a sales executive at a beauty magazine, recalled a trip to Atlantic City with \"a basically rude\" man who wouldn't stop \"bopping around to his own music.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ba89da-11e2-352f-9750-7d73976f673e",
                                        "entry_id": "8cec428e-6184-36fb-bfa7-49c728b1b860",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
