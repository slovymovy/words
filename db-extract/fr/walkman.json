            {
                "entry_id": "80fb5af7-b83b-3bf5-9b8f-2bb076d2b1c7",
                "word": "walkman",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d791fc2e-56d7-4c57-9c57-f5b80b242572",
                        "entry_id": "80fb5af7-b83b-3bf5-9b8f-2bb076d2b1c7",
                        "tags": [
