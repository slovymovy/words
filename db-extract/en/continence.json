    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                "word": "continence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5d029cf6-7125-464b-833f-f03b7bf51050",
                        "entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "continences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41c3d73c-998b-3e42-84ff-d097df98f3f1",
                        "entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                        "glosses": [
                            "The voluntary control of urination and defecation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d3751b-e3a3-48c5-b1fd-933d9dfedd52",
                                "sense_id": "41c3d73c-998b-3e42-84ff-d097df98f3f1",
                                "text": "To maintain continence, the puborectalis muscle chokes the anal canal. The sling of tissue is supposed to release during defecation. Mine has not been doing that."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc468b31-68ed-3328-8a39-3ad7bb0c64b4",
                        "entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                        "glosses": [
                            "Moderation or self-restraint, especially in sexual activity; abstinence."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8da79d5a-adff-44ce-9bad-f33cb8b3130f",
                                "sense_id": "dc468b31-68ed-3328-8a39-3ad7bb0c64b4",
                                "text": "For quotations using this term, see Citations:continence."
                            },
                            {
                                "example_id": "c7cca92a-035f-4905-9b7d-1e6693fcbf09",
                                "sense_id": "dc468b31-68ed-3328-8a39-3ad7bb0c64b4",
                                "text": "He knew what to say; he knew also, when to leave off, — a continence which is practised by few writers."
                            },
                            {
                                "example_id": "129ded57-0e77-4905-a2e8-61f6e8e5f161",
                                "sense_id": "dc468b31-68ed-3328-8a39-3ad7bb0c64b4",
                                "text": "Chastity is either abstinence or continence: abstinence is that of virgins or widows; continence of married persons."
                            },
                            {
                                "example_id": "f7e0f535-6f90-49eb-b99e-cd48a12d404e",
                                "sense_id": "dc468b31-68ed-3328-8a39-3ad7bb0c64b4",
                                "text": "For this was a line so little frequented, especially at this hour, when the driver, the stoker, the guard and the station staffs all along the line, were anhelating towards their wives, after the long hours of continence, that the train would hardly draw up, when it would be off again, like a bouncing ball."
                            }
                        ]
                    },
                    {
                        "sense_id": "8980b58a-9cf3-3769-8b13-8dfebd3edb78",
                        "entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                        "glosses": [
                            "Uninterrupted course; continuity."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2580ab04-a6f4-4d66-a442-14c305b8a052",
                                "sense_id": "8980b58a-9cf3-3769-8b13-8dfebd3edb78",
                                "text": "the Continence of the Cause should be divided"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f81f0c8e-3816-4b52-aa56-9b4efb4416c8",
                        "source_entry_id": "3da8ff0e-16fb-3fc8-8942-2dd5773d25d5",
                        "source_sense_description": "voluntary control of urination and defecation",
                        "target_lang_word": "continentie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continentie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bbef9a94-c81c-39c7-b8d6-f631821a5264",
                                        "entry_id": "d4d5446e-957c-3442-b651-cdb230020064",
                                        "glosses": [
                                            "het vermogen om de uitscheiding van urine en ontlasting te kunnen beheersen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2133401-8251-4b2f-ae26-8cdbd62afeda",
                                                "sense_id": "bbef9a94-c81c-39c7-b8d6-f631821a5264",
                                                "text": "Schone en veilige openbare toiletten, daar zijn er nog te weinig van in Nederland. Dat maakt de Continentie Stichting Nederland bekend tijdens de Nationale Plasdag. De organisatie vraagt met die dag aandacht voor 3,5 miljoen Nederlanders met een plasprobleem."
                                            },
                                            {
                                                "example_id": "94713308-67cc-43a1-bde0-386a9d195dbf",
                                                "sense_id": "bbef9a94-c81c-39c7-b8d6-f631821a5264",
                                                "text": "Is er wel een wc in de buurt als ik de deur uitga? De meeste mensen denken daar niet over na, maar voor honderdduizenden mensen met continentieproblemen is het een dagelijks probleem. Gemeenten moeten zich daar meer van bewust worden en zich hard maken voor genoeg openbare toiletten. Met die oproep komt de Continentie Stichting Nederland vandaag op de Nationale Plasdag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
