                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čas",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d4c1debd-08bb-3dcd-a624-e45ed421f796",
                                        "entry_id": "7f837740-50f9-3e6d-acc3-3c29218eda15",
                                        "glosses": [
                                            "doba"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0172b70e-53fd-4880-842a-d271b867b092",
                                                "sense_id": "d4c1debd-08bb-3dcd-a624-e45ed421f796",
                                                "text": "Čas je jedna ze základních fyzikálních veličin, jíž se měří vzdálenost mezi událostmi na první souřadnici časoprostoru."
                                            },
                                            {
                                                "example_id": "641ff3b4-9cdf-4569-9eaa-7fd4c0ed538e",
                                                "sense_id": "d4c1debd-08bb-3dcd-a624-e45ed421f796",
                                                "text": "Zítra budu mít bohužel příliš málo času, abych se na ten text podívala."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4188740e-0296-3d08-ad0e-c3b500d43903",
                                        "entry_id": "7f837740-50f9-3e6d-acc3-3c29218eda15",
                                        "glosses": [
                                            "dohodnutý způsob označování času (1) v určité oblasti"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7f01f8-4cc4-4c48-92b7-74fcdaeca114",
                                                "sense_id": "4188740e-0296-3d08-ad0e-c3b500d43903",
                                                "text": "Středoevropský čas se od britského liší o jednu hodinu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ed0d5c3-3282-3365-9323-ee3f4b23e4b1",
                                        "entry_id": "7f837740-50f9-3e6d-acc3-3c29218eda15",
                                        "glosses": [
                                            "příhodná doba"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3565d1dc-33da-4453-abb8-59e5f7aadc14",
                                                "sense_id": "1ed0d5c3-3282-3365-9323-ee3f4b23e4b1",
                                                "text": "Už je čas na svačinu."
                                            },
                                            {
                                                "example_id": "b989fcb0-ecd3-44a9-8e8a-9d816e5aa86c",
                                                "sense_id": "1ed0d5c3-3282-3365-9323-ee3f4b23e4b1",
                                                "text": "Na adresu režiséra Marka Najbrta, který jej kritizoval, pak [Miloš Zeman] uvedl: „Chtěl bych mu sdělit, že jeho čas minul a náš čas nastal.“ (…) Jestli má třiasedmdesátiletý prezident po bezmála třiceti letech politické praxe dojem, že jeho čas teprve teď nastal, proč by nemohli mít stejný dojem i mladí lidé, kteří v této zemi budou nepochybně žít déle než my?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68cf4d4e-f562-3555-a5c4-0d20fcdfc17d",
