                                "target_senses": [
                                    {
                                        "sense_id": "d18cb5fe-e497-36e9-ad11-9a50eec88d83",
                                        "entry_id": "9e1aab08-3184-33da-a000-69a84bafa145",
                                        "glosses": [
                                            "Person, die Kindergartenkinder betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a87037c-6156-4d1e-a527-c7038a2240cc",
                                                "sense_id": "d18cb5fe-e497-36e9-ad11-9a50eec88d83",
                                                "text": "Heute passen zwei Kindergärtner draußen auf die Kinder auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a8d3c4d-4c17-4460-9710-cc4a5df2e3fd",
                        "source_entry_id": "4088fb6b-025f-3afb-a891-27d0f73065d8",
                        "source_sense_id": "a43d5be0-7c68-3b19-afc5-947bbf9f34bf",
                        "source_sense_description": "person who teaches at a kindergarten",
                        "target_lang_word": "Kindergärtnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindergärtnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                        "entry_id": "01174db4-153e-3dd8-834a-cf642ba46a63",
                                        "glosses": [
                                            "weibliche Person, die Kindergartenkinder betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c58bf1c-5740-4389-9ab9-9cbf7b9f3cf8",
                                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                                "text": "Die Kindergärtnerin hat heute mehrere schwierigere Kindern zu betreuen."
                                            },
                                            {
                                                "example_id": "e7017645-66a7-4d44-ad4e-7d2904fe07cb",
                                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                                "text": "„Eine Kindergärtnerin hatte es geschossen und es mir zum Geburtstag geschenkt.“"
                                            },
                                            {
                                                "example_id": "2842a8a8-24ef-4a8a-bebd-0e388179286f",
                                                "sense_id": "c3425c03-965e-3e0f-95f6-655f63a78077",
                                                "text": "„Ein universitärer Studiengang müsse her, dazu ein weit gefächertes Fortbildungsprogramm für Kindergärtnerinnen, ein ganzes Bündel von Forschungsprogrammen zur Früherziehung sowie internationale Vernetzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d92ec90-defe-4b59-9128-9c2c952e40b7",
