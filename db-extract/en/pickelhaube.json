                    },
                    {
                        "form_id": "78c273d0-b67d-4fe2-8efc-cd8c0c85b9fa",
                        "entry_id": "cb1b7fda-3f6c-3d40-809e-e5c9b4723377",
                        "tags": [
                            "plural"
                        ],
                        "form": "pickelhauben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05f3caa6-7c6d-363c-ad2d-70d09c70f224",
                        "entry_id": "cb1b7fda-3f6c-3d40-809e-e5c9b4723377",
                        "glosses": [
                            "A spiked helmet worn by German troops, especially during the First World War."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ee110000-62da-4b7b-afc6-4a682987a746",
                                "sense_id": "05f3caa6-7c6d-363c-ad2d-70d09c70f224",
                                "text": "Whereupon an outlandish production number breaks out in which the Marx Brothers play xylophone on the pickelhauben of the assembled soldiers[…]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e34ce4-a965-460b-8e1b-25cf40c9ee6c",
                        "source_entry_id": "cb1b7fda-3f6c-3d40-809e-e5c9b4723377",
                        "source_sense_id": "05f3caa6-7c6d-363c-ad2d-70d09c70f224",
                        "source_sense_description": "helmet",
                        "target_lang_word": "casque à pointe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casque à pointe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b99e6dfb-3840-364b-84ec-6a0703273218",
                                        "entry_id": "eaf95675-afd6-355a-8267-e179c2307697",
                                        "glosses": [
                                            "Casque de militaire prussien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f43b6cb-6ff2-4971-8ab8-cec140379191",
                                                "sense_id": "b99e6dfb-3840-364b-84ec-6a0703273218",
                                                "text": "Et s'il en doutait encore, les militaires qu'il croisait dans la rue l'en auraient bien convaincu, avec leurs casques à pointe ou leurs bonnets de police si caractéristiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e8905aa-41a7-3b73-b7ac-2325259ac174",
                                        "entry_id": "eaf95675-afd6-355a-8267-e179c2307697",
                                        "glosses": [
                                            "Allemand, soldat allemand d’avant la Première Guerre mondiale."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3429b3df-6e41-441d-854d-f44e810e5243",
                                                "sense_id": "7e8905aa-41a7-3b73-b7ac-2325259ac174",
                                                "text": "Tant mieux, car ça va chauffer. Les casques à pointe se sont barricadés dans les rues... non, pas les casques à pointe... les casques à chenille... Le lieutenant Leblanc disait tout à l'heure qu'il n'y a là-dedans que des Bavarois.... ça sera dur tout de même..."
                                            },
                                            {
                                                "example_id": "a61ddcf9-819f-4036-9b84-6045d9d41b61",
                                                "sense_id": "7e8905aa-41a7-3b73-b7ac-2325259ac174",
                                                "text": "Les paysans les regardaient avec stupeur, cachés derrière leurs fenêtres; sur la place du village, une femme osa entr'ouvrir sa porte pour rappeler un enfant curieux, qui avait couru dehors afin de mieux voir les « casques à pointe. »"
                                            },
                                            {
                                                "example_id": "76d5e813-1549-4eda-a4a0-55fb3dbcab98",
                                                "sense_id": "7e8905aa-41a7-3b73-b7ac-2325259ac174",
                                                "text": "Mais cette même dame revient à un moment à 1940 et évoque les défilés allemands qu'elle décrit presque dans le détail. Mais elle parle à leur propos de « casques à pointe ». Autant dire que cette dame a un certain âge, qu'elle a connu les deux guerres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3573f42a-5410-42d0-8e58-25b31cf4eccc",
                        "source_entry_id": "cb1b7fda-3f6c-3d40-809e-e5c9b4723377",
                        "source_sense_id": "05f3caa6-7c6d-363c-ad2d-70d09c70f224",
                        "source_sense_description": "helmet",
                        "target_lang_word": "Pickelhaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pickelhaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a43bb20-64ed-3e33-9674-6ae4a08c5461",
                                        "entry_id": "f6c05709-4664-3c85-b648-b47e3e982a91",
                                        "glosses": [
                                            "Helm mit nach oben gerichteter Spitze (für Soldaten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c7defa-3efe-4c9f-ad48-fb40cd4c8cff",
                                                "sense_id": "0a43bb20-64ed-3e33-9674-6ae4a08c5461",
                                                "text": "„Der »Helm mit Spitze«, so die offizielle Bezeichnung für die Pickelhaube, war damals gerade erst in der preußischen Armee eingeführt worden.“"
                                            },
                                            {
                                                "example_id": "6812a4dd-11b6-4b98-b46c-d3d9566e214a",
                                                "sense_id": "0a43bb20-64ed-3e33-9674-6ae4a08c5461",
                                                "text": "„Heute tragen die Polizisten keine Pickelhauben mit Blitzableiterspitzen mehr, und die Radfahrer pfeifen aus dem letzten Schlauchloch.“"
                                            },
                                            {
                                                "example_id": "11d35756-68fc-4a27-b8ad-1f0de306aa5d",
                                                "sense_id": "0a43bb20-64ed-3e33-9674-6ae4a08c5461",
                                                "text": "„Bei »Preußen« denken die meisten an Pickelhaube und Stechschritt, an Obrigkeitshörigkeit und Militarismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
