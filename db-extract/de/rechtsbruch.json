                                                "example_id": "32bea161-27c5-437c-bd6d-53fc99b70a66",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "La peine n’était pas proportionnée au délit."
                                            },
                                            {
                                                "example_id": "38930c1f-3729-462f-aa0c-8972393d22c9",
                                                "sense_id": "dc785e74-6f03-36b6-b8f6-e672c6885bcb",
                                                "text": "Prendre quelqu’un en flagrant délit."
                                            },
