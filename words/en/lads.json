                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Me and the <w>lads</w> are planning a trip to the coast this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы с <w>пацанами</w> планируем поездку на побережье в эти выходные.",
                                "es": "Mis <w>colegas</w> y yo estamos planeando un viaje a la costa este fin de semana."
                            }
                        },
                        {
                            "text": "Are you <w>lads</w> ready to order your dinner now?",
                            "target_lang_translations": {
                                "ru": "Вы, <w>ребята</w>, готовы заказать ужин?",
                                "es": "¿Están listos para pedir la cena, <w>chicos</w>?"
                            }
