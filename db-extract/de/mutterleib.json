                    {
                        "sense_id": "833a6aa6-01b7-3dd9-9c49-057260d91054",
                        "entry_id": "9d457857-c280-322c-a57a-b8d0d3da32e0",
                        "glosses": [
                            "Bauch einer schwangeren Frau (im Hinblick auf den sich darin entwickelnden Embryo)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d0a6aa-0b3e-4f5f-860b-15bd7b8deeb8",
                                "sense_id": "833a6aa6-01b7-3dd9-9c49-057260d91054",
                                "text": "„Mediziner hofften, durch eine erhöhte Durchblutung der Plazenta das Wachstum der Kinder im Mutterleib zu fördern.“"
                            },
                            {
                                "example_id": "bb619100-0101-4a07-abf4-48a9e344f8b5",
                                "sense_id": "833a6aa6-01b7-3dd9-9c49-057260d91054",
                                "text": "„Manche enthalten Skelette in jener Stellung, die der Fötus im Mutterleib einnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017baede-ba39-4187-a611-550009717f03",
                        "source_entry_id": "9d457857-c280-322c-a57a-b8d0d3da32e0",
                        "source_sense_id": "833a6aa6-01b7-3dd9-9c49-057260d91054",
                        "source_sense_description": "Bauch einer schwangeren Frau (im Hinblick auf den sich darin entwickelnden Embryo)",
                        "target_lang_word": "womb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67e056a7-3184-35dd-8d19-cb630bc207e9",
                                        "entry_id": "7e3b1904-fb7b-378d-8559-9e9121e10691",
                                        "glosses": [
                                            "In female mammals, the organ in which the young are conceived and grow until birth; the uterus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c119c2-6209-45b4-ade2-c51698133724",
                                                "sense_id": "67e056a7-3184-35dd-8d19-cb630bc207e9",
                                                "text": "I danced myself right out the womb / Is it strange to dance so soon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb77d40-b32e-35c4-a3ed-d519250ab20c",
                                        "entry_id": "7e3b1904-fb7b-378d-8559-9e9121e10691",
                                        "glosses": [
                                            "The abdomen or stomach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f73a33-75bb-49ab-98b8-6bf3b2ff5bf9",
                                                "sense_id": "abb77d40-b32e-35c4-a3ed-d519250ab20c",
                                                "text": "And his hede, hym semed,was enamyled with asure, and his shuldyrs shone as the golde, and his wombe was lyke mayles of a merveylous hew[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad9e2aef-96bc-3e18-9314-c29d48b9668c",
                                        "entry_id": "7e3b1904-fb7b-378d-8559-9e9121e10691",
                                        "glosses": [
                                            "The stomach of a person or creature."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e6d3404-ba98-3394-8f4d-9f929a2d8094",
                                        "entry_id": "7e3b1904-fb7b-378d-8559-9e9121e10691",
                                        "glosses": [
                                            "A place where something is made or formed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8eb4a97-51fa-4494-89ab-4127d71b6076",
                                                "sense_id": "5e6d3404-ba98-3394-8f4d-9f929a2d8094",
                                                "text": "The womb of earth the genial seed receives."
                                            },
                                            {
                                                "example_id": "e5709717-e4bb-4ca5-987e-a120441a33a7",
                                                "sense_id": "5e6d3404-ba98-3394-8f4d-9f929a2d8094",
                                                "text": "The shadows of the future hours rose dark and menacing from the womb of time [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e0173c-f319-3b52-aacd-401724854d4a",
                                        "entry_id": "7e3b1904-fb7b-378d-8559-9e9121e10691",
                                        "glosses": [
                                            "Any cavity containing and enveloping anything."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f623bf5-c97c-4b6c-a57b-1e501104d442",
                                                "sense_id": "98e0173c-f319-3b52-aacd-401724854d4a",
                                                "text": "The centre spike of gold\n Which burns deep in the blue-bell's womb."
                                            }
                                        ]
                                    }
                                ]
                            },
