                    {
                        "sense_id": "feee026a-f338-3446-9791-9bde246b1f76",
                        "entry_id": "3a398021-a17a-353d-a9f2-336df5e7e2ca",
                        "glosses": [
                            "Graphie ancienne de vert."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "426163c6-14fd-4b97-89ca-a5c43b08e4ec",
                                "sense_id": "feee026a-f338-3446-9791-9bde246b1f76",
                                "text": "[…] Le verd Tarin gentil, cigalant ſon ramage; […]"
                            },
                            {
                                "example_id": "ddf7b09f-7eb5-4033-96d5-869bda6c8122",
                                "sense_id": "feee026a-f338-3446-9791-9bde246b1f76",
                                "text": "Ses feuilles sont de petits brins toujours verds."
                            },
                            {
                                "example_id": "d91a67b6-73c7-4bf2-a3b3-2e5b846af4ea",
                                "sense_id": "feee026a-f338-3446-9791-9bde246b1f76",
                                "text": "Il fait prendre à l’étain une forme crystallisée, […] ; il change le plomb en crystaux blancs & verds, […], d’où l’on voit que l’arsenic a la propriété de s’unir très intimement avec les substances métalliques, desquelles on a beaucoup de peine de le dégager par le grillage & par les travaux de la Métallurgie."
                            }
                        ]
                    }
