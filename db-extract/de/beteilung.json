                "senses": [
                    {
                        "sense_id": "7ebcf208-90d8-3f8f-9f8a-92a34a2f648f",
                        "entry_id": "da409962-e93e-36f2-9835-29ee4d8f837a",
                        "glosses": [
                            "Vorgang des Gebens"
                        ],
                        "tags": [
                            "Austrian German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "cb5c9510-93c5-4435-8d4b-66ef743a83bd",
                                "sense_id": "7ebcf208-90d8-3f8f-9f8a-92a34a2f648f",
                                "text": "„Die von diesen abweichende Beteilung der beiden Erben und der Pflichtteilsberechtigten unterliege der Privatautonomie der Beteiligten und könne folglich keinen Einfluss auf die Erbschaftssteuerbemessung haben.“"
                            },
                            {
                                "example_id": "d1dd043f-7071-4043-b2a7-2b1fc521a407",
                                "sense_id": "7ebcf208-90d8-3f8f-9f8a-92a34a2f648f",
                                "text": "„Er hatte für diese Zeit nach dem mit 1.Juli 1992 in Kraft getretenen Heeresgebührengesetz 1992 neben dem Anspruch auf Sachbezüge (auf unentgeltliche Unterbringung im Sinn des § 12 HGG, die unentgeltliche Verpflegung im Sinn des § 13 HGG sowie auf unentgeltliche Beteilung mit Bekleidung im Sinn des § 16 HGG) auch einen Anspruch auf Barbezüge im Sinn des § 3 HGG.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
