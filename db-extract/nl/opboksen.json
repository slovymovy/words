        "nl-extract.jsonl": [
            {
                "entry_id": "e82c4bee-2e0c-3286-af62-9ab7e2c7ba54",
                "word": "opboksen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b56db8ae-904e-30fd-ae59-01dad230fb64",
                        "entry_id": "e82c4bee-2e0c-3286-af62-9ab7e2c7ba54",
                        "glosses": [
                            "met veel moeite ingaan tegen iets of iemand: vooral in decombinatie opboksen tegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae72adf-9560-4bc3-bd24-9e7cf3553144",
                                "sense_id": "b56db8ae-904e-30fd-ae59-01dad230fb64",
                                "text": "Daarna probeerde Lotto-Soudal het nog opnieuw met Sean De Bie maar die moest alleen opboksen tegen een jagend peloton en was kansloos."
                            },
                            {
                                "example_id": "a3140128-2001-4a5f-917d-bbcc2cf99852",
                                "sense_id": "b56db8ae-904e-30fd-ae59-01dad230fb64",
                                "text": "Moers blijft zeer sceptisch ondanks het voorlopige succes van de crowdfundingsactie. \"Goed, iedereen heeft het recht om zijn geld kwijt te raken. Kijkshop was ooit een totale vernieuwing, maar om nu nog met zo'n platform te starten is gewoon rijkelijk laat. Ze kunnen zelfs met het bedrag dat ze nu hebben opgehaald niet opboksen tegen hun concurrentie, die miljarden pompt in hun eigen platformen. Het lijkt me een hopeloos moeilijke taak. Ik heb respect voor het feit dat ze iets anders proberen, maar het is too little, too late.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8da5daa-398c-4a05-9536-eecba314faf5",
                        "source_entry_id": "e82c4bee-2e0c-3286-af62-9ab7e2c7ba54",
                        "source_sense_id": "b56db8ae-904e-30fd-ae59-01dad230fb64",
                        "source_sense_description": "met veel moeite ingaan tegen iets of iemand: vooral in combinatie met tegen",
                        "target_lang_word": "struggle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "struggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa9e2b3-cb1a-310f-b3bf-b3d85c2aa458",
                                        "entry_id": "63ebf7ef-a0c0-330b-816f-5eb8dbcdea9b",
                                        "glosses": [
                                            "A contortion of the body in an attempt to escape or to perform a difficult task."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "563734fc-5df2-33af-96ca-27da91be2198",
                                        "entry_id": "63ebf7ef-a0c0-330b-816f-5eb8dbcdea9b",
                                        "glosses": [
                                            "Strife, contention, great effort."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a571a0-af90-442a-afef-ff44fb3d40bf",
                                                "sense_id": "563734fc-5df2-33af-96ca-27da91be2198",
                                                "text": "The struggle with ways and means had recommenced, more difficult now a hundredfold than it had been before, because of their increasing needs. Their income disappeared as a little rivulet that is swallowed by the thirsty ground. He worked night and day to supplement it."
                                            },
                                            {
                                                "example_id": "6ec25891-00a8-4750-b8d6-b8a0f59d724b",
                                                "sense_id": "563734fc-5df2-33af-96ca-27da91be2198",
                                                "text": "R. Moskowitz charges cisgender readers to be as conscious and deliberate with our religious identities as transgender and gender non-conforming people are with theirs, arguing that holiness is only achieved through continuous and unrelenting struggle and change."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "struggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                        "entry_id": "1bf5e88d-54bf-3bef-af95-0ee23bf24b34",
                                        "glosses": [
                                            "To strive, to labour in difficulty, to fight (for or against), to contend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d95b33e-f29f-4225-8a67-e384197d017e",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "During the centuries, the people of Ireland struggled constantly to assert their right to govern themselves."
                                            },
                                            {
                                                "example_id": "26246dd4-02cc-43d7-a043-11b41cb22138",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "Troutbeck is a tiny village midway between Penrith and Keswick in a very sparsely populated part of Cumberland, and it used to be said by facetious travellers that the reason why it ever had a station at all was to give the engine a rest after it had struggled up the long and trying incline from Threlkeld."
                                            },
                                            {
                                                "example_id": "282a53db-a7ee-487d-adf5-1cb9dee75a5c",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "England were ponderous with ball in hand, their runners static when taking the ball and their lines obvious, while their front row struggled badly in the scrum."
                                            },
                                            {
                                                "example_id": "701f5fff-6f64-4a27-a977-fc36aaac5914",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            },
                                            {
                                                "example_id": "0af22fb2-16bd-4e45-a001-5d3439434ceb",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "Most train operators have reduced services with emergency timetables, as they struggle to cope with a rapid increase in staff absences due to the Omicron variant of COVID."
                                            },
                                            {
                                                "example_id": "6dc933ea-76e5-443e-be48-4465b4bb99e1",
                                                "sense_id": "e4e67ed5-6b49-3191-8e9f-9b02a1dd3058",
                                                "text": "The sheriff’s office released a compilation of bodycam footage Friday from deputies at the scene that shows them handcuffing Earl and pinning him down for more than 20 minutes as he struggles and repeatedly shouts for help."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0223c1-0b7a-39e7-865a-0c30df39d965",
                                        "entry_id": "1bf5e88d-54bf-3bef-af95-0ee23bf24b34",
                                        "glosses": [
                                            "To have difficulty with something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0eecf6-c82c-4cd9-bdc3-021c79646dea",
                                                "sense_id": "3b0223c1-0b7a-39e7-865a-0c30df39d965",
                                                "text": "One of the doctor’s patients struggled with depression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c6bc01-5b0d-311f-b47a-c5ea7d935fb5",
                                        "entry_id": "1bf5e88d-54bf-3bef-af95-0ee23bf24b34",
                                        "glosses": [
                                            "To strive, or to make efforts, with a twisting, or with contortions of the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c2687c7-d0a2-4906-ac1e-85755053e5f9",
                                                "sense_id": "69c6bc01-5b0d-311f-b47a-c5ea7d935fb5",
                                                "text": "She struggled to escape from her assailant's grasp."
                                            },
                                            {
                                                "example_id": "ad6d0837-9933-41a7-93cd-37bb0daef1d3",
                                                "sense_id": "69c6bc01-5b0d-311f-b47a-c5ea7d935fb5",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out. Indeed, a nail filed sharp is not of much avail as an arrowhead; you must have it barbed, and that was a little beyond our skill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
