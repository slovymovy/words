                        "glosses": [
                            "Varying regularly with a day/night cycle; diurnal; circadian."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8894247-3bfe-4b46-9e46-a48a8b7ace7c",
                                "sense_id": "19150765-2b4d-36a7-8d99-4ff420632bd9",
                                "text": "To cope with daily variation of environmental parameters, talitrids evolved a migratory behaviour, synchronized with tidal and nictemeral cycles, that enable them to locate the suitable patches of habitat on the shore (Pardi and Ercolini 1986)."
                            }
                        ]
                    }
