                        ],
                        "examples": [
                            {
                                "example_id": "972ddd1a-6786-414a-bf2b-0a5a76cd6bd0",
                                "sense_id": "0a29faf1-8ac0-3203-b572-2a8d26738cc2",
                                "text": "On obtient une bonne « clouabilité » par l'addition d'asbeste, de poudre de pierre ponce, de résidus de la combustion de charbon et de coke, de débris épars de mortier de chaux […]."
                            },
                            {
                                "example_id": "26a4c33e-e1ee-41ea-8f73-bd684ac6fc47",
                                "sense_id": "0a29faf1-8ac0-3203-b572-2a8d26738cc2",
                                "text": "Propriétés : densité, résistance, retrait et gonflement (plus élevé que pour le béton ordinaire), conductibilité thermique, capacité d’absorption d’eau, clouabilité et sciabilité, emploi dans le béton armé."
                            }
                        ]
