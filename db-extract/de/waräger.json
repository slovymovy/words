                "senses": [
                    {
                        "sense_id": "33666106-7bfa-352e-a6ca-284e557cc2ff",
                        "entry_id": "2a71f20e-755a-3b6a-96c6-ca9f911f26ea",
                        "glosses": [
                            "in Ost- und Südosteuropa gebräuchliche Bezeichnung für einen Angehörigen eines ursprünglich in Skandinavien beheimateten Volksstammes"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f624b80a-78f4-4546-b916-6d8b7341147a",
                                "sense_id": "33666106-7bfa-352e-a6ca-284e557cc2ff",
                                "text": "„Die Waräger erwarben sich nicht den schrecklichen Ruf ihrer stammverwandten Normannen im Westen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
