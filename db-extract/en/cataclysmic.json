                "senses": [
                    {
                        "sense_id": "a71e7b52-78a1-3f34-ad70-8134324b5702",
                        "entry_id": "38a974d1-0574-314b-80b4-c4c2aeafc97f",
                        "glosses": [
                            "Of or pertaining to a cataclysm; causing great destruction or upheaval; catastrophic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0584574-e5f5-46bb-818c-7caa3c7504dd",
                                "sense_id": "a71e7b52-78a1-3f34-ad70-8134324b5702",
                                "text": "It is believed that a cataclysmic impact caused the extinction of the dinosaurs."
                            },
                            {
                                "example_id": "9b9d5019-1d7c-42b7-96a8-020f2882eb04",
                                "sense_id": "a71e7b52-78a1-3f34-ad70-8134324b5702",
                                "text": "That’s why to be rejected in love was so cataclysmic: one had been judged and found wanting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ee4099c-2ff7-43da-bb57-a11dd65b0a12",
