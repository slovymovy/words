{
    "word_family": [
        "shake",
        "shaker",
        "shakeable",
        "shaky"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0df5ed32-d433-3a0e-89a7-550c93b0754d",
                    "sense_definition": "In a state of shock, trauma, or emotional disturbance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were left <w>shaken</w> by the sudden news of the accident.",
                            "target_lang_translations": {
                                "ru": "Мы остались <w>потрясёнными</w> внезапными новостями об аварии."
                            }
                        },
                        {
                            "text": "The witness was visibly <w>shaken</w> after seeing the crime.",
                            "target_lang_translations": {
                                "ru": "Свидетель был заметно <w>взволнован</w> после увиденного преступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "shocked",
                        "disturbed",
                        "upset",
                        "rattled"
                    ],
                    "antonyms": [
                        "calm",
                        "composed"
                    ],
                    "common_phrases": [
                        "visibly shaken",
                        "deeply shaken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии шока, потрясения или эмоционального расстройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясённый",
                                "target_lang_sense_clarification": "глубоко взволнованный или шокированный событием"
                            },
                            {
                                "target_lang_word": "взволнованный",
                                "target_lang_sense_clarification": "находящийся в состоянии сильного беспокойства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e5bff40-88da-39a0-96f2-9d689a214bf0",
                    "sense_definition": "Past participle of <w>shake</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bottle had been <w>shaken</w> before it was opened.",
                            "target_lang_translations": {
                                "ru": "Бутылку <w>встряхнули</w> перед тем, как открыть."
                            }
                        },
                        {
                            "text": "He has <w>shaken</w> hands with many famous people.",
                            "target_lang_translations": {
                                "ru": "Он <w>пожал</w> руку многим знаменитым людям."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb shake."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола «трясти»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрясённый",
                                "target_lang_sense_clarification": "в значении «встряхнутый» (например, о жидкости)"
                            },
                            {
                                "target_lang_word": "пожатый",
                                "target_lang_sense_clarification": "в контексте рукопожатия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f537e58a-4bf2-3e56-ad7b-a17a7a356371",
                    "sense_definition": "A flat, wheel-shaped throwing star used as a weapon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ninja threw the <w>shaken</w> with great precision.",
                            "target_lang_translations": {
                                "ru": "Ниндзя метнул <w>сюрикен</w> с большой точностью."
                            }
                        },
                        {
                            "text": "A collection of traditional weapons including a <w>shaken</w> was displayed.",
                            "target_lang_translations": {
                                "ru": "Была выставлена коллекция традиционного оружия, включая <w>сюрикен</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shuriken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская метательная звезда, используемая в качестве оружия (сюрикен)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сюрикен",
                                "target_lang_sense_clarification": "японское метательное оружие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}