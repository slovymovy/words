        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f1fceefb-3db2-3ac9-ad9c-1a8495e6fac8",
                    "sense_definition": "Used to encourage someone to wake up.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "waking_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother shouted <w>wakey</w> to her children so they would not be late for school.",
                            "target_lang_translations": {
                                "pl": "Matka krzyknęła <w>pobudka</w> do swoich dzieci, żeby nie spóźniły się do szkoły."
                            }
                        },
                        {
                            "text": "He playfully called out <w>wakey</w> to his friend who was still sleeping on the sofa.",
                            "target_lang_translations": {
                                "pl": "Żartobliwie zawołał <w>pobudka</w> do przyjaciela, który wciąż spał na kanapie."
                            }
                        }
                    ],
                    "synonyms": [
                        "wakey wakey"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a playful or informal manner."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Używane, aby zachęcić kogoś do pobudki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pobudka",
                                "target_lang_sense_clarification": "potoczne zawołanie używane przy budzeniu kogoś"
                            },
                            {
                                "target_lang_word": "wstawaj",
                                "target_lang_sense_clarification": "bezpośrednie wezwanie do wstania z łóżka"
                            }
                        ]
                    }
                }
            ]
        },
        {
