                "senses": [
                    {
                        "sense_id": "68ffad99-87d1-3f35-a63a-01b2abfba062",
                        "entry_id": "2da47bc6-f5ce-3246-a4c0-d2ac63896be6",
                        "glosses": [
                            "An advance warning; an omen."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c28dfb68-dc16-4a45-9ff3-f312c9c53796",
                                "sense_id": "68ffad99-87d1-3f35-a63a-01b2abfba062",
                                "text": "Beatrice knew his footstep at a distance that might have defied even the acute listener of the fairy tale; and yet, with even such long forewarning, would blush crimson deep on his entrance."
                            },
                            {
                                "example_id": "fade7ac5-6e49-48b1-8f61-52d65da0f49c",
                                "sense_id": "68ffad99-87d1-3f35-a63a-01b2abfba062",
                                "text": "I have never believed, as some people do, in omens and forewarnings, for the dramatic things in my life have generally come upon me as suddenly as a tropical thunder-storm."
                            },
                            {
                                "example_id": "9e7c4b82-eb1b-4e85-b845-ce7210f93d56",
                                "sense_id": "68ffad99-87d1-3f35-a63a-01b2abfba062",
                                "text": "For many humans, life does end abruptly, without much forewarning."
                            },
                            {
                                "example_id": "00608b1c-a6fe-4ff7-a187-88ef38a4740d",
                                "sense_id": "68ffad99-87d1-3f35-a63a-01b2abfba062",
                                "text": "“It’s kind of this forewarning of like, ‘Hey you’re annoying me, I’m going to crash out,’” he said, “or like, ‘This project I’m working on is going to make me crash out.’”"
                            }
                        ]
                    }
