                "senses": [
                    {
                        "sense_id": "669500f9-1969-3097-a1da-a0b087efb300",
                        "entry_id": "f05b1e44-0033-37bf-a961-b2c3f1ed64da",
                        "glosses": [
                            "tajemny zlot czarownic"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "3eb8c367-0f51-4e3a-b55a-ee71ecb92d54",
                                "sense_id": "669500f9-1969-3097-a1da-a0b087efb300",
                                "text": "Ponoć na Łysej Górze odbywały się sabaty wiedźm."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "552a7593-c0d7-3f7a-80f6-42dbe56a1e29",
                        "entry_id": "f05b1e44-0033-37bf-a961-b2c3f1ed64da",
                        "glosses": [
                            "zob. szabat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c12a92f-7a12-4013-b0de-3121783556b4",
                                "sense_id": "552a7593-c0d7-3f7a-80f6-42dbe56a1e29",
                                "text": "Jahwe odwraca wzrok od waszych sabatów, nie podobają mu się wasze święta nowiu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d1aa691-c160-4d83-9d23-c0e779152d29",
                        "source_entry_id": "f05b1e44-0033-37bf-a961-b2c3f1ed64da",
                        "source_sense_id": "669500f9-1969-3097-a1da-a0b087efb300",
                        "target_lang_word": "Sabbath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sabbath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ce39b9-3334-3e65-836b-713d665406d2",
                                        "entry_id": "bb016128-8649-359e-aa59-c0890da83d74",
                                        "glosses": [
                                            "Saturday, observed in Judaism as a day of rest and worship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba732f80-500d-3e69-bcf9-b31b3f112f94",
                                        "entry_id": "bb016128-8649-359e-aa59-c0890da83d74",
                                        "glosses": [
                                            "Sunday, observed in Christianity as a day of rest and worship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b596022f-2106-3c22-b921-553ca75d9ca1",
                                        "entry_id": "bb016128-8649-359e-aa59-c0890da83d74",
                                        "glosses": [
                                            "Friday, observed in Islam as a day of rest and worship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ee3b9e-e776-4257-b8b4-a86031c36662",
                                                "sense_id": "b596022f-2106-3c22-b921-553ca75d9ca1",
                                                "text": "Jerusalem is a city of three Sabbaths–Friday (Muslim), Saturday (Jewish), and Sunday (Christian)."
                                            },
                                            {
                                                "example_id": "f984a519-2906-4e76-ac7e-51a765ac23bb",
                                                "sense_id": "b596022f-2106-3c22-b921-553ca75d9ca1",
                                                "text": "Witches always anointed themselves with ointments before departing up the chimney to their Sabbaths. One such ointment was composed of Aconite, Belladonna, Water Parsley, Cinquefoil and Babies' Fat."
                                            },
                                            {
                                                "example_id": "89c0ac7e-0b48-4e1c-b86d-0bd2d2b9cfd4",
                                                "sense_id": "b596022f-2106-3c22-b921-553ca75d9ca1",
                                                "text": "Around this conception was built up the notion of ritual devil-worship, involving the sabbath or nocturnal meeting at which the witches gathered to worship their master and to copulate with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998f903c-4470-32a1-8749-43182ab43992",
                                        "entry_id": "bb016128-8649-359e-aa59-c0890da83d74",
                                        "glosses": [
                                            "Among the ancient Jews and Hebrews, the seventh year, when the land was left fallow."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbf86194-7009-3f4e-bd8a-f2ece1e88156",
                                        "entry_id": "bb016128-8649-359e-aa59-c0890da83d74",
                                        "glosses": [
                                            "Synonym of uposatha, a regular day of fasting, devotion, or other religious observance."
                                        ],
                                        "tags": [
                                            "Myanmar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4523fc6b-bcb0-4b52-9047-7af37f480896",
                        "source_entry_id": "f05b1e44-0033-37bf-a961-b2c3f1ed64da",
                        "source_sense_id": "669500f9-1969-3097-a1da-a0b087efb300",
