                "senses": [
                    {
                        "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                        "entry_id": "b4fe2416-28cd-36f9-ad0f-a0ad71d11181",
                        "glosses": [
                            "Zustand der Entflechtung/Trennung von Kirche und Staat, Weltlichkeit in Abgrenzung zur Religiosität"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "c543377a-0de8-4ee7-90ac-e66e9f329d86",
                                "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                                "text": "„Nicht nur gilt die Säkularität für viele Muslime geradezu als Äquivalent für eine moderne Gottlosigkeit; sie steht außerdem für die Kultur des ‚Westens‘, die infolge des kolonialistischen Traumas weithin als Bedrohung wahrgenommen wird.“"
                            },
                            {
                                "example_id": "28438d20-0d26-4a38-ba68-f1dc4328cf62",
                                "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                                "text": "„Er scheint somit von der Säkularität als einem grundlegendem Prinzip der Verfassungsordnung auszugehen, spricht dies aber nicht explizit aus, sondern sieht die Säkularität wiederum als integralen Bestandteil des republikanischen Prinzips.“"
                            },
                            {
                                "example_id": "9171e0ae-2e78-4ddf-abde-305ef554f17b",
                                "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                                "text": "„Im Folgenden soll der oft gestellten Frage nach dem Verhältnis von Islam und Säkularität nachgegangen werden.“"
                            },
                            {
                                "example_id": "77f451ef-77f2-4085-bfa6-6955bb4fc060",
                                "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                                "text": "„Die Institutionalisierung des Rechts auf Religionsfreiheit in Europa und seine Verknüpfung mit dem Gleichheitsprinzip sowie mit der Idee staatlicher Säkularität war ein langwieriger Prozess, der sich in den verschiedenen europäischen Staaten weder gleichförmig noch zur gleichen Zeit vollzogen hat.“"
                            },
                            {
                                "example_id": "1f721c45-a822-4396-a8ea-5f9f374af2ec",
                                "sense_id": "ba4ec180-be6d-37f1-86f9-55c49d328f8b",
                                "text": "„Der vorliegende Band – so lässt sich zusammenfassen – konstatiert Bewegungen und Umstellungen vielfältiger Art in den Diskursen um Säkularität, Moderne und Religion. Er verweist auf tiefgreifende Veränderungen in der Wahrnehmung von Säkularität, die deren Genealogie wie deren gegenwärtige Ausprägung betreffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
