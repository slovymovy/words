                "senses": [
                    {
                        "sense_id": "37d032a7-f5da-3a61-86ad-d7ba8d3671d0",
                        "entry_id": "98f62e2c-62b8-3af4-9c5f-f14a3b573906",
                        "glosses": [
                            "Eau-de-vie hongroise à base de fruits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db005e7-e15a-4cb0-9fcc-7833db2745dd",
                                "sense_id": "37d032a7-f5da-3a61-86ad-d7ba8d3671d0",
                                "text": "Le brave oncle était propriétaire d’un magasin avec une auberge adjacente et souvent le père de Ditke, Adam, Shalom en hébreu, allait y prendre une bière ou un godet de pálinka, ce que sa sœur critiquait."
                            },
                            {
                                "example_id": "60b6e8ba-2c5f-44d7-b885-615808f3c7cc",
                                "sense_id": "37d032a7-f5da-3a61-86ad-d7ba8d3671d0",
                                "text": "Le grand-père criait plus fort, et ce vers résonnait étrangement dans la bouche d’un homme que la pálinka poussait à chanter."
                            },
                            {
                                "example_id": "a978b383-ab5e-40c6-89bb-778ebe5206bd",
                                "sense_id": "37d032a7-f5da-3a61-86ad-d7ba8d3671d0",
                                "text": "En 2004, la Hongrie et quatre comtés d’Autriche ont obtenu de l’Union européenne les droits exclusifs sur l’appellation commerciale pálinka, pour des boissons distillées uniquement à base de fruits."
                            }
                        ]
                    }
