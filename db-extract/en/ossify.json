                    },
                    {
                        "form_id": "566cc094-0c19-4dbf-96cb-bc9d34a70928",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "ossified"
                    },
                    {
                        "form_id": "9158f285-485e-40f0-bb5b-c3be2bc25bda",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "tags": [
                            "past"
                        ],
                        "form": "ossified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f996be6-0c1c-36b3-9889-326178ccfcf2",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "glosses": [
                            "To transform (or cause to transform) from a softer animal substance into bone; particularly the processes of growth in humans and animals."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9745dba5-2d98-460a-9c05-e057b4222b60",
                                "sense_id": "1f996be6-0c1c-36b3-9889-326178ccfcf2",
                                "text": "[…], nor do all bones of the same skeleton ossify during the samе period of time."
                            }
                        ]
                    },
                    {
                        "sense_id": "aabcd5b3-33cd-371e-b6ab-cf5eafe1c9ac",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "glosses": [
                            "To become (or cause to become) inflexible and rigid in habits or opinions."
                        ],
                        "tags": [
                            "ambitransitive",
                            "animate"
                        ],
                        "examples": [
                            {
                                "example_id": "58d7da01-4f52-4f8e-ba14-ccce48d73822",
                                "sense_id": "aabcd5b3-33cd-371e-b6ab-cf5eafe1c9ac",
                                "text": "Before long, the entire organization ossifies."
                            },
                            {
                                "example_id": "d0ab3f8b-7c2d-4a34-875f-b344e35244db",
                                "sense_id": "aabcd5b3-33cd-371e-b6ab-cf5eafe1c9ac",
                                "text": "Possession of absolute knowledge would ossify the human spirit, quenching human creativity;"
                            }
                        ]
                    },
                    {
                        "sense_id": "09d15b08-7768-30f8-afe8-079159327837",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "glosses": [
                            "To grow (or cause to grow) formulaic and permanent."
                        ],
                        "tags": [
                            "ambitransitive",
                            "inanimate"
                        ],
                        "examples": [
                            {
                                "example_id": "1ef95eb2-f643-4213-876d-4593d020425e",
                                "sense_id": "09d15b08-7768-30f8-afe8-079159327837",
                                "text": "This accidental repartition gets repeated, develops advantages of its own, and gradually ossifies into a systematic division of labour."
                            },
                            {
                                "example_id": "ca3e3397-2693-4a6b-a434-e203b52741b1",
                                "sense_id": "09d15b08-7768-30f8-afe8-079159327837",
                                "text": "Now, in turn, we apply a revolutionary critique that […] ossifies into a rhetoric to become \"the monstrous Latin of a monstrous church.\""
                            },
                            {
                                "example_id": "ca9bbd5c-bcc4-4926-9e56-ab326e87d358",
                                "sense_id": "09d15b08-7768-30f8-afe8-079159327837",
                                "text": "[T]he charge threatens to ossify into conventional wisdom before the movie's audience can get to theaters to see how misguided it is."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f4f2037-e983-3ded-a53e-32c56fe782e9",
                        "entry_id": "51d51e4d-32b9-3da6-9bb1-12fd0053a960",
                        "glosses": [
                            "To calcify."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8e3e4e0f-a3c6-40e5-b023-f785a32283ea",
                                "sense_id": "7f4f2037-e983-3ded-a53e-32c56fe782e9",
                                "text": "The cartilages become brittle, and in many instances are ossified; the ligaments are rendered harder, but are less capable of resisting extension."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46effc86-3eeb-4275-aae6-35242c78feb3",
