                                "target_word": "Widerwille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                        "entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                                        "glosses": [
                                            "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e41a167-d759-42fb-9fe4-0efe9d2dd08b",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„In diesem Augenblick fühlte er nichts anderes als einen unbestimmten Zorn, einen tiefen Widerwillen und den Beginn einer grenzenlosen Hoffnungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "4683c385-5f0b-40c3-ba52-8b951cdf2261",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Sie hatte sich bei der Arbeit niemals wohl gefühlt, aber jetzt trat zum Unbehagen plötzlich noch Widerwille hinzu.“"
                                            },
                                            {
                                                "example_id": "743e4064-8626-4897-a82e-44f12cf8a682",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Aber gerade in diesem Widerwillen gegen alles fand Pierre einen seltsam erregenden Reiz.“"
                                            },
                                            {
                                                "example_id": "097630bc-a125-4db5-8669-2ddd5a23adf9",
                                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                                "text": "„Ich tat es mit Widerwillen und stand Höllenqualen aus, nicht aus Verlangen, an seine Stelle zu treten, denn bei mir rührte sich nichts, sondern aus Wut darüber, daß sich eine so schöne Frau einem Mann hingab, der seinen einzigen Vorzug mit dem Esel gemeinsam hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e74cc38a-0fd5-4d90-8b84-46cd91919a78",
                        "source_entry_id": "52d74f9b-356c-3d8a-8556-cc027bac8ad9",
                        "source_sense_id": "a9ae78c9-7d9e-35f2-b8e4-824293838189",
                        "source_sense_description": "gehoben: starke Abneigung gegenüber jemandem/etwas; Abscheu, Widerwille, Ekel",
                        "target_lang_word": "Ekel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ekel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                        "entry_id": "eec15d3e-2e33-31a3-877e-72b598932b8f",
                                        "glosses": [
                                            "starker körperlicher Abscheu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3629e8-198a-4205-93c0-c87fedfa9b91",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "Vor Ekel verging ihm ganz der Appetit."
                                            },
                                            {
                                                "example_id": "2aaf8650-b070-4686-823d-8e25acbba21d",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "Schon der Anblick von Kutteln flößt ihr Ekel ein, bei deren Anblick hebt sich ihr der Magen."
                                            },
                                            {
                                                "example_id": "11c7e06c-dff6-4c99-be6a-8e05a7113b38",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "Das Pflegepersonal lernt, den eigenen Ekel zu überwinden."
                                            },
                                            {
                                                "example_id": "2102ddba-26ac-402d-899b-f133fdab6ed8",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "„Er ruderte und paddelte wieder voller Angst und Ekel und mit dem vielen Alkohol im Blut, schnaufend und stöhnend und ohne klaren Gedanken als nur: fort von hier.“"
                                            },
                                            {
                                                "example_id": "4c51f5b5-d082-49d9-abd6-b18159154dce",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "„Dieser Gedanke, der einen wahren Kern enthält, erregt Ekel und Widerwillen.“"
                                            },
                                            {
                                                "example_id": "d7c9e3b2-fa1e-49d4-8f9e-eccd37ca05d0",
                                                "sense_id": "f2133a03-4c4d-3d85-bf38-eb4a3dd77787",
                                                "text": "„Und der Ekel riss ihn in den totalen Zusammenbruch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ekel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15ecb43a-948e-3473-b31a-6d6df9bf9f64",
