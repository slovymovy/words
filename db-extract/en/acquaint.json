                "senses": [
                    {
                        "sense_id": "abf18082-987c-34d3-985f-88818b2a54b5",
                        "entry_id": "cf122d2c-5eeb-34f9-a59e-3f1a8c6729b6",
                        "glosses": [
                            "Acquainted."
                        ],
                        "tags": [
                            "Scotland",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6c218df-929a-4fc5-9694-207635cc2ce2",
                                "sense_id": "abf18082-987c-34d3-985f-88818b2a54b5",
                                "text": "[I]f you have skimmed through even a paragraph of my poor neglected little magnum opus you will know I am unusually acquaint with my inner workings."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
