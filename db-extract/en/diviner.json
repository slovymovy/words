                        "target_lang_word": "Rutengänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rutengänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1fb5f3-7b92-3db7-acdc-ab0c6a214abe",
                                        "entry_id": "59b4c330-6f27-3e14-aa75-74ca16420868",
                                        "glosses": [
                                            "(männliche^☆) Person, die mit Hilfe einer Wünschelrute nach Erz- oder Wasseradern sucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5caa78c-4d99-42a4-9fa4-bb39f8242f97",
                                                "sense_id": "dd1fb5f3-7b92-3db7-acdc-ab0c6a214abe",
                                                "text": "„Hier war Laura Leonore im Jahr 1979 auf einen alten Mann namens Karl Bausin gestoßen, einen ehemaligen Sattler, der schon lange in Pension lebte und ein passionierter Rutengänger war.“"
                                            },
                                            {
                                                "example_id": "770e4325-4481-45aa-bf40-e68d3b553642",
                                                "sense_id": "dd1fb5f3-7b92-3db7-acdc-ab0c6a214abe",
                                                "text": "„Richard schnitt sich aus einem in vollem Saft stehenden, grünen Busch einen gegabelten Zweig, fasste ihn an den Zinken und versuchte sich als Rutengänger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cba19e9-fb1b-4000-9cfc-27889d610577",
