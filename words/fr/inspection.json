    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4219bf1-4fa0-3dc8-9af9-3d211adb4f5f",
                    "sense_definition": "Visite officielle visant à vérifier la conformité, la sécurité ou le bon fonctionnement d'un établissement ou d'un service.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "controle_officiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le restaurant a reçu une <w>inspection</w> sanitaire surprise hier après-midi."
                        },
                        {
                            "text": "Le responsable a organisé une tournée d'<w>inspection</w> pour vérifier l'état des machines."
                        }
                    ],
                    "synonyms": [
                        "contrôle",
                        "audit",
                        "vérification"
                    ],
                    "common_phrases": [
                        "inspection du travail",
                        "inspection sanitaire",
                        "tournée d'inspection"
                    ]
                },
                {
                    "sense_id": "31ae61f2-7eaf-399d-9b10-1d8639a01454",
                    "sense_definition": "Action d'examiner attentivement et en détail une chose ou une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "examen_visuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une minutieuse <w>inspection</w> de la voiture, le mécanicien a trouvé l'origine de la panne."
                        },
                        {
                            "text": "À la première <w>inspection</w>, ce document ancien ne semblait comporter aucune anomalie visible."
                        }
                    ],
                    "synonyms": [
                        "examen",
                        "observation"
                    ],
                    "common_phrases": [
                        "inspection minutieuse",
                        "première inspection"
                    ]
                },
                {
                    "sense_id": "9d7fecc8-4ab0-375a-8501-17cca4ec8c79",
                    "sense_definition": "Fonction, charge ou statut attribué à un inspecteur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a consacré toute sa carrière à l'<w>inspection</w> générale au sein de ce ministère."
                        },
                        {
                            "text": "Elle a obtenu une place convoitée à l'<w>inspection</w> après avoir réussi un concours difficile."
