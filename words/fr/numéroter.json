                {
                    "sense_id": "c1ff28e7-9500-3639-b328-76e12b9f9404",
                    "sense_definition": "Marquer d'un numéro pour distinguer, classer ou ordonner des éléments d'une même suite.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marquer_numero",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas de <w>numéroter</w> chaque page de votre rapport avant de l'imprimer."
                        },
                        {
                            "text": "Le bibliothécaire prend le temps de <w>numéroter</w> tous les nouveaux livres reçus."
                        }
                    ],
                    "synonyms": [
                        "chiffrer",
                        "coter"
                    ],
                    "common_phrases": [
                        "numéroter les pages"
                    ]
                },
                {
                    "sense_id": "62f5e320-295c-3b44-b7c4-d8dc10af9508",
                    "sense_definition": "Composer un numéro sur un appareil téléphonique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "telephoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a pris son téléphone portable pour <w>numéroter</w> directement le service d'urgence."
                        },
                        {
                            "text": "Elle hésite encore avant de <w>numéroter</w> les coordonnées de son ancien collègue."
