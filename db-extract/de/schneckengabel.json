                "senses": [
                    {
                        "sense_id": "be9ca5bc-3de8-38d5-be76-6222e9334a20",
                        "entry_id": "78aa111a-b2e3-36de-acf2-db8c3a9749a9",
                        "glosses": [
                            "schmale Gabel mit zwei Zinken zum Herauslösen von Schnecken aus ihren Gehäusen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afaacdc6-ec9e-4289-b846-a6cfb6937009",
                                "sense_id": "be9ca5bc-3de8-38d5-be76-6222e9334a20",
                                "text": "„Die Schneckenzange wird beim Essen in der linken Hand gehalten, die Schneckengabel in der rechten.“"
                            },
                            {
                                "example_id": "c86f49c8-fd7d-442c-803a-c4bd33f8bfd0",
                                "sense_id": "be9ca5bc-3de8-38d5-be76-6222e9334a20",
                                "text": "„Sobald die Kräuterbutter herausgelaufen ist, fasst man das Schneckenfleisch mit der Schneckengabel und zieht es vorsichtig heraus.“"
                            },
                            {
                                "example_id": "e1a4f799-9557-41c5-bb6e-77ec1e21bfd5",
                                "sense_id": "be9ca5bc-3de8-38d5-be76-6222e9334a20",
                                "text": "„Berking erteilte nach nur ein paar Tagen Bedenkzeit den Auftrag – für 50 Teile ‚Alta‘, einschließlich Zuckerzange, Pastetenheber und Schneckengabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
