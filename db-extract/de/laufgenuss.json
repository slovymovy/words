                ],
                "senses": [
                    {
                        "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                        "entry_id": "2ce7405a-5013-333c-a9e5-8ee1a521a3db",
                        "glosses": [
                            "angenehme, befriedigende Wahrnehmung des Laufens, positives Lauferlebnis, das der Läufer während seines Laufes empfindet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9a0661fb-a0be-4c25-b014-b5290d4e5557",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Schmerzen im Schienbein sind ein häufiges Problem bei Läuferinnen und Läufern und können den Laufgenuss erheblich beeinträchtigen.“"
                            },
                            {
                                "example_id": "fa5b744a-b533-4811-8935-5c1596a6f3ec",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Das Lauf-Trainingscamp bot den TeilnehmernInnen [sic] vier Tage lang puren Laufgenuss auf 1500 Metern Seehöhe.“"
                            },
                            {
                                "example_id": "f64f6fc5-2521-4cb3-9ea2-c5a93c9743ca",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Das speziell konstruierte Dämpfungssystem absorbiert Stöße und sorgt selbst auf harten Industrieböden für federleichte Schritte mit neuartigem Laufgenuss.“"
                            },
                            {
                                "example_id": "e8065019-f45e-45c8-aa00-51c677a65080",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Auch der Rest der Strecke sowie das herrliche Wetter mit angenehmen Temperaturen machten den Lübeck-Marathon 2021 zum wahren Laufgenuss.“"
                            },
                            {
                                "example_id": "fc0ec7e0-5293-4ab7-811c-34660466f8ba",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Nach 14 Km [sic!] Laufgenuss, gespickt mit Trails&Co waren die kühlen Getränke ein herrlicher Abschluss.“"
                            },
                            {
                                "example_id": "e6d8c3a2-91d2-42f5-8d95-a5bc46615c00",
                                "sense_id": "0e01f8ac-f032-3b8e-984f-c0b2d34f41a4",
                                "text": "„Aufgrund der geltenden Hygienerichtlinien galt es, ein Konzept zu entwickeln, das es ermöglicht [sic!] den vielen Läuferinnen und Läufern, aber auch den zahlreichen Helfenden ein größtes Maß an Sicherheit zu bieten, ohne den Laufgenuss zu schmälern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
