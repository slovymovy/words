                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2f0b9c1b-edec-33c0-a2e0-4c73de6c427b",
                        "entry_id": "ecb2c72e-ddac-31fa-9ea7-a6baa84faa7e",
