                        "glosses": [
                            "Habitant ou personne originaire de Trois-Rivières, ville du Québec, situé au Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f4aa9e-e307-49c9-a6fb-b1f159265b7f",
                                "sense_id": "eace1346-ef5d-3e84-ad81-665883729688",
                                "text": "C’est le cas du Trifluvien Richard Dober fils qui prendra part, en compagnie d’Andrew Willows, à l’épreuve de K-2500 mètres, dont les préliminaires sont prévues demain après-midi."
                            }
