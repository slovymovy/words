                                    {
                                        "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                        "entry_id": "98a5be25-20bf-306c-8c46-5447f552659f",
                                        "glosses": [
                                            "In a significant manner or to a significant extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad786888-7fd3-4d14-840e-6a4f0198b6da",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "Irene's English significantly improved after taking a year out in Ireland."
                                            },
                                            {
                                                "example_id": "4084213f-8976-46a7-b30c-aeac57cecf9c",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "The quality of life is significantly higher than it was twenty years ago."
                                            },
                                            {
                                                "example_id": "bf06dc41-3314-4bf5-a1d1-850d35c9468f",
                                                "sense_id": "e058acdd-93de-319a-80f0-073a3b0ebb00",
                                                "text": "It's the water that makes this area famous. […] That water is still being used to supply Blackford's two dominant industries, Tullibardine whisky distillery to the south of the village and, more significantly, Highland Spring Group's bottling plant to the north."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bdbc5fd-95b9-473a-8045-007475e7b311",
                        "source_entry_id": "f377e9a2-258b-3c53-a81b-7af31bf82edd",
                        "source_sense_description": "намного",
                        "target_lang_word": "considerably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "considerably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                        "entry_id": "444ecb7c-37f7-34ea-9e51-e3cd4dd32b1a",
                                        "glosses": [
                                            "Significantly; to a degree worth considering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e72450-c056-412e-a4d6-b1f84652e734",
                                                "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                                "text": "The situation has improved considerably."
                                            },
                                            {
                                                "example_id": "becde3c9-fb76-44af-a543-bffd1b38aaa2",
                                                "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                                "text": "The situation is considerably better."
                                            },
                                            {
                                                "example_id": "affd7d73-ef23-472a-b290-f971d40cd902",
                                                "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                                "text": "From several magnets combined von Hellenbach and Gessmann in Vienna constructed considerably stronger hypnoscopes, through which 66 per cent. of those examined showed the above mentioned sensitiveness […]"
                                            },
                                            {
                                                "example_id": "04748506-8136-41be-b27b-35ce5d42461a",
                                                "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                                "text": "The hand which is not concealed by the drapery is gloveless; the arms are bare considerably above the elbow; and a bracelet encircles the right wrist."
                                            },
                                            {
                                                "example_id": "5c60277b-93fd-4ba5-bdff-d305b538a0d6",
                                                "sense_id": "b80fe9e0-8d14-3ec9-96f3-1fc0d3235f30",
                                                "text": "Despite the ups and downs of removals and rehousings, the collection was considerably extended under his guidance, both by purchases and donations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02dddd7c-bc44-42ab-89c1-10cb77accd6f",
                        "source_entry_id": "f377e9a2-258b-3c53-a81b-7af31bf82edd",
                        "source_sense_description": "намного",
                        "target_lang_word": "substantially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "substantially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0fa7d2d-c757-3f63-8f31-037088466826",
                                        "entry_id": "d3e7edc2-31d8-37aa-b70c-6d79248915dc",
                                        "glosses": [
                                            "In a strong or substantial manner; considerably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d362f9d-32b5-43ea-9473-087bae6e0eb6",
                                                "sense_id": "d0fa7d2d-c757-3f63-8f31-037088466826",
                                                "text": "For the first time since the Great Depression, median family income has fallen substantially over an entire decade. Income grew slowly through most of the last decade, except at the top of the distribution, before falling sharply when the financial crisis began."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3496e83-9765-3863-ba2b-9fd3cabd3148",
                                        "entry_id": "d3e7edc2-31d8-37aa-b70c-6d79248915dc",
                                        "glosses": [
