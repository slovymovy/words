                "senses": [
                    {
                        "sense_id": "653ea4fc-2b0a-32da-a67a-5d134f5f72b2",
                        "entry_id": "be17c362-c51b-3558-8ac7-fab15df774b7",
                        "glosses": [
                            "iemand die teveel met de mode bezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0c116a-38dc-4d58-b548-b8b0968e6d34",
                                "sense_id": "653ea4fc-2b0a-32da-a67a-5d134f5f72b2",
                                "text": "In Zonder filter doet de tekenaar uit de doeken hoe het zo gekomen is. Als student, onder invloed van alcohol (de Chianti stroomt rijkelijk) en liefdesverdriet (hij doopt haar Penelope), besluit de met een identiteitscrisis kampende kunstenaar voortaan als dandy door het leven te gaan. Hij moet nog wel even in zijn Prisma-woordenboek opzoeken wat het ook alweer betekent: modegek"
                            },
                            {
                                "example_id": "ca023681-5264-46a9-b836-a5dacbbed5d0",
                                "sense_id": "653ea4fc-2b0a-32da-a67a-5d134f5f72b2",
                                "text": "Veel schrijvers en kunstenaars stileerden zichzelf, sommigen waren regelrechte ‘fats’, modegekken, anderen waren excentriekelingen, weer anderen vooral welbespraakte dwepers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afb6d05b-2445-49cd-ba82-59510eed8cde",
                        "source_entry_id": "be17c362-c51b-3558-8ac7-fab15df774b7",
                        "source_sense_id": "653ea4fc-2b0a-32da-a67a-5d134f5f72b2",
                        "target_lang_word": "fop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70fcdcfd-4090-3254-8b5f-da9651826f8f",
                                        "entry_id": "7194659f-76dc-36f5-bff7-a39b68004a51",
                                        "glosses": [
                                            "A vain man; a dandy."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae2c295-3150-4ca1-b4b6-09b771007cb6",
                                                "sense_id": "70fcdcfd-4090-3254-8b5f-da9651826f8f",
                                                "text": "And she nearly started a fight between two young fops in plumed hats and flouncy collars: \"Clay-brained coxcomb!\" \"Mewling milk-livered maggot!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
