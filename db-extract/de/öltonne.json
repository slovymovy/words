                        "examples": [
                            {
                                "example_id": "9bde9789-bfbb-4571-b87a-3c4d01aef48b",
                                "sense_id": "8c330e62-95db-3532-b40a-5e15e9c6ae0f",
                                "text": "„Die Besatzung befördert im Flug ein Fass der halben Größe einer Öltonne über die hintere Laderampe aus dem Heck.“"
                            },
                            {
                                "example_id": "199698e1-0ec0-4b67-8810-01d9ceabd42d",
                                "sense_id": "8c330e62-95db-3532-b40a-5e15e9c6ae0f",
                                "text": "„Gentry senior nahm sämtliche Wetten an und schmiss die von Court gewonnenen Patronen alle in eine Öltonne, die sich langsam, aber unaufhaltsam mit Munition füllte.“"
                            }
                        ],
