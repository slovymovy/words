{
    "word_family": [
        "vivre",
        "survivre",
        "vivant",
        "vie",
        "reviviscence",
        "revivifier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46035aa4-a2e2-3bb9-a6d3-369e6e63436b",
                    "sense_definition": "Éprouver à nouveau un événement ou se remémorer intensément une expérience passée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En regardant ces vieilles photographies, elle <w>revit</w> tous les moments heureux de son enfance."
                        },
                        {
                            "text": "Personne dans le village ne souhaite <w>revivre</w> les tragiques inondations de l'année dernière."
                        }
                    ],
                    "synonyms": [
                        "se remémorer",
                        "se rappeler"
                    ],
                    "antonyms": [
                        "oublier"
                    ],
                    "common_phrases": [
                        "revivre le passé",
                        "revivre un cauchemar"
                    ]
                },
                {
                    "sense_id": "8718be0a-1720-37c0-b0be-e2068496be7e",
                    "sense_definition": "Reprendre des forces, retrouver de l'énergie, de la joie ou du bien-être.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bien_etre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a quitté cet emploi stressant, il <w>revit</w> et retrouve enfin le sourire."
                        },
                        {
                            "text": "Cette promenade au grand air m'a fait <w>revivre</w> après une longue semaine enfermé au bureau."
                        }
                    ],
                    "synonyms": [
                        "respirer",
                        "se requinquer"
                    ],
                    "antonyms": [
                        "dépérir",
                        "s'éteindre"
                    ],
                    "common_phrases": [
                        "faire revivre"
                    ]
                },
                {
                    "sense_id": "cc2881f0-f751-3f46-8d9d-034be71c3ee6",
                    "sense_definition": "Revenir à la vie après être mort ; ressusciter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "resurrection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans de nombreux mythes anciens, les héros meurent avant de <w>revivre</w> sous une forme divine."
                        },
                        {
                            "text": "Malgré tous les efforts des médecins, rien ne pouvait faire <w>revivre</w> le pauvre animal blessé."
                        }
                    ],
                    "synonyms": [
                        "ressusciter"
                    ],
                    "antonyms": [
                        "mourir",
                        "trépasser"
                    ]
                },
                {
                    "sense_id": "c7f87acf-d020-30e4-9bc2-0458cc7b07f1",
                    "sense_definition": "Renaître, reprendre vigueur ou retrouver de l'éclat, en parlant de choses inanimées ou abstraites.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "renaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce aux nouvelles subventions, l'économie de cette petite région industrielle commence enfin à <w>revivre</w>."
                        },
                        {
                            "text": "Ce festival annuel permet de faire <w>revivre</w> une tradition musicale presque tombée dans l'oubli."
                        }
                    ],
                    "synonyms": [
                        "renaître",
                        "se ranimer"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'éteindre"
                    ],
                    "common_phrases": [
                        "faire revivre une tradition"
                    ]
                },
                {
                    "sense_id": "43f5de7c-5d9e-3e1b-acee-de9e08f3ba97",
                    "sense_definition": "Se perpétuer ou continuer d'exister à travers une autre personne ou ses créations.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "continuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À travers le talent de cette jeune pianiste, l'esprit de son professeur <w>revit</w> magnifiquement sur scène."
                        },
                        {
                            "text": "Beaucoup de parents aiment penser qu'ils continuent de <w>revivre</w> dans la mémoire de leurs descendants."
                        }
                    ],
                    "synonyms": [
                        "se perpétuer"
                    ]
                }
            ]
        }
    ]
}