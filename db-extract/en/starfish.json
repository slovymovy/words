                        ],
                        "examples": [
                            {
                                "example_id": "b66b517d-27bc-4dfe-bec8-83a7d2a09766",
                                "sense_id": "3360a6d8-0e11-3dff-9bd3-1b02206c26e5",
                                "text": "\"Oh you damn bastard, why won't you let anybody love you,\" and then, before I could stop her, she threw herself between us and the glowing suitcase, starfishing in the blaze of light as he blew up."
                            },
                            {
                                "example_id": "635cf7b1-7ed1-484c-b5ec-611a515730c3",
                                "sense_id": "3360a6d8-0e11-3dff-9bd3-1b02206c26e5",
                                "text": "The freckle on her eye starfished out and the sun began to move over her face like it does below the surface of water."
                            }
