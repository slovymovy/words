                                    {
                                        "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                        "entry_id": "6729f811-810f-33b4-b5e0-e6ffde5d4bb0",
                                        "glosses": [
                                            "Something that is being or has been sewn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fa831e3-aab0-431c-a161-4399d3469880",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "She put down her sewing and went to answer the door."
                                            },
                                            {
                                                "example_id": "cea91a43-fa9b-4188-8cc0-d1d2a01a6368",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "The sewing has come undone on this seam."
                                            },
                                            {
                                                "example_id": "f0d21827-faa3-4453-8824-42180f759e1f",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "Mrs. Flanders had left her sewing on the table. There were her large reels of white cotton and her steel spectacles; her needle-case; her brown wool wound round an old postcard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
