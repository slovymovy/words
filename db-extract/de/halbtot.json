                                        "examples": [
                                            {
                                                "example_id": "82227162-b57c-41c4-85d5-919c0e3b0962",
                                                "sense_id": "a8bf032e-773e-37da-9f1b-17c30dc8d249",
                                                "text": "But even after he was beyond the danger zone, he still felt halfdead."
                                            },
                                            {
                                                "example_id": "34b0e089-0468-4e0e-8ea2-876da9c0cc52",
                                                "sense_id": "a8bf032e-773e-37da-9f1b-17c30dc8d249",
                                                "text": "Until the day King Nax had seized him and shattered his legs—not broken them, but shattered them, eight men taking turns with a mallet—and then sent him home, halfdead, to his wife, Aliss, in the northern Dells."
                                            },
                                            {
                                                "example_id": "0551c15e-2925-4bc9-8481-520f2cb1673a",
                                                "sense_id": "a8bf032e-773e-37da-9f1b-17c30dc8d249",
                                                "text": "Some may be halfdead physically; they need people to visit them in the hospital or in their homes. But there are many more who are halfdead in other ways."
                                            },
                                            {
                                                "example_id": "465a79a9-b7f0-4d21-8826-78fbb85879a2",
                                                "sense_id": "a8bf032e-773e-37da-9f1b-17c30dc8d249",
                                                "text": "[...] from a vantage point of security, the lawyer is taught to ask the question from the vantage point of one lying halfdead by the side of the road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
