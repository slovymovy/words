{
    "word_family": [
        "allow",
        "allowance",
        "disallowance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aabed668-e177-3459-b611-7c6a6554e47d",
                    "sense_definition": "To reject as invalid, untrue, or improper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reject_invalid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee decided to <w>disallow</w> the goal because the player was offside.",
                            "target_lang_translations": {
                                "pl": "Sędzia zdecydował, by <w>nie uznać</w> bramki, ponieważ zawodnik był na spalonym."
                            }
                        },
                        {
                            "text": "The tax authority will <w>disallow</w> claims that lack proper receipts.",
                            "target_lang_translations": {
                                "pl": "Urząd skarbowy <w>odrzuci</w> roszczenia, które nie mają odpowiednich paragonów."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "invalidate",
                        "void",
                        "dismiss"
                    ],
                    "antonyms": [
                        "allow",
                        "approve",
                        "validate",
                        "accept"
                    ],
                    "common_phrases": [
                        "disallow a goal",
                        "disallow a claim",
                        "disallow the deduction"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odrzucić coś jako nieważne, nieprawdziwe lub niewłaściwe (np. gola, roszczenie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odrzucić",
                                "target_lang_sense_clarification": "np. roszczenie, wniosek"
                            },
                            {
                                "target_lang_word": "nie uznać",
                                "target_lang_sense_clarification": "np. gola, wydatków"
                            },
                            {
                                "target_lang_word": "unieważnić",
                                "target_lang_sense_clarification": "np. decyzję, wynik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75a33c75-4085-39a4-bf1a-eaa144023c82",
                    "sense_definition": "To refuse to allow; to forbid or prohibit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prohibit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations <w>disallow</w> smoking anywhere on the school grounds.",
                            "target_lang_translations": {
                                "pl": "Nowe przepisy <w>zabraniają</w> palenia tytoniu na całym terenie szkoły."
                            }
                        },
                        {
                            "text": "The prison guards will <w>disallow</w> visitors who do not have proper identification.",
                            "target_lang_translations": {
                                "pl": "Strażnicy więzienni <w>nie zezwolą na wejście</w> odwiedzającym, którzy nie posiadają odpowiedniego dokumentu tożsamości."
                            }
                        }
                    ],
                    "synonyms": [
                        "forbid",
                        "prohibit",
                        "ban"
                    ],
                    "antonyms": [
                        "allow",
                        "permit"
                    ],
                    "common_phrases": [
                        "disallow access",
                        "disallow entry"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zabronić czegoś, nie zezwolić na coś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zabraniać",
                                "target_lang_sense_clarification": "nie pozwalać na coś"
                            },
                            {
                                "target_lang_word": "zakazywać",
                                "target_lang_sense_clarification": "wprowadzać zakaz"
                            },
                            {
                                "target_lang_word": "nie zezwalać",
                                "target_lang_sense_clarification": "odmawiać zgody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d90d1173-29b1-3dbd-a914-7a7c76634dce",
                    "sense_definition": "To overrule colonial legislation by the sovereign-in-privy council.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_overrule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The British Crown chose to <w>disallow</w> the provincial act passed by the colonial assembly.",
                            "target_lang_translations": {
                                "pl": "Korona Brytyjska zdecydowała się <w>uchylić</w> ustawę prowincjonalną uchwaloną przez zgromadzenie kolonialne."
                            }
                        },
                        {
                            "text": "Historically, the power to <w>disallow</w> colonial laws was exercised sparingly by the sovereign.",
                            "target_lang_translations": {
                                "pl": "Historycznie rzecz biorąc, uprawnienie do <w>uchylania</w> praw kolonialnych było rzadko stosowane przez suwerena."
                            }
                        }
                    ],
                    "synonyms": [
                        "overrule",
                        "veto",
                        "nullify"
                    ],
                    "antonyms": [
                        "sanction",
                        "confirm"
                    ],
                    "common_phrases": [
                        "disallow colonial legislation",
                        "power to disallow"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in historical and constitutional contexts regarding colonial administration."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uchylić lub wetować ustawodawstwo kolonialne przez suwerena."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "uchylić",
                                "target_lang_sense_clarification": "np. ustawę kolonialną"
                            },
                            {
                                "target_lang_word": "zawetować",
                                "target_lang_sense_clarification": "odrzucić prawo przez monarchę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}