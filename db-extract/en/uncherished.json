                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389777d2-fc56-456c-af8a-47a40d989924",
                                "sense_id": "da184167-297a-3d47-a0df-9322d9531c85",
                                "text": "The reason why the primrose was said to \"die unmarried,\" is, according to Warton, because it grows in the shade uncherished or unseen by the sun, who was supposed to be in love with certain sorts of flowers."
                            },
                            {
                                "example_id": "9f28a1bc-c5a2-462d-9131-92236e559c2a",
                                "sense_id": "da184167-297a-3d47-a0df-9322d9531c85",
                                "text": "We must go through life unloved and uncherished, bringing princes into the world, seeing happiness and love just beyond our reach all the time."
                            }
                        ]
                    }
