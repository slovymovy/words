                "senses": [
                    {
                        "sense_id": "6ddeae62-a24d-364b-b34a-e43931e54f07",
                        "entry_id": "f78aaa34-8bdd-3875-b1c1-7a8ab498f1ce",
                        "glosses": [
                            "Wissenschaft, die sich mit den physischen und psychischen Aspekten des Lachens beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e48ffe-4ddd-49df-a6e7-21104946dbdd",
                                "sense_id": "6ddeae62-a24d-364b-b34a-e43931e54f07",
                                "text": "„Befunde der modernen Gelotologie bestätigen, dass die Humorreaktion zur Stärkung des Immunsystems führt, zur Schmerzreduktion beiträgt und dem Stressabbau förderlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99c97cdc-16a2-418a-8d6a-b5015da4d7f0",
                        "source_entry_id": "f78aaa34-8bdd-3875-b1c1-7a8ab498f1ce",
                        "source_sense_id": "6ddeae62-a24d-364b-b34a-e43931e54f07",
                        "source_sense_description": "Wissenschaft, die sich mit den physischen und psychischen Aspekten des Lachens beschäftigt",
                        "target_lang_word": "gelotology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelotology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aea7aaa-1b81-3340-b210-7f1f8f1b87b0",
                                        "entry_id": "a77066f7-a5b6-3869-b3f0-4b99cbb702d0",
                                        "glosses": [
                                            "The study of humour and laughter, and its effects on the body."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50d44742-3ffe-4e92-bb08-5beb19fcc906",
                                                "sense_id": "6aea7aaa-1b81-3340-b210-7f1f8f1b87b0",
                                                "text": "Let's not develop a cult of laughology (though the study of laughter in medicine has already been christened gelotology from the Greek root meaning \"laughter.\") Humor is an important and documented adjunct in the life of both the well and the unwell, but as a therapy it rarely can stand alone."
                                            },
                                            {
                                                "example_id": "31a90d6a-f389-4d2f-bb64-70920a124bd3",
                                                "sense_id": "6aea7aaa-1b81-3340-b210-7f1f8f1b87b0",
                                                "text": "One of the founders of gelotology (gelos is Greek for \"laughter\"), Stanford University professor William F. Fry, also experimented on himself in the early 1960s. He drew blood samples at regular intervals while watching Laurel and Hardy and other comedic movies and had the samples analyzed. He found that laughter enhanced the activity of certain immune system cells responsible for killing infectious pathogens."
                                            },
                                            {
                                                "example_id": "ea368c0c-56b9-4a39-8177-69c82d0778ba",
                                                "sense_id": "6aea7aaa-1b81-3340-b210-7f1f8f1b87b0",
                                                "text": "Gelotology, the study of laughter, was established in the late 1960s in an effort to determine the possible physiological and psychological effects humor and laughter can have. One of the pioneers of Gelotology, William F. Fry, a Professor Emeritus at Stanford University, has done extensive research on the physiological benefits of laughter with very encouraging findings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f82ebf48-b986-41f5-87ef-d61005359370",
                        "source_entry_id": "f78aaa34-8bdd-3875-b1c1-7a8ab498f1ce",
                        "source_sense_id": "6ddeae62-a24d-364b-b34a-e43931e54f07",
