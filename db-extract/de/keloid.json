                                "target_senses": [
                                    {
                                        "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                                        "entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                                        "glosses": [
                                            "A hard raised growth of scar tissue at the site of an injury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319fb756-7785-4fc7-86cc-9964e2ffa86e",
                                                "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                                                "text": "It gave her otherwise plain face a broken excitement and blue-blade threat like the keloid scar of the razored man who sometimes played checkers with her grandmother."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "keloid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014389cb-68eb-3781-b2e3-3d870d7c27f1",
                                        "entry_id": "42c61312-a4a1-3bd9-8d67-938e621fa352",
                                        "glosses": [
                                            "To form a keloid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116db366-038b-4f20-9554-fa9ac41fd35b",
                                                "sense_id": "014389cb-68eb-3781-b2e3-3d870d7c27f1",
                                                "text": "The scar on his neck from running through that plate glass on one of our licks has keloided smooth and shiny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ca77681-53a6-4a87-a060-cadad3d70019",
                        "source_entry_id": "9afcc784-9eec-3746-b3d6-75629bfe26f9",
