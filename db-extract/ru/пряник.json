                    }
                ],
                "senses": [
                    {
                        "sense_id": "e95d8aba-9e37-3258-947b-501c1d9dada8",
                        "entry_id": "5d7c4101-d4fd-34ec-b640-5eb351dd0e11",
                        "glosses": [
                            "гастрон. мучное кондитерское изделие в виде толстой лепешки на меду, сахаре или патоке с добавлением каких-либо пряностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "020480e2-4241-4472-9b60-c6a5b23e6f88",
                                "sense_id": "e95d8aba-9e37-3258-947b-501c1d9dada8",
                                "text": "Большая семья расселась в кружок перед раскрытой корзинкой, и нянька, ломая на куски тульский пряник, наделяла им детей."
                            },
                            {
                                "example_id": "95464f31-1272-4b0f-bc6a-9c1ca09797f3",
                                "sense_id": "e95d8aba-9e37-3258-947b-501c1d9dada8",
                                "text": "Она лукаво подмигнула и сунула мне большой медовый пряник и глиняную свистульку."
                            }
                        ]
                    },
                    {
                        "sense_id": "57a54a96-fd6d-37d8-b582-8192ca391551",
                        "entry_id": "5d7c4101-d4fd-34ec-b640-5eb351dd0e11",
                        "glosses": [
                            "перен., разг. дорога со срезанным асфальтным покрытием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d42115-fe5c-40bb-8e6c-770d041aa699",
                                "sense_id": "57a54a96-fd6d-37d8-b582-8192ca391551",
                                "text": "На соседней улице новый асфальт ещё не положили, машины едут по прянику и объезжают люки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49425e28-b41e-4322-96bb-870aed0f30a7",
                        "source_entry_id": "5d7c4101-d4fd-34ec-b640-5eb351dd0e11",
                        "target_lang_word": "Lebkuchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebkuchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2474eff3-c8e0-376b-bc6f-6a70bb99f3ce",
                                        "entry_id": "9679b086-2c6a-3548-8999-72da321124e3",
                                        "glosses": [
                                            "Gebäck, das vor allem in der Advents- und Weihnachtszeit gebacken wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de8e901-ce1a-4ee8-b351-6349447c6e06",
                                                "sense_id": "2474eff3-c8e0-376b-bc6f-6a70bb99f3ce",
                                                "text": "Jonas liebt Lebkuchen."
                                            },
                                            {
                                                "example_id": "b81ba4b7-9e05-4cc3-beba-4a36f6cfc425",
                                                "sense_id": "2474eff3-c8e0-376b-bc6f-6a70bb99f3ce",
                                                "text": "Heute haben wir Lebkuchen gebacken."
                                            },
                                            {
                                                "example_id": "c7e948fa-a146-4a7a-99b8-90daf2e90086",
                                                "sense_id": "2474eff3-c8e0-376b-bc6f-6a70bb99f3ce",
                                                "text": "„Ja, also, Weihnachten muss schon ein bisschen würzig duften, so nach feinem Lebkuchen …“"
                                            },
                                            {
                                                "example_id": "2d6f23d8-0cfd-45e6-8bf7-135b2e3a3f33",
                                                "sense_id": "2474eff3-c8e0-376b-bc6f-6a70bb99f3ce",
                                                "text": "Einzelhändler […] argumentieren, dass zum Beispiel Lebkuchen und Spekulatius eher herbstliche als weihnachtliche Leckereien seien und man sie deshalb nicht nur in der Adventszeit verkaufen müsse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
