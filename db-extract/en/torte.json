                "forms": [],
                "senses": [
                    {
                        "sense_id": "5711e3c3-7288-3d71-abdc-94c66d0f65fb",
                        "entry_id": "dd3e9c13-8008-3ca4-92b9-546ce8a4dbaf",
                        "glosses": [
                            "süßer Kuchen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eac12925-43aa-422f-81da-5bcaae760875",
                        "source_entry_id": "dd3e9c13-8008-3ca4-92b9-546ce8a4dbaf",
                        "source_sense_id": "5711e3c3-7288-3d71-abdc-94c66d0f65fb",
                        "source_sense_description": "süßer Kuchen",
                        "target_lang_word": "Kuchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                        "entry_id": "b98a2be3-4eda-3ba0-b6af-bbb7565afc40",
                                        "glosses": [
                                            "süßes Gebäck; aus gebackenem Teig bestehendes Nahrungsmittel beziehungsweise Genussmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2649b840-95f5-4463-a394-85b28ff80bb4",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "Als eines schönen Tages der Kuchen im Backofen anbrannte, konnte ich mir es nicht verkneifen, die alte Volksweise „Liesel, Liesel, Köhler-Liesel …“ anzustimmen."
                                            },
                                            {
                                                "example_id": "a29f710c-027b-4dbd-bd48-49a6d5044de9",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Oh Mann, wir lieben Kuchen!“"
                                            },
                                            {
                                                "example_id": "9440a21c-f0df-4382-8da7-7e3c59a3d686",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Wenn das Volk kein Brot hat, wieso isst es dann keinen Kuchen?“ (Marie-Antoinette)"
                                            },
                                            {
                                                "example_id": "54edb97c-5caa-4896-8992-5e3b31b2a81a",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Wir gingen dann in die Konditorei, und es gab dort sehr viele Kuchen und Torten in einer langen Vitrine.“"
                                            },
                                            {
                                                "example_id": "0a0a9add-5dfb-4d5b-a9a7-d5fc2496fe29",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Nachdem ich ein Stück Kuchen gegessen hatte, setzte ich mich im Wohnzimmer auf den Perserteppich und fing etwas lustlos an, Murmeln durch die Murmelbahn zu schicken.“"
                                            },
                                            {
                                                "example_id": "bb1baabb-813a-4840-80f4-b7b380677dae",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Ich hatte mit einer sanften Nonnenstimme gerechnet, mit dem Geruch schwachen Kaffees und trockenen Kuchens, statt dessen: ein krächzender Mann, und es roch nach Krüllschnitt und Kohl, auf eine so penetrante Art, daß ich anfing zu husten.“"
                                            },
                                            {
                                                "example_id": "589f71d7-4b8b-4bca-844b-bf2e2032d6a4",
                                                "sense_id": "626bf7b3-c90e-3834-8f41-d4521455cc8d",
                                                "text": "„Ständig buk sie Kuchen – Marmorkuchen, Bananenkuchen, Biskuitkuchen, Schokoladenkuchen und so weiter – und es gab täglich mindestens zwei warmen Mahlzeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
