    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43e97e3b-f783-349b-a896-e7de88812968",
                    "sense_definition": "plotseling bang worden of een schok krijgen door een onverwachte gebeurtenis",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schrik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sorry dat ik je zo hard deed <w>verschieten</w> toen ik de kamer binnenkwam.",
                            "target_lang_translations": {
                                "en": "Sorry that I made you <w>startle</w> so much when I entered the room."
                            }
                        },
                        {
                            "text": "Ik deed de deur open en moest even <w>verschieten</w> van die harde knal.",
                            "target_lang_translations": {
                                "en": "I opened the door and <w>jumped</w> for a moment from that loud bang."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrikken"
                    ],
                    "common_phrases": [
                        "doen verschieten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be suddenly startled or shocked by an unexpected event"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "startle",
                                "target_lang_sense_clarification": "to cause a sudden shock or alarm"
                            },
                            {
                                "target_lang_word": "jump",
                                "target_lang_sense_clarification": "to move suddenly from surprise"
                            },
                            {
                                "target_lang_word": "get a fright",
                                "target_lang_sense_clarification": "to be suddenly scared"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60c6b4b3-bc0f-357a-bbb8-6745d3c5de20",
                    "sense_definition": "het verliezen van de oorspronkelijke kleur, vaak door zonlicht of emotie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kleurverandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het horen van het slechte nieuws was hij helemaal van kleur <w>verschoten</w>.",
                            "target_lang_translations": {
                                "en": "Upon hearing the bad news, he had completely <w>turned pale</w>."
                            }
                        },
                        {
                            "text": "De gordijnen in de woonkamer zijn door de felle zon erg <w>verschoten</w>.",
                            "target_lang_translations": {
                                "en": "The curtains in the living room have <w>faded</w> a lot due to the bright sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkleuren",
                        "verbleken"
                    ],
                    "common_phrases": [
                        "van kleur verschieten"
                    ],
                    "target_lang_definitions": {
                        "en": "to lose original color, often due to sunlight or strong emotion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fade",
                                "target_lang_sense_clarification": "to lose color or brightness"
                            },
                            {
                                "target_lang_word": "discolor",
                                "target_lang_sense_clarification": "to change color in a negative way"
                            },
                            {
                                "target_lang_word": "turn pale",
                                "target_lang_sense_clarification": "to lose color in the face due to emotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68b4d311-92ca-3874-a8f7-3906d428026a",
                    "sense_definition": "alle munitie of projectielen gebruiken tijdens het schieten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager had al zijn kogels al <w>verschoten</w> voordat hij het hert zag.",
                            "target_lang_translations": {
                                "en": "The hunter had already <w>shot off</w> all his bullets before he saw the deer."
                            }
                        },
                        {
                            "text": "Ze hadden de mooiste vuurpijlen al <w>verschoten</w> aan het begin van de avond.",
                            "target_lang_translations": {
                                "en": "They had already <w>fired off</w> the most beautiful rockets at the beginning of the evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkwisten"
                    ],
                    "common_phrases": [
                        "pijlen verschieten"
                    ],
                    "target_lang_definitions": {
                        "en": "to use up all ammunition or projectiles while shooting"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shoot off",
                                "target_lang_sense_clarification": "to fire all available ammunition"
                            },
                            {
                                "target_lang_word": "use up",
                                "target_lang_sense_clarification": "to exhaust a supply of projectiles"
                            },
                            {
                                "target_lang_word": "fire off",
                                "target_lang_sense_clarification": "to discharge all shots"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8793965a-7bf4-38bc-9c51-b5f0fc2baf0a",
                    "sense_definition": "geld aan iemand lenen of vooruitbetalen met de verwachting het terug te krijgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je mij een tientje kunnen <w>verschieten</w> voor de lunch vanmiddag?",
                            "target_lang_translations": {
                                "en": "Could you <w>advance</w> me ten euros for lunch this afternoon?"
                            }
                        },
                        {
                            "text": "Ik heb het bedrag voor de tickets alvast voor de hele groep <w>verschoten</w>.",
                            "target_lang_translations": {
                                "en": "I have already <w>fronted</w> the amount for the tickets for the whole group."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorschieten"
                    ],
                    "common_phrases": [
                        "geld verschieten"
                    ],
                    "target_lang_definitions": {
                        "en": "to lend money to someone or pay in advance expecting to be paid back"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "to pay money before it is due"
                            },
                            {
                                "target_lang_word": "lend",
                                "target_lang_sense_clarification": "to give money temporarily"
                            },
                            {
                                "target_lang_word": "front",
                                "target_lang_sense_clarification": "to provide money upfront for someone else"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee13ba3-47ff-3500-8d0f-3e393b2bd08e",
                    "sense_definition": "zich snel verplaatsen of van positie veranderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muis zag de kat en wist razendsnel onder de kast te <w>verschieten</w>.",
                            "target_lang_translations": {
                                "en": "The mouse saw the cat and managed to <w>dart</w> under the cupboard lightning fast."
                            }
                        },
                        {
                            "text": "Door de harde wind zagen we de wolken snel over de hemel <w>verschieten</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong wind, we saw the clouds <w>scud</w> quickly across the sky."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegschieten"
                    ],
                    "target_lang_definitions": {
                        "en": "to move quickly or change position rapidly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dart",
                                "target_lang_sense_clarification": "to move suddenly and rapidly"
                            },
                            {
                                "target_lang_word": "scoot",
                                "target_lang_sense_clarification": "to move quickly away"
                            },
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "to run away suddenly"
                            }
                        ]
                    }
                }
            ]
        },
