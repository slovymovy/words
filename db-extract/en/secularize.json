                                        "entry_id": "9bdaf2df-a02a-3cdb-9633-9204440344d3",
                                        "glosses": [
                                            "Rendre au siècle, à la vie laïque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5075f411-fa2f-4d25-9a67-8af38764c310",
                                                "sense_id": "de63caf3-6f7d-3c4c-9cf2-a539555d869e",
                                                "text": "Une religieuse sécularisée."
