                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c894566-2f0b-4d31-b763-68f99107f46b",
                        "source_entry_id": "056e0d70-4c7a-3791-aa2e-37b0e8d619dc",
                        "source_sense_id": "18bf09a3-ca2e-334d-b924-f3dddcf060bd",
                        "source_sense_description": "chlorine substituted organic compound",
                        "target_lang_word": "organochloré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "organochloré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                        "entry_id": "61a1b346-dfe4-3f91-9d75-5734563e515f",
                                        "glosses": [
                                            "Qualifie les composés organiques comportant au moins un atome de chlore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bb69e3-8183-4f49-95cf-b2eb6fef901a",
                                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                                "text": "La chlordécone est un pesticide organochloré polluant et persistant."
                                            },
                                            {
                                                "example_id": "f437dd21-4576-47e3-ad9e-8cc3fae9c38e",
                                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                                "text": "L’endosulfan a été homologué dans les années 1950, ce qui en faisait jusqu’ici un produit acceptable, malgré les critiques des écologistes, même si d’autres molécules organochlorées semblables comme le DDT, le dieldrin et le chlordane ont été bannies dans les années 1970 et 1980."
                                            },
                                            {
                                                "example_id": "854e5b9f-804a-417e-99c0-fdb223717e33",
                                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                                "text": "La contamination de la Martinique et de la Guadeloupe par une molécule organochlorée appelée chlordécone (C₁₀Cl₁₀O) raconte aussi l’histoire globale de la condition toxique du Plantationocène et de sa chimie des maîtres."
                                            },
                                            {
                                                "example_id": "f4d4911b-f8ca-4109-9dc8-82d5918e6f65",
                                                "sense_id": "def5a432-b59f-3323-859c-2a9e9e08de70",
                                                "text": "Les terres agricoles contaminées par des pesticides organochlorées sont-elles condamnées ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "organochloré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6c61844-836a-34c3-b494-ba24cf434eeb",
                                        "entry_id": "491f5f18-446d-3328-966c-32e2495cb90f",
                                        "glosses": [
                                            "Composé organique comportant un atome de chlore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813af0c1-4901-4045-b584-08a49d9bebea",
                                                "sense_id": "f6c61844-836a-34c3-b494-ba24cf434eeb",
                                                "text": "C’est, comme le DDT, un « organochloré », interdit depuis 1998, qui a été utilisé pendant près de 60 ans pour lutter contre les insectes parasites des plantes et pour lutter contre les poux des animaux ou des hommes."
                                            },
                                            {
                                                "example_id": "f10374f3-b9c1-4cfa-9f75-10543310f30f",
                                                "sense_id": "f6c61844-836a-34c3-b494-ba24cf434eeb",
                                                "text": "Les organochlorés sont des toxiques neurotropes qui altèrent le fonctionnement des canaux sodium indispensables à la transmission de l’influx nerveux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
