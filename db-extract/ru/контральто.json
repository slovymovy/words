                                        "entry_id": "e58d2604-ccdf-3a99-863f-d10024c2c692",
                                        "glosses": [
                                            "Variante de contralto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeff01ba-3ab9-4640-890c-879203babcd4",
                                                "sense_id": "171da8b4-1712-357f-9fda-7bcf7cffd6cb",
                                                "text": "Les chanteuses d’opéra, ou plutôt les actrices, chantent indifféremment le grave et l’aigu, ne s’en tenant à aucun registre; par contre, il n’y a pas de contralte sachant se maintenir convenablement dans les sons pleins du grave."
                                            }
                                        ]
                                    }
                                ]
                            }
