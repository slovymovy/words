{
    "word_family": [
        "funéraire",
        "funérailles",
        "funeste"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d21cbe2-e6b8-3f6c-9344-dbb45d034e36",
                    "sense_definition": "Qui a rapport aux funérailles ou au culte des morts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "funérailles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a joué une marche <w>funèbre</w> pendant que le cortège avançait lentement vers le cimetière."
                        },
                        {
                            "text": "Il a prononcé une oraison <w>funèbre</w> très émouvante lors de la cérémonie d'adieu."
                        }
                    ],
                    "synonyms": [
                        "funéraire",
                        "mortuaire"
                    ],
                    "common_phrases": [
                        "marche funèbre",
                        "oraison funèbre",
                        "convoi funèbre",
                        "cérémonie funèbre"
                    ]
                },
                {
                    "sense_id": "fb5cfc2c-ea8b-3127-a72e-bc98d2b258f8",
                    "sense_definition": "Qui inspire la tristesse ou évoque la mort ; lugubre, sinistre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lugubre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un silence <w>funèbre</w> régnait dans la maison abandonnée après le départ précipité des habitants."
                        },
                        {
                            "text": "Elle éprouvait un pressentiment <w>funèbre</w> en découvrant les volets fermés de la demeure."
                        }
                    ],
                    "synonyms": [
                        "lugubre",
                        "sinistre",
                        "macabre",
                        "sépulcral",
                        "sombre"
                    ],
                    "antonyms": [
                        "joyeux",
                        "gai"
                    ],
                    "common_phrases": [
                        "pressentiment funèbre",
                        "atmosphère funèbre",
                        "lueur funèbre"
                    ]
                },
                {
                    "sense_id": "60663094-22d0-3db3-8250-f0a2a3e4bffc",
                    "sense_definition": "Qualifie certains oiseaux réputés de mauvais augure dont le cri rappelle la mort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lugubre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les croyances populaires, la chouette était souvent considérée comme un oiseau <w>funèbre</w>."
                        },
                        {
                            "text": "Le cri perçant de ces oiseaux <w>funèbres</w> résonnait au cœur de la nuit noire."
                        }
                    ],
                    "common_phrases": [
                        "oiseau funèbre",
                        "oiseaux funèbres"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7575074d-15bc-35e0-a619-52e018aeb7f0",
                    "sense_definition": "Espèce de papillon de nuit aux ailes sombres bordées de clair, aussi appelée noctuelle en deuil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entomologiste a observé une <w>funèbre</w> posée sur une branche d'arbre dans la forêt."
                        },
                        {
                            "text": "Cette espèce de papillon nocturne, la <w>funèbre</w>, se distingue par ses ailes sombres bordées de blanc."
                        }
                    ],
                    "synonyms": [
                        "noctuelle en deuil"
                    ]
                }
            ]
        }
    ]
}