                ],
                "senses": [
                    {
                        "sense_id": "bf5203c1-d2a0-3291-a9ac-1fc1a4e6908d",
                        "entry_id": "a2a3df0a-5829-3388-886d-409c3027294b",
                        "glosses": [
                            "разг. мельчайшая деталь"
                        ],
                        "tags": [
                            "обычно в выражении тютелька в тютельку"
                        ],
                        "examples": [
                            {
                                "example_id": "93c6a7cc-7338-4a74-b10f-8e95cd0efe5c",
                                "sense_id": "bf5203c1-d2a0-3291-a9ac-1fc1a4e6908d",
                                "text": "Сама она — не талантливая, но — всё понимает, всё до последней тютельки, — как одеться и раздеться."
                            },
                            {
                                "example_id": "b03e45d1-3e77-454e-bc01-032efae66ec9",
                                "sense_id": "bf5203c1-d2a0-3291-a9ac-1fc1a4e6908d",
                                "text": "Скоро полгода, как с вами работаем, и действительно вижу — человек вы уж не молодой, без ветру, делом интересуетесь, вникаете во всякую тютельку."
                            }
                        ]
                    }
                ],
