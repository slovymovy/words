                    {
                        "sense_id": "619a09d8-8693-3555-848b-682f2c8176e4",
                        "entry_id": "7c7a4429-409e-3a66-88e4-5edbb7e60196",
                        "glosses": [
                            "Variante de gouillas : petite mare, flaque d’eau."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "05e0ff6b-3971-49f1-93e5-5d550eabb58e",
                                "sense_id": "619a09d8-8693-3555-848b-682f2c8176e4",
                                "text": "De grandes figures toutes couvertes d’écorchures et de boue, des chapeaux qu’on dirait ramassés dans un gouillat."
                            },
                            {
                                "example_id": "11c5aa8c-3cbc-4079-8135-6b7355fbca92",
                                "sense_id": "619a09d8-8693-3555-848b-682f2c8176e4",
                                "text": "GOUILLAT, s. m. — Mare, flaque d’eau, le plus souvent bourbeuse. J’ai mis mes clapotons au beau mitan du gouillat. Le phonème gouil pour exprimer l’eau, et spécialement l’eau bourbeuse, se trouve dans presque tous les patois."
                            },
                            {
                                "example_id": "1959cfd8-f581-41eb-a79b-9f12ee2ea377",
                                "sense_id": "619a09d8-8693-3555-848b-682f2c8176e4",
                                "text": "J’ai failli beugner une voiture en évitant un gouillat."
                            }
                        ]
                    }
                ],
