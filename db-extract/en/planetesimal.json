                "senses": [
                    {
                        "sense_id": "7b99b4e5-d949-3bb1-a0cc-0861f58b47e3",
                        "entry_id": "e861739f-fff3-353f-8bc7-5de1e5c75f5f",
                        "glosses": [
                            "Any of many small, solid astronomical objects that orbit a star and form protoplanets through mutual gravitational attraction."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8db474e2-b54a-43fd-891c-d2fe1c3217a0",
                        "source_entry_id": "e861739f-fff3-353f-8bc7-5de1e5c75f5f",
                        "source_sense_id": "7b99b4e5-d949-3bb1-a0cc-0861f58b47e3",
                        "source_sense_description": "a small, solid astronomical object",
                        "target_lang_word": "Planetesimal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Planetesimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                        "entry_id": "d43f88df-acaa-3f2d-9002-ed8d77ae1e82",
                                        "glosses": [
                                            "Kleinkörper aus kondensierter Materie des Urplanetensystems, die durch Kollisionen die Gesteinsplaneten sowie die Kerne der Gasplaneten bildete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2627e95-b66d-4987-9495-0771b82006c2",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Haben die Objekte erst einmal die Zentimeterbarriere überschritten und Planetesimale gebildet, dann gibt es für den weiteren Aufbau eines Planeten grünes Licht."
                                            },
                                            {
                                                "example_id": "a695c17a-7a05-460f-96de-64f22591d5e6",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Die Planetesimale sind trotz des Gases in der Scheibe groß und mobil genug, um sich gegenseitig anzuziehen."
                                            },
                                            {
                                                "example_id": "a8f31494-b48e-4f22-a5f7-cd775d3272bd",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Zu Beginn der planetaren Entwicklung müssen innerhalb der Scheibe ausgedehnte Kondensationsprozesse stattgefunden haben, in denen sich Gas am Staub anlagerte, wodurch die Größe der Staubkörner allmählich wuchs und die Planetesimale entstanden."
                                            },
                                            {
                                                "example_id": "f53a38b7-edd8-4975-82b3-e20c60c0a67f",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Die meisten der Planetesimale wurden im Verlauf der Planetenbildung aus dem Sonnensystem hinaus und in den interstellaren Raum geschleudert."
                                            },
                                            {
                                                "example_id": "251b7f81-7fc4-453f-bf63-132874a0e665",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Ein marsgroßes Planetesimal stößt mit der jungen Erde zusammen, wobei sowohl der Planet als auch das Planetesimal zertrümmert werden."
                                            },
                                            {
                                                "example_id": "ac4fe904-8a73-49ad-8082-3834c62e060c",
                                                "sense_id": "df072554-494d-3501-ab1d-e03357738afc",
                                                "text": "Viele Wissenschaftler halten Pluto daher nicht für einen echten Planeten, sondern für ein Eis-Planetesimal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
