{
    "word_family": [
        "deizen",
        "terugdeizen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27446aa4-1987-3ff7-b6a6-f304cf3b12db",
                    "sense_definition": "rustig en op de achtergrond blijvend, vaak na een berisping of uit angst",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de felle discussie hield hij zich de rest van de avond <w>gedeisd</w>.",
                            "target_lang_translations": {
                                "en": "After the heated discussion, he kept a <w>low profile</w> for the rest of the evening."
                            }
                        },
                        {
                            "text": "Je kunt je maar beter even <w>gedeisd</w> houden tot de storm is overgewaaid.",
                            "target_lang_translations": {
                                "en": "You'd better keep <w>quiet</w> for a while until the storm has blown over."
                            }
                        }
                    ],
                    "synonyms": [
                        "kalm",
                        "koest",
                        "stil"
                    ],
                    "antonyms": [
                        "opstandig",
                        "luidruchtig"
                    ],
                    "common_phrases": [
                        "zich gedeisd houden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'zich gedeisd houden'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "remaining quiet and in the background, often after a reprimand or out of fear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "low profile",
                                "target_lang_sense_clarification": "to keep a low profile"
                            },
                            {
                                "target_lang_word": "quiet",
                                "target_lang_sense_clarification": "staying out of trouble"
                            },
                            {
                                "target_lang_word": "subdued",
                                "target_lang_sense_clarification": "after being scolded"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbdc5835-a885-3e16-9561-cbb5bf8ae271",
                    "sense_definition": "voltooid deelwoord van <w>deizen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is voor de dreiging terug <w>gedeisd</w> naar zijn oorspronkelijke positie.",
                            "target_lang_translations": {
                                "en": "He <w>retreated</w> back to his original position in the face of the threat."
                            }
                        },
                        {
                            "text": "Nadat de vijand was <w>gedeisd</w>, keerde de rust in het dorp eindelijk terug.",
                            "target_lang_translations": {
                                "en": "After the enemy had <w>recoiled</w>, peace finally returned to the village."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "het werkwoord deizen is in modern Nederlands zeer ongebruikelijk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'deizen' (to shrink back or retreat)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "retreated",
                                "target_lang_sense_clarification": "moved back"
                            },
                            {
                                "target_lang_word": "shrunk back",
                                "target_lang_sense_clarification": "recoiled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
