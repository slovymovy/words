                                                "sense_id": "2822c529-cf46-364f-bed0-34456cb24bbc",
                                                "text": "Homme inconstant."
                                            },
                                            {
                                                "example_id": "81b84aef-343b-4344-b5eb-1a714fde7335",
                                                "sense_id": "2822c529-cf46-364f-bed0-34456cb24bbc",
                                                "text": "Femme inconstante."
                                            },
                                            {
                                                "example_id": "70a0b866-be87-4f17-a15b-c02857ae63fc",
                                                "sense_id": "2822c529-cf46-364f-bed0-34456cb24bbc",
                                                "text": "Esprit inconstant."
                                            },
                                            {
                                                "example_id": "09edeb5a-ce17-4a0f-a13f-5075aa958d78",
                                                "sense_id": "2822c529-cf46-364f-bed0-34456cb24bbc",
                                                "text": "Inconstant dans ses résolutions, dans ses amitiés."
                                            },
                                            {
                                                "example_id": "491cb644-62db-4854-a977-f06f60d76956",
                                                "sense_id": "2822c529-cf46-364f-bed0-34456cb24bbc",
                                                "text": "Inconstant en amour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5acbea2b-5f83-3dfc-82ba-9620eb6bf0b3",
                                        "entry_id": "3b8599e0-4b92-334f-8ee9-3e1aa408e82e",
                                        "glosses": [
                                            "Instable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7ce80a-185f-483d-b510-f49b5d944d91",
                                                "sense_id": "5acbea2b-5f83-3dfc-82ba-9620eb6bf0b3",
                                                "text": "Voilà un temps bien inconstant."
                                            },
                                            {
                                                "example_id": "f8bd5b92-292c-44a6-9c84-a23fec310bf6",
                                                "sense_id": "5acbea2b-5f83-3dfc-82ba-9620eb6bf0b3",
                                                "text": "L’automne est une saison inconstante."
                                            },
                                            {
                                                "example_id": "a4fc9aa6-aaf3-4046-ae81-1ab84b845424",
                                                "sense_id": "5acbea2b-5f83-3dfc-82ba-9620eb6bf0b3",
                                                "text": "Toutes les choses d’ici-bas sont inconstantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inconstant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a04e683e-cfdb-3f74-b5f5-a9ba3835e290",
                                        "entry_id": "2296edad-c91a-3285-9887-4147b259565d",
                                        "glosses": [
                                            "Celui qui fait preuve d'inconstance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6968653c-6769-44af-a9c5-9d4c1f7b60d6",
                                                "sense_id": "a04e683e-cfdb-3f74-b5f5-a9ba3835e290",
                                                "text": "C’était sans connaître le venin qui habitait Guillaume : un inconstant en quête de jupons."
                                            },
                                            {
                                                "example_id": "5023ee7f-6f68-4ff0-b434-b1e211b1d192",
                                                "sense_id": "a04e683e-cfdb-3f74-b5f5-a9ba3835e290",
                                                "text": "N’ayant plus de besoins, jouissant d’un calme profond et d’une douce liberté, dont la sagesse de mes livres m’apprend à faire un bon usage, qu’irai-je encore chercher parmi les hommes jaloux, trompeurs et inconstants ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
