    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                "word": "perversity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "01fafb66-2980-4911-b8cb-0f6ec090dd87",
                        "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                        "tags": [
                            "plural"
                        ],
                        "form": "perversities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfab4201-726c-38c8-94af-f56eb48b6714",
                        "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                        "glosses": [
                            "The quality of being perverse."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0e13ba8-4d74-4e29-a042-6cc73e4fd7bc",
                                "sense_id": "dfab4201-726c-38c8-94af-f56eb48b6714",
                                "text": "Hey kids, the word of the week is \"pupaphobia\"! Others may enjoy being frightened by chainsaw-wielding maniacs and cannibal clowns, but my Halloween is never complete without a murderous Muppet or two. Thankfully, a pair of events last Friday the 13th provided a perfect double feature of puppet perversity."
                            }
                        ]
                    },
                    {
                        "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                        "entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                        "glosses": [
                            "Something which is perverse."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "568a7f01-05ce-4163-92bb-db81bda3adeb",
                                "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                                "text": "More generally, for the ULD property to hold, the substitution effects (which are always well behaved) must be large enough to overcome possible “perversities” coming from the wealth effects."
                            },
                            {
                                "example_id": "104cd353-8c8b-4746-bee1-bc0ed6ff012a",
                                "sense_id": "4143bc9b-a3f8-37c3-9725-7437f103d17b",
                                "text": "“Of all this world's perversities, there is only one I cannot abide: the kink-shame. I'm off!” “You can't walk out! I'm walking out!”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d0f91f-f743-4f69-a3f8-685bbc4e7cd3",
                        "source_entry_id": "260f332a-8864-33f8-8aa3-61ae1f886f30",
                        "source_sense_description": "the quality of being perverse",
                        "target_lang_word": "Perversität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perversität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                        "entry_id": "fd3dee58-f353-3818-9980-8b6de2c3dda1",
                                        "glosses": [
                                            "Eigenschaft/Tat/Handlungsweise, die in deutlichem Maße die Grenze des als erlaubt und akzeptabel Beurteilten überschreitet, (die (sexuell) perverses Verhalten zeigt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227fbd91-032c-4fd0-9e54-eb6e77ced64e",
                                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                                "text": "„Die kalte, protokollarisch exakte Art und Weise, mit der Moravia alle möglichen Perversitäten beschreibt, und die Überladung des Textes mit physiologischen Details, all das erstaunt, verärgert und wirkt geschmacklos.“"
                                            },
                                            {
                                                "example_id": "20bf4c22-b92b-4c58-99bf-e18fc8762b39",
                                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                                "text": "„Man hat zwischen Perversität des Verhaltens und Perversion des Triebes zu unterscheiden. Und die Erfahrung lehrt, daß ein perverser Trieb weder notwendige Voraussetzung noch zureichender Grund für eine entsprechende Perversität des Handelns ist.“"
                                            },
                                            {
                                                "example_id": "396ee1f5-8e3d-4208-9b2f-8c91cc7eeba3",
                                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                                "text": "„Trotz (und wegen) der sich etablierenden Sexualwissenschaften, die die ‚Perversität‘ der Homosexuellen wissenschaftlich legitimierte, beginnen sich um die Jahrhundertwende homosexuelle Männer zu organisieren.“"
                                            },
                                            {
                                                "example_id": "3ac0c194-1a06-47c3-b56d-a57f4f0d699f",
                                                "sense_id": "603e6609-e51c-3524-a780-e0258a017b6d",
                                                "text": "„Sie meint, in Bordellen werden Männer zu Perversitäten verführt, und zuhause verlangen sie das dann auch von ihren Frauen. Mit der Theorie war sie sogar mal im Fernsehn in einer Talkshow.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
