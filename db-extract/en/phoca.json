                        "entry_id": "ccb23e05-a675-36dd-81ca-fffbb11ad15f",
                        "glosses": [
                            "A seal."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "360469ca-7883-4d49-bf40-a09d0afc2f37",
                                "sense_id": "0efe3f0b-e923-3aaf-bd3b-64d67bb67ea7",
                                "text": "His charet swift in haste he thither steard,\n Which with a teeme of scaly Phocas bound\n Was drawne vpon the waues, that fomed him around."
                            },
                            {
                                "example_id": "67b89f37-5aa2-4b86-8e00-35590fc24ea2",
                                "sense_id": "0efe3f0b-e923-3aaf-bd3b-64d67bb67ea7",
                                "text": "With tangled fins, behind, huge Phocæ glide,\n And Whales and Grampi swell the distant tide."
                            }
                        ]
                    }
                ],
