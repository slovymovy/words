                        "sense_id": "86a2239c-48a4-37f4-9d05-6c01da100940",
                        "entry_id": "498bd0a6-7fb6-3796-aa0a-6d54c00261f3",
                        "glosses": [
                            "Bothered; willing to make an effort."
                        ],
                        "tags": [
                            "Commonwealth",
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "b93694b9-5c9f-4da6-be83-e22f334cfada",
                                "sense_id": "86a2239c-48a4-37f4-9d05-6c01da100940",
                                "text": "You can keep all the macho bollocks that goes with the job. I can’t be arsed who thinks what of me to be perfectly honest and I have no time for those that are."
                            },
                            {
                                "example_id": "18e51361-42d4-4d1e-b3e2-e49abafc741a",
                                "sense_id": "86a2239c-48a4-37f4-9d05-6c01da100940",
                                "text": "I can’t be arsed to get out of bed today."
                            },
                            {
                                "example_id": "ddb2591b-c783-4097-b907-92a7f3684d5b",
                                "sense_id": "86a2239c-48a4-37f4-9d05-6c01da100940",
                                "text": "We asked John if he wanted to come down the pub with us, but he couldn’t be arsed."
                            },
                            {
                                "example_id": "ca2ea0b1-e725-41ed-86f1-43969a299510",
                                "sense_id": "86a2239c-48a4-37f4-9d05-6c01da100940",
                                "text": "[…]but here’s the way you’re supposed to run it: make out like it’ll be a long, drawn out process, that you can’t be arsed and that they shouldn’t be arsed because it’ll probably end up doing fuck all except getting a copper pissed off at them."
                            }
                        ]
                    },
