        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fba50a23-ee0b-37a3-b66d-2538b4260559",
                    "sense_definition": "A sharp, pointed prong on a tool or implement, such as a fork or comb.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tines</w> of the fork were made of strong steel.",
                            "target_lang_translations": {
                                "ru": "<w>Зубцы</w> вилки были сделаны из прочной стали."
                            }
                        },
                        {
                            "text": "He carefully cleaned the hair from the <w>tines</w> of his comb.",
                            "target_lang_translations": {
                                "ru": "Он осторожно очистил волосы с <w>зубьев</w> своей расчески."
                            }
                        }
                    ],
                    "synonyms": [
                        "prong",
                        "spike",
                        "tooth"
                    ],
                    "common_phrases": [
                        "fork tines"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый, заостренный выступ на инструменте или приспособлении, например, на вилке или расческе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубец",
                                "target_lang_sense_clarification": "острый выступ на предмете (вилка, расческа, грабли)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4bb2f41-3124-3258-b3e1-a32d2b3ca990",
                    "sense_definition": "A branch or point on an animal's antler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large deer had antlers with many <w>tines</w>.",
                            "target_lang_translations": {
                                "ru": "У крупного оленя были рога с множеством <w>отростков</w>."
                            }
                        },
                        {
                            "text": "The hunter counted every <w>tine</w> on the stag's head.",
                            "target_lang_translations": {
                                "ru": "Охотник пересчитал каждый <w>отросток</w> на голове оленя."
