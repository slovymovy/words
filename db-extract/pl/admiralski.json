                                        "examples": [
                                            {
                                                "example_id": "5e2197b3-f2a9-4073-a6a3-a38e3cb22b9c",
                                                "sense_id": "26e24603-695e-379a-a2d0-5a9a9e72d48b",
                                                "text": "Der Admiral entspricht dem General bei Heer und Luftwaffe."
                                            }
