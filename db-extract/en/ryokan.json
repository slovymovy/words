                "senses": [
                    {
                        "sense_id": "eb54b5b1-d702-3d4d-ba84-1a4746d3e2c5",
                        "entry_id": "3c97f711-3a79-33a6-aa1e-9bb1878e5348",
                        "glosses": [
                            "A traditional Japanese inn with communal baths and other public areas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b820aec4-05d3-4cef-8b19-3bcd01b8e233",
                                "sense_id": "eb54b5b1-d702-3d4d-ba84-1a4746d3e2c5",
                                "text": "Mr. Ducasse is pursuing plans for a new hotel one hour from central Tokyo, a cross between a ryokan, a traditional Japanese inn, and an auberge, a French country inn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85e92f6d-3950-41cc-aab0-376e7a2e58b1",
                        "source_entry_id": "3c97f711-3a79-33a6-aa1e-9bb1878e5348",
                        "source_sense_id": "eb54b5b1-d702-3d4d-ba84-1a4746d3e2c5",
                        "source_sense_description": "a traditional Japanese hotel",
                        "target_lang_word": "ryokan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ryokan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4868c374-e2c5-338e-9d99-4910d6fe2eb2",
                                        "entry_id": "cb7dab35-93aa-383c-9552-0cd3bc59319f",
                                        "glosses": [
                                            "Auberge traditionnelle au Japon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3237849a-3255-4cff-849e-6591283edb88",
                                                "sense_id": "4868c374-e2c5-338e-9d99-4910d6fe2eb2",
                                                "text": "À Kyoto, nous avons un peu de mal à trouver l’auberge traditionnelle que Pep a réservée. La ryokan en question ne nous autorise pas encore à nous installer, il est trop tôt."
                                            },
                                            {
                                                "example_id": "3fcfb2af-d05f-42ec-8d65-dc567c934107",
                                                "sense_id": "4868c374-e2c5-338e-9d99-4910d6fe2eb2",
                                                "text": "La haute saison étant passée, il put trouver une chambre libre sans difficulté. Il dénicha un ryôkan où séjournaient principalement des gens venus pour pêcher. Sa chambre était petite mais très propre, les tatamis exhalaient une bonne odeur de paille neuve."
                                            },
                                            {
                                                "example_id": "880f6e0b-ee36-451f-a51b-3696c48dac50",
                                                "sense_id": "4868c374-e2c5-338e-9d99-4910d6fe2eb2",
                                                "text": "En réalité, je rêvais d’une chambre dans un petit ryokan, je voulais appliquer mes pieds humides sur la paille tiède d’un tatami, piloter avec la pointe de mon index la télécommande du climatiseur réversible, régner sur la soufflerie, manger des watts par milliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e050e03e-2123-4856-80a3-cfa3bba5cf23",
                        "source_entry_id": "3c97f711-3a79-33a6-aa1e-9bb1878e5348",
