                                        "entry_id": "c0afe946-f0f8-3c0e-801c-7e6b3652617a",
                                        "glosses": [
                                            "außerordentliches Wohlbehagen, große Freude, die jemand bei der Wahrnehmung oder dem Konsum von etwas empfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c942a3-b06a-486e-9b42-bdc3dce365b3",
                                                "sense_id": "3ba1f13f-cb32-3cc0-bea9-5f8cc5d2d1cc",
                                                "text": "Die Ziegenkäsespezialitäten aus diesem spärlich bewohnten Tal sind für jeden Käseliebhaber ein Hochgenuss."
