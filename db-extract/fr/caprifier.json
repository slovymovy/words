                        "glosses": [
                            "Amener des insectes utiles à des figuiers en y apportant des figues sauvages (ou des branches de figuiers sauvages)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803a27fa-8ff2-4f87-8353-edde9e766abd",
                                "sense_id": "99a49b8a-3eb8-36bf-b2f0-426f86675eaf",
                                "text": "Examinons à présent les raisons qui déterminent à caprifier la seconde espèce de figues."
                            },
                            {
