                ],
                "senses": [
                    {
                        "sense_id": "e9f6df3d-9fc9-3a22-93ec-549bd0a907c3",
                        "entry_id": "73fecab1-69c3-3c7d-a9e0-980e761df00f",
                        "glosses": [
                            "Scanner, Bildabtaster"
                        ],
                        "tags": [],
