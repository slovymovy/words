                "senses": [
                    {
                        "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                        "entry_id": "7b089f1a-fee7-3357-8dfa-4cbad1b772ee",
                        "glosses": [
                            "Kutsche, die von Pferden gezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58ae66e-22fc-4f3b-bfbe-b3db58414dc9",
                                "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                                "text": "An ihrem Hochzeitstag fuhren sie mit einer Pferdekutsche."
                            },
                            {
                                "example_id": "3a5013bd-84ef-4ee9-aae7-298f6b86fce1",
                                "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                                "text": "„Postkurse mit Personenbeförderung in Pferdekutschen gab es in Deutschland etwa ab den 1640er Jahren.“"
                            },
                            {
                                "example_id": "1f3d0732-0e0d-4c89-b3ae-3d260cc83150",
                                "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                                "text": "„Irmgard wird bei einem Erntefest von einem Bauern kurzerhand auf eine Pferdekutsche geladen und mitgenommen.“"
                            },
                            {
                                "example_id": "66f84b65-c5d1-4227-8b36-2c289bfd4f7e",
                                "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                                "text": "„In den Straßen gab es kaum noch Pferdekutschen, hingegen sehr viel mehr Automobile, und auch die Pferdeomnibusse waren doppelstöckigen Motorbussen gewichen.“"
                            },
                            {
                                "example_id": "d9f148f5-e04b-4af6-aca0-5a34fc090674",
                                "sense_id": "64079aad-c748-34e2-881f-c9f96d29619f",
                                "text": "„Mémé besorgte sich zwei kräftige Männer und eine Pferdekutsche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
