                                                "example_id": "d3158f7c-c351-4e68-b821-2de0e471ee92",
                                                "sense_id": "e8750d9f-e662-3718-a513-806b9669423a",
                                                "text": "Met de voetbalwedstrijd namen we onze revanche door te winnen met 2-1."
