{
    "word_family": [
        "conductrice",
        "conducteurschap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d85c0e2-4901-3f7a-bde2-10e1ca1d6841",
                    "sense_definition": "Een medewerker in het openbaar vervoer die vervoersbewijzen controleert en reizigers assisteert.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>conducteur</w> is nu al drie keer langs geweest om de kaartjes te controleren.",
                            "target_lang_translations": {
                                "en": "The <w>conductor</w> has already come by three times to check the tickets."
                            }
                        },
                        {
                            "text": "Je kunt de <w>conducteur</w> om hulp vragen als je de juiste trein niet kunt vinden.",
                            "target_lang_translations": {
                                "en": "You can ask the <w>guard</w> for help if you can't find the right train."
                            }
                        }
                    ],
                    "synonyms": [
                        "treinbegeleider",
                        "controleur"
                    ],
                    "common_phrases": [
                        "de conducteur komt eraan",
                        "vriendelijke conducteur"
                    ],
                    "target_lang_definitions": {
                        "en": "A public transport employee who checks tickets and assists passengers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conductor",
                                "target_lang_sense_clarification": "on a train, tram, or bus"
                            },
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "UK English, specifically for trains"
                            },
                            {
                                "target_lang_word": "ticket inspector",
                                "target_lang_sense_clarification": "specifically for checking tickets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaea3ba2-d3a3-39ec-9daa-2e219c0c6b0c",
                    "sense_definition": "Een blad of partituur die de specifieke partij van één muzikant in een orkest of band bevat.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muzikant keek aandachtig op zijn <w>conducteur</w> om de juiste inzet niet te missen.",
                            "target_lang_translations": {
                                "en": "The musician looked closely at his <w>part</w> so as not to miss the right entry."
                            }
                        },
                        {
                            "text": "Tijdens de repetitie bleek er een fout te staan in de <w>conducteur</w> van de trompettist.",
                            "target_lang_translations": {
                                "en": "During the rehearsal, there appeared to be an error in the trumpeter's <w>sheet music</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de muziek"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A sheet or score containing the specific part of a single musician in an orchestra or band."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "part",
                                "target_lang_sense_clarification": "musical score for one instrument"
                            },
                            {
                                "target_lang_word": "sheet music",
                                "target_lang_sense_clarification": "general term for printed music"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66cdd4d9-5e68-37a0-9a82-4885a42f16c0",
                    "sense_definition": "Een verkorte vorm van <w>conducteur van bruggen en wegen</w>, een historische technische functie bij de overheid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historische_functies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de negentiende eeuw was hij werkzaam als <w>conducteur</w> bij de aanleg van nieuwe kanalen.",
                            "target_lang_translations": {
                                "en": "In the nineteenth century, he was employed as an <w>overseer</w> during the construction of new canals."
                            }
                        },
                        {
                            "text": "De <w>conducteur</w> hield toezicht op de kwaliteit van de gebruikte materialen bij de bruggenbouw.",
                            "target_lang_translations": {
                                "en": "The <w>superintendent</w> supervised the quality of the materials used in bridge building."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historische functiebenaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A historical technical government position, specifically an overseer of bridges and roads."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overseer",
                                "target_lang_sense_clarification": "historical technical supervisor"
                            },
                            {
                                "target_lang_word": "superintendent",
                                "target_lang_sense_clarification": "historical public works official"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}