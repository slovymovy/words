                        "examples": [
                            {
                                "example_id": "7b54509c-c52a-4c3f-839a-6c72b54aa826",
                                "sense_id": "742eda10-af7a-3111-b4a2-93e3c64c6379",
                                "text": "Voor de Franse coureur Valentin Giraud is de GP-zijspancross van Markelo geëindigd in een ramp. De Fransman kwam kort na de start van de tweede manche ten val, waarbij hij - naar nu blijkt - zware verwondingen heeft opgelopen."
                            },
                            {
                                "example_id": "b66ad68d-5acb-4df0-b21b-f798db0f720f",
                                "sense_id": "742eda10-af7a-3111-b4a2-93e3c64c6379",
                                "text": "Etienne Bax is vanmiddag wereldkampioen geworden in de zijspancross. De Brabander won samen met zijn Letse bakkenist Kaspars Stupelis de eerste manche in de GP van Frankrijk."
                            }
                        ]
