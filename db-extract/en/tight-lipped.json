                "senses": [
                    {
                        "sense_id": "2361a25e-5634-3a48-ab24-901ab3079cb5",
                        "entry_id": "e1456c24-f7c8-3cf3-a664-bea267b6441f",
                        "glosses": [
                            "Having the lips pressed tightly together, hence, not speaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babcc251-e5f8-4e6e-b2fe-d97ef3cc9107",
                                "sense_id": "2361a25e-5634-3a48-ab24-901ab3079cb5",
                                "text": "He would have sprung upon Captain Blood, who stood aloof, alert, tight-lipped, and watchful."
                            },
                            {
                                "example_id": "bd4434b5-0e82-4049-a0b2-9303063b48eb",
                                "sense_id": "2361a25e-5634-3a48-ab24-901ab3079cb5",
                                "text": "Gaining the dak, they were joined on the veranda by four tight-lipped men."
                            }
                        ]
                    },
                    {
                        "sense_id": "efc173a5-2fda-3502-b1a9-2ce92aa58329",
                        "entry_id": "e1456c24-f7c8-3cf3-a664-bea267b6441f",
                        "glosses": [
                            "Unwilling to divulge information."
                        ],
                        "tags": [
                            "idiomatic"
                        ],
                        "examples": [
                            {
                                "example_id": "b2ea83b8-957d-4091-9aab-19e03d178cab",
                                "sense_id": "efc173a5-2fda-3502-b1a9-2ce92aa58329",
                                "text": "The open access operator has remained tight-lipped over what may have caused the driver to suddenly apply the brake, but stressed that safety was its priority."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e19c2a6-b5b8-49d4-9eeb-1a68c6cba194",
                        "source_entry_id": "e1456c24-f7c8-3cf3-a664-bea267b6441f",
                        "source_sense_description": "unwilling to divulge information",
                        "target_lang_word": "schmallippig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmallippig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d219713b-c66a-3762-a485-74f970a16669",
                                        "entry_id": "76ae391d-93fd-3a7f-a3c6-cd5538e293b5",
                                        "glosses": [
                                            "schmale oder dünne Lippen besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb399a0d-e4a6-489d-9d27-e268867447c4",
                                                "sense_id": "d219713b-c66a-3762-a485-74f970a16669",
                                                "text": "„Das Gemälde zeigt ein schmallippiges Gesicht, das strahlend aus dem samtschwarzen Hintergrund hervorsticht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74eec690-22ed-30e9-9e1b-a346d71b15b5",
                                        "entry_id": "76ae391d-93fd-3a7f-a3c6-cd5538e293b5",
                                        "glosses": [
                                            "geheuchelt nett, dabei kurz angebunden, mit Antipathie höflich und lächelnd gelogen; sich bei Auskünften auf das Nötigste beschränkend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9218cf-9c07-4f10-ae23-ebc311bd146b",
                                                "sense_id": "74eec690-22ed-30e9-9e1b-a346d71b15b5",
                                                "text": "Sie antwortete mir schmallippig."
                                            },
                                            {
                                                "example_id": "d47ce10f-1d60-4d4e-be78-568203ab74f2",
                                                "sense_id": "74eec690-22ed-30e9-9e1b-a346d71b15b5",
                                                "text": "„«Da bin ich eben noch sehr jung gewesen», fügte sie, plötzlich schmallippig, hinzu.“"
                                            },
                                            {
                                                "example_id": "8aacf9a3-eca3-4148-8521-886aff456839",
                                                "sense_id": "74eec690-22ed-30e9-9e1b-a346d71b15b5",
                                                "text": "„Gerade wenn es um den Verbleib von U-Booten geht, werden sie im Pentagon schnell schmallippig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
