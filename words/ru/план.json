                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1c589e-a3f0-36e2-a6cb-f38f658d5e30",
                    "sense_definition": "Жаргонное название наркотических веществ из конопли (марихуаны, гашиша).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция обнаружила у задержанного пакет, в котором был <w>план</w>.",
                            "target_lang_translations": {
                                "en": "The police found a bag on the detainee containing <w>weed</w>.",
                                "de": "Die Polizei fand bei dem Festgenommenen ein Tütchen, das <w>Gras</w> enthielt."
                            }
                        },
                        {
                            "text": "В этом районе было трудно достать хороший <w>план</w>.",
                            "target_lang_translations": {
                                "en": "It was hard to get good <w>weed</w> in this neighborhood.",
                                "de": "In dieser Gegend war es schwer, gutes <w>Gras</w> zu bekommen."
                            }
                        }
                    ],
                    "synonyms": [
