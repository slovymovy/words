                "senses": [
                    {
                        "sense_id": "42283bb3-fc04-3707-8fe8-51f30e757ede",
                        "entry_id": "44a0fc36-6273-33e0-9f1b-74b3e445a84d",
                        "glosses": [
                            "Faire du tintamarre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52160d5f-9430-440a-a9a2-f053e48aa020",
                                "sense_id": "42283bb3-fc04-3707-8fe8-51f30e757ede",
                                "text": "Je m’en revins tout épouvanté tintamarrer à notre huis."
                            },
                            {
                                "example_id": "973850cf-6688-4799-a59a-87f4950f33a5",
                                "sense_id": "42283bb3-fc04-3707-8fe8-51f30e757ede",
                                "text": "Que l’on ne fasse point tintamarrer leurs armes."
                            },
                            {
                                "example_id": "c9a8dd6e-07aa-4869-9a79-ea992e418dca",
                                "sense_id": "42283bb3-fc04-3707-8fe8-51f30e757ede",
                                "text": "Elle eut beau le tintamarrer, tarabuster, sabouler."
                            },
                            {
                                "example_id": "041aa83f-b894-4a20-a241-4bb0f8752c7e",
                                "sense_id": "42283bb3-fc04-3707-8fe8-51f30e757ede",
                                "text": "Les Chœurs d’Oiseaux, soit de la même famille, soit d’espèces différentes, carillonnent. Au contraire, les Chœurs d’Animaux ne font guère que tintamarrer."
                            }
                        ]
                    }
