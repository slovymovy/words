                    {
                        "sense_id": "0590f5b9-4642-3b18-ba1f-4aa072bd6db0",
                        "entry_id": "85b8b479-0ddf-3446-80aa-dc2e2635186a",
                        "glosses": [
                            "Médecine non conventionnelle qui prétend soigner par le biais des cristaux."
                        ],
                        "tags": [
                            "Médecine non conventionnelle",
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "18ce70a6-ea12-45b5-b52f-3f7fc4abe5ec",
                                "sense_id": "0590f5b9-4642-3b18-ba1f-4aa072bd6db0",
                                "text": "La lithothérapie déchélatrice est une méthode homéopathique, c’est-à-dire qu’elle utilise des minéraux dilués et dynamisés 8 fois à des fins thérapeutiques."
                            },
                            {
                                "example_id": "b66495e7-1af7-421d-a50c-e6ae9d4e21a7",
                                "sense_id": "0590f5b9-4642-3b18-ba1f-4aa072bd6db0",
                                "text": "Un espace y était dédié à la lithothérapie, une pratique qui prétend accompagner la guérison avec des pierres."
                            },
                            {
                                "example_id": "4636a094-f4c4-4836-a9ac-b74d31915b4c",
                                "sense_id": "0590f5b9-4642-3b18-ba1f-4aa072bd6db0",
                                "text": "La présence des pierres en médecine, dans la pratique de la lithothérapie, fut dirigée vers la guérison des maux les plus divers."
                            }
                        ]
                    }
                ],
