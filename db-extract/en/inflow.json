                    }
                ],
                "senses": [
                    {
                        "sense_id": "e530ef8f-0ec6-3097-8934-efca1704883a",
                        "entry_id": "55129076-31af-308f-bb48-dbe5809ebdf1",
                        "glosses": [
                            "The act or process of flowing in or into."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2752fc0c-5577-3fbc-b58f-eee8d52faa96",
                        "entry_id": "55129076-31af-308f-bb48-dbe5809ebdf1",
                        "glosses": [
                            "Anything which flows in or into."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e1af1fe-c9b9-4a84-b921-7fa28955a8bd",
                                "sense_id": "2752fc0c-5577-3fbc-b58f-eee8d52faa96",
                                "text": "The inflow of air."
                            },
                            {
                                "example_id": "c2b34dec-f8e2-4df2-8362-5a58e3e26aca",
                                "sense_id": "2752fc0c-5577-3fbc-b58f-eee8d52faa96",
                                "text": "According to Farside Investors’ data, spot ETH exchange-traded funds (ETFs) recorded net inflows of roughly $2.4 billion in the past six trading days, well above the $827 million in net inflows into spot BTC ETFs during the same period."
                            }
                        ]
                    },
                    {
                        "sense_id": "da60f977-ee3d-3c80-b724-4683425f085b",
                        "entry_id": "55129076-31af-308f-bb48-dbe5809ebdf1",
                        "glosses": [
                            "Influence from outside."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21032675-d635-4edf-8556-5ce57b4989e6",
                                "sense_id": "da60f977-ee3d-3c80-b724-4683425f085b",
                                "text": "But there is also \"top down causality\" in which the entire system, as a whole, is affected by the inflow or influence of pattern formation, or \"information.\""
                            },
                            {
                                "example_id": "56b72052-79ab-4298-a203-310517388a85",
                                "sense_id": "da60f977-ee3d-3c80-b724-4683425f085b",
                                "text": "Broadly speaking, there are two cases in which a national culture is subjected to the sudden inflow or influence of a foreign culture: (1) when the former is conquered by the latter and (2) when it conquers the latter."
                            },
                            {
                                "example_id": "3847d840-69a8-4c36-badf-24404e98237a",
                                "sense_id": "da60f977-ee3d-3c80-b724-4683425f085b",
                                "text": "Open yourself completely to the inflow and influence of the music and light of God through daily practice of the spiritual exercises, which he gives to you."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85d5e702-dc25-480e-9c24-e8d6f4af8cda",
                        "source_entry_id": "55129076-31af-308f-bb48-dbe5809ebdf1",
                        "source_sense_description": "a flow in",
                        "target_lang_word": "afflux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afflux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5dc666-d1ba-37ef-9aab-697e10e65f30",
                                        "entry_id": "932a3ab6-a472-33ad-94ea-b3a457797b95",
                                        "glosses": [
                                            "Action d’affluer, concours des liquides vers une partie de l’organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc8e58c-b664-4e4b-bafa-1af566489108",
                                                "sense_id": "3d5dc666-d1ba-37ef-9aab-697e10e65f30",
                                                "text": "Parfois, il se lève, il parcourt deux ou trois fois sa cellule dans sa plus grande largeur, et, brusquement, alors, un afflux de sang empourpre cette tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652eff2e-b118-3d4f-8acc-46ee5deefec5",
                                        "entry_id": "932a3ab6-a472-33ad-94ea-b3a457797b95",
                                        "glosses": [
                                            "Mouvement du fluide électrique vers un point."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a42f33b-7990-3cf5-bfd1-be11dbd57bfc",
                                        "entry_id": "932a3ab6-a472-33ad-94ea-b3a457797b95",
                                        "glosses": [
                                            "Toute arrivée de personnes ou de choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7e9ed2-e907-4a4b-bb13-bc86c5e6f4ba",
                                                "sense_id": "2a42f33b-7990-3cf5-bfd1-be11dbd57bfc",
                                                "text": "Et, en définitive, dans cette Bretagne qu'on nous disait si pauvre, nous observons une région où il y a grand afflux d'argent et où une sorte d'aristocratie paysanne exerce son influence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
