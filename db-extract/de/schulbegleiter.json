                "senses": [
                    {
                        "sense_id": "150f7e7f-2de8-30a0-9862-01f5c1859e73",
                        "entry_id": "fe2b5822-f314-3c14-9eb3-e8a7f738c0da",
                        "glosses": [
                            "Person, die berufsmäßig ein Kind mit körperlicher oder geistiger Behinderung beziehungsweise mit einer psychischen Störung zur Schule begleitet und dort betreut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e85afdc-2295-43cb-b5ab-c24a7e0ce3ef",
                                "sense_id": "150f7e7f-2de8-30a0-9862-01f5c1859e73",
                                "text": "„Der Junge braucht einen Schulbegleiter.“"
                            },
                            {
                                "example_id": "ffd3074b-c11a-437f-bafa-a92791359e59",
                                "sense_id": "150f7e7f-2de8-30a0-9862-01f5c1859e73",
                                "text": "„Auch in anderen Teilen Bayerns berichten Jugendämter, Bezirke und Hilfsdienste von fehlenden Schulbegleitern.“"
                            }
                        ],
