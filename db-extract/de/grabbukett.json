                ],
                "senses": [
                    {
                        "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                        "entry_id": "cfa012c6-6524-388e-a0dc-cafec8823d9b",
                        "glosses": [
                            "Strauß zusammengebundener Blumen als letzter Gruß bei Begräbnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3154347a-1e4c-4333-83d9-79854dd1ba30",
                                "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                                "text": "„Von den mit insgesamt S 45.379 geltend gemachten Begräbniskosten (S 22.199 Begräbniskosten abzüglich Sterbegeld, S 360 Grabbukett, S 18.850 Grabstein, S 900 Grabpflege sowie S 120) erschienen vorliegendenfalls solche von etwa S 35.000 angemessen.“"
                            },
                            {
                                "example_id": "a25bf270-3fcc-4126-9b91-152396f72a6d",
                                "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                                "text": "„Zur Beerdigung seines verstorbenen Wiener Freundes Friedrich Torberg reiste er mit gebrochenem linken Arm, einem märkischen Grabbukett und einem offiziellen DDR-Visum“"
                            },
                            {
                                "example_id": "8a665e99-5dfb-414b-8a3f-7eb876acc6f2",
                                "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                                "text": "„Die Unruhe, mit der sie morgens aufgewacht war, kam ihr in den Sinn, das Grabbukett, an dem sie gearbeitet hatte, als ihr Vater anrief.“"
                            },
                            {
                                "example_id": "cf2cfb66-4edf-4d33-92ea-1d796066620f",
                                "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                                "text": "„Nicht auszuschließen ist auch die Möglichkeit, daß einige Pflanzen mit schönen dekorativen Blüten als ‚Grabbukett‘ des Polovzer-Khans dienten.“"
                            },
                            {
                                "example_id": "a961cdbc-138d-4104-ac20-3d5b9f4704d6",
                                "sense_id": "1a9e30c7-60c0-3bad-89b0-9802f555a44f",
                                "text": "„Sparten der Blumenbinderei: Handsträuße, Trauergebinde (Grabbukett, Kranz, Kranzgarnierungen), Advent- und Weihnachtsbinderei (Symbolbinderei, freie Gestecke), Tischgestecke, Trockenbinderei, Brautsträuße, gepflanzte Schalen und Tröge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
