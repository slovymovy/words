                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ebfb7f3-bfa4-3142-8990-219e1830f998",
                        "entry_id": "cbb3eaa1-e733-3fc1-ba49-048b43e40b4c",
                        "glosses": [
                            "gesetzlicher Steuersatz auf den Umsatz eines Unternehmens, den dieses jedoch an seine Kunden weiter berechnen darf; Steuerschuldner ist jedoch das leistende Unternehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bb9908-ec6e-4981-85c6-68c6db7cc2e9",
                                "sense_id": "1ebfb7f3-bfa4-3142-8990-219e1830f998",
                                "text": "„Die Umsatzsteuer (oder auch Mehrwertsteuer) wird auf (fast) jeden getätigten Umsatz fällig, also immer dann, wenn Sie Waren oder Leistungen verkaufen.“"
                            },
                            {
                                "example_id": "50fd72d0-264d-4af0-9d4c-a02b7751b091",
                                "sense_id": "1ebfb7f3-bfa4-3142-8990-219e1830f998",
                                "text": "„Der Unternehmer, der selber Umsatzsteuern beim Einkauf von Waren oder der Inanspruchnahme von Dienstleistungen entrichtet, darf die ihm in Rechnung gestellte Vorsteuer mit der zu zahlenden Umsatzsteuer verrechnen.“"
                            },
                            {
                                "example_id": "15cc9d77-854b-4ff0-8bf0-3b0d0ab36b18",
                                "sense_id": "1ebfb7f3-bfa4-3142-8990-219e1830f998",
                                "text": "„Der Umsatzsteuer unterliegen Lieferungen und Leistungen, die Sie als Unternehmer im Inland entgeltlich im Rahmen Ihres Unternehmens ausführen (§ 1 Abs. 1 Nr. 1 UStG).“"
                            },
                            {
                                "example_id": "5304f85e-407f-4e61-b322-b65ea1c827e5",
                                "sense_id": "1ebfb7f3-bfa4-3142-8990-219e1830f998",
                                "text": "„Beträgt die Umsatzsteuer des vorangegangenen Jahres mehr als 7.500€, müssen Sie die Voranmeldung bis zum 10. Tag nach Ablauf eines jeden Kalendermonats abgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
