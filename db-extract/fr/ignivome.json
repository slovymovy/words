                    {
                        "sense_id": "23941ed0-5bb0-369e-867d-a5541a087d2f",
                        "entry_id": "bfc13a99-668f-3b3d-92b6-251e9ed5772a",
                        "glosses": [
                            "Volcan éruptif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d4bc2d7-c966-4424-8f32-f955e51ce623",
                                "sense_id": "23941ed0-5bb0-369e-867d-a5541a087d2f",
                                "text": "Ce n’est qu'un mamelon sur un plateau, une herbe sur des herbes, et en dessous, sur un socle de granit et de schistes, l’épanchement des ignivomes de l’ère pliocène."
                            }
                        ]
                    },
                    {
                        "sense_id": "391bfb3c-75e6-3c9d-8f70-94e50004fecf",
                        "entry_id": "bfc13a99-668f-3b3d-92b6-251e9ed5772a",
                        "glosses": [
                            "Un dragon."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb681ab8-b748-4755-80f4-902cac75808c",
                                "sense_id": "391bfb3c-75e6-3c9d-8f70-94e50004fecf",
                                "text": "Ils ont pris l’ombre, ils ont fait avouer les sphinx, ils ont échoué l’hydre, éteint les ignivomes, et du sinistre enfer augmenté les fantômes"
                            }
                        ]
                    }
