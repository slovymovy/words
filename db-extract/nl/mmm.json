                    {
                        "translation_id": "39825a0c-c5c3-4c9f-b649-22321c4b671a",
                        "source_entry_id": "a91fb4f7-2b9e-3369-ae03-2edf3be5667a",
                        "source_sense_id": "d0b051f3-dd28-370b-b2da-9cde9e9e5722",
