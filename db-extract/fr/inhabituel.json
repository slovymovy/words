                                        "entry_id": "6c9debe0-af32-34bc-89fe-e766c5faea74",
                                        "glosses": [
                                            "so, dass es nicht den Gepflogenheiten entspricht; nicht üblich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad4c67f-acf8-46f5-94c7-04840f637784",
                                                "sense_id": "cc9ce098-6b76-3ee8-9c5a-ca45e8a936fc",
                                                "text": "Es ist unüblich, dass wir jetzt essen gehen, da wir normalerweise später essen."
                                            },
                                            {
                                                "example_id": "b6790b4f-c662-44c1-8b79-488e24671c3a",
                                                "sense_id": "cc9ce098-6b76-3ee8-9c5a-ca45e8a936fc",
                                                "text": "Auf dem Gelände der WTD 91 [Bundeswehr] scheinen durch Waffentests ausgelöste Brände nicht unüblich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
