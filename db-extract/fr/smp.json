                                        "examples": [
                                            {
                                                "example_id": "78a45fce-f9ea-4737-9473-43f9ef3f763a",
                                                "sense_id": "c05f8bb5-037f-30f7-b5ae-e429377787ec",
                                                "text": "That the PMCs working in Iraq operate in a legal black hole is, in my mind, a huge problem but also an eminently solvable one."
                                            },
                                            {
                                                "example_id": "e5bab8b0-2c60-42c6-af79-88273a516e8b",
                                                "sense_id": "c05f8bb5-037f-30f7-b5ae-e429377787ec",
                                                "text": "The first time he ever shot somebody, and knew about it, “was as a PMC. The firefights were a lot closer, a lot more personal.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6fc925-1b7b-3699-862c-11de707e3f1d",
