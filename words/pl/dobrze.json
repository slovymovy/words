            "senses": [
                {
                    "sense_id": "44666627-eb2e-3082-b676-a95b819317b7",
                    "sense_definition": "Słowo wyrażające zgodę, potwierdzenie, akceptację propozycji lub zakończenie tematu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Dobrze>, zrobię to zadanie jutro rano.",
                            "target_lang_translations": {
                                "ru": "<Хорошо>, я сделаю это задание завтра утром.",
                                "en": "<Okay>, I will do this task tomorrow morning."
