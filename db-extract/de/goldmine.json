                                        "glosses": [
                                            "een plaats waar men goud uit de grond haalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5376255-5eca-446c-9fca-eb4ed57d01ca",
                                                "sense_id": "c0fc09b9-8753-3f56-b969-97ee8beea726",
                                                "text": "In Zuid-Afrika zijn veel goudmijnen."
                                            },
                                            {
                                                "example_id": "0a6c79a1-be49-45d6-a3e0-a0f4df293bb1",
                                                "sense_id": "c0fc09b9-8753-3f56-b969-97ee8beea726",
                                                "text": "De illegalen komen uit het dorpje Nieuw Koffiekamp, niet ver van de goudmijn. Ze vinden dat ook zij recht hebben om te mijnen in het concessiegebied van Iamgold. De leiding van bedrijf heeft nog niet op de onrust in het gebied gereageerd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04eb5e1e-7fb9-3c03-879e-14c70f9d344a",
                                        "entry_id": "40434fdc-459e-3646-a5c9-11e737896a37",
                                        "glosses": [
                                            "een bron van grote rijkdom welvaart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a153ea8a-9879-4684-bd33-99d8e1b6b9eb",
                                                "sense_id": "04eb5e1e-7fb9-3c03-879e-14c70f9d344a",
                                                "text": "De winkel in het centrum van de stad was de goudmijn voor de hele familie."
                                            },
                                            {
                                                "example_id": "ada76ec6-1143-4334-abb4-0741dd5a77d0",
                                                "sense_id": "04eb5e1e-7fb9-3c03-879e-14c70f9d344a",
                                                "text": "De vastgoedmaatschappij was dus in de huidige conjunctuur een enorm verborgen kapitaal, een vergeten en slapende goudmijn."
                                            }
                                        ]
                                    }
                                ]
                            }
