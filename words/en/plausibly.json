{
    "word_family": [
        "plausible",
        "implausible",
        "plausibility",
        "implausibility"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0fde9f6c-4196-30df-9dbc-c01de96f3240",
                    "sense_definition": "In a believable or credible manner; in a way that seems reasonable or likely to be true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "believability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She lied <w>plausibly</w>, but the police suspected her anyway.",
                            "target_lang_translations": {
                                "ru": "Она лгала <w>правдоподобно</w>, но полиция всё равно её подозревала."
                            }
                        },
                        {
                            "text": "The actor was able to <w>plausibly</w> explain his absence from the scene.",
                            "target_lang_translations": {
                                "ru": "Актер смог <w>убедительно</w> объяснить свое отсутствие на месте происшествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "believably#Adverb",
                        "credibly#Adverb"
                    ],
                    "antonyms": [
                        "implausibly#Adverb",
                        "unbelievably#Adverb",
                        "incredibly#Adverb"
                    ],
                    "common_phrases": [
                        "plausibly explain",
                        "argue plausibly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правдоподобно или убедительно; так, что это кажется разумным или похожим на правду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдоподобно",
                                "target_lang_sense_clarification": "так, что в это легко поверить"
                            },
                            {
                                "target_lang_word": "убедительно",
                                "target_lang_sense_clarification": "вызывая доверие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d96d9e-f8e1-3212-af02-986cd60198ed",
                    "sense_definition": "Possibly or probably; in a way that cannot be easily disproved based on the available evidence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "believability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Plausibly</w>, she said she'd been working at the time.",
                            "target_lang_translations": {
                                "ru": "<w>Вполне возможно</w>, она сказала правду, что работала в то время."
                            }
                        },
                        {
                            "text": "The missing documents could <w>plausibly</w> have been destroyed during the fire.",
                            "target_lang_translations": {
                                "ru": "Утерянные документы <w>вполне могли</w> быть уничтожены во время пожара."
                            }
                        }
                    ],
                    "synonyms": [
                        "believably#Adverb",
                        "credibly#Adverb"
                    ],
                    "antonyms": [
                        "implausibly#Adverb"
                    ],
                    "common_phrases": [
                        "could plausibly have"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможно или вероятно; так, что это трудно опровергнуть на основе имеющихся данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вполне возможно",
                                "target_lang_sense_clarification": "с высокой долей вероятности"
                            },
                            {
                                "target_lang_word": "вероятно",
                                "target_lang_sense_clarification": "допускается на основе фактов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}