                        "Arabic",
                        "Arabian"
                    ],
                    "common_phrases": [
                        "Arab culture",
                        "Arab states",
                        "Arab world"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к арабам, их странам или культуре.",
                        "zh": "与阿拉伯人、其国家或文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ара́бский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阿拉伯的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
