                    },
                    {
                        "translation_id": "585d3077-9422-4c78-bbeb-333e42027692",
                        "source_entry_id": "b8fc8a29-9f83-338c-8cda-3519ff2246ea",
                        "source_sense_id": "d5334c79-074c-31a3-8524-2ec7fe03c970",
                        "target_lang_word": "Konrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                        "entry_id": "dcef0a45-14a1-3b52-ab11-175d160f88b4",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b56e79-7702-4c45-9c44-b12010a51e2c",
                                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                                "text": "Konrad ist ein kluges Kerlchen."
                                            },
                                            {
                                                "example_id": "67945fde-303f-4096-baff-621f8bea8d26",
                                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                                "text": "\"Konrad\", sprach die Frau Mama, \"Ich geh´ aus und du bleibst da. Sei hübsch ordentlich und fromm, bis nach Haus ich wieder komm’. Und vor allem, Konrad, hör’! Lutsche nicht…\" (Aus Der Struwwelpeter)"
                                            },
                                            {
                                                "example_id": "a7d5a682-ffab-4729-b6eb-c25c1f1eab34",
                                                "sense_id": "3a64f7e7-3fc0-3d33-8d57-271ed1105e81",
                                                "text": "„Bereits Konrad Adenauer kritisierte in seiner Weihnachtsansprache 1955 die Kommerzialisierung des Weihnachtsfests.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de5c8c2-818a-489a-a23a-f6daf605a864",
                        "source_entry_id": "b8fc8a29-9f83-338c-8cda-3519ff2246ea",
                        "source_sense_id": "d5334c79-074c-31a3-8524-2ec7fe03c970",
                        "target_lang_word": "Conrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Conrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea65a6a2-9708-3970-bdee-48d1c0057a0f",
                                        "entry_id": "25787839-cf4b-3e13-9157-87ae71585058",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c1e249-954e-4408-a66f-3c13914150ae",
                                                "sense_id": "ea65a6a2-9708-3970-bdee-48d1c0057a0f",
                                                "text": "Conrad Mustermann ist ein schöner Junge."
                                            },
                                            {
                                                "example_id": "e66586b7-2f20-4a4d-aa91-ad5ec6762691",
                                                "sense_id": "ea65a6a2-9708-3970-bdee-48d1c0057a0f",
                                                "text": "Conrad ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "258f4b70-9209-4bb1-8b2f-0da9e094605d",
                                                "sense_id": "ea65a6a2-9708-3970-bdee-48d1c0057a0f",
                                                "text": "Grüß bitte Conrad Mustermann herzlich von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Conrad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                        "entry_id": "2dc3c24a-730e-391f-b143-92b3c67821fc",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313badc8-114f-449f-8924-ac62f4367c63",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Frau Conrad ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6b2df9b1-eb67-45b5-84aa-e9108e5d9679",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Herr Conrad wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f9c3906f-e3ab-4717-a1bd-58117d7da251",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Die Conrads kommen heute aus dem Erzgebirge."
                                            },
                                            {
                                                "example_id": "ddd379d1-de21-400c-9bc9-d3c2f34adb40",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Der Conrad trägt nie die Schals, die die Conrad ihm strickt."
                                            },
                                            {
                                                "example_id": "cad6927d-a902-4ba1-8d2b-f13fa2181e53",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Conrad kommt, geht der Herr Conrad.“"
                                            },
                                            {
                                                "example_id": "886f6dab-f5b0-4673-9cc0-a6ce2626fb67",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Conrad kommt und geht."
                                            },
                                            {
                                                "example_id": "6c54f927-71fc-44e3-a58e-209ce564f304",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "Conrads kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "40fcbbde-ed8a-4902-8ed5-a3f55cbd70a7",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "An verregneten Herbsttagen ist Familie Conrads liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "f42ab689-9abc-4172-ba81-d00fa06c5485",
                                                "sense_id": "b36accb9-52b9-3805-8d5b-161448399eb3",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Conrad das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
