                                        "glosses": [
                                            "Property of being litigious, of tending to resort to legal means such as lawsuits."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bac78d8-324f-4605-9b2a-3149a91b4ec4",
                                                "sense_id": "4865d438-af30-3bf0-a957-dd57c00ca793",
                                                "text": "His litigiousness won him almost as few friends as it won him cases."
                                            }
