                    },
                    {
                        "translation_id": "18709980-4f68-43a4-a92b-eadc09d6df6a",
                        "source_entry_id": "d944bf77-7491-3b66-8bba-68226b5ffe00",
                        "source_sense_id": "f2ac519f-22f6-3704-982b-b798e8fdb4f2",
                        "target_lang_word": "Laib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laib",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                        "entry_id": "30285a66-f6ad-3b35-8fc2-0ca9c97d44f6",
                                        "glosses": [
                                            "Zähleinheit für große, runde und geformte Dinge wie Brot oder Käse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b135044-26c7-4c6b-be7b-f0e7877ad242",
                                                "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                                "text": "Auf dem Markt werde ich zwei Laibe Brot und einen halben Laib Gouda kaufen."
                                            },
                                            {
                                                "example_id": "8f8c2028-e644-4598-86d9-3504c498e2e6",
                                                "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                                "text": "„Sie revanchierte sich mit einer Gegenanzeige, weil die gestohlenen beiden Laibe frisch gebacken waren.“"
                                            },
                                            {
                                                "example_id": "2bb89d00-2023-4161-843d-f10e75ad0115",
                                                "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                                "text": "„Dann zerstreuen sie sich, die warmen Laibe unter dem Arm.“"
                                            },
                                            {
                                                "example_id": "f62263f7-1d5c-499a-800a-bfc3255e0646",
                                                "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                                "text": "„Unter Jacques' neu entdeckter Führung und mit dieser hoffnungsvollen Perspektive stieg der Teamgeist enorm, und auf einmal erschienen vierzig Laib Brot wieder exzessiv und etwas blöde.“"
                                            },
                                            {
                                                "example_id": "0cceea7d-1a69-4122-9012-e43f9393394e",
                                                "sense_id": "9b43bc94-fc02-3205-a17f-7a2b05e493ec",
                                                "text": "„Ich bekam, so viel ich wollte, und einen kleinen Laib Brot obendrein, genau wie einige andere, die mich begleitet hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79b422b1-f7fa-4e4e-9e4a-b166f2e35ece",
                        "source_entry_id": "d944bf77-7491-3b66-8bba-68226b5ffe00",
                        "source_sense_id": "f2ac519f-22f6-3704-982b-b798e8fdb4f2",
                        "target_lang_word": "miche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                        "entry_id": "3f3656bb-a4e6-3697-bdb2-a4417cedf76b",
                                        "glosses": [
                                            "Pain d’une grosseur moyenne, pesant une livre ou plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e237a81b-d76e-4831-b719-311ddea1a94c",
                                                "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                                "text": "Nous avons encore pas mal de pain de seigle à manger, et la miche quotidienne est dure à pétrir."
                                            },
                                            {
                                                "example_id": "f01ab77d-1532-4042-b636-b8a7560e166f",
                                                "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                                "text": "Pendant qu’elle disposait les bols et qu’elle tirait de la huche la bonne miche de pain bis, mon compagnon lui demanda : […]."
                                            },
                                            {
                                                "example_id": "94bc9a90-384d-4eab-950e-b0a5556a109a",
                                                "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                                "text": "C’était une affaire délicate que le découpage de ma miche ; j’en fis cinq parts aussi égales que possible, et, pour qu’il n’y eût pas de pain gaspillé, je les distribuai en petites tranches ; chacun avait son morceau à son tour, comme si nous avions mangé à la gamelle."
                                            },
                                            {
                                                "example_id": "a4e46585-e4bf-47b8-ac56-c983ca5eba10",
                                                "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                                "text": "Il vivait aussi bien l’âge de ses quinze ans avec le quinquet éclairant la voûte du four où son père lui apprenait à aligner les miches, qu’il vivait dans l’époque présente engluée dans un crépuscule de silence et de calme."
                                            },
                                            {
                                                "example_id": "13729c0d-cdef-4466-8f00-1497f7ae2715",
                                                "sense_id": "2a58cc72-89b0-3648-b417-16b9bc305bd8",
                                                "text": "On en sort le plus souvent avec de gros pains d’un kilo ou des miches qu’on conserve. Pour nous, le luxe c’était la baguette ou la ficelle qu’on achetait exceptionnellement et qu’on ne trouvait pas d’ailleurs tous les jours, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                        "entry_id": "3f3656bb-a4e6-3697-bdb2-a4417cedf76b",
                                        "glosses": [
                                            "Fesse."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40daad44-1eca-4ebf-84fd-9631ead2f9f7",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "— « Si tu causes si tu fais le con, tu vas voir tes miches, petit con. Je te fais la peau. »"
                                            },
                                            {
                                                "example_id": "cd93e666-24a3-4d78-9009-6519d44c7819",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "Elle a de magnifiques miches, elle a de belles fesses."
                                            },
                                            {
                                                "example_id": "fe4c2b86-a5d1-4766-968e-e3441a9d1633",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "On a eu chaud aux miches, on a eu chaud aux fesses, on l’a échappé belle."
                                            },
                                            {
                                                "example_id": "5998a11b-2da7-4b44-8eb9-f045cfd73d2c",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "Gare à tes/vos miches, gare à tes/vos fesses."
                                            },
                                            {
                                                "example_id": "91ab31f4-835f-44f7-9ce4-72c01148d431",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "… qu'est-ce que ça pouvait leur foutre, c'est pas entre leurs miches que ça rentrait ces zobs dynamiques !"
                                            },
                                            {
                                                "example_id": "ecf232dd-9faa-4993-b0d6-ad844e1ea221",
                                                "sense_id": "652c0809-77e2-3748-af82-56a843962697",
                                                "text": "Y fait ni une ni deux, y quitte son bénard, s’couche à côté de la bonne femme, lui p’lote les miches, sort sa clarinette, et entreprend d’l’enfiler en levrette à la surprenante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e051e9-d07b-3981-bd96-ebbf99f4b17f",
                                        "entry_id": "3f3656bb-a4e6-3697-bdb2-a4417cedf76b",
                                        "glosses": [
                                            "Seins, poitrine."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fc47f57-90f0-4105-bd15-51bc2e0e2d95",
                                                "sense_id": "e8e051e9-d07b-3981-bd96-ebbf99f4b17f",
                                                "text": "C’te paire de miches pleines de lait qu’elle a!"
                                            },
                                            {
                                                "example_id": "9741ad93-2e3e-4501-a040-3a660dde330c",
                                                "sense_id": "e8e051e9-d07b-3981-bd96-ebbf99f4b17f",
                                                "text": "j'ai mal aux miches"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
