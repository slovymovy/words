                                "target_senses": [
                                    {
                                        "sense_id": "0419a6ca-6313-3516-9cee-beda91f600ac",
                                        "entry_id": "b4cc671d-1727-3d70-ab17-97fb3806f3c7",
                                        "glosses": [
                                            "Of an inappropriately or unusually low weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a484c1e-3347-4d0a-8c74-3c7b5bc7f98d",
                                                "sense_id": "0419a6ca-6313-3516-9cee-beda91f600ac",
                                                "text": "He's so underweight he's had to buy smaller clothes."
                                            },
                                            {
                                                "example_id": "bab24493-8cc4-4869-89de-e20c84898a20",
                                                "sense_id": "0419a6ca-6313-3516-9cee-beda91f600ac",
                                                "text": "He's thirty pounds underweight."
                                            },
                                            {
                                                "example_id": "df704577-66b6-4287-a5bf-b9a4d4d542d2",
                                                "sense_id": "0419a6ca-6313-3516-9cee-beda91f600ac",
                                                "text": "The market trader was fined for selling underweight bags of fruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efeb72d2-89c9-3ae5-a427-c5c27e08049d",
                                        "entry_id": "b4cc671d-1727-3d70-ab17-97fb3806f3c7",
                                        "glosses": [
                                            "Not too heavy for an intended purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427fd1f0-bba8-48c8-82cf-825cab4a6fa8",
                                                "sense_id": "efeb72d2-89c9-3ae5-a427-c5c27e08049d",
                                                "text": "The suitcase is just slightly underweight; I'll let it on the plane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92755bad-566c-3cec-b41d-97f3fecf8d4b",
                                        "entry_id": "b4cc671d-1727-3d70-ab17-97fb3806f3c7",
                                        "glosses": [
                                            "Being less invested in a particular area than market wisdom suggests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42eebce-1372-4623-aef7-85f87793b461",
                                                "sense_id": "92755bad-566c-3cec-b41d-97f3fecf8d4b",
                                                "text": "The fund is underweight in mining."
                                            },
                                            {
                                                "example_id": "e64ded88-189e-4c5e-abe8-36747476c584",
                                                "sense_id": "92755bad-566c-3cec-b41d-97f3fecf8d4b",
                                                "text": "2011, Murdoch, S. Foreigners back for Aussie stocks, The Australian\n\"It's a long-run trend of foreign investors -- typically being underweight the banking sector in Australia,\" Mr Baker said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "underweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "314d1822-9da4-3977-a3a8-6e2fff15e4fe",
                                        "entry_id": "0d112824-323d-3aaf-b1df-210a8c7ce84d",
                                        "glosses": [
                                            "The state or quality of being underweight."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb9aaed-1c89-49c5-a9ad-a636149ffef8",
                                                "sense_id": "314d1822-9da4-3977-a3a8-6e2fff15e4fe",
                                                "text": "1996, United States Institute of Medicine Committee on Scientific Evaluation of WIC Nutrition Risk Criteria, WIC Nutrition Risk Criteria: A Scientific Assessment, National Academies Press, →ISBN, page 110,\nUnderweight reflects the body’s thinness, but the term does not necessarily imply the nature and causes of underweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a88f3f-712e-34fe-99c4-d2e002a08f9d",
                                        "entry_id": "0d112824-323d-3aaf-b1df-210a8c7ce84d",
                                        "glosses": [
                                            "An underweight person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14ad1cfe-665a-3f5e-bfd3-36e6b1f32905",
                                        "entry_id": "0d112824-323d-3aaf-b1df-210a8c7ce84d",
                                        "glosses": [
                                            "An underweight investment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89005297-3475-4ba5-a486-aac560fa3b2a",
                                                "sense_id": "14ad1cfe-665a-3f5e-bfd3-36e6b1f32905",
                                                "text": "Further, structured managers usually attempt to hit their lower targets by relying on a relatively large number of small active deviations (i.e., overweights and underweights)."
                                            },
                                            {
                                                "example_id": "a089a937-d504-4926-b78d-c9f47d1f46a4",
                                                "sense_id": "14ad1cfe-665a-3f5e-bfd3-36e6b1f32905",
                                                "text": "Consider a conventional long-only portfolio with underweights on holdings the investment manager does not like and overweights on holdings the manager does like."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
