                    {
                        "translation_id": "9d5ec625-b5ce-40ce-baa8-ab8a2ff37e04",
                        "source_entry_id": "44c3e669-0699-3b56-8d1b-b8e151447602",
                        "source_sense_id": "7a8dc8d3-42be-3c9f-a769-ee2b9defbe4a",
                        "source_sense_description": "fast, quickly, swiftly",
                        "target_lang_word": "vivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                                        "entry_id": "ed765c48-5241-3c35-bda8-538338df30ad",
                                        "glosses": [
                                            "Avec vivacité ; avec ardeur ; avec vigueur ; sans relâche ; avec promptitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1303229-fe86-4c88-a3fa-aba4ceb2e9ee",
                                                "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                                                "text": "Garçon!... garçon!... des pieds de mouton à la poulette, et servez chaud... Allons, vivement."
                                            },
                                            {
                                                "example_id": "f85e48c4-43e7-4089-bf92-34971684a631",
                                                "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                                                "text": "Ses eaux, très limpides, alimentées par la fonte des neiges, coulaient assez vivement, sans jamais former de tumultueux rapides."
                                            },
                                            {
                                                "example_id": "2cdcc796-c2d2-417e-913c-e310b6c0fdb3",
                                                "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                                                "text": "Par-dessus l’autre bord du navire, j’aperçus, vivement éclairée par l’incendie, la falaise abrupte qui descend vers Lübeck."
                                            },
                                            {
                                                "example_id": "5a6b7cfe-254a-4d59-8199-805d2db02e08",
                                                "sense_id": "b80fe886-039d-3680-a175-35635dbc8fef",
                                                "text": "L’acide fluorhydrique, très avide d’eau, attaque vivement les végétaux […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7009404e-6a66-3e5e-b8aa-497db034a89b",
                                        "entry_id": "ed765c48-5241-3c35-bda8-538338df30ad",
                                        "glosses": [
                                            "Sensiblement ; profondément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541cad4d-7a4b-4ff2-8ace-2865a2aaafa3",
                                                "sense_id": "7009404e-6a66-3e5e-b8aa-497db034a89b",
                                                "text": "À ce moment, il aperçut un ours superbe, un grizzly à fourrure noire, de haute taille, qui marchait sur ses pieds de derrière en longeant la voie, troublé sans doute par cette lutte des éléments qui impressionne si vivement les animaux."
                                            },
                                            {
                                                "example_id": "36b986ac-ad47-405a-a9fa-c8b3700ec0e4",
                                                "sense_id": "7009404e-6a66-3e5e-b8aa-497db034a89b",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61712e35-50f1-3f9c-b9f0-2f77b2e992f8",
                                        "entry_id": "ed765c48-5241-3c35-bda8-538338df30ad",
                                        "glosses": [
                                            "Exprime le vif souhait de voir un événement arriver, se produire au plus tôt :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90fd0cc-a825-4b13-8181-56820d153120",
                                                "sense_id": "61712e35-50f1-3f9c-b9f0-2f77b2e992f8",
                                                "text": "Vivement dimanche !"
                                            },
                                            {
                                                "example_id": "c9320955-7e64-4c31-a5ff-9cddf5b4b956",
                                                "sense_id": "61712e35-50f1-3f9c-b9f0-2f77b2e992f8",
                                                "text": "Vivement que tu reviennes !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
