                                    {
                                        "sense_id": "495ce0e2-1f14-3f43-8784-a8b10a5cce35",
                                        "entry_id": "019af52d-50a9-39ec-97eb-d14903baa395",
                                        "glosses": [
                                            "The sound of something that chugs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ba5c89-88ed-414a-bda5-7258fb18f71c",
                                                "sense_id": "495ce0e2-1f14-3f43-8784-a8b10a5cce35",
                                                "text": "There was a Thompson class \"B1\" in Birmingham New Street, and an ex-Great Eastern class \"B12/3\" in the Midland station at Leicester, where the contented chugging of its Westinghouse air-compressor struck an exotic note."
                                            },
                                            {
                                                "example_id": "c630f5ac-eecf-46b6-9b26-f7893dfec6eb",
                                                "sense_id": "495ce0e2-1f14-3f43-8784-a8b10a5cce35",
                                                "text": "From the nearby rail yards came clangings, groanings, chuggings."
                                            }
                                        ]
