                ],
                "senses": [
                    {
                        "sense_id": "4219b818-9097-35a6-b433-f7fd2cac0bc0",
                        "entry_id": "db941e6e-aee8-3b44-af34-fffc491948cd",
                        "glosses": [
                            "Entasser comme des sardines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe1647e-8436-4705-9ef4-2e6fc37610c4",
                                "sense_id": "4219b818-9097-35a6-b433-f7fd2cac0bc0",
                                "text": "L'état d'apesanteur permettait d'ensardiner les passagers."
                            },
                            {
                                "example_id": "c2fd4bcb-c934-4e34-a03b-45634134034b",
                                "sense_id": "4219b818-9097-35a6-b433-f7fd2cac0bc0",
                                "text": "Bref j'ai quitté la maison à quatre heures de l'après-midi pour éviter de me faire ensardiner dans le bus 14."
                            },
                            {
                                "example_id": "af6cfe59-2de2-471b-83d9-7d49d472fc9f",
                                "sense_id": "4219b818-9097-35a6-b433-f7fd2cac0bc0",
                                "text": "N'est-ce pas ton juridisme chauvin qui a codifié des lois d'exclusion pour nous rejeter à la mer du Kivu, et nous condamner, de la sorte, à nous ensardiner sur nos coteaux étiques des minuscules mille collines ?"
                            }
                        ]
                    }
