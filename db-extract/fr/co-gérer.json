                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d37ce9-671e-41a8-81b4-2f849c675204",
                                "sense_id": "4a8b0663-8f68-3080-a30a-08164f67e39c",
                                "text": "Un peu de liberté accordée au malade pour co-gérer son traitement peut être une bonne chose, mais le « hors piste » est toujours à ses risques et périls."
                            },
                            {
                                "example_id": "53e52114-2b9b-4ecd-a8f0-b789c3743028",
                                "sense_id": "4a8b0663-8f68-3080-a30a-08164f67e39c",
                                "text": "Il s'agit donc d'inviter salariés et militants à « peser », à influencer les décisions d'organisation, mais en aucun cas à co-gérer."
                            }
                        ]
                    }
