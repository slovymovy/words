        "nl-extract.jsonl": [
            {
                "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                "word": "community",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "d1ab909b-ef0d-48b3-bcdf-e21ab32d908b",
                        "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                        "tags": [
                            "plural"
                        ],
                        "form": "community's"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edc2454a-c702-3ff0-9a55-f60009759d9b",
                        "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                        "glosses": [
                            "groep mensen die vanuit een gedeelde belangstelling veel informatie en opvattingen willen uitwisselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9c6f34-6b4f-4172-b7e0-ba19d6096b30",
                                "sense_id": "edc2454a-c702-3ff0-9a55-f60009759d9b",
                                "text": "En dat terwijl NRC Handelsblad zelf zojuist ook al als gratis verpakking had gediend van het magazine Ode, het blad van de esoterische ‘community voor intelligente optimisten’ dat artikelen brengt als ‘Maand van de spiritualiteit nu al succesvol’ en ‘Paddenstoelen kunnen helpen bij olieramp’ en ‘Bescherm je brein tegen informatie-overload’."
                            },
                            {
                                "example_id": "74f48398-aebe-42c7-be27-58034451e5a0",
                                "sense_id": "edc2454a-c702-3ff0-9a55-f60009759d9b",
                                "text": "Op die manier zijn vele duizenden foto's - cultureel erfgoed dat anders nog altijd in familiealbums in de Westhoek zou zitten - intussen online beschikbaar gemaakt voor een veel bredere community."
                            }
                        ]
                    },
                    {
                        "sense_id": "a543c2e7-1c32-3c1b-9551-ed2eb434a6bc",
                        "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                        "glosses": [
                            "vaste bezoekersgroep van een website die onderling contact tussen gebruikers mogelijk maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d460da-d887-4006-bb13-767280ec4413",
                                "sense_id": "a543c2e7-1c32-3c1b-9551-ed2eb434a6bc",
                                "text": "Voor de gamers biedt de PSP nu dus niet alleen de mogelijkheid om van voor de pc op te stappen en toch geconnecteerd te blijven met de community van gamers van massive multiplayer online role playing games, bijvoorbeeld, maar ook van wireless gaming in een ter plekke opgezette LAN-party."
                            },
                            {
                                "example_id": "784a128d-8090-4fed-8794-bec773704c92",
                                "sense_id": "a543c2e7-1c32-3c1b-9551-ed2eb434a6bc",
                                "text": "De Digitale Stad heeft als potentieel sterk punt dat het een community van bewoners is. Beter gezegd, een community die uit groepen van bewoners bestaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "27b935e4-5cea-3a0f-8274-83ad424d7eb0",
                        "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                        "glosses": [
                            "groep mensen die samen bepaalde programmatuur onder vrije licentie ontwikkelen en onderhouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f175f3f0-b651-4401-bc02-f02f5009738c",
                                "sense_id": "27b935e4-5cea-3a0f-8274-83ad424d7eb0",
                                "text": "Big Buck Bunny werd gemaakt met open source software (het 3D-animatiepakket Blender) dat vrij op het internet beschikbaar wordt gesteld en onderhouden door de community rondom de Blender Foundation."
                            },
                            {
                                "example_id": "181866d1-2e8c-43a4-9772-bb803880b6dd",
                                "sense_id": "27b935e4-5cea-3a0f-8274-83ad424d7eb0",
                                "text": "Opensourceprojecten hebben altijd slimme mensen aangetrokken die zich binnen een community wijdden aan het perfectioneren en uitdragen van het gedachtegoed, zoals de community die het besturingssysteem Linux jarenlang promootte."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5590b12-c366-3a59-8130-d5d154cc2aa2",
                        "entry_id": "c0ae9c1a-7371-3a45-a23a-fb87ae574d63",
                        "glosses": [
                            "groep mensen die een vast sociaal verband vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c3fa7f-925e-4d29-8209-711102c88f81",
                                "sense_id": "d5590b12-c366-3a59-8130-d5d154cc2aa2",
                                "text": "Een hernieuwde waardering van levenstijlen [sic!] die de community centraal stellen, met de daarbij behorende bereidheid elkaar op plaatselijk niveau bij te staan."
                            },
                            {
                                "example_id": "1e235293-ccbf-4ac6-8e95-7528a4228464",
                                "sense_id": "d5590b12-c366-3a59-8130-d5d154cc2aa2",
                                "text": "Staat in de traditionele liberale filosofie de emancipatie van het individu centraal, de communitaristen benadrukken dat ook de moderne, geëmancipeerde burger zonder zijn omgeving niet kan bestaan. Hij heeft een omgeving, een community, nodig waarin hij tot bloei komen kan: het gezin, de buurt, het bedrijf, de etnische en/of nationale groep, de lokale en nationale gemeenschap."
                            }
                        ]
                    }
                ],
