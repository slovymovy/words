                ],
                "senses": [
                    {
                        "sense_id": "4770d1c3-17ef-3ad7-8369-79115ab9e3f6",
                        "entry_id": "8bc9c9a8-9e64-3acf-844a-f77bb5878193",
                        "glosses": [
                            "Anhänger des Neofaschismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0f146a-120c-491a-9192-212b4c099b06",
                                "sense_id": "4770d1c3-17ef-3ad7-8369-79115ab9e3f6",
                                "text": "„Als er aus dem Bus stieg, starrten ihn die Einheimischen im und vor dem Terminal Bookstore an. Er wäre nicht mehr aufgefallen, hätte er ein Transparent mit der Aufschrift VERKLEMMTER, UNCOOLER, UNSPORTLICHER, FLEISCHFRESSENDER, URBANER NEOFASCHIST VON DER EAST COAST, DER NOCH NIE IM LEBEN MEDITIERT HAT vor sich hergetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faef1b39-e7b3-46ad-897a-042c8be530d4",
                        "source_entry_id": "8bc9c9a8-9e64-3acf-844a-f77bb5878193",
                        "source_sense_id": "4770d1c3-17ef-3ad7-8369-79115ab9e3f6",
                        "source_sense_description": "Anhänger des Neofaschismus",
                        "target_lang_word": "neofascist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neofascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                        "entry_id": "80b8f13f-f121-3db5-b6cc-893466dfe975",
                                        "glosses": [
                                            "Of or pertaining to neofascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00931b42-9787-4395-b08c-a1038dc10614",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "The neoliberal era in the United States ended with a neofascist bang."
                                            },
                                            {
                                                "example_id": "1f5f95d9-0537-44f7-94cc-74e6efaa6daf",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "Throughout this area, which includes the Ruhr, Germany's industrial arsenal, there has been a steady growth in Nationalist and neo-Fascist sentiments in the last six months."
                                            },
                                            {
                                                "example_id": "767b145c-396f-42dd-92b9-0eee668acc1a",
                                                "sense_id": "5843b278-47fb-385c-b1c0-3fe21d59f8dc",
                                                "text": "Italian opposition leaders have called on Giorgia Meloni’s rightwing government to ban neofascist groups after a chilling video emerged of hundreds of men making fascist salutes during an event in Rome."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neofascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a544ca9c-fec7-3a05-97c1-3d35e1942d08",
                                        "entry_id": "15a2e6ec-73ba-3165-a071-67e1f70c0ba0",
                                        "glosses": [
                                            "A follower of neofascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac13fd80-d915-4bc5-98b1-7ead1dcf3744",
                                                "sense_id": "a544ca9c-fec7-3a05-97c1-3d35e1942d08",
                                                "text": "By this summer, everything — her youthful admiration for Benito Mussolini, her party’s links to neofascists, her often extreme rhetoric — had been forgiven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "149ed952-e0c1-47f7-ac15-3251a44bd18b",
                        "source_entry_id": "8bc9c9a8-9e64-3acf-844a-f77bb5878193",
                        "source_sense_id": "4770d1c3-17ef-3ad7-8369-79115ab9e3f6",
                        "source_sense_description": "Anhänger des Neofaschismus",
                        "target_lang_word": "néofasciste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néofasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "207f8d31-8a33-3c7c-81f2-48bc8d1b58a2",
                                        "entry_id": "710327ce-df92-31a0-a4b2-9572f33d1d5d",
                                        "glosses": [
                                            "Relatif au néofascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e091f05-9734-4fb7-98db-045949a3f613",
                                                "sense_id": "207f8d31-8a33-3c7c-81f2-48bc8d1b58a2",
                                                "text": "Mais la dynamique néofasciste est mondiale car elle procède d’un phénomène qui s’est déployé à cette échelle : l’avènement du capitalisme néolibéral puis sa crise. Une crise multiforme : sociale, économique, environnementale, et bien sûr politique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "néofasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1df2280-3f24-39c1-9ad3-9694f4d65218",
                                        "entry_id": "7fd99aee-c88c-3dd3-80f2-777875804e19",
                                        "glosses": [
                                            "Partisan du néofascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36809815-4083-4808-95d3-f0ca0ff3add8",
                                                "sense_id": "a1df2280-3f24-39c1-9ad3-9694f4d65218",
                                                "text": "Après un passage par l’Armée de l’Air, Shauna M. est aujourd’hui chargée de communication pour la Garde Nationale. Elle est surtout l’une des militantes du collectif Némésis et fréquente des néofascistes aux évènements d’Academia Christiana."
                                            },
                                            {
                                                "example_id": "575f400d-bf62-4894-9dc2-dc956533b940",
                                                "sense_id": "a1df2280-3f24-39c1-9ad3-9694f4d65218",
                                                "text": "Enfin, on peut soutenir que les États disposent actuellement d’instruments de surveillance et de répression de masse d’une sophistication sans commune mesure avec les États dans l’entre-deux-guerres, si bien que les néofascistes peuvent avoir le sentiment que la violence étatique est suffisante pour surveiller, contrôler, réprimer voire annihiler, physiquement si besoin, toute forme d’opposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
