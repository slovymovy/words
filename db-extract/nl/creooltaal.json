                                        "glosses": [
                                            "uproszczona mowa powstała w wyniku kontaktu grup posługujących się wzajemnie niezrozumiałymi językami, w odróżnieniu od pidżynu charakteryzująca się ustabilizowanym systemem gramatycznym i dobrze wypracowanym słownictwem, służąca danemu społeczeństwu jako język etniczny"
                                        ],
                                        "tags": [],
