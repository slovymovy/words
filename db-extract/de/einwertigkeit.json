                    {
                        "form_id": "7ad638c7-31cc-45e2-8de5-501c787bc166",
                        "entry_id": "6dc1b0b4-df8b-3777-9bc2-8d3d274880bb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Einwertigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                        "entry_id": "6dc1b0b4-df8b-3777-9bc2-8d3d274880bb",
                        "glosses": [
                            "Eigenschaft, nur einen Zustand, eine Möglichkeit zu haben"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d9fe9910-2120-4219-b2da-fef680ddd41a",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Die Mehrwertigkeit des Konsumismus hebt sich hier sehr prägnant von der Einwertigkeit der Religion und der Zweiwertigkeit der Politik ab.“"
                            },
                            {
                                "example_id": "fc5f28c0-88c8-4cfe-96b1-54330c7e0c3d",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Sämtliche Daten des Modells sind durch Einwertigkeit und durch statischen Charakter gekennzeichnet […].“"
                            },
                            {
                                "example_id": "53462965-8be8-4b66-995a-266f948afede",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Die Zuverlässigkeit der Rechnerarbeit besteht eben in der Einwertigkeit der Bedeutung und Form der übergebenen Anweisungen.“"
                            },
                            {
                                "example_id": "2a187c07-8975-41fb-9ea8-f16ec27b1d6c",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Diese Voraussetzung der Einwertigkeit der Umweltvorstellung ist nicht identisch mit der Annahme der Richtigkeit dieser Vorstellung.“"
                            },
                            {
                                "example_id": "400b1867-0af7-41cb-a07a-cf5857f64f24",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Nun ist die Einheit der Satzintention Voraussetzung für die Einwertigkeit des Satzes im Sinne des Prinzips vom ausgeschlossenen Dritten: entweder ist der Satz wahr oder er ist falsch.“"
                            },
                            {
                                "example_id": "5ae48b87-efcb-4eda-ba5f-133a0f3b8e50",
                                "sense_id": "d8b630df-dee4-3cf4-8a46-ef140ae275a9",
                                "text": "„Wie bei der Darstellung der Namenstheorie ausgeführt wurde, führt die Verbindung zweier Glieder notwendig zu einer einzigen und damit einwertigen Relation, die dann leicht in eine Einwertigkeit des Ausdrucks umgedeutet werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da743aa8-e169-3aa1-ad8c-ed9c5cef79a4",
                        "entry_id": "6dc1b0b4-df8b-3777-9bc2-8d3d274880bb",
                        "glosses": [
                            "Eigenschaft, nur mit einem anderen Atom eine chemische Bindung einzugehen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3a75484e-683c-46cd-ab8a-dd9a3dc07373",
                                "sense_id": "da743aa8-e169-3aa1-ad8c-ed9c5cef79a4",
                                "text": "„Chlor ist in der siebten Hauptgruppe zu finden, was ebenfalls Einwertigkeit impliziert.“"
                            },
                            {
                                "example_id": "64098d0d-5b74-48f9-8880-3729f3d3daa9",
                                "sense_id": "da743aa8-e169-3aa1-ad8c-ed9c5cef79a4",
                                "text": "„Ebenso wenig wie hier die Einwertigkeit der Alkali- und Halogenatome sich unmittelbar in der Struktur äußert, tut das etwa die Zweiwertigkeit von Zink und Schwefel in ZnS.“"
                            },
                            {
                                "example_id": "049e55c0-91fc-48bb-9374-a17c0acf03e1",
                                "sense_id": "da743aa8-e169-3aa1-ad8c-ed9c5cef79a4",
                                "text": "„Die größere Stabilität der abgeschlossenen Schale von zehn 4d-Elektronen hängt offenbar mit der strengen Einwertigkeit des Silbers zusammen.“"
                            },
                            {
                                "example_id": "cbc68bf0-0ea6-49aa-afc5-c6227f349378",
                                "sense_id": "da743aa8-e169-3aa1-ad8c-ed9c5cef79a4",
                                "text": "„Chemische Eigenschaften, die sich periodisch wiederholen, sind beispielsweise die Einwertigkeit der Alkali-Atome oder die Reaktionsträgheit der Edelgase.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                        "entry_id": "6dc1b0b4-df8b-3777-9bc2-8d3d274880bb",
                        "glosses": [
                            "Eigenschaft, drei obligatorische Aktanten zu haben"
                        ],
                        "tags": [
                            "bei einem Verb"
                        ],
                        "examples": [
                            {
                                "example_id": "b72fe7e6-e81e-409b-9ee5-0a23c5e82aee",
                                "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                                "text": "„Es gibt Verben v₁, die nur in syntaktischer Einwertigkeit vorkommen.“"
                            },
                            {
                                "example_id": "41381f34-5817-433a-9ddd-80da4784b242",
                                "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                                "text": "„Eine besondere Schwierigkeit liegt darin, daß zunächst nur einwertige Verben (Einwertigkeit im Sinne des Dependenzmodells) Verwendung finden können, wodurch die Zahl der in Frage kommenden Verben stark reduziert wird.“"
                            },
                            {
                                "example_id": "821e4edc-507b-4ba7-b221-5af7a775660d",
                                "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                                "text": "„Im Kern dieser sprachlichen Handlungstheorie unterscheidet Tesnière bei den Verben drei Valenzen, nämlich die Einwertigkeit , die Zweiwertigkeit und die Dreiwertigkeit.“"
                            },
                            {
                                "example_id": "d46525b2-bd64-48bf-80e7-102b9cf4eae7",
                                "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                                "text": "„Im Unterschied der dann als Ausgangsversion angesetzten Variante ‚eine Frage stellen‘ ist keine Reduktion auf Einwertigkeit möglich.“"
                            },
                            {
                                "example_id": "c279aa2e-d0bc-4cb9-babe-80beacd425e2",
                                "sense_id": "4b670c77-d27c-300d-a6a8-5a823b95f253",
                                "text": "„Der Verlust der Einwertigkeit wird dadurch möglich, daß die Nominalform des Verbs nicht in primären, sondern in sekundären Sätzen steht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
