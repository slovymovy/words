        "nl-extract.jsonl": [
            {
                "entry_id": "d12a7f55-aba0-3786-9c4d-215a1938eb90",
                "word": "trojaan",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b21a00ee-6777-452d-a570-dd8907ea014b",
                        "entry_id": "d12a7f55-aba0-3786-9c4d-215a1938eb90",
                        "tags": [
                            "plural"
                        ],
                        "form": "trojanen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70bce7f7-8b13-3d3b-a764-2c5ce6d698f3",
                        "entry_id": "d12a7f55-aba0-3786-9c4d-215a1938eb90",
                        "glosses": [
                            "een programma dat ongewenst meekomt met een programma dat door de gebruiker wordt geïnstalleerd. Een Trojaans paard kan schade toebrengen aan de computergegevens of de privacy van de gebruiker. In het jargon gebruikt men ook wel het Engelse Trojan horse of kortweg trojaan. Het is genoemd naar het Paard van Troje waarin Griekse soldaten de stad Troje binnenkwamen om de stad van binnenuit aan te vallen. Een Trojaans paard is dus geen zelfstandig programma, zoals een computervirus. Het is ook niet hetzelfde als een worm, want het moet door de gebruiker worden gekopieerd en kopieert niet zichzelf naar andere computers"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76a3399c-0f63-4688-918b-479bef4b1e9c",
                        "source_entry_id": "d12a7f55-aba0-3786-9c4d-215a1938eb90",
                        "source_sense_id": "70bce7f7-8b13-3d3b-a764-2c5ce6d698f3",
                        "target_lang_word": "Trojan horse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trojan horse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a57734d7-0f82-329b-9678-bad009520cf7",
                                        "entry_id": "7bd2a8d4-9cca-3056-a2e2-176fbfe4eb8a",
                                        "glosses": [
                                            "The hollow wooden horse by which the Greeks allegedly gained access to Troy during the Trojan War."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Trojan horse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4531ec07-7846-339a-8282-0723d9397ab7",
                                        "entry_id": "d4436bef-e09b-338a-8f1c-7647aea53914",
                                        "glosses": [
                                            "A subversive person or device placed within the ranks of the enemy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb3aba15-610c-309b-83b1-3224f203a4f6",
                                        "entry_id": "d4436bef-e09b-338a-8f1c-7647aea53914",
                                        "glosses": [
                                            "A malicious program that is disguised as legitimate software."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f238308-ac8d-4e0b-846d-f1c0f47e5c4f",
                                                "sense_id": "bb3aba15-610c-309b-83b1-3224f203a4f6",
                                                "text": "Worse than what could be observed about the program was the fear that it might be a Trojan horse program -- apparently innocent, but carrying a string of code instructing the computer to carry out a specific damaging instruction at some later time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c73625-827e-3ecd-8946-c325cdd6f6b8",
                                        "entry_id": "d4436bef-e09b-338a-8f1c-7647aea53914",
                                        "glosses": [
                                            "A seemingly favorable offer designed to trick customers into making exorbitant payments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd432f26-a84e-3caf-aa12-8e2f24988520",
                                        "entry_id": "d4436bef-e09b-338a-8f1c-7647aea53914",
                                        "glosses": [
                                            "A person, organization, social movement, piece of legislation, or ideology with a negative agenda or evil intentions under the guise of positive values or good intentions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe4af62-0f26-4358-9136-80c77962488d",
                                                "sense_id": "fd432f26-a84e-3caf-aa12-8e2f24988520",
                                                "text": "Russia thinks of an atomic authority as a Trojan horse to get behind the iron curtain and impair her defense, and there is some reason historically for this view."
                                            },
                                            {
                                                "example_id": "c48b520d-d7ac-422a-8679-700b433b305b",
                                                "sense_id": "fd432f26-a84e-3caf-aa12-8e2f24988520",
                                                "text": "Seen like this, huge western companies function like a Trojan horse when they are invited inside the boundaries of LDCs."
                                            },
                                            {
                                                "example_id": "0c27d451-9311-4435-b168-80d63281abd3",
                                                "sense_id": "fd432f26-a84e-3caf-aa12-8e2f24988520",
                                                "text": "Had the Israelis and the Americans realized that the Oslo accords were merely a “Trojan horse” designed to promote the higher goal of Palestine’s complete liberation, he argued, “they would never have opened their fortified gates and let it inside their walls.”"
                                            },
                                            {
                                                "example_id": "7f8bd42a-7e73-4f65-bea3-06396885120f",
                                                "sense_id": "fd432f26-a84e-3caf-aa12-8e2f24988520",
                                                "text": "Indeed, it may turn out to be a Trojan horse that finally allows conservative ideologues, who have unsuccessfully laid siege to Medicare since the days of Barry Goldwater, to breach its political defenses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Trojan horse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ab7cee0-0ed7-33d0-9da2-93e5b4996390",
                                        "entry_id": "7b73a4aa-4af7-3c58-8c82-64ff03350ec7",
                                        "glosses": [
                                            "Alternative form of Trojan-horse."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43088eee-91b5-451d-84a8-2d16db4f9e9b",
                                                "sense_id": "7ab7cee0-0ed7-33d0-9da2-93e5b4996390",
                                                "text": "You will disarm a group or person that holds simplistic attitudes—about relationships, education, financial success, morality, business ethics, religion, raising children—by giving that group or person Trojan Horsed instructions seemingly about how to do something mundane and unrelated."
                                            },
                                            {
                                                "example_id": "500f86a2-9618-40ec-94ad-82d5a2719e6d",
                                                "sense_id": "7ab7cee0-0ed7-33d0-9da2-93e5b4996390",
                                                "text": "But still, despite my initial shock at being expected to do a grownup job for my new grown-up salary, I was determined to keep the dream alive to some extent, by ticking a few of the sensible boxes while Trojan Horsing (yes, as a verb) some dot com fun in the back […]"
                                            },
                                            {
                                                "example_id": "dddd6012-0d58-4e31-9e08-74f34451d44c",
                                                "sense_id": "7ab7cee0-0ed7-33d0-9da2-93e5b4996390",
                                                "text": "In its place arose a bilateral treaty that spelled out in basic terms that advances made in freedom of movement would be kept, under safeguards; free trade would be advanced bilaterally; goods imported from third countries would not be Trojan horsed; and countries would cooperate in areas of common interest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
