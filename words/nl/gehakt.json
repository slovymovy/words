                    "examples": [
                        {
                            "text": "We eten vanavond spaghetti met tomatensaus en <w>gehakt</w>.",
                            "target_lang_translations": {
                                "en": "We are having spaghetti with tomato sauce and <w>minced meat</w> tonight.",
                                "ru": "Сегодня вечером мы едим спагетти с томатным соусом и <w>фаршем</w>.",
                                "pl": "Dziś wieczorem jemy spaghetti z sosem pomidorowym i <w>mięsem mielonym</w>.",
                                "de": "Heute Abend essen wir Spaghetti mit Tomatensauce und <w>Hackfleisch</w>.",
                                "fr": "Ce soir, nous mangeons des spaghettis à la sauce tomate et à la <w>viande hachée</w>.",
                                "it": "Stasera mangiamo spaghetti con salsa di pomodoro e <w>carne macinata</w>.",
                                "cs": "Dnes večer máme špagety s rajčatovou omáčkou a <w>mletým masem</w>.",
                                "tr": "Bu akşam domates soslu ve <w>kıymalı</w> spagetti yiyoruz.",
                                "es": "Esta noche cenamos espaguetis con salsa de tomate y <w>carne picada</w>."
                            }
                        },
                        {
                            "text": "Je moet het <w>gehakt</w> goed kruiden voordat je er ballen van draait.",
                            "target_lang_translations": {
                                "en": "You must season the <w>minced meat</w> well before rolling it into balls.",
                                "ru": "Нужно хорошо приправить <w>фарш</w>, прежде чем катать из него шарики.",
                                "pl": "Musisz dobrze przyprawić <w>mięso mielone</w>, zanim uformujesz z niego pulpety.",
                                "de": "Du musst das <w>Hackfleisch</w> gut würzen, bevor du Frikadellen daraus formst.",
                                "fr": "Il faut bien assaisonner la <w>viande hachée</w> avant d'en faire des boulettes.",
                                "it": "Devi condire bene il <w>macinato</w> prima di farne delle polpette.",
                                "cs": "Před tvarováním kuliček musíte <w>mleté maso</w> dobře okořenit.",
                                "tr": "Köfte yapmadan önce <w>kıymayı</w> iyice baharatlamalısın.",
                                "es": "Debes sazonar bien la <w>carne picada</w> antes de hacer albóndigas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "half-om-half gehakt",
