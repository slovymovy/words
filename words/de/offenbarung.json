                    "frequency": "Middle",
                    "semantic_group_id": "enthuellung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die plötzliche <w>Offenbarung</w> der Wahrheit überraschte alle Anwesenden bei der gestrigen Konferenz."
                        },
                        {
                            "text": "Die <w>Offenbarung</w> seiner finanziellen Probleme führte zu großen Diskussionen in der Familie."
                        }
                    ],
                    "common_phrases": [
                        "die Offenbarung der Tatsachen",
                        "die Offenbarung eines Geheimnisses"
                    ]
                },
