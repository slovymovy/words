                                "target_senses": [
                                    {
                                        "sense_id": "1959311c-44db-34b5-baff-ad3cb9bb4167",
                                        "entry_id": "c054db60-1b1d-37eb-b0a7-2859469418e5",
                                        "glosses": [
                                            "Tür, die sich an einem Tresor befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aabcb757-2fed-4da8-b4ef-223f8750032c",
                                                "sense_id": "1959311c-44db-34b5-baff-ad3cb9bb4167",
                                                "text": "„Wenn Panzerknacker einen Banksafe ausgeräumt haben, finden die Bankangestellten die Tresortür am Morgen danach meist weit offen.“"
                                            },
                                            {
                                                "example_id": "9d1cfbf5-16c4-411b-a687-b5e2ea878bb7",
                                                "sense_id": "1959311c-44db-34b5-baff-ad3cb9bb4167",
                                                "text": "„Am Fuß der Wendeltreppe, die jenseits der Schalterhalle ins Tiefgeschoss führt, wartet tief unter Genf eine zimmerhohe rotlackierte Tresortür - rund dreißig Zentimeter dick, mit Zahlencode, zwei Schlüsseln und einem Drehkreuz zu öffnen.“"
                                            },
                                            {
                                                "example_id": "ba312bea-1653-488a-83fe-c14eb9c98574",
                                                "sense_id": "1959311c-44db-34b5-baff-ad3cb9bb4167",
                                                "text": "„Hoteldirektor Thomas Schmid kann nur noch die einstige Windfahne, ein paar Wappenscheiben und, kurioserweise, eine Tresortür vorweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
