                "senses": [
                    {
                        "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                        "entry_id": "09606710-3346-354a-8175-ab005ac2d484",
                        "glosses": [
                            "Produktion des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb3ce98-e84d-46e5-b86b-6f1e7331e3ba",
                                "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                                "text": "„Melatonin ist ein starker Freier-Radikale-Fänger, reguliert die Melaninbildung in RPE und Chorioidea.“"
                            },
                            {
                                "example_id": "fcb58ba5-50d2-46c4-9239-d60546e03662",
                                "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                                "text": "„Eine verstärkte Produktion von hypophysärem Melanozyten-stimulierendem Hormon (MSH) führt zu vermehrter Melaninbildung und -ablagerung in der Haut.“"
                            },
                            {
                                "example_id": "8ebac19f-bc3b-4914-9e01-58a6dddc7f61",
                                "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                                "text": "„Fehlende Melanozyten oder eine gestörte Melaninbildung können zu einem punktuellen (Vitiligo) oder einem generalisierten Melaninverlust (Albinismus) führen.“"
                            },
                            {
                                "example_id": "b68c2308-1de5-4ae7-9049-85bc48abc900",
                                "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                                "text": "„Vom Dihydroxyphenylalanin geht auch die Melaninbildung in der Haut aus.“"
                            },
                            {
                                "example_id": "2e3851f2-66ae-4e26-81d5-3d686a891934",
                                "sense_id": "6b456bce-cb3f-3086-a871-b07cc0df1298",
                                "text": "„Dafür geben die Untersuchungen von Danneel über die Melaninbildung im Haar verschiedener Kaninchenrassen ein Beispiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
