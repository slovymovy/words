                "senses": [
                    {
                        "sense_id": "8407fd18-5dfc-35c7-a516-ef6efa6a1d00",
                        "entry_id": "c4ee2cbd-e149-3b42-87a6-02f34067af81",
                        "glosses": [
                            "книжн. связанный, соотносящийся по значению с существительным оргия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0cb5a41-803c-4454-b7a5-fb91ba8a34a9",
                                "sense_id": "8407fd18-5dfc-35c7-a516-ef6efa6a1d00",
                                "text": "... в душе его господствовали страх, ненависть, слепое поклонение и оргиастический восторг."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad7a9b9d-977f-45be-b112-34b115af5bc2",
                        "source_entry_id": "c4ee2cbd-e149-3b42-87a6-02f34067af81",
                        "source_sense_id": "8407fd18-5dfc-35c7-a516-ef6efa6a1d00",
                        "target_lang_word": "orgiastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgiastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                        "entry_id": "693b57ed-e871-3625-8dda-65d06e43ccca",
                                        "glosses": [
                                            "Relating to an orgy; uncontrolled, wild."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b160914-1a08-426b-b7de-1c70f36d912d",
                                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                                "text": "1919, Sax Rohmer, Dope\nDancing was in progress, or, rather, one of those orgiastic ceremonies which passed for dancing during this pagan period."
                                            },
                                            {
                                                "example_id": "4e0cc8a7-0733-466d-be5f-6ee96316d201",
                                                "sense_id": "6bdcf455-347b-38e3-a41a-a29a4b1d3d23",
                                                "text": "Gatsby believed in the green light, the orgiastic future that year by year recedes before us. It eluded us then, but that's no matter—tomorrow we will run faster, stretch out our arms farther … And one fine morning—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
