                "senses": [
                    {
                        "sense_id": "7cef50dd-fc15-3c98-93bd-26b51fff154c",
                        "entry_id": "9ae60b2a-4e28-358c-b8dc-017b1ae3c065",
                        "glosses": [
                            "bindegewebige Umhüllung von Muskeln und Muskelgruppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b15669-3479-4b73-b812-9d9e03d478eb",
                                "sense_id": "7cef50dd-fc15-3c98-93bd-26b51fff154c",
                                "text": "„Und mit ihren Händen, manchmal auch mit den Ellenbogen, widmet sie sich nach einer ausführlichen Körperbegutachtung dann den Faszien.“"
                            },
                            {
                                "example_id": "38a38f44-644e-4679-8ef6-66a0e4af194c",
                                "sense_id": "7cef50dd-fc15-3c98-93bd-26b51fff154c",
                                "text": "„Wie umfassende Untersuchungen am linken Unterschenkel ergaben, werden die Wadenschmerzen des 31-Jährigen von einem Einriss in der Faszie, der Bindegewebshülle des Wadenmuskels, hervorgerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
