                        "source_sense_id": "faeb3d2c-8b25-3e38-a311-ba5ba628ebfb",
                        "source_sense_description": "person or thing neither highbrow or lowbrow",
                        "target_lang_word": "Durchschnittsmensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchschnittsmensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                                        "entry_id": "abf98652-f7ad-35da-9845-555a188c5ee9",
                                        "glosses": [
                                            "durchschnittlicher Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb70ad02-d0c9-457f-8983-7356c72d7936",
                                                "sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                                                "text": "„Jedoch: ›Normale‹ Menschen gibt es für die Österreichische Schule nicht, den Durchschnittsmenschen hält sie für eine gefährliche Einbildung; jeder Mensch ist einzigartig.“"
                                            },
                                            {
                                                "example_id": "5a62ff34-9289-4125-ba8a-1fd9eec4f145",
                                                "sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                                                "text": "„Welcher Durchschnittsmensch begeht keine Fehler?“"
                                            },
                                            {
                                                "example_id": "de3d675f-7dcc-4f39-9294-19cf75d7a62d",
                                                "sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                                                "text": "„Er packt die flüchtige Wahrheit, die festzuhalten der Durchschnittsmensch zu talentlos oder zu feige ist.“"
                                            },
                                            {
                                                "example_id": "8875a7c8-37be-4769-bda0-6b5b7c4cb20f",
                                                "sense_id": "e387c0ce-c1b9-3462-987e-0dfac908a31d",
                                                "text": "„Und hier wird sie von Redakteuren gelobt, die keine Durchschnittsmenschen sind, wie dir bekannt sein sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
