                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trompeterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c1d7ca7-0279-3549-9f42-af333b289c2c",
                                        "entry_id": "8e7fafd2-03bb-3589-b477-ff1f32efb3f2",
                                        "glosses": [
                                            "weibliche Person, die Trompete spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a1ee41-bb73-4587-9299-3f9ec6a342d7",
                                                "sense_id": "6c1d7ca7-0279-3549-9f42-af333b289c2c",
                                                "text": "Eine Trompeterin wird noch dringend gesucht."
                                            },
                                            {
                                                "example_id": "be3628df-15e8-4b84-a34c-75e2121c1f79",
                                                "sense_id": "6c1d7ca7-0279-3549-9f42-af333b289c2c",
                                                "text": "„Das Kammerorchester Basel und die Trompeterin Alison Balsom haben einen fulminanten Auftritt in der Zürcher Tonhalle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
