                    {
                        "sense_id": "9575f778-b00a-33ca-bd04-8c97a2cc7cad",
                        "entry_id": "2158c40f-9a99-304d-8ca9-395bef667cfb",
                        "glosses": [
                            "divination by means of animals"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe6f6d9a-0973-419b-b19e-3ddad7040a29",
                                "sense_id": "9575f778-b00a-33ca-bd04-8c97a2cc7cad",
                                "text": "Yet why should so many generations have believed in divination by birds, and even in zoomancy, said by Suidas to have been imparted by Orpheus, who taught how to perceive in the yoke and white of the egg, under certain conditions, that which the bird born from it would have seen around it during its short life."
                            },
                            {
                                "example_id": "3b7afacc-4373-42c2-9a0f-f114a3f2e474",
                                "sense_id": "9575f778-b00a-33ca-bd04-8c97a2cc7cad",
                                "text": "The speech takes the form of a zoomancy, with no act of zoomancy in evidence."
                            },
                            {
                                "example_id": "c5153a7f-d2df-4a8d-8c01-22d5fc4e6d66",
                                "sense_id": "9575f778-b00a-33ca-bd04-8c97a2cc7cad",
                                "text": "[…] these are mainly writings of a technical nature: scribes' registers on ritual divination by turtle and milfoil, calendars, manuals of hemerology, astrology, meteoromancy and Yijing divination, treatises on medicine, macrobiotics, and zoomancy."
                            }
                        ]
                    }
