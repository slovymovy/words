                "senses": [
                    {
                        "sense_id": "5dbda95e-33a7-3855-b6bb-c1c6d6850bd1",
                        "entry_id": "f84a9e70-7a5d-3b35-af38-8d012c825acd",
                        "glosses": [
                            "rotierendes Teil zur Lagerung und Kraftübertragung des Transmissionsriemens in Transmissionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605405ea-20a0-44c4-8bdc-e7eddb7eacbd",
                                "sense_id": "5dbda95e-33a7-3855-b6bb-c1c6d6850bd1",
                                "text": "„Der Durchmesser der Transmissionsscheibe (= des Getriebenen) beträgt 320 mm.“"
                            },
                            {
                                "example_id": "ca2f2397-909d-4767-88b2-cde35e9d8081",
                                "sense_id": "5dbda95e-33a7-3855-b6bb-c1c6d6850bd1",
                                "text": "„Das Unternehmen dehnte die Produktion schon vor und während des 1. Weltkrieges durch die Übernahme weiterer Firmen in Bocholt auf gußeiserne Transmissionsscheiben und sonstige Teile des Transmissionsbaus, wie Spannrollen und Kupplungen, aus.“"
                            },
                            {
                                "example_id": "1bfb445a-9b9b-464c-b724-139d4af580c0",
                                "sense_id": "5dbda95e-33a7-3855-b6bb-c1c6d6850bd1",
                                "text": "„Die Antriebsscheiben haben abwechselnd eine oder zwei Rillen, das Schwungrad deren sieben, von welchen aus sieben zweirillige Transmissionsscheiben durch Hanfseile angetrieben werden, die nach rechts und links in den Transmissionsgang auslaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
