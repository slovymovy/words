                            {
                                "example_id": "21d00d96-61b6-4372-9deb-dc05c1852e11",
                                "sense_id": "5b57d739-4f0d-3dd1-a2a3-9e6338358d05",
                                "text": "Дорога шла под изволок."
                            },
                            {
                                "example_id": "8312c151-da07-4cf9-97aa-eef1944ac791",
                                "sense_id": "5b57d739-4f0d-3dd1-a2a3-9e6338358d05",
                                "text": "Это было моё любимое поле. Оно клином подходило к селу, убегая вёрст за семь, взбиралось на изволок к старому синему лесу."
                            }
                        ]
