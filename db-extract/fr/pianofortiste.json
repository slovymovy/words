                        "glosses": [
                            "Celui, celle qui joue du pianoforte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a6a5fe-8b4f-49a4-b5f0-fa35733bef86",
                                "sense_id": "8d23d6d9-56aa-3f33-a171-0798e8532c01",
                                "text": "Le jeune pianofortiste de 32 ans a construit son programme à partir des préludes composés lors du séjour de Chopin, avec George Sand, sur l’île de Majorque, à l’hiver 1838-1839."
                            },
                            {
                                "example_id": "4dad64bc-1028-4c02-99b9-0caf0ba35801",
                                "sense_id": "8d23d6d9-56aa-3f33-a171-0798e8532c01",
                                "text": "Cette excellente claveciniste et pianofortiste, peu connue ici, s’adresse à tous ceux qui, nostalgiques de l’intégrale Leonhardt-Harnoncourt, recherchent un son de clavecin très clair et pas trop enjolivé ou nourri."
                            },
                            {
                                "example_id": "ca3d8f29-1ccb-42d1-becc-e91e9a7ca7ac",
                                "sense_id": "8d23d6d9-56aa-3f33-a171-0798e8532c01",
                                "text": "De ce point de vue, dimanche après-midi, le pianofortiste Tom Beghin placera dans une perspective différente les Sonates Pathétique, Clair de lune et “La Tempête”, de Beethoven, à la salle Ville-Marie du marché Bonsecours."
                            }
                        ]
                    }
