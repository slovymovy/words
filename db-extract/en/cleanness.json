                                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                                "text": "Соблюдать чистоту."
                                            },
                                            {
                                                "example_id": "40bc54e3-1d7d-486e-aaca-db5e8987b48d",
                                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                                "text": "Нравственная чистота."
                                            },
                                            {
                                                "example_id": "64d44bf5-5e00-4afe-ab42-a443807580f5",
                                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                                "text": "Укромный домик твой не златом — чистотой и светлостью пленяет."
                                            },
                                            {
                                                "example_id": "ad025588-b0f9-4203-b42e-cfc7820eb790",
                                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                                "text": "Сознательно мирские наслажденья ты отвергал; ты чистоту хранил."
                                            }
                                        ]
