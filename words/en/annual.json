                        "tr": [
                            {
                                "target_lang_word": "yıllık",
                                "target_lang_sense_clarification": "yılda bir çıkarılan yayın, almanak"
                            },
                            {
                                "target_lang_word": "almanak",
                                "target_lang_sense_clarification": "yıllık dergi veya kitap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6152b21-8f0a-36e7-ac36-0e29ce51fac6",
                    "sense_definition": "A plant that lives for only one growing season.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology_lifespan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardeners often plant <w>annuals</w> to add bright colors for the summer.",
                            "target_lang_translations": {
                                "ru": "Садоводы часто сажают <w>однолетники</w>, чтобы добавить ярких красок на лето.",
                                "tr": "Bahçıvanlar yaza canlı renkler katmak için genellikle <w>tek yıllık bitkiler</w> dikerler."
                            }
                        },
                        {
                            "text": "Unlike perennials, <w>annuals</w> need to be sown from seed every year.",
                            "target_lang_translations": {
                                "ru": "В отличие от многолетников, <w>однолетники</w> нужно высеивать из семян каждый год.",
                                "tr": "Çok yıllıkların aksine, <w>tek yıllık bitkilerin</w> her yıl tohumdan ekilmesi gerekir."
                            }
                        }
                    ],
                    "antonyms": [
                        "perennial"
                    ],
                    "common_phrases": [
                        "hardy annuals",
                        "summer annuals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение, живущее только один вегетационный период.",
                        "tr": "Sadece bir büyüme mevsimi yaşayan bitki."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одноле́тник",
                                "target_lang_sense_clarification": "растение"
                            },
                            {
                                "target_lang_word": "одноле́тнее расте́ние",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tek yıllık bitki",
                                "target_lang_sense_clarification": "bir mevsimlik ömrü olan bitki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "029ef553-15ba-3cee-9a98-a30e880a71cd",
                    "sense_definition": "A medical checkup taking place once a year.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor scheduled my <w>annual</w> for next Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "Врач назначил мой <w>ежегодный осмотр</w> на утро следующего вторника.",
                                "tr": "Doktor <w>yıllık muayenemi</w> önümüzdeki salı sabahına ayarladı."
                            }
                        },
                        {
                            "text": "Most insurance plans cover routine <w>annuals</w> without extra cost.",
                            "target_lang_translations": {
                                "ru": "Большинство страховых планов покрывают плановые <w>ежегодные осмотры</w> без дополнительной платы.",
                                "tr": "Sigorta planlarının çoğu rutin <w>yıllık kontrolleri</w> ek ücret almadan kapsar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for 'annual checkup'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский осмотр, проходящий раз в год.",
                        "tr": "Yılda bir kez yapılan tıbbi muayene."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежего́дный осмо́тр",
                                "target_lang_sense_clarification": "медицинское обследование"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yıllık muayene",
                                "target_lang_sense_clarification": "yılda bir yapılan doktor kontrolü"
                            },
                            {
                                "target_lang_word": "yıllık kontrol",
                                "target_lang_sense_clarification": "rutin sağlık kontrolü"
                            }
                        ]
