                    {
                        "translation_id": "a318c3c1-749a-4e09-ba56-96fcebb2d878",
                        "source_entry_id": "ec2be7ca-e075-3e90-85ca-be31f8801274",
                        "source_sense_id": "b80f01c9-0acc-333d-becd-539efd2f3a76",
                        "source_sense_description": "member or follower of the Neogrammarian school",
                        "target_lang_word": "néogrammairien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néogrammairien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f454e2-0438-382d-9dd6-e2ce259ee630",
                                        "entry_id": "d946cf9a-6b1f-3d4a-af18-5fc60137c216",
                                        "glosses": [
                                            "Relatif à l’école linguistique, née à l’université de Leipzig, à la fin du XIXᵉ siècle, au sujet de l’évolution phonétique des langues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32eb773-c233-44e4-ac98-6cda42df0e0a",
                                                "sense_id": "f0f454e2-0438-382d-9dd6-e2ce259ee630",
                                                "text": "Le structuralisme […] s'est largement construit par la critique de leur méthode entreprise par Ferdinand de Saussure, lui-même de formation néogrammairienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "néogrammairien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a93c75bf-857e-3f76-a9d6-3dbc6048c736",
                                        "entry_id": "dd9a47b3-7f3e-3dfa-b961-fc1e616acde4",
                                        "glosses": [
                                            "Membre de cette école."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28330f77-0c8b-4d90-9923-319f3e9c1771",
                                                "sense_id": "a93c75bf-857e-3f76-a9d6-3dbc6048c736",
                                                "text": "Les néogrammariens ont érigé la régularité des lois phonétiques en axiome de la linguistique comparée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e7700f7-0fe5-496b-b961-8d5e045911ce",
                        "source_entry_id": "ec2be7ca-e075-3e90-85ca-be31f8801274",
                        "source_sense_id": "b80f01c9-0acc-333d-becd-539efd2f3a76",
                        "source_sense_description": "member or follower of the Neogrammarian school",
                        "target_lang_word": "Junggrammatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Junggrammatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                        "entry_id": "61174a68-768d-3067-804e-a6fdb8c5bbde",
                                        "glosses": [
                                            "eine Gruppe von Linguisten des ausgehenden 19. und beginnenden 20. Jahrhunderts, die vornehmlich sprachhistorisch ausgerichtet waren und Sprachwandel durch Analogie, Entlehnung und vor allem Lautgesetz erklärten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a548e9-7155-4442-a724-41be2fb3dae0",
                                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                                "text": "Für die Junggrammatiker war Sprachwissenschaft nur als historische Wissenschaft möglich."
                                            },
                                            {
                                                "example_id": "913f7fb5-d15c-460d-9ed1-55dcd25a97fe",
                                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                                "text": "„Die Verdienste der Junggrammatiker bestehen 1) in der strengeren Fassung und Vollendung der Methoden der Komparatistik und ihrer erfolgreichen Anwendung…“"
                                            },
                                            {
                                                "example_id": "17e59680-f618-47c6-8998-c234a7467ab8",
                                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                                "text": "„Unzweifelhaft haben die Methodologien und Analyseverfahren der Junggrammatiker nachhaltigen Einfluß auf spätere Entwicklungen der Sprachwissenschaft gehabt.“"
                                            },
                                            {
                                                "example_id": "2cb75327-c852-4adc-864c-4a45c5c34d5e",
                                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                                "text": "„Die Junggrammatiker ließen somit den Sprachwandel von zwei Kräften beherrscht werden, den mit Naturnotwendigkeit herrschenden Lautgesetzen und der durchkreuzend von der Seele her eingreifenden Analogie, die freilich nur auftreten konnte, nicht mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
