                    },
                    {
                        "translation_id": "6c5f1100-b2ce-4280-b353-6395bf3906b4",
                        "source_entry_id": "265fbd92-89c4-3862-9328-bd51270d17e0",
                        "source_sense_id": "b792d5aa-60c9-372f-bf1a-8769205ca8c9",
                        "target_lang_word": "versengen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versengen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9cab21-eb53-3a08-9742-5b7a543e41ad",
                                        "entry_id": "a3b17122-2fd8-37bc-b898-2fc0d2d8126f",
                                        "glosses": [
                                            "durch Hitze oberflächlich beschädigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b97652c-5029-4881-997a-88482cf11426",
                                                "sense_id": "cd9cab21-eb53-3a08-9742-5b7a543e41ad",
                                                "text": "Irgendwer hat mir meine Jacke versengt."
                                            },
                                            {
                                                "example_id": "f023ddd4-d711-457a-9659-a83019dec07f",
                                                "sense_id": "cd9cab21-eb53-3a08-9742-5b7a543e41ad",
                                                "text": "In wenigen Stunden versengten die Flammen über 4000 Hektar Land."
                                            },
                                            {
                                                "example_id": "f0355989-9764-4adb-aeae-b40583810f07",
                                                "sense_id": "cd9cab21-eb53-3a08-9742-5b7a543e41ad",
                                                "text": "Die Flammen versengten die Haare an seinen Beinen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38caf198-72b9-461e-b3a1-6c23d9dfcfc0",
                        "source_entry_id": "265fbd92-89c4-3862-9328-bd51270d17e0",
                        "source_sense_id": "b792d5aa-60c9-372f-bf1a-8769205ca8c9",
                        "target_lang_word": "roussir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roussir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09e1140e-78ea-3d40-a64a-703ce81581ae",
                                        "entry_id": "7006fb22-9a83-3d54-9633-e47f9ee002fc",
                                        "glosses": [
                                            "Rendre roux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7edaf1-8b94-49a6-af1c-1d39363581a8",
                                                "sense_id": "09e1140e-78ea-3d40-a64a-703ce81581ae",
                                                "text": "Et de son côté, le récent hiver a roussi les oliviers, dépenaillé les grands mimosas, pareils à des mâts dont les haubans sont coupés, et où pendent des paquets de vieilles voilures déralinguées."
                                            },
                                            {
                                                "example_id": "f654ded6-fa93-4adc-998d-fc4450c8ae4c",
                                                "sense_id": "09e1140e-78ea-3d40-a64a-703ce81581ae",
                                                "text": "La sécheuse idéale doit aussi être sûre pour tous les tissus, sans risque de brûlure, certaines sécheuses roussissent le linge ou l'exposent aux éléments chauffants."
                                            },
                                            {
                                                "example_id": "b59cdc13-66fa-4003-bcd6-9c88b13f1597",
                                                "sense_id": "09e1140e-78ea-3d40-a64a-703ce81581ae",
                                                "text": "Le fer chaud a fait roussir ce linge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1502729a-f2d0-3e6b-b674-5eccff8505d8",
                                        "entry_id": "7006fb22-9a83-3d54-9633-e47f9ee002fc",
                                        "glosses": [
                                            "Devenir roux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92483b04-f8f1-4c1a-8df5-3beaaba0da82",
                                                "sense_id": "1502729a-f2d0-3e6b-b674-5eccff8505d8",
                                                "text": "Seuls, dans un des versants caillouteux de la forêt, deux ou trois vieux hêtres accusaient, par quelques feuilles roussies prématurément, l’arrivée prochaine de l’automne et la mort de l’été."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
