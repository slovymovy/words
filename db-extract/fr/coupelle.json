                                    {
                                        "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A trophy in the shape of an oversized cup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf336a4-56a9-4a59-9b03-bf7a8b253834",
                                                "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                                "text": "The World Cup is awarded to the winner of a quadrennial football tournament."
                                            },
                                            {
                                                "example_id": "6ba044ad-ec5f-4e6c-88d4-7bb6cec12c2e",
                                                "sense_id": "a07cdf83-a47c-381a-8535-12bf67896820",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf793de9-25c1-3a4a-a524-215e9b1c56bc",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A contest for which a cup is awarded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10252940-8ea0-4993-bfa5-3b1cd41fabb1",
                                                "sense_id": "bf793de9-25c1-3a4a-a524-215e9b1c56bc",
                                                "text": "The World Cup is the world's most widely watched sporting event."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "The main knockout tournament in a country, organised alongside the league."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c011e01-d12b-40d8-8bcc-aa566725449b",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "Until it was disbanded in 1999, the European Cup-Winners Cup was contested annually by the winners of Europe's national cups."
                                            },
                                            {
                                                "example_id": "991e1b11-01f9-4c6e-b449-28e0a6f6a48e",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "Wallace had the unique distinction of being the only player ever to play in the English, Welsh and Scottish Cups in the same season."
                                            },
                                            {
                                                "example_id": "697c5901-c66a-4f73-91bb-f8cbc835523b",
                                                "sense_id": "a4de537f-174a-35a7-ae77-26f603378f83",
                                                "text": "One week earlier, they had lost 5-2 to Borussia Dortmund in the DFB-Pokal [the German cup] final in Berlin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aaea091-79be-31bd-bf91-aff2bcc96318",
                                        "entry_id": "bb26a4e1-9dd6-3e64-b958-1c032bf37ae2",
                                        "glosses": [
                                            "A cup-shaped object placed in the target hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde526c8-1eba-4dd4-88e0-f42bac8418fc",
                                                "sense_id": "6aaea091-79be-31bd-bf91-aff2bcc96318",
                                                "text": "The ball just misses the cup."
                                            }
                                        ]
                                    },
