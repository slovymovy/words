                                        "sense_id": "840b05fe-dac8-3088-8384-d9ff57ba6030",
                                        "entry_id": "4f3bd415-6a7f-369d-88c0-44a44b2cc3ab",
                                        "glosses": [
                                            "A thin, fragile paper made from parts of the rice plant, used in artificial flowers and watercolour art."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c134401-249f-4eef-a72b-5eaa24df44bb",
                                                "sense_id": "840b05fe-dac8-3088-8384-d9ff57ba6030",
                                                "text": "I will scatter rice paper stars in your heaven\nIf there are no stars ...\nIf there are no stars ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a443df-8ece-3919-8548-52f446daf348",
                                        "entry_id": "4f3bd415-6a7f-369d-88c0-44a44b2cc3ab",
                                        "glosses": [
                                            "Any similar paper made from a plant other than rice, such as bamboo or mulberry."
                                        ],
