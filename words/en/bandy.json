            "senses": [
                {
                    "sense_id": "6a10e800-36cb-3bae-894c-6ecb8439f262",
                    "sense_definition": "To mention, discuss, or pass around casually or without much care.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several names were <w>bandied</w> about as potential candidates for the open position.",
                            "target_lang_translations": {
                                "nl": "Er werden verschillende namen <w>rondgestrooid</w> als mogelijke kandidaten voor de vacature.",
                                "ru": "Несколько имён <w>мусолились</w> в качестве потенциальных кандидатов на открытую вакансию."
                            }
                        },
                        {
                            "text": "The media continues to <w>bandy</w> rumors about their secret marriage.",
                            "target_lang_translations": {
                                "nl": "De media blijven geruchten over hun geheime huwelijk <w>verspreiden</w>.",
                                "ru": "СМИ продолжают <w>распространять</w> слухи об их тайной свадьбе."
                            }
