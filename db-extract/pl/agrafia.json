                                        "sense_id": "6bfb04c5-53c3-3057-aaa0-6f09db33e502",
                                        "entry_id": "458e8965-075b-3cc2-94ec-13d30b6793f5",
                                        "glosses": [
                                            "Impossibilité d’écrire, constituant, avec l’aphasie, deux symptômes importants des maladies mentales, des apoplexies et du ramollissement cérébral ou des incapacités motrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97923ada-d6f9-4422-9f6c-117b3f0450e9",
                                                "sense_id": "6bfb04c5-53c3-3057-aaa0-6f09db33e502",
                                                "text": "Lorsqu'un écrivain « de sf » subit une crise d’agraphie non lésionnelle (parfois appelée flemmingite, mélancolie, coma éthylique, etc.) mais désire néanmoins assurer ses fins de mois — c'est-à-dire obtenir à peu près l'équivalent du S.M.I.C. — plusieurs possibilités s'offrent à lui."
                                            }
                                        ]
                                    }
