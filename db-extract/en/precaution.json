                                                "sense_id": "6929e4f7-80da-3def-a58f-66d2e37093aa",
                                                "text": "Die Vorsorge für das Pensionsalter bestand in Form eines Eigenheimes."
                                            },
                                            {
                                                "example_id": "62e8de0c-f6e1-4f84-ae71-89230e98d2c9",
                                                "sense_id": "6929e4f7-80da-3def-a58f-66d2e37093aa",
                                                "text": "Falls es an meinem Geburtstag regnen sollte, habe ich Vorsorge getroffen."
                                            },
                                            {
                                                "example_id": "e3437639-153a-4521-b138-ba9f5c88b7fa",
                                                "sense_id": "6929e4f7-80da-3def-a58f-66d2e37093aa",
                                                "text": "„Ich entdeckte nämlich ein Mittel gegen Leichtfertigkeit, und zwar die Vorsorge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
