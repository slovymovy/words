                        "glosses": [
                            "raues, pelziges Mundgefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d080448c-5c7a-4107-985b-67d9be5b70a1",
                                "sense_id": "65142e27-f5c0-31e9-8003-4b5699fad09b",
                                "text": "„Eine pelzige oder raue Note von Trockenheit wird als Adstringenz bezeichnet und ist auf die Tannine - also die Gerbstoffe - im Wein zurückzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
