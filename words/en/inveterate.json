                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was an <w>inveterate</w> gambler who could never walk past a casino without going inside."
                        },
                        {
                            "text": "As an <w>inveterate</w> smoker, she found it nearly impossible to quit despite her doctor's warnings."
                        }
                    ],
                    "synonyms": [
