                        "examples": [
                            {
                                "example_id": "37f7dc55-1dac-42df-95f0-249f89adee57",
                                "sense_id": "20a31b55-17cb-3424-8b46-80876c0f8e3b",
                                "text": "De hutspot werd geserveerd met klapstuk."
                            },
                            {
                                "example_id": "4406c596-3a7d-4817-a2be-2f93b49d5fc5",
                                "sense_id": "20a31b55-17cb-3424-8b46-80876c0f8e3b",
                                "text": "Hoofdgerecht: malse hertenbiefstuk met lak van kruidnagel, wildragoutloempia, gesmoorde spruiten, spek, ui en hutspot."
                            }
                        ]
                    },
                    {
                        "sense_id": "24211238-c9b2-39df-ab85-b0bf1f05873f",
                        "entry_id": "15b77034-59ca-3c2e-842d-de1eb3d8290a",
                        "glosses": [
                            "het bij elkaar gooien van allerlei uiteenlopende zaken"
                        ],
