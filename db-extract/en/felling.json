            {
                "entry_id": "1edbbb56-0f88-37ef-8298-f0ac04ae759d",
                "word": "felling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b98d8db-9d1a-49c0-a085-3b6bd69816b4",
                        "entry_id": "1edbbb56-0f88-37ef-8298-f0ac04ae759d",
                        "tags": [
                            "plural"
                        ],
                        "form": "fellings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "978cd4a0-bf78-3705-9a6b-2b14a58afcd3",
                        "entry_id": "1edbbb56-0f88-37ef-8298-f0ac04ae759d",
                        "glosses": [
                            "The act by which something is felled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8c0553-b7d1-4511-938c-7485a9754302",
                                "sense_id": "978cd4a0-bf78-3705-9a6b-2b14a58afcd3",
                                "text": "One forest officer, stationed in the buffer of the Buxa Tiger Reserve, argued that 80% of the illegal fellings are carried out by forest villagers and that more or less all Rabhas are involved."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e5fb6ac-0eed-4e98-9a68-3029022db1d5",
                        "source_entry_id": "1edbbb56-0f88-37ef-8298-f0ac04ae759d",
                        "source_sense_id": "978cd4a0-bf78-3705-9a6b-2b14a58afcd3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Fällung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fällung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                                        "glosses": [
                                            "das Roden eines Baumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583dd275-f8bf-4537-9e1b-1041266b633d",
                                                "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                                                "text": "„Wenn der Eigentümer einen Antrag zur Fällung des Baumes eingereicht hat, hat der Baum anscheinend keinen Wert für ihn.“"
                                            },
                                            {
                                                "example_id": "f073f4a2-ab02-4006-abee-292333725b10",
                                                "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                                                "text": "„Die Stadt Dresden sagte die geplante Räumung und Fällung des Baumes aus Sicherheitsgründen ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                                        "glosses": [
                                            "verbindliche Festlegung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691d793a-85b1-4fc4-8fe8-a9a18ded7fb4",
                                                "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                                                "text": "„Nach Fällung der Entscheidungist Widerstand jedoch höchst destruktiv für das weitere Voranschreiten der Reorganisation.“"
                                            },
                                            {
                                                "example_id": "38d137ab-34df-4164-bd98-4222dd9d11ce",
                                                "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                                                "text": "„Vor Fällung des Urteils zeige der Beklagte seinen Ehefortsetzungswillen durch seine Zustimmung zur Klagszurücknahme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                                        "glosses": [
                                            "Ausscheiden eines gelösten Stoffes aus einer Lösung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74c299ce-a07a-4b5b-a94a-84d04f2b9ef1",
                                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                                "text": "„Die Fällung wird nun 2mal mit je 5 ccm 0,4%iger NaCl-Lösung gewaschen, die Waschflüssigkeit nach dem Zentrifugieren jedesmal sorgfältig abgegossen.“"
                                            },
                                            {
                                                "example_id": "0a4372ed-20cc-4fcc-b7af-43ba78f77a52",
                                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                                "text": "„Bei der Fällung werden ungelöste Wasserinhaltsstoffe mit Fällmitteln in unlösliche Fällprodukte überführt und anschließend über Sedimentation oder Filtration abgetrennt.“"
                                            },
                                            {
                                                "example_id": "00267f7e-cbe2-4ea0-ab0e-e2ecfc97891f",
                                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                                "text": "„Infolge der Hinzufügung des Antimonsalzes koagulierte die Fällung der Sulfide und konnte leicht durch Filtration abgetrennt werden; nachher wurde das Präzipitat gut mit destilliertem Wasser gewaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9794222b-b29b-4b88-b71b-fb2afee88951",
                        "source_entry_id": "1edbbb56-0f88-37ef-8298-f0ac04ae759d",
                        "source_sense_id": "978cd4a0-bf78-3705-9a6b-2b14a58afcd3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Einschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "das Eintreffen eines Blitzes, Geschosses oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093cca9a-0ec2-47f1-923d-f05522c4d859",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "Der Einschlag des Blitzes hinterließ ein gewaltiges Loch."
                                            },
                                            {
                                                "example_id": "9205da99-f6ed-4f94-8f8b-1aaa72b9911a",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Auf 700.000 Jahre nach dem Einschlag datieren die ältesten Belege für die nährstoffreiche Pflanzenfamilie der Hülsenfrüchtler.“"
                                            },
                                            {
                                                "example_id": "4a20f8ae-865f-4548-ba04-3f14455290fc",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Mein Vater hatte uns, schon bevor er 1941 zur Wehrmacht eingezogen wurde, mehrfach erklärt, dass die runde Form sicherer vor Einschlägen sei als ein eckiger Bau.“"
                                            },
                                            {
                                                "example_id": "ee820ec0-4cf9-45d6-86e4-712161f20ba4",
                                                "sense_id": "4ff388b9-bf3c-3ce2-9b4c-35c8d099b6ee",
                                                "text": "„Ich aber, ganz elend von dem Transitgeflüster, ich staunte sehr, wenn ich derer gedachte, die in den Flammen der Bombardements und in den rasenden Einschlägen des Blitzkrieges zugrunde gegangen waren, zu Tausenden, zu Hunderttausenden, und viele waren daselbst auch zur Welt gekommen, ganz ohne Kenntnis der Konsuln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cc4e816-46e5-3bb2-8b51-a5185e28b1e4",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Spur, die ein Schlag hinterlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9f05688-089c-4b17-9207-1d18a82ea9c1",
                                                "sense_id": "5cc4e816-46e5-3bb2-8b51-a5185e28b1e4",
                                                "text": "Den Einschlag der Granate sah man auch nach Jahren noch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "afa02551-4055-32b7-b01c-42056c7f270d",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Beimischung völkischer Eigenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120a51db-72b3-4b41-a6f8-e15b1bfe747a",
                                                "sense_id": "afa02551-4055-32b7-b01c-42056c7f270d",
                                                "text": "Der Einschlag des Mongolischen war in den Gesichtern leicht zu erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b1c121c1-43c4-3bf9-a119-e8318533cafd",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "planmäßige Baumfällung"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd24dc8e-614c-45b4-b17a-65361dc89473",
                                                "sense_id": "b1c121c1-43c4-3bf9-a119-e8318533cafd",
                                                "text": "Der Einschlag betraf vor allem windgeschädigte Bäume."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1e94aad5-91a3-3c81-a61e-3db6c28d3470",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Lenkung der Räder, Drehung am Lenkrad"
                                        ],
                                        "tags": [
                                            "Fahrzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095ff33a-6ff3-4ec0-81ee-dc32ccf3cf1c",
                                                "sense_id": "1e94aad5-91a3-3c81-a61e-3db6c28d3470",
                                                "text": "Der Einschlag der Räder war durch die Lenkradsperre begrenzt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7a3d5e47-297c-3569-9a98-c480cef79475",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Saum bei Kleidungsstücken"
                                        ],
                                        "tags": [
                                            "Schneiderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545ccd74-ce78-46aa-b37c-a628dc8367b6",
                                                "sense_id": "7a3d5e47-297c-3569-9a98-c480cef79475",
                                                "text": "Der Einschlag am Knopflochsaum war schlecht vernäht."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "276b3010-0194-3fdd-8500-8fe54b07ab4a",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "Abdeckung von Jungpflanzen mit Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dfa6654-7bde-4aa7-9b5d-c92f351627bd",
                                                "sense_id": "276b3010-0194-3fdd-8500-8fe54b07ab4a",
                                                "text": "Der Einschlag der Jungpflanzen wurde zusätzlich noch mit Gießwasser befeuchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "d9f75e39-1206-32a4-be55-7e5ece40c03b",
                                        "entry_id": "33c64650-646e-3ef2-aef4-83be5dbe8abc",
                                        "glosses": [
                                            "prozentuale Herabsetzung eines Werts"
                                        ],
                                        "tags": [
                                            "Steuerwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff6f06a7-671a-4403-b57a-ec656b9269e6",
                                                "sense_id": "d9f75e39-1206-32a4-be55-7e5ece40c03b",
                                                "text": "Bei der Bemessung des Einschlages sind im konkreten Einzelfall auch die Vermögensverhältnisse zu berücksichtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            },
