                    },
                    {
                        "form_id": "40ae254e-4d3d-4409-848d-c0a514990223",
                        "entry_id": "ccbad3fa-1767-3cd2-918d-321282721667",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "накупи́в"
                    },
                    {
                        "form_id": "d30340e2-26ea-47a5-942d-780419b6ef2b",
                        "entry_id": "ccbad3fa-1767-3cd2-918d-321282721667",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "накупи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "588bb33b-9616-3c37-90a9-80b9944ea2f7",
                        "entry_id": "ccbad3fa-1767-3cd2-918d-321282721667",
                        "glosses": [
                            "купить что-либо в каком-либо количестве (обычно большом)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7675e294-001f-41fa-bf00-d394cfc624b4",
                                "sense_id": "588bb33b-9616-3c37-90a9-80b9944ea2f7",
                                "text": "Мы накупили вина, фруктов, всяческих закусок и погрузили всё это в ялик. Сметанина везла деду в подарок его собственный портрет, Гарт — жестянку английского трубочного табака, Юнге — новый барометр, Зоя — семена разных цветов, Баранов — бутылку шампанского, а я — набор рыболовных крючков и шёлковые плетёные лески."
                            },
                            {
                                "example_id": "437fb947-0d73-4a93-9ab2-5f7bfcccb322",
                                "sense_id": "588bb33b-9616-3c37-90a9-80b9944ea2f7",
                                "text": "В течение марта 2018 года Россия накупила государственных облигаций США ещё на два с лишним миллиарда долларов, в общей сложности став обладательницей свыше девяноста шести миллиардов долларов в американских облигациях…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6df8e63-a048-4f65-bd4a-f121432008d9",
                        "source_entry_id": "ccbad3fa-1767-3cd2-918d-321282721667",
                        "source_sense_id": "588bb33b-9616-3c37-90a9-80b9944ea2f7",
                        "target_lang_word": "buy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "617d9290-2964-37c1-9a1a-ef079f9ca802",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "To obtain (something) in exchange for money or goods."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de258868-0e5a-4c48-bae1-c2b4485f1a25",
                                                "sense_id": "617d9290-2964-37c1-9a1a-ef079f9ca802",
                                                "text": "Who'd Father buy the car for? He boughtit for me, not for you."
                                            },
                                            {
                                                "example_id": "44eb38c4-9f05-410d-83fd-712d75cbc660",
                                                "sense_id": "617d9290-2964-37c1-9a1a-ef079f9ca802",
                                                "text": "Buy what thou hast no need of, and ere long thou wilt sell thy necessaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11934e6f-563a-3d1c-8797-49d265338301",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "To obtain, especially by some sacrifice."
                                        ],
                                        "tags": [
                                            "ditransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5454874-ffd0-42af-8207-d293d78eafa3",
                                                "sense_id": "11934e6f-563a-3d1c-8797-49d265338301",
                                                "text": "I've bought material comfort by foregoing my dreams."
                                            },
                                            {
                                                "example_id": "e9d4b51e-4ada-4244-9ef3-243daad3c5d8",
                                                "sense_id": "11934e6f-563a-3d1c-8797-49d265338301",
                                                "text": "You just bought yourself an assault charge!"
                                            },
                                            {
                                                "example_id": "82886aa8-e7fb-49d8-8a48-93fad99dd1b0",
                                                "sense_id": "11934e6f-563a-3d1c-8797-49d265338301",
                                                "text": "Buy the truth and sell it not; also wisdom, and instruction, and understanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79953462-e8cd-35df-85c8-94f5e4d5bedb",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "To suffer consequences for (something) through being deprived of something; to pay for (something one has done)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b6088b-4dce-41a1-a448-369f2bc8d5ef",
                                                "sense_id": "79953462-e8cd-35df-85c8-94f5e4d5bedb",
                                                "text": "VVhat villaine, doſt ſtrike me? I ſweare by the rood,\nAs I am Iacke Strawe, thou ſhalt buy it with thy blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "712cf850-7839-3ef0-9003-73e8ffba77f9",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "To bribe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16440713-0ef6-4a27-9767-8329d03d67cd",
                                                "sense_id": "712cf850-7839-3ef0-9003-73e8ffba77f9",
                                                "text": "He tried to buy me with gifts, but I wouldn't give up my beliefs."
                                            },
                                            {
                                                "example_id": "e10ed01c-91ed-43e6-9124-e3b00efbc204",
                                                "sense_id": "712cf850-7839-3ef0-9003-73e8ffba77f9",
                                                "text": "After Bongino reiterated that Epstein killed himself, he was flooded with responses of disbelief. \"WHO has bought the both of you?\" one X user asked of Bongino and Patel, referencing the Fox News interview."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cce88f48-c582-378a-80bb-76f3284b41c6",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "To be equivalent to in value."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e6cf55-2748-4c95-a40a-ecb9f3c8f429",
                                                "sense_id": "cce88f48-c582-378a-80bb-76f3284b41c6",
                                                "text": "The dollar doesn't buy as much as it used to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f4a668-a405-341c-96e7-20ff1319b02c",
                                        "entry_id": "efeaa632-b681-3efd-b39a-ef717d391b17",
                                        "glosses": [
                                            "to accept as true; to believe"
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e5c32d-7846-48a2-9876-39f5d33232e5",
                                                "sense_id": "20f4a668-a405-341c-96e7-20ff1319b02c",
                                                "text": "I'm not going to buy your stupid excuses anymore!"
                                            },
                                            {
                                                "example_id": "71352ebe-7205-477e-8e95-3444eba16a54",
                                                "sense_id": "20f4a668-a405-341c-96e7-20ff1319b02c",
                                                "text": "People like to say that dead people look asleep, and maybe she would have bought that under different circumstances."
