                        "glosses": [
                            "Petit dériveur en solitaire, conçu en 1947 pour l'usage des enfants (jusqu'à 15 ans), et généralement construit en fibre de verre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1376e146-a98d-49a8-8fef-dd79d3f02502",
                                "sense_id": "159b4083-4e5e-3327-b2c9-5a555268be81",
                                "text": "Cette régate s’est faite en équipage sur Optimist : « Le plus souvent avec un enfant à la barre et un adulte comme coéquipier qui essayait tant bien que mal de se trouver une place dans ce mythique bateau », s’amuse Fabrice Rousseau, directeur du CNBP."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "145d25d7-27e5-4925-bdd3-b2e6f79f93c3",
                        "source_entry_id": "9c3dfd3a-4a2f-35ab-9f58-517e132944fb",
