            {
                "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
                "word": "rep",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8dca2519-7599-4aa5-bdf1-696f503a67cb",
                        "entry_id": "70ce2c89-f669-34f6-8e04-09b23dd2cc38",
