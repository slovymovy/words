                "senses": [
                    {
                        "sense_id": "95f6a1c6-000a-3344-9c97-a5d1fe27a6d9",
                        "entry_id": "3d4fbf04-745f-3d27-b21e-ceac97c82b93",
                        "glosses": [
                            "Kontrolle/Lektüre eines Druckwerks/von Gedrucktem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adac7827-6762-4a35-abb2-9f20e941c004",
                                "sense_id": "95f6a1c6-000a-3344-9c97-a5d1fe27a6d9",
                                "text": "„Er bedankt sich bei seiner Lebensgefährtin Annette Wolpert für die Durchsicht des Manuskripts, die Begleitung unterwegs und die Motivation zum Arbeiten.“"
                            },
                            {
                                "example_id": "bb8bb3c8-99d2-4cf0-ae3e-4052ac02daa3",
                                "sense_id": "95f6a1c6-000a-3344-9c97-a5d1fe27a6d9",
                                "text": "„Obwohl regelmäßig Subskriptionen und Anzahlungen von gespannten Lesern eingingen, war Sylvia ständig knapp bei Kasse, zumal die Druckkosten mit jeder neuen Durchsicht von Joyce stiegen.“"
                            }
                        ],
