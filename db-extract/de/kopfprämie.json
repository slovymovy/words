                "senses": [
                    {
                        "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                        "entry_id": "03dcd860-57b7-3254-b456-31156fc5099a",
                        "glosses": [
                            "Geldbetrag, der für die Festnahme eines Gesuchten gezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c920456-a6e1-4f8b-b888-c5e3d21ae356",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Und wie andere Firmen auch zahlt Rücker seinen Mitarbeitern eine Kopfprämie: Wer einen Ingenieur wirbt, erhält 1000 Euro.“"
                            },
                            {
                                "example_id": "065e70cd-bb9c-4f5b-a558-1d2f25f26758",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Statt eines prozentualen Anteils am Lohn soll 2013 jeder Versicherte eine einheitliche Prämie (‚Kopfprämie‘) zahlen, die Sekretärin also genausoviel wie ihr Chef.“"
                            },
                            {
                                "example_id": "205363d5-985f-4b19-95c9-43fd1e18cfad",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Die Kopfprämie gehöre nicht in eine christlich-demokratische Sozialpolitik.“"
                            },
                            {
                                "example_id": "3ee77b66-6ff3-42cd-869b-bb4263deafea",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Der frühere Bundessozialminister Norbert Blüm hatte die vorgesehene einkommensunabhängige Kopfprämie in der Krankenversicherung als ‚sozialistisches Nivellierungsinstrument‘ bezeichnet und erklärt, die Partei, die dies vorschlage, sei nicht mehr seine CDU.“"
                            },
                            {
                                "example_id": "2b6f5fcd-07c8-40b6-aaa7-673b364da52f",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Die Schweiz ist vielmehr das einzige Land, das bei einer obligatorischen Krankenversicherung den Beitrag nicht nach dem Einkommen bemißt, sondern eine Pauschale (Kopfprämie) erhebt.“"
                            },
                            {
                                "example_id": "4d113d26-59cb-4b56-a083-8076dd0d36b1",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Doch zeigt sich Merkel da, wo der Leitantrag konkret wird, weniger konfliktfreudig als bei der gesundheitspolitischen Kopfprämie.“"
                            },
                            {
                                "example_id": "02bd2086-9126-441a-b130-9a3a53742648",
                                "sense_id": "c858ba4b-c545-3966-b55a-853ecf555aef",
                                "text": "„Die Kopfprämie im Gesundheitswesen eröffnet mehr Perspektiven als eine wettbewerbliche Kostenkontrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
