            {
                "entry_id": "a22e6e24-5542-336b-a9b7-fb3433b1d2ce",
                "word": "cynégétique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32dc92d7-322b-4902-9af8-97b34c4a7cda",
                        "entry_id": "a22e6e24-5542-336b-a9b7-fb3433b1d2ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "cynégétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ec1fee9-2909-3ef4-8ca9-4ef995662727",
                        "entry_id": "a22e6e24-5542-336b-a9b7-fb3433b1d2ce",
                        "glosses": [
                            "Art de la chasse ; art de chasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0ac6d81-8c2d-47be-92a4-327635ceccf0",
                                "sense_id": "8ec1fee9-2909-3ef4-8ca9-4ef995662727",
                                "text": "Dans la 3ᵉ Néméenne, il évoque la rapidité d'Achille à la chasse, sans toutefois attribuer expressément à Chiron l'enseignement de la cynégétique comme le fait le pseudo-Xénophon, […]."
                            },
                            {
                                "example_id": "34f2d6f4-b949-4eeb-8957-9d55c104f776",
                                "sense_id": "8ec1fee9-2909-3ef4-8ca9-4ef995662727",
                                "text": "Dans un pays et à une époque de bouleversemens universels, à côté des dynasties croulantes et des doctrines sociales chaque jour ébranlées , la cynégétique elle seule a gardé ses anciennes formules , ses mœurs, ses costumes, […]."
                            }
                        ]
                    }
