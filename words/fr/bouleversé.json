                },
                {
                    "sense_id": "8b3936d4-ee63-390b-a433-7ac9ac8c6822",
                    "sense_definition": "Qui subit des changements profonds, violents ou désorganisés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la région présente un paysage complètement <w>bouleversé</w> après la tempête.",
                            "target_lang_translations": {
                                "en": "The entire region now shows a landscape completely <w>devastated</w> after the storm.",
                                "ru": "После бури весь регион предстаёт перед нами в совершенно <w>разрушенном</w> виде.",
                                "de": "Nach dem Sturm zeigt die ganze Region eine völlig <w>verwüstete</w> Landschaft.",
                                "es": "Toda la región presenta un paisaje completamente <w>devastado</w> tras la tormenta.",
                                "zh": "暴风雨过后，整个地区的景观已经<w>面目全非</w>。"
                            }
                        },
                        {
                            "text": "La société tout entière évolue désormais dans un monde <w>bouleversé</w> par les crises successives.",
                            "target_lang_translations": {
                                "en": "Society as a whole now lives in a world <w>disrupted</w> by successive crises.",
                                "ru": "Всё общество теперь живёт в мире, <w>нарушенном</w> чередой кризисов.",
                                "de": "Die gesamte Gesellschaft lebt heute in einer durch aufeinanderfolgende Krisen <w>gestörten</w> Welt.",
                                "es": "Toda la sociedad vive ahora en un mundo <w>trastocado</w> por las sucesivas crisis.",
                                "zh": "如今，整个社会都生活在一个因接连不断的危机而变得<w>混乱</w>的世界里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chamboulé"
                    ],
                    "antonyms": [
                        "inchangé",
                        "stable"
                    ],
                    "common_phrases": [
                        "monde bouleversé",
                        "paysage bouleversé"
                    ],
                    "target_lang_definitions": {
                        "en": "Undergoing profound, violent or disorderly changes.",
                        "ru": "Претерпевший глубокие, резкие или беспорядочные изменения.",
                        "de": "Tiefgreifenden, heftigen oder ungeordneten Veränderungen unterworfen.",
                        "es": "Que sufre cambios profundos, violentos o desordenados.",
                        "zh": "经历深刻、剧烈或混乱变化的，面貌或秩序已被彻底改变。"
                    },
