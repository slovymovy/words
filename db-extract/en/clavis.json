                    }
                ],
                "senses": [
                    {
                        "sense_id": "98f5d25c-201b-3fe5-874c-014d766df700",
                        "entry_id": "3c150638-b561-393c-adb1-81bba0b772a4",
                        "glosses": [
                            "A Roman key."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b5948a-4b7e-4f3a-b157-fc89fc9261d5",
                                "sense_id": "98f5d25c-201b-3fe5-874c-014d766df700",
                                "text": "Iron clavis, the solid web-shaped at the edges to fit the wards in the lock, and having a pointed broach and a kite-formed looped haft."
                            }
                        ]
                    },
                    {
                        "sense_id": "e526f515-02db-318a-9313-5e7a024ad053",
                        "entry_id": "3c150638-b561-393c-adb1-81bba0b772a4",
                        "glosses": [
                            "A device for restraint of the hands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed055285-b20a-4ce6-bdcd-113c5ed5b5ae",
                                "sense_id": "e526f515-02db-318a-9313-5e7a024ad053",
                                "text": "His hands were restrained by means of a clavis and bolt (of iron), appropriated to each wrist, and united by a padlock."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c14f705-7f6a-3ce0-940f-51151895f40f",
                        "entry_id": "3c150638-b561-393c-adb1-81bba0b772a4",
                        "glosses": [
                            "Synonym of glossary: a key to the meaning of various terms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bac8ae8-9f34-426f-b838-d90863b5e17f",
                                "sense_id": "0c14f705-7f6a-3ce0-940f-51151895f40f",
                                "text": "Homer, with a clavis, I have had possession of some years."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a7a3030-f997-30cb-879c-719b9cbc37ec",
                        "entry_id": "3c150638-b561-393c-adb1-81bba0b772a4",
                        "glosses": [
                            "A key; an identification guide; a series of logically organized groups of discriminating information which aims to allow the user to correctly identify a taxon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35c8698-9b19-46ea-85d5-1cd1f8ff2fa9",
                                "sense_id": "9a7a3030-f997-30cb-879c-719b9cbc37ec",
                                "text": "There are many disadvantages in using a clavis intended for another country, which necessarily includes plants that are absent from our islands while it omits some that are present and neglects the peculiarities of our island flora."
                            }
                        ]
                    }
                ],
