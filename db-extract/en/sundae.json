                    {
                        "sense_id": "5a92fa11-b2b5-3f54-8cb8-6803ee9ad491",
                        "entry_id": "90489fa7-00d9-3eb0-851b-b810ecfcf71c",
                        "glosses": [
                            "A dessert consisting of ice cream with various toppings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da4e725-9e3e-4d34-88e8-5dc7f3d638f9",
                                "sense_id": "5a92fa11-b2b5-3f54-8cb8-6803ee9ad491",
                                "text": "Dine-and-dashed for an ice cream sundae. I did it two or three times a month. Kept it to a hot fudge sundae—never real food or anything like that."
                            }
                        ]
                    }
                ],
