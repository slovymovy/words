                    "frequency": "VeryLow",
                    "semantic_group_id": "mocking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mock panegyrics were written by <w>sardonic</w> intellectuals who enjoyed irony.",
                            "target_lang_translations": {
                                "nl": "Bespotte lofdichten werden geschreven door <w>sardonische</w> intellectuelen die hielden van ironie.",
                                "es": "Los falsos panegíricos fueron escritos por intelectuales <w>sardónicos</w> que disfrutaban de la ironía."
                            }
                        },
                        {
                            "text": "His <w>sardonic</w> wit often made people feel uncomfortable during the meeting.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>sardonische</w> gevatheid zorgde er vaak voor dat mensen zich tijdens de vergadering ongemakkelijk voelden.",
                                "es": "Su agudeza <w>sardónica</w> solía hacer que la gente se sintiera incómoda durante la reunión."
                            }
