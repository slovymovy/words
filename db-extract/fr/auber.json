            {
                "entry_id": "27c8161d-05d8-35e2-8f55-d200410d4d84",
                "word": "auber",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36517389-6dcb-443c-8549-e39307b3818e",
                        "entry_id": "27c8161d-05d8-35e2-8f55-d200410d4d84",
                        "tags": [],
                        "form": "aubert"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e8d25ab-b8a5-3b7a-ae46-8e93f04d341d",
                        "entry_id": "27c8161d-05d8-35e2-8f55-d200410d4d84",
                        "glosses": [
                            "Argent ; somme d’argent."
                        ],
                        "tags": [
                            "dated",
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8431fbfb-8fc6-418f-9896-80a2d7509f32",
                                "sense_id": "5e8d25ab-b8a5-3b7a-ae46-8e93f04d341d",
                                "text": "Quand on n’avait pas d’marmite,\nOn bouffait chez l’père Lafrite,\nPour un peu d’auber."
                            },
                            {
                                "example_id": "45f06705-d927-428a-81e0-7795109d98ff",
                                "sense_id": "5e8d25ab-b8a5-3b7a-ae46-8e93f04d341d",
                                "text": "Le Rouquin disait « gruper » pour grouper; il appelait ses poches, les fouilles, les « fouillouses » (l’escarcelle); il nommait l’argent : l’« auber », l'or : le « jonc », […]. C’était un gars du Nord."
                            },
                            {
                                "example_id": "2d3ed3a6-0c4b-49b9-ac50-fef1602ee258",
                                "sense_id": "5e8d25ab-b8a5-3b7a-ae46-8e93f04d341d",
                                "text": "Restait à savoir d’où le mec allait sortir cet auber?..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
