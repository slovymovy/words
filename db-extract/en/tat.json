            {
                "entry_id": "a034f36c-777c-38a4-b4ba-0962e9e9be22",
                "word": "tat",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ff346434-a617-434a-bd25-94aa50ebc97b",
                        "entry_id": "a034f36c-777c-38a4-b4ba-0962e9e9be22",
                        "tags": [
