                ],
                "senses": [
                    {
                        "sense_id": "9ecf8c95-ee89-3c5a-a095-5e4e1c8c43a5",
                        "entry_id": "f91ce69d-9ebe-3ec6-815b-4da57bc14194",
                        "glosses": [
                            "officieel bezoek van een lager geplaatst persoon bij een zeer hoog geplaatst persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a957df87-34c1-4c6c-a78a-6b6ca8396d23",
                                "sense_id": "9ecf8c95-ee89-3c5a-a095-5e4e1c8c43a5",
                                "text": "Hij ging op audiëntie bij de koning."
                            },
                            {
                                "example_id": "e2bea923-8b8d-4781-b932-35799780c44a",
                                "sense_id": "9ecf8c95-ee89-3c5a-a095-5e4e1c8c43a5",
                                "text": "In 1996 zouden de twee elkaar ontmoeten in Washington. Twee jaar eerder, in 1994, hadden radicale Hutu’s geprobeerd alle Tutsi’s uit te roeien. Kagame had de genocide met zijn Tutsi-leger beëindigd. Ontdaan van zijn mythologische koninklijke macht en levend als een sloeber, mocht Kigeli op audiëntie komen bij president Kagame in diens hotelkamer."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee08ab57-d7d9-3059-b01e-e6d78f16df57",
                        "entry_id": "f91ce69d-9ebe-3ec6-815b-4da57bc14194",
                        "glosses": [
                            "een ceremoniële hoorzitting, voor burgers door een persoon met een zekere bevoegdheid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6650b3e6-a72e-411d-ab38-6dbba0918042",
                        "source_entry_id": "f91ce69d-9ebe-3ec6-815b-4da57bc14194",
                        "target_lang_word": "audience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A group of people within hearing; specifically, a large gathering of people listening to or watching a performance, speech, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884168d3-7c8f-423e-b90d-298606fae67c",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "We joined the audience just as the lights went down."
                                            },
                                            {
                                                "example_id": "58741179-58e9-4147-ab8a-6e6f1d5bfa11",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "79257534-910e-4652-99ab-f44eff094da7",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "My audience to this not-too-easy operation was a small group of Scottish school lasses, who seemed (perhaps naturally) to find the proceedings somewhat mysterious, but at any rate amusing. I wished they would go away, but they didn't, so I had to get on with the job to the accompaniment of a background of giggles!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "Hearing; the condition or state of hearing or listening."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd45a1ed-c581-4d19-a032-07b63d02899c",
                                                "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                                "text": "WHen he had ended all his ſayingꝭ in the audience of the people / he entred ĩto Capernaum."
                                            },
                                            {
                                                "example_id": "e1bfe273-8047-4987-b6d9-66a29348bf5d",
                                                "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                                "text": "... groans and roarings full of plaintive anger, the force of which can only be realized by actual audience. When solicited by the jerking of their noses, they condescend to kneel down and tuck their legs under them;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ccbebf-2f99-304e-9ca0-7422e69575d1",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A widespread or nationwide viewing or listening public, as of a TV or radio network or program."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A formal meeting with a state or religious dignitary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0dd9bf-b019-4942-a08b-99f28263977e",
                                                "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                                "text": "She managed to get an audience with the Pope."
                                            },
                                            {
                                                "example_id": "d483271c-3182-459d-950e-82fe062081d3",
                                                "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                                "text": "Captain Anderson: Sounds like you convinced the Council to give us an audience.\nAmbassador Udina: They were not happy about it. Saren's their top agent. They don't like him being accused of treason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24dee49f-f7a6-3ed0-b37d-4b862913f51d",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "The readership of a book or other written publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a1aa8c-bcb5-45d5-a833-49d9afe8e85d",
                                                "sense_id": "24dee49f-f7a6-3ed0-b37d-4b862913f51d",
                                                "text": "\"Private Eye\" has a small but faithful audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a8ec86-9619-3003-874e-ce57a0a2e611",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A following."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbad1c4-7603-4d75-b462-7d7e05c2b719",
                                                "sense_id": "40a8ec86-9619-3003-874e-ce57a0a2e611",
                                                "text": "The opera singer expanded his audience by singing songs from the shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bad342b-5485-3b95-9a95-d6feb56c81c2",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "An audiencia (judicial court of the Spanish empire), or the territory administered by it."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
