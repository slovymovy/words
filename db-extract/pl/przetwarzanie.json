                                        "sense_id": "e91b32d5-080f-3027-931d-313e9a00f6db",
                                        "entry_id": "96b54321-a0ad-3b24-a576-21b9a978d5ba",
                                        "glosses": [
                                            "The action of the verb to process."
                                        ],
                                        "tags": [
