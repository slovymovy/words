                    {
                        "sense_id": "d178596c-09ee-3a72-bd0f-32462ed5e6ad",
                        "entry_id": "589a0631-a0e7-35a8-9f80-db6a0fede595",
                        "glosses": [
                            "het gewone, gemene volk"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ff9b31c4-3599-4b00-9ced-fce062168982",
                                "sense_id": "d178596c-09ee-3a72-bd0f-32462ed5e6ad",
                                "text": "Net als in de gewone wereld stond het luizenleven van de bazen in sterk contrast met de barre omstandigheden waarin het voetvolk zich bevond. Die spenderen hun tijd in cellen zonder water, ventilatie of daglicht."
                            },
                            {
                                "example_id": "850f14c2-ac75-48b3-95cd-8545623608d4",
                                "sense_id": "d178596c-09ee-3a72-bd0f-32462ed5e6ad",
                                "text": "Ik wil het daarom in deze eerbiedwaardige behuizing nog maar eens stellen: als je je boven het voetvolk wil verheffen door een kalasjnikov op te pakken, dan moet je gaan. Ik zie geen juridische gronden om ze dan tegen te houden. Dus waarom zouden we dat doen.'"
                            }
                        ]
                    }
