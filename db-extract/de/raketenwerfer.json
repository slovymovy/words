                "senses": [
                    {
                        "sense_id": "11004b80-4eff-301a-8e76-c95ce4db8584",
                        "entry_id": "dad2d677-22c2-3118-80b0-13eef4b813e2",
                        "glosses": [
                            "Vorrichtung zum Starten von Raketenwaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fef680-e049-458e-be41-0e673770a1f7",
                                "sense_id": "11004b80-4eff-301a-8e76-c95ce4db8584",
                                "text": "„Die Türkei hat bei der NATO formell die Stationierung von Patriot-Raketenwerfern an der Grenze zu Syrien beantragt.“"
                            },
                            {
                                "example_id": "5623a070-945b-4b82-bbb5-b90b99b92f59",
                                "sense_id": "11004b80-4eff-301a-8e76-c95ce4db8584",
                                "text": "„Georgiens Präsident ist stolz auf den neuen Raketenwerfer seiner Streitkräfte — den ersten aus eigener Herstellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
