                ],
                "senses": [
                    {
                        "sense_id": "2f4f54f7-e54d-3e66-8cbf-a5ed708db2fa",
                        "entry_id": "bed09e4f-f5f3-3026-a905-845d50e6615b",
                        "glosses": [
                            "Faire sortir les baleines de leur position normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f7a4f70-b889-42e0-8b24-1d89a171ec4b",
                                "sense_id": "2f4f54f7-e54d-3e66-8cbf-a5ed708db2fa",
                                "text": "Elle revenait par le chemin le plus direct à bord d'un temps à débaleiner un parapluie."
                            },
                            {
                                "example_id": "a5099aea-4def-43ea-af7b-4d9136c1e9fe",
                                "sense_id": "2f4f54f7-e54d-3e66-8cbf-a5ed708db2fa",
                                "text": "Dimanche matin : je suis partie sous la pluie pour acheter mon journal, engoncée dans mon ciré blanc-bleu, avec mon parapluie prêt à se débaleiner sous les bourrasques."
                            },
                            {
                                "example_id": "5fb81d4a-41ee-4332-b46e-ca360b892900",
                                "sense_id": "2f4f54f7-e54d-3e66-8cbf-a5ed708db2fa",
                                "text": "Après avoir allumé elle-même les deux cigarettes, elle s'était jetée sur son lit, entre un corset débaleiné et un fer à repasser et s'était plongée dans la lecture du journal qu'elle venait de récupérer."
                            }
                        ]
                    }
                ],
