                                    },
                                    {
                                        "sense_id": "0c9bdfff-d784-3b36-997f-b7f38e30025f",
                                        "entry_id": "50c164e9-ec6a-36f3-a2e1-26b02da9a83b",
                                        "glosses": [
                                            "Greedily sought or pursued."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1036ce23-bef5-4a1c-b05e-bc6f415d1afd",
                                                "sense_id": "0c9bdfff-d784-3b36-997f-b7f38e30025f",
                                                "text": "Suppoſe they be in number infinit,\nYet being voyd of Martiall diſcipline,\nAll running headlong after greedie ſpoiles: […]\nTheir careleſſe ſwords ſhal lanch their fellows throats\nAnd make vs triumph in their ouerthrow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a50cb1aa-2db9-4e52-9be0-ac893727015e",
                        "source_entry_id": "9e568ede-bbf0-3b6c-bad9-d5a2067058fe",
                        "source_sense_description": "жадный, скупой человек",
                        "target_lang_word": "cheapskate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheapskate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e69b844-a578-3f6d-a006-485eddcd09da",
                                        "entry_id": "00581872-a308-376a-ba84-abbfe0e3f44d",
                                        "glosses": [
                                            "Someone who stingily avoids spending money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95686f7-6921-4261-a8d3-d42269dc3d32",
                                                "sense_id": "7e69b844-a578-3f6d-a006-485eddcd09da",
                                                "text": "He is such a cheapskate, he found that jumper in a dustbin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa665843-1814-362a-92c1-40eb6940fc49",
                                        "entry_id": "00581872-a308-376a-ba84-abbfe0e3f44d",
                                        "glosses": [
                                            "Someone who does not give freely."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac33d1f-9633-4945-b0f1-f6aef74dab77",
                                                "sense_id": "aa665843-1814-362a-92c1-40eb6940fc49",
                                                "text": "My mum is such a cheapskate that she didn't lend me money to go shopping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
