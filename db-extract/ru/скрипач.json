                                                "example_id": "faea2517-90dd-456b-9b61-1f62e49bcd1c",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Frau Geiger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "65eceb9c-603e-406f-bf0e-872e9c07a172",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Herr Geiger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f684289a-71cc-426d-b98d-e8f64c6a30f3",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Die Geigers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c9817563-9624-4ef4-a51a-969cbb805973",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Der Geiger trägt nie die Schals, die die Geiger ihm strickt."
                                            },
                                            {
                                                "example_id": "c71c600b-7f23-4a08-a91b-a2fcdb1cc76f",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geiger kommt, geht der Herr Geiger.“"
                                            },
                                            {
                                                "example_id": "c59d2695-ccb9-41fd-95dc-c476c33b7cc5",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Geiger kommt und geht."
                                            },
                                            {
                                                "example_id": "758142f2-7cfb-47ce-83ce-91a202d0b325",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Geigers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
