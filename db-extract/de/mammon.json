                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "02e23f03-81d6-4594-819c-daa5774f587e",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "der Mammon"
                    },
                    {
                        "form_id": "3b9665b9-46fa-406d-bc51-b7e8998b2601",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "des Mammons"
                    },
                    {
                        "form_id": "d1e8901c-8186-4198-a289-99f359cd6d2d",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "dem Mammon"
                    },
                    {
                        "form_id": "9e5d3c33-50a6-40ff-9780-1f469e00e507",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Mammon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "glosses": [
                            "Geld in seiner Eigenschaft als Zahlungsmittel für Status und Luxus"
                        ],
                        "tags": [
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "aac65ada-0eb0-4716-94c3-775580ab9eca",
                                "sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                                "text": "Was nützt der ganze Mammon, wenn man doch nicht glücklich ist."
                            },
                            {
                                "example_id": "ccb17af7-3559-4371-9605-a92d2ce79729",
                                "sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                                "text": "„Auch bei den Katholiken im ›Kreis‹ wollte nie einer über den ungerechten Mammon sprechen, Kinkel und Sommerwild lächelten immer nur verlegen, wenn ich sie darauf ansprach – als hätten sie Christus bei einem peinlichen Lapsus ertappt, und Fredebeul sprach von dem Verschleiß durch die Geschichte, den dieser Ausdruck erfahren habe.“"
                            },
                            {
                                "example_id": "7968ecd8-783f-41ec-b912-64fe0c113991",
                                "sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                                "text": "Man kann nicht nur dem schnöden Mammon nachjagen, man muss auch leben und genießen."
                            },
                            {
                                "example_id": "fb45c1cc-b57a-474f-965d-a4a468b17370",
                                "sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                                "text": "„Das war Wolkenstein, der nicht an schnöden Mammon denkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e20b5cc-e904-3e97-8794-2183aa70bcc9",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "glosses": [
                            "Reichtum als Götze, auch unredlich erworbener Gewinn oder unmoralisch eingesetzter Reichtum"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "443d71aa-48de-4921-955b-e58f0ade13ed",
                                "sense_id": "0e20b5cc-e904-3e97-8794-2183aa70bcc9",
                                "text": "Das Goldene Kalb wird als Sinnbild des Mammons gesehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3ed8e208-f7de-3dda-a02a-450db303a5ef",
                        "entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "glosses": [
                            "ein Dämon, der den Menschen zum Geiz verführt"
                        ],
                        "tags": [
                            "in Volksglaube und Literatur",
                            "da Luther den Begriff in der Bibel nicht übersetzt hat"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b424c42a-397e-4f93-8ea4-588b3f838f35",
                        "source_entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "source_sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                        "source_sense_description": "abwertend, scherzhaft: Geld in seiner Eigenschaft als Zahlungsmittel für Status und Luxus",
                        "target_lang_word": "Mammon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mammon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                        "entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                                        "glosses": [
                                            "The desire for wealth personified as an evil spirit or a malign influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6752702e-3ce3-491b-89e2-92ef5bb0bbe7",
                                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                                "text": "No man can ſerue two maſters: for either he will hate the one and loue the other, or elſe hee will holde to the one, and deſpiſe the other. Ye cannot ſerue God and Mammon."
                                            },
                                            {
                                                "example_id": "1e0b4f7c-4709-4fc4-a0b8-7fd78d68e19f",
                                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                                "text": "They [bankers] would do what has been done by the Bank of France—buy bullion at a premium, on the approach of danger, and keep peril at a safe and respectable distance. Any expenditure that might be incurred for that purpose would be small indeed when contrasted with the immense loss and suffering caused by the present system, and the continual fear in which the public now live of some new crisis—because it has been out of one and into another for a long period now; and that will be the case hereafter, until we have no interval to gather strength, and recruit for the next struggle with Mammon, or Moloch, or whatever other name of evil import belongs to the \"Tutelarity\" of Lombard-street and its precincts."
                                            },
                                            {
                                                "example_id": "c23f375b-487b-497f-a8a2-c54c9869d870",
                                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                                "text": "Lives sacrificed upon the altar of Mammon, only units in the thousands who have fallen in the wilds of Australia, victims to the fever and unrest caused by the search for gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                                        "entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                                        "glosses": [
                                            "Often mammon: wealth, material avarice, profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34ee1d8-042f-4b78-ac5e-5310decaa29a",
                                                "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                                                "text": "The proper sphere of the church, after all, was the kingdom of God, not greedy earthbound kingdoms of mammon, which should be left to temporal authorities to rule and squabble over."
                                            },
                                            {
                                                "example_id": "3bfca319-9309-4ad3-bad4-bcec536b67e9",
                                                "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                                                "text": "But he [Andrew Wyeth] did not want to become an all-American illustrator like the Post's illustrious Norman Rockwell – and he had heard his own father, an illustrator, bemoan choosing the path of mammon rather than the path of virtue, and declined."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25ea72c9-db5e-4962-80fe-1ad3e26eacc3",
                        "source_entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "source_sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
                        "source_sense_description": "abwertend, scherzhaft: Geld in seiner Eigenschaft als Zahlungsmittel für Status und Luxus",
                        "target_lang_word": "мамон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мамон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                                        "glosses": [
                                            "то же, что мамона; утроба, брюхо, желудок как символ алчности, обжорства, стяжательства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863ea815-3266-4a50-bd6c-7f7b12a18480",
                                                "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                                                "text": "Не можешь служить Богу и мамону."
                                            },
                                            {
                                                "example_id": "b88ae377-f273-4a22-ad41-9853ef4ea0e7",
                                                "sense_id": "35d3e164-5ca7-344c-9655-2f1fbf7efff6",
                                                "text": "Нельзя работать на Бога и на мамона."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9eff29a-6a03-3a8a-b337-f19bd700d476",
                                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                                        "glosses": [
                                            "живот, брюхо, желудок в буквальном значении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ac552e-e275-4263-a631-0ec915d9c6cb",
                                                "sense_id": "a9eff29a-6a03-3a8a-b337-f19bd700d476",
                                                "text": "Им, ракушкам, жить хочется, а ты, простофиля, ими мамон с утра до вечера набиваешь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e0b117b-1b37-39bd-89bb-708c5befc788",
                                        "entry_id": "8c5316fd-c6fe-35e1-8e26-d2397cbd0edf",
                                        "glosses": [
                                            "рег. (арх.) то же, что няндомец"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed9d639e-7d15-4130-8438-a16632b3c02c",
                        "source_entry_id": "51a0c63b-6ca3-332b-beb9-1363ea4953f5",
                        "source_sense_id": "3cb1954b-4aae-3547-af3d-6a2a33ebf596",
