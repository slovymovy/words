                        "entry_id": "7ef20dbe-2e00-3004-b948-4fe93bd7d56a",
                        "glosses": [
                            "Leiter, die im Notfall oder bei einem Brand genutzt werden kann oder soll, um sich von der Gefahrenstelle zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084d913b-93bc-4114-918c-d47469f1ce2a",
                                "sense_id": "1b46e209-036e-3006-8401-990390b5910a",
                                "text": "Hinter der Nottür befindet sich eine Feuerleiter."
                            },
                            {
                                "example_id": "04a8c08f-85cc-4707-81b2-811f174a0d6d",
                                "sense_id": "1b46e209-036e-3006-8401-990390b5910a",
                                "text": "Feuerleitern enden meist ein ganzes Stück oberhalb vom Boden, damit niemand von unten heraufklettern kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
