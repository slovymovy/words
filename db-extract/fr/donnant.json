                        "examples": [
                            {
                                "example_id": "e24a19ae-ab55-42ac-a406-421f5a4fb6ea",
                                "sense_id": "b30f6f8a-bb43-3bb7-9f0a-c6539c300b84",
                                "text": "Quelques chefs catholiques aidaient activement les catéchistes dans leur territoire, leur donnant logement et champs à cultiver, voire même en construisant pour eux une chapelle."
                            },
                            {
                                "example_id": "5657f1f7-9bbc-41ee-ab92-17d43bf5d246",
                                "sense_id": "b30f6f8a-bb43-3bb7-9f0a-c6539c300b84",
                                "text": "Par une inconséquence hautement psychologique, Job passe sa matinée à fourbir les cuivres du plumard, à nettoyer, à araigner, ne se donnant de répit que pour avaler une pilule, pour aller cracher dans le vent et se soulager la panse dans le chatouillis de la brise marine."
                            }
                        ]
                    }
