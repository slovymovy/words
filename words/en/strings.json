                    "sense_definition": "Plural of <w>string</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a new set of <strings> for his acoustic guitar.",
                            "target_lang_translations": {
                                "ru": "Он купил новый комплект <струн> для своей акустической гитары.",
                                "fr": "Il a acheté un nouveau jeu de <w>cordes</w> pour sa guitare acoustique."
                            }
                        },
                        {
                            "text": "The puppet moved its arms when she pulled the <strings>.",
                            "target_lang_translations": {
                                "ru": "Кукла двигала руками, когда она дергала за <ниточки>.",
                                "fr": "La marionnette bougeait ses bras quand elle tirait sur les <w>ficelles</w>."
                            }
                        }
                    ],
                    "traits": [
