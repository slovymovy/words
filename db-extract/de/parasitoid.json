                                "target_senses": [
                                    {
                                        "sense_id": "9c6e0bb7-c543-3612-9e92-a6a030622fd3",
                                        "entry_id": "38519c33-418c-3cd9-a1f6-59b6be8ac0c4",
                                        "glosses": [
                                            "Any organism that is parasitic during part of its life cycle, especially one that eventually kills its host."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf04e2d-2531-41bf-a45d-0305e4b02d28",
                                                "sense_id": "9c6e0bb7-c543-3612-9e92-a6a030622fd3",
                                                "text": "All of these solitary parasitoid wasps that use their sting-ovipositors for stinging prey and depositing eggs are subjected to little predatory pressure from large predators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
