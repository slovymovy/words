                ],
                "senses": [
                    {
                        "sense_id": "2256b501-9ff3-387f-a686-59441d1c1f55",
                        "entry_id": "e760fae7-9173-3c61-a350-ec010709fc99",
                        "glosses": [
                            "aus der württembergischen Stadt Asperg stammend, auf die württembergische Stadt Asperg bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3e33c6-26cf-4ede-8d9e-011a3a1d830c",
                                "sense_id": "2256b501-9ff3-387f-a686-59441d1c1f55",
                                "text": "„Ein weiteres Prunkgrab der Keltenzeit, datiert auf 500 v. Chr., wurde bei Bauarbeiten im Gebiet Grafenbühl 1964 von Hartwig Zürn entdeckt. Auch hier fanden sich einzigartige Stücke, beispielsweise zwei aus Bein geschnitzte Sphingen, eine davon mit aufgesetztem Bernsteingesicht. Die Asperger Funde befinden sich im Landesmuseum Württemberg in Stuttgart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "74096816-d491-309e-ba6c-00ec092a5006",
