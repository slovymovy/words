                ],
                "senses": [
                    {
                        "sense_id": "c8b97894-e4cb-39da-9dcd-56f911d5d8f8",
                        "entry_id": "64c55ed4-1032-3fc0-bdce-3d2fbb95c776",
                        "glosses": [
                            "A dish consisting of French fries topped with cheese curds and gravy, eaten primarily in Canada."
                        ],
                        "tags": [
                            "Canada",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f469d78-ac64-4ce3-ab8e-0c9fc8bc84e3",
                                "sense_id": "c8b97894-e4cb-39da-9dcd-56f911d5d8f8",
                                "text": "Jean made an eight-hour trip across the border into Quebec just to satisfy his craving for poutine."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c8da0a0-eb72-31d4-968c-9428edefff3d",
                        "entry_id": "64c55ed4-1032-3fc0-bdce-3d2fbb95c776",
                        "glosses": [
                            "Chiefly with a qualifying word: any of a number of variations on the basic poutine dish."
                        ],
                        "tags": [
                            "Canada",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e7a27b83-d2bf-4599-9297-d17c69516758",
                                "sense_id": "0c8da0a0-eb72-31d4-968c-9428edefff3d",
                                "text": "In Italian poutine, gravy is replaced with spaghetti sauce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc46ff5f-b145-48e6-865b-a256780a32c5",
