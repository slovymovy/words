                                        "entry_id": "808d1a6f-38c3-3319-843a-5e8a862441c4",
                                        "glosses": [
                                            "A successful kill in a deathmatch game. A point or score (when considered collectively) gained by successfully killing opponents in a deathmatch game."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
