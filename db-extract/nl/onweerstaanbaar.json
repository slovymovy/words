                ],
                "senses": [
                    {
                        "sense_id": "07d7f245-d3f2-312f-b41e-d71432067f4f",
                        "entry_id": "8b3b1719-d273-36e4-9850-53349e10cc53",
                        "glosses": [
                            "zo verleidelijk dat je eraan toe moet geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a4e1638-8dc4-4675-b9f7-597d485eba54",
                                "sense_id": "07d7f245-d3f2-312f-b41e-d71432067f4f",
                                "text": "Datzelfde geldt voor de derde release van dit jaar, Moessorgski’s Schilderijententoonstelling. Een stuk waar je van moet houden, maar de ronkende toon van de Mariinskystrijkers geven er een glans aan die hoe dan ook onweerstaanbaar is. Dat geldt nog iets meer voor de Liederen en dansen van de dood met Ferruccio Furlanetto - een kelderbas die toch beschikt over subtiliteit, kleuren en (belangrijkst) een vertelstem die je even in de waan brengt dat je Russisch verstaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8b0990-b56c-3303-b43b-62137aaf3183",
                        "entry_id": "8b3b1719-d273-36e4-9850-53349e10cc53",
                        "glosses": [
                            "niet tegen te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86276ef-f32f-49f9-96ce-5a6c442fe51c",
                                "sense_id": "8b8b0990-b56c-3303-b43b-62137aaf3183",
                                "text": "Het kwam onweerstaanbaar naderbij. De bomen hadden niets in de gaten. Hij probeerde op het gevaar te wijzen. Maar niemand lette op hem."
                            },
                            {
                                "example_id": "2ccb6561-c88b-4508-bb8a-6c90e9a5e4b6",
                                "sense_id": "8b8b0990-b56c-3303-b43b-62137aaf3183",
                                "text": "Maar toen ik was uitgestapt bij de Ringvâgen drongen de tranen zich onweerstaanbaar op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a17b0f4-ae6b-425c-b747-c37497035e86",
                        "source_entry_id": "8b3b1719-d273-36e4-9850-53349e10cc53",
                        "target_lang_word": "irresistible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irresistible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                        "entry_id": "ebccb7e4-0c28-3866-a1a4-14ce41b9f99c",
                                        "glosses": [
                                            "Impossible to resist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5de83d-f997-4ca3-afbe-dd45e9683841",
                                                "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                                "text": "Where the breakdown of traditional authority set the poor of the earth on the march, where they left the obscurity of their misfortunes and streamed upon the market-place, their furor seemed as irresistible as the motion of the stars, a torrent rushing forward with elemental force and engulfing a whole world."
                                            },
                                            {
                                                "example_id": "f0a0f413-81c4-491c-aaad-f8e11757c1b4",
                                                "sense_id": "2e5c2000-7069-3dae-8963-b67142e99ea4",
                                                "text": "Though his account of written communication over the past 5,000 years necessarily has a powerful forward momentum, his diversions down the fascinating byways of the subject are irresistible ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "821eaecf-e006-3021-96f3-9b0c7c5aaaed",
                                        "entry_id": "ebccb7e4-0c28-3866-a1a4-14ce41b9f99c",
                                        "glosses": [
                                            "Compellingly attractive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
