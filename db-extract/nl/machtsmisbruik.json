                                    {
                                        "sense_id": "a3046232-32a1-3efa-84c6-ec5275625e03",
                                        "entry_id": "f519b9f0-34e1-3d9a-b2e1-06addd858729",
                                        "glosses": [
                                            "der Missbrauch einer Machtposition, um anderen Personen - über welche man Macht ausüben kann - zu schaden, sie zu schikanieren oder zu benachteiligen oder um sich selbst oder eigenen Günstlingen persönliche Vorteile zu verschaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5151c2-e19e-4baf-8809-ae922ec73e7d",
                                                "sense_id": "a3046232-32a1-3efa-84c6-ec5275625e03",
                                                "text": "In vielen politisch instabilen Staaten ist Machtmissbrauch ein großes Problem."
                                            },
                                            {
                                                "example_id": "0d49dd0d-137c-4909-8e38-b3afb136f3c5",
                                                "sense_id": "a3046232-32a1-3efa-84c6-ec5275625e03",
                                                "text": "„Es war der Aufstand der Dichter gegen den Machtmissbrauch des kommunistischen Regimes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
