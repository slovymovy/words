                            {
                                "example_id": "0f71b756-c0f8-408b-ab7e-65ffce3db622",
                                "sense_id": "b4080684-1a4a-3b08-a390-1f2b2450ebc3",
                                "text": "Puis vient le moment du dépulpage ; c’est-à-dire, la séparation du grain de la pulpe par l’utilisation d’eau et de friction."
                            },
                            {
                                "example_id": "ee8a4726-4492-4926-b697-e0b7f31aab29",
                                "sense_id": "b4080684-1a4a-3b08-a390-1f2b2450ebc3",
                                "text": "Une filière qui comprend plusieurs systèmes de transformation : le café de base est la cerise rouge et elle est lavée et dépulpée dans les stations de lavage et dépulpage."
                            },
                            {
                                "example_id": "90484e4c-6f58-49eb-843c-27b24a935510",
                                "sense_id": "b4080684-1a4a-3b08-a390-1f2b2450ebc3",
                                "text": "Les cerises du cafier^([sic]) étant sujettes à varier de grosseur, il est essentiel de pouvoir modifier l’écartement du couloir où a lieu le dépulpage."
                            }
                        ]
