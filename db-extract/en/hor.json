                                "sense_id": "3c64e0e8-359f-3bcb-b506-0746c95ed99e",
                                "text": "Oh. That’s me. I see you later, hor, Jackson. You got my number right?"
                            },
                            {
                                "example_id": "c5593645-eb2d-4944-bbcc-96b4fb35cbed",
                                "sense_id": "3c64e0e8-359f-3bcb-b506-0746c95ed99e",
                                "text": "sorry, i have to drill hor. the filling will cost $300."
                            },
                            {
                                "example_id": "ee50fd8d-b75a-4fd9-ad7d-b3fac35e3df9",
                                "sense_id": "3c64e0e8-359f-3bcb-b506-0746c95ed99e",
                                "text": "[…] except it is slightly more hostile (\"This is mine hor, don't touch it!\")."
                            }
