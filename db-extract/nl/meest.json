                            {
                                "example_id": "88ef6b81-ed36-40f1-8b33-f7e9ba9df0b8",
                                "sense_id": "7c4f737e-566d-3ce4-988e-ffb7cb0f00eb",
                                "text": "Facturen zonder het juiste kenmerk gaan retour. Omdat terugzending meest weinig prioriteit heeft, kan dit de betalingstermijn met weken vertragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e70b465a-862a-3a16-b9bd-454da5564268",
                        "entry_id": "c1d463ef-732b-344b-b07c-0cca4210d6c2",
                        "glosses": [
                            "van hoedanigheid in hoogste mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c5d9a12-49df-4474-aefd-e38a6ecc2df5",
                                "sense_id": "e70b465a-862a-3a16-b9bd-454da5564268",
                                "text": "'Lobbes is de meest geweldige vader die bestaat."
                            },
                            {
                                "example_id": "ee6bcf34-0531-4c95-87bb-491954b34aa2",
                                "sense_id": "e70b465a-862a-3a16-b9bd-454da5564268",
                                "text": "'Lobbes is de meest geweldige vader die bestaat."
                            },
                            {
                                "example_id": "8fbb642f-4f45-4818-b2bf-3ab84c1d6c7b",
                                "sense_id": "e70b465a-862a-3a16-b9bd-454da5564268",
                                "text": "Ook in de meest gezonde arbeidsrelatie komt er ooit een moment dat je een collega of baas naar de keel wilt vliegen."
                            },
                            {
                                "example_id": "cb09ad44-c736-4e29-8eba-3231e5d16bf8",
                                "sense_id": "e70b465a-862a-3a16-b9bd-454da5564268",
                                "text": "Het was gek om mijn gezondheid helemaal in handen van deze wonderlijke techniek te leggen, maar het leek mij de meest efficiënte optie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
