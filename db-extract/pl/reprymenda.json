                                        "glosses": [
                                            "A severe, formal or official reproof; reprehension, rebuke, private or public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150c3a5a-d13c-4594-b2fd-b692a0463f14",
                                                "sense_id": "8e0cfcab-2c44-3953-ad0e-c00a4af885a7",
                                                "text": "Goldsmith gave his landlady a sharp reprimand for her treatment of him."
                                            }
