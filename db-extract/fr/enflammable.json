                ],
                "translations": [
                    {
                        "translation_id": "19e7e421-4c81-464a-8d6f-d2e0792db430",
                        "source_entry_id": "25a3ebfd-d1f2-37d8-b7d1-eb4c388a4022",
                        "source_sense_id": "5b1b937f-bbf2-3a84-bbe9-33f1adb3d361",
                        "target_lang_word": "brennbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brennbar",
