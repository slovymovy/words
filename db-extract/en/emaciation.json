                                                "sense_id": "f54ec2f3-89f4-3cae-a6eb-ccd768fae773",
                                                "text": "„Den Gürtel in einer Hand, kam er näher. Die Löcher darin markierten seine fortschreitende Abmagerung, und das Leder wies eine wie lackiert wirkende Stelle auf, wo er es gewohnt war, die Klinge seines Messers abzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0c267b-d7f2-4279-95ce-537a80c045b9",
                        "source_entry_id": "2f4dfb3d-e282-3122-bdbe-3ec24bc7bb69",
                        "source_sense_description": "the act of making very lean",
                        "target_lang_word": "emaciación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
