                {
                    "sense_id": "47ed1777-93b0-37d4-872d-725639da5762",
                    "sense_definition": "Слухи, сплетни, обсуждаемые новости (обычно во множественном числе).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По всему городу ходят <w>разговоры</w> о его скором отъезде.",
                            "target_lang_translations": {
                                "en": "There is <w>talk</w> all over the city about his imminent departure.",
                                "nl": "Er gaan door de hele stad <w>praatjes</w> over zijn aanstaande vertrek.",
                                "pl": "Po całym mieście krążą <w>plotki</w> o jego szybkim wyjeździe.",
                                "de": "In der ganzen Stadt gibt es <w>Gerede</w> über seine baldige Abreise.",
                                "fr": "Il y a des <w>rumeurs</w> dans toute la ville sur son départ imminent.",
                                "it": "In tutta la città girano <w>voci</w> sulla sua imminente partenza.",
                                "cs": "Po celém městě se vedou <w>řeči</w> o jeho brzkém odjezdu.",
                                "tr": "Tüm şehirde onun yakında gideceğine dair <w>söylentiler</w> dolaşıyor.",
                                "es": "Por toda la ciudad hay <w>rumores</w> sobre su pronta partida.",
                                "zh": "全城都在<w>议论</w>他即将离开的消息。"
                            }
                        },
                        {
                            "text": "Не стоит верить этим глупым <w>разговорам</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't believe this silly <w>talk</w>.",
                                "nl": "Je moet die domme <w>praatjes</w> niet geloven.",
                                "pl": "Nie warto wierzyć w to głupie <w>gadanie</w>.",
                                "de": "Man sollte diesem dummen <w>Gerede</w> nicht glauben.",
                                "fr": "Il ne faut pas croire ces stupides <w>commérages</w>.",
                                "it": "Non vale la pena credere a queste stupide <w>dicerie</w>.",
                                "cs": "Nemá cenu věřit těmto hloupým <w>řečem</w>.",
                                "tr": "Bu saçma <w>dedikodulara</w> inanmamalısın.",
                                "es": "No vale la pena creer en estas <w>habladurías</w> tontas.",
                                "zh": "不应该相信那些愚蠢的<w>流言</w>。"
                            }
                        }
