                "senses": [
                    {
                        "sense_id": "21c62628-1917-3672-9e3c-be5b6c481750",
                        "entry_id": "58290344-0275-3101-8527-9a5f77ab5e82",
                        "glosses": [
                            "krankhafte, zwanghafte Neigung zum Gebrauch von Fäkalsprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63659134-08b5-4adc-98c9-6ec77287aa3c",
                                "sense_id": "21c62628-1917-3672-9e3c-be5b6c481750",
                                "text": "„Komplexe vokale Tics sind das Wiederholen von Wörtern (Echolalie bzw. Palilalie) oder das als Koprolalie bekannte Herausschleudern obszöner und aggressiver Wörter.“"
                            },
                            {
                                "example_id": "67ebdc19-4c1d-4a5d-88ab-f4d95c0b8bfd",
                                "sense_id": "21c62628-1917-3672-9e3c-be5b6c481750",
                                "text": "„Streng genommen (und vom etymologischen Standpunkt aus ohnehin) meinen ja »Koprolalie« wie auch »skatologisch« nur das Exkrementelle, nicht das Sexuelle.“"
                            },
                            {
                                "example_id": "13ca1635-fbb6-437b-8b4a-7a87c29b6947",
                                "sense_id": "21c62628-1917-3672-9e3c-be5b6c481750",
                                "text": "„Und nun kommt die Hauptsache: Das Tourette-Syndrom äußert sich vor allem sprachlich, in der »Koprolalie«, die der Pschyrembel (das klinische Wörterbuch) als »zwanghaften Gebrauch vulgärer Ausdrücke (häufig aus dem Bereich der Fäkalsprache)« definiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
