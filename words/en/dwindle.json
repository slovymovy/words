{
    "word_family": [
        "dwindlement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "864c0500-b97f-3525-a018-5584c57cd05c",
                    "sense_definition": "To gradually become smaller, fewer, or less intense over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the winter progressed, the village's food supplies began to <w>dwindle</w> rapidly.",
                            "target_lang_translations": {
                                "ru": "С наступлением зимы запасы продовольствия в деревне начали быстро <w>сокращаться</w>."
                            }
                        },
                        {
                            "text": "The crowd started to <w>dwindle</w> away after the main performance ended and the rain began.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>редеть</w> после окончания основного выступления и начала дождя."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade away",
                        "peter out",
                        "wane"
                    ],
                    "antonyms": [
                        "increase",
                        "grow",
                        "expand"
                    ],
                    "common_phrases": [
                        "dwindle away",
                        "dwindle to nothing",
                        "dwindling resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становиться меньше, сокращаться в количестве или терять интенсивность со временем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращаться",
                                "target_lang_sense_clarification": "о количестве или запасах"
                            },
                            {
                                "target_lang_word": "уменьшаться",
                                "target_lang_sense_clarification": "становиться меньше"
                            },
                            {
                                "target_lang_word": "истощаться",
                                "target_lang_sense_clarification": "о ресурсах"
                            },
                            {
                                "target_lang_word": "иссякать",
                                "target_lang_sense_clarification": "постепенно заканчиваться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4410d663-e400-3cdc-9efd-31e7c8b9be52",
                    "sense_definition": "To decline in quality or importance; to degenerate or sink into a lower state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The once-great empire saw its influence <w>dwindle</w> into insignificance over several decades.",
                            "target_lang_translations": {
                                "ru": "Когда-то великая империя увидела, как её влияние <w>сошло на нет</w> за несколько десятилетий."
                            }
                        },
                        {
                            "text": "The initial excitement for the project began to <w>dwindle</w> into simple boredom among the staff.",
                            "target_lang_translations": {
                                "ru": "Первоначальный восторг от проекта начал <w>угасать</w>, сменяясь обычной скукой среди сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "trail off"
                    ],
                    "antonyms": [
                        "improve",
                        "flourish"
                    ],
                    "common_phrases": [
                        "dwindle into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижаться в качестве или значимости; вырождаться или переходить в более низкое состояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходить на нет",
                                "target_lang_sense_clarification": "терять значимость"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "о влиянии или интересе"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "о чувствах или энтузиазме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ec9ef9d-e588-3bde-adf0-c63880ded8e8",
                    "sense_definition": "To break up, disperse, or scatter until very little remains.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disperse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small army <w>dwindled</w> away as soldiers deserted their posts during the long retreat.",
                            "target_lang_translations": {
                                "ru": "Маленькая армия <w>растаяла</w>, так как солдаты дезертировали со своих постов во время долгого отступления."
                            }
                        },
                        {
                            "text": "By the end of the meeting, the group had <w>dwindled</w> to just three people.",
                            "target_lang_translations": {
                                "ru": "К концу встречи группа <w>сократилась</w> всего до трех человек."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade away"
                    ],
                    "antonyms": [
                        "assemble",
                        "gather"
                    ],
                    "common_phrases": [
                        "dwindle away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распадаться, рассеиваться или разбредаться до тех пор, пока почти ничего не останется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редеть",
                                "target_lang_sense_clarification": "о группе людей или толпе"
                            },
                            {
                                "target_lang_word": "сократиться",
                                "target_lang_sense_clarification": "уменьшиться до малого числа"
                            },
                            {
                                "target_lang_word": "рассеиваться",
                                "target_lang_sense_clarification": "о группе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}