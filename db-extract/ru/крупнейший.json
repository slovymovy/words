                "senses": [
                    {
                        "sense_id": "dabd63c0-e51f-3f94-98d6-3fb79bf30b63",
                        "entry_id": "d23168b4-fbfb-331a-b4f6-beb5f8019692",
                        "glosses": [
                            "превосх. ст. к прил. крупный; имеющий самые большие размеры"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "5bf4f24b-c03c-4762-acbb-530fb9be83f2",
                                "sense_id": "dabd63c0-e51f-3f94-98d6-3fb79bf30b63",
                                "text": "Долгое время географы считали, что водопад на Замбези ― крупнейший в мире."
                            }
                        ]
                    },
                    {
                        "sense_id": "09e1b480-1fe2-3bc1-9c17-053deb04efa3",
                        "entry_id": "d23168b4-fbfb-331a-b4f6-beb5f8019692",
                        "glosses": [
                            "превосх. ст. к прил. крупный; самый значительный по количественным показателям или важности"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "18607600-8237-4928-8655-58d569ca3185",
                                "sense_id": "09e1b480-1fe2-3bc1-9c17-053deb04efa3",
                                "text": "Вскоре в крупнейшей американской газете появилась статья на эту тему."
                            },
                            {
                                "example_id": "d75d5828-042e-401a-a6c0-7e7eed72e7da",
                                "sense_id": "09e1b480-1fe2-3bc1-9c17-053deb04efa3",
                                "text": "Я пригласила крупнейшего специалиста по аппендициту, профессора Буша."
                            }
                        ]
                    }
                ],
