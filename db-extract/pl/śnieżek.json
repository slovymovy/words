                    },
                    {
                        "sense_id": "7228f32e-df6f-34f4-bf82-a9bd694639f5",
                        "entry_id": "4a041334-dcc6-3779-806a-fd08e001f6a1",
                        "glosses": [
                            "drobny śnieg"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c73541bf-0238-491a-b844-87fb92752736",
                                "sense_id": "7228f32e-df6f-34f4-bf82-a9bd694639f5",
                                "text": "Gdy szliśmy na przystanek, zaczął padać drobny śnieżek."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79af3bf-33f2-4a8f-8837-c817e01de9ab",
                        "source_entry_id": "4a041334-dcc6-3779-806a-fd08e001f6a1",
                        "source_sense_id": "781e5306-0aa6-38e2-87a8-80d35057b60f",
                        "target_lang_word": "снежок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "снежок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33fac2c8-a97d-3a41-9058-097a70ed24c5",
                                        "entry_id": "08d7f12c-637a-3f94-87b8-74dacd0d8618",
                                        "glosses": [
                                            "уменьш.-ласк. к снег"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78cbce49-005f-441f-8eb2-f5e9cbec5e91",
                                                "sense_id": "33fac2c8-a97d-3a41-9058-097a70ed24c5",
                                                "text": "Погода благоприятствовала охоте — мороз 5 градусов, полное отсутствие ветра, и свежевыпавший снежок смягчал хруст подмёрзшего после оттепели старого снега."
                                            },
                                            {
                                                "example_id": "e55ac66c-500b-4a93-b89e-c53d8ce158b2",
                                                "sense_id": "33fac2c8-a97d-3a41-9058-097a70ed24c5",
                                                "text": "Погода солнечная, морозная, снежка за ночь подвалило."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad91c06a-7bdc-31c3-bce8-b5623df1f11d",
                                        "entry_id": "08d7f12c-637a-3f94-87b8-74dacd0d8618",
                                        "glosses": [
                                            "небольшой, плотно скатанный комок снега (которым бросаются)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2488a2f-a660-4847-9404-87ed8ca678ad",
                                                "sense_id": "ad91c06a-7bdc-31c3-bce8-b5623df1f11d",
                                                "text": "Виктория наклонилась, зачерпнула ладонью снег и слепила снежок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f4a0609-3596-3cf8-80ae-eaa2b1f67137",
                                        "entry_id": "08d7f12c-637a-3f94-87b8-74dacd0d8618",
                                        "glosses": [
                                            "жарг. то же, что кокаин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e910cf-d095-43bd-b262-ceab5be259fb",
                                                "sense_id": "4f4a0609-3596-3cf8-80ae-eaa2b1f67137",
                                                "text": "Получился такой слабенький коктейль, который в отличие от «снежка» торкает не слишком сильно."
                                            },
                                            {
                                                "example_id": "7e5d0b1a-48a3-45e1-9491-707ef6affd13",
                                                "sense_id": "4f4a0609-3596-3cf8-80ae-eaa2b1f67137",
                                                "text": "— Мне бы сейчас, — сказал я про себя с яростью, — понюхать ещё этого снежка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4425004f-15b2-30d2-b84c-c7f35df59642",
                                        "entry_id": "08d7f12c-637a-3f94-87b8-74dacd0d8618",
                                        "glosses": [
                                            "кисломолочный напиток обычно с добавлением сахара или плодово-ягодного сиропа"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
