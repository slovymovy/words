                                        "entry_id": "e7cc8808-03c8-3826-b296-322ad7e3ca9b",
                                        "glosses": [
                                            "Aspirant qui souhaite être quelqu’un ou faire quelque chose, mais manque de qualités, de talent."
                                        ],
