                "senses": [
                    {
                        "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                        "entry_id": "e32180ef-a652-3aa2-bd03-c0a7fc42142f",
                        "glosses": [
                            "Sport Utility Vehicle; Fahrzeug, das zwar das Aussehen eines Geländewagens besitzt, meist aber nicht für Geländefahrten geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d1e373-ba99-43b4-abb1-e880974af723",
                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                "text": "„Audi-Chef Rupert Stadler ließ auf der Peking Auto Show wenig Zweifel offen: Bis 2020 werden 45 Prozent aller verkauften Audi-Modelle SUV sein.“"
                            },
                            {
                                "example_id": "72f3cbab-36e6-4947-b91c-7fc28c588bca",
                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                "text": "„Grundsätzlich gilt die Namensregelung, wonach SUV ungerade Ziffern (Q1, Q3, Q5, etc.) erhalten, die geraden Zahlen dagegen den sportlicheren, eleganteren Crossover-Modellen vorbehalten bleiben.“"
                            },
                            {
                                "example_id": "db767539-e7e5-4c03-838d-7ae4f4521d76",
                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                "text": "„Schon am Parkplatz davor fällt mein verdreckter Dacia-Lieferwagen unter den ganzen schnittigen Sportwagen und den SUVs ziemlich auf.“"
                            },
                            {
                                "example_id": "c5f13d66-de76-44f0-8bec-cd28dcecff73",
                                "sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                                "text": "„Die Fahrt mit einem SUV sollte um die hundert Euro kosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2caa6362-a804-414b-a3b4-b42533148dad",
                        "source_entry_id": "e32180ef-a652-3aa2-bd03-c0a7fc42142f",
                        "source_sense_id": "ef741df3-01e5-3bef-92a2-af7746065a31",
                        "source_sense_description": "Sport Utility Vehicle; Fahrzeug mit dem Aussehen eines Geländewagens",
                        "target_lang_word": "SUV",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "SUV",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                        "entry_id": "995fdde5-50e3-346d-ae1e-b1f5f87ac586",
                                        "glosses": [
                                            "Initialism of sport utility vehicle; also S.U.V."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14faea86-ef0c-4b05-a8a2-12b56415c05d",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "A man dressed as a lab tech, his blue scrubs startlingly pale against the vivid red and black chaos, moved into sight from behind the SUV. He carried an assault rifle."
                                            },
                                            {
                                                "example_id": "7df3c2dc-9122-40bd-8db3-a2ac484648b4",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "As SUVs are higher and heavier, they are more likely to kill the people they hit. Driving an SUV in an urban area is an antisocial act."
                                            },
                                            {
                                                "example_id": "c2b40e73-13d5-4e34-a186-5403874394a4",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "Audi, which markets a variety of electrified S.U.V.s like the E-tron, is developing other designs as pure electrics, said an Audi of America spokesman, Mark Dahncke."
                                            },
                                            {
                                                "example_id": "022cd8c7-f477-4e55-aa03-021152fe2bea",
                                                "sense_id": "d0aba0b0-ba19-3bbf-9c3d-fbd74fe61dc6",
                                                "text": "For the whole year, the exotic automaker sold 7,430 cars and SUVs, down 9.5% compared to 2019. But the last quarter of 2020 was the best in the Italian supercar maker’s history and its order banks are already filled for the first nine months of 2021, Lamborghini CEO Stephan Winkelmann said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
