{
    "word_family": [
        "fiddle",
        "fiddler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "395c9c0b-2cc6-3a8c-899f-87aa7086f3ae",
                    "sense_definition": "Present participle and gerund of <w>fiddle</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>fiddling</w> with his keys while waiting for the bus.",
                            "target_lang_translations": {
                                "cs": "Zatímco čekal na autobus, <w>si pohrával</w> s klíči.",
                                "nl": "Hij was met zijn sleutels aan het <w>friemelen</w> terwijl hij op de bus wachtte."
                            }
                        },
                        {
                            "text": "Stop <w>fiddling</w> with your hair during the meeting.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>si pohrávat</w> s vlasy během schůzky.",
                                "nl": "Stop met <w>friemelen</w> aan je haar tijdens de vergadering."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fiddling with"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybování prsty nebo předměty, často z nervozity nebo nudy.",
                        "nl": "Het onrustig met de vingers of een voorwerp spelen, vaak uit nervositeit of verveling."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pohrávat si",
                                "target_lang_sense_clarification": "manipulace s předmětem v rukou"
                            },
                            {
                                "target_lang_word": "vrtět se",
                                "target_lang_sense_clarification": "neklidné pohyby"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "friemelen",
                                "target_lang_sense_clarification": "onrustig met de vingers spelen"
                            },
                            {
                                "target_lang_word": "prutsen",
                                "target_lang_sense_clarification": "onhandig of doelloos met iets bezig zijn"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca3ccb6c-04cd-3665-80a2-035d83670b55",
                    "sense_definition": "The act of making small, often dishonest or unnecessary adjustments or manipulations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant was accused of <w>fiddling</w> with the company's financial records.",
                            "target_lang_translations": {
                                "cs": "Účetní byl obviněn z <w>manipulace</w> s finančními záznamy společnosti.",
                                "nl": "De accountant werd beschuldigd van het <w>frauderen</w> met de financiële administratie van het bedrijf."
                            }
                        },
                        {
                            "text": "After much <w>fiddling</w> with the settings, the machine finally started working correctly.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém <w>nastavování</w> přístroje stroj konečně začal správně fungovat.",
                                "nl": "Na veel <w>gepiel</w> met de instellingen begon de machine eindelijk goed te werken."
                            }
                        }
                    ],
                    "synonyms": [
                        "tampering",
                        "manipulation"
                    ],
                    "target_lang_definitions": {
                        "cs": "Provádění drobných, často nečestných nebo zbytečných úprav či manipulací.",
                        "nl": "Het verrichten van kleine, vaak oneerlijke of onnodige aanpassingen of manipulaties."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "manipulace",
                                "target_lang_sense_clarification": "nečestné ovlivňování dat"
                            },
                            {
                                "target_lang_word": "kutilství",
                                "target_lang_sense_clarification": "zdlouhavé nastavování či opravování"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "fraude",
                                "target_lang_sense_clarification": "oneerlijke manipulatie van gegevens"
                            },
                            {
                                "target_lang_word": "gepiel",
                                "target_lang_sense_clarification": "langdurig en pietluttig werk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bb87929-5a3a-36b2-a64c-6b2b502a1174",
                    "sense_definition": "Of very small or trivial importance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent hours arguing over <w>fiddling</w> details that did not matter.",
                            "target_lang_translations": {
                                "cs": "Strávili hodiny hádkami o <w>malicherných</w> detailech, na kterých nezáleželo.",
                                "nl": "Ze besteedden uren aan ruziën over <w>onbeduidende</w> details die er niet toe deden."
                            }
                        },
                        {
                            "text": "It was a <w>fiddling</w> amount of money compared to the total cost.",
                            "target_lang_translations": {
                                "cs": "Byla to <w>nepatrná</w> částka peněz v porovnání s celkovými náklady.",
                                "nl": "Het was een <w>futiel</w> bedrag in vergelijking met de totale kosten."
                            }
                        }
                    ],
                    "synonyms": [
                        "trivial",
                        "petty",
                        "insignificant"
                    ],
                    "antonyms": [
                        "significant",
                        "important"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající velmi malý nebo zanedbatelný význam.",
                        "nl": "Van zeer gering of onbeduidend belang."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "malicherný",
                                "target_lang_sense_clarification": "týkající se nepodstatných detailů"
                            },
                            {
                                "target_lang_word": "nepatrný",
                                "target_lang_sense_clarification": "velmi malý rozsahem či hodnotou"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "onbeduidend",
                                "target_lang_sense_clarification": "van weinig belang"
                            },
                            {
                                "target_lang_word": "futiel",
                                "target_lang_sense_clarification": "zeer klein of onbelangrijk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}