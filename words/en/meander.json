{
    "word_family": [
        "meanderingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "870cccbd-90d9-3b5a-9b20-1fb2ed0279e6",
                    "sense_definition": "To follow a winding or indirect course",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small river <w>meanders</w> through the quiet valley.",
                            "target_lang_translations": {
                                "ru": "Маленькая речка <w>извивается</w> по тихой долине."
                            }
                        },
                        {
                            "text": "We spent the afternoon <w>meandering</w> along the forest path.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня мы провели, <w>бродя</w> по лесной тропинке."
                            }
                        }
                    ],
                    "synonyms": [
                        "wind",
                        "wander"
                    ],
                    "common_phrases": [
                        "meander through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти по извилистому пути; медленно бродить без четкой цели или извиваться (о реке, дороге)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "о реке или дороге"
                            },
                            {
                                "target_lang_word": "петлять",
                                "target_lang_sense_clarification": "делать изгибы, менять направление"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "неспешно гулять без четкой цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc305233-411c-368f-bb3f-854254f922c4",
                    "sense_definition": "To speak or write in a rambling or indirect way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor tended to <w>meander</w> during his long lectures.",
                            "target_lang_translations": {
                                "ru": "Профессор имел склонность <w>уклоняться от темы</w> во время своих длинных лекций."
                            }
                        },
                        {
                            "text": "His long story <w>meandered</w> from one topic to another without focus.",
                            "target_lang_translations": {
                                "ru": "Его длинный рассказ <w>перескакивал</w> с одной темы на другую без какой-либо цели."
                            }
                        }
                    ],
                    "synonyms": [
                        "ramble",
                        "digress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить или писать бессвязно, пространно, отклоняясь от темы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклоняться от темы",
                                "target_lang_sense_clarification": "отвлекаться в речи или тексте"
                            },
                            {
                                "target_lang_word": "растекаться мыслью по древу",
                                "target_lang_sense_clarification": "говорить пространно и бессистемно"
                            },
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "перескакивать с темы на тему"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e177ad4b-95b7-3b32-b57e-95dba30aefbf",
                    "sense_definition": "A winding curve or bend in a river or path",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river creates many <w>meanders</w> across the flat landscape.",
                            "target_lang_translations": {
                                "ru": "Река образует множество <w>излучин</w> на равнинном ландшафте."
                            }
                        },
                        {
                            "text": "Geologists study how a river changes its <w>meander</w> over time.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают то, как река меняет свой <w>изгиб</w> с течением времени."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавный изгиб, петля или излучина реки либо тропинки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меандр",
                                "target_lang_sense_clarification": "плавный изгиб русла реки (географический термин)"
                            },
                            {
                                "target_lang_word": "излучина",
                                "target_lang_sense_clarification": "крутой поворот или изгиб реки"
                            },
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "петля или поворот русла либо дороги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffefdb38-38ac-3762-b555-de3036f5fb74",
                    "sense_definition": "A decorative border pattern consisting of repeated lines",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient vase was decorated with a classic <w>meander</w> pattern.",
                            "target_lang_translations": {
                                "ru": "Древняя ваза была украшена классическим узором <w>меандра</w>."
                            }
                        },
                        {
                            "text": "Intricate <w>meanders</w> were carved into the stone frame of the door.",
                            "target_lang_translations": {
                                "ru": "Замысловатые <w>меандры</w> были высечены на каменной раме двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "Greek key"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древний декоративный орнамент в виде непрерывной ломаной или спиралевидной линии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меандр",
                                "target_lang_sense_clarification": "геометрический орнамент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "975e3af4-691e-387b-901b-b2d4e5918e54",
                    "sense_definition": "A town in Tasmania, Australia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small town of <w>Meander</w> during their trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они посетили небольшой городок <w>Миандер</w>."
                            }
                        },
                        {
                            "text": "The local council manages the region surrounding <w>Meander</w>.",
                            "target_lang_translations": {
                                "ru": "Местный совет управляет регионом, окружающим <w>Миандер</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Тасмании, Австралия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миандер",
                                "target_lang_sense_clarification": "географическое название города в Тасмании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}