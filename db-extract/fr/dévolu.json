                    },
                    {
                        "form_id": "792d1004-1aeb-4540-aa2b-ff5ceae2d0c9",
                        "entry_id": "793c51d5-22f0-3fdc-a5ba-2da9a300b528",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "dévolues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e398397-7707-3ae7-a0c2-6523a6402931",
                        "entry_id": "793c51d5-22f0-3fdc-a5ba-2da9a300b528",
                        "glosses": [
                            "Transféré d’une personne à une autre, qui est échu à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f4e15a-aa80-4fd5-b91d-ad87a514d519",
                                "sense_id": "0e398397-7707-3ae7-a0c2-6523a6402931",
                                "text": "De temps en temps les sauvages m’invitaient à descendre et à me laisser tuer avant la fin du jour, afin de leur épargner la peine de me dépecer pendant la nuit. J’étais dévolu pièce par pièce aux différents chefs dont chacun désignait celle qu’il voulait avoir."
                            },
                            {
                                "example_id": "87e7e33c-7314-43fa-8e18-9120446b7999",
                                "sense_id": "0e398397-7707-3ae7-a0c2-6523a6402931",
                                "text": "Pierre Savary avait au surplus l'administration des fiefs de Boutervilliers et de la Grimbardière, dévolus à ses enfants sur la succession de sa femme."
                            }
                        ]
                    },
                    {
                        "sense_id": "838c8eba-c82a-300d-bff4-b17b44f50cda",
                        "entry_id": "793c51d5-22f0-3fdc-a5ba-2da9a300b528",
                        "glosses": [
                            "Affecté, consacré à une personne ou un usage."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d192d31e-8d4b-4e22-b726-fcf64b0cc38e",
                                "sense_id": "838c8eba-c82a-300d-bff4-b17b44f50cda",
                                "text": "Les aciers les plus purs, les chefs-d’œuvre de la métallurgie et de la balistique sont dévolus aux engins de destruction."
                            },
                            {
                                "example_id": "888581f0-faab-4a7d-b1eb-e12de53bc91f",
                                "sense_id": "838c8eba-c82a-300d-bff4-b17b44f50cda",
                                "text": "9e \"Nuit blanche\" à Paris, dévolue à l'art contemporain"
                            },
                            {
                                "example_id": "ccb58df7-be42-432a-940e-9b42334c6c0f",
                                "sense_id": "838c8eba-c82a-300d-bff4-b17b44f50cda",
                                "text": "Les allocations familiales sont dévolues à l'éducation et à l'instruction, donc la collectivité intervient déjà pour les frais scolaires."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
