                "senses": [
                    {
                        "sense_id": "1fed88a2-f069-31f6-ad48-3a8b9fc97d44",
                        "entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "glosses": [
                            "A powerful angel that leads many other angels, but is still loyal to a deity, and often seen as belonging to a particular archangelical rank or order within a greater hierarchy of angels. (Judeo-Christian examples: Gabriel, Michael, Raphael, Uriel)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "82aeb8d8-1607-3f8a-87c6-a571bf9b386f",
                        "entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "glosses": [
                            "Synonym of angelica (“the garden herb”)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4911e6cf-2cff-4e08-8cff-522672d7d88e",
                        "source_entry_id": "bf25daf5-8a72-3fc8-b6f3-91d65d9eeb41",
                        "source_sense_description": "angel who leads other angels",
                        "target_lang_word": "archanděl",
