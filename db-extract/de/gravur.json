                ],
                "senses": [
                    {
                        "sense_id": "ee584e85-8300-3b44-ba2a-b35c230b82be",
                        "entry_id": "49cdfb52-d550-35a4-b840-91649a7893db",
                        "glosses": [
                            "durch Ausschneiden/Ausstechen aus einem harten Material hergestellte Verzierung (Bild oder Schrift)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d662250-2a98-49ab-801e-9c63fbd119a5",
                                "sense_id": "ee584e85-8300-3b44-ba2a-b35c230b82be",
                                "text": "„Mit einem angefeuchteten Papier wieder aus den Vertiefungen herausgezogen, ergab die Farbe ein seitenverkehrtes Abbild der Gravur.“"
                            },
                            {
                                "example_id": "30196b8f-98cf-4f96-a8da-266392397e03",
                                "sense_id": "ee584e85-8300-3b44-ba2a-b35c230b82be",
                                "text": "„Zwar wurde die Qualität von Gravur zu Gravur etwas besser, aber Pablo Emilio Coni war mit dem Resultat alles andere als zufrieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "376c3adf-334c-4a90-b5b9-e186a514ea77",
                        "source_entry_id": "49cdfb52-d550-35a4-b840-91649a7893db",
                        "source_sense_id": "ee584e85-8300-3b44-ba2a-b35c230b82be",
                        "source_sense_description": "durch Ausschneiden/Ausstechen aus einem harten Material hergestellte Verzierung (Bild oder Schrift)",
                        "target_lang_word": "engraving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engraving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02e82fae-ca43-3723-883e-b0360ae1f1fc",
                                        "entry_id": "d700c69d-480a-3961-a134-7f9690a4bdb3",
                                        "glosses": [
                                            "The practice of incising a design onto a hard surface, by cutting grooves into it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f09afc6a-fd24-3af4-9e5c-a22fd4f35b8b",
                                        "entry_id": "d700c69d-480a-3961-a134-7f9690a4bdb3",
                                        "glosses": [
                                            "The art of producing an image from an engraved printing form, typically made of copper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c332352-bd9f-307b-8bf8-e6897f5c1d6c",
                                        "entry_id": "d700c69d-480a-3961-a134-7f9690a4bdb3",
                                        "glosses": [
                                            "A print produced from an engraving."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6da7ad9-e1c9-4d34-9aec-1f65c19aea42",
                                                "sense_id": "6c332352-bd9f-307b-8bf8-e6897f5c1d6c",
                                                "text": "He looked round the poor room, at the distempered walls, and the bad engravings in meretricious frames, the crinkly paper and wax flowers on the chiffonier; and he thought of a room like Father Bryan's, with panelling, with cut glass, with tulips in silver pots, such a room as he had hoped to have for his own."
                                            },
                                            {
                                                "example_id": "8ae390ce-873c-44e5-9624-602b1f666c1c",
                                                "sense_id": "6c332352-bd9f-307b-8bf8-e6897f5c1d6c",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2fb1c5-0a9f-375e-800c-9350756bd542",
                                        "entry_id": "d700c69d-480a-3961-a134-7f9690a4bdb3",
                                        "glosses": [
                                            "The art of drawing music notation at high quality, particularly on a computer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "engraving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "920e2c94-2e4b-3aa2-bcea-5bbc21c5b665",
                                        "entry_id": "f06e3d6d-6c49-3ed2-97cd-79975310d8b0",
