                                        "examples": [
                                            {
                                                "example_id": "0753ab11-bfca-4bc7-a92a-d30c7d807b0d",
                                                "sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                                                "text": "Although Brogan sees the history as a “medley of fiction and wishful thinking,” he is deeply impressed with Tocqueville’s pioneering use of local archives, which allowed him to lay out the continuity between prerevolutionary and postrevolutionary France."
                                            },
                                            {
                                                "example_id": "dbbe6dda-56ce-4cfa-9f13-7435307443cc",
                                                "sense_id": "02486649-daff-3095-9f9b-e58e28d80feb",
                                                "text": "But there are those within the senior ranks of the Party who count you among the heroes of the prerevolutionary cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
