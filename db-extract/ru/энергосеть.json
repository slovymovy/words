                        "translation_id": "120834b3-379c-4be7-b510-5466098a3c50",
                        "source_entry_id": "71c297cc-1d17-373d-940c-534083e4f419",
                        "source_sense_id": "8a117a90-2e4e-3a79-aa2d-c4d866beb33d",
                        "target_lang_word": "power grid",
                        "target_lang_code": "en",
