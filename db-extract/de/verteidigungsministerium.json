                        ],
                        "form": "das Verteidigungsministerium"
                    },
                    {
                        "form_id": "552d7f9a-3bba-4b6b-9a2d-0506df40f4c5",
                        "entry_id": "7b0bc1e6-046a-3268-a3ef-9a74e20e9c4c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verteidigungsministerien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce0c5c77-f722-3bf9-b048-a368abfeaac1",
                        "entry_id": "7b0bc1e6-046a-3268-a3ef-9a74e20e9c4c",
                        "glosses": [
                            "Ministerium, das für die militärischen Angelegenheiten eines Staates zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9accd12-baeb-4cf6-b814-3b955ee2c469",
                                "sense_id": "ce0c5c77-f722-3bf9-b048-a368abfeaac1",
                                "text": "„Das World Trade Center in New York, Symbol der Wirtschafts- und Finanzmacht der USA, und das Verteidigungsministerium in Washington, das für die militärische Potenz der einzig verbliebenen Supermacht steht, wurden am 11. September 2001 Ziel der verheerendsten Anschläge in der Geschichte des internationalen Terrorismus.“"
                            },
                            {
                                "example_id": "bfc3d85e-135e-4bb0-a906-a7a0d10c56ac",
                                "sense_id": "ce0c5c77-f722-3bf9-b048-a368abfeaac1",
                                "text": "„Das amerikanische Verteidigungsministerium etwa pflegt verständlicherweise die Zuverlässigkeit von Software, von der das Gelingen einer militärischen Aktion abhängt, mit sehr strengen – und teuren – Verfahren zu überprüfen.“"
                            },
                            {
                                "example_id": "c528d539-7d11-4088-bbe2-ae7cd8b07fae",
                                "sense_id": "ce0c5c77-f722-3bf9-b048-a368abfeaac1",
                                "text": "„Nach einer Pannenserie schafft das deutsche Verteidigungsministerium drei neue Maschinen für die Flugbereitschaft an.“"
                            },
                            {
                                "example_id": "60dba427-7d7a-4760-a429-e9c12f92e17b",
                                "sense_id": "ce0c5c77-f722-3bf9-b048-a368abfeaac1",
                                "text": "„Jedenfalls sind weder im Verteidigungsministerium noch bei der Wehrbeauftragten des Deutschen Bundestages Klagen oder Disziplinarfälle oder gar Gerichtsverfahren in Sachen Anrede bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
