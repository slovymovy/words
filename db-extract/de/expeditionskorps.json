                            {
                                "example_id": "7042e860-5209-4c79-9b0b-a05551784333",
                                "sense_id": "70f39093-bcbb-3a6b-96b7-d6db6fe3ab61",
                                "text": "„Dort hatte sich ein Expeditionskorps der Marine eingeschifft.“"
                            },
                            {
                                "example_id": "1c904b8e-4f57-451c-9e78-1013b8c6d9b2",
                                "sense_id": "70f39093-bcbb-3a6b-96b7-d6db6fe3ab61",
                                "text": "„Die Briten hatten sich mehrere Jahrzehnte eine außenpolitische Zurückhaltung in Indien auferlegt. Lytton aber sandte ein Expeditionskorps nach Afghanistan, das dort bis auf einen Mann den Tod fand.“"
                            }
                        ],
