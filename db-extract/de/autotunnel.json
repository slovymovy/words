                        "glosses": [
                            "Tunnel, der dafür gebaut wurde, dass er von Personenkraftwagen durchfahren wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd99ba3-443d-4487-8fca-740c49ce6bf7",
                                "sense_id": "82e59696-6d89-3b8c-a93e-46a2bb936399",
                                "text": "„Der Straßentunnel durch den Großen Sankt Bernhard, der erste große Autotunnel durch die Alpen, wird für den Verkehr freigegeben.“"
                            },
                            {
                                "example_id": "ab7e9082-a62c-4a1e-bc85-5a1895bc82ec",
                                "sense_id": "82e59696-6d89-3b8c-a93e-46a2bb936399",
                                "text": "„Der Autotunnel unter dem Montblanc war nach der Katastrophe für rund 350 Millionen Euro jahrelang renoviert und mit modernen Kontroll- und Entlüftungsanlagen ausgestattet worden.“"
                            },
                            {
                                "example_id": "b48ac400-5345-46db-bc94-39814b5500cb",
                                "sense_id": "82e59696-6d89-3b8c-a93e-46a2bb936399",
                                "text": "„Eine Explosion bei Bauarbeiten in einem Autotunnel in China hat mindestens 20 Menschen das Leben gekostet.“"
                            }
                        ],
