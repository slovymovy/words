                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc2bb20a-64b4-35ed-a2bc-1d8603da6122",
                        "entry_id": "e85ce162-d39b-3a02-9155-c69c6a0e2c1e",
                        "glosses": [
                            "A female given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c38375b2-38e3-4512-844f-7213d30b441c",
                                "sense_id": "fc2bb20a-64b4-35ed-a2bc-1d8603da6122",
                                "text": "Hunsdon did first present her to mine eyen; / Bright is her hue, and Geraldine she hight."
                            },
                            {
                                "example_id": "cd441bc9-6cf2-47cf-92da-227ebc31e226",
                                "sense_id": "fc2bb20a-64b4-35ed-a2bc-1d8603da6122",
                                "text": "Alberta is more like a man's name than any other name that comes from a men's, more than Georgianna which is just like a magnolia blossom or Henrietta which most people change to Etta or Geraldine which nobody ever thinks of coming from a man's Irish name like Gerald."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc23b283-4a44-3cf2-b2e0-6c32427440d3",
                        "entry_id": "e85ce162-d39b-3a02-9155-c69c6a0e2c1e",
                        "glosses": [
