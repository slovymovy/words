                ],
                "senses": [
                    {
                        "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                        "entry_id": "09c6da48-6df8-3f0d-a059-f84910604ca3",
                        "glosses": [
                            "Diminutive of dragon."
                        ],
                        "tags": [
                            "diminutive",
                            "form-of",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d2b68537-4e74-4e52-80f3-f7d026d437f3",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": ">(Gets an offended look) Don't listen to him, Patricia!!!\n>\n>-Kazul\nWas I offensive, my little draggy-poo? I so sowwy.\nBTW, have you ever heard of the SciFi story called \"The Game of Rat and Dragon\"?"
                            },
                            {
                                "example_id": "72f8c797-eef0-431c-ad30-5ae52685bdb1",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": "> Once there was a dragon […] > Thank you everyone, for making this little draggy feel right at home."
                            },
                            {
                                "example_id": "955d7d18-0acd-4d7d-b2cc-84363ee9a59c",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": "‘[…] He is just SO cute, aren’t you, my little baby draggy yum yums?’ / ‘Baby draggy yum yums?’ repeated Borgon. ‘Look what he did to my axe!’"
                            },
                            {
                                "example_id": "5ae0afd3-8813-4ccd-8994-b6a017147076",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": "The blood drained from his face as he turned to see the dragon crouched low, watching them. “Nice, draggy, draggy,” Josette breathed in a singsongy tone."
                            },
                            {
                                "example_id": "3794a1c9-b7f6-43b2-ab26-eacf96ddc544",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": "“Here Draggy, Draggy, Draggy, where are you, you sadistic whelp” taunted Grinsfeld as he crept down the staircase into the dungeon."
                            },
                            {
                                "example_id": "4cdbccce-0f3e-4385-a623-77386bb283fb",
                                "sense_id": "67691146-2e3e-3e9a-8ef9-5a0631b22f7d",
                                "text": "Lisa backed away as the beast opened its jaws. “Good dragon. Who’s a good draggy? Queen draggy.[…]”"
                            }
                        ]
                    }
