                    {
                        "sense_id": "0a453304-f395-38e7-aa82-24dae3e73ab1",
                        "entry_id": "13473172-46a7-379e-87ea-6ffe0677f881",
                        "glosses": [
                            "kapsel waarbij het haar zo geknipt is dat het lijkt of er een omgekeerde bloempot op het hoofd was geplaatst waarna wat daar onderuit kwam, weggeknipt werd (in andere talen eerder vergeleken met een kommetje)"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "73ad1a83-7257-4a3d-a005-3bc4cfe41612",
                                "sense_id": "0a453304-f395-38e7-aa82-24dae3e73ab1",
                                "text": "Deze pagina bewijst dat de markante, gladgeschoren kin en het strenge bloempotkapsel binnen de Amsterdamse politiegelederen duidelijk aan populariteit verliezen, zodat er een verzachting van gelaatstrekken ontstaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e782ec3-72a6-4bf0-8cde-028ba7230284",
                        "source_entry_id": "13473172-46a7-379e-87ea-6ffe0677f881",
                        "source_sense_id": "0a453304-f395-38e7-aa82-24dae3e73ab1",
                        "target_lang_word": "Topfschnitt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Topfschnitt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a64bd0-07a2-3a8a-86f0-b2f7536f5d4a",
                                        "entry_id": "b2aa6ec6-b02f-3643-9e0f-ac67ef7eb54e",
                                        "glosses": [
                                            "Haarschnitt, bei der alle Haare auf etwa der gleichen Höhe enden beziehungsweise die gleiche Länge haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739fe186-6612-4c49-b973-52bc0d13e19f",
                                                "sense_id": "c3a64bd0-07a2-3a8a-86f0-b2f7536f5d4a",
                                                "text": "„Auf diesem süßen Foto zeigt er sich schüchtern, niedlich und mit einem wundervollen Topfschnitt.“"
                                            },
                                            {
                                                "example_id": "c3f88cea-96ec-4367-bfc2-7068d8ed0624",
                                                "sense_id": "c3a64bd0-07a2-3a8a-86f0-b2f7536f5d4a",
                                                "text": "„Der britische Premier Boris Johnson sieht ja immer ein wenig so aus, als sei er Catweazel, der nach einem Topfschnitt mit der Heckenschere in die Steckdose gefasst hat und schließlich in einen Orkan geraten ist.“"
                                            },
                                            {
                                                "example_id": "79b5872a-ac73-4124-b506-cab293987064",
                                                "sense_id": "c3a64bd0-07a2-3a8a-86f0-b2f7536f5d4a",
                                                "text": "„Da war Karl, der Junge mit dem Topfschnitt, der mir seine Edelsteine gezeigt hat, die er in einer kleinen Schachtel immer in seiner Jackentasche hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fef27c7-b686-4003-9b55-f6ab139a7d17",
                        "source_entry_id": "13473172-46a7-379e-87ea-6ffe0677f881",
                        "source_sense_id": "0a453304-f395-38e7-aa82-24dae3e73ab1",
