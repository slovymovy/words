                "senses": [
                    {
                        "sense_id": "f652343f-1603-3f0d-8e23-72b1d55aebd6",
                        "entry_id": "440e4731-1859-3487-9c0c-453639d2bf06",
                        "glosses": [
                            "fiktives, sehr hartes Metall, Mineral"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1185e887-e668-45e8-9e72-d3f6b5029098",
                                "sense_id": "f652343f-1603-3f0d-8e23-72b1d55aebd6",
                                "text": "„Die Ketten bestanden aus einem unzerbrechlichen Metall namens Adamant, das Jupiter selbst zu Tage gefördert hatte. Nur Herkules war stark genug, um die Kette zu zerreißen und Prometheus zu befreien.“"
                            },
                            {
                                "example_id": "89299575-81ed-4041-b7b6-a1e436f9d12c",
                                "sense_id": "f652343f-1603-3f0d-8e23-72b1d55aebd6",
                                "text": "„Hier wird dem Magnetit der Name Adamant gegeben, der ihm nicht zukommt; im Gegenteil ist der Adamant eigentlich der Diamant und der ärgste Feind des Magnetit, denn dieser ist stärker als der sonst ‚Unüberwindliche‘.“"
                            },
                            {
                                "example_id": "6347c764-bf2f-499a-8999-7b31aedfe2fd",
                                "sense_id": "f652343f-1603-3f0d-8e23-72b1d55aebd6",
                                "text": "„Als Adamant wurden vorwiegend Diamanten und Saphire sowie Eisen, Eisenlegierungen mit Magnetit bzw. Eisenstahl bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f0fdcac-1577-311d-8f25-83789fffd7c1",
                        "entry_id": "440e4731-1859-3487-9c0c-453639d2bf06",
                        "glosses": [
                            "sehr harter Edelstein, Diamant"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f260a86f-e9c9-4d58-a57c-bcca4145f568",
                                "sense_id": "2f0fdcac-1577-311d-8f25-83789fffd7c1",
                                "text": "„Hier wird dem Magnetit der Name Adamant gegeben, der ihm nicht zukommt; im Gegenteil ist der Adamant eigentlich der Diamant und der ärgste Feind des Magnetit, denn dieser ist stärker als der sonst ‚Unüberwindliche‘.“"
                            },
                            {
                                "example_id": "2e6ac3f3-2ca8-475a-894c-448ea352699f",
                                "sense_id": "2f0fdcac-1577-311d-8f25-83789fffd7c1",
                                "text": "„Als Adamant wurden vorwiegend Diamanten und Saphire sowie Eisen, Eisenlegierungen mit Magnetit bzw. Eisenstahl bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc3bcbee-d1e8-4511-985a-37e393142790",
                        "source_entry_id": "440e4731-1859-3487-9c0c-453639d2bf06",
                        "source_sense_id": "f652343f-1603-3f0d-8e23-72b1d55aebd6",
                        "source_sense_description": "kein Plural: fiktives, sehr hartes Metall, Mineral",
                        "target_lang_word": "adamant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adamant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                                        "entry_id": "30558553-d779-3022-aae0-74c4459f386e",
                                        "glosses": [
                                            "Firm; unshakeable; unyielding; determined."
                                        ],
                                        "tags": [
                                            "said of people and their conviction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1daba1-9aa4-49cd-b822-c6395b3c4969",
                                                "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                                                "text": "Broiles and Kirkley were adamant about getting out of the lawsuit, but Mike and Dee were equally adamant about not wanting to sign a letter of apology"
                                            },
                                            {
                                                "example_id": "6f70ba9f-5c72-48b7-95c5-1fd9b4b2b583",
                                                "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                                                "text": "Johan is determined to play the field and adamant about never committing."
                                            },
                                            {
                                                "example_id": "5b404ed3-85ee-4dd1-93ac-37b085cca0a8",
                                                "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                                                "text": "What good would such foolishness do a mountain man? But Pa had been adamant. Just as he'd been adamant about their reading, writing, numbers, geography, and languages. Just as he'd been adamant about using proper grammar"
                                            },
                                            {
                                                "example_id": "5da349c4-ca3a-4c91-bba8-5c0fbd66757a",
                                                "sense_id": "adc2f7bb-12e8-3bd4-b745-6af2568b9d76",
                                                "text": "Most Panamanians are adamant that the canal, completed in 1914, will not return to U.S. control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4a743f-f79d-3015-ab32-52e650d02315",
                                        "entry_id": "30558553-d779-3022-aae0-74c4459f386e",
                                        "glosses": [
                                            "Very difficult to break, pierce, or cut."
                                        ],
                                        "tags": [
                                            "of an object"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb80cde5-465a-4d82-82e7-fe428b498ed0",
                                                "sense_id": "4a4a743f-f79d-3015-ab32-52e650d02315",
                                                "text": "Unprotected matter, however adamant, would have been ground to dust ages ago."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adamant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de95536b-8334-3908-9c46-f25001aa3787",
                                        "entry_id": "168402ad-94db-35fd-bae5-c02e23f22a5a",
                                        "glosses": [
                                            "An imaginary rock or mineral of impenetrable hardness; a name given to the diamond and other substances of extreme hardness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8b8fcd-2b51-4dc1-8359-76228344c7e5",
                                                "sense_id": "de95536b-8334-3908-9c46-f25001aa3787",
                                                "text": "This then is and alwayes hath ben the fashion of Worldlinges, & reprobate persons, to harden their hartes as an adamant stone, against anye thinge that shalbe tolde the for amendement of their lives, and for the savinge of their soules."
                                            },
                                            {
                                                "example_id": "d563f85e-a883-4dfd-8330-d8e6b7319ffe",
                                                "sense_id": "de95536b-8334-3908-9c46-f25001aa3787",
                                                "text": "As an adamant harder than flint have I made thy forehead …"
                                            },
                                            {
                                                "example_id": "6c11bd6f-9644-459b-a22e-4b0627a1fa16",
                                                "sense_id": "de95536b-8334-3908-9c46-f25001aa3787",
                                                "text": "But this was a finale she ever avoided: an offer, like the rock of adamant in Sinbad's voyages, finishes the attraction by destroying the vessel;..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6092bf1-97a6-380b-bba4-1a551330cba2",
                                        "entry_id": "168402ad-94db-35fd-bae5-c02e23f22a5a",
                                        "glosses": [
                                            "An embodiment of impregnable hardness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d593794-eca2-4fa1-9108-37d5b11aa40a",
                                                "sense_id": "e6092bf1-97a6-380b-bba4-1a551330cba2",
                                                "text": "Actual life might seem to her so real that she could not detect the union of shadow and adamant that men call poetry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968f12ae-3c88-326d-a01f-ba0b085934f1",
                                        "entry_id": "168402ad-94db-35fd-bae5-c02e23f22a5a",
                                        "glosses": [
                                            "A lodestone."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e980f269-58d4-42f6-a52d-785fda3138c9",
                                                "sense_id": "968f12ae-3c88-326d-a01f-ba0b085934f1",
                                                "text": "You draw me, you hard-hearted adamant:\nBut yet you draw not iron, for all my heart\nIs true as steel. Leave you your power to draw,\nAnd I shall have no power to follow you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f37eca-06bb-3484-8622-5adfd1d16997",
                                        "entry_id": "168402ad-94db-35fd-bae5-c02e23f22a5a",
                                        "glosses": [
                                            "A substance that neutralizes lodestones."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cbb55b-5a03-4cfd-a68d-faf18a26d9f9",
                                                "sense_id": "18f37eca-06bb-3484-8622-5adfd1d16997",
                                                "text": "An Adamant hinders the attractive vertue, as also Garlick rubbed on the Magnet; for its attractive faculty is not so valid, but it may be easily deluded, obscured, and superated […]"
                                            },
                                            {
                                                "example_id": "95733683-4c6a-47cb-8d1d-6d6879d5e8ee",
                                                "sense_id": "18f37eca-06bb-3484-8622-5adfd1d16997",
                                                "text": "But we know from book 37 of the Natural History that adamant works on magnets in exactly the same way that garlic does: robbing them of their power to attract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
