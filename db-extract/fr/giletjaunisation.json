                "senses": [
                    {
                        "sense_id": "fe699694-2760-381e-8b51-4c7d80783b39",
                        "entry_id": "67b97ed6-33cb-3963-b338-4093182953be",
                        "glosses": [
                            "Diffusion de l’idée de radicalité et de détermination des Gilets jaunes dans d’autres milieux sociaux, notamment dans les milieux syndicaux."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "6376afe9-049b-4ce8-9481-ec919d1be9a7",
                                "sense_id": "fe699694-2760-381e-8b51-4c7d80783b39",
                                "text": "Lors de la mobilisation contre la réforme des retraites qui a démarré en France en décembre 2019, on a ainsi pu parler d’une « giletjaunisation » des syndicats."
                            },
                            {
                                "example_id": "a679fcb2-01ed-4a73-89ed-39ae193da5cb",
                                "sense_id": "fe699694-2760-381e-8b51-4c7d80783b39",
                                "text": "C’est la « giletjaunisation » mondiale. Prenons les revendications économiques, il y a des éléments communs manifestes."
                            },
                            {
                                "example_id": "addb0141-c193-42b3-8392-e969bd946c55",
                                "sense_id": "fe699694-2760-381e-8b51-4c7d80783b39",
                                "text": "Dans Interdit d’interdire, Frédéric Taddeï anime un débat autour de la question des mouvements de protestation observables au Chili, en Catalogne, au Liban, en Algérie, à Hong Kong, etc. : assistons-nous à une « giletjaunisation » du monde ?"
                            },
                            {
                                "example_id": "7737bc4a-ee53-4fed-90a8-7cb916ef5a84",
                                "sense_id": "fe699694-2760-381e-8b51-4c7d80783b39",
                                "text": "Mais cet « effet Gilets jaunes » reste cependant limité : il est à cet égard inapproprié de parler d’une « giletjaunisation » du mouvement."
                            }
                        ]
                    }
                ],
