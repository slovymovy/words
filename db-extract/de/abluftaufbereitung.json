                "senses": [
                    {
                        "sense_id": "071d3956-2228-3971-9732-b3f3137d2462",
                        "entry_id": "acd0d4f7-91ec-3831-9f5e-ef4778c0bee4",
                        "glosses": [
                            "Vorbereitung der Abluft zur Abgabe ins Freie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f16285-79d5-44dc-ac20-340cb9672846",
                                "sense_id": "071d3956-2228-3971-9732-b3f3137d2462",
                                "text": "„Bei der thermischen Abluftaufbereitung werden oxidierbare Schadstoffe durch Verbrennung (Oxidation) mit Luftsauerstoff ohne Mitwirkung eines Katalysators in umweltverträgliche oder durch nachgeschaltete Reinigungstufen abtrennbare Stoffe umgewandelt.“"
                            },
                            {
                                "example_id": "6329431f-33ca-4da1-80d9-87e11302bec2",
                                "sense_id": "071d3956-2228-3971-9732-b3f3137d2462",
                                "text": "„Pneumatik ist sauber und kann mit einer korrekten Abluftaufbereitung gemäß Normen in Reinsträumen installiert werden.“"
                            },
                            {
                                "example_id": "d9e7c3ed-94b3-417d-a8b5-eb51d4d73f6f",
                                "sense_id": "071d3956-2228-3971-9732-b3f3137d2462",
                                "text": "„Energie aus der Abluftreinigung. Hohe Wirtschaftlichkeit bei Abluftaufbereitung mit Wärmerückgewinnungssystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
