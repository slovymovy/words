{
    "word_family": [
        "endeavorer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9463ffa-6b07-3df0-89d9-709204707910",
                    "sense_definition": "To attempt through application of effort to do something; to try strenuously.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist will <w>endeavor</w> to find a cure for the rare disease through years of research.",
                            "target_lang_translations": {
                                "ru": "Ученый будет <w>стараться</w> найти лекарство от редкого заболевания в течение многих лет исследований."
                            }
                        },
                        {
                            "text": "We must <w>endeavor</w> to finish the project before the deadline despite the many challenges.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>приложить все усилия</w>, чтобы закончить проект до дедлайна, несмотря на многочисленные трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "strive"
                    ],
                    "common_phrases": [
                        "endeavor to finish",
                        "endeavor to show"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться сделать что-либо, прилагая значительные усилия; усердно стараться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стараться",
                                "target_lang_sense_clarification": "прилагать усилия"
                            },
                            {
                                "target_lang_word": "пытаться",
                                "target_lang_sense_clarification": "делать попытку"
                            },
                            {
                                "target_lang_word": "прилагать усилия",
                                "target_lang_sense_clarification": "стремиться к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "731b4f52-a8e3-3132-8af6-c88db50d178e",
                    "sense_definition": "To work with purpose or to exert oneself toward a specific goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>endeavors</w> to show that the current economic system is unfair to the working class.",
                            "target_lang_translations": {
                                "ru": "Автор <w>стремится</w> показать, что нынешняя экономическая система несправедлива по отношению к рабочему классу."
                            }
                        },
                        {
                            "text": "She <w>endeavored</w> tirelessly to improve the living conditions in her local community.",
                            "target_lang_translations": {
                                "ru": "Она неустанно <w>старалась</w> улучшить условия жизни в своей местной общине."
                            }
                        }
                    ],
                    "synonyms": [
                        "strive"
                    ],
                    "common_phrases": [
                        "endeavor to show",
                        "endeavor tirelessly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Целенаправленно работать или усердно трудиться для достижения конкретной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "настойчиво желать достичь цели"
                            },
                            {
                                "target_lang_word": "прилагать усилия",
                                "target_lang_sense_clarification": "усердно трудиться"
                            },
                            {
                                "target_lang_word": "стараться",
                                "target_lang_sense_clarification": "делать всё возможное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9221348e-4fc1-361e-b8d2-d162d899ae72",
                    "sense_definition": "A sincere attempt or a determined effort towards a specific goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starting a new business is a risky <w>endeavor</w> that requires a lot of capital and planning.",
                            "target_lang_translations": {
                                "ru": "Открытие нового бизнеса — это рискованное <w>начинание</w>, требующее большого капитала и планирования."
                            }
                        },
                        {
                            "text": "The soldiers set upon a mighty <w>endeavor</w> to preserve their nation and set free a suffering humanity.",
                            "target_lang_translations": {
                                "ru": "Солдаты предприняли великое <w>усилие</w>, чтобы сохранить свою нацию и освободить страждущее человечество."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursuit",
                        "undertaking",
                        "enterprise",
                        "venture"
                    ],
                    "common_phrases": [
                        "mighty endeavor",
                        "risky endeavor",
                        "artistic endeavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренняя попытка или решительное усилие, направленное на достижение определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начинание",
                                "target_lang_sense_clarification": "новое дело или предприятие"
                            },
                            {
                                "target_lang_word": "усилие",
                                "target_lang_sense_clarification": "напряжение сил для достижения цели"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание добиться чего-либо"
                            },
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "действие с целью добиться результата"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}