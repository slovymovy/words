    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a86eaf04-591b-340b-a513-d7e47201605d",
                    "sense_definition": "Past participle of <w>eat</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>eaten</w> breakfast already, so I am not hungry.",
                            "target_lang_translations": {
                                "ru": "Я уже <w>съел</w> завтрак, поэтому не голоден.",
                                "zh": "我已经<w>吃过</w>早饭了，所以不饿。"
                            }
                        },
                        {
                            "text": "The delicious cake was <w>eaten</w> by the guests in minutes.",
                            "target_lang_translations": {
                                "ru": "Вкусный торт был <w>съеден</w> гостями за считанные минуты.",
                                "zh": "美味的蛋糕几分钟内就被客人们<w>吃掉</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consumed",
                        "devoured"
                    ],
                    "common_phrases": [
                        "have eaten",
                        "be eaten",
                        "get eaten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола <w>eat</w> (есть).",
                        "zh": "动词 eat 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съеденный",
                                "target_lang_sense_clarification": "страдательное причастие"
                            },
                            {
                                "target_lang_word": "съел",
                                "target_lang_sense_clarification": "форма прошедшего времени (активный залог)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃过",
                                "target_lang_sense_clarification": "表示动作已经完成"
                            },
                            {
                                "target_lang_word": "被吃掉",
                                "target_lang_sense_clarification": "用于被动语态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45bbc59a-9fd2-397e-9f17-71fff423aab8",
                    "sense_definition": "Having been consumed by eating.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She threw the half-<w>eaten</w> sandwich into the trash bin.",
                            "target_lang_translations": {
                                "ru": "Она выбросила наполовину <w>съеденный</w> сэндвич в мусорное ведро.",
                                "zh": "她把那个<w>吃剩的</w>三明治扔进了垃圾桶。"
                            }
                        },
                        {
                            "text": "The <w>eaten</w> fruit left a sticky mess on the table.",
                            "target_lang_translations": {
                                "ru": "<w>Съеденный</w> фрукт оставил липкий след на столе.",
                                "zh": "那个<w>被吃掉的</w>水果在桌子上留下了一片黏糊糊的污渍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "consumed",
                        "finished"
                    ],
                    "antonyms": [
                        "uneaten",
                        "untouched"
                    ],
                    "common_phrases": [
                        "half-eaten",
                        "partly eaten",
                        "moth-eaten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который съели или употребили в пищу.",
                        "zh": "指已经被吃掉或被消耗掉的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "съеденный",
                                "target_lang_sense_clarification": "в значении прилагательного"
                            },
                            {
                                "target_lang_word": "поеденный",
                                "target_lang_sense_clarification": "поврежденный (например, насекомыми)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吃剩的",
                                "target_lang_sense_clarification": "指吃了一部分剩下的"
                            },
                            {
                                "target_lang_word": "被吃掉的",
                                "target_lang_sense_clarification": "描述已经完成进食动作的对象"
                            }
                        ]
