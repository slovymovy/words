                "senses": [
                    {
                        "sense_id": "5526ef4d-fcbd-3f32-97f7-2cb6780d3a79",
                        "entry_id": "c98e5d99-48cc-32a5-8b75-c4f4a30a3ee3",
                        "glosses": [
                            "woman (adult female human)"
                        ],
                        "tags": [
                            "colloquial",
                            "dialectal",
                            "feminine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                        "entry_id": "c98e5d99-48cc-32a5-8b75-c4f4a30a3ee3",
                        "glosses": [
                            "woman (wife or lover)"
                        ],
                        "tags": [
                            "colloquial",
                            "dialectal",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "eb0096a0-0ea9-48f4-992b-6f32960e0bd4",
                                "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                                "text": "Moja kobita me kocha.",
                                "translation": "My wife loves me.",
                                "english": "My wife loves me."
                            },
                            {
                                "example_id": "4e2cf1e5-e7ae-4307-aab6-497f0c54c00c",
                                "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                                "text": "Wysyła kobite swojo.",
                                "translation": "He's sending his wife.",
                                "english": "He's sending his wife."
                            },
                            {
                                "example_id": "aae68da9-eafd-46a7-8231-fddd3b83811d",
                                "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                                "text": "utoplecowa kobita",
                                "translation": "wife of an utopiec appearing in the form of a frog",
                                "english": "wife of an utopiec appearing in the form of a frog"
                            },
                            {
                                "example_id": "9f53a992-334c-44c0-be78-e866d5c4cc53",
                                "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                                "text": "Z kobito i dziećmi swemi.",
                                "translation": "With his wife and kids.",
                                "english": "With his wife and kids."
                            },
                            {
                                "example_id": "ae42447d-8f47-41cb-9c5a-9dd20ba76f7e",
                                "sense_id": "324a84ca-6547-3b3e-acfb-8e70a32c8d83",
                                "text": "Na karczmie osadził pan ôgrodnika z jego kobitą.",
                                "translation": "The lord settled the gardener and his wife at the inn.",
                                "english": "The lord settled the gardener and his wife at the inn."
                            }
                        ]
                    }
                ],
