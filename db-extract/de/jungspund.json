                "senses": [
                    {
                        "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                        "entry_id": "ee5602a8-8f7e-3c4e-958e-09a6d2f95a63",
                        "glosses": [
                            "junge, unerfahrene Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5299d8f9-e0cb-4d6d-bc81-3ca4b120d59f",
                                "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                                "text": "Unser Nachbarsjunge ist ein richtiger Jungspund."
                            },
                            {
                                "example_id": "1bf3035e-fcfe-4470-a4c0-e56ed44a6b63",
                                "sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                                "text": "Wer hier als Jungspund in die Tasten greift, atmet den Hauch der Romantik gratis."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c78e02bc-95e5-4f86-9d2d-6a44d3bd124e",
                        "source_entry_id": "ee5602a8-8f7e-3c4e-958e-09a6d2f95a63",
                        "source_sense_id": "39d0b851-4b60-31b2-abcd-c0746465b9e6",
                        "source_sense_description": "umgangssprachlich: junge, unerfahrene Person",
                        "target_lang_word": "whippersnapper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whippersnapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                                        "entry_id": "eae13369-1888-3f37-90b1-d2af9f1cc744",
                                        "glosses": [
                                            "A young and cheeky or presumptuous person; often with a connotation of ignorance via inexperience."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad9238ca-b878-4848-9b6b-2b4e27a1cc80",
                                                "sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                                                "text": "These whippersnappers have never had to walk far or carry water."
                                            },
                                            {
                                                "example_id": "d76064ad-f977-4296-b8e3-2cda3c303d79",
                                                "sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                                                "text": "\"Throw me a nine iron Fatman, I want to make sure of getting inside you young whippersnappers.\""
                                            },
                                            {
                                                "example_id": "20879719-5e21-4009-ab38-1ade7e39c2c7",
                                                "sense_id": "31d7815e-03ed-3cc3-ac5d-253c8823aa97",
                                                "text": "Eisenhower thought that the President-elect, his junior by over 25 years, was merely a \"young whippersnapper.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
