                        ],
                        "form": "den Oberlippenbart"
                    },
                    {
                        "form_id": "94c1867b-96a7-4fa9-acbe-09973ac67c16",
                        "entry_id": "b63be6ab-5133-3cc4-a38f-3d06ba4ae061",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Oberlippenbärte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                        "entry_id": "b63be6ab-5133-3cc4-a38f-3d06ba4ae061",
                        "glosses": [
                            "Bart auf der Oberlippe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ea5ace-c491-4dab-92a3-4f126472a909",
                                "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                                "text": "Siehst du da hinten den Mann mit dem Oberlippenbart?"
                            },
                            {
                                "example_id": "05c4eb64-a69a-4415-a0b1-c70235f333f8",
                                "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                                "text": "„Ich nickte und sah zu, wie die Spitzen seines Oberlippenbarts im Wind ruderten.“"
                            },
                            {
                                "example_id": "ed5098db-bba4-40a2-ad80-72d5851c58cc",
                                "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                                "text": "„Im Gegensatz zu seinen Vorgängern, die sich mit langen, gefärbten Vollbärten schmückten, trat er eher europäisch auf, mit gepflegtem Oberlippenbart und glatt rasiertem Kinn.“"
                            },
                            {
                                "example_id": "0c426340-ede1-454a-8fe6-d63f5b5754b5",
                                "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                                "text": "„Sein Haar war schwarz wie Schuhwichse, und er trug einen schmalen Oberlippenbart, vermutlich um sein weiches, fast noch jugendliches Gesicht älter wirken zu lassen.“"
                            },
                            {
                                "example_id": "a8e6e0af-e292-40a1-b305-cf6b6225109d",
                                "sense_id": "fb0ab56d-d082-3865-9b9c-dc2c042b1b00",
                                "text": "„Der Bierschaum blieb auf dem Oberlippenbart hängen, und Elma verspürte einen starken Drang, sich nach vorne zu beugen und ihn mit dem Daumen wegzuwischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
