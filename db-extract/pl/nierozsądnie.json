                        "translation_id": "81e066e2-ef98-46fa-87e8-a2f264c9f944",
                        "source_entry_id": "a4bd7319-031b-3f5b-8f26-b922a69a5442",
                        "source_sense_id": "d5c2307b-4640-3a21-898d-308f949c9ddc",
                        "target_lang_word": "unreasonably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unreasonably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                        "entry_id": "56a32973-7e7b-325e-a1d2-d5e1b1bff426",
                                        "glosses": [
                                            "In an unreasonable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a956eb28-64a3-47be-8d9c-ab24872d271a",
                                                "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                                "text": "He behaved unreasonably."
                                            },
                                            {
                                                "example_id": "83033725-64af-4934-9e8a-fb07e0858516",
                                                "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                                "text": "Fye, you confine your ſelfe moſt vnreaſonably: Come, you muſt go viſit the good Lady that lies in."
                                            },
                                            {
                                                "example_id": "14828bbb-ec15-45ac-9fe6-50c3608187f7",
                                                "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                                "text": "When I employ myself upon a paper of morality, I generally consider how I may recommend the particular virtue which I treat of, by the precepts or examples of the ancient heathens; by that means, if possible, to shame those who have greater advantages of knowing their duty, and therefore greater obligations to perform it, into a better course of life: besides that many among us are unreasonably disposed to give a fairer hearing to a pagan philosopher, than to a christian writer."
                                            },
                                            {
                                                "example_id": "a04aa3de-30dc-4d9c-b375-87b496d44d86",
                                                "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                                "text": "When thus gentle, Bessie seemed to me the best, prettiest, kindest being in the world; and I wished most intensely that she would always be so pleasant and amiable, and never push me about, or scold, or task me unreasonably, as she was too often wont to do."
                                            },
                                            {
                                                "example_id": "ccdf5639-b58c-43a5-b7aa-220a71301be4",
                                                "sense_id": "3798e104-6bf2-396d-a6bc-2fa8520c0021",
                                                "text": "Until then, the Sunak administration remains a study in ineffectuality on multiple fronts, leading Goldsmith to cite, not unreasonably, “a kind of paralysis”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc00e08c-fee9-3e1e-b73d-d3bced096243",
                                        "entry_id": "56a32973-7e7b-325e-a1d2-d5e1b1bff426",
                                        "glosses": [
                                            "To an unreasonable degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c9a6ec-043e-451f-ad58-ef5d7ddb8d8b",
                                                "sense_id": "fc00e08c-fee9-3e1e-b73d-d3bced096243",
                                                "text": "The team was given an unreasonably short amount of time to put together a presentation."
                                            },
                                            {
                                                "example_id": "1e82d076-0a65-4459-a335-6025543da203",
                                                "sense_id": "fc00e08c-fee9-3e1e-b73d-d3bced096243",
                                                "text": "1737, Jonathan Swift, Letter to Alderman Barber dated 30 March, 1737, in The Works of Dr Jonathan Swift, Edinburgh: J. Balfour, 1766, Volume 11, p. 126,\nThus bishops, deans, and chapters, as well as other corporations, seldom or never let their lands even so high as half the value; and when they raise those rents which are unreasonably low, it is by degrees."
                                            },
                                            {
                                                "example_id": "dc3cf078-b2c3-4318-bcd4-50aea79fee95",
                                                "sense_id": "fc00e08c-fee9-3e1e-b73d-d3bced096243",
                                                "text": "The Senate of the United States has been both extravagantly praised and unreasonably disparaged, according to the predisposition and temper of its various critics."
                                            },
                                            {
                                                "example_id": "faf6bbbe-122d-4578-83c4-5335e01c49bb",
                                                "sense_id": "fc00e08c-fee9-3e1e-b73d-d3bced096243",
                                                "text": "I get unreasonably angry with John sometimes. I’m sure I never used to be so sensitive. I think it is due to this nervous condition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2941e9aa-35ce-4bfd-9af4-7ea26de37f38",
                        "source_entry_id": "a4bd7319-031b-3f5b-8f26-b922a69a5442",
                        "source_sense_id": "d5c2307b-4640-3a21-898d-308f949c9ddc",
                        "target_lang_word": "unwisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unwisely",
