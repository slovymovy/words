                    {
                        "translation_id": "cb4fc8fd-f35b-453a-a49a-c52f752f6a71",
                        "source_entry_id": "838ba7e7-8dfa-3790-ae11-d477da4f0aaf",
                        "source_sense_id": "28171005-946f-3244-bbb2-8d2315c43f11",
                        "source_sense_description": "Ornithorhynchus anatinus",
                        "target_lang_word": "ornithorynque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornithorynque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0831f298-f768-38a0-87b2-295b72c76980",
                                        "entry_id": "5f05999a-c196-3484-b790-9aa264376029",
                                        "glosses": [
                                            "Mammifère monotrème ovipare, à bec d’oiseau, qui vit en Australie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6029aa84-ea7b-4b7f-8759-bf932e53d3ab",
                                                "sense_id": "0831f298-f768-38a0-87b2-295b72c76980",
                                                "text": "Les ornithorynques vivent au bord des rivières et des marais."
                                            },
                                            {
                                                "example_id": "2213e63d-dd21-4ac9-a662-f42e77f1f456",
                                                "sense_id": "0831f298-f768-38a0-87b2-295b72c76980",
                                                "text": "L'ornithorynque... c'est un des rares mammifères dont la femelle pond des œufs. Il n'a pas de mamelle vraie : le lait s'écoule et imbibe les touffes de poils que les jeunes sucent."
                                            },
                                            {
                                                "example_id": "a15db1f7-a4ce-4254-b340-d3693f12014d",
                                                "sense_id": "0831f298-f768-38a0-87b2-295b72c76980",
                                                "text": "Un continent … où les quadrupèdes ont des becs, comme l’échidné et l’ornithorynque, et ont obligé les naturalistes à créer spécialement pour eux le genre nouveau des monothrèmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35e04e6b-1ae7-4bd8-8b22-10960d5f101f",
                        "source_entry_id": "838ba7e7-8dfa-3790-ae11-d477da4f0aaf",
                        "source_sense_id": "28171005-946f-3244-bbb2-8d2315c43f11",
