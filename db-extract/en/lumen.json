                                    {
                                        "sense_id": "92a990f2-1e0e-39c1-9179-20dbd5e78e03",
                                        "entry_id": "260a21b6-2d6a-35e8-96ec-1b32d8d3b9e5",
                                        "glosses": [
                                            "Unité de mesure de flux lumineux du Système international, équivalant à une candela-stéradian, définie comme le flux lumineux de la lumière monochromatique de fréquence de 540 térahertz et de puissance de 1/683 de watt. Le symbole en est lm."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e86543ac-b55c-3aca-93e2-c7f6d4059604",
                                        "entry_id": "260a21b6-2d6a-35e8-96ec-1b32d8d3b9e5",
                                        "glosses": [
                                            "Cavité d’un organe creux ou espace intérieur d’un organe tubulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9fcfc8d-feb8-48fc-9c2c-7c257f352723",
                                                "sense_id": "e86543ac-b55c-3aca-93e2-c7f6d4059604",
                                                "text": "Divers parasites, comme l’Ascaris, vivent dans le lumen d’un organe de leurs hôtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ff6646-cab0-30e1-9e65-c4f27006bfb0",
                                        "entry_id": "260a21b6-2d6a-35e8-96ec-1b32d8d3b9e5",
                                        "glosses": [
                                            "Espace intérieur d’organites creux, en cytologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2459adce-69d5-4e28-a9ca-21b686ab0c3d",
                                                "sense_id": "c2ff6646-cab0-30e1-9e65-c4f27006bfb0",
                                                "text": "Le collagène est produit dans le lumen du réticulum endoplasmique avant d’être exporté vers sa destination finale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
