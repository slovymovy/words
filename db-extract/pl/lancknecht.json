                ],
                "senses": [
                    {
                        "sense_id": "5232b8f0-a9c3-3339-a7d1-2267cca37f50",
                        "entry_id": "5690c2d0-9133-3e12-a8b9-39eb6cf90baf",
                        "glosses": [
                            "hazardowa gra w karty, rozpowszechniona zwłaszcza w XVI-XVIII wieku"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f80afe33-0642-492f-aef6-e67240517ab6",
                                "sense_id": "5232b8f0-a9c3-3339-a7d1-2267cca37f50",
                                "text": "A jeżeli wygram dziś wieczór pięć czy sześć tysięcy franków w lancknechta, cóż znaczy tych siedemdziesiąt franków straty… – Lancknecht to także jedna z tysiąca fizjonomii prawdziwego Paryża"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b7eec27-5140-49be-ae6c-11d0eca3cc6b",
                        "source_entry_id": "5690c2d0-9133-3e12-a8b9-39eb6cf90baf",
                        "source_sense_id": "5232b8f0-a9c3-3339-a7d1-2267cca37f50",
                        "target_lang_word": "lansquenet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lansquenet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f08b55d-9054-31dd-b564-2e5569ab8c2e",
                                        "entry_id": "38dad964-677a-3665-96d9-e9f0fe862276",
                                        "glosses": [
                                            "Any of a class of German mercenaries of the 15th and 16th centuries, most of whom were pikemen and foot soldiers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971c1612-c9dc-459e-86fe-a0756fb29e9c",
                                                "sense_id": "3f08b55d-9054-31dd-b564-2e5569ab8c2e",
                                                "text": "[…] arising out of this festival there was established an individual lansquenet tradition, in speech and outward appearance, and the bare, sunburnt necks of the vagabond soldiers, their baggy garments hanging in shreds, and their short swords, could be seen all over the country for long afterwards."
                                            },
                                            {
                                                "example_id": "fe97d1b9-245f-4134-b60a-25a2369e23d8",
                                                "sense_id": "3f08b55d-9054-31dd-b564-2e5569ab8c2e",
                                                "text": "Ruthless killing, wanton strife / Add up to a lanzknecht’s life."
                                            },
                                            {
                                                "example_id": "2f5752be-b9be-48a9-b386-9da81a134f17",
                                                "sense_id": "3f08b55d-9054-31dd-b564-2e5569ab8c2e",
                                                "text": "I have never really been outdoorsy enough to make a mercenary landsknecht, although their immense two-handed swords, flowing moustaches and puffed-silk slashed sleeves take some beating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe162f8-7c2f-3401-ab17-5e05209ffce5",
                                        "entry_id": "38dad964-677a-3665-96d9-e9f0fe862276",
                                        "glosses": [
                                            "A gambling card game in which the dealer is given an initial card and the players another; cards are then turned up until the value (rank) of one of those cards is met."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09fbb496-7e4c-4c72-b4de-c7e0acc24dbc",
                                                "sense_id": "dfe162f8-7c2f-3401-ab17-5e05209ffce5",
                                                "text": "“I'm through with all pawn-games,” I laughed. “Come, let us have a game of lansquenet. Either I will take a farewell fall out of you or you will have your sevenfold revenge”."
                                            },
                                            {
                                                "example_id": "9e289658-c51c-4943-8583-1e8789a85f7b",
                                                "sense_id": "dfe162f8-7c2f-3401-ab17-5e05209ffce5",
                                                "text": "One could see part of the dimly lit court where under an enclosed poplar two soldiers on a stone bench were playing lansquenet."
                                            },
                                            {
                                                "example_id": "32cf9b70-3f60-4898-bdad-d6d6fcd496a2",
                                                "sense_id": "dfe162f8-7c2f-3401-ab17-5e05209ffce5",
                                                "text": "And so it was over the game of lansquenet that I scored my first triumph."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c2bed21-a943-4bbb-a4a3-9d4c069e09ab",
