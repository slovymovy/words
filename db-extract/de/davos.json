                        ],
                        "examples": [
                            {
                                "example_id": "2711b845-fe37-4355-ac15-35daae3784f6",
                                "sense_id": "864b58ac-4b3a-3994-8129-5f93e580972b",
                                "text": "Thomas Mann machte Davos mit seinem Roman Der Zauberberg auch in der deutschsprachigen Welt berühmt."
                            },
                            {
                                "example_id": "c51ec370-036f-41dd-8090-77d955089a66",
                                "sense_id": "864b58ac-4b3a-3994-8129-5f93e580972b",
                                "text": "1936 erschoss der jüdische Medizinstudent David Frankfurter in Davos den NSDAP-Landesgruppenleiter der Schweiz Wilhelm Gustloff."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c0e72b8-7963-4d98-a6f5-5dc37d30add5",
                        "source_entry_id": "31ab28d8-cf8e-3bc8-9494-dcbb55169310",
                        "source_sense_id": "95ab4780-518f-3c66-93cb-0c4f9c17dad3",
                        "source_sense_description": "eine Gemeinde im schweizerischen Kanton Graubünden",
                        "target_lang_word": "Davos",
