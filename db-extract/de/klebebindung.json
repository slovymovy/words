                "senses": [
                    {
                        "sense_id": "5d4fb577-b5b0-3aae-9594-36118d0b903c",
                        "entry_id": "c9902eb1-8748-3ce2-95c4-451fc463670b",
                        "glosses": [
                            "Form des Buchbindens, bei der die Blätter des Buchblocks miteinander verleimt werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976d32c4-c5b6-4e53-888d-8e6bd4e6808e",
                                "sense_id": "5d4fb577-b5b0-3aae-9594-36118d0b903c",
                                "text": "„Broschüren mit Klebebindung sind ideal geeignet für eine langfristige und regelmäßige Nutzung.“"
                            },
                            {
                                "example_id": "0144046a-d555-4691-9c76-9f023f9ebd78",
                                "sense_id": "5d4fb577-b5b0-3aae-9594-36118d0b903c",
                                "text": "„Kurzum garantiert die Klebebindung eine hohe Haltbarkeit zum günstigen Preis.“"
                            },
                            {
                                "example_id": "8f959f66-5e20-4b89-85c6-a0244a3eda37",
                                "sense_id": "5d4fb577-b5b0-3aae-9594-36118d0b903c",
                                "text": "„Eine edle Optik, hoher Lesekomfort und eine lange Haltbarkeit machen die Klebebindung zur optimalen Bindung für die Bachelorarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
