                                        "examples": [
                                            {
                                                "example_id": "88f60f6d-ee8f-44c0-8c6e-2832ddda105f",
                                                "sense_id": "b0f6545f-2685-37ca-8c49-9dbbf9b273e5",
                                                "text": "Algorithms in current use differ in their ability to select a matching that does not overmargin a complicated position."
                                            },
                                            {
                                                "example_id": "b4ffa899-a5be-4b50-b0f8-f02965fb9d1d",
                                                "sense_id": "b0f6545f-2685-37ca-8c49-9dbbf9b273e5",
                                                "text": "Finally, exchanges need to be wary of adverse selection — positions that are undermargined would be heavily used while those that are overmargined would be less popular."
                                            },
                                            {
                                                "example_id": "c4036807-3219-4ae0-bbdb-918ec613666b",
                                                "sense_id": "b0f6545f-2685-37ca-8c49-9dbbf9b273e5",
                                                "text": "Bulging with overconfidence, they load up their accounts and way overmargin themselves."
