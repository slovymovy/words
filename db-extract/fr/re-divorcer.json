                "senses": [
                    {
                        "sense_id": "ee677172-0e81-304c-acb8-c0a3ad7799be",
                        "entry_id": "94c94054-0afc-3c37-a9b1-591fe7c82aa4",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée (sans doute pour insister sur la répétition), de redivorcer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef302d18-1070-4a11-9f94-6fb7dff2aef3",
                                "sense_id": "ee677172-0e81-304c-acb8-c0a3ad7799be",
                                "text": "Ce cadeau qu’on lui fait en déclarant sans rire qu’elle est libre d’aller se faire re-divorcer ailleurs et qu’elle est en surcroît l’égale de l’homme qui la chasse ne me parait pas suffisant."
                            },
                            {
                                "example_id": "0df2ad71-2028-400e-8f33-7910c347e759",
                                "sense_id": "ee677172-0e81-304c-acb8-c0a3ad7799be",
                                "text": "Note de la rédaction : les paris sont ouverts pour les chaînes qui diffuseront « Moundir et la psychothérapie de couple » et « Moundir divorce, se re-marie et re-divorce. »"
                            }
                        ]
                    }
