                                            {
                                                "example_id": "93f01bab-61bd-4c71-94b8-c83af4c1854f",
                                                "sense_id": "0d77f16b-f5e8-31b9-86c0-7cee1cb4be10",
                                                "text": "Bridge łączy dwie skrajne części utworu jazzowego."
                                            },
                                            {
                                                "example_id": "35937899-e261-4b1e-8688-a2a652c11c37",
                                                "sense_id": "0d77f16b-f5e8-31b9-86c0-7cee1cb4be10",
                                                "text": "Urzekła ją gra jazzowego saksofonisty."
                                            },
                                            {
                                                "example_id": "6116db8e-d0fd-4737-a7d0-eeafed0d7994",
                                                "sense_id": "0d77f16b-f5e8-31b9-86c0-7cee1cb4be10",
                                                "text": "Wokalistka ma w swoim repertuarze znane standardy jazzowe."
                                            },
                                            {
                                                "example_id": "ffd4c2b4-97f3-473a-a6a3-ed7e045b3f1a",
                                                "sense_id": "0d77f16b-f5e8-31b9-86c0-7cee1cb4be10",
                                                "text": "Był jednym z najpopularniejszy muzyków jazzowych grających na skrzydłówce."
                                            },
                                            {
                                                "example_id": "89039cf8-3113-48b7-9da0-53f7b814e9ca",
                                                "sense_id": "0d77f16b-f5e8-31b9-86c0-7cee1cb4be10",
                                                "text": "Zaduszki jazzowe odbywają się zwykle w kościele ponorbertańskim koło dworca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fcef4c5-318b-4cff-a533-5b9f8ab5e73e",
