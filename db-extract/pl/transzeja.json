                "senses": [
                    {
                        "sense_id": "076bebf8-0d70-3861-ad20-8e603ff42da2",
                        "entry_id": "1e029e85-c12f-36b7-9cca-82c430065917",
                        "glosses": [
                            "odkryty, wąski rów wykopany wzdłuż linii frontu, łączący w jednolity system inne elementy fortyfikacji (okopy, schrony itp.), ułatwiający skryte manewry wzdłuż frontu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5c2e9c0-c24d-4d89-950b-f31766eb6892",
                        "source_entry_id": "1e029e85-c12f-36b7-9cca-82c430065917",
                        "source_sense_id": "076bebf8-0d70-3861-ad20-8e603ff42da2",
                        "target_lang_word": "trench",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trench",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A long, narrow ditch or hole dug in the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbeebce7-c4b7-47ab-a05a-4b1de74922f9",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "The trenches for installing the underground cables were dug with a trencher."
                                            },
                                            {
                                                "example_id": "d228f71c-aebb-40f9-bb2a-65914674e664",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "The milling action of the bucket line enables the trencher to cut through difficult materials, such as stone rubble and brick filling, and to leave a good trench with clean side walls."
                                            },
                                            {
                                                "example_id": "bf2ae672-0848-4176-a709-a599ebe22c4d",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "Figure 114 shows how pegs driven into the bottom of a foundation trench to establish a horizontal level for the concreter to work to, can be levelled with a boning rod held upright on the pages at either end of the trench."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A narrow excavation as used in warfare, as a cover for besieging or emplaced forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47072239-5295-4637-b0ef-7632dbdc7f94",
                                                "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                                "text": "The soldiers in the trenches rely on logistical support."
                                            },
                                            {
                                                "example_id": "b67c43b8-b51f-4526-bc73-6d9f4c0f8a33",
                                                "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                                "text": "Following in the tank's wake, the cameliers reached the first line of Turkish trenches, where they confronted a handful of Ottoman soldiers too wounded to retreat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26c60ff-fab4-3eb5-90bb-9fd789b7c03e",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A pit, usually rectangular with smooth walls and floor, excavated during an archaeological investigation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A trench coat."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c2c6af-26bd-4f8f-bedf-fad8fbfe72c8",
                                                "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                                "text": "I was the first person in my high school to wear a trench and fedora constantly, and Ben was one of the first to wear a black trench."
                                            },
                                            {
                                                "example_id": "35c9d454-ecb4-4e4f-b1ac-91eb2bf3eb19",
                                                "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                                "text": "A classic trench can work in any kind of weather and goes well with almost anything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trench",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To invade, especially with regard to the rights or the exclusive authority of another; to encroach."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc38983c-6c71-490f-96ac-6019dfcf8d9b",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "Shee is the Judge, Thou Executioner, Or if thou needs would'st trench upon her power, Thou mightst have yet enjoy'd thy crueltie, With some more thrift, and more varietie."
                                            },
                                            {
                                                "example_id": "924fe363-b936-4eeb-a1c0-253d971b71c8",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "Does it not seem as if for a creature to challenge to itself a boundless attribute, were to trench upon the prerogative of the divine nature?"
                                            },
                                            {
                                                "example_id": "d6565494-1535-4d05-9fcc-103b2e440226",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "He could make what laws he pleased, as long as those laws did not trench upon property rights."
                                            },
                                            {
                                                "example_id": "2c76da02-c760-4081-88c2-cf1f7044ea66",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "[O]ur ideas, therefore, must trench upon the province of tactics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To excavate an elongated pit for protection of soldiers and or equipment, usually perpendicular to the line of sight toward the enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d116a75-a0e3-452b-a4bd-b3c360d933db",
                                                "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                                "text": "No more shall trenching war channel her fields."
                                            },
                                            {
                                                "example_id": "eb5c16d4-ae54-4f0d-b298-93e6afdc78df",
                                                "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                                "text": "Advanc'd upon the field there stood a mound\nOf earth congested, wall'd , and trench'd around"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63d762e-3275-39b1-b9d9-8cc16a1bd510",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To excavate an elongated and often narrow pit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2142512-def1-3d56-8bd1-5026291549f8",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To have direction; to aim or tend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b97ce6-fb6c-4d48-b9cf-f2131f58c7c5",
                                                "sense_id": "c2142512-def1-3d56-8bd1-5026291549f8",
                                                "text": "the reason and consequence thereof may trench to point of estate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To cut; to form or shape by cutting; to make by incision, hewing, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c1d8cf-c904-4d70-80a4-4c040d852d2b",
                                                "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                                "text": "The wide wound that the boar had trenched / In his soft flank."
                                            },
                                            {
                                                "example_id": "6d8f5676-5392-4332-b9d4-e28f63c4c149",
                                                "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                                "text": "This weak impress of love is as a figure / Trenched in ice, which with an hour's heat\nDissolves to water, and doth lose its form."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85aeab73-6774-36ca-a18c-31e568c4499e",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To cut furrows or ditches in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717890f0-284e-4bf4-94db-f9899b829e48",
                                                "sense_id": "85aeab73-6774-36ca-a18c-31e568c4499e",
                                                "text": "to trench land for the purpose of draining it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82508416-d0b9-364b-8dcc-07d7b34120fe",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To dig or cultivate very deeply, usually by digging parallel contiguous trenches in succession, filling each from the next."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72fdf456-ff7d-46cf-836d-29a2a2d3a400",
                                                "sense_id": "82508416-d0b9-364b-8dcc-07d7b34120fe",
                                                "text": "to trench a garden for certain crops"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcca5352-ee8e-4c1a-a5f3-0bc3f3360f6d",
                        "source_entry_id": "1e029e85-c12f-36b7-9cca-82c430065917",
                        "source_sense_id": "076bebf8-0d70-3861-ad20-8e603ff42da2",
                        "target_lang_word": "траншея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "траншея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d040b6-21d3-3b68-89bb-cdfff7683c26",
                                        "entry_id": "ef1c95d3-9b32-3e23-b47a-a070bb594cf7",
                                        "glosses": [
                                            "искусственная неширокая и протяжённая выемка в грунте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb546f0-3fc2-40ec-a6e4-04bff952f9e5",
                                                "sense_id": "c1d040b6-21d3-3b68-89bb-cdfff7683c26",
                                                "text": "Два товарища стоят на противоположных сторонах траншеи, на дне которой находится вода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b50b95-d36b-3f9f-a411-5a0b5a4017de",
                                        "entry_id": "ef1c95d3-9b32-3e23-b47a-a070bb594cf7",
                                        "glosses": [
                                            "воен. траншея [1], предназначенная для укрытия личного состава"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d95d2de-5d2f-45be-a48c-51123cc120cd",
                                                "sense_id": "66b50b95-d36b-3f9f-a411-5a0b5a4017de",
                                                "text": "Чтобы идти на четвёртый бастион, возьмите направо, по этой узкой траншее, по которой, нагнувшись, побрёл пехотный солдатик."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eff190eb-8d7d-33bf-9d68-c6f854bdc223",
                                        "entry_id": "ef1c95d3-9b32-3e23-b47a-a070bb594cf7",
                                        "glosses": [
                                            "горн. открытая горная выработка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96416f54-4dd2-414d-a58b-8395434d1ddb",
                                                "sense_id": "eff190eb-8d7d-33bf-9d68-c6f854bdc223",
                                                "text": "Внутренние капитальные траншеи используются для вскрытия наклонных и крутых месторождений на глубоких карьерах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
