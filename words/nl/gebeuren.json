        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8e609be-d807-3495-a26a-350755755805",
                    "sense_definition": "iets dat plaatsvindt of heeft plaatsgevonden; een voorval",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het hele <w>gebeuren</w> rondom de bruiloft was prachtig georganiseerd.",
                            "target_lang_translations": {
                                "en": "The whole <w>event</w> surrounding the wedding was beautifully organized.",
                                "ru": "Все <w>событие</w> вокруг свадьбы было прекрасно организовано."
                            }
                        },
                        {
                            "text": "Zij keek met verbazing naar het vreemde <w>gebeuren</w> op straat.",
                            "target_lang_translations": {
                                "en": "She watched the strange <w>goings-on</w> on the street with amazement.",
                                "ru": "Она с удивлением наблюдала за странным <w>происходящим</w> на улице."
                            }
                        }
                    ],
