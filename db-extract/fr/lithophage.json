                ],
                "senses": [
                    {
                        "sense_id": "d530a0c8-1b2f-3505-a42b-a85dc4f64ac9",
                        "entry_id": "c3d9bf5e-0c73-3fbc-ba6e-626af8ea8f35",
                        "glosses": [
                            "Qui ronge la pierre, en parlant de certains coquillages qui s’introduisent dans les rochers pour y creuser leur demeure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794140dc-a906-40f3-b192-b38735f22be6",
                                "sense_id": "d530a0c8-1b2f-3505-a42b-a85dc4f64ac9",
                                "text": "La datte de mer est un mollusque lithophage."
                            },
                            {
                                "example_id": "65cd093b-2e2f-4fd4-acb6-c4a68ee09f25",
                                "sense_id": "d530a0c8-1b2f-3505-a42b-a85dc4f64ac9",
                                "text": "Maurice Badoux était un vrai poète lithophage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79416c32-e344-4538-9a3e-a40ed644c974",
                        "source_entry_id": "c3d9bf5e-0c73-3fbc-ba6e-626af8ea8f35",
                        "source_sense_id": "d530a0c8-1b2f-3505-a42b-a85dc4f64ac9",
                        "target_lang_word": "lithophag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lithophag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                        "entry_id": "2c822b12-c87b-34f2-8b61-dd1b0c5f5e31",
                                        "glosses": [
                                            "Gesteine auflösend, sich in Gestein einbohrend"
                                        ],
                                        "tags": [
                                            "von Tieren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e72bafed-5482-4794-9dda-856359d48cae",
                                                "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                                "text": "Auch zum Teil von lithophagen Muscheln angebohrter Korallenschutt ist nicht sehr verbreitet."
                                            },
                                            {
                                                "example_id": "dd0c0234-fdab-4d04-9aaa-6856da44d1b0",
                                                "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                                "text": "Im Gezeitenbereich findet man im harten Substrat Wohnbauten lithophager Organismen (Schwämme, Ringelwürmer, Bryozoen, Muscheln, Krebse, Seeigel usw.) (…)."
                                            },
                                            {
                                                "example_id": "bc0f6cc1-52c0-4e3c-a96b-b5f7b18628e5",
                                                "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                                "text": "Bohrlöcher von lithophagen Organismen oder Freßbauten von Sedimentfresern geben Auskunft über den Verfestigungszustand des Substrats im Augenbkick des Entstehens der Lebensspuren (…)."
                                            },
                                            {
                                                "example_id": "80b27fe1-aa2a-416c-8f68-fb7c6348683a",
                                                "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                                "text": "In den Geröllmergeln des Erweiterungssteinbruches Retznei treten zahlreiche „Schliergerölle\" auf, die zum einen von verschiedenen Hartsubstratbewohnern (Ostreen, Serpuliden, Bryozoen) besiedelt sind und zum anderen von lithophagen Lamellibranchiaten angebohrt sind."
                                            },
                                            {
                                                "example_id": "722c7594-433d-4521-b51c-9199e8327a3e",
                                                "sense_id": "529a7ec8-1f5d-3f99-907c-590298065399",
                                                "text": "Lithophage Organismen durchlöchern das Gestein mit den darin enthaltenen Skelett- bzw. Schalenresten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
