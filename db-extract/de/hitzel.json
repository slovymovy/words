                "senses": [
                    {
                        "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                        "entry_id": "c5a17069-2351-3a72-8d29-aedd663230f4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19f007e-cd36-4b40-b9e1-825a8b1147cd",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Frau Hitzel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "71d55ac0-1258-4ec3-a2b5-44cfcf9f6f5d",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Herr Hitzel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7df7f748-5b58-4164-ad52-68a12e827187",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Die Hitzels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bdd2668f-e7f5-4301-881a-c58a9d8d7ba8",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Der Hitzel trägt nie die Schals, die die Hitzel ihm strickt."
                            },
                            {
                                "example_id": "81714079-9dfb-4100-a4cb-2f0c68b0de24",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hitzel kommt, geht der Herr Hitzel.“"
                            },
                            {
                                "example_id": "a0d19c41-c7a8-4a2e-b4e3-3e7638d6d147",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Hitzel kommt und geht."
                            },
                            {
                                "example_id": "8310427e-6eb0-4018-8c93-abd31e64a769",
                                "sense_id": "dbf6c386-9c0b-3c1d-b1d1-55ce7b6792dd",
                                "text": "Hitzels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
