                "translations": [
                    {
                        "translation_id": "af2c99bd-ce5c-4c96-8d28-dde50c9bb01b",
                        "source_entry_id": "4dee6ba4-957e-3138-98eb-375cad5bb7bc",
                        "source_sense_id": "766e29b1-d857-338c-be63-c5bd81f3eee5",
                        "source_sense_description": "jemand,der Schlösser herstellt und repariert; Schlosser, Schlossschmied (veraltet)",
                        "target_lang_word": "Schlosser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlosser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                        "entry_id": "7ee25ca8-ae66-3d4f-9a5c-f18d771c41fa",
                                        "glosses": [
                                            "Handwerker oder Industriearbeiter, der Metall und Kunststoff ver- oder bearbeitet oder Gegenstände repariert, montiert oder instand hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9508c810-69e2-40bb-a2af-86dee0967c7d",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "Der Industrieberuf Schlosser erfordert eine dreieinhalbjährige Ausbildungszeit."
                                            },
                                            {
                                                "example_id": "200ddd91-3c06-4a0e-b806-d6481c16e51c",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "Schlosser ist eine allgemeine Bezeichnung für verschiedene Handwerksberufe."
                                            },
                                            {
                                                "example_id": "51e07e41-f232-463c-9417-4d1eef020462",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Der Beruf des Schlossers ist seit dem 14. Jh. belegt und gehört dem Stand der Kleinschmiede an.“"
                                            },
                                            {
                                                "example_id": "4ea07431-df22-4db0-bac3-556a8f4804ee",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Im Mai 1945 begann der 14-jährige Horst in Hindenburg eine Lehre als Schlosser: In der Schlosserei von Maksymilian Fiszer lernte er die harte Arbeit kennen.“"
                                            },
                                            {
                                                "example_id": "bb2c550f-d00f-4626-9688-6bb149f75bb4",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Sobald ich angezogen war, ging ich ein wenig spazieren und traf den Priester mit einem Schlosser.“"
                                            },
                                            {
                                                "example_id": "4d581dff-b6b5-4ab3-aaa9-dc0fccb35921",
                                                "sense_id": "7c26b979-55cf-3790-b95b-8833424345dc",
                                                "text": "„Sie ließen einen Schlosser für die Spalierstangen, einen Klempner für die Drahtverspannungen, einen Zimmermann für die Pfähle kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schlosser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b69ce453-23c4-34a7-aec2-62232b457976",
                                        "entry_id": "c10054e7-02c3-3c27-9437-0870e81eda36",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddaa63d0-aa09-4c55-bb52-63671d55ff22",
                                                "sense_id": "b69ce453-23c4-34a7-aec2-62232b457976",
                                                "text": "Max Schlosser, der Sohn von Paul Schlosser, ist ein guter Tennisspieler und macht seinem Nachnahme wenig Ehre."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
