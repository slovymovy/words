                                        "entry_id": "1586f314-7935-358e-81af-75d179d84b55",
                                        "glosses": [
                                            "freizeitsportliche Aktivität, die dazu dient, die körperliche Leistungsfähigkeit zu erhalten oder zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
