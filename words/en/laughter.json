                    "sense_id": "a076e396-38e6-33c3-939d-3291e63543fb",
                    "sense_definition": "The action or sound of laughing, usually expressing happiness or amusement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience burst into <w>laughter</w> at the comedian's joke.",
                            "target_lang_translations": {
                                "ru": "Зрители разразились <w>смехом</w> над шуткой комика.",
                                "nl": "Het publiek barstte in <w>gelach</w> uit om de grap van de komiek.",
                                "pl": "Publiczność wybuchnęła <w>śmiechem</w> na żart komika.",
                                "de": "Das Publikum brach bei dem Witz des Komikers in <w>Gelächter</w> aus."
                            }
                        },
                        {
                            "text": "We could hear the sound of happy <w>laughter</w> coming from the park.",
                            "target_lang_translations": {
                                "ru": "Мы слышали звуки счастливого <w>смеха</w>, доносившиеся из парка.",
                                "nl": "We konden het geluid van vrolijk <w>gelach</w> uit het park horen komen.",
                                "pl": "Słyszeliśmy dźwięk radosnego <w>śmiechu</w> dobiegający z parku.",
                                "de": "Wir konnten das Geräusch fröhlichen <w>Lachens</w> aus dem Park hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "laugh"
                    ],
                    "antonyms": [
                        "crying"
                    ],
                    "common_phrases": [
                        "burst into laughter",
                        "roar with laughter",
                        "shriek of laughter"
                    ],
                    "target_lang_definitions": {
