                        "glosses": [
                            "Grotte et tunnel naturels d’altitude où la neige s’accumule. Le terme n'est utilisé qu'en Dévoluy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30be8baa-0653-4daf-a618-e57ab24151cf",
                                "sense_id": "4a22ef74-aa6a-3a74-878f-62ce8f6bf88d",
                                "text": "Les chourums sont de drôles de grottes et tunnels naturels d’altitude où la neige s’accumule, permettant aux connaisseurs de se frayer un passage à pied, à ski ou en rappel »."
                            },
                            {
                                "example_id": "f4a2eb54-de5e-4a68-adf4-51064380604f",
                                "sense_id": "4a22ef74-aa6a-3a74-878f-62ce8f6bf88d",
                                "text": "Se creuse un chourum où l'absence de quelque chose répond en écho à une sorte d'inquiétude. Show room de points d'interrogation, points d'exclamation... point de suspension."
                            }
                        ]
                    }
