                ],
                "senses": [
                    {
                        "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                        "entry_id": "58476da4-3357-3188-be6a-fde2f3277c3b",
                        "glosses": [
                            "Stadt in Mecklenburg-Vorpommern, Deutschland; Universitätsstadt, Hansestadt, Reformationsstadt Europas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea261c88-00e1-4ab4-ba43-cd061116512a",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "„Die Nord-Stream-Pipeline, die vom russischen Wyborg durch die Ostsee in die Nähe von Greifswald führt, wird Deutschland unabhängig von Transitländern machen.“"
                            },
                            {
                                "example_id": "a1c0b0cf-7559-4e9f-b781-0aeac92f86ce",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "Greifswalds Universität gehört zu den ältesten Europas."
                            },
                            {
                                "example_id": "f159ff33-175b-4077-b78d-3d8573cc33b5",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "Ich bin in Greifswald geboren."
                            },
                            {
                                "example_id": "0d928df7-5217-4412-918c-6e8e72be7d09",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "„Er wurde 1893 als Sohn eines Karrierejuristen in Greifswald geboren, wuchs in Berlin, später in Leipzig auf und war ein schwieriges, unglückliches Kind, vom Pech verfolgt, von Unfällen und Krankheiten geplagt, eigenbrötlerisch, aufbrausend und arrogant.“"
                            },
                            {
                                "example_id": "aef769d5-1070-4cd3-af76-edfa9a782fb1",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "Wir haben in Greifswald unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "755b41fd-742d-47c9-9a74-4e8a3b578325",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "Nach Greifswald führen viele Wege."
                            },
                            {
                                "example_id": "68a7d41f-01ee-4c1b-b8e5-226c85e61755",
                                "sense_id": "8a33c784-2c51-3bcd-8925-1be682c95c17",
                                "text": "Greifswald liegt auf der Nordhalbkugel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
