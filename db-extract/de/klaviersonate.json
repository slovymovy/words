                                    {
                                        "sense_id": "09fa37f4-a428-36ca-82b1-9227d9c0cb2f",
                                        "entry_id": "0cb91e00-9b25-323d-9494-b945091c02e0",
                                        "glosses": [
                                            "barok muziekstuk voor piano in meerdere delen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1123b487-392c-456f-849e-2601f7ba5a82",
                                                "sense_id": "09fa37f4-a428-36ca-82b1-9227d9c0cb2f",
                                                "text": "Ik liep naar het keyboard, stak de stekker weer in het stopcontact en speelde een aantal maten van een pianosonate van Mozart."
                                            },
                                            {
                                                "example_id": "382f1292-e0fc-4ada-99a7-62f65916c78d",
                                                "sense_id": "09fa37f4-a428-36ca-82b1-9227d9c0cb2f",
                                                "text": "Wie Boomsma's kijk op Schuberts 21ste pianosonate vergelijkt met die van de Poolse pianogod Krystian Zimerman (ook net verschenen), kan er niet omheen. Zimerman speelt briljant en steriel, bij Boomsma vloeien de noten filosofisch. Gaat het bij Zimerman soms van pets, pets, pets, aan Boomsma's vingers kleeft fluweel. Waar de Pool praat van wilskracht en ambitie, spreekt de Nederlander van berusting en dood."
                                            }
                                        ]
                                    }
                                ]
                            }
