                    {
                        "translation_id": "df85f5c1-4104-4a11-af6d-ad03e22072a4",
                        "source_entry_id": "bee64da4-6fe9-35f3-878a-9cc62fe7b631",
                        "source_sense_id": "4d9d413d-0bdc-3408-bc50-29e8d057423d",
                        "target_lang_word": "viburnum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viburnum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b4061c-b7ff-3568-beff-13aa96c65e30",
                                        "entry_id": "fae36d39-8717-3c9c-aab4-59070558277b",
                                        "glosses": [
                                            "Any of many shrubs and trees, of the genus Viburnum, native to the Northern Hemisphere that have showy clusters of flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d3af46-7052-4fbd-9ef3-b239dabd33d2",
                                                "sense_id": "48b4061c-b7ff-3568-beff-13aa96c65e30",
                                                "text": "Thus he diſcovered two or three kinds of oaks, a few viburna, and ſome trees of the maple genus, with a wild ſort of Japaneſe pear."
                                            },
                                            {
                                                "example_id": "20d723b4-96d6-4f2d-9dd5-a92606093765",
                                                "sense_id": "48b4061c-b7ff-3568-beff-13aa96c65e30",
                                                "text": "Adowa moschatellina. — Although it quite differs from the elder-trees, viburna and honey-suckles as far as the general appearance is concerned, says Siclain, it occurs in the neighbourhood of these plants."
                                            },
                                            {
                                                "example_id": "6fedb283-68aa-4345-930f-d5999dd51848",
                                                "sense_id": "48b4061c-b7ff-3568-beff-13aa96c65e30",
                                                "text": "But such knowledge is simply ungermane to aesthetics. When one studies the biochemistry of plants, one may afterwards be more tolerant in one’s taste toward thornbushes and dandelions (for they too are wonderfully evolved) but still aesthetically prefer viburna and hyacinths for very good reasons that have nothing to do with botanical science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
