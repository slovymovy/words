                                        "glosses": [
                                            "Pertaining to or resembling lead; grey, heavy, sluggish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8c958a-aa1b-4ef6-84c9-ddb19114aee8",
                                                "sense_id": "486301e3-0a3a-3dbf-b28c-275c62764db9",
                                                "text": "Which break a teachless nature to the yoke."
                                            },
                                            {
                                                "example_id": "d741ee00-1b62-4969-ac7d-3582b11b83a4",
                                                "sense_id": "486301e3-0a3a-3dbf-b28c-275c62764db9",
                                                "text": "Where but to think is to be full of sorrow / And leaden-eyed despairs, / Where Beauty cannot keep her lustrous eyes, / Or new Love pine at them beyond to-morrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e8ba55f-ed03-36d8-90a5-e07249066501",
                                        "entry_id": "32232dc5-09d9-318f-bd40-b2391c72367f",
                                        "glosses": [
                                            "Dull; darkened with overcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87af0ba0-4aee-46d5-a4f5-58792eb5d139",
                                                "sense_id": "2e8ba55f-ed03-36d8-90a5-e07249066501",
                                                "text": "the sky was leaden and thick"
                                            },
                                            {
                                                "example_id": "71c1ae4a-b16d-4178-9807-bda4a0d60ae4",
                                                "sense_id": "2e8ba55f-ed03-36d8-90a5-e07249066501",
                                                "text": "It was at the end of February..., when the world was cold..., when icy rains fell from the leaden skies in continual drizzling showers."
                                            }
