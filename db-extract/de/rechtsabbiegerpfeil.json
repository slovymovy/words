                "senses": [
                    {
                        "sense_id": "c025dd1d-49fd-3770-b467-2201f5fbca40",
                        "entry_id": "1c91dc37-73e9-3229-8eb9-07a71e9ec66b",
                        "glosses": [
                            "Zusatzschild an einer Ampel, das das Rechtsabbiegen trotz roter Ampelphase, jedoch ohne Vorfahrt, erlaubt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127945a3-2f56-4f79-afa1-55ea62a810cd",
                                "sense_id": "c025dd1d-49fd-3770-b467-2201f5fbca40",
                                "text": "„Jetzt hätte er sich einen grünen Rechtsabbiegerpfeil wie in Berlin gewünscht.“"
                            },
                            {
                                "example_id": "f4adbed0-cb20-430f-a41f-93607599e3af",
                                "sense_id": "c025dd1d-49fd-3770-b467-2201f5fbca40",
                                "text": "„Außer grünem Rechtsabbiegerpfeil, FKK-Tradition und Sandmännchen konnte man kaum etwas durch die Wendewirren retten.“"
                            },
                            {
                                "example_id": "c82865ed-2b70-4d41-95a4-2637d831a5f0",
                                "sense_id": "c025dd1d-49fd-3770-b467-2201f5fbca40",
                                "text": "„An der einen Ampel beim Möbelhaus – habt ihr da auch gedacht, der Trick wäre, dass es einen grünen Rechtsabbiegerpfeil gibt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
