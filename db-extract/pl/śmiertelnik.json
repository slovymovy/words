                "senses": [
                    {
                        "sense_id": "4ecb4b28-78dc-321a-a9f8-1032aff8fed1",
                        "entry_id": "3ca878f7-1f0f-38a7-9dfc-cbe39f2de4dd",
                        "glosses": [
                            "istota śmiertelna, jaką jest człowiek"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cb6ac761-11c3-473e-b87a-5ba812376a02",
                                "sense_id": "4ecb4b28-78dc-321a-a9f8-1032aff8fed1",
                                "text": "Do Ciebie przychodzi wszelki śmiertelnik, wyznając nieprawości"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f98be2ba-8636-437d-a543-cc5eaa3d5d28",
                        "source_entry_id": "3ca878f7-1f0f-38a7-9dfc-cbe39f2de4dd",
                        "source_sense_id": "4ecb4b28-78dc-321a-a9f8-1032aff8fed1",
                        "target_lang_word": "mortal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4c0bfc8-773a-3c1d-a697-922892a8cb9a",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Susceptible to death by aging, sickness, injury, or wound; not immortal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ea19205-5637-3302-9153-9a730470d439",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Causing death; deadly, fatal, killing, lethal (now only of wounds, injuries etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f139b9c2-c698-4804-a56a-0d7be04b213a",
                                                "sense_id": "5ea19205-5637-3302-9153-9a730470d439",
                                                "text": "Blyndfold he was; and in his cruell fist\n A mortall bow and arrowes keene did hold […]"
                                            },
                                            {
                                                "example_id": "a6d4c206-0554-4b93-8999-bac15db763f6",
                                                "sense_id": "5ea19205-5637-3302-9153-9a730470d439",
                                                "text": "into the plain\nDisgorged at length, the dead and the alive,\nIn one dread mass, were parted, and the stain\nOf blood from mortal steel fell o’er the fields like rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bef25b6-a10d-31ad-a6af-504ca04ef10e",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Punishable by death."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab93524e-2979-3291-b309-55e6ba22aa3c",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Fatally vulnerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ece3e614-cd18-4ad9-a5eb-4fa06ac666ac",
                                                "sense_id": "ab93524e-2979-3291-b309-55e6ba22aa3c",
                                                "text": "Last of all, against himself he turns his sword, but missing the mortal place, with his poniard finishes the work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7283dd3-5be3-30e3-a45a-00a78e8ed2f3",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Of or relating to the time of death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93cf26db-79f8-412c-a1a4-3b01c3a2db99",
                                                "sense_id": "e7283dd3-5be3-30e3-a45a-00a78e8ed2f3",
                                                "text": "Safe in the hand of one disposing Power,\n Or in the natal or the mortal hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Affecting as if with power to kill; deathly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75802a31-70ec-451f-920b-9d5bac33945b",
                                                "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                                                "text": "mortal enemy"
                                            },
                                            {
                                                "example_id": "f3c940dc-3a53-4c78-84ab-f06ea78e4d64",
                                                "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                                                "text": "The nymph grew pale, and in a mortal fright."
                                            },
                                            {
                                                "example_id": "e326ef56-bac7-4a62-8f71-d46004f79930",
                                                "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                                                "text": "I was in mortal fear lest the captain should repent of his confessions and make an end of me."
                                            },
                                            {
                                                "example_id": "9e1f38d9-dc36-4a25-8a05-641ae6f0e6f0",
                                                "sense_id": "b7a54665-9fae-324a-8f69-0c5376e0a833",
                                                "text": "Although the Japanese have engaged with little hesitation, they are as surprised as the Americans to be fighting this battle. Although the escort-carrier groups have been under sporadic air attack for over a week, these attacks appear to have been conducted by aircraft from the Japanese Army, who, of course, have utterly failed to mention any of this to their counterparts-dash-rivals-dash-mortal enemies in the Imperial Japanese Navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85bad0f9-98ed-3d13-87fe-ce5b08a620ed",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Human; belonging or pertaining to people who are mortal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d92994b-cc85-44e4-a922-2e93e37cb26c",
                                                "sense_id": "85bad0f9-98ed-3d13-87fe-ce5b08a620ed",
                                                "text": "mortal wit or knowledge; mortal power"
                                            },
                                            {
                                                "example_id": "730813c1-e1fb-42c4-be2d-3f0d306155e0",
                                                "sense_id": "85bad0f9-98ed-3d13-87fe-ce5b08a620ed",
                                                "text": "The voice of God\n To mortal ear is dreadful."
                                            },
                                            {
                                                "example_id": "98c2bcfa-68d6-4b16-88de-7bf0654fba97",
                                                "sense_id": "85bad0f9-98ed-3d13-87fe-ce5b08a620ed",
                                                "text": "“It's just...I hesitated to call the police. I wasn't sure you'd appreciate their presence.” He sure wouldn't. Mortal scum he could dispatch. Mortal law enforcement he avoided at all costs[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acb4641-e684-3ff3-9d84-ed3306b9d609",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Very painful or tedious; wearisome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ba5bf9c-99c2-4af5-a141-874d1af51a0a",
                                                "sense_id": "6acb4641-e684-3ff3-9d84-ed3306b9d609",
                                                "text": "a sermon lasting two mortal hours"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3280e4d7-8729-361f-8fba-b45cb837efa9",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Very drunk."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "Scotland",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c86ec5-32a3-467b-bccc-4666329c7e58",
                                                "sense_id": "3280e4d7-8729-361f-8fba-b45cb837efa9",
                                                "text": "Thats^([sic]) nothing, says Tequila Sheila, who told how the summer she was housemaid in The Saint Columba she took this guy back to the staff flats while mortal on slammers and crashed out on him before anything could happen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "410999a7-8a56-3d48-b517-f55b68159cac",
                                        "entry_id": "18e045db-b616-3809-ab90-b91b6304fc11",
                                        "glosses": [
                                            "Causing spiritual death."
                                        ],
                                        "tags": [
                                            "of a sin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mortal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f38f324-0062-3fd4-805a-d4a0caed0192",
                                        "entry_id": "e9809c86-0742-3cb4-a7ce-aa1105422410",
                                        "glosses": [
                                            "A human; someone susceptible to death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc2d9e7-05e3-4333-a5a4-f987ceea7384",
                                                "sense_id": "1f38f324-0062-3fd4-805a-d4a0caed0192",
                                                "text": "Her wisdom was beyond that of a mere mortal."
                                            },
                                            {
                                                "example_id": "e8a3c64d-18b7-49ae-8faf-68361951b9ea",
                                                "sense_id": "1f38f324-0062-3fd4-805a-d4a0caed0192",
                                                "text": "Lord what fools these mortals be!"
                                            },
                                            {
                                                "example_id": "b92fab79-e359-4f6d-aa2e-ae2688604132",
                                                "sense_id": "1f38f324-0062-3fd4-805a-d4a0caed0192",
                                                "text": "But then I had the flintlock by me for protection.\n There were giants in the days when that gun was made; for surely no modern mortal could have held that mass of metal steady to his shoulder. The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mortal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3474e078-c74e-306f-8538-3e1918ddf330",
                                        "entry_id": "45df934b-3dc0-3473-9775-f5e7bc8c58eb",
                                        "glosses": [
                                            "Mortally; enough to cause death."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063af3dc-c302-45ab-ad9a-ddd01a92ad99",
                                                "sense_id": "3474e078-c74e-306f-8538-3e1918ddf330",
                                                "text": "It's mortal cold out there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
