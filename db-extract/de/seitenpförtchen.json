                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d2fda5-f16e-415d-9abd-27b2b963991b",
                                "sense_id": "fd5d474c-b82a-35b0-b183-8148ab838149",
                                "text": "„Damit begab sie sich zu dem Seitenpförtchen und verschloß es von außen mit einem ihrer silbernen Haarpfeile.“"
                            },
                            {
                                "example_id": "8a1c6ed8-529c-4650-96a1-a222fa999329",
                                "sense_id": "fd5d474c-b82a-35b0-b183-8148ab838149",
                                "text": "„Botho sagte der so Herausgeputzten etwas Schmeichelhaftes, und gleich danach gingen alle drei den Gang hinunter und traten durch ein verstecktes Seitenpförtchen auf einen Feldweg hinaus, der hier, wenigstens zunächst noch und eh er weiter abwärts in das freie Wiesengrün einbog, an dem an seiner Außenseite hoch in Nesseln stehenden Gartenzaun hinlief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
