                                        "glosses": [
                                            "One who denies the existence of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a68ac1c-4179-4c72-a6c6-a1c3c0a86aa5",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "Holocaust denier"
                                            },
                                            {
                                                "example_id": "1ba88bfd-473b-46e5-9be7-d2ec6833607e",
                                                "sense_id": "9190e94a-436a-3efb-ab68-f7658855bd65",
                                                "text": "global warming denier"
