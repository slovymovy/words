                "senses": [
                    {
                        "sense_id": "6dfe6876-a81e-3059-b9d9-f11e49428ad9",
                        "entry_id": "a51a21b3-eb42-3b38-aec8-8ef32ba09868",
                        "glosses": [
                            "действ. прич. наст. вр. от округлять"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "810a5930-5658-4b9f-8410-ca63e5d3072a",
                                "sense_id": "6dfe6876-a81e-3059-b9d9-f11e49428ad9",
                                "text": "― Иван Павлович сделал рукой широкий округляющий жест, потом начал вертеть цигарку."
                            },
                            {
                                "example_id": "a3092dde-dff3-4423-8254-ced4e1bead16",
                                "sense_id": "6dfe6876-a81e-3059-b9d9-f11e49428ad9",
                                "text": "Прежде всего вечный хохот ― не смех, а победно-издевательский хохот, округляющий и без того круглое лицо, обнажающий белые, безупречно ровные, один к одному, блестящие зубы."
                            }
                        ]
                    }
