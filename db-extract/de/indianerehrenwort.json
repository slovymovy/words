                "senses": [
                    {
                        "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                        "entry_id": "97c8aa7c-f7f6-3737-af13-0101495b94f3",
                        "glosses": [
                            "(verstärktes) bedeutungsvolles Versprechen, das auf die eigene Ehre abgelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1729d6bc-6166-42e9-beb7-8c212992aa2b",
                                "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                                "text": "„Schwüre, Eide, große Indianerehrenworte wurden geleistet. Aber die Fotos vom angeblichen Rückzug Neumanns aus dem Rotlicht-Milieu — die bleiben verschollen.“"
                            },
                            {
                                "example_id": "7743fff1-41db-47fb-ad75-57f929671511",
                                "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                                "text": "„‚Wir steigen nicht ab, Junge‘, sprach Hansi Gundelach zu mir, als das alte Quecksilberthermometer aus dem Arzneimittelschrank meiner Eltern 39,6 Grad anzeigte. ‚Indianerehrenwort.‘“"
                            },
                            {
                                "example_id": "9f2d7f90-1f5d-4780-bfb4-46431a84721a",
                                "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                                "text": "„Das ‚ich‘ ist es, was einem ständig verspricht, man müsse erst dies und das haben, erst jenes erreichen, aber dann, Indianerehrenwort, wäre man ganz, ganz sicher glücklich.“"
                            },
                            {
                                "example_id": "ceac6402-978f-4e06-942e-82be1674ff5c",
                                "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                                "text": "„Jedenfalls hat Karl May das positive deutsche Bild von Indianern nachhaltig geprägt, was heute noch in Redensarten wie ‚Großes Indianerehrenwort‘ oder ‚Ein Indianer kennt keinen Schmerz‘ fortlebt.“"
                            },
                            {
                                "example_id": "53e926db-5dc3-4322-8666-cf3c55cbfea7",
                                "sense_id": "679bfc63-f9f6-37ec-8dbe-843382c35d88",
                                "text": "„Wir haben die Erde von unseren Kindern nur geborgt, verkündete eine angeblich indianische Weisheit – oh Pardon, es muss natürlich Weisheit der indigenen Einwohner Amerikas heißen, danke für den Hinweis der Sprachpolizei, ich tue es nie wieder, großes Indianerehrenwort – auf den Plakaten der Grünen zur Bundestagswahl 1983.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
