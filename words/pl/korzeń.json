    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb129dea-cae2-3df8-8e6f-b296e264673c",
                    "sense_definition": "część rośliny znajdująca się pod ziemią, która pobiera wodę i utrzymuje ją w glebie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczorajsza silna wichura wyrywała stare drzewa z <w>korzeniami</w>.",
                            "target_lang_translations": {
                                "ru": "Вчерашний сильный ураган вырывал старые деревья с <w>корнями</w>."
                            }
                        },
                        {
                            "text": "Musisz uważać, aby podczas przesadzania kwiatka nie uszkodzić jego <w>korzenia</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно быть осторожным, чтобы при пересадке цветка не повредить его <w>корень</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gw. (Górny Śląsk) korzyń"
                    ],
                    "common_phrases": [
                        "wyrwać z korzeniami",
                        "zapuścić korzenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "подземная часть растения, которая поглощает воду и удерживает его в почве"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корень",
                                "target_lang_sense_clarification": "часть растения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec322774-c350-399b-b56f-b3bdad9fcf92",
                    "sense_definition": "pochodzenie człowieka, powiązania rodzinne lub kulturowe z danym miejscem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pochodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek pochodził z Wilna, więc mam tam swoje <w>korzenie</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка был родом из Вильнюса, так что у меня там свои <w>корни</w>."
                            }
                        },
                        {
                            "text": "Mimo że mieszka za granicą, zawsze pamięta o swoich polskich <w>korzeniach</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то что он живет за границей, он всегда помнит о своих польских <w>корнях</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mieć korzenie",
                        "szukać korzeni"
                    ],
                    "target_lang_definitions": {
                        "ru": "происхождение человека, семейные или культурные связи с определенным местом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корни",
                                "target_lang_sense_clarification": "происхождение, предки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5dc02f2-2107-3b62-9d4d-e4a2d2bc551e",
                    "sense_definition": "część organu ludzkiego lub zwierzęcego, która jest osadzona głęboko w tkance",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dentysta musiał usunąć <w>korzeń</w> zęba, ponieważ wdał się tam stan zapalny.",
                            "target_lang_translations": {
                                "ru": "Стоматологу пришлось удалить <w>корень</w> зуба, так как там началось воспаление."
                            }
                        },
                        {
                            "text": "Za prawidłowy wzrost każdego włosa odpowiedzialny jest jego <w>korzeń</w>.",
                            "target_lang_translations": {
                                "ru": "За правильный рост каждого волоса отвечает его <w>корень</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "korzeń zęba",
                        "korzeń włosa",
                        "korzeń języka"
                    ],
                    "target_lang_definitions": {
                        "ru": "часть органа человека или животного, глубоко вживленная в ткань"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корень",
                                "target_lang_sense_clarification": "анатомическая часть зуба, волоса и т.д."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "015b3252-0e3b-3f44-b145-c7fe333a0215",
                    "sense_definition": "roślina lub jej część o intensywnym zapachu, używana w kuchni jako przyprawa",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do przygotowania tradycyjnego piernika niezbędny jest aromatyczny <w>korzeń</w> imbiru.",
                            "target_lang_translations": {
                                "ru": "Для приготовления традиционного пряника необходим ароматный <w>корень</w> имбиря."
                            }
                        },
                        {
                            "text": "W tej potrawie dominują egzotyczne <w>korzenie</w> sprowadzane prosto z Indii.",
                            "target_lang_translations": {
                                "ru": "В этом блюде преобладают экзотические <w>коренья</w>, привезенные прямо из Индии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "korzeń imbiru"
                    ],
                    "target_lang_definitions": {
                        "ru": "растение или его часть с интенсивным запахом, используемая в кулинарии в качестве приправы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корень",
                                "target_lang_sense_clarification": "пряность, например имбирь"
                            },
                            {
                                "target_lang_word": "коренья",
                                "target_lang_sense_clarification": "овощи или пряности, используемые для супов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b1fb04-386d-39be-9f0d-99542bf26bb4",
                    "sense_definition": "eufemistyczne lub potoczne określenie męskiego narządu płciowego",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seksualność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starej literaturze czasem pojawiało się porównanie, że u mężczyzny <w>korzeń</w> twardnieje jak sosna.",
                            "target_lang_translations": {
                                "ru": "В старой литературе иногда встречалось сравнение, что у мужчины <w>корень</w> твердеет, как сосна."
                            }
                        },
                        {
                            "text": "Autor użył metafory, opisując męski <w>korzeń</w> w sposób bardzo poetycki.",
                            "target_lang_translations": {
                                "ru": "Автор использовал метафору, описывая мужской <w>корень</w> очень поэтично."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane jako eufemizm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "эвфемистическое или разговорное обозначение мужского полового органа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корень",
                                "target_lang_sense_clarification": "эвфемизм в литературе"
                            }
                        ]
                    }
                }
            ]
        },
