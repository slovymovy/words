                        "examples": [
                            {
                                "example_id": "24dcdd17-e1ad-46d9-998b-cfe2a3a0ab77",
                                "sense_id": "22a0f7a4-f93a-3ee8-8a09-f146d3991b6e",
                                "text": "Bizarre que le congélo soit encore plein à ras bord, vu que Rolo nous a servi du cabillaud tous les soirs pendant une semaine, se dit Mike."
                            },
                            {
                                "example_id": "bfcaa873-1cb5-4ce1-a836-23c2de6d235a",
                                "sense_id": "22a0f7a4-f93a-3ee8-8a09-f146d3991b6e",
                                "text": "Je l'ai foutue dans le congélo en attendant. — Dans le congélo ? — Je pouvais pas la laisser sur le tapis."
                            },
                            {
                                "example_id": "ffcae146-951f-44d9-bbd1-d97b481598ed",
                                "sense_id": "22a0f7a4-f93a-3ee8-8a09-f146d3991b6e",
                                "text": "Il rangea le bac à glaçons dans le congélo et prit les Coca pour remonter."
                            }
                        ]
                    }
