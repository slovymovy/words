                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6206a0ef-5215-3f99-8263-5831e287b837",
                                        "entry_id": "ba7e5fbd-9197-3c38-9561-be08d926ce2c",
                                        "glosses": [
                                            "A type of soft leather, made from calfskin, with a brushed texture to resemble fabric, often used to make boots, clothing and fashion accessories."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a553d2d-a387-4b25-b421-74338d0d6dbc",
                                                "sense_id": "6206a0ef-5215-3f99-8263-5831e287b837",
                                                "text": "“She sheathed her legs in the sheerest of the nylons that her father had brought back from the Continent, and slipped her feet into the toeless, high-heeled shoes of black suède.”"
                                            },
                                            {
                                                "example_id": "8a50b4b9-85b6-4e7e-bf88-cb19b356d573",
                                                "sense_id": "6206a0ef-5215-3f99-8263-5831e287b837",
                                                "text": "Richard DeLongpre: Mmm, your belly skin is like suede.\nJeremy DeLongpre: Thanks.\nRichard: Tough but soft, like a man."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suede",
