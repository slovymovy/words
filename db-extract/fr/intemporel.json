        "fr-extract.jsonl": [
            {
                "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                "word": "intemporel",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73e84fe0-4bdb-4a49-8644-e1272c459c7e",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "intemporels"
                    },
                    {
                        "form_id": "db6a4607-608f-4882-84fa-53ccaa66005e",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "intemporelle"
                    },
                    {
                        "form_id": "7459c70f-8c5a-47fa-9291-7ecb3861e9bd",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "intemporelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "glosses": [
                            "Que l’on ne peut dater, qui est de toutes les époques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3b2a18-a76f-4fa1-b259-c0bfaa990c58",
                                "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                                "text": "Voici une étape aussi sauvage qu'inédite entre l’intemporel village de Condé-Sainte-Libiaire et la fameuse ancienne chocolaterie de Noisiel. Cet itinéraire offre de magnifiques passages au plus près la Marne."
                            },
                            {
                                "example_id": "d608107d-f904-40be-ac5a-c45e82c0be97",
                                "sense_id": "048bfb34-9abd-3511-a185-14144a697620",
                                "text": "Elle portait un pantalon de velours intemporel et un pull à col roulé fluide qui glissait sur son torse mince."
                            }
                        ]
                    },
                    {
                        "sense_id": "569e7d5f-960b-3a08-9667-1f983ea6e925",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "glosses": [
                            "Qui reste valable en tout temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90bc3b5b-4b0d-4d42-b722-230e175d0b05",
                                "sense_id": "569e7d5f-960b-3a08-9667-1f983ea6e925",
                                "text": "Lorsque des dispositions sont insérées dans un code, ce qui est devenu un cas de figure courant, elles doivent revêtir le caractère intemporel de celui-ci. Par suite, on n’écrit pas : « Il est créé une commission nationale de… chargée de… », mais « La commission nationale… est chargée de… »."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff0f7d84-7f87-31a1-9f36-f7abc0136a3b",
                        "entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "glosses": [
                            "Impérissable, éternel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26f12df-7718-4ba3-86ee-c1e8e81463e2",
                                "sense_id": "ff0f7d84-7f87-31a1-9f36-f7abc0136a3b",
                                "text": "Ces festivités, ce sont aussi des moments emprunts de coutumes quasi immuables. …. Il s’agit-là des valeurs intemporelles du Têt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1da819b6-bb54-4f16-aeed-e054994a7c66",
                        "source_entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "target_lang_word": "eternal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eternal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                                        "entry_id": "86f9ea91-0059-3d4c-b697-5ca73ddc501c",
                                        "glosses": [
                                            "Lasting forever; unending."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5b497c-a716-4b86-b706-5c10dc303308",
                                                "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                                                "text": "But here again it is another question, quite different from our having an idea of eternity, to know whether there were any real being, whose duration has been eternal."
                                            },
                                            {
                                                "example_id": "b0e65ea7-4d4a-4907-8f66-d05721ecaa58",
                                                "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                                                "text": "Thy smoking altar shall be fat with food / Of incense and the grateful steam of blood; / Burnt-offerings morn and evening shall be thine, / And fires eternal in thy temple shine."
                                            },
                                            {
                                                "example_id": "8ca3ffed-8e58-40d2-ad67-7c8e93f504f9",
                                                "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                                                "text": "Organic life is nothing but a genetic mutation, an accident. Your lives are measured in years and decades. You wither and die.\nWe are eternal. The pinnacle of evolution and existence. Before us, you are nothing. Your extinction is inevitable. We are the end of everything."
                                            },
                                            {
                                                "example_id": "95fcbef4-03db-46dc-ba91-f86d3d9812a0",
                                                "sense_id": "7937a72d-2a98-30bf-9da7-d365b9f43036",
                                                "text": "In a bid to understand the eternal mystery that is woman, Bart goes to the least qualified possible source for advice and counsel: his father, who remarkably seems to have made it to his mid-30s without quite figuring out much of anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f99850a3-3ccc-373e-9164-ec60cf5ac767",
                                        "entry_id": "86f9ea91-0059-3d4c-b697-5ca73ddc501c",
                                        "glosses": [
                                            "Existing outside time; as opposed to sempiternal, existing within time but everlastingly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f568bedc-f903-3667-8e37-e136e20a562f",
                                        "entry_id": "86f9ea91-0059-3d4c-b697-5ca73ddc501c",
                                        "glosses": [
                                            "Constant; perpetual; ceaseless; ever-present."
                                        ],
                                        "tags": [
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "219296e1-3614-486f-b532-7edde1c3dd45",
                                                "sense_id": "f568bedc-f903-3667-8e37-e136e20a562f",
                                                "text": "Beneath him you might have seen the three of us - myself, sunburnt, young, and vigorous after our open-air tramp; Summerlee, solemn but still critical, behind his eternal pipe; Lord John, as keen as a razor-edge, with his supple, alert figure leaning upon his rifle, and his eager eyes fixed eagerly upon the speaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc241f89-feaf-32c3-99b2-0f44186e9865",
                                        "entry_id": "86f9ea91-0059-3d4c-b697-5ca73ddc501c",
                                        "glosses": [
                                            "Exceedingly great or bad; used as an intensifier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08fad33-2b48-476f-9dbf-b1cb0d824b45",
                                                "sense_id": "cc241f89-feaf-32c3-99b2-0f44186e9865",
                                                "text": "some eternal villain"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eternal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4549d7f9-bc92-3125-9ad7-75029bbac047",
                                        "entry_id": "acfdd9bc-440a-32e0-83ef-3863ded25e24",
                                        "glosses": [
                                            "One who lives forever; an immortal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2847fb4d-898a-46e8-9c94-48d6e503112e",
                                                "sense_id": "4549d7f9-bc92-3125-9ad7-75029bbac047",
                                                "text": "Yes, I want that raw power that is only offered to the eternals or creators"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f85ecff-656d-4ce3-bea9-f937f9893595",
                        "source_entry_id": "1cefc302-f126-3703-bab8-49a60096652a",
                        "target_lang_word": "timeless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timeless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6924f3-112d-37ff-bb79-0bd1990ae32b",
                                        "entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                                        "glosses": [
                                            "Eternal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc368f42-e45b-4363-a325-b0fe6f682b70",
                                                "sense_id": "bf6924f3-112d-37ff-bb79-0bd1990ae32b",
                                                "text": "When Worlds, that count his Circles now, unhing’d,\n(Fate the loud Signal sounding) headlong rush\nTo timeless Night and Chaos, whence they rose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caac8cfa-c888-3f9d-bf53-9e7f98726f26",
                                        "entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                                        "glosses": [
                                            "Not affected by time; ageless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68a45d00-7ca5-3128-b5fd-26b538152560",
                                        "entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                                        "glosses": [
                                            "Done at an improper time; unseasonable; untimely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395e3d6b-f92f-4a71-a56a-3af433191c6d",
                                                "sense_id": "68a45d00-7ca5-3128-b5fd-26b538152560",
                                                "text": "Must I behold thy timeless, cruel death?"
                                            },
                                            {
                                                "example_id": "d05070b4-ae72-472c-ac28-b32b99ead91b",
                                                "sense_id": "68a45d00-7ca5-3128-b5fd-26b538152560",
                                                "text": "The lamp of day is quench’d beneath the deep,\nAnd soft approach the balmy hours of sleep:\nNor fits it to prolong the heav’nly feast\nTimeless, indecent, but retire to rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90161315-1368-3dbe-8958-4fd5117643ab",
                                        "entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                                        "glosses": [
                                            "Not decreasing over time in quality and appeal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edcf2782-7fbb-49cd-9d7f-8487ea736ddd",
                                                "sense_id": "90161315-1368-3dbe-8958-4fd5117643ab",
                                                "text": "The cave carvings have a timeless beauty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c012a2-b921-379c-8784-6e4d9efa37ef",
                                        "entry_id": "98630a2a-7888-3c9a-bc0d-1bbe6c850e24",
                                        "glosses": [
                                            "Without a time limit; untimed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9bca9e6-35be-4359-8147-20fe5df6c6bd",
                                                "sense_id": "f5c012a2-b921-379c-8784-6e4d9efa37ef",
                                                "text": "a timeless cricket match"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "timeless",
                                "target_lang_code": "en",
                                "target_senses": [
