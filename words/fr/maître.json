                {
                    "sense_id": "de889242-73ea-340c-903e-12abc8cfa7c6",
                    "sense_definition": "Dispositif ou processus qui commande ou synchronise d'autres éléments dépendants.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le disque dur a été configuré en <w>maître</w> sur cette ancienne carte mère."
                        },
                        {
                            "text": "Le serveur <w>maître</w> distribue régulièrement les données vers les nœuds secondaires."
                        }
                    ]
                }
            ]
