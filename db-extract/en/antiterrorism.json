                                    {
                                        "sense_id": "22632e16-598d-3704-a459-b8b1e892a2aa",
                                        "entry_id": "a098206e-cd43-3774-b643-7e5818699c4f",
                                        "glosses": [
                                            "Ensemble des opérations, stratégies, etc., pour lutter contre le terrorisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f32383-4880-42fe-8496-696ea3960e2f",
                                                "sense_id": "22632e16-598d-3704-a459-b8b1e892a2aa",
                                                "text": "La DGSE a l'un des service de renseignements occidentaux les plus performants en matière de contreterrorisme islamiste radical."
                                            },
                                            {
                                                "example_id": "54e97883-093d-4548-838b-17bb02768625",
                                                "sense_id": "22632e16-598d-3704-a459-b8b1e892a2aa",
                                                "text": "Une unité d'élite spécialisée dans le contreterrorisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4d2c5bd-f996-4ca8-a05f-8736408f3789",
                        "source_entry_id": "5c71c735-473f-36af-87c5-4d1053e461c6",
                        "source_sense_id": "c88408a4-45a0-3a4c-b963-5e4e197d9a69",
                        "source_sense_description": "activity aiming at opposing terrorism",
                        "target_lang_word": "Terrorismusbekämpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrorismusbekämpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c924f061-5c8b-30e0-9101-a63b92e519c6",
                                        "entry_id": "fde7f65a-5dc1-3a42-8e8e-bd3140711c6e",
                                        "glosses": [
                                            "Bekämpfung des Terrorismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75dd7fff-8e48-460d-9fdd-30630aad22e2",
                                                "sense_id": "c924f061-5c8b-30e0-9101-a63b92e519c6",
                                                "text": "„Datenschutz und Terrorismusbekämpfung sind nach Ansicht des rheinland-pfälzischen Experten Dieter Kugelmann vereinbar.“"
                                            },
                                            {
                                                "example_id": "6bbde05a-480a-4fcb-a653-ca5a1f6fb0e4",
                                                "sense_id": "c924f061-5c8b-30e0-9101-a63b92e519c6",
                                                "text": "„Innenminister Kickl plant die Neuaufstellung des Bundesamts für Verfassungsschutz und Terrorismusbekämpfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0544279-c22f-4398-8b4b-475195fd0712",
                        "source_entry_id": "5c71c735-473f-36af-87c5-4d1053e461c6",
                        "source_sense_id": "c88408a4-45a0-3a4c-b963-5e4e197d9a69",
                        "source_sense_description": "activity aiming at opposing terrorism",
                        "target_lang_word": "Terrorabwehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terrorabwehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad0b81e-65ff-32ac-b2b8-71781e9b7cef",
                                        "entry_id": "f344d364-a6f4-3855-b8ff-4b0c50d3e50f",
                                        "glosses": [
                                            "Maßnahmen zur Verteidigung gegen terroristische Angriffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f888334-a5a8-4543-bf14-4b07348ae587",
                                                "sense_id": "9ad0b81e-65ff-32ac-b2b8-71781e9b7cef",
                                                "text": "„Denn das ist der springende Punkt: Nichts Nennenswertes spricht dafür, daß bei der Terrorabwehr durch die Polizei das Motto gilt ‚Viel hilft viel‘.“"
                                            },
                                            {
                                                "example_id": "2e0d6223-d615-4c59-9cd1-9e190fa1ece0",
                                                "sense_id": "9ad0b81e-65ff-32ac-b2b8-71781e9b7cef",
                                                "text": "„Darf ein Staat notfalls Unschuldige opfern, wenn dies zur Terrorabwehr erforderlich ist?“"
                                            },
                                            {
                                                "example_id": "8149de4b-7d66-48f1-933d-4d05768eb426",
                                                "sense_id": "9ad0b81e-65ff-32ac-b2b8-71781e9b7cef",
                                                "text": "„Die Lufthansa hat keinen Anspruch auf Kostenerstattung für die zur Terrorabwehr eingesetzten Bundespolizisten in ihren Flugzeugen.“"
                                            },
                                            {
                                                "example_id": "2dab4ca4-f108-4eda-b87c-50fe89a54cd1",
                                                "sense_id": "9ad0b81e-65ff-32ac-b2b8-71781e9b7cef",
                                                "text": "„Da Attentäter ihre Taktiken aber änderten, müsse sich auch die Terrorabwehr anpassen, betonte der EU-Sicherheitskommissar Julian King am Mittwoch in Brüssel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
