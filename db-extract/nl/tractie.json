                        "translation_id": "05f6e127-653b-4f06-b55e-bfe8dd7ada5d",
                        "source_entry_id": "92885c10-9e24-3c51-8ce8-b952511d4360",
                        "target_lang_word": "traction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "666384ef-849b-3fef-a06d-7d4b38c981c0",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Action de tirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca8e6f9-5cdc-4ddc-bc00-7594cb8d1d9c",
                                                "sense_id": "666384ef-849b-3fef-a06d-7d4b38c981c0",
                                                "text": "Deux fils de même ténacité, mais de numéros différents, qui doivent être tendus conséquemment avec la même traction, ne peuvent donc pas, au dévidoir, prendre le même dispositif de tension."
                                            },
                                            {
                                                "example_id": "7d50f1ad-d854-4b1b-b0c3-80f920306833",
                                                "sense_id": "666384ef-849b-3fef-a06d-7d4b38c981c0",
                                                "text": "Deux demi-clefs inversées assurées d’un tour mort frappé serré, voilà un nœud que la plus violente traction ne ferait que renforcer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c298b8f4-4b54-337e-ba22-e8da4aa67a84",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Propriété de résistance d'un matériau à la rupture sous une sollicitation de type allongement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb3a748-ca8f-495f-a39e-c3dc861d33e9",
                                                "sense_id": "c298b8f4-4b54-337e-ba22-e8da4aa67a84",
                                                "text": "Le principal avantage des vis à bois est de permettre des assemblages résistant à la traction, même lorsqu'un seul côté est accessible. Elles peuvent donc être utilisées en cas de sollicitation de cisaillement accompagnée de traction parallèle à la tige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8422518f-e659-37a7-b140-7b3919d2c30a",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Action de mouvoir un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52460d9b-6f60-4a73-8941-c026483c90d1",
                                                "sense_id": "8422518f-e659-37a7-b140-7b3919d2c30a",
                                                "text": "La traction électrique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8edb5897-d8ce-33e7-8cdd-6a5fd5ab4a21",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Ce qui concerne les transports et le matériel qui y est utilisé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f320172-2e8d-3e78-af3c-e4bbd62158c3",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Automobile de type Citroën Traction Avant."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "362849d0-9c20-47ef-81af-afa89fe739f9",
                                                "sense_id": "4f320172-2e8d-3e78-af3c-e4bbd62158c3",
                                                "text": "Le motard découvrit ce qu’il cherchait dans l’une des poches pratiquées dans le capitonnage des portières et, sans se donner la peine de procéder à une vérification, il dégonfla les pneus de la traction de quatre coups de poinçon, ramassa le couteau, réenfourcha sa machine et fila."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4f18f9-f79d-3941-b3e4-72584d2d8081",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Tout véhicule de type traction avant."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d27f280-cae8-4bcc-b317-2cc349e8911c",
                                                "sense_id": "4a4f18f9-f79d-3941-b3e4-72584d2d8081",
                                                "text": "Une propulsion sera toujours moins à l’aise sur neige qu’une traction ou une intégrale, mais avec les bons pneus ou chaînes, et surtout de la vigilance, il sera possible de rentrer à la maison."
                                            },
                                            {
                                                "example_id": "11f59485-7cb1-46ea-bc86-dcb55eacf58a",
                                                "sense_id": "4a4f18f9-f79d-3941-b3e4-72584d2d8081",
                                                "text": "Vous roulez en Traction ou en 403, des véhicules non équipés de ceinture à leur sortie d’usine, pas de panique. « On ne peut vous reprocher d’utiliser le véhicule tel qu’il était vendu à l’époque. Si votre véhicule n’est pas équipé, vous avez tout à fait le droit de rouler avec, sans ceinture. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82eebfcd-9fbc-3c05-a2ed-24ac4f423b61",
                                        "entry_id": "24d754a1-4a33-3d80-a3fc-0d1ef22983fc",
                                        "glosses": [
                                            "Exercice qui consiste à se hisser à la force des bras en tenant une barre horizontale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396f6f56-c3f3-4655-b4a9-423c1c9bec8c",
                                                "sense_id": "82eebfcd-9fbc-3c05-a2ed-24ac4f423b61",
                                                "text": "Pour agripper le sommet du mur il n’eut recours à l’aide de personne ; une traction le rétablit ; à présent, tout debout, il avançait sur cette crête, évitant les tessons qui la hérissaient par endroits."
                                            }
                                        ]
                                    }
                                ]
