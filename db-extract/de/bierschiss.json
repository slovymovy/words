                        ],
                        "examples": [
                            {
                                "example_id": "718b64d5-5a1f-4cfa-8139-27558c4297a2",
                                "sense_id": "4f6021b2-b788-3fdb-918f-2466e402e8b3",
                                "text": "Nach einer durchzechten Nacht leide ich meist unter Bierschiss."
                            },
                            {
                                "example_id": "6d280d60-17b6-45fc-aaf7-b895ecffc389",
                                "sense_id": "4f6021b2-b788-3fdb-918f-2466e402e8b3",
                                "text": "Du solltest nicht so viel trinken, sonst hast du morgen Bierschiss."
                            },
                            {
                                "example_id": "c2af1d88-f167-4027-b570-bf4b4ae9c879",
                                "sense_id": "4f6021b2-b788-3fdb-918f-2466e402e8b3",
                                "text": "„Es war das Bier vom Vorabend, eins zu viel, und was ich jetzt kommen spürte, nannte man Bierschiss.“"
                            },
                            {
                                "example_id": "1971eec5-1a04-4d83-a7d6-4b272e7663ac",
                                "sense_id": "4f6021b2-b788-3fdb-918f-2466e402e8b3",
                                "text": "„Außerdem sei allgemein bekannt, dass die Düsseldorfer Alt-Katholiken ihren eigenen Bierschiss als Bier feilböten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
