    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72e99abc-5d06-3d27-af36-fd690fb9e777",
                    "sense_definition": "Suite ou série ininterrompue de personnes, d'objets ou d'événements qui se succèdent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "serie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>succession</w> d'événements imprévus a complètement bouleversé notre emploi du temps.",
                            "target_lang_translations": {
                                "en": "A <w>series</w> of unforeseen events completely disrupted our schedule.",
                                "ru": "<w>Череда</w> непредвиденных событий полностью нарушила наш распорядок дня.",
                                "de": "Eine <w>Reihe</w> unvorhergesehener Ereignisse hat unseren Terminplan völlig durcheinandergebracht.",
                                "es": "Una <w>serie</w> de acontecimientos imprevistos trastocó por completo nuestra agenda.",
                                "zh": "一<w>系列</w>意外事件彻底打乱了我们的日程安排。"
                            }
                        },
                        {
                            "text": "Le pays a connu une <w>succession</w> de crises économiques au cours de la décennie.",
                            "target_lang_translations": {
                                "en": "The country experienced a <w>series</w> of economic crises over the course of the decade.",
                                "ru": "В течение десятилетия страна пережила <w>череду</w> экономических кризисов.",
                                "de": "Das Land erlebte im Laufe des Jahrzehnts eine <w>Reihe</w> von Wirtschaftskrisen.",
                                "es": "El país atravesó una <w>serie</w> de crisis económicas a lo largo de la década.",
                                "zh": "这个国家在这十年间经历了一<w>系列</w>经济危机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enchaînement",
                        "suite",
                        "série"
                    ],
                    "common_phrases": [
                        "succession rapide",
                        "succession de victoires",
                        "succession ininterrompue"
                    ],
                    "target_lang_definitions": {
                        "en": "An unbroken series of people, objects, or events that follow one another.",
                        "ru": "Непрерывный ряд людей, предметов или событий, следующих друг за другом.",
                        "de": "Ununterbrochene Reihe von Personen, Gegenständen oder Ereignissen, die aufeinanderfolgen.",
                        "es": "Conjunto ininterrumpido de personas, objetos o acontecimientos que se suceden unos a otros.",
                        "zh": "一个接一个出现、不间断的人、事物或事件构成的序列。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "series",
                                "target_lang_sense_clarification": "of events or things"
                            },
                            {
                                "target_lang_word": "sequence",
                                "target_lang_sense_clarification": "ordered arrangement of events"
                            },
                            {
                                "target_lang_word": "chain",
                                "target_lang_sense_clarification": "linked events, often unwelcome"
                            }
                        ],
                        "ru": [
