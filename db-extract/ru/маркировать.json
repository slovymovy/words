                                                "sense_id": "e5e19549-36ad-3def-8d1c-f71c0b3c3b13",
                                                "text": "Klaus ist nicht krank, der markiert bloß!"
                                            },
                                            {
                                                "example_id": "eaf15d12-2eb5-462a-a15c-44424a18d2ef",
                                                "sense_id": "e5e19549-36ad-3def-8d1c-f71c0b3c3b13",
                                                "text": "Muss du wieder den Helden markieren? Komm da mal wieder runter von dem Baugerüst!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "714521a5-f346-38cc-80d9-c1e79d0dd8cd",
                                        "entry_id": "6967b9ab-c84a-310e-b31c-9f276495f144",
                                        "glosses": [
                                            "etwas durch sein Vorhandensein bezeichnen/beweisen und damit einen besonderen Moment hervorheben"
                                        ],
