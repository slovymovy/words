                "senses": [
                    {
                        "sense_id": "0e3ca8b2-cbb6-36ab-9407-558c236b0472",
                        "entry_id": "b29cb92b-d7ae-3b6d-8123-f73e9451d96e",
                        "glosses": [
                            "плоская кривая, образуемая точкой, жёстко связанной с окружностью, катящейся по внешней стороне другой окружности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc37d0d7-91aa-4aa8-a2ee-a0ebd937b124",
                                "sense_id": "0e3ca8b2-cbb6-36ab-9407-558c236b0472",
                                "text": "При одновременном наложении на пластины осциллографа напряжений, отличающихся друг от друга по амплитуде и частоте, электронный пучок описывает на экране сложную замкнутую кривую с завитками (эпитрохоиду)."
                            }
                        ]
                    }
                ],
