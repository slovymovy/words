        "fr-extract.jsonl": [
            {
                "entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                "word": "violoncelliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d968d56e-2d01-44b5-8f7f-f0c8518c1f48",
                        "entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "violoncellistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4d6cf6c-1995-3ab1-b03f-897ca71ad8be",
                        "entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                        "glosses": [
                            "Instrumentiste qui joue du violoncelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1dcef9-5687-43d7-b2bc-4e138ab29089",
                                "sense_id": "f4d6cf6c-1995-3ab1-b03f-897ca71ad8be",
                                "text": "A droite du piano, le violoncelliste émergeait de la fosse, la tête appuyée contre la crosse de son instrument dont il pinçait les cordes en regardant fixement devant lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec20cd12-acc3-4ea8-96e9-2a7edfdd12ad",
                        "source_entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                        "source_sense_id": "f4d6cf6c-1995-3ab1-b03f-897ca71ad8be",
                        "target_lang_word": "Cellist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cellist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                        "entry_id": "71e6be28-c4d4-3973-a974-d63200e6ae1e",
                                        "glosses": [
                                            "(männliche^☆) Person, die Cello spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417f2fe8-46d3-46dc-a045-062489a47ed6",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Bis Celli, Cellisten, Koffer, Kisten, Taschen in den zugeteilten Stockwerken sind, ist die Zeit gekommen, bis zu der wieder alles unten sein muss, um die Proben pünktlich zu erreichen.“"
                                            },
                                            {
                                                "example_id": "cb6356ef-9643-41a4-a8dd-e4d7b4b5bbfc",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Er war nach den mir überlieferten Berichten der Cellist im Bunde.“"
                                            },
                                            {
                                                "example_id": "c50f51d1-7d18-484e-bea4-ecd76f97b03a",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Bei einem Straßenfest stand ich mit zwei jungen Germanistikstudentinnen und einem Cellisten aus der Nachbarschaft herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34489a79-5a79-435c-96a8-e0f6a31d11a0",
                        "source_entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                        "source_sense_id": "f4d6cf6c-1995-3ab1-b03f-897ca71ad8be",
                        "target_lang_word": "Cellistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cellistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c9ae801-96ef-3f90-9a9f-9d48897cdefc",
                                        "entry_id": "89c5d75b-bf10-364b-b45f-f0b21c6daa04",
                                        "glosses": [
                                            "weibliche Person, die Cello spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98cc5bb8-ea6e-43e9-a5d8-ac074223a8b5",
                                                "sense_id": "6c9ae801-96ef-3f90-9a9f-9d48897cdefc",
                                                "text": "Die Cellistin kam zu spät zur Orchesterprobe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fde789a8-0619-4137-957d-81eb19c8ace6",
                        "source_entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
                        "source_sense_id": "f4d6cf6c-1995-3ab1-b03f-897ca71ad8be",
                        "target_lang_word": "cellist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cellist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8950179-869b-3318-ac64-2e59b92abfec",
                                        "entry_id": "cf931c00-ea81-34f8-92c2-735cca9ccbeb",
                                        "glosses": [
                                            "Someone who plays the cello."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0cca9e2-9df3-4889-8888-04e84d2358a0",
                                                "sense_id": "f8950179-869b-3318-ac64-2e59b92abfec",
                                                "text": "And the cello concerto was strikingly different on Sunday: at Weill, the ensemble included two violinists and one violist, cellist, bassist and lutenist, but on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            },
                                            {
                                                "example_id": "9f681e7b-8f54-4944-a2a7-5746a6344d13",
                                                "sense_id": "f8950179-869b-3318-ac64-2e59b92abfec",
                                                "text": "Though relative newcomers to classical music, they seemed closely attuned to the eight cellists onstage, raising their heads abruptly as the piece’s languid strains gave way to rapid-fire bow strokes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a68893d1-9959-4711-987b-a608673e9b4f",
                        "source_entry_id": "4dee423c-5740-30da-af45-dfd007728c04",
