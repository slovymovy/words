                ],
                "senses": [
                    {
                        "sense_id": "6a9df9a3-db36-3d1c-9fa1-6eb7e26b82d7",
                        "entry_id": "607617b9-9d47-31b7-b586-39bcc2c23072",
                        "glosses": [
                            "разг., ласк. к муж (супруг)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27911d0b-3204-4a83-9537-3a182dd2b954",
                                "sense_id": "6a9df9a3-db36-3d1c-9fa1-6eb7e26b82d7",
                                "text": "[Пульхерия Андревна Гущина] Только толстеет. Наградил бог муженьком, уж нечего сказать! [Татьяна Никоновна] Ну, вам грех на мужа жаловаться, он у вас добышник хороший."
                            },
                            {
                                "example_id": "86364125-6e53-46c8-a559-0baff04fbef4",
                                "sense_id": "6a9df9a3-db36-3d1c-9fa1-6eb7e26b82d7",
                                "text": "Ну, она и приласкала кузининого муженька, а тот, как водится, растаял."
                            },
                            {
                                "example_id": "90de2e57-7dbb-4cba-a91b-65686b2ab22c",
                                "sense_id": "6a9df9a3-db36-3d1c-9fa1-6eb7e26b82d7",
                                "text": "― У вас муженёк-то есть? ― Помер. Сын у меня…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f6f09c8-dd06-4e8d-bad7-4b64f394ef92",
                        "source_entry_id": "607617b9-9d47-31b7-b586-39bcc2c23072",
                        "source_sense_id": "6a9df9a3-db36-3d1c-9fa1-6eb7e26b82d7",
                        "target_lang_word": "hubby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                        "entry_id": "4ecc19ce-741a-37db-a124-946a517ff875",
                                        "glosses": [
                                            "Husband."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6721eb9d-b1d4-483e-9ccf-496b6e12f947",
                                                "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                                "text": "Laura thought Jack was the most wonderful hubby in the world."
                                            },
                                            {
                                                "example_id": "971291df-32b1-4e21-bcb9-c4fff7d2e042",
                                                "sense_id": "1e495c87-f011-331a-a0ae-0f4f2802a788",
                                                "text": "“But they have done more than talk — they have written — written to my hubby — I'm sure of it,” said the Man's Wife, and she pulled a letter from her husband out of her saddle-pocket and gave it to the Tertium Quid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c0f73f-8267-363c-8d29-04904d652407",
                                        "entry_id": "f7d7746e-876a-3e27-92a9-5dfaa22e2f94",
                                        "glosses": [
                                            "Full of hubs or protuberances."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bfe620-583e-422e-842f-730e748c96d0",
                                                "sense_id": "c8c0f73f-8267-363c-8d29-04904d652407",
                                                "text": "A road that has been frozen while muddy is hubby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
