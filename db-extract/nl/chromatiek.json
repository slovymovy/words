                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac80fc27-eb64-3dc3-8230-c0b7e4af9574",
                                        "entry_id": "7cbdf617-108f-3d62-9974-1e9c9c62748d",
                                        "glosses": [
                                            "Relatif aux couleurs, excluant le blanc, le noir et le gris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d8a314-b82d-4b8f-b351-4b741a17fcfb",
                                                "sense_id": "ac80fc27-eb64-3dc3-8230-c0b7e4af9574",
                                                "text": "Longtemps Barbie s’est située à l’opposé de cette tendance et a suscité contre elle, principalement en Allemagne, en Grande-Bretagne et en Scandinavie, l’hostilité de courants féministes prônant en tous domaines la non-distinction chromatique entre les hommes et les femmes."
                                            },
                                            {
                                                "example_id": "65d9fa17-299e-45f4-a244-4900fa117608",
                                                "sense_id": "ac80fc27-eb64-3dc3-8230-c0b7e4af9574",
                                                "text": "En ce siècle romantique, le grand public aussi bien que les scientifiques développent une nomenclature quelque peu chromatique des grandes épidémies : ainsi appelle-t-on la tuberculose « mort blanche » ou « peste blanche »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21c7624-cd84-3094-b59e-9e04ad1c6b9f",
                                        "entry_id": "7cbdf617-108f-3d62-9974-1e9c9c62748d",
                                        "glosses": [
                                            "Qui procède par demi-tons consécutifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48049108-88a3-42a6-abbb-765815caa9b0",
                                                "sense_id": "a21c7624-cd84-3094-b59e-9e04ad1c6b9f",
                                                "text": "Les chromatiques en montant et en descendant."
                                            },
                                            {
                                                "example_id": "2b4f023d-5f57-4ff3-b3aa-ab35d80c4097",
                                                "sense_id": "a21c7624-cd84-3094-b59e-9e04ad1c6b9f",
                                                "text": "Une gamme chromatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af8fe17-9e88-32ab-b065-990e9671b3bc",
                                        "entry_id": "7cbdf617-108f-3d62-9974-1e9c9c62748d",
                                        "glosses": [
                                            "Se disait chez les Anciens d’un des trois genres de leur musique, celui qui divisait la quarte en un ton et demi et deux demi-tons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3c21d0-f378-4a81-b98d-8129ca5ddaad",
                                                "sense_id": "7af8fe17-9e88-32ab-b065-990e9671b3bc",
                                                "text": "La musique des psaumes chantés ici appartient aux trois genres de la musique byzantine : diatonique, enharmonique et chromatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
