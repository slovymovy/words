                                "target_senses": [
                                    {
                                        "sense_id": "ece5d2e8-91f2-3e3f-b888-6709f5886d8d",
                                        "entry_id": "72a7f805-5403-37ec-bbc0-4b98f27e5c1b",
                                        "glosses": [
                                            "Tod einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0465b957-1cad-44fa-a638-ba884e3c992b",
                                                "sense_id": "ece5d2e8-91f2-3e3f-b888-6709f5886d8d",
                                                "text": "„Ich hatte zuviel vertrackte Sterbefälle mitangesehen.“"
                                            },
                                            {
                                                "example_id": "0577b745-21ab-4632-b3b3-b716188e606a",
                                                "sense_id": "ece5d2e8-91f2-3e3f-b888-6709f5886d8d",
                                                "text": "„Für die Beurkundung der Sterbefälle von Häftlingen der ehemaligen deutschen Konzentrationslager ist im Inland das Sonderstandesamt in Bad Arolsen ausschließlich zuständig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41d52724-08be-42cf-af3e-e9c84ccf3d7c",
                        "source_entry_id": "8874bae1-b0d9-36d8-9fdd-4f8739ded365",
                        "source_sense_id": "3cfb3409-9067-3ceb-b35f-e80e35ced6f5",
                        "source_sense_description": "het voorkomen van een gebeurtenis waarbij iemand overlijdt",
                        "target_lang_word": "decease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                        "entry_id": "3651deaa-168a-3f75-b992-98bfde8ddfc0",
                                        "glosses": [
                                            "Death, departure from life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb31956-a75c-44b8-854f-9050943038cc",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "So should that beauty which you hold in lease\nFind no determination: then you were\nYourself again after yourself's decease […]"
                                            },
                                            {
                                                "example_id": "fd4bf109-db3a-447b-9ea4-06e54bd0a7c1",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "I thought about my predecessor, who had died of drink and smoke; and I could have wished he had been so good as to live, and not bother me with his decease."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To die."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4740ce84-1841-4e5f-a67b-7154d3782fcc",
                                                "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                                "text": "After which usurped victorie, he presently deceased: and partly through the excessive joy he thereby conceived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73d6b95-b247-32bf-9276-fdf72cc7bd06",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To cause to die."
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
