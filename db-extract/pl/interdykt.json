                                "target_senses": [
                                    {
                                        "sense_id": "a18a6298-7611-3007-865d-7bb3a5c5abda",
                                        "entry_id": "3929264f-6cf9-3c93-97c8-bc14f5177d30",
                                        "glosses": [
                                            "A papal decree prohibiting the administration of the sacraments from a political entity under the power of a single person (e.g., a king or an oligarchy with similar powers). Extreme unction/Anointing of the Sick is excepted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c0af80d-0c0d-3c98-82a5-7493c0a1b9a0",
                                        "entry_id": "3929264f-6cf9-3c93-97c8-bc14f5177d30",
                                        "glosses": [
                                            "An injunction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734acef2-01e2-4636-87aa-869f376848b4",
                                                "sense_id": "8c0af80d-0c0d-3c98-82a5-7493c0a1b9a0",
                                                "text": "The Fife County Council, and other objectors, were successful in July [1950] in obtaining an interim interdict against this decision, but the Court of Session withdrew the interdict in January, and it was then stated that a civil court had no jurisdiction in the matter. […] Mr. Waller adds that when the railway was authorised in 1897, one of the clauses of the Act authorising the transfer of the line to the North British Railway provided that that company should work it in perpetuity, and it was this clause that caused the interim interdict to be granted."
                                            },
                                            {
                                                "example_id": "a28cd547-4c48-43ac-99e1-cee8540852bc",
                                                "sense_id": "8c0af80d-0c0d-3c98-82a5-7493c0a1b9a0",
                                                "text": "In May [1995], the court issued an interdict preventing the service withdrawal, pending consultation on the closure to passenger traffic of three short stretches of railway around Glasgow and its hinterland that were only used by the Fort William Sleeper - and for which BR had failed to invoke standard closure procedures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interdict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ea1f68-88a7-3100-954e-8b7ead27735a",
                                        "entry_id": "d182d2c4-35a3-33fd-a57a-c8469aaf3a5a",
                                        "glosses": [
                                            "To exclude (someone or somewhere) from participation in church services; to place under a religious interdict."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794072a0-5250-4eb4-8122-31cfadb7d140",
                                                "sense_id": "e9ea1f68-88a7-3100-954e-8b7ead27735a",
                                                "text": "An archbishop [may not only] excommunicate and interdict his suffragans, but his Vicar-General may also do the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f902278-ad29-3d72-b323-61e493ad3a91",
                                        "entry_id": "d182d2c4-35a3-33fd-a57a-c8469aaf3a5a",
                                        "glosses": [
                                            "To forbid (an action or thing) by formal or legal sanction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "577011da-19d1-4d47-baaf-b080390bbd2c",
                                                "sense_id": "1f902278-ad29-3d72-b323-61e493ad3a91",
                                                "text": "Charged not to touch the interdicted tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b8f2d87-7c10-32f4-8410-c4ee48584509",
                                        "entry_id": "d182d2c4-35a3-33fd-a57a-c8469aaf3a5a",
                                        "glosses": [
                                            "To forbid (someone) from doing something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cef7caa-0026-482f-9868-8f9489d5fbfc",
                                                "sense_id": "8b8f2d87-7c10-32f4-8410-c4ee48584509",
                                                "text": "Do not look so alarmed, Madame; every possible precaution has been taken to prevent infection. I have given the strictest orders to interdict any communication between her attendants and those devoted to your service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b3f4b5-40b2-3e92-a6fc-8a14062d4a3c",
                                        "entry_id": "d182d2c4-35a3-33fd-a57a-c8469aaf3a5a",
                                        "glosses": [
                                            "To impede (an enemy); to interrupt or destroy (enemy communications, supply lines etc)."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd84f4f-3924-48fc-89f5-426fc0f95703",
                                                "sense_id": "68b3f4b5-40b2-3e92-a6fc-8a14062d4a3c",
                                                "text": "Grant did not cease his efforts to interdict Lee's supply lines and break through the defenses."
                                            }
                                        ]
                                    }
                                ]
