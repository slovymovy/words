                    "target_lang_definitions": {
                        "ru": "Роликовые коньки с четырьмя колесами, расположенными попарно (два спереди, два сзади).",
                        "zh": "一种四个轮子两两并排排列的轮滑鞋。"
                    },
                    "translations": {
