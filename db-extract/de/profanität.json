                ],
                "senses": [
                    {
                        "sense_id": "1a33aea7-d1ee-30e0-b65f-b79f13401a6e",
                        "entry_id": "b2c4cbbc-37ad-3caf-a20e-4a4a897dfa44",
                        "glosses": [
                            "Eigenschaft, die sich nicht auf das religiöse Leben, sondern auf das weltliche (profane) Dasein bezieht"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1ac7a0e8-201c-4b53-8d6a-1cfd9c0ec475",
                                "sense_id": "1a33aea7-d1ee-30e0-b65f-b79f13401a6e",
                                "text": "„Wie vielleicht nie zuvor breche heute über das öffentliche und private Leben eine Flut der Profanität, der Säkularisierung und der Unmoral herein.“"
                            },
                            {
                                "example_id": "7f41f620-f93b-41be-bb83-a7df8f3ed064",
                                "sense_id": "1a33aea7-d1ee-30e0-b65f-b79f13401a6e",
                                "text": "„Ich kannte hohe Beamte da unten, auch Deutsche darunter, denen nicht wohl war, wenn sie nicht tagtäglich mit einigen Schock der allergröbsten Profanitäten um sich werfen konnten. Die geheimsten Partien der menschlichen Anatomie mit ihren Funktionen erfahren bei der geradezu erfinderischen Kombination in zotigen Profanitäten eine oft verblüffende Verwendung.“ (1936)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "697bce91-3e7a-325e-b634-b06d3cf99783",
                        "entry_id": "b2c4cbbc-37ad-3caf-a20e-4a4a897dfa44",
                        "glosses": [
                            "Eigenschaft/Handlung, die in deutlichem Maße alltägliches (profanes) Verhalten zeigt"
                        ],
                        "tags": [
                            "derogatory",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "f6d7fe2a-4f0b-4c8f-8a25-8c244dc7b0cb",
                                "sense_id": "697bce91-3e7a-325e-b634-b06d3cf99783",
                                "text": "„Ich kannte hohe Beamte da unten, auch Deutsche darunter, denen nicht wohl war, wenn sie nicht tagtäglich mit einigen Schock der allergröbsten Profanitäten um sich werfen konnten. Die geheimsten Partien der menschlichen Anatomie mit ihren Funktionen erfahren bei der geradezu erfinderischen Kombination in zotigen Profanitäten eine oft verblüffende Verwendung.“ (1936)"
                            },
                            {
                                "example_id": "fae94c97-1fe0-481b-8945-a2aaf5cbfbfd",
                                "sense_id": "697bce91-3e7a-325e-b634-b06d3cf99783",
                                "text": "„Um von derartigen Profanitäten umgeben allen Ernstes Poesie zu schreiben. Dafür musste man schon knochenhart sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
