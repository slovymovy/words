                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sluik</w> de goederen over de grens zonder dat iemand het merkt.",
                            "target_lang_translations": {
                                "en": "I <w>smuggle</w> the goods across the border without anyone noticing.",
                                "de": "Ich <w>schmuggle</w> die Waren über die Grenze, ohne dass es jemand bemerkt."
