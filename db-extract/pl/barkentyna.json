                        "target_lang_word": "barkentine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barkentine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9115f86-84d4-306a-b0b0-8aeb87b94e77",
                                        "entry_id": "114d02af-0219-3c76-ab12-2282c260c986",
                                        "glosses": [
                                            "Alternative spelling of barquentine."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f834938-f80e-48ac-b740-359c9af9f850",
                                                "sense_id": "b9115f86-84d4-306a-b0b0-8aeb87b94e77",
                                                "text": "There was a barkentine in Halifax harbor. That was a thing worth looking at in the year 1933."
                                            },
                                            {
                                                "example_id": "aaa9fe9b-9026-4e7d-ae86-56a729936e98",
                                                "sense_id": "b9115f86-84d4-306a-b0b0-8aeb87b94e77",
                                                "text": "The William Olsen, a San Francisco barkentine, kedged out into the lagoon as fast as possible, and through the tearing sheets of rain I glimpsed other vessels reaching for a holding-ground."
                                            },
                                            {
                                                "example_id": "98c44b69-b439-460e-8d0e-1daf32e7b59c",
                                                "sense_id": "b9115f86-84d4-306a-b0b0-8aeb87b94e77",
                                                "text": "She is passenger on the square-rigged barkentine Speedwell, now lying off the coast of Virginia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35618830-7375-4cad-a646-931c49bf8ce7",
                        "source_entry_id": "93e4c0b7-df6d-3bc7-a58e-0bd5e294d395",
                        "source_sense_id": "f9c03bc2-7824-3b22-bb0c-5805b5d67ebf",
                        "target_lang_word": "trois-mâts goélette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trois-mâts goélette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4b400a-01a0-3514-a088-0b10a2adaa70",
                                        "entry_id": "27fb6df7-177f-300f-ba46-7bc5a7fea1dd",
                                        "glosses": [
                                            "Trois-mâts gréé en voiles auriques, excepté le mât de misaine gréé en voiles carrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae4bf7b0-2077-4abd-ad3d-ecc3318a9d84",
                                                "sense_id": "9b4b400a-01a0-3514-a088-0b10a2adaa70",
                                                "text": "Le Français, bien qu'un très petit navire, était un excellent trois-mâts goélette auxiliaire de 250 tonneaux, mesurant 32 mètres de longueur sur 7m,50 de large, construit avec le plus grand soin par Gauthier père de Saint-Malo, doyen des constructeurs français, sur mes indications et sur celles du commandant de Gerlache, qui ne me ménagea jamais ses conseils éclairés"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
