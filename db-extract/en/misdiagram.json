                        "examples": [
                            {
                                "example_id": "0529e1ef-97f3-4324-8e3b-40f45810bd24",
                                "sense_id": "5348af04-8393-3c38-9653-285196635d89",
                                "text": "If the parser isn't sophisticated, it will misdiagram the sentence and won't know the difference between verb and subject."
                            },
                            {
                                "example_id": "ba3b1508-9757-4dfe-99a2-9b4398e47688",
                                "sense_id": "5348af04-8393-3c38-9653-285196635d89",
                                "text": "No one had a clue as to what terrible things she'd do to us if we misdiagrammed a sentence."
                            },
                            {
                                "example_id": "5c833898-374c-4aaf-af9d-ce4ca490a070",
                                "sense_id": "5348af04-8393-3c38-9653-285196635d89",
                                "text": "If you are missing any connections, or if you misdiagrammed, check the numbered arrows in the diagram against the numbered rules to see where you may have gone wrong."
