                                        "glosses": [
                                            "deutlich von den gesellschaftlichen Normen abweichend, oft euphemistisch für \\\"merkwürdig\\\" oder \\\"abnormal\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b489461-784d-4372-892f-8d0b761f5ae0",
                                                "sense_id": "3e79484d-90b4-32a8-b4bf-a48cf116db4f",
                                                "text": "Der Maler ist sehr talentiert, aber sehr exzentrisch, weshalb es niemand lange mit ihm aushält."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
