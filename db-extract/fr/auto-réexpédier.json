                "senses": [
                    {
                        "sense_id": "5dea8305-e38e-313c-9b66-d81e1a834353",
                        "entry_id": "4f83e9ac-7866-303d-96e7-95b6c5b85746",
                        "glosses": [
                            "Réexpédier automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d426c5-049c-4a5e-97ea-c3740f6980b0",
                                "sense_id": "5dea8305-e38e-313c-9b66-d81e1a834353",
                                "text": "Une grande difficulté (outre les multiples contre-temps et tâtonnements dus à l'apprentissage du langage), fut de trouver comment auto-réexpédier les valeurs des variables ne figurant pas dans le questionnaire."
                            },
                            {
                                "example_id": "ea83572e-ad45-42ca-859d-70bec7e488ea",
                                "sense_id": "5dea8305-e38e-313c-9b66-d81e1a834353",
                                "text": "Les questions ainsi que les pondérations pour chaque axe sont définies dans un tableau multidimensionnel au début, le score sur chaque dimension est mise à jour à chaque nouvelle question et auto-réexpédié pour la question suivante."
                            },
                            {
                                "example_id": "faecae90-5210-4cf2-b866-8c06cccdbafb",
                                "sense_id": "5dea8305-e38e-313c-9b66-d81e1a834353",
                                "text": "Le second s'étant auto-réexpédié dès décembre en Australie et la première ayant sauté fin janvier dans le train de nuit direction Berlin."
                            }
                        ]
                    }
