                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f8127b1-cf03-3c34-88aa-cef6d493504e",
                        "entry_id": "59397852-87d2-3ef8-9b0f-6eb57c5299a2",
                        "glosses": [
                            "Pièces du thorax des insectes hexapodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5fb67aa-f446-40ca-904d-e5f73ea8ae0b",
                                "sense_id": "8f8127b1-cf03-3c34-88aa-cef6d493504e",
                                "text": "La branche ou portion non annulaire de tous les épimères porte à sa face profonde un épidème membraneux pâle, plus ou moins large de l'une à l'autre. Une expansion ou épidème plus ou moins facilement apercevable relie chez les Glyciphages comme chez les Tyroglyphes l'extrémité externe du deuxième épimère à la base de la première patte, et celui-ci à la base du premier article du palpe."
                            }
                        ]
                    },
                    {
                        "sense_id": "1356f33b-2b69-3671-98f5-570585702abf",
                        "entry_id": "59397852-87d2-3ef8-9b0f-6eb57c5299a2",
                        "glosses": [
                            "Molécule organique ne différant de son isomère que par la configuration absolue d'un seul de leurs carbones asymétriques. Notamment utilisé pour les sucres."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "1a73147f-217a-4fa3-bd40-04a55ce14fde",
                                "sense_id": "1356f33b-2b69-3671-98f5-570585702abf",
                                "text": "Le galactose est un épimère du glucose au quatrième carbone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e19818c2-22ee-46bc-afa4-d09afd1e0b75",
                        "source_entry_id": "59397852-87d2-3ef8-9b0f-6eb57c5299a2",
                        "source_sense_description": "entomologie",
                        "target_lang_word": "epimere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epimere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c45a5fc4-febf-3d17-a234-9a01892d3e77",
                                        "entry_id": "9222ea60-d220-3ebc-8c6a-26b2e52f1be7",
                                        "glosses": [
                                            "One of the segments of the transverse axis, or the so-called homonymous parts; as, for example, one of the several segments of the extremities in vertebrates, or one of the similar segments in plants, as in a segmented leaf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936c4daa-47ae-42ee-b087-af5282ca0ff1",
                                                "sense_id": "c45a5fc4-febf-3d17-a234-9a01892d3e77",
                                                "text": "Four pairs of the leg epimeres are distinctly divided by a sejugal interval into two groups."
                                            },
                                            {
                                                "example_id": "65dff7cc-4321-4118-ae6b-cd161754d0b0",
                                                "sense_id": "c45a5fc4-febf-3d17-a234-9a01892d3e77",
                                                "text": "The mesoderm next becomes differentiated into three regions: a dorsal region, called the epimere, which lies to each side of the neural tube; a middle region called the mesomere or nephrotome, situated lateral and ventral to the epimere"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
