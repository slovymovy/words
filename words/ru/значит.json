{
    "word_family": [
        "значить",
        "значение",
        "значимый",
        "значительно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b77724da-af3d-3785-8b54-aa8ec1fadba7",
                    "sense_definition": "форма настоящего времени третьего лица единственного числа изъявительного наклонения глагола <w>значить</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если собака виляет хвостом, это <w>значит</w>, что она рада.",
                            "target_lang_translations": {
                                "en": "If a dog wags its tail, it <w>means</w> that it is happy.",
                                "zh": "如果狗摇尾巴，那<w>意味着</w>它很高兴。"
                            }
                        },
                        {
                            "text": "Твоё обещание много для меня <w>значит</w>.",
                            "target_lang_translations": {
                                "en": "Your promise <w>means</w> a lot to me.",
                                "zh": "你的承诺对我来说<w>意味着</w>很多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "что это значит",
                        "это значит",
                        "ничего не значит"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "3rd person singular present form of the verb <w>to mean</w>",
                        "zh": "动词“意味着”的第三人称单数现在时形式"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "means",
                                "target_lang_sense_clarification": "signifies or intends"
                            },
                            {
                                "target_lang_word": "it means",
                                "target_lang_sense_clarification": "implies"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意味着",
                                "target_lang_sense_clarification": "表示某种含义或意图"
                            },
                            {
                                "target_lang_word": "代表",
                                "target_lang_sense_clarification": "表示某种意义"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d835a560-4847-39a2-b59b-2265334ec1ca",
                    "sense_definition": "вводное слово, соответствующее по значению словам «стало быть», «следовательно»",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "logic_consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты молчишь, <w>значит</w>, ты согласен с нами.",
                            "target_lang_translations": {
                                "en": "You are silent, <w>so</w> you agree with us.",
                                "zh": "你沉默不语，<w>那么</w>你就是同意我们的看法了。"
                            }
                        },
                        {
                            "text": "Дверь заперта, <w>значит</w>, в магазине никого нет.",
                            "target_lang_translations": {
                                "en": "The door is locked, <w>so</w> there is no one in the shop.",
                                "zh": "门锁着，<w>那么</w>店里应该没人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "стало быть",
                        "следовательно",
                        "выходит",
                        "так что"
                    ],
                    "common_phrases": [
                        "а значит"
                    ],
                    "target_lang_definitions": {
                        "en": "introductory word indicating a logical conclusion, equivalent to 'therefore' or 'consequently'",
                        "zh": "用于引出逻辑结论的插入语，相当于“因此”或“那么”"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "indicating a conclusion"
                            },
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "in that case"
                            },
                            {
                                "target_lang_word": "therefore",
                                "target_lang_sense_clarification": "formal consequence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "表示推论"
                            },
                            {
                                "target_lang_word": "因此",
                                "target_lang_sense_clarification": "表示逻辑结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a830d1c9-a0de-39dc-9f0b-7afbc587a416",
                    "sense_definition": "употребляется при присоединении придаточной части предложения со значением следствия",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic_consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас нет денег, <w>значит</w>, мы не можем это купить.",
                            "target_lang_translations": {
                                "en": "We have no money, <w>so</w> we can't buy it.",
                                "zh": "我们没钱，<w>所以</w>买不了这个。"
                            }
                        },
                        {
                            "text": "Шел сильный дождь, <w>значит</w>, прогулка отменяется.",
                            "target_lang_translations": {
                                "en": "It was raining hard, <w>so</w> the walk is cancelled.",
                                "zh": "当时雨下得很大，<w>所以</w>散步取消了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "поэтому",
                        "следовательно"
                    ],
                    "target_lang_definitions": {
                        "en": "used to connect a clause expressing a consequence or result",
                        "zh": "用于连接表示结果或后果的从句"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "as a result"
                            },
                            {
                                "target_lang_word": "consequently",
                                "target_lang_sense_clarification": "formal result"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所以",
                                "target_lang_sense_clarification": "表示因果关系"
                            },
                            {
                                "target_lang_word": "因此",
                                "target_lang_sense_clarification": "表示正式的结果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "4b976a35-3a82-39b9-b6de-a345f0e1161a",
                    "sense_definition": "употребляется как связка в речи, для заполнения паузы или усиления (часто как слово-паразит)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Прихожу я, <w>значит</w>, домой, а там никого нет.",
                            "target_lang_translations": {
                                "en": "I come home, <w>so</w>, and there is no one there.",
                                "zh": "我回到家，<w>就是说</w>，结果家里一个人也没有。"
                            }
                        },
                        {
                            "text": "Так ты, <w>значит</w>, решил не ехать с нами?",
                            "target_lang_translations": {
                                "en": "<w>So</w>, you decided not to go with us?",
                                "zh": "所以，你<w>就是</w>决定不跟我们一起去了？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вот значит как"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "used as a filler word in speech or to add emphasis",
                        "zh": "口语中用于填补停顿或加强语气的填充词"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "filler word"
                            },
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "discourse marker"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "话语标记"
                            },
                            {
                                "target_lang_word": "就是说",
                                "target_lang_sense_clarification": "口语填充词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}