                        "entry_id": "573d3e4c-6ad0-3a35-9edb-7a6be9c69620",
                        "glosses": [
                            "Personne s'adonnant à la boisson, alcoolique, ivrogne."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b50447fb-b817-48d2-90c2-cec832066b44",
                                "sense_id": "e48b9819-f6e0-3ee9-a7df-9584079ebc5e",
                                "text": "Dès le matin on peut la voir\nSur le pavé sur le trottoir\nCheminer, la mine hagarde\nLa soûlarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
