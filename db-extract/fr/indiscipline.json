                "senses": [
                    {
                        "sense_id": "ae4dcbe0-7677-3f89-a862-abf44e9bdec5",
                        "entry_id": "e2135ae4-675a-31e3-8bc6-13ba1b3fea64",
                        "glosses": [
                            "Manque de discipline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b5b72ad-e00c-4e6a-8de9-e07a29b3bdb1",
                                "sense_id": "ae4dcbe0-7677-3f89-a862-abf44e9bdec5",
                                "text": "La garde mobile de la Seine n'était pas encore organisée, qu'il était facile déjà de reconnaître le mauvais esprit qui l'animait. Elle poussait l'amour de l'indiscipline jusqu'à l'absurde."
                            },
                            {
                                "example_id": "46653d29-c6dc-4e9b-9937-819e31d79801",
                                "sense_id": "ae4dcbe0-7677-3f89-a862-abf44e9bdec5",
                                "text": "Durant l’avant-midi, l’adolescente n'avait pu s'empêcher de se plaindre de l’indiscipline de ses deux frères qui acceptaient mal son autorité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e53bb224-4539-4bac-b6b3-2949a30093c2",
                        "source_entry_id": "e2135ae4-675a-31e3-8bc6-13ba1b3fea64",
                        "source_sense_id": "ae4dcbe0-7677-3f89-a862-abf44e9bdec5",
                        "target_lang_word": "Disziplinlosigkeit",
                        "target_lang_code": "de",
