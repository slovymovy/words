                "senses": [
                    {
                        "sense_id": "648ff302-fa55-3259-9fd2-3036efaabb84",
                        "entry_id": "64646d54-088d-38d2-95f3-6094c0761598",
                        "glosses": [
                            "Peitsche, die beim Reiten benutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77710f79-65c2-4fa2-b658-560f9dd6b8a6",
                                "sense_id": "648ff302-fa55-3259-9fd2-3036efaabb84",
                                "text": "„Damit hatte sie Simen Tjing so weit, daß er schweigend die Reitpeitsche fallen ließ.“"
                            },
                            {
                                "example_id": "c836fb00-c445-4bb7-9c96-4cdecc9d94b8",
                                "sense_id": "648ff302-fa55-3259-9fd2-3036efaabb84",
                                "text": "„Kutusow sass finster und melancholisch auf einer Bank in der Nähe der Brücke und spielte mit seiner Reitpeitsche im Sande, als ein Wagen mit lautem Rasseln angejagt kam.“"
                            },
                            {
                                "example_id": "bd91e542-fe40-4261-95c1-d84a9a245f6a",
                                "sense_id": "648ff302-fa55-3259-9fd2-3036efaabb84",
                                "text": "„Mit diesen Worte nahm er seine gewichtige Reitpeitsche, mit der er wirklich einst einen Damhirsch zu Boden geschlagen, von der Wand, steckte eine gewaltige Pistole in seine lange Rocktasche und bestieg seinen Gaul.“"
                            },
                            {
                                "example_id": "2b946d60-6263-4977-a811-3d791afa9662",
                                "sense_id": "648ff302-fa55-3259-9fd2-3036efaabb84",
                                "text": "„Die Gestapo-Schergen steckten ihm einen Knebel in den Mund und hieben mit der Reitpeitsche auf ihn ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
