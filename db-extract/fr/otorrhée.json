                        "entry_id": "d6258083-ae98-3e6c-b117-7b40fbd3e249",
                        "glosses": [
                            "Écoulement de liquide séreux, mucoïde ou purulent provenant du conduit auditif externe, témoin d'une infection de l'oreille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caba245c-5170-4bde-9f8a-c48ed91d8b9d",
                                "sense_id": "24187c1d-fa87-3767-859a-662a8e292241",
                                "text": "Lorsqu'il n'y a pas de signes généraux et locaux de rhinopharyngite et si l'otorrhée est unilatérale, elle est probablement liée à une otite externe."
                            },
                            {
                                "example_id": "9e124107-cc7b-4b6d-8da4-1e32738551ad",
                                "sense_id": "24187c1d-fa87-3767-859a-662a8e292241",
                                "text": "L’otorrhée est un écoulement muqueux ou mucopurulent issu de la perforation tympanique."
                            }
                        ]
                    }
