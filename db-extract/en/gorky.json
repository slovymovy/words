                "senses": [
                    {
                        "sense_id": "ded7a9d5-9126-3efb-a7f1-e6c580e4ff82",
                        "entry_id": "fe5a77ae-e64a-3721-971f-5a09031e6844",
                        "glosses": [
                            "Awkward or strange."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2fb4f6c0-a908-4c53-ba84-dd36e603fc1c",
                                "sense_id": "ded7a9d5-9126-3efb-a7f1-e6c580e4ff82",
                                "text": "Dr Gill says: \"Phillip Schofield went from being a gorky boyish chump to a daytime anchor when he went back to grey. Suddenly, he seemed more mature. Maturity is what women want for a stable relationship.\""
                            },
                            {
                                "example_id": "3a4c44a3-f17e-4afa-a41b-8b5b42e08028",
                                "sense_id": "ded7a9d5-9126-3efb-a7f1-e6c580e4ff82",
                                "text": "\"He was nine weeks old when he arrived and, although he was a gorky long-legged funny little fellow, he won our hearts instantly, especially mine,\" Michelle Ackland said."
                            },
                            {
                                "example_id": "05b365db-fac6-463c-af85-ab44f9bb791b",
                                "sense_id": "ded7a9d5-9126-3efb-a7f1-e6c580e4ff82",
                                "text": "We kept in touch, but not long after starting at the bank, she started dating some real gorky looking older bloke called Ray. He must have felt like all his Saturdays had come at once to be dating a girl like Jemma when his mirror told only horror stories."
                            }
                        ]
                    }
                ],
