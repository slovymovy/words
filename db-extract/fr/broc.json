                                "target_senses": [
                                    {
                                        "sense_id": "69ef0aa4-fa19-39c0-b30e-945360ba23f1",
                                        "entry_id": "6c2b8675-efd2-3bdd-8614-7bd91ab9f7d6",
                                        "glosses": [
                                            "Kanne für Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112dde3c-519e-4e23-8560-b42fa02f764b",
                                                "sense_id": "69ef0aa4-fa19-39c0-b30e-945360ba23f1",
                                                "text": "Man brachte ihr Wasserkanne und Schüssel, damit sie sich frischmachen konnte."
                                            },
                                            {
                                                "example_id": "83bb1d75-578b-4094-be14-e0588a0d34f8",
                                                "sense_id": "69ef0aa4-fa19-39c0-b30e-945360ba23f1",
                                                "text": "„Als er noch zögerte, klatschte sie flink ein paarmal in die Hände, ergriff die beiden Wasserkannen und bedeutete ihm mit einem knappen Rucken des Kopfes, als wäre Eile geboten, ihr zu folgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ee9e19-e143-4c4b-8e83-36aca86db8e3",
                        "source_entry_id": "2b029111-b859-3c23-bacc-d911ac714dd3",
                        "target_lang_word": "tankard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tankard",
