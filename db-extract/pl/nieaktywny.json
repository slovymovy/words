                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                                        "entry_id": "495146ce-4430-3e4b-a6ed-bd64faa98e0c",
                                        "glosses": [
                                            "Qui est dans l’inaction ou l’inactivité, oisif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d724b783-47dd-4d8f-a8f8-1ad69ba61dcf",
                                                "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                                                "text": "C’est l’homme du monde le plus inactif."
                                            },
                                            {
                                                "example_id": "cad406f8-d96f-4dd0-b84d-c2967937367b",
                                                "sense_id": "da0bb030-8b08-3056-94e0-3c131c6b574b",
                                                "text": "Rester inactif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                        "entry_id": "495146ce-4430-3e4b-a6ed-bd64faa98e0c",
                                        "glosses": [
                                            "Qualifie une chose qui n’a pas d’effet, inefficace."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e222077-f35e-4984-b670-520a251f8d02",
                                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                                "text": "Remède inactif."
                                            },
                                            {
                                                "example_id": "9153257d-2a20-42bd-a630-86c6ba9ef543",
                                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                                "text": "Moyen inactif."
                                            },
                                            {
                                                "example_id": "3c0d7e93-995d-4f50-a3ea-770892423ceb",
                                                "sense_id": "b4b1bf54-e3f6-31d8-a079-5ce5e909ed33",
                                                "text": "Il ne faut jamais laisser l’argent inactif. Il en meurt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e22273d-3e32-4ba4-9d61-ef0743e6dfcb",
                        "source_entry_id": "bfc89488-9d04-382c-ae13-4f6faede6eb8",
                        "source_sense_id": "40ca8044-15dc-35b4-ad8c-551718af0935",
                        "target_lang_word": "inerte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inerte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                        "entry_id": "4a891054-38ed-3e8b-a19f-7cdfba3bbc2e",
                                        "glosses": [
                                            "Qui est sans ressort et sans activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76b2d6c-0d7a-4034-bcf1-415ae60ada67",
                                                "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                                "text": "La matière inerte."
                                            },
                                            {
                                                "example_id": "f125f9c0-131a-488d-ab62-4fdcb11067db",
                                                "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                                "text": "Une masse inerte."
                                            },
                                            {
                                                "example_id": "2a0a637a-b946-4c1c-950e-11cdce673a9a",
                                                "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                                "text": "Un membre inerte."
                                            },
                                            {
                                                "example_id": "2dbfa94b-afc6-43ca-9e14-866cdf022928",
                                                "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                                "text": "Il songea aux centaines de dizeaux que les mains maintenant inertes du vieillard avaient liés en gerbes au cours de sa vie, au nombre de fois où elles avaient caressé la chevelure de sa promise ou pris la main de sa petite fille, et à tous ces menus objets de la vie courante qu’elles avaient réalisé, et qui leur survivraient."
                                            },
                                            {
                                                "example_id": "bb781bfc-4b9c-452e-868b-0c178a4c1967",
                                                "sense_id": "3af65337-52c8-35d2-868c-feb2253f6ddf",
                                                "text": "Si quelques patients étaient, de fait, plongés dans un coma profond — manifestement endormis, inertes —, d’autres se trouvaient dans des états végétatifs variables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933eb040-7573-391d-aea7-d62e4ccfadb4",
                                        "entry_id": "4a891054-38ed-3e8b-a19f-7cdfba3bbc2e",
                                        "glosses": [
                                            "Sans activité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
