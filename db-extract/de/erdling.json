                "senses": [
                    {
                        "sense_id": "ac0412d9-0058-3da0-a8ab-e20623225c78",
                        "entry_id": "e839594d-675a-3223-88af-27d400ba89f7",
                        "glosses": [
                            "Bewohner der Erde"
                        ],
                        "tags": [
                            "ironisch",
                            "witzig"
                        ],
                        "examples": [
                            {
                                "example_id": "9c4c96e9-2958-4f44-9397-87d5cccb7e7d",
                                "sense_id": "ac0412d9-0058-3da0-a8ab-e20623225c78",
                                "text": "„So nimmt er an, dass ihre Zellen Wasserstoffperoxid enthalten - Erdlinge bleichen sich mit diesem Reinigungszeug die Haare.“"
                            },
                            {
                                "example_id": "234521b4-2b74-47e9-aa86-18c7c995febc",
                                "sense_id": "ac0412d9-0058-3da0-a8ab-e20623225c78",
                                "text": "„Es gab Tausende von Sprachen auf Erden, was dem Erdling wie ein hoffnungsloses Babel biblischen Ausmaßes erscheinen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd5dd784-174b-4ae6-8d23-af9adefbd228",
                        "source_entry_id": "e839594d-675a-3223-88af-27d400ba89f7",
                        "source_sense_id": "ac0412d9-0058-3da0-a8ab-e20623225c78",
                        "source_sense_description": "ironisch, witzig: Bewohner der Erde",
                        "target_lang_word": "earthling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "earthling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2be538-8f0f-3cdf-b3fe-b9cc1691a3ae",
                                        "entry_id": "4b86eae4-586f-3ddb-8dd2-dbc16ffc7b40",
                                        "glosses": [
                                            "Alternative letter-case form of Earthling."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8a449d-1237-488d-98b5-abc83bf508d7",
                                                "sense_id": "5a2be538-8f0f-3cdf-b3fe-b9cc1691a3ae",
                                                "text": "VVe (of all earthlings) are Gods vtmoſt ſubiects, the laſt (in a manner) that he bought to his obedience: ſhal we then forgette that vvee are any ſubiects of hys, becauſe (as amongſt his Angels) he is not viſibly conuerſant amongſt vs?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "earthling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d7381ba-d5d8-3d24-a8f6-25b92f0cb405",
                                        "entry_id": "3f100d7f-ef81-3094-8204-b62387a5115b",
                                        "glosses": [
                                            "One who tills the earth; a farmer, a husbandman, a ploughman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0631b2-a73b-4e51-865b-5e471878ddc3",
                                                "sense_id": "2d7381ba-d5d8-3d24-a8f6-25b92f0cb405",
                                                "text": "Eoꞃðlinᵹ [Eorthling], is a Husbandman, or Earthling."
                                            },
                                            {
                                                "example_id": "e2c5b046-da14-4abf-827c-2134bac2c2a4",
                                                "sense_id": "2d7381ba-d5d8-3d24-a8f6-25b92f0cb405",
                                                "text": "And we have not imagination enough to believe, that either the Danish boors, who were earthlings (yrthlingas) in the country, or the Danish soldiers, who, as history tells us, were dandies at the court of King Canute, could, in the brief space of twenty years, have so overlaid or interlarded the pure Anglo-Saxon with their provincialisms, as to give it a new character, and thus form a new period in its history, as was afterwards done by the Normans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad5d6559-0e0b-43cd-94db-bc407e57e272",
                        "source_entry_id": "e839594d-675a-3223-88af-27d400ba89f7",
                        "source_sense_id": "ac0412d9-0058-3da0-a8ab-e20623225c78",
                        "source_sense_description": "ironisch, witzig: Bewohner der Erde",
                        "target_lang_word": "terrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48e0b021-5706-37cc-a83a-5aa9449863df",
                                        "entry_id": "51bd32e4-d047-3a45-b643-6d15e050c731",
                                        "glosses": [
                                            "Qui possède des terres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a51cad-d03f-4547-8958-d2d0f439b465",
                                                "sense_id": "48e0b021-5706-37cc-a83a-5aa9449863df",
                                                "text": "En France, en Belgique, en Hollande, en Allemagne, partout, sauf en Amérique, il est bien rare que le petit propriétaire terrien possède plus de dix à vingt acres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ab5ecc1-596c-3b80-8f0e-b0152f2b6ad9",
                                        "entry_id": "51bd32e4-d047-3a45-b643-6d15e050c731",
                                        "glosses": [
                                            "Relatif à la terre, à la campagne (par opposition à la ville)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e14612-0048-49c4-af03-75c58f0756d3",
                                                "sense_id": "9ab5ecc1-596c-3b80-8f0e-b0152f2b6ad9",
                                                "text": "[…] un peuple ouvrier-paysan, hier encore rustique, qui apportait dans ses métiers les plus vieilles vertus terriennes, un honneur incroyable du travail, la piété de l’ouvrage bien fait […]"
                                            },
                                            {
                                                "example_id": "12d4dbd6-a957-4ad6-a0e7-5fb195061ee2",
                                                "sense_id": "9ab5ecc1-596c-3b80-8f0e-b0152f2b6ad9",
                                                "text": "Elle était mince et grande pour son âge, si dissemblable en cela de Sabine, forte et terrienne, et à onze ans elle se faisait déjà traiter de \"planche à repasser\" et de \"grande tige\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29b9d80b-58f5-32aa-b470-25e6415cbb8d",
                                        "entry_id": "51bd32e4-d047-3a45-b643-6d15e050c731",
                                        "glosses": [
                                            "Relatif à la Terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57db36f0-cbe4-4698-aa67-0cd51e8e7f13",
                                                "sense_id": "29b9d80b-58f5-32aa-b470-25e6415cbb8d",
                                                "text": "Le vieux rêve de fraternité universelle n’est nullement irréalisable. Il suffirait simplement que notre chère Terre soit attaquée par une autre planète. Et l’on verrait surgir immédiatement le drapeau « terrien », l’hymne « terrien », la mission « terrienne » et, naturellement, le « terrianisme intégral »."
                                            },
                                            {
                                                "example_id": "5f85902a-794a-4e1b-b76f-ec6475161ef4",
                                                "sense_id": "29b9d80b-58f5-32aa-b470-25e6415cbb8d",
                                                "text": "— Un des buts du Mouvement raélien (et non le moindre) est la construction d’une ambassade terrienne qui, le jour venu, permettra d’accueillir les extraterrestres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc90c22b-0fa3-3c8b-ab17-3d7e17f1c713",
                                        "entry_id": "51bd32e4-d047-3a45-b643-6d15e050c731",
                                        "glosses": [
                                            "Qui vit à l’intérieur des terres, par opposition aux côtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e48071-5fe2-44b4-a6af-32a2f702bfde",
                                                "sense_id": "fc90c22b-0fa3-3c8b-ab17-3d7e17f1c713",
                                                "text": "Créer une marine : œuvre de longue haleine, qui veut de la suite, de l'argent, et il a toujours été difficile d'intéresser le Français terrien aux choses de la mer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "terrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4fd820-db60-39bb-963e-0c7f9ea7d86d",
                                        "entry_id": "fcd1bec4-334b-3a8e-a062-cc64507564f5",
                                        "glosses": [
                                            "Celui qui vit du travail de la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34db61a-a1d6-465b-89aa-db4e243fac38",
                                                "sense_id": "6a4fd820-db60-39bb-963e-0c7f9ea7d86d",
                                                "text": "Le paysan n’est plus le terrien robuste et songeur, né de la terre, qui vivait d’elle et qui mourait là où, comme le chêne, il avait poussé ses racines."
                                            },
                                            {
                                                "example_id": "57544ef2-8242-4117-a9f2-31f72a89c8f9",
                                                "sense_id": "6a4fd820-db60-39bb-963e-0c7f9ea7d86d",
                                                "text": "Les terriens de Roche ont des entêtements inexplicables. Il est vrai que ces entêtements sont une vertu. L’invasion est à leur porte, inévitable; cela ne les empêche pas de s’acharner au travail de la moisson, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "484e933c-44ca-34b0-9252-c680f59487a5",
                                        "entry_id": "fcd1bec4-334b-3a8e-a062-cc64507564f5",
                                        "glosses": [
                                            "Habitant de la Terre."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53d4aff9-b1b8-478b-a8d0-55b62ff90496",
                                                "sense_id": "484e933c-44ca-34b0-9252-c680f59487a5",
                                                "text": "Le dernier jour des terriens était arrivé et Arcvad le puissant avait décrété leur mort pour minuit, heure de Mars, — 11 heures du matin à New-York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4e635fc-9138-3f04-8c6a-bb176b5fe87c",
                                        "entry_id": "fcd1bec4-334b-3a8e-a062-cc64507564f5",
                                        "glosses": [
                                            "Habitant de l’intérieur des terres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bc0452-7e2e-482e-9f4c-1fc97fdedc03",
                                                "sense_id": "a4e635fc-9138-3f04-8c6a-bb176b5fe87c",
                                                "text": "[…] ; mais le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "441d8ad6-d884-3012-9045-16202fd5a6a7",
                                        "entry_id": "fcd1bec4-334b-3a8e-a062-cc64507564f5",
                                        "glosses": [
                                            "Joueur spécialiste de la terre battue."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d58bba-7e91-46fd-b85e-942061c41970",
                                                "sense_id": "441d8ad6-d884-3012-9045-16202fd5a6a7",
                                                "text": "Confronté à un pur terrien, très mobile et d’une régularité rare dans l’échange, le Français n’aura jamais réussi à imposer son rythme dans cette rencontre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
