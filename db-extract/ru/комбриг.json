                "senses": [
                    {
                        "sense_id": "8bdb7c5d-aa58-3d63-94ad-6d6f5498f973",
                        "entry_id": "44759990-2f05-35f6-b935-b6eefb994f50",
                        "glosses": [
                            "истор. сокр. от командир бригады; воинское звание высшего командного состава в Сухопутных войсках и ВВС Красной Армии в 1935–1940 годах, предшествовавшее званию комдива; также лицо, имевшее такое звание"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "4bc0bacb-84e1-4dc8-949e-43588b7d42de",
                                "sense_id": "8bdb7c5d-aa58-3d63-94ad-6d6f5498f973",
                                "text": "Начальник военно-пехотной школы комбриг Василий Клементьев известен тем, что в 1928 году впервые организовал массовое восхождение на Эльбрус."
                            }
                        ]
                    }
