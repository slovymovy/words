                "senses": [
                    {
                        "sense_id": "a9a10887-0ae7-3252-8ea3-838a09674e55",
                        "entry_id": "da605202-c4dc-3ee4-914a-8aae74eb872e",
                        "glosses": [
                            "starogrecka szkoła filozoficzna kładąca nacisk na wewnętrzną dyscyplinę moralną, wypełnianie obowiązków które na nas spadły oraz odcięciu się od emocji i zdarzeń zewnętrznych, w celu osiągnięcia szczęścia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8f0a19-3af2-44a0-b41e-cee0c422e68a",
                                "sense_id": "a9a10887-0ae7-3252-8ea3-838a09674e55",
                                "text": "Toteż - zauważa Hegel - stoicyzm \"mógł wystąpić tylko w okresie powszechnego strachu i niewolnictwa, będącego zarazem okresem takiej kultury ogólnej (…), która kształtowanie i kulturę (…) podnosiła do poziomu myśli\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8185964c-120f-30e3-8330-d07d1047fff4",
                        "entry_id": "da605202-c4dc-3ee4-914a-8aae74eb872e",
                        "glosses": [
                            "umiejętność panowania nad sobą, swoimi emocjami i uczuciami; niewzruszony spokój i równowaga duchowa"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39050383-5b15-4e61-8cf0-e72ebbb821b2",
                        "source_entry_id": "da605202-c4dc-3ee4-914a-8aae74eb872e",
                        "source_sense_id": "a9a10887-0ae7-3252-8ea3-838a09674e55",
                        "target_lang_word": "stoicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40b2df25-aed5-31a2-a005-d04ea5caa94f",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A school of philosophy popularized during the Roman Empire that emphasized reason as a means of understanding the natural state of things, or logos, and as a means of freeing oneself from emotional distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A real or pretended indifference to pleasure or pain; insensibility; impassiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8f39ac-771a-456d-ba80-0549918a8f8c",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Jones’ sad eyes betray a pervasive pain his purposefully spare dialogue only hints at, while the perfectly cast Brolin conveys hints of playfulness and warmth while staying true to the craggy stoicism at the character’s core."
                                            },
                                            {
                                                "example_id": "39925f7d-3d2a-4f9c-b58b-eb62c652b614",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Although very distant from the lives of her subjects – she never went to school and had only the most fleeting experiences of being on equal terms with anyone – she grew into a much respected figure, admired for her stoicism and diligence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9002d1f-7a74-4481-872f-c4a2b70fdaf2",
                        "source_entry_id": "da605202-c4dc-3ee4-914a-8aae74eb872e",
                        "source_sense_id": "a9a10887-0ae7-3252-8ea3-838a09674e55",
                        "target_lang_word": "stoïcisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoïcisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6c1944-b176-3859-a54d-1396fcac3a55",
                                        "entry_id": "21b8dffe-f1dd-3e46-b9d8-fa8751b5a21e",
                                        "glosses": [
                                            "Philosophie basée sur la raison, faisant du bonheur le but de la vie pouvant être atteint en concentrant nos efforts sur ce qui dépend de nous et en traitant avec indifférence les événements qui sont hors de notre contrôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607bf971-9d57-4f7a-87c3-5fdd2627494d",
                                                "sense_id": "2e6c1944-b176-3859-a54d-1396fcac3a55",
                                                "text": "Deux circonstances expliquent le phénomène. La première fut la croyance en l’unité de la philosophie antique. Elle est due à un vaste effort de syncrétisme des dernières écoles d’Alexandrie et d’Athènes qui s’évertuèrent à coordonner le Platonisme, l’Aristotélisme, le Stoïcisme, le Néo-Pythagorisme en une synthèse unique […]"
                                            },
                                            {
                                                "example_id": "250dfacc-8394-486f-b50f-84b20a2879c0",
                                                "sense_id": "2e6c1944-b176-3859-a54d-1396fcac3a55",
                                                "text": "Trois nouveaux courants, fort opposés, s’imposent : l’épicurisme, le stoïcisme et le scepticisme ; leur point commun est l’attention accordée aux questions éthiques, au point que le savoir lui-même se laisse subordonner à cette visée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28740ba-b035-3555-a2b7-1653ab061f65",
                                        "entry_id": "21b8dffe-f1dd-3e46-b9d8-fa8751b5a21e",
                                        "glosses": [
                                            "Attitude d’une personne inébranlable qui reste rationnelle face aux difficultés et ne se laisse pas atteindre par elles, telle qu’était celle des stoïciens."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da1dac4-6028-4e27-b5b8-666b68cdf735",
                                                "sense_id": "a28740ba-b035-3555-a2b7-1653ab061f65",
                                                "text": "Le Saxon avait été sous l’empire des inquiétudes les plus vives et les plus cuisantes à l’endroit de son fils ; car la nature avait maintenu ses droits, en dépit du stoïcisme patriotique qui s’efforçait de la méconnaître."
                                            },
                                            {
                                                "example_id": "d8020e31-7a8f-455e-9683-d5226de146fb",
                                                "sense_id": "a28740ba-b035-3555-a2b7-1653ab061f65",
                                                "text": "Alors elle s’était tue, avalant sa rage dans un stoïcisme muet, qu’elle garda jusqu’à sa mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
