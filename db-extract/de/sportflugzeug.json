                                "example_id": "941c643d-6a0f-465a-a06f-0e660bb0535d",
                                "sense_id": "499199fe-1109-30b1-b414-703d8d0d30ab",
                                "text": "„Beim Absturz eines Sportflugzeugs in der Nähe des Flughafens Lübeck-Blankensee ist ein Insasse ums Leben gekommen.“"
                            },
                            {
                                "example_id": "77ada410-9ad9-4699-85bd-a5be7ae280c3",
                                "sense_id": "499199fe-1109-30b1-b414-703d8d0d30ab",
                                "text": "„Eine Frau besteigt mit ihrem Mann ein Sportflugzeug, um einen Rundflug zu machen.“"
                            }
                        ],
