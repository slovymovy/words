                                    {
                                        "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                        "entry_id": "565f8322-2d5a-32ce-aa93-7de711ca0200",
                                        "glosses": [
                                            "die massenhafte Verarmung in der ersten Hälfte des 19. Jahrhunderts (vor allem in den 1830er- und 1840er-Jahren) in Deutschland, die sich aus der Schere zwischen wachsender Bevölkerung und stagnierender Wirtschaft ergab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc01d7a2-f7ff-4671-b3d1-4c64fe1db2e3",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Das schnelle Ende des krisenhaften Pauperismus nach 1850 ist gerade auf die Industrialisierung und die von ihr geschaffenen neuen Arbeitsplätze zurückzuführen.“"
                                            },
                                            {
                                                "example_id": "a4f1fc0b-b702-4a97-85fa-95902e480a6d",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            },
                                            {
                                                "example_id": "d571ddc9-cc6d-46bf-adde-d052dfbcf6d9",
                                                "sense_id": "a2c2082e-96ea-3cf6-8f12-59fb275c8326",
                                                "text": "„Dabei nahmen sie den Pauperismus in Kauf – die langfristige Armut großer Teile der Bevölkerung, vor allem der wie Sklaven behandelten Leibeigenen –, aber das war ja für sie persönlich kein Problem.“"
                                            }
                                        ],
