                        "source_entry_id": "71bbde5c-cb2f-3b67-83a2-438ca2cfce20",
                        "source_sense_id": "7a6ae74f-a758-3cb2-9a4f-b24c8c291163",
                        "source_sense_description": "Sprache, die vom gleichnamigen, indigenen Volk Neuseelands gesprochen wird",
