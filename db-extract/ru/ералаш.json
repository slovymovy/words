                "senses": [
                    {
                        "sense_id": "318c5e93-e435-3229-94ea-f065d8e6b946",
                        "entry_id": "12b393e9-cdbd-3abf-b517-ee954aee7cf5",
                        "glosses": [
                            "спец. и устар. смесь разнородных засахаренных фруктов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0a29284-67bd-324d-83ab-f2b4f442a611",
                        "entry_id": "12b393e9-cdbd-3abf-b517-ee954aee7cf5",
                        "glosses": [
                            "перен., прост. беспорядок; путаница, неразбериха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d009a7e-3141-434d-88c1-3f0d7282391e",
                                "sense_id": "e0a29284-67bd-324d-83ab-f2b4f442a611",
                                "text": "Что это у тебя, братец, в голове всегда ералаш такой?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a50601eb-19ed-3f1d-bc34-f588706812b5",
                        "entry_id": "12b393e9-cdbd-3abf-b517-ee954aee7cf5",
                        "glosses": [
                            "истор., карт. картёжная игра, близкая к висту и преферансу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c33fdc0-d693-44c2-b6b5-fd53c3547952",
                                "sense_id": "a50601eb-19ed-3f1d-bc34-f588706812b5",
                                "text": "В молодости он ни в какие игры не играл, а тут пристрастился к лото, а когда запретили лото, к ералашу."
                            },
                            {
                                "example_id": "05558519-b489-4952-bf36-bd1d515ee8dc",
                                "sense_id": "a50601eb-19ed-3f1d-bc34-f588706812b5",
                                "text": "Мы после обеда засядем в ералаш, и я его обыграю."
                            },
                            {
                                "example_id": "3265c7a5-309b-4d1b-be35-98b09952eeb7",
                                "sense_id": "a50601eb-19ed-3f1d-bc34-f588706812b5",
                                "text": "Посмотрели бы вы на него у нас в клубе, когда он садился за карты. Весь вид его говорил: «Карты! Я сажусь с вами в ералаш! Разве это совместно? Кто ж отвечает за это? Кто разбил мою деятельность и обратил её в ералаш? Э, погибай Россия!» ― и он осанисто козырял с червей."
                            }
                        ]
                    }
