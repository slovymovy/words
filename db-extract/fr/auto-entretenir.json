                    },
                    {
                        "sense_id": "5845be35-9b92-33cf-849c-c344745ae00d",
                        "entry_id": "8b057f7e-fbdf-311f-a1d1-7713bf9704cc",
                        "glosses": [
                            "S’entretenir soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2bace553-577a-4698-9b7a-3c020188ee40",
                                "sense_id": "5845be35-9b92-33cf-849c-c344745ae00d",
                                "text": "Expliquer pourquoi la réaction de fission peut s'auto-entretenir."
                            },
                            {
                                "example_id": "bc89ed11-7ce0-47eb-aa40-01377d770b04",
                                "sense_id": "5845be35-9b92-33cf-849c-c344745ae00d",
                                "text": "L'inflation a tendance à s'auto-entretenir, et à se développer sur la base d'une spirale difficilement contrôlable."
                            },
                            {
                                "example_id": "1661d656-72a9-4371-ae46-6d6c986a2813",
                                "sense_id": "5845be35-9b92-33cf-849c-c344745ae00d",
                                "text": "La toux a tendance à s'auto-entretenir: certains cas anciens nécessitent jusqu'à trois semaines de traitement."
                            }
                        ]
                    }
