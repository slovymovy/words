                        "sense_id": "17169189-ed8a-3655-8aa5-018ce6ecdbec",
                        "entry_id": "99627fee-e948-37b0-a704-673be356629a",
                        "glosses": [
                            "zielony o złotym połysku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa4e6b0-4c5c-465b-a4bf-9fbb552c1314",
                                "sense_id": "17169189-ed8a-3655-8aa5-018ce6ecdbec",
                                "text": "Drzewa się zakolebały bez szumu, sypiąc na jej jasną głowę ulewę migotliwych brzasków i cieniów, kieby ten deszcz zielonozłoty"
                            },
                            {
                                "example_id": "f528cedd-c8f7-40cc-93aa-54d4fede086c",
                                "sense_id": "17169189-ed8a-3655-8aa5-018ce6ecdbec",
                                "text": "Zaświtał nieśmiało, bladym, zielonozłotym promieniem na szarym, zimnym obłoku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
