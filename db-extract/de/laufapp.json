                "senses": [
                    {
                        "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                        "entry_id": "ce3c1e3e-3f4c-30d9-bcb3-2f55371ff2b6",
                        "glosses": [
                            "Anwendung für Smartphones oder Smartwatches (App), die beim Laufen unterstützt – etwa durch die Anzeige von Tempo, Zeit, Distanz, Kalorienverbrauch oder das Aufzeichnen der Laufstrecke mittels GPS"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8aec71-c3da-4b34-aff6-26698a2488ff",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Ich schnalle mir die Startnummer um (Chip auf der Rückseite) und mache meine Laufapp scharf.“"
                            },
                            {
                                "example_id": "ec01ddc2-ce40-4b26-bfb8-418d153a3ace",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Zu den Kunden zählen besonders jüngere Unternehmen wie der Schnelllieferdienst Gorillas, der Onlinemöbelhändler Westwing oder die Laufapp Adidas Runtastic.“"
                            },
                            {
                                "example_id": "76882ac3-0fc1-430e-9d10-445b20863767",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Die Laufapp MapMyRun bietet Läufern ebenso die Möglichkeit, eigene Routen zu planen oder beliebte Laufstrecken in der Nähe zu suchen.“"
                            },
                            {
                                "example_id": "0be86cd4-cdf1-4748-a9d5-66a6abf95171",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Ich habe keine Gadgets zum Schritte zählen o.ä. Einzig meine Laufapp, die mir dann eine Geschwindigkeit anzeigt- die mir mittlerweile egal ist.“"
                            },
                            {
                                "example_id": "6a7480f3-808a-46e6-ab20-566f4720620e",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Eines dieser Technik Gadgets ist meine Apple Watch, die mich, zusammen mit der Laufapp ‚iSmooth Run’ täglich begleitet.“"
                            },
                            {
                                "example_id": "c93b7bdd-0008-4a59-b21e-a72c10d47e26",
                                "sense_id": "d0656d74-225b-3646-ad91-da049699c23e",
                                "text": "„Falls du noch keine Laufapp auf deinem Smartphone hast, lade dir eine beliebige App herunter und richte sie ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
