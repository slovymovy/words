{
    "word_family": [
        "production",
        "producteur",
        "productrice",
        "productif",
        "productivité",
        "surproduction",
        "improductif"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8ba450f-00bc-37b1-a205-d3267503896f",
                    "sense_definition": "Fabriquer des biens matériels, des objets ou de l'énergie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fabrication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle usine <w>produit</w> des milliers de voitures chaque année pour le marché européen."
                        },
                        {
                            "text": "Notre entreprise cherche à <w>produire</w> plus proprement pour respecter les normes environnementales."
                        }
                    ],
                    "common_phrases": [
                        "produire de l'électricité",
                        "produire en masse"
                    ]
                },
                {
                    "sense_id": "6033a612-1c31-3525-a853-1bc1a8d085cb",
                    "sense_definition": "Arriver, survenir ou avoir lieu de manière soudaine ou imprévue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un accident grave s'est <w>produit</w> sur cette autoroute hier soir à cause du verglas."
                        },
                        {
                            "text": "Nous devons tout faire pour éviter qu'un tel problème ne se <w>produise</w> encore."
                        }
                    ],
                    "synonyms": [
                        "arriver",
                        "se passer"
                    ],
                    "common_phrases": [
                        "se produire souvent",
                        "se produire un incident"
                    ]
                },
                {
                    "sense_id": "272ba787-f192-3425-a0ea-8e51a10a2d73",
                    "sense_definition": "Provoquer, causer ou amener un effet, une réaction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La déclaration du ministre a <w>produit</w> une vive réaction au sein de la population."
                        },
                        {
                            "text": "Ce médicament peut <w>produire</w> des effets secondaires indésirables pendant les premiers jours."
                        }
                    ],
                    "common_phrases": [
                        "produire un effet",
                        "produire une impression"
                    ]
                },
                {
                    "sense_id": "f9a31b63-433b-3367-8d34-dc294355b6c6",
                    "sense_definition": "Créer ou composer un ouvrage de l'esprit, une œuvre artistique ou littéraire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet écrivain talentueux a <w>produit</w> plusieurs romans remarquables au cours de sa carrière."
                        },
                        {
                            "text": "L'artiste continue de <w>produire</w> des toiles magnifiques malgré son grand âge."
                        }
                    ],
                    "synonyms": [
                        "créer"
                    ],
                    "common_phrases": [
                        "produire une œuvre",
                        "produire un chef-d'œuvre"
                    ]
                },
                {
                    "sense_id": "d498b78d-0654-3528-9614-21d4aec6ed2e",
                    "sense_definition": "Monter sur scène ou donner une représentation publique pour un artiste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chanteuse va se <w>produire</w> sur scène devant des milliers de spectateurs enthousiastes."
                        },
                        {
                            "text": "Ce jeune groupe de jazz s'est <w>produit</w> dans plusieurs festivals renommés cet été."
                        }
                    ],
                    "common_phrases": [
                        "se produire sur scène",
                        "se produire en concert"
                    ]
                },
                {
                    "sense_id": "97e620ef-0727-3805-befd-24fc7adc099f",
                    "sense_definition": "Donner des récoltes ou porter des fruits, en parlant de la terre ou d'un végétal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pommiers de notre verger <w>produisent</w> des fruits abondants et savoureux cet automne."
                        },
                        {
                            "text": "Cette terre très fertile <w>produit</w> du blé d'excellente qualité depuis des générations."
                        }
                    ],
                    "common_phrases": [
                        "produire des fruits",
                        "produire une récolte"
                    ]
                },
                {
                    "sense_id": "7535a760-e6c3-3da4-9f6b-2798c6c3e81f",
                    "sense_definition": "Financer et organiser la réalisation d'un film, d'une émission ou d'un spectacle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "production_audiovisuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand studio a décidé de <w>produire</w> un film documentaire sur la faune sauvage."
                        },
                        {
                            "text": "Elle cherche des investisseurs motivés pour <w>produire</w> son prochain spectacle musical."
                        }
                    ],
                    "common_phrases": [
                        "produire un film",
                        "produire un spectacle"
                    ]
                },
                {
                    "sense_id": "9e23ee2c-b6ac-3d65-b396-f892cadeb0a5",
                    "sense_definition": "Présenter ou soumettre des documents, des titres ou des preuves à un examen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "droit_administratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat doit obligatoirement <w>produire</w> un justificatif de domicile pour valider son dossier."
                        },
                        {
                            "text": "L'avocat a pu <w>produire</w> de nouvelles pièces déterminantes pour innocenter son client."
                        }
                    ],
                    "common_phrases": [
                        "produire des pièces",
                        "produire un justificatif"
                    ]
                },
                {
                    "sense_id": "36cb80eb-0e08-30c2-b37e-5213cbf3eee1",
                    "sense_definition": "Rapporter un gain financier ou des intérêts sous forme de revenus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet investissement prudent a <w>produit</w> des intérêts réguliers tout au long de l'année."
                        },
                        {
                            "text": "Le compte d'épargne ne <w>produit</w> presque rien en raison des taux très faibles."
                        }
                    ],
                    "common_phrases": [
                        "produire des intérêts",
                        "produire un revenu"
                    ]
                }
            ]
        }
    ]
}