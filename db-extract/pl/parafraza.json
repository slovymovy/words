                        "entry_id": "aebf8b61-8695-3783-99b4-d72f254d0cb9",
                        "glosses": [
                            "przeróbka tekstu literackiego rozwijająca lub modyfikująca treść pierwowzoru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d70e0c8-d517-4876-8c41-72fd5ed82a95",
                                "sense_id": "a649cbc8-34ae-36ab-8f7c-665f863238d1",
                                "text": "Czytelność parafrazy zależy od znajomości dzieła, do którego stanowi odwołanie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
