                "entry_id": "e8c7011a-df07-3537-bf14-26ba8dd358fe",
                "word": "NEB",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "23b070a6-fff4-31c5-be56-e240a5d5ea8a",
                        "entry_id": "e8c7011a-df07-3537-bf14-26ba8dd358fe",
                        "glosses": [
                            "Système d’information regroupant en temps utile l’ensemble des informations obtenues sur le champ de bataille et permettant l’interconnexion des différents niveaux de commandement des forces armées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21defd91-19b5-45d2-9483-4083345ba25b",
                                "sense_id": "23b070a6-fff4-31c5-be56-e240a5d5ea8a",
                                "text": "Aujourd’hui, les transmetteurs des armées garantissent aux décideurs politiques et militaires la permanence du commandement au cœur des opérations, tous temps, tous lieux, grâce à la numérisation complète de l’espace de bataille (NEB)."
                            },
                            {
                                "example_id": "93b80795-796a-4f26-b60d-4c2641cedcd0",
                                "sense_id": "23b070a6-fff4-31c5-be56-e240a5d5ea8a",
                                "text": "La formation des « chefs » au sein des armées de pays modernes et démocratiques doit veiller à en faire des champions de la NEB (Numérisation de l'Espace de Bataille), mais également des guerriers ayant du caractère, le sens de l’initiative et surtout une grande capacité d’adaptation à des réalités mouvantes."
                            }
                        ]
                    }
                ],
