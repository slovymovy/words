                    {
                        "translation_id": "4ab603d4-19e6-483e-b39b-4c03ae08f7ea",
                        "source_entry_id": "6912475e-1e26-3ae7-bfea-3fffed5f8d1b",
                        "source_sense_id": "f0ee933b-0e7a-35f2-a9a7-a97ce8ca151e",
                        "source_sense_description": "de rode kleur van karmijn",
                        "target_lang_word": "crimson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd74fff9-9156-3e06-ae1b-569f76de1426",
                                        "entry_id": "8ec5d299-3d18-350b-b42d-e546ca5fcbee",
                                        "glosses": [
                                            "A deep, slightly bluish red."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "870ae41a-c086-48cf-bbac-e829bdff81c1",
                                                "sense_id": "cd74fff9-9156-3e06-ae1b-569f76de1426",
                                                "text": "To my horror I perceived that the yellow blossoms were all dabbled with crimson."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                        "entry_id": "e4557118-ecf1-3c50-8318-f365af744a8f",
                                        "glosses": [
                                            "Having a deep red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785e6662-82ed-4434-b1d7-1912688a0ff3",
                                                "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            },
                                            {
                                                "example_id": "ff79e707-e2a1-497c-bb02-6ef54a2c5106",
                                                "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                                "text": "Her crimson dress inflames grey corridors, or flaring in a sunshaft through high branches makes of the deep green shadows a greenness darker yet, and a darkness greener."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2cab433-221c-36ca-b970-a82b6c429ad6",
                                        "entry_id": "e4557118-ecf1-3c50-8318-f365af744a8f",
                                        "glosses": [
                                            "Immodest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                        "entry_id": "f7630bcb-ada8-3b0b-9b0a-e4ad7f4de56f",
                                        "glosses": [
                                            "To become crimson or deep red; to blush."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6071bac-b5a0-4ddc-a4a5-abba9fe536c0",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "Eugenie's quick apprehensions seized the foul thought. Her eyes flashed—her cheek crimsoned."
                                            },
                                            {
                                                "example_id": "97ad956b-e0fb-4997-a356-1fa2265ecca4",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "1885, Alfred, Lord Tennyson, “The Ring” in The Poetical Works of Alfred, Lord Tennyson, New York and Boston: Thomas Y. Crowell & Co., Volume 2, p. 662,\nFather. Why do you look so gravely at the tower?\nMiram. I never saw it yet so all ablaze\nWith creepers crimsoning to the pinnacles,"
                                            },
                                            {
                                                "example_id": "51b83f7d-87aa-4b0e-ad29-cdd045249f21",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "Gerty MacDowell bent down her head and crimsoned at the idea of Cissy saying an unladylike thing like that out loud she'd be ashamed of her life to say, flushing a deep rosy red, and Edy Boardman said she was sure the gentleman opposite heard what she said. But not a pin cared Ciss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                        "entry_id": "f7630bcb-ada8-3b0b-9b0a-e4ad7f4de56f",
                                        "glosses": [
                                            "To dye with crimson or deep red; to redden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b3f133-d0b8-4d5d-ab85-f18c5162dd9e",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "Here didst thou fall; and here thy hunters stand,\nSign’d in thy spoil, and crimson’d in thy lethe."
                                            },
                                            {
                                                "example_id": "27373af2-2091-4610-badf-f4bffbcc4f88",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "Her face was crimsoned over, and she exclaimed, in a voice of the greatest emotion, “Good God! Willoughby, what is the meaning of this? […]”"
                                            },
                                            {
                                                "example_id": "27f5df52-2844-4f3c-a728-22fb5c96ef62",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "[…] that sheetless bed (that nuptial couch of love and grief) with the pale and bloody corpse in its patched and weathered gray crimsoning the bare mattress […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a88b0417-bd76-463f-bf06-1b4b129d315a",
                        "source_entry_id": "6912475e-1e26-3ae7-bfea-3fffed5f8d1b",
                        "source_sense_id": "f0ee933b-0e7a-35f2-a9a7-a97ce8ca151e",
                        "source_sense_description": "de rode kleur van karmijn",
                        "target_lang_word": "cramoisi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cramoisi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                        "entry_id": "cfd1dbca-daa0-3550-b680-6877899e922b",
                                        "glosses": [
                                            "D’une couleur rouge foncé, tirant sur le violet. #DC143C"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e39fd55-86cb-4c07-9b83-2d76bad936d7",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Cette robe était cramoisie et faite de la plus belle laine ; […]."
                                            },
                                            {
                                                "example_id": "c36dc8c5-78f3-416b-aecc-7baaac825f4c",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Il est parfaitement vrai que je possède une robe de satin cramoisi, et il est non moins vrai que je l’ai achetée d’une fille de couleur, ma voisine, qui est entretenue par le capitaine Aguirre."
                                            },
                                            {
                                                "example_id": "0e2502a2-649a-4364-8105-3304ea51d4fc",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "La maison, dans laquelle on ne pouvait pas dire que cette lumière brillait, car elle était tamisée par un double rideau cramoisi dont elle traversait mystérieusement l’épaisseur, était une grande maison qui n’avait qu’un étage, — mais placé très haut…"
                                            },
                                            {
                                                "example_id": "e2222a4b-5792-4add-a6f2-c0af92898e98",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Le soleil qui quelques minutes avant était rouge cramoisi, était devenu d’un jaune vif, et les rayons d’or qu’il dardait étaient si flamboyants que l’œil en était ébloui ; […]."
                                            },
                                            {
                                                "example_id": "d94d66e2-81f6-4d29-becb-9f6eca81a7d6",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Le drapeau cueilli à Saint Blaize (et dont les Parisiens admirent, à la fenêtre du ministère, la soie cramoisie) présage toute une moisson d’étendards."
                                            },
                                            {
                                                "example_id": "d8214b2a-bcc4-4ddb-9a4c-7a7a6b417e2e",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Une visite banale, parfois, la laissait cramoisie et sans force aux bras du fauteuil capitonné, en reps vert."
                                            },
                                            {
                                                "example_id": "04d99fa7-0f44-4a83-a618-9a1b22a74225",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Et pourtant les figuiers s’obstinent à pousser spontanément parmi les gravats et je me gorge, sans rien payer, de leurs fruits cramoisis."
                                            },
                                            {
                                                "example_id": "0dbc8773-9870-4a09-9e03-20567c34f477",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Je connais une planète où il y a un monsieur cramoisi."
                                            },
                                            {
                                                "example_id": "940919e6-49d9-4278-a75f-609f77016b33",
                                                "sense_id": "af946f18-4e68-3ba3-98da-49163b090f3d",
                                                "text": "Alice était cramoisie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cramoisi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b27dbd8f-89e3-3036-85f3-f4b975d8e097",
                                        "entry_id": "2f57c561-bd56-3a1a-b723-7f266baf1b16",
                                        "glosses": [
