                        "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                        "entry_id": "4f9d395f-2865-3066-b9af-654c8fbd9435",
                        "glosses": [
                            "Containing fossils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b349dcbe-bcc8-49d7-b306-9fcbfb9f5462",
                                "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                                "text": "Having already described him [the whale] in most of his present habitatory and anatomical peculiarities, it now remains to magnify him in an archæological, fossiliferous, and antediluvian point of view."
                            },
                            {
                                "example_id": "4ec9362c-820a-4bba-8e57-e758c1962b25",
                                "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                                "text": "The area contains a great thickness of well exposed fossiliferous, marine strata of uppermost Cretaceous and Eocene age, and it is felt that the most continuous and complete section may be found here."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f82f019d-7924-4bef-a213-7f7ca22381e1",
                        "source_entry_id": "4f9d395f-2865-3066-b9af-654c8fbd9435",
