                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad50753b-1571-4129-be87-325b58eeefb7",
                                "sense_id": "3f1c381d-cb33-3070-bb3e-5b799db88276",
                                "text": "On appelle délaitage l’opération qui consiste à expulser du beurre le petit-lait qui reste interposé dans sa masse."
                            },
                            {
                                "example_id": "a15d6e82-9737-4c15-be6c-f8e823764f5b",
                                "sense_id": "3f1c381d-cb33-3070-bb3e-5b799db88276",
                                "text": "Le meilleur délaitage se fait en coupant le beurre par lames très minces , et en le pétrissant longuement avec des rouleaux et des battes."
                            }
                        ]
                    }
