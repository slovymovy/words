                                        "sense_id": "d66ffec0-0377-3218-acc3-9c201ebd8ee7",
                                        "entry_id": "bd067b3c-058a-3a95-8c53-62acf0d71751",
                                        "glosses": [
                                            "An expression of favorable acceptance and encouragement; a compliment that also condones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
