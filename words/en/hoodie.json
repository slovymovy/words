                            }
                        },
                        {
                            "text": "He pulled up his <w>hoodie</w> to keep his head warm in the wind.",
                            "target_lang_translations": {
                                "ru": "Он натянул <w>капюшон</w>, чтобы голову не продуло на ветру."
