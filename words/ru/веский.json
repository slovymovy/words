                    "sense_id": "fff3d76c-2eea-3d3d-a7e4-25ff5c70d1e2",
                    "sense_definition": "Имеющий большой вес, тяжёлый.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Птица сложила крылья и как <w>веский</w> камень упала вниз.",
                            "target_lang_translations": {
                                "en": "The bird folded its wings and fell down like a <w>heavy</w> stone.",
                                "es": "El pájaro plegó sus alas y cayó hacia abajo como una piedra <w>pesada</w>.",
                                "fr": "L'oiseau a replié ses ailes et est tombé comme une pierre <w>lourde</w>."
                            }
                        },
                        {
                            "text": "В руках у него был <w>веский</w> мешок с инструментами.",
                            "target_lang_translations": {
                                "en": "He had a <w>weighty</w> bag of tools in his hands.",
                                "es": "Tenía en sus manos un saco <w>pesado</w> con herramientas.",
                                "fr": "Il tenait dans ses mains un sac <w>lourd</w> d'outils."
                            }
                        }
                    ],
                    "synonyms": [
                        "тяжёлый"
                    ],
                    "antonyms": [
                        "лёгкий"
                    ],
                    "target_lang_definitions": {
                        "en": "Having significant physical weight; heavy.",
                        "es": "Que tiene mucho peso, pesado.",
                        "fr": "Qui a un poids important, lourd."
                    },
                    "translations": {
