                "senses": [
                    {
                        "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                        "entry_id": "3f368956-d7cc-392a-9897-048a80132aca",
                        "glosses": [
                            "Pigmentzelle, in welcher der Farbstoff Melanin produziert wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "4e20b4b2-240b-4aef-8f5e-e5f92b41d3a6",
                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                "text": "„Der Melanocyt ist eine Zelle, die durch ihren Gehalt an Tyrosinase befähigt ist, aktiv Melanin zu synthetisieren.“"
                            },
                            {
                                "example_id": "54019028-6bb0-40be-b14c-c9d4f31cbcf0",
                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                "text": "„Ist das Netzwerk im Gelzustand, so sind die Melaningranula im Zentrum der Zelle lokalisiert und der Melanocyt ist hell gefärbt.“"
                            },
                            {
                                "example_id": "85cde5b9-7c3a-4e02-a22c-75c2d28ed86a",
                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                "text": "„Daraus resultiert, daß die Melanoblasten ein eigenes Areal einnehmen, in das kein anderer Melanocyt eindringen kann, und daß sie sich in einem allseits ungefähr gleichen Abstand voneinander halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
