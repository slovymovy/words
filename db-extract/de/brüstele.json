                "senses": [
                    {
                        "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                        "entry_id": "50cc1063-fbe3-3b94-b560-237d109aabfa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e16acbc1-4caa-4e80-aa6d-911db1ef4099",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Frau Brüstele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db04d832-b9b9-467b-ae76-6aa8d6f94b6c",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Herr Brüstele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "831cd672-e2da-4794-b8b3-8317c57f2f9c",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Die Brüsteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "99df1dd9-c9e5-466a-b41e-8ad0029faaa0",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Der Brüstele trägt nie die Schals, die die Brüstele ihm strickt."
                            },
                            {
                                "example_id": "75982eb5-0bdd-4df0-84e6-b2cdbfd89da0",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brüstele kommt, geht der Herr Brüstele.“"
                            },
                            {
                                "example_id": "85d01aff-0f96-43d8-ae79-0bf407cab805",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Brüstele kommt und geht."
                            },
                            {
                                "example_id": "9ecfbb06-8fa9-45bc-b8b7-a08bd3bc2f9f",
                                "sense_id": "07fb10b2-546e-3f23-b5c3-beca2e571f4a",
                                "text": "Brüsteles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
