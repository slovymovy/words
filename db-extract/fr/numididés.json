                "senses": [
                    {
                        "sense_id": "327aac39-5ded-3d5e-a634-f916162060ea",
                        "entry_id": "19305161-ad4d-36b5-8810-9fcac7fca6e5",
                        "glosses": [
                            "Famille d’oiseaux de l'ordre des Galliformes, constituée de six espèces appartenant à quatre genres différents, essentiellement terrestres et coureuses, qui se distinguent par la présence d'un casque ou excroissance cornée au sommet du crâne, habitent toute l'Afrique subsaharienne, et qui sont connus sous le nom de pintades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211e16ec-92ea-457c-836f-d69b65c36234",
                                "sense_id": "327aac39-5ded-3d5e-a634-f916162060ea",
                                "text": "Les numididés ont été les sujets de la domestication par l'homme d'abord pour leur chair fort appréciée, et ensuite, comme dans le cas des faisans, pour leur élégance et leur aspects ornementaux."
                            },
                            {
                                "example_id": "fe68d666-c4be-46b7-bc85-c8324fc4fded",
                                "sense_id": "327aac39-5ded-3d5e-a634-f916162060ea",
                                "text": "Les numididés sont caractérisés par une longueur de 43 à 75 cm, un plumage sombre uniformément piqueté de « perles » blanches et serrées."
                            }
                        ]
                    }
