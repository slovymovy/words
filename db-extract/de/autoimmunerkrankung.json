                "senses": [
                    {
                        "sense_id": "6d8707ce-5f44-3340-884d-6c9f92048a7c",
                        "entry_id": "fe539e67-ee47-30fd-b15d-181e10403df2",
                        "glosses": [
                            "Maladie auto-immune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea753b2a-f92d-45b9-b694-b7c728496176",
                                "sense_id": "6d8707ce-5f44-3340-884d-6c9f92048a7c",
                                "text": "Die Ursache von Autoimmunerkrankungen ist größtenteils unklar.",
                                "translation": "La cause de la plupart des maladies auto-immunes est inconnue."
                            },
                            {
                                "example_id": "ab59ed6d-b928-4373-a6d4-49a4d8e8e424",
                                "sense_id": "6d8707ce-5f44-3340-884d-6c9f92048a7c",
                                "text": "Bei einer Autoimmunerkrankung erkennt der Körper eigene Organe nicht und greift sie als vermeintlichen Fremdkörper an.",
                                "translation": "Lors d’une maladie auto-immune, le corps ne reconnaît pas ses propres organes et les attaque comme s’ils étaient des corps étrangers."
                            },
                            {
                                "example_id": "4b1f49c5-76d7-48dc-908a-3bdc42d9996b",
                                "sense_id": "6d8707ce-5f44-3340-884d-6c9f92048a7c",
                                "text": "Eine häufig anzutreffende Autoimmunerkrankung ist der sogenannte juvenile Diabetes.",
                                "translation": "Le « diabète juvénile » est une maladie auto-immune courante."
                            }
                        ]
                    }
                ],
