                                        "glosses": [
                                            "That occurs every day, or at least every working day."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead122fc-3ea7-4d0c-91bc-ea0380c5fdf0",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "Near-synonyms: circadianly, diurnally"
                                            },
                                            {
                                                "example_id": "a008011b-af82-4bd4-bf61-9548d711133a",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "daily life"
                                            },
                                            {
                                                "example_id": "629705c4-7840-43ad-a534-19b75113a90f",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "on a daily basis"
                                            },
                                            {
                                                "example_id": "5c1619ca-574f-4281-88f7-002aeef6b750",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "daily routine"
                                            },
                                            {
                                                "example_id": "f05aa570-7cb3-4190-a026-88be3cd1329b",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "He follows a strict daily routine."
                                            },
                                            {
                                                "example_id": "31d83cad-be25-442f-913a-1a937aec82d5",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "The daily newspaper arrives each morning."
                                            },
                                            {
                                                "example_id": "aeca6539-6ea7-49e2-8338-a780c278bfc5",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "Give us this day our daily bread."
                                            },
                                            {
                                                "example_id": "a7d5bdd3-9be3-4c28-9699-5c4c18ff8aed",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "Bunyan has told us […] that in New England his dream was the daily subject of the conversation of thousands."
                                            },
                                            {
                                                "example_id": "75cd9fdd-0094-4d54-a648-9e6c83a39e64",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "Man hath his daily work of body or mind / Appointed, which declares his dignity, / And the regard of Heaven on all his ways."
                                            },
                                            {
                                                "example_id": "5dd7869a-1a9e-4802-b29b-771f71766de9",
                                                "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                                                "text": "The petty ſtreames that paie a dailie det / To their ſalt ſoveraigne with their freſh fals haſt, / Adde to his flowe, but alter not his taſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70377466-f8fc-37a2-ba00-ae684f75f326",
                                        "entry_id": "7aa3bd3d-fc20-3339-aebd-9de1f9852c06",
                                        "glosses": [
                                            "Diurnally: by daylight."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "daily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab91507-f197-3f1c-bb16-ad35f2d57e2d",
                                        "entry_id": "2b5fd70b-d3a6-390a-80bf-73f5ce49a405",
                                        "glosses": [
                                            "Something that is produced, consumed, used, or done every day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72fca5f-3749-49dc-835e-be9a5d763656",
                                                "sense_id": "0ab91507-f197-3f1c-bb16-ad35f2d57e2d",
                                                "text": "In the home office these dailies may be filed under one of two methods. Geographically by the territory controlled by an Agency, filing the dailies by their numbers back of the guide indicating the locality. Geographically as above, but filing the dailies by expiration date instead of by their numbers."
                                            },
                                            {
                                                "example_id": "0711eabc-6759-4cec-bcfd-3c90e6abe3cd",
                                                "sense_id": "0ab91507-f197-3f1c-bb16-ad35f2d57e2d",
                                                "text": "The dailies, or abstracts of the dailies, of the other companies and other departments are also checked, as has been said, in the Impaired Record department. For these coverages it is necessary to check for honesty or undesirable reputation of any kind. These dailies, and abstracts, are also taken by the \"impaired record girls\" when they have completed their checking, to the various departments."
                                            },
                                            {
                                                "example_id": "8cc69305-3d04-4d0c-bae0-994cfbe56b0f",
                                                "sense_id": "0ab91507-f197-3f1c-bb16-ad35f2d57e2d",
                                                "text": "The popular \"dailies\" format builds a broad range of knowledge by covering Tennessee Basics, Geography, History, People, and Government essential facts through interesting texts and visuals + reading comprehension activities, skill activities, map activities, and more."
                                            },
                                            {
                                                "example_id": "d8ffa1a2-cc1f-4c53-87ee-9ba67c6f727a",
                                                "sense_id": "0ab91507-f197-3f1c-bb16-ad35f2d57e2d",
                                                "text": "I do not let these experiences disrupt my focus in my daily or my responsibility for my family."
                                            }
                                        ]
                                    },
