                "senses": [
                    {
                        "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                        "entry_id": "3ac4a7d7-f9fa-39df-9611-fced00ce0920",
                        "glosses": [
                            "das Begehen von Flächen, Räumen, Gebäuden oder anderen Einrichtungen durch Fachleute; brandschutztechnische Überprüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c036a1-334b-4365-a5ba-4a08e1db5733",
                                "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                                "text": "Alle Brandschutzbegehungen durch Fachleute haben das Ziel, auf etwaiges Gefahrenpotential aufmerksam zu machen oder aber, der örtlichen Feuerwehr (im Fall der Fälle) die Möglichkeit einzuräumen, den Brand auch schnell und sicher löschen zu können."
                            },
                            {
                                "example_id": "0fb5f8e4-e19a-4f67-ab2b-c6a1e6af1521",
                                "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                                "text": "„Da die Handlungsweise der Mitarbeiter in der Regel nicht vom böswilligen Vorsatz, sondern von der betrieblichen Notwendigkeit oder Bequemlichkeit bestimmt wird, kann es nicht Sinn einer Brandschutzbegehung sein, Täter zu finden und zu bestrafen.“"
                            },
                            {
                                "example_id": "510a3f2c-0b6d-490b-aece-7d4ccf4945c3",
                                "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                                "text": "„Das Gebäude des Schlagbaums, in dem bisher mehrere Lokale untergebracht waren, sollte zu \"einer großen Gaststätte umgebaut werden, beim \"Gleis 3\" wollten die Verantwortlichen auf eine Brandschutzbegehung und deren Resultate warten. “"
                            },
                            {
                                "example_id": "4cf40fac-2ee0-4c1d-8b98-ac2bc2a2cf93",
                                "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                                "text": "„Aus diesem Grund führten vor ca. 2 Monaten die Verantwortlichen der FF Abtenau eine Brandschutzbegehung in diesem Betrieb mit hohem Gefahrenpotential durch.“"
                            },
                            {
                                "example_id": "68058a69-3b07-41b9-a9f1-86e0018e40c9",
                                "sense_id": "0f05a865-0f81-3618-adf9-389a929b2597",
                                "text": "„Brandschutzbegehungen zur Kontrolle der Brandschutzmaßnahmen sind zur Erfüllung der Sicherheit nach den gesetzlichen Vorschriften eine permanente Aufgabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
