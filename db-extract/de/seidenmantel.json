                ],
                "senses": [
                    {
                        "sense_id": "0fc8eaeb-1499-3835-9423-aeec63a926c7",
                        "entry_id": "bd470250-98d8-3a61-86e7-89547e9988bc",
                        "glosses": [
                            "aus Seide bestehender Mantel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee51a14-8025-4f2e-b823-d1afe2be69e6",
                                "sense_id": "0fc8eaeb-1499-3835-9423-aeec63a926c7",
                                "text": "„Er folgte gehorsam, da hob Jamanda die Arme hoch, und der luftige Seidenmantel glitt von ihren Schultern zu Boden.“"
                            },
                            {
                                "example_id": "4371e87b-8040-4456-90a1-4bf15e7e8d3f",
                                "sense_id": "0fc8eaeb-1499-3835-9423-aeec63a926c7",
                                "text": "„Väsele Li trug einen karminrotbunten Seidenmantel mit langen Ärmeln, darunter einen hellgrünen, mit allerlei Blumen und Blütenzweigen in Gold gewirkten Rock.“"
                            },
                            {
                                "example_id": "490e9c46-6399-4d6f-8d92-d89bc0eb6337",
                                "sense_id": "0fc8eaeb-1499-3835-9423-aeec63a926c7",
                                "text": "„Zu dem Seidenmantel Tante Margueritens gehörten auch noch ein Paar seidene Handschuhe, die sie ganz besonders in Ehren hielt und immer erst auf dem obersten Treppenabsatz anzog.“"
                            },
                            {
                                "example_id": "e67447b6-a2af-46f6-904a-fa6cfe4cda20",
                                "sense_id": "0fc8eaeb-1499-3835-9423-aeec63a926c7",
                                "text": "„Dann warf er den Seidenmantel ab und rannte in die kleinen Wellen hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
