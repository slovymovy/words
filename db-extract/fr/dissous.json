                    {
                        "sense_id": "4138d5f4-901c-396d-8b50-becb185ae1e3",
                        "entry_id": "8c478ac0-2a20-33fb-8289-21e6d3c7bd39",
                        "glosses": [
                            "Qui a été solubilisé, dispersé dans un liquide appelé « solvant »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb3a969-3a2d-452c-a0cc-a53799807a8a",
                                "sense_id": "4138d5f4-901c-396d-8b50-becb185ae1e3",
                                "text": "Le pastis, qui titre à 40 degrés, maintient les terpènes dissous. En présence d’eau, la dissémination de ces molécules donne un liquide laiteux."
                            }
                        ]
                    },
                    {
                        "sense_id": "4345bff6-43f5-3557-a5e7-51744c439851",
                        "entry_id": "8c478ac0-2a20-33fb-8289-21e6d3c7bd39",
                        "glosses": [
                            "Rompu."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7a142b94-7b75-46f9-bc2f-47302c8f5b6f",
                                "sense_id": "4345bff6-43f5-3557-a5e7-51744c439851",
                                "text": "À dater de quel moment le mariage est-il dissous par le divorce ?"
                            },
                            {
                                "example_id": "71a12656-7f1d-4d16-8de2-aa74fbbab1b6",
                                "sense_id": "4345bff6-43f5-3557-a5e7-51744c439851",
                                "text": "Chevallier et Laspalès est un duo d'humoristes français formé en 1981 par Philippe Chevallier et Régis Laspalès et dissous en 2016."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5ef0dac-ce8a-3577-ae18-458df87e89b6",
                        "entry_id": "8c478ac0-2a20-33fb-8289-21e6d3c7bd39",
                        "glosses": [
                            "Supprimé, démantelé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d6cf04-2664-4467-9b9c-79314b555c4b",
                                "sense_id": "e5ef0dac-ce8a-3577-ae18-458df87e89b6",
                                "text": "Tous les officiers appartenant aux régiments dissous devaient être renvoyés en Égypte."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a053da0-bb51-3138-a79a-4fdb8c97f615",
                        "entry_id": "8c478ac0-2a20-33fb-8289-21e6d3c7bd39",
                        "glosses": [
                            "Désorganisé au point de disparaître."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd2f91c-aca4-425f-8ba4-3439b29c6626",
                                "sense_id": "7a053da0-bb51-3138-a79a-4fdb8c97f615",
                                "text": "Jusqu’au 19 avril, le front est rompu, les groupes dissous, soumis à d’harassantes marches à travers une forêt."
                            }
                        ]
                    }
