        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bbc4fc68-4cab-3706-88b0-a98812a11cc4",
                    "sense_definition": "Participe présent de <w>croire</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parti sans veste, <w>croyant</w> que le soleil allait bientôt réchauffer l'air.",
                            "target_lang_translations": {
                                "en": "He left without a jacket, <w>believing</w> that the sun would soon warm the air.",
                                "ru": "Он ушёл без куртки, <w>полагая</w>, что солнце скоро согреет воздух.",
                                "de": "Er ist ohne Jacke losgegangen, da er <w>glaubte</w>, dass die Sonne die Luft bald erwärmen würde.",
                                "es": "Salió sin chaqueta, <w>creyendo</w> que el sol pronto calentaría el aire.",
                                "zh": "他没穿外套就出门了，<w>认为</w>太阳很快就会让空气暖和起来。"
                            }
                        },
                        {
                            "text": "Elle a pris cette décision difficile en <w>croyant</w> bien faire pour son entourage.",
                            "target_lang_translations": {
                                "en": "She made this difficult decision, <w>believing</w> she was doing the right thing for those around her.",
                                "ru": "Она приняла это трудное решение, <w>веря</w>, что поступает правильно по отношению к окружающим.",
                                "de": "Sie traf diese schwere Entscheidung und <w>glaubte</w> dabei, das Richtige für ihr Umfeld zu tun.",
                                "es": "Tomó esta difícil decisión <w>creyendo</w> que hacía lo correcto por quienes la rodeaban.",
                                "zh": "她做出这个艰难的决定，<w>认为</w>自己是在为身边的人着想。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "en croyant bien faire"
                    ],
                    "target_lang_definitions": {
