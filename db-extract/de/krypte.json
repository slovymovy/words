                "senses": [
                    {
                        "sense_id": "f31e556f-a66b-3c6c-938a-e8d2bf14fb2f",
                        "entry_id": "df83ec2c-2e24-3126-ada7-65da604bbd84",
                        "glosses": [
                            "eine mehr oder weniger tiefe Grube, die mit Epithel bzw. mit einer Schleimhaut ausgekleidet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfdcb894-1e2e-4983-b042-1feb3e1b4656",
                                "sense_id": "f31e556f-a66b-3c6c-938a-e8d2bf14fb2f",
                                "text": "„Gesteigerte Proliferation des Epithels mit normaler Zelldifferenzierung und nur geringer Expansion der mitotischen Zone im unteren Drittel der Krypte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
