            "senses": [
                {
                    "sense_id": "46b864f2-9386-326c-8604-6c1d6239b74f",
                    "sense_definition": "Élément ou événement imprévisible qui vient modifier le cours des choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aleas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet a pris du retard à cause d'un <w>impondérable</w> survenu sur le chantier."
                        },
                        {
                            "text": "Il faut toujours prévoir une marge de sécurité face aux <w>impondérables</w> du voyage."
                        }
                    ],
                    "synonyms": [
                        "aléa",
                        "imprévu"
                    ],
                    "common_phrases": [
