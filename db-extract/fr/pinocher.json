                "senses": [
                    {
                        "sense_id": "f6c521a0-691c-3605-9867-4deb454acc76",
                        "entry_id": "d58f7d82-74f5-3070-ad67-8fcc044aa3fe",
                        "glosses": [
                            "Manger sans appétit et en ne prenant que de très petits morceaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f40245d9-e431-4e1b-ad6f-d73168b79c81",
                                "sense_id": "f6c521a0-691c-3605-9867-4deb454acc76",
                                "text": "À l’instar de Néron, le Terrible Turc était vautré sur un monticule de coussins et pinochait dans ce qui restait d’une salade de crevettes sur une table à roulettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf93116-3169-3d8f-94eb-b0c1c3a05cbd",
                        "entry_id": "d58f7d82-74f5-3070-ad67-8fcc044aa3fe",
                        "glosses": [
                            "Fignoler, apporter beaucoup de soin à ce que l’on entreprend."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ce844044-c09c-4584-b758-4d942c9fac6d",
                                "sense_id": "0bf93116-3169-3d8f-94eb-b0c1c3a05cbd",
                                "text": "Ce roman il l’a écrit laborieusement, l’a pinoché à mort."
                            }
                        ]
                    }
