                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e955506-0fd8-411a-badc-841c4730ac2b",
                                "sense_id": "a933f868-21be-3e6f-952a-70fd19db0b3c",
                                "text": "И, гнусавя надо мной / как над усопшим монах / Читает мне жизнь / Какого-то прохвоста и забулдыги"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "608f4f49-ed7c-4604-8c08-69018513861f",
                        "source_entry_id": "a5f536eb-5644-334f-a1fd-ab6070fbf854",
                        "source_sense_id": "a933f868-21be-3e6f-952a-70fd19db0b3c",
                        "target_lang_word": "näseln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "näseln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cee527f4-a146-36cc-99a2-06e9558055c0",
                                        "entry_id": "7393cc87-5abb-3783-b5b4-6a5e407e4d7a",
                                        "glosses": [
                                            "durch die Nase sprechen oder singen; nasal sprechen oder singen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "635e698e-be3d-4391-9f6a-456e0b4709d7",
                                                "sense_id": "cee527f4-a146-36cc-99a2-06e9558055c0",
                                                "text": "„Ja, er ist der Lindenberg der Nullerjahre. Statt zu nuscheln näselt Jan Delay über den deutschen Alltag.“"
                                            },
                                            {
                                                "example_id": "1c4d39cd-2de5-49bf-a7c2-8da45f622d4c",
                                                "sense_id": "cee527f4-a146-36cc-99a2-06e9558055c0",
                                                "text": "„Wenn Kinder näseln, dann kann man das logopädisch behandeln lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
