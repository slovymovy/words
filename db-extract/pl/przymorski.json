                        "glosses": [
                            "znajdujący się, działający lub odbywający się przy morzu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee875da-af7e-4d71-a8eb-fc52986d22c3",
                                "sense_id": "d955be78-e782-3473-b2f1-1fbfa037f84e",
                                "text": "Znaczne różnice zasolenia wraz z głębokością występują często w wielu jeziorach przymorskich"
                            },
                            {
                                "example_id": "0e3ac940-5e63-4897-be20-d71ce3af7376",
                                "sense_id": "d955be78-e782-3473-b2f1-1fbfa037f84e",
                                "text": "Zagrożenie powodziowe dotyczy mierzei nisko położonych oraz depresyjnych obszarów przymorskich, a także wysokich brzegów klifowych"
                            }
