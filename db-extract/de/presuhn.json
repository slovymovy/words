                "senses": [
                    {
                        "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                        "entry_id": "ca0edb9b-fe9a-3c4b-86c6-27634630a877",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b3c077-d469-4278-b7c3-2ca44f71dbd8",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Frau Presuhn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "199d34d6-be36-43b6-9db5-3a62d5050458",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Herr Presuhn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dcb493a1-275d-475b-aea2-5420fe493c3d",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Die Presuhns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f01567cc-0bfd-4946-b73e-2b519dd8bc32",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Der Presuhn trägt nie die Schals, die die Presuhn ihm strickt."
                            },
                            {
                                "example_id": "6681d653-7d74-4441-a6b0-c9d3e03c6f21",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Presuhn kommt, geht der Herr Presuhn.“"
                            },
                            {
                                "example_id": "5af41122-075a-4753-bfa0-2fc295f9e4a6",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Presuhn kommt und geht."
                            },
                            {
                                "example_id": "6aac5682-ccdb-4d3b-906d-d4e5517e14be",
                                "sense_id": "81718314-271a-33e7-bc63-75fd672d4bae",
                                "text": "Presuhns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
