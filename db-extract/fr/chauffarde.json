                "senses": [
                    {
                        "sense_id": "462bad2d-b39f-320d-a1f0-210958ffb130",
                        "entry_id": "e3dd0e59-7699-390f-9692-f354a10a1251",
                        "glosses": [
                            "Mauvaise conductrice, personne dont le comportement au volant est dangereux. Souvent utilisé de manière injurieuse."
                        ],
                        "tags": [
                            "pejorative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c18a5c92-ae9a-4b48-915c-0f299447525d",
                                "sense_id": "462bad2d-b39f-320d-a1f0-210958ffb130",
                                "text": "L’idée que sa fille portait une veste semblable à celle d’une chauffarde était déplaisante."
                            },
                            {
                                "example_id": "5bc4df59-4ac8-4d1f-9ddd-e608fcca4bfc",
                                "sense_id": "462bad2d-b39f-320d-a1f0-210958ffb130",
                                "text": "En plus de l’hélicoptère, dix véhicules de pompiers ont été dépêchés sur place pour prendre en charge les victimes de la chauffarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55fb6257-939e-426b-aa51-8b82042399bb",
                        "source_entry_id": "e3dd0e59-7699-390f-9692-f354a10a1251",
                        "source_sense_id": "462bad2d-b39f-320d-a1f0-210958ffb130",
                        "target_lang_word": "Heizer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heizer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                        "entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                                        "glosses": [
                                            "Person, die beruflich für die Beheizung von Dampfkesseln, Heizungsanlagen und Verbrennungsanlagen vorwiegend bei Dampflokomotiven und Dampfschiffen sorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "909fcab8-31ab-4e5a-b1ae-50d38dd0539d",
                                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                                "text": "„Bei ersten Versuchen benutzte man kleine, auf dem Tender aufgestellte Kolbendampfmaschinen, deren Regelung jedoch vom Heizer zu viel Aufmerksamkeit forderte.“"
                                            },
                                            {
                                                "example_id": "76b3d0ec-ba4d-47c7-a29e-c06c78b6cfbd",
                                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                                "text": "„Die Mannschaftsräume waren klein und bis zur Unerträglichkeit überfüllt, alles war da zusammengewürfelt: Matrosen, Heizer, Signalgasten und Funker.“"
                                            },
                                            {
                                                "example_id": "b1e91ad5-d000-40cc-8f48-f80257705493",
                                                "sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                                                "text": "„Wie schaffte er es nur, den schweren Beruf eines Heizers auszuüben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4045eac0-1ccf-33ae-99fa-4cb9eb841ad0",
                                        "entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                                        "glosses": [
                                            "bis zum Jahr 1938 Dienstgrad der deutschen Marine"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cbdc025-1284-4322-9270-50fbed2d9fe2",
                                                "sense_id": "4045eac0-1ccf-33ae-99fa-4cb9eb841ad0",
                                                "text": "Sein Urgroßvater hatte in den 20er Jahren als Heizer bei der Reichswehr gedient."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e61d1bcf-41f2-45c8-8d1c-56884afbd91f",
                        "source_entry_id": "e3dd0e59-7699-390f-9692-f354a10a1251",
                        "source_sense_id": "462bad2d-b39f-320d-a1f0-210958ffb130",
