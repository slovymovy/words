                "senses": [
                    {
                        "sense_id": "a7c38280-c79d-364c-afb2-7e6ebc9e212c",
                        "entry_id": "1a03ac5c-51e7-3d0d-956a-a1bc9fd0fcff",
                        "glosses": [
                            "Sinn, Grund der Existenz, Ziel oder Nutzen des Daseins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099f2421-df8e-4b1c-9651-25e0848d208f",
                                "sense_id": "a7c38280-c79d-364c-afb2-7e6ebc9e212c",
                                "text": "„Falls er sein ganzes Leben nach etwas gesucht hatte, nach einem Daseinsgrund, einem Sinn seiner Existenz, schien es plötzlich, als hätte er ihn gefunden.“"
                            },
                            {
                                "example_id": "305924eb-828f-4a40-b130-845d6779472b",
                                "sense_id": "a7c38280-c79d-364c-afb2-7e6ebc9e212c",
                                "text": "„Ich trage eine riesige Kraft in meinem Kopf, meinen Daseinsgrund, und auch mein Schicksal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
