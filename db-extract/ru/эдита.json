                                                "example_id": "ed3a1988-cf30-4a2e-b088-8f3962e79a86",
                                                "sense_id": "4d9b6b00-50a3-3506-9bd8-4780df4c7dfd",
                                                "text": "Comme Édith Piaf, vous aussi vous vous en foutez du monde entier ?"
