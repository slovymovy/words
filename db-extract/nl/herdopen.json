                    {
                        "sense_id": "740464b3-82b2-3245-8130-81c8048bf378",
                        "entry_id": "9fec38b5-2fe2-3dee-b242-4315a7c27888",
                        "glosses": [
                            "opnieuw dopen van iemand die al eerder het doopsel heeft ontvangen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fcaf75a6-f7c7-30b4-9580-ba3b7ee3ce44",
                        "entry_id": "9fec38b5-2fe2-3dee-b242-4315a7c27888",
                        "glosses": [
                            "iets een andere, nieuwe naam geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84678874-d902-40c4-a9b4-e7e89455dabe",
                                "sense_id": "fcaf75a6-f7c7-30b4-9580-ba3b7ee3ce44",
                                "text": "Als eerbetoon aan de veel te vroege overleden Michael Goolaerts zal een kasseistrook van Parijs-Roubaix herdoopt worden tot 'Secteur Pavé Michael Goolaerts'."
                            },
                            {
                                "example_id": "fb88e74c-7b5b-4478-a805-e6b4bce8058a",
                                "sense_id": "fcaf75a6-f7c7-30b4-9580-ba3b7ee3ce44",
                                "text": "Het multiculturele drama wordt herdoopt als superdiversiteit. Twee vliegen in één klap, want ook het idee van een dominante cultuur waaraan nieuwkomers in een liberale democratie zich moeten aanpassen voor succesvolle integratie is weg."
                            },
                            {
                                "example_id": "ad992ddd-b2f4-44ff-968c-b33a233ae9a0",
                                "sense_id": "fcaf75a6-f7c7-30b4-9580-ba3b7ee3ce44",
                                "text": "Lieftinck stampte in enkele maanden de Maatschappij tot Financiering van het Nationaal Herstel uit de grond. Via deze op 31 oktober 1945 officieel opgerichte staatsbank werd de aan Nederland verstrekte Amerikaanse Marshallhulp de door de oorlog verwoeste Nederlandse economie ingepompt. In 1971 werd de Herstelbank herdoopt tot De Nationale Investeringsbank (DNIB)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "709c086c-0016-49dc-8524-19741cc547b5",
                        "source_entry_id": "9fec38b5-2fe2-3dee-b242-4315a7c27888",
                        "source_sense_id": "740464b3-82b2-3245-8130-81c8048bf378",
                        "target_lang_word": "rebaptize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebaptize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8899483-deba-3729-a53c-92521fad6f39",
                                        "entry_id": "84ccc8eb-5bdd-33ad-82e0-c145e528036c",
                                        "glosses": [
                                            "To baptize again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90ccae0-4bb4-4eac-bc72-b5b00bfd92eb",
                                                "sense_id": "c8899483-deba-3729-a53c-92521fad6f39",
                                                "text": "She's a freako religious number, pushing Christians into any trough of water handy to rebaptize them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d4647-d2e8-3644-85e7-4ffec56b29d2",
                                        "entry_id": "84ccc8eb-5bdd-33ad-82e0-c145e528036c",
                                        "glosses": [
                                            "To rename."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8b456cb-533a-4711-ba01-0f7571775d0d",
                                                "sense_id": "a32d4647-d2e8-3644-85e7-4ffec56b29d2",
                                                "text": "After the fire destroyed the Bronx pub, it was rebaptized “The Bronx 2”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc03db0e-3619-4856-8745-4b9c55e1d4b8",
                        "source_entry_id": "9fec38b5-2fe2-3dee-b242-4315a7c27888",
                        "source_sense_id": "740464b3-82b2-3245-8130-81c8048bf378",
                        "target_lang_word": "rechristen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechristen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d9328d8-0207-3ad0-b5b3-408fc2d91dea",
                                        "entry_id": "ad4c6c8f-675e-3b92-94a6-dda29188f9aa",
                                        "glosses": [
                                            "To christen or baptize again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6037af43-0e35-30de-8335-d2714eaa0903",
                                        "entry_id": "ad4c6c8f-675e-3b92-94a6-dda29188f9aa",
                                        "glosses": [
                                            "To rename."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f8f70d5-0139-48c7-9cd6-e2cffc4d59da",
                                                "sense_id": "6037af43-0e35-30de-8335-d2714eaa0903",
                                                "text": "Jewellery is broken up; watches are 'rechristened.' The 'fences' or receivers of stolen goods are of all grades, and serve every sort of thief; and in Hoxton thieves of every kind seem to be represented."
                                            },
                                            {
                                                "example_id": "73a0efe0-c7a0-4856-be52-baa2d3f59efc",
                                                "sense_id": "6037af43-0e35-30de-8335-d2714eaa0903",
                                                "text": "Illinois and partner organizations kicked off a market-tested campaign Wednesday to rechristen as “copi” four species previously known collectively as Asian carp, hoping the new label will make them more attractive to U.S. consumers."
                                            },
                                            {
                                                "example_id": "8edd4edd-e526-4a5d-9cce-b33b175ddedf",
                                                "sense_id": "6037af43-0e35-30de-8335-d2714eaa0903",
                                                "text": "Musk later rechristened Twitter as X, further loosening moderation on the platform, and restoring the accounts of users previously banned for bigotry or harassment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
