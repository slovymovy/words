                                "example_id": "3b5ad134-5f76-42c4-8785-a55db6ea1592",
                                "sense_id": "a9795ca1-7c3a-314e-b0c1-2a0b259be37e",
                                "text": "La gastronomie est affaire de rites et le Rhônalpin, de cœur et de naissance, s’y soumet avec passion."
                            },
                            {
                                "example_id": "5404d44b-f568-433a-b37d-b708e9cb9a27",
                                "sense_id": "a9795ca1-7c3a-314e-b0c1-2a0b259be37e",
                                "text": "Qu'importent les péripéties, le Rhônalpin, qui abordera le versant de la cinquantaine en avril, est déjà remonté sur son cheval …."
                            }
                        ]
