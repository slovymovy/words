                "senses": [
                    {
                        "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                        "entry_id": "b0a45373-d0ed-3e75-91d1-f34085d97d8c",
                        "glosses": [
                            "Frau, die einen Menschen für eine Gegenleistung ermordet; Frau, die einen Auftragsmord ausführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dccf4ac-c7e8-419a-8602-78b97a0bb8a7",
                                "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                                "text": "[Film \"Die Ballade von Cenk und Valerie\":] „[…] Valerie ist eine weltweit gesuchte Auftragskillerin […].“"
                            },
                            {
                                "example_id": "5aed5086-80f7-4acb-b4e9-73a4c959e2c6",
                                "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                                "text": "[Film «The Assassin»:] „Nie Yinniang hat ihr Studium abgeschlossen und ist nun Auftragskillerin. Ihre Missionen beinhalten zum Beispiel, korrupte Politiker aus dem Weg zu räumen.“"
                            },
                            {
                                "example_id": "c5cd478f-e22d-48a2-a8a3-aeeac96ef70f",
                                "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                                "text": "[\"Killing Eve\":] „Nach internationalem Hype kommt die BBC-Serie über eine Auftragskillerin und Geheimdienstagentin endlich auch nach Deutschland.“"
                            },
                            {
                                "example_id": "c8e260aa-188f-4423-856d-d27afbb8620a",
                                "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                                "text": "„Im \"Tatort: Der große Schmerz\", den am Neujahrsabend (1. Januar) im Ersten rund 8,24 Millionen Zuschauerinnen und Zuschauer sahen, war neben Til Schweiger, […] u. a. Helene Fischer als russische Auftragskillerin zu sehen.“"
                            },
                            {
                                "example_id": "6b73a681-fa37-472f-b2bf-ac4509f54165",
                                "sense_id": "fcd06b15-a46e-3766-8afc-d48d08ebd3d7",
                                "text": "[Film „Eine Karte der Klänge von Tokio“:] „Natürlich muss man an „Nikita“ denken, Luc Bessons Film-noir-Portrait einer kühlen, innerlich verhärteten Auftragskillerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
