                ],
                "senses": [
                    {
                        "sense_id": "7d5d3bc9-e78c-3a8c-8df7-a2455c8bc33c",
                        "entry_id": "01c7218e-0b6f-3b7b-b078-67c11a0f60dc",
                        "glosses": [
                            "Temps qui suit le diner, qui se prenait autrefois à midi."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0cdb74ad-0fc3-4ab2-bbe6-f33401133b7c",
                                "sense_id": "7d5d3bc9-e78c-3a8c-8df7-a2455c8bc33c",
                                "text": "Le 14ème jour de may mil six centz quarante trois expira Louys treize Roy de France et de Navarre et la quarante deuxiesme de son aage non encore révolu, apres avoir regne justement trente trois ans et ce qui ne se peut concepvoir sans merveille, le mesme jour du mesme mois, la mesme apres diner qui fut sur les deux heures et un quart apres midy, …"
                            },
                            {
                                "example_id": "09661c07-1ac1-4db7-b283-8f7ae9967d28",
                                "sense_id": "7d5d3bc9-e78c-3a8c-8df7-a2455c8bc33c",
                                "text": "Il nous a quittés cet après-diner sans rien dire à personne, mais je doute de l’endroit où il se rend, …."
                            },
                            {
                                "example_id": "5bd7b4ff-12f7-4e35-9f1f-6f0c10adbe7f",
                                "sense_id": "7d5d3bc9-e78c-3a8c-8df7-a2455c8bc33c",
                                "text": "Mais, ce jour-là, l'atmosphère s'embruma subitement, et une forte bourrasque, accompagnée de brumailles, se déclara dans l'après-diner."
                            },
                            {
                                "example_id": "32c41e85-9b91-4d63-840e-cf26757b19b5",
                                "sense_id": "7d5d3bc9-e78c-3a8c-8df7-a2455c8bc33c",
                                "text": "Un matin, s’étant réveillé tout joyeux, il courut à la chapelle et y demeura seul pendant plus d’une heure. Il y retourna l’après-dîner."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf4f5be3-f7cd-3e17-bceb-812b053b4535",
                        "entry_id": "01c7218e-0b6f-3b7b-b078-67c11a0f60dc",
                        "glosses": [
                            "Moment qui est après le repas du soir."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd957a59-fa51-4420-af1c-e99c0ec9e2d8",
                        "source_entry_id": "01c7218e-0b6f-3b7b-b078-67c11a0f60dc",
                        "target_lang_word": "Nachmittag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachmittag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                        "entry_id": "60e21b15-3c35-3db0-b274-1009be644181",
                                        "glosses": [
                                            "die Zeit vom Mittag bis zum Abend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74847c6c-6422-4a99-b9fc-63e3060e60e3",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "Unser Flug startet am Nachmittag."
                                            },
                                            {
                                                "example_id": "d93fba9e-5db4-444a-96e2-954167d7b7f9",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Endlich, am späten Nachmittag, kamen Flugzeuge, einige Spitfire und Mustangs, die aus Richtung Flensburg oder Schleswig hereindrehten, um im Tiefflug über uns hinwegzuflitzen und auf die Nordsee hinaus zu verschwinden.“"
                                            },
                                            {
                                                "example_id": "568e0c89-a4f1-4573-a029-b316d870e033",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Wir landeten am späten Nachmittag in einer kleinen sandigen Bucht.“"
                                            },
                                            {
                                                "example_id": "891a48c0-c6be-41e9-aaca-fa00a80baa80",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Es ging dann schon auf den Nachmittag zu, und ich hatte nun auch etwas Hunger.“"
                                            },
                                            {
                                                "example_id": "1bb69aa5-972d-49d0-8431-556a123c7e2f",
                                                "sense_id": "60db1462-a603-3b2e-ad62-a5022a02a3c7",
                                                "text": "„Eines Nachmittags saß ich bei offenem Fenster in meiner Bücherstube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
