                "senses": [
                    {
                        "sense_id": "28a01a2a-ebb6-381a-8522-082fa77b50a2",
                        "entry_id": "a4f502a3-f324-3650-8c5e-d5e49f61eea9",
                        "glosses": [
                            "Action d’aléser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c374546-dbdf-467a-8ab4-d94cd4d0218b",
                                "sense_id": "28a01a2a-ebb6-381a-8522-082fa77b50a2",
                                "text": "L'alésage manuel est un procédé d'usinage par enlèvement de copeau au moyen d'outils appelés alésoirs\ncette opération consiste à parfaire :\n- Les dimensions\n- L'état de surface\n- La rectitude des génératrices des trous de perçage"
                            },
                            {
                                "example_id": "579dbfd9-98bf-441d-a235-d05662460f97",
                                "sense_id": "28a01a2a-ebb6-381a-8522-082fa77b50a2",
                                "text": "Ce composant est construit dans un acier nitruré et l’alésage doit être usiné avec ces tolérances très étroites."
                            }
                        ]
                    },
                    {
                        "sense_id": "6646ebbc-c13c-3261-9fc2-5079fb99d99a",
                        "entry_id": "a4f502a3-f324-3650-8c5e-d5e49f61eea9",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cbd5bc7-e751-4913-937c-aa3a376301cc",
                                "sense_id": "6646ebbc-c13c-3261-9fc2-5079fb99d99a",
                                "text": "La différence de hauteur entre les surfaces repères et la référence du sabre magnétique (le fond de l'alésage du piquage du tube de jaugeage) doit pouvoir être mesurée."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9e61260-1d0a-37d7-9ad6-70148a1cf067",
                        "entry_id": "a4f502a3-f324-3650-8c5e-d5e49f61eea9",
