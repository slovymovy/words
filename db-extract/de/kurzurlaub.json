                "senses": [
                    {
                        "sense_id": "95a4e5d3-45b6-3a52-98ea-52746aedf716",
                        "entry_id": "ba28844f-1a64-3f5b-b288-065641985a7d",
                        "glosses": [
                            "Urlaub, der nur wenige Tage dauert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d28076c-6b86-4ec2-a6ff-51f92fef3896",
                                "sense_id": "95a4e5d3-45b6-3a52-98ea-52746aedf716",
                                "text": "Sie verbrachten ihren Kurzurlaub an der Ostsee."
                            },
                            {
                                "example_id": "2a13e064-f190-4e6e-ba8a-b47ce8f12787",
                                "sense_id": "95a4e5d3-45b6-3a52-98ea-52746aedf716",
                                "text": "„Doro hatte mehrere Tag- und Nachtdienste im Krankenhaus hinter sich, mit denen sie den Kurzurlaub herausgeschunden hatte, und Vega war der Universität gewesen und danach bis morgens vier Uhr in der Bar, wo sie jobbte, um die Reisekasse aufzubessern.“"
                            },
                            {
                                "example_id": "f9347b8c-ad45-4dd4-84e7-effe05846bd3",
                                "sense_id": "95a4e5d3-45b6-3a52-98ea-52746aedf716",
                                "text": "„Sie gefielen einander derart, dass sie einen Kurzurlaub beschlossen, im Gebirge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
