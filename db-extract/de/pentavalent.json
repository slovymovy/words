                ],
                "senses": [
                    {
                        "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                        "entry_id": "334dd79e-e48c-3161-acfa-b9b7a84207f5",
                        "glosses": [
                            "gleichzeitig gegen fünf unterschiedliche Erreger immunisierend"
                        ],
                        "tags": [
                            "bei Impfstoffen"
                        ],
                        "examples": [
                            {
                                "example_id": "ffd74c9a-8793-448f-9846-3cdbb648287b",
                                "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                                "text": "„Die Muttertierschutzimpfung erbrachte für die mit dem pentavalenten Impfstoff immunisierten Tiere signifikante Schutzwirkungen im Sinne einer Morbiditäts- und Mortalitätssenkung, die dosisabhängig waren.“"
                            },
                            {
                                "example_id": "c0542701-e705-4323-ab94-3f21ead820c7",
                                "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                                "text": "„Es handelt sich um den monovalenten Impfstoff Rotarix aus einem humanen Rotavirusstamm und den pentavalenten Impfstoff RotaTeq, eine Kombination von fünf bovin-humanen Modifikationen eines Rotavirusstammes […].“"
                            },
                            {
                                "example_id": "dfb3539d-df93-44b4-85a6-8344fec218aa",
                                "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                                "text": "„Bei dem zweiten Impfstoff mit dem Namen RotaTec handelt es sich um eine pentavalente Vakzine.“"
                            },
                            {
                                "example_id": "414d48e4-8d6c-4e53-bde8-c0514dd152d2",
                                "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                                "text": "„Es wird z. B. 4mal in monatlichen Abständen mit quadrivalenten […] oder 3mal im Abstand von 3 Wochen mit pentavalenten Vakzinen […] geimpft.“"
                            },
                            {
                                "example_id": "770e2069-31f9-492c-8d2d-faaf63cd9bc6",
                                "sense_id": "7fac49df-db32-3c59-a9be-ea0d8f71bc59",
                                "text": "„RotaTeq ist ein human-boviner reassortierter pentavalenter Impfstoff, der die Serotypen G1, G2, G3, G4 und P1a enthält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                        "entry_id": "334dd79e-e48c-3161-acfa-b9b7a84207f5",
                        "glosses": [
                            "zu einer chemischen Bindung mit fünf Atomen fähig"
                        ],
                        "tags": [
                            "bei einem Atom"
                        ],
                        "examples": [
                            {
                                "example_id": "07cca4fb-8eac-4256-9551-1dffeffa3101",
                                "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                                "text": "„Die Schwefelsäure ist nach Herausnahme vollkommen klar; alles pentavalente Vanadin war reduziert.“"
                            },
                            {
                                "example_id": "60e031bd-e4d9-4712-948a-88cb4f285b8a",
                                "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                                "text": "„Bei Gegenwart von Arsenation muss dagegen vorerst reduziert werden, da unter den angegebenen Versuchsbedingungen der Methylalkohol auf das pentavalente Arsen gar nicht reduzierend wirkt.“"
                            },
                            {
                                "example_id": "d0491166-1b51-4cf3-9e76-1380644e2d85",
                                "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                                "text": "„Sie dürfte so zu erklären sein , dass die Gruppe CN entweder tetravalenten C und trivalenten N oder divalenten C und pentavalenten N enthält.“"
                            },
                            {
                                "example_id": "5be90dce-60c0-4bac-9138-ad1221352b72",
                                "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                                "text": "„Es handelt sich hierbei um die Aufeinanderfolge zweier SN2-Prozesse, in deren Verlauf das P-Atom vom trivalenten in den pentavalenten Zustand überführt wird.“"
                            },
                            {
                                "example_id": "356290f0-4d4f-4554-bc13-437a3298ef68",
                                "sense_id": "b0793f98-63fd-3b18-a14e-802c3b2e5101",
                                "text": "„Sind Arsen und Antimon in der trivalenten Form zugegen, so müssen sie erst in die pentavalente, also in Arsensäure und Antimonsäure, übergeführt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
