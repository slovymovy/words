                            {
                                "example_id": "f8c6d770-4e7b-4f3f-a19b-6eb0473e76b2",
                                "sense_id": "4423df5a-a654-30cc-9d40-ab5925eb93a4",
                                "text": "Die Komik des Clowns brachte ihn herzhaft zum Lachen."
                            },
                            {
                                "example_id": "b5f0caee-538c-4a41-b674-d2a342f6ae71",
                                "sense_id": "4423df5a-a654-30cc-9d40-ab5925eb93a4",
                                "text": "„Seine tiefsitzende Faulheit war zuweilen von unfreiwilliger Komik begleitet.“"
                            },
                            {
                                "example_id": "2c6394f8-6e1d-4734-baa4-a6cd1939831a",
                                "sense_id": "4423df5a-a654-30cc-9d40-ab5925eb93a4",
                                "text": "„Die Komik des Schwankes wird in anschaulichen Bildern entwickelt.“"
                            }
