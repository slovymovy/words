                    {
                        "sense_id": "c06f3528-0245-34e5-92cc-598a5a1a601c",
                        "entry_id": "faf4360f-c4af-36b4-a86f-f4e155b6266f",
                        "glosses": [
                            "motyl z rodziny Noctuidae, sówkowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6be9614e-df8a-4e7a-a5a3-13c6d07cf698",
                                "sense_id": "c06f3528-0245-34e5-92cc-598a5a1a601c",
                                "text": "U starszych larw sówek głowy stają się brązowe."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55c89643-5f7c-4471-96d0-da911c8ad1cb",
                        "source_entry_id": "faf4360f-c4af-36b4-a86f-f4e155b6266f",
                        "source_sense_id": "ab5c1f38-8d69-337b-b11d-c21db303516f",
                        "target_lang_word": "owlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "owlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "def8be7b-1cb3-38e6-93f6-05ac4233b082",
                                        "entry_id": "5ec8af88-181c-363d-9dde-d30fddab4706",
                                        "glosses": [
                                            "Diminutive of owl."
                                        ],
                                        "tags": [
                                            "diminutive",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3a7866-f88f-46e1-bae2-6b2e84cc8110",
                                                "sense_id": "def8be7b-1cb3-38e6-93f6-05ac4233b082",
                                                "text": "And in faith Sir unlesse your hospitalitie doe releeve us, wee are like to wander with a sorrowfull hey ho, among the owlets, & Hobgoblins of the Forrest […]"
                                            },
                                            {
                                                "example_id": "8148475e-788e-445c-ae47-f24622238edf",
                                                "sense_id": "def8be7b-1cb3-38e6-93f6-05ac4233b082",
                                                "text": "Adder’s fork and blind-worm’s sting,\nLizard’s leg and owlet’s wing,\nFor a charm of powerful trouble,\nLike a hell-broth boil and bubble."
                                            },
                                            {
                                                "example_id": "584fc62c-3787-4ecc-9f13-122caccdebb6",
                                                "sense_id": "def8be7b-1cb3-38e6-93f6-05ac4233b082",
                                                "text": "[…] and bold with joy,\nForth from his dark and lonely hiding-place\n(Portentous sight) the owlet, ATHEISM,\nSailing on obscene wings athwart the noon,\nDrops his blue-fringed lids, and holds them close,\nAnd, hooting at the glorious sun in heaven,\nCries out, “where is it?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffacf2cd-59df-3515-9f7a-23e8c6c286d0",
                                        "entry_id": "5ec8af88-181c-363d-9dde-d30fddab4706",
                                        "glosses": [
                                            "A young owl; owling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9094851-bc57-3294-9e7a-b60463ee4367",
                                        "entry_id": "5ec8af88-181c-363d-9dde-d30fddab4706",
                                        "glosses": [
                                            "One of a species of small owls, such as Athene noctua."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f0be148-7318-32bb-8c44-3527bb837ab4",
                                        "entry_id": "5ec8af88-181c-363d-9dde-d30fddab4706",
                                        "glosses": [
                                            "An owlet moth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38138cd-9baa-4bed-adb3-55df9425e72a",
                                                "sense_id": "7f0be148-7318-32bb-8c44-3527bb837ab4",
                                                "text": "Noticeable features found in many of the owlets are two markings that often appear on the upper forewings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
