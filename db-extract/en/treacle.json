                        "entry_id": "31312337-d0bf-3078-a9f7-6d0777bbb06b",
                        "glosses": [
                            "A syrupy byproduct of sugar refining; molasses or golden syrup."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d159075-9c4f-4aa4-8dc2-486f587f352c",
                                "sense_id": "c398354a-9cd8-3c5b-bce5-9b41c5dcd53a",
                                "text": "Didn’t you see how the cub was ashamed of the thick bread-and-butter? I dare say they’re going to have treacle if they are good."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4a21662-23e0-3a2a-b9fd-e2cea80d0635",
                        "entry_id": "31312337-d0bf-3078-a9f7-6d0777bbb06b",
                        "glosses": [
                            "Cloying sentimental speech."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7efe85b2-9f17-42b7-b4ca-aca5667816e7",
                                "sense_id": "c4a21662-23e0-3a2a-b9fd-e2cea80d0635",
                                "text": "The public tributes to Griffith were over-the-top in a way his acting never was, spreading treacle from the evening newscasts to the front page of the New York Times."
                            }
                        ]
                    },
                    {
                        "sense_id": "795f4652-3d94-329d-8e81-f3121a1ddc36",
                        "entry_id": "31312337-d0bf-3078-a9f7-6d0777bbb06b",
                        "glosses": [
                            "Sweetheart (from treacle tart)."
                        ],
                        "tags": [
                            "Cockney",
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a43eac1-033c-4dee-9926-d68e86f37ec0",
                                "sense_id": "795f4652-3d94-329d-8e81-f3121a1ddc36",
                                "text": "Listen, treacle, this is the last time I'll warn you!"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ec99962-d3cf-3c19-9883-0b4eae141ad0",
                        "entry_id": "31312337-d0bf-3078-a9f7-6d0777bbb06b",
