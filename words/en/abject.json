    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9e98e4f9-07b6-3213-8580-03ba9e2b23d2",
                    "sense_definition": "Existing in a very low, miserable, or degraded state.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "miserable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family lived in <w>abject</w> poverty after losing their home and all their savings.",
                            "target_lang_translations": {
                                "ru": "Семья жила в <w>крайней</w> нищете после потери дома и всех своих сбережений."
                            }
                        },
                        {
                            "text": "He spent his final years in an <w>abject</w> condition, forgotten by his former friends.",
                            "target_lang_translations": {
                                "ru": "Он провёл свои последние годы в <w>жалком</w> состоянии, забытый бывшими друзьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "wretched",
                        "degraded",
                        "mean"
                    ],
                    "antonyms": [
                        "unabject"
                    ],
                    "common_phrases": [
                        "abject poverty",
                        "abject misery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в крайне бедственном, жалком или унизительном положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалкий",
                                "target_lang_sense_clarification": "вызывающий жалость, убогий"
                            },
                            {
                                "target_lang_word": "униженный",
                                "target_lang_sense_clarification": "лишенный достоинства, приниженный"
                            },
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "о бедности, нищете"
                            },
                            {
                                "target_lang_word": "беспросветный",
                                "target_lang_sense_clarification": "о нищете или горе"
