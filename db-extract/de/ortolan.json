                    {
                        "sense_id": "4659274c-5787-3261-a237-d0473e27b03b",
                        "entry_id": "cd0ab88c-e92f-3382-a473-421d204f965d",
                        "glosses": [
                            "Singvogelart aus der Gattung der Ammern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efc1461-4e2c-4ea7-8bec-f47fc499c9e6",
                                "sense_id": "4659274c-5787-3261-a237-d0473e27b03b",
                                "text": "Das Männchen des Ortolans hat eine gelbe Kehle und gelbe Augenringe."
                            },
                            {
                                "example_id": "571dff39-5266-4d36-9328-40086103071d",
                                "sense_id": "4659274c-5787-3261-a237-d0473e27b03b",
                                "text": "Der Ortolan hat eine zimtfarbene Unterseite mit gelber Kehle, einen rötlichen Schnabel und liebt es trocken und warm."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "780c72e5-fcc8-48e8-9892-105acd232d92",
                        "source_entry_id": "cd0ab88c-e92f-3382-a473-421d204f965d",
                        "source_sense_id": "4659274c-5787-3261-a237-d0473e27b03b",
                        "source_sense_description": "Ornithologie: Singvogelart aus der Gattung der Ammern",
                        "target_lang_word": "ortolan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ortolan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99d0e08c-4d1d-3f98-bd56-e03ace7a64b4",
                                        "entry_id": "a06afb47-53aa-3cfd-a1f6-e02e03ca6134",
                                        "glosses": [
                                            "A small European migratory bunting (Emberiza hortulana), once eaten whole as a delicacy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ecb4965-de3c-44c5-ae24-879c2ba7cad7",
                                                "sense_id": "99d0e08c-4d1d-3f98-bd56-e03ace7a64b4",
                                                "text": "[…]this taught him to consider Sophia as a most delicious morsel, indeed to regard her with the same desires which an ortolan inspires into the soul of an epicure."
                                            },
                                            {
                                                "example_id": "9a27799f-55a9-499e-8471-65ff206b0b6d",
                                                "sense_id": "99d0e08c-4d1d-3f98-bd56-e03ace7a64b4",
                                                "text": "[…]the last flavor Mitterrand wished to savor belonged to the flesh of the endangered ortolan, a songbird the size of a human toe that is a crime to buy or hunt, and is certainly illegal to eat. Mitterrand devoured it in the traditional manner, first covering his head with an embroidered cloth, then inserting the entire bird into his mouth.[…]Only its head should dangle out from between your lips. Bite off the head and discard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c37d58-0fe8-3d97-b4d1-ca40ea000b0d",
                                        "entry_id": "a06afb47-53aa-3cfd-a1f6-e02e03ca6134",
                                        "glosses": [
                                            "Any of various similar birds, especially the bobolink, sora, or snow bunting."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e7f5094-a324-3667-a000-e2e45f176a17",
                                        "entry_id": "a06afb47-53aa-3cfd-a1f6-e02e03ca6134",
                                        "glosses": [
                                            "The greater short-toed lark (Calandrella brachydactyla)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce8743bb-8863-4967-a7d9-8325d02b1247",
                        "source_entry_id": "cd0ab88c-e92f-3382-a473-421d204f965d",
                        "source_sense_id": "4659274c-5787-3261-a237-d0473e27b03b",
                        "source_sense_description": "Ornithologie: Singvogelart aus der Gattung der Ammern",
                        "target_lang_word": "bruant ortolan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruant ortolan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2d93a8-5272-3f47-b7be-e3cb862823bf",
                                        "entry_id": "35e8e32e-838f-38db-bd9b-ddd07b5e26b7",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau d’Eurasie, bruant dont le mâle a la tête et la poitrine verdâtres, la gorge jaune, le dessous rosâtre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5519b6cb-78e1-4fc7-b897-9b358e73bfc8",
                                                "sense_id": "bb2d93a8-5272-3f47-b7be-e3cb862823bf",
                                                "text": "La chair du bruant ortolan est recherchée."
                                            },
                                            {
                                                "example_id": "eaa6c19b-e5ba-4a93-a531-a22006d4e753",
                                                "sense_id": "bb2d93a8-5272-3f47-b7be-e3cb862823bf",
                                                "text": "Les milieux ouverts ne présentent pas qu’un intérêt paysager: ils abritent certaines espèces remarquables (notamment des oiseaux: outarde canepetière, chouette chevêche, vautour, bruant ortolan)."
                                            },
                                            {
                                                "example_id": "b7bad557-b55d-483c-9d31-962637653c85",
                                                "sense_id": "bb2d93a8-5272-3f47-b7be-e3cb862823bf",
                                                "text": "Certaines juridictions du sud-ouest de la France font preuve de la plus étrange indulgence envers les pratiquants de chasse traditionnelle restée illicite telle la capture des bruants ortolans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
