                "senses": [
                    {
                        "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                        "entry_id": "3c7c9326-2e88-3558-b5e0-661de3986b56",
                        "glosses": [
                            "durch das Gefrieren von Wasser entstandener durchsichtiger und natürlicher Kristall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf951a6-df2d-4d8d-9b84-1811a325df63",
                                "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                                "text": "Im Winter glitzern die Eiskristalle im Schnee."
                            },
                            {
                                "example_id": "111c0c38-6c2c-4db0-9f85-aa25a2bd4f81",
                                "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                                "text": "Wenn es sehr kalt ist, also unter null Grad, dann gefrieren die Wassertröpfchen in den Wolken zu Kristallen. Wenn sie nach unten fallen, verbinden sich immer mehr Eiskristalle zu Schneeflocken."
                            },
                            {
                                "example_id": "92971243-1d99-4dc3-94a7-65898fdf2a89",
                                "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                                "text": "Schneemänner kann man besonders gut aus Pappschnee bauen, weil der Schnee besser hält. Das liegt an den besonders kleinen Formen der Eiskristalle."
                            },
                            {
                                "example_id": "94af2a4f-4b59-46a2-9341-e8ea3299daa7",
                                "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                                "text": "Was Eis ist und was man mit Eis alles machen kann, weiß jedes Kind. Aber wer ahnt schon, dass die Wissenschaft zwischen 13 Formen von Eiskristallen unterscheidet?"
                            },
                            {
                                "example_id": "2bd70b01-7a02-4810-8088-6e858126eb0c",
                                "sense_id": "46122a93-da79-3db1-81d6-8f5120ad9524",
                                "text": "„Zu einem bestimmten Zeitpunkt nehmen Eiskristalle diese Form an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
