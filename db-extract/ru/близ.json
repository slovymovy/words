                                                "example_id": "2894e44d-7be0-41ad-91a7-6f6b31574036",
                                                "sense_id": "eb6d9e19-b788-38b0-bda2-37e734a94ab4",
                                                "text": "The ship nears the land."
                                            },
                                            {
                                                "example_id": "ec2b78a0-1a64-422c-b75a-9185fc92ad26",
                                                "sense_id": "eb6d9e19-b788-38b0-bda2-37e734a94ab4",
                                                "text": "We started back in the same conditions, and for part of the journey ran through semi-darkness, but the sun appeared once again as we neared London."
                                            },
                                            {
                                                "example_id": "3da62615-0cc8-494a-9a90-e95d23272c78",
                                                "sense_id": "eb6d9e19-b788-38b0-bda2-37e734a94ab4",
                                                "text": "As he neared a bridge over the East Coast Main Line near Great Heck, he lost control. His Land Rover left the carriageway and veered onto the hard shoulder before biting into the grass verge."
                                            }
                                        ]
                                    }
                                ]
