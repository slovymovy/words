                        "glosses": [
                            "Zustand in Bezug auf das Leistungsvermögen einer Person oder Mannschaft an einem bestimmten (Wettkampf)-Tag"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "31bf80cf-7dbc-4fd2-832d-c5a792b70b81",
                                "sense_id": "2fdfa019-cd67-3ab6-9464-37cc2684b73f",
                                "text": "„Das Play-off-System im Hockey ist gnadenlos. Da es kein Rückspiel gibt, reicht eine schlechte Tagesform, um die Arbeit einer ganzen Saison zunichte zu machen.“"
                            },
                            {
                                "example_id": "d415fba4-605a-43e3-95ae-57d2e089023d",
                                "sense_id": "2fdfa019-cd67-3ab6-9464-37cc2684b73f",
                                "text": "„Ein einziger IQ-Test kann nie sicher Intelligenz messen, schon allein deshalb nicht, weil das Ergebnis von der Tagesform abhängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
