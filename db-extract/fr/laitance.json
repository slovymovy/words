                                    {
                                        "sense_id": "106ac9cb-f1b4-36bb-a2af-37482f0b898a",
                                        "entry_id": "a8b653df-be91-3936-b002-5e9c157a60d1",
                                        "glosses": [
                                            "die reifen Eier von Fischen und anderen Wassertieren vor der Abgabe ins Wasser"
                                        ],
                                        "tags": [],
