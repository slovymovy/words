                        "examples": [
                            {
                                "example_id": "118f56c9-2c4e-4bc0-9ed0-507e49270921",
                                "sense_id": "8a0afea0-0806-33a0-8a7e-e46cd59a3de3",
                                "text": "⧖ Die gravinne trooste grave Kaerl op die woerden uutermaten wel, ende sprac: 'Heere grave, weest goetsmoets: ghi soudt tot Asch opter heiden leggen VII jaer, eer die coninck ymmermeer daer quame.",
                                "translation": "Na die woorden troostte gravin graaf Karel uitermate wel en zei: 'Heer graaf, wees welgemoed: je zou zeven jaar te Asch op de heide kunnen verblijven eer dat de koning daar ooit zou komen."
                            }
                        ]
                    }
