                    {
                        "translation_id": "0ff7cbf4-4796-48b7-94e0-417227e4e7b0",
                        "source_entry_id": "6e0c2f5a-9b5e-334e-9fb7-7cd509a75f16",
                        "source_sense_id": "158e629a-1693-3e51-8bbf-207bec4b428b",
                        "source_sense_description": "jemand, der mit Sklaven handelt",
                        "target_lang_word": "slaver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb1b08f-3282-3caa-90ab-ed944e2d3e83",
                                        "entry_id": "c80b1731-b0bb-3f02-9834-0cafacfb7d20",
                                        "glosses": [
                                            "To drool saliva from the mouth; to slobber."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56c8d5de-df45-3944-865f-23db848ecf70",
                                        "entry_id": "c80b1731-b0bb-3f02-9834-0cafacfb7d20",
                                        "glosses": [
                                            "To fawn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ceda2165-89c7-3e14-a415-1b55824b9d85",
                                        "entry_id": "c80b1731-b0bb-3f02-9834-0cafacfb7d20",
                                        "glosses": [
                                            "To be drooled out of someone’s mouth."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f920b5ba-8467-4a29-8f71-210f615f421c",
                                                "sense_id": "ceda2165-89c7-3e14-a415-1b55824b9d85",
                                                "text": "A fearsome sight it was to behold how he swelled in his wrath, and his eyes blazed like disastrous stars at midnight, and being wood with anger he gnashed his teeth till the froth stood at his lips and slavered down his chin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f14671e-1fbf-307c-88ed-6722f4894484",
                                        "entry_id": "c80b1731-b0bb-3f02-9834-0cafacfb7d20",
                                        "glosses": [
                                            "To smear with saliva issuing from the mouth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a836e0c4-27ac-3105-b5bc-5d04897f38ee",
                                        "entry_id": "c80b1731-b0bb-3f02-9834-0cafacfb7d20",
                                        "glosses": [
                                            "To be besmeared with saliva."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70acbbe8-2b2b-4597-b4a3-e079cc1dfd54",
                                                "sense_id": "a836e0c4-27ac-3105-b5bc-5d04897f38ee",
                                                "text": "should I, damn'd then, / Slaver with lips as common as the stairs / That mount the Capitol"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a19dc44b-c459-39ed-aba4-c971dcdb2996",
                                        "entry_id": "51bae6c2-7dc8-3d15-aaf3-1c07d5d6186d",
                                        "glosses": [
                                            "Saliva running from the mouth; drool."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfbcaae6-f835-494f-b4b4-09d4c29e65f3",
                                                "sense_id": "a19dc44b-c459-39ed-aba4-c971dcdb2996",
                                                "text": "Of all mad Creatures, if the Learn'd are right, / It is the Slaver kills, and not the Bite."
                                            },
                                            {
                                                "example_id": "ab4e4e7b-939b-4afb-be0a-7fb1f48d3dc3",
                                                "sense_id": "a19dc44b-c459-39ed-aba4-c971dcdb2996",
                                                "text": "He went over to it, held it in his hands awhile, feeling its coolness, smelling the clammy slaver of the lather in which the brush was stuck."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1711843d-113b-3145-8ad5-c96a1126ddc7",
                                        "entry_id": "0ba12fd7-043e-3cbe-842f-8503b428aa4b",
                                        "glosses": [
                                            "A person engaged in the slave trade; a person who buys, sells, transports, or owns slaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7548c7ec-e588-436d-9f22-6ee32a9b3d66",
                                                "sense_id": "1711843d-113b-3145-8ad5-c96a1126ddc7",
                                                "text": "The continued fight between abolitionists and slavers in Missouri caused slave owners to refuge slaves to the Confederate interior. But some Union forces that made salients into rebel territory insisted that the slaves were “contraband” […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c9421c-099a-3676-80f0-0d5d1b8a7838",
                                        "entry_id": "0ba12fd7-043e-3cbe-842f-8503b428aa4b",
                                        "glosses": [
                                            "A person engaged in the slave trade; a person who buys, sells, transports, or owns slaves.",
                                            "A white slaver; a person who sells prostitutes into sexual slavery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb35df3a-8ef2-3649-b627-3489375a01e9",
                                        "entry_id": "0ba12fd7-043e-3cbe-842f-8503b428aa4b",
                                        "glosses": [
                                            "A ship used to transport slaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18675945-8253-4b79-892d-d1c28671b058",
                                                "sense_id": "eb35df3a-8ef2-3649-b627-3489375a01e9",
                                                "text": "The Gulnare was a fast sailer, built for a slaver originally[.]"
                                            },
                                            {
                                                "example_id": "59fa290c-13f4-4a95-a401-a6c9d5f7b62b",
                                                "sense_id": "eb35df3a-8ef2-3649-b627-3489375a01e9",
                                                "text": "Somewhat unsurprisingly, unleashing the most powerful navy on the planet with carte blanche to exterminate slavers on sight saw a dramatic and sudden collapse in slaver numbers in the late 1840s and early 1850s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
