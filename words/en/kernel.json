{
    "word_family": [
        "kernelization",
        "kernelize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97db4384-d245-3e86-a975-268b36601f5c",
                    "sense_definition": "A single seed or grain, especially of corn or wheat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer examined a single <w>kernel</w> of corn to check if the crop was ready.",
                            "target_lang_translations": {
                                "ru": "Фермер осмотрел одно <w>зерно</w> кукурузы, чтобы проверить, готов ли урожай."
                            }
                        },
                        {
                            "text": "She carefully removed every corn <w>kernel</w> from the cob before cooking them.",
                            "target_lang_translations": {
                                "ru": "Она аккуратно очистила початок от каждого кукурузного <w>зёрнышка</w> перед тем, как их готовить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corn kernel",
                        "wheat kernel",
                        "popcorn kernel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное семя или зерно, особенно кукурузы или пшеницы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "семя злака"
                            },
                            {
                                "target_lang_word": "зёрнышко",
                                "target_lang_sense_clarification": "маленькое семя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a972b53-db80-3b48-ac60-d6164bd728df",
                    "sense_definition": "The central, usually edible part of a nut, found inside the hard shell.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After cracking the tough shell, he finally reached the delicious walnut <w>kernel</w> inside.",
                            "target_lang_translations": {
                                "ru": "Расколов твердую скорлупу, он наконец добрался до вкусного <w>ядра</w> грецкого ореха внутри."
                            }
                        },
                        {
                            "text": "The recipe requires you to crush the <w>kernel</w> into a fine paste.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется измельчить <w>ядро</w> в однородную пасту."
                            }
                        }
                    ],
                    "common_phrases": [
                        "walnut kernel",
                        "nut kernel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная, обычно съедобная часть ореха, находящаяся внутри твердой скорлупы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ядро",
                                "target_lang_sense_clarification": "внутренняя часть ореха"
                            },
                            {
                                "target_lang_word": "сердцевина",
                                "target_lang_sense_clarification": "центр плода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8d8172e-b0a7-3872-aa08-9ca8e627afec",
                    "sense_definition": "The core, center, or most essential part of an idea, argument, or system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "essence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>kernel</w> of truth in his otherwise exaggerated story.",
                            "target_lang_translations": {
                                "ru": "В его в остальном преувеличенном рассказе было <w>зерно</w> истины."
                            }
                        },
                        {
                            "text": "The <w>kernel</w> of the argument was that the policy failed to address poverty.",
                            "target_lang_translations": {
                                "ru": "<w>Суть</w> аргумента заключалась в том, что политика не смогла решить проблему бедности."
                            }
                        }
                    ],
                    "synonyms": [
                        "core",
                        "essence",
                        "gist",
                        "heart",
                        "nub",
                        "pith"
                    ],
                    "common_phrases": [
                        "kernel of truth",
                        "kernel of an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ядро, центр или самая существенная часть идеи, аргумента или системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суть",
                                "target_lang_sense_clarification": "самое существенное"
                            },
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "основа чего-либо"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "зачаток или основа идеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "535a4e8a-1c72-3f18-84dc-3ae1637a09a4",
                    "sense_definition": "The central part of a computer operating system that manages hardware and software communication.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Linux <w>kernel</w> is open-source and used by millions of developers worldwide.",
                            "target_lang_translations": {
                                "ru": "<w>Ядро</w> Linux имеет открытый исходный код и используется миллионами разработчиков по всему миру."
                            }
                        },
                        {
                            "text": "An error in the operating system <w>kernel</w> can cause the entire computer to crash.",
                            "target_lang_translations": {
                                "ru": "Ошибка в <w>ядре</w> операционной системы может привести к сбою всего компьютера."
                            }
                        }
                    ],
                    "antonyms": [
                        "userland"
                    ],
                    "common_phrases": [
                        "Linux kernel",
                        "operating system kernel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Центральная часть операционной системы компьютера, управляющая взаимодействием оборудования и программного обеспечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ядро",
                                "target_lang_sense_clarification": "основная программа ОС"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "106dcbfe-4982-3b72-a14e-92aa6fd05daf",
                    "sense_definition": "A mathematical function used to define an integral transform or in machine learning algorithms.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher applied a Gaussian <w>kernel</w> to smooth the data points in the set.",
                            "target_lang_translations": {
                                "ru": "Исследователь применил гауссово <w>ядро</w> для сглаживания точек данных в наборе."
                            }
                        },
                        {
                            "text": "In machine learning, the <w>kernel</w> trick allows for linear classifiers to solve non-linear problems.",
                            "target_lang_translations": {
                                "ru": "В машинном обучении метод <w>ядер</w> позволяет линейным классификаторам решать нелинейные задачи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Gaussian kernel",
                        "integral kernel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическая функция, используемая для определения интегрального преобразования или в алгоритмах машинного обучения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ядро",
                                "target_lang_sense_clarification": "математическая функция или множество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e91cbdfc-4056-34fa-8d62-56e932897810",
                    "sense_definition": "To enclose something within a <w>kernel</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The process will <w>kernel</w> the delicate seeds to protect them from the harsh environment.",
                            "target_lang_translations": {
                                "ru": "Этот процесс <w>заключит в оболочку</w> нежные семена, чтобы защитить их от суровой окружающей среды."
                            }
                        },
                        {
                            "text": "Nature has a way to <w>kernel</w> life within protective layers during the winter.",
                            "target_lang_translations": {
                                "ru": "Природа умеет <w>скрывать</w> жизнь внутри защитных слоев в зимний период."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключать что-либо внутри ядра или защитной оболочки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключать в оболочку",
                                "target_lang_sense_clarification": "помещать внутрь ядра"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}