                        "cross_references": [
                            {
                                "target_word": "gilet jaune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b3a7323-d92f-3cec-b2ce-66bb9b7f6e30",
                                        "entry_id": "de0e2d06-c5e6-3a2d-818b-a9e1096c3239",
                                        "glosses": [
                                            "Vêtement (chasuble) de haute visibilité de couleur jaune habituellement muni de bandes rétroréfléchissantes destiné à améliorer la visibilité du porteur notamment dans l'obscurité et en situation dangereuse (chaussée, chantier, engins lourds)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e032b73c-56a7-46f3-9709-8661bd870d10",
                                                "sense_id": "9b3a7323-d92f-3cec-b2ce-66bb9b7f6e30",
                                                "text": "Depuis le 1ᵉʳ janvier de cette année le gilet jaune est donc obligatoire pour les motards, comme pour les automobilistes, mais les modalités d’application de cette nouvelle règle sont encore un peu confuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5183d3c5-b9ff-3b00-a78a-a5411282666b",
                                        "entry_id": "de0e2d06-c5e6-3a2d-818b-a9e1096c3239",
                                        "glosses": [
                                            "Patrouilleur autoroutier muni de ce vêtement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dba4779-b136-49d8-8874-308501cb51f0",
                                                "sense_id": "5183d3c5-b9ff-3b00-a78a-a5411282666b",
                                                "text": "Pour limiter les risques de collision, l’application Waze signale dorénavant aux automobilistes les gilets jaunes en intervention sur l’autoroute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gilet jaune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e59581e-a512-3b68-b196-992c13284650",
                                        "entry_id": "a2234c3e-8ef8-35ca-a443-72d2afa7cc1c",
                                        "glosses": [
                                            "Membre du mouvement de contestation apparu en 2018 initialement dû à la hausse des prix du carburant causée par le projet de taxe carbone ; le mouvement utilisant le gilet (sens premier) comme symbole."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a372ac-223c-4db9-a805-a4bbb802d1b1",
                                                "sense_id": "0e59581e-a512-3b68-b196-992c13284650",
                                                "text": "C’est grâce à une étude menée par Elabe pour l’Institut Montaigne que l’on peut préciser plus clairement le profil type d’un(e) gilet jaune."
                                            },
                                            {
                                                "example_id": "76f4cdb9-e4b8-4f58-adf3-87722200e4e2",
                                                "sense_id": "0e59581e-a512-3b68-b196-992c13284650",
                                                "text": "Un gilet jaune est interpellé par des policiers lors de la manifestation du 8 décembre à Paris."
                                            },
                                            {
                                                "example_id": "91b4f02f-a2ec-4d0c-bc1e-af71c81685e1",
                                                "sense_id": "0e59581e-a512-3b68-b196-992c13284650",
                                                "text": "Qu’entendre par une notion aussi floue qu’« absolue nécessité » sachant que dans les enquêtes visant des écologistes, les militants, les gilets jaunes et plus généralement tout opposant politique, cela fait déjà longtemps que les moyens de l’antiterrorisme sont appliqués ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
