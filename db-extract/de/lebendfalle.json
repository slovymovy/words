                "senses": [
                    {
                        "sense_id": "2fe9afad-be04-3499-8571-409de8a576fc",
                        "entry_id": "b72d177b-0391-395e-861d-c2a8c5eb8c42",
                        "glosses": [
                            "Vorrichtung zum Fangen bestimmter Tiere, mit der sie nicht getötet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0de4b7-0de0-4550-af39-5951eac987a8",
                                "sense_id": "2fe9afad-be04-3499-8571-409de8a576fc",
                                "text": "„Wir haben uns damals eine große Lebendfalle angeschafft, mit deren Hilfe wir bereits 2 Steinmarder fingen.“"
                            },
                            {
                                "example_id": "5488e2fb-f68b-40c5-bad9-e487f8d64174",
                                "sense_id": "2fe9afad-be04-3499-8571-409de8a576fc",
                                "text": "„Aus diesen Sachen baute ich eine Lebendfalle und legte dort das Getreide hinein.“"
                            },
                            {
                                "example_id": "81f2f679-074c-4f02-b780-df20bae62a0b",
                                "sense_id": "2fe9afad-be04-3499-8571-409de8a576fc",
                                "text": "„Haben sich Hunde und Katzen in Lebendfallen gefangen, sind sie in den meisten Bundesländern als Fundsache zu behandeln.“"
                            }
                        ],
