                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00929d9e-f8ff-491b-8369-9fa27a3fb07b",
                                                "sense_id": "d94ded60-0623-397d-999e-ba086e899962",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22fe3a45-5354-34f7-822c-596a91584f82",
                                        "entry_id": "227ee030-8d19-373e-b516-a98a490319a9",
                                        "glosses": [
                                            "A break in play between the first and second sessions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baaa2a15-bf37-3466-bed1-c30570d4c734",
                                        "entry_id": "227ee030-8d19-373e-b516-a98a490319a9",
                                        "glosses": [
                                            "Any small meal, especially one eaten at a social gathering."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b44513-81b2-41c4-ad76-bc9f0f07090e",
                                                "sense_id": "baaa2a15-bf37-3466-bed1-c30570d4c734",
                                                "text": "After the funeral there was a lunch for those who didn't go to the cemetery."
                                            },
                                            {
                                                "example_id": "574eaa08-e4e3-4379-a778-4b867d12d804",
                                                "sense_id": "baaa2a15-bf37-3466-bed1-c30570d4c734",
                                                "text": "“Oh, you mustn’t dream of going home without your tea,” cried Anne in distress. “I’ll get it right off—I’ll go and put the tea down this very minute.” “I must go home,” repeated Diana, stupidly but determinedly. “Let me get you a lunch anyhow,” implored Anne. “Let me give you a bit of fruit-cake and some of the cherry preserves. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61fb3a3c-3128-34b2-a6e8-3d0ad89eeedd",
                                        "entry_id": "227ee030-8d19-373e-b516-a98a490319a9",
                                        "glosses": [
                                            "A thin piece or hunk (of bread, meat, etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5beee17e-678c-31b6-b976-d3553373dcbc",
                                        "entry_id": "39c3bc31-607e-3322-84fe-ea6feabfa46d",
                                        "glosses": [
                                            "To eat lunch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23586b51-3b58-40d0-9e0c-addf57e208ec",
                                                "sense_id": "5beee17e-678c-31b6-b976-d3553373dcbc",
                                                "text": "I like to lunch in Italian restaurants."
                                            },
                                            {
                                                "example_id": "e5ee2860-49b4-485e-8bdd-5dd6bc8f2268",
                                                "sense_id": "5beee17e-678c-31b6-b976-d3553373dcbc",
                                                "text": "The gentleman had left for London after lunch. Yes, alone; but he had lunched in the hotel with a lady."
                                            },
                                            {
                                                "example_id": "974f549e-249b-4b53-8d8b-a974726d096f",
                                                "sense_id": "5beee17e-678c-31b6-b976-d3553373dcbc",
                                                "text": "Miss Otis regrets she's unable to lunch today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e2d5933-b935-362b-b17d-fc7f1273399b",
                                        "entry_id": "39c3bc31-607e-3322-84fe-ea6feabfa46d",
                                        "glosses": [
                                            "To treat to lunch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701a4d58-2b9c-4cd5-a4d7-50e8a7106083",
                                                "sense_id": "0e2d5933-b935-362b-b17d-fc7f1273399b",
                                                "text": "We dined him, we lunched him, we were photographed in his company by flashlight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "976d9943-e610-4535-87cf-97e7029e1bf3",
                        "source_entry_id": "b723a5c4-df13-39a2-a397-0b3661562f15",
                        "source_sense_id": "ae4d1373-c199-3f22-98d2-962a0aaef272",
                        "source_sense_description": "het middageten",
                        "target_lang_word": "luncheon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luncheon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                                        "glosses": [
                                            "A formal meal served in the middle of the day."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d727ecb-cecc-4fd3-b8c6-d02c40bdefe3",
                                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                                "text": "Now that she had rested and had fed from the luncheon tray Mrs. Broome had just removed, she had reverted to her normal gaiety. She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            },
                                            {
                                                "example_id": "be63fc12-3ee0-4729-807f-7e92b51983bb",
                                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                                "text": "Superintendent Chalmers: Well, Seymour, I made it — despite your directions.\nPrincipal Skinner: Ahhh, Superintendent Chalmers! Welcome! I hope you're prepared for an unforgettable luncheon."
                                            },
                                            {
                                                "example_id": "44451d72-934c-4b63-a244-e690b7c99fe9",
                                                "sense_id": "6a4189a9-2282-3951-8173-c5bac7abecdc",
                                                "text": "Most people thought the food at the luncheon was mediocre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                                        "glosses": [
                                            "A large, cheap, processed sausage served in thin slices."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1897ed4c-d555-4f66-9d2f-2e1063c4664f",
                                                "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                                                "text": "Filled Roll (x2) 1x luncheon, tomato, lettuce, and mayonnaise / 1x cheese and onion"
                                            },
                                            {
                                                "example_id": "c8213e62-d477-4ae9-9055-412d9f464518",
                                                "sense_id": "29c09bf8-2f21-3549-ad82-4245571d146f",
                                                "text": "Ian bought the luncheon since it was on special."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                                        "glosses": [
                                            "Any midday meal; lunch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f3ed077-7409-4bae-810d-ac55bcaf0d83",
                                                "sense_id": "026e759f-a445-345d-a129-def33852aad6",
                                                "text": "Have you had luncheon?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e64e808f-f92e-3c78-a28a-2d7b6c5b1535",
                                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                                        "glosses": [
                                            "A lump of food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f5ebbf0-e16d-329f-a749-de6c9bfcda40",
                                        "entry_id": "ef391354-4e7e-3d0f-bbf3-bc12eb910877",
                                        "glosses": [
                                            "A portion of food taken at any time except at a regular meal; an informal or light repast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72116f8f-d06a-4b27-9bed-b5587bc1da60",
                                                "sense_id": "5f5ebbf0-e16d-329f-a749-de6c9bfcda40",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luncheon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9960b889-f1ce-3612-a67a-e5b3a74c6c13",
                                        "entry_id": "e22158de-f9c0-338a-9fbf-794a5006beb1",
                                        "glosses": [
                                            "To eat luncheon."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "888b18ff-f686-4919-8318-036adb54c7ed",
                                                "sense_id": "9960b889-f1ce-3612-a67a-e5b3a74c6c13",
                                                "text": "In the meantime, while ladies are luncheoning on chicken pie, or coursing in whirling britskas, performing all the singular ceremonies of a London morning in the heart of the season[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                        "entry_id": "e22158de-f9c0-338a-9fbf-794a5006beb1",
                                        "glosses": [
                                            "To serve luncheon to."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcae31c9-0bbe-4a7b-b090-30e38ab08acd",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "Towns welcomed us in our hundreds; M.P.’s luncheoned us, manufacturers turned out their warehouses, decorated them and feasted us; private families tea’d us on their lawns, but we were so true to our art that we always returned to—“papers!”"
                                            },
                                            {
                                                "example_id": "e8891182-73a2-497f-91da-78c8c9f5044f",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "This gentleman was presented by Colonel C. E. S. Wood, and was entertained here—wined, dined, tead, breakfasted, coffeed and luncheoned—and we bought his pictures."
                                            },
                                            {
                                                "example_id": "c7044e40-8034-43e4-b018-83a72f506b13",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "[…] entertained him at the Bohemian Club; Edward D. Kneass, Jr., ’18, extended to him the greeting of the San Francisco Press Club; and Frank J. Taylor, ’18, luncheoned him at the Honolulu Club."
                                            },
                                            {
                                                "example_id": "0916677b-a126-429c-89d9-6f537fbd039c",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "A number of friends of Mrs. H. M. Richey, wife of H. M., luncheoned her on Thursday at the Warden Hotel."
                                            },
                                            {
                                                "example_id": "325c9b4a-d8bd-42f6-9d2a-e4bb899c8b3d",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "To soften him up, a group of his fellows luncheoned him at the Jonathan Club in Los Angeles."
                                            },
                                            {
                                                "example_id": "ff8ece66-482f-428f-8d0f-7e5668764a1f",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "Mrs. Harry (Sybil) Brand farewell-luncheoned her New York friends Monday (21), before taking off for Paris with John Haskell, representing TWA, on month’s vacation, first time over."
                                            },
                                            {
                                                "example_id": "0066949c-67cc-4093-b768-3c932a38821b",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "We won’t try to lie to you for, bro-ther! until that recent noon when Don Fernando Carlés, Number 1 at National City Bank in Buenos Aires, luncheoned us at this fantastic Jockey Club—and invitations to this fantastic block-square brownstone Mansion in Calle Florída are nothing to view lightly—we could take our sting-rays or leave ’em alone."
                                            },
                                            {
                                                "example_id": "630d9712-7c85-45d0-9bda-a6678a73266e",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "The Legal Department's Richard Colby went off to other pastures, so early this month his associates luncheoned him at Rosoff's, and in the tradition of the profession, all remarks were off the record."
                                            },
                                            {
                                                "example_id": "59fc8651-02d8-4743-831e-3a6243d8de80",
                                                "sense_id": "81d56bb7-c79a-3e93-983b-1b3df7b92497",
                                                "text": "There must have been a chip of the blarney stone in the Irish stew the pretty stewardess luncheoned us with, for one quipped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63a8a2a5-835c-4f60-86f9-130479d0caee",
                        "source_entry_id": "b723a5c4-df13-39a2-a397-0b3661562f15",
