    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "acb3a39d-3ee2-350d-814a-ae5290b523e3",
                    "sense_definition": "Toucher ou palper délicatement quelque chose avec la main pour en apprécier la texture, la température ou l'état.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin s'est penché pour <w>tâter</w> le pouls de son patient inquiet."
                        },
                        {
                            "text": "Elle a voulu <w>tâter</w> le tissu pour vérifier s'il était doux et épais."
                        }
                    ],
                    "common_phrases": [
                        "tâter le pouls"
                    ]
                },
                {
                    "sense_id": "8cc17f5b-911c-35d3-8429-74cc8866f712",
                    "sense_definition": "Chercher à découvrir prudemment les sentiments, les intentions ou les dispositions d'une personne ou d'un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de lancer le projet, nous devons d'abord <w>tâter</w> le terrain auprès des investisseurs."
                        },
                        {
                            "text": "Il a prudemment <w>tâté</w> les intentions de son directeur sur cette affaire délicate."
                        }
                    ],
                    "common_phrases": [
                        "tâter le terrain"
                    ]
                },
                {
                    "sense_id": "ded331ad-0ad0-3f5d-b19e-03d4428c5e70",
                    "sense_definition": "Faire l'expérience directe d'une situation ou s'essayer à une activité (construit avec « de »).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experimenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au cours de sa jeunesse aventureuse, il a <w>tâté</w> de plusieurs métiers différents."
                        },
                        {
                            "text": "Ce jeune ingénieur aimerait bien <w>tâter</w> de la recherche scientifique dans un laboratoire."
                        }
                    ],
                    "synonyms": [
                        "essayer de"
                    ],
                    "common_phrases": [
                        "tâter de plusieurs métiers"
                    ]
                },
                {
                    "sense_id": "84e1bfa0-9dbe-3c20-9efe-dbd29762bd32",
                    "sense_definition": "S'interroger intérieurement et hésiter avant de prendre une décision ferme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesiter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'accepter cette proposition d'embauche, je me <w>tâte</w> encore beaucoup."
                        },
                        {
                            "text": "Ils se <w>tâtent</w> depuis des semaines avant de prendre une décision finale."
                        }
                    ],
                    "common_phrases": [
                        "se tâter longuement"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi pronominal familier pour exprimer l'hésitation"
                        }
                    ]
                },
                {
                    "sense_id": "6284def1-51ae-32e6-b530-f7ed57f6abf3",
                    "sense_definition": "Goûter un aliment ou une boisson afin d'en connaître la saveur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gouter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le convive a accepté avec plaisir de <w>tâter</w> de cette excellente tourte régionale."
                        },
                        {
                            "text": "Voudriez-vous <w>tâter</w> du vin que notre hôte a apporté de sa cave ?"
                        }
                    ],
                    "common_phrases": [
                        "tâter du vin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vieilli dans le sens de goûter à une nourriture"
                        }
                    ]
                }
            ]
        }
    ]
}