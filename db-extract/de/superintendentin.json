                                    {
                                        "sense_id": "6d891014-95be-3277-9994-d2314c5c2e92",
                                        "entry_id": "451d61cf-6e3e-3134-bbcd-665ca8d8f277",
                                        "glosses": [
                                            "Femme responsable de l’administration d’une maison princière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d454c36-f951-42df-85f9-8da202ac2248",
                                                "sense_id": "6d891014-95be-3277-9994-d2314c5c2e92",
                                                "text": "Le cardinal Mazarin, qui fit tout pour que le comte de Soissons ne se trouvât pas mal marié à sa nièce, venoit d’inventer pour elle la charge jusqu’alors inconnue de surintendante de la maison de la reine, et pour conserver toute préférence à la reine mère avec laquelle il avoit toujours été si uni, à qui il devoit tout, et que le roi respectoit si fort, il fit en même temps la princesse de Conti, son autre nièce, surintendante de sa maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db78aa60-4146-3335-b611-6a1a8d0b7427",
                                        "entry_id": "451d61cf-6e3e-3134-bbcd-665ca8d8f277",
                                        "glosses": [
                                            "Directrice d’une maison d’éducation de la Légion d’honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf67d61-f1b1-4ae2-a726-ccea7019b997",
                                                "sense_id": "db78aa60-4146-3335-b611-6a1a8d0b7427",
                                                "text": "Nommée par décret du Président de la République sur proposition du grand chancelier, Madame Sophie Maraux a pris ce 1ᵉʳ septembre 2021 ses fonctions de surintendante des maisons d’éducation de la Légion d’honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f9908e0-cb1b-3545-952f-acfb5f18d042",
                                        "entry_id": "451d61cf-6e3e-3134-bbcd-665ca8d8f277",
                                        "glosses": [
                                            "Épouse d’un surintendant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a5346ab-5720-4be0-9142-0109a6de7b6c",
                                                "sense_id": "3f9908e0-cb1b-3545-952f-acfb5f18d042",
                                                "text": "Elles furent reçues par madame la surintendante, et, au moment où elles apparaissaient, une lumière vive, comme celle du jour, jaillit de tous les arbres, de tous les vases, de tous les marbres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
