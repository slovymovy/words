                        "glosses": [
                            "persoon die slecht voor één enkele keer de rol heeft van aanvoerder van een sportteam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2550e49-d65d-427f-8956-afa26c2d4260",
                                "sense_id": "ba7a7b50-ade8-3c88-92d0-61c610e19d4c",
                                "text": "\"We hebben het gevoel dat er veel meer had ingezeten\", aldus PSV-keeper en gelegenheidsaanvoerder Jeroen Zoet. \"We geven de wedstrijd in twintig minuten weg. Het is doodzonde. Het mag nooit gebeuren dat je zo ver achter komt te staan.\""
                            },
                            {
                                "example_id": "aa39e1a6-c11e-446f-a024-1009392c8694",
                                "sense_id": "ba7a7b50-ade8-3c88-92d0-61c610e19d4c",
                                "text": "Alle grote sterren van Barcelona kregen rust van trainer Luis Enrique, onder wie Lionel Messi, Luis Suárez, Neymar en Andres Iniesta. Hun vervangers namen het vlekkeloos over. De goals kwamen op naam van Jérémy Mathieu, Sergi Roberto, gelegenheidsaanvoerder Pedro en Adriano Correia."
                            },
                            {
                                "example_id": "390ebb5b-d380-42de-8406-6a6d23c2fe00",
                                "sense_id": "ba7a7b50-ade8-3c88-92d0-61c610e19d4c",
                                "text": "Geen Vincent Kompany en geen Thomas Vermaelen, dus was Vertonghen in de laatste groepswedstrijd tegen Zuid-Korea gelegenheidsaanvoerder. In de 77ste minuut reageerde hij alert op een schot van Divock Origi dat in eerste instantie gekeerd werd door de Koreaanse doelman. Met die 1-0 kroonde de Vertonghen zich ook meteen tot matchwinner."
                            }
                        ]
                    }
