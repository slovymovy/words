                "senses": [
                    {
                        "sense_id": "60ea2518-1a6e-32c6-ac32-fa6b11f45e50",
                        "entry_id": "39b52d8f-e0f4-3efa-8a65-6c16eb94afa8",
                        "glosses": [
                            "Donner un caractère pessimiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c921e156-5a70-45fe-b77f-14c93a894fee",
                                "sense_id": "60ea2518-1a6e-32c6-ac32-fa6b11f45e50",
                                "text": "C'est pas pour te \"pessimistiser\" mais même si tu levais la sanction, il faut bien te dire que tu gagnerais juste le droit de jouer dans la même cour que les autres"
                            }
                        ]
                    },
                    {
                        "sense_id": "e50d7f1f-8446-3e45-96db-ee2e00d51248",
                        "entry_id": "39b52d8f-e0f4-3efa-8a65-6c16eb94afa8",
                        "glosses": [
                            "Se montrer pessimiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba534ae6-8c24-4fe2-8483-08ef26875321",
                                "sense_id": "e50d7f1f-8446-3e45-96db-ee2e00d51248",
                                "text": "T'as fait une recherche des topics qu'il a postés avant de pessimistiser ?"
                            },
                            {
                                "example_id": "a3e60613-7250-480e-8823-ae4eab87cb5e",
                                "sense_id": "e50d7f1f-8446-3e45-96db-ee2e00d51248",
                                "text": "Et puis les prévisions sont d'une part que des prévisions et d'autre part il n'y a pas de quoi pessimistiser!"
                            }
                        ]
                    }
