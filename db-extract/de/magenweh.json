                    }
                ],
                "senses": [
                    {
                        "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                        "entry_id": "663638cf-d70c-3c41-97f0-693f966114c2",
                        "glosses": [
                            "Schmerzgefühl im Bereich des Magens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f752f45e-99b9-4c6e-8357-52fa2357c73f",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Mir ist schwindlig und furchtbar schlecht und ich hab Magenweh.“"
                            },
                            {
                                "example_id": "ab9c13ee-7f49-41fe-874c-ade63b77ffbc",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Ich fühlte den ganzen Tag sehr unwohl, habe seit einigen Tagen wieder immer Magenweh.“"
                            },
                            {
                                "example_id": "e6bb4296-31a9-4e49-9a91-58e1e6fcf2fa",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Ausserdem finden sich bei ihm Mittel gegen Magenweh, Peripneumonie, Phrenesie, Bräune, Darmzwang, Epilepsie, Podagra, Halsstarre.“"
                            },
                            {
                                "example_id": "4f6e498c-6083-459f-aa31-66fe236cfe5a",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Magenweh oder Magenkrampf ist ein so häufig vorkommendes Uebel, dass es nöthig ist, die verschiedenen Arten von Magenweh und Magenbeschwerden etwas eingehender zu behandeln.“"
                            },
                            {
                                "example_id": "d1d2f100-6915-4ced-ac30-a12af9ee8ee7",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Das Magenweh beunruhiget ihn noch, nicht aber wie zuvor; doch seit einigen Tagen leidet er an Kopfweh.“"
                            },
                            {
                                "example_id": "e16baf4f-41c9-4804-9c25-f21707fa467c",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Sie bekämpfen erfolgreich Hautausschlag, Magenweh und Geschwüre und tragen sogar gegen Infektionskrankheiten den Sieg davon.“"
                            },
                            {
                                "example_id": "8bc0652d-a423-46a4-9877-09f9a49d3edb",
                                "sense_id": "198ec835-0341-3d3a-a2a7-896a3435fff9",
                                "text": "„Frau Ziehm, ich verschreibe Ihnen ein Medikament, das nehmen sie zeitlebens und sie werden nie mehr Magenweh kriegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
