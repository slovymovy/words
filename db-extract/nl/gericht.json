            {
                "entry_id": "71b1c9d9-4858-349f-8145-8b543e1c5b26",
                "word": "gericht",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                        "entry_id": "71b1c9d9-4858-349f-8145-8b543e1c5b26",
                        "glosses": [
                            "voltooid deelwoord van richten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4caf5620-7c73-43e3-8ec6-167b60498752",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Heb je wel eens een geweer op iemand gericht?"
                            },
                            {
                                "example_id": "a9a6e1ad-c6bc-4beb-b440-63ead2ae5d9d",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Meteen zijn alle blikken op mij gericht."
                            },
                            {
                                "example_id": "063661e9-1bc5-49d5-8c2b-805982d98588",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "De Chinese autofabrikanten weten auto's op de markt te krijgen met een vaak hogere actieradius tegen een voordeligere prijs dan de Europese concurrenten. \"De innovaties waar Tesla zich de afgelopen tijd op heeft gericht zijn bijvoorbeeld robotisering en zelfrijdende auto's, maar dat is voor Europa voorlopig nog niet zo interessant\", zegt Luman."
                            },
                            {
                                "example_id": "3058c995-f475-48d7-b762-3ed865a5284e",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "' 'Bedoel je een massage?' 'Zo zou je het kunnen noemen. Maar dan zachter. Niet erop gericht om spieren los te maken. Gewoon om eens te voelen wat er te voelen valt ' Omdat ze aarzelt, zeg ik: 'Het hoeft niet, natuurlijk."
                            },
                            {
                                "example_id": "5d626a47-0305-47dc-9e8b-aa0c211bc5a0",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Alle sollicitaties kunnen gericht worden aan het volgende adres."
                            },
                            {
                                "example_id": "647f8ea2-e76d-4879-9c7c-cae22f09ea9e",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Alle ogen zijn op hem gericht."
                            },
                            {
                                "example_id": "786d385c-2a38-447e-9e89-d218fcd6bcdb",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Het was een gerichte aanval op het leiderschap van het land."
                            },
                            {
                                "example_id": "ee0cdcdc-cd00-4c71-b138-88e610c404d1",
                                "sense_id": "b98a12d0-8604-37ea-9a31-21abf1a94d42",
                                "text": "Een sollicitatiebrief, gericht aan het dagelijks bestuur, zien wij graag uiterlijk 10 dagen na het verschijnen van dit blad in de brievenbus."
                            }
                        ]
                    }
                ],
