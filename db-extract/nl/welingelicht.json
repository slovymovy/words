                                "target_senses": [
                                    {
                                        "sense_id": "89898f4e-0f10-3580-af9f-94d3c6ec48c9",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Side by side and facing forward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5be163-7fde-44ed-88a1-d63afe4dbeaf",
                                                "sense_id": "89898f4e-0f10-3580-af9f-94d3c6ec48c9",
                                                "text": "On Sunday afternoon it was as dark as night, with barely room for two riders abreast on a gradient that touches 20%."
                                            },
                                            {
                                                "example_id": "727ec4e3-bd81-41a7-80d8-9fba2babb432",
                                                "sense_id": "89898f4e-0f10-3580-af9f-94d3c6ec48c9",
                                                "text": "The only path was narrow and rugged: two men could hardly walk abreast;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b318bad-b4cf-3d02-857b-0af82e646936",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Alongside; parallel to."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "984f7ab1-863a-377d-863e-8cd016689c09",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Informed, well-informed, familiar, acquainted."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54c66cc5-a303-371e-8a22-a14ff800fc6d",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Followed by of or with: up to a certain level or line; equally advanced."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b21e6144-8c03-41df-af30-486f30d58558",
                                                "sense_id": "54c66cc5-a303-371e-8a22-a14ff800fc6d",
                                                "text": "She believes it is important to keep abreast of new scientific developments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6271d6e1-356e-3d63-8a29-c2ca3f7d4c9b",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Breast high (of an advancing wave)."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed0994b-3247-4baa-ad67-9274d4bbfb2a",
                                                "sense_id": "6271d6e1-356e-3d63-8a29-c2ca3f7d4c9b",
                                                "text": "The west wind blew a tempest, and, according to the common expression, brought in the water [of the Solway] three foot abreast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4262c4be-de4f-3ff8-8121-71624b96f3b8",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "Side by side; also, opposite; on a line with the vessel's beam."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c01eff-b395-3b5a-a0b0-10807b1d1143",
                                        "entry_id": "c72049a3-915a-337b-89aa-77b95bb8ed7c",
                                        "glosses": [
                                            "At the same time; simultaneously."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d6715f-7805-421d-bb7a-7246d6737420",
                                                "sense_id": "04c01eff-b395-3b5a-a0b0-10807b1d1143",
                                                "text": "Abreast therewith began a convocation."
                                            }
                                        ]
                                    }
                                ]
                            },
