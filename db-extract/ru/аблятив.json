                "senses": [
                    {
                        "sense_id": "bba5352f-c5eb-3f51-9e1c-5e8b260b0fa8",
                        "entry_id": "b0ae1ea0-08f6-33ce-8857-d22b86de4826",
                        "glosses": [
                            "лингв. то же, что аблатив; название падежа в некоторых языках, по значению сходного с родительным или с творительным падежами в русском языке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e0cc9f-dba5-47d5-9f93-9b8b93235d4c",
                                "sense_id": "bba5352f-c5eb-3f51-9e1c-5e8b260b0fa8",
                                "text": "Для грамотного написания рецептов необходимо усвоить окончания двух падежей — винительного и так называемого аблятива — в пяти склонениях существительных и прилагательных I, II и III склонений."
                            }
                        ]
                    }
