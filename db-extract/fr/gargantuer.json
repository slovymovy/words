                        "glosses": [
                            "Manger à la manière de Gargantua (des quantités énormes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13f331c-ba9d-419b-be82-802219714804",
                                "sense_id": "32dbf989-8bae-35c1-bd3b-3bddcaef340b",
                                "text": "On n’a pas arrêté de rabelaiser en Rabelaisie, on a gargantué comme des fous, on a panurgé en long et en large, on a pantagruélé partout où on pouvait."
                            },
                            {
                                "example_id": "945acd1b-3a47-4ac1-8910-f352661e292f",
                                "sense_id": "32dbf989-8bae-35c1-bd3b-3bddcaef340b",
                                "text": "Ils vous gargantuaient de ces cuisses, de ces épaules, de ces chaudrons de tripes, avec des doigts et des gosiers d’amiante !"
                            },
                            {
                                "example_id": "98e0fbcd-d20d-40b4-9ae1-569bd480c2a9",
                                "sense_id": "32dbf989-8bae-35c1-bd3b-3bddcaef340b",
                                "text": "L’autre dimanche, spectacle dans la salle : familles venues gargantuer, gentlemen-tireurs et leurs \"gibiers de poche\" du week-end, chasseurs sub-apoplectiques."
                            }
                        ]
                    }
