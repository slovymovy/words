                                "example_id": "9a7c93bd-a33f-4154-a950-1742459c052a",
                                "sense_id": "d9fb0c29-5f97-3aeb-8dd0-53081142d9ed",
                                "text": "1665, Gideon Harvey, A Discourse of the Plague, London: Nath. Brooke, Distinction 12, p. 15,\nNeither, as we may universally observe, is the Plague more shie in attaquing those that are armed with the said Antipestilentials, than others that slight all Preservatives."
                            },
                            {
                                "example_id": "ceeb8335-4763-449a-aff4-da125da47133",
                                "sense_id": "d9fb0c29-5f97-3aeb-8dd0-53081142d9ed",
                                "text": "The electuary, which was formerly in high repute as an antipestilential, has been replaced, in English pharmacy, by the Electuarium catechu."
                            }
                        ]
