                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9309bf77-3904-4e58-97c2-74d664684cac",
                                "sense_id": "ff9ff04e-e209-34b5-96c1-55c992085db8",
                                "text": "„Rudolf Harbig, der erst vor fünf Tagen einen deutschen Rekord im 1000 m-Lauf aufgestellt hat, verbessert bei einem Abendsportfest in Dresden den Weltrekord über diese Distanz um 2,1 Sekunden auf 2:21,5 min.“"
                            },
                            {
                                "example_id": "2d7a090b-e7c7-4541-9d05-377bc0ffe7b3",
                                "sense_id": "ff9ff04e-e209-34b5-96c1-55c992085db8",
                                "text": "„Beim Abendsportfest des SC Charlottenburg in Berlin siegt über 5000 m Paavo Nurmi (Finnland) in 14:47,6 min.“"
                            },
                            {
                                "example_id": "7a2fed4c-bd74-4285-b006-2aece6cf7f3f",
                                "sense_id": "ff9ff04e-e209-34b5-96c1-55c992085db8",
                                "text": "„Bei einem Abendsportfest in Dormagen überzeugte der Zehnkampf-Olympiazweite aus Dortmund mit persönlicher Bestleistung von 5,05 m im Stabhochsprung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
