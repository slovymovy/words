                ],
                "senses": [
                    {
                        "sense_id": "4e7912c7-eec1-3bd6-993b-471d92c6b1f3",
                        "entry_id": "91f16344-8215-3713-a4dc-ef7b6a2012ef",
                        "glosses": [
                            "mit Stuck verziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c00dcaf8-bd10-4a21-94de-2f586225fced",
                                "sense_id": "4e7912c7-eec1-3bd6-993b-471d92c6b1f3",
                                "text": "„Ich sitze in der Falle, schaue zur stuckverzierten Decke hinauf: religiöse Symbole, Girlanden aus Eibenzweigen und Anspielungen auf die Gerechtigkeit, wobei das Ganze allerdings schon so oft überstrichen worden ist, dass die scharfen Konturen allmählich verloren gehen.“"
                            },
                            {
                                "example_id": "49ab0ff5-7935-40a8-87a1-05fafba85c7f",
                                "sense_id": "4e7912c7-eec1-3bd6-993b-471d92c6b1f3",
                                "text": "„Nummer 1842, ein großes, stuckverziertes Wohnhaus, kam in Sicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
