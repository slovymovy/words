                    },
                    {
                        "translation_id": "26489895-e4b2-4410-aba1-b6685f389bd6",
                        "source_entry_id": "a6a7279a-ea35-3613-aa29-c8a232d9d990",
                        "source_sense_id": "c4542766-ceda-36f7-8b78-813bc9611b0a",
                        "target_lang_word": "Transformator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transformator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                        "entry_id": "69502bbd-85ce-3983-99d0-c215655608c9",
                                        "glosses": [
                                            "Vorrichtung aus zwei Spulen, meist mit gemeinsamem Eisenkern, die elektrische Energie transformieren, das heißt ihre charakteristische Größe Spannung ändern kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ccc269a-68d2-4af6-a3b0-311914b0e87c",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "Meist fehlt aber das notwendige Wissen, welches Bedingung ist, um einen Transformator erfolgreich zu berechnen und zu wickeln."
                                            },
                                            {
                                                "example_id": "13ba8242-5204-455a-ba3e-281cf7c9cfcd",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "Transformatoren verändern die vorherrschende ländertypische Netzspannung, für den Einsatz verschiedenster, elektrischer Geräte, auf Niederspannungen von 1 Volt bis hin zu 1000den Volt, und umgekehrt."
                                            },
                                            {
                                                "example_id": "bfbde812-65bd-40a9-bc41-3e50c1ad8861",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "„Daher ist der Primärstrom beim unbelasteten Transformator in der Regel sehr klein.“ „Aus dem oben Gesagten geht hervor, dass ein Transformator nur mit Wechselspannung funktionieren kann.“"
                                            },
                                            {
                                                "example_id": "23e8d714-1346-49b1-ba43-22f6f9599828",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "„Transformatoren werden verwendet, um elektrische Energie eines Wechselstromes von einem Primärstromkreis auf einen Sekundärstromkreis zu übertragen. Bei dieser Übertragung kann man die Werte für die Spannungen und Stromstärken verändern. Das Funktionsprinzip von Transformatoren beruht auf der elektromagnetischen Induktion.“"
                                            },
                                            {
                                                "example_id": "3c2f8ddb-71ec-4bd2-b03e-40bd0ff933ff",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "„Transformatoren von Siemens stehen in über 100 Ländern und seit mehr als 100 Jahren für Spitzenqualität – als Resultat von Ideen, Know-how und einzigartiger Erfahrung. Wir bieten den richtigen Transformator für jede Aufgabe – von kompakten Verteiltransformatoren bis zu großen Leistungstransformatoren mit Leistungen über 1000 MVA.“"
                                            },
                                            {
                                                "example_id": "b32956e6-d67d-4fd3-a772-4d4415bb656c",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "„Die Einrichtung besteht außerdem aus einem Transformator, der den Wechselstrom des städtischen Elektrizitätswerks von 6.600 Volt in Gleichstrom von 2 mal 230 Volt umwandeln kann.“"
                                            },
                                            {
                                                "example_id": "fd304284-c6bb-46a6-bddd-390bf6990a32",
                                                "sense_id": "00a9625d-4dce-3b4c-a6c1-809639e07166",
                                                "text": "„Bei sekundärgetakteten Wandlern ist dem DC/DC-Wandler ein Transformator und meistens eine ungesteuerte B2-Schaltung mit Glättungskondensator eingangsseitig vorgeschaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
