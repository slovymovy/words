                "senses": [
                    {
                        "sense_id": "2b95fff1-6c0d-3db8-84c5-54bc905a9812",
                        "entry_id": "ebc36801-d3dc-3e7f-b11e-d4a0b6355c16",
                        "glosses": [
                            "24 Stunden (Tag), die dem Thema Schmerzen gewidmet sind, oft im Zusammenhang mit einem Kongress, Vorträgen oder einer Ausstellung"
                        ],
                        "tags": [
                            "Aufklärungsarbeit"
                        ],
                        "examples": [
                            {
                                "example_id": "025a5ea0-6112-4d8d-b34f-93b908f68173",
                                "sense_id": "2b95fff1-6c0d-3db8-84c5-54bc905a9812",
                                "text": "„Mit dem „Deutschen Schmerzpreis — Deutscher Förderpreis für Schmerzforschung und Schmerzmedizin“, der mit 5.000 € dotiert ist, wurden im Rahmen des 30. Schmerz- und Palliativtags PD Dr. Jens Michael Heyn und PD Dr. Benjamin Luchting, beide aus München, ausgezeichnet.“"
                            },
                            {
                                "example_id": "20ba84ab-ba49-4e07-a29f-9a98d5d407c1",
                                "sense_id": "2b95fff1-6c0d-3db8-84c5-54bc905a9812",
                                "text": "„Sehr geehrte Besucherinnen und Besucher, liebe Kolleginnen, liebe Kollegen, wir laden Sie herzlich zu den 12. Schmerztagen Bodensee-Oberschwaben ein.“"
                            }
                        ],
