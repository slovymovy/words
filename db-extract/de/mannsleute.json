                "translations": [
                    {
                        "translation_id": "09251222-c100-4f66-bc02-bb006ad97711",
                        "source_entry_id": "a27dc43e-5bd9-33f5-9783-20d0e1c2fd40",
                        "source_sense_id": "278b2053-46ef-3002-955b-ea164a481732",
