                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5c66a76c-7db4-347f-88d4-96da1fd3d9ed",
                        "entry_id": "35320fb8-9c8a-345a-8258-1ea277ad89f9",
                        "glosses": [
                            "ogromna ilość czegoś"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "06370c9f-58b4-49ff-a751-dc45f4200f69",
                                "sense_id": "5c66a76c-7db4-347f-88d4-96da1fd3d9ed",
                                "text": "Aszszur przybył z gór, od północy, przyszedł z miriadami swoich sił zbrojnych, mnóstwo ich obsadziło potoki, a konnica ich okryła wzgórza"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027b5dce-5414-4cc4-9a28-a17c470f5da5",
                        "source_entry_id": "35320fb8-9c8a-345a-8258-1ea277ad89f9",
                        "source_sense_id": "5d2de459-b4a1-327f-afa2-86f24f609d6b",
                        "target_lang_word": "myriad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myriad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edf1a101-7a9d-35c9-8fe6-24946f24c1eb",
                                        "entry_id": "cf7bae7b-9f98-313d-8e33-8205e6903e70",
                                        "glosses": [
                                            "Ten thousand; 10,000"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52773576-12db-3fb2-8ea9-fe63e2306875",
                                        "entry_id": "cf7bae7b-9f98-313d-8e33-8205e6903e70",
                                        "glosses": [
                                            "Ten thousand; 10,000",
                                            "Synonym of decamillennium: a period of 10000 years."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                        "entry_id": "cf7bae7b-9f98-313d-8e33-8205e6903e70",
                                        "glosses": [
                                            "A countless number or multitude (of specified things)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01340b4c-47de-472d-af71-1a1849875076",
                                                "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                                "text": "Earth hosts a myriad of animals."
                                            },
                                            {
                                                "example_id": "2e90f0ef-dd13-4277-97ab-9dd7ace7c8bc",
                                                "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                                "text": "O Myriads of immortal Spirits, O Powers / Matchleſs, but with th' Almighty, and that ſtrife / Was not inglorious, though th' event was dire,"
                                            },
                                            {
                                                "example_id": "3fc4b28d-ded2-4e54-93b8-f095350ace0b",
                                                "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                                "text": "A myriad of beginnings to her intended discourse darted into her mind; but, as is usual in such cases, she chose the one the very worst suited to her purpose. \"I never intend to marry,\" said she, in a faltering voice."
                                            },
                                            {
                                                "example_id": "f86e9f9e-b186-4401-949f-da287fa0ac21",
                                                "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                                "text": "I saw battle-corpses, myriads of them, / And the white skeletons of young men, I saw them, / I saw the debris and debris of all the slain soldiers of the war, […]"
                                            },
                                            {
                                                "example_id": "4ebd1e08-74fa-4e7e-86e8-fecda4ca7a8f",
                                                "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                                                "text": "How far he surpassed them all may be felt if we remember that no Scythian, although the Scythians are reckoned by their myriads, has ever succeeded in dominating a foreign nation ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myriad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da99532f-9dfe-350b-b1e7-2fee7b651398",
                                        "entry_id": "ee570459-9e3c-305c-a2ab-0810a038ff18",
                                        "glosses": [
                                            "Multifaceted, having innumerable elements"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355a81d3-1aba-4e25-a2e4-f1eb496c64cf",
                                                "sense_id": "da99532f-9dfe-350b-b1e7-2fee7b651398",
                                                "text": "one night he would be singing at the barred window and yelling down out of the soft myriad darkness of a May night; the next night he would be gone [...]."
                                            },
                                            {
                                                "example_id": "d670947b-3fa9-4285-8fee-e73a9441f12d",
                                                "sense_id": "da99532f-9dfe-350b-b1e7-2fee7b651398",
                                                "text": "\"As a clinician, it's a difficult symptom to treat,\" Cornelius said. \"The end symptom may be the same, but what's causing it may be myriad.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f5c14f-cf76-378c-8765-371f8fe46250",
                                        "entry_id": "ee570459-9e3c-305c-a2ab-0810a038ff18",
                                        "glosses": [
                                            "Great in number; innumerable, multitudinous"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c894dfc3-a344-4415-b95c-119208a49e2f",
                                                "sense_id": "10f5c14f-cf76-378c-8765-371f8fe46250",
                                                "text": "Driven by a perceived political need to adopt a hard-line stance, Mr. Cameron’s coalition government has imposed myriad new restrictions, the aim of which is to reduce net migration to Britain to below 100,000."
                                            },
                                            {
                                                "example_id": "8ee14992-1a7a-4054-96b5-56f72dc7dc12",
                                                "sense_id": "10f5c14f-cf76-378c-8765-371f8fe46250",
                                                "text": "Earth hosts myriad animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36b05a03-df30-48ca-8b63-e7e031cfe8d2",
                        "source_entry_id": "35320fb8-9c8a-345a-8258-1ea277ad89f9",
