                "senses": [
                    {
                        "sense_id": "da4c0dfc-8361-3f56-ab62-412006638d93",
                        "entry_id": "1ec3a19a-495d-332a-9975-3c3c6967f1fb",
                        "glosses": [
                            "Survivre à nouveau, après une première épreuve à laquelle on a déjà survécu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc8fb32-d809-4f43-bfc0-d2652d9ae41a",
                                "sense_id": "da4c0dfc-8361-3f56-ab62-412006638d93",
                                "text": "REbienvenue mes chers, puissiez-vous resurvivre aussi longtemps que vous le pouvez parmi nous !"
                            },
                            {
                                "example_id": "23f871d1-3b71-4652-9a64-c07d15e8bc44",
                                "sense_id": "da4c0dfc-8361-3f56-ab62-412006638d93",
                                "text": "Tu parles de survie? c'est vrai nous survivons...avant de pouvoir essayer de vivre à nouveau...pour resurvivre encore, car comme tu l'expliques très bien, \"le temps ne cicatrise rien, il endort la douleur pour mieux la laisser ressortir avec autant de colère, de douleur qu'à ses débuts\"."
                            },
                            {
                                "example_id": "aa929127-caf3-4d09-94d3-4369f2614c38",
                                "sense_id": "da4c0dfc-8361-3f56-ab62-412006638d93",
                                "text": "Pour le cas des Rwandais, la majorité des populations survivent sans espoir de resurvivre."
                            }
                        ]
                    }
                ],
