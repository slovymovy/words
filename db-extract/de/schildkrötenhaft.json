                ],
                "senses": [
                    {
                        "sense_id": "2642f184-d533-3a20-91c2-5f9045d4846a",
                        "entry_id": "8f319db9-c700-3e14-ad8e-f3b58de526f6",
                        "glosses": [
                            "an eine Schildkröte erinnernd, wie eine Schildkröte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a4f195b-138f-43dc-980b-d077a6e8ef60",
                                "sense_id": "2642f184-d533-3a20-91c2-5f9045d4846a",
                                "text": "„Kurz darauf passierten sie das offene Portal des Gouverneurspalastes, zogen über die abgetretenen Steinschwellen in den Hof, wo die schrundigen, unbeschlagenen Hufe ihrer Pferde sich mit seltsamem, schildkrötenhaftem Geklapper über den Kopfstein bewegten.“"
                            },
                            {
                                "example_id": "aec7e5e0-10c7-49e0-a167-bce777c7f890",
                                "sense_id": "2642f184-d533-3a20-91c2-5f9045d4846a",
                                "text": "„Es war aus weißlichem Gold gefertigt und stellte ein höckriges Tier dar, ausgestattet mit einem glatten Rückenpanzer, unter dessen vorstehendem Rand der Kopf und die Gliedmaßen schildkrötenhaft hervorlugten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
