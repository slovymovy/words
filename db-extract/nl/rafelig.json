                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4f20eb5-65c7-36d1-9090-6c7e7252670d",
                        "entry_id": "8101ae72-9484-3287-ad8b-5c324804dbd9",
                        "glosses": [
                            "een weefsel is rafelig als er draden uit losraken, het weefsel is dan beschadigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "877b9625-4090-4aaa-8bb8-7c23bec0b284",
                                "sense_id": "f4f20eb5-65c7-36d1-9090-6c7e7252670d",
                                "text": "Hij liep in een rafelig T-shirt rond."
                            },
                            {
                                "example_id": "3ab82316-c49b-4c7e-a368-5f15dad4cea0",
                                "sense_id": "f4f20eb5-65c7-36d1-9090-6c7e7252670d",
                                "text": "Dit woord was geschreven op een stukje bruin papier, de randen rafelig waar het was afgescheurd om te voldoen aan de afmetingen waar dr. Murray de voorkeur aan gaf Vader hield stil en ik bereidde me voor om het te leren."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73864d7-f9ac-398a-b5b5-c1e4994febc8",
                        "entry_id": "8101ae72-9484-3287-ad8b-5c324804dbd9",
                        "glosses": [
                            "beschadigd, niet meer helemaal nieuw en netjes afgewerkt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "354dac64-4b64-4ebb-bdc4-e14ea501f795",
                                "sense_id": "a73864d7-f9ac-398a-b5b5-c1e4994febc8",
                                "text": "Hier leek de adem van Sjostakovitsj écht echt voelbaar in een interpretatie op het scherpst van de snede: rauw, risicovol en rafelig. Zelfs de solo van de 15-jarige Noa Wildschut klonk alsof je zo, via een open zenuw, in contact stond met het Sovjet-era."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9f21191-4e04-386c-8124-b705d764813f",
                        "entry_id": "8101ae72-9484-3287-ad8b-5c324804dbd9",
                        "glosses": [
                            "verstrooid, ver van elkaar verwijderd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4d74aedb-386e-4cc5-9c0d-28f29a87bd6c",
                                "sense_id": "e9f21191-4e04-386c-8124-b705d764813f",
                                "text": "Nadat de Japanse vlag was gehesen, klonk een rafelig applaus van de grotendeels lege tribunes."
                            }
                        ]
                    },
                    {
                        "sense_id": "09c61973-8563-3cad-ac7d-d8737a721d6a",
                        "entry_id": "8101ae72-9484-3287-ad8b-5c324804dbd9",
                        "glosses": [
                            "met hoge criminaliteit, sociale achterstand e.d."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "b425af1f-dd9f-443f-a928-9bed37fc3569",
                                "sense_id": "09c61973-8563-3cad-ac7d-d8737a721d6a",
                                "text": "Het idee: meer nog dan de vaste clientèle zaterdag en zondag, ook mensen lokken die in coronatijd niet zo makkelijk naar het rafelige deel van Amsterdam-Noord komen."
                            }
                        ]
                    }
                ],
