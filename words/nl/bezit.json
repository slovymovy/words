                {
                    "sense_id": "d605d4bd-6db6-3d4b-a888-fa4225c2fc73",
                    "sense_definition": "de totale waarde van iemands eigendommen of financiële middelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financiën",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het totale <w>bezit</w> van de familie wordt geschat op miljoenen euro's.",
