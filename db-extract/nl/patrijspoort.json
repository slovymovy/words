                "senses": [
                    {
                        "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                        "entry_id": "0ce53a45-2e34-335e-a387-1828fc445d6e",
                        "glosses": [
                            "klein rond raam in een scheepswand dat waterdicht kan worden afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c05b7e4f-0a25-490f-a7f8-23f3bb613d36",
                                "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                                "text": "In de vertrekhal vreesde ik de sfeer van een pannenkoekenboot, met liedjes en wafels onderweg. Tot ik de Viking Grace zag. Nog nooit had ik zo’n groot schip gezien, twaalf dekken, 218 meter lang! Mijn kajuit had niet het piepgaatje van een patrijspoort, maar een groot raam om in stijl uit te kijken naar Åland, mijn koninkrijk."
                            },
                            {
                                "example_id": "c4013603-672e-4d44-a127-1b39ea766641",
                                "sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                                "text": "Nachts wakker geworden met een droge mond nam hij een slok water, gooide het glas walgend uit de patrijspoort, waarna het in het ochtendlicht duidelijk werd dat het het kunstgebit van zijn kajuitgenoot bevat had, een politicus die in Indië toespraken moest houden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d3d84e7-db7d-404a-a01d-4dd9aba61d53",
                        "source_entry_id": "0ce53a45-2e34-335e-a387-1828fc445d6e",
                        "source_sense_id": "5cb03b07-638e-3802-b194-4f08c5b45e6b",
                        "source_sense_description": "klein rond raam in een scheepswand dat waterdicht kan worden afgesloten",
                        "target_lang_word": "Bullauge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bullauge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "228bc96b-568d-394a-9628-106c3cef5557",
                                        "entry_id": "f34435d2-053c-3965-ad7f-c98fe845aabf",
                                        "glosses": [
                                            "rundes Glasfenster (meist in Schiffen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80a32fb-6eb2-4fd3-80ab-58b009c8c4c5",
                                                "sense_id": "228bc96b-568d-394a-9628-106c3cef5557",
                                                "text": "Er schaute durch das Bullauge des Unterseebootes und sah bunte Fische vorbeischwimmen."
                                            },
                                            {
                                                "example_id": "9dc79458-5bb0-4f8c-944d-7384d79dafdc",
                                                "sense_id": "228bc96b-568d-394a-9628-106c3cef5557",
                                                "text": "„Als sie in der Kombüse verschwand, schlich er zum zweiten Bullauge, beobachtete ihre flinken Hände am Herd.“"
                                            },
                                            {
                                                "example_id": "4bb2d5dd-15a1-4231-9afc-91fb3244199f",
                                                "sense_id": "228bc96b-568d-394a-9628-106c3cef5557",
                                                "text": "„Wir hatten ein großes Bullauge in der Kajüte, hoch oben über den an der Außenwand hingleitenden Brechern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
