                ],
                "senses": [
                    {
                        "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                        "entry_id": "51bba519-6d21-3d78-b9b6-e1dc5ea9462b",
                        "glosses": [
                            "besonders nervenaufreibende Spannung in einer Situation, die meist mit erhöhter Hormonausschüttung verbunden ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "afa6d50a-6479-4a46-b735-0f5da0666ee6",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "Ich liebe den Nervenkitzel bei Achterbahnfahrten."
                            },
                            {
                                "example_id": "02244586-ed8a-4459-9efc-c0b1603d7434",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "Am Bungeejumping reizt mich vor allem der Nervenkitzel."
                            },
                            {
                                "example_id": "6993c0ae-3477-4902-bb3f-aff05741c9ee",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "„Die Abstimmung über einen Austritt Großbritanniens aus der Europäischen Union wird immer mehr zum Nervenkitzel.“"
                            },
                            {
                                "example_id": "72cea8bf-1bca-41c5-b510-40501d895fcd",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "„Sie begleiten die Techniker im Cockpit der Schneekatze auf ihrer abendlichen Fahrt, die auf den Hängen der steilsten präparierten Piste Italiens fast genauso viel Nervenkitzel mit sich bringt wie die Abfahrt selbst.“"
                            },
                            {
                                "example_id": "f953665c-721d-436f-9a26-343bd2eacf33",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "„Je nach Risikomentalität wird der Nervenkitzel in echten Gefahrensituationen gesucht oder auch nur in abgesicherten Scheinbedrohungen von virtuellen Welten oder Vergnügungsarrangements ausgelebt.“"
                            },
                            {
                                "example_id": "202bb0e8-ce40-4a9f-a664-275e71ba0f83",
                                "sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                                "text": "„Obwohl es mir leid tat, dass ich Hamid so viel Kummer bereitet hatte, genoss ich insgeheim den Nervenkitzel, den mir unsere Flucht aus Bordj el Haouas bereitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c607e638-d8b1-4673-bb1d-81cb9205c352",
                        "source_entry_id": "51bba519-6d21-3d78-b9b6-e1dc5ea9462b",
                        "source_sense_id": "5fbf3804-57b4-3db0-bd42-268c3dc90ddf",
                        "target_lang_word": "thrill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fe83132-3f06-3978-abf1-58e1f73d58a4",
                                        "entry_id": "5bc91ee8-8590-3e16-88f5-9f44ef831a91",
                                        "glosses": [
                                            "To suddenly excite someone, or to give someone great pleasure; to (figuratively) electrify; to experience such a sensation."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5e40f51-b1e8-4684-a820-0f53831d16ea",
                                                "sense_id": "7fe83132-3f06-3978-abf1-58e1f73d58a4",
                                                "text": "The cruel word her tender heart so thrilled, / That sudden cold did run through every vein."
                                            },
                                            {
                                                "example_id": "e5915f7b-8823-4238-aac3-079b1597cb45",
                                                "sense_id": "7fe83132-3f06-3978-abf1-58e1f73d58a4",
                                                "text": "1854, Matthew Arnold, Preface to Poems\nvivid and picturesque turns of expression […] which thrill the reader with a sudden delight"
                                            },
                                            {
                                                "example_id": "23bb6db7-33b5-41a1-b234-a5f44c70f687",
                                                "sense_id": "7fe83132-3f06-3978-abf1-58e1f73d58a4",
                                                "text": "One love / That has possessed me; / One love / Thrilling me through"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de9106e-d3cd-3478-84cf-0509baa28cb8",
                                        "entry_id": "5bc91ee8-8590-3e16-88f5-9f44ef831a91",
                                        "glosses": [
                                            "To (cause something to) tremble or quiver."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b223d429-9dee-3ae4-a55f-400f199af34a",
                                        "entry_id": "5bc91ee8-8590-3e16-88f5-9f44ef831a91",
                                        "glosses": [
                                            "To perforate by a pointed instrument; to bore; to transfix; to drill."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92fb3983-7697-4be4-b18e-f2cd54afff92",
                                                "sense_id": "b223d429-9dee-3ae4-a55f-400f199af34a",
                                                "text": "he perced through his chaufed chest / With thrilling point of deadly yron brand"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7391ab92-e369-3f9c-971d-bfe94f72679a",
                                        "entry_id": "5bc91ee8-8590-3e16-88f5-9f44ef831a91",
                                        "glosses": [
                                            "To hurl; to throw; to cast."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656b6079-ffe7-4817-977b-0ef1c7e74dfd",
                                                "sense_id": "7391ab92-e369-3f9c-971d-bfe94f72679a",
                                                "text": "I'd thrill my jauelin at the Grecian moysture"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thrill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c397976-8e6a-3a62-82e7-8dd246ef28cb",
                                        "entry_id": "6109461d-f83e-3560-a43e-ea59d3b9fe70",
                                        "glosses": [
                                            "A trembling or quivering, especially one caused by emotion; a frisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701da5db-069c-40d7-9e05-47d879a3c05e",
                                                "sense_id": "7c397976-8e6a-3a62-82e7-8dd246ef28cb",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    },
