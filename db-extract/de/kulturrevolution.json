                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9511a666-6503-4006-988d-3ae3f56dd9fc",
                                "sense_id": "1373839b-08f9-34d9-80a5-b1faa9ed3b84",
                                "text": "Die industrielle Revolution ist von ihrem Ansatz her genuin eine Kulturrevolution."
