                "senses": [
                    {
                        "sense_id": "ee519996-b53d-3ec1-a267-e82e1c2594cb",
                        "entry_id": "b5b1a97c-978e-3638-b74e-a9f3f7e6e24b",
                        "glosses": [
                            "Mystery of Crowning"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "e12eca82-d94d-4e18-9b56-7ed9db26f56c",
                                "sense_id": "ee519996-b53d-3ec1-a267-e82e1c2594cb",
                                "text": "Арти́ст говори́л О́льге Ива́новне, что со свои́ми льняны́ми волоса́ми и в венча́льном наря́де она́ о́чень похо́жа на стро́йное вишнёвое де́ревцо, когда́ весно́ю оно́ сплошь быва́ет покры́то не́жными бе́лыми цвета́ми.",
                                "translation": "The artist told Olga Ivanovna that with her flaxen hair and wedding dress she was a graceful cherry-tree covered with tender, white blossoms in spring.",
                                "english": "The artist told Olga Ivanovna that with her flaxen hair and wedding dress she was a graceful cherry-tree covered with tender, white blossoms in spring."
                            },
                            {
                                "example_id": "a125e14b-10ac-4056-a884-cb45aea21d68",
                                "sense_id": "ee519996-b53d-3ec1-a267-e82e1c2594cb",
                                "text": "Я у вас, я у вас, у вас на губа́х,\nЯ у вас, я у вас, у вас на плече́,\nОтража́юсь в чёрных глаза́х, как в венча́льной свече́.",
                                "translation": "DDT",
                                "english": "DDT"
                            }
                        ]
                    }
                ],
