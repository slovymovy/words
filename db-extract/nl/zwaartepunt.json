                    {
                        "sense_id": "78eb06ce-2827-3914-b81e-517f81e0b8c5",
                        "entry_id": "42afead5-1653-392d-8b54-d6a5b0264027",
                        "glosses": [
                            "het punt ten opzichte waarvan de massa van dat object in evenwicht is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d893c6d-a3fc-4587-8a65-393e521dd76e",
                                "sense_id": "78eb06ce-2827-3914-b81e-517f81e0b8c5",
                                "text": "Het zwaartepunt van een potlood ligt ongeveer in het midden."
                            },
                            {
                                "example_id": "16e3c14f-ec82-44b6-9765-3d07a086c2b3",
                                "sense_id": "78eb06ce-2827-3914-b81e-517f81e0b8c5",
                                "text": "wanneer op een lichaam een stelsel krachten werkzaam is, zal dat lichaam zich bewegen alsof alle massa in het zwaartepunt geconcentreerd is"
                            },
                            {
                                "example_id": "1641270a-4a74-4852-88d4-d15e1fcfc598",
                                "sense_id": "78eb06ce-2827-3914-b81e-517f81e0b8c5",
                                "text": "Het overwinnen van het zwaartepunt was een moment van grote vreugde."
                            }
                        ]
                    },
                    {
                        "sense_id": "62cfe500-fb54-3df5-a23b-9e3b8510a133",
