    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8edef88a-1119-3210-b512-47d7f7edd4b7",
                    "sense_definition": "Вдумчивый, строгий и глубокомысленный человек.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он всегда был очень <w>серьёзным</w> человеком.",
                            "target_lang_translations": {
                                "pl": "Zawsze był bardzo <w>poważnym</w> człowiekiem."
                            }
                        },
                        {
                            "text": "Мой отец — <w>серьёзный</w> и ответственный специалист.",
                            "target_lang_translations": {
                                "pl": "Mój ojciec to <w>poważny</w> i odpowiedzialny specjalista."
                            }
                        }
                    ],
                    "synonyms": [
                        "строгий",
                        "глубокомысленный"
                    ],
                    "antonyms": [
                        "легкомысленный"
                    ],
                    "common_phrases": [
                        "серьёзный человек"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba zrównoważona, odpowiedzialna, myśląca głęboko i pozbawiona lekkomyślności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "o usposobieniu lub charakterze człowieka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74e05614-0cea-310b-8371-aa64ce51be7a",
                    "sense_definition": "Не расположенный к веселью или легкомыслию, не выражающий радость.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него было очень <w>серьёзное</w> лицо во время разговора.",
                            "target_lang_translations": {
                                "pl": "Miał bardzo <w>poważną</w> twarz podczas rozmowy."
                            }
                        },
                        {
                            "text": "Она посмотрела на меня <w>серьёзным</w> взглядом.",
                            "target_lang_translations": {
                                "pl": "Spojrzała na mnie <w>poważnym</w> wzrokiem."
                            }
                        }
                    ],
                    "antonyms": [
                        "весёлый"
                    ],
                    "common_phrases": [
                        "серьёзное лицо"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niewyrażający wesołości ani radości, skupiony, surowy z wyglądu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "o wyrazie twarzy, spojrzeniu lub nastroju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cc690b4-6cba-311d-98b9-36155cb4ce3f",
                    "sense_definition": "Существенный, важный, критический по своему значению.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это очень <w>серьёзная</w> проблема для нашей компании.",
                            "target_lang_translations": {
                                "pl": "To bardzo <w>poważny</w> problem dla naszej firmy."
                            }
                        },
                        {
                            "text": "Нам нужно принять <w>серьёзное</w> решение сегодня.",
                            "target_lang_translations": {
                                "pl": "Musimy dzisiaj podjąć <w>poważną</w> decyzję."
                            }
                        }
                    ],
                    "synonyms": [
                        "существенный",
                        "важный"
                    ],
                    "common_phrases": [
                        "серьёзная проблема",
                        "серьёзное решение"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający duże znaczenie, istotny, wymagający namysłu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "mający duże znaczenie"
                            },
                            {
                                "target_lang_word": "istotny",
                                "target_lang_sense_clarification": "ważny, kluczowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f8e0a49-7482-3787-b334-27a6d188d7a8",
                    "sense_definition": "Опасный, чреватый значительными негативными последствиями.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Совершено <w>серьёзное</w> преступление в центре города.",
                            "target_lang_translations": {
                                "pl": "W centrum miasta popełniono <w>ciężkie</w> przestępstwo."
                            }
                        },
                        {
                            "text": "У пациента была <w>серьёзная</w> травма после аварии.",
                            "target_lang_translations": {
                                "pl": "Pacjent miał <w>poważny</w> uraz po wypadku."
                            }
                        }
                    ],
                    "synonyms": [
                        "опасный",
                        "тяжёлый"
                    ],
                    "common_phrases": [
                        "серьёзное преступление",
                        "серьёзная травма",
                        "серьёзная болезнь"
                    ],
                    "target_lang_definitions": {
                        "pl": "Groźny, niebezpieczny, niosący ze sobą ciężkie konsekwencje."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "o chorobie, urazie, problemie"
                            },
                            {
                                "target_lang_word": "ciężki",
                                "target_lang_sense_clarification": "o przestępstwie, uszkodzeniu ciała"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778f4d4d-6a73-369b-8870-24a48bf179ce",
                    "sense_definition": "Сильный, способный действовать правильно и эффективно в своей области.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "competence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>серьёзный</w> учёный с мировым именем.",
                            "target_lang_translations": {
                                "pl": "To <w>poważny</w> naukowiec o światowej renomie."
                            }
                        },
                        {
                            "text": "Наш боец встретил <w>серьёзного</w> противника на ринге.",
                            "target_lang_translations": {
                                "pl": "Nasz zawodnik spotkał na ringu <w>wymagającego</w> przeciwnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "сильный",
                        "солидный"
                    ],
                    "antonyms": [
                        "слабый"
                    ],
                    "common_phrases": [
                        "серьёзный противник"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zdolny, liczący się w danej dziedzinie, stanowiący wyzwanie dla innych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "liczący się, godny uwagi"
                            },
                            {
                                "target_lang_word": "wymagający",
                                "target_lang_sense_clarification": "o rywalu lub przeciwniku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53b2a51b-f5c8-349f-8fd1-50eeba6ba982",
                    "sense_definition": "Не имеющий отношения к развлечению, требующий глубокого внимания.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Серьёзная</w> литература требует времени для осмысления.",
                            "target_lang_translations": {
                                "pl": "<w>Ambitna</w> literatura wymaga czasu na refleksję."
                            }
                        },
                        {
                            "text": "Он предпочитает <w>серьёзную</w> музыку лёгким песням.",
                            "target_lang_translations": {
                                "pl": "Woli muzykę <w>poważną</w> od lekkich piosenek."
                            }
                        }
                    ],
                    "antonyms": [
                        "лёгкий"
                    ],
                    "common_phrases": [
                        "серьёзная литература",
                        "серьёзная музыка"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dotyczący spraw wzniosłych lub trudnych, nienależący do kultury czysto rozrywkowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "poważny",
                                "target_lang_sense_clarification": "np. muzyka poważna, ambitna literatura"
                            },
                            {
                                "target_lang_word": "ambitny",
                                "target_lang_sense_clarification": "o sztuce, literaturze"
                            }
                        ]
                    }
                }
            ]
        }
    ]
