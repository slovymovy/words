                "senses": [
                    {
                        "sense_id": "d8a44a33-5cc8-39ec-a62d-4a8de6d45da7",
                        "entry_id": "40b24ba8-f982-3e90-bd07-a944b171b49f",
                        "glosses": [
                            "Verbrennungsmotor, der mit Schweröl betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d57d8a-e02e-4bcf-805d-46432b907cc0",
                                "sense_id": "d8a44a33-5cc8-39ec-a62d-4a8de6d45da7",
                                "text": "„In Europa ist der Schlepper mit Schwerölmotor, insbesondere mit Glühkopfmotor, vorherrschend, während in den übrigen Erdteilen, besonders in Nordamerika, Schlepper mit Schwerölmotoren erst in jüngster Zeit gebaut werden.“"
                            },
                            {
                                "example_id": "9d528e02-e7a2-42ed-a191-cb7662a5a1c8",
                                "sense_id": "d8a44a33-5cc8-39ec-a62d-4a8de6d45da7",
                                "text": "„Der Übergang vom Benzinmotor zum Schwerölmotor durch Dieselautos oder Versuche mit Schwerölvergasern behalten nicht entfernt den heutigen Anreiz.“"
                            },
                            {
                                "example_id": "7e230c0d-5ab5-4058-83fe-e3cc9c98fc27",
                                "sense_id": "d8a44a33-5cc8-39ec-a62d-4a8de6d45da7",
                                "text": "„Auf dem großen Kanal lagen Dutzende von Schiffen eng beieinander und miteinander vertäut, das Beben ihrer Schwerölmotoren erfüllte die Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
