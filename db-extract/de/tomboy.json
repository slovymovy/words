                        "entry_id": "40c985f6-80d1-37db-873a-013b70ce4bda",
                        "glosses": [
                            "A girl who behaves in a typically boyish manner."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b6711c8a-badb-4bd8-8199-c467b81c9c15",
                                "sense_id": "369e31df-1306-3d2a-85ed-08d2c9aa9272",
                                "text": "Sie war ein richtiger Tomboy und musste auf jeden Baum klettern.",
                                "translation": "She was a real tomboy and had to climb any tree.",
                                "english": "She was a real tomboy and had to climb any tree."
                            },
                            {
                                "example_id": "dbf5a922-abca-418f-8be0-a4dc950b5ab0",
                                "sense_id": "369e31df-1306-3d2a-85ed-08d2c9aa9272",
                                "text": "Weiter hinten in der Straße gibt es ein Restaurant, in dem ein Tomboy, eine Frau mit extrem maskulinem Auftreten arbeitet.",
                                "translation": "A bit further down the street, there is a restaurant where a tomboy works, a woman with a very masculine demeanour.",
                                "english": "A bit further down the street, there is a restaurant where a tomboy works, a woman with a very masculine demeanour."
