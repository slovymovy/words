                "senses": [
                    {
                        "sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
                        "entry_id": "17ac5963-74e6-313c-ad51-f45d6122f8f1",
                        "glosses": [
                            "het in contact komen met elkaar; de keer dat men contact heeft met elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9040e26a-f50e-4caa-bdd6-20e196319ecf",
                                "sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
                                "text": "Barman Victor Abeln liet gisteren aan RTL Boulevard weten dat meer dan de helft van de ontmoetingen tijdens het vorige seizoen heeft geleid tot een match. Hij gaat ook in de nieuwe reeks weer drankjes en hapjes serveren aan naar liefde en een relatie hunkerende mannen en vrouwen."
                            },
                            {
                                "example_id": "1325860c-fd10-4208-b93a-2e1906ec3ddc",
                                "sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
                                "text": "De ontmoeting der twee mannen was voor beiden veel aangenamer dan zij verwacht hadden."
                            },
                            {
                                "example_id": "f6da4db4-6a9f-4179-87ee-15af935d97ae",
                                "sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
                                "text": "Tijdens onze eerste ontmoeting had ze me verteld dat ik haar deed denken aan iemand die ze had gekend."
                            },
                            {
                                "example_id": "060071ad-f65c-46d2-a1fc-c95b22ce1047",
                                "sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
                                "text": "Bovendien wilde ik niet al mijn kruit verschieten bij onze eerste ontmoeting, want ik vermoedde dat er nog vele gelegenheden zouden volgen, waarbij ik het voorrecht zou hebben alle details te vernemen van zijn talrijke successen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f9eef95-cef8-4155-ba01-054de4cd3ede",
                        "source_entry_id": "17ac5963-74e6-313c-ad51-f45d6122f8f1",
                        "source_sense_id": "75a1c60b-17a4-3030-85c6-0a9bf858a556",
