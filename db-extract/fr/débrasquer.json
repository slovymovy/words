                "senses": [
                    {
                        "sense_id": "e7cd7151-a6a4-371a-b5c1-8d88d6b7ab86",
                        "entry_id": "e8e6cf4d-2c6b-3110-b594-880274ec0022",
                        "glosses": [
                            "Enlever les brasques qu’on avait utilisé pour enduire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ba7d4e-0110-4688-833c-66806d9df894",
                                "sense_id": "e7cd7151-a6a4-371a-b5c1-8d88d6b7ab86",
                                "text": "Les sous-traitants responsables de la réfection des cuves pour l’entreprise s’affaireront, en équipe avec les employés d’Alouette, à débrasquer et rebrasquer majoritairement les cuves issues de la seconde phase qui a démarré en 2005."
                            },
                            {
                                "example_id": "72dd95ca-9767-410b-a391-9dd9247f4ef9",
                                "sense_id": "e7cd7151-a6a4-371a-b5c1-8d88d6b7ab86",
                                "text": "Il souligne qu’il était devenu impératif de débrasquer à sec et que malgré les contraintes de coûts, l’équipe a su relever le défi et trouver des solutions."
                            }
                        ]
                    }
