                        "examples": [
                            {
                                "example_id": "06b1d529-1893-4166-80e1-8024ed45e613",
                                "sense_id": "7157ebb1-37d4-3807-bf67-38e0c1b41883",
                                "text": "De voerman op zijn bastschoenen rende hijgend naar zijn kar, schoof een steen onder de onbeslagen achterwielen en begon de staartriem van zijn tot staan gekomen paardje recht te trekken."
