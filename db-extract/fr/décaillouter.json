                "senses": [
                    {
                        "sense_id": "31797423-02b4-3cf0-b3cb-8d154c2bc2b4",
                        "entry_id": "8dc7e187-75bd-348b-a177-07112e5a62e0",
                        "glosses": [
                            "Débarrasser des cailloux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45e5438-1f8c-4523-9166-6e5503b95baa",
                                "sense_id": "31797423-02b4-3cf0-b3cb-8d154c2bc2b4",
                                "text": "Mais à eux deux, ils lui permirent de défricher, de brûler, de couper ronces et épines, d’aplanir, de «décaillouter» et de s’attaquer aux murs et au toit."
                            },
                            {
                                "example_id": "84db194e-2ea2-485b-a619-937060c01b76",
                                "sense_id": "31797423-02b4-3cf0-b3cb-8d154c2bc2b4",
                                "text": "Roland leur distribua des champs à décaillouter, incitant certains à favoriser l’élevage des vaches et des moutons, grands dispensateurs de lait, de viande, de cuir et de laine."
                            }
                        ]
                    }
