                "senses": [
                    {
                        "sense_id": "400a1d66-c507-31e2-b4d0-eb05d7c068bb",
                        "entry_id": "52d7c4b2-db3e-344a-b3ce-0d456aefcbfb",
                        "glosses": [
                            "bequeme Person, die"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7215da3a-2929-48cf-ab36-bedbcffb8629",
                                "sense_id": "400a1d66-c507-31e2-b4d0-eb05d7c068bb",
                                "text": "Gerade jetzt im Asylpolitik-Streit brauchte es dringend ein starkes, geeintes Europa. Stattdessen [bestimmen] Dilettantismus und bayerische Dünnbrettbohrer die Szene […]"
                            },
                            {
                                "example_id": "fa1f73aa-79ca-44f1-802f-693e9104f1e6",
                                "sense_id": "400a1d66-c507-31e2-b4d0-eb05d7c068bb",
                                "text": "[…] wir suchen ja nicht so Dünnbrettbohrer, sondern wir brauchen Menschen in der Politik, die wirklich auch Stress aushalten können, die so viel Motivation mitbringen und so viel auch authentische Kraft, die sie in sich haben und die sie sich angeeignet haben, dass sie Widerstände aushalten können."
                            },
                            {
                                "example_id": "bf824e27-c9f2-4fec-9433-01b0f7d21b61",
                                "sense_id": "400a1d66-c507-31e2-b4d0-eb05d7c068bb",
                                "text": "Manchmal hab ich mich selber so in Verdacht gehabt, dass ich so ein Dünnbrettbohrer bin, also immer wenn es schwierig wird, dass ich dann auf ein anderes Thema komme oder in eine andere Disziplin wieder wechsel […]"
                            },
                            {
                                "example_id": "3770237f-9ec8-4b8e-994f-10e4dc7003e0",
                                "sense_id": "400a1d66-c507-31e2-b4d0-eb05d7c068bb",
                                "text": "„Die Lehrer werden an die Universitäten zu Schmalspurwissenschaftlern ausgebildet. Das sind doch Dünnbrettbohrer. Sie bekommen kein Handwerkszeug vermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "642f8ba1-5ba0-3e87-80ee-2a738a28d2e9",
                        "entry_id": "52d7c4b2-db3e-344a-b3ce-0d456aefcbfb",
                        "glosses": [
                            "Anstrengungen vermeidet und Probleme und Schwierigkeiten gar nicht erst angeht,"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "df8d269c-3067-3a3d-8909-79296db26d98",
                        "entry_id": "52d7c4b2-db3e-344a-b3ce-0d456aefcbfb",
                        "glosses": [
                            "keine Leistung bringt,"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "27c931b7-bc49-31d7-b63f-2c2119911860",
                        "entry_id": "52d7c4b2-db3e-344a-b3ce-0d456aefcbfb",
                        "glosses": [
                            "den einfachsten Weg zum Ziel wählt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "96df237f-b648-3066-bdbf-b63a83ab4ff9",
                        "entry_id": "52d7c4b2-db3e-344a-b3ce-0d456aefcbfb",
                        "glosses": [
                            "Person, die nicht besonders schlau / intelligent ist, aber so erscheinen möchte"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0898cdf5-cf43-47fa-b66f-ab4f6b385f76",
                                "sense_id": "96df237f-b648-3066-bdbf-b63a83ab4ff9",
                                "text": "CSU-Generalsekretär [Andreas] Scheuer verzichtet nach einem kritischen Zeitungsbericht künftig auf seinen Doktortitel. […] Mit dem Vorwurf, ein wissenschaftlicher Dünnbrettbohrer zu sein, muss Scheuer jetzt vorerst zurechtkommen […]"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75827e78-5795-4a25-a6a3-f80ceab88f55",
