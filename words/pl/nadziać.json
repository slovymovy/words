{
    "word_family": [
        "nadzienie",
        "nadziewany"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a4a61e0-7625-307c-929b-2d2ab613c457",
                    "sense_definition": "wypełnić wnętrze czegoś masą lub produktami",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wypełnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz <w>nadziać</w> paprykę mięsem z ryżem przed włożeniem do piekarnika.",
                            "target_lang_translations": {
                                "en": "You must <w>stuff</w> the peppers with meat and rice before putting them in the oven."
                            }
                        },
                        {
                            "text": "Kucharz postanowił <w>nadziać</w> kurczaka suszonymi śliwkami.",
                            "target_lang_translations": {
                                "en": "The chef decided to <w>stuff</w> the chicken with dried plums."
                            }
                        }
                    ],
                    "synonyms": [
                        "napełnić",
                        "wypełnić"
                    ],
                    "common_phrases": [
                        "nadziać paprykę",
                        "nadziać kurczaka"
                    ],
                    "target_lang_definitions": {
                        "en": "To fill the inside of something with a mixture or food products"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stuff",
                                "target_lang_sense_clarification": "filling food with a mixture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40f2b550-3435-3a55-9d44-c24cbf07f049",
                    "sense_definition": "przebić coś ostrym przedmiotem",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przebijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trzeba <w>nadziać</w> kawałki mięsa na metalowy szpikulec do szaszłyków.",
                            "target_lang_translations": {
                                "en": "You need to <w>skewer</w> the pieces of meat onto a metal kebab stick."
                            }
                        },
                        {
                            "text": "Kucharz ostrożnie <w>nadział</w> oliwkę na wykałaczkę.",
                            "target_lang_translations": {
                                "en": "The chef carefully <w>skewered</w> an olive onto a toothpick."
                            }
                        }
                    ],
                    "synonyms": [
                        "nakłuć"
                    ],
                    "common_phrases": [
                        "nadziać na szpikulec"
                    ],
                    "target_lang_definitions": {
                        "en": "To pierce something with a sharp object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to skewer",
                                "target_lang_sense_clarification": "piercing food with a stick or rod"
                            },
                            {
                                "target_lang_word": "to impale",
                                "target_lang_sense_clarification": "piercing something with a sharp point"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed14457a-be37-3774-b36b-2d52cdb47a22",
                    "sense_definition": "przypadkowo wbić się na ostry przedmiot",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "przebijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biegł tak szybko, że <w>nadział</w> się na wystający z płotu gwóźdź.",
                            "target_lang_translations": {
                                "en": "He was running so fast that he <w>impaled himself</w> on a nail sticking out of the fence."
                            }
                        },
                        {
                            "text": "Uważaj, żebyś nie <w>nadział</w> się na kolce tej róży.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>impale yourself</w> on the thorns of this rose."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To accidentally run into or get stuck on a sharp object"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to impale oneself",
                                "target_lang_sense_clarification": "accidentally getting pierced by a sharp object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea925323-22da-3a5c-814e-fe2a56f70976",
                    "sense_definition": "nieoczekiwanie na kogoś lub coś trafić",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spotkanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wychodząc z domu, <w>nadziałem</w> się na sąsiada, który chciał ze mną rozmawiać.",
                            "target_lang_translations": {
                                "en": "Leaving the house, I <w>ran into</w> my neighbor who wanted to talk to me."
                            }
                        },
                        {
                            "text": "W sklepie <w>nadziałem</w> się na kontrolę biletów.",
                            "target_lang_translations": {
                                "en": "At the store, I <w>ran into</w> a ticket inspection."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To unexpectedly encounter someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to run into",
                                "target_lang_sense_clarification": "meeting someone unexpectedly"
                            },
                            {
                                "target_lang_word": "to bump into",
                                "target_lang_sense_clarification": "encountering something or someone by chance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}