                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ce768dd-65e9-3fac-aed4-9c3a6c5b7d21",
                        "entry_id": "a44af661-f3ed-3a69-87fb-dd04fc3767c7",
                        "glosses": [
                            "levenshouding van iemand die zijn handelwijze laat bepalen door de belangen van anderen"
                        ],
                        "tags": [],
