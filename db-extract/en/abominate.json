                        "entry_id": "5f162215-093c-304a-8d62-13700448f3d8",
                        "glosses": [
                            "To feel disgust towards; to loathe or detest thoroughly; to hate in the highest degree, as if with religious dread."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f702a252-c70b-451d-911a-46aa72f3f861",
                                "sense_id": "be3d745c-3c80-38f7-84a6-80daba156fd9",
                                "text": "\"Much as I abominate writing, I would not give up Mr. Collins's correspondence for any consideration.\""
                            }
                        ]
                    },
