                        "glosses": [
                            "Synonym of tagetes (“individual plant of the genus Tagetes”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4e9260-3657-4d87-bfba-e5e5f1413f83",
                                "sense_id": "bb0a1794-c88e-3189-9fa6-c4853ebc7c6d",
                                "text": "The wound was washed with the juice of a young green coconut, sutured with a fine coconut fibre using the sharpened wing bone of a flying fox and then dressed with a \"tagete\" leaf over which was laid the outer layer of a banana flower. The whole was then sealed from the air with a mixture of pepper, lime and young betel nut chewed together. Mrs. Parkinson said she knew a man who had lived for thirty years after this operation, but she thought this was exceptional."
                            },
                            {
                                "example_id": "d0f79dca-3280-4b43-bcd4-b43eb34e7cb6",
                                "sense_id": "bb0a1794-c88e-3189-9fa6-c4853ebc7c6d",
                                "text": "[…] The little girl wears a white death mask and holds a tagete (sunflower):"
                            },
                            {
                                "example_id": "820230fb-d03d-4a4c-9bc3-a7a010fd77eb",
                                "sense_id": "bb0a1794-c88e-3189-9fa6-c4853ebc7c6d",
                                "text": "\"She would no more confuse a calendula with a tagete than you'd mistake a water gun for a pistol.\""
                            }
                        ]
                    }
