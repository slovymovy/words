                                                "example_id": "1ed2d65b-9b87-4ca0-a79b-d00a4cb2ca23",
                                                "sense_id": "94cba287-b827-37a9-b767-07d41f87df8f",
                                                "text": "Nachdem Nicole ihrer Freundin per WhatsApp von ihrem Missgeschick mit dem Eimer Wandfarbe berichtet hatte, antwortete diese mit „Hihi!“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
