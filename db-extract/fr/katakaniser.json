                "senses": [
                    {
                        "sense_id": "6cf4cdee-24ec-34ab-adef-6d888cee714b",
                        "entry_id": "f72203d2-282a-3722-be49-25d0c9175ab5",
                        "glosses": [
                            "Transcrire un mot non-japonais en katakanas ou le prononcer à la japonaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f751572-2d2d-453b-98f4-0b0867b64c1a",
                                "sense_id": "6cf4cdee-24ec-34ab-adef-6d888cee714b",
                                "text": "Vous avez appris récemment à katakaniser les noms étrangers."
                            },
                            {
                                "example_id": "4e5f38da-3e2e-4c0b-ae4c-830f7c096961",
                                "sense_id": "6cf4cdee-24ec-34ab-adef-6d888cee714b",
                                "text": "[…] ce serait dommage que le japonais finisse en \"anglais katakanisé\" […]"
                            },
                            {
                                "example_id": "118ae19d-ded7-4a58-96e0-a03e7c2fe312",
                                "sense_id": "6cf4cdee-24ec-34ab-adef-6d888cee714b",
                                "text": "Ils ont pas adopté l'anglais katakanisé pour tout, et on peut même tomber sur 正弦 et 余弦 (respectivement sinus et cosinus)."
                            }
                        ]
                    }
