                    {
                        "sense_id": "91b56531-e7c1-38f8-aafd-7f95d32ee8a6",
                        "entry_id": "164b3662-c7ce-3740-becf-585623598c6f",
                        "glosses": [
                            "Handlung, etwas zu verleihen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6b35e3-fdd9-4476-8d52-c6ff87ba4975",
                                "sense_id": "91b56531-e7c1-38f8-aafd-7f95d32ee8a6",
                                "text": "„In jeder Bibliothek gehen Dinge verloren durch falsche Katalogisierung oder Einordnung, durch Verleih, durch Unachtsamkeit oder Diebstahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51d0a0cd-c187-3db1-a137-a0b8a98100ab",
                        "entry_id": "164b3662-c7ce-3740-becf-585623598c6f",
                        "glosses": [
                            "Unternehmen, das gegen Bezahlung etwas für eine bestimmte Zeit verleiht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9abb34c-2480-4bc4-a05b-434d591d994b",
                                "sense_id": "51d0a0cd-c187-3db1-a137-a0b8a98100ab",
                                "text": "„Ich gab den Wagen beim Verleih zurück, dann verbrachte ich den Tag mit ihnen am Pool.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b68b6d7-d8d1-472b-b98f-961dcf577203",
                        "source_entry_id": "164b3662-c7ce-3740-becf-585623598c6f",
                        "source_sense_id": "51d0a0cd-c187-3db1-a137-a0b8a98100ab",
                        "source_sense_description": "Wirtschaft: Unternehmen, das gegen Bezahlung etwas für eine bestimmte Zeit verleiht",
                        "target_lang_word": "rental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                                        "glosses": [
                                            "Something that is rented."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aecac82-36a4-4518-87bb-5542b37efb93",
                                                "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                                                "text": "It's just a rental, so I don't need to take very good care of it."
                                            },
                                            {
                                                "example_id": "df180730-06bc-4f29-9ba8-404de780b5bb",
                                                "sense_id": "27582955-a074-3706-8826-8d5f718b790b",
                                                "text": "Furthermore, whilst we would have been pleased to have been able to give you some quoteworthy examples of men cruelly dominating the choice of video movie rentals, these simply did not appear in the diaries either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbf7b2bc-00a2-3e34-92cb-0d3947b97e62",
                                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                                        "glosses": [
                                            "The payment made to rent something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feb2229b-5f78-45fa-9811-7882d32f0213",
                                                "sense_id": "cbf7b2bc-00a2-3e34-92cb-0d3947b97e62",
                                                "text": "On a grass roots level we are making the film available at a nominal rental to gay organizations, student groups, and religious affiliates so that gay people and their straight friends can see GAY USA now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4647da-e8e5-3805-8e04-8216407e0db7",
                                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                                        "glosses": [
                                            "A business that rents out something to its customers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "519616a5-36c6-3a29-9b23-125ad20f965f",
                                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                                        "glosses": [
                                            "An act of renting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a147a19b-192b-3128-a303-315a45aaf471",
                                        "entry_id": "38b2fb7f-453f-3fd1-9d4f-65159901bf20",
                                        "glosses": [
                                            "A player traded to a team with a year or less on his contract"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91c45727-d814-4448-ab0f-2e93ee3aa643",
                                                "sense_id": "a147a19b-192b-3128-a303-315a45aaf471",
                                                "text": "[When the trade deadline approaches], Everyone wants to talk about which preening millionaire is going to be shipped out of town because he can't get along with his GM, or what veteran is going to finally get a shot at a Cup, or which guy is going to a contender as a \"rental.\" Sure, it's gossip. Is that so wrong?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
