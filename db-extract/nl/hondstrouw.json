                        "examples": [
                            {
                                "example_id": "d64a2964-5205-4639-895b-0f6d1c9dcd92",
                                "sense_id": "41a9336d-8ccf-3147-8312-185017c056c1",
                                "text": "De Volksrepubliek is mede daarom hondstrouw aan het diplomatieke beginsel dat je je niet met de binnenlandse aangelegenheden van een ander land bemoeit."
                            },
                            {
                                "example_id": "c69c4b78-9336-4e7a-8139-822f43fae608",
                                "sense_id": "41a9336d-8ccf-3147-8312-185017c056c1",
                                "text": "\"In de liefde ben ik hondstrouw aan Johanna. In de seks niet. Ik maak een onderscheid. Maar ik loop er absoluut de kantjes niet af. En de uitglijers zijn op de vingers van één hand te tellen?\""
                            }
                        ]
                    }
