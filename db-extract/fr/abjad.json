            {
                "entry_id": "12dee4ec-ce55-3725-ab03-7ee61270b439",
                "word": "abjad",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30690091-91a6-4ad8-85c9-9fce75852a87",
                        "entry_id": "12dee4ec-ce55-3725-ab03-7ee61270b439",
                        "tags": [
                            "plural"
                        ],
                        "form": "abjads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e93a9acb-8826-3696-bc9e-8b4d8ffd7fb5",
                        "entry_id": "12dee4ec-ce55-3725-ab03-7ee61270b439",
                        "glosses": [
                            "Alphabet consonantique, c’est-à-dire privilégiant la notation des consonnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bd2b50-fa96-4984-8bcf-906be57aea23",
                                "sense_id": "e93a9acb-8826-3696-bc9e-8b4d8ffd7fb5",
                                "text": "L’alphabet arabe et l’alphabet hébreu sont des abjads."
                            },
                            {
                                "example_id": "41f87426-bffe-4a89-86bd-20de9ebc3533",
                                "sense_id": "e93a9acb-8826-3696-bc9e-8b4d8ffd7fb5",
                                "text": "Les musulmans adoptèrent l'abjad du monde préislamique, aménagement de l'alphabet attribuant une valeur numérique, de un à mille, aux consonnes de l'arabe. L'assignation des valeurs numériques suit un ordre, non alphabétique, qui forge huit mots, dont le premier est abjad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c90784dd-d2a2-4d42-9bd9-3fbbbef93d29",
                        "source_entry_id": "12dee4ec-ce55-3725-ab03-7ee61270b439",
                        "source_sense_id": "e93a9acb-8826-3696-bc9e-8b4d8ffd7fb5",
                        "target_lang_word": "Abdschad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abdschad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fd2ff03-cb12-3f56-8372-e025409f3319",
                                        "entry_id": "483b71a7-161b-3f05-9bfe-602f051547e2",
                                        "glosses": [
                                            "Schriftsystem, in dem nur oder primär Zeichen für Konsonanten verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09577389-94e9-46cd-8c55-7852d29374ec",
                                                "sense_id": "4fd2ff03-cb12-3f56-8372-e025409f3319",
                                                "text": "„Sie heißen denn auch Konsonantenschriften oder Abdschads, und von den heute verwendeten Exemplaren sind die arabische und die hebräische Schrift die bekanntesten.“"
                                            },
                                            {
                                                "example_id": "2a7f1caa-427e-4dda-807a-81f500fa5377",
                                                "sense_id": "4fd2ff03-cb12-3f56-8372-e025409f3319",
                                                "text": "„Letztlich von den ägyptischen Hieroglyphen abgeleitet, wurde das phönizische Abdschad im 9. Jahrhundert v.u.Z. von den alten Griechen übernommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0be5080e-f3ac-3434-b85a-6ebc45b92d40",
                                        "entry_id": "483b71a7-161b-3f05-9bfe-602f051547e2",
                                        "glosses": [
                                            "historisches Zahlensystem, in dem arabischen Buchstaben Zahlenwerte zugeordnet wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84451608-7e81-47fe-b826-7b53adee3c53",
                                                "sense_id": "0be5080e-f3ac-3434-b85a-6ebc45b92d40",
                                                "text": "„Laut dem Abdschad, dem alphabetischen Zahlensystem der Araber, entspricht dem Wort ‚Allah‘ die Zahl 66.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3523d4be-0eae-4aa7-85ce-47857fe437eb",
                        "source_entry_id": "12dee4ec-ce55-3725-ab03-7ee61270b439",
                        "source_sense_id": "e93a9acb-8826-3696-bc9e-8b4d8ffd7fb5",
                        "target_lang_word": "abjad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abjad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "876ef773-10b2-38d9-ad4d-40ef42aa7dd6",
                                        "entry_id": "f1628a15-abfe-39e3-b04d-62b2831994bf",
                                        "glosses": [
                                            "A writing system for Arabic, historically also employed as a numeral system, in which there is one glyph (symbol or letter) for each consonant but vowels are not specified."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a651c795-b67f-4c82-8a85-b38bcd64857c",
                                                "sense_id": "876ef773-10b2-38d9-ad4d-40ef42aa7dd6",
                                                "text": "In Rabghuzi's Stories of the Prophets, a teacher asked Jesus, who was seven years old at the time, to repeat the alphabet and the abjad by rote."
                                            },
                                            {
                                                "example_id": "ea00df41-540d-4a55-b51c-4ab2063ad576",
                                                "sense_id": "876ef773-10b2-38d9-ad4d-40ef42aa7dd6",
                                                "text": "Abjad is the writing system used in this book, and it's also the writing system used throughout the Arabic world. For instance, most newspapers you pick up in the Middle East use the abjad writing system, whereby the consonants are included but not the vowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036dc7ef-53b3-32df-a733-be7dbc6dba38",
                                        "entry_id": "f1628a15-abfe-39e3-b04d-62b2831994bf",
                                        "glosses": [
                                            "Any writing system in which glyphs are used to represent consonants or consonantal phonemes, but not vowels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f570eb4-3a4e-47f1-a691-79aa3d9b2827",
                                                "sense_id": "036dc7ef-53b3-32df-a733-be7dbc6dba38",
                                                "text": "Languages that use abjads include Arabic, Hebrew, Persian, and Urdu. Abjads differ from syllabaries (such as the Japanese hiragana) in that the vowel quality of each letter is left unspecified, and must be inferred from context and grammar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a823f7-ce60-353c-afee-340233305fd8",
                                        "entry_id": "f1628a15-abfe-39e3-b04d-62b2831994bf",
                                        "glosses": [
                                            "The system of abjad numerals; a numeral system in which the letters of the Arabic abjad are interpreted as numerals, typically used to enumerate lists and nested lists, as well as in numerology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db92ba3-36a5-4ade-8677-9864fb6dccb6",
                                                "sense_id": "33a823f7-ce60-353c-afee-340233305fd8",
                                                "text": "1971, Mohibbul Hasan, History of Tipu Sultan, Aakar Books, 2nd Edition, 2005 Reprint, page 399,\nThe other names had no significance, except that the initial letter of each month denoted its place in the calendar according to the abjad system, which assigned a certain numerical power to every letter in the alphabet."
                                            },
                                            {
                                                "example_id": "5bc28d32-15f2-44e8-87e5-a505988b56ef",
                                                "sense_id": "33a823f7-ce60-353c-afee-340233305fd8",
                                                "text": "As Islam spread eastward throughout the eighth century AD as far as the Indus River, the Indian style of numeration began to diffuse westward and supplant the Arabic abjad, which itself was still a novelty in western regions such as North Africa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
