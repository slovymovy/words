                ],
                "senses": [
                    {
                        "sense_id": "abefcc69-44fc-3406-a115-2219b1207f95",
                        "entry_id": "c87bc699-71e0-3ce9-acff-e42a64aab7d1",
                        "glosses": [
                            "Fortbewegung mit einem Fahrzeug auf der Wasseroberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea24df63-c104-4a39-8b0d-7027288d95d2",
                                "sense_id": "abefcc69-44fc-3406-a115-2219b1207f95",
                                "text": "„Bei Überwasserfahrt sind sie geflutet und geben dem Boot zusätzliches Gewicht, das mithilft, die Oberflächenspannung beim Tauchen schnell zu überwinden.“"
                            },
                            {
                                "example_id": "71bb1d4c-bb44-4a52-896a-3391bb5263f4",
                                "sense_id": "abefcc69-44fc-3406-a115-2219b1207f95",
                                "text": "„Die Vorteile dieser Boote wurden schnell deutlich, denn sie wurden insbesondere in einer verbesserten Seetauglichkeit bei Überwasserfahrt sichtbar und boten darüber hinaus auch eine wesentlich erhöhte Stabilität des Rumpfes und der Druckkörperhülle.“"
                            },
                            {
                                "example_id": "b92d02da-1fb6-4089-8fce-f246b55529d0",
                                "sense_id": "abefcc69-44fc-3406-a115-2219b1207f95",
                                "text": "„Ein herkömmliches U-Boot hingegen wird bei der Überwasserfahrt durch Dieselmotoren und bei Unterwasserfahrten durch Elektromotoren angetrieben.“"
                            },
                            {
                                "example_id": "c2420c98-9659-4e08-914c-7cfbeb0b9d3b",
                                "sense_id": "abefcc69-44fc-3406-a115-2219b1207f95",
                                "text": "„Die E-Maschine mit einer Leistung von 18,4 kW arbeitete bei Überwasserfahrt als Generator und lud die Batterien auf, unter Wasser fungierte sie als Antriebsmotor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
