                        ],
                        "form": "die Waldes"
                    },
                    {
                        "form_id": "1035b1af-79b7-47cb-9ff3-53565bc39501",
                        "entry_id": "13eaa318-b07b-38ac-9d6a-2747ecbc1e72",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Walde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                        "entry_id": "13eaa318-b07b-38ac-9d6a-2747ecbc1e72",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e8e8f5-31ae-4ea0-8972-9dd9e603526d",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Frau Walde ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "afb7c0d7-8951-4c60-83b6-d70a5fcefaa5",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Herr Walde wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d6efda7-7771-46fd-9ba6-b44f5a4eee98",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Die Waldes kommen heute aus Wesel."
                            },
                            {
                                "example_id": "ecf9454e-791d-4464-a0b2-773ef51ba811",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Der Walde trägt nie die Schals, die die Walde ihm strickt."
                            },
                            {
                                "example_id": "cd972d01-7a56-4d81-a5d7-4e085fd1ce93",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Walde kommt, geht der Herr Walde.“"
                            },
                            {
                                "example_id": "7f8cf724-7175-4b2f-861e-8689c0ec9347",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Walde kommt und geht."
                            },
                            {
                                "example_id": "9d0b248d-eb88-44c9-8fba-c2d034e332c1",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "Waldes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d7b6f34f-bdfc-4c6f-a1c5-9e779e2465bd",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "An verregneten Herbsttagen ist Familie Waldes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "3ea944fb-1cd0-4456-be64-7546b8e652e2",
                                "sense_id": "618dcf0b-a8ae-3665-a02f-c5a85100ebf5",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Walde das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
