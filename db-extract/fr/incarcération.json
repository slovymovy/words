                "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                "word": "incarcération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b7742fa-3cb8-4e2d-a1ba-287f151bbbaf",
                        "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                        "tags": [
