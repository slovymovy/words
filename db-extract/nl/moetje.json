                ],
                "senses": [
                    {
                        "sense_id": "f3e15be3-b46e-3d43-ad2b-bd7d359312de",
                        "entry_id": "24a220df-7110-36e2-b75e-4f8c3069bf40",
                        "glosses": [
                            "huwelijk ingegeven door een onvoorziene zwangerschap"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "1798efea-37d6-4f11-a12d-17d50d55ba91",
                                "sense_id": "f3e15be3-b46e-3d43-ad2b-bd7d359312de",
                                "text": "De geboorte van hun dochter na zeven maanden liet zien dat het een moetje geweest was."
                            }
                        ]
                    },
                    {
                        "sense_id": "29e063e0-b926-3d08-95ae-18d053906032",
                        "entry_id": "24a220df-7110-36e2-b75e-4f8c3069bf40",
                        "glosses": [
                            "verplichting, taak ingegeven door onvoorziene omstandigheden"
                        ],
                        "tags": [
                            "humorous",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1ea2db90-0617-4be9-baa2-af41f6850a4e",
                                "sense_id": "29e063e0-b926-3d08-95ae-18d053906032",
                                "text": "Vindt u het wel leuk om hier te zijn, of is het een moetje? Waarom investeert u niet persoonlijk in het stadion? Waarom was u eerst niet aanwezig en nu ineens wel?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b7281684-eb53-30d4-a12e-ad9523e7ae00",
                        "entry_id": "24a220df-7110-36e2-b75e-4f8c3069bf40",
                        "glosses": [
                            "samenwerking van partijen, bedrijven e.d. ingegeven door onvoorziene omstandigheden"
                        ],
                        "tags": [
                            "humorous",
                            "vernacular"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c50e0ff0-5c2c-4f55-bca4-adfa0b3d0e64",
                        "source_entry_id": "24a220df-7110-36e2-b75e-4f8c3069bf40",
                        "source_sense_id": "f3e15be3-b46e-3d43-ad2b-bd7d359312de",
                        "source_sense_description": "huwelijk ingegeven door zwangerschap",
                        "target_lang_word": "Traufe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Traufe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59c2daa1-0ef9-302f-b2d8-6d1bce5f31fe",
                                        "entry_id": "63ca7823-1270-36d4-8b55-f1b0ae6dbb37",
                                        "glosses": [
                                            "der Rand des Dachs eines Gebäudes; die Tropfkante, unter welcher häufig eine Dachrinne angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf88a7c-b038-45ce-858f-d638f964910b",
                                                "sense_id": "59c2daa1-0ef9-302f-b2d8-6d1bce5f31fe",
                                                "text": "Der Regen tropfte mir von der Traufe des Scheunendachs in den Kragen."
                                            },
                                            {
                                                "example_id": "fc39a808-3658-42ef-80ca-40c8a7642e6e",
                                                "sense_id": "59c2daa1-0ef9-302f-b2d8-6d1bce5f31fe",
                                                "text": "„Die Komödie lässt den armen Tropf neben all den glücklichen Paaren nicht nur im Regen stehen, sondern tunkt ihn in die Traufe des Wahnsinns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                        "entry_id": "63ca7823-1270-36d4-8b55-f1b0ae6dbb37",
                                        "glosses": [
                                            "kombinierte Feier einer Trauung und einer Taufe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad21213-b6b3-427c-a03b-69a6a274b7d3",
                                                "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                                "text": "„Aus der Perspektive des Pfarrpersonals ist klar, dass eine Traufe zwei unterschiedliche Kasualien von ebenfalls unterschiedlich hohem theologischen Gewicht in einem Gottesdienst zusammenbringt.“"
                                            },
                                            {
                                                "example_id": "af2707f3-14e6-44b4-a723-14bb1994fe20",
                                                "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                                "text": "„Der inzwischen häufige praktizierte Brauch einer ‚Traufe‘, Verbindung von Trauung und Taufe würde diese Annahme stützen.“"
                                            },
                                            {
                                                "example_id": "fbda18da-d6b6-4b69-be21-29cdebf4b502",
                                                "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                                "text": "„Die Traufe ist eine Verschmelzung der Wörter Trauung und Taufe, was bedeutet, dass die beiden Feierlichkeiten in einer Zeremonie vereint werden.“"
                                            },
                                            {
                                                "example_id": "a7a4b952-9e52-4369-9355-92310245674e",
                                                "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                                "text": "„Eine junge Frau möchte eine ‚Traufe‘, also eine kirchliche Trauung mit der Taufe des Babys des Paares.“"
                                            },
                                            {
                                                "example_id": "13f985de-d019-49ef-8ea2-12c5c51aac8a",
                                                "sense_id": "95b508fe-259e-3112-acfe-944e8c15b446",
                                                "text": "„Vor diesem Hintergrund war es für die Familie nicht schlimm, ihre ‚Traufe‘ aufgrund von Corona zu verschieben: ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
