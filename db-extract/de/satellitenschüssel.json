                "senses": [
                    {
                        "sense_id": "a73549f1-3a6f-3d59-ab22-ed6f4347eafd",
                        "entry_id": "67ff4eac-9b48-357f-8a57-806459d22862",
                        "glosses": [
                            "Parabolantenne zum Empfang von Radio- und Fernsehprogrammen, die von einem Satelliten abgestrahlt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7201e900-bcad-4a45-a768-2ae8ed7ce5d0",
                                "sense_id": "a73549f1-3a6f-3d59-ab22-ed6f4347eafd",
                                "text": "„Außerdem muss die Satellitenschüssel über ein digitaltaugliches Empfangsteil, den Universal-LNB (Low Noise Block), verfügen.“"
                            },
                            {
                                "example_id": "36544762-addf-43b2-b010-48b853870117",
                                "sense_id": "a73549f1-3a6f-3d59-ab22-ed6f4347eafd",
                                "text": "„Dieser Ratgeber zeigt Ihnen, welche Sender Sie empfangen, wie Sie Ihre Satellitenschüssel richtig ausrichten und wie Sie mit Sat-IP Fernsehen im ganzen Haus haben.“"
                            },
                            {
                                "example_id": "c7d97a61-aa15-4105-b882-7fdf6569d550",
                                "sense_id": "a73549f1-3a6f-3d59-ab22-ed6f4347eafd",
                                "text": "„Im ersten Stock war eine Satellitenschüssel an der Wand befestigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
