                "senses": [
                    {
                        "sense_id": "6297ec2b-6637-361e-afb5-922d35d03976",
                        "entry_id": "2b4689ca-e4b7-3a67-b7e3-2096d5a9f288",
                        "glosses": [
                            "Réaliser l’éviction de (quelqu’un)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "267f6901-1a9d-4e60-a2db-a9dd18542b78",
                                "sense_id": "6297ec2b-6637-361e-afb5-922d35d03976",
                                "text": "WoW faut payer pour évicter les hackers..."
                            },
                            {
                                "example_id": "dbf26a49-298e-4215-969c-8a1915269643",
                                "sense_id": "6297ec2b-6637-361e-afb5-922d35d03976",
                                "text": "Il ne parlait de rien moins que de refuser de payer le fermage et de se laisser évicter."
                            },
                            {
                                "example_id": "433fce8f-2f76-4f09-bd7a-1a15c9256520",
                                "sense_id": "6297ec2b-6637-361e-afb5-922d35d03976",
                                "text": "Et du coup... je me souviens avoir souvent lu que jamais une COA 0.0 ne pourrait évicter les (gros) résidents de WH, et que toute guerre contre ces entités expérimentées dans l'art de la défense en systèmes solaires inconnus, serait vouée à l'échec."
                            }
                        ]
                    }
