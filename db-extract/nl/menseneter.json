        "nl-extract.jsonl": [
            {
                "entry_id": "92efb492-4537-39c2-8235-e270ceae43b0",
                "word": "menseneter",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c9c82c5a-cd8d-4737-a1f7-4f6ed65900b6",
                        "entry_id": "92efb492-4537-39c2-8235-e270ceae43b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "menseneters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4dc15dca-cc18-34a8-b93b-9528ce907d9a",
                        "entry_id": "92efb492-4537-39c2-8235-e270ceae43b0",
                        "glosses": [
                            "iets of iemand die mensen eet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d03ac2-fe1c-4e8b-acd1-777ee3de504d",
                                "sense_id": "4dc15dca-cc18-34a8-b93b-9528ce907d9a",
                                "text": "Het aftandse gebit en de onverteerbare sieraden vormen het bewijs dat de krokodil een oude menseneter was. Met een diameter van 41 tot 65 millimeter (gemiddeld 53,6) geven de polsbanden een mooi beeld van de prooigrootte."
                            },
                            {
                                "example_id": "db5cd9a2-ffcf-4d7b-9891-04383dde4fc3",
                                "sense_id": "4dc15dca-cc18-34a8-b93b-9528ce907d9a",
                                "text": "Vijftienduizend jaar geleden was een grot in Somerset bewoond door menseneters. Al aten ze mensenvlees eerder als ritueel dan omdat ze het lekker vonden."
                            },
                            {
                                "example_id": "4b51e824-372f-4179-b6bf-e9152822cad2",
                                "sense_id": "4dc15dca-cc18-34a8-b93b-9528ce907d9a",
                                "text": "Lichtvoetig is de bundel Er was eens een vrouw die haar buurkind wilde doden niet. Integendeel, Petroesjevskaja's horrorstory's zijn beklemmend en griezelig, aan zombies en menseneters geen gebrek. De meeste spelen zich af in een post-apocalyptische wereld, die Ruslandgangers zullen herkennen als de late jaren tachtig en begin jaren negentig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a084e47-5798-449b-8899-1fe31e440d8b",
                        "source_entry_id": "92efb492-4537-39c2-8235-e270ceae43b0",
                        "source_sense_id": "4dc15dca-cc18-34a8-b93b-9528ce907d9a",
                        "target_lang_word": "cannibal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannibal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                        "entry_id": "0bdd6e9c-e92e-30d4-ba6e-3ca7bd91a0ef",
                                        "glosses": [
                                            "An organism which eats others of its own or similar species or kind, especially a human or other human-like creature such as a zombie who consumes human flesh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69a9294-32a3-456d-bf61-0c0aea94b58e",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "These insects were not uncommon beneath stones. I found one cannibal scorpion quietly devouring another."
                                            },
                                            {
                                                "example_id": "6b5ddb7c-df61-474a-9217-4182bb505722",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "Up the cave I went, and after me came the others, and after them thundered the whole crowd of cannibals, mad with fury at the death of the woman."
                                            },
                                            {
                                                "example_id": "a3be2502-4108-4fbf-81a1-814d639f9bfe",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "[…] that the larvae of Thecla calanus is a cannibal, eating its weaker brethren when short of food."
                                            },
                                            {
                                                "example_id": "ff40bc57-e571-4724-a3fa-9e3863617cf2",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "Quickly he learned their simple speech, their native customs, and the ethics of their wild, primitive tribal life. He found that they were not cannibals—that they looked with loathing and contempt upon men who ate men."
                                            },
                                            {
                                                "example_id": "1acafd73-f096-4a86-9dde-f807cd72c0dd",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "His expression slack, Green Spider methodically pried out another clod and swallowed it. “I'm a cannibal. Eating the Earth Mother. Chewing the flesh from her bones. Cannibal ... cannibal ... cannibal!” Otter tried to shake off his discomfort, […]"
                                            },
                                            {
                                                "example_id": "83825ef9-382a-42cd-a843-eb1aa28f71e0",
                                                "sense_id": "96cf1e8f-79ed-31b3-a74c-2d0dd6bc834e",
                                                "text": "Both authors quote Paul Graham[…]: “You could parachute him [Sam Altman] into an island full of cannibals and come back in five years and he'd be the king.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b920cbb-872e-35c3-bdb3-e7bf1275c5aa",
                                        "entry_id": "0bdd6e9c-e92e-30d4-ba6e-3ca7bd91a0ef",
                                        "glosses": [
                                            "Ellipsis of cannibal boat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
