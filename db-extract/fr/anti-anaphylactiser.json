                ],
                "senses": [
                    {
                        "sense_id": "98d163b6-744c-3cd2-a46e-dc8145b280ed",
                        "entry_id": "2a1bac79-7bdb-3565-87c9-a6e5cb10edd2",
                        "glosses": [
                            "Désensibiliser à un antigène susceptible de provoquer un choc anaphylactique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2893ecce-c568-4538-988b-40fb398d9b23",
                                "sense_id": "98d163b6-744c-3cd2-a46e-dc8145b280ed",
                                "text": "Par contre, il réussit à anti-anaphylactiser des cobayes préalablement sensibilisés au lait par voie sous-cutanée en leur introduisant lavement 20 ce. de lait, ou 10 ce. dans l'estomac, (...)"
                            },
                            {
                                "example_id": "b83d624d-4e91-4820-9533-eb5cc22c5cb1",
                                "sense_id": "98d163b6-744c-3cd2-a46e-dc8145b280ed",
                                "text": "Méthode préconisée par Couder et nous-même : l'huile de paraffine pure à dose faible, (une demi-cuillerée à café au début et une au milieu de chaque repas), retarde l'absorption intestinale et permet à l'organisme de s'anti-anaphylactiser pendant le repas."
                            }
                        ]
                    }
                ],
