                "senses": [
                    {
                        "sense_id": "07767391-2fa5-3124-9b6f-097fd3d2a993",
                        "entry_id": "75a7d545-be53-344d-851a-62a52ef7350f",
                        "glosses": [
                            "биол., цитол. совокупность вспомогательных клеток нервной ткани, заполняющая всё пространство между нейронами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93f7032-9833-4adc-bbd6-8da74b1af0b9",
                                "sense_id": "07767391-2fa5-3124-9b6f-097fd3d2a993",
                                "text": "Нейроны с отростками окружены нейроглией и миелином, которые выполняют по отношению к нейрону опорную, защитную, трофическую функции. Микроглиальные клетки нейроглии являются представителями иммунной системы человека."
                            }
                        ]
                    }
                ],
