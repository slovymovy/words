                        "sense_id": "4f153e59-29fe-3ffc-ace1-37c6760e06f0",
                        "entry_id": "aa90d59a-4346-3fc9-9975-136c118bdf23",
                        "glosses": [
                            "Produit cosmétique qui réduit ou atténue les rides."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cde89531-5f56-493a-a574-62d44be8b5fa",
                                "sense_id": "4f153e59-29fe-3ffc-ace1-37c6760e06f0",
                                "text": "Selon des chercheurs canadiens, plusieurs cosmétiques, et spécialement des antirides, déclencheraient dans la peau des réactions pathologiques qui mériteraient beaucoup plus d’attention."
                            },
                            {
                                "example_id": "d459654f-5e09-4339-94e6-6e227b18b6d2",
                                "sense_id": "4f153e59-29fe-3ffc-ace1-37c6760e06f0",
                                "text": "Les cosmétiques, les antirides, les légers traitement esthétiques et la pensée magique ne suffisaient plus à masquer l’arrogance des années."
                            }
                        ]
                    }
