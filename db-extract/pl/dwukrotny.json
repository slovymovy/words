                                        "glosses": [
                                            "Having two parts, especially two different parts."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9e30cde-9f4f-4327-9ee5-4cd8948a8e86",
                                                "sense_id": "f09a9fcf-7d6a-3ebc-b5e8-29f37944986a",
                                                "text": "a twofold nature;  a twofold sense;  a twofold argument"
                                            },
                                            {
                                                "example_id": "65750663-1c7d-4236-8e22-de2b4fbf358e",
                                                "sense_id": "f09a9fcf-7d6a-3ebc-b5e8-29f37944986a",
                                                "text": "1874, Ernest Myers (transl.), The Extant Odes of Pindar, translated into English, Pythian Ode III, page 65.\nHad I but landed there and brought unto him a twofold joy, first golden health and next this my song of triumph to be a splendour in his Pythian crown […]"
                                            },
                                            {
                                                "example_id": "2cce5536-3587-4674-9fdc-bb582babc739",
                                                "sense_id": "f09a9fcf-7d6a-3ebc-b5e8-29f37944986a",
                                                "text": "It is the tale of Ixion's twofold guilt, unnatural murder and unlawful love."
                                            },
                                            {
                                                "example_id": "8a8c6ede-bb05-47aa-996d-bfa12ef79f57",
                                                "sense_id": "f09a9fcf-7d6a-3ebc-b5e8-29f37944986a",
                                                "text": "\"Wallace's suggestion for overcoming the epistemological and solipsistic effects of innate selfishness is twofold.\""
                                            }
                                        ]
                                    }
                                ]
