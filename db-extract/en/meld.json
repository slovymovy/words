                                        "examples": [
                                            {
                                                "example_id": "c6374712-33d5-4c1f-a41a-539300289b75",
                                                "sense_id": "439c248b-f783-3923-98ab-2e73f364aae0",
                                                "text": "De coach roemt de teamgeest van zijn ploeg."
                                            },
                                            {
                                                "example_id": "148fddc6-4ff7-4425-815d-16d2dadf45e7",
                                                "sense_id": "439c248b-f783-3923-98ab-2e73f364aae0",
                                                "text": "Medestanders roemen de stabiliteit sinds zijn aantreden, tegenstanders wijzen naar de aantasting van de persvrijheid."
