                        "glosses": [
                            "natürliche oder künstlich hergestellte Höhle, die von Menschen bewohnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6dac1e-b0fb-4f69-89fb-378a95e4e74e",
                                "sense_id": "5ede4c48-05b0-3b0a-9d65-db4bdccadab2",
                                "text": "„In dieser außerirdisch anmutenden Kulisse gab es Hunderte von winzigen Wohnhöhlen in den Hügeln, das Zuhause der Troglodyten im Süden von Tunesien.“"
                            },
                            {
                                "example_id": "43a76233-eb3c-4cb9-9512-6a006d89137b",
                                "sense_id": "5ede4c48-05b0-3b0a-9d65-db4bdccadab2",
                                "text": "„Er mußte so schnell wie möglich in die Wohnhöhle transportiert werden.“"
                            }
                        ],
