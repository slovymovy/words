                    {
                        "translation_id": "cdbfadb9-ff73-4241-8b9c-f3f0f9cb4fa6",
                        "source_entry_id": "8b104734-016e-3445-b37f-b1ee2be6ca05",
                        "source_sense_id": "e0adfb19-49af-3e11-8628-04c5f4b4f0cc",
