                ],
                "senses": [
                    {
                        "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                        "entry_id": "5cf2cf47-5784-31b7-99de-91097253a53e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d796cb-9da4-4c55-a5ab-a72779bac07d",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Herr Frankle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3a1a9bc7-b3b2-43eb-b23a-462eaaf8beb3",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Die Frankles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c0ffcee0-29c0-4cf1-8bf9-daddee09232d",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Frau Frankle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bd7ee47f-630b-4131-8bcc-da1d2ef7efc4",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Der Frankle trägt nie die Schals, die die Frankle ihm strickt."
                            },
                            {
                                "example_id": "13660aeb-0880-47e4-9b68-132d008de11d",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frankle kommt, geht der Herr Frankle.“"
                            },
                            {
                                "example_id": "06cfaad9-652b-41c7-a8ad-d37e286abd3f",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Frankle kommt und geht."
                            },
                            {
                                "example_id": "b8bacb67-f9cc-4257-a20f-25477ee7c45c",
                                "sense_id": "811fedae-dbfc-3260-8acc-6f3c69d1222d",
                                "text": "Frankles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
