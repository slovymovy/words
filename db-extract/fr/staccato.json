                    {
                        "translation_id": "f02c1fef-d985-4f29-9ae3-f2265e76bb55",
                        "source_entry_id": "a4bb0088-60ac-34ca-bff6-05618877331d",
                        "source_sense_id": "86acef73-cb3b-3405-955c-9bb7397d56b1",
                        "target_lang_word": "staccato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8ff1e6-a2cf-36bc-8fea-bfae48ec60f2",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "An articulation marking directing that a note or passage of notes are to be played in an abruptly disconnected manner, with each note sounding for a very short duration, and a short break lasting until the sounding of the next note; as opposed to legato. Staccato is indicated by a dot directly above or below the notehead."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3115d652-0354-3220-989f-d329c82cf180",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "A passage having this mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                        "entry_id": "3295d2e5-1625-3d55-8880-8686c5a69e3e",
                                        "glosses": [
                                            "Any sound resembling a musical staccato."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b0a382-4148-4470-aeb8-f0d4d190b59f",
                                                "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                                "text": "According to the syllable-timed hypothesis, Spanish syllables as staccato."
                                            },
                                            {
                                                "example_id": "67533af7-86c9-4316-ad22-57f0ca8c08b8",
                                                "sense_id": "e4ac6e1b-66bf-3f5b-b306-aca2951cd83f",
                                                "text": "The tumultuous noise resolved itself now into the disorderly mingling of many voices, the gride of many wheels, the creaking of waggons, and the staccato of hoofs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95ca6677-c5df-3356-94cb-ee7364052f7a",
                                        "entry_id": "c43f5264-7e59-3352-91e9-b5a43ae48600",
                                        "glosses": [
                                            "played in this style"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dddef3a-a975-4456-9b55-22edec0d57a9",
                                                "sense_id": "95ca6677-c5df-3356-94cb-ee7364052f7a",
                                                "text": "Now, play the same passage very staccato."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "staccato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07838d16-0376-35fc-9251-771d54656f0c",
                                        "entry_id": "c16d7eb7-5d0c-3d49-a3a1-0b059c05f22a",
                                        "glosses": [
                                            "Describing a passage having this mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                        "entry_id": "c16d7eb7-5d0c-3d49-a3a1-0b059c05f22a",
                                        "glosses": [
                                            "Made up of abruptly disconnected parts or sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1833f7a9-e7d0-43e6-97f0-578e341c388f",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "The same nervous staccato laugh broke from her thin lips, and her fingers began to play with a long tortoise-shell paper-knife."
                                            },
                                            {
                                                "example_id": "ba371e1f-085e-4ca9-a089-229407ca4273",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "A kind of tense peace, like the centre of a cyclone, descended. Not for long, of course, for already stealing upon one's hearing would be the staccato bark and thrust of the banker bringing up the rear."
                                            },
                                            {
                                                "example_id": "f9756124-6819-4820-af6a-4c392f26613e",
                                                "sense_id": "632f1ebb-7c7b-399a-934c-2c7a02e52044",
                                                "text": "The water-level route, the whistle and the loud staccato exhaust of this great engine recalled most vividly memories of the New York Central Hudsons highballing along the Hudson River between Harmon and Albany!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
