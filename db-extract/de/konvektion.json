                    {
                        "sense_id": "902d0744-461e-363c-a877-960a0bf00f77",
                        "entry_id": "f7d55366-67db-3edd-b16f-001968a57546",
                        "glosses": [
                            "vertikale (aufwärts- oder abwärtsgerichtete) Luftströmung; Austausch von verschieden temperierten Luftmassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e78525-d39b-4d94-90ca-07b6ac911eae",
                                "sense_id": "902d0744-461e-363c-a877-960a0bf00f77",
                                "text": "„Oft kommt die Bewegung aber auch durch die Dichteänderungen der erwärmten Körper zustande (Auftriebskraft). In diesem Fall spricht man von freier Konvektion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e9da741-3776-3316-8c05-e4a94c385c61",
                        "entry_id": "f7d55366-67db-3edd-b16f-001968a57546",
                        "glosses": [
                            "Strömungsbewegung in einem flüssigen Medium"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d9b6fa61-7b97-31cb-bc67-110a9862f8b7",
                        "entry_id": "f7d55366-67db-3edd-b16f-001968a57546",
                        "glosses": [
                            "Transport von Energie oder elektrischer Ladung durch bewegte kleinste Teilchen"
                        ],
                        "tags": [],
