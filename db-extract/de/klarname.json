                        ],
                        "form": "die Klarnamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf3aedb8-c901-3b9f-aa5d-4ac182cbbf75",
                        "entry_id": "634db169-4860-3fc5-98e1-f2a8a91248ce",
                        "glosses": [
                            "tatsächlicher, in der Regel amtlich verbriefter, bürgerlicher Name einer natürlichen Person"
                        ],
                        "tags": [
                            "Netzjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "bd5680e6-7ba3-4742-b07c-430ca272daed",
                                "sense_id": "bf3aedb8-c901-3b9f-aa5d-4ac182cbbf75",
                                "text": "Manche Autoren schreiben lieber unter Pseudonym als unter ihrem Klarnamen."
                            },
                            {
                                "example_id": "299bdfa9-73a0-4f1e-a2e0-f27190dabe2e",
                                "sense_id": "bf3aedb8-c901-3b9f-aa5d-4ac182cbbf75",
                                "text": "„Redaktionen scheuen Klarnamen von Stasi-Spitzeln“"
                            },
                            {
                                "example_id": "504e0770-d622-450a-bd06-2d4fa87ade15",
                                "sense_id": "bf3aedb8-c901-3b9f-aa5d-4ac182cbbf75",
                                "text": "„Es spricht vieles dafür, dass es zum Sieg der Klarnamen im Netz politischen Drucks gar nicht bedarf - dafür werden vielmehr die Nutzer selbst sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
