                        "translation_id": "1f5f5287-ed7e-449b-80c4-b1f8f4eeb009",
                        "source_entry_id": "e1013d20-cca8-3479-9e49-67a32c99684c",
                        "source_sense_id": "92fb06f1-c284-3554-bbde-60e40e845e63",
                        "target_lang_word": "gelieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "024669ab-570c-3be6-b233-8b339ff0cee4",
                                        "entry_id": "b510fae4-dac3-3286-9bc3-045dad324bd8",
                                        "glosses": [
                                            "fest werden, so dass eine bei Erschütterung wackelnde, halbfeste Masse (Gelee) entsteht"
                                        ],
                                        "tags": [
                                            "meist über einen (flüssigen) Saft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d40144-e873-4f3c-8b0c-d1e575104a45",
                                                "sense_id": "024669ab-570c-3be6-b233-8b339ff0cee4",
                                                "text": "„Unreife Früchte sind zur Saftbereitung nicht geeignet, weil der Saft nicht flüssig bleibt, sondern geliert oder stockt.“"
                                            },
                                            {
                                                "example_id": "cc6e704e-f4c9-47e4-89ef-6378d576cdb0",
                                                "sense_id": "024669ab-570c-3be6-b233-8b339ff0cee4",
                                                "text": "„Eine Marmelade geliert besser, je mehr Pektin die Früchte enthalten.“"
                                            },
                                            {
                                                "example_id": "8bed2e97-b2b9-4c3d-a6d8-ae24c99c9f42",
                                                "sense_id": "024669ab-570c-3be6-b233-8b339ff0cee4",
                                                "text": "„Wie geliere ich richtig?“"
                                            },
                                            {
                                                "example_id": "a825a4d1-c5fc-494c-b4e9-da4ea7296ea5",
                                                "sense_id": "024669ab-570c-3be6-b233-8b339ff0cee4",
                                                "text": "„Trauben sind da, ich geliere Trauben in Wein, geliertes Traubensüppchen werde ich das später nennen. Sahne obendrauf. Mit Zimt!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
