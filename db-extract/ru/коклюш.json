                    },
                    {
                        "translation_id": "28ce3c4b-0d42-4847-a543-5b6a422fbe2a",
                        "source_entry_id": "7e33de30-e620-3723-a2e2-dc36e6f2c995",
                        "source_sense_id": "08e25291-bcd9-3c4e-9815-de66193d4c4c",
                        "target_lang_word": "Keuchhusten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keuchhusten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                        "entry_id": "4af69faf-a46d-3393-a057-9613976dc480",
                                        "glosses": [
                                            "bakterielle Infektionskrankheit, die starke Hustenanfälle verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df193182-9a4f-43ad-9953-996aebb3be52",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "Für Säuglinge kann Keuchhusten lebensbedrohlich sein."
                                            },
                                            {
                                                "example_id": "aad753e2-b4a7-4a87-b609-fc61acd82e04",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Nur, mit ihrem eigenen Glauben daran schien es nicht gar so weit her zu sein, denn sie bekamen Masern, Keuchhusten und Windpocken.“"
                                            },
                                            {
                                                "example_id": "aee11c85-ece7-43d1-b15e-42a45b5c1fe9",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Die drei Kinder hatten Keuchhusten und konnten ihn nicht loswerden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f8f4622-6b05-4504-9e27-3694d0daf3f5",
                        "source_entry_id": "7e33de30-e620-3723-a2e2-dc36e6f2c995",
                        "source_sense_id": "08e25291-bcd9-3c4e-9815-de66193d4c4c",
                        "target_lang_word": "coqueluche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coqueluche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Maladie bactérienne due à Bordetella pertussis, elle atteint principalement les enfants et se caractérisé par une toux convulsive."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ad219b-12fc-4a9e-a3c3-a0da4fd62fb6",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Il arrive un moment où l’idée du mariage vous prend tous : c’est comme la coqueluche qui attrape les enfants à un certain âge."
                                            },
                                            {
                                                "example_id": "e3a0a127-c7ed-4c31-af6d-73a270a57dab",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Je te répondrai que l’on n’a jamais prétendu non plus, avec le seul secours du bon sens, guérir la coqueluche ou la scarlatine."
                                            },
                                            {
                                                "example_id": "ab080346-52f3-463d-a64c-421e1c02963a",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Depuis 1996, près de 300 cas annuels de coqueluche ont été déclarés en France, avec deux pics observés respectivement en 1997 et en 2000. Le taux d’incidence national chez les enfants de 0 à 2 mois est estimé à 276/100 000 en moyenne."
                                            },
                                            {
                                                "example_id": "2cbff8f4-0741-4eb2-8265-33a89d73f0bc",
                                                "sense_id": "f7b321ed-2400-3953-ae0e-e6362c4a3c35",
                                                "text": "Il y a l’entérite cholériforme liée à une nourriture inadaptée, la variole, la rougeole, la coqueluche, la tuberculose. Et face à tout cela, une inaction coupable des pouvoirs publics. Un manque tragique de maternités de crèches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Personne particulièrement en vogue, favori."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9d8d25-9ac9-4615-9c4f-9d0b4ae4b3e5",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "Alexis Hanquinquant est une coqueluche du handisport tricolore, multiple champion de France, champion d’Europe et plusieurs fois médaillé olympique"
                                            },
                                            {
                                                "example_id": "78becd6f-8428-425f-b393-d8a642b5ed64",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "– Il y a des très jolies femmes à Aix.\n– J’ai donné quelques assauts devant elles.\n– Vous avez dû être leur coqueluche ?...\n– Elles faisaient, en effet, une belle tapisserie."
                                            },
                                            {
                                                "example_id": "86c57c26-4ab2-46a0-bb64-284f0002b3a0",
                                                "sense_id": "827fbb36-d40e-342f-a360-d124c3972fb4",
                                                "text": "Une œuvre de la jeune coqueluche Yéanzi a été adjugée pour 67 600 euros chez Piasa, à Paris, mi-novembre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                        "entry_id": "7df69823-1326-34ce-8135-b1cfcb0847b0",
                                        "glosses": [
                                            "Chose appréciée, affection, engouement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0168f97a-fcfa-4a07-bc19-2fdfd76031f6",
                                                "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                                "text": "Cependant, au milieu de cette coqueluche de tendresse pour Lantier, Gervaise, les premières semaines, vécut dans un grand trouble."
                                            },
                                            {
                                                "example_id": "6ceccc20-863e-4c3e-9540-2751de48776a",
                                                "sense_id": "deab51b4-f2f6-348b-ac4f-22f7c2f1a05b",
                                                "text": "Le vrai roi du guinche, la coqueluche, le mieux placé pour lever les frangines, c’est l’accordéon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coqueluche",
                                "target_lang_code": "fr",
                                "target_senses": [
