                "senses": [
                    {
                        "sense_id": "e0fd4a3e-f8dd-38c3-b729-50c5a8cf8431",
                        "entry_id": "136d6fae-aa6b-3610-96a3-497d9dd84583",
                        "glosses": [
                            "variante de flex office: Espace de travail qui ne donne pas d’emplacement fixe aux employés, les poussant à changer régulièrement de place au sein de l’entreprise ou même à travailler ailleurs."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "d2738261-79c0-476a-84d4-c066615d1745",
                                "sense_id": "e0fd4a3e-f8dd-38c3-b729-50c5a8cf8431",
                                "text": "Une femme qui passe plus d’une heure et demie dans les transports, traite énormément d’informations pour son travail, dans un espace organisé en flex-office (bureau non attribué), et qui aide un parent âgé, aurait bien besoin que son manageur veille sur elle, car elle est psychologiquement en danger."
                            },
                            {
                                "example_id": "432ef717-3304-4845-bdc8-a85685abb173",
                                "sense_id": "e0fd4a3e-f8dd-38c3-b729-50c5a8cf8431",
                                "text": "En France, nous parlons souvent de Flex office pour désigner ce que nos collègues anglo-saxon appellent l’ABW (activity-based working) : la flexibilité dans l'utilisation de l'espace de bureau en fonction des besoins de son activité au cours de la journé"
                            }
                        ]
                    }
