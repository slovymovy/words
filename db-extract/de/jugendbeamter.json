                "senses": [
                    {
                        "sense_id": "ddc6cca6-02af-3bb0-b9a1-8672136a769e",
                        "entry_id": "3bbda821-9939-3e41-a24a-6646081dc969",
                        "glosses": [
                            "Polizist, der speziell für jugendliche Straftäter zuständig ist und der auch bei Jugendlichen (besonders in Schulen und Freizeiteinrichtungen) Aufklärungs- und Beratungsarbeit leistet, um Jugendkriminalität vorzubeugen"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "c107b692-2178-4b29-b97f-b8ff2b7bc31e",
                                "sense_id": "ddc6cca6-02af-3bb0-b9a1-8672136a769e",
                                "text": "„Zigaretten, Schnupftabak und neun Flaschen hochprozentigen Alkohol hatten sechs Jugendliche im Alter zwischen 15 und 17 Jahren dabei, die am Samstag in Markt Schwaben durch die Jugendbeamten der Poinger Polizei kontrolliert wurden.“"
                            },
                            {
                                "example_id": "78be2e67-ec04-4d7c-8d09-90528bdf4708",
                                "sense_id": "ddc6cca6-02af-3bb0-b9a1-8672136a769e",
                                "text": "„Die Jugendbeamten der regionalen Polizeidienststellen sind regelmäßig in Schulen, um zum Beispiel über Cybermobbing aufzuklären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
