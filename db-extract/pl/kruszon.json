                    },
                    {
                        "sense_id": "3b089e73-fb77-3a50-9fc9-b62005c31456",
                        "entry_id": "851b8b1b-2c18-3473-8f5d-2cbad228e167",
                        "glosses": [
                            "placek z kruchego ciasta, do którego dodaje się dżem lub powidła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc4a335-f5a9-45cb-9be2-ed968e604188",
                                "sense_id": "3b089e73-fb77-3a50-9fc9-b62005c31456",
                                "text": "Było to ciasto \"wojenne\", tak zwany kruszon. Kruszyło się czarny razowy chleb, słodziło się rozmoczoną masę cukrem, jeśli był, albo melasą czy miodem, dodawało marmolady, najczęściej buraczanej, i piekło w piecu jak ciasto."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
