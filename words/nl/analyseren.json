                {
                    "sense_id": "5b9cc2df-3674-362c-938c-9d822c18089a",
                    "sense_definition": "Iemand psychologisch onderzoeken of behandelen volgens de methode van de psychoanalyse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze man heeft zich al tien jaar lang laten <w>analyseren</w> door een therapeut.",
                            "target_lang_translations": {
                                "ru": "Этот мужчина уже десять лет позволяет терапевту себя <w>анализировать</w>.",
                                "en": "This man has been <w>analyzed</w> by a therapist for ten years.",
                                "zh": "这个男人已经接受了十年的<w>心理分析</w>治疗。"
                            }
                        },
                        {
                            "text": "De psychiater <w>analyseerde</w> de dromen van de patiënt om zijn angsten te begrijpen.",
                            "target_lang_translations": {
                                "ru": "Психиатр <w>анализировал</w> сны пациента, чтобы понять его страхи.",
                                "en": "The psychiatrist <w>analyzed</w> the patient's dreams to understand his fears.",
                                "zh": "精神科医生<w>分析</w>了病人的梦境，以了解他的恐惧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich laten analyseren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исследовать или лечить кого-либо методами психоанализа.",
                        "en": "To examine or treat someone psychologically using the method of psychoanalysis.",
                        "zh": "运用心理分析的方法对某人进行心理检查或治疗。"
                    },
