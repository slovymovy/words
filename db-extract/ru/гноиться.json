                ],
                "senses": [
                    {
                        "sense_id": "2bf3230f-6c7e-3003-85a1-cb739900f299",
                        "entry_id": "d81f22d9-eabf-3a25-bf47-ae29e34ab2c0",
                        "glosses": [
                            "выделять гной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150742ff-a51c-485a-af14-7e2e246a9055",
                                "sense_id": "2bf3230f-6c7e-3003-85a1-cb739900f299",
                                "text": "Э́тот дал себе́ во́лю и в отме́стку отодра́л колле́гу так жесто́ко, что у того́, по расска́зам, до сих пор гнои́тся те́ло."
                            },
                            {
                                "example_id": "7b284be5-296f-407b-8a3e-54870152a553",
                                "sense_id": "2bf3230f-6c7e-3003-85a1-cb739900f299",
                                "text": "Она́ гнои́лась, и прекрати́ть нагное́ние не удава́лось."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fc79a7a-00b0-4769-8874-a1bce3cd0113",
                        "source_entry_id": "d81f22d9-eabf-3a25-bf47-ae29e34ab2c0",
                        "source_sense_id": "2bf3230f-6c7e-3003-85a1-cb739900f299",
                        "target_lang_word": "suppurer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suppurer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c228f1-2f13-33d9-8403-e88bf6973c7f",
                                        "entry_id": "9d7ee80c-f802-3dd0-a842-ee9c5e78115b",
                                        "glosses": [
                                            "Rendre du pus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d8a57d-3119-4144-8e37-b8ed44f0971b",
                                                "sense_id": "e1c228f1-2f13-33d9-8403-e88bf6973c7f",
                                                "text": "Un front construit – les yeux veloutés de sa race – de trop grosses joues – et puis ce qui me dégoûte dans les garçons de cet âge : des boutons, les signes du sang en mouvement ; tout ce qui suppure ; surtout ces paumes moites qu'il essuyait avec un mouchoir, avant de vous serrer la main."
                                            },
                                            {
                                                "example_id": "3d6f051b-ee68-411e-b002-2a7d52f39a88",
                                                "sense_id": "e1c228f1-2f13-33d9-8403-e88bf6973c7f",
                                                "text": "Mais la déchirure avait déjà été effectuée, j’avais une moitié du cœur qui béait et l’autre en lambeaux : chaque élan vers le petit ne faisait que raviver les élancements de cette plaie qui suppurait encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
