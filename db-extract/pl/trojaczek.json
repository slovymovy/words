                            {
                                "example_id": "6d5e2fc1-f363-44c3-983f-4153718c6f5f",
                                "sense_id": "e241f6f4-2ee3-3452-b54f-63af5197ecf8",
                                "text": "Statystycznie bliźnięta rodzą się raz na osiemdziesiąt ciąż, trojaczki przychodzą na świat jeszcze rzadziej: zdarzają się może raz na dwa lata."
                            },
