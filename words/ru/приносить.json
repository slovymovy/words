{
    "word_family": [
        "принос",
        "приношение",
        "принести",
        "носить",
        "нести"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dec297e4-af89-33a6-92b4-27912c992144",
                    "sense_definition": "доставлять куда-либо, держа в руках или на себе",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро почтальон продолжал <w>приносить</w> свежие газеты прямо к нашей двери.",
                            "target_lang_translations": {
                                "en": "Every morning, the mail carrier continued to <w>bring</w> fresh newspapers straight to our door."
                            }
                        },
                        {
                            "text": "Он привык <w>приносить</w> книги обратно в библиотеку строго вовремя.",
                            "target_lang_translations": {
                                "en": "He was used to <w>bringing</w> books back to the library strictly on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "доставлять"
                    ],
                    "antonyms": [
                        "уносить"
                    ],
                    "common_phrases": [
                        "приносить домой",
                        "приносить пользу"
                    ],
                    "target_lang_definitions": {
                        "en": "to carry or deliver something somewhere in hands or on oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "to carry or convey toward somewhere"
                            },
                            {
                                "target_lang_word": "fetch",
                                "target_lang_sense_clarification": "to go and retrieve"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd99662-975c-381a-9a46-1e1a683a2f8b",
                    "sense_definition": "давать что-либо в качестве результата, следствия",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Любимая работа должна <w>приносить</w> радость и удовлетворение человеку.",
                            "target_lang_translations": {
                                "en": "One's favourite work should <w>bring</w> joy and satisfaction."
                            }
                        },
                        {
                            "text": "Этот новый финансовый проект начал регулярно <w>приносить</w> доход инвесторам.",
                            "target_lang_translations": {
                                "en": "This new financial project began to regularly <w>yield</w> returns for investors."
                            }
                        }
                    ],
                    "synonyms": [
                        "давать"
                    ],
                    "common_phrases": [
                        "приносить радость",
                        "приносить доход",
                        "приносить прибыль",
                        "приносить вред"
                    ],
                    "target_lang_definitions": {
                        "en": "to produce something as a result, consequence, or profit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring",
                                "target_lang_sense_clarification": "to occasion or produce as a result"
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to generate or produce as return"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecf2c12a-0ed1-3ba6-add5-94451709a97b",
                    "sense_definition": "выражать, высказывать в устойчивых оборотах (извинения, благодарность)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я искренне <w>приношу</w> свои извинения за причинённые вам неудобства.",
                            "target_lang_translations": {
                                "en": "I sincerely <w>offer</w> my apologies for the inconvenience caused to you."
                            }
                        },
                        {
                            "text": "Организаторы встречи поспешили <w>приносить</w> благодарность всем участникам мероприятия.",
                            "target_lang_translations": {
                                "en": "The meeting organizers hastened to <w>extend</w> thanks to all participants of the event."
                            }
                        }
                    ],
                    "synonyms": [
                        "выражать"
                    ],
                    "common_phrases": [
                        "приносить извинения",
                        "приносить благодарность",
                        "приносить соболезнования"
                    ],
                    "target_lang_definitions": {
                        "en": "to express or convey formally in set phrases (apologies, thanks, condolences)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to express or present formally (apologies, thanks)"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to convey or express (condolences, greetings)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53c6dde0-c663-37af-b85f-ca37c7fb8855",
                    "sense_definition": "совершать торжественное действие, выражаемое существительными вроде клятва, присяга",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый новый солдат обязан <w>приносить</w> воинскую присягу перед строем.",
                            "target_lang_translations": {
                                "en": "Every new soldier is required to <w>take</w> a military oath before the ranks."
                            }
                        },
                        {
                            "text": "В древности было принято <w>приносить</w> торжественные клятвы богам.",
                            "target_lang_translations": {
                                "en": "In ancient times, it was customary to <w>make</w> solemn vows to the gods."
                            }
                        }
                    ],
                    "synonyms": [
                        "давать"
                    ],
                    "common_phrases": [
                        "приносить присягу",
                        "приносить клятву",
                        "приносить жертву"
                    ],
                    "target_lang_definitions": {
                        "en": "to perform a solemn or ritual act, such as taking an oath or making a sacrifice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "to make a solemn commitment, such as an oath"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "to offer or perform (a sacrifice, vow)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a3d0e26-cbeb-387e-82ef-299faf231423",
                    "sense_definition": "о растениях: давать урожай, плоды",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старая яблоня в саду продолжала каждый год <w>приносить</w> богатые плоды.",
                            "target_lang_translations": {
                                "en": "The old apple tree in the garden continued to <w>bear</w> rich fruit every year."
                            }
                        },
                        {
                            "text": "Эти кустарники могут <w>приносить</w> спелые ягоды до глубокой осени.",
                            "target_lang_translations": {
                                "en": "These shrubs can <w>yield</w> ripe berries well into late autumn."
                            }
                        }
                    ],
                    "synonyms": [
                        "плодоносить"
                    ],
                    "common_phrases": [
                        "приносить плоды"
                    ],
                    "target_lang_definitions": {
                        "en": "of plants: to bear or yield fruit, crops, or produce"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to produce or yield fruit"
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to produce a crop or harvest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2eec271-35f3-3fa3-a9dc-d37a64d08691",
                    "sense_definition": "о самках млекопитающих: рожать детёнышей",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Здоровая кошка может <w>приносить</w> до пяти котят за один раз.",
                            "target_lang_translations": {
                                "en": "A healthy cat can <w>bear</w> up to five kittens at a time."
                            }
                        },
                        {
                            "text": "Обычно овцы начинают <w>приносить</w> потомство весной.",
                            "target_lang_translations": {
                                "en": "Usually, sheep begin to <w>give birth to</w> offspring in the spring."
                            }
                        }
                    ],
                    "synonyms": [
                        "рожать"
                    ],
                    "common_phrases": [
                        "приносить потомство"
                    ],
                    "target_lang_definitions": {
                        "en": "of female mammals: to give birth to young"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "to give birth to offspring"
                            },
                            {
                                "target_lang_word": "give birth to",
                                "target_lang_sense_clarification": "to produce young"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81761079-9407-38d2-9a28-b76bb073bae6",
                    "sense_definition": "о нежелательном, неожиданном появлении кого-либо",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечно тебя <w>приносит</w> в самый неподходящий момент рабочего дня.",
                            "target_lang_translations": {
                                "en": "You always <w>blow in</w> at the worst possible moment of the workday."
                            }
                        },
                        {
                            "text": "И какая нелёгкая сила может <w>приносить</w> непрошеных гостей в полночь.",
                            "target_lang_translations": {
                                "en": "What devil could <w>drag in</w> uninvited guests at midnight?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "нелёгкая приносит"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to show up unexpectedly or undesirably"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow in",
                                "target_lang_sense_clarification": "to arrive unexpectedly or unwelcome"
                            },
                            {
                                "target_lang_word": "drag in",
                                "target_lang_sense_clarification": "to show up somewhere uninvited"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}