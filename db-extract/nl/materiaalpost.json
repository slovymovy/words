                        "glosses": [
                            "plaats de zone waar de begeleiders van de veldwielrenners staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9946601f-cffa-4594-9370-6a822fd6fdcd",
                                "sense_id": "90c8f9ea-c460-350a-b33d-e1b115427869",
                                "text": "\"Die fiets stond ter beschikking in de materiaalpost als reservemateriaal. En de UCI was systematisch kaders aan het scannen van de deelneemsters. Daarbij hebben ze een onregelmatigheid vastgesteld. Ze hebben de fiets gelijk verwijderd\", vertelt De Bie."
                            },
                            {
                                "example_id": "cc4a1239-1ee3-4b30-8ff6-e479bf0813a8",
                                "sense_id": "90c8f9ea-c460-350a-b33d-e1b115427869",
                                "text": "De moegestreden Van der Haar kreeg nog eens pech, moest lang wachten tot hij bij een materiaalpost kwam, werd door drie Belgen gepasseerd en eindigde uiteindelijk als zesde."
                            }
                        ]
                    }
