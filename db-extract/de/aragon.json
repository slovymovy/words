                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "90060b82-997e-454a-8bee-fde84077d574",
                                "sense_id": "9747d6b8-740b-3bf1-8514-33203df7749b",
                                "text": "„Doch ob mit oder ohne Finanzierung – die Menschen von Aragon scheinen fest entschlossen, ihre Traditionen zu pflegen."
                            },
                            {
                                "example_id": "b9f9cb71-0c07-4cc0-8571-f40e9b33663a",
                                "sense_id": "9747d6b8-740b-3bf1-8514-33203df7749b",
                                "text": "„Auch in den Regionen Katalonien und Aragon im Nordosten des Landes sowie im östlichen Valencia und in Murcia im Süden beeinträchtigte heftiger Schneefall den Verkehr."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3787c615-0460-3401-97a4-f6d959669066",
                        "entry_id": "d03f8165-2e6c-352c-8267-d347289c2b57",
                        "glosses": [
                            "das mittelalterlich-frühneuzeitliche Königreich von Aragon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a072ae-0ad1-4bf5-b499-a39c72a143d5",
                                "sense_id": "3787c615-0460-3401-97a4-f6d959669066",
                                "text": "„Dieser vermählte sich 1137 mit der Erbin des Königreichs Aragon, wodurch Catalonien mit letzterem vereiniget wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
