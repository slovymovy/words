                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduire_discretement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>glissé</w> la lettre dans une enveloppe avant de partir."
