                        "cross_references": [
                            {
                                "target_word": "antyfeminizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e9daf50-6d8d-35a6-895b-0ceafea4b45f",
                                        "entry_id": "f61070e1-3a98-3342-9082-44f90016f470",
                                        "glosses": [
                                            "stanowisko sprzeciwiające się ideom i ruchowi feministycznemu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be83e6e0-bce6-457b-a97c-99c0ed78bdc5",
                                                "sense_id": "2e9daf50-6d8d-35a6-895b-0ceafea4b45f",
                                                "text": "Antyfeminizm faszyzmu, sprzeciwiający się liberalnej idei powszechnej równości ludzi, szczególnie płci, był wręcz ostentacyjny"
                                            },
                                            {
                                                "example_id": "6b45b4f9-3242-466d-b9b7-0b6295bb6693",
                                                "sense_id": "2e9daf50-6d8d-35a6-895b-0ceafea4b45f",
                                                "text": "Również „antyfeminizm\" jest jednak w języku polskim czymś pejoratywnym, jeśli w ten sposób określimy czyjeś poglądy, to jasne jest, że się z nimi nie utożsamiamy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1145185c-de02-3963-818e-1788eef3b6a1",
                                        "entry_id": "f61070e1-3a98-3342-9082-44f90016f470",
                                        "glosses": [
                                            "wrogi stosunek do kobiet i/lub nieakceptowanie ich równości wobec prawa"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29415ba6-e209-401c-9c42-d48a0860686f",
                                                "sense_id": "1145185c-de02-3963-818e-1788eef3b6a1",
                                                "text": "Zdecydowany antyfeminizm cechuje wielu moralistów, m.in. głośnego Szymona Starowolskiego. Uzasadniając swą niechęć do kobiet powoływał się na prawa natury"
                                            },
                                            {
                                                "example_id": "247cc92f-dc97-489b-9782-c39938cd4bdf",
                                                "sense_id": "1145185c-de02-3963-818e-1788eef3b6a1",
                                                "text": "Naukowy antyfeminizm przybrał w tekstach XV-wiecznych inkwizytorów Jakuba Sprengera i Henryka Instytora postać krańcowej nienawiści, tworząc jeden z najgorszych w historii systemów represji wobec kobiet"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
