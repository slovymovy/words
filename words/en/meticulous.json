                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Робкий, боязливый или чрезмерно осторожный до такой степени, что это мешает действовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многозаботливый",
                                "target_lang_sense_clarification": "чрезмерно беспокойный о мелочах (устаревшее)"
                            },
                            {
                                "target_lang_word": "робость",
                                "target_lang_sense_clarification": "проявляющий излишнюю осторожность и нерешительность"
