                                "sense_id": "a854cd79-5a15-3f13-bc69-41f921047c3f",
                                "text": "„Nach der Einigung mit dem SC Klinge Seckach ist die Fußballnationalspielerin Renate Lingor ab sofort für den Bundesligisten SG Praunheim spielberechtigt.“"
                            },
                            {
                                "example_id": "30d77365-1bee-465b-b284-d798f0adc5bc",
                                "sense_id": "a854cd79-5a15-3f13-bc69-41f921047c3f",
                                "text": "„Nach dem Gewinn der Europameisterschaft im Juli standen die Fußballnationalspielerinnen bei deutschen Autogrammsammlern hoch im Kurs.“"
                            },
                            {
                                "example_id": "7e400e31-4aee-44ba-b7f0-1a4678863f04",
                                "sense_id": "a854cd79-5a15-3f13-bc69-41f921047c3f",
                                "text": "„Inka Grings (34) ist deutsche Fussballnationalspielerin und hat am vergangenen Wochenende mit dem FC Zürich den Schweizer Cup gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
