                    }
                ],
                "senses": [
                    {
                        "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                        "entry_id": "4be2b582-0eef-3df9-a82f-84394ad7ae8e",
                        "glosses": [
                            "künstlerische Darstellung des gekreuzigten Jesus"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "089e81df-7a5a-4080-bf22-d8b3376f1a45",
                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                "text": "„Er trat während der ersten Strophe neben das Bild des amtierenden Staatspräsidenten, das in jedem Klassenzimmer neben dem Kruzifix hängen musste, und salutierte bei der letzten Strophe.“"
                            },
                            {
                                "example_id": "f90d5a7a-63ec-44ac-9681-fce4a50e601a",
                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                "text": "„Unter dem Kruzifix neben dem ausgebrannten Öllämpchen nahm sich die Rose wahrhaft königlich aus.“"
                            },
                            {
                                "example_id": "84c55c56-3baa-4893-bbd8-35e224719791",
                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                "text": "„Kerzen brennen zu beiden Seiten des Kruzifixes.“"
                            },
                            {
                                "example_id": "33a9219d-ac8c-41bc-9ae9-8a2eeb6ed6cd",
                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                "text": "„An der Wand hing ein Kruzifix.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "60dd1f81-f3e5-315f-b548-ef97dabf9814",
                        "entry_id": "4be2b582-0eef-3df9-a82f-84394ad7ae8e",
                        "glosses": [
                            "Fluchwort"
                        ],
                        "tags": [
                            "oberdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "59f9a0f9-9c5c-46fe-ace8-5c643e6b9889",
                                "sense_id": "60dd1f81-f3e5-315f-b548-ef97dabf9814",
                                "text": "Kruzifix nochmal, jetzt habe ich den Karren vergessen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5286b4ae-1795-4828-b6c5-2797236de35e",
                        "source_entry_id": "4be2b582-0eef-3df9-a82f-84394ad7ae8e",
                        "source_sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                        "source_sense_description": "Religion, Bildende Kunst: künstlerische Darstellung des gekreuzigten Jesus",
                        "target_lang_word": "crucifix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "003c46ca-ab6b-38af-8c44-784795accaf7",
                                        "entry_id": "f991d009-0d41-3d6b-972a-e6bdb7182c53",
                                        "glosses": [
                                            "A wooden structure used for crucifixions, as by the Romans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de202016-5070-301a-be61-c6338d24aa85",
                                        "entry_id": "f991d009-0d41-3d6b-972a-e6bdb7182c53",
                                        "glosses": [
                                            "An ornamental or symbolic sculptural representation of Christ on a cross, often worn as a pendant or displayed in a Christian church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac58d386-47c8-4527-8e6a-b5df27114f3f",
                                                "sense_id": "de202016-5070-301a-be61-c6338d24aa85",
                                                "text": "Plain crosses are preferred by Protestants, but crucifixes by Catholics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ad4cc66-71a6-3db7-8923-5022fa77d8ce",
                                        "entry_id": "f991d009-0d41-3d6b-972a-e6bdb7182c53",
                                        "glosses": [
                                            "The iron cross, a position on the rings where the gymnast holds the rings straight out on either side of the body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09579f6c-a666-4301-983a-03cc3064a6f6",
                        "source_entry_id": "4be2b582-0eef-3df9-a82f-84394ad7ae8e",
                        "source_sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                        "source_sense_description": "Religion, Bildende Kunst: künstlerische Darstellung des gekreuzigten Jesus",
                        "target_lang_word": "crucifix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucifix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                        "entry_id": "06f47ce9-8b3b-330a-a91f-09da6ea99803",
                                        "glosses": [
                                            "Représentation par l’image, la statuaire, etc., de Jésus-Christ crucifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20bb3c0-9504-4480-a73e-cbeb4f432a4e",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "Tout était à sa place: le lit de serge verte dans son alcôve; à la tête du lit le crucifix de bois noir, surmonté d’une branche de buis séché depuis la dernière Pâques."
                                            },
                                            {
                                                "example_id": "c68c611c-6a71-42c5-9f59-1916f72dc10a",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "Cet or une fois trouvé, l’Amérique ne fut plus pour ses conquérants qu’une étape où ces avides aventuriers venaient, un poignard d’une main et un crucifix de l’autre, recueillir une ample moisson de ce métal si ardemment convoité."
                                            },
                                            {
                                                "example_id": "524b3a82-5f46-416c-a1ae-9342a961aaa7",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "Le pain d’autel dont se sert l'église de Vrigne-aux-Bois a huit centimètres de diamètre. Il est épais, friable et spongieux. L'empreinte qui se dessine à la surface représente une croix sans crucifix."
                                            },
                                            {
                                                "example_id": "a309d2e1-46ad-423e-8a55-5c743aafe1af",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "C’était un vieux tout blanc, médaillé de Crimée et d’Italie, et qui n’avait pas l’air commode. Ses hommes se le tinrent pour dit, et je dois leur rendre cette justice qu’ils n’ont rien pris dans les tombes, pas même le crucifix du duc de Morny, qui vaut à lui seul près de deux mille francs."
                                            },
                                            {
                                                "example_id": "81925d0d-5b88-412f-a91c-0c169fd21da4",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "À peine s’est-elle montrée, que brandissant le crucifix à deux mains, de toute la hauteur de mes bras, je le laisse retomber lourdement sur la tête de Carmen."
                                            },
                                            {
                                                "example_id": "ce01724a-7ffa-4f94-b56d-b29d8b2649a9",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "Il attire mon attention sur ce fait que, très souvent ici, même dans les cabarets, on voit des crucifix et des images pieuses."
                                            },
                                            {
                                                "example_id": "51b0ada3-752f-4d25-9211-d250c3d96ea1",
                                                "sense_id": "3cbe3a6b-8045-352f-9596-af9d9dda56b1",
                                                "text": "Certes, la douairière règne au premier étage, dans le « bel appartement » où elle tient conseil avec ses notaires, et que domine de haut, tranchant sur le mobilier baroque, un crucifix avec son bénitier et son brin de buis, presque indispensable chez ces chrétiens bourgeois qui pourtant ne savent pas prier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
