                "senses": [
                    {
                        "sense_id": "5f34559d-9851-3271-b0dd-e538604adabe",
                        "entry_id": "3f17b5c4-7b0f-30b1-9edc-1be2296518e4",
                        "glosses": [
                            "Kennzeichnung fehlender Wortteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43d022a8-cca7-4d9a-9a47-0e30ffca3c3f",
                                "sense_id": "5f34559d-9851-3271-b0dd-e538604adabe",
                                "text": "„In dem vom niederösterreichischen Erstgericht geführten Handelsregister sind die Verhältnisse des Trägers der Firma eingetragen, die aus einem Vornamen, einem Familiennamen mit einem unter Auslassungszeichen angefügten Genitiv-S, dem Wort ‚Söhne‘, einer Berufsbezeichnung und dem Ortsnamen des Unternehmenssitzes gebildet ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cadfeeff-f440-416a-951d-8107f751cfbe",
                        "source_entry_id": "3f17b5c4-7b0f-30b1-9edc-1be2296518e4",
                        "source_sense_id": "5f34559d-9851-3271-b0dd-e538604adabe",
                        "source_sense_description": "Kennzeichnung fehlender Wortteile",
                        "target_lang_word": "apostrophe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apostrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30f70717-5e91-31b6-98ff-4d25fab3234a",
                                        "entry_id": "cac050d2-aeeb-381c-870d-1a0f77e17ace",
                                        "glosses": [
                                            "The text character ’, which serves as a punctuation mark in various languages and as a diacritical mark in certain rare contexts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87839131-773c-4c52-8e1c-9ed1ecf26b2c",
                                                "sense_id": "30f70717-5e91-31b6-98ff-4d25fab3234a",
                                                "text": "Since its inception the apostrophe has been a controversial piece of punctuation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apostrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1043a198-3773-37fe-89e2-f30cdc7d64ce",
                                        "entry_id": "e876913d-17b5-389f-b051-af67d9e3d4f5",
                                        "glosses": [
                                            "A sudden exclamatory piece of dialogue addressed to someone or something, especially absent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aac8e6f-6214-453c-a011-d69b38fc84a0",
                                                "sense_id": "1043a198-3773-37fe-89e2-f30cdc7d64ce",
                                                "text": "Apostrophe a bold digression makes,\nMov'd by some sudden thought the theme awakes."
                                            },
                                            {
                                                "example_id": "abf6898f-fbfd-4742-a721-b9edd7119fd8",
                                                "sense_id": "1043a198-3773-37fe-89e2-f30cdc7d64ce",
                                                "text": "The warm apostrophe of Riccardini to this little representative of his parents, whom he called \"the son of his love, the child of his old age, the gift of his beloved niece, on the behalf of his angel-daughter,\" affected them all;..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apostrophe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98084b97-27d9-3ca7-b467-74df7ba423db",
                                        "entry_id": "36f707ca-ea2b-33cc-a08d-ac4ac15a30b8",
                                        "glosses": [
                                            "An arrangement of chlorophyll grains perpendicular to the outer surface of plant cells, as opposed to epistrophe (an arrangement on the outer surface)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30fb8b9e-dd72-4bbe-8c05-17ddb183e926",
                                                "sense_id": "98084b97-27d9-3ca7-b467-74df7ba423db",
                                                "text": "As is well known, chloroplast in the epistrophe position presents an oval or more or less circular form; in the apostrophe position a flattened and lenticular form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
