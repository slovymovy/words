                "senses": [
                    {
                        "sense_id": "9ac59964-ac92-3731-84da-469322aa942a",
                        "entry_id": "40aa88dc-f62a-31a6-aaee-d9fc9d408c0b",
                        "glosses": [
                            "Blushing; ruddy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a697d1-3811-47ae-9737-59710335fb92",
                                "sense_id": "9ac59964-ac92-3731-84da-469322aa942a",
                                "text": "She turned ablush when she received the unexpected compliment."
                            },
                            {
                                "example_id": "2d7e4a05-868c-44ab-b61f-3f4125656383",
                                "sense_id": "9ac59964-ac92-3731-84da-469322aa942a",
                                "text": "His face went ablush after realizing he had spoken out of turn."
                            },
                            {
                                "example_id": "55d8cc7f-ff3c-4749-bf2a-7f5b11e2840a",
                                "sense_id": "9ac59964-ac92-3731-84da-469322aa942a",
                                "text": "The girl’s cheeks turned ablush at the attention."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82031227-2fca-484f-9c4f-f97ccd87e6bd",
                        "source_entry_id": "40aa88dc-f62a-31a6-aaee-d9fc9d408c0b",
                        "source_sense_id": "9ac59964-ac92-3731-84da-469322aa942a",
