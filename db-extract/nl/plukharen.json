                                                "sense_id": "8c3ffdd9-3ff0-32a2-a174-64d3e45e933e",
                                                "text": "The two sets of fans were tussling before the game."
                                            },
                                            {
                                                "example_id": "798b6b78-fce5-481c-920e-b625836eb728",
                                                "sense_id": "8c3ffdd9-3ff0-32a2-a174-64d3e45e933e",
                                                "text": "Olsson and Herd tussled off the ball at a free-kick before Olsson fell to the ground. Assistant referee Darren Cann signalled for a penalty and Dowd sent Herd off to the amazement of the Villa faithful."
                                            }
                                        ]
                                    }
                                ]
                            },
