                "senses": [
                    {
                        "sense_id": "329b0de7-03b5-3797-9cbe-dc9ee6b596e2",
                        "entry_id": "db4ba7d5-a91c-39e5-9ce3-556d71385136",
                        "glosses": [
                            "Haut eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1e27419-7df0-498b-885b-2f1495e210f4",
                                "sense_id": "329b0de7-03b5-3797-9cbe-dc9ee6b596e2",
                                "text": "„In Menschenhaut gebundene Bücher haben sich erhalten.“"
                            },
                            {
                                "example_id": "8bbe8677-23a7-4936-a300-90061b5dfc99",
                                "sense_id": "329b0de7-03b5-3797-9cbe-dc9ee6b596e2",
                                "text": "„Zwar verarbeiten die Skythen primär die Häute ihrer Nutztiere, aber in einigen Fällen scheuten sie offenbar nicht davor zurück, auch Menschenhaut zu verwenden.“"
                            },
                            {
                                "example_id": "820010ac-63c8-42f3-bdf1-d24736851f64",
                                "sense_id": "329b0de7-03b5-3797-9cbe-dc9ee6b596e2",
                                "text": "„Eine verschlossene Mappe, gebunden in gegerbte Menschenhaut, enthielt besondere unbekannte und unbeschreibliche Zeichnungen, die Gerüchten zufolge von Goya stammten, die er aber nicht zu signieren gewagt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
