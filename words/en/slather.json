{
    "word_family": [
        "slathering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bad0004f-e699-34e4-bdc7-b4b980d64f88",
                    "sense_definition": "To spread a substance thickly over a surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apply_thickly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>slathered</w> butter over the warm bread.",
                            "target_lang_translations": {
                                "cs": "Teplý chleba <w>bohatě namazala</w> máslem."
                            }
                        },
                        {
                            "text": "He <w>slathered</w> sunscreen on his face before going to the beach.",
                            "target_lang_translations": {
                                "cs": "Před odchodem na pláž si na obličej <w>v silné vrstvě nanesl</w> opalovací krém."
                            }
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "spread",
                        "coat"
                    ],
                    "common_phrases": [
                        "slather with"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nanášet nebo roztírat látku v silné vrstvě na povrch."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "natřít",
                                "target_lang_sense_clarification": "nanést v silné vrstvě"
                            },
                            {
                                "target_lang_word": "namazat",
                                "target_lang_sense_clarification": "pokrýt povrch něčím mazlavým"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a903393-d2e9-394e-ab31-dbfb81ce50f4",
                    "sense_definition": "To rain very heavily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>slathering</w> down outside so we decided to stay indoors.",
                            "target_lang_translations": {
                                "cs": "Venku <w>lilo jako z konve</w>, tak jsme se rozhodli zůstat doma."
                            }
                        },
                        {
                            "text": "The rain <w>slathered</w> down all afternoon during the storm.",
                            "target_lang_translations": {
                                "cs": "Během bouřky celé odpoledne <w>lilo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pour",
                        "teem"
                    ],
                    "common_phrases": [
                        "slather down"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Often used in regional or informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi silně pršet (regionální nebo neformální výraz)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "lít",
                                "target_lang_sense_clarification": "o silném dešti"
                            },
                            {
                                "target_lang_word": "pršet jako z konve",
                                "target_lang_sense_clarification": "idiomatické vyjádření silného deště"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "54e1e7c1-d560-3041-9c98-d2749380292e",
                    "sense_definition": "A large or generous amount of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had <w>slathers</w> of free time during the summer holidays.",
                            "target_lang_translations": {
                                "cs": "Během letních prázdnin měla <w>spoustu</w> volného času."
                            }
                        },
                        {
                            "text": "The wealthy family owned <w>slathers</w> of expensive jewelry.",
                            "target_lang_translations": {
                                "cs": "Ta bohatá rodina vlastnila <w>hromady</w> drahých šperků."
                            }
                        }
                    ],
                    "synonyms": [
                        "plenty",
                        "abundance",
                        "heaps"
                    ],
                    "antonyms": [
                        "scarcity"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velké nebo štědré množství něčeho (hovorově)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spousta",
                                "target_lang_sense_clarification": "velké množství"
                            },
                            {
                                "target_lang_word": "hromada",
                                "target_lang_sense_clarification": "velké množství, neformálně"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}