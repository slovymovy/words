                "senses": [
                    {
                        "sense_id": "dc18e462-87b7-365a-82a7-a088833a2f1c",
                        "entry_id": "de12a057-26e7-3824-9c71-e36ea743ba3d",
                        "glosses": [
                            "percussie-instrument uit de klassieke oudheid bestaande uit rinkelende ringetjes om staafjes die in een U-vormige houder zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "773dc1df-7997-478d-9285-acc59aadf599",
                                "sense_id": "dc18e462-87b7-365a-82a7-a088833a2f1c",
                                "text": "Ook moest hij zich onverhoed laten omkronkelen van Agathoteman, de slang met den koperkleurigen kop en den lotusstaart, want in deze geheimzinnige ritselaarster en sister onder de palmboomen en de roodgeschorste acacia's, ademde de hoogheid en weldadigheid der beschermende goden."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c10f597-a379-3644-87e3-ecf3486350a9",
                        "entry_id": "de12a057-26e7-3824-9c71-e36ea743ba3d",
                        "glosses": [
                            "snaarinstrument dat als een citer wordt bespeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1514e7ea-9172-405a-8a95-5d7aff598f8f",
                                "sense_id": "5c10f597-a379-3644-87e3-ecf3486350a9",
                                "text": "De harp, de sister, het clavecimbel, het spinet, de gitaar, de piano zijn alle snaarinstrumenten waarvan de rol hoofdzakelijk was liederen te begeleiden. De sister, uit het Oosten herkomstig, blijft bij ons helemaal onbekend tot 1500. Voornamelijk in de XVIIIe eeuw was dit instrument in gebruik, maar werd vanaf omstreeks 1800 door de gitaar verdrongen."
                            }
                        ]
                    },
                    {
                        "sense_id": "320f1a08-fd6a-3b78-b161-5316cf682d55",
                        "entry_id": "de12a057-26e7-3824-9c71-e36ea743ba3d",
                        "glosses": [
                            "stortbak van een wc"
                        ],
                        "tags": [
                            "Suriname"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b1346418-3a26-3908-94f5-7ba1b7536a70",
                        "entry_id": "de12a057-26e7-3824-9c71-e36ea743ba3d",
                        "glosses": [
                            "inhoudsmaat van 25 liter"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "22b42e22-5eae-4cc0-bbb6-8a897210efb9",
                                "sense_id": "b1346418-3a26-3908-94f5-7ba1b7536a70",
                                "text": "Jonker Jan schijnt nu het geleende geld te hebben teruggegeven in 1580. Immers op 4 Juni 1580 verkoopt hem zijn hooger vermelde zwager ‘eerst de 6 gdn. 18 st. en een blanke erfelijk die men heffende is op het stuk lands gelegen te Oostbrecht en geheeten den Bienacker, item nog een sister rogge die men heft op een hoeve van jonker Erard Coutereau, en nog de drie veertelen rogge op het land geheeten den Heyman en op een stuk heide achter Honthoven’ alle welke erfgoederen Jan had verkocht in 1578 aan zijn zwager."
                            }
                        ]
                    }
