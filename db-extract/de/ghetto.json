                    },
                    {
                        "form_id": "181320ba-e667-457c-827b-314c19853c95",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ghettos"
                    },
                    {
                        "form_id": "9ad637c9-6d47-4704-bf6e-8f1cd2637324",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ghetti"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16a5f85e-951a-3a39-907f-9ab4dbf688bc",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "glosses": [
                            "von der jüdischen Bevölkerung (anfänglich freiwillig, später zwangsweise) bewohntes, von den übrigen Stadtvierteln (durch Mauern oder Ähnliches) abgetrenntes Viertel"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "61a79a31-4213-4a67-af60-685af6c6ec2f",
                                "sense_id": "16a5f85e-951a-3a39-907f-9ab4dbf688bc",
                                "text": "„Der Ghetto also liegt an eben jener Halle der Oktavia, wo Vespasian und Titus den Triumph über die Juden einweihten, und um diesen jetzt im Schmutz starrenden Portikus wohnen heute Nachkommen jener Hebräer, die damals Kriegssklaven des Titus waren.“"
                            },
                            {
                                "example_id": "8b684da9-ec27-483d-a4e4-6ea23956037e",
                                "sense_id": "16a5f85e-951a-3a39-907f-9ab4dbf688bc",
                                "text": "„Wegen der historischen Beziehung des Volkes Israel zu den Römern, welche Jerusalem zerstörten und das Judenvolk in die Welt zerstreuten, ist der Ghetto Roms unter allen Judengemeinden Europas die merkwürdigste.“"
                            },
                            {
                                "example_id": "56252b79-e413-47be-89df-28665a216072",
                                "sense_id": "16a5f85e-951a-3a39-907f-9ab4dbf688bc",
                                "text": "„Die Vorgänge in Ländern, die noch gar nicht entdeckt waren, als Europa die Juden in Ghetti sperrte, sind uns in der nächsten Stunde bekannt.“"
                            },
                            {
                                "example_id": "7d0b2617-f253-43c8-bcaf-5a4bd6d20532",
                                "sense_id": "16a5f85e-951a-3a39-907f-9ab4dbf688bc",
                                "text": "„Das gewöhnliche Volk hat kein historisches Verständnis und kann keines haben. Es weiß nicht, daß die Sünden des Mittelalters jetzt an den europäischen Völkern heimkommen. Wir sind, wozu man uns in den Ghetti gemacht hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2696060b-9e38-3d2d-9641-d831ac8d07b3",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "glosses": [
                            "(militärisch streng bewachtes) isoliertes Stadtviertel, in dem die jüdische Bevölkerung gezwungenermaßen abgesondert von der übrigen Stadtbevölkerung (in unmenschlichen Lebensverhältnissen) leben musste"
                        ],
                        "tags": [
                            "früher",
                            "besonders in der Zeit des Nationalsozialismus"
                        ],
                        "examples": [
                            {
                                "example_id": "d7668e89-b294-4b45-b52d-c1c469bb91c9",
                                "sense_id": "2696060b-9e38-3d2d-9641-d831ac8d07b3",
                                "text": "„Zwei Jahre später bereiste er den nordostpolnischen Bezirk Bialystok und begrüßte hinterher, daß die ‚Juden nur noch in den Ghetti der Städte anzutreffen‘ seien.“"
                            },
                            {
                                "example_id": "569efb00-04c8-4e81-99fe-7a4c7af0f6f4",
                                "sense_id": "2696060b-9e38-3d2d-9641-d831ac8d07b3",
                                "text": "„So hatte Roman vom Aufstand im Warschauer Ghetto erfahren, etwa eine Woche nach Ausbruch, gegen Ende April, über Radio London.“"
                            },
                            {
                                "example_id": "93325ad9-1c79-4723-95fd-50c412cb673b",
                                "sense_id": "2696060b-9e38-3d2d-9641-d831ac8d07b3",
                                "text": "„Hermann Adler hat die Hölle überlebt – die Ghettos von Wilna und Warschau, das KZ Bergen-Belsen.“"
                            },
                            {
                                "example_id": "23afd737-c5d7-4ff5-b113-c9dc89e9a61f",
                                "sense_id": "2696060b-9e38-3d2d-9641-d831ac8d07b3",
                                "text": "„Seine Eltern haben in Wien gelebt und sind ins Ghetto von Lodz deportiert worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "33c9a21c-3b3c-3877-97d7-9398227729a9",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "glosses": [
                            "von diskriminierten Minderheiten, Ausländern oder auch privilegierten Bevölkerungsgruppen bewohnter Bezirk beziehungsweise Viertel einer Stadt"
                        ],
                        "tags": [
                            "zumeist abwertend"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d07ddcbc-570c-3c7e-973b-f8aa94f07e47",
                        "entry_id": "c6f851e7-701b-34a6-9d88-b3819730b78d",
                        "glosses": [
                            "bestimmte (soziale, wirtschaftliche oder dergleichen) mentale oder psychische Sphäre, der sich jemand nicht entziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee50e83-3e31-45f1-8ff7-8f0d0298daa9",
                                "sense_id": "d07ddcbc-570c-3c7e-973b-f8aa94f07e47",
                                "text": "„Aber es ist kein Ghetto der Jugendlichkeit und Radikalität entstanden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
