                        "glosses": [
                            "Pisser."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a9702b06-ece0-4f22-a8c6-e17065a00682",
                                "sense_id": "4a51cac4-c0c8-3508-8649-c2615be4d043",
                                "text": "Je crains une réaction en chaîne, je n’insiste pas, affolé, je me lève et vais lisbroquer, la laissant pantelante et insatisfaite."
                            },
                            {
                                "example_id": "537ab174-4db5-4b83-a3d9-8217d3d33f21",
                                "sense_id": "4a51cac4-c0c8-3508-8649-c2615be4d043",
                                "text": "Le scrupule la tenaille comme une envie de lisbroquer."
                            }
                        ]
                    }
