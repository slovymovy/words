                                                "example_id": "60814b5a-16d4-48f9-81f5-51d3a337540c",
                                                "sense_id": "d9af51f8-5446-32f9-b9fb-b1b210ec8494",
                                                "text": "Motivados algunos por el deseo biempensante de ayudar al prójimo, y otros por el deseo de pertenecer a una casta privilegiada, los principales líderes del mundo occidental han abandonado el modelo de la libertad por distintas versiones de lo que llamamos colectivismo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8153821-8f3c-4d43-943b-f1bb0bb7e107",
                        "source_entry_id": "01b8e428-2e08-3413-ae95-ac909a6abbfa",
                        "source_sense_description": "принцип",
                        "target_lang_word": "collettivismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collettivismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "50329af4-4620-3f77-92fe-643b41be73b6",
                                        "entry_id": "40c1896b-77cc-3971-a038-643df8c6ca8a",
                                        "glosses": [
                                            "visione morale, politica, economica e sociale che esalta la dipendenza reciproca di ogni individuo e la priorità delle esigenze di gruppo su quelle personali"
                                        ],
                                        "tags": [
                                            "diritto"
