                            {
                                "example_id": "552ea666-2040-48d3-9499-6a1bac18ff2b",
                                "sense_id": "d9182b2f-cf22-3fc2-9790-806c1dd3f525",
                                "text": "Jay-Z (48) is zaterdag in gesprek met CNN eerlijk over de huwelijksproblemen die de rapper en zangeres Beyoncé hebben doorstaan. Naar eigen zeggen doen ze er alles aan om bij elkaar te blijven en is Bee zijn soulmate."
                            },
                            {
                                "example_id": "a4c54c19-771f-4397-b4f0-791031ab2c3d",
                                "sense_id": "d9182b2f-cf22-3fc2-9790-806c1dd3f525",
                                "text": "The Sun schrijft dat het wereldberoemde echtpaar huwelijksproblemen begint te krijgen, al doen ze hun best om het merk Beckham te beschermen. Vooral Victoria zou zich steeds minder prettig voelen bij de nieuwe levensstijl van David als zakenman, die naast werken, vooral uit feesten bestaat."
                            },
                            {
                                "example_id": "4f46de88-0657-4d22-b748-87a3c13bdc94",
                                "sense_id": "d9182b2f-cf22-3fc2-9790-806c1dd3f525",
                                "text": "Burgemeester Joris Bengevoord van Winterswijk stelt dat raadsleden met huwelijksproblemen of arbeidsconflicten kwetsbaar en daardoor chantabel kunnen zijn. Hij pleit voor een schone lijst voor de verkiezingen in maart."
                            }
                        ]
