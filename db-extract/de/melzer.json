                ],
                "senses": [
                    {
                        "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                        "entry_id": "3cad466b-8ef2-321b-82ff-7ab060c17898",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ce25a6-cc08-468d-a6d0-b992091d982a",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Frau Melzer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4100e9d0-a041-4663-a85c-047f00f026cd",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Herr Melzer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bccaba69-ed06-4059-9ab7-f113a4a9869a",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Die Melzers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4750942d-73bb-4b06-906b-0be1cf0d8855",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Der Melzer trägt nie die Schals, die die Melzer ihm strickt."
                            },
                            {
                                "example_id": "27350988-96df-4ea1-a3b5-7cf9ac821960",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Melzer kommt, geht der Herr Melzer.“"
                            },
                            {
                                "example_id": "4d84d26d-679b-4fc3-8107-4e0d76b1a3b8",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Melzer kommt und geht."
                            },
                            {
                                "example_id": "a5ac4ece-a7e8-4cc0-8f19-eecfc240460d",
                                "sense_id": "187c05a0-e58e-372a-bee8-e7001627d3c3",
                                "text": "Melzers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
