                    "semantic_group_id": "null",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden earthquake was a <w>terrifying</w> experience for everyone in the city.",
                            "target_lang_translations": {
                                "ru": "Внезапное землетрясение стало <w>ужасающим</w> переживанием для всех жителей города.",
                                "nl": "De plotselinge aardbeving was een <w>angstaanjagende</w> ervaring voor iedereen in de stad.",
                                "pl": "Nagłe trzęsienie ziemi było <w>przerażającym</w> doświadczeniem dla wszystkich mieszkańców miasta.",
                                "de": "Das plötzliche Erdbeben war eine <w>furchteinflößende</w> Erfahrung für alle in der Stadt.",
                                "fr": "Le tremblement de terre soudain a été une expérience <w>terrifiante</w> pour tous les habitants de la ville.",
                                "it": "L'improvviso terremoto è stato un'esperienza <w>terrificante</w> per tutti in città.",
                                "cs": "Náhlé zemětřesení bylo pro všechny ve městě <w>děsivým</w> zážitkem.",
                                "tr": "Ani deprem, şehirdeki herkes için <w>korkunç</w> bir deneyimdi.",
                                "es": "El repentino terremoto fue una experiencia <w>aterradora</w> para todos en la ciudad.",
                                "zh": "对于城里的每个人来说，那场突如其来的地震是一次<w>可怕的</w>经历。"
                            }
                        },
                        {
                            "text": "She woke up screaming after having an absolutely <w>terrifying</w> nightmare.",
                            "target_lang_translations": {
                                "ru": "Она проснулась с криком после совершенно <w>жуткого</w> кошмара.",
                                "nl": "Ze werd schreeuwend wakker na een absoluut <w>huiveringwekkende</w> nachtmerrie.",
                                "pl": "Obudziła się z krzykiem po absolutnie <w>przerażającym</w> koszmarze.",
                                "de": "Sie wachte schreiend auf, nachdem sie einen absolut <w>schrecklichen</w> Albtraum hatte.",
                                "fr": "Elle s'est réveillée en criant après avoir fait un cauchemar absolument <w>terrifiant</w>.",
                                "it": "Si è svegliata urlando dopo aver fatto un incubo assolutamente <w>spaventoso</w>.",
                                "cs": "Probudila se s křikem poté, co měla naprosto <w>hrůznou</w> noční můru.",
                                "tr": "Kesinlikle <w>dehşet verici</w> bir kabus gördükten sonra çığlık atarak uyandı.",
                                "es": "Ella se despertó gritando después de tener una pesadilla absolutamente <w>aterradora</w>.",
                                "zh": "她做了一个极其<w>吓人的</w>噩梦，醒来时还在尖叫。"
                            }
                        }
                    ],
