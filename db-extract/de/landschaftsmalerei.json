                        "source_sense_id": "7c1f89b0-b69e-3809-ab97-3999f38fe547",
                        "source_sense_description": "Gattung der Malerei",
                        "target_lang_word": "landschapsschilderkunst",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landschapsschilderkunst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "267a5a6b-6baa-3904-99c5-505e946ceaa7",
                                        "entry_id": "f818d737-db5c-3181-9ece-d5d4b2da500f",
                                        "glosses": [
                                            "een schildergenre waarin taferelen met onder meer bergen, valleien, vlakten, bomen, rivieren, zeeën en bossen het belangrijkste onderwerp vormen"
                                        ],
                                        "tags": [
                                            "schilderkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4ae868c-98c5-4453-af2b-feeaf7298756",
                                                "sense_id": "267a5a6b-6baa-3904-99c5-505e946ceaa7",
                                                "text": "`Theo Blake bereikte al heel vroeg een piek, maar behield zijn aanvankelijke uitmuntendheid niet,'meldde een bron. 'Hij had de idealen van de Glasgow School hoog in het vaandel staan en werkte ën plein air\", combineerde realisme met landschapsschilderkunst en riep emoties op door middel van alledaagse taferelen zonder zoete sentimentaliteit.'"
                                            },
                                            {
                                                "example_id": "cf3fe42e-8e9c-4181-82d9-4a78bf9729fe",
                                                "sense_id": "267a5a6b-6baa-3904-99c5-505e946ceaa7",
                                                "text": "Ger Lataster behoort tot de schilders die kort na de Tweede Wereldoorlog de landschapsschilderkunst in Nederland vernieuwden. Hij probeerde in een steeds vrijere, abstracte vormgeving het wezen van de natuur weer te geven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
