                        "examples": [
                            {
                                "example_id": "41d2f464-4a1b-4093-b4cd-4973ac374c0f",
                                "sense_id": "94c85568-35b0-3310-a22c-9d5f0cbdbade",
                                "text": "Ce garçon avait sacrifié avec tant de zèle à Thémis que ses manches trouées au coude laissaient passer la doublure, ce qui lui avait valu le grade de registrateur de collège."
                            },
                            {
                                "example_id": "c20a0045-a8a0-4bbc-b51e-691240c630c5",
                                "sense_id": "94c85568-35b0-3310-a22c-9d5f0cbdbade",
                                "text": "Il y avait encore un autre vaudeville avec des vers très amusants sur les avoués, et tout particulièrement sur un certain registrateur de collège ; des vers assez hardis ; je m’étonnais même que la censure les eût laissé passer."
                            }
                        ]
