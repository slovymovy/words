                        "sense_id": "0d6c45b2-7773-321f-91f2-0245c393bf60",
                        "entry_id": "124c51a4-22d6-36f2-8272-1a3898903269",
                        "glosses": [
                            "native or inhabitant of Gdynia (usually male)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "e9e5fdc5-f511-45bc-b3ea-3906d68129a0",
                                "sense_id": "0d6c45b2-7773-321f-91f2-0245c393bf60",
                                "text": "— Przyjechałem do Gdyni. — Oto tytuł dialogu, jaki na temat Gdyni przeprowadzi gdynianin ze „szczurem lądowym“.",
                                "translation": "— I came to Gdynia. — This is the title of a dialogue about Gdynia between an inhabitant of Gdynia and a “landlubber.”",
                                "english": "— I came to Gdynia. — This is the title of a dialogue about Gdynia between an inhabitant of Gdynia and a “landlubber.”"
                            },
                            {
                                "example_id": "19c82650-abd1-4cfd-b72b-a37e07ad84a6",
                                "sense_id": "0d6c45b2-7773-321f-91f2-0245c393bf60",
                                "text": "Nawet dwa lata w więzieniu może spędzić 78-letni gdynianin, którego policjanci przyłapali na strzelaniu z broni pneumatycznej do ptaków.",
                                "translation": "A 78-year-old inhabitant of Gdynia may spend up to two years in prison after being caught by police officers while shooting birds with an air gun.",
                                "english": "A 78-year-old inhabitant of Gdynia may spend up to two years in prison after being caught by police officers while shooting birds with an air gun."
                            },
                            {
                                "example_id": "46d5d96c-ceb8-4e91-9d66-b711b241445a",
                                "sense_id": "0d6c45b2-7773-321f-91f2-0245c393bf60",
                                "text": "Według mnie każdy gdynianin powinien ten film obejrzeć.",
                                "translation": "In my opinion, every inhabitant of Gdynia should watch this film.",
                                "english": "In my opinion, every inhabitant of Gdynia should watch this film."
                            }
                        ]
                    }
                ],
