                    {
                        "sense_id": "44b26a3c-3367-3de6-8656-e887d57f0e6f",
                        "entry_id": "51a14a47-c00c-3d1a-8c90-1d05bac04690",
                        "glosses": [
                            "A traditional Korean hat made of horsehair, once worn by married gentlemen."
                        ],
                        "tags": [],
