                "senses": [
                    {
                        "sense_id": "858172e6-ea0f-38c6-9b88-0f40c8c4c3bb",
                        "entry_id": "ef5bfce6-e934-3d1f-9802-5a377d645e4a",
                        "glosses": [
                            "Aufbewahrung/Lagerung von Gas"
