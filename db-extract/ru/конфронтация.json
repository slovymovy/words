                    }
                ],
                "senses": [
                    {
                        "sense_id": "6280d5c8-caa5-3730-ac42-8f210c918052",
                        "entry_id": "8b91a4d3-e704-3426-bcab-ccccde63f9c2",
                        "glosses": [
                            "книжн. жёсткое противостояние, противоборство, столкновение взглядов, принципов, социальных систем и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7034a63-b835-4550-9e6a-3e0f2a0b5080",
                                "sense_id": "6280d5c8-caa5-3730-ac42-8f210c918052",
                                "text": "Как бы это ни называлось в то время, мы боролись за наше право на конфронтацию, за образ жизни, альтернативный зажёванной «американской мечте» с её долларами, бондами, закладными, «кадиллаками» и загородным комфортом."
                            },
                            {
                                "example_id": "13af39c6-7a3f-41bf-aed3-6df951eceac6",
                                "sense_id": "6280d5c8-caa5-3730-ac42-8f210c918052",
                                "text": "Тёща почувствует в моих интонациях тщательно скрытый сарказм и, чтобы избежать возможной конфронтации, утянет жену в магазин, так как давно собиралась купить резинку для демисезонных трусов, но руки всё не доходили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25ca916b-6518-4c7b-8bc1-e12cfa9ec468",
                        "source_entry_id": "8b91a4d3-e704-3426-bcab-ccccde63f9c2",
                        "source_sense_id": "6280d5c8-caa5-3730-ac42-8f210c918052",
                        "target_lang_word": "confrontation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confrontation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c2b480-840b-3602-8e9e-1904e56f16f9",
                                        "entry_id": "c735ed6d-27a4-38e4-ab08-ac3179787046",
                                        "glosses": [
                                            "The act of confronting or challenging another, especially face to face."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c4ce73-2c89-4195-a38f-d21de43a012c",
                                                "sense_id": "f5c2b480-840b-3602-8e9e-1904e56f16f9",
                                                "text": "During the late 1950s and throughout the 1960s, this commitment brought him into frequent critical confrontation with entrenched forms of conservative thinking (in academic areas from history and social science to the more abstract domains of ethical and political philosophy)[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421329db-b99a-300f-b568-560ee651c17d",
                                        "entry_id": "c735ed6d-27a4-38e4-ab08-ac3179787046",
                                        "glosses": [
                                            "A conflict between armed forces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39d54e03-95de-4e49-be66-1703b0e122ca",
                        "source_entry_id": "8b91a4d3-e704-3426-bcab-ccccde63f9c2",
                        "source_sense_id": "6280d5c8-caa5-3730-ac42-8f210c918052",
                        "target_lang_word": "Konfrontation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfrontation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a5dd795-9650-3635-813b-cdc28c0eea34",
                                        "entry_id": "386b629b-56b5-38c5-a0e2-5f3e17f72678",
                                        "glosses": [
                                            "Gegenüberstellung von Dingen, Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a98b29a-864d-47b9-9930-a8e3bb1acdbc",
                                                "sense_id": "4a5dd795-9650-3635-813b-cdc28c0eea34",
                                                "text": "Dabei wird in der Konfrontation von Arbeiten verschiedener Fotografen der Blick auf die unterschiedlichen Perspektiven gelenkt. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "a48eb325-e9d5-4423-902c-54625478bc09",
                                                "sense_id": "4a5dd795-9650-3635-813b-cdc28c0eea34",
                                                "text": "„Thomas Sendler geht Konfrontationen gerne aus dem Weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                        "entry_id": "386b629b-56b5-38c5-a0e2-5f3e17f72678",
                                        "glosses": [
                                            "Auseinandersetzung zwischen Parteien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5938818-7468-473d-9e8b-3539feb4000b",
                                                "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                                "text": "Er suchte die Konfrontation mit seinem Gegner."
                                            },
                                            {
                                                "example_id": "66cf38c7-8a84-4e1a-a29b-0fa1600e7796",
                                                "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                                "text": "Aus dieser Konfrontation kann keiner als Sieger hervorgehen."
                                            },
                                            {
                                                "example_id": "760d0d25-5c60-496d-a73c-b3b886c3054f",
                                                "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                                "text": "„Es war die zweite größere Konfrontation zwischen Germanen und Römern.“"
                                            },
                                            {
                                                "example_id": "31639a96-f269-4591-832f-ee071b99af20",
                                                "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                                "text": "„Kepler und Galilei waren keineswegs auf eine Konfrontation mit der Kirche aus.“"
                                            },
                                            {
                                                "example_id": "15267ec2-a46b-4414-96f7-632523ebf76b",
                                                "sense_id": "dc3890c1-a99a-324e-994d-aaa222e13c5e",
                                                "text": "„Eine offene Konfrontation mit der Staatsmacht wie in Berlin wollte die SPD in München vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0835c2f1-d2b7-3527-8bb4-c99c25829fb8",
                                        "entry_id": "386b629b-56b5-38c5-a0e2-5f3e17f72678",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed6e5c2-9112-4623-aca5-5ad414310986",
                                                "sense_id": "0835c2f1-d2b7-3527-8bb4-c99c25829fb8",
                                                "text": "Die Konfrontation zwischen dem Westen und der islamischen Welt. (Internetbeleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1 oder 2\""
                                    }
                                ]
                            }
                        ]
