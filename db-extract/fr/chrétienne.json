                        ],
                        "examples": [
                            {
                                "example_id": "2296d46c-3af0-417a-be90-88c50a3968f8",
                                "sense_id": "63f0bd2a-a0d3-3fcf-aa59-cef91c136da9",
                                "text": "Or, dans la pensée chrétienne, plusieurs serpents jouent un rôle de grande importance."
