                ],
                "senses": [
                    {
                        "sense_id": "1ed482fd-4057-3598-a2ea-ffe25089f113",
                        "entry_id": "5d236dfe-94a3-3d0b-a338-0d585321a3e7",
                        "glosses": [
                            "The condition of an organism that is able to reproduce as both male and female, either simultaneously (simultaneous hermaphroditism or cosexuality) or sequentially (sequential hermaphroditism or dichogamy)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2f9cc374-6c3c-4603-9ea7-beb0dca5cedb",
                                "sense_id": "1ed482fd-4057-3598-a2ea-ffe25089f113",
                                "text": "Among other organisms, alternative methods of reproduction include budding, hermaphroditism (one individual carrying both kinds of sex organs) and isogamy (two individuals, not distinguished as male and female, combining their genes)."
                            }
                        ]
                    },
                    {
                        "sense_id": "db40bb0b-affb-3014-b7d6-223d823c1266",
                        "entry_id": "5d236dfe-94a3-3d0b-a338-0d585321a3e7",
                        "glosses": [
                            "The condition of intersex people with intermediate sex characteristics or pseudohermaphroditism."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "historical",
                            "offensive",
                            "uncountable"
                        ],
                        "examples": []
                    }
