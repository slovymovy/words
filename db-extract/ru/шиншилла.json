                "translations": [
                    {
                        "translation_id": "788a914f-8640-4b60-9af4-a764bf08f285",
                        "source_entry_id": "e09760c6-ffeb-3f16-a2a7-52e7c73b42c0",
                        "target_lang_word": "chinchilla",
