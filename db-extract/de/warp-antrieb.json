                "senses": [
                    {
                        "sense_id": "e5f6013b-096f-3c8b-b4e2-423923091812",
                        "entry_id": "0f47e836-1375-34ae-99f5-5c101bfd4a61",
                        "glosses": [
                            "fiktiver beziehungsweise hypothetischer Antrieb für Raumfahrzeuge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b05b0264-eef5-45f2-85c9-03c6b476ea87",
                                "sense_id": "e5f6013b-096f-3c8b-b4e2-423923091812",
                                "text": "\"Aufgrund seiner Ergebnisse sei der Warp-Antrieb nicht mehr \"unmöglich\", sondern \"plausibel und es wert, weiter erforscht zu werden\", sagte White Space.com im Anschluss an seinen Vortrag.\""
                            },
                            {
                                "example_id": "ec00aa72-19f9-49eb-a8bb-9c2a556946fc",
                                "sense_id": "e5f6013b-096f-3c8b-b4e2-423923091812",
                                "text": "Doch könnte der Warp-Antrieb aus \"Star Trek\" tatsächlich funktionieren? Forscher bezweifeln das: Nach ihren Berechnungen würde Captain Kirks \"Enterprise\" jeden besuchten Planeten mit Strahlung braten."
                            },
                            {
                                "example_id": "ee02f252-e28b-4c93-a6d4-9aea7746db80",
                                "sense_id": "e5f6013b-096f-3c8b-b4e2-423923091812",
                                "text": "Marc Millis war von 1996 bis 2002 Leiter von NASAs Breakthrough Propulsion Physics Programms und beschäftigte sich damals unter anderem mit dem Warp Antrieb. Rückblickend sagt er heute dazu: Er funktioniert nicht, obwohl sehr interessant."
                            },
                            {
                                "example_id": "d0480ba6-b0d6-4cab-ab7a-d47732280152",
                                "sense_id": "e5f6013b-096f-3c8b-b4e2-423923091812",
                                "text": "Der Warp-Antrieb (englisch Warp Drive) aus der Star-Trek-Serie ist heute ein Synonym für Überlichtgeschwindigkeit-Antriebe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
