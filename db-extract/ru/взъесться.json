                                "target_senses": [
                                    {
                                        "sense_id": "c5e529b3-47d9-306a-b9af-e5d70e7c5068",
                                        "entry_id": "9aa58d01-5211-3e4f-9613-39b835c5e00b",
                                        "glosses": [
                                            "To experience; to suffer; to fall upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ecac5b-fe31-4b9a-a011-a6712067ca1b",
                                                "sense_id": "c5e529b3-47d9-306a-b9af-e5d70e7c5068",
                                                "text": "With the rise of the Internet, some media fell on hard times."
                                            },
                                            {
                                                "example_id": "6a153dbe-bb2a-4019-9079-83ec1a82b692",
                                                "sense_id": "c5e529b3-47d9-306a-b9af-e5d70e7c5068",
                                                "text": "Labour frontbencher Louise Haigh (Shadow Transport Secretary for heaven's sake!) initially lambasted TOCs before the handful of specialist rail commentators fell on her tweets and she changed her tune, refocusing her fire on Government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc738c6-e930-3585-8308-438a3932d468",
                                        "entry_id": "9aa58d01-5211-3e4f-9613-39b835c5e00b",
                                        "glosses": [
                                            "To be assigned to; to acquire a new responsibility, duty or burden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "196fa070-3b78-43f8-aff6-1e399e0e77e8",
                                                "sense_id": "6dc738c6-e930-3585-8308-438a3932d468",
                                                "text": "This decision is important, and it falls on you to make it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52065ae1-fa0d-38d6-8783-64cdaa4ce02e",
                                        "entry_id": "9aa58d01-5211-3e4f-9613-39b835c5e00b",
                                        "glosses": [
                                            "To occur on a particular day."
                                        ],
                                        "tags": [
                                            "of a holiday or event"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb82063-716c-4960-bde9-4a73590454ff",
                                                "sense_id": "52065ae1-fa0d-38d6-8783-64cdaa4ce02e",
                                                "text": "The first day of spring this year will fall on a Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a5f32c9-368d-3796-87bf-264878a6ccc5",
                                        "entry_id": "9aa58d01-5211-3e4f-9613-39b835c5e00b",
                                        "glosses": [
                                            "Of the eyes or gaze: to alight upon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6b55d13-a0d3-35f2-a210-af7ff914f099",
                                        "entry_id": "9aa58d01-5211-3e4f-9613-39b835c5e00b",
                                        "glosses": [
                                            "To attack (someone); to join an attack on (someone), especially a surprise attack."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ffdcd33-4c75-4c71-9d59-3a808dd159e8",
                        "source_entry_id": "690efa56-b52e-3efd-a44f-6b85c6d838f6",
                        "source_sense_id": "6e869e61-a1e4-34ec-9f99-c5111de250a9",
                        "target_lang_word": "go for",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "go for",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see go, for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a699b12-c899-4369-aa5e-2f508a1ab3ae",
                                                "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                                "text": "I'll go for some milk."
                                            },
                                            {
                                                "example_id": "99bac967-f1d4-4cfb-ad77-7a44b0031992",
                                                "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                                "text": "If John goes for three days without sleep, he will be very tired."
                                            },
                                            {
                                                "example_id": "e6f72c0d-10c6-4b8e-9011-1c697a235e8c",
                                                "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                                "text": "I need to go for a checkup at the clinic."
                                            },
                                            {
                                                "example_id": "863dfe0e-4daa-40e9-9cb3-474de368f929",
                                                "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                                "text": "Tickets are going for upwards of $100."
                                            },
                                            {
                                                "example_id": "4f04a34b-e22c-4d97-aa46-51f820d7f171",
                                                "sense_id": "fa3c349d-9597-3963-8439-4edaf70b197b",
                                                "text": "I've gotta go for a job interview next Mon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c195f236-86f9-36f3-a24b-dfdf522403f9",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To try for, to attempt to reach."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "842b2bfd-bca1-4f18-94bd-f79973401706",
                                                "sense_id": "c195f236-86f9-36f3-a24b-dfdf522403f9",
                                                "text": "I'll go for the world record."
                                            },
                                            {
                                                "example_id": "a4702e79-9648-4b75-8941-30b02ad0bd12",
                                                "sense_id": "c195f236-86f9-36f3-a24b-dfdf522403f9",
                                                "text": "Go for it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42301541-4559-380c-82d4-51bf7e37066e",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To undertake (an action); to choose an option."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fda92dc-909d-4a41-a4f8-15b29d5806ed",
                                                "sense_id": "42301541-4559-380c-82d4-51bf7e37066e",
                                                "text": "His phone was off so I couldn't ask his permission, so I decided to just go for it."
                                            },
                                            {
                                                "example_id": "eac420dd-d9f7-4c27-9dab-78bcbcecf5b6",
                                                "sense_id": "42301541-4559-380c-82d4-51bf7e37066e",
                                                "text": "I'll go for a swim if it's warm enough."
                                            },
                                            {
                                                "example_id": "31a37308-cd00-4c1d-adf8-b90be2466c27",
                                                "sense_id": "42301541-4559-380c-82d4-51bf7e37066e",
                                                "text": "I went for the pay-as-you-go plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69063bed-b208-3281-8973-7e8346053e77",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To attack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b6d0dde-6c2a-4195-a8d5-1a448c01daf2",
                                                "sense_id": "69063bed-b208-3281-8973-7e8346053e77",
                                                "text": "Careful, he'll go for your throat!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdba1881-0363-304d-9940-7709b58ca8f5",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To develop a strong interest in, especially in a sudden manner; to be infatuated with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785eb813-135f-4415-99c1-a3bd7d83e492",
                                                "sense_id": "cdba1881-0363-304d-9940-7709b58ca8f5",
                                                "text": "Douglas: Well done on passing the test, Jen... Yes, all those clumsy attempts at seduction. Don't tell me you couldn't see through them. They were a test to find out whether you really wanted to work for me or whether you just wanted to come up here for my body.\nJen: Oh, no, no, no, no, no, not at all.\nDouglas: All right.\nJen: No, physically you're just not the sort of man I go for.\nDouglas: Yeah, thanks, Jen.\nJen: I go for the classically good-looking men: Blond, broad, and generally clean shaven.\nDouglas: Alright, yeah, enough of the jibber-jabber!"
                                            },
                                            {
                                                "example_id": "095d8e07-c485-4025-8c37-3473c18fadd3",
                                                "sense_id": "cdba1881-0363-304d-9940-7709b58ca8f5",
                                                "text": "Clyde took one look at Bonnie and really went for her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4fde802-e739-38e0-b50c-0fcfacc906a2",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To favor, accept; to have a preference for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6a37e48-cc24-41f2-a79d-c40016eb4404",
                                                "sense_id": "d4fde802-e739-38e0-b50c-0fcfacc906a2",
                                                "text": "Management won't go for such a risky project now."
                                            },
                                            {
                                                "example_id": "86741b1e-0d8b-4e9b-b7aa-f7d50177180f",
                                                "sense_id": "d4fde802-e739-38e0-b50c-0fcfacc906a2",
                                                "text": "Do you want to climb the mountain with me?\nYeah, I could go for that."
                                            },
                                            {
                                                "example_id": "e0b6d4cc-0b54-4235-bf45-06353b94d409",
                                                "sense_id": "d4fde802-e739-38e0-b50c-0fcfacc906a2",
                                                "text": "And the judge and the jury\nThey all put the blame on me\nThey wouldn't go for my story\nThey wouldn't hear my plea"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3bc8b9-244e-3fba-b7a2-729f195b771a",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To fall for (a trick)"
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86a08485-843a-3bb3-9f39-cf82495a5cc2",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To apply equally to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89674af8-3576-4578-846e-ba1e6845a116",
                                                "sense_id": "86a08485-843a-3bb3-9f39-cf82495a5cc2",
                                                "text": "Stop taking my food from the fridge! That goes for you too, Nick!"
                                            },
                                            {
                                                "example_id": "d4b39fb5-3ff3-447e-8ade-5fd334e2509e",
                                                "sense_id": "86a08485-843a-3bb3-9f39-cf82495a5cc2",
                                                "text": "What I'm about to say goes for all of you."
                                            },
                                            {
                                                "example_id": "30eebd5a-900f-4ea0-a618-e3428795ff05",
                                                "sense_id": "86a08485-843a-3bb3-9f39-cf82495a5cc2",
                                                "text": "My wife hates football, and that goes for me as well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749583f8-44c9-3d59-b373-fa8e2926ffa6",
                                        "entry_id": "6f084587-9790-34c9-b712-4542aacf7265",
                                        "glosses": [
                                            "To suffice to be used for; to serve as."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8142cb0-f3ce-4e6e-83ed-72410cedec54",
                                                "sense_id": "749583f8-44c9-3d59-b373-fa8e2926ffa6",
                                                "text": "It's a desk that goes for a dresser too."
                                            },
                                            {
                                                "example_id": "82d90b30-fa7e-45d0-9a9d-f567ccd8bd67",
                                                "sense_id": "749583f8-44c9-3d59-b373-fa8e2926ffa6",
                                                "text": "[…] every of them, being gold, whole and weight, shall go and be current in payment throughout this his realm for the sum that they were coined for."
