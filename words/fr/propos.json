                {
                    "sense_id": "e7224c3e-4d6e-3651-b4b3-997107d36459",
                    "sense_definition": "Intention arrêtée, résolution délibérée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a agi de <w>propos</w> délibéré pour provoquer une réaction rapide de son adversaire.",
                            "target_lang_translations": {
                                "en": "He acted with deliberate <w>intent</w> to provoke a quick reaction from his opponent.",
                                "ru": "Он действовал с <w>умыслом</w>, чтобы спровоцировать быструю реакцию своего соперника.",
                                "nl": "Hij handelde met <w>opzet</w> om een snelle reactie van zijn tegenstander uit te lokken.",
                                "de": "Er handelte mit <w>Vorsatz</w>, um eine schnelle Reaktion seines Gegners zu provozieren.",
                                "pl": "Działał z <w>premedytacją</w>, aby sprowokować szybką reakcję przeciwnika.",
                                "it": "Ha agito di <w>proposito</w> per provocare una reazione rapida del suo avversario.",
                                "cs": "Jednal s <w>úmyslem</w> vyprovokovat rychlou reakci protivníka.",
                                "tr": "Rakibinden hızlı bir tepki çıkarmak için <w>kasıtla</w> hareket etti.",
                                "es": "Actuó a <w>propósito</w> para provocar una reacción rápida de su adversario.",
                                "zh": "他怀着明确的<w>意图</w>行动，想要激起对手迅速的反应。"
                            }
                        },
                        {
                            "text": "Elle avait le ferme <w>propos</w> de corriger ses erreurs du passé sans hésiter.",
                            "target_lang_translations": {
                                "en": "She had the firm <w>resolve</w> to correct her past mistakes without hesitation.",
                                "ru": "Она была полна твёрдой <w>решимости</w> исправить свои прошлые ошибки, не колеблясь.",
                                "nl": "Ze had het vaste <w>voornemen</w> om haar fouten uit het verleden zonder aarzelen te verbeteren.",
                                "de": "Sie hatte den festen <w>Entschluss</w>, ihre Fehler aus der Vergangenheit ohne Zögern zu korrigieren.",
                                "pl": "Miała stanowcze <w>postanowienie</w>, aby bez wahania poprawić swoje błędy z przeszłości.",
                                "it": "Aveva il fermo <w>proposito</w> di correggere i suoi errori del passato senza esitare.",
                                "cs": "Měla pevné <w>předsevzetí</w>, že bez váhání napraví své chyby z minulosti.",
                                "tr": "Geçmişteki hatalarını tereddüt etmeden düzeltmek için kesin bir <w>kararlılığı</w> vardı.",
                                "es": "Tenía el firme <w>propósito</w> de corregir sus errores del pasado sin vacilar.",
                                "zh": "她有坚定的<w>决心</w>，要毫不犹豫地改正过去的错误。"
                            }
                        }
