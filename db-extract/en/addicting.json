                "senses": [
                    {
                        "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                        "entry_id": "8d7f55f2-a15f-3d6e-b3c1-40bac0580826",
                        "glosses": [
                            "Causing addiction."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "5efb4a12-99a3-447f-8be6-bf42bf933364",
                                "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                                "text": "whether any of the substances possess addicting properties is very difficult to determine on animals, although efforts are being made to study this aspect of the problem on dogs and monkeys."
                            },
                            {
                                "example_id": "33e5919c-bd22-43cb-88bd-b4a6df7f28a3",
                                "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                                "text": "similar in action to codeine salts but when compared with codeine on the basis of weight is more active, and more addicting."
                            },
                            {
                                "example_id": "da5cb7bd-8907-42b5-9cde-40bed40dd6cc",
                                "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                                "text": "When we didn't have narcotics laws, when we could go and buy this stuff like you could candy and potatoes, laudanum was a very addicting drug"
                            },
                            {
                                "example_id": "7774f274-5eee-450e-b4ac-67e661fbdfa0",
                                "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                                "text": "Cocaine has been reconceptualized as our most addicting drug and crack is viewed as the most addicting form of cocaine"
                            },
                            {
                                "example_id": "94301947-a511-4d29-b51b-f5f74c6a34f1",
                                "sense_id": "fa6ae925-a7ee-3387-a67c-60e8233a953f",
                                "text": "That is why smoking and intravenous injection are the routes of administration chosen by addicted people and why these routes of administration are so much more addicting than is oral use of the same drug."
                            }
                        ]
                    }
                ],
                "translations": [],
