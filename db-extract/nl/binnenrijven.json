                "senses": [
                    {
                        "sense_id": "ca405df5-674d-3dc9-8bdf-676c9af1b9f5",
                        "entry_id": "829e0696-b281-3a2d-9e56-9ddd8c20e755",
                        "glosses": [
                            "winnen of ontvangen van iets dat men graag wil hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5850896e-1264-4f64-b26a-85d7b54f75c2",
                                "sense_id": "ca405df5-674d-3dc9-8bdf-676c9af1b9f5",
                                "text": "Met het geld dat ze binnenrijven met de verkoop van licht en leds heeft Philips in het afgelopen half jaar maar liefst zeven overnames gedaan in de gezondheidszorg, voor naar schatting zo'n 2,5 miljard euro. Grootste aankoop is het Amerikaanse Spectranetics, voor bijna 1,5 miljard euro."
                            },
                            {
                                "example_id": "47a94476-030d-4906-be4b-c6256fa9ab20",
                                "sense_id": "ca405df5-674d-3dc9-8bdf-676c9af1b9f5",
                                "text": "De partij van Kyriakos Mitsotakis zal mogelijk 155 tot 165 van de 300 parlementszetels binnenrijven."
                            },
                            {
                                "example_id": "e782ceba-b5a2-48ef-ac80-117e8e9b0ea1",
                                "sense_id": "ca405df5-674d-3dc9-8bdf-676c9af1b9f5",
                                "text": "Van die 83 politici behoren er 65 tot de People Power Party (PPP), die in het totaal 233 zetels binnenrijfde."
                            }
                        ]
                    }
