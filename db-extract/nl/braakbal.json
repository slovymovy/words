                "senses": [
                    {
                        "sense_id": "61c819b6-a332-3bd3-a8e3-9641dbd75988",
                        "entry_id": "a17e0a6d-ace7-37be-8137-bacf841e3b07",
                        "glosses": [
                            "de door sommige vogels uitgebraakte onverteerbare resten van het voedsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a598fa7f-0b40-462e-9a50-9650d2ceccb8",
                                "sense_id": "61c819b6-a332-3bd3-a8e3-9641dbd75988",
                                "text": "Het onderzoek van braakballen is een vast onderdeel van het biologieonderwijs."
                            },
                            {
                                "example_id": "2ea2068f-ea71-41b7-b95f-7f3f1dd87f5d",
                                "sense_id": "61c819b6-a332-3bd3-a8e3-9641dbd75988",
                                "text": "En zo geschiedde. Dinsdagmiddag vonden medewerkers van Dragonheart de braakbal, inclusief haak en draad. Voor Aragorn liep het goed af, maar het bedrijf zegt het probleem vaker mee te maken."
                            },
                            {
                                "example_id": "9af32839-e695-4dcd-a0b6-1205bffcf2a2",
                                "sense_id": "61c819b6-a332-3bd3-a8e3-9641dbd75988",
                                "text": "Ik stopte allerlei zaden in de magen van dode vissen en voerde die vissen aan visarenden, ooievaars en pelikanen; de zaden kwamen vele uren later in braakballen of via de feces weer uit het lichaam van deze vogels tevoorschijn; en verschillende van deze zaden hadden hun kiemkracht behouden."
                            }
                        ]
                    }
                ],
