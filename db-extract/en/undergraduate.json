                "senses": [
                    {
                        "sense_id": "715519b0-7d2c-3a56-88a6-d059bd2cc1ff",
                        "entry_id": "183b83ea-8f6a-35b9-85d5-6437fd00d952",
                        "glosses": [
                            "A student at a university who has not yet received a degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f1f024-aa14-46d7-978c-de9c9f02d0b6",
                                "sense_id": "715519b0-7d2c-3a56-88a6-d059bd2cc1ff",
                                "text": "Daniel Hajas is a physics undergraduate at Sussex and has been blind since he was 16. He first heard about Giles and the SSDs when Giles was looking for blind students to test the devices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d084c308-6aa7-4f7f-a86c-3c0f92237e77",
                        "source_entry_id": "183b83ea-8f6a-35b9-85d5-6437fd00d952",
                        "source_sense_id": "715519b0-7d2c-3a56-88a6-d059bd2cc1ff",
                        "source_sense_description": "student at a university who has not yet received a degree",
                        "target_lang_word": "étudiant de licence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "701ed155-6402-4449-b5f9-d5acff1c3a5a",
                        "source_entry_id": "183b83ea-8f6a-35b9-85d5-6437fd00d952",
                        "source_sense_id": "715519b0-7d2c-3a56-88a6-d059bd2cc1ff",
                        "source_sense_description": "student at a university who has not yet received a degree",
                        "target_lang_word": "Student",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Student",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                        "entry_id": "3cdb4f39-2955-3daa-bf28-6483c55cc833",
                                        "glosses": [
                                            "Person, die an einer Universität oder Fachhochschule studiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30bf535-8676-4587-9cb6-623fa1923cd7",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "Sind Sie Student dieser Universität?"
                                            },
                                            {
                                                "example_id": "eac7a33f-205f-461d-9702-dbc92eb055cb",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                                            },
                                            {
                                                "example_id": "158cfe27-3175-459b-b19d-29817bdce361",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "cf5ec9b2-1408-41af-bd6a-b70389c4eeb5",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Die meisten Studenten sind Krüppel und Kranke, die der Krieg freigab.“"
                                            },
                                            {
                                                "example_id": "7e816e7d-7db8-429c-9be1-0b40eae3d2b1",
                                                "sense_id": "7afb250c-5c16-3f93-9106-2c44b5fc8c61",
                                                "text": "„Junge Leute, eben auch meine Studenten und Studentinnen, waren fasziniert von dem neuen Modell, als sie erstmals davon Kenntnis erhielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48524f1-9727-45da-9a9a-9e646d59900d",
                        "source_entry_id": "183b83ea-8f6a-35b9-85d5-6437fd00d952",
                        "source_sense_id": "715519b0-7d2c-3a56-88a6-d059bd2cc1ff",
                        "source_sense_description": "student at a university who has not yet received a degree",
                        "target_lang_word": "студе́нт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "студе́нт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bdc2f6db-0240-3a90-8b1b-a69ab127be9a",
                                        "entry_id": "4d2346df-f92e-3116-aa15-686a6b0a41a3",
                                        "glosses": [
                                            "учащийся высшего или среднего учебного заведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ada1728b-092e-4980-b02f-696a02b1d212",
                                                "sense_id": "bdc2f6db-0240-3a90-8b1b-a69ab127be9a",
                                                "text": "Мне было весело смотреть на лица студентов; их объятия, восклицания, невинное кокетничанье молодости, горящие взгляды, смех без причины ― лучший смех на свете ― всё это радостное кипение жизни юной, свежей, этот порыв вперёд ― куда бы то ни было, лишь бы вперёд, ― это добродушное раздолье меня трогало и поджигало."
                                            },
                                            {
                                                "example_id": "7002a3f1-cf3a-48ae-b05a-fe790757f02d",
                                                "sense_id": "bdc2f6db-0240-3a90-8b1b-a69ab127be9a",
                                                "text": "Можно сказать, что он с кафедры своей читал в пустыне: на лекции его приходило два, три студента, да иногда человека два наших офицеров или наши генералы Полуектов и Кнорринг."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
