                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоняться",
                                "target_lang_sense_clarification": "ходить без дела"
                            },
                            {
                                "target_lang_word": "болтаться",
                                "target_lang_sense_clarification": "разговорное, проводить время без пользы"
                            },
                            {
                                "target_lang_word": "бездельничать",
                                "target_lang_sense_clarification": "ничем не заниматься"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲逛",
                                "target_lang_sense_clarification": "指漫无目的地走动"
                            },
                            {
                                "target_lang_word": "游荡",
                                "target_lang_sense_clarification": "指无所事事地晃荡"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
