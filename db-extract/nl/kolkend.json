                "senses": [
                    {
                        "sense_id": "e78dd4d0-ae1c-36d5-881d-e009bea2412a",
                        "entry_id": "472a91eb-876a-39ff-b13b-7b17de963400",
                        "glosses": [
                            "wild stromend en ronddraaiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f04327-0f80-4bde-9957-1beff5c70205",
                                "sense_id": "e78dd4d0-ae1c-36d5-881d-e009bea2412a",
                                "text": "- Korte hevige buien vormen de straatjes om tot kolkende rivieren. Even later doet de brandende zon de bui alweer vergeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a754f6d-471e-350c-8169-543eeb75ff4d",
                        "entry_id": "472a91eb-876a-39ff-b13b-7b17de963400",
                        "glosses": [
                            "zeer opgewonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbdf32a-0d95-4e37-b1e6-de8450a06105",
                                "sense_id": "5a754f6d-471e-350c-8169-543eeb75ff4d",
                                "text": "- In een kolkende Arena won Ajax het duel met 3-1 en werd daarmee kampioen van Nederland. De Amsterdammers werden na zes seizoenen zonder titel weer eens kampioen en brachten het totaal op het symbolische aantal van dertig titels. Trainer Frank de Boer, die het stokje halverwege het seizoen overnam van Martin Jol, werd voor het eerst kampioen als trainer."
                            }
                        ]
                    }
