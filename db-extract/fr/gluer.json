                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c347c56c-3c9c-4e8a-a10b-f4b93f8c90fd",
                                "sense_id": "95f00ac0-0df4-3210-add8-1dc1f6acfe48",
                                "text": "Ces confitures lui ont glué les mains."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3c6f442-abee-3385-9ad2-181283916303",
                        "entry_id": "531a7503-5854-3806-b0bb-646c486d426e",
                        "glosses": [
                            "Être ou devenir gluant."
                        ],
                        "tags": [
