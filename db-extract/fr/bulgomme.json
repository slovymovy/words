                "senses": [
                    {
                        "sense_id": "7cac0bc5-c44c-3610-b9fc-c7f086e98aa6",
                        "entry_id": "0dda3ff4-8cad-37b5-a624-5c49a58b8ca5",
                        "glosses": [
                            "Mousse de caoutchouc intégrée à l’origine dans des revêtements de sol puis employée pour d’autres usages, essentiellement comme sous-nappe de table."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "1407506b-f7ca-4950-b7e0-fff435e84746",
                                "sense_id": "7cac0bc5-c44c-3610-b9fc-c7f086e98aa6",
                                "text": "Pour une meilleure protection du rasoir dans la « pochette » supérieure, celle-ci a été recouverte intérieurement de caoutchouc (chambre à air auto) et le fond garni de plusieurs épaisseurs de caoutchouc mousse (ou bulgomme), enveloppé dans un mince sachet de matière plastique."
                            },
                            {
                                "example_id": "ec1e0622-83c2-4198-a1af-acdcf9c3f1ff",
                                "sense_id": "7cac0bc5-c44c-3610-b9fc-c7f086e98aa6",
                                "text": "Si HD veut me retirer, elle me soulève, et là j’enfonce mes griffes dans la nappe et le bulgomme, la nappe vient sous mes griffes, les verres à pied tombent sur la nappe."
                            }
                        ]
                    },
                    {
                        "sense_id": "712ba2e8-1548-3cc4-b766-4a93ee35146c",
                        "entry_id": "0dda3ff4-8cad-37b5-a624-5c49a58b8ca5",
                        "glosses": [
                            "Sous-nappe ou nappe de table en bulgomme."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "d86aa2d4-c693-49dc-b7d2-0cce0dde59b1",
                                "sense_id": "712ba2e8-1548-3cc4-b766-4a93ee35146c",
                                "text": "Pas moins de 34 degrés et le soleil qui tape sur les baies vitrées. J’entends encore le slurp des avant-bras que l’on décollait des bulgommes pour lever son papier."
                            }
                        ]
                    }
