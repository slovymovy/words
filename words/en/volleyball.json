            "senses": [
                {
                    "sense_id": "cfa8d859-5da0-3a0c-a048-7638cf99b6f4",
                    "sense_definition": "A game played by two teams who hit a large ball with their hands over a high net, trying to make it touch the ground on the opponent's side.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to play <w>volleyball</w> on the beach during our vacation.",
                            "target_lang_translations": {
                                "ru": "Мы решили поиграть в <w>волейбол</w> на пляже во время отпуска.",
                                "zh": "假期里我们决定在沙滩上打<w>排球</w>。"
                            }
                        },
                        {
                            "text": "She is the captain of the school <w>volleyball</w> team.",
                            "target_lang_translations": {
                                "ru": "Она капитан школьной команды по <w>волейболу</w>.",
                                "zh": "她是校<w>排球</w>队的队长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play volleyball",
                        "volleyball team",
                        "volleyball court",
                        "beach volleyball",
                        "volleyball match"
                    ],
                    "target_lang_definitions": {
