                "senses": [
                    {
                        "sense_id": "1fdc263b-afac-3129-86cb-02d549d71255",
                        "entry_id": "f7588818-25b4-3651-bab3-0ad062e5b8fc",
                        "glosses": [
                            "gewerbliche Räumlichkeiten, in denen Schuhe zum Verkauf angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd284695-6df5-4442-91ec-f15db51d44f4",
                                "sense_id": "1fdc263b-afac-3129-86cb-02d549d71255",
                                "text": "Herr Müller arbeitet als Verkäufer im Schuhgeschäft."
                            },
                            {
                                "example_id": "b65850f7-26b8-441a-84d8-153563463b69",
                                "sense_id": "1fdc263b-afac-3129-86cb-02d549d71255",
                                "text": "„Das schöne große Schuhgeschäft gehört einer alten Frau, die hat ihren Geschäftsführer geheiratet, und seitdem schläft sie hinten, und es geht ihr schlecht.“"
                            },
                            {
                                "example_id": "f38e9d8c-0824-4251-b76a-419880aaffba",
                                "sense_id": "1fdc263b-afac-3129-86cb-02d549d71255",
                                "text": "„Wir hatten ein Schuhgeschäft in einer der kleinen Seitenstraßen betreten und betrachteten als einzige Kunden eine karge Auswahl an Schuhen auf glatten, weißen Oberflächen.“"
                            },
                            {
                                "example_id": "9b1f4b74-f01c-43bb-a67b-380c2e06c376",
                                "sense_id": "1fdc263b-afac-3129-86cb-02d549d71255",
                                "text": "„Sie blieb vor einem Schuhgeschäft stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
