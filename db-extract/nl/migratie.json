                                    {
                                        "sense_id": "7ac0e33a-4ea6-3a23-9687-8831b4b6647d",
                                        "entry_id": "b5252c09-fe07-3ac7-a6fd-adfb9a95dc25",
                                        "glosses": [
                                            "An instance of moving to live in another place for a while."
