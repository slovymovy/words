{
    "word_family": [
        "progress",
        "progression",
        "progressive",
        "progressiveness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b055b643-98e3-3261-8b0a-4d9e883df820",
                    "sense_definition": "In a manner that happens or develops gradually in stages.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gradual_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficulty of the exercises <w>progressively</w> increases throughout the textbook.",
                            "target_lang_translations": {
                                "tr": "Kitap boyunca alıştırmaların zorluğu <w>giderek</w> artıyor."
                            }
                        },
                        {
                            "text": "We must <w>progressively</w> raise the standards to ensure better quality control.",
                            "target_lang_translations": {
                                "tr": "Daha iyi kalite kontrolü sağlamak için standartları <w>kademe kademe</w> yükseltmeliyiz."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradually",
                        "steadily",
                        "incrementally"
                    ],
                    "common_phrases": [
                        "progressively increase",
                        "progressively difficult"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşamalı olarak, zamanla veya belirli adımlarla gelişen veya gerçekleşen bir biçimde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "giderek",
                                "target_lang_sense_clarification": "Zamanla artan veya değişen bir süreci ifade eder."
                            },
                            {
                                "target_lang_word": "gittikçe",
                                "target_lang_sense_clarification": "Sürecin zaman ilerledikçe devam ettiğini vurgular."
                            },
                            {
                                "target_lang_word": "kademe kademe",
                                "target_lang_sense_clarification": "Belirli aşamalar veya basamaklar halinde gerçekleşen durumlar için kullanılır."
                            },
                            {
                                "target_lang_word": "tedricen",
                                "target_lang_sense_clarification": "Daha resmi veya akademik bağlamlarda yavaş ve aşamalı ilerlemeyi belirtir."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1aa006b-303c-3a81-a16d-5b7bdee340a4",
                    "sense_definition": "As a component or element of a sequence or progression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gradual_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The data points were <w>progressively</w> added to the chart to show the trend.",
                            "target_lang_translations": {
                                "tr": "Eğilimi göstermek için veri noktaları grafiğe <w>sırasıyla</w> eklendi."
                            }
                        },
                        {
                            "text": "Each step is <w>progressively</w> linked to the previous one in the logical chain.",
                            "target_lang_translations": {
                                "tr": "Mantıksal zincirdeki her adım, bir öncekine <w>ardışık olarak</w> bağlıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "sequentially",
                        "successively"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir dizi veya ilerleyişin parçası veya öğesi olarak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sırasıyla",
                                "target_lang_sense_clarification": "Bir dizilim veya mantıksal sıra içindeki ardışıklığı ifade eder."
                            },
                            {
                                "target_lang_word": "ardışık olarak",
                                "target_lang_sense_clarification": "Birbirini takip eden öğeler için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}