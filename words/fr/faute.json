    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cd8af05-d2ac-3b54-986f-9aec2bb0f4c0",
                    "sense_definition": "Erreur commise en faisant ou en disant quelque chose, par exemple en écrivant, en calculant ou en jugeant mal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a une <w>faute</w> d'orthographe dans ta phrase."
                        },
                        {
                            "text": "J'ai fait trois <w>fautes</w> dans la dictée de ce matin."
                        }
                    ],
                    "synonyms": [
                        "erreur"
                    ],
                    "common_phrases": [
                        "faute d'orthographe",
                        "faute de frappe",
                        "faute de grammaire",
                        "faire une faute"
                    ]
                },
                {
                    "sense_id": "1e3492fd-a762-3c58-9b7f-9cfbd8ccd145",
                    "sense_definition": "Responsabilité d'un mal ou d'un échec ; ce qui permet de désigner le coupable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "responsabilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est pas ma <w>faute</w> si le train est en retard."
                        },
                        {
                            "text": "Il rejette toujours la <w>faute</w> sur les autres."
                        },
                        {
                            "text": "Le retard est arrivé par la <w>faute</w> du chauffeur."
                        }
                    ],
                    "common_phrases": [
                        "par la faute de",
                        "rejeter la faute",
                        "avouer sa faute"
                    ]
                },
                {
                    "sense_id": "9d35c82a-e9fb-38c9-ae4b-d6a7d11d4ea2",
                    "sense_definition": "Infraction aux règles d'un jeu ou d'un sport, sanctionnée par l'arbitre ou qui fait perdre un point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction sportive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre a sifflé une <w>faute</w> contre le défenseur."
                        },
                        {
                            "text": "Elle a perdu le match à cause d'une double <w>faute</w> au tennis."
                        }
                    ],
                    "common_phrases": [
                        "double faute",
                        "commettre une faute",
                        "siffler une faute"
                    ]
                },
                {
                    "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                    "sense_definition": "Manquement plus ou moins grave à un devoir, à une loi, à une règle ou à un usage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manquement moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a commis une <w>faute</w> grave en cachant ces informations."
                        },
                        {
                            "text": "L'employé a été licencié pour <w>faute</w> professionnelle."
                        }
                    ],
                    "common_phrases": [
                        "faute grave",
                        "faute professionnelle",
                        "commettre une faute",
                        "faute lourde"
                    ]
                },
                {
                    "sense_id": "8f4aec0b-3709-3ca9-9668-3d97fe168e83",
                    "sense_definition": "Manque de quelque chose ; absence de ce qui est nécessaire (surtout dans l'expression « faute de »).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Faute</w> de temps, nous avons dû annuler la réunion."
                        },
                        {
                            "text": "Ils n'ont pas pu partir en vacances <w>faute</w> d'argent."
                        }
                    ],
                    "common_phrases": [
