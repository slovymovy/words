                        "examples": [
                            {
                                "example_id": "d35da6d8-acc1-4c77-9583-282be491adc4",
                                "sense_id": "53802fb7-dced-3b86-a8e1-08180ae9f493",
                                "text": "De rijmeester Ainé, dezelfde die ook bij Austerlitz was geweest, leidde het paard van de tsaar voor, en op de trap klonk een licht gekraak van voetstappen die Rostov direct herkende."
                            },
                            {
                                "example_id": "6528e4a1-18d3-4f62-8e7c-91eee27abe4f",
                                "sense_id": "53802fb7-dced-3b86-a8e1-08180ae9f493",
                                "text": "Het dodelijke ongeluk gebeurde op een manege in Gaicht, gemeente Weißenbach am Lech, in de deelstaat Tirol. De vrouw werkte er sinds twee jaar en was opgeleid als rijmeester. Ze stond bekend als een uitgelezen instructrice, meldt Krone.at."
                            }
                        ]
