                "senses": [
                    {
                        "sense_id": "ead82187-ac74-3369-8020-a5bf5a992c33",
                        "entry_id": "20a6830e-58c5-344b-8650-07b26d841984",
                        "glosses": [
                            "Variante orthographique de lichénologue."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3038a1c0-5264-4da5-b15a-a90fe14701a1",
                                "sense_id": "ead82187-ac74-3369-8020-a5bf5a992c33",
                                "text": "Quoique les travaux lichenologique de M. Nylander ne soient pas encore du volume de ceux que je viens d’analyser, ils ont droit cependant à toute l’attention du lichenologue car leur auteur apporte à l’étude microscopique de ces êtres difficiles à bien connaître, une persévérance et une sagacité remarquables."
                            },
                            {
                                "example_id": "f8c1d3ed-2ee1-426f-849e-cf795337bb5e",
                                "sense_id": "ead82187-ac74-3369-8020-a5bf5a992c33",
                                "text": "Dans le Tarn-et-Garonne, le lichenologue peut recueillir ces admirables végétations crustacées et dendroïdes sur les rochers de Bruniquel."
                            },
                            {
                                "example_id": "6d1b711a-3ff9-4c26-ac5a-1c7d53414db0",
                                "sense_id": "ead82187-ac74-3369-8020-a5bf5a992c33",
                                "text": "Un savant lichenologue, M. l’abbé Hue […] a fait en ma compagnie quelques excursions aux environs de Vire."
                            },
                            {
                                "example_id": "1408538b-40c0-4936-9e33-4731c008c1a3",
                                "sense_id": "ead82187-ac74-3369-8020-a5bf5a992c33",
                                "text": "Lichénologue professionnel, Joël Esnault explore le Massif armoricain, loupe collée à l'œil, pour mieux percer les mystères des innombrables mosaïques colorées formées par les lichens."
                            }
                        ]
                    }
