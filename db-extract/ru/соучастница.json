                        "entry_id": "ddfe3558-a470-33f5-96c5-25eac44ae2b6",
                        "glosses": [
                            "female equivalent of соуча́стник (součástnik): female accessory (contributor to an offense)"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a982feb5-5c06-4a25-8532-8a4a3c3bbb08",
                                "sense_id": "04afc75c-7636-31d9-a2ad-d2fbe97a01c1",
                                "text": "К ногам моим выкатился каравай и за ним она, моя доблестная соучастница.",
                                "translation": "A loaf flew to my feet and after it herself, my valiant comrade.",
                                "english": "A loaf flew to my feet and after it herself, my valiant comrade."
                            }
                        ]
                    }
