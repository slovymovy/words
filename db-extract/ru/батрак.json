                        "entry_id": "9dfec164-40dd-3083-81ec-65442841322f",
                        "glosses": [
                            "farm labourer; cotter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef127b2-5688-40ae-a13e-ba6006f5272b",
                                "sense_id": "d5e8e6c8-18c7-3465-8d9a-eddb8bbe8037",
                                "text": "Се́рдце всему́ челове́ку батра́к, оно́ — рабо́чий челове́к, а вы все эксплуата́торы, и у вас не́ту коммуни́зма",
                                "translation": "The heart is a cotter for the whole human, (the heart) is (like) a worker, while you all are exploiters and have no communism",
                                "english": "The heart is a cotter for the whole human, (the heart) is (like) a worker, while you all are exploiters and have no communism"
                            }
                        ]
