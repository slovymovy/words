                                        "entry_id": "e72f2b27-6824-3789-9ece-4b56002614c5",
                                        "glosses": [
                                            "An industrial heating device, such as for smelting metal or firing ceramics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4f6ad9-b246-4305-a7e8-e0e48137ccd0",
                                                "sense_id": "2ba7902a-a3ec-3a0a-8f4a-30f5184dbbea",
                                                "text": "Plans for the next phase include furnaces capable of inert atmospheres and partial vacuums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab9f467-dfce-3200-ad62-7ddae3277d29",
                                        "entry_id": "e72f2b27-6824-3789-9ece-4b56002614c5",
                                        "glosses": [
                                            "A device that provides heat for a building."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77fed7f-58bc-4bfc-8af2-4ad2ce82cfe1",
                                                "sense_id": "dab9f467-dfce-3200-ad62-7ddae3277d29",
                                                "text": "HVAC services include furnace maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66d3ed0-981f-3abf-b3b5-4a0c0c0c003a",
                                        "entry_id": "e72f2b27-6824-3789-9ece-4b56002614c5",
                                        "glosses": [
                                            "Any area that is excessively hot."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17f28ff-92c6-48e2-a783-201eacf69e6a",
                                                "sense_id": "a66d3ed0-981f-3abf-b3b5-4a0c0c0c003a",
                                                "text": "The busy kitchen became a sweltering furnace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cfdb848-fafc-3017-aa43-887ea42d8a5f",
                                        "entry_id": "e72f2b27-6824-3789-9ece-4b56002614c5",
                                        "glosses": [
                                            "A place or time of punishment, affliction, or great trial; severe experience or discipline."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "643992e0-8674-48ce-868a-831cffe9ea15",
                                                "sense_id": "8cfdb848-fafc-3017-aa43-887ea42d8a5f",
                                                "text": "forged in the furnace of fierce competition"
                                            },
                                            {
                                                "example_id": "04cc70fe-806e-4506-bdb6-845ec00dc952",
                                                "sense_id": "8cfdb848-fafc-3017-aa43-887ea42d8a5f",
                                                "text": "For the Lorde toke you and broughte you out of the yernen fornace of Egipte, to be vnto him a people of enheritaunce, as it is come to paſſe this daye."
                                            },
                                            {
                                                "example_id": "5455e4ab-7e4d-4469-80a3-28234c0c3fa9",
                                                "sense_id": "8cfdb848-fafc-3017-aa43-887ea42d8a5f",
                                                "text": "For that heroic band—those children of the furnace who, in regions like Texas and Tennessee, maintained their fidelity through terrible trials—we of the North felt for them, and profoundly we honor them."
                                            }
                                        ]
                                    }
                                ]
                            },
