                "senses": [
                    {
                        "sense_id": "65574209-98a2-328b-9dfd-423074052e69",
                        "entry_id": "ba17d65c-6529-3c53-9a56-bc5deabdecb5",
                        "glosses": [
                            "Aufzählung oder Schilderung von technischen Merkmalen und Eigenschaften der Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad4ac99b-a87f-401e-9a11-69f381a60dc6",
                                "sense_id": "65574209-98a2-328b-9dfd-423074052e69",
                                "text": "„In Bezug auf den Tierbesatz der einzelnen Ställe verwies diese Lüftungsbeschreibung auf die Angaben der mitbeteiligten Bauwerber.“"
                            },
                            {
                                "example_id": "34e09bbf-4df4-4e51-a850-eb9b8295459d",
                                "sense_id": "65574209-98a2-328b-9dfd-423074052e69",
                                "text": "„Wesentliche Grundlage für die Beurteilung sind Angaben hinsichtlich der Nutzung und der baulichen bzw. technischen Ausgestaltung des Stallobjektes sowie einheitliche Parameter in der Lüftungsbeschreibung.“"
                            },
                            {
                                "example_id": "25d62f12-991d-4f44-bf77-996a2331c07a",
                                "sense_id": "65574209-98a2-328b-9dfd-423074052e69",
                                "text": "„Das Stallgebäude ist nach der Lüftungsbeschreibung der Firma ***** vom 19. Oktober 2011 (Bl. 39 ff der Bauakt e) fugendicht ausgeführt (sog. Wärmestall), so dass sich kein ausgeprägter Platzgeruch im Nähebereich des Stallgebäudes bilden wird und die geruchsbelastete Abluft im Wesentlichen über die Abluftkamine als Emissionsschwerpunkte abgegeben wird“"
                            },
                            {
                                "example_id": "97f58728-6c3c-466b-9332-a2b170894e77",
                                "sense_id": "65574209-98a2-328b-9dfd-423074052e69",
                                "text": "„Gegen den Baubewilligungsbescheid vom 24.09.2009 wurde von der Umweltanwaltschaft mit Schreiben vom 30.09.2009 Berufung erhoben, weil die Forderung der nachträglichen Abdeckung der offenen Güllegrube nicht von der Baubehörde vorgeschrieben wurde und auch die Abluftgeschwindigkeit in der Lüftungsbeschreibung nicht eindeutig festgelegt war.“"
                            }
                        ],
