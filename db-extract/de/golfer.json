                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golfista",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                                        "entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
