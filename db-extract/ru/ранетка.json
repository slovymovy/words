                        "entry_id": "a3637ad5-05ab-39a9-ba99-0a5a4bfdb625",
                        "glosses": [
                            "ranetka (sexually precocious girl)"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a78765f0-048a-40e9-8292-dee632ef50a8",
                                "sense_id": "68be1bcb-9110-3d19-95ce-825bad6ac183",
                                "text": "Моя однокла́ссница На́стя — ране́тка. С 13 лет с пацана́ми тра́хается!",
                                "translation": "My classmate Nastya is a \"ranetka\". She’s been screwing boys since she was 13!",
