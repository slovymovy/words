                                    {
                                        "sense_id": "efee01fe-aafa-392d-924e-c443a50ab3f6",
                                        "entry_id": "02e64628-7261-3033-835d-6a238f5dd698",
                                        "glosses": [
                                            "mający moc nadprzyrodzoną"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ef5423-b70a-45ec-99a6-d148018a77ac",
                                                "sense_id": "efee01fe-aafa-392d-924e-c443a50ab3f6",
                                                "text": "Dlatego też jest to ze wszystkich skarbów najczarowniejszy skarb — i nie potrzeba go szukać daleko za górami, za lasami... Bije tuż — tuż... Posłuchajcie i pamiętajcie o niem"
                                            },
                                            {
                                                "example_id": "f93779e1-c660-4248-b673-62627f7c2f9a",
                                                "sense_id": "efee01fe-aafa-392d-924e-c443a50ab3f6",
                                                "text": "Czarowny widok — czarowne wieczory! — / Ciebie zachwycał zgiełk ludzi i tęcza, / W jaką się ludzkie wiązały kolory / Nad błękitnawem morzem w pół obręczą"
                                            }
                                        ],
