                        "examples": [
                            {
                                "example_id": "f6904ac5-749c-4334-a50a-1c7cd0173db0",
                                "sense_id": "f7005ca4-3615-3bf3-b10e-8b1ea44502b5",
                                "text": "„Bring mir ein Bier nach draußen auf meinen Stammplatz und für die Frau Birkhuhn ein Kanderl Kaffee.“"
                            },
                            {
                                "example_id": "6300fda6-31b8-4e23-a1fb-d1f08b330b4c",
                                "sense_id": "f7005ca4-3615-3bf3-b10e-8b1ea44502b5",
                                "text": "„Am Sonntagnachmittag nahm ich ein Kanderl, ging hinauf zur ‚Kälberhalt‘, einer Ötz am obersten Ende des Hatzengutes, wo im Sommer immer die Kälber weideten.“"
                            }
                        ],
