                                "example_id": "5caed923-53e5-4ee6-96b3-204422ef2702",
                                "sense_id": "141dd416-ccc9-32bd-b843-7efb803fe554",
                                "text": "„Ihr Vorwurf lautete, dass der Zigarettenhersteller die Gefahren des Rauchens und die Suchtgefahr seiner Produkte verheimlicht habe.“"
                            },
                            {
                                "example_id": "c118b412-0807-4061-b193-49388ba5dad1",
                                "sense_id": "141dd416-ccc9-32bd-b843-7efb803fe554",
                                "text": "„Gleich mehrere Staaten haben zuletzt härtere Gesetze gegen die Branche erlassen, wogegen sich die Zigarettenhersteller stets vor Gericht wehren.“"
                            }
