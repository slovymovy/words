                        "sense_id": "80678a4d-74f6-35eb-aafd-1e819a674625",
                        "entry_id": "b88b6229-f45e-3508-bca6-1ec1a38b810c",
                        "glosses": [
                            "результат такого действия; дополнение, исправление, изменяющее что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
