                    {
                        "translation_id": "57cda288-dba2-4191-984a-abe365bfa091",
                        "source_entry_id": "40dbc821-0911-335b-aea8-cf242c2ddb8c",
                        "source_sense_id": "2f257d0e-3ecc-3bfb-b0d5-db0def9bd792",
                        "target_lang_word": "мозазавр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мозазавр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "27683289-89fe-3bf7-a59b-b6381a3b50d1",
                                        "entry_id": "4e3a534a-0aef-3657-85b6-88486b07908b",
                                        "glosses": [
                                            "зоол. вымершее морское пресмыкающееся отряда чешуйчатых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5350ec7e-9471-40c8-af0f-59b63e03eb0f",
                                                "sense_id": "27683289-89fe-3bf7-a59b-b6381a3b50d1",
                                                "text": ".. мозазавр — это .. огромная ящерица, перебравшаяся на жительство в море. Их ближайшие родственники, по мнению многих исследователей, — хорошо всем известные вараны. Расцвет этих существ пришёлся на узкий промежуток времени в конце мелового периода. В какой-то эволюционный момент другие группы морских рептилий — ихтиозавры, завроптеригии, крокодилы — отошли на задний план или вообще исчезли, а мозазавры захватили нишу крупных морских хищников."
                                            },
                                            {
                                                "example_id": "949d2c4d-f194-4289-9c53-b0810b056b16",
                                                "sense_id": "27683289-89fe-3bf7-a59b-b6381a3b50d1",
                                                "text": "Мозазавры были крупными существами, они достигали семи метров в длину. Питались аммонитами, рыбой и даже своими сородичами. Учёные считают, что мозазавры исчезли в результате массового вымирания, одновременно с динозаврами и птерозаврами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
