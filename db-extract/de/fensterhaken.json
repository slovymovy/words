                ],
                "senses": [
                    {
                        "sense_id": "3e840e10-0429-3735-a07f-b6eed5d62752",
                        "entry_id": "530b8cd8-4b26-3499-b306-bfbbfd3bc43a",
                        "glosses": [
                            "mechanische Vorrichtung, die verhindern soll, dass ein Fenster oder Fensterladen beispielsweise durch Zug zuschlägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b57f6338-ae33-40c9-b282-49a4d1487aec",
                                "sense_id": "3e840e10-0429-3735-a07f-b6eed5d62752",
                                "text": "Dieser Fensterhaken ist günstig und schnell montiert."
                            },
                            {
                                "example_id": "9e5be1bb-9217-431a-8fa1-477a95867b59",
                                "sense_id": "3e840e10-0429-3735-a07f-b6eed5d62752",
                                "text": "Bevor ich Fenster und Rahmen streichen kann muss ich die Beschläge und Fensterhaken abbauen."
                            },
                            {
                                "example_id": "53015aa6-cd7c-4be9-ab1e-bb4820f58b1b",
                                "sense_id": "3e840e10-0429-3735-a07f-b6eed5d62752",
                                "text": "Emsig arbeitete er mit den kleinen dürren Händen an dem Fensterhaken; denn drunten auf der mondhellen Gasse hatte er den Wächter stehen sehen. Aber die Haspen waren festgerostet; er bemühte sich vergebens, sie zu öffnen."
                            },
                            {
                                "example_id": "0d885b3d-a003-4e17-98f1-fded25840cf6",
                                "sense_id": "3e840e10-0429-3735-a07f-b6eed5d62752",
                                "text": "Die Wachen waren unablässig vor dem Guckloch seiner Zelle. Doch paßte er den Augenblick ab, um sich durch einen Sprung von seiner Pritsche in der am Fensterhaken befestigten Wäscheschlinge selbst den Hals zu brechen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
