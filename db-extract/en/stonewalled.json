                "senses": [
                    {
                        "sense_id": "89b645a8-2edc-3326-b983-fabb94831f61",
                        "entry_id": "9e1360b2-969e-387e-ab7f-3f24bf2d2cc9",
                        "glosses": [
                            "Surrounded or defined in size and shape by a wall of stone."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "832de7fb-1c6f-49e6-a85d-b9f18d11c616",
                                "sense_id": "89b645a8-2edc-3326-b983-fabb94831f61",
                                "text": "Leading from the terrace to the old stonewalled garden is a flight of stone steps."
                            },
                            {
                                "example_id": "e08fec65-4901-45ad-902a-6aecaf0f43ae",
                                "sense_id": "89b645a8-2edc-3326-b983-fabb94831f61",
                                "text": "The stonewalled farmhouse is of the late 16th century or the early 17th, extended southwards in the early 19th century"
                            },
                            {
                                "example_id": "f2d33259-14bb-4407-adcf-bca19684bd69",
                                "sense_id": "89b645a8-2edc-3326-b983-fabb94831f61",
                                "text": "In fact, one of the few main differences was that Doreen's house had an old stonewalled shed back near the cliffs, and Carl's didn't."
                            }
                        ]
                    }
