                ],
                "senses": [
                    {
                        "sense_id": "a6e93780-125f-332a-995a-7d7db3e0797e",
                        "entry_id": "90a3e325-a74c-3bab-adf3-cd1b113ff56e",
                        "glosses": [
                            "Wald aus Tannen"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "da78d3b2-0195-4b5d-ae9a-e4a60d3b18e2",
                                "sense_id": "a6e93780-125f-332a-995a-7d7db3e0797e",
                                "text": "„Für den verliebten Abendländer gibt es auch draußen verborgene, schattige Plätze genug – ob im finstern Tann oder unterm Holunderbusch.“"
                            },
                            {
                                "example_id": "f7b41f16-0bf9-413f-8447-f105d798b012",
                                "sense_id": "a6e93780-125f-332a-995a-7d7db3e0797e",
                                "text": "„Doch nein, es war wohl nur Täuschung, ein wilder Traum, oder der Ruf eines Nachtvogels im Tann und das Heulen des Windes …“"
                            },
                            {
                                "example_id": "dd5d3790-e3d4-4dee-a253-15004d39c45e",
                                "sense_id": "a6e93780-125f-332a-995a-7d7db3e0797e",
                                "text": "„Herrn Milons Roß bestieg er dann",
                                "translation": "Den Vater nicht zu wecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
