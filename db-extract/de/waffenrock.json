                "senses": [
                    {
                        "sense_id": "2c99882d-00d8-35de-b4ec-9ce5e55217a1",
                        "entry_id": "69d50624-91e1-33bf-80c4-8d2a9147cfc1",
                        "glosses": [
                            "die Uniform des Militärs und der Polizei"
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "670de250-a6b3-4ab1-a921-237ee2bba6ab",
                                "sense_id": "2c99882d-00d8-35de-b4ec-9ce5e55217a1",
                                "text": "Mit Stolz trug Napoleon seinen Waffenrock."
                            },
                            {
                                "example_id": "7d5a399d-47b0-439d-8d94-efb805006dac",
                                "sense_id": "2c99882d-00d8-35de-b4ec-9ce5e55217a1",
                                "text": "„Aber die unfreiwilligen Humoristen im Waffenrock finden sich ja nicht nur auf dem Kasernenhof oder im Mannschaftsstand.“"
                            },
                            {
                                "example_id": "d5f8dc6a-665f-45a8-a7fa-b88ffbc41cd8",
                                "sense_id": "2c99882d-00d8-35de-b4ec-9ce5e55217a1",
                                "text": "„Unter den vielen Blauuniformierten entdecke ich jetzt auch einen in feldgrauem Waffenrock und scharfen Breeches: kein Mann vom Heer, sondern einer mit einem silbernen Totenkopf an der Mütze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfb503a4-7740-492c-b8b7-68b86b232481",
                        "source_entry_id": "69d50624-91e1-33bf-80c4-8d2a9147cfc1",
                        "source_sense_id": "2c99882d-00d8-35de-b4ec-9ce5e55217a1",
                        "source_sense_description": "veraltet, historisch: die Uniform des Militärs und der Polizei",
                        "target_lang_word": "tunic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tunic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "627eb52a-7b95-3c33-b581-b009f39a1dc2",
                                        "entry_id": "467960ee-a63f-34bb-a200-67264c516ef3",
                                        "glosses": [
                                            "A garment worn over the torso, with or without sleeves, and of various lengths reaching from the hips to the ankles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd60f975-2f05-4f7a-b8f1-5de9a08286db",
                                                "sense_id": "627eb52a-7b95-3c33-b581-b009f39a1dc2",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7482c2-cee9-30ab-a2aa-5d50a68c12bb",
                                        "entry_id": "467960ee-a63f-34bb-a200-67264c516ef3",
                                        "glosses": [
                                            "Any covering, such as seed coat or the organ that covers a membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4f8ba03-c3b1-4144-b209-49da618a2e42",
                                                "sense_id": "fe7482c2-cee9-30ab-a2aa-5d50a68c12bb",
                                                "text": "Select individual bulbs that are firm and have no noticeable blemishes on them. Don't worry about the papery covering or tunic. That may or may not be in place, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "550457ea-6fd5-3680-bbc3-43bd478c4574",
                                        "entry_id": "467960ee-a63f-34bb-a200-67264c516ef3",
                                        "glosses": [
                                            "Synonym of gymslip."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
