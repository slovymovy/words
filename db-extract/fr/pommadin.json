                    {
                        "sense_id": "01165398-280d-3b37-ae94-0b70a21e1937",
                        "entry_id": "e36ed52b-aa36-390e-88fb-7a20ee642e40",
                        "glosses": [
                            "Personne élégante."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "34d482ad-ed37-4af1-9376-7d4ebe7f3e1f",
                                "sense_id": "01165398-280d-3b37-ae94-0b70a21e1937",
                                "text": "Un pommadin, ondulé au petit fer et qui sent la putain à quinze pas, sort du métro."
                            },
                            {
                                "example_id": "b60a7a0e-3fa1-4a1c-9c38-89e1941fcae9",
                                "sense_id": "01165398-280d-3b37-ae94-0b70a21e1937",
                                "text": "L’homme à l’impeccable complet gris pris une table voisine de la sienne et se fit servir un thé glacé. Farr aurait voulu qu’il lui soit permis de faire cracher la vérité à cette espèce de pommadin."
                            }
                        ]
                    },
                    {
                        "sense_id": "6400e1b3-34aa-3576-ac69-e7e96780fe53",
                        "entry_id": "e36ed52b-aa36-390e-88fb-7a20ee642e40",
                        "glosses": [
                            "Appellation péjorative, dépréciative, du coiffeur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7e8280c4-26b5-42eb-82a7-88f5ce2de358",
                                "sense_id": "6400e1b3-34aa-3576-ac69-e7e96780fe53",
                                "text": "Il te vous balance le potage comme un pommadin de village vous vaporise de l’eau de lavande moisie après la barbouze."
                            }
                        ]
                    }
                ],
