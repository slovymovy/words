                                                "sense_id": "f8bea9d2-8ea6-3d4a-a060-40a5d2079d0d",
                                                "text": "Put these ragges and cloutes vnder thine arme holes."
                                            },
                                            {
                                                "example_id": "0a0e0a2f-7559-4047-90b8-10649cc3e2b8",
                                                "sense_id": "f8bea9d2-8ea6-3d4a-a060-40a5d2079d0d",
                                                "text": "He... violently pull'd off her Riding-Hood, and tore it at the Arm Holes in pulling it off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b9ce593-17cb-4abd-8d18-9e444f324097",
                        "source_entry_id": "79af6464-2b35-3cd8-ad01-c74003921f29",
                        "source_sense_id": "fa199989-42b5-344a-9d93-7e1332ba2e0f",
                        "target_lang_word": "armsgat",
