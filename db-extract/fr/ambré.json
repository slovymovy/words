                ],
                "senses": [
                    {
                        "sense_id": "7f9f8cec-1f8a-3fb1-a571-6e706d168926",
                        "entry_id": "79ec6193-1805-34c9-b725-4c0504a86e3d",
                        "glosses": [
                            "Qui a les teintes de l’ambre jaune. #F0C300"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84500a17-cdd4-4b58-a7a9-6b881cca61fe",
                                "sense_id": "7f9f8cec-1f8a-3fb1-a571-6e706d168926",
                                "text": "Le second traîne des leurres le long des récifs à la recherche d’un wahoo ou d’une sériole ambrée."
                            },
                            {
                                "example_id": "30795872-7b8c-40a8-af12-e3634965cef2",
                                "sense_id": "7f9f8cec-1f8a-3fb1-a571-6e706d168926",
                                "text": "J’ai regardé ton corps debout, simple et altier comme un pilier d’ivoire, ambré comme un rayon de miel."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5750c57-a23a-3eef-8b7d-2795fb121a25",
                        "entry_id": "79ec6193-1805-34c9-b725-4c0504a86e3d",
                        "glosses": [
                            "Couleur de la robe d’un vin blanc, indiquant une meilleure maturité que la couleur « vieil or »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790dbcec-4ba5-423f-90df-d4844182998b",
                                "sense_id": "b5750c57-a23a-3eef-8b7d-2795fb121a25",
                                "text": "La robe ambrée de ce vin blanc est celle d’un vin liquoreux."
                            }
                        ]
                    },
                    {
                        "sense_id": "094eae05-9a06-3134-962c-d96f21d9cdcd",
                        "entry_id": "79ec6193-1805-34c9-b725-4c0504a86e3d",
                        "glosses": [
                            "Qui a le parfum de l’ambre gris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f5099df-186c-4d65-a305-b7056d4736f3",
                                "sense_id": "094eae05-9a06-3134-962c-d96f21d9cdcd",
                                "text": "Eau de Cologne ambrée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3bf6578-db5c-4607-9da6-ae4132d73bb2",
                        "source_entry_id": "79ec6193-1805-34c9-b725-4c0504a86e3d",
                        "target_lang_word": "amber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "Ambergris, the waxy product of the sperm whale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae31e176-6b2f-4f80-9509-dc0fccdb52da",
                                                "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                                                "text": "Ambre is hote and drye […] Some say that it is the sparme of a whale."
                                            },
                                            {
                                                "example_id": "a1639f0c-4838-48cd-abda-badb93f52ad0",
                                                "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                                                "text": "As for Amber Grice, or Amber Cane, which ist most sweet myngled with other sweete thynges: some say it commeth from the rocks of the Sea. […] Some say it is gotten by a fish called Azelum, which feedeth upon Amber Grece, and dyeth, which is taken by cunnyng fishers and the belly opened, and this precious Amber found in hym."
                                            },
                                            {
                                                "example_id": "3d7e702e-1f23-4348-97e7-bf51bd3bd1fb",
                                                "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                                                "text": "The head of this fish is as hard as stone. The inhabitants of the Ocean sea coast affirme that this fish casteth foorth Amber; but whether the said Amber be the sperma or the excrement thereof, they cannot well determine."
                                            },
                                            {
                                                "example_id": "77e6bf18-7cb1-4a5c-ab04-9322b73dff34",
                                                "sense_id": "76229632-2863-30c2-b0b1-26db77bcf16f",
                                                "text": "Slaves […] with silver Censors […] perfum'd the air with Amber, Aloes wood, and other Scents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a27413c-3a2a-36a0-ae32-ed77b19dbe9d",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "Ambergris, the waxy product of the sperm whale.",
                                            "Formerly thought to be the product of a plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf9938b-7873-4c29-aa49-eb8c4a7b6c75",
                                                "sense_id": "0a27413c-3a2a-36a0-ae32-ed77b19dbe9d",
                                                "text": "The leaves of the foreſt were loaded with manna, pure amber dropped from every bough, honey diſtilled from the rifted rock, and the humming bee, drunk with joy, ſtrayed from flower to flower, forgetful of his burſting cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "A hard, generally yellow to brown translucent or transparent fossil resin from extinct coniferous trees of the pine genus, used for jewellery, decoration and later dissolved as a binder in varnishes. One variety, blue amber, appears blue rather than yellow under direct sunlight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53b47128-a532-4f7d-b1e3-3cf781441f36",
                                                "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                                                "text": "With scarfs and fans and double change of bravery,\nWith amber bracelets, beads, and all this knavery."
                                            },
                                            {
                                                "example_id": "22e1a889-3837-4b1c-a0fa-ae7ffefe4651",
                                                "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                                                "text": "Slanders, sir: for the satirical rogue says here that old men have grey beards, that their faces are wrinkled, their eyes purging thick amber and plum-tree gum and that they have a plentiful lack of wit."
                                            },
                                            {
                                                "example_id": "399869f1-ad0c-4fe1-8f59-d95c279f43e6",
                                                "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                                                "text": "To shew this by example, we reade of Sabina Poppcea, to whom nothing was wanting, but shame and honestie, being extremely beloved of Nero, had the colour of her haire yellow, like Amber, which Nero esteemed much of, […] ."
                                            },
                                            {
                                                "example_id": "3abd51c9-089c-493e-8f03-9e8d69cdc520",
                                                "sense_id": "375f7880-ccbb-32e9-80ee-e80cdb114004",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […]. (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d931a8-d849-3544-90fc-65fa722a4087",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "A yellow-orange colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59816565-8677-4b2b-8f24-8dbb7e973ab7",
                                                "sense_id": "13d931a8-d849-3544-90fc-65fa722a4087",
                                                "text": "And I looked, and, behold, a whirlwind came out of the north, a great cloud, and a fire infolding itself, and a brightness was about it, and out of the midst thereof as the colour of amber, out of the midst of the fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a02e76de-3b25-34f5-bb9d-4f0ce1c1a3b9",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "The intermediate light in a set of three traffic lights, which when illuminated indicates that drivers should stop when safe to do so. See also yellow light."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851ac5b4-d7c6-4a95-b286-0be416ad1a49",
                                                "sense_id": "a02e76de-3b25-34f5-bb9d-4f0ce1c1a3b9",
                                                "text": "While earlier controllers provided concurrent ambers, present practice is to indicate a minimum intergreen period of 4 s."
                                            },
                                            {
                                                "example_id": "37dd7056-48a7-4241-a083-ba49d9028d27",
                                                "sense_id": "a02e76de-3b25-34f5-bb9d-4f0ce1c1a3b9",
                                                "text": "Also flashing ambers are not operational at this type of crossing."
                                            },
                                            {
                                                "example_id": "8c65ce59-f25d-4743-b032-9b45f2c2dcec",
                                                "sense_id": "a02e76de-3b25-34f5-bb9d-4f0ce1c1a3b9",
                                                "text": ">Problem: Red-red signals are too time consuming when traffic density is higher.\nI don't find them time consuming at all. I find them identical to ambers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a687de-1ba9-3670-9e85-ab18e0b8d321",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "The stop codon (nucleotide triplet) \\\"UAG\\\", or a mutant which has this stop codon at a premature place in its DNA sequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ea212e-47e2-41ee-ac14-3cf5b3d4d41b",
                                                "sense_id": "74a687de-1ba9-3670-9e85-ab18e0b8d321",
                                                "text": "an amber codon, an amber mutation, an amber suppressor"
                                            },
                                            {
                                                "example_id": "21bd4627-1fb3-41bd-b2c5-e851c3535b2d",
                                                "sense_id": "74a687de-1ba9-3670-9e85-ab18e0b8d321",
                                                "text": "For example, to cross a temperature-sensitive mutation with an amber mutation, amber suppressor cells are infected at the low (permissive) temperature."
                                            },
                                            {
                                                "example_id": "1dc68eb8-276f-497c-b9bb-47e0815ccff9",
                                                "sense_id": "74a687de-1ba9-3670-9e85-ab18e0b8d321",
                                                "text": "Double ambers revert at 10⁻⁸−10⁻⁹, and therefore, reversion is negligible. Double-amber mutants are made by crossing single-amber mutants with each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d4b7ea-9d6b-314a-b7b3-fa9f5b7f82da",
                                        "entry_id": "3e0adc5a-1092-3dfa-a246-438d5faa6ad9",
                                        "glosses": [
                                            "Hesitance to proceed, or limited approval to proceed; an amber light."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98073615-261e-49c2-a9ac-345912ea2131",
                                                "sense_id": "86d4b7ea-9d6b-314a-b7b3-fa9f5b7f82da",
                                                "text": "[…] in response to the actions I just described, business was given the green light, and now we seem to be on amber."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a091ce7-470c-39d5-812b-749f42ac2580",
                                        "entry_id": "a05939e9-923b-31e8-a0d1-ddb4acd12a72",
                                        "glosses": [
                                            "Of a brownish yellow colour, like that of most amber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee721e34-f6c7-4380-9e85-da533ae26c78",
                                                "sense_id": "6a091ce7-470c-39d5-812b-749f42ac2580",
                                                "text": "They all moved safely through the first green and then the second, but when the third light turned amber Jack's taxi was the last to cross the intersection."
                                            },
                                            {
                                                "example_id": "63bcd2ac-cca9-4447-9625-0159b07bc6dd",
                                                "sense_id": "6a091ce7-470c-39d5-812b-749f42ac2580",
                                                "text": "Ahead, a cool breeze swept the pale morning sun across a grassy meadow turned amber by morning's frost."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b27b6ee6-791d-3876-9699-1c2643e141c2",
                                        "entry_id": "43668b6b-7ee4-3b5d-8e45-643bb8e7dae5",
                                        "glosses": [
                                            "To perfume or flavour with ambergris."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c57eac-b90f-40e9-bb3f-8bf94799cc11",
                                                "sense_id": "b27b6ee6-791d-3876-9699-1c2643e141c2",
                                                "text": "ambered wine, an ambered room"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b009ae7c-eca7-3116-be2b-d067deb7afb0",
                                        "entry_id": "43668b6b-7ee4-3b5d-8e45-643bb8e7dae5",
                                        "glosses": [
                                            "To preserve in amber."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca9b22fc-5429-4ac1-832c-8950aad1f166",
                                                "sense_id": "b009ae7c-eca7-3116-be2b-d067deb7afb0",
                                                "text": "an ambered fly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e610c1e6-8f61-31df-ba50-074e7ccfb7ae",
                                        "entry_id": "43668b6b-7ee4-3b5d-8e45-643bb8e7dae5",
                                        "glosses": [
                                            "To cause to take on the yellow colour of amber."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc682cd1-c310-4c4a-959e-df9281e68229",
                                                "sense_id": "e610c1e6-8f61-31df-ba50-074e7ccfb7ae",
                                                "text": "For purple mountains majesty; for amber waves of grain."
                                            },
                                            {
                                                "example_id": "4ee1de57-47f2-4840-85cc-273b8f1f47bd",
                                                "sense_id": "e610c1e6-8f61-31df-ba50-074e7ccfb7ae",
                                                "text": "Home to the mosaic of coloured-lit windows in the black and white houses, the fake gas lamps ambering the cobbles, sometimes the scent of applewood smoke."
                                            },
                                            {
                                                "example_id": "5e0f52c4-74f3-4b42-ad23-a99b26019493",
                                                "sense_id": "e610c1e6-8f61-31df-ba50-074e7ccfb7ae",
                                                "text": "The firelight flickered on her rounded cheeks, ambering the pale skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fe2b9b-d4a4-3403-8421-14e71ce29b98",
                                        "entry_id": "43668b6b-7ee4-3b5d-8e45-643bb8e7dae5",
                                        "glosses": [
                                            "To take on the yellow colour of amber."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary",
                                            "poetic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c63489b-4d76-4ae6-849e-231c80846e3f",
                                                "sense_id": "52fe2b9b-d4a4-3403-8421-14e71ce29b98",
                                                "text": "Westward along Lancaster Avenue, among the stone walls and broad driveways of imposing old houses—their lawns dappled with the shade of ambering maples and dusty, bark-peeled sycamores—"
                                            },
                                            {
                                                "example_id": "ec3fb1c9-9531-4c52-8920-bde3930c85d0",
                                                "sense_id": "52fe2b9b-d4a4-3403-8421-14e71ce29b98",
