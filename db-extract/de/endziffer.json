                "senses": [
                    {
                        "sense_id": "adb7e8a0-8e90-3d05-bdec-488d1888abdf",
                        "entry_id": "a53b8ca2-53fc-38c4-9ba3-8519bca3bcfb",
                        "glosses": [
                            "letzte Ziffer einer Zahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3896d869-ef45-44bb-a581-bed48d1c241e",
                                "sense_id": "adb7e8a0-8e90-3d05-bdec-488d1888abdf",
                                "text": "3 ist die Endziffer der Zahl 573."
                            },
                            {
                                "example_id": "cf8117fc-6643-4084-8025-395f4f65ee26",
                                "sense_id": "adb7e8a0-8e90-3d05-bdec-488d1888abdf",
                                "text": "„Die Überweisungstermine 2014 (siehe unten) für das Kindergeld sind bereits im Vorfeld festgelegt und richten sich nach der Endziffer der Kindergeldnummer.“"
                            },
                            {
                                "example_id": "5a104c75-27de-4ee1-ad98-208349d02c28",
                                "sense_id": "adb7e8a0-8e90-3d05-bdec-488d1888abdf",
                                "text": "„Ganze Zahlen können von der Endziffer aus durch Zwischenräume in dreistellige Gruppen gegliedert werden.“"
                            },
                            {
                                "example_id": "1edf56e2-d250-44fd-9bf1-6ea27371435b",
                                "sense_id": "adb7e8a0-8e90-3d05-bdec-488d1888abdf",
                                "text": "„Als Endziffern einer Primzahl bleiben somit nur die 1, 3, 7 und 9.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
