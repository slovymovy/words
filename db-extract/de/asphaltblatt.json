                ],
                "senses": [
                    {
                        "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                        "entry_id": "327e6222-5601-3de5-a161-cc5e77fa6d91",
                        "glosses": [
                            "Presseerzeugnis mit oberflächlichem, wenig anspruchsvollem oder gar verleumderischem, aufhetzendem Inhalt und Stil"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "2845d12a-583b-47c6-9252-03facc47b164",
                                "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                                "text": "(1927:) „[…], was ist darum natürlicher als das, wenn er [der Jude] seine Presseorgane loslässt? In den 28 Tagen dieses Monats ist von diesen Jargons mehr über uns zusammengeschrieben ( = gelogen) worden, als in den letztverflossenen 3 Monaten zusammen. Ein Asphaltblatt, nämlich die ‚Rote Fahne‘, reagierte besonders […] auf alle Operationen unserer Partei […]. Auch die unbedeutendste Veranstaltung von uns registrierte sie […], umrankt mit ihren lieblichen Ausdrücken und ‚Wünschen‘ für unsere Zukunft.“"
                            },
                            {
                                "example_id": "d2a01424-8fbe-462a-83bf-6a805a700844",
                                "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                                "text": "(1937:) „Der Rittmeister […] versetzte seiner Zeitung einen kräftigen Schubs, obwohl es die Deutsche Tageszeitung und kein Asphaltblatt war.“"
                            },
                            {
                                "example_id": "c40e783b-82af-4e07-8808-d721d5780806",
                                "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                                "text": "„Auf der Medienseite berichtet Mark Winkelmann über die Lage der Asphaltblätter in Deutschland.“"
                            },
                            {
                                "example_id": "0951982c-95f1-41de-84d1-94c52db0e2d8",
                                "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                                "text": "„Er ließ die bekannten Zeitungen Revue passieren: […] Blieben nur noch die Asphaltblätter, die allein von Skandalen lebten.“"
                            },
                            {
                                "example_id": "cdeef704-bb08-4659-bcae-cfa60bcdd179",
                                "sense_id": "d0a940c8-0f47-322d-b1bb-53e3397e3e48",
                                "text": "„Die traurige Story plazierte die englische Krawallzeitung ‚Daily Mirror‘ rechtzeitig zum Saisonauftakt. Englische Asphaltblätter pflegen seit Jahren mit der Eröffnung deutsch/britischer ‚Urlaubs-Kriege‘ ihre Auflage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ee4a00f-aab8-381c-a20e-8c7fcc1f0d5b",
                        "entry_id": "327e6222-5601-3de5-a161-cc5e77fa6d91",
                        "glosses": [
                            "sich drehende Scheibe aus Stahl mit gekerbtem Rand zum Schneiden von Flächen aus Asphalt; angetrieben und geführt von einer Maschine, einem Trennschleifer oder Fugenschneider"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd052798-8625-473d-8e21-6d19eb3be424",
                                "sense_id": "8ee4a00f-aab8-381c-a20e-8c7fcc1f0d5b",
                                "text": "kommerzieller Text: „Asphaltblätter werden standardmäßig mit Schrägschutzsegmenten ausgeliefert.“"
                            },
                            {
                                "example_id": "b54fe6a5-1fc1-4172-a121-551e084cca91",
                                "sense_id": "8ee4a00f-aab8-381c-a20e-8c7fcc1f0d5b",
                                "text": "„Für Asphaltblätter ist die Möglichkeit dieser Erneuerungsmaßnahme eingeschränkt, weil die Materialstärke des Stammkörpers durch die Abrasivität des Asphalts unter Umständen stark verdünnt ist.“"
                            },
                            {
                                "example_id": "6d860525-cf06-45ac-8c1b-c26d5cdf0354",
                                "sense_id": "8ee4a00f-aab8-381c-a20e-8c7fcc1f0d5b",
                                "text": "„ROSCHEN hat eine komplette Linie von Diamantblättern und Zusätze, einschließlich Asphaltblätter, kombinierte Blätter, konkrete Blätter, Bohrkronen, Topfscheiben, Demolierung Sägeblätter, universelle Blätter, Granit Sägeblätter, Marmor Sägeblätter, Frischbetonblätter, reibende Schuhe, Maurerarbeit Sägeblätter, Polierauflagen, Rettung Sägeblätter, Fliese Sägeblätter, Biesenpunktblätter und Massendiamantblatt Specials, etc.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
