{
    "word_family": [
        "omnivore",
        "omnivorously",
        "omnivory",
        "omnivorousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0e804a6-00e5-3345-b588-3950febb999e",
                    "sense_definition": "Having a diet that consists of both plant and animal matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dietary habits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many bear species are <w>omnivorous</w> and will eat berries as well as fish.",
                            "target_lang_translations": {
                                "ru": "Многие виды медведей <w>всеядны</w> и едят как ягоды, так и рыбу."
                            }
                        },
                        {
                            "text": "Humans are naturally <w>omnivorous</w> animals with a very diverse diet.",
                            "target_lang_translations": {
                                "ru": "Люди по своей природе — <w>всеядные</w> животные с очень разнообразным рационом."
                            }
                        }
                    ],
                    "synonyms": [
                        "pantophagous"
                    ],
                    "antonyms": [
                        "carnivorous",
                        "herbivorous"
                    ],
                    "common_phrases": [
                        "omnivorous diet",
                        "omnivorous species",
                        "omnivorous animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий рацион, состоящий как из растительной, так и из животной пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеядный",
                                "target_lang_sense_clarification": "питающийся любой пищей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3520bba-1063-3c8b-90f5-a83df86be8e5",
                    "sense_definition": "Taking in or interested in everything available; having a wide variety of interests.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual habits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>omnivorous</w> reader who enjoys everything from classic literature to modern sci-fi.",
                            "target_lang_translations": {
                                "ru": "Она — <w>всеядная</w> читательница, которой нравится всё: от классической литературы до современной научной фантастики."
                            }
                        },
                        {
                            "text": "His <w>omnivorous</w> appetite for knowledge led him to study both physics and ancient history.",
                            "target_lang_translations": {
                                "ru": "Его <w>ненасытная</w> жажда знаний побудила его изучать как физику, так и древнюю историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "unselective",
                        "indiscriminate",
                        "all-embracing"
                    ],
                    "antonyms": [
                        "selective",
                        "specialized"
                    ],
                    "common_phrases": [
                        "omnivorous reader",
                        "omnivorous appetite",
                        "omnivorous interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интересующийся всем доступным; имеющий широкий спектр интересов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеядный",
                                "target_lang_sense_clarification": "в переносном смысле, неразборчивый в интересах"
                            },
                            {
                                "target_lang_word": "разносторонний",
                                "target_lang_sense_clarification": "имеющий многообразные интересы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6637bc9c-b955-3f49-b39e-837e6940b7aa",
                    "sense_definition": "Of a parasite or pest: attacking many different species or host plants.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biological behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>omnivorous</w> parasite can survive by infecting dozens of different insect species.",
                            "target_lang_translations": {
                                "ru": "Этот <w>всеядный</w> паразит может выживать, заражая десятки различных видов насекомых."
                            }
                        },
                        {
                            "text": "Farmers struggled to control the <w>omnivorous</w> pest because it fed on almost every crop in the field.",
                            "target_lang_translations": {
                                "ru": "Фермеры изо всех сил пытались бороться с этим <w>многоядным</w> вредителем, потому что он питался почти всеми культурами на поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "polyphagous"
                    ],
                    "antonyms": [
                        "monophagous"
                    ],
                    "common_phrases": [
                        "omnivorous parasite",
                        "omnivorous pest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical biological usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О паразите или вредителе: атакующий множество различных видов или растений-хозяев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всеядный",
                                "target_lang_sense_clarification": "поражающий разные виды"
                            },
                            {
                                "target_lang_word": "многоядный",
                                "target_lang_sense_clarification": "биологический термин для вредителей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bf31052-3dcc-3c43-8965-3bc2e7032a8d",
                    "sense_definition": "Consuming or taking in all things; all-consuming.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intellectual habits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>omnivorous</w> nature of the fire meant that nothing in the building was spared.",
                            "target_lang_translations": {
                                "ru": "<w>Всепоглощающий</w> характер пожара означал, что в здании ничего не уцелело."
                            }
                        },
                        {
                            "text": "He had an <w>omnivorous</w> curiosity that made him question every detail of the experiment.",
                            "target_lang_translations": {
                                "ru": "У него было <w>всепоглощающее</w> любопытство, которое заставляло его подвергать сомнению каждую деталь эксперимента."
                            }
                        }
                    ],
                    "synonyms": [
                        "all-consuming",
                        "voracious"
                    ],
                    "common_phrases": [
                        "omnivorous curiosity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потребляющий или охватывающий всё; всепоглощающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всепоглощающий",
                                "target_lang_sense_clarification": "охватывающий всё целиком"
                            },
                            {
                                "target_lang_word": "ненасытный",
                                "target_lang_sense_clarification": "крайне жадный до чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}