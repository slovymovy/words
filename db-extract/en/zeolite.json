                    },
                    {
                        "translation_id": "9c1ff969-4fe3-4ad2-b009-a7fbc11c4222",
                        "source_entry_id": "2cbeed3d-2aca-33ba-98d8-f414f6808618",
                        "source_sense_id": "3c309ff4-c166-3ade-a916-7cccf409a16e",
