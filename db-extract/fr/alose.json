                                        "entry_id": "6e75144f-82d3-3475-b0de-4513c20cec2f",
                                        "glosses": [
                                            "Any one of several species of food fishes that make up the genus Alosa in the family Clupeidae, to which the herrings also belong; river herring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643c95ed-b898-49b8-8130-732b1a935f3a",
                                                "sense_id": "e7a5bfbd-c4d5-3f75-83ce-9b6fa0fd33a1",
                                                "text": "Each river had its village and its iron bridge that the train crossed with a blast of its whistle, and the girls bathing in the icy water leaped like shad as it passed, unsettling travelers with their fleeting breasts."
                                            }
