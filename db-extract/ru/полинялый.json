                                    {
                                        "sense_id": "11d388cc-e7fe-3e93-b1ad-f2736479fbd4",
                                        "entry_id": "7597f63d-f737-35a0-b2ae-449a5f86f4b3",
                                        "glosses": [
                                            "That has lost some of its former strength or vigour."
