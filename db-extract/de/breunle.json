                "senses": [
                    {
                        "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                        "entry_id": "d1192d11-1150-3eb7-8d6f-61531f0b5a96",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ffec5d-157f-48aa-bd32-3ea6cb3d8a02",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Frau Breunle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b4a58265-26cf-4be3-ab92-163482dad70c",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Herr Breunle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ac1e6531-040d-4437-a13a-ee5b2dff5fee",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Die Breunles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7482ea33-b8e8-445c-9dbc-d69540685460",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Der Breunle trägt nie die Schals, die die Breunle ihm strickt."
                            },
                            {
                                "example_id": "d3e08f97-bac8-4b88-b584-7fea614ae9e4",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breunle kommt, geht der Herr Breunle.“"
                            },
                            {
                                "example_id": "73bd10c8-71f0-4574-9060-b45d4769a952",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Breunle kommt und geht."
                            },
                            {
                                "example_id": "6e9ed7a8-730b-4844-b5d2-f9fe2c62b28b",
                                "sense_id": "395c1fdd-c35e-3a2f-9480-b76f72f5ddfa",
                                "text": "Breunles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
