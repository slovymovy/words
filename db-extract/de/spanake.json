                        "examples": [
                            {
                                "example_id": "b37ec792-ecb4-4e85-a5ed-7056392e41ba",
                                "sense_id": "24ea78b2-52a4-34d5-96f0-1aa908f50f37",
                                "text": "[Es] folgte […] dann 2007 eine Mini CD namens „God Among Slaves“. Die brachte den Spanaken einen Deal bei Noisehead Records ein und in deren Studio wurde das nun vorliegende Album „Divinity“ auch eingeprügelt."
                            },
                            {
                                "example_id": "cf3d6a49-e9bb-4edb-89e3-fa161a8bde54",
                                "sense_id": "24ea78b2-52a4-34d5-96f0-1aa908f50f37",
                                "text": "Hey, du kommst jetzt mit raus, ich hab' genug von euch Spanacken!"
                            },
                            {
                                "example_id": "6491bf28-6057-4a10-bd78-e0a44f7570ac",
                                "sense_id": "24ea78b2-52a4-34d5-96f0-1aa908f50f37",
                                "text": "Und deine Tochter Ayse kriegt jeden Tag einen Strauß Rosen,\ndoch so ein Spanacke kommt dir nicht ins Haus.\nWarum nicht der Ali? Warum nicht der Klaus?\nSpanier sind faul, asoziales Pack."
                            }
                        ]
                    }
