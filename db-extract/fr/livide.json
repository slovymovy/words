            {
                "entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                "word": "livide",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f9a2e98c-0274-4a14-995d-de01214cfa86",
                        "entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "livides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                        "entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                        "glosses": [
                            "Qui est de couleur plombée, bleuâtre et extrêmement pâle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "660981b7-9562-4d3d-a66a-8fd356aafa71",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "Mais toi t’es partie en me laissant blanc comme un linge devant le lit vide (livide)"
                            },
                            {
                                "example_id": "632de407-1c41-4a5b-af39-ffee1e16b3df",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "Lorenzo. – Te voilà, toi, face livide ?\nLa lune paraît."
                            },
                            {
                                "example_id": "c5f277a9-ceda-46b9-9ecb-b6cc49cc7f54",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "Les traits du Babillard étaient livides, une sueur froide perlait à ses tempes et le sang coulait en abondance d’une blessure qu’il avait à la poitrine."
                            },
                            {
                                "example_id": "bef71bd4-efe9-4e9f-bb30-9d21c6a44706",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "Je jetai les yeux sur Grégoriska: il n'était plus pâle, il était livide."
                            },
                            {
                                "example_id": "785e1d7b-e816-4533-9d41-b39d94c382a4",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "[…] ; de temps en temps seulement un éclair livide illuminait les appartements sombres d’un reflet bleuâtre qui disparaissait aussitôt."
                            },
                            {
                                "example_id": "358c971a-d61b-4eb7-a95c-6c6a5d4ecd34",
                                "sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                                "text": "Au milieu de la cheminée, un gros chiffre noir sur la feuille livide d’un calendrier : dimanche 12 janvier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91ecb0e0-2967-42b6-9eb2-83973f99ac1e",
                        "source_entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                        "source_sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                        "target_lang_word": "bleifarben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleifarben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24f97e5b-6da2-35b1-b58b-8445925b8b29",
                                        "entry_id": "086584d7-b374-3765-858d-d23e3e459b7f",
                                        "glosses": [
                                            "die graue Farbe von Blei habend; in der Farbe von Blei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3a5afc-33a8-41c5-bf7d-ef34b98dcbf1",
                                                "sense_id": "24f97e5b-6da2-35b1-b58b-8445925b8b29",
                                                "text": "„Die Straße wand sich die Küste entlang, tote Besengrasbüschel hingen auf das Pflaster. In der Ferne die Bewegung der bleifarbenen See.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b14a97a-cc20-4cbd-8618-249a6a7c2444",
                        "source_entry_id": "388bd1b9-7e2a-382b-b288-788544e2e4ac",
                        "source_sense_id": "ceceb573-b0f0-3210-aa58-5f8d0be8e9d2",
                        "target_lang_word": "aschfahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aschfahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b1ccd3d-794d-38e1-9e11-b1a366fa9505",
                                        "entry_id": "fc4df798-a361-3b93-81da-db66213f691f",
                                        "glosses": [
                                            "fahl wie Asche, graubleich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627dcead-f036-4437-af41-c1b4135bb998",
                                                "sense_id": "6b1ccd3d-794d-38e1-9e11-b1a366fa9505",
                                                "text": "Er hatte ein aschfahles Gesicht."
                                            },
                                            {
                                                "example_id": "059f192e-3776-45b9-bb5f-61351cf9df3e",
                                                "sense_id": "6b1ccd3d-794d-38e1-9e11-b1a366fa9505",
                                                "text": "Als sie diese Nachricht hörte, wurde sie aschfahl im Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43376c6-9d6b-4dfe-883b-3d4d7aafda52",
