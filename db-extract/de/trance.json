                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "285d7413-f64d-3d04-8910-6a8723083588",
                                        "entry_id": "df9c4b6e-a495-34d6-b14e-0f8109a894c6",
                                        "glosses": [
                                            "To (cause to) be in a trance; to entrance."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8a374b-5dab-4e28-85bb-0697b083459b",
                                                "sense_id": "285d7413-f64d-3d04-8910-6a8723083588",
                                                "text": "And there I left him tranced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435d9f15-2d55-3b35-888a-0f9f91c17524",
                                        "entry_id": "df9c4b6e-a495-34d6-b14e-0f8109a894c6",
                                        "glosses": [
                                            "To create in or via a trance."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c73be61f-85da-4c15-9b81-305844310c7e",
                                                "sense_id": "435d9f15-2d55-3b35-888a-0f9f91c17524",
                                                "text": "The Horned Toad (kɛŋkak) tranced the rivers into being. A bakɔh bird tranced the mountains. The Scrub Bulbul (ˀɛsˀããs) drilled fire into existence with its beak. And, finally, the Bronzed Black Drongo (tɛrhɛɛh) tranced the year […]"
                                            },
                                            {
                                                "example_id": "dac54990-c39f-48ee-9397-d5e941adb323",
                                                "sense_id": "435d9f15-2d55-3b35-888a-0f9f91c17524",
                                                "text": "What is interesting for us here is that Chingkai and her familiars dreamed and tranced the Temiar world into being. […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99c3ebae-c5b9-3bee-8a24-a9b33c903276",
