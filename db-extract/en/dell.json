                "forms": [
                    {
                        "form_id": "5816a4ea-b628-42b4-b6ac-fba1ba0accf6",
                        "entry_id": "a295fe5b-9767-374c-965f-f5d8b8a9f530",
                        "tags": [
                            "plural"
                        ],
                        "form": "dells"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62ddb7d2-0394-3b99-b34c-a6492c1fc4c2",
                        "entry_id": "a295fe5b-9767-374c-965f-f5d8b8a9f530",
                        "glosses": [
                            "A small, deep, and wooded valley or sunken area of ground, especially in the form of a natural hollow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516d25c9-17d0-492a-b527-e666ca7790be",
                                "sense_id": "62ddb7d2-0394-3b99-b34c-a6492c1fc4c2",
                                "text": "To this day they dwell\nIn a lonely dell."
                            },
                            {
                                "example_id": "c69adad0-e290-440f-8c2f-306881ebf056",
                                "sense_id": "62ddb7d2-0394-3b99-b34c-a6492c1fc4c2",
                                "text": "In dells and dales, conceal'd from human sight."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de42ef9a-7b71-4f3e-bc87-0e3b28f440b0",
                        "source_entry_id": "a295fe5b-9767-374c-965f-f5d8b8a9f530",
                        "source_sense_id": "62ddb7d2-0394-3b99-b34c-a6492c1fc4c2",
                        "source_sense_description": "sunken area of ground",
                        "target_lang_word": "inzinking",
