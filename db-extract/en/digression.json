                        "target_lang_word": "Exkurs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exkurs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c67580-b814-3ea3-af3d-deef527221e6",
                                        "entry_id": "db0487c3-5067-375a-8a6a-58fa9c2897a4",
                                        "glosses": [
                                            "Einschub eines Themas in einen Text, der mit den übrigen Themen nur entfernt zu tun hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eab50c2-78a2-4029-9b21-afdb36c726f4",
                                                "sense_id": "f5c67580-b814-3ea3-af3d-deef527221e6",
                                                "text": "In wissenschaftlichen Abhandlungen ist ein Exkurs eine in den Text eingefügte oder als Anhang beigefügte selbständige und in sich geschlossene Abschweifung."
                                            },
                                            {
                                                "example_id": "15a0ea6f-2874-4a95-b0c8-564148911771",
                                                "sense_id": "f5c67580-b814-3ea3-af3d-deef527221e6",
                                                "text": "„Sollte man Menschen verurteilen, die ihre Träume ausleben?, fragt die Autorin – und hilft mit vielen praktischen Exkursen zum Thema Höhenbergsteigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dc40a3d-ad80-4138-8993-6e2257f0d17f",
                        "source_entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                        "source_sense_description": "a departure from the main subject in speech or writing",
                        "target_lang_word": "Umschweif",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umschweif",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5681fe57-476b-386d-ad7d-1452f9030d42",
                                        "entry_id": "2d864d1a-73f3-346a-9e3a-19e9d3cc9b8f",
                                        "glosses": [
                                            "umständliches Verhalten, übertriebene Ausführlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c605e1c8-cb4c-46e8-8627-c9202b68d9b4",
                                                "sense_id": "5681fe57-476b-386d-ad7d-1452f9030d42",
                                                "text": "„Sie hatte wenig Zeit, und ich überfiel sie ohne Umschweife mit meinem Anliegen.“"
                                            },
                                            {
                                                "example_id": "dd05e4af-dc47-4bb0-bbe3-771319f944f7",
                                                "sense_id": "5681fe57-476b-386d-ad7d-1452f9030d42",
                                                "text": "„Man könnte es auch ohne Umschweife als tragisch bezeichnen.“"
                                            },
                                            {
                                                "example_id": "6dee0721-e675-4c40-803c-c812317d1b24",
                                                "sense_id": "5681fe57-476b-386d-ad7d-1452f9030d42",
                                                "text": "„Ich befürchtete, dass der Diener mich nicht hereinlassen würde, wenn ich im Gewand eines einfachen Seemanns anklopfte, also öffnete ich die Eingangstür ohne Umschweife und ging direkt durch zum Salon, bevor man mich aufhalten konnte.“"
                                            },
                                            {
                                                "example_id": "d25b69fc-5fd6-42f8-ba7e-2351099d9f8a",
                                                "sense_id": "5681fe57-476b-386d-ad7d-1452f9030d42",
                                                "text": "„Ich unterschrieb ohne Umschweife.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea5df383-b7fe-4048-ab04-335fa65ed5b9",
