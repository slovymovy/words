                            {
                                "example_id": "b2ea8a97-03ca-4fa5-b6a3-7af5b01045da",
                                "sense_id": "2f812947-490f-3808-afda-c233a5fd19a5",
                                "text": "Op 22 december is het echt precies honderd jaar geleden dat het Oude Luxor als bioscooptheater open ging."
                            },
                            {
                                "example_id": "27d71aca-e89b-4cf7-9e05-ca8e4e6c57cf",
                                "sense_id": "2f812947-490f-3808-afda-c233a5fd19a5",
                                "text": "Tegelijk solliciteert hij in 1941 naar de post van organist bij een bioscooptheater aan het Leidseplein, wat hem zijn functie als kerkorganist bij de hersteld evangelisch-lutherse kerk aan de Kloveniersburgwal (de post van Jan Zwart) kost. De kerk vindt de combinatie niet gelukkig."
                            }
                        ]
