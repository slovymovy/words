                    {
                        "translation_id": "c001ee41-d5da-4028-a635-c742fcc73886",
                        "source_entry_id": "5a43c967-41ed-3753-98c4-28df6cd0272a",
                        "source_sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
                        "source_sense_description": "Nom",
                        "target_lang_word": "Snob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea333d13-1b9f-39c4-835d-2f1917640fa1",
                                        "entry_id": "7c8ca04f-5d9b-3930-bf3b-f5515f130802",
                                        "glosses": [
                                            "blasierter Mensch, Wichtigtuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cca39b2-e7a5-407b-b81f-9e12af1e4c34",
                                                "sense_id": "ea333d13-1b9f-39c4-835d-2f1917640fa1",
                                                "text": "Sein Auftreten als Snob brachte ihm keine Freunde."
                                            },
                                            {
                                                "example_id": "837f0c5a-4312-40a2-9a9b-b991ebe05e60",
                                                "sense_id": "ea333d13-1b9f-39c4-835d-2f1917640fa1",
                                                "text": "„Nach dem Mittagessen fingen die Leute an, Zweige am Strand mit Aluminiumpapier zu schmücken, und Kerstin Horner sagte, das würde sie nicht aushalten. Sie war ein Snob, das hatte Anders schon seit langem gewusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a2de8b-d971-4301-8c8b-4bd9380931b0",
                        "source_entry_id": "5a43c967-41ed-3753-98c4-28df6cd0272a",
                        "source_sense_id": "5586973f-73ba-35be-b2f9-4d0330aef20e",
                        "source_sense_description": "Nom",
                        "target_lang_word": "Fatzke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fatzke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b513053-c3c0-38c7-8a49-41b39dec0ec6",
                                        "entry_id": "4921a9ed-4873-3e51-8dfe-9ff128fabf10",
                                        "glosses": [
                                            "von sich eingenommene, eitle und arrogante Person"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddf439c9-9e97-4ed5-b6f1-2f670e203b02",
                                                "sense_id": "4b513053-c3c0-38c7-8a49-41b39dec0ec6",
                                                "text": "„Das von Bismarck schon Disraeli vorgeschlagene Bündnis hätte man von Chamberlain kostenfrei erhalten, doch mit einem Unzurechnungsfähigen, halb Fatzke, halb Brutalisator, konnte man nie an einem Verhandlungstische sitzen.“"
                                            },
                                            {
                                                "example_id": "6bc0103f-8ab0-42b2-999a-548f632632c9",
                                                "sense_id": "4b513053-c3c0-38c7-8a49-41b39dec0ec6",
                                                "text": "„Vielleicht müsste man seine Gestalt noch einmal ganz anders angehen, vielleicht gehört er in eine Galerie, die den Philosophen, den Schriftsteller, den intellektuellen Virtuosen verschiedener Zeiten als Fatzke zeigt. Eine strahlende, alles durchdringende Intelligenz, die zugleich bis zur Erschöpfung in sich selbst verliebt ist und das Publikum, das nicht anders kann als bewundern, dafür verachtet, ein Publikum, durch das der Fatzke tagtäglich stolziert, um die öffentliche Aufmerksamkeit einzutreiben, zuerst im rotkohlfarbenen, dann im zitronengelben Mantel. Die Phänomenologie des Intellektuellen als Fatzke, das wäre doch mal was.“"
                                            },
                                            {
                                                "example_id": "5d113666-3b5e-42cb-9c1f-d8b0b5a9c328",
                                                "sense_id": "4b513053-c3c0-38c7-8a49-41b39dec0ec6",
                                                "text": "„Für diesen Fatzke bin ich weniger wert als der Dreck auf der Straße, dachte Richard.“"
                                            },
                                            {
                                                "example_id": "ba43cd73-2e47-433e-814c-e3c1a23d257d",
                                                "sense_id": "4b513053-c3c0-38c7-8a49-41b39dec0ec6",
                                                "text": "„Er ist eben ein Fatzke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
