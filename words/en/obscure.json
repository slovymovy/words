{
    "word_family": [
        "obscurity",
        "obscurely",
        "obscurantism",
        "obscuration"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "16ba7433-edb9-3db3-b216-5fa5bc9c312a",
                    "sense_definition": "Not well known to most people; known by only a few.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to listen to <w>obscure</w> jazz records from the 1920s.",
                            "target_lang_translations": {
                                "ru": "Ему нравится слушать <w>малоизвестные</w> джазовые пластинки 1920-х годов.",
                                "zh": "他喜欢听20世纪20年代那些<w>鲜为人知</w>的爵士乐唱片。"
                            }
                        },
                        {
                            "text": "The professor specializes in an <w>obscure</w> period of European history.",
                            "target_lang_translations": {
                                "ru": "Профессор специализируется на <w>малоизвестном</w> периоде европейской истории.",
                                "zh": "这位教授专门研究欧洲历史上一个<w>冷门</w>的时期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "esoteric",
                        "enigmatic"
                    ],
                    "common_phrases": [
                        "obscure band",
                        "obscure writer",
                        "obscure fact",
                        "remains obscure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неизвестный большинству людей; знакомый лишь немногим.",
                        "zh": "指不为大众所知，仅有少数人了解的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "малоизве́стный",
                                "target_lang_sense_clarification": "о фактах, людях или произведениях искусства"
                            },
                            {
                                "target_lang_word": "неизве́стный",
                                "target_lang_sense_clarification": "не пользующийся известностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲜为人知",
                                "target_lang_sense_clarification": "形容很少有人知道"
                            },
                            {
                                "target_lang_word": "冷门",
                                "target_lang_sense_clarification": "指不热门、不被大众关注的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bafb3799-a95b-3bd7-9ff5-c94f8dea69d1",
                    "sense_definition": "Difficult to understand, explain, or identify; not clear or precise.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract was written in <w>obscure</w> legal language that confused everyone.",
                            "target_lang_translations": {
                                "ru": "Контракт был написан <w>непонятным</w> юридическим языком, который всех запутал.",
                                "zh": "这份合同是用<w>晦涩</w>的法律术语写成的，让所有人都感到困惑。"
                            }
                        },
                        {
                            "text": "For some <w>obscure</w> reason, she decided to leave the party early.",
                            "target_lang_translations": {
                                "ru": "По какой-то <w>непонятной</w> причине она решила уйти с вечеринки рано.",
                                "zh": "出于某种<w>模糊</w>的原因，她决定提前离开聚会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inscrutable",
                        "mysterious",
                        "fathomless"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "obscure meaning",
                        "obscure reference",
                        "obscure reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания, объяснения или определения; неясный.",
                        "zh": "难以理解、解释或辨认；不清晰或不精确的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непоня́тный",
                                "target_lang_sense_clarification": "сложный для осмысления"
                            },
                            {
                                "target_lang_word": "нея́сный",
                                "target_lang_sense_clarification": "лишенный определенности или точности"
                            },
                            {
                                "target_lang_word": "тума́нный",
                                "target_lang_sense_clarification": "перен. расплывчатый, загадочный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晦涩",
                                "target_lang_sense_clarification": "指文字或语言难懂"
                            },
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指概念或意义不明确"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e936537c-148c-3186-b6ce-42ef25c72b5b",
                    "sense_definition": "Not clearly seen or distinguished; faint, dim, or physically indistinct.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>obscure</w> figure appeared in the distance through the heavy fog.",
                            "target_lang_translations": {
                                "ru": "Вдали сквозь густой туман появилась <w>смутная</w> фигура.",
                                "zh": "浓雾中，远处出现了一个<w>模糊</w>的身影。"
                            }
                        },
                        {
                            "text": "The details of the old photograph were <w>obscure</w> and hard to make out.",
                            "target_lang_translations": {
                                "ru": "Детали на старой фотографии были <w>неясными</w> и их было трудно разобрать.",
                                "zh": "这张旧照片上的细节非常<w>朦胧</w>，很难辨认。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fuzzy",
                        "ill-defined",
                        "dingy"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "obscure shape",
                        "obscure figure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо различимый; тусклый, нечеткий или физически неявный.",
                        "zh": "看不清楚或难以辨别；微弱、暗淡或物理上不清晰的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сму́тный",
                                "target_lang_sense_clarification": "плохо различимый очертаниями"
                            },
                            {
                                "target_lang_word": "нея́сный",
                                "target_lang_sense_clarification": "плохо видимый, расплывчатый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "指视觉上不清晰"
                            },
                            {
                                "target_lang_word": "朦胧",
                                "target_lang_sense_clarification": "指轮廓不分明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "975642dc-ad4c-38ba-9891-d087f33ede38",
                    "sense_definition": "Hidden from view; located in a remote or out-of-the-way place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lived in a small cottage in an <w>obscure</w> corner of the forest.",
                            "target_lang_translations": {
                                "ru": "Они жили в маленьком домике в <w>глухом</w> уголке леса.",
                                "zh": "他们住在森林里一个<w>偏僻</w>角落的小屋里。"
                            }
                        },
                        {
                            "text": "The library keeps its rarest books in an <w>obscure</w> room in the basement.",
                            "target_lang_translations": {
                                "ru": "Библиотека хранит свои самые редкие книги в <w>скрытой</w> комнате в подвале.",
                                "zh": "图书馆把最珍贵的书存放在地下室一个<w>隐蔽</w>的房间里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "secluded",
                        "occluded"
                    ],
                    "common_phrases": [
                        "obscure corner",
                        "obscure village"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый от глаз; расположенный в отдаленном или неприметном месте.",
                        "zh": "隐藏在视线之外；位于偏远或不起眼的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухо́й",
                                "target_lang_sense_clarification": "о месте: удаленный, уединенный, малопосещаемый"
                            },
                            {
                                "target_lang_word": "скры́тый",
                                "target_lang_sense_clarification": "утаенный от взгляда"
                            },
                            {
                                "target_lang_word": "неприме́тный",
                                "target_lang_sense_clarification": "не привлекающий внимания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏僻",
                                "target_lang_sense_clarification": "指地理位置偏远"
                            },
                            {
                                "target_lang_word": "隐蔽",
                                "target_lang_sense_clarification": "指不易被发现"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15ca2574-1fa6-3ed4-94a7-b8676c2ec85a",
                    "sense_definition": "To cover something so that it cannot be seen; to block the view of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick grey clouds arrived to <w>obscure</w> the moon completely.",
                            "target_lang_translations": {
                                "ru": "Налетели густые серые тучи и полностью <w>скрыли</w> луну.",
                                "zh": "厚厚的灰云飘来，完全<w>遮挡</w>了月亮。"
                            }
                        },
                        {
                            "text": "A large truck <w>obscured</w> the driver's view of the road ahead.",
                            "target_lang_translations": {
                                "ru": "Большой грузовик <w>заслонил</w> водителю обзор дороги впереди.",
                                "zh": "一辆大卡车<w>遮挡</w>了司机对前方道路的视线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "obscure the view",
                        "obscure the sun",
                        "clouds obscure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать собой, мешая видеть что-либо; заслонять обзор.",
                        "zh": "遮盖某物使其无法被看见；阻挡视线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслоня́ть",
                                "target_lang_sense_clarification": "преграждать вид на что-либо"
                            },
                            {
                                "target_lang_word": "скрыва́ть",
                                "target_lang_sense_clarification": "делать невидимым, прятать"
                            },
                            {
                                "target_lang_word": "затемня́ть",
                                "target_lang_sense_clarification": "делать темным, перекрывая свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遮挡",
                                "target_lang_sense_clarification": "指阻挡视线"
                            },
                            {
                                "target_lang_word": "掩盖",
                                "target_lang_sense_clarification": "指遮住使看不见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4e53eec-9ce0-31b7-a52c-8e6e47940aa1",
                    "sense_definition": "To make something difficult to understand, perceive, or see clearly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>obscure</w> the facts with a long and complicated speech.",
                            "target_lang_translations": {
                                "ru": "Политик пытался <w>скрыть</w> факты длинной и сложной речью.",
                                "zh": "那位政客试图用冗长复杂的演讲来<w>掩盖</w>事实。"
                            }
                        },
                        {
                            "text": "Too much technical jargon can <w>obscure</w> the real meaning of the text.",
                            "target_lang_translations": {
                                "ru": "Слишком большое количество технических терминов может <w>затемнить</w> истинный смысл текста.",
                                "zh": "过多的专业术语会<w>混淆</w>文本的真实含义。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "obscure the truth",
                        "obscure the issue",
                        "obscure the meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо трудным для понимания или восприятия; запутывать.",
                        "zh": "使某事难以理解、感知或看清。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затемня́ть",
                                "target_lang_sense_clarification": "делать смысл неясным"
                            },
                            {
                                "target_lang_word": "запу́тывать",
                                "target_lang_sense_clarification": "вносить неясность, усложнять понимание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混淆",
                                "target_lang_sense_clarification": "指使界限不清"
                            },
                            {
                                "target_lang_word": "掩盖",
                                "target_lang_sense_clarification": "指使真相难以被察觉"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}