{
    "word_family": [
        "excuus",
        "excusabel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1e1ed5d-bef0-3c4f-8ccb-784de267026f",
                    "sense_definition": "zich <w>verontschuldigen</w> om begrip te vragen voor iemands gedrag of een situatie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verontschuldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>excuseerde</w> zich dat hij vroeg vertrekken moest.",
                            "target_lang_translations": {
                                "en": "He <w>excused</w> himself because he had to leave early."
                            }
                        },
                        {
                            "text": "Je moet je <w>excuseren</w> voor je gedrag van gisteren.",
                            "target_lang_translations": {
                                "en": "You must <w>apologize</w> for your behavior yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "verontschuldigen"
                    ],
                    "common_phrases": [
                        "zich excuseren voor"
                    ],
                    "target_lang_definitions": {
                        "en": "to apologize or excuse oneself in order to ask for understanding regarding one's behavior or a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse oneself",
                                "target_lang_sense_clarification": "to politely ask to leave or explain an action"
                            },
                            {
                                "target_lang_word": "apologize",
                                "target_lang_sense_clarification": "to express regret for something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09878861-6e21-33fa-b108-3eea9c5a82ae",
                    "sense_definition": "een reden of verklaring geven om een fout of tekortkoming te rechtvaardigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verontschuldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>excuseerde</w> het gebrek aan gegevens met een verwijzing naar de technische problemen.",
                            "target_lang_translations": {
                                "en": "He <w>excused</w> the lack of data by referring to the technical problems."
                            }
                        },
                        {
                            "text": "Zij probeerde haar fout te <w>excuseren</w> door te zeggen dat ze moe was.",
                            "target_lang_translations": {
                                "en": "She tried to <w>justify</w> her mistake by saying she was tired."
                            }
                        }
                    ],
                    "synonyms": [
                        "verontschuldigen",
                        "verschonen",
                        "goedpraten",
                        "verantwoorden"
                    ],
                    "common_phrases": [
                        "een fout excuseren"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide a reason or explanation to justify a mistake or shortcoming"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "to justify or provide an explanation for a fault"
                            },
                            {
                                "target_lang_word": "justify",
                                "target_lang_sense_clarification": "to show or prove to be right or reasonable"
                            },
                            {
                                "target_lang_word": "explain away",
                                "target_lang_sense_clarification": "to minimize the importance of a mistake by giving reasons"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a384696a-cb65-3384-9e97-5fff8e15083b",
                    "sense_definition": "iemand een fout niet aanrekenen of een straf kwijtschelden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vergeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij besloot de afwezigheid van de studenten te <w>excuseren</w> vanwege het slechte weer.",
                            "target_lang_translations": {
                                "en": "He decided to <w>excuse</w> the students' absence because of the bad weather."
                            }
                        },
                        {
                            "text": "De leraar kon deze kleine overtreding voor één keer <w>excuseren</w>.",
                            "target_lang_translations": {
                                "en": "The teacher could <w>overlook</w> this minor offense for once."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergeven",
                        "verschonen"
                    ],
                    "common_phrases": [
                        "iemand excuseren"
                    ],
                    "target_lang_definitions": {
                        "en": "to not hold a mistake against someone or to remit a punishment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "to overlook or forgive a minor offense or absence"
                            },
                            {
                                "target_lang_word": "forgive",
                                "target_lang_sense_clarification": "to stop feeling angry or resentful toward someone for an offense"
                            },
                            {
                                "target_lang_word": "pardon",
                                "target_lang_sense_clarification": "to release from a requirement or penalty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}