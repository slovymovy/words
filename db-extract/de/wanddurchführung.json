                "senses": [
                    {
                        "sense_id": "24c06674-48fe-30af-9a1e-fa5a935bd192",
                        "entry_id": "cbc4c5ce-227b-3f1c-bff9-36f2edcb0d1d",
                        "glosses": [
                            "Bauteil, das in einen Wanddurchbruch eingedichtet wird und so einen Durchgang für zum Beispiel Kabel- oder Rohrleitungen bietet"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "91c53852-bd42-412e-a20b-702dfd8396b3",
                                "sense_id": "24c06674-48fe-30af-9a1e-fa5a935bd192",
                                "text": "„Mit den vorgefertigten Wanddurchführungen können Wanddurchbrüche für Schornsteine wesentlich kleiner ausfallen als in herkömmlicher Bauweise.“"
                            },
                            {
                                "example_id": "2d2085ca-e2a9-4403-a2c4-e8fcfbcc95a3",
                                "sense_id": "24c06674-48fe-30af-9a1e-fa5a935bd192",
                                "text": "„Wanddurchführung einseitig mit angeschweißter Platte, einseitig Anschlussplatte lose beigelegt Durchmesser in Anlehnung an die DIN 8077.“"
                            },
                            {
                                "example_id": "1302d23d-4d84-4d12-8f1a-710cf49e8cb6",
                                "sense_id": "24c06674-48fe-30af-9a1e-fa5a935bd192",
                                "text": "„Heutzutage werden die Durchbrüche für die Wanddurchführungen mit einem Kernbohrgerät hergestellt, damit sie passend eingebaut werden können.“"
                            },
                            {
                                "example_id": "44d589cf-a79a-4578-acca-e4eabacec41d",
                                "sense_id": "24c06674-48fe-30af-9a1e-fa5a935bd192",
                                "text": "„Fix und fertig als leicht transportierbare Einheit wird diese platzsparende Wanddurchführung bereits vor dem Erstellen Ihres Gebäude eingepasst und nach der Fertigstellung des Fertigfußbodens verschraubt oder nach Fertigstellung Ihres Kellers lediglich in eine Kernbohrung bzw. in ein Futterrohr eingepasst, verschraubt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
