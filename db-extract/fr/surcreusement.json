                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5407a866-9c80-4772-92cc-be4c2b7f30b9",
                                "sense_id": "9b0cfff7-4973-3905-9a46-2f5bcd5ecd64",
                                "text": "Enfin le surcreusement glaciaire se manifeste de façon remarquable en divers endroits des vallées saônoises en particulier sur le plateau Ognon-Breuchin ; […]."
                            },
                            {
                                "example_id": "b3b6d48c-6e00-422c-b11b-2b8b0bdc98d3",
                                "sense_id": "9b0cfff7-4973-3905-9a46-2f5bcd5ecd64",
                                "text": "Le surcreusement s'est produit durant l'époque pléistocène, quand le fossé tectonique de la baie Frobisher était occupé par un important glacier émissaire."
                            }
                        ]
                    }
