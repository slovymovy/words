{
    "word_family": [
        "wide",
        "widely",
        "wideness",
        "widening",
        "width"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e3b4720-c769-38b4-8560-9cd000a11960",
                    "sense_definition": "To become wide or wider in physical distance or size.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His eyes <w>widened</w> in surprise when he saw the beautiful gift.",
                            "target_lang_translations": {
                                "ru": "Его глаза <w>расширились</w> от удивления, когда он увидел прекрасный подарок."
                            }
                        },
                        {
                            "text": "The river <w>widens</w> as it flows toward the sea.",
                            "target_lang_translations": {
                                "ru": "Река <w>расширяется</w> по мере приближения к морю."
                            }
                        }
                    ],
                    "synonyms": [
                        "broaden"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "eyes widen",
                        "river widens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться шире в физическом расстоянии или размере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширяться",
                                "target_lang_sense_clarification": "становиться шире (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "расшириться",
                                "target_lang_sense_clarification": "стать шире (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05e3e3b-e3f3-30ee-85c8-62862be0d7cb",
                    "sense_definition": "To make something wide or wider in physical distance or size.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city decided to <w>widen</w> the road to reduce traffic congestion.",
                            "target_lang_translations": {
                                "ru": "Город решил <w>расширить</w> дорогу, чтобы уменьшить пробки."
                            }
                        },
                        {
                            "text": "They had to <w>widen</w> the entrance to allow the large truck to pass through.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>расширить</w> въезд, чтобы смог проехать большой грузовик."
                            }
                        }
                    ],
                    "synonyms": [
                        "broaden"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "widen the road",
                        "widen the gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо шире в физическом расстоянии или размере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "делать шире (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "расширить",
                                "target_lang_sense_clarification": "сделать шире (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8413944-274c-3d64-aecb-ac45f143a9bb",
                    "sense_definition": "To broaden or extend in scope, range, or variety.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police <w>widened</w> their search for the missing person to include the neighboring towns.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>расширила</w> зону поиска пропавшего человека, включив в неё соседние города."
                            }
                        },
                        {
                            "text": "Reading books can help you <w>widen</w> your horizons and learn about different cultures.",
                            "target_lang_translations": {
                                "ru": "Чтение книг поможет вам <w>расширить</w> кругозор и узнать о разных культурах."
                            }
                        }
                    ],
                    "synonyms": [
                        "broaden"
                    ],
                    "antonyms": [
                        "narrow"
                    ],
                    "common_phrases": [
                        "widen your horizons",
                        "widen the scope",
                        "widen the search"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расширять сферу охвата, диапазон или разнообразие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "увеличивать масштаб или кругозор"
                            },
                            {
                                "target_lang_word": "расширить",
                                "target_lang_sense_clarification": "увеличить масштаб или кругозор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bff008c-e3e6-33a7-8e68-f2bb1063057e",
                    "sense_definition": "To adjust clothes to a larger size by letting out the fabric.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor had to <w>widen</w> the waist of the trousers because they were too tight.",
                            "target_lang_translations": {
                                "ru": "Портному пришлось <w>расширить</w> брюки в талии, потому что они были слишком тесными."
                            }
                        },
                        {
                            "text": "She asked her mother to <w>widen</w> the dress so she could wear it comfortably.",
                            "target_lang_translations": {
                                "ru": "Она попросила маму <w>расширить</w> платье, чтобы его было удобно носить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "widen the waist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подгонять одежду под больший размер, выпуская ткань."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширить",
                                "target_lang_sense_clarification": "сделать одежду свободнее"
                            },
                            {
                                "target_lang_word": "расставить",
                                "target_lang_sense_clarification": "увеличить размер одежды в швах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a7fbea-ef17-3cdc-b561-e1a5e1b5b2e7",
                    "sense_definition": "To convert a data type to one that can hold a larger number of distinct values.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_conversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler will automatically <w>widen</w> a short variable to an int variable during the operation.",
                            "target_lang_translations": {
                                "ru": "Компилятор автоматически <w>расширит</w> переменную типа short до типа int во время операции."
                            }
                        },
                        {
                            "text": "You may need to <w>widen</w> the data type to prevent overflow errors in your code.",
                            "target_lang_translations": {
                                "ru": "Возможно, вам потребуется <w>расширить</w> тип данных, чтобы предотвратить ошибки переполнения в коде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "widen a variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать тип данных в такой, который может содержать большее количество значений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расширять",
                                "target_lang_sense_clarification": "приводить тип к более вместительному"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "61a9e303-e654-3bca-b3b0-19e3800e3513",
                    "sense_definition": "A surname of Swedish origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Widen</w> was known in the community for his extensive research on local history.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Виден</w> был известен в округе своими обширными исследованиями местной истории."
                            }
                        },
                        {
                            "text": "The <w>Widen</w> family moved from Sweden to the United States in the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Виден</w> переехала из Швеции в США в начале двадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Swedish origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия шведского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виден",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}