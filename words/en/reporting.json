{
    "word_family": [
        "report",
        "reporter",
        "reportage",
        "reportable",
        "misreport"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55402962-fa1f-3a47-aa39-6b0a90de4a39",
                    "sense_definition": "The act or process of creating and presenting formal statements or documents, especially in business or administration.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_reporting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software simplifies the <w>reporting</w> of monthly sales figures.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение упрощает <w>составление отчётов</w> о ежемесячных показателях продаж.",
                                "de": "Die neue Software vereinfacht die <w>Erfassung</w> der monatlichen Umsatzzahlen.",
                                "zh": "这款新软件简化了月度销售数据的<w>报告</w>流程。"
                            }
                        },
                        {
                            "text": "Strict financial <w>reporting</w> is required for all public companies to ensure transparency.",
                            "target_lang_translations": {
                                "ru": "Для обеспечения прозрачности от всех публичных компаний требуется строгая финансовая <w>отчётность</w>.",
                                "de": "Eine strenge finanzielle <w>Berichterstattung</w> ist für alle börsennotierten Unternehmen erforderlich, um Transparenz zu gewährleisten.",
                                "zh": "所有上市公司都必须进行严格的财务<w>汇报</w>，以确保透明度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "documentation",
                        "accounting"
                    ],
                    "common_phrases": [
                        "financial reporting",
                        "reporting system",
                        "reporting period",
                        "reporting requirements"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс создания и представления официальных заявлений или документов, особенно в бизнесе или администрации.",
                        "de": "Der Prozess der Erstellung und Vorlage formeller Berichte oder Dokumente, insbesondere im Geschäfts- oder Verwaltungsbereich.",
                        "zh": "在商业或行政管理中，创建和提交正式报告或文件的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчётность",
                                "target_lang_sense_clarification": "финансовая или деловая документация"
                            },
                            {
                                "target_lang_word": "составление отчётов",
                                "target_lang_sense_clarification": "процесс подготовки документов"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Berichtswesen",
                                "target_lang_sense_clarification": "System zur Erstellung von Berichten"
                            },
                            {
                                "target_lang_word": "Berichterstattung",
                                "target_lang_sense_clarification": "finanzielle oder betriebliche Dokumentation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报告",
                                "target_lang_sense_clarification": "指提交正式文件或陈述的行为"
                            },
                            {
                                "target_lang_word": "汇报",
                                "target_lang_sense_clarification": "指向上级或相关部门陈述情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92e2596d-041b-38f6-9dfa-eb1c638809ff",
                    "sense_definition": "The activity of gathering and presenting news for newspapers, radio, or television.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "journalism_reporting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her investigative <w>reporting</w> exposed corruption in the local government.",
                            "target_lang_translations": {
                                "ru": "Её расследовательские <w>репортажи</w> разоблачили коррупцию в местном правительстве.",
                                "de": "Ihre investigative <w>Berichterstattung</w> deckte Korruption in der Kommunalverwaltung auf.",
                                "zh": "她的调查性<w>报道</w>揭露了当地政府的腐败行为。"
                            }
                        },
                        {
                            "text": "We rely on accurate news <w>reporting</w> to understand complex current events.",
                            "target_lang_translations": {
                                "ru": "Мы полагаемся на точное новостное <w>освещение</w>, чтобы понимать сложные текущие события.",
                                "de": "Wir sind auf eine genaue Nachrichten<w>berichterstattung</w> angewiesen, um komplexe aktuelle Ereignisse zu verstehen.",
                                "zh": "我们依靠准确的新闻<w>报道</w>来理解复杂的时事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "journalism",
                        "coverage",
                        "newsgathering"
                    ],
                    "common_phrases": [
                        "investigative reporting",
                        "news reporting",
                        "factual reporting",
                        "live reporting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по сбору и представлению новостей для газет, радио или телевидения.",
                        "de": "Das Sammeln und Präsentieren von Nachrichten für Zeitungen, Radio oder Fernsehen.",
                        "zh": "为报纸、广播或电视收集并呈现新闻的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репортаж",
                                "target_lang_sense_clarification": "журналистский материал"
                            },
                            {
                                "target_lang_word": "освещение",
                                "target_lang_sense_clarification": "подача новостей или событий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Berichterstattung",
                                "target_lang_sense_clarification": "journalistische Vermittlung von Informationen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "报道",
                                "target_lang_sense_clarification": "新闻媒体对事件的叙述和传播"
                            },
                            {
                                "target_lang_word": "新闻采访",
                                "target_lang_sense_clarification": "记者收集新闻素材的过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e713235a-7788-3808-8869-0f96352d1966",
                    "sense_definition": "Present participle and gerund of <w>report</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist is currently <w>reporting</w> live from the scene of the accident.",
                            "target_lang_translations": {
                                "ru": "Журналист в данный момент <w>ведёт репортаж</w> в прямом эфире с места происшествия.",
                                "de": "Der Journalist <w>berichtet</w> derzeit live vom Unfallort.",
                                "zh": "记者目前正在事故现场进行直播<w>报道</w>。"
                            }
                        },
                        {
                            "text": "He was <w>reporting</w> the theft to the police when I arrived at the station.",
                            "target_lang_translations": {
                                "ru": "Он <w>сообщал</w> о краже в полицию, когда я прибыл в участок.",
                                "de": "Er <w>meldete</w> gerade den Diebstahl bei der Polizei, als ich im Revier ankam.",
                                "zh": "我到达警局时，他正在向警察<w>报告</w>那起盗窃案。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reporting for duty",
                        "reporting a crime"
                    ],
