                                            {
                                                "example_id": "32b38bee-5077-45ac-9a28-eb22f5a76db0",
                                                "sense_id": "3cc8c987-3125-302d-842a-33c0b473c0a1",
                                                "text": "Meine Oma wohnt in Auckland, das liegt in Neuseeland."
                                            },
                                            {
                                                "example_id": "b903f284-8c20-4ec4-a0d7-9c84140f8a9f",
                                                "sense_id": "3cc8c987-3125-302d-842a-33c0b473c0a1",
                                                "text": "„Bei Calhoun und Taylor wird das schwierig; der eine kommt aus Wellington, der andere aus Auckland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
