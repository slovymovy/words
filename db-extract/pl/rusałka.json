                "senses": [
                    {
                        "sense_id": "77a4b087-e0d1-371d-899f-f7b703f004bb",
                        "entry_id": "4df9e568-fe13-3bde-bc74-e9aa292fdceb",
                        "glosses": [
                            "demoniczna istota o kobiecej postaci występująca w mitologii słowiańskiej"
                        ],
                        "tags": [
                            "Slavic"
                        ],
                        "examples": [
                            {
                                "example_id": "30e5bf9c-bfc9-49ed-8b9c-364c964d3e8a",
                                "sense_id": "77a4b087-e0d1-371d-899f-f7b703f004bb",
                                "text": "Danka wyglądała jak rusałka z jeziora Świteź – wysmukła, blada, z tajemniczymi zamglonymi oczami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a9867774-6398-38c8-9b33-e41602640912",
                        "entry_id": "4df9e568-fe13-3bde-bc74-e9aa292fdceb",
                        "glosses": [
                            "nazwa niektórych gatunków motyli z rodziny rusałkowatych, Nymphalidae"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "971d4904-693b-4ef3-9f3c-36647525378f",
                        "source_entry_id": "4df9e568-fe13-3bde-bc74-e9aa292fdceb",
                        "source_sense_id": "77a4b087-e0d1-371d-899f-f7b703f004bb",
