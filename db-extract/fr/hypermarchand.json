                "senses": [
                    {
                        "sense_id": "c002c39b-414c-3e50-a7b2-3133a947e1c5",
                        "entry_id": "2f6b2407-016d-3cfd-b988-f23a8f02158e",
                        "glosses": [
                            "Synonyme de hypermarché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e96e3e87-7167-4aa4-8803-c68e27cb794b",
                                "sense_id": "c002c39b-414c-3e50-a7b2-3133a947e1c5",
                                "text": "Entre la météo qui oscille entre le moyen et le passable et la climatisation que personne, y compris vous, ne sait vraiment utiliser, qui souffle continuellement un air, frais, froid, chaud, pollué, infecté, qui vous accompagne en voiture, dans le train, au bureau, chez le boulanger, le boucher, l’hypermarchand, dans les embouteillages, les queues aux caisses, à la machine à café, à la cantine d’entreprise, tout ça sans le moindre soin ou presque puisque les « climatiseurologues » compétents sont débordés, vous êtes tombé malade."
                            }
                        ]
                    },
                    {
                        "sense_id": "26384ee5-fc09-3a2f-8928-4317d30fb3b3",
                        "entry_id": "2f6b2407-016d-3cfd-b988-f23a8f02158e",
                        "glosses": [
                            "Entreprise gérant des hypermarchés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e825065-357a-4bcf-a61f-992439085b4d",
                                "sense_id": "26384ee5-fc09-3a2f-8928-4317d30fb3b3",
                                "text": "Auchan, Cora, Système U, Carrefour, Casino, Intermarché… Les hypermarchands sont tombés des nues en découvrant qu’ils avaient, eux aussi, vendu des laits proscrits."
                            },
                            {
                                "example_id": "d3c5c4ba-8980-4cb7-a349-7a8636df4e8b",
                                "sense_id": "26384ee5-fc09-3a2f-8928-4317d30fb3b3",
                                "text": "Les hypermarchands ont bien senti le vent tourner. Ils ont compris que pour pouvoir vendre et polluer plus longtemps, il allait falloir superficiellement verdir les emballages."
                            }
                        ]
                    }
