                    {
                        "sense_id": "7b23a136-a611-35c5-bbfe-b51e73782343",
                        "entry_id": "60ea288a-cd86-33b4-a4c5-9d4be1a58f86",
                        "glosses": [
                            "Angehöriger eines indischen Stammes beziehungsweise einer Volksgruppe"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "93a5bbda-c185-4a5e-a42e-abfe45f66b81",
                                "sense_id": "7b23a136-a611-35c5-bbfe-b51e73782343",
                                "text": "„Sikhs, Marathen und Rajputen schärften ihre Waffen für den Kampf gegen Delhi.“"
                            },
                            {
                                "example_id": "e32e255e-142b-41c2-82a2-cef47004ff86",
                                "sense_id": "7b23a136-a611-35c5-bbfe-b51e73782343",
                                "text": "„So gibt es die Kategorie von «indigenen Kasten», die nach tribaler Zugehörigkeit (Paschtunen, Belutschen, Jat, Rajputen) unterschieden werden, dann die berufsmäßige Zuordnung und die sozia-religiöse Status-Kategorie (Sayyed, Qureshi), aber auch die von der Kolonialadministration eingeführte Gruppenunterscheidung von Landwirten und Nichtlandwirten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
