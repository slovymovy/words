                        "sense_id": "a5cc9c0e-abb7-3dac-8790-3058ad43364e",
                        "entry_id": "6abfa918-a8fe-3ee2-821d-94a4517e0e87",
                        "glosses": [
                            "Action pour un interprète assis sur une chaise de marquer un rythme caractéristique et répétitif avec les pieds, le plus souvent pour accompagner une chanson a cappella."
                        ],
                        "tags": [
                            "Folklore"
                        ],
                        "examples": [
                            {
                                "example_id": "dec95396-3a48-499b-9788-96aea0bc9278",
                                "sense_id": "a5cc9c0e-abb7-3dac-8790-3058ad43364e",
                                "text": "Sapins, marrons chauds, ateliers d’harmonica et de podorythmie, soirée de conte, concert de Noël…"
                            },
                            {
                                "example_id": "0b5874f3-2fa0-45bc-9c90-d9de18e0ef58",
                                "sense_id": "a5cc9c0e-abb7-3dac-8790-3058ad43364e",
                                "text": "D’autant que Jean-François Dumas, l’autre larron, est un chanteur homme-orchestre à lui seul, qui pimente le répertoire de banjo, de guitare, d’harmonica, de podorythmie, de guimbarde, de ti-fer, de cajon ainsi que de percussions corporelles et métalliques. Rien de moins !"
                            }
                        ]
                    }
