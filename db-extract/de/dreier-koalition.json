                    {
                        "sense_id": "d14a9a42-874d-3e68-944b-45f4486aedc0",
                        "entry_id": "99d0a1e8-4d91-3156-b2de-d1c2b2830faa",
                        "glosses": [
                            "aus drei Parteien bestehendes politisches Bündnis zur Durchsetzung bestimmter Ziele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8532230c-d4bd-4cf9-8400-8ed53001c17c",
                                "sense_id": "d14a9a42-874d-3e68-944b-45f4486aedc0",
                                "text": "„Inoffiziell war zu hören, dass sich die Dreier-Koalition bereits auf die Schließung der Landestankstellen geeinigt habe.“"
                            },
                            {
                                "example_id": "18691a11-f991-4663-ab3f-70b0e2de0cad",
                                "sense_id": "d14a9a42-874d-3e68-944b-45f4486aedc0",
                                "text": "„Mit ihm wäre sogar eine Dreier-Koalition denkbar, weil er das mittlere Lager mit dem rechten verbinden kann.“"
                            },
                            {
                                "example_id": "751dd261-7a56-435a-9730-7ee3a9d5df64",
                                "sense_id": "d14a9a42-874d-3e68-944b-45f4486aedc0",
                                "text": "„Dennoch sei nicht vollkommen auszuschließen, dass SPD, Linke und Grüne gemeinsam genug Stimmen zusammen bekommen, um mit einer Dreier-Koalition die Regierung übernehmen zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
