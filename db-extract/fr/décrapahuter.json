                "senses": [
                    {
                        "sense_id": "e46e9700-e0fe-3c49-b463-d6973d3f1dba",
                        "entry_id": "808ff1c9-1678-3f3f-8eea-446e5091d1fc",
                        "glosses": [
                            "Arrêter de crapahuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d1f3de-86e3-426e-81db-976c1aa8e3bb",
                                "sense_id": "e46e9700-e0fe-3c49-b463-d6973d3f1dba",
                                "text": "Trop attendu au ravito ? Froid versus folle envie de décrapahuter ? À peine 100 ou 200 m et le genou gauche me lâche."
                            },
                            {
                                "example_id": "39c2d0da-8ea9-4634-8af9-359ab8f31b7a",
                                "sense_id": "e46e9700-e0fe-3c49-b463-d6973d3f1dba",
                                "text": "Ça fait très bizarre de s'autoriser une telle détente brusquement, après une dizaine d'heures de confrontation sans décrapahuter au principe de réalité le plus glabre."
                            },
                            {
                                "example_id": "31f99456-d768-48d0-a924-47f35dd8d16a",
                                "sense_id": "e46e9700-e0fe-3c49-b463-d6973d3f1dba",
                                "text": "Alors on décrapahute lentement, pour savourer."
                            }
                        ]
                    }
