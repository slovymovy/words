                                "target_senses": [
                                    {
                                        "sense_id": "3ff6325e-b68c-32f7-b0ed-dfedbfea7110",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Salirse, quitarse o apartarse del camino, del carril."
                                        ],
                                        "tags": [
                                            "se emplea también como transitivo: descarriar"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f4b00d8-88d1-3a24-afe0-d7054662ae90",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Separarse o perderse del grupo que lo acompañaba a uno, perder su ayuda, apoyo o protección."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1dce519-2c3a-4da9-a053-f630a12dc7b7",
                                                "sense_id": "6f4b00d8-88d1-3a24-afe0-d7054662ae90",
                                                "text": "Si, además, es menester conceder favores a quienes más nos los reclaman, conviene mostrar benevolencia no a los satisfechos, sino a los descarriados."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "965892cc-4bd6-393a-a6f1-c4902656360c",
                                        "entry_id": "3f192adf-d35c-321b-9106-e472035aae60",
                                        "glosses": [
                                            "Salirse del camino recto en el sentido moral o ético; obrar de modo no razonable, correcto o justo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36445d04-837e-4510-b347-a41e472a99d3",
                        "source_entry_id": "8dff9183-f0c7-359d-9077-df2e668e859d",
                        "source_sense_id": "bc923ecb-92d4-3504-92c0-3d2eae7de362",
                        "target_lang_word": "perderse",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perderse",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cc544f-dcee-35f7-9ba5-5b9af2239ac0",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "No hallar su camino."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c23720-4c4b-400e-8b2b-61e9efe383e2",
                                                "sense_id": "c1cc544f-dcee-35f7-9ba5-5b9af2239ac0",
                                                "text": "Nunca había estado en esta ciudad, me he perdido."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9295d60-16c6-3b9f-89e4-360491b2b4a7",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "Abandonar el buen camino, decaer moralmente, caer en el vicio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1467a36c-6b03-49d1-9ad7-4938f8dd6a74",
                                                "sense_id": "c9295d60-16c6-3b9f-89e4-360491b2b4a7",
                                                "text": "El jugador de Dostoievsky, es un personaje que se pierde con el juego."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e7150c72-0eed-3d3a-8a1a-41a643332ad9",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "No saber donde se está."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4812e436-a412-4c6d-8ebb-6054bc6ca8b4",
                                                "sense_id": "e7150c72-0eed-3d3a-8a1a-41a643332ad9",
                                                "text": "¿De qué estábamos hablando? Me he perdido."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e9fa9523-ec30-3a5c-924a-d36da64c2d54",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "Destruirse o desaparecer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f406540-cc27-4815-b66d-c2e904380638",
                                                "sense_id": "e9fa9523-ec30-3a5c-924a-d36da64c2d54",
                                                "text": "Se cortó la luz, y todo lo que estaba haciendo en el computador se ha perdido."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4737fde8-d039-37ec-83f3-db7d8bcb1a52",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "Dicho de una nave, hundirse o naufragar."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "490ffe08-4c2b-30df-a739-42fd5e6ddbda",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "Volverse menos nítido hasta desaparecer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a8a431-4ee0-49e9-933e-a2cb918398b2",
                                                "sense_id": "490ffe08-4c2b-30df-a739-42fd5e6ddbda",
                                                "text": "El barco se perdió en lontananza, solo un ojo experto podía aun divisarlo."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d6f5f107-e076-3ceb-ac95-6a69279f0a76",
                                        "entry_id": "8c2edc67-44af-3448-9dd2-93ed955ebaff",
                                        "glosses": [
                                            "Disminuir paulatinamente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a4fa46-c201-46ec-8b65-cf246b01a535",
                                                "sense_id": "d6f5f107-e076-3ceb-ac95-6a69279f0a76",
                                                "text": "La buena educación se pierde en este vertiginoso mundo moderno."
                                            }
