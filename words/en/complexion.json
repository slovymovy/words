                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in specific scientific or technical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Specifické uspořádání nebo konfigurace komponent v systému.",
                        "ru": "Определенная конфигурация или структура компонентов в системе."
                    },
                    "translations": {
