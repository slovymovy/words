                                        "glosses": [
                                            "The act of producing chirping sounds, or twitters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f63a130-41d9-4992-b4c5-b8b9691d4430",
                                                "sense_id": "eb11c854-d818-3f24-8a43-4ff7c52933f1",
                                                "text": "Once there, he blushingly went through the procedure, having to fold and refold the flag about three times, to the twitterings and gigglings of twelve little girls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
