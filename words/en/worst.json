    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9a22c7b-83d6-323b-995b-ec04399578ba",
                    "sense_definition": "The superlative form of <w>bad</w>: of the poorest quality or lowest standard.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>worst</w> movie I have ever seen in my life.",
                            "target_lang_translations": {
                                "ru": "Это <w>ху́дший</w> фильм, который я когда-либо видел в своей жизни.",
                                "es": "Esta es la <w>peor</w> película que he visto en mi vida.",
                                "zh": "这是我这辈子看过<w>最差的</w>电影。"
                            }
                        },
                        {
                            "text": "He felt that putting oil on the burn was the <w>worst</w> thing to do.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что мазать ожог маслом было <w>ху́дшим</w> решением.",
                                "es": "Él sintió que poner aceite en la quemadura era lo <w>peor</w> que podía hacer.",
                                "zh": "他觉得在烧伤处涂油是<w>最糟糕的</w>做法。"
                            }
                        }
                    ],
                    "antonyms": [
                        "best"
                    ],
                    "common_phrases": [
                        "the worst thing",
                        "worst enemy",
                        "worst possible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходная степень прилагательного \"bad\": самого низкого качества или уровня.",
                        "es": "La forma superlativa de \"malo\": de la calidad más baja o el estándar más pobre.",
                        "zh": "形容词 bad 的最高级：质量最差或标准最低的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ху́дший",
                                "target_lang_sense_clarification": "самый плохой по качеству"
                            },
                            {
                                "target_lang_word": "наиху́дший",
                                "target_lang_sense_clarification": "книжный или официальный стиль"
                            },
                            {
                                "target_lang_word": "са́мый плохо́й",
                                "target_lang_sense_clarification": "общеупотребительное"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "peor",
                                "target_lang_sense_clarification": "el más malo de todos"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最差的",
                                "target_lang_sense_clarification": "质量或水平最低"
                            },
                            {
                                "target_lang_word": "最坏的",
                                "target_lang_sense_clarification": "程度最严重或最糟糕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "939e635d-bd1c-34d5-96c4-f41474c8a559",
                    "sense_definition": "The superlative form of <w>bad</w>: most severe, harmful, or unpleasant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>worst</w> storm of the decade knocked down the power lines.",
                            "target_lang_translations": {
                                "ru": "<w>Сильне́йший</w> шторм десятилетия оборвал линии электропередач.",
                                "es": "La <w>peor</w> tormenta de la década derribó las líneas eléctricas.",
                                "zh": "十年来<w>最严重的</w>风暴吹倒了电线。"
                            }
                        },
                        {
                            "text": "That is the <w>worst</w> news we have received all day.",
                            "target_lang_translations": {
                                "ru": "Это <w>ху́дшие</w> новости, которые мы получили за весь день.",
                                "es": "Esas son las <w>peores</w> noticias que hemos recibido en todo el día.",
                                "zh": "这是我们今天收到的<w>最糟糕的</w>消息。"
                            }
                        }
                    ],
                    "antonyms": [
                        "best"
                    ],
                    "common_phrases": [
                        "worst case scenario",
                        "worst nightmare",
                        "worst fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходная степень прилагательного \"bad\": наиболее суровый, вредный или неприятный.",
                        "es": "La forma superlativa de \"malo\": lo más severo, dañino o desagradable.",
                        "zh": "形容词 bad 的最高级：最严重、最有害或最令人不快的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "са́мый ужа́сный",
                                "target_lang_sense_clarification": "наиболее неприятный или страшный"
                            },
                            {
                                "target_lang_word": "ху́дший",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "сильне́йший",
                                "target_lang_sense_clarification": "о стихийных бедствиях"
                            }
                        ],
                        "es": [
