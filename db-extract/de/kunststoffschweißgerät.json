                ],
                "senses": [
                    {
                        "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                        "entry_id": "8220f44c-a95d-35fb-9d4a-df186aaa07ac",
                        "glosses": [
                            "Apparat, um Kunststoffteile miteinander zu verschweißen, wird beim Kunststoff-Heißluftschweißen verwendet"
                        ],
                        "tags": [
                            "Kunststoffschweißtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "e6f0f964-6ed0-48a5-938a-facc7a76fe7d",
                                "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                                "text": "„Viele manuelle Kunststoffschweißgeräte für das Kunststoff-Heißluftschweißen in unterschiedlichsten Leistungsstärken und Ausführungen runden das Programm ab.“"
                            },
                            {
                                "example_id": "30f7bef8-cfd3-431c-8a79-51c0025c8bab",
                                "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                                "text": "„Mit diesem Kunststoffschweißgerät können thermoplastische Folien, Gewebe und Dichtungsprofile getrennt, verschweißt und versiegelt werden.“"
                            },
                            {
                                "example_id": "4cd73b9f-602d-4c7e-b601-8f6b14d32ed0",
                                "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                                "text": "„Gemäss dem Deutschen Verband für Schweißtechnik (DVS) ist es sehr empfehlenswert, Ihre Kunststoffschweißgeräte einmal pro Jahr überprüfen und warten zu lassen.\"Auszug aus der Richtlinie DVS 2208 T1 Punkt 5.6: Nach Herstellerangabe, jedoch mindestens ein Mal im Jahr, ist eine Überprüfung des Schweißgerätes von einem Sachkundigen mit der dafür notwendigen Erfahrung und dem Nachweis der Qualifizierung durch den jeweiligen Hersteller entsprechend durchzuführen…\"“"
                            },
                            {
                                "example_id": "4222cd24-bd9e-47c1-b9cc-6af02f6107e3",
                                "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                                "text": "„Wir bieten Ihnen eine große Reichweite an Kunststoffschweißgeräten in vielfältiger Ausstattung zum Schweißen von Kunststoffen einer sehr großen Bandbreite.“"
                            },
                            {
                                "example_id": "d4e80ed3-4330-4227-8458-0043bd626be6",
                                "sense_id": "1b034ebe-6461-340f-a338-d9040f8a259e",
                                "text": "„Für das Verlegen der Westec-Fugenbänder wurde ein spezielles Kunststoffschweißgerät entwickelt, welches in der Handhabung kleiner, leichter und schneller ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
