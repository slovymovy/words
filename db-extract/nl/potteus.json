                "senses": [
                    {
                        "sense_id": "f5399569-0ed0-3b2c-8515-975e63a36ca0",
                        "entry_id": "cce30733-0161-3152-b433-d155da976a2a",
                        "glosses": [
                            "lesbisch"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cbac364d-9a19-4c00-ae7d-4fcde730a216",
                                "sense_id": "f5399569-0ed0-3b2c-8515-975e63a36ca0",
                                "text": "Onder opvolger Margriet van der Linden is het maandblad weer het orthodoxe partijorgaan van tuinbroekdragend potteus Nederland, maar mevrouw Dresselhuys geniet na veertig ijzeren dienstjaren van haar welverdiende pensioen. Proost!"
                            },
                            {
                                "example_id": "3b625b71-1273-4767-8aaf-9d5212be4b32",
                                "sense_id": "f5399569-0ed0-3b2c-8515-975e63a36ca0",
                                "text": "'Lesbische cafés zijn aan het uitsterven, maar in de Saarein op de Elandsstraat kun je nog ouderwets 'potteus' poolen en roken tegelijk. Jammer dat er, zoals in de homoscene, geen plekken voor vrouwen zijn om alleen te seksen. Misschien breng ik een moedige entrepreneur op een idee.'"
                            }
                        ]
                    }
