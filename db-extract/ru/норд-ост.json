                                    {
                                        "sense_id": "3dfefd46-33a6-363e-956d-91b1811be222",
                                        "entry_id": "018032b4-1a63-3eba-a4f2-ffaa042c9994",
                                        "glosses": [
                                            "Point de l’horizon qui est entre le nord et l’est. Il correspond à l'azimut 45°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d94b290-e29c-4616-a83d-cebfa1434e4f",
                                                "sense_id": "3dfefd46-33a6-363e-956d-91b1811be222",
                                                "text": "[…] et dans la mer des Antilles je faisais une bonne moyenne de marche poussé par les alizés qui soufflaient frais et réguliers du Nord-Est."
                                            },
                                            {
                                                "example_id": "d81002a2-6dfc-4237-962a-391b4ca35aef",
                                                "sense_id": "3dfefd46-33a6-363e-956d-91b1811be222",
                                                "text": "Du vélo 365 jours dans l’année : à Oulu, ville finlandaise au nord-est du golfe de Botnie, ni les températures négatives, ni les premières neiges n’arrêtent les cyclistes, dans cette commune qui se définit elle-même comme « la capitale du vélo en hiver »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c758130-4bac-3bda-936c-03418d925e83",
                                        "entry_id": "018032b4-1a63-3eba-a4f2-ffaa042c9994",
                                        "glosses": [
                                            "Vent qui souffle entre le nord et l’est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f471d33-9b33-41ed-8996-0a2f8967122b",
                                                "sense_id": "5c758130-4bac-3bda-936c-03418d925e83",
                                                "text": "Le nord-est est extrêmement froid en ce pays."
                                            },
                                            {
                                                "example_id": "7056f5d3-63cc-4ba8-ac7c-8e2af6f3df3c",
                                                "sense_id": "5c758130-4bac-3bda-936c-03418d925e83",
                                                "text": "De temps à autre, il se redressait pour sonder le ciel du regard et flairer le vent. C’était le nord-est qui donnait, et comme il tenait depuis plus de trois jours, on pouvait être assuré que la semaine irait à son terme sans une goutte d’eau."
                                            }
                                        ]
                                    }
                                ]
