                    }
                ],
                "translations": [
                    {
                        "translation_id": "f87913a5-0efa-4d25-b0e1-ecbaff98be0d",
                        "source_entry_id": "c8fec78c-303c-3495-9629-2b93e8f382de",
                        "source_sense_description": "of or pertaining to the axilla",
                        "target_lang_word": "axillaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axillaire",
