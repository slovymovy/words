                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9f919fa-d472-440e-8bab-0332bf92c8e9",
                        "source_entry_id": "c00b1424-91a1-37e4-9f68-51a574cda298",
                        "source_sense_description": "кинуть в сторону или вдаль",
                        "target_lang_word": "rejeter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rejeter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e50b9a6e-62be-3efb-97ad-faf2e5e020bd",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Jeter de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3533d48-26ad-4133-bce0-3e50c0c7ae0f",
                                                "sense_id": "e50b9a6e-62be-3efb-97ad-faf2e5e020bd",
                                                "text": "Vous n’avez pu prendre la balle quand je vous l’ai jetée ; renvoyez-la-moi, je vous la rejetterai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2de402-f4a5-3960-b45c-d771abd487f2",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Repousser ; renvoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf903cd-07d5-4bf3-868a-f149c8034306",
                                                "sense_id": "8a2de402-f4a5-3960-b45c-d771abd487f2",
                                                "text": "Qu’y a-t-il Héloïse ?\nLe prénom familier rompait l’envoûtement, conjurait le péril. Il la rejetait vers l’enfance, niait sa flamboyante puberté."
                                            },
                                            {
                                                "example_id": "c55eff0b-6ddc-41d5-801c-d26a306372c2",
                                                "sense_id": "8a2de402-f4a5-3960-b45c-d771abd487f2",
                                                "text": "La viande trichinée doit être rejetée de la consommation, et, comme il est facile qu'elle échappe à l'examen, il est toujours préférable de manger la viande de porc très cuite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef802ad6-0446-3b79-a809-4fccbda70f9d",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Reporter ; renvoyer à un autre terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b2fd52-ffec-4545-a366-599f6bd25bd3",
                                                "sense_id": "ef802ad6-0446-3b79-a809-4fccbda70f9d",
                                                "text": "[…] ces rites rapprochent aussi l’affatomie des legs et du testament […] Il est frappant qu’il y ait un dessaisissement formaliste effectué inter vivos, mais l’effet complet de l’acte n’est réalisé que post mortem. Il y a cérémonie de dessaisissement et de déclaration de volonté au mallum puis mise en possession immédiate du bénéficiaire […] mais en définitive la mise à disposition complète est rejetée après le décès du disposant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc86535-0091-3526-b68d-e879afd1dde8",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Jeter une chose dans l’endroit d’où on l’avait tirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc38955-3217-4d82-a551-185e38ee8e1d",
                                                "sense_id": "6cc86535-0091-3526-b68d-e879afd1dde8",
                                                "text": "Des bâtiments soulevés par le retournement d’un ice-berg ont été rejetés à la mer brisés comme une noix."
                                            },
                                            {
                                                "example_id": "12c69b5b-5a9d-4f28-88b3-8b9c23bcec55",
                                                "sense_id": "6cc86535-0091-3526-b68d-e879afd1dde8",
                                                "text": "Il mettait un appât au milieu, il descendait le panier au bout d’une ficelle dans un riveau ou d’autres cours d'eau, puis au bout d’un certain temps, il remontait le panier avec plus ou moins bonne fortune, ne gardant que les prises les plus grosses et rejetant les étrilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a149cf-c1fa-3fef-93a8-cb7eeb27856e",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Jeter dehors ; pousser hors de soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bff367a7-14b3-49e2-8fb6-0f8b2ac1a4cb",
                                                "sense_id": "19a149cf-c1fa-3fef-93a8-cb7eeb27856e",
                                                "text": "Il procédait à de profondes aspirations puis rejetait l’air en produisant une espèce de sifflement particulier."
                                            },
                                            {
                                                "example_id": "2aed2477-e74d-494a-8dc9-85b387ff03a7",
                                                "sense_id": "19a149cf-c1fa-3fef-93a8-cb7eeb27856e",
                                                "text": "La mer a rejeté sur ses bords les débris du naufrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9226678a-c6ee-3669-8bd7-2d2ca79ecf54",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Vomir."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc689bc3-e0ad-44d1-bb6a-e5c5a5c3568e",
                                                "sense_id": "9226678a-c6ee-3669-8bd7-2d2ca79ecf54",
                                                "text": "Cet homme a l’estomac malade, il rejette tout ce qu’il prend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6debfd3d-bb25-3d92-b2aa-a4b08d2d9a2a",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Faire des rejets, repousser après avoir été coupé, en parlant d’un arbre ou d’un arbuste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bee21b-0875-4157-8a33-04e841308675",
                                                "sense_id": "6debfd3d-bb25-3d92-b2aa-a4b08d2d9a2a",
                                                "text": "[…] le régime du taillis sous futaie pratiqué en vue de la production de l’écorce et du tan […] a favorisé le Chêne qui, « rejetant » abondamment de souche, a peu à peu éliminé ses concurrents."
                                            },
                                            {
                                                "example_id": "61fb7b5d-4773-4478-857b-957851e0fa70",
                                                "sense_id": "6debfd3d-bb25-3d92-b2aa-a4b08d2d9a2a",
                                                "text": "Depuis qu’on a étêté cet arbre, il a rejeté beaucoup de branches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e651e45-1ccd-3078-8523-9eae6876e696",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Mettre une chose en un endroit, après l’avoir ôtée de celui où elle était."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee9dc78-cc42-4067-99bc-6af07cb2b5f0",
                                                "sense_id": "0e651e45-1ccd-3078-8523-9eae6876e696",
                                                "text": "Il faut rejeter l’eau de ce bassin dans cette cuve, la terre de ce fossé sur cette couche."
                                            },
                                            {
                                                "example_id": "9b5770b1-fec5-4568-9d83-1d1f1f5a09d5",
                                                "sense_id": "0e651e45-1ccd-3078-8523-9eae6876e696",
                                                "text": "Rejetez tous ces détails dans les notes de votre ouvrage."
                                            },
                                            {
                                                "example_id": "1258ee65-7b9c-445e-80ad-d9ff3a9c919d",
                                                "sense_id": "0e651e45-1ccd-3078-8523-9eae6876e696",
                                                "text": "Rejeter les notes à la fin du volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "775df7ef-3cd9-3712-968e-864ac097f1d0",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Faire retomber."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c363ac4-e86e-498c-aa4b-beb96e3c06a5",
                                                "sense_id": "775df7ef-3cd9-3712-968e-864ac097f1d0",
                                                "text": "Rejeter un tort sur quelqu’un."
                                            },
                                            {
                                                "example_id": "d2b4725f-4db0-4d5a-ba2e-31dc1b2d17f7",
                                                "sense_id": "775df7ef-3cd9-3712-968e-864ac097f1d0",
                                                "text": "Il a rejeté sa faute sur cet homme, qui en était bien innocent."
                                            },
                                            {
                                                "example_id": "5a4997fd-0329-426b-b57a-01c4b07f5b6c",
                                                "sense_id": "775df7ef-3cd9-3712-968e-864ac097f1d0",
                                                "text": "On a tout rejeté sur lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Repousser ; ne pas admettre ; ne pas vouloir recevoir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f8009d-53cf-4ff6-b0cc-7344ed7bbc2a",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "La cour de cassation ayant rejeté le pourvoi d’Étienne Baud, de Masméjan , commune de Saint-Étienne-de-Lugdarez (Ardèche), condamné à la peine capitale par arrêt de la cour d'assises de la Lozère du 4 juin dernier, pour crime d'homicide volontaire avec préméditation de guet-à-pens, ce malheureux, […], a été exécuté le 13 sur la place d’Angiran à Mende."
                                            },
                                            {
                                                "example_id": "fb0207bd-8832-4161-a1b5-cc9fd867a119",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "J’ai rejeté bien loin les propositions qu’il m’a faites."
                                            },
                                            {
                                                "example_id": "11a13470-844e-4acc-85c4-307384371e13",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "Il a rejeté les offres qu’on lui faisait."
                                            },
                                            {
                                                "example_id": "33cd4958-a9d6-4df8-9ea4-a66fb11e7a43",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "Sa requête a été rejetée."
                                            },
                                            {
                                                "example_id": "ec63bdd7-a91a-429a-8133-6bbf806677f7",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "La Chambre a rejeté la loi proposée."
                                            },
                                            {
                                                "example_id": "410f0aed-1067-4bc0-86e9-0b04438a0b38",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "On a rejeté son offre, sa proposition, ses prières, sa demande."
                                            },
                                            {
                                                "example_id": "58eed779-ae98-4121-a807-a1ff1b0ead73",
                                                "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                                                "text": "On a rejeté ses avis, ses conseils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "084d13dc-c607-31ff-a037-f78733feab52",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Repousser ou condamner, en parlant de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f91deffc-79d5-4ef8-b7c7-6c41a47c0a84",
                                                "sense_id": "084d13dc-c607-31ff-a037-f78733feab52",
                                                "text": "Les groupes religieux minoritaires ne sont pas forcément rejetés : les adeptes de la religion monophysite, ou les quakers ou les amishs, ne sont l'objet d'aucune suspicion."
                                            },
                                            {
                                                "example_id": "dee7335b-f2e4-461e-bc7b-503b62496f37",
                                                "sense_id": "084d13dc-c607-31ff-a037-f78733feab52",
                                                "text": "Il fut rejeté même de ses plus anciens amis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f5f81c-cfa8-3cb7-b79f-d155e30b49f1",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Écarter ; éloigner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7444a81-ccb5-4487-9b39-dc3635f5beaf",
                                                "sense_id": "98f5f81c-cfa8-3cb7-b79f-d155e30b49f1",
                                                "text": "Il rejetait délibérément toutes préoccupations étrangères à sa neuve situation."
                                            },
                                            {
                                                "example_id": "e99ca828-f856-4d2f-94ae-c2b02f254cec",
                                                "sense_id": "98f5f81c-cfa8-3cb7-b79f-d155e30b49f1",
                                                "text": "Tous les trucs qu’il avait vu pratiquer, toutes les ficelles enregistrées au cours d’une expérience de camionneur déjà longue, des pistes pourries du llano vénézuélien aux pentes escarpées des Andes, il les passa en revue, et un par un les rejeta : ça ne collait pas."
                                            },
                                            {
                                                "example_id": "ebd28440-8a92-4b9a-8953-4e78caa973e2",
                                                "sense_id": "98f5f81c-cfa8-3cb7-b79f-d155e30b49f1",
                                                "text": "Elle m’horripilait avec ses airs supérieurs, […]. Même sa façon de rejeter ses cheveux en arrière lorsqu'elle riait m'énervait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8658b648-e167-3423-a64b-73d0bf92cd57",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Se reculer ; se porter en arrière."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cd3fa4a-9dcb-4188-b1db-26d64aa5c0e3",
                                                "sense_id": "8658b648-e167-3423-a64b-73d0bf92cd57",
                                                "text": "Nous reprenons le raidillon ; il n’est guère plus drôle à descendre qu’à monter : tantôt nous étions courbés en avant, maintenant il faut, pour la descente, se rejeter en arrière…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55dcd69b-0334-386e-808a-320cee96000a",
                                        "entry_id": "0500d0ea-5ad6-39be-8e3e-b903324d3d20",
                                        "glosses": [
                                            "Se reporter, faute de mieux, sur une autre chose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8333b24d-f165-45a0-8ab3-97648b358b64",
                                                "sense_id": "55dcd69b-0334-386e-808a-320cee96000a",
                                                "text": "Ne sachant plus que dire pour sa justification, il se rejeta sur les services qu’il prétendait avoir rendus."
                                            },
                                            {
                                                "example_id": "e2bc998d-e0ce-4653-9d22-c8caddbb5f31",
                                                "sense_id": "55dcd69b-0334-386e-808a-320cee96000a",
                                                "text": "La lecture m’étant interdite, je me rejette sur les auditions de radio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
