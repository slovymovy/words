                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e15063b7-865a-3120-acfc-182dbf0b94f1",
                                        "entry_id": "3af33f83-2bd5-3ebb-b07d-cfbe98129682",
                                        "glosses": [
                                            "die Lehre von den Dämonen, das heißt den bösen Geistern"
                                        ],
                                        "tags": [
                                            "Theologie/Religionswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14da460c-4edb-4362-95a2-3d831bc4324d",
                                                "sense_id": "e15063b7-865a-3120-acfc-182dbf0b94f1",
                                                "text": "„Die Annahme, dass mit der ‚Medizin der Aufklärung‘ die Dämonologie endgültig aus der wissenschaftlichen Medizin verbannt worden sei, ist irrig. Ärzte und Naturforscher der Romantik wandten sich im frühen 19. Jahrhundert erneut den Phänomenen der Dämonologie zu.“"
                                            },
                                            {
                                                "example_id": "81a24db5-447a-4724-a641-5bba585be21a",
                                                "sense_id": "e15063b7-865a-3120-acfc-182dbf0b94f1",
                                                "text": "„Der Wittenberger Prophet wiederum sank mit seiner persönlichen Dämonologie umso tiefer ins Mittelalter zurück, je weiter er seine Kirche aus der katholischen Tradition herauskämpfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
