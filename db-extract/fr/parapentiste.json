                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0679dc06-ae0a-4c4c-ad21-b21b4ee62b5f",
                                "sense_id": "e2210503-9f8b-3fbc-85f2-800999491c29",
                                "text": "Un parapentiste de 66 ans, porté disparu depuis la veille, a été retrouvé mort hier matin sur la commune de Chorges (Hautes-Alpes) après une chute."
                            }
                        ]
                    }
                ],
