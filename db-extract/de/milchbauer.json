                "senses": [
                    {
                        "sense_id": "ab878bae-5cd7-3171-b4e7-1c1bc441e5c5",
                        "entry_id": "a5038fdf-9da8-332b-966e-4d12905a37ef",
                        "glosses": [
                            "Landwirt, der seinen Schwerpunkt auf die Milchwirtschaft gelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668924a1-3133-42b7-82ca-63818475aad2",
                                "sense_id": "ab878bae-5cd7-3171-b4e7-1c1bc441e5c5",
                                "text": "„Rund zwei Monate ist es her, da stoppte der Bundesverband Deutscher Milchviehhalter die Lieferung seines weißen Produkts, weil die Milchbauern höhere Preise für ihre Milch forderten.“"
                            },
                            {
                                "example_id": "418d7385-4c73-4ef2-9ca1-61ddd583937f",
                                "sense_id": "ab878bae-5cd7-3171-b4e7-1c1bc441e5c5",
                                "text": "„Der Milchtransport in die Stadt wurde je nach der Menge zwischen den Milchbauern im Tal aufgeteilt.“"
                            },
                            {
                                "example_id": "99b7c5c1-bf16-4167-bff7-5c79cbe02221",
                                "sense_id": "ab878bae-5cd7-3171-b4e7-1c1bc441e5c5",
                                "text": "„Der Milchbauer geht da mit gutem Beispiel voran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
