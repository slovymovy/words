        "ru-extract.jsonl": [
            {
                "entry_id": "c594e70d-ed70-3639-a0ec-6e18f02bdb0b",
                "word": "простодушно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fee4b377-029d-3cec-9b21-8df5fe5c9bf4",
                        "entry_id": "c594e70d-ed70-3639-a0ec-6e18f02bdb0b",
                        "glosses": [
                            "наречие к простодушный; проявляя простодушие"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "dcaabc6b-eb08-45a5-b15c-ccd79a47c575",
                                "sense_id": "fee4b377-029d-3cec-9b21-8df5fe5c9bf4",
                                "text": "Еврей простодушно возразил, что самый старший в России, а следовательно, и здесь, конечно, царь. «Врёшь, — рассвирепел урядник, — самый старший здесь — я: вот царь запрещает тебе жить здесь, а я говорю, — живи! — и ты живёшь»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c26922df-b595-4aa7-b776-14b38c99f9fe",
                        "source_entry_id": "c594e70d-ed70-3639-a0ec-6e18f02bdb0b",
                        "source_sense_id": "fee4b377-029d-3cec-9b21-8df5fe5c9bf4",
                        "target_lang_word": "innocently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innocently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8d8a63-b943-308f-aee1-3693aea345d9",
                                        "entry_id": "e4b0a776-f7de-3e57-9c52-e2c028af1285",
                                        "glosses": [
                                            "In an innocent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e211e5-042a-4711-b8ae-beb60eb5232b",
                                                "sense_id": "8c8d8a63-b943-308f-aee1-3693aea345d9",
                                                "text": "[M]en lyued ſimplye and innocentlye without inforcement of lawes, without quarellinge Judges and libelles, contente onely to ſatiſfie nature, without further vexation for knowledge of thinges to come."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "376bc313-6bd0-4b99-b0ea-6dff9182b97f",
                        "source_entry_id": "c594e70d-ed70-3639-a0ec-6e18f02bdb0b",
                        "source_sense_id": "fee4b377-029d-3cec-9b21-8df5fe5c9bf4",
                        "target_lang_word": "ingenuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingenuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                        "entry_id": "eee24856-de71-376b-932c-3f79bcef5cbe",
                                        "glosses": [
                                            "In an ingenuous manner; frankly, straightforwardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c17e8b8-00e7-4739-87aa-ead5975cf2d2",
                                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                                "text": "Let us ingenuously confesse that only God and Faith hath told it us: for it is no lesson of Nature, nor comming from our reason."
                                            },
                                            {
                                                "example_id": "37c113f5-9ae9-403f-bcec-5acf5dab10e2",
                                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                                "text": "Yet this in Duty and Modesty I may ingenuously confess, My Royal Husband is oto far seduced, his Ear is too open, his Will too violent, and his Heart too free, to those bewitching Syrens, that make his Errors their Profit and Glory."
                                            },
                                            {
                                                "example_id": "8bc535e2-56de-40e9-bac4-7aefb13e3d2f",
                                                "sense_id": "cd77a87b-c38f-3f43-88df-255c3e7392b6",
                                                "text": "I must ingenuously acknowledge the chief Motive of my leaving her was the Present of a New-Year's-Gift she made me; but whether French or Neopolitan, I leave to the Determination of the Sons of Galen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8d1649a-28fb-4f8a-a1d2-aca66980ab57",
                        "source_entry_id": "c594e70d-ed70-3639-a0ec-6e18f02bdb0b",
                        "source_sense_id": "fee4b377-029d-3cec-9b21-8df5fe5c9bf4",
