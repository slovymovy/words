                    {
                        "translation_id": "ff0fa377-25ab-4891-bfa2-7469cabb43fe",
                        "source_entry_id": "21c83b11-6d15-398f-8ced-965d982691f8",
                        "source_sense_id": "2c2c2573-a3a7-3382-a1e7-83ec5fb305ff",
                        "source_sense_description": "bar to steer a vessel",
                        "target_lang_word": "timon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                        "entry_id": "59bd0142-8a55-3df8-abe9-cec09985e034",
                                        "glosses": [
                                            "Longue pièce de bois fixée en avant d’une voiture, d’une charrue et aux deux côtés de laquelle on attelle les chevaux, les bœufs, ou un véhicule tracteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e658a50-a1c3-4907-9d79-c334056c303f",
                                                "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                                "text": "À ce train était fixé un timon de trente-cinq pieds, le long duquel six bœufs accouplés devaient prendre place."
                                            },
                                            {
                                                "example_id": "574e4f4e-0254-4c28-80d4-a91f30481f0e",
                                                "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                                "text": "Six bœufs […] étaient attelés au timon de chaque chariot avec des harnais de peaux de buffle."
                                            },
                                            {
                                                "example_id": "02147a20-ff2c-42b3-a1cd-ac91f3008594",
                                                "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                                "text": "Il avisa un gros commissionnaire assis sur le timon de sa charrette plate, mordant à belles dents dans une pomme jaune."
                                            },
                                            {
                                                "example_id": "860cde98-ee90-4f9c-9e55-594f631025f8",
                                                "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                                "text": "Elle marcha à côté de lui jusqu’à la remise et, quand il baissa le timon de la charrette à quatre roues, elle se trouvait déjà derrière, les mains sur la traverse du plateau, prête à l’aider de toutes ses forces."
                                            },
                                            {
                                                "example_id": "de09adef-949f-45e5-b65f-0c6d82ae1ec1",
                                                "sense_id": "b0f5f33e-7961-3ec4-8530-fed980c386c3",
                                                "text": "Il est possible, en attelant l’autochargeuse au tracteur avec un timon déportable, d’utiliser simultanément une faucheuse attelée au même tracteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "273d9f12-7a14-3b60-9883-5652fe3b7131",
                                        "entry_id": "59bd0142-8a55-3df8-abe9-cec09985e034",
                                        "glosses": [
                                            "Longue pièce de bois attachée au gouvernail d’un navire et qui sert à le diriger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9421c555-c8c9-374e-8451-44b77d561b99",
                                        "entry_id": "59bd0142-8a55-3df8-abe9-cec09985e034",
                                        "glosses": [
                                            "Gouvernail, direction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4db3734-2e81-4185-923f-a42640a6daac",
                                                "sense_id": "9421c555-c8c9-374e-8451-44b77d561b99",
                                                "text": "Le timon des affaires, de l’État, le gouvernement des affaires, de l’État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96e5407d-309f-3df8-b687-a060f9058f4a",
                                        "entry_id": "59bd0142-8a55-3df8-abe9-cec09985e034",
                                        "glosses": [
                                            "Pénis, verge en érection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ffb2c9-dbd4-449e-b5c1-a33157d30959",
                                                "sense_id": "96e5407d-309f-3df8-b687-a060f9058f4a",
                                                "text": "Thérèse en ce malheur perdit la tramontane :\nClaude la débusqua, s’emparant du timon.\nThérèse, pire qu’un démon,\nTâche à la retirer et se remettre au trône ;\nMais celle-ci n’est pas personne\n à céder un poste si doux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87807188-9b22-4a89-a61e-d4e54863ecee",
                        "source_entry_id": "21c83b11-6d15-398f-8ced-965d982691f8",
                        "source_sense_id": "2c2c2573-a3a7-3382-a1e7-83ec5fb305ff",
                        "source_sense_description": "bar to steer a vessel",
                        "target_lang_word": "fouet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fouet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Cordelette de chanvre ou de cuir, qui est attachée à une baguette, à un bâton, et dont on se sert pour conduire et pour châtier les chevaux et autres animaux, voire, dans certains pays ou à certaines époques, pour punir une personne condamnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e018a5e-7e7a-42f6-b3c5-2b96711c1473",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "Mais c’est faisable, dit La Mole en se préparant comme son compagnon à rouer l’hôtelier de coups de fouet."
                                            },
                                            {
                                                "example_id": "d797e790-f862-4b3f-a22b-66484baa2398",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "Quand j’atteignais un rat d’un bon coup de fouet, le ronge-maille sifflait avec fureur, hérissait tous ses poils et s’élançait avec désespoir contre le fouet lui-même, instrument de sa torture; […]."
                                            },
                                            {
                                                "example_id": "78f6a263-8810-408e-8033-29894476713d",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "L’écho de la forêt voisine répétait nos cris, le mugissement des troupeaux, le tintement des clochettes et le claquement du fouet […]."
                                            },
                                            {
                                                "example_id": "ed6b0c4e-04e3-4067-8f88-4098604cbfc5",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "Il devenait méchant. Il lançait son fouet, comme pour partager en deux une mouche en plein vol et cela finissait par un bruit de pétard qui éclate."
                                            },
                                            {
                                                "example_id": "41a93bac-c094-4a05-820a-5ed14ef2ab3d",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "Ce père, cocher de fiacre à la « face bouffie, apoplectisée d’alcool », qui ne cesse de répéter parce que c’est sa fierté, « toujours bon fouet, bonne mèche »."
                                            },
                                            {
                                                "example_id": "82bf30bc-e26a-4a73-8fcf-187601c3681b",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "[…], Mimile faisait de temps à autre claquer vigoureusement son fouet pour, d’une façon précise et tangible, rappeler au sentiment de la discipline ses tributaires encornés se bousculant dans les ornières boueuses de l’étroit chemin."
                                            },
                                            {
                                                "example_id": "cec9348c-1d07-4fdb-b1d5-105f8cb40b79",
                                                "sense_id": "78e91266-4801-3304-a228-9e17c92cc11e",
                                                "text": "L’avocate iranienne Nasrin Sotoudeh, célèbre militante des droits humains qui purge une peine de prison de cinq ans, a été condamnée à dix années d’emprisonnement supplémentaires et 148 coups de fouet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bca53d7-e47e-3759-bfaf-83cc57ef1517",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Cordelette serrée qui sert de mèche au fouet des cochers et les charretiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4fc0ec9-04fd-3954-bff5-34282961494d",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Coups de verges, de lanières ou de corde à nœuds destinés à châtier un criminel."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f67fdd18-d89a-4ab0-b9ba-4da6545d807a",
                                                "sense_id": "c4fc0ec9-04fd-3954-bff5-34282961494d",
                                                "text": "Être condamné au fouet. Craindre, mériter le fouet. Donner le fouet. Avoir le fouet par les carrefours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293ded65-d703-3660-a726-cf251ef27a76",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Violente secousse ou coup cinglant qui rappelle l’effet douloureux d’un coup de fouet."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "196efd1a-158b-45bc-a7ac-cdb56e082135",
                                                "sense_id": "293ded65-d703-3660-a726-cf251ef27a76",
                                                "text": "Sous le fouet redoublé des rafales d’hiver\nLa tour du vieux Komor dressait sa masse haute,\nTelle qu’un cormoran qui regarde la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e3d8219-071f-3945-a5c8-55d94e7e3599",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Corde ; longueur de mât."
                                        ],
                                        "tags": [
                                            "Voile"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d23ccfa5-cd81-3d02-9dd4-30f2cf0b7b4c",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Lanière de cuir ou de peau d’anguille qui est attachée au bout d’un petit bâton et qui sert aux enfants pour faire tourner un sabot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2d8a2b3-3205-3f67-bec5-b23e4da82ac9",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Bout de l’aile d’un oiseau."
                                        ],
                                        "tags": [
                                            "Naturelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c9851d-2ae5-4af7-b3a9-16c6ecffdf95",
                                                "sense_id": "e2d8a2b3-3205-3f67-bec5-b23e4da82ac9",
                                                "text": "Le fouet de l’aile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66caeb2-ad05-3449-8d3c-769284787094",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Queue du chien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd29e1e5-a347-4c75-8f1b-710971ba7799",
                                                "sense_id": "f66caeb2-ad05-3449-8d3c-769284787094",
                                                "text": "Tous, dressant la queue - le fouet, comme disent les amateurs de chiens - volèrent à la rencontre des visiteurs."
                                            },
                                            {
                                                "example_id": "bd6ca8a2-4062-4e27-9266-c94ec6c8d1f7",
                                                "sense_id": "f66caeb2-ad05-3449-8d3c-769284787094",
                                                "text": "Son labrador, grisé d’excitation, le fouet dressé, lui tenait le bas de sa jupe comme un page de cour l’aurait fait d’une traîne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ac741c-c7c7-3b57-9705-4d6a3c636659",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Ustensile de cuisine, constitué de tiges souples repliées sur elles-mêmes, destiné à mélanger, ou à homogénéiser une préparation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f094a17-dc16-4d41-acfd-1b552ab0e6a6",
                                                "sense_id": "a0ac741c-c7c7-3b57-9705-4d6a3c636659",
                                                "text": "Battre au fouet le jus des citrons pressés et l’huile d’olive."
                                            },
                                            {
                                                "example_id": "0f6c2a5d-8077-47b2-90fa-77da62fa6b77",
                                                "sense_id": "a0ac741c-c7c7-3b57-9705-4d6a3c636659",
                                                "text": "Sur la couverture, la photo d’une jeune femme brune en tee-shirt dans sa cuisine. De la main droite, elle tient un fouet et de l’autre le livre de Ginette Mathiot qu’elle lit avec le sourire de qui est plongé dans un roman désopilant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e845321c-9472-3af1-a28d-a2f1d8358c2e",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Jeune congre (poisson)."
                                        ],
                                        "tags": [
                                            "France : Manche et côte atlantique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46344750-44cf-39dc-87b2-24e94fce298b",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Ouvrier de verrerie qui arrangeait les bouteilles dans le four."
                                        ],
                                        "tags": [
                                            "Histoire des techniques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d683529-23f3-38ed-b563-e25fd5d2fd70",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
