                ],
                "senses": [
                    {
                        "sense_id": "0c26ec1a-21e2-364b-bd25-8baf5661eb5d",
                        "entry_id": "8f9352c3-9b4a-3c07-a7a3-4d0677574499",
                        "glosses": [
                            "Titre que prennent les descendants de Mahomet par sa fille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66e8a38-cba6-4ddb-9fb8-896777843e82",
                                "sense_id": "0c26ec1a-21e2-364b-bd25-8baf5661eb5d",
                                "text": "En cas de doute sur la pertinence de l’exorcisme, mieux vaut alors faire appel aux chérifs détenteurs d’une baraka reconnue pour sa puissance thérapeutique."
                            },
                            {
                                "example_id": "0d868fb0-3752-4dd0-9e5f-47b1633e42f2",
                                "sense_id": "0c26ec1a-21e2-364b-bd25-8baf5661eb5d",
                                "text": "Il se manifesta chez lui un revirement complet correspondant à une crise de mysticisme ou de xénophobie. Il se rapprocha subitement des chorfa et des oulama et passa le plus clair de son temps à lire et commenter les saintes écritures en leur compagnie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b864d15c-5fdf-3f07-8ac8-dd6e495b37be",
                        "entry_id": "8f9352c3-9b4a-3c07-a7a3-4d0677574499",
                        "glosses": [
                            "Prince, chef, chez les Arabes et chez les Maures."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "83268ecd-ee72-4879-9cb9-309e35774962",
                                "sense_id": "b864d15c-5fdf-3f07-8ac8-dd6e495b37be",
                                "text": "L’anarchie marocaine, l’application de lois semi-barbares, la corruption du chérif étaient autant d’arguments pouvant justifier une intervention de l’extérieur."
                            }
                        ]
                    }
                ],
