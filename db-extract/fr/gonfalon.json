                                        "glosses": [
                                            "κομμάτι υφάσματος που κρέμεται από ιστό και φέρει παραστάσεις και εμβλήματα ενός στρατού, κόμματος, συλλόγου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
