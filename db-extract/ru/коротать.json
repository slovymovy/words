                        "examples": [
                            {
                                "example_id": "6d418bf9-17f5-4948-b9f4-63ab3f4391f1",
                                "sense_id": "88df9fa5-0631-3844-984a-08cc3993f54c",
                                "text": "корота́ть вре́мя",
                                "translation": "to while away the time",
                                "english": "to while away the time"
                            },
                            {
                                "example_id": "04458555-4773-4183-904a-ddbd8b8275dd",
                                "sense_id": "88df9fa5-0631-3844-984a-08cc3993f54c",
                                "text": "До са́мого моего́ отъе́зда мы вме́сте слоня́лись о́коло монастыря́ и корота́ли дли́нный жа́ркий день.",
                                "translation": "Up to the time of my departure we strolled together about the Monastery, whiling away the long hot day.",
                                "english": "Up to the time of my departure we strolled together about the Monastery, whiling away the long hot day."
                            }
                        ]
                    }
