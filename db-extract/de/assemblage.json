                    {
                        "translation_id": "f869d14c-c1df-45e1-96ce-1c7b8fa1c4fc",
                        "source_entry_id": "5bd1eec4-abd8-3398-af81-8834d9fc30f3",
                        "source_sense_id": "d8cfc8cd-5c7b-3cbc-b2dd-1ecf3be13f57",
