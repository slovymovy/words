                        "entry_id": "180e6daa-6a22-3f62-8f73-23d970e02de7",
                        "glosses": [
                            "Geldbetrag, der zu Beginn eines Mietverhältnisses dem Vormieter oder dem Eigentümer für die Überlassung von (fest eingebauten) Einrichtungsgegenständen bezahlt wird"
                        ],
                        "tags": [
                            "Mietrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed7e844-90f6-4032-86cb-97cc239e09e7",
                                "sense_id": "3758a603-0ecb-3ba0-b3c4-9383233f9e79",
                                "text": "„In Zeiten von Wohnungsknappheit und Mietpreisbremse beißt so mancher Nachmieter in den sauren Apfel und zahlt für die Hinterlassenschaften eine Ablösesumme.“"
                            }
                        ],
