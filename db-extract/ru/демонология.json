                "senses": [
                    {
                        "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                        "entry_id": "d79b987b-291c-3cc3-9eaf-38fc0b000c98",
                        "glosses": [
                            "учение о демонах в некоторых религиях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0798d77-4ccb-4f17-8fb9-77c87912ddc8",
                                "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                                "text": "Настолько не забыл, что даже в средневековую демонологию Азазел перешёл, изображаемый эмблематически голым дикарём, который тащит за рога, доставшегося ему, жертвенного козла."
                            },
                            {
                                "example_id": "b159f2b8-57c7-42ef-a554-ec4a55206ad4",
                                "sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                                "text": "Но демонология — суть Искусство обращать силу демона против него самого."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5de1eca-c471-44ae-bf2a-effce44941fd",
                        "source_entry_id": "d79b987b-291c-3cc3-9eaf-38fc0b000c98",
                        "source_sense_id": "a011a989-44a7-34f8-8b6d-4091ad23c052",
                        "target_lang_word": "demonology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39bd16f-8395-32c8-ace3-0ee41020dc62",
                                        "entry_id": "735eb0cf-b363-308a-9490-ad24599da030",
                                        "glosses": [
                                            "The study of demons, especially the incantations required to summon and control them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34be19b-3eea-4b9b-b615-292be483bbc1",
                                                "sense_id": "c39bd16f-8395-32c8-ace3-0ee41020dc62",
                                                "text": "But it wasn't all that strange, because any wizard bright enough to survive for five minutes was also bright enough to realize that if there was any power in demonology, then it lay with the demons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
