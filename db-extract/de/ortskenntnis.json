                "senses": [
                    {
                        "sense_id": "14f8895a-7feb-3afa-869d-3ea3de3a5b17",
                        "entry_id": "d3dcbb4f-8a74-3c04-9d38-8b7a5060cc54",
                        "glosses": [
                            "Wissen um die örtlichen Verhältnisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b01a2bab-a162-4a54-b406-ccbff257d574",
                                "sense_id": "14f8895a-7feb-3afa-869d-3ea3de3a5b17",
                                "text": "„Wer auf der Straße liegt, empfängt kaum Nachrichten oder vermag sie nicht zu deuten, weil es an Ortskenntnissen und Karten fehlt.“"
                            },
                            {
                                "example_id": "e4fe3de9-5893-433d-aa13-32d755a8d36b",
                                "sense_id": "14f8895a-7feb-3afa-869d-3ea3de3a5b17",
                                "text": "„Wir waren – ein schöner Beweis meiner Ortskenntnis – bis zum Morgenrot vor der Nase der roten Vorposten in den Sümpfen herumgewatet.“"
                            },
                            {
                                "example_id": "208c7091-9484-40c1-9f3f-c8ec65da92b9",
                                "sense_id": "14f8895a-7feb-3afa-869d-3ea3de3a5b17",
                                "text": "„Wegen ihrer guten Ortskenntnis brauchte sie keinen Fremden zu belästigen, sondern ritt bis zu dem Fenster, hinter dem, wie sie wußte, ihrer Schwester Kammer lag, und pochte mit dem Peitschenschaft gegen die Scheibe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
