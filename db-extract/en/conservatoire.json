                                        "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                        "entry_id": "a66f7e9a-02f6-3ce2-b231-0c4fca882982",
                                        "glosses": [
                                            "een school in het hoger onderwijs waar men zich kan laten opleiden tot professioneel musicus, acteur/actrice of danser(es)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88ff6994-5061-487d-93e8-0a5de27176c0",
                                                "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                                "text": "Hoewel hij een goede leerling was bij de muziekschool in zijn stad, kreeg hij toch geen plaats op het conservatorium."
                                            },
                                            {
                                                "example_id": "dad87faf-48d2-470a-ab8f-cb6701ec5621",
                                                "sense_id": "8ef3bdc4-e87d-379d-8735-11464c242b15",
                                                "text": "Van jongs af aan heeft Frens, zo vertelt hij, altijd graag gezongen en de afgelopen twee jaar groeide dat uit tot het verlangen om naar het conservatorium te gaan en beroepszanger te worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c0d237-06d3-4063-8943-a3e66d5a18a7",
                        "source_entry_id": "f82caa17-073b-322b-9cac-d327b9de92a0",
                        "source_sense_id": "1b59ef85-c05c-33fb-b59e-4ec6f272098d",
                        "source_sense_description": "school or educational institution that teaches music",
                        "target_lang_word": "conservatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4a4942a-f2b4-375a-a108-2006c43b7853",
                                        "entry_id": "420f058d-1287-3d7b-95f7-a5cd57b92b0d",
                                        "glosses": [
                                            "Qui a pour but de conserver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9c0e07-9dc3-4a89-837f-d1ee44a10be9",
                                                "sense_id": "c4a4942a-f2b4-375a-a108-2006c43b7853",
                                                "text": "Leur premier soin, après l’acte conservatoire du prince royal & de la royauté, fut de rappeler au ministère leurs créatures, Servan, Clavière & Rolland."
                                            },
                                            {
                                                "example_id": "8517eb98-e91a-42b1-806a-73b46f5cb9dd",
                                                "sense_id": "c4a4942a-f2b4-375a-a108-2006c43b7853",
                                                "text": "Une opposition, un scellé sont des actes conservatoires."
                                            },
                                            {
                                                "example_id": "62dd0b9b-3e13-4d18-a378-bfe6b70eb39a",
                                                "sense_id": "c4a4942a-f2b4-375a-a108-2006c43b7853",
                                                "text": "Prendre des mesures conservatoires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conservatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83cd229b-845f-38cd-a01f-c9eb7e53abb2",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "Lieu destiné à conserver quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eec8532-eb0e-45ec-99ba-6c03e40176f2",
                                                "sense_id": "83cd229b-845f-38cd-a01f-c9eb7e53abb2",
                                                "text": "Au XIXᵉ siècle, l’atelier est une sorte d’institut de voyous, le conservatoire de la blague, formant l’artiste aux mœurs crapuleuses du cabot et aux haines du socialisme."
                                            },
                                            {
                                                "example_id": "4a298436-dc21-4679-a5b8-790f4a03793c",
                                                "sense_id": "83cd229b-845f-38cd-a01f-c9eb7e53abb2",
                                                "text": "Les professions qui comportent l’usage constant de la parole ou de l’écriture sont des conservatoires tenaces de clichés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c861dfbc-3930-3221-a2d3-717d730e3652",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "Mont de Piété, crédit municipal de la ville de Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2275785b-0294-4488-b4ea-52bf81570c64",
                                                "sense_id": "c861dfbc-3930-3221-a2d3-717d730e3652",
                                                "text": "Il vaut mieux vider un beurrier que d’emplir un conservatoire. On peut dévaliser un banquier, mais ne rien mettre au Mont-de-Piété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bee36f9-39be-36ed-95aa-5fa367949cd4",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "Lieu où conserver les meubles, mobilier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f3fa9c-01dc-4f01-9f98-dd356c1df7dc",
                                                "sense_id": "9bee36f9-39be-36ed-95aa-5fa367949cd4",
                                                "text": "Ne laissez pas la tournante au conservatoire de cambuse ni à la lourde : Ne laissez pas la clef à vos meubles, aux armoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46884241-72c2-37ac-95c5-329d0efffcd9",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "Lieu destiné à conserver des végétaux pendant l’hiver, serre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4e2d91c-f4ae-3e7c-8b7a-55227a4f6b86",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "Établissement public qui assure le maintien des traditions, des savoirs, des savoir-faire et à en promouvoir l’enseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe7fcab6-a0ca-40b8-8dd7-6661bd6d59c5",
                                                "sense_id": "f4e2d91c-f4ae-3e7c-8b7a-55227a4f6b86",
                                                "text": "Il voudrait que fût fondé un conservatoire de danse castiza, pour maintenir les traditions de la pure danse andalouse, inculquer à la jeunesse le mépris des danses de dancing, et bien marquer que l’Espagne revendique officiellement comme une de ses richesses l’art flamenco."
                                            },
                                            {
                                                "example_id": "3a59b498-1daa-40d6-b944-32fdeaa2b2fd",
                                                "sense_id": "f4e2d91c-f4ae-3e7c-8b7a-55227a4f6b86",
                                                "text": "Le Conservatoire des arts et métiers : « dépôt de machines, modèles, outils, dessins, descriptions et livres dans tous les genres d’arts et métiers », où devra être déposé « l’original des instruments et machines inventés ou perfectionnés »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb9639e-2227-3be5-b9e8-29d71ba3f4ac",
                                        "entry_id": "0c9cc05b-e53c-3c37-8878-92dd1b0087b3",
                                        "glosses": [
                                            "École de musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10e86154-ad29-4386-97ed-56eb1903df4c",
                                                "sense_id": "2bb9639e-2227-3be5-b9e8-29d71ba3f4ac",
                                                "text": "Clara Danchin enseigne actuellement au conservatoire de Toulouse, et Katia Darisio à celui de Montélimar."
                                            },
                                            {
                                                "example_id": "4a7095a7-5cb5-43c9-a34c-404d59fe6633",
                                                "sense_id": "2bb9639e-2227-3be5-b9e8-29d71ba3f4ac",
                                                "text": "Vingt-cinq ans, musicienne, premier prix de piano au conservatoire : elle se nommait Cécile Fleury."
                                            },
                                            {
                                                "example_id": "b531ddc5-730e-478a-b3d2-6ec232f31b04",
                                                "sense_id": "2bb9639e-2227-3be5-b9e8-29d71ba3f4ac",
                                                "text": "Il est à peine besoin de dire que le Conservatoire national de Paris, les écoles nationales de province et les Conservatoires municipaux ne sauraient suffire à enseigner, en France, la musique et le chant, d’autant que leur but est très particulier : former des professionnels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb8a4e33-5cf7-4899-9511-f1763b9b5108",
                        "source_entry_id": "f82caa17-073b-322b-9cac-d327b9de92a0",
                        "source_sense_id": "1b59ef85-c05c-33fb-b59e-4ec6f272098d",
                        "source_sense_description": "school or educational institution that teaches music",
                        "target_lang_word": "école de musique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "école de musique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                        "entry_id": "1ec368c5-131e-363a-aac8-59929ce485ad",
                                        "glosses": [
                                            "Institution dispensant un enseignement de la pratique musicale, vocale, instrumentale, mais qui, en général, à la différence des conservatoires, ne s’adresse pas à des élèves sélectionnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e2693d-1adc-44d1-b901-72c0b42e9259",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "Il fonda, en 1862, avec Lamakin, une école de musique gratuite, puis fut nommé, en 1866, chef d’orchestre au théâtre tchèque de Prague, et, l’année suivante, directeur des concerts symphoniques de la Société impériale de musique à Saint-Pétersbourg."
                                            },
                                            {
                                                "example_id": "5cbcd3eb-5308-4cb3-8720-d5a0e7b242ea",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "À Brest, les instruments à vent vont avoir leur école de musique. À la rentrée de septembre 2025, « Zef Musïc » accueillera ses premiers élèves, débutants ou avancés, et recherche, pour l’heure, des salles pour les cours."
                                            },
                                            {
                                                "example_id": "88422e9a-02fb-48de-88c4-cdebd1068571",
                                                "sense_id": "ee90d2be-48ef-3514-8d2e-8188d42e8c10",
                                                "text": "L’atelier jazz de l’école de musique du pays d’Allassac fête ses dix ans d’existence. Depuis cette année, une mutualisation avec l’école de musique d’Objat permet d’étoffer le groupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d05b4a-ce9f-3e34-abcc-dddc29b2c7e2",
                                        "entry_id": "1ec368c5-131e-363a-aac8-59929ce485ad",
                                        "glosses": [
                                            "Établissement public ou privé qui, comme les conservatoires, propose des formations diplômantes dans le domaine de la musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d15a0b1-a3d3-449b-af06-e82b201c8f57",
                                                "sense_id": "84d05b4a-ce9f-3e34-abcc-dddc29b2c7e2",
                                                "text": "Les écoles de musique proposent des formations diplômantes comme la licence en musique, le bachelor en musique ou encore le master en musique. Le corps enseignant est composé de musiciens ou des chanteurs professionnels ainsi que des professeurs de musique diplômés d’Etat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
