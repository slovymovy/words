                    "frequency": "High",
                    "semantic_group_id": "electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The power went out because a <w>fuse</w> blew in the basement."
                        },
                        {
                            "text": "You should check the <w>fuse</w> box if the lights are not working."
                        }
                    ],
                    "common_phrases": [
                        "blown fuse",
                        "fuse box"
                    ]
                },
                {
                    "sense_id": "59e2900b-2b71-398b-afa9-5b4351a8ec5d",
                    "sense_definition": "A person's capacity to remain calm before becoming angry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When talking about being laid off, he has a short <w>fuse</w>."
                        },
                        {
                            "text": "She has a very long <w>fuse</w> and rarely loses her temper."
                        }
                    ],
                    "common_phrases": [
                        "short fuse"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9c81f7a-49d5-3cc9-9c10-1acea179e26e",
                    "sense_definition": "To join or blend two or more things together into a single unit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "joining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies decided to <w>fuse</w> their operations to save money."
                        },
                        {
                            "text": "The artist <w>fused</w> different styles of music to create a unique sound."
                        }
                    ],
                    "synonyms": [
