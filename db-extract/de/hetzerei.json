                        ],
                        "examples": [
                            {
                                "example_id": "04d728aa-3998-4d51-8848-6ce2854910bd",
                                "sense_id": "fb90af08-44a3-318d-a7b4-f7ec563f5687",
                                "text": "„Das Geschenkebesorgen ist zwar eine große Hetzerei, aber als wir Erwachsenen in einem Jahr mal beschlossen haben, uns nichts zu schenken, fehlte auch etwas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "91e5e74b-8b94-3a14-b85f-e17d2fd33cab",
                        "entry_id": "0fb2c9f6-dcd9-3baf-a0ad-c739033705d9",
                        "glosses": [
                            "das ständige Aufwiegeln, das Hervorrufen von Hass gegen jemanden/etwas; auch die entsprechende Handlung, Aussage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6093be7-b442-4db9-911e-b175ee0bc52e",
                                "sense_id": "91e5e74b-8b94-3a14-b85f-e17d2fd33cab",
                                "text": "„Weil Volksverhetzer erfahrungsgemäß immer und immer wieder hetzen und es genießen, wenn darüber berichtet wird, wäre es eigentlich ganz wirksam, wenn über ihre Hetzereien gar nicht berichtet würde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
