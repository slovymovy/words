                        "sense_id": "11aa1fd9-b6fa-3e72-b4d2-8e0cf7dbb83d",
                        "entry_id": "8a32329c-c268-39c6-84b7-9e800c3fbf97",
                        "glosses": [
                            "Sorte de divinité mi-humaine et mi-caprine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e948937e-76f0-40c1-a06f-876dbdcce150",
                                "sense_id": "11aa1fd9-b6fa-3e72-b4d2-8e0cf7dbb83d",
                                "text": "Les satyres et les pyraustes\nLes égypans les feux follets\nEt les destins damnés ou faustes […]"
                            },
                            {
                                "example_id": "4889bb3e-7d33-48d7-8f75-add72d6f1c92",
                                "sense_id": "11aa1fd9-b6fa-3e72-b4d2-8e0cf7dbb83d",
                                "text": "Et moi, dit le chevalier, je fais un simple égypan ; il est vrai que je suis mauvais danseur, et que j’ai la jambe mal faite."
                            },
                            {
                                "example_id": "bba5430b-a76c-4d24-8b2a-877233cc17cc",
                                "sense_id": "11aa1fd9-b6fa-3e72-b4d2-8e0cf7dbb83d",
                                "text": "Il appliqua ses vieilles lèvres d’aegypan sur les bras de ses voisines."
                            }
                        ]
                    }
