                    {
                        "sense_id": "36c3f680-affc-3f98-9a83-7acb73397aa2",
                        "entry_id": "b6abf1c0-236c-3008-be7c-429a15d7749a",
                        "glosses": [
                            "een klein onbeduidend foutje in iets dat verder heel goed is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d39a71-2944-4b46-a8dd-8c42e94424ef",
                                "sense_id": "36c3f680-affc-3f98-9a83-7acb73397aa2",
                                "text": "Maar dat zijn slechts schoonheidsfouten in dit krachtige debuut. Ruskovich laat zien hoe we verhalen vertellen en vervormen, hoe we namen verzinnen voor onze geliefden en hoe we, zelfs in het donkerste van de nacht, de kans krijgen om even iets voor een ander te betekenen."
                            },
                            {
                                "example_id": "9837863b-ae17-41af-923f-39462f0677f3",
                                "sense_id": "36c3f680-affc-3f98-9a83-7acb73397aa2",
                                "text": "De 22-jarige Brabander turnde een stabiele oefening zonder grove schoonheidsfouten. Hij benaderde zijn persoonlijke topscore van de kwalificatie op dinsdag tot op 0.1 punt: 14.333."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d25192-d510-4951-ae7f-eafc039773e1",
                        "source_entry_id": "b6abf1c0-236c-3008-be7c-429a15d7749a",
                        "source_sense_id": "36c3f680-affc-3f98-9a83-7acb73397aa2",
