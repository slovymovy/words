                "senses": [
                    {
                        "sense_id": "bb9cc121-eb9d-3803-9405-a975225a91e3",
                        "entry_id": "f5af1656-64b3-3502-b118-ddfa9f54237d",
                        "glosses": [
                            "Verbindung von Vokalen in Äußerungen/Wörtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb694a56-9340-45d7-90c1-064464837585",
                                "sense_id": "bb9cc121-eb9d-3803-9405-a975225a91e3",
                                "text": "„Letztlich glückte das Unterfangen, erforderte jedoch immer wieder den Blick in die Systemurkunde, die neben dem Zeichenvorrat für Konsonanten und Vokale, für Konsonanten- und Vokalverbindungen sowie für Vor- und Nachsilben auch jede Menge an Kürzeln (Zeichen zur Schreibung von besonders häufigen Wörtern und Wortbestandteilen) enthält.“"
                            },
                            {
                                "example_id": "bc2f5340-bcaf-4ad4-8637-8a0c023001d5",
                                "sense_id": "bb9cc121-eb9d-3803-9405-a975225a91e3",
                                "text": "„Generell ist zwischen Diphthongen und zweisilbigen Vokalverbindungen zu unterscheiden, wobei die Grenze nicht immer klar zu ziehen ist. So ist das au in kaula [ˈkɑu̯lɑ] (Hals) ein Diphthong, in kulaus [ˈkulɑus] (Schluck) aber eine Vokalverbindung.“"
                            },
                            {
                                "example_id": "b91468dc-c2ef-4782-a99d-4d6669b46900",
                                "sense_id": "bb9cc121-eb9d-3803-9405-a975225a91e3",
                                "text": "„Die Vokalverbindung \"-oi\" wird einerseits hell ausgesprochen.“"
                            },
                            {
                                "example_id": "b2cff44c-1e5d-459b-8ad4-042f525c7c56",
                                "sense_id": "bb9cc121-eb9d-3803-9405-a975225a91e3",
                                "text": "„Die Bezeichnung der Vokalverbindung als Zwielaut und ihre Bedeutung als Silbenkern sind hier bereits hervorzuheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
