                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af4d9be-575e-493e-9ff8-2d85a282c07e",
                                "sense_id": "5839900f-694f-382f-83e0-cce9db2117da",
                                "text": "„Dann kommt der Tag, noch lange vor der Sache mit den Augäpfeln, lange vor den Klapperschlangenbissen und den Highschool-Erektionen.“"
                            },
                            {
                                "example_id": "89d19d70-cf90-4c21-9b7b-127a6df24603",
                                "sense_id": "5839900f-694f-382f-83e0-cce9db2117da",
                                "text": "„Er wusste noch, wie sein Vater vor vielen Jahren das jüngste der drei Kinder gefragt hatte: ›So, Purzel, die Chance, dass ein geimpfter Hund einen Klapperschlangenbiss überlebt, liegt bei ...?‹“"
                            },
                            {
                                "example_id": "93ff5f30-a84c-4c01-ab8f-e668d31bcda6",
                                "sense_id": "5839900f-694f-382f-83e0-cce9db2117da",
                                "text": "„›Gott, er hat so viele Klapperschlangenbisse, dass er gesprenkelt ist wie 'n Perlhuhn.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
