                        "examples": [
                            {
                                "example_id": "212620df-4fd1-4b5c-9faa-b6777d171f10",
                                "sense_id": "f1c8a147-ee0b-3e73-90a7-143913367977",
                                "text": "Volgens de aanklager had de adjunct-chef van de veiligheidsdiensten de opdracht gegeven om Khashoggi in het consulaat te ontvoeren en naar Saudi-Arabië te brengen. Hij is inmiddels ontslagen. Op 29 september, drie dagen voor de moord, werd het sein gegeven voor de operatie, zei de openbaar aanklager in een persconferentie."
                            },
                            {
                                "example_id": "105159fa-4d9a-4982-9f1c-b56c1e9a559d",
                                "sense_id": "f1c8a147-ee0b-3e73-90a7-143913367977",
                                "text": "\"Dit is de meest opvallende variant die we tot nu toe zijn tegengekomen\", zei adjunct-chef Jenny Harries van de Britse medische dienst in een verklaring. Volgens haar moet er zo snel mogelijk grondig onderzoek naar worden gedaan. Het Verenigd Koninkrijk kwam gisteren met een inreisverbod voor een aantal Afrikaanse landen, in de hoop de variant buiten de deur te houden."
                            }
                        ]
                    }
