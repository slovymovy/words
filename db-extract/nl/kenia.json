                                            {
                                                "example_id": "70aa8c5d-a5f0-4917-9bef-e7b4d9c6d62b",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "Sie kommt aus Kenia."
                                            },
                                            {
                                                "example_id": "48bae0b9-b413-4f8a-b612-355eebc2ae3e",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "„Es gibt eine Vielzahl an Nationalparks in Kenia, die ein wichtiges Standbein für den Tourismus darstellen.“"
                                            },
                                            {
                                                "example_id": "fd55a92c-cab1-410f-b0b5-9e9a13bf4e03",
                                                "sense_id": "050d6e5d-c074-33b0-b984-f4cc217bad59",
                                                "text": "Nairobi ist die Hauptstadt von Kenia."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kenia",
