                "senses": [
                    {
                        "sense_id": "0e2fe99a-1087-34ad-99eb-ef12819a4c3c",
                        "entry_id": "3e8a003e-8068-387b-9ec9-9b63d2350a58",
                        "glosses": [
                            "Qui aime froufrouter, au sens de flirter, draguer, voire plus si entente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8418cea-e038-4a23-b557-c3d88da0f8c9",
                                "sense_id": "0e2fe99a-1087-34ad-99eb-ef12819a4c3c",
                                "text": "Très froufrouteur est un jeune étudiant qui voudrait éprouver le charme prenant d’une jeune et jolie Parisienne, laquelle se chargera par lettre de lui en faire connaître toute la grâce et la douceur."
                            }
                        ]
                    }
                ],
