                                        "entry_id": "b2560fef-b1b2-3867-8c39-dca29db4a12c",
                                        "glosses": [
                                            "A herb of the mint family, Origanum majorana, having aromatic leaves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
