                "senses": [
                    {
                        "sense_id": "714679dc-c932-32d8-bc11-ae113e427b1c",
                        "entry_id": "163a045a-a74c-3220-9ef0-1a0c60bb0bcb",
                        "glosses": [
                            "Spielfilm, in dem kriegerische Auseinandersetzungen den Hintergrund für die handelnden Personen liefern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294dada9-a996-4d3f-a1cd-0fccf1420c91",
                                "sense_id": "714679dc-c932-32d8-bc11-ae113e427b1c",
                                "text": "„Der in den Vereinigten Staaten sehr erfolgreich gestartete Hollywood-Streifen scheint zunächst ein stumpfer Kriegsfilm zu sein.“"
                            },
                            {
                                "example_id": "c82f9bdb-e5a1-4b45-a33d-ab94ef84168b",
                                "sense_id": "714679dc-c932-32d8-bc11-ae113e427b1c",
                                "text": "„Ich habe viele Kriegsfilme gesehen, das ist wahr. Auch Kriegsbücher gelesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
