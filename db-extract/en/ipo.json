                    {
                        "sense_id": "bfafd478-3722-3c1b-9188-043910ba9d89",
                        "entry_id": "f322e73a-2aee-35d4-aa7e-8eadb9c9d733",
                        "glosses": [
                            "To launch an initial public offering, to go public."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3dc67fc1-0665-49ff-94cc-7dd396ea3699",
                                "sense_id": "bfafd478-3722-3c1b-9188-043910ba9d89",
                                "text": "OnX recently IPO'ed at $7.50 per share, quickly rose to $10.50 per share and then drifted down to about $5 per share."
                            },
                            {
                                "example_id": "fd4a088a-ae5b-4ecb-bedf-4135fe1a4f09",
                                "sense_id": "bfafd478-3722-3c1b-9188-043910ba9d89",
                                "text": "@大学生讲坛 tweets, “A stock market investor asks Hades, ‘What level of hell is this?’ Hades replies, ‘The 18th.’ The investor tears up out of happiness, ‘Finally I've managed to buy at the bottom!’ Hades looks at him with a smile, ‘Don't you know that hell has IPOed and expanded to 36 levels?’”"
                            },
                            {
                                "example_id": "b0bc0544-4141-4eb3-985d-2d07bc0a19b9",
                                "sense_id": "bfafd478-3722-3c1b-9188-043910ba9d89",
                                "text": "The extra scrutiny was a sign of the times, but having never IPO-ed a company before, most of the executive team took it as par for the course."
                            }
                        ]
                    }
