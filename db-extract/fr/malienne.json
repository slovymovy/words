                        "entry_id": "bebd25c6-d679-31e6-977d-f47d8e9837f1",
                        "glosses": [
                            "Féminin singulier de malien."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4849df08-6575-4d24-9f94-dadd0f36a6a1",
                                "sense_id": "84fed972-17ad-35e3-bcd6-0af0a78f2dc2",
                                "text": "Le 5 mai, impasse de la Statue, des éboueurs d’origine malienne trouvèrent parmi les poubelles de ce beau quartier, le corps de Girolamo Venezia, lui-même d’origine italienne."
                            },
                            {
                                "example_id": "bbb01582-d4da-4718-ad13-3e1af73d0489",
                                "sense_id": "84fed972-17ad-35e3-bcd6-0af0a78f2dc2",
                                "text": "– Mais n’oublie pas la police malienne, insista Hydra. Si Pharos a toujours cette notice rouge d’Interpol, la police peut lui mettre la main au collet dans n’importe quelle ville du pays."
                            }
                        ]
                    }
