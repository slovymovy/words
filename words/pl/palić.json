    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e1d7e16-bc49-326e-98b5-ec2543670830",
                    "sense_definition": "Wdychać i wydychać dym z wyrobów tytoniowych (np. papierosów, cygar, fajki), zazwyczaj jako nałóg.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "smoking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek <pali> fajkę każdego wieczoru na tarasie.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка <курит> трубку каждый вечер на террасе.",
                                "en": "My grandfather <smokes> a pipe every evening on the terrace.",
                                "zh": "我爷爷每天晚上都在露台上<抽>烟斗。"
                            }
                        },
                        {
                            "text": "Niestety <palę> papierosy od czasów liceum i trudno mi rzucić.",
                            "target_lang_translations": {
                                "ru": "К сожалению, я <курю> сигареты со времен лицея, и мне трудно бросить.",
                                "en": "Unfortunately, I have been <smoking> cigarettes since high school and find it hard to quit.",
                                "zh": "不幸的是，我从高中起就<抽>烟，很难戒掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kurzyć",
                        "jarać",
                        "kopcić",
                        "ćmić",
                        "fajczyć"
                    ],
                    "common_phrases": [
                        "palić papierosy",
                        "palić jak smok",
                        "palić fajkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вдыхать и выдыхать дым табачных изделий (например, сигарет, сигар, трубки), обычно как вредная привычка.",
                        "en": "To inhale and exhale smoke from tobacco products (such as cigarettes, cigars, or pipes), usually as a habit.",
                        "zh": "吸入并吐出烟草制品（如香烟、雪茄、烟斗）的烟雾；抽烟、吸烟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курить",
                                "target_lang_sense_clarification": "вдыхать дым"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "smoke",
                                "target_lang_sense_clarification": "inhale/exhale tobacco smoke"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽",
                                "target_lang_sense_clarification": "吸烟、抽烟"
                            },
                            {
                                "target_lang_word": "吸",
                                "target_lang_sense_clarification": "吸食烟草"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e68cac7e-11dc-30e1-ae11-0fdaa6dfca26",
                    "sense_definition": "Rozniecać i utrzymywać ogień (np. w piecu, w kominku) w celu ogrzania pomieszczenia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "heating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą codziennie <palimy> w kominku, żeby było przytulnie.",
                            "target_lang_translations": {
                                "ru": "Зимой мы каждый день <топим> камин, чтобы было уютно.",
                                "en": "In the winter we <light a fire> in the fireplace every day to make it cosy.",
                                "zh": "冬天我们每天都会<烧>壁炉，好让屋里暖和舒适。"
                            }
                        },
                        {
                            "text": "Moi sąsiedzi <palą> węglem, co powoduje dużo dymu.",
                            "target_lang_translations": {
                                "ru": "Мои соседи <топят> углем, из-за чего много дыма.",
                                "en": "My neighbours <burn> coal, which produces a lot of smoke.",
                                "zh": "我的邻居们<烧>煤取暖，产生了很多浓烟。"
                            }
                        }
                    ],
                    "antonyms": [
                        "gasić"
                    ],
                    "common_phrases": [
                        "palić w piecu",
                        "palić w kominku",
                        "palić drewnem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разводить и поддерживать огонь (например, в печи, в камине) для обогрева помещения.",
                        "en": "To light and maintain a fire (e.g., in a stove or fireplace) to heat a room.",
                        "zh": "在炉子或壁炉中生火或添柴、烧煤以取暖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топить",
                                "target_lang_sense_clarification": "печь или камин"
                            },
                            {
                                "target_lang_word": "жечь",
                                "target_lang_sense_clarification": "дрова или уголь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "burn",
                                "target_lang_sense_clarification": "use as fuel, e.g. wood or coal"
                            },
                            {
                                "target_lang_word": "heat",
                                "target_lang_sense_clarification": "fuel a fire for heating"
                            },
                            {
                                "target_lang_word": "light a fire",
                                "target_lang_sense_clarification": "kindle a hearth or stove"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烧",
                                "target_lang_sense_clarification": "生火取暖、烧煤或柴"
                            },
                            {
                                "target_lang_word": "生",
                                "target_lang_sense_clarification": "生火、生炉子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9adc7168-d9fe-3f70-8cad-cdd6e168b178",
                    "sense_definition": "Zużywać paliwo (o pojazdach i silnikach spalinowych).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fuel_consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten stary samochód <pali> bardzo dużo benzyny w mieście.",
                            "target_lang_translations": {
                                "ru": "Эта старая машина <расходует> очень много бензина в городе.",
                                "en": "This old car <burns> a lot of petrol in the city.",
                                "zh": "这辆旧车在市区里非常<耗>油。"
                            }
                        },
                        {
                            "text": "Ile <pali> twoje nowe auto na autostradzie?",
                            "target_lang_translations": {
                                "ru": "Сколько <потребляет> твоя новая машина на трассе?",
                                "en": "How much fuel does your new car <consume> on the highway?",
                                "zh": "你的新车在高速公路上<耗>多少油？"
                            }
                        }
                    ],
                    "synonyms": [
