                                        "glosses": [
                                            "Any observable characteristic of an organism, such as its morphological, developmental, biochemical or physiological properties, or its behavior."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "phenotype",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f39c0137-b2cb-3437-aebd-f317a6357eae",
                                        "entry_id": "16a6bc25-6045-385f-b2ce-77370f859ad9",
                                        "glosses": [
                                            "To evaluate or classify based on phenotype."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b897f1-5e92-49e0-9bb0-01d3f5320dc3",
                                                "sense_id": "f39c0137-b2cb-3437-aebd-f317a6357eae",
                                                "text": "One hundred and sixty-two unrelated healthy Japanese subjects were genotyped with the polymerase chain reaction amplification method and 35 subjects were phenotyped with dextromethorphan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89a7ad4e-bc3d-4b6a-ac0c-fab160dd89c9",
                        "source_entry_id": "15c7d027-d4d3-385c-b65d-727169c93023",
                        "source_sense_id": "591a6971-88ae-34b4-81e2-95fca1a18a8c",
                        "source_sense_description": "das äußere, sichtbare Erscheinungsbild eines Lebewesens, das durch die Erbanlagen und Umwelteinflüsse ausgeprägt wird",
                        "target_lang_word": "phénotype",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phénotype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "253e25a6-3c51-3e91-82df-194b62fa3393",
                                        "entry_id": "2c8ec178-1b13-3a86-9fe6-672256a2adad",
                                        "glosses": [
                                            "État d’un caractère observable chez un organisme vivant (anatomique, morphologique, moléculaire, physiologique, ou éthologique)."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13796912-7724-4803-95ae-6d4ca245099e",
                                                "sense_id": "253e25a6-3c51-3e91-82df-194b62fa3393",
                                                "text": "Ainsi, la résistance aux aminosides qui ne concernait, jusqu’en 1975, que la streptomycine et la kanamycine a été modifiée par l’apparition cette même année de deux nouveaux phénotypes de résistance plasmidique."
                                            },
                                            {
                                                "example_id": "e2f17212-6e01-4266-8acc-9325ad9d15a2",
                                                "sense_id": "253e25a6-3c51-3e91-82df-194b62fa3393",
                                                "text": "Le phénotype d’un individu est le résultat de l’action conjointe, exprimée, de l’ensemble de ses gènes et de l’environnement. Les gènes qui contribuent au phénotype constituent ensemble le génotype de l’animal."
                                            },
                                            {
                                                "example_id": "09119d9f-1258-4fd3-b88e-4933e9d45db6",
                                                "sense_id": "253e25a6-3c51-3e91-82df-194b62fa3393",
                                                "text": "Les phénotypes exprimés par les caractères récessifs ne s’embarrassent pas de frontières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phénotype",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3695666c-4409-3fae-8a31-1b35b7cb2ce7",
