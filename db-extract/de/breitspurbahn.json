                "senses": [
                    {
                        "sense_id": "3ef8a097-58cd-3401-bf8a-c0390fe0ba9f",
                        "entry_id": "324dd312-799c-3c77-b85e-54f7131e2566",
                        "glosses": [
                            "Bahn, deren Spurweite breiter als die Normalspur ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da84b8e-2a9e-4a02-9edd-eb8b2eff722b",
                                "sense_id": "3ef8a097-58cd-3401-bf8a-c0390fe0ba9f",
                                "text": "„Eine Breitspurbahn vom Elbufer zum Ostseehafen Lübeck-Travemünde und eine Eisenbahnfähre zum sowjetischen Klaipeda, dem früheren Memel, sollen Hamburg mit der längsten Bahnstrecke der Welt verknüpfen […].“"
                            },
                            {
                                "example_id": "81ed9525-8672-4cc8-94bc-768dce6d33bd",
                                "sense_id": "3ef8a097-58cd-3401-bf8a-c0390fe0ba9f",
                                "text": "„Verkehrsminister Norbert Hofer macht Druck bei der umstrittenen Verlängerung der Breitspurbahn von Košice in der Ostslowakei nach Österreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
