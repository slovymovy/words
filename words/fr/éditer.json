    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "795e4572-8e2b-3029-88c0-dd7d74c1ce1e",
                    "sense_definition": "Publier et commercialiser un ouvrage, un texte ou tout autre support imprimé ou numérique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette maison a choisi d'<w>éditer</w> son premier roman dès le mois prochain."
                        },
                        {
                            "text": "Ils <w>éditent</w> une revue littéraire trimestrielle très appréciée des lecteurs."
                        }
                    ],
                    "synonyms": [
                        "publier"
                    ],
                    "common_phrases": [
                        "éditer un livre",
                        "éditer un roman"
                    ]
                },
                {
                    "sense_id": "b83875fe-5546-3204-9c78-653e95d4ecb3",
                    "sense_definition": "Modifier ou mettre en forme un document, un texte ou un fichier à l'aide d'un outil informatique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "traitement_de_texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez <w>éditer</w> ce document avant de l'envoyer à votre directeur."
                        },
                        {
                            "text": "Ce logiciel permet d'<w>éditer</w> facilement vos photos sur un ordinateur."
                        }
                    ],
                    "synonyms": [
                        "modifier"
                    ],
                    "common_phrases": [
                        "éditer un document",
                        "éditer un fichier"
                    ]
                },
                {
                    "sense_id": "cd96d6b4-ed1c-362b-9232-7dc23385b0b5",
                    "sense_definition": "Reproduire une œuvre d'art, particulièrement une sculpture ou une gravure, en un certain nombre d'exemplaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fonderie a reçu l'autorisation d'<w>éditer</w> plusieurs bronzes de cet artiste."
                        },
                        {
                            "text": "La galerie d'art <w>édite</w> une série limitée d'estampes signées par le sculpteur."
                        }
                    ],
                    "synonyms": [
                        "reproduire"
                    ]
                }
            ]
        }
    ]
