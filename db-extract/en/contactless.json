                "senses": [
                    {
                        "sense_id": "5cf6dfe6-ba35-37b8-ba22-3e10c6411d9f",
                        "entry_id": "f2d0cdfc-c5c4-35a1-85db-f83739514a8b",
                        "glosses": [
                            "A technology for paying for goods etc. while physically present at the point of interaction but without the need for physical contact."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "09253366-28b9-43f7-bef1-36fd84b14d71",
                                "sense_id": "5cf6dfe6-ba35-37b8-ba22-3e10c6411d9f",
                                "text": "The motivation for using contactless is clear: it is most popular for people in a rush (58 per cent), people with a queue behind them (30 per cent) and those in busy places with lots of people (26 per cent)."
                            },
                            {
                                "example_id": "f0148a20-04c0-4cdf-8506-5bab4e537148",
                                "sense_id": "5cf6dfe6-ba35-37b8-ba22-3e10c6411d9f",
                                "text": "Even before the coronavirus struck, contactless was starting to become our way of life, our active choice."
                            }
                        ]
                    }
