            "senses": [
                {
                    "sense_id": "a4155922-57f6-3ac1-9181-12027334b693",
                    "sense_definition": "van minder belang of gewicht in vergelijking met iets anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit project is de snelheid van <w>ondergeschikt</w> belang vergeleken met de kwaliteit.",
                            "target_lang_translations": {
                                "en": "In this project, speed is of <w>secondary</w> importance compared to quality."
                            }
                        },
                        {
                            "text": "De details zijn in deze fase nog <w>ondergeschikt</w> aan het algemene plan.",
                            "target_lang_translations": {
                                "en": "At this stage, the details are still <w>subordinate</w> to the general plan."
                            }
                        }
                    ],
                    "antonyms": [
                        "hoofdzakelijk",
                        "belangrijk"
                    ],
                    "common_phrases": [
                        "ondergeschikt belang",
                        "ondergeschikte rol"
                    ],
                    "target_lang_definitions": {
