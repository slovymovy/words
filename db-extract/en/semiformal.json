                        "glosses": [
                            "A social event in which one is expected to dress in semiformal wear."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "987df23a-2609-43c3-af98-9ae56862eacf",
                                "sense_id": "0a7da4a3-b2c0-381d-a7f4-f2973c752d35",
                                "text": "Bright-colored flyers decorated battered lockers, telling everyone to join the debate team, try out for the school play, and not to miss the fall semiformal this Friday. I wondered what a \"semiformal\" consisted of at a public school, not that I'd bothered to ask anyone."
                            }
                        ]
                    }
