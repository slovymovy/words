                "senses": [
                    {
                        "sense_id": "cc0ccc5a-bb68-345f-bc06-198b24e97a00",
                        "entry_id": "9ece42e6-27b6-32ef-b79c-047efe78fd07",
                        "glosses": [
                            "Saborder à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f039700-6dfc-460a-9077-6a60485cee5b",
                                "sense_id": "cc0ccc5a-bb68-345f-bc06-198b24e97a00",
                                "text": "Mais bon je n'ai pas l'intenton de tout resaborder pour vérifier wink."
                            },
                            {
                                "example_id": "572ede9b-eeba-483b-ad06-027f4008ac23",
                                "sense_id": "cc0ccc5a-bb68-345f-bc06-198b24e97a00",
                                "text": "Pendant les années 80, le style s'est diversifié avec Trouble (surtout les 2 premiers albums), Cathedral (Forest of Equilibrium), Candlemass, The Obsessed que Wino a sabordé pour rejoindre Saint Vitus avant de reformer le groupe avec d'autres zicos (dont Greg Rogers, Guy Pinhas et Scott Reeder qui ont tous fait partie à un moment ou à un autre de Goatsnake) pour finalement resaborder le groupe et formé Spirit Caravan. — (faute de frappe corrigée : finallement en finalement)"
                            }
                        ]
                    }
