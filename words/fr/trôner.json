                    "sense_definition": "Siéger sur un trône en qualité de souverain ou de dignitaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi <w>trône</w> au milieu de la grande salle lors des cérémonies officielles."
                        },
                        {
                            "text": "Après son sacre, la souveraine a <w>trôné</w> devant tous les nobles du royaume."
                        }
                    ],
                    "synonyms": [
