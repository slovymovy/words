                {
                    "sense_id": "291d7bd1-ca96-31c4-93d3-de2c0e73223d",
                    "sense_definition": "The unsmoked waste end of a cigarette.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remnant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sidewalk outside the bar was littered with cigarette <w>butts</w>.",
                            "target_lang_translations": {
                                "ru": "Тротуар у бара был усеян сигаретными <w>окурками</w>.",
                                "es": "La acera fuera del bar estaba llena de <w>colillas</w> de cigarrillo.",
                                "zh": "酒吧外的路面上到处都是<w>烟头</w>。"
                            }
                        },
                        {
                            "text": "He crushed the <w>butt</w> of his cigarette in the overflowing ashtray.",
                            "target_lang_translations": {
                                "ru": "Он раздавил <w>окурок</w> своей сигареты в переполненной пепельнице.",
                                "es": "Aplastó la <w>colilla</w> de su cigarrillo en el cenicero rebosante.",
                                "zh": "他把<w>烟头</w>按灭在已经装满的烟灰缸里。"
                            }
                        }
                    ],
                    "common_phrases": [
