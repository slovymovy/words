                "senses": [
                    {
                        "sense_id": "bfd27d97-3115-35f5-9cf4-2b15068bd27c",
                        "entry_id": "29b53be3-122f-34bf-a283-365403ec7deb",
                        "glosses": [
                            "Celui qui est outrecuidant."
                        ],
                        "tags": [
                            "Par substantivation"
                        ],
                        "examples": [
                            {
                                "example_id": "ef935fd8-07ac-4815-92c7-a1715199d5ff",
                                "sense_id": "bfd27d97-3115-35f5-9cf4-2b15068bd27c",
                                "text": "Vous êtes un outrecuidant ! hurla-t-il en abattant son poing sur la table."
                            },
                            {
                                "example_id": "4d2d4ca6-8e87-499b-a461-ada3c8e26576",
                                "sense_id": "bfd27d97-3115-35f5-9cf4-2b15068bd27c",
                                "text": "C'est le sort que notre pays de France ménage souvent à ses bons serviteurs. Il est tout heureux de les trouver pour réparer les sottises des outrecuidants. Mais il a un faible pour les évaltonnés glorieux, peu de goût pour les sages."
                            }
                        ]
                    }
