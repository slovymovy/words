                        "sense_id": "22a4dd92-d794-330e-9810-ed1eff785e1a",
                        "entry_id": "878960d1-b5b7-3082-842a-a58f25052986",
                        "glosses": [
                            "Scrofulariacée (ou Calceolariacées selon la classification phylogénétique) du genre Calceolaria dont la fleur de certaines espèces affecte la forme d’un soulier ou d’un sabot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd60c269-0776-41b6-8643-2d1fa79a3745",
                                "sense_id": "22a4dd92-d794-330e-9810-ed1eff785e1a",
                                "text": "L’escalier de pierre s’évase doucement jusqu’à la cour sablée, chaque degré supporte des géraniums enflammés, des calcoléaires aux petits ventres tigrés, des rosiers nains qu’on a forcés à trop fleurir."
                            },
                            {
                                "example_id": "5dfb938c-f02c-406c-8dfd-78c1aa9092f6",
                                "sense_id": "22a4dd92-d794-330e-9810-ed1eff785e1a",
                                "text": "D’autres plantes surprennent le regard, comme la calcéolaire d’un jaune uni ou le magnifique rudbeckia hirta 'Prairie Sun', avec ses fleurs au cœur vert."
                            }
                        ]
                    }
