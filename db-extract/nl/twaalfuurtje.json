                                        "sense_id": "d94ded60-0623-397d-999e-ba086e899962",
                                        "entry_id": "227ee030-8d19-373e-b516-a98a490319a9",
                                        "glosses": [
                                            "A light meal usually eaten around midday, notably when not as main meal of the day."
                                        ],
