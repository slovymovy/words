                "senses": [
                    {
                        "sense_id": "78566ecf-c4a0-38b4-9bc4-b18764c88dbc",
                        "entry_id": "3a32fc01-4b1f-3856-8068-bfb93863f1c0",
                        "glosses": [
                            "op handen en voeten voortbewegend, laag bij de grond voortbewegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6264a5f4-33dd-483c-91ab-1f06209d1068",
                                "sense_id": "78566ecf-c4a0-38b4-9bc4-b18764c88dbc",
                                "text": "Het object langs de Berkel is de Eibergse editie van het project Tussen de Coulissen. Het kunstwerk zelf oogt al bijzonder. Helemaal onderin blijft ruimte voor kruipende dieren, waarbij de ontwerpers speciaal aan egels hebben gedacht."
                            },
                            {
                                "example_id": "12a9d230-1c9e-43a1-9473-0a5ce94b7d5b",
                                "sense_id": "78566ecf-c4a0-38b4-9bc4-b18764c88dbc",
                                "text": "Gerard Joling heeft uitgebreid zijn klassieke keuken en een ongenode kruipende gast in zijn Aalsmeerse stulpje gefilmd."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac5aeef8-9cb1-3eb6-acbb-54b58a903f26",
                        "entry_id": "3a32fc01-4b1f-3856-8068-bfb93863f1c0",
                        "glosses": [
                            "heel langzaam voortgaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7be62ab-41ad-4ea3-a91f-6c79503a592e",
                                "sense_id": "ac5aeef8-9cb1-3eb6-acbb-54b58a903f26",
                                "text": "De Belgische sportzender zond vandaagde loting live uit op Facebook. Filmpjes van kruipende slakken waren het gevolg."
                            }
                        ]
                    },
                    {
                        "sense_id": "81401971-81b3-3d57-9605-605b4626ae6a",
                        "entry_id": "3a32fc01-4b1f-3856-8068-bfb93863f1c0",
                        "glosses": [
                            "heel onderdanig"
                        ],
                        "tags": [],
                        "examples": [
                            {
