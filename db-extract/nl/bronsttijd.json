                        "examples": [
                            {
                                "example_id": "f45e88ae-63ac-44af-8bda-a5c59e4fc7ae",
                                "sense_id": "a03bf4fa-0943-3b04-a98b-8aeb882c704e",
                                "text": "1836, H. R. Schinz, Volledige natuurlijke historie der zoogdieren, J. F. Schleijer (1845), vol. 1, 396.\nDe bok laat daarbij een kort, driemaal herhaald en ver klinkend geblaf hooren, hetwelk hem enkel dan, of ook in den bronsttijd eigen is.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "bee268fc-039d-4ecc-9a47-49ef8e069201",
                                "sense_id": "a03bf4fa-0943-3b04-a98b-8aeb882c704e",
                                "text": "Het begin van den bronststijd richt zich naar het weer en de hoeveelheid voedsel, waarover de haas gedurende den winter kan beschikken."
                            },
                            {
                                "example_id": "9719d62e-54e6-4e36-8e66-eaa6414d8dc3",
                                "sense_id": "a03bf4fa-0943-3b04-a98b-8aeb882c704e",
                                "text": "Ellenberger (92) verdeelt den bronsttijd in bronstperioden. Elk dezer laatste omvat de rijping en uitstooting van het ei en alle verschijnselen, die hiermede in het geheele organisme gepaard gaan."
                            },
                            {
                                "example_id": "96e55173-adcd-4e4e-a6f5-c71ff2945584",
                                "sense_id": "a03bf4fa-0943-3b04-a98b-8aeb882c704e",
                                "text": "Dat rollen in de modder is een teken dat de bronsttijd nadert, in welke periode de stilte alleen doorbroken wordt door de bronstroep, het burlen der herten, en het terrein uitsluitend toegankelijk is voor de leden van het Groene gilde."
                            }
                        ]
                    }
