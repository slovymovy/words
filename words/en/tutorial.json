                                "target_lang_sense_clarification": "documento explicativo"
                            },
                            {
                                "target_lang_word": "instrucciones",
                                "target_lang_sense_clarification": "pasos a seguir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac27509-0d4d-3e0b-af47-f9dc05ad20b3",
                    "sense_definition": "An interactive class or session taught by a tutor to a small group of students or an individual, typically at a university.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor holds a weekly <w>tutorial</w> to discuss the lecture topics in more detail.",
                            "target_lang_translations": {
                                "ru": "Профессор проводит еженедельный <w>семинар</w>, чтобы обсудить темы лекций более подробно.",
                                "zh": "教授每周都会举行一次<w>研讨课</w>，更详细地讨论讲座主题。",
                                "es": "El profesor organiza una <w>tutoría</w> semanal para discutir los temas de la clase con más detalle."
                            }
                        },
                        {
                            "text": "She missed her <w>tutorial</w> this morning because she overslept.",
                            "target_lang_translations": {
                                "ru": "Она пропустила <w>консультацию</w> сегодня утром, потому что проспала.",
                                "zh": "她今天早上因为睡过头错过了<w>辅导课</w>。",
                                "es": "Ella faltó a su <w>tutoría</w> esta mañana porque se quedó dormida."
                            }
                        }
                    ],
                    "synonyms": [
                        "seminar",
                        "class",
                        "lesson"
                    ],
                    "common_phrases": [
                        "attend a tutorial",
                        "group tutorial",
                        "weekly tutorial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интерактивное занятие или сессия, проводимая преподавателем для небольшой группы студентов или индивидуально, обычно в университете.",
                        "zh": "由导师为小组学生或个人进行的互动式教学课程，通常在大学环境中。",
                        "es": "Clase o sesión interactiva impartida por un tutor a un grupo pequeño de estudiantes o a un individuo, generalmente en un entorno universitario."
                    },
                    "translations": {
