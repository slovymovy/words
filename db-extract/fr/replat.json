                ],
                "senses": [
                    {
                        "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                        "entry_id": "3b593dbf-a6a9-36a3-a3c2-91533a59d195",
                        "glosses": [
                            "Petit plateau horizontal dans les montagnes ou sur une voie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3664f6-f718-4437-9a1d-9a9512f73ad3",
                                "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                                "text": "On n’y rencontre l’aubaine d’aucun replat consolateur."
                            },
                            {
                                "example_id": "4dd64cdc-0532-4796-aa13-520ebb8e9dde",
                                "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                                "text": "Sur l'escarpement voisin de la verticale, croissent dans les fentes ou les petits replats ménagés par la cassure géométrique de la roche : […]."
                            },
                            {
                                "example_id": "bd9b6dea-c7a8-44c7-80ab-ff3e338ce907",
                                "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                                "text": "Maintenant nous sommes au pied des abrupts de la « Nonne », arrêtés sur un replat du glacier."
                            },
                            {
                                "example_id": "db71d046-9c1b-41ba-9777-7364cbebf2eb",
                                "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                                "text": "Elle avait cru entendre des bûcherons, elle s’était engagée trop avant et sans doute allait-elle se perdre, tomber sur un replat où elle tournerait en rond pour finir par descendre une autre pente."
                            },
                            {
                                "example_id": "f2080a86-68ba-4853-b346-fb87831510c1",
                                "sense_id": "fe4af353-af3d-3b51-bbd0-6fe6fb71f141",
                                "text": "À une douzaine de kilomètres en aval de Combloux, […], on note un replat où affleurent quelques blocs erratiques granitiques."
                            }
                        ]
                    }
                ],
