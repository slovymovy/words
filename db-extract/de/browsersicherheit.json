                "senses": [
                    {
                        "sense_id": "33a74bd1-a29d-35ea-ac17-be957d868f3f",
                        "entry_id": "79fe1564-5981-30d3-b928-5b1cec944df2",
                        "glosses": [
                            "Ergebnis aller Maßnahmen, die dem Schutz der Benutzer von Webbrowsern dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d820845-bc3d-4d4e-9b27-3357740d62ae",
                                "sense_id": "33a74bd1-a29d-35ea-ac17-be957d868f3f",
                                "text": "„Mit offensichtlich unberechtigten Patentansprüchen bei der Browsersicherheit hat eine britische Computerfirma für Verwirrung gesorgt.“"
                            },
                            {
                                "example_id": "c2128045-3912-47bb-a637-1fc081f8a83e",
                                "sense_id": "33a74bd1-a29d-35ea-ac17-be957d868f3f",
                                "text": "„Auch bei Microsoft tut sich etwas in Sachen Browsersicherheit.“"
                            },
                            {
                                "example_id": "1629fe17-a902-4f39-99ce-a4901b0be3a3",
                                "sense_id": "33a74bd1-a29d-35ea-ac17-be957d868f3f",
                                "text": "„Außerdem sind Updates für Ihren Safari-Browser enthalten, die für Ihre Browsersicherheit von entscheidender Bedeutung sein können.“"
                            },
                            {
                                "example_id": "0eb08e8f-dfdd-4651-a3e8-c8bed4cb239d",
                                "sense_id": "33a74bd1-a29d-35ea-ac17-be957d868f3f",
                                "text": "„Grech will mit seinem Proof-of-Concept-Code vor allem den sorglosen Mitmenschen zeigen, dass das Thema Browsersicherheit nicht unterschätzt werden darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
