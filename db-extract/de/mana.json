                ],
                "senses": [
                    {
                        "sense_id": "839a4a7a-6df2-3d57-acb2-a5e52ac7ea17",
                        "entry_id": "57fb468d-36b4-3685-9d94-c8559d923de4",
                        "glosses": [
                            "mysteriöse Kraft, die in Menschen, Tieren oder Gegenständen Übernatürliches hervorbringt"
                        ],
                        "tags": [
                            "Ozeanien"
                        ],
                        "examples": [
                            {
                                "example_id": "945cf92a-8ae2-42ae-a08e-f68343aafa75",
                                "sense_id": "839a4a7a-6df2-3d57-acb2-a5e52ac7ea17",
                                "text": "„Mana ist die Wurzel der Dualität von Leben und Tod, die viele Merkmale umfaßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cd30a7f5-307a-30e1-b576-b3e524af8af6",
                        "entry_id": "57fb468d-36b4-3685-9d94-c8559d923de4",
                        "glosses": [
                            "Ressource für Zaubersprüche in Rollenspielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5ecf6a-bd3b-40d7-a377-b3b844e36a8d",
                                "sense_id": "cd30a7f5-307a-30e1-b576-b3e524af8af6",
                                "text": "„Für jede außergewöhnliche Aktion verbraucht dein Held Mana, beispielsweise beim Zaubern, wenn er bestimmte Heilfertigkeiten einsetzt, für besondere Angriffe oder für viele Fertigkeiten vom Typ Verbesserung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c1a7fcd-df26-4e37-ad7e-16c9898fb28d",
                        "source_entry_id": "57fb468d-36b4-3685-9d94-c8559d923de4",
                        "source_sense_id": "839a4a7a-6df2-3d57-acb2-a5e52ac7ea17",
                        "source_sense_description": "eine mysteriöse Kraft, die in Menschen, Tieren oder Gegenständen Übernatürliches hervorbringt",
                        "target_lang_word": "mana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                        "entry_id": "1d7e93d2-8029-3422-8e11-8c16b434e180",
                                        "glosses": [
                                            "Power, prestige; specifically, a form of supernatural energy in Polynesian religion that inheres in things or people."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "213544a5-3d85-4878-923b-ed2ce1c41074",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "They further required that a certain number of the old Chiefs should be liberally pensioned by the Government, and placed upon a footing of equality with European gentlemen of independent means, in consideration of their resigning their \"mana\" as Chiefs in favor of the new system […]"
                                            },
                                            {
                                                "example_id": "85a29d72-975a-4999-8448-914d2e33cf89",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "The human tribe partakes of the mana or life-force of the animal, and is strengthened […]"
                                            },
                                            {
                                                "example_id": "6189c6e1-8534-491e-8fda-6496c09cd327",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "But in popular estimation their essential virtue derived from the personal mana of the sovereign."
                                            },
                                            {
                                                "example_id": "45f57f21-1d87-4ab7-abf7-1e603be711df",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "It can be seen, therefore, that mana is a nonvisible changing measure; it can remain static, increase, or decrease, depending on the actions or inaction of the recipient, and it can be enhanced or diminished."
                                            },
                                            {
                                                "example_id": "a5c6162b-a0ce-4aed-a29a-d6e380d40135",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "Among the Maori sovereignty was the result of mana—power based on hereditary rank and personal achievement. Manas could coexist and overlap, as they did in the medieval times in Europe."
                                            },
                                            {
                                                "example_id": "b01bace3-f3a0-4446-b7de-6d1ecef0514a",
                                                "sense_id": "fb007329-7d0d-3d94-91ce-a2df6103dc4b",
                                                "text": "On a number of occasions in recent years apologies have been offered to Māori because of past offences to their mana and invasions of their rights as tangata whenua."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                        "entry_id": "1d7e93d2-8029-3422-8e11-8c16b434e180",
                                        "glosses": [
                                            "Magical energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eb2c68b-0a75-4c9e-948e-3a942e6303cf",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "Mana is the name we give to the power behind magic."
                                            },
                                            {
                                                "example_id": "ba498512-9888-4a5a-a84b-d04c6a1e5cdc",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "However, all such magik requires the mages [sic] own \"MANA\" or \"internal power\" to make it work. Without the mana, a spoken spell is just so much gibberish."
                                            },
                                            {
                                                "example_id": "67dae029-37cf-4e29-ba50-6a75ce4bce2f",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "Lands generate mana, which is required to cast spells."
                                            },
                                            {
                                                "example_id": "725e9df7-b2ae-4071-9b4c-17b11341b4ed",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "[…] Teleporting from an open room where there were a dozen black orcs firing bows […] landed me, low on mana and hitpoints, in a room full of gnome mages who instantly summoned four umber hulks and a xorn!"
                                            },
                                            {
                                                "example_id": "ce5a9291-810f-4956-826f-8917b4da1c11",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "Mana often grows in exponential proportion to population size, so as the population increases the player acquires vastly greater powers—a progression that god games share with spellcaster characters in role-playing games."
                                            },
                                            {
                                                "example_id": "40b48815-a7cd-42df-b352-4d76ad9a9129",
                                                "sense_id": "347f1029-c825-3d6c-93d5-b869e8cd0e4a",
                                                "text": "The player starts with no mana crystals, and gets one on their first turn, meaning an 8-mana card cannot be played until turn 8."
                                            }
                                        ]
                                    }
                                ]
                            },
