                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cedc76dd-601b-41c6-ba4c-09304f8ef078",
                                "sense_id": "2e95b535-059d-39c9-8855-dff5f7f49dac",
                                "text": "Les usagers appartenant à une communauté s’entre-référencent, c’est-à-dire qu’ils établissent des liens hypertextuels qui renvoient d’un blog vers l’autre."
                            },
                            {
                                "example_id": "f9ebefaf-cb12-4ef8-acde-f65e8fd5311e",
                                "sense_id": "2e95b535-059d-39c9-8855-dff5f7f49dac",
                                "text": "Depuis Twitter et l’apparition des premiers Hashtag ^([sic : mots-clics]) on ne cesse de s’entre-référencer."
                            },
                            {
                                "example_id": "df2ef728-38be-423d-bf73-aa752037b17b",
                                "sense_id": "2e95b535-059d-39c9-8855-dff5f7f49dac",
                                "text": "Maintenant je pense abandonner cette démarche et me contenter avec des simples tables non reliées et avec des clés étrangères pour s’entre-référencer dans une fgdb."
                            },
                            {
                                "example_id": "9bc27674-0eb3-4866-8aec-7570bc461ec6",
                                "sense_id": "2e95b535-059d-39c9-8855-dff5f7f49dac",
                                "text": "Et puis si on continue de toujours s’entre-référencer ce cher FC et moi, on va perdre de la crédibilité et faire hurler à la collusion !"
                            }
                        ]
                    }
