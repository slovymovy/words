                                    }
                                ]
                            },
                            {
                                "target_word": "disguise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "646c4fda-c144-3d63-978e-0ae4579b7c74",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To change the appearance of (a person or thing) so as to hide, or to assume an identity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27ac2fa4-00b6-488d-accb-1f3b5a4d6037",
                                                "sense_id": "646c4fda-c144-3d63-978e-0ae4579b7c74",
                                                "text": "Spies often disguise themselves."
                                            },
                                            {
                                                "example_id": "555ea72d-c326-48b8-acb4-3bd8fd0dd7c4",
                                                "sense_id": "646c4fda-c144-3d63-978e-0ae4579b7c74",
                                                "text": "Bunyan was forced to disguise himself as a wagoner."
                                            },
                                            {
                                                "example_id": "f36e850b-ac29-4603-8470-fd0490920c43",
                                                "sense_id": "646c4fda-c144-3d63-978e-0ae4579b7c74",
                                                "text": "The official Central News agency said a Nationalist patrol boat Dec. 28 captured six Communist spies disguised as fishermen as they approached within 1,000 yards of the Paichuan in a motorized fishing craft. They were taken to Matsu for questioning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d126617-91d9-3ff6-8c4f-9112ace6d3ea",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To transform or disfigure, to change the appearance of in general."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d2b3930-b66d-3fa4-abb6-5602f5086c02",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To avoid giving away or revealing (something secret); to hide by a false appearance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba22259-7a1c-4312-87b3-3e8f1a1b3bc3",
                                                "sense_id": "4d2b3930-b66d-3fa4-abb6-5602f5086c02",
                                                "text": "He disguised his true intentions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "950435a1-8448-3e8b-998b-dc4911c61460",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To dress in newfangled or showy clothing, to deck out in new fashions."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c82acf0-cea2-3a57-8bdc-92b268101043",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To dissemble, to talk or act falsely while concealing one’s thoughts."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c4060cc-91b3-3e11-adf7-ed9416e93712",
                                        "entry_id": "6185e2d2-49c3-3c2e-8ac1-0eda26f2ea88",
                                        "glosses": [
                                            "To affect or change by liquor; to intoxicate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438b9feb-20d4-4d31-be2d-9559cdc6d875",
                                                "sense_id": "5c4060cc-91b3-3e11-adf7-ed9416e93712",
                                                "text": "But my lord was angry, and being disguised with liquor too, he would not let him go till they played more; and play they did, and the luck still went the same way; […]"
                                            },
                                            {
                                                "example_id": "4696df17-7879-4670-ba2f-69e442e5e3b5",
                                                "sense_id": "5c4060cc-91b3-3e11-adf7-ed9416e93712",
                                                "text": "I have just left the right worshipful, and his myrmidons, about a sneaker or five gallons; the whole magistracy was pretty well disguised before I gave them the slip."
                                            }
                                        ]
                                    }
                                ]
                            }
