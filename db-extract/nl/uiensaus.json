                        "sense_id": "0d93c455-5a23-341e-89a3-89839fb835e1",
                        "entry_id": "afcf7fee-b05e-30a3-87f5-b0e5c4b82c4a",
                        "glosses": [
                            "een saus gemaakt van uien en met de smaak van uien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bb634e-f184-4d9a-83ee-a7d7c3cdcc7d",
                                "sense_id": "0d93c455-5a23-341e-89a3-89839fb835e1",
                                "text": "De uiensaus in het recept vraagt wel wat tijd omdat de uien heel lang fruiten. Daardoor worden ze zoet en zacht. En geurig. Maar dat duurt dus wel even."
                            },
                            {
                                "example_id": "d90148f0-3d12-4168-afa6-c5e27376924e",
                                "sense_id": "0d93c455-5a23-341e-89a3-89839fb835e1",
                                "text": "De uien moeten in net genoeg vocht en olijfolie smoren zodat ze mooi karamelbruin worden en niet aanbranden. Ik heb een zeer krachtige runderbouillon gebruikt, maar u kunt er kippenbouillon of zelfs water voor in de plaats gebruiken. Na 3 uur stoven u zult u ongeveer 5 deciliter uiensaus overhouden."
                            }
                        ]
                    }
