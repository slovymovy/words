                                        "sense_id": "fe97772b-2e1b-337a-ba8c-f53e74c7c069",
                                        "entry_id": "a7539e09-505b-3607-825d-49b4b6deba57",
                                        "glosses": [
                                            "The obsolete name for a psychotic disorder, now called delusional disorder, often (in one of six subtypes) characterized by delusions of persecution and a perceived threat against the individual affected with the disorder, and often associated with false accusations and a general mistrust of others"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fac27e70-0ed1-3326-85f0-92c0c990733d",
                                        "entry_id": "a7539e09-505b-3607-825d-49b4b6deba57",
                                        "glosses": [
                                            "Extreme, irrational distrust of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebe20540-0515-4da0-8464-adae6f3c1189",
                        "source_entry_id": "0528ea07-6f54-31a1-8f8b-b6f85e39fe48",
                        "source_sense_id": "68424915-29b4-3877-bd4b-9e6d1a159e14",
                        "target_lang_word": "paranoia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paranoia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c83444c6-7de2-32c6-b9f4-a4902b439a48",
                                        "entry_id": "d36785b8-849f-32a5-94bb-f8cff99d64ea",
                                        "glosses": [
                                            "Transtorno mental que se caracteriza por la fijación de una idea o conjunto de ideas en la mente."
