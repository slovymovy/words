                                ]
                            },
                            {
                                "target_word": "서리",
                                "target_lang_code": "ko",
                                "target_senses": [
                                    {
                                        "sense_id": "41f23d80-8bab-34b3-bd96-4b65a2d20f5e",
                                        "entry_id": "6bfb2cd6-bc2c-3ae0-a2ae-193fdada3b92",
                                        "glosses": [
                                            "대기의 온도가 낮을 때 공기 중에 있는 습기가 지표면이나 물체 표면에 물방울을 이루어 얼어붙어서 생긴 결정체."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0e648c-e3e7-4fec-900e-72655653d85b",
                                                "sense_id": "41f23d80-8bab-34b3-bd96-4b65a2d20f5e",
                                                "text": "기온이 어는점 아래로 내려가 대기 중의 수증기가 지면이나 주변 물체에 승화해서 부착된 얼음 결정."
                                            },
                                            {
                                                "example_id": "1544e097-28e5-44bc-9780-af70220683f9",
                                                "sense_id": "41f23d80-8bab-34b3-bd96-4b65a2d20f5e",
                                                "text": "서리가 생길 때에는 식물의 잎 등의 세포 조직은 동결이나 저온에 의하여 손상되어 농작물이 많은 피해를 받는다."
                                            },
                                            {
                                                "example_id": "581ed5cf-b82c-40a1-80e3-8f8408b13c23",
                                                "sense_id": "41f23d80-8bab-34b3-bd96-4b65a2d20f5e",
                                                "text": "늦가을에 처음 내리는 묽은 서리를 무서리라 하고, 늦가을에 아주 되게 내리는 서리를 된서리라고 한다."
                                            },
                                            {
                                                "example_id": "6ab358f2-7fe3-4011-b759-5322fde9a562",
                                                "sense_id": "41f23d80-8bab-34b3-bd96-4b65a2d20f5e",
                                                "text": "야간에 구름 한 점 없이 청명하여 별이 뚜렷이 관찰될 때 발생하기 쉽다. 그러나 자정기온이 크게 내려가도 바람이 불어 엷은 구름이 나타나면 서리는 발생하기 어렵다."
                                            }
                                        ]
                                    }
                                ]
                            },
