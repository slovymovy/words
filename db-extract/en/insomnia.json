                    {
                        "translation_id": "b5a0f2b2-af18-4144-8ecc-d8c1ee4207e5",
                        "source_entry_id": "ac76e84a-0eb8-3338-8bcf-f1737f286a25",
                        "source_sense_description": "sleeping disorder",
                        "target_lang_word": "Schlaflosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlaflosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                        "entry_id": "00aee2d4-34d2-3aa9-a5d9-8a94b72cb6b7",
                                        "glosses": [
                                            "das Fehlen von Schlaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a671be-bbbf-479a-ae68-5354b188743d",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "Die chronische Schlaflosigkeit kostet viel Substanz."
                                            },
                                            {
                                                "example_id": "740834e6-1590-4494-be58-247f2984fa92",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "„Zu den auf diese Weise behandelten Störungen gehören die Epilepsie, zentrale Schmerzzustände, Schlaflosigkeit, Angstzustände und Depressionen, unkontrollierbare Gewalttätigkeit und einige Abarten der Schizophrenie.“"
                                            },
                                            {
                                                "example_id": "3396d53a-f6fd-4c0e-870b-e17cf571070b",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "„Schlaflosigkeit machte ihr die Nächte zur Qual, Schwermut verdunkelte ihre Tage.“"
                                            },
                                            {
                                                "example_id": "0e25913a-3bf8-4686-a9e3-5bd6652c97ae",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "„Ich leide an Schlaflosigkeit.“"
                                            },
                                            {
                                                "example_id": "f4252afe-a3ec-4836-b0d9-c85cbd24377a",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "„Immer wenn Sabina sich in der Schlaflosigkeit verloren fühlte, nahm sie den verworrenen Faden ihres Lebens auf, vom Anfang an, um die Stelle zu finden, an der sich ihre Wege verwirrt hatten.“"
                                            },
                                            {
                                                "example_id": "008224d7-c37c-4cff-a05c-f289db2334e6",
                                                "sense_id": "974e98a9-aa51-3e12-ae0b-8dd0ab6fdcf9",
                                                "text": "„Mit dem Abstand der Schlaflosigkeit kannst du nichts berühren, und nichts kann dich berühren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
