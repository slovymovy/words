{
    "word_family": [
        "kettledrum",
        "kettling",
        "teakettle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "875baa32-dca9-304f-8a5b-ea1d7ec2e9d5",
                    "sense_definition": "A vessel or appliance used to boil water for the preparation of hot beverages and other foodstuffs.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stick the <w>kettle</w> on and we'll have a nice cup of tea.",
                            "target_lang_translations": {
                                "ru": "Поставь <w>чайник</w>, и мы выпьем по чашечке чая."
                            }
                        },
                        {
                            "text": "She filled the electric <w>kettle</w> with water to make some coffee.",
                            "target_lang_translations": {
                                "ru": "Она наполнила электрический <w>чайник</w> водой, чтобы приготовить кофе."
                            }
                        }
                    ],
                    "synonyms": [
                        "teakettle"
                    ],
                    "common_phrases": [
                        "put the kettle on",
                        "electric kettle",
                        "boil the kettle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд или прибор, используемый для кипячения воды для приготовления горячих напитков и других продуктов питания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайник",
                                "target_lang_sense_clarification": "для кипячения воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e352562-4e36-3944-92b5-cf58746b15cf",
                    "sense_definition": "A vessel for boiling a liquid or cooking food, usually metal and equipped with a lid.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To cook pasta, you first need to put the <w>kettle</w> on.",
                            "target_lang_translations": {
                                "ru": "Чтобы сварить макароны, сначала нужно поставить <w>котёл</w> на огонь."
                            }
                        },
                        {
                            "text": "There's a hot <w>kettle</w> of soup on the stove.",
                            "target_lang_translations": {
                                "ru": "На плите стоит горячий <w>котелок</w> супа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fish kettle",
                        "copper kettle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд для кипячения жидкости или приготовления пищи, обычно металлический и снабженный крышкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "котёл",
                                "target_lang_sense_clarification": "большой сосуд для варки"
                            },
                            {
                                "target_lang_word": "котелок",
                                "target_lang_sense_clarification": "небольшой походный или кухонный сосуд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f6bda40-1434-3bf8-ae6a-2706fe7533e9",
                    "sense_definition": "The quantity held by a kettle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We drank a whole <w>kettle</w> of tea during the long meeting.",
                            "target_lang_translations": {
                                "ru": "За время долгого совещания мы выпили целый <w>чайник</w> чая."
                            }
                        },
                        {
                            "text": "He poured a <w>kettle</w> of boiling water into the large basin.",
                            "target_lang_translations": {
                                "ru": "Он вылил <w>чайник</w> кипятка в большой таз."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество содержимого, вмещающееся в чайник или котёл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайник",
                                "target_lang_sense_clarification": "как мера объема"
                            },
                            {
                                "target_lang_word": "котёл",
                                "target_lang_sense_clarification": "как мера объема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a199ee8-5a72-322f-89e3-e44f240e5184",
                    "sense_definition": "A group of raptors riding a thermal, especially when migrating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>kettle</w> of hawks circling high above the valley.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>«котёл»</w> ястребов, кружащих высоко над долиной."
                            }
                        },
                        {
                            "text": "<w>Kettles</w> can consist of thousands of birds migrating together.",
                            "target_lang_translations": {
                                "ru": "Такие <w>скопления</w> могут состоять из тысяч птиц, мигрирующих вместе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kettle of hawks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа хищных птиц, парящих в восходящем потоке воздуха, особенно во время миграции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«котёл»",
                                "target_lang_sense_clarification": "скопление парящих птиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35378027-e709-3131-a9c4-99248119c2fa",
                    "sense_definition": "A kettle hole, sometimes any pothole.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retreating glacier left behind a deep <w>kettle</w> in the landscape.",
                            "target_lang_translations": {
                                "ru": "Отступающий ледник оставил после себя глубокий ледниковый <w>котёл</w> в ландшафте."
                            }
                        },
                        {
                            "text": "The lake formed within a large <w>kettle</w> created during the last ice age.",
                            "target_lang_translations": {
                                "ru": "Озеро образовалось в огромной <w>котловине</w>, возникшей во время последнего ледникового периода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kettle hole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ледниковый котел; глубокая впадина в ландшафте, образовавшаяся при таянии глыбы льда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледниковый котёл",
                                "target_lang_sense_clarification": "геологическое образование"
                            },
                            {
                                "target_lang_word": "котловина",
                                "target_lang_sense_clarification": "впадина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e14fd7db-1e77-3990-bb0c-8c3fb8937cc8",
                    "sense_definition": "An instance of kettling; a group of protesters or rioters confined in a limited area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police maintained the <w>kettle</w> for several hours until the crowd dispersed.",
                            "target_lang_translations": {
                                "ru": "Полиция удерживала <w>оцепление</w> в течение нескольких часов, пока толпа не разошлась."
                            }
                        },
                        {
                            "text": "Many protesters were trapped inside the <w>kettle</w> without access to water.",
                            "target_lang_translations": {
                                "ru": "Многие протестующие оказались заперты внутри <w>«котла»</w> без доступа к воде."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай кеттлинга; группа протестующих, заблокированная полицией на ограниченном пространстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оцепление",
                                "target_lang_sense_clarification": "блокирование толпы"
                            },
                            {
                                "target_lang_word": "«котёл»",
                                "target_lang_sense_clarification": "тактика блокирования протестующих"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bf312f6-3b24-3fae-99c2-eb010468fd74",
                    "sense_definition": "To contain demonstrators in a confined area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "containment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police decided to <w>kettle</w> the protesters to prevent them from reaching the square.",
                            "target_lang_translations": {
                                "ru": "Полиция решила <w>взять в кольцо</w> протестующих, чтобы не дать им дойти до площади."
                            }
                        },
                        {
                            "text": "They were <w>kettled</w> by bright orange police mesh for several hours.",
                            "target_lang_translations": {
                                "ru": "Их несколько часов <w>удерживали в оцеплении</w> с помощью ярко-оранжевой полицейской сетки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать демонстрантов в ограниченной зоне (тактика полиции)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать в оцепление",
                                "target_lang_sense_clarification": "блокировать протестующих"
                            },
                            {
                                "target_lang_word": "зажимать в «котёл»",
                                "target_lang_sense_clarification": "окружать толпу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7796b3a-f55d-3430-bb6a-6c946b2250cb",
                    "sense_definition": "Of a boiler: to make a whistling sound like the boiling of a kettle, indicative of various types of fault.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old central heating boiler has started to <w>kettle</w> loudly every morning.",
                            "target_lang_translations": {
                                "ru": "Старый котел центрального отопления начал громко <w>шуметь</w> каждое утро."
                            }
                        },
                        {
                            "text": "If your boiler begins to <w>kettle</w>, it might be due to limescale buildup.",
                            "target_lang_translations": {
                                "ru": "Если ваш бойлер начинает <w>свистеть</w>, это может быть связано с накоплением накипи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage regarding boilers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О бойлере: издавать свистящий звук, похожий на кипение чайника, что указывает на неисправность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шуметь",
                                "target_lang_sense_clarification": "о неисправном бойлере"
                            },
                            {
                                "target_lang_word": "свистеть",
                                "target_lang_sense_clarification": "издавать звук кипения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b91ec707-b1fb-38a3-bd82-661df880acd9",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Kettle</w> has lived in this neighborhood for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кеттл</w> живет в этом районе уже более тридцати лет."
                            }
                        },
                        {
                            "text": "The author of the book is a woman named Alice <w>Kettle</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — женщина по имени Элис <w>Кеттл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кеттл",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "569c721f-f222-3176-8c6e-5638ae2bc6e6",
                    "sense_definition": "A synonym of <w>Kingskettle</w>, a village in Fife, Scotland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He was born and raised in the small village of <w>Kettle</w>.",
                            "target_lang_translations": {
                                "ru": "Он родился и вырос в небольшой деревне <w>Кеттл</w>."
                            }
                        },
                        {
                            "text": "The train stops at <w>Kettle</w> before continuing to the next town.",
                            "target_lang_translations": {
                                "ru": "Поезд останавливается в <w>Кеттле</w>, прежде чем продолжить путь в следующий город."
                            }
                        }
                    ],
                    "synonyms": [
                        "Kingskettle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Синоним Кингскеттла, деревни в Файфе, Шотландия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кеттл",
                                "target_lang_sense_clarification": "название деревни"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}