                "senses": [
                    {
                        "sense_id": "bab84b0d-89ff-3814-8f59-cd8c09854e1d",
                        "entry_id": "82afd47b-fff2-30c2-886d-8bb0bf4c34f1",
                        "glosses": [
                            "Reichstagswahl vom 30. Juli 1878, in deren Vorfeld zwei Attentate auf Kaiser Wilhelm I. ^(→ WP) verübt wurden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1cf54a77-ed4f-4996-a5ac-5c9333c5259d",
                                "sense_id": "bab84b0d-89ff-3814-8f59-cd8c09854e1d",
                                "text": "„Die folgenden Reichstagswahlen, genannt Attentatswahlen, brachten den reaktionären Parteien solche Gewinne, daß die Sozialistengesetze erlassen werden konnten, …“"
                            },
                            {
                                "example_id": "b63aa119-7560-40ba-8486-cb2502f8eb03",
                                "sense_id": "bab84b0d-89ff-3814-8f59-cd8c09854e1d",
                                "text": "„Es ging vielmehr eine Wandlung im Bürgertum selbst vor sich. Bei den Attentatswahlen hatte sich seine nach rechts tendierende Stimmung aus der Furcht vor der Sozialdemokratie bereits bemerkbar gemacht.“"
                            },
                            {
                                "example_id": "c743de43-1740-4a07-8ffa-d20cdbb73381",
                                "sense_id": "bab84b0d-89ff-3814-8f59-cd8c09854e1d",
                                "text": "„Als seit dem Frühsommer 1878 unter Ausnutzung des Schocks, den die beiden Attentate auf den deutschen Kaiser vom 11. Mai und 2. Juni 1878 ausgelöst hatten, die Partei der Arbeiterklasse als ›Partei der Kaisermörder‹ diffamiert wurde und die herrschenden Kreise – auch zur Vorbereitung der sogenannten Attentatswahlen – einen antisozialistischen Hetzfeldzug inszenierten, erklärte sich die internationale Arbeiterbewegung ohne Zögern mit den verleumdeten und verfolgten deutschen Sozialdemokraten solidarisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
