                    {
                        "form_id": "a91f8a2d-0b86-4bdf-86c9-1c88dd05c7aa",
                        "entry_id": "1a4de054-d30d-39c8-aa1a-24624b31c3c6",
                        "tags": [
                            "Plus rare"
                        ],
                        "form": "felouka"
                    },
                    {
                        "form_id": "bca9e033-d79a-415a-a375-5ae62a6c7c2d",
                        "entry_id": "1a4de054-d30d-39c8-aa1a-24624b31c3c6",
                        "tags": [
                            "Plus rare"
                        ],
                        "form": "felukka"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                        "entry_id": "1a4de054-d30d-39c8-aa1a-24624b31c3c6",
                        "glosses": [
                            "Sorte de petit bâtiment léger, long et étroit, à voiles et à rames, et qui était principalement en usage dans la Méditerranée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "931a9317-3994-4fe3-93f9-43cbcfeb5473",
                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                "text": "Je n’aperçus en arrivant que trois ou quatre felouques grecques, et je perdis tout espoir de retrouver mon navire autrichien."
                            },
                            {
                                "example_id": "0fed1a6b-c25a-4c60-ad41-7dec3f2e4689",
                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                "text": "Enfin, il parvint à un tel degré de maladie que, pour le mettre au lit, il fallait le manœuvrer comme une felouque entrant dans un chenal dangereux."
                            },
                            {
                                "example_id": "7706263f-f560-416a-8cbb-c09b23bb70eb",
                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                "text": "Puis on fit venir de petites unités du Levant, frégates latines et felouques."
                            },
                            {
                                "example_id": "cebf60d3-d117-40f0-89c3-37b1fa3a3a0d",
                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                "text": "Ce sont ces bâtiments qui enlèvent les barques et les felouques qui vont terre à terre, et font souvent des prises considérables et un grand nombre d’esclaves, […]."
                            },
                            {
                                "example_id": "7b95d13f-4afe-4263-9473-064d133c516a",
                                "sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                                "text": "La Valette a caché plus d’une vingtaine de felouques tout le long de la côte, à l’usage de ses messagers pour la Sicile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a86a1d5-5efd-469e-82d6-cd4c883c8038",
                        "source_entry_id": "1a4de054-d30d-39c8-aa1a-24624b31c3c6",
                        "source_sense_id": "06e10f27-597a-3c2f-8b7c-1ce0f90881bf",
                        "target_lang_word": "Feluke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feluke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e009cf86-6ac8-333f-bc74-e7d4cb12539e",
                                        "entry_id": "172b59c8-4a82-37a6-9e59-0291d578cf5f",
                                        "glosses": [
                                            "Segelschiff mit ein oder zwei Masten und Dreieckssegel für die Küstenschiffahrt im Mittelmeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8006a7-b5c0-4637-9ec3-e45473695e0c",
                                                "sense_id": "e009cf86-6ac8-333f-bc74-e7d4cb12539e",
                                                "text": "„Wann immer der Wind abflaute, holte die Feluke auf, während die Böen uns einen kleinen Vorteil verschafften.“"
                                            },
                                            {
                                                "example_id": "76699fbf-d0ac-460c-8557-dc69e9c5a92a",
                                                "sense_id": "e009cf86-6ac8-333f-bc74-e7d4cb12539e",
                                                "text": "„Auf der Feluke erholte sich Bellino von seinem Schrecken und sagte mir, ich hätte ihn zum Zeugen eines Ereignisses gemacht, das in Wirklichkeit kaum glaubhaft sei, ihm jedenfalls eine befremdliche Vorstellung von meinem Charakter gegeben habe; den der Griechin verstehe er überhaupt nicht, es sei denn, ich behaupte, alle Griechinnen verhielten sich so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66d9ff19-a29f-3ad3-8beb-8f757248ec75",
                                        "entry_id": "172b59c8-4a82-37a6-9e59-0291d578cf5f",
                                        "glosses": [
                                            "kleines Kriegsschiff in der Form einer Galeere"
                                        ],
                                        "tags": [
                                            "früher"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bff44c27-1bd4-4b3c-bc41-0464d5a774ab",
