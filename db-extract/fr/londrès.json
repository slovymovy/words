                "senses": [
                    {
                        "sense_id": "72fa7fbb-2487-3297-b0d2-85f0c17c0d48",
                        "entry_id": "4e4bed4f-976c-3da2-bff0-a18f19e80dbe",
                        "glosses": [
                            "Cigare de La Havane, à l’origine destiné au marché anglais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5367017b-7bfd-40be-bfe8-8faf7782ba12",
                                "sense_id": "72fa7fbb-2487-3297-b0d2-85f0c17c0d48",
                                "text": "Mais pouvait-on lui en vouloir, à cet endiablé vicomte, si charmant, si bon garçon, toujours le cœur et le londrès sur la main ?"
                            },
                            {
                                "example_id": "c246de25-78da-4e8d-82a7-14355eda526b",
                                "sense_id": "72fa7fbb-2487-3297-b0d2-85f0c17c0d48",
                                "text": "Je lui eusse offert un de ces londrès de choix dont ma sacoche est largement approvisionnée."
                            },
                            {
                                "example_id": "620fa220-210b-47c7-95fe-3748575673c7",
                                "sense_id": "72fa7fbb-2487-3297-b0d2-85f0c17c0d48",
                                "text": "Il fumait un de ces londrès sans défaut qui valent seuls un long poème."
                            },
                            {
                                "example_id": "ccd5644b-8881-4ca2-819f-95cd212c6779",
                                "sense_id": "72fa7fbb-2487-3297-b0d2-85f0c17c0d48",
                                "text": "Où des richards pervers allumaient des londrès."
                            }
                        ]
                    },
                    {
                        "sense_id": "260399bc-6496-3fd8-8d59-d8ccd12fcb92",
                        "entry_id": "4e4bed4f-976c-3da2-bff0-a18f19e80dbe",
                        "glosses": [
                            "Demi-londrès : Cigare de qualité identique, mais de taille réduite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8b239d-63bb-431f-99f0-fe4bedec979b",
                                "sense_id": "260399bc-6496-3fd8-8d59-d8ccd12fcb92",
                                "text": "Elle aurait bien aimé être serveuse dans un bureau de tabac : « Les demi-londrès, voilà, monsieur ! » et l’on sourit en disant ces mots."
                            },
                            {
                                "example_id": "194bed2b-80d1-4ff6-8dfd-b80b7b13ef71",
                                "sense_id": "260399bc-6496-3fd8-8d59-d8ccd12fcb92",
                                "text": "Lockroy était d’une maigreur squelettique, précocement blanchi, agité d’un tremblement à moitié feint, qui devint réel avec les années, les yeux à fleur de tête, la bouche railleuse, fumant ou tripotant sans cesse un petit cigare qu’on appelait demi-londrès."
                            }
                        ]
                    }
