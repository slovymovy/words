{
    "word_family": [
        "bunter",
        "bunting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4bef9dc5-7d21-377a-8dcb-33b67bbd1770",
                    "sense_definition": "A ball that has been intentionally hit softly so as to be difficult to field, typically in baseball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball_bunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter laid down a perfect <w>bunt</w> along the third-base line.",
                            "target_lang_translations": {
                                "ru": "Бьющий выполнил идеальный <w>короткий удар</w> вдоль линии третьей базы."
                            }
                        },
                        {
                            "text": "The infielder rushed forward but could not field the <w>bunt</w> in time.",
                            "target_lang_translations": {
                                "ru": "Инфилдер бросился вперед, но не успел обработать этот <w>бант</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "perfect bunt",
                        "lay down a bunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мяч, намеренно посланный слабым ударом, чтобы его было трудно поймать в поле (обычно в бейсболе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бант",
                                "target_lang_sense_clarification": "короткий удар в бейсболе"
                            },
                            {
                                "target_lang_word": "короткий удар",
                                "target_lang_sense_clarification": "в бейсболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59c92137-544c-39ea-8fcc-a39fe0ce14db",
                    "sense_definition": "The act of hitting a ball softly, especially in baseball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball_bunt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager decided to call for a sacrifice <w>bunt</w> to advance the runner.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил дать команду на жертвенный <w>бант</w>, чтобы продвинуть раннера вперед."
                            }
                        },
                        {
                            "text": "With two strikes, attempting a <w>bunt</w> is a very risky strategy.",
                            "target_lang_translations": {
                                "ru": "При двух страйках попытка сделать <w>короткий удар</w> — очень рискованная стратегия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacrifice bunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прием или действие по выполнению мягкого, короткого удара по мячу (особенно в бейсболе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бант",
                                "target_lang_sense_clarification": "прием в бейсболе"
                            },
                            {
                                "target_lang_word": "короткий удар",
                                "target_lang_sense_clarification": "действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "290647f2-d58f-3b13-be2c-fcd726f277f7",
                    "sense_definition": "A gentle push, shove, or butt, especially with the head.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "push_butt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful goat gave my leg a friendly <w>bunt</w> to get my attention.",
                            "target_lang_translations": {
                                "ru": "Игривый козлик дружески <w>боднул</w> мою ногу, чтобы привлечь внимание."
                            }
                        },
                        {
                            "text": "With a soft <w>bunt</w> of its nose, the puppy nudged the ball toward me.",
                            "target_lang_translations": {
                                "ru": "Мягким <w>тычком</w> носа щенок подтолкнул мяч ко мне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "friendly bunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий толчок или удар, особенно головой или носом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "легкий толчок головой"
                            },
                            {
                                "target_lang_word": "толчок носом",
                                "target_lang_sense_clarification": "о животном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26252473-b4c1-397f-8623-c164dcfa3d9c",
                    "sense_definition": "The middle part, cavity, or belly of a sail; the part of a furled sail which is at the center of the yard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_sail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors gathered to secure the <w>bunt</w> of the main sail during the storm.",
                            "target_lang_translations": {
                                "ru": "Моряки собрались, чтобы закрепить <w>брюхо</w> грота во время шторма."
                            }
                        },
                        {
                            "text": "The wind filled the <w>bunt</w> of the sail, pushing the vessel forward.",
                            "target_lang_translations": {
                                "ru": "Ветер наполнил <w>середину</w> паруса, толкая судно вперед."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средняя часть, брюхо или выпуклость паруса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюхо паруса",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e2ad103-b26a-32a9-8724-80d758da8104",
                    "sense_definition": "The second half of an outside loop in aviation, from level flight to inverted flight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation_maneuver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot executed a perfect <w>bunt</w>, transitioning smoothly to inverted flight.",
                            "target_lang_translations": {
                                "ru": "Пилот безупречно выполнил <w>бант</w>, плавно перейдя в перевернутый полет."
                            }
                        },
                        {
                            "text": "Performing a <w>bunt</w> requires precise control to handle the negative G-forces.",
                            "target_lang_translations": {
                                "ru": "Выполнение <w>обратной полупетли вниз</w> требует точного управления, чтобы справиться с отрицательными перегрузками."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вторая половина обратной петли в авиации, переход из горизонтального полета в перевернутый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бант",
                                "target_lang_sense_clarification": "фигура пилотажа"
                            },
                            {
                                "target_lang_word": "обратная полупетля",
                                "target_lang_sense_clarification": "вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "909c1c25-199e-3c23-be50-2495aea4359e",
                    "sense_definition": "Any large pilot-commanded pitch-down motion of an aircraft, often producing negative G-forces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation_maneuver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>bunt</w> caused loose items in the cockpit to float momentarily.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>нырок</w> самолета заставил незакрепленные вещи в кабине на мгновение взлететь."
                            }
                        },
                        {
                            "text": "He initiated a sharp <w>bunt</w> to rapidly change his flightpath angle.",
                            "target_lang_translations": {
                                "ru": "Он начал резкое <w>пикирование</w>, чтобы быстро изменить угол траектории полета."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое движение самолета носом вниз по команде пилота, часто вызывающее отрицательную перегрузку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резкое пикирование",
                                "target_lang_sense_clarification": "отдача ручки от себя"
                            },
                            {
                                "target_lang_word": "нырок",
                                "target_lang_sense_clarification": "самолета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e155ffb-c0f6-3aab-ae61-f28cde7394d1",
                    "sense_definition": "A fungus affecting the ear of cereals, filling the grains with a foetid dust.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_fungus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wheat crop was severely damaged by an outbreak of <w>bunt</w> this season.",
                            "target_lang_translations": {
                                "ru": "Урожай пшеницы в этом сезоне сильно пострадал от вспышки <w>головни</w>."
                            }
                        },
                        {
                            "text": "Farmers use treated seeds to prevent <w>bunt</w> from ruining their harvest.",
                            "target_lang_translations": {
                                "ru": "Фермеры используют обработанные семена, чтобы <w>грибок</w> не погубил их урожай."
                            }
                        }
                    ],
                    "synonyms": [
                        "pepperbrand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грибковое заболевание злаков, при котором зерна наполняются темной вонючей пылью; головня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твердая головня",
                                "target_lang_sense_clarification": "болезнь растений"
                            },
                            {
                                "target_lang_word": "мокрая головня",
                                "target_lang_sense_clarification": "грибок пшеницы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb66bbe0-9865-359c-ae1b-a8e01f6ffea6",
                    "sense_definition": "To intentionally hit a ball softly with a hands-spread batting stance, typically in baseball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball_bunt_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach signaled for the batter to <w>bunt</w> the ball to advance the runner.",
                            "target_lang_translations": {
                                "ru": "Тренер подал сигнал бьющему, чтобы тот <w>сыграл коротко</w> и продвинул раннера."
                            }
                        },
                        {
                            "text": "He managed to <w>bunt</w> the pitch perfectly down the third-base line.",
                            "target_lang_translations": {
                                "ru": "Ему удалось идеально <w>направить</w> мяч бантом вдоль линии третьей базы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bunt the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно мягко ударить по мячу, держа биту широко расставленными руками (в бейсболе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать бант",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "выполнять короткий удар",
                                "target_lang_sense_clarification": "бейсбол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c209844-0f29-3bfb-9217-d4f253b6124e",
                    "sense_definition": "To perform the action of hitting a ball softly in baseball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baseball_bunt_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of swinging hard, the batter decided to <w>bunt</w> to surprise the defense.",
                            "target_lang_translations": {
                                "ru": "Вместо сильного замаха бьющий решил <w>сделать бант</w>, чтобы застать защиту врасплох."
                            }
                        },
                        {
                            "text": "She knows how to <w>bunt</w> effectively when the team needs a base hit.",
                            "target_lang_translations": {
                                "ru": "Она умеет эффективно <w>выполнять короткий удар</w>, когда команде нужно занять базу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять короткий, мягкий удар по мячу в бейсболе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить коротко",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "бантовать",
                                "target_lang_sense_clarification": "жаргон в бейсболе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f900698-296d-32aa-96d4-8e186de56dc4",
                    "sense_definition": "To headbutt affectionately, as a cat or other animal does.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affectionate_butt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My cat loves to <w>bunt</w> my hand when she wants to be petted.",
                            "target_lang_translations": {
                                "ru": "Моя кошка обожает <w>тыкаться головой</w> в мою руку, когда хочет, чтобы её погладили."
                            }
                        },
                        {
                            "text": "The friendly goat would gently <w>bunt</w> against our knees for treats.",
                            "target_lang_translations": {
                                "ru": "Дружелюбный козлик слегка <w>бодался</w> о наши колени, выпрашивая лакомство."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for animal behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласково бодаться или тереться головой (о кошках и других животных)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодаться",
                                "target_lang_sense_clarification": "ласково, о животных"
                            },
                            {
                                "target_lang_word": "тыкаться головой",
                                "target_lang_sense_clarification": "выражая привязанность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec28a119-fbbd-3dcd-ad92-fb77570930f5",
                    "sense_definition": "To push or strike with the horns or head; to butt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "push_butt_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rams began to <w>bunt</w> each other during their playful sparring.",
                            "target_lang_translations": {
                                "ru": "Бараны начали <w>бодаться</w> друг с другом во время игривой стычки."
                            }
                        },
                        {
                            "text": "Be careful, as that young bull might try to <w>bunt</w> you if you get too close.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, так как этот молодой бычок может попытаться <w>боднуть</w> тебя, если ты подойдешь слишком близко."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкать или бить рогами или головой; бодаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодать",
                                "target_lang_sense_clarification": "ударить рогами или головой"
                            },
                            {
                                "target_lang_word": "бодаться",
                                "target_lang_sense_clarification": "драться рогами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eea2dbdc-8c5f-341d-b92b-281c9cd386d3",
                    "sense_definition": "To spring or rear up.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rear_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startled horse began to <w>bunt</w> when the loud noise echoed through the valley.",
                            "target_lang_translations": {
                                "ru": "Испуганная лошадь начала <w>вздыбливаться</w>, когда громкий звук разнесся по долине."
                            }
                        },
                        {
                            "text": "We watched the wild animals <w>bunt</w> and play in the open fields.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как дикие животные <w>резвятся</w> и играют в открытом поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставать на дыбы или резко вскидываться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздыбливаться",
                                "target_lang_sense_clarification": "о лошади"
                            },
                            {
                                "target_lang_word": "вскидываться",
                                "target_lang_sense_clarification": "резко подниматься"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f15c636-1c12-33f1-8ec9-77b080fd9ce6",
                    "sense_definition": "To perform the second half of an outside loop in an aircraft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aviation_maneuver_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a few highly skilled pilots dared to <w>bunt</w> their aircraft during the airshow.",
                            "target_lang_translations": {
                                "ru": "Лишь немногие высококлассные пилоты осмеливались <w>делать обратную полупетлю</w> на своих самолетах во время авиашоу."
                            }
                        },
                        {
                            "text": "He pushed the nose down past the vertical to <w>bunt</w> into inverted flight.",
                            "target_lang_translations": {
                                "ru": "Он опустил нос ниже вертикали, чтобы <w>перейти</w> в перевернутый полет через пикирование."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять вторую половину обратной петли на самолете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать бант",
                                "target_lang_sense_clarification": "в авиации"
                            },
                            {
                                "target_lang_word": "выполнять обратную полупетлю",
                                "target_lang_sense_clarification": "вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f4f9cca-6529-39e9-aa58-2f1399092175",
                    "sense_definition": "To swell out, as a sail filled with wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "swell_out",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched the canvas <w>bunt</w> as the strong sea breeze caught the vessel.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели, как парусина <w>надувается</w>, когда сильный морской бриз настиг судно."
                            }
                        },
                        {
                            "text": "The sails began to <w>bunt</w> beautifully as the ship turned into the wind.",
                            "target_lang_translations": {
                                "ru": "Паруса начали красиво <w>выгибаться</w>, когда корабль повернул по ветру."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Надуваться, выгибаться (о парусе под ветром)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надуваться",
                                "target_lang_sense_clarification": "о парусе"
                            },
                            {
                                "target_lang_word": "выгибаться",
                                "target_lang_sense_clarification": "под ветром"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "61f1b33e-7209-371b-9170-2d206d2da82a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Bunt</w> to speak at our local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Банта</w> выступить на заседании нашего местного исторического общества."
                            }
                        },
                        {
                            "text": "The local library has a collection of papers donated by the <w>Bunt</w> family.",
                            "target_lang_translations": {
                                "ru": "В местной библиотеке хранится коллекция документов, подаренных семьей <w>Бант</w>."
                            }
                        }
