                "senses": [
                    {
                        "sense_id": "131f2004-fdb8-3847-885f-ee42fccab3fb",
                        "entry_id": "5b31a842-4df5-350e-8f55-6e06108a32af",
                        "glosses": [
                            "ungeordnete Ansammlung vieler Kabel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "48fbc5f5-d2cb-4df2-80f4-c81ec73b35a0",
                                "sense_id": "131f2004-fdb8-3847-885f-ee42fccab3fb",
                                "text": "Hinter der HiFi-Anlage ist ein riesiger Kabelsalat."
                            },
                            {
                                "example_id": "f9eea0b4-811d-44e2-bea6-8196228404be",
                                "sense_id": "131f2004-fdb8-3847-885f-ee42fccab3fb",
                                "text": "[…] seit Mitte des 19. Jahrhunderts wird Salat in der Bedeutung von „Durcheinander“, „Unordnung“ gebraucht. Bei Kabelsalat hilft nur eins: Geduld […]"
                            },
                            {
                                "example_id": "4898498e-78b3-45b4-876f-8c723311dc75",
                                "sense_id": "131f2004-fdb8-3847-885f-ee42fccab3fb",
                                "text": "Auf diese Weise konnte es [das Wort 'Salat'] auch einen negativen Beiklang entwickeln, wie er in Kabelsalat oder Bandsalat greifbar ist; also im Sinn von \"Mischmasch\", \"Chaos\"."
                            },
                            {
                                "example_id": "ff2d2914-5f6b-4212-acf5-1e0618021928",
                                "sense_id": "131f2004-fdb8-3847-885f-ee42fccab3fb",
                                "text": "Der Händler winkt, und bittet in den hinteren Ladenteil, in die Werkstatt. Offene Kartons stehen herum, randvoll mit Kabelsalat, Platinen und Lötkolben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
