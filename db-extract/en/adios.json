                        ],
                        "form": "adioses"
                    },
                    {
                        "form_id": "b9d705f2-d0d8-40ab-a577-0467f98152c3",
                        "entry_id": "5b2c675c-85f2-37bd-b0c0-e9c6dd61a8e2",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "adiosing"
                    },
                    {
                        "form_id": "68e9a156-4bd1-4896-99ab-fa256dcfde47",
                        "entry_id": "5b2c675c-85f2-37bd-b0c0-e9c6dd61a8e2",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "adiosed"
                    },
                    {
                        "form_id": "14e56e9d-325f-44be-a65b-d7beb9f854b3",
                        "entry_id": "5b2c675c-85f2-37bd-b0c0-e9c6dd61a8e2",
                        "tags": [
                            "past"
                        ],
                        "form": "adiosed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97a4b67a-b3a5-3973-9f0e-e86bc87edff6",
                        "entry_id": "5b2c675c-85f2-37bd-b0c0-e9c6dd61a8e2",
                        "glosses": [
                            "To leave; to literally or figuratively say “adios” to."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af34e131-411e-49a3-8d4e-e0505f33d214",
                                "sense_id": "97a4b67a-b3a5-3973-9f0e-e86bc87edff6",
                                "text": "About an hour later I adiosed the office."
                            },
                            {
                                "example_id": "9bc666b3-c3f9-48fd-9b76-e39116c01045",
                                "sense_id": "97a4b67a-b3a5-3973-9f0e-e86bc87edff6",
                                "text": "“Oh, yes, I’m so happy that my latest codelincuente has adiosed me,” I scoff."
                            },
                            {
                                "example_id": "a5480194-caed-4464-a5c2-128fd6253572",
                                "sense_id": "97a4b67a-b3a5-3973-9f0e-e86bc87edff6",
                                "text": "Three cups later, he and Juana stacked together their collated notes and he adiosed the kids and caregivers."
                            },
                            {
                                "example_id": "d635077a-d4e8-4688-817d-f4cc38fa5b49",
                                "sense_id": "97a4b67a-b3a5-3973-9f0e-e86bc87edff6",
                                "text": "“ONE THING you need to be clear on,” Patti says after we’ve adiosed the scene, doubling back now to drive me to my car."
                            }
                        ]
                    },
                    {
                        "sense_id": "06980ea1-2729-3542-a864-018d369061b0",
                        "entry_id": "5b2c675c-85f2-37bd-b0c0-e9c6dd61a8e2",
                        "glosses": [
                            "To get rid of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2868a68a-4007-4956-a3b9-db442f1bdad9",
                                "sense_id": "06980ea1-2729-3542-a864-018d369061b0",
                                "text": "By the time they got there, somebody’d adiosed the corpse."
                            },
                            {
                                "example_id": "9624c30a-f976-428d-a810-7c142b4707b0",
                                "sense_id": "06980ea1-2729-3542-a864-018d369061b0",
                                "text": "She also adiosed the eye contact."
                            }
                        ]
                    }
                ],
