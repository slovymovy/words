                "senses": [
                    {
                        "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                        "entry_id": "b72cbd36-5e39-385c-8cb7-0f07e5d74575",
                        "glosses": [
                            "persönliches Einbringen in das Verkehrsgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7173001b-4ccf-4e8f-91bd-d0766b8d7b0d",
                                "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                                "text": "„Um die Voraussetzungen des Kindes für die Verkehrsteilnahme beurteilen zu können, muss wenigstens kurz auf die Zusammenhänge von Wahrnehmen und Handeln sowie auf die Unterschiede von Kindsein und Erwachsenensituation eingegangen werden.“"
                            },
                            {
                                "example_id": "bc836658-59fa-4627-b06f-cc9bd715bf79",
                                "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                                "text": "Die Verteilung der Art der Verkehrsteilnahme der Verletzten im Alter zwischen 18 und 64 Jahren zeigt, dass PKW-Insassen und Fahrradfahrer am häufigsten betroffen sind.“"
                            },
                            {
                                "example_id": "302e6c0a-3523-42b1-92ae-bb3616cc9781",
                                "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                                "text": "„Anders als das Radfahren ist das Skaten weniger eine Form der alltäglichen Verkehrsteilnahme, sondern vorwiegend Freizeitsport, sagte Richard Schild zur Begründung.“"
                            },
                            {
                                "example_id": "6bedea86-a772-4648-9a96-ef035e88bed2",
                                "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                                "text": "„Ebenso klar setzen sie sich allerdings dafür ein, dass in nachgewiesenen Einzelfällen dann, wenn eine Verkehrsteilnahme nicht mehr verantwortbar ist, die Fahrerlaubnis auch entzogen werden sollte.“"
                            },
                            {
                                "example_id": "e66840e0-575b-4fbd-867f-d3e83a62d730",
                                "sense_id": "fb70d7df-62dc-33fa-9890-dc28f15d980d",
                                "text": "„Dabei haben auch wir Deutsche den Begriff von ‚Verkehrsteilnahme’.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
