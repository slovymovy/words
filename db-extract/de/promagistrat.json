                "senses": [
                    {
                        "sense_id": "fa9e355b-1b3e-39bf-8641-5e475f6ae5d3",
                        "entry_id": "4db9ecf4-8fc3-3cc8-b959-4307f80204b0",
                        "glosses": [
                            "die Rechte eines Magistrats besitzende Person, die aber kein Amt bekleidet"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b85e6d1a-fef1-4d90-b723-62ac6d882e71",
                                "sense_id": "fa9e355b-1b3e-39bf-8641-5e475f6ae5d3",
                                "text": "„Um auch in den Provinzen gefährliche Machtkonzentrationen einzelner Statthalter zu vermeiden, wurden ferner die Heeresverbände auf alle Promagistrate verteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b80e401-8cdf-40fa-9715-ddc3af836a2b",
                        "source_entry_id": "4db9ecf4-8fc3-3cc8-b959-4307f80204b0",
                        "source_sense_id": "fa9e355b-1b3e-39bf-8641-5e475f6ae5d3",
                        "source_sense_description": "historisch: die Rechte eines Magistrats besitzende Person, die aber kein Amt bekleidet",
                        "target_lang_word": "promagistrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promagistrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeeab309-be75-3859-bd5b-433f0f871b4b",
                                        "entry_id": "a9a54068-1f8b-333e-8983-a8fc638e5f68",
                                        "glosses": [
                                            "In ancient Rome, an ex-consul or ex-praetor whose imperium (the power to command an army) was extended at the end of his annual term of office or later."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704eb9d8-0f5f-4658-a3bb-3d6761b1dfd1",
                                                "sense_id": "aeeab309-be75-3859-bd5b-433f0f871b4b",
                                                "text": "The first promagistrate was Q. Publilius Philo (b.c. 327), who, after serving his year as consul, was retained in command of the army pro consule for another year by an extension (prorogatio) of his imperium;[…]."
                                            },
                                            {
                                                "example_id": "709a5280-c8bb-45f0-823e-c0d5656768e2",
                                                "sense_id": "aeeab309-be75-3859-bd5b-433f0f871b4b",
                                                "text": "But on the expiration of their office, they became promagistrates with military authority for an additional year in the provinces."
                                            },
                                            {
                                                "example_id": "3d5afd8b-f05b-41a3-9541-ce04d3603178",
                                                "sense_id": "aeeab309-be75-3859-bd5b-433f0f871b4b",
                                                "text": "Although promagistrates could not exercise their power in Rome itself, many were appointed to govern overseas territories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
