                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To agitate rapidly and repetitively, or to stir with a rowing or rocking motion; generally applies to liquids, notably cream."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e172d852-2661-473e-9cbd-40ea463d3f1f",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "Now the cream is churned to make butter."
                                            },
                                            {
                                                "example_id": "65c4bb9d-5de3-4c61-b256-1a427fd234e8",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "no-churn ice cream"
                                            },
                                            {
                                                "example_id": "6001be79-5509-4ce3-887c-ed59222c8574",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "Churned in his teeth, the foamy venom rose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e093ba8-e260-3baa-9641-3eff63a1668f",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To produce excessive and sometimes undesirable or unproductive activity or motion."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f2b885-0ad7-4796-a496-4b1129ee8666",
                                                "sense_id": "0e093ba8-e260-3baa-9641-3eff63a1668f",
                                                "text": "The slope of the terrain, shaped like a funnel, squeezed the growing swell of churning snow into a steep, twisting gorge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a751a1-ee86-319c-bd15-dc0a28bc7b29",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To move rapidly and repetitively with a rocking motion; to tumble, mix or shake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5041f8-a89b-4cc8-9513-8c2ae9010261",
                                                "sense_id": "18a751a1-ee86-319c-bd15-dc0a28bc7b29",
                                                "text": "I was so nervous that my stomach was churning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c640ab-13e8-364d-a891-266ecd589494",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To stop using a company's product or service."
                                        ],
                                        "tags": [
                                            "of a customer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "598a5302-7f98-4af2-97e1-19b76fd5ed5d",
                                                "sense_id": "d6c640ab-13e8-364d-a891-266ecd589494",
                                                "text": "Subscriptions can be ended or canceled, which is known as churn. If there are no subscriptions, a customer churns when they stop using the product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e91053d-2ea9-3467-83cb-7d787e0c9a19",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To repeatedly cancel and rebook a reservation in order to refresh ticket time limits or other fare rule restrictions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e5cbee-90cf-397b-8fb9-e0d234d802f3",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To continually sign up for new credit cards in order to earn signup bonuses, airline miles, and other benefits."
                                        ],
