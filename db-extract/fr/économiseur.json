                                "sense_id": "4071a078-8e9d-3ab6-8677-2294331a67e9",
                                "text": "Un économiseur d’écran, écran de veille."
                            },
                            {
                                "example_id": "c9609f58-1476-4e96-901a-0ccae9704276",
                                "sense_id": "4071a078-8e9d-3ab6-8677-2294331a67e9",
                                "text": "Il s’installa devant l’ordinateur et stoppa l’économiseur d’écran."
                            }
                        ]
