                ],
                "senses": [
                    {
                        "sense_id": "3e8f8376-ff2e-38e4-8eb2-32e2042e13ad",
                        "entry_id": "d25dc853-f880-3a2a-a923-add3f0c235e8",
                        "glosses": [
                            "een klein klompje hard materiaal, meestal in de vorm van een botje dat gebruikt wordt om op te gooien in het bikkelspel"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a862ee8-8b08-3cd3-965d-89dfd3561a9a",
                        "entry_id": "d25dc853-f880-3a2a-a923-add3f0c235e8",
                        "glosses": [
                            "overdrachtelijk iets erg hards"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c846da67-2a80-4dbc-b255-cc4c77d224cc",
                                "sense_id": "2a862ee8-8b08-3cd3-965d-89dfd3561a9a",
                                "text": "Dat is zo hard als een bikkel."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cc9730d-e602-3eeb-8be0-2ecdec686a7e",
                        "entry_id": "d25dc853-f880-3a2a-a923-add3f0c235e8",
                        "glosses": [
                            "een persoon met heel veel doorzettingsvermogen, iemand die heel stoer is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3abfcb0-8909-4af6-b700-5c13ef8b8a36",
                                "sense_id": "8cc9730d-e602-3eeb-8be0-2ecdec686a7e",
                                "text": "Tussen de weeën door praatten ze over de huizenmarkt. Ik had geen verdoving nodig; ik wilde zelfs geen paracetamol toen het voorbij was. 'Je bent een bikkel,' zei mijn arts hoofdschuddend."
                            },
                            {
                                "example_id": "cf6ee226-9bf5-4346-a9b4-ccd494134daa",
                                "sense_id": "8cc9730d-e602-3eeb-8be0-2ecdec686a7e",
                                "text": "Mijn vader zegt dat dragers van de bollentrui echte bikkels zijn. Ik weet niet of ik een bikkel ben, ik vind vooral de rode bollen op de witte ondergrond heel mooi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "796591dc-e112-4005-ab79-d9c5c154e669",
                        "source_entry_id": "d25dc853-f880-3a2a-a923-add3f0c235e8",
                        "source_sense_id": "3e8f8376-ff2e-38e4-8eb2-32e2042e13ad",
                        "source_sense_description": "klein klompje hard materiaal",
                        "target_lang_word": "osselet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osselet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed848b3-3095-32fa-9cb9-78c0f3c0432a",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Petit os."
                                        ],
                                        "tags": [
                                            "Squelette"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0334ee7-bd9b-4539-9bb2-85951a3cc5bb",
                                                "sense_id": "1ed848b3-3095-32fa-9cb9-78c0f3c0432a",
                                                "text": "Les osselets de l’oreille moyenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Petits os du jeu d’osselets, généralement des tarses de veau ou de mouton ou des copies en métal ou en plastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5e74de-4322-4f05-b253-08a8478dabb9",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Les tabletiers font des osselets d’ivoire."
                                            },
                                            {
                                                "example_id": "558ddc11-7098-4c86-953e-8e06e6d7d34d",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Habilement, Stavro jette un osselet en l’air et avant de le rattraper, saisit tous les autres."
                                            },
                                            {
                                                "example_id": "e41a8f1f-a8fb-4861-82aa-5988b32eb620",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Le reste est jeu d’enfant, et je suis avec tous mes livres comme un petit garçon qui agite des osselets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Tumeur osseuse placée sur la partie inférieure de la jambe d’un cheval, à côté du boulet."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eff5a1b-0015-4f4b-90a9-97b6996560f0",
                                                "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                                "text": "L’osselet est une exostose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
