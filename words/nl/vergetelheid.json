{
    "word_family": [
        "vergeten",
        "vergetelijk",
        "onvergetelijk",
        "vergeetachtig",
        "vergeetachtigheid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "110e4d10-7377-3fa2-82ce-fcc9c3441cf3",
                    "sense_definition": "De toestand van volledig vergeten te zijn of in vergetelheid te zijn geraakt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vergetelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de opkomst van de nieuwe technologie raakte het oude systeem al snel in <w>vergetelheid</w>.",
                            "target_lang_translations": {
                                "en": "After the rise of the new technology, the old system quickly fell into <w>oblivion</w>."
                            }
                        },
                        {
                            "text": "De eens zo beroemde schrijver is na zijn dood in totale <w>vergetelheid</w> geraakt.",
                            "target_lang_translations": {
                                "en": "The once famous writer fell into total <w>obscurity</w> after his death."
                            }
                        }
                    ],
                    "synonyms": [
                        "oblivion"
                    ],
                    "antonyms": [
                        "bekendheid",
                        "roem"
                    ],
                    "common_phrases": [
                        "in vergetelheid raken",
                        "aan de vergetelheid ontrukken"
                    ],
                    "target_lang_definitions": {
                        "en": "The state of being completely forgotten or having faded into obscurity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oblivion",
                                "target_lang_sense_clarification": "the state of being forgotten"
                            },
                            {
                                "target_lang_word": "obscurity",
                                "target_lang_sense_clarification": "the state of being unknown or forgotten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2836ebe-cd75-3b70-a5a1-2575f8215d77",
                    "sense_definition": "De eigenschap of toestand van vergeetachtigheid; een moment of neiging tot vergeten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vergeetachtigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn toenemende <w>vergetelheid</w> begon zijn dagelijkse werkzaamheden ernstig te belemmeren.",
                            "target_lang_translations": {
                                "en": "His increasing <w>forgetfulness</w> began to seriously hinder his daily activities."
                            }
                        },
                        {
                            "text": "Zij vergaf hem zijn kleine <w>vergetelheid</w> toen hij haar verjaardag bleek te zijn vergeten.",
                            "target_lang_translations": {
                                "en": "She forgave him his minor <w>oversight</w> when it turned out he had forgotten her birthday."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergeetachtigheid"
                    ],
                    "antonyms": [
                        "oplettendheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality or state of being forgetful; a moment or tendency to forget."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forgetfulness",
                                "target_lang_sense_clarification": "the tendency to forget things"
                            },
                            {
                                "target_lang_word": "lapse of memory",
                                "target_lang_sense_clarification": "a temporary failure to remember something"
                            },
                            {
                                "target_lang_word": "oversight",
                                "target_lang_sense_clarification": "an unintentional failure to notice or do something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}