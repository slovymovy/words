                "senses": [
                    {
                        "sense_id": "692ed529-a465-3eed-83ff-b6dbe4ad3ac9",
                        "entry_id": "ab28058a-0cea-3b6e-b4d5-45209bab254e",
                        "glosses": [
                            "siedziba pustelnika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7863809c-bbc9-4f67-967a-be31c092ae4c",
                                "sense_id": "692ed529-a465-3eed-83ff-b6dbe4ad3ac9",
                                "text": "Eremita zamieszkał w pustelni, gdzie znalazł ciszę i spokój."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ce52e786-655b-3015-9a35-83967292aa8c",
                        "entry_id": "ab28058a-0cea-3b6e-b4d5-45209bab254e",
                        "glosses": [
                            "niewielki pawilon w ogrodzie lub parku przeznaczony do wypoczynku na uboczu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b316155a-2f1f-4be9-86f8-1a6dbbcea9a6",
                                "sense_id": "ce52e786-655b-3015-9a35-83967292aa8c",
                                "text": "Znalazł hrabinę w pustelni, drzemała z pieskiem na kolanach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5d2a6e3-3deb-439b-95ad-0fbe6d30950b",
                        "source_entry_id": "ab28058a-0cea-3b6e-b4d5-45209bab254e",
                        "source_sense_id": "692ed529-a465-3eed-83ff-b6dbe4ad3ac9",
                        "target_lang_word": "hermitage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermitage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A house or dwelling where a hermit lives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0296aca7-86cd-4e82-92cb-6f5041f2a9bb",
                                                "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                                "text": "But vvhat a vvretched, and diſconſolate Hermitage is that Houſe, vvhich is not viſited by thee [God], and vvhat a VVayue, and Stray is that Man, that hath not thy Markes vpon him?"
                                            },
                                            {
                                                "example_id": "1f11460d-289e-4eaf-b031-7aabf56098e0",
                                                "sense_id": "4851da0f-8a97-369b-ab74-b1bed6bb7566",
                                                "text": "I saw the huge rocking-stone, that had been violently depressed by him as he sprang, fly back when relieved of his weight till, for the first time during all these centuries, it got beyond its balance, fell with a most awful crash right into the rocky chamber which had once served the philosopher Noot for a hermitage, and, I have no doubt, for ever sealed the passage that leads to the Place of Life with some hundreds of tons of rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba22db81-aa26-3aa0-9f2f-5fed839bdcea",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A place of seclusion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e37f2c-89a2-4c1b-9c3c-44c70278baa1",
                                                "sense_id": "ba22db81-aa26-3aa0-9f2f-5fed839bdcea",
                                                "text": "Temptation is an obsequious servant that has no objection to the country, and we know that it takes up its lodging in hermitages as well as in cities; and that in the most remote and inaccessible desert it keeps company with the fugitive solitary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb17122f-f9de-3b08-ab3f-c035aeeb221e",
                                        "entry_id": "43aeb1bb-ca38-3ddd-b103-082ea01f2fec",
                                        "glosses": [
                                            "A period of seclusion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ee089d-d039-41db-b887-c89530b6c9ed",
                        "source_entry_id": "ab28058a-0cea-3b6e-b4d5-45209bab254e",
                        "source_sense_id": "692ed529-a465-3eed-83ff-b6dbe4ad3ac9",
                        "target_lang_word": "ermitage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ermitage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cffc6b4-8fbe-370e-93cb-a6d67507f567",
                                        "entry_id": "b49ff236-a7dd-3bee-b065-691aa3118e47",
                                        "glosses": [
                                            "Habitation d’un ermite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b51e57-a0c9-4df3-83e8-d510be62d419",
                                                "sense_id": "6cffc6b4-8fbe-370e-93cb-a6d67507f567",
                                                "text": "Comme le nouveau-né sort du sein de sa mère, l'ermite est enfanté à la vie spirituelle dans l'ermitage où il devient librement l'otage de Dieu."
                                            },
                                            {
                                                "example_id": "525ea339-9975-44d9-ab0d-bd0fc9793220",
                                                "sense_id": "6cffc6b4-8fbe-370e-93cb-a6d67507f567",
                                                "text": "Les relations de l’ermite et de la devineresse auraient indirectement commencé lors de ce rassemblement : entendant parler de Margueronne, Regnaud aurait préché contre elle. Il faut ajouter que le lieu-dit Bellevillotte, près de Bourdenay, qui est sans doute le lieu de résidence de Margueronne, n'est situé qu'à quelques kilomètres de là : il reste tout à fait concevable que la devineresse se soit rendue dans la foulée à l’ermitage de Saint-Flavy pour s'entretenir avec Regnaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4a9187-9ebd-3a8e-8fd1-46776ddc9d6e",
                                        "entry_id": "b49ff236-a7dd-3bee-b065-691aa3118e47",
                                        "glosses": [
                                            "Groupement d’ermites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72b89325-5c15-4aaa-8c68-ef4f35d19951",
                                                "sense_id": "ff4a9187-9ebd-3a8e-8fd1-46776ddc9d6e",
                                                "text": "Maclow aurait abordé, au terme de sept années de navigation, l'île de Cézembre — une île côtière du nord-est de la Bretagne — où il construisit son ermitage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22839a8b-3990-35fe-b054-3f8373a69e75",
                                        "entry_id": "b49ff236-a7dd-3bee-b065-691aa3118e47",
                                        "glosses": [
                                            "Lieu écarté, solitaire et champêtre, comme ceux que les ermites choisissent pour leur retraite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4beb9318-4394-496c-8a84-3cbaa2104d28",
                                                "sense_id": "22839a8b-3990-35fe-b054-3f8373a69e75",
                                                "text": "Le tintement d’une petite cloche fit comprendre au chevalier qu’il était dans le voisinage de quelque chapelle ou de quelque ermitage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
