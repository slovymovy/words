                        "source_entry_id": "3f253916-d0be-3e60-8d25-f51e697d658d",
                        "source_sense_id": "43028016-b3d9-3d82-9b0d-298a43f2587b",
                        "source_sense_description": "voedingsmiddel op basis van melk",
                        "target_lang_word": "laitage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
