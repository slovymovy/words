                ],
                "senses": [
                    {
                        "sense_id": "8728fd02-3dd4-33da-baf3-ec1bc1abe9ea",
                        "entry_id": "c14e1585-1d89-325e-8631-53e880d9cf31",
                        "glosses": [
                            "kugelförmiges Präparat gegen Motten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea52d766-c5ab-4983-a9b0-d3d3fd313438",
                                "sense_id": "8728fd02-3dd4-33da-baf3-ec1bc1abe9ea",
                                "text": "„Sie roch nach Kleidern, die zu lange im Koffer gelegen hatten, eine Mischung aus Mief und Mottenkugeln.“"
                            },
                            {
                                "example_id": "47e58885-45e0-4c49-877a-bb60251eab3a",
                                "sense_id": "8728fd02-3dd4-33da-baf3-ec1bc1abe9ea",
                                "text": "„Es roch nach Mottenkugeln und abgestandener Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8d4ffa9-3086-44e9-9f70-dffc5f671c0a",
                        "source_entry_id": "c14e1585-1d89-325e-8631-53e880d9cf31",
                        "source_sense_id": "8728fd02-3dd4-33da-baf3-ec1bc1abe9ea",
                        "source_sense_description": "kugelförmiges Präparat gegen Motten",
                        "target_lang_word": "mothball",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mothball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5fd26a0-f20c-3dbf-ab9c-f27f74381bd7",
                                        "entry_id": "492993de-9fe8-3db7-9d86-2ed3471c999e",
                                        "glosses": [
                                            "A small ball of chemical pesticide (typically naphthalene) and deodorant placed in or around clothing and other articles susceptible to damage from mold or moth larvae in order to protect them from this damage."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mothball",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                                        "entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                                        "glosses": [
                                            "To store or shelve something no longer used."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5262b642-70af-4d36-8ea5-90786a03e315",
                                                "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                                                "text": "They mothballed the old version after the new one came out."
                                            },
                                            {
                                                "example_id": "440d2365-ca32-4e50-be0f-8de4ede16a3b",
                                                "sense_id": "8e72256d-4a36-33b9-bb2d-ed15b4307c01",
                                                "text": "Before Musk, America’s space industry was moribund. In 2011, NASA mothballed the last space shuttle, after inking a deal with SpaceX to make uncrewed cargo resupply runs to the International Space Station (ISS)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                                        "entry_id": "8ca9f403-df3e-3714-8363-a1cf9acf3c38",
                                        "glosses": [
                                            "To stop using (something), but keep it in good condition."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da084c0-1f14-4b8e-9e62-923dae8e3e0b",
                                                "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                                                "text": "Some schools might have an art studio, an area of forestry in the playground, or a performance stage in the hall – all exceptional assets. Just check they get plenty of use and aren't mothballed while the school concentrates on (you guessed it) maths and literacy."
                                            },
                                            {
                                                "example_id": "d18e8734-1701-42aa-a3ec-e26a503c9cfe",
                                                "sense_id": "1b316599-9936-3ac2-a52a-899b8e4d682b",
                                                "text": "In the short term NR could well mothball the line given its lack of traffic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
