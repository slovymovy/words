                        "nl": [
                            {
                                "target_lang_word": "bebouwd",
                                "target_lang_sense_clarification": "met betrekking tot land of terrein"
                            },
                            {
                                "target_lang_word": "ontgonnen",
                                "target_lang_sense_clarification": "klaargemaakt voor gebruik"
                            },
                            {
                                "target_lang_word": "aangelegd",
                                "target_lang_sense_clarification": "met betrekking tot parken of infrastructuur"
                            }
                        ]
