                "senses": [
                    {
                        "sense_id": "3cec3057-28b0-32e9-8e0f-aaef2161ed5b",
                        "entry_id": "c76cf92c-2689-3f35-a8d0-a9ce2b66eebe",
                        "glosses": [
                            "Pays enclavé d’Asie du Sud-Est, enclavé entre la Birmanie, la Thaïlande, le Cambodge, le Viêt Nam et la Chine. Sa capitale est Vientiane."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "5a5281e7-e474-4b10-958a-04cb46a4bfb7",
                                "sense_id": "3cec3057-28b0-32e9-8e0f-aaef2161ed5b",
                                "text": "Ce fut auſſi ce qui rendit curieux un Ambaſſadeur du Roy de Laos qui ſe trouvoit alors à la Cour de Tunquin, de s’informer de cette Loy, & d’en prendre des inſtructions particulieres par la converſation meſme qu’il prattiqua avecque les noſtres ; en laquelle il fut tellement gaigné qu’il leur fit offre de les conduire à ſon retour au Royaume de Laos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19d21b6c-0775-48be-83f6-1cd4f4004779",
                        "source_entry_id": "c76cf92c-2689-3f35-a8d0-a9ce2b66eebe",
                        "source_sense_id": "3cec3057-28b0-32e9-8e0f-aaef2161ed5b",
