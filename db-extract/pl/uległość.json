                                    {
                                        "sense_id": "45af0304-9840-3a93-af4c-e59facdf9dcc",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "The act of submitting or yielding; surrender."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c57297a-beb0-3ea0-b515-c1cda04035ae",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "The act of submitting or giving e.g. a completed piece of work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cd822dd-dbfb-4aee-9fb2-0227cc11ec43",
                                                "sense_id": "8c57297a-beb0-3ea0-b515-c1cda04035ae",
                                                "text": "Any submissions received after Friday will have marks deducted for lateness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "246e1d16-2326-3521-8b15-de36837c6a6a",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "The thing which has been submitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7057eb8-0598-4eed-9558-b46d02f54906",
                                                "sense_id": "246e1d16-2326-3521-8b15-de36837c6a6a",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52195826-f0a3-3ab9-9d58-5b4ce4f658bd",
                                        "entry_id": "1f6bfb25-bf47-39b6-ac00-79f4fcd2ec9c",
                                        "glosses": [
                                            "A submission hold in wrestling, mixed martial arts, or other combat sports."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd865e5-8573-4fe7-aecc-f4015e3c80e1",
                                                "sense_id": "52195826-f0a3-3ab9-9d58-5b4ce4f658bd",
                                                "text": "He used overhooks to block the punches, but he didn't seem to know any submissions off the overhooks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "submission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64b0ae8c-1372-3844-977b-fafbe8fa5000",
                                        "entry_id": "d6a185ec-91ea-3992-8656-608fd1dc50f1",
                                        "glosses": [
                                            "A subset or component of a mission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5de9492-8088-470b-acd0-db6dbdc232d5",
                                                "sense_id": "64b0ae8c-1372-3844-977b-fafbe8fa5000",
                                                "text": "The commander would have to communicate to his operational planners his intent — how he wanted to fight the battle and what missions and submissions were vital to achieving what the corps order had defined as missions for the division."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
