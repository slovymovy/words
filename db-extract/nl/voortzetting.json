                    {
                        "sense_id": "d7b2cbaf-1593-3406-af37-ae585dc1ac5c",
                        "entry_id": "14900584-6b2c-3cb6-b579-8744cde98bc6",
                        "glosses": [
                            "het voortzetten van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cccb4a42-6c6a-4ece-bf1a-28a401acf676",
                                "sense_id": "d7b2cbaf-1593-3406-af37-ae585dc1ac5c",
                                "text": "De voortzetting van dit project is van groot belang!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c67e60c-98e3-4d3f-b37b-69c972fba76f",
                        "source_entry_id": "14900584-6b2c-3cb6-b579-8744cde98bc6",
                        "source_sense_id": "d7b2cbaf-1593-3406-af37-ae585dc1ac5c",
                        "source_sense_description": "het voortzetten van iets",
                        "target_lang_word": "Fortsetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fortsetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d2e2c4-d4f6-3a33-9bd0-ed1b7a30ff6b",
                                        "entry_id": "db4989d3-60a2-3ccb-ae08-0ee52f616028",
                                        "glosses": [
                                            "das Fortsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8367f7b3-2778-4917-ae39-49374ee84b4b",
                                                "sense_id": "c8d2e2c4-d4f6-3a33-9bd0-ed1b7a30ff6b",
                                                "text": "Die Fortsetzung der Diskussion wurde beschlossen."
                                            },
                                            {
                                                "example_id": "22ed3533-df25-4e4d-8359-dd81088666dc",
                                                "sense_id": "c8d2e2c4-d4f6-3a33-9bd0-ed1b7a30ff6b",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "3c068340-cac8-4ee3-894b-5460f8297268",
                                                "sense_id": "c8d2e2c4-d4f6-3a33-9bd0-ed1b7a30ff6b",
                                                "text": "„Die Obereren ermunterten ihn zur Fortsetzung seiner naturwissenschaftlichen Studien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb19afa7-a4e1-3c23-aee3-3593c24a1579",
                                        "entry_id": "db4989d3-60a2-3ccb-ae08-0ee52f616028",
                                        "glosses": [
                                            "der fortgesetzte, weitergeführte Teil eines in einzelnen Teilen veröffentlichten Werkes (z. B. Roman, Film)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87315534-0039-46df-ad34-dd80d3eb2f20",
                                                "sense_id": "fb19afa7-a4e1-3c23-aee3-3593c24a1579",
                                                "text": "Die Erzählung wurde in Fortsetzungen abgedruckt."
                                            },
                                            {
                                                "example_id": "ced45744-bca1-41b4-8867-b9e151d47857",
                                                "sense_id": "fb19afa7-a4e1-3c23-aee3-3593c24a1579",
                                                "text": "„Halldóra ging wie Scheherezade in Tausendundeiner Nacht vor, sie stellte das Erzählen nämlich auf dem Höhepunkt ein und verschob die Fortsetzung auf den nächsten Tag.“"
                                            },
                                            {
                                                "example_id": "adde497f-58dc-49c8-aea8-cee190bd7602",
                                                "sense_id": "fb19afa7-a4e1-3c23-aee3-3593c24a1579",
                                                "text": "„Irgendwann im Herbst 1773 beginnt Wieland mit der Niederschrift, von Januar bis Juli 1774 erscheinen die ersten beiden Teile in Fortsetzungen im »Teutschen Merkur«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45e58be4-6022-47d3-a49d-b43817cfd4bc",
                        "source_entry_id": "14900584-6b2c-3cb6-b579-8744cde98bc6",
                        "source_sense_id": "d7b2cbaf-1593-3406-af37-ae585dc1ac5c",
