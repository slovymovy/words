            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c21074bd-6f37-389c-94d7-d3abb2d1f559",
                    "sense_definition": "Craindre fortement une personne ou une chose, appréhender un danger ou un malheur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup d'étudiants <w>redoutent</w> les examens de fin d'année scolaire."
                        },
                        {
                            "text": "Les habitants <w>redoutaient</w> le pire après l'annonce de la violente tempête."
                        }
                    ],
                    "synonyms": [
                        "craindre",
                        "appréhender"
                    ],
                    "antonyms": [
                        "espérer",
                        "souhaiter"
                    ],
                    "common_phrases": [
                        "redouter le pire",
                        "redouter les conséquences"
                    ]
                },
                {
                    "sense_id": "e5f217cd-bff8-3d00-8934-8815c3ce9b7c",
                    "sense_definition": "Être vulnérable à l'action de quelque chose, risquer d'être abîmé ou détérioré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces meubles anciens <w>redoutent</w> l'humidité et doivent être conservés dans une pièce sèche."
                        },
                        {
                            "text": "Ce tissu très fin et délicat <w>redoute</w> la chaleur excessive du fer."
                        }
                    ],
                    "synonyms": [
                        "craindre"
                    ],
                    "antonyms": [
                        "supporter"
                    ],
                    "common_phrases": [
