                ],
                "senses": [
                    {
                        "sense_id": "0efd018f-66d7-36bb-a0e2-ec718157b394",
                        "entry_id": "a63651bf-fabf-3ad1-a3d2-3794f09d155a",
                        "glosses": [
                            "Verzicht auf weitere Nutzung der Atomenergie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63302e5e-6ba2-4562-98fc-20a93acd3c08",
                                "sense_id": "0efd018f-66d7-36bb-a0e2-ec718157b394",
                                "text": "Es gibt genügend Gründe für einen Atomausstieg."
                            },
                            {
                                "example_id": "7c07cc2a-2744-44c7-b7b1-3fa7af1769f3",
                                "sense_id": "0efd018f-66d7-36bb-a0e2-ec718157b394",
                                "text": "„Die Parteien stellen sich auf den Wahlkampf ein, arbeiten Programme aus, streiten über Mehrwertsteuern, Atomausstiege und Verbraucherschutz.“"
                            },
                            {
                                "example_id": "92743148-6b30-490e-8670-f5d19a416d32",
                                "sense_id": "0efd018f-66d7-36bb-a0e2-ec718157b394",
                                "text": "„Der Zürcher Stadtrat will die energiepolitischen Weichen für Zürich neu stellen. … Ebenfalls festgeschrieben werden soll der Atomausstieg, wenn auch erst auf lange Sicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
