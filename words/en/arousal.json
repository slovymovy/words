            "senses": [
                {
                    "sense_id": "8069c005-548a-30e2-ad15-bf0d8853bd12",
                    "sense_definition": "A state of sexual excitement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual_excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie scene caused a noticeable sense of <w>arousal</w> in the viewer.",
                            "target_lang_translations": {
                                "ru": "Сцена из фильма вызвала у зрителя заметное чувство <w>возбуждения</w>."
                            }
                        },
                        {
                            "text": "Physical touch can often trigger intense sexual <w>arousal</w> between partners.",
                            "target_lang_translations": {
                                "ru": "Физическое прикосновение часто может вызывать сильное сексуальное <w>возбуждение</w> между партнерами."
                            }
                        }
                    ],
                    "synonyms": [
                        "horniness"
                    ],
                    "common_phrases": [
                        "sexual arousal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние полового влечения или возбуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "сексуальное влечение"
                            },
                            {
                                "target_lang_word": "половое возбуждение",
                                "target_lang_sense_clarification": "физиологическая и психологическая реакция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c2df68-d49b-36dc-b53a-2a540526a6c2",
                    "sense_definition": "The act of stirring up emotions or interest, or the state of being stirred up.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dramatic speech caused an immediate <w>arousal</w> of public sympathy.",
                            "target_lang_translations": {
                                "ru": "Драматическая речь вызвала немедленное <w>пробуждение</w> сочувствия у публики."
                            }
                        },
                        {
                            "text": "High levels of emotional <w>arousal</w> can interfere with clear decision-making.",
                            "target_lang_translations": {
                                "ru": "Высокий уровень эмоционального <w>возбуждения</w> может мешать принятию ясных решений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional arousal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробуждение чувств, эмоций или интереса, а также состояние эмоционального подъема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "чувств, интереса или эмоций"
                            },
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "эмоциональный подъем, волнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d10ba29-d569-3694-a80e-18a8f39ac9ca",
                    "sense_definition": "A physiological and psychological state of being awake, alert, and responsive to stimuli.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "activation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loud noises trigger physiological <w>arousal</w> by increasing heart rate and muscle tension.",
                            "target_lang_translations": {
                                "ru": "Громкие звуки вызывают физиологическое <w>возбуждение</w>, увеличивая частоту сердечных сокращений и мышечное напряжение."
                            }
                        },
                        {
                            "text": "Athletes need an optimal level of cortical <w>arousal</w> to perform at their best.",
                            "target_lang_translations": {
                                "ru": "Спортсменам необходим оптимальный уровень <w>активации</w> коры головного мозга, чтобы показать наилучшие результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "alertness"
                    ],
                    "common_phrases": [
                        "physiological arousal",
                        "state of arousal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физиологическое и психологическое состояние бодрствования, бдительности и готовности реагировать на стимулы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возбуждение",
                                "target_lang_sense_clarification": "физиологическая активация нервной системы"
                            },
                            {
                                "target_lang_word": "бодрствование",
                                "target_lang_sense_clarification": "состояние активности и бдительности"
                            },
                            {
                                "target_lang_word": "активация",
                                "target_lang_sense_clarification": "физиологическая готовность систем организма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84107e7c-12af-37ad-bd56-0698edd68886",
                    "sense_definition": "The act of waking up or emerging from sleep, unconsciousness, or hibernation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers studied the sudden <w>arousal</w> from sleep caused by sleep apnea.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили внезапное <w>пробуждение</w> ото сна, вызванное апноэ."
                            }
                        },
                        {
                            "text": "During periodic <w>arousal</w> from hibernation, the mammal warms its body up.",
                            "target_lang_translations": {
                                "ru": "Во время периодического <w>пробуждения</w> от спячки млекопитающее согревает свое тело."
                            }
                        }
                    ],
                    "synonyms": [
                        "wakefulness"
                    ],
                    "common_phrases": [
                        "arousal from sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс выхода изо сна, бессознательного состояния или спячки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробуждение",
                                "target_lang_sense_clarification": "выход ото сна или спячки"
