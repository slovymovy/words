                ],
                "senses": [
                    {
                        "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                        "entry_id": "f74c155c-c7f4-3dcb-89f9-6c00ae764c61",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbd1baa-9365-481c-b30b-8efd967db89c",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Frau Heimes ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a5f5f08a-9c3f-4c55-b342-3a7ffa564d1a",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Herr Heimes wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e1defac3-dd2e-4375-8f0e-ff78348c6890",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Die Heimesens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "279104e5-359e-42f5-88de-a47331acaba0",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Der Heimes trägt nie die Pullover, die die Heimes ihm strickt."
                            },
                            {
                                "example_id": "5ee6fe3a-2421-43e7-a589-f0b475791da0",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heimes kommt, geht der Herr Heimes.“"
                            },
                            {
                                "example_id": "7cbcc9a8-e082-4aa2-bf0b-b9a7d44bdbb6",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Heimes kommt und geht."
                            },
                            {
                                "example_id": "2547ab03-f312-49e6-8a77-e8a3df5bbabb",
                                "sense_id": "73d4f5c7-b9c5-38b2-bb58-4b84c4f84c8b",
                                "text": "Heimes’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
