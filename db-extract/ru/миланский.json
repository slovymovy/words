                                        "sense_id": "f5b9fb90-844f-30b4-b5f0-0cbbee2254d3",
                                        "entry_id": "d5c648a3-99ad-3107-a93d-6155f3fb2968",
                                        "glosses": [
                                            "Of, from or relating to the city of Milan or surrounding metropolitan city, Lombardy, Italy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Milanese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69ebfbe4-37ca-3bf3-95be-b4b5c1429630",
                                        "entry_id": "461a3439-fe22-3081-a35b-e09adeb1c9a4",
                                        "glosses": [
                                            "A native or inhabitant of the city of Milan or surrounding metropolitan city, Lombardy, Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc05cb43-6fc9-4135-99fc-ca85aab1b9a6",
                                                "sense_id": "69ebfbe4-37ca-3bf3-95be-b4b5c1429630",
                                                "text": "—the waiter was a Milanese, and ardently patriotic—"
                                            },
                                            {
                                                "example_id": "1199eed2-b08a-4df7-9587-f639645886de",
                                                "sense_id": "69ebfbe4-37ca-3bf3-95be-b4b5c1429630",
                                                "text": "Finally, the first maestro to have been both a Milanese and a product of the studio, Giovanni Battista Cesati, served from before 1655, publishing a motet book, until he was called to Bologna in summer 1658."
                                            },
                                            {
                                                "example_id": "fc748a40-6cc7-4bb8-ada6-9153b58ca526",
                                                "sense_id": "69ebfbe4-37ca-3bf3-95be-b4b5c1429630",
                                                "text": "Indeed, in Milan, everyday conversations and practices of relating, attunement, and distancing between inhabitants also partake in wider discourses concerning who is a “Milanese” and what the Milanese share."
                                            }
                                        ]
                                    }
                                ]
                            },
