            {
                "entry_id": "8d30b450-e16b-365f-bd24-30d07dd4abb8",
                "word": "polis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11625df2-c1c2-3d7c-a046-e091efe114ac",
                        "entry_id": "8d30b450-e16b-365f-bd24-30d07dd4abb8",
                        "glosses": [
                            "Dans la Grèce antique, cité-État composée d’une communauté de citoyens libres et autonomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cdde951-65ba-46eb-ad51-e6adfe7be6dd",
                                "sense_id": "11625df2-c1c2-3d7c-a046-e091efe114ac",
                                "text": "La polis grecque a longtemps été étudiée selon une vision dichotomique, ville et campagne, intérieur et extérieur."
                            },
                            {
                                "example_id": "0267fcaa-ad39-4845-885b-049c600aebd8",
                                "sense_id": "11625df2-c1c2-3d7c-a046-e091efe114ac",
                                "text": "Avec la polis s’efface le citoyen et apparaît l’individu."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbc75cd3-5faf-3989-bbdb-e946797a76aa",
                        "entry_id": "8d30b450-e16b-365f-bd24-30d07dd4abb8",
                        "glosses": [
                            "De façon plus générale, même à l’époque moderne, cité (au sens politique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343abfa7-6407-42ab-8827-778164a59d9a",
                                "sense_id": "cbc75cd3-5faf-3989-bbdb-e946797a76aa",
                                "text": "Ce lieu doit devenir « le centre de la polis (cité en grec, NDLR] », où l’on vient pour « s’instruire, apprendre et débattre »."
                            }
                        ]
                    }
                ],
