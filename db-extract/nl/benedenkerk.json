                        "examples": [
                            {
                                "example_id": "c4d4a339-9ebf-4560-bbd7-2b1a695c9221",
                                "sense_id": "c7b5d843-e4af-3ce7-a905-b44b3f791931",
                                "text": "Pal aan de oever staat een neogotische kerk, die bij nader inzien blijkt te zijn verdeeld in een bovenkerk en een benedenkerk, omdat zo kort bij de rivier expansie in de lengte of breedte niet mogelijk bleek; alleen in de hoogte."
                            },
                            {
                                "example_id": "0a77909d-d126-47b2-8ca1-75a4cae3e2b3",
                                "sense_id": "c7b5d843-e4af-3ce7-a905-b44b3f791931",
                                "text": "Zijn lijkkist is opgegraven en in een sarcofaag geplaatst in de benedenkerk om te worden vereerd."
                            }
                        ]
                    }
