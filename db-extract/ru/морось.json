                "senses": [
                    {
                        "sense_id": "5f65eac0-6033-3a86-a859-fe79904952cc",
                        "entry_id": "a27fbe12-7cba-33c0-be39-97d5f705d8d3",
                        "glosses": [
                            "метеорол. атмосферные осадки в виде очень мелких капель, медленно выпадающих из облаков или из тумана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e81d2e-03cc-46c7-abcd-6c613cae06f1",
                                "sense_id": "5f65eac0-6033-3a86-a859-fe79904952cc",
                                "text": "Шёл дождь, — не дождь, какая-то мелкая морось, — небо нависло тёмное, мутное."
                            },
                            {
                                "example_id": "202c7c9b-e896-4b93-804f-bff979c0aa23",
                                "sense_id": "5f65eac0-6033-3a86-a859-fe79904952cc",
                                "text": "О борта бились взлохмаченные некрупные волны. Свежий ветер и ноябрьская морось не отяжеляли дыхания."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdb3b5f3-fdcf-48f5-9034-37cfff323a55",
                        "source_entry_id": "a27fbe12-7cba-33c0-be39-97d5f705d8d3",
                        "source_sense_id": "5f65eac0-6033-3a86-a859-fe79904952cc",
