                        "target_lang_word": "Ätna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ätna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                        "entry_id": "25f63e95-b430-38e6-acce-a47b53b27c52",
                                        "glosses": [
                                            "ein 3352 Meter hoher, aktiver Schichtvulkan an der Ostküste der Insel Sizilien nördlich der Stadt Catania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19aa962-d2b4-4b39-8baf-ac5929c2693c",
                                                "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                                "text": "Die Entstehung des eigentlichen Ätna begann vor ca. 100.000 Jahren, zu Beginn des Quartärs."
                                            },
                                            {
                                                "example_id": "89932fae-7375-4a8a-8f8b-9280a78524c0",
                                                "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                                "text": "Ausbrüche des Ätna wurden bereits in der Antike beschrieben."
                                            },
                                            {
                                                "example_id": "4e024d4a-16ec-46b8-b218-c078e438443c",
                                                "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                                "text": "Vor 600.000 Jahren setzte der Vulkanismus im Bereich des heutigen Ätna ein."
                                            },
                                            {
                                                "example_id": "1947ec29-a98f-4dd6-8dc3-0fab4c8edf32",
                                                "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                                "text": "Weitere Erdstöße haben die Bewohner der Region um den ausgebrochenen sizilianischen Vulkan Ätna in Angst und Schrecken versetzt."
                                            },
                                            {
                                                "example_id": "f5ffb6e6-4637-4a3f-ab8e-c7dbe562ee46",
                                                "sense_id": "f6d13f16-1b51-328c-96ef-c34a1633ac17",
                                                "text": "Nach Ansicht des deutschen Vulkanologen Boris Behnke hat der neue Ausbruch zu Bewegungen des Ätna geführt: \"Große Teile der Nordostseite des Vulkans sind um etwa einen Meter in Richtung Meer verschoben worden\", berichtete der Wissenschaftler von der Universität Catania."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
