                            {
                                "example_id": "dfa8219c-540b-48c3-8f92-a70cbef61e62",
                                "sense_id": "c8ce7f44-975e-3b8b-8a5d-555f92240424",
                                "text": "De vervolging van minderheden is een ernstig mensenrechtenprobleem.",
                                "translation": "The persecution of minorities is a serious human rights issue.",
                                "english": "The persecution of minorities is a serious human rights issue."
                            },
                            {
                                "example_id": "4048f039-7236-43ed-a741-bac729381b81",
                                "sense_id": "c8ce7f44-975e-3b8b-8a5d-555f92240424",
                                "text": "Tijdens het regime was er veel vervolging van politieke tegenstanders.",
                                "translation": "During the regime, there was much persecution of political opponents.",
                                "english": "During the regime, there was much persecution of political opponents."
                            },
                            {
                                "example_id": "c2c655d0-ce44-4267-8506-9d19e313a4aa",
                                "sense_id": "c8ce7f44-975e-3b8b-8a5d-555f92240424",
                                "text": "De geschiedenis kent vele voorbeelden van religieuze vervolging.",
                                "translation": "History has many examples of religious persecution.",
                                "english": "History has many examples of religious persecution."
                            }
                        ]
                    },
