                        "sense_id": "5759d6b8-48da-3254-a833-96544385a288",
                        "entry_id": "5e78bdf1-cf9e-3502-a484-059937276b5b",
                        "glosses": [
                            "statek handlowy przewożący towary drogą morską np. masowiec, kontenerowiec, drobnicowiec"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0ce4a6-43b1-47ae-9c3e-d33e7e6d226e",
                                "sense_id": "5759d6b8-48da-3254-a833-96544385a288",
                                "text": "Niemieckie bombowce zaatakowały konwój brytyjskich frachtowców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
