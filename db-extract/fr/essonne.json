            {
                "entry_id": "bc7718d2-aba9-3c84-8b38-ac2e27964f58",
                "word": "Essonne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c630f294-8151-3e29-8af5-363236ebd39a",
                        "entry_id": "bc7718d2-aba9-3c84-8b38-ac2e27964f58",
                        "glosses": [
                            "Rivière, affluent de la Seine dont le cours traverse les départements du Loiret et de l’Essonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a70ae4-a356-47dd-b7e1-73b641be0900",
                                "sense_id": "c630f294-8151-3e29-8af5-363236ebd39a",
                                "text": "Il faut remarquer que l’Essonne se forme des deux cours d'eau la Rimarde et l'Œuf, et qu'elle ne prend son véritable nom qu'après la réunion de ces deux petites rivières, à Aulnay-la-Rivière."
                            },
                            {
                                "example_id": "c3bb53b3-56a3-40dd-905b-1abb53194c72",
                                "sense_id": "c630f294-8151-3e29-8af5-363236ebd39a",
                                "text": "Deux chemins de randonnée permettent de profiter pleinement de ce paysage préservé. Ils longent la Rimarde, cours d’eau récemment « renaturalisé » qui, avec l’Œuf, forment l’Essonne."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf653751-0a3d-33c5-8af7-982343deef8a",
                        "entry_id": "bc7718d2-aba9-3c84-8b38-ac2e27964f58",
                        "glosses": [
                            "Département français de l’Île-de-France portant le numéro 91."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55e47a1-79df-4008-8cb2-d345c6a4ce13",
                                "sense_id": "cf653751-0a3d-33c5-8af7-982343deef8a",
                                "text": "Après deux ans de recherche, ils ont finalement jeté leur dévolu sur la Base 217, une ex-base aérienne entre Brétigny-sur-Orge et Le Plessis-Pâté (Essonne)."
                            }
                        ]
                    }
