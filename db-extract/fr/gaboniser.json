                        "glosses": [
                            "Donner un caractère gabonais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0b65a8-7096-4515-876b-e2d795d1b781",
                                "sense_id": "0aa2e046-69af-36d8-b072-ace1dbb124f4",
                                "text": "Le problème majeur, ce sont les hommes, souligne le directeur. Nous voulons « gaboniser » au maximum."
                            },
                            {
                                "example_id": "cfad8da7-04a9-4fd6-b886-876f3fdf261f",
                                "sense_id": "0aa2e046-69af-36d8-b072-ace1dbb124f4",
                                "text": "Le gouvernement gabonais a entrepris la double tâche de moderniser le secteur rural et de nationaliser, ou plutôt de « gaboniser » le secteur moderne industriel."
                            }
                        ]
