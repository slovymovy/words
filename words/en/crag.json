{
    "word_family": [
        "craggy",
        "cragginess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f06094fc-cfdf-3e13-8e47-0a84276a968e",
                    "sense_definition": "A steep, rugged, and rough rock or cliff projecting outwards.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rocky_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain climber carefully reached for a handhold on the steep <w>crag</w>.",
                            "target_lang_translations": {
                                "ru": "Альпинист осторожно потянулся за опорой на крутом <w>утёсе</w>."
                            }
                        },
                        {
                            "text": "An eagle built its nest high up on a rocky <w>crag</w> where no predators could reach it.",
                            "target_lang_translations": {
                                "ru": "Орёл свил гнездо высоко на скалистом <w>утёсе</w>, куда не могли добраться хищники."
                            }
                        }
                    ],
                    "synonyms": [
                        "cliff",
                        "precipice",
                        "bluff"
                    ],
                    "common_phrases": [
                        "rocky crag",
                        "steep crag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутая, неровная и грубая скала или утес, выступающий наружу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утёс",
                                "target_lang_sense_clarification": "отвесная скала"
                            },
                            {
                                "target_lang_word": "скала́",
                                "target_lang_sense_clarification": "каменная глыба или гора с крутыми склонами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ea7d029-59e1-3dd9-9568-fff3999f1c53",
                    "sense_definition": "A rough, broken fragment of rock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rocky_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path was littered with sharp <w>crags</w> that made walking difficult.",
                            "target_lang_translations": {
                                "ru": "Тропа была усыпана острыми <w>обломками скал</w>, что затрудняло ходьбу."
                            }
                        },
                        {
                            "text": "He kicked a loose <w>crag</w> of limestone down the slope.",
                            "target_lang_translations": {
                                "ru": "Он пнул покатившийся вниз по склону <w>осколок</w> известняка."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragment",
                        "boulder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, отколотый обломок скалы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обломок скалы",
                                "target_lang_sense_clarification": "кусок камня"
                            },
                            {
                                "target_lang_word": "осколок",
                                "target_lang_sense_clarification": "острый обломок камня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05523048-9752-3b44-84e1-5c46637fd293",
                    "sense_definition": "A partially compacted bed of gravel mixed with shells, dating from the Pliocene to Pleistocene epochs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists analyzed the fossilized shells found within the ancient layer of <w>crag</w>.",
                            "target_lang_translations": {
                                "ru": "Геологи проанализировали окаменелые раковины, найденные в древнем слое <w>крэга</w>."
                            }
                        },
                        {
                            "text": "The coastal cliffs of East Anglia are famous for their deposits of Red <w>Crag</w>.",
                            "target_lang_translations": {
                                "ru": "Прибрежные скалы Восточной Англии знамениты своими залежами Красного <w>крэга</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical geological term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частично уплотненный слой гравия, смешанного с ракушками, относящийся к эпохам плиоцена и плейстоцена."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крэг",
                                "target_lang_sense_clarification": "геологический термин, ракушечный гравий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0c75947-adfe-3e4c-88f4-29c9145ba678",
                    "sense_definition": "A game played with three dice, similar to Yahtzee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the rainy afternoon playing a lively game of <w>crag</w> at the kitchen table.",
                            "target_lang_translations": {
                                "ru": "Дождливый день они провели за кухонным столом, оживлённо играя в <w>крэг</w>."
                            }
                        },
                        {
                            "text": "To win at <w>crag</w>, you need to roll specific combinations with three dice.",
                            "target_lang_translations": {
                                "ru": "Чтобы выиграть в <w>крэг</w>, нужно выбросить определённые комбинации тремя кубиками."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игра в кости с тремя кубиками, похожая на Яхтзи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крэг",
                                "target_lang_sense_clarification": "название настольной игры в кости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa451140-80d0-3bb6-862e-fc02eb7446d6",
                    "sense_definition": "The neck or throat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher prepared the <w>crag</w> of mutton for a slow-cooked stew.",
                            "target_lang_translations": {
                                "ru": "Мясник приготовил баранью <w>шею</w> для медленного тушения."
                            }
                        },
                        {
                            "text": "He grabbed the beast by its hairy <w>crag</w> to hold it still.",
                            "target_lang_translations": {
                                "ru": "Он схватил зверя за волосатый <w>загривок</w>, чтобы удержать его на месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "neck",
                        "throat"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily Scottish and Northern English"
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern standard English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шея или горло (диалектное или архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загривок",
                                "target_lang_sense_clarification": "задняя часть шеи"
                            },
                            {
                                "target_lang_word": "шея",
                                "target_lang_sense_clarification": "горло, шея животного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "070387c6-8651-34c2-98f2-963158748a89",
                    "sense_definition": "A dice game similar to Yahtzee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "We decided to play <w>Crag</w> instead of board games tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы решили сыграть в <w>Крэг</w> вместо настольных игр."
                            }
                        },
                        {
                            "text": "The rules of <w>Crag</w> are simpler than those of traditional Yahtzee.",
                            "target_lang_translations": {
                                "ru": "Правила игры <w>Крэг</w> проще, чем правила традиционного Яхтзи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игра в кости, похожая на Яхтзи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Крэг",
                                "target_lang_sense_clarification": "название игры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}