                                "target_senses": [
                                    {
                                        "sense_id": "7ab644ee-98d9-34fa-904d-c451088cc0c3",
                                        "entry_id": "deb9ef2c-c9e6-33e5-9918-d447888b87c2",
                                        "glosses": [
                                            "As sharp as a razor; extremely sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e3a001-4438-4f70-8af0-c5a43cb4ad2b",
                                                "sense_id": "7ab644ee-98d9-34fa-904d-c451088cc0c3",
                                                "text": "The executioner was proud that he kept his axe razor-sharp, so no prisoner would feel any pain when his head was cut off."
                                            },
                                            {
                                                "example_id": "e8c04b9e-1c88-4f5f-9b7e-e339ed2f86b1",
                                                "sense_id": "7ab644ee-98d9-34fa-904d-c451088cc0c3",
                                                "text": "[flavor text of the card \"Zera The Mant\"]\nA huge, brutal monster that attacks with razor-sharp claws."
                                            },
                                            {
                                                "example_id": "aed803b2-83cd-45dd-b35a-8d99d4ee2309",
                                                "sense_id": "7ab644ee-98d9-34fa-904d-c451088cc0c3",
                                                "text": "A lot of people stress out about getting crows' feet, but personally I would be more concerned about their long, razor-sharp beaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b107a9fc-6ad8-36a8-963d-61ebde613318",
                                        "entry_id": "deb9ef2c-c9e6-33e5-9918-d447888b87c2",
                                        "glosses": [
                                            "Very clever or quick-witted."
                                        ],
