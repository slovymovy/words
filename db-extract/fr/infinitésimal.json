                    },
                    {
                        "form_id": "0b79a0a1-786a-4abb-81f7-3541e4dae039",
                        "entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "infinitésimale"
                    },
                    {
                        "form_id": "578db5ff-0083-493b-8819-3ecad46f0ce7",
                        "entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "infinitésimales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35086d01-5442-3c13-b318-f6ba4e84b4c2",
                        "entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "glosses": [
                            "Infiniment petit ; en quantité extrêmement petite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89ab99c-30df-476c-8cac-76c4d2bf9a58",
                                "sense_id": "35086d01-5442-3c13-b318-f6ba4e84b4c2",
                                "text": "L'action des doses infinitésimales, quelque incompréhensible qu'elle paraisse aux meilleurs esprits, eu égard à son intensité, et quel que puisse être le caractère d'infinitésimalité qu'on lui suppose, aura toujours un résultat positif."
                            },
                            {
                                "example_id": "a3cf8d6b-636e-4900-8fff-60cfa39dbc06",
                                "sense_id": "35086d01-5442-3c13-b318-f6ba4e84b4c2",
                                "text": "Disons dès à présent que cette cause est la présence […] de ces métaux , dont une quotité presque infinitésimale suffit pour rendre le fer, et à plus forte raison l'acier fondu, inforgeable et insoudable."
                            },
                            {
                                "example_id": "da194750-68e8-420e-9019-1577271f747b",
                                "sense_id": "35086d01-5442-3c13-b318-f6ba4e84b4c2",
                                "text": "Jeune homme, permettez-moi de vous donner un conseil : élevez-vous au-dessus de tout. Planez, jeune homme ! Planez, ouvrez vos ailes, projetez tous vos petits problèmes dans l'infini, dans l'astral, dans la métaphysique et vous verrez aussitôt apparaître les véritables proportions de toute chose qui sont, jeune homme, infinitésimales."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa123446-c0c8-354d-b464-0fedcb170bc1",
                        "entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "glosses": [
                            "Qualifie la partie des mathématiques qui a pour but l’étude des grandeurs considérées comme sommes de leurs accroissements infiniment petits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7f0ea4-e561-4f8c-a942-9d4ad13a8970",
                                "sense_id": "fa123446-c0c8-354d-b464-0fedcb170bc1",
                                "text": "L’analyse infinitésimale est formée du calcul différentiel se rapportant au calcul des dérivées et du calcul intégral qui a pour objet la théorie de l’intégration."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04993a5-d239-4ce2-9e29-22fd4dad5009",
                        "source_entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "target_lang_word": "unendlich klein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cadc8f98-8acb-41ef-b1bd-b11a38e2f772",
                        "source_entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "target_lang_word": "infinitesimal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinitesimal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "659d14b9-ec52-3eca-a23e-95e9e3c207b0",
                                        "entry_id": "a567786a-5dcc-3f4c-9045-7bd1e11e5c95",
                                        "glosses": [
                                            "betragsmäßig unendlich klein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6969cc2e-8e45-4804-b43d-84285a0d9c64",
                                                "sense_id": "659d14b9-ec52-3eca-a23e-95e9e3c207b0",
                                                "text": "Die Wahrscheinlichkeit, durch eine Wand zu fallen, ist infinitesimal."
                                            },
                                            {
                                                "example_id": "7cef4356-f15a-49a0-94ea-321d51d864b6",
                                                "sense_id": "659d14b9-ec52-3eca-a23e-95e9e3c207b0",
                                                "text": "„Sie führten Grenzwertbetrachtungen ein, die die Nutzung infinitesimaler Größen überflüssig machten.“"
                                            },
                                            {
                                                "example_id": "db9f2e81-453d-4d37-86a9-e34d42e8eb2b",
                                                "sense_id": "659d14b9-ec52-3eca-a23e-95e9e3c207b0",
                                                "text": "„Wenn der „folgende Zeitpunkt“ nur infinitesimal vom jetzigen entfernt ist, heißt der Vorgang stetig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65f8062c-7819-4a95-85ec-bbae23a77580",
                        "source_entry_id": "058c24e4-7a8e-3245-8386-e93602925af5",
                        "target_lang_word": "infinitesimal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinitesimal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f218ab2-6025-36f1-ae2c-586aa75db5ac",
                                        "entry_id": "1feb580d-7d2b-3ec7-87ca-c50505c8de2d",
                                        "glosses": [
                                            "Incalculably, exceedingly, or immeasurably minute; vanishingly small."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46674741-0965-4fa6-b130-5d8d22e6f1a7",
                                                "sense_id": "1f218ab2-6025-36f1-ae2c-586aa75db5ac",
                                                "text": "Do you ever get the feeling that you are but an infinitesimal speck, swallowed by the vastness of the universe and beyond?"
                                            },
                                            {
                                                "example_id": "88bd40c1-74e3-4b4a-843c-646126032ca8",
                                                "sense_id": "1f218ab2-6025-36f1-ae2c-586aa75db5ac",
                                                "text": "\"You will conceive a bunch of grapes,\" said he, \"which are covered by some infinitesimal but noxious bacillus.\""
                                            },
                                            {
                                                "example_id": "7029feb5-412f-483d-bdf4-f7ed968635da",
                                                "sense_id": "1f218ab2-6025-36f1-ae2c-586aa75db5ac",
                                                "text": "Then you could say that the doorway exploded. But the particular verb doesn't do the action justice. Rather, it shattered into infinitesimal pieces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a9b20a-90e7-3779-901a-365b35ca4de9",
                                        "entry_id": "1feb580d-7d2b-3ec7-87ca-c50505c8de2d",
                                        "glosses": [
                                            "Of or pertaining to non-zero quantities whose magnitude is less than any positive rational number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf92c23d-2328-37f9-934a-c29e49179c4f",
                                        "entry_id": "1feb580d-7d2b-3ec7-87ca-c50505c8de2d",
                                        "glosses": [
                                            "Very small."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinitesimal",
                                "target_lang_code": "en",
