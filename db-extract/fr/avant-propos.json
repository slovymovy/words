                "forms": [],
                "senses": [
                    {
                        "sense_id": "728268f9-b51d-3448-a628-881478550237",
                        "entry_id": "6dc31913-af8e-364d-95a8-f6d6c33625a2",
                        "glosses": [
                            "Sorte de courte introduction mise en tête d’un livre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34972e6-8e8d-4af6-8a35-fe660999f2fd",
                                "sense_id": "728268f9-b51d-3448-a628-881478550237",
                                "text": "Il y a un long avant-propos à la tête de cet ouvrage."
                            }
                        ]
                    },
                    {
                        "sense_id": "9def6087-1c2d-3083-a18b-1dca9b236e48",
                        "entry_id": "6dc31913-af8e-364d-95a8-f6d6c33625a2",
                        "glosses": [
                            "Ce qu’on dit avant de venir au fait, quand on entreprend de raconter quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919e52a7-10eb-43df-8111-5b672f80c8c3",
                                "sense_id": "9def6087-1c2d-3083-a18b-1dca9b236e48",
                                "text": "Il a fait un avant-propos bien inutile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f802277b-c819-4165-8963-e9bf45aec79a",
                        "source_entry_id": "6dc31913-af8e-364d-95a8-f6d6c33625a2",
                        "source_sense_id": "728268f9-b51d-3448-a628-881478550237",
                        "source_sense_description": "Sorte de courte introduction mise en tête d’un livre",
                        "target_lang_word": "Vorwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                        "entry_id": "3a10c1ee-ddf9-338e-869c-f02a113897ad",
                                        "glosses": [
                                            "Einleitung eines Buches, Vorrede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6954731-80ec-44c9-bcb0-83a98a4d8fc1",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "Viele Bücher enthalten ein Vorwort, in dem der Verfasser in die Thematik des jeweiligen Werkes einführt."
                                            },
                                            {
                                                "example_id": "573a91a7-2306-4e42-ad23-dcd8915e9f6c",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "„Nun weiß ich nicht recht, wie und warum ich ein Vorwort zu meinem Tagebuch schreiben sollte.“"
                                            },
                                            {
                                                "example_id": "62626157-c8e5-4e7a-83c6-dae74d10460d",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "„Doch nun zu dem Problem, dessentwegen ich dieses Vorwort verfasse.“"
                                            },
                                            {
                                                "example_id": "c72e9e41-6713-4e81-9902-e651122cef9f",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "„Und dass Ole Jacobsen tatsächlich tot war, sah man an einem merkwürdigen Setzfehler im Vorwort.“"
                                            },
                                            {
                                                "example_id": "17c799fe-80cc-49c0-928c-44e983ca3dd7",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "„Den Satz habe ich aus dem Vorwort gefischt.“"
                                            },
                                            {
                                                "example_id": "ebdb0e07-f0a7-4679-8809-628cc3594584",
                                                "sense_id": "1330c714-0db9-30f7-82ed-2fb5ef8045cb",
                                                "text": "„Meine Freunde machen sich schon seit langem darüber lustig, daß keines meiner Bücher ohne ein Vorwort erscheint. Ja, ich hab auch schon Bücher mit zwei oder drei Vorworten zustande gebracht!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Vorwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78c66a80-3cca-3ab4-bfcc-521dbc338110",
                                        "entry_id": "0d9982bd-b767-34ac-b4c6-af419ef8c22b",
                                        "glosses": [
                                            "Bezeichnung für Präposition"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
