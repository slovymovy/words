    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "72453fcc-6254-31a5-93cf-dfb7ced6609b",
                "word": "hootenanny",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6cd800cd-392a-4d39-8305-f0bcdb3ccb90",
                        "entry_id": "72453fcc-6254-31a5-93cf-dfb7ced6609b",
                        "tags": [
                            "plural"
                        ],
                        "form": "hootenannies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a86671ab-1783-3c31-bef1-0af7dd0bd591",
                        "entry_id": "72453fcc-6254-31a5-93cf-dfb7ced6609b",
                        "glosses": [
                            "An informal, festive performance by folk singers, often including audience participation with the use of acoustic instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56abe7b6-968c-4d69-bfa6-723e7be81d74",
                                "sense_id": "a86671ab-1783-3c31-bef1-0af7dd0bd591",
                                "text": "The brain matches the mind-image of doughnuts to images and emotions stored in his brain’s memory regions: “Mmmm … doughnuts.” Then—bingo!—his brain’s dopamine-producing reward centres light up and have a rip-roaring hootenanny."
                            },
                            {
                                "example_id": "6867849f-fc7c-42d9-baa3-9a93662c4c67",
                                "sense_id": "a86671ab-1783-3c31-bef1-0af7dd0bd591",
                                "text": "It bespoke country’s devotion to realism, to songs about Saturday night’s hootenanny and Sunday morning’s moral reckoning, not to mention the kitchen-table truths of Monday through Friday."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d33f39f-80e7-36f5-9867-69cfbe2b7489",
                        "entry_id": "72453fcc-6254-31a5-93cf-dfb7ced6609b",
                        "glosses": [
                            "A placeholder word for a nonspecific or forgotten thing."
                        ],
