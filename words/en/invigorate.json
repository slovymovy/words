    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5db98ecd-70ad-3b69-999d-24b0ee5956fb",
                    "sense_definition": "To give strength, energy, or vitality to someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen_vitalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A brisk morning walk in the crisp air can <w>invigorate</w> you for the entire day.",
                            "target_lang_translations": {
                                "ru": "Быстрая утренняя прогулка на свежем воздухе может <w>взбодрить</w> вас на весь день."
                            }
                        },
                        {
                            "text": "The refreshing splash of cold water helped to <w>invigorate</w> his tired mind.",
                            "target_lang_translations": {
                                "ru": "Освежающий всплеск холодной воды помог <w>прояснить</w> его уставший разум."
                            }
                        }
                    ],
                    "synonyms": [
                        "energize",
                        "revitalize",
                        "refresh",
                        "stimulate"
                    ],
                    "antonyms": [
                        "drain",
                        "exhaust",
                        "fatigue"
                    ],
                    "common_phrases": [
                        "invigorate the economy",
                        "invigorate the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать силы, энергию или бодрость кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бодрить",
                                "target_lang_sense_clarification": "придавать бодрости и энергии"
                            },
                            {
                                "target_lang_word": "взбадривать",
                                "target_lang_sense_clarification": "приводить в бодрое состояние, возвращать силы"
                            },
                            {
                                "target_lang_word": "тонизировать",
                                "target_lang_sense_clarification": "стимулировать жизненные силы, освежать"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать физически крепче, придавать сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5cc41d-71d8-3878-98d7-38814ee50401",
                    "sense_definition": "To heighten, intensify, or make something more active and lively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strengthen_vitalize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected arrival of new talent helped <w>invigorate</w> the stale debate.",
                            "target_lang_translations": {
                                "ru": "Неожиданное появление новых талантов помогло <w>оживить</w> зашедшие в тупик дебаты."
                            }
                        },
                        {
                            "text": "Lower tax rates were proposed to <w>invigorate</w> industrial growth across the region.",
                            "target_lang_translations": {
                                "ru": "Для того чтобы <w>стимулировать</w> промышленный рост во всем регионе, было предложено снизить налоговые ставки."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensify",
                        "quicken",
                        "animate"
                    ],
                    "antonyms": [
                        "dampen",
                        "stifle"
                    ],
                    "common_phrases": [
                        "invigorate growth",
                        "invigorate debate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Усиливать, активизировать или делать что-либо более живым и динамичным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлять",
                                "target_lang_sense_clarification": "вносить живость, делать более активным"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "побуждать к развитию или росту"
                            },
                            {
                                "target_lang_word": "активизировать",
                                "target_lang_sense_clarification": "делать более интенсивным и деятельным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba5e50f1-2c59-397c-bba7-bd5b25895c19",
                    "sense_definition": "Filled with vigour; <w>invigorated</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt renewed and <w>invigorate</w> after resting in the shade of the grand oak.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя обновлённым и <w>полным сил</w> после отдыха в тени величественного дуба."
                            }
