                "senses": [
                    {
                        "sense_id": "7981a95a-4e84-389a-98bf-f67be5e250c1",
                        "entry_id": "c289c3ae-a8f7-3190-9818-ee3be2bb42e3",
                        "glosses": [
                            "Scheune, die auf einer landwirtschaftlichen Fläche (im freien Feld) errichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984a3fd1-b4d2-414b-86c1-7472b469bac5",
                                "sense_id": "7981a95a-4e84-389a-98bf-f67be5e250c1",
                                "text": "„Nicht weit davon hielten wir an einer halboffenen Feldscheune, um die Büsche standen.“"
                            },
                            {
                                "example_id": "9ae4c3a4-3cfc-474c-be87-9e5e22b067d3",
                                "sense_id": "7981a95a-4e84-389a-98bf-f67be5e250c1",
                                "text": "„Kurz vor dem Dorfe bei der Feldscheune verabschieden sich zwei Drähte und gehen auf eigenen Stangen zum auffrisierten Guts-Schafstall.“"
                            },
                            {
                                "example_id": "ec2add9d-81fc-489c-b204-77e348d9d48b",
                                "sense_id": "7981a95a-4e84-389a-98bf-f67be5e250c1",
                                "text": "„Die Herde weidet am Flußufer, und wir übernachten in einer Feldscheune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
