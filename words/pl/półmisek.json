{
    "word_family": [
        "miska",
        "misa",
        "miseczka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0485747c-40e0-38f3-9fd4-0f53a1132aab",
                    "sense_definition": "duże, zazwyczaj podłużne i płytkie naczynie używane do podawania potraw na stół",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kelner postawił na stole duży <w>półmisek</w> z pieczonym mięsem.",
                            "target_lang_translations": {
                                "ru": "Официант поставил на стол большое <w>блюдо</w> с запечённым мясом."
                            }
                        },
                        {
                            "text": "Do serwowania ryb najlepiej sprawdzi się owalny <w>półmisek</w>.",
                            "target_lang_translations": {
                                "ru": "Для подачи рыбы лучше всего подойдёт овальное <w>блюдо</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plater"
                    ],
                    "common_phrases": [
                        "półmisek wędlin",
                        "owalny półmisek",
                        "półmisek z mięsem"
                    ],
                    "target_lang_definitions": {
                        "ru": "большое, обычно продолговатое и неглубокое блюдо для подачи еды на стол"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блюдо",
                                "target_lang_sense_clarification": "большая плоская тарелка для подачи еды"
                            },
                            {
                                "target_lang_word": "поднос",
                                "target_lang_sense_clarification": "сервировочный поднос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00dfea02-2174-3149-95e5-3609fa9a886b",
                    "sense_definition": "ilość jedzenia mieszcząca się na takim naczyniu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "miara_ilosci",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Głodni goście zjedli cały <w>półmisek</w> pierogów w kilka minut.",
                            "target_lang_translations": {
                                "ru": "Голодные гости съели целое <w>блюдо</w> вареников за несколько минут."
                            }
                        },
                        {
                            "text": "Na powitanie gospodyni przygotowała pełen <w>półmisek</w> kruchych ciastek.",
                            "target_lang_translations": {
                                "ru": "В знак приветствия хозяйка приготовила полное <w>блюдо</w> песочного печенья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cały półmisek",
                        "pełen półmisek"
                    ],
                    "target_lang_definitions": {
                        "ru": "количество еды, помещающееся на таком блюде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блюдо",
                                "target_lang_sense_clarification": "мера объёма пищи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}