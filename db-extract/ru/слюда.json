                                        "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                        "entry_id": "6e02cdaa-98b2-3601-8d75-8a4ad48ab028",
                                        "glosses": [
                                            "schimmerndes Mineral aus einer Gruppe der Schichtsilikate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c61dcc-5fa6-4769-bff2-887024e85e36",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "Mit der Spitzhacke schlug er den Glimmer aus dem Fels."
                                            },
                                            {
                                                "example_id": "271e60a4-65ee-4dc3-a383-8d3bbb6b6bfc",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "Glimmer finden sich überall auf der Welt."
                                            },
                                            {
                                                "example_id": "a732a02f-670b-4417-b87e-1168c4fa78ce",
                                                "sense_id": "52e1e8d4-94e2-347e-8c04-1a8e0a4a8063",
                                                "text": "„Kaiser dieser Welt hatten sich hier im Glimmer von Kristallen, Quarz und Achat den Segen abgeholt, um ihre Macht auf den Schlachtfeldern zu festigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                        "entry_id": "6e02cdaa-98b2-3601-8d75-8a4ad48ab028",
                                        "glosses": [
                                            "etwas, das glänzt oder schimmert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "121bd761-94fa-4c41-a2f8-2b2acb7932df",
                                                "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                                "text": "„Du bist eher der romantische Typ und nicht wirklich Fan von Glitter und Glimmer? Dann greif zu Pastellfarben.“"
                                            },
                                            {
                                                "example_id": "df0dc5b6-a11f-4c1e-8475-aada81201533",
                                                "sense_id": "cdb51ec8-93e2-3d5d-b71f-4cadbe640d67",
                                                "text": "„Janoschs Traum blieb für immer die »Rummelbudenkultur« mit Glimmer, Glitzer, Katzengold, Pink und Rot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
