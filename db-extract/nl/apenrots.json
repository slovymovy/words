                        "examples": [
                            {
                                "example_id": "6612fabb-2e3d-49ff-8fe3-718f06d19373",
                                "sense_id": "c73b9ec5-6100-3ff6-980a-0e9e30d80187",
                                "text": "1938 January 8, \"Rotterdam krijgt een nieuwe moderne diergaarde\", Leeuwarder Nieuwsblad, issue 8919, second edition, page 4.\nHier zal een moderne dierentuin verrijzen met roofdierenterrassen, apenrotsen en alles wat verder tot de inventaris behoort.",
                                "translation": "A modern zoo is going to be built here with enclosures for predators, monkey rocks and everything else that belongs to the inventory.",
                                "english": "A modern zoo is going to be built here with enclosures for predators, monkey rocks and everything else that belongs to the inventory."
                            }
                        ]
                    },
                    {
                        "sense_id": "9200b9a8-1403-3ee5-80e3-022abe917d30",
                        "entry_id": "e2486443-4289-30df-b671-954e99419040",
                        "glosses": [
                            "a hierarchical world in which similar individuals live or work and which can appear silly from the perspective of an outsider, like the corporate world or the political world"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6d1ab10a-d0b4-4d1a-aadb-773809107695",
                                "sense_id": "9200b9a8-1403-3ee5-80e3-022abe917d30",
                                "text": "Ook zei Van der Voort dat 'Holleeder lager op de criminele apenrots zit dan de oprichter van No Surrender. Klaas heeft Willem uit de club gezet'.",
                                "translation": "Van der Voort also said that \"Holleeder is on a lower rung of the criminal hierarchy than the founder of No Surrender. Klaas threw Willem out of the club.\"",
                                "english": "Van der Voort also said that \"Holleeder is on a lower rung of the criminal hierarchy than the founder of No Surrender. Klaas threw Willem out of the club.\""
                            }
                        ]
