                "senses": [
                    {
                        "sense_id": "cc466ce7-fb42-3768-a65e-b96fb83a18fb",
                        "entry_id": "9d3bc977-16cb-3b1e-8b8d-d1191d565a08",
                        "glosses": [
                            "eintoriger Triumphbogen auf der Velia, einem Hügel in Rom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b366b85a-78c7-4370-9b96-065d6b1b0799",
                                "sense_id": "cc466ce7-fb42-3768-a65e-b96fb83a18fb",
                                "text": "„Zusammen mit den beiden Tempeltrompeten sind sie auch auf dem Titusbogen in Rom abgebildet, wo die Kultgegenstände im Triumphzug als Kriegsbeute mitgeführt werden.“"
                            },
                            {
                                "example_id": "2b6ff2a5-fcfd-4297-b135-fd6288bfdd89",
                                "sense_id": "cc466ce7-fb42-3768-a65e-b96fb83a18fb",
                                "text": "„Er dachte vielmehr daran, in Jerusalem eine Nachbildung des römischen Titusbogens zu errichten, den ein Relief ziert, auf dem römische Soldaten abgebildet sind, die ihre Kriegsbeute, unter anderem eine Menora (einen siebenarmigen Leuchter), aus dem Tempel schleppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
