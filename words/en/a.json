{
    "word_family": [
        "an"
    ],
    "entries": [
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "2e3186fb-7956-398f-b03c-5b7f25a01df7",
                    "sense_definition": "An unspecified example of (something); the indefinite article.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "indefinite_article",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anna, do you have <w>a</w> pen in your bag?",
                            "target_lang_translations": {
                                "ru": "Анна, у тебя есть <w>ручка</w> в сумке?"
                            }
                        },
                        {
                            "text": "There was <w>a</w> man here looking for you yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера здесь был <w>какой-то</w> человек, который тебя искал."
                            }
                        }
                    ],
                    "synonyms": [
                        "an"
                    ],
                    "antonyms": [
                        "the"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределенный артикль, указывающий на любой предмет из категории или на предмет, упоминаемый впервые."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какой-то",
                                "target_lang_sense_clarification": "неопределённый артикль; чаще всего не переводится"
                            },
                            {
                                "target_lang_word": "некий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "516356cb-0d29-3462-ac33-02787e297646",
                    "sense_definition": "One; used before score, dozen, hundred, thousand, million, etc.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have seen that movie <w>a</w> hundred times already.",
                            "target_lang_translations": {
                                "ru": "Я видел этот фильм уже <w>целую</w> сотню раз."
                            }
                        },
                        {
                            "text": "The line to get back up stretches the length of <w>a</w> football field.",
                            "target_lang_translations": {
                                "ru": "Очередь, чтобы подняться обратно, растянулась на длину <w>одного</w> футбольного поля."
                            }
                        }
                    ],
                    "synonyms": [
                        "one"
                    ],
                    "common_phrases": [
                        "a hundred",
                        "a dozen",
                        "a thousand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один; используется перед числительными, такими как сотня, тысяча, миллион и т. д."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "один",
                                "target_lang_sense_clarification": "в значении количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b2b356-36e3-3182-babb-395081c5455c",
                    "sense_definition": "Used in some phrases denoting quantity, such as a few, a couple, a little, a bit, etc.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They asked me <w>a</w> few questions during the interview.",
                            "target_lang_translations": {
                                "ru": "Во время интервью мне задали <w>несколько</w> вопросов."
                            }
                        },
                        {
                            "text": "He is <w>a</w> bit tired after the long walk.",
                            "target_lang_translations": {
                                "ru": "Он <w>немного</w> устал после долгой прогулки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a few",
                        "a little",
                        "a bit",
                        "a couple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в некоторых фразах, обозначающих количество, таких как «несколько», «немного» и т. д."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несколько",
                                "target_lang_sense_clarification": "в составе фразы a few"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "в составе фразы a little"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e52c752c-f847-3238-84c6-36c27efb3560",
                    "sense_definition": "Any; used with a negative to indicate not a single one.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "negation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was so dark that we could not see <w>a</w> thing.",
                            "target_lang_translations": {
                                "ru": "Было так темно, что мы не могли видеть <w>ни</w> зги."
                            }
                        },
                        {
                            "text": "My conscience would give me not <w>a</w> moment's peace.",
                            "target_lang_translations": {
                                "ru": "Совесть не давала мне <w>ни</w> минуты покоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "one"
                    ],
                    "common_phrases": [
                        "not a thing",
                        "not a single"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ни один; используется с отрицанием для усиления значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ни один",
                                "target_lang_sense_clarification": "в отрицательных предложениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f32cd5e4-c4d5-3278-b1bd-d4f458121000",
                    "sense_definition": "Used in some adverbial phrases denoting the degree or extent of an action, such as a little, a bit, a lot, etc.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The door was opened <w>a</w> little to let in some air.",
                            "target_lang_translations": {
                                "ru": "Дверь приоткрыли <w>совсем</w> чуть-чуть, чтобы впустить немного воздуха."
                            }
                        },
                        {
                            "text": "He plays basketball <w>a</w> lot during his free time.",
                            "target_lang_translations": {
                                "ru": "В свободное время он <w>много</w> играет в баскетбол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a lot",
                        "a little bit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в наречных фразах, обозначающих степень или меру действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "в составе фразы a little"
                            },
                            {
                                "target_lang_word": "много",
                                "target_lang_sense_clarification": "в составе фразы a lot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94b09b92-77b5-3398-bbe3-c57b1a8820d3",
                    "sense_definition": "Any; every; used before a noun which has become modified to limit its scope.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "generalization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>A</w> man who dies without a will leaves his children many difficulties.",
                            "target_lang_translations": {
                                "ru": "<w>Человек</w>, умирающий без завещания, оставляет своим детям много трудностей."
                            }
                        },
                        {
                            "text": "<w>A</w> student who works hard will usually succeed in exams.",
                            "target_lang_translations": {
                                "ru": "<w>Любой</w> студент, который усердно учится, обычно успешно сдает экзамены."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "every"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой; каждый; используется перед существительным для обобщения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любой",
                                "target_lang_sense_clarification": "в значении обобщения"
                            },
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "при описании общих правил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06ccd1c0-d9d4-309d-b9bd-9a5af46496ab",
                    "sense_definition": "The same; one and the same. Used in phrases such as of a kind, birds of a feather, etc.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sameness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are two of <w>a</w> kind and always agree with each other.",
                            "target_lang_translations": {
                                "ru": "Они <w>одного</w> поля ягоды и всегда соглашаются друг с другом."
                            }
                        },
                        {
                            "text": "We are of <w>a</w> mind on matters of morals and ethics.",
                            "target_lang_translations": {
                                "ru": "Мы <w>едины</w> во мнении по вопросам морали и этики."
                            }
                        }
                    ],
                    "synonyms": [
                        "one"
                    ],
                    "common_phrases": [
                        "of a kind",
                        "of a mind",
                        "birds of a feather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот же самый; один и тот же. Используется в устойчивых выражениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "один и тот же",
                                "target_lang_sense_clarification": "в устойчивых выражениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aabfb9d-cea6-3a7c-a06a-cc2366f413aa",
                    "sense_definition": "Someone or something like; similar to; used before a proper noun to create an example out of it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man is <w>a</w> regular Romeo when it comes to romance.",
                            "target_lang_translations": {
                                "ru": "Этот парень — <w>настоящий</w> Ромео, когда дело касается романтики."
                            }
                        },
                        {
                            "text": "The center of the small village was becoming <w>a</w> Times Square.",
                            "target_lang_translations": {
                                "ru": "Центр маленькой деревушки превращался в <w>своего рода</w> Таймс-сквер."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a regular"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подобный кому-то или чему-то; используется перед именем собственным для создания нарицательного образа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "в значении подобия известному лицу"
                            },
                            {
                                "target_lang_word": "своего рода",
                                "target_lang_sense_clarification": "для сравнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1e5e2ef-2ee3-3a62-813e-577de9feda1f",
                    "sense_definition": "One; someone named; used before a person's name, suggesting that the speaker knows little about the person other than the name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unfamiliarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have received an interesting letter from <w>a</w> Mrs. Miggins of London.",
                            "target_lang_translations": {
                                "ru": "Мы получили интересное письмо от <w>некой</w> миссис Миггинс из Лондона."
                            }
                        },
                        {
                            "text": "There is <w>a</w> Mr. Smith on the phone waiting to speak with you.",
                            "target_lang_translations": {
                                "ru": "Там <w>какой-то</w> мистер Смит на линии, хочет поговорить с вами."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Некий; некто по имени; используется перед фамилией незнакомого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "некий",
                                "target_lang_sense_clarification": "перед фамилией незнакомца"
                            },
                            {
                                "target_lang_word": "какой-то",
                                "target_lang_sense_clarification": "о незнакомом человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e177fe-87de-3ebe-b675-1e2393389042",
                    "sense_definition": "The name of the Latin script letter A / a.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loop through the lowercase <w>a</w> is similar in both notes.",
                            "target_lang_translations": {
                                "ru": "Петля в строчной букве <w>а</w> одинакова в обеих записях."
                            }
                        },
                        {
                            "text": "He drew an <w>a</w> on some paper and asked them what it was.",
                            "target_lang_translations": {
                                "ru": "Он нарисовал букву <w>а</w> на бумаге и спросил их, что это такое."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lowercase a",
                        "uppercase a"
                    ],
                    "target_lang_definitions": {
                        "ru": "Название буквы латинского алфавита A / a."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "название буквы"
                            },
                            {
                                "target_lang_word": "эй",
                                "target_lang_sense_clarification": "английское произношение буквы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8ae3394-2448-341f-a58e-86a7f8314c54",
                    "sense_definition": "Answer.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "abbreviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your <w>a</w> in the space provided below the question.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите ваш <w>ответ</w> в отведенном месте под вопросом."
                            }
                        },
                        {
                            "text": "The teacher marked the <w>a</w> as correct on the exam paper.",
                            "target_lang_translations": {
                                "ru": "Учитель отметил <w>ответ</w> как правильный в экзаменационной работе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "q and a"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответ (сокращение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "О",
                                "target_lang_sense_clarification": "сокращение от «ответ»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d764c997-ea4b-329d-96e6-e3d7e40a6ba4",
                    "sense_definition": "Ace. (including in card games)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the <w>a</w> of spades in his hand during the final round.",
                            "target_lang_translations": {
                                "ru": "Во время финального раунда он держал в руке пикового <w>туза</w>."
                            }
                        },
                        {
                            "text": "The player discarded an <w>a</w> to win the card game.",
                            "target_lang_translations": {
                                "ru": "Игрок сбросил <w>туза</w>, чтобы выиграть в карты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a of spades",
                        "a of hearts"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Туз (в карточных играх)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Т",
                                "target_lang_sense_clarification": "обозначение туза на картах"
                            },
                            {
                                "target_lang_word": "туз",
                                "target_lang_sense_clarification": "название игральной карты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "b4325845-177d-3302-8e04-99016f0e2bb7",
                    "sense_definition": "To do with time; Each, per, in, on, by. Often occurs between two nouns, where the first noun occurs at the end of a verbal phrase.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frequency_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I brush my teeth twice <w>a</w> day to keep them healthy.",
                            "target_lang_translations": {
                                "ru": "Я чищу зубы дважды <w>в</w> день, чтобы они были здоровыми."
                            }
                        },
                        {
                            "text": "The requests grew on average by 28 percent <w>a</w> year.",
                            "target_lang_translations": {
                                "ru": "Количество запросов росло в среднем на 28 процентов <w>в</w> год."
                            }
                        }
                    ],
                    "common_phrases": [
                        "twice a day",
                        "once a week",
                        "miles a minute"
                    ],
                    "target_lang_definitions": {
                        "ru": "В; в течение; за. Используется для обозначения частоты или распределения во времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в",
                                "target_lang_sense_clarification": "при указании частоты (в день)"
                            },
                            {
                                "target_lang_word": "за",
                                "target_lang_sense_clarification": "при указании периода (за год)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "2c872091-1635-3626-94bb-008bd5fd44a2",
                    "sense_definition": "The ordinal number first, derived from this letter of the English alphabet, called a and written in the Latin script.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ordering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Item <w>a</w> is foods, while item b is drinks on the list.",
                            "target_lang_translations": {
                                "ru": "Пункт <w>а</w> в списке — это еда, а пункт б — напитки."
                            }
                        },
                        {
                            "text": "Please look at section <w>a</w> of the document for more details.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, посмотрите раздел <w>а</w> документа для получения более подробной информации."
                            }
                        }
                    ],
                    "synonyms": [
                        "one",
                        "first"
                    ],
                    "common_phrases": [
                        "item a",
                        "section a"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первый по порядку; пункт «а»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "а",
                                "target_lang_sense_clarification": "первый пункт в списке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26addee1-dcf6-3549-9c30-629283a8b2ae",
                    "sense_definition": "Have (auxiliary verb).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "auxiliary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would <w>a</w> come if you had asked me earlier.",
                            "target_lang_translations": {
                                "ru": "Я <w>бы</w> пришел, если бы ты попросил меня раньше."
                            }
                        },
                        {
                            "text": "He could <w>a</w> reached out and touched the boat as it passed.",
                            "target_lang_translations": {
                                "ru": "Он мог <w>бы</w> протянуть руку и коснуться лодки, когда она проплывала мимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "would a",
                        "could a",
                        "should a"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal speech or dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспомогательный глагол «have» в разговорной речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бы",
                                "target_lang_sense_clarification": "передает сослагательное наклонение в разговорной форме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}