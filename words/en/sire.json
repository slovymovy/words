            "senses": [
                {
                    "sense_id": "a20af737-1b80-36a2-bcd0-1a67c779c986",
                    "sense_definition": "A male parent of an animal, especially a domestic animal such as a horse or dog.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_father",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion stallion became the most sought-after <w>sire</w> in the entire country."
                        },
                        {
                            "text": "Breeders carefully checked the pedigree to identify the <w>sire</w> and dam of the foal."
                        }
                    ],
                    "common_phrases": [
                        "sire and dam"
                    ]
                },
                {
                    "sense_id": "fc057a8b-5378-3b69-b892-70701ce80b98",
                    "sense_definition": "A respectful form of address used to a monarch or sovereign.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight bowed low and replied, \"I will obey your command at once, <w>sire</w>.\""
                        },
                        {
                            "text": "The messenger knelt before the throne, waiting for <w>sire</w> to grant him permission to speak."
                        }
                    ],
                    "traits": [
                        {
