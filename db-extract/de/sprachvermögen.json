                        "glosses": [
                            "Fähigkeit des Menschen, Sprache zu beherrschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "452d6bda-eb65-4a30-9ff0-9d106b0b8344",
                                "sense_id": "0d8c7f64-3520-3402-ba09-93a1af7d9d20",
                                "text": "„Das Sprachvermögen des Menschen macht 95 Prozent oder mehr dessen aus, was ihn über das Tier erhebt!“"
                            },
                            {
                                "example_id": "f6bef0b0-d5a2-41ac-b3e2-77620d433d33",
                                "sense_id": "0d8c7f64-3520-3402-ba09-93a1af7d9d20",
                                "text": "„Bei Tisch sagte man mir, man habe den Griechen zur Ader gelassen, und er habe die Bewegungsfähigkeit seiner Augen wiedererlangt, nicht jedoch das Sprachvermögen und nicht die Herrschaft über seine Gliedmaßen.“"
                            }
                        ],
