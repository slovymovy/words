{
    "word_family": [
        "curable",
        "incurable",
        "curative",
        "curer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1243e5c-5c95-324f-b5b8-4df90742dae0",
                    "sense_definition": "To restore a person or animal to health; to heal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health_healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used a new medicine to <w>cure</w> the patient.",
                            "target_lang_translations": {
                                "ru": "Врач использовал новое лекарство, чтобы <w>вылечить</w> пациента.",
                                "zh": "医生用一种新药<w>治愈</w>了病人。"
                            }
                        },
                        {
                            "text": "With proper rest and care, you can <w>cure</w> yourself of the flu.",
                            "target_lang_translations": {
                                "ru": "При должном отдыхе и уходе вы можете <w>вылечиться</w> от гриппа.",
                                "zh": "只要适当休息和护理，你就能<w>治好</w>流感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heal",
                        "remedy",
                        "make better"
                    ],
                    "antonyms": [
                        "sicken",
                        "infect"
                    ],
                    "common_phrases": [
                        "cure a patient",
                        "cure a disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить здоровье человека или животного; исцелить.",
                        "zh": "使人或动物恢复健康；治愈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылечить",
                                "target_lang_sense_clarification": "восстановить здоровье полностью"
                            },
                            {
                                "target_lang_word": "лечить",
                                "target_lang_sense_clarification": "процесс лечения"
                            },
                            {
                                "target_lang_word": "исцелить",
                                "target_lang_sense_clarification": "вернуть здоровье, часто чудесным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治愈",
                                "target_lang_sense_clarification": "使病痛完全消失"
                            },
                            {
                                "target_lang_word": "治疗",
                                "target_lang_sense_clarification": "进行医疗护理的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "908a7331-a014-31d4-b4ca-26336cc7ac55",
                    "sense_definition": "To cause a disease or illness to end or disappear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health_healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are working hard to <w>cure</w> cancer.",
                            "target_lang_translations": {
                                "ru": "Ученые усердно работают над тем, чтобы <w>излечить</w> рак.",
                                "zh": "科学家们正在努力寻找<w>根治</w>癌症的方法。"
                            }
                        },
                        {
                            "text": "This antibiotic will <w>cure</w> the infection within a week.",
                            "target_lang_translations": {
                                "ru": "Этот антибиотик <w>вылечит</w> инфекцию в течение недели.",
                                "zh": "这种抗生素在一周内就能<w>治愈</w>感染。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heal",
                        "remedy",
                        "eliminate"
                    ],
                    "common_phrases": [
                        "cure an illness",
                        "cure an infection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устранить болезнь или недуг.",
                        "zh": "使疾病或病症消失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излечить",
                                "target_lang_sense_clarification": "полностью устранить болезнь"
                            },
                            {
                                "target_lang_word": "вылечить",
                                "target_lang_sense_clarification": "сделать здоровым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根治",
                                "target_lang_sense_clarification": "彻底消除疾病"
                            },
                            {
                                "target_lang_word": "治好",
                                "target_lang_sense_clarification": "使病症痊愈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5245e6c9-4ebb-34b3-b093-92af0d6f5fac",
                    "sense_definition": "To cause someone to stop a bad habit or behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solution_problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope this experience will <w>cure</w> him of his constant lateness.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, этот опыт <w>отучит</w> его от постоянных опозданий.",
                                "zh": "我希望这次经历能让他<w>改掉</w>总是迟到的毛病。"
                            }
                        },
                        {
                            "text": "She tried to <w>cure</w> her dog of barking at strangers.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>отучить</w> свою собаку лаять на незнакомцев.",
                                "zh": "她试图<w>纠正</w>她家狗对着陌生人乱叫的习惯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cure of a habit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то избавиться от вредной привычки или поведения.",
                        "zh": "使某人改掉坏习惯或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отучить",
                                "target_lang_sense_clarification": "заставить бросить привычку"
                            },
                            {
                                "target_lang_word": "излечить",
                                "target_lang_sense_clarification": "перен. избавить от недостатка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改掉",
                                "target_lang_sense_clarification": "戒除某种习惯"
                            },
                            {
                                "target_lang_word": "纠正",
                                "target_lang_sense_clarification": "改正错误行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d70f7025-b606-36a3-9b4c-177389b16c0d",
                    "sense_definition": "To preserve food, especially meat or fish, by salting, smoking, or drying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preservation_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers used to <w>cure</w> meat to keep it edible during the winter.",
                            "target_lang_translations": {
                                "ru": "Раньше фермеры <w>вялили</w> мясо, чтобы сохранить его пригодным для еды зимой.",
                                "zh": "农民过去常把肉<w>腌制</w>起来，以便在冬天食用。"
                            }
                        },
                        {
                            "text": "The ham is <w>cured</w> with a special blend of spices and salt.",
                            "target_lang_translations": {
                                "ru": "Ветчину <w>засаливают</w> со специальной смесью специй и соли.",
                                "zh": "这种火腿是用特制的香料和盐<w>腌制</w>而成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cure meat",
                        "cure ham"
                    ],
                    "target_lang_definitions": {
                        "ru": "Консервировать продукты (особенно мясо или рыбу) путем соления, копчения или сушки.",
                        "zh": "通过腌制、熏制或干燥来保存食物（如肉或鱼）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вялить",
                                "target_lang_sense_clarification": "сушить на воздухе"
                            },
                            {
                                "target_lang_word": "консервировать",
                                "target_lang_sense_clarification": "сохранять продукты"
                            },
                            {
                                "target_lang_word": "заготавливать",
                                "target_lang_sense_clarification": "готовить впрок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腌制",
                                "target_lang_sense_clarification": "用盐或调料处理食物"
                            },
                            {
                                "target_lang_word": "熏制",
                                "target_lang_sense_clarification": "通过烟熏保存"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "396ccacb-4726-3375-80b3-361fd1a0775d",
                    "sense_definition": "To cause a material (such as rubber, plastic, or concrete) to harden or set permanently through a chemical or physical process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glue needs twenty-four hours to fully <w>cure</w>.",
                            "target_lang_translations": {
                                "ru": "Клею требуется двадцать четыре часа, чтобы полностью <w>затвердеть</w>.",
                                "zh": "这种胶水需要二十四小时才能完全<w>固化</w>。"
                            }
                        },
                        {
                            "text": "Heat is often used to <w>cure</w> the resin in the mold.",
                            "target_lang_translations": {
                                "ru": "Тепло часто используется для того, чтобы <w>отвердить</w> смолу в форме.",
                                "zh": "通常使用加热的方法来使模具中的树脂<w>固化</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить материал (резину, пластик или бетон) затвердеть или схватиться посредством химического или физического процесса.",
                        "zh": "通过化学或物理过程使材料（如橡胶、塑料或混凝土）永久硬化或凝固。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отверждать",
                                "target_lang_sense_clarification": "делать твердым"
                            },
                            {
                                "target_lang_word": "затвердевать",
                                "target_lang_sense_clarification": "становиться твердым"
                            },
                            {
                                "target_lang_word": "вулканизировать",
                                "target_lang_sense_clarification": "обрабатывать резину"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固化",
                                "target_lang_sense_clarification": "使材料变硬"
                            },
                            {
                                "target_lang_word": "硬化",
                                "target_lang_sense_clarification": "变得坚硬"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d331863e-527a-3699-8b25-034571b595a7",
                    "sense_definition": "A medicine, treatment, or method that restores health.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health_healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is currently no known <w>cure</w> for the common cold.",
                            "target_lang_translations": {
                                "ru": "В настоящее время нет известного <w>лекарства</w> от простуды.",
                                "zh": "目前还没有已知的感冒<w>特效药</w>。"
                            }
                        },
                        {
                            "text": "Doctors are searching for a <w>cure</w> for this rare disease.",
                            "target_lang_translations": {
                                "ru": "Врачи ищут <w>лекарство</w> от этой редкой болезни.",
                                "zh": "医生们正在寻找这种罕见疾病的<w>治疗方法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remedy",
                        "treatment"
                    ],
                    "antonyms": [
                        "disease",
                        "illness"
                    ],
                    "common_phrases": [
                        "find a cure",
                        "miracle cure",
                        "prevention and cure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарство, лечение или метод, восстанавливающий здоровье.",
                        "zh": "恢复健康的药物、疗法或方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарство",
                                "target_lang_sense_clarification": "препарат"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "метод лечения"
                            },
                            {
                                "target_lang_word": "лечение",
                                "target_lang_sense_clarification": "терапия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药物",
                                "target_lang_sense_clarification": "治疗用的药剂"
                            },
                            {
                                "target_lang_word": "疗法",
                                "target_lang_sense_clarification": "治疗的方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e9e9518-8ea0-383f-8633-ca13abe042fe",
                    "sense_definition": "A solution to a difficult problem or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "solution_problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is often seen as the best <w>cure</w> for poverty.",
                            "target_lang_translations": {
                                "ru": "Образование часто рассматривается как лучшее <w>средство</w> от бедности.",
                                "zh": "教育常被视为消除贫困的最好<w>良方</w>。"
                            }
                        },
                        {
                            "text": "There is no easy <w>cure</w> for the country's economic troubles.",
                            "target_lang_translations": {
                                "ru": "Не существует простого <w>решения</w> для экономических проблем страны.",
                                "zh": "这个国家的经济困境没有简单的<w>解决办法</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "problem"
                    ],
                    "common_phrases": [
                        "cure for inflation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решение сложной проблемы или ситуации.",
                        "zh": "解决困难问题或局面的方案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "способ решения"
                            },
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "выход из ситуации"
                            },
                            {
                                "target_lang_word": "панацея",
                                "target_lang_sense_clarification": "универсальное средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解决办法",
                                "target_lang_sense_clarification": "处理问题的方案"
                            },
                            {
                                "target_lang_word": "良方",
                                "target_lang_sense_clarification": "有效的解决途径"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5899f121-e70b-3519-b6b3-74953c0b5b31",
                    "sense_definition": "The process of healing or the state of being healed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health_healing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cure</w> took several months of therapy and rest.",
                            "target_lang_translations": {
                                "ru": "<w>Лечение</w> заняло несколько месяцев терапии и отдыха.",
                                "zh": "这次<w>康复</w>过程花费了几个月的治疗和休息。"
                            }
                        },
                        {
                            "text": "His sudden <w>cure</w> surprised all the medical staff.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>выздоровление</w> удивило весь медицинский персонал.",
                                "zh": "他突然的<w>康复</w>让所有医护人员感到惊讶。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс лечения или состояние выздоровления.",
                        "zh": "治愈的过程或康复的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выздоровление",
                                "target_lang_sense_clarification": "восстановление здоровья"
                            },
                            {
                                "target_lang_word": "лечение",
                                "target_lang_sense_clarification": "процесс терапии"
                            },
                            {
                                "target_lang_word": "исцеление",
                                "target_lang_sense_clarification": "факт излечения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康复",
                                "target_lang_sense_clarification": "恢复健康的状态"
                            },
                            {
                                "target_lang_word": "治疗",
                                "target_lang_sense_clarification": "治愈的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de631e84-c348-3c2d-8873-929f7f19bd3e",
                    "sense_definition": "A process of preserving food, such as smoking or salting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "preservation_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional <w>cure</w> gives the ham its distinctive flavor.",
                            "target_lang_translations": {
                                "ru": "Традиционный <w>способ засолки</w> придает ветчине ее характерный вкус.",
                                "zh": "传统的<w>腌制</w>工艺赋予了火腿独特的风味。"
                            }
                        },
                        {
                            "text": "We used a dry <w>cure</w> for the fish this year.",
                            "target_lang_translations": {
                                "ru": "В этом году мы использовали сухой <w>посол</w> для рыбы.",
                                "zh": "今年我们用干<w>腌法</w>来处理鱼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dry cure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс консервирования продуктов, например, копчение или соление.",
                        "zh": "保存食物的过程，如熏制或腌制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервирование",
                                "target_lang_sense_clarification": "процесс сохранения"
                            },
                            {
                                "target_lang_word": "засолка",
                                "target_lang_sense_clarification": "соление"
                            },
                            {
                                "target_lang_word": "вяление",
                                "target_lang_sense_clarification": "сушка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腌制",
                                "target_lang_sense_clarification": "保存食物的方法"
                            },
                            {
                                "target_lang_word": "熏制",
                                "target_lang_sense_clarification": "烟熏保存法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41ccdf7c-cbd3-33f7-842d-3481e1b085a3",
                    "sense_definition": "Spiritual charge or care of souls; the office of a parish priest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young priest was given the <w>cure</w> of a small village parish.",
                            "target_lang_translations": {
                                "ru": "Молодому священнику поручили <w>попечение</w> над небольшим сельским приходом.",
                                "zh": "这位年轻的牧师被委以重任，负责一个小村庄教区的<w>牧灵</w>工作。"
                            }
                        },
                        {
                            "text": "He took his duties regarding the <w>cure</w> of souls very seriously.",
                            "target_lang_translations": {
                                "ru": "Он очень серьезно относился к своим обязанностям по <w>попечению</w> о душах.",
                                "zh": "他非常认真地对待自己关于<w>牧灵</w>的职责。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curacy"
                    ],
                    "common_phrases": [
                        "cure of souls"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or ecclesiastical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Духовное окормление или забота о душах; должность приходского священника.",
                        "zh": "灵魂的属灵照管；教区牧师的职责。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "забота"
                            },
