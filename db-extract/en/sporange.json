                        "sense_id": "92733475-85b0-3a10-8783-830865b5c722",
                        "entry_id": "c0277466-24f8-3583-924c-9ae43a82d220",
                        "glosses": [
                            "A sporangium."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b85ed4d4-9a2c-4842-b992-3b28ef2ae07a",
                                "sense_id": "92733475-85b0-3a10-8783-830865b5c722",
                                "text": "The most immature of the sporanges have few or no papillae on them."
                            },
                            {
                                "example_id": "55955a5b-9c10-4077-8a41-6f945ca1777e",
                                "sense_id": "92733475-85b0-3a10-8783-830865b5c722",
                                "text": "If this were the cause we should expect to find the layer of denser plasm at the base of the sporange as well as on the sides and top, as we have no evidence that evaporation does not go on from the part of the sporange just around the sporangiophore as well as from the rest of its surface."
                            }
                        ]
                    }
                ],
