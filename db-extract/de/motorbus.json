                "senses": [
                    {
                        "sense_id": "da8253e6-4009-35e2-828e-54d9bd1773f7",
                        "entry_id": "5a40c7c2-cbb9-330d-a034-efd66159c52e",
                        "glosses": [
                            "von einem Motor (statt zum Beispiel Pferden) angetriebener Bus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b727a6-18ff-44dd-9d57-00733101a081",
                                "sense_id": "da8253e6-4009-35e2-828e-54d9bd1773f7",
                                "text": "„In den Straßen gab es kaum noch Pferdekutschen, hingegen sehr viel mehr Automobile, und auch die Pferdeomnibusse waren doppelstöckigen Motorbussen gewichen.“"
                            },
                            {
                                "example_id": "1e379c31-659b-43a1-abcd-c418005362b6",
                                "sense_id": "da8253e6-4009-35e2-828e-54d9bd1773f7",
                                "text": "„Ende des 19. Jahrhunderts stiegen die ersten Fahrgäste von der Kutsche in den Motorbus um - die Geburtsstunde der Kraftpost.“"
                            },
                            {
                                "example_id": "4cde0596-5de0-4e5f-b396-81275f62e330",
                                "sense_id": "da8253e6-4009-35e2-828e-54d9bd1773f7",
                                "text": "„Mit lautem „Töff, töff!“ und unter dem Gejohle vieler Berliner starteten am 19. November 1905, an einem Sonntag, die ersten beiden Motorbusse der städtischen Verkehrsbetriebe.“"
                            },
                            {
                                "example_id": "a84c8d55-0c50-4ec4-b44a-888f0d13724b",
                                "sense_id": "da8253e6-4009-35e2-828e-54d9bd1773f7",
                                "text": "„1907 musste auch diese letzte Pferdebahnverbindung dem technischen Fortschritt weichen, hier übernahmen nun Motorbusse den öffentlichen Verkehr. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
