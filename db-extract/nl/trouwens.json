        "nl-extract.jsonl": [
            {
                "entry_id": "afe95445-a585-30e3-84c0-11d395dd7640",
                "word": "trouwens",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                        "entry_id": "afe95445-a585-30e3-84c0-11d395dd7640",
                        "glosses": [
                            "overigens, in werkelijkheid, in waarheid, in zekerheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a384541c-32a8-481c-9f00-8c6b6c861f19",
                                "sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                                "text": "Hij is trouwens de leider van het team geworden."
                            },
                            {
                                "example_id": "2a8d0dbd-0b9e-4ab7-b966-9406470e7c37",
                                "sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                                "text": "' 'Haaaaaa Lotje, ik heb zo'n zin in een mueslireep, heb jij er nog een in die handige rugzak van je?' 'O Lot, trouwens, ik ga dood, dus misschien kun je mij helpen om beter te leven?' De buitenwereld is een kakofonie, een stemmenorkest dat me aldoor lijkt te roepen."
                            },
                            {
                                "example_id": "aa78da18-7749-47bf-aee1-a22ba9599e42",
                                "sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                                "text": "Net op het moment dat ik de boel wil gaan afsluiten, murmelt Olaf tussen neus en lippen: 'O ja, trouwens, klein dingetje ' 'Wat?' vraag ik. 'Nou ja, we hebben natuurlijk dat hele Jaap-verhaal! En, nou ja, er hebben zich meer vrouwen gemeld."
                            },
                            {
                                "example_id": "484e4285-e559-4e5c-99d5-421f540f6a6f",
                                "sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                                "text": "Mijn kinderen staan trouwens absoluut niet te trappelen om zelf ook lange wandelingen te gaan maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0bbf8dd-0b23-4349-a14b-c8f80c20e86a",
                        "source_entry_id": "afe95445-a585-30e3-84c0-11d395dd7640",
                        "source_sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                        "source_sense_description": "overigens",
                        "target_lang_word": "übrigens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "übrigens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b3e23f-8ada-3e3a-93c3-4b6ec2b3887d",
                                        "entry_id": "c92516cd-2e27-337e-a1cf-88badc6fbe25",
                                        "glosses": [
                                            "nebenbei bemerkt, gesagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec892f88-5dfd-4344-9f84-54b55a5297c9",
                                                "sense_id": "b6b3e23f-8ada-3e3a-93c3-4b6ec2b3887d",
                                                "text": "Ah, übrigens – wusstest du, dass wir ein neues Auto gekauft haben?"
                                            },
                                            {
                                                "example_id": "9aebaf3f-5843-471a-a279-21800d874632",
                                                "sense_id": "b6b3e23f-8ada-3e3a-93c3-4b6ec2b3887d",
                                                "text": "„Zur Tatwaffe befragt, sagte mein Sohn, ihm sei das Schießeisen – übrigens eine 7-mm-Tokarev aus sowjetischen Armeebeständen – schon vor eineinhalb Jahren zur Hand gewesen.“"
                                            },
                                            {
                                                "example_id": "4af35f2e-d2ed-40df-9631-ead0bfa566d4",
                                                "sense_id": "b6b3e23f-8ada-3e3a-93c3-4b6ec2b3887d",
                                                "text": "„Die ersten Absprachen wurden übrigens in den Knuttstuben (Strickstuben) zwischen den beteiligten Hausfrauen getroffen, aus deren Reihen sich später das Festkomitee rekrutierte, das jedem - vom Koch über die Backfrau bis zum Musikus - seine Aufgaben zuwies.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa441239-5dd4-407d-9d67-953a38542084",
                        "source_entry_id": "afe95445-a585-30e3-84c0-11d395dd7640",
                        "source_sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                        "source_sense_description": "overigens",
                        "target_lang_word": "by the way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by the way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cffdfdc4-0a90-3fc6-b3b0-5b6a0c36a0c1",
                                        "entry_id": "5a0237cf-352a-3c90-a1e0-cabe4f944ff2",
                                        "glosses": [
                                            "Incidentally; used in referencing a parenthetical statement not timely, central, or crucial to the topic at hand; foregone, passed by, something that has already happened."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "960ecbc3-56f7-4c24-a0ce-6006a5680d9e",
                                                "sense_id": "cffdfdc4-0a90-3fc6-b3b0-5b6a0c36a0c1",
                                                "text": "His mother will be coming for dinner tomorrow, and, by the way, she recently sold her collection of ceramic eggs."
                                            },
                                            {
                                                "example_id": "a0b9a8e6-11ac-4afd-aa51-a9b9a3504884",
                                                "sense_id": "cffdfdc4-0a90-3fc6-b3b0-5b6a0c36a0c1",
                                                "text": "[…] I had counted on a life-lease of the profits, whereas I only received those of a few short years. But this is by the way."
                                            },
                                            {
                                                "example_id": "99bddfa7-1eaf-4659-8deb-12c6b75cdd10",
                                                "sense_id": "cffdfdc4-0a90-3fc6-b3b0-5b6a0c36a0c1",
                                                "text": "“A very welcome, kind, useful present, that means to the parish. By the way, Hopkins, let this go no further. We don't want the tale running round that a rich person has arrived. Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing.[…]”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by the way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c86ccf-5468-39af-b0e2-2d5cd5d76cc3",
                                        "entry_id": "e2f36a7d-732d-3fcc-a5ec-7cff983d603c",
                                        "glosses": [
                                            "Irrelevantly, off-topic."
                                        ],
                                        "tags": [
                                            "UK",
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c7647f-e6a3-49fc-8156-5160340e6e92",
                        "source_entry_id": "afe95445-a585-30e3-84c0-11d395dd7640",
                        "source_sense_id": "d751832f-6683-3936-9029-73bd306e2550",
                        "source_sense_description": "overigens",
                        "target_lang_word": "au fait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au fait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fc3f670-bcc6-3ac3-afe6-609a22ac576c",
                                        "entry_id": "c62d3158-1015-3580-be67-7a1401aaa121",
                                        "glosses": [
                                            "Au courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90134f08-6e1c-4420-aea9-643640acaddb",
                                                "sense_id": "9fc3f670-bcc6-3ac3-afe6-609a22ac576c",
                                                "text": "La jeune femme, déjà passionnée par la nutrition infantile, est donc très au fait des enjeux des mille premiers jours de l’enfant et consciente que cette « fenêtre d’opportunités » est déterminante pour construire le capital santé d’un enfant et définir ses habitudes alimentaires."
                                            },
                                            {
                                                "example_id": "022939f2-3de1-453c-ae86-27014b50f14c",
                                                "sense_id": "9fc3f670-bcc6-3ac3-afe6-609a22ac576c",
                                                "text": "Il est au fait sur cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48aaac6a-9659-34f1-b8cc-dcf4ac6fe630",
                                        "entry_id": "c62d3158-1015-3580-be67-7a1401aaa121",
                                        "glosses": [
                                            "Habitude, habileté nécessaire pour faire certaines choses."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c2d5d0-b660-4bbb-a525-d2b16a5bf427",
                                                "sense_id": "48aaac6a-9659-34f1-b8cc-dcf4ac6fe630",
                                                "text": "Vous vous mettrez aisément au fait de cette affaire."
                                            },
                                            {
                                                "example_id": "e71e234f-1e99-442a-962b-99ac69ab488e",
                                                "sense_id": "48aaac6a-9659-34f1-b8cc-dcf4ac6fe630",
                                                "text": "Cette jeune fille est bien au fait du ménage."
                                            },
                                            {
                                                "example_id": "b682ce34-3f82-46bd-95a3-6e545bc3d533",
                                                "sense_id": "48aaac6a-9659-34f1-b8cc-dcf4ac6fe630",
                                                "text": "Il se fut bientôt mis au fait de son nouvel emploi."
                                            },
                                            {
                                                "example_id": "1806fde9-973a-4454-b43e-63354a045be3",
                                                "sense_id": "48aaac6a-9659-34f1-b8cc-dcf4ac6fe630",
                                                "text": "— Quoi donc faire d’un paysan quand on est au fait de causer avec un monsieur ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "au fait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1771be04-944b-38af-b0ec-88f5afd4611e",
                                        "entry_id": "9c5baa40-31e0-38a0-8b0e-3e061dfc02a3",
                                        "glosses": [
                                            "À propos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2223a9e2-f681-4b6e-b8b1-e5502f53f9d4",
                                                "sense_id": "1771be04-944b-38af-b0ec-88f5afd4611e",
                                                "text": "Il fallait encore gagner du temps mais, cette fois, je perdis pied :\n– Hein, dis donc, hé ! au fait, le moine maudit, qu'est-ce qu'il glandait, ce nase, ce radis noir, ce foutu ratichon ?"
                                            },
                                            {
                                                "example_id": "4838ca77-5042-4aa0-bf74-911f0f5d99fc",
                                                "sense_id": "1771be04-944b-38af-b0ec-88f5afd4611e",
                                                "text": "– Alors mon salaud, on fait sa feignasse, on se fait trimballer alors que les p’tits copains crapahutent ? Ah, au fait, ne t’en fais pas pour ce qui s’est passé là-haut. Je leur ai raconté qu’une de ces crapules t’avait estourbi par-derrière, et que je m’étais occupé de son cas aussitôt après… L’honneur est sauf ! dit-il avec un clin d’œil salace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba5e79e4-9d49-3408-a3fc-0f646145210c",
                                        "entry_id": "9c5baa40-31e0-38a0-8b0e-3e061dfc02a3",
                                        "glosses": [
                                            "Tout bien considéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9873003e-5133-463e-aefe-18e619aea492",
                                                "sense_id": "ba5e79e4-9d49-3408-a3fc-0f646145210c",
                                                "text": "Au fait, qu’est-ce que je risque ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
