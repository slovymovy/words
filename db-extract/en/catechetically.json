                        "examples": [
                            {
                                "example_id": "f81e156a-498b-4ce3-93af-023e1ce4c7e0",
                                "sense_id": "1ca3fc78-eb0e-3389-b58f-e9fa3403b06b",
                                "text": "If the professors were to teach catechetically, it would be (as far as relates to intellectual instruction) but a question of words. They would be so far \"Tutors\" under another name."
                            },
                            {
                                "example_id": "074f0ec0-f587-44ad-b670-cb63685ed0e6",
                                "sense_id": "1ca3fc78-eb0e-3389-b58f-e9fa3403b06b",
                                "text": "In the midst of a catechetically structured recital of the ills to which life is subject, \"Ithaca\"'s narrator asks, Did Stephen participate in his dejection?"
                            },
                            {
                                "example_id": "ee2a3022-94f8-4576-b501-198692d01b51",
                                "sense_id": "1ca3fc78-eb0e-3389-b58f-e9fa3403b06b",
                                "text": "Even where the audience knows the answers and recites them catechetically, the question-and-answer pattern reactivates the sense of wonder at again bringing the diverse elements of the world together, replaying the primal educational scene in which the correspondences and continuities were first dramatized"
                            }
                        ]
                    }
