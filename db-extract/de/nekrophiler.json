                        "glosses": [
                            "Person, deren sexuelle Triebe sich auf Leichen richten, ein Fall von Nekrophilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "866813a3-6276-4df3-b124-b0c23dae77c3",
                                "sense_id": "bbc38f28-7903-3839-8b2f-67368587fd40",
                                "text": "„Der König, Schwager Marie Antoinettes, ist Nekrophile; seine Frau, die berüchtigte Karoline, die bei Sade Charlotte heißt, Tribadin.“"
                            },
                            {
                                "example_id": "bbede95c-e619-4cd8-9930-2dd5f6d59175",
                                "sense_id": "bbc38f28-7903-3839-8b2f-67368587fd40",
                                "text": "„Wenigstens ist Duncan nicht von einem Nekrophilen als Spielzeug benutzt worden.“"
                            }
                        ],
