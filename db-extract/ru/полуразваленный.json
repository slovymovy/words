                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f4a2c3-f310-472e-915f-045b2c798baf",
                                                "sense_id": "29ec4bb2-16f1-3c35-89d0-d922ae2e62a2",
                                                "text": "Ein Freund hat sich vor zwei Jahren WoW gekauft und ist dem Wahn vollkommen verfallen."
