                                        "entry_id": "2b871af2-69ed-3019-a90c-29aaba8afc8f",
                                        "glosses": [
                                            "von Mitgliedern befreien, die einen Hintergrund als Mitglieder der NSDAP hatten oder Nationalsozialisten waren; Personen entfernen, die den Nationalsozialismus vertreten"
                                        ],
                                        "tags": [
                                            "historisch, nach dem 2. Weltkrieg",
                                            "über eine Organisation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6e04ad-b0a8-49da-a658-a83241583825",
                                                "sense_id": "95552bf9-6ffb-335a-a43a-16b47df20c70",
                                                "text": "Ziel der Maßnahmen war es, das Polizeiwesen zu entnazifizieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86814442-225d-3538-be35-1cab994acd95",
                                        "entry_id": "2b871af2-69ed-3019-a90c-29aaba8afc8f",
                                        "glosses": [
                                            "jemanden, der Nationalsozialist war, durch ein Untersuchungsverfahren entlasten oder nach einer Untersuchung bestrafen"
                                        ],
                                        "tags": [
                                            "historisch, nach dem 2. Weltkrieg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20081bae-dd3c-4ff8-9c4f-4cd7dc59c640",
                                                "sense_id": "86814442-225d-3538-be35-1cab994acd95",
                                                "text": "In der amerikanischen Besatzungszone waren die Verfahren vor den Spruchkammern ein wichtiges Instrument im Ansinnen, Personen mit einem nationalsozialistischen Hintergrund zu entnazifizieren."
                                            },
                                            {
                                                "example_id": "05eff28a-5c59-42b5-b553-c096fe4b5ae3",
                                                "sense_id": "86814442-225d-3538-be35-1cab994acd95",
                                                "text": "Eine Person, die ein Untersuchungsverfahren durchlaufen hatte und nicht schuldig war, galt direkt als entnazifiziert."
                                            },
                                            {
                                                "example_id": "28042622-281b-4ff0-80f4-96ce2944bad9",
                                                "sense_id": "86814442-225d-3538-be35-1cab994acd95",
                                                "text": "Ein Künstler, der im 3. Reich aktiv war, musste sich erst entnazifizieren lassen, bevor er wieder eine Auftrittserlaubnis erhielt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
