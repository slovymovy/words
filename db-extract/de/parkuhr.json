                        "glosses": [
                            "ein Gerät an einem Fahrzeugstellplatz, das je nach eingeworfener Geldmenge die Restparkdauer anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "927f8ca8-9144-41d9-a353-b92a8399ead8",
                                "sense_id": "2cb0f563-50ee-3422-8362-60019a467349",
                                "text": "Ich muss schnell nochmal die Parkuhr füttern, damit ich kein Knöllchen kriege."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4ae5c352-554d-3fb2-a3e3-7cee2434ecff",
                        "entry_id": "8470d262-b941-396a-a8c0-babd92d76184",
                        "glosses": [
                            "eine Scheibe, auf der man die Parkbeginnzeit einstellen kann"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fb43728f-601f-46a4-8a61-2328076fe1b9",
                                "sense_id": "4ae5c352-554d-3fb2-a3e3-7cee2434ecff",
                                "text": "„In gesondert beschilderten Geschäftsstraßen müssen Parkpickerlbesitzer allerdings die höchstzulässige Kurzparkdauer von eineinhalb Stunden einhalten und durch eine Parkuhr nachweisen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
