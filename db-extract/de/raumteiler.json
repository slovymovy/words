                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A section of a hard disk separately formatted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
