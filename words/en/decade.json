    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                    "sense_definition": "A period of ten years.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Technology has changed rapidly in the last <w>decade</w>.",
                            "target_lang_translations": {
                                "ru": "За последнее <w>десятилетие</w> технологии стремительно изменились.",
                                "de": "Die Technologie hat sich im letzten <w>Jahrzehnt</w> rasant verändert.",
                                "zh": "在过去的<w>十年</w>里，科技发展迅速。"
                            }
                        },
                        {
                            "text": "She has lived in this house for more than a <w>decade</w>.",
                            "target_lang_translations": {
                                "ru": "Она живет в этом доме уже более <w>десятилетия</w>.",
                                "de": "Sie lebt seit mehr als einem <w>Jahrzehnt</w> in diesem Haus.",
                                "zh": "她在这所房子里已经住了<w>十年</w>多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decennium",
                        "decennary"
                    ],
                    "common_phrases": [
                        "past decade",
                        "next decade",
                        "last decade",
                        "over a decade",
                        "recent decades"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени продолжительностью в десять лет.",
                        "de": "Ein Zeitraum von zehn Jahren.",
                        "zh": "指十年这一时间段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десятилетие",
                                "target_lang_sense_clarification": "период в 10 лет"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Jahrzehnt",
                                "target_lang_sense_clarification": "Zeitraum von 10 Jahren"
                            },
                            {
                                "target_lang_word": "Dekade",
                                "target_lang_sense_clarification": "Zeitraum von 10 Jahren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十年",
                                "target_lang_sense_clarification": "指十年的时间跨度"
                            },
                            {
                                "target_lang_word": "年代",
                                "target_lang_sense_clarification": "指特定的十年时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20dfc0e7-485d-3abb-9879-3d15ec99b2cd",
                    "sense_definition": "A series of prayers in the rosary, consisting of one Our Father and ten Hail Marys.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered to pray a <w>decade</w> of the rosary.",
                            "target_lang_translations": {
                                "ru": "Семья собралась, чтобы прочитать <w>десяток</w> розария.",
                                "de": "Die Familie versammelte sich, um eine <w>Dekade</w> des Rosenkranzes zu beten.",
                                "zh": "全家人聚在一起诵念了一<w>端</w>玫瑰经。"
                            }
                        },
                        {
                            "text": "He silently recited the first <w>decade</w> while walking to church.",
                            "target_lang_translations": {
                                "ru": "По дороге в церковь он молча читал первый <w>десяток</w>.",
                                "de": "Auf dem Weg zur Kirche betete er stumm das erste <w>Gesätz</w>.",
                                "zh": "他在去教堂的路上默默地诵念了第一<w>端</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rosary decade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия молитв в розарии, состоящая из одного «Отче наш» и десяти «Богородице Дево, радуйся».",
                        "de": "Eine Reihe von Gebeten im Rosenkranz, bestehend aus einem Vaterunser und zehn Gegrüßet seist du, Maria.",
                        "zh": "天主教玫瑰经中的一部分，包含一遍天主经和十遍圣母经。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "десяток",
                                "target_lang_sense_clarification": "часть розария"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dekade",
                                "target_lang_sense_clarification": "Gesätz im Rosenkranz"
                            },
                            {
                                "target_lang_word": "Gesätz",
                                "target_lang_sense_clarification": "Abschnitt des Rosenkranzes"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "端",
                                "target_lang_sense_clarification": "玫瑰经中的一段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87bd001f-d066-3941-896d-78743816ff86",
                    "sense_definition": "The interval between any two quantities having a ratio of 10 to 1.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frequency response is flat over several <w>decades</w>.",
                            "target_lang_translations": {
                                "ru": "Частотная характеристика остается плоской на протяжении нескольких <w>декад</w>.",
                                "de": "Der Frequenzgang ist über mehrere <w>Dekaden</w> hinweg flach.",
                                "zh": "频率响应在几个<w>十倍频程</w>内保持平坦。"
                            }
                        },
                        {
                            "text": "There are <w>decades</w> between these two values on the logarithmic scale.",
                            "target_lang_translations": {
                                "ru": "На логарифмической шкале между этими двумя значениями лежат <w>декады</w>.",
                                "de": "Auf der logarithmischen Skala liegen zwischen diesen beiden Werten mehrere <w>Dekaden</w>.",
                                "zh": "在对数刻度上，这两个数值之间相差几个<w>十倍频程</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Интервал между двумя величинами, отношение которых равно 10 к 1.",
                        "de": "Der Intervall zwischen zwei Größen im Verhältnis von 10 zu 1.",
                        "zh": "在对数尺度上，两个数值之比为10比1的区间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декада",
                                "target_lang_sense_clarification": "логарифмический интервал"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dekade",
                                "target_lang_sense_clarification": "frequenz- oder logarithmischer Bereich"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十倍频程",
                                "target_lang_sense_clarification": "频率或数值上的十倍区间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33243f46-3a0e-3745-acd6-356ec5988f4e",
                    "sense_definition": "A group or set of ten items or people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander led a <w>decade</w> of soldiers into the valley.",
                            "target_lang_translations": {
                                "ru": "Командир вел <w>десяток</w> солдат в долину.",
                                "de": "Der Kommandant führte eine <w>Zehnergruppe</w> von Soldaten ins Tal.",
                                "zh": "指挥官带领<w>十个</w>士兵进入了山谷。"
                            }
                        },
                        {
                            "text": "A <w>decade</w> of wagons moved slowly across the plain.",
                            "target_lang_translations": {
                                "ru": "<w>Десяток</w> повозок медленно двигался по равнине.",
                                "de": "Eine <w>Dekade</w> von Wagen bewegte sich langsam über die Ebene.",
                                "zh": "<w>十</w>辆马车缓慢地穿过平原。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to refer to a group of ten soldiers or items"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или набор из десяти предметов или людей.",
                        "de": "Eine Gruppe oder ein Set von zehn Gegenständen oder Personen.",
                        "zh": "由十个单位或人组成的集合。"
                    },
                    "translations": {
                        "ru": [
