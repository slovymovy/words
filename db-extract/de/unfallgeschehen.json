                ],
                "senses": [
                    {
                        "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                        "entry_id": "482162b2-7f08-33a0-a081-0ebb83311a5e",
                        "glosses": [
                            "Ereignis, das einen Schaden zur Folge hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81240243-8793-41ae-b2a9-c6d194788369",
                                "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                                "text": "„Direkt Betroffene können den Kindern authentische Auskunft über das Unfallgeschehen geben und vielleicht auch erklären, wie man es hätte verhindern können.“"
                            },
                            {
                                "example_id": "a03f18a6-269b-492d-b5b4-07b5c7da9c46",
                                "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                                "text": "„Doch gemessen an der Gesamtzahl aller Verkehrsunglücke tragen Auto fahrende Senioren nur wenig zum Unfallgeschehen bei.“"
                            },
                            {
                                "example_id": "81213b09-4723-4d5d-a261-acb8fd159623",
                                "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                                "text": "„Der Grund liege in unterschiedlichen Fahrzeugbeständen und Unfallgeschehen.“"
                            },
                            {
                                "example_id": "8402a271-3bcd-4ecd-b543-f02273f74f93",
                                "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                                "text": "„Ein gravierender Einfluß moderner Kraftfahrzeugtechnik auf das Unfallgeschehen ist dabei aber kaum belegbar.“"
                            },
                            {
                                "example_id": "4f956f04-6602-4d7e-aecb-0596c08f797a",
                                "sense_id": "1dc316e4-c761-34ff-85ee-68c204deef74",
                                "text": "„Die Ermittler suchen nach Zeugen, die Klarheit in das Unfallgeschehen bringen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
