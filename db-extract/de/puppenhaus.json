                "senses": [
                    {
                        "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                        "entry_id": "5a452aab-0a8e-37be-97a6-de1a683169b4",
                        "glosses": [
                            "ein Kinderspielzeug, das eine Miniatur eines (Teil-)Hauses darstellt und als Behausung für Puppen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdbad465-8789-4ed4-b00b-652002930d6a",
                                "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                                "text": "Das Puppenhaus ist technisch so ausgereift, dass es sogar einen echten Miniaturflachbildschirm besitzt."
                            },
                            {
                                "example_id": "f3489f49-6ac2-4c76-9ea6-89e957549030",
                                "sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                                "text": "„Sie hatte ein schönes rosa Zimmer und ein riesiges Puppenhaus voller Möbel und Puppen, mit denen sie spielten und denen sie Puppenkleider anzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a40a622b-f1b4-4183-a15b-37bf1fb73746",
                        "source_entry_id": "5a452aab-0a8e-37be-97a6-de1a683169b4",
                        "source_sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                        "source_sense_description": "Haus für Puppen",
                        "target_lang_word": "doll's house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doll's house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6c9279-aa0a-385c-ab15-1e6dd0568cb3",
                                        "entry_id": "d647d2f3-293f-3b5d-b691-d94f7e38e299",
                                        "glosses": [
                                            "A miniature house used by children as a toy for recreating domestic settings."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7952f3e-8e0c-4dde-832c-eb9414c2b47b",
                                                "sense_id": "0b6c9279-aa0a-385c-ab15-1e6dd0568cb3",
                                                "text": "Adam Stockhausen's doll's-house production design is eye-wateringly precise, the black-and-white images of the city's ancient buildings (shot in Angouleme) deserve their own coffee table book"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f5d752-f88a-323c-abbb-7ceecee0b378",
                                        "entry_id": "d647d2f3-293f-3b5d-b691-d94f7e38e299",
                                        "glosses": [
                                            "A small, cramped, dwelling-place."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cbb55c8-d000-4c22-aa89-c49162a60ab9",
                                                "sense_id": "c4f5d752-f88a-323c-abbb-7ceecee0b378",
                                                "text": "A slightly incongruous note is struck by the National Westminster Bank beside the Vine [pub], a tiny dolls' house of a building, about the size of a garden shed, in herringbone-patterned brick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "187b80ee-8bf6-4b91-acd4-436eaf905d0b",
                        "source_entry_id": "5a452aab-0a8e-37be-97a6-de1a683169b4",
                        "source_sense_id": "10215353-6d78-3120-9515-fa650865bea5",
                        "source_sense_description": "Haus für Puppen",
                        "target_lang_word": "maison de poupée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de poupée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "299ffaf2-2390-33ee-91bd-c5208294f2e1",
                                        "entry_id": "6639e9d0-b1dc-3465-b786-75c9e5116e40",
                                        "glosses": [
                                            "Maison fabriquée en modèle réduit, afin d’accueillir des poupées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff6991d-dc1b-4f7e-9b85-a67620c06da7",
                                                "sense_id": "299ffaf2-2390-33ee-91bd-c5208294f2e1",
                                                "text": "Devant le mas, sur la place, deux ilôts de verdure, et sur le premier, juste entre deux assez grandes bâtisses, à l’ombre d’un vieil olivier et d’un figuier, il y avait là les ruines d’un petit cabanon, on aurait dit presque une maison de poupée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
