            "senses": [
                {
                    "sense_id": "8edd3314-faf0-3271-9c80-002f45791618",
                    "sense_definition": "Towards the back or in the reverse direction or order.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a step <w>backwards</w> to let him pass.",
                            "target_lang_translations": {
                                "ru": "Она сделала шаг <w>назад</w>, чтобы пропустить его.",
                                "zh": "她<w>向后</w>退了一步，让他过去。",
                                "pl": "Zrobiła krok <w>do tyłu</w>, żeby go przepuścić."
                            }
                        },
                        {
                            "text": "Can you count <w>backwards</w> from ten to one?",
                            "target_lang_translations": {
                                "ru": "Ты можешь посчитать <w>в обратном порядке</w> от десяти до одного?",
                                "zh": "你能从十到一<w>倒着</w>数吗？",
                                "pl": "Potrafisz liczyć <w>wstecz</w> od dziesięciu do jednego?"
                            }
                        }
                    ],
                    "synonyms": [
                        "backward",
                        "back"
                    ],
                    "antonyms": [
                        "forwards",
                        "forward"
                    ],
                    "common_phrases": [
                        "look backwards",
                        "move backwards",
                        "fall backwards",
                        "count backwards"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении назад или в обратном порядке.",
                        "zh": "朝向后方，或以相反的方向、顺序。",
                        "pl": "W kierunku tyłu lub w odwrotnym kierunku lub kolejności."
                    },
