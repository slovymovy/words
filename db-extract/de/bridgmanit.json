                        "source_entry_id": "39f0ac6e-8a85-352c-bc3f-c00a060d5b23",
                        "source_sense_id": "35d448eb-a899-32f2-8c68-aed27bb31143",
                        "source_sense_description": "Chemie: unter extrem hohem Druck entstehendes Mineral aus der Gruppe der Silikat-Perowskite",
                        "target_lang_word": "bridgmanite",
