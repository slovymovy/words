{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab24d896-16f8-3aed-b570-862838964e25",
                    "sense_definition": "A piece of soft sandstone used by sailors to scrub and scour the wooden decks of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime_cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning the crew scrubbed the timber planks with a <w>holystone</w> and seawater.",
                            "target_lang_translations": {
                                "ru": "Каждое утро команда драила деревянные доски <w>песчаником</w> и морской водой."
                            }
                        },
                        {
                            "text": "He grabbed a heavy <w>holystone</w> to remove the grime accumulated on the deck.",
                            "target_lang_translations": {
                                "ru": "Он взял увесистый <w>камень для драйки</w>, чтобы соскоблить въевшуюся в палубу грязь."
                            }
                        }
                    ],
                    "synonyms": [
                        "bible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брусок мягкого песчаника, используемый моряками для драйки и чистки деревянной палубы корабля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "песчаник для драйки палубы",
                                "target_lang_sense_clarification": "морской термин, брусок песчаника"
                            },
                            {
                                "target_lang_word": "точильный камень для палубы",
                                "target_lang_sense_clarification": "камень для чистки досок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5df6d18-93b5-377d-b58f-2b7546d7b42f",
                    "sense_definition": "A stone with a naturally occurring hole through it, traditionally kept as a charm for good luck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hung a small <w>holystone</w> by the front door to ward off bad luck.",
                            "target_lang_translations": {
                                "ru": "Она повесила у входной двери маленький <w>куриный бог</w>, чтобы отогнать неудачу."
                            }
                        },
                        {
                            "text": "Walking along the rocky beach, he searched the gravel for a genuine <w>holystone</w>.",
                            "target_lang_translations": {
                                "ru": "Гуляя по каменистому пляжу, он искал среди гальки настоящий <w>куриный бог</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Yorkshire"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Камень с естественным сквозным отверстием, традиционно используемый как амулет или оберег на удачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куриный бог",
                                "target_lang_sense_clarification": "камень с естественным отверстием, амулет"
                            },
                            {
                                "target_lang_word": "ведьмин камень",
                                "target_lang_sense_clarification": "оберег от злых духов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2bc07b3-f11e-336d-bb6a-2749385e4100",
                    "sense_definition": "To scrub or scour a wooden ship's deck using a holystone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime_cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors were ordered to <w>holystone</w> the decks until the wood gleamed.",
                            "target_lang_translations": {
                                "ru": "Морякам приказали <w>драить песчаником</w> палубы до тех пор, пока дерево не заблестит."
                            }
                        },
                        {
                            "text": "He spent the entire afternoon helping to <w>holystone</w> the weathered planks.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, помогая <w>драить камнем</w> потемневшие от времени доски."
                            }
                        }
                    ],
                    "common_phrases": [
                        "holystone the decks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драить или чистить деревянную палубу корабля с помощью бруска песчаника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драить песчаником",
                                "target_lang_sense_clarification": "чистить палубу камнем"
                            },
                            {
                                "target_lang_word": "драить палубу",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}