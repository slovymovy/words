                "senses": [
                    {
                        "sense_id": "0c2a3097-05b1-3795-89a0-a831f0e20878",
                        "entry_id": "7337b74b-8c9d-3739-af9d-998fb7aef7c8",
                        "glosses": [
                            "ärmelloses Oberbekleidungsstück für Herren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1652db5-a12b-4e8f-83c2-0c8981acef44",
                                "sense_id": "0c2a3097-05b1-3795-89a0-a831f0e20878",
                                "text": "„Otto Schlaginhaufen hat trotz der Hitze Gilet, Hemd, Krawatte und Kittel anbehalten.“"
                            },
                            {
                                "example_id": "edb9ca6a-8852-4400-87d6-5d7005bdb159",
                                "sense_id": "0c2a3097-05b1-3795-89a0-a831f0e20878",
                                "text": "„Sakko und Gilet waren auf einem Haken fein säuberlich aufgehängt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96f839e7-f240-422b-aae0-7a29d9694932",
                        "source_entry_id": "7337b74b-8c9d-3739-af9d-998fb7aef7c8",
                        "source_sense_id": "0c2a3097-05b1-3795-89a0-a831f0e20878",
                        "source_sense_description": "ärmelloses Oberbekleidungsstück für Herren",
                        "target_lang_word": "waistcoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waistcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688179c8-15c7-38d7-ad21-06badc47b5ad",
                                        "entry_id": "0a394ce4-9d1b-39bc-b1cf-401cb92c8843",
                                        "glosses": [
                                            "An ornamental garment worn under a doublet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "781c5177-52eb-3733-90bb-ac712fd6e267",
                                        "entry_id": "0a394ce4-9d1b-39bc-b1cf-401cb92c8843",
                                        "glosses": [
                                            "A sleeveless, collarless garment worn over a shirt and under a suit jacket."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4865863f-110b-4e06-b7af-3d51567023f4",
                                                "sense_id": "781c5177-52eb-3733-90bb-ac712fd6e267",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            },
                                            {
                                                "example_id": "d33ab52a-5ba6-4cc7-91c9-975bed460c53",
                                                "sense_id": "781c5177-52eb-3733-90bb-ac712fd6e267",
                                                "text": "In the Victorian Era, exposing your shirtfront in public was considered improper, as shirts were viewed as undergarments. Waistcoats concealed this and helped [to] tame oversized, billowy shirts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25472c83-9000-48e5-b08e-c2c1eb33cf08",
                        "source_entry_id": "7337b74b-8c9d-3739-af9d-998fb7aef7c8",
                        "source_sense_id": "0c2a3097-05b1-3795-89a0-a831f0e20878",
                        "source_sense_description": "ärmelloses Oberbekleidungsstück für Herren",
                        "target_lang_word": "vest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f06498d2-891d-322c-becf-829080d8fd81",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "A sleeveless garment that buttons down the front, worn over a shirt, and often as part of a suit; a waistcoat."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5847a69-b4e1-467d-a452-7ec2812c3623",
                                                "sense_id": "f06498d2-891d-322c-becf-829080d8fd81",
                                                "text": "The Jones man was looking at her hard. Now he reached into the hatch of his vest and fetched out a couple of cigars, everlasting big ones, with gilt bands on them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c19b0015-ef66-301a-b991-92452460ba79",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "A sleeveless garment, often with a low-cut neck, usually worn under a shirt or blouse."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "117e0563-89f5-3fca-9043-7191a617665d",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "A sleeveless top, typically with identifying colours or logos, worn by an athlete or member of a sports team."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2123743-fa5c-36ce-8740-f407da64b0f5",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "Any sleeveless outer garment, often for a purpose such as identification, safety, or storage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0810658b-5cac-41a0-a071-390450778c00",
                                                "sense_id": "d2123743-fa5c-36ce-8740-f407da64b0f5",
                                                "text": "He gripped some of the shreds and pulled off his vest and the shirt beneath it, his clothing disintegrating around him. What in the hell point was there in wearing a twenty-five-pound bulletproof vest if you could still get gunned to death?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11590d78-80dd-3f91-b8b2-170394582dc1",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "A vestment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8927e6c9-e65d-4031-b729-aeebc0565157",
                                                "sense_id": "11590d78-80dd-3f91-b8b2-170394582dc1",
                                                "text": "In state attended by her maiden train, / Who bore the vests that holy rites require."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc940dc-979a-3501-aeab-c8104e8ac18c",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "Clothing generally; array; garb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6223839-495f-4003-b01c-afa3ad9778f9",
                                                "sense_id": "1dc940dc-979a-3501-aeab-c8104e8ac18c",
                                                "text": "Not seldom, clad in radiant vest / Deceitfully goes forth the morn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7c1d370-49a6-3d75-bef8-0470764c7f57",
                                        "entry_id": "ef3174b7-353b-396b-9ffd-39f9c063fac1",
                                        "glosses": [
                                            "A loose robe or outer garment worn historically by men in Arab or Middle Eastern countries."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37118780-dcaf-3fdb-bcb3-884ab96a9fbd",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To clothe with, or as with, a vestment, or garment; to dress; to robe; to cover, surround, or encompass closely."
                                        ],
                                        "tags": [
                                            "passive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e86669-81d7-4f27-880b-1eefec1de3c5",
                                                "sense_id": "37118780-dcaf-3fdb-bcb3-884ab96a9fbd",
                                                "text": "Came vested all in white, pure as her mind."
                                            },
                                            {
                                                "example_id": "8ed003bf-2467-4db9-8c06-60f382c3cea5",
                                                "sense_id": "37118780-dcaf-3fdb-bcb3-884ab96a9fbd",
                                                "text": "With ether vested, and a purple sky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff768f9-7793-311e-95c6-d450beb200ae",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To clothe with authority, power, etc.; to put in possession; to invest; to furnish; to endow; followed by with and the thing conferred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e05971-7e85-477d-999b-8d53bac9772f",
                                                "sense_id": "2ff768f9-7793-311e-95c6-d450beb200ae",
                                                "text": "to vest a court with power to try cases of life and death"
                                            },
                                            {
                                                "example_id": "49ef274f-42ae-421e-8054-2b1c1f2c5785",
                                                "sense_id": "2ff768f9-7793-311e-95c6-d450beb200ae",
                                                "text": "Had thy poor breast receiv’d an equal pain; / Had I been vested with the monarch’s power; / Thou must have sigh’d, unlucky youth, in vain; / Nor from my bounty hadst thou found a cure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df3d7e6-1998-3a1c-9791-a6923efe5650",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To place or give into the possession or discretion of some person or authority; to commit to another; with in before the possessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762733d3-157f-40c5-aadb-89c80bd1f7bd",
                                                "sense_id": "8df3d7e6-1998-3a1c-9791-a6923efe5650",
                                                "text": "The power of life and death is vested in the king, or in the courts."
                                            },
                                            {
                                                "example_id": "782b5631-ccba-47d1-b4ef-394f5e31d397",
                                                "sense_id": "8df3d7e6-1998-3a1c-9791-a6923efe5650",
                                                "text": ", Book I\nEmpire and dominion […] was vested in him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a127cb-1607-3abd-9b4a-a7bf3d3c6c4b",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To clothe with possession; also, to give a person an immediate fixed right of present or future enjoyment of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbb6618-9904-4ce4-9d7d-5c6bbc3d1e5d",
                                                "sense_id": "99a127cb-1607-3abd-9b4a-a7bf3d3c6c4b",
                                                "text": "to vest a person with an estate"
                                            },
                                            {
                                                "example_id": "45ddc647-0e01-4800-9527-626b24d78427",
                                                "sense_id": "99a127cb-1607-3abd-9b4a-a7bf3d3c6c4b",
                                                "text": "an estate is vested in possession"
                                            },
                                            {
                                                "example_id": "099e26bd-ee41-4090-af61-be5ee560d754",
                                                "sense_id": "99a127cb-1607-3abd-9b4a-a7bf3d3c6c4b",
                                                "text": "For the right of the crown vests[…]upon his heir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b20699-d21a-3c3a-ac2a-3f46b45e7092",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "(of an inheritance or a trust fund) To devolve upon the person currently entitled when a prior interest has ended."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d849f35-6b34-4058-86b2-1584d6b016f7",
                                                "sense_id": "68b20699-d21a-3c3a-ac2a-3f46b45e7092",
                                                "text": "Upon the death of the Sovereign the Crown automatically vests in the next heir without the need of coronation or other formality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0d38df-fc01-3da9-a609-0100e97be30e",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To become vested, to become permanent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7577422-32b9-4891-90ca-a83aa00bb9a7",
                                                "sense_id": "bd0d38df-fc01-3da9-a609-0100e97be30e",
                                                "text": "My pension vests at the end of the month and then I can take it with me when I quit."
                                            },
                                            {
                                                "example_id": "55b4891c-0109-4918-82fe-37b50de7f827",
                                                "sense_id": "bd0d38df-fc01-3da9-a609-0100e97be30e",
                                                "text": "If you doubt that you'll stick around at the company long enough for your options to vest, you should discount the value for that uncertainty as well."
                                            },
                                            {
                                                "example_id": "045d8483-ebb1-4a3d-be4e-e0bbfdce7702",
                                                "sense_id": "bd0d38df-fc01-3da9-a609-0100e97be30e",
                                                "text": "2007, Ransey Guy Cole, Jr. (United States Court of Appeals, Sixth Circuit), Roger Miller Music, Inc. v. Sony ATV Publishing, LLC\nSony interpreted 17 U.S.C. § 304 as requiring that the author be alive at the start of the copyright renewal term for the author’s prior assignments to vest."
                                            },
                                            {
                                                "example_id": "48a79ed8-0fcf-4252-8f73-e28853484544",
                                                "sense_id": "bd0d38df-fc01-3da9-a609-0100e97be30e",
                                                "text": "They were, they said tipsily, essentially being paid to do nothing while earning out — or “vesting” — their stock grants. “Rest and vest,” the techies said, in between sips of beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3ac3fa-8b6d-343d-9793-089524815af0",
                                        "entry_id": "14d832ce-5f84-3fca-8b98-da6193bd9754",
                                        "glosses": [
                                            "To invest; to put."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "483f0023-eb67-4225-88fd-5810fcccdba8",
                                                "sense_id": "ec3ac3fa-8b6d-343d-9793-089524815af0",
                                                "text": "to vest money in goods, land, or houses"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
