                                            {
                                                "example_id": "af98caa3-5d96-4071-8da9-67090aeb986b",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Weißer Schimmel“ und „alter Greis“ werden von Wilpert als Beispiele für Pleonasmen angegeben."
                                            },
                                            {
                                                "example_id": "033bb162-7eaa-47a5-ac8f-549ebef0aabd",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Weißer Schimmel“ und „alter Greis“ sind Beispiele für Pleonasmen, da ein Schimmel immer schon weiß und ein Greis immer schon alt ist."
                                            },
                                            {
                                                "example_id": "8c4f2b2a-3bc0-477b-931a-72fc7d978f36",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Tautologien und Pleonasmen können im allgemeinen schon als Ausdruck einer pervertierten Sprache verstanden werden, insofern als sie Sprach- und Sprechschwierigkeiten des Menschen aufdecken.“"
                                            },
                                            {
                                                "example_id": "5576edae-3d44-49a6-87d3-436738e7a778",
                                                "sense_id": "d052dd3c-7f24-3c0c-8369-5289a6b965d5",
                                                "text": "„Der hier beschriebene Fall ist ein Beispiel für einen Pleonasmus, damit eng verbunden auch die Tautologie, auf welche wir später auch noch eingehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "910a1679-5449-47f7-a390-3cb47371a916",
                        "source_entry_id": "c577e165-cc05-3ee2-a9e5-4c0ca48ec638",
                        "source_sense_id": "ef1642a0-f46d-3578-88d4-ea42d6ff7e61",
                        "target_lang_word": "плеоназм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "плеоназм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4ecd35be-c8ad-3a8c-ac25-c7fb3f46e9af",
                                        "entry_id": "fe05fa6b-a1d4-3948-9c01-b342bb29df8f",
                                        "glosses": [
                                            "филол., лингв. употребление в устной или письменной речи оборотов, в которых без надобности повторяются однокоренные или близкие по значению слова, излишние для смысловой полноты высказывания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3b612c-71db-42fa-b603-dabf27659736",
                                                "sense_id": "4ecd35be-c8ad-3a8c-ac25-c7fb3f46e9af",
                                                "text": "Да-с, молодые усы ― живой мост между двух коралловых ротиков, с молодыми усиками не нужно подписывать внизу письма: «Всегда готовый к услугам»; это будет плеоназм."
                                            },
                                            {
                                                "example_id": "1bcad300-60c9-4c53-97a0-bf109fdde1b6",
                                                "sense_id": "4ecd35be-c8ad-3a8c-ac25-c7fb3f46e9af",
                                                "text": "Писателя ловят на детских ошибках – тавтологиях, плеоназмах («Кавабата <…> смотрел на аппарат, не шевелясь и не меняя позы»; «еле слышным шёпотом матерились <…> девушки <…> но почти ничего из их ругани нельзя было разобрать»), нагромождении словесных штампов («опьянённый страстью разум»; «ветер судьбы нёс меня куда-то»; «невыносимое бремя этой жизни»; «комната осветилась мрачным светом занимающегося пожара»)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1416f4-a915-3a2e-bd2d-cf63db9877d4",
                                        "entry_id": "fe05fa6b-a1d4-3948-9c01-b342bb29df8f",
                                        "glosses": [
                                            "филол., лингв. стилистическая фигура, вид амплификации, применяющийся как стилистический приём для придания речи выразительности, при котором не обязательно повторяется лексический элемент, но обязательно дублируется лексическое значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d9a4dc-1f3f-4af7-93df-3293a2e60a0b",
                                                "sense_id": "9e1416f4-a915-3a2e-bd2d-cf63db9877d4",
                                                "text": "С одной стороны, опущения союзов, сокращения, подразумевания, с другой ― плеоназмы, ― словом, именно то, чем разговорный язык отличается от книжного."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
