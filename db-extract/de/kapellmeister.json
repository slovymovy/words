                    },
                    {
                        "form_id": "f3c53844-e55f-4b17-b344-226b841a43c0",
                        "entry_id": "93dedb4d-9015-380d-b436-293563baf882",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kapellmeister"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "425bfa6f-cd9a-3449-a37f-33bdae50e3e6",
                        "entry_id": "93dedb4d-9015-380d-b436-293563baf882",
                        "glosses": [
                            "musikalischer Leiter einer Kapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e9c223a-1476-4b63-9179-717449d451ad",
                                "sense_id": "425bfa6f-cd9a-3449-a37f-33bdae50e3e6",
                                "text": "„Von Zeit zu Zeit wandte er sich, in die Hände klatschend, zum Kapellmeister, damit dieser den Einsatz zu einer Polka oder einer Mazurka gebe, um die Wartezeit zu überbrücken.“"
                            },
                            {
                                "example_id": "0c847d18-2db3-46e7-82a4-73464c3cd75c",
                                "sense_id": "425bfa6f-cd9a-3449-a37f-33bdae50e3e6",
                                "text": "„Trotzdem ist Hoffmann weit davon entfernt zu klagen, er ist froh, seine Kunst vor einem Publikum ausüben zu können, dessen Gunst er als Komponist sehr viel mehr erwirbt denn als Kapellmeister.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ea6732f-ac76-3c37-91ea-19442bebc303",
                        "entry_id": "93dedb4d-9015-380d-b436-293563baf882",
                        "glosses": [
                            "Dirigent eines Orchesters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e9ddb4-44bd-4d7e-8136-e5d9a1be6246",
                                "sense_id": "3ea6732f-ac76-3c37-91ea-19442bebc303",
                                "text": "„Trotzdem ist Hoffmann weit davon entfernt zu klagen, er ist froh, seine Kunst vor einem Publikum ausüben zu können, dessen Gunst er als Komponist sehr viel mehr erwirbt denn als Kapellmeister.“"
                            },
                            {
                                "example_id": "cb51431b-2a2e-4d52-bafa-472eabebee5b",
                                "sense_id": "3ea6732f-ac76-3c37-91ea-19442bebc303",
                                "text": "„Das britische Auktionshaus Aldridge & Son hat am Samstag die Geige versteigert, die vom Kapellmeister des Schiffsorchesters auf der sinkenden Titanic gespielt worden sein soll.“"
                            },
                            {
                                "example_id": "3cfec318-714b-45cd-996f-8d78704aec12",
                                "sense_id": "3ea6732f-ac76-3c37-91ea-19442bebc303",
                                "text": "„Der junge Kapellmeister sprach jedenfalls besser tschechisch als deutsch, und das führte zu Mißverständnissen.“"
                            },
                            {
                                "example_id": "c1375ae1-76cd-4eb9-b936-48a60aa89488",
                                "sense_id": "3ea6732f-ac76-3c37-91ea-19442bebc303",
                                "text": "„In diesem Augenblick ertönten die letzten Akkorde der Ouvertüre, und man hörte den Kapellmeister mit dem Dirigentenstabe klopfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6d663b1-93d2-4220-a2b2-c8fc2e2b81eb",
                        "source_entry_id": "93dedb4d-9015-380d-b436-293563baf882",
                        "source_sense_id": "425bfa6f-cd9a-3449-a37f-33bdae50e3e6",
                        "source_sense_description": "musikalischer Leiter einer Kapelle",
                        "target_lang_word": "bandleader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bandleader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "348cecb7-ed79-3e21-a061-b0605b7e7ebd",
                                        "entry_id": "99ee3942-3508-3ebb-b522-dc41f6c0eb77",
                                        "glosses": [
                                            "A musician who conducts or leads a band of musicians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa460d5-ed38-47d6-b92b-e69634096bc2",
                                                "sense_id": "348cecb7-ed79-3e21-a061-b0605b7e7ebd",
                                                "text": "Before Brooklyn became the World Historical Hipster Hub, there were the Hepsters of Harlem. And well before there was an Urban Dictionary for every last nuance of non-standard English, the bandleader and amateur linguist Cab Calloway cataloged some of the unique speech of the 1930s and ’40s in his Hepster’s Dictionary."
                                            },
                                            {
                                                "example_id": "8405337f-6dde-4f63-9108-f98ad0eb19c4",
                                                "sense_id": "348cecb7-ed79-3e21-a061-b0605b7e7ebd",
                                                "text": "By and large back then, bassists weren’t bandleaders; Mingus was an anomaly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b78a128-6ccb-46d4-a807-7ffb37276335",
                        "source_entry_id": "93dedb4d-9015-380d-b436-293563baf882",
                        "source_sense_id": "425bfa6f-cd9a-3449-a37f-33bdae50e3e6",
                        "source_sense_description": "musikalischer Leiter einer Kapelle",
                        "target_lang_word": "maître de chapelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maître de chapelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0adc1d-fb4e-3cb0-b2b5-a33c47384da1",
                                        "entry_id": "0260b734-7bfa-3157-a75b-2f5ec5b9377a",
                                        "glosses": [
                                            "Maître de musique dans une chapelle, une église, une cathédrale..."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a7bca7-e24e-4d82-a23b-c4a10acd2295",
                                                "sense_id": "4a0adc1d-fb4e-3cb0-b2b5-a33c47384da1",
                                                "text": "Musicien gagé pour composer de la musique ou la faire exécuter. C'est le Maître de musique qui bat la mesure et dirige les Musiciens.(...) Ainsi l'emploi de Maître de musique n'a guère lieu dans les Églises ; aussi ne dit-on point en Italie, Maître de musique, mais Maître de Chapelle : dénomination qui commence à passer aussi en France."
                                            },
                                            {
                                                "example_id": "a205bb15-bbdc-4901-8e6e-76472a52c1b1",
                                                "sense_id": "4a0adc1d-fb4e-3cb0-b2b5-a33c47384da1",
                                                "text": "Il n’y a donc pas moyen d’obtenir qu’on expulse l’organiste, qu’on balaie le maître de chapelle et les professeurs de chant de la maîtrise, qu’on refoule chez les liquoristes les voix de rogomme des gros chantres ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
