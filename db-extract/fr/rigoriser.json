                "senses": [
                    {
                        "sense_id": "49ebbc8c-0adc-3bdd-a225-a854d6a4c2ad",
                        "entry_id": "8fec44b4-098c-339e-882f-4144e76c4ab7",
                        "glosses": [
                            "Rendre rigoureux, ou plus rigoureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94750a0-cbde-44e4-8999-89a850e93802",
                                "sense_id": "49ebbc8c-0adc-3bdd-a225-a854d6a4c2ad",
                                "text": "L’aporie des analyses qui opposent les sociétés primitives et nos sociétés — comment les qualifier : modernes, complexes, civilisées ? — tient à la volonté anti-marxiste de rigoriser Marx."
                            },
                            {
                                "example_id": "f5ddf2c4-943d-4b2a-9803-594dfec033b1",
                                "sense_id": "49ebbc8c-0adc-3bdd-a225-a854d6a4c2ad",
                                "text": "Voilà des magistrats arrivés au sommet de leur carrière et qui mettent leur zèle à « rigoriser » le droit !"
                            }
                        ]
                    }
