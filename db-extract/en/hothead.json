                        "target_lang_word": "Hitzkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitzkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                        "entry_id": "bb09ce50-5918-3fcb-a5f2-dda43584c1a0",
                                        "glosses": [
                                            "Person, die sich besonders leicht aufregt und dabei außer sich gerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71728c8a-8383-4f36-8cae-690b7afb9da7",
                                                "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                                "text": "Ronald Pofalla gilt als politischer Hitzkopf, der sich mit anderen Politikern gerne lautstark streitet."
                                            },
                                            {
                                                "example_id": "93b32367-3d7a-490c-9eb8-2e32b2bba147",
                                                "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                                "text": "[Philipp Hammond] gilt zwar nicht als Europafreund, aber als Pragmatiker und im Gegensatz zum Hitzkopf Boris Johnson gleichzeitig als vernünftig."
                                            },
                                            {
                                                "example_id": "7260af07-9b92-45c8-be2d-b78b61feef3e",
                                                "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                                "text": "[Formel 1:] Immer wieder stehen Schumacher und Benetton im Kreuzfeuer der Kritik. Der 25-jährige Schumacher ist oft ein Hitzkopf, von riesigem Ehrgeiz angetrieben, fällt er nicht immer positiv auf."
                                            },
                                            {
                                                "example_id": "9034045b-b25c-4635-b814-a5cdaea583de",
                                                "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                                "text": "Schon merkwürdig, mit wem sie hier so zusammen sitzen, der Hitzkopf Petrus und der philosophierende Johannes oder die karrierebewussten Zebedäus-Söhne und der aufsässige Judas – also, sie selbst hätten sich diese Gesellschaft nicht ausgesucht. Bestimmt nicht. Aber Jesus hat sie zusammengebracht."
                                            },
                                            {
                                                "example_id": "85fb7a34-1bd7-44d3-9b57-869bf41f48db",
                                                "sense_id": "10b809ba-e403-3114-bf0e-80b5cb6e8a99",
                                                "text": "„Aber wenn ihn nun die Hitzköpfe nicht gehört, ihm nicht geglaubt hätten, wer konnte ihn denn in der Geschwindigkeit vor ihren Mißhandlungen schützen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
