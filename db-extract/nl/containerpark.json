                        "entry_id": "90ee16ba-9231-3495-b73e-e3295c6d4999",
                        "glosses": [
                            "plaats waar afval gesorteerd in containers gestort kan worden,"
                        ],
                        "tags": [
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "180b05d5-b0f1-42df-ab88-e2f7eabfb0b4",
                                "sense_id": "776cba1e-8ec4-3319-a9b4-b127802b3b39",
                                "text": "Afval dat niet via huis-aan-huisophalingen kan worden ingezameld zal men naar een containerpark moeten brengen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6f404fb-037b-40f6-a07d-a702f1a884bd",
                        "source_entry_id": "90ee16ba-9231-3495-b73e-e3295c6d4999",
                        "source_sense_id": "776cba1e-8ec4-3319-a9b4-b127802b3b39",
                        "source_sense_description": "(België) plaats waar afval gesorteerd in containers gestort kan worden",
                        "target_lang_word": "Recyclinghof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Recyclinghof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                        "entry_id": "12c5d71e-3d37-3294-bacf-1cee245eb40e",
                                        "glosses": [
                                            "zentrale Sammelstelle für wiederverwertbare Abfälle und Wertstoffe aus Privathaushalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599efb0b-8bd5-4c4e-b4ba-de740179c64a",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„Ihre Abgabestellen für Sperrmüll, Grünabfälle, Wertstoffe und Problemstoffe sind unsere Recyclinghöfe und die Mobile Problemstoffsammlung.“"
                                            },
                                            {
                                                "example_id": "68909de9-407e-41c3-ab66-a4b1ebf86dd8",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„Die städtischen Recyclinghöfe Fürth und Schwabach werden von uns privatrechtlich, jedoch im Auftrag der Kommune, bzw. Stadt betrieben.“"
                                            },
                                            {
                                                "example_id": "a0fed165-805e-46f6-b652-eea9d5cff218",
                                                "sense_id": "7585325a-b4f2-3088-8b09-05b8f317790d",
                                                "text": "„In Münster gibt es elf Recyclinghöfe, hier werden alle Wertstoffe, Problemabfälle und Sperrgut aus Privathaushalten kostenlos angenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
