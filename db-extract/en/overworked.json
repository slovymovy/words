                    {
                        "translation_id": "80fef537-e687-48b5-a8a2-e070bd0f982d",
                        "source_entry_id": "c582c718-78ae-350e-af6f-2fbfb45d205b",
                        "source_sense_description": "subjected to too much work",
                        "target_lang_word": "débordé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débordé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "090b27dd-e11a-378e-9446-53c7eea2b25c",
                                        "entry_id": "80eb271f-113a-3f65-b783-0f1f2c4eda18",
                                        "glosses": [
                                            "Qui est sorti de son lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265787d9-d75c-425d-8752-108c24a6e68d",
                                                "sense_id": "090b27dd-e11a-378e-9446-53c7eea2b25c",
                                                "text": "Arrivés sur les bords de la Durance, qu'on traversait alors en bac, nous trouvâmes cette rivière tellement grossie et débordée, qu'il était impossible de passer avant cinq ou six heures."
                                            },
                                            {
                                                "example_id": "f7d8c7f6-0ab6-48c2-8fec-ab01d1ae8ff3",
                                                "sense_id": "090b27dd-e11a-378e-9446-53c7eea2b25c",
                                                "text": "Les jours de grandes pluies, l’abside entière s’éveillait et grondait, dans le ronflement de l’averse battant les feuilles de plomb du comble, se déversant par les rigoles des galeries, roulant d’étage en étage avec la clameur d’un torrent débordé."
                                            },
                                            {
                                                "example_id": "ca1a6560-9c06-4389-b467-72a2be8da6b6",
                                                "sense_id": "090b27dd-e11a-378e-9446-53c7eea2b25c",
                                                "text": "La rivière était débordée, de sorte qu'il fallut attendre jusqu'au jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08bb9358-61d8-3fd7-aa62-65f1a0dfe02f",
                                        "entry_id": "80eb271f-113a-3f65-b783-0f1f2c4eda18",
                                        "glosses": [
                                            "Dont les bords ont été enlevés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a874e3-58e3-4e21-95a6-32d4e5273b42",
                                                "sense_id": "08bb9358-61d8-3fd7-aa62-65f1a0dfe02f",
                                                "text": "Une couverture débordée."
                                            },
                                            {
                                                "example_id": "ab993d0b-3bea-45db-95c0-f7230be23dc8",
                                                "sense_id": "08bb9358-61d8-3fd7-aa62-65f1a0dfe02f",
                                                "text": "Ce malade est tout débordé, il faut refaire son lit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b558951c-bcd4-3692-9851-f3df12248138",
                                        "entry_id": "80eb271f-113a-3f65-b783-0f1f2c4eda18",
                                        "glosses": [
                                            "Surchargé de travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a99c75-e078-45cf-aa30-ce8eaa054dcf",
                                                "sense_id": "b558951c-bcd4-3692-9851-f3df12248138",
                                                "text": "Depuis le début, c’est un site révolutionnaire pour toutes les mamans hypercréatives et débordées, sur lequel tout est centralisé et trié par thème pour organiser le goûter d’anniversaire de ses bambins adorés."
                                            },
                                            {
                                                "example_id": "48cceb03-254b-4aef-959d-21149f792f8e",
                                                "sense_id": "b558951c-bcd4-3692-9851-f3df12248138",
                                                "text": "Organisez-vous avant d’être débordé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débordé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32f0a29d-b0ca-3ebe-849e-ffe67dd79852",
