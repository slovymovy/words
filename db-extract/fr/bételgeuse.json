                        "cross_references": [
                            {
                                "target_word": "Betelgeza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b55d91ca-869a-35f2-83e0-64ba2cf20947",
                                        "entry_id": "be2c658e-9548-3b97-97e0-8e368b27cda8",
                                        "glosses": [
                                            "czerwony nadolbrzym w Orionie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3626f2cd-fdcd-45be-95d0-354b50a55d61",
                                                "sense_id": "b55d91ca-869a-35f2-83e0-64ba2cf20947",
                                                "text": "Z całą pewnością ozdobą zimowego nieba jest Orion z powodu swej wielkości i pięknych jasnych gwiazd: wspomnianego już Pasa Oriona oraz czerwonawej Betelgezy i bardzo jasnego Rigela"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0a8716b-82df-4462-ba97-e9d3cbdfd7ca",
                        "source_entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
