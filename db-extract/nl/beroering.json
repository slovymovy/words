                "senses": [
                    {
                        "sense_id": "3acfdb83-6562-3f84-adb3-c806565be5af",
                        "entry_id": "b041db96-3df5-30be-9dcf-50d1b19b0cc2",
                        "glosses": [
                            "onrust door iets veroorzaakt, commotie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f45827e-5309-41b2-ae33-6c5fd8bed211",
                                "sense_id": "3acfdb83-6562-3f84-adb3-c806565be5af",
                                "text": "De ontdekking van water op de maan bracht de wereld van de ruimtevaart in beroering."
                            },
                            {
                                "example_id": "e1aa34c2-ee7e-4aba-b251-5969a6fd2589",
                                "sense_id": "3acfdb83-6562-3f84-adb3-c806565be5af",
                                "text": "In de tijd dat het slecht ging met Jeroen had een mededeling van zijn kant over ontbrekende documenten zeker voor onwelkome beroering gezorgd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd88280-343e-4b90-86ff-64bfea8868e0",
                        "source_entry_id": "b041db96-3df5-30be-9dcf-50d1b19b0cc2",
                        "source_sense_id": "3acfdb83-6562-3f84-adb3-c806565be5af",
                        "source_sense_description": "onrust door iets veroorzaakt",
                        "target_lang_word": "turmoil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turmoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                        "entry_id": "53203a96-1a21-3529-bc12-87fad885b379",
                                        "glosses": [
                                            "A state of great disorder or uncertainty."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a227c4d-ddbe-484b-9919-f270ce0498f3",
                                                "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                                "text": "Oleg Blokhin's side lost the talismanic Andriy Shevchenko to the substitutes' bench because of a knee injury but still showed enough to put England through real turmoil in spells."
                                            },
                                            {
                                                "example_id": "e27292ea-6663-4205-b7fe-30708f120e61",
                                                "sense_id": "170f7d54-2ef4-3c95-9f57-5c42a53ace25",
                                                "text": "The Taoists developed their philosophy during an extended era of turmoil known as the Warring States period of Chinese history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                        "entry_id": "53203a96-1a21-3529-bc12-87fad885b379",
                                        "glosses": [
                                            "Harassing labor; trouble; disturbance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7daf3cc3-8ce4-47c1-91fa-50d8483d76cf",
                                                "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                                "text": "And there I'll rest, as after much turmoil, / A blessed soul doth in Elysium."
                                            },
                                            {
                                                "example_id": "f686e38a-b5e0-466b-920c-666fcd6ef91a",
                                                "sense_id": "a47f63b5-b11e-36f3-bf37-748b204d62ed",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turmoil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20d5ddc4-8db9-3068-86e9-4d854ae67b7f",
                                        "entry_id": "c9accff3-71ca-3546-8bc8-6e5e26ac78c2",
                                        "glosses": [
                                            "To be disquieted or confused; to be in commotion."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5eeb6e0-91ea-41a5-a3b8-ad2c7d2843a5",
                                                "sense_id": "20d5ddc4-8db9-3068-86e9-4d854ae67b7f",
                                                "text": "some notable sophister lies sweating and turmoiling under the inevitable and merciless delimmas of Socrates"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f121b92-eb45-3791-9793-97d1ac543c58",
                                        "entry_id": "c9accff3-71ca-3546-8bc8-6e5e26ac78c2",
                                        "glosses": [
                                            "To harass with commotion; to disquiet; to worry."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dc12def-146d-4582-a00a-36f6b69989fc",
                                                "sense_id": "5f121b92-eb45-3791-9793-97d1ac543c58",
                                                "text": "It is her fatal misfortune […] to be thus miserably tossed and turmoiled with these storms of affliction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
