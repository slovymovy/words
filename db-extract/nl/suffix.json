                        "target_lang_word": "suffixe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffixe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54cf67be-f1fc-319d-b566-780d07fa7d9a",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Affixe ajouté à la fin d’un mot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b03553c-cb97-3e9e-852b-18638c9ceebd",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Affixe ajouté à la fin d’un mot.",
                                            "Affixe sémantique, pour modifier le sens du mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4f05c2-5e87-4611-8879-ed015099c4fb",
                                                "sense_id": "3b03553c-cb97-3e9e-852b-18638c9ceebd",
                                                "text": "Le suffixe diminutif -ot change le sens du mot : frère donne un autre nom, frérot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ef5e78-9a72-3445-8781-89626dc9c60b",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Affixe ajouté à la fin d’un mot.",
                                            "Affixe néologique servant à créer un mot nouveau sur la base d’un radical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd3af9a-bec5-4b14-b00f-727d03f71c5e",
                                                "sense_id": "d5ef5e78-9a72-3445-8781-89626dc9c60b",
                                                "text": "Le nom de chaque diastase est construit de la façon suivante. Il comprend un radical désignant le corps hydrolysé par la diastase, et le suffixe -ase."
                                            },
                                            {
                                                "example_id": "87f97ccc-9cb1-45c1-a92b-8352dcf9a219",
                                                "sense_id": "d5ef5e78-9a72-3445-8781-89626dc9c60b",
                                                "text": "On [nomme les enzymes] d’après la substance qu’elles transforment suivi du suffixe -ase."
                                            },
                                            {
                                                "example_id": "5832843c-5fee-4c88-975a-0cd05537d26d",
                                                "sense_id": "d5ef5e78-9a72-3445-8781-89626dc9c60b",
                                                "text": "Jadis, Maurras, Daudet, Béraud et consorts traquaient, dans les listes des députés, la moindre consonance ashkénaze : malheur aux suffixes -blum, -berg ou -feld !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbbcf16e-4276-3a0f-b306-b609713d3a54",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Affixe ajouté à la fin d’un mot.",
                                            "Affixe dérivationnel servant à changer la classe d’un mot, de substantif à adjectif, d’adjectif à adverbe, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06414cfc-23a4-48ae-ad88-f7c25b2f832f",
                                                "sense_id": "dbbcf16e-4276-3a0f-b306-b609713d3a54",
                                                "text": "Le suffixe adverbial -ment sert à construire des adverbes : chaleureux donne chaleureusement."
                                            },
                                            {
                                                "example_id": "6147b510-6ad2-4565-ac77-911a9b764549",
                                                "sense_id": "dbbcf16e-4276-3a0f-b306-b609713d3a54",
                                                "text": "Le suffixe adjectival -eux sert à construire des adjectifs : chance donne chanceux."
                                            },
                                            {
                                                "example_id": "62f85599-dd64-4cc9-bf54-37f8345bd616",
                                                "sense_id": "dbbcf16e-4276-3a0f-b306-b609713d3a54",
                                                "text": "Le suffixe nominal -age sert à construire des substantifs : piloter donne pilotage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b819507-5def-3ef5-bbf9-49c4a432c41c",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Affixe ajouté à la fin d’un mot.",
                                            "Synonyme de désinence, affixe qui change le genre, le nombre ou, pour les verbes, la personne, le mode, la voix, le temps, le nombre du mot suffixé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c580a2f9-442e-47a0-b4af-46829686ccb3",
                                                "sense_id": "0b819507-5def-3ef5-bbf9-49c4a432c41c",
                                                "text": "Le suffixe flexionnel ou désinentiel constitue une marque de genre ou de nombre des noms, de temps, de nombre et de personne des verbes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e9f92b7-e967-3e69-be5a-e098ef203130",
                                        "entry_id": "43cfbf80-c293-3590-817e-a4a19e774b4d",
                                        "glosses": [
                                            "Extension d’une donnée pour la qualifier, la compléter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64c563f-b8e1-4b5b-af24-7742a0204cb3",
                                                "sense_id": "7e9f92b7-e967-3e69-be5a-e098ef203130",
                                                "text": "Pour être relayés à travers les passerelles [des réseaux autres qu’Internet], les messages associés à ces réseaux étaient étiquetés avec des suffixes comme .bitnet, .oz, .csnet et .uucp, mais les domaines correspondant à ces étiquettes n’existaient pas dans le système de nom de domaine d’Internet."
                                            }
                                        ]
                                    }
                                ]
                            },
