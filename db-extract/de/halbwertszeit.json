                "senses": [
                    {
                        "sense_id": "38d314a1-7848-3251-a773-cee57e48d2f4",
                        "entry_id": "9620ed92-ff30-38a5-b591-2ad76156f1b5",
                        "glosses": [
                            "die Zeit, in der sich ein exponentiell mit der Zeit abnehmender Wert halbiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e3fe70-a63d-4bcb-9150-1f5c3c585a85",
                                "sense_id": "38d314a1-7848-3251-a773-cee57e48d2f4",
                                "text": "Die Halbwertszeit des radioaktiven Materials beträgt circa 50 Jahre."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57cb8a0b-0194-4354-99d0-9a05782a76cd",
                        "source_entry_id": "9620ed92-ff30-38a5-b591-2ad76156f1b5",
                        "source_sense_id": "38d314a1-7848-3251-a773-cee57e48d2f4",
                        "source_sense_description": "die Zeit, in der sich ein exponentiell mit der Zeit abnehmender Wert halbiert hat",
                        "target_lang_word": "half-life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half-life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The time required for half the nuclei in a sample of an isotope to undergo radioactive decay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff77dc60-bf07-45ea-a816-63af82dbbcd7",
                                                "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                                "text": "\"The guy that just left—what's he got in his lungs?\" / \"Well, I'm not very sure. But the two best candidates are uranium-233 and plutonium-239, one or both.\" / \"They're in his bones too, aren't they?\" / \"Yeah, they're both boneseekers. And they've got half-lives of one hundred sixty-two thousand and twenty-four thousand years respectively. So they stay hot for a long time.\""
                                            },
                                            {
                                                "example_id": "b9084599-0403-4ceb-bd97-a44b96c5b012",
                                                "sense_id": "89273148-30d8-370b-b481-01bdfe79dfd3",
                                                "text": "O₂^(•−) and OH^• are highly unstable (half-life at the level of microseconds and nanoseconds, respectively) and cannot cross membrane, while H₂O₂, though not a free radical but a ROS, is relatively stable (half-life around 1 ms) (Møller et al. 2007) and can cross membranes through aquaporins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1998337-af91-3f74-96bb-e666fb2a8fc5",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "In a chemical reaction, the time required for the concentration of a reactant to fall from a chosen value to half that value."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f664353b-d6f0-35e7-ae33-bbd868a60d1b",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The time it takes for a substance (drug, radioactive nuclide, or other) to lose half of its pharmacological, physiologic, or radiological activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0daf28-2ca0-4961-aa96-a6889b601c9d",
                                                "sense_id": "f664353b-d6f0-35e7-ae33-bbd868a60d1b",
                                                "text": "For nonporous surfaces such as steel, in a dark and low-humidity environment, the CCP virus has an 18-hour half-life—the time required for it to decrease by half , according to the researchers' findings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b118f584-4fa5-3c49-a8df-3a57a61d71e8",
                                        "entry_id": "2367cf2f-9ec0-3248-a4f1-8864cd1ddc4e",
                                        "glosses": [
                                            "The amount of time it takes for an idea or a fashion to lose half of its influential power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab237bd4-59a0-4e65-8ab3-73526dc627e6",
                                                "sense_id": "b118f584-4fa5-3c49-a8df-3a57a61d71e8",
                                                "text": "Most books of scholarship have surprisingly short intellectual half-lives during which they make a difference\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ca3f2a-92d9-4fa0-969c-433da6653a74",
                        "source_entry_id": "9620ed92-ff30-38a5-b591-2ad76156f1b5",
                        "source_sense_id": "38d314a1-7848-3251-a773-cee57e48d2f4",
                        "source_sense_description": "die Zeit, in der sich ein exponentiell mit der Zeit abnehmender Wert halbiert hat",
                        "target_lang_word": "demi-vie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-vie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e9bc9d9-ae69-33b4-acab-29357bf00d81",
                                        "entry_id": "8d8f5b46-ab5a-3f89-9ac3-b246c99da6b9",
                                        "glosses": [
                                            "Dans la cinétique d’une réaction au cours de laquelle un réactif réagit complètement, temps nécessaire pour que la concentration de ce réactif soit réduite de moitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b79a169-e5c6-4a2a-b06f-9af94e9abc99",
                                                "sense_id": "9e9bc9d9-ae69-33b4-acab-29357bf00d81",
                                                "text": "Par exemple, aux États-Unis, dans un sol limon fin acide (pH 5,7) contenant 4,9 % de matières organiques, on a mesuré une demi-vie du chlorsulfuron de 4 semaines à 20 °C (Beyer et al., 1988). Dans le même type de sol (5,7 % de matières organiques), mais alcalin (pH 7,5), cette demi-vie passait à 33 semaines à la même température."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b0f921f-f4b2-3de0-8f51-73b98c736a12",
                                        "entry_id": "8d8f5b46-ab5a-3f89-9ac3-b246c99da6b9",
                                        "glosses": [
                                            "Dans le cas des substances radioactives, temps nécessaire pour que la quantité de cette substance soit réduite de moitié par désintégration."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c203ede-a9b2-4cc4-84cd-81136cf57584",
                                                "sense_id": "0b0f921f-f4b2-3de0-8f51-73b98c736a12",
                                                "text": "La décomposition de chacune de ces substances suit un schéma qui lui est propre, appelé « demi-vie », le temps nécessaire à leur radioactivité pour diminuer de moitié."
                                            },
                                            {
                                                "example_id": "26529f80-1447-4f33-b416-b330a55f75dd",
                                                "sense_id": "0b0f921f-f4b2-3de0-8f51-73b98c736a12",
                                                "text": "En outre, les 2,7 millions d’années de la calotte glaciaire correspondent à deux demi-vies du béryllium 10, de sorte qu’au début du Pléistocène, le nombre d’atomes de cet isotope dans le sol du centre du Groenland était quatre fois supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eef902a-ee2d-30ed-8de7-5ee34e7146c7",
                                        "entry_id": "8d8f5b46-ab5a-3f89-9ac3-b246c99da6b9",
                                        "glosses": [
                                            "Temps nécessaire pour que, après l’administration d’un médicament, sa concentration dans l’organisme soit réduite de moitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b644716-de4a-44b0-8b30-c4467a3da488",
                                                "sense_id": "6eef902a-ee2d-30ed-8de7-5ee34e7146c7",
                                                "text": "« La L-dopa agit sur un ensemble de symptômes, mais les prises doivent être répétées dans la journée car sa demi-vie est courte », explique le Pʳ Caroline Moreau, neurologue au CHRU de Lille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
