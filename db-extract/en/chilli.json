                        "glosses": [
                            "Ớt cay, tươi hay khô, thường màu đỏ, của vài loại cây trồng."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "782409ec-941a-40b9-8d17-4c2238d5c664",
                                "sense_id": "1a54079d-27f2-3b20-91d8-b08566e0540c",
                                "text": "The farmers' market had a wide variety of chillis, from anchos to jalepeños to habaneros.",
                                "translation": "Chợ có đủ loại quả ớt, kể từ ancho đến jalepeño, ngay cả đến habanero."
