                        "source_sense_id": "de0bb524-d14f-3ff8-9de6-8992ad9e55d7",
                        "target_lang_word": "křesťanka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "křesťanka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b319e0b2-4e3d-39bf-9a95-e6508bdb8de5",
                                        "entry_id": "5fe6e0f1-ab89-3996-9c0a-8afa66e06b1c",
                                        "glosses": [
                                            "žena, která vyznává křesťanskou víru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6cd1ca-5542-44af-95de-6efe2c1a4e68",
                                                "sense_id": "b319e0b2-4e3d-39bf-9a95-e6508bdb8de5",
                                                "text": "První křesťanka česká, kněžna Ludmila, jest i první mučednicí naší."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1fdc0a4-7cfd-420b-bac3-0c7ad9990f13",
                        "source_entry_id": "a2dc9f68-fcf5-3498-8121-106e1fbd6e33",
                        "source_sense_id": "de0bb524-d14f-3ff8-9de6-8992ad9e55d7",
                        "target_lang_word": "chrétienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chrétienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63f0bd2a-a0d3-3fcf-aa59-cef91c136da9",
                                        "entry_id": "77beae76-26d4-3353-8650-a5abc299f949",
                                        "glosses": [
                                            "Féminin singulier de chrétien."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2296d46c-3af0-417a-be90-88c50a3968f8",
                                                "sense_id": "63f0bd2a-a0d3-3fcf-aa59-cef91c136da9",
                                                "text": "Or, dans la pensée chrétienne, plusieurs serpents jouent un rôle de grande importance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chrétienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "804c65a6-bd74-333e-aa5c-0a413f0ac6c3",
                                        "entry_id": "470ae7da-4f94-31fc-a2cb-061c86ad46d5",
                                        "glosses": [
                                            "Femme ou fille adepte de la religion de Jésus de Nazareth, dit Jésus-Christ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10120c9c-87cd-4061-89e1-db94f13dd6fc",
                                                "sense_id": "804c65a6-bd74-333e-aa5c-0a413f0ac6c3",
                                                "text": "Campé dès le commencement de la messe sous le porche, il examina l’église en regardant tous les chrétiens, mais plus particulièrement les chrétiennes qui trempaient leurs doigts dans l’eau sainte."
                                            },
                                            {
                                                "example_id": "251cbc92-821a-429c-8487-f878debed526",
                                                "sense_id": "804c65a6-bd74-333e-aa5c-0a413f0ac6c3",
                                                "text": "Avec une pareille allure, pouvait-on être une vraie chrétienne, une épouse parfaite ? Et que signifiait ce goût récent du cheval, ces rallie-papiers ?"
                                            },
                                            {
                                                "example_id": "526de559-399d-4299-a92c-8e624bf86e99",
                                                "sense_id": "804c65a6-bd74-333e-aa5c-0a413f0ac6c3",
                                                "text": "— De l’Anglais ? Ah ! dit Jeanne étonnée, un Anglais peut-il porter bonheur à une chrétienne ?\n— Tu crois donc qu’un Anglais n’est pas un chrétien ?\n— Je ne sais pas.\n— Je t’assure qu’ils sont aussi bons chrétiens que nous, Jeanne !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f89f419-0514-3d0f-9edf-fdd1c5cb1300",
                                        "entry_id": "470ae7da-4f94-31fc-a2cb-061c86ad46d5",
                                        "glosses": [
                                            "Femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93b32630-9823-4e12-abac-eb80844c2be0",
                                                "sense_id": "5f89f419-0514-3d0f-9edf-fdd1c5cb1300",
                                                "text": "Une dure chrétienne : Une méchante femme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "824a0d5b-1b08-461a-bd13-5fea31ed44eb",
                        "source_entry_id": "a2dc9f68-fcf5-3498-8121-106e1fbd6e33",
