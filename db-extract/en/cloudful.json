                                "sense_id": "21d47166-f41c-3e35-9c19-2691502e3566",
                                "text": "One might suppose himself angling in Lake Avernus, with a cloudful of hobgoblins on each side of him!"
                            },
                            {
                                "example_id": "e22c3bf7-676e-4f6a-b6a6-939f99e3e02e",
                                "sense_id": "21d47166-f41c-3e35-9c19-2691502e3566",
                                "text": "A shuffling from the pit is drowned by the tumult of the top gallery, where the crowd whoops and whistles and stamps like a cloudful of angels on a spree."
                            }
                        ]
                    }
