    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1390806f-0f8a-32c5-8221-41cd331762c9",
                "word": "Blighty",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29c82456-b0e4-3991-b88a-2defb721d7ae",
                        "entry_id": "1390806f-0f8a-32c5-8221-41cd331762c9",
                        "glosses": [
                            "Great Britain, Britain, or England, especially as viewed from abroad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda73fc8-dbb4-4bc9-a94c-b54c549d40af",
                                "sense_id": "29c82456-b0e4-3991-b88a-2defb721d7ae",
                                "text": "Before I knew it, 8 August had come around and our holiday was over. As my lovely little family headed for the airport to jump ship back to Blighty, I was on the road again with fresh legs."
                            },
                            {
                                "example_id": "3a927769-29d3-4808-b7d6-4fe6356e1c54",
                                "sense_id": "29c82456-b0e4-3991-b88a-2defb721d7ae",
                                "text": "Living in the US, I have always seized every opportunity to insist things are better in Blighty. But now both countries look ludicrous[.]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fef78298-8eb5-3b17-91f3-fd88ce6bd050",
                "word": "Blighty",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c80bff9f-0ca5-47ae-835d-b3eb2f03520f",
                        "entry_id": "fef78298-8eb5-3b17-91f3-fd88ce6bd050",
                        "tags": [
                            "plural"
                        ],
                        "form": "Blighties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31379916-7bf4-3dac-8759-a38074446230",
                        "entry_id": "fef78298-8eb5-3b17-91f3-fd88ce6bd050",
                        "glosses": [
                            "Synonym of Blighty one."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c96260ec-1b4e-411c-9e6a-46793c3fb4ed",
                                "sense_id": "31379916-7bf4-3dac-8759-a38074446230",
                                "text": "The ones who did get a good Blighty were returned to England."
                            },
                            {
                                "example_id": "8d2ba9ad-edd8-483d-ac4d-4df1501d0878",
                                "sense_id": "31379916-7bf4-3dac-8759-a38074446230",
                                "text": "Well maybe I'll have luck this time in the shape of a decent little “Blighty” as its^([sic]) the only way out of it for a while."
                            },
                            {
                                "example_id": "dd4f99f0-5f55-41d3-8221-fa3ea1ad6ab6",
                                "sense_id": "31379916-7bf4-3dac-8759-a38074446230",
                                "text": "\"Talk about Blighties——” He lifted his bandaged arm."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "2dc2fa24-c24e-4461-83d7-80e4f8dd3a40",
                        "source_entry_id": "fef78298-8eb5-3b17-91f3-fd88ce6bd050",
