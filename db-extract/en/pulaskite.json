                "senses": [
                    {
                        "sense_id": "cc78fb22-413c-3e39-8614-47a6c5aca149",
                        "entry_id": "7fb4c42a-eb6e-338f-8736-cc1790bbf5f5",
                        "glosses": [
                            "A massive course-grained rock composed chiefly of feldspar with some other minerals such as hornblende and biotite."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2f3787d-548f-417d-b44b-18b010c9cfc0",
                                "sense_id": "cc78fb22-413c-3e39-8614-47a6c5aca149",
                                "text": "The pulaskites occupy a position similar to that of larvikite between syenite and nepheline-syenite. Quartz is absent, while felspathoids are present in small quantities."
                            },
                            {
                                "example_id": "865ca337-0fa3-4885-b2af-77577f0a4686",
                                "sense_id": "cc78fb22-413c-3e39-8614-47a6c5aca149",
                                "text": "The normal granite nowhere cuts the normal pulaskite, nor does the pulaskite cut the granite. That the two rocks are transitional is clearly shown in some places."
                            },
                            {
                                "example_id": "49adefad-530b-4b12-a6c5-e3f169f03e31",
                                "sense_id": "cc78fb22-413c-3e39-8614-47a6c5aca149",
                                "text": "Nepheline and sodalite are two accessory minerals in the pulaskites."
                            }
                        ]
                    }
                ],
