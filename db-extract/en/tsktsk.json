                "senses": [
                    {
                        "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                        "entry_id": "5fe26fe7-2f64-3b15-88c3-c2f9e1d61f66",
                        "glosses": [
                            "To make a tsktsk sound of disapproval."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "af1e9f2a-1a13-4233-879e-6191a9b24a34",
                                "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                                "text": "\"You're not supposed to talk,\" the guy at the desk tsktsked at us."
                            },
                            {
                                "example_id": "0bfa3e8a-2c88-46f0-bffe-3c00c3569b00",
                                "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                                "text": "Tone takes Davis to his Connecticut home where housekeeper Skipworth tsktsks as Davis gets demanding and asks for booze."
                            },
                            {
                                "example_id": "a2e9ed9b-666d-47f4-8055-43e485ac0993",
                                "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                                "text": "Adam tsktsked at her. “You are such a snob, Lex. What would you say if I told you we were going swimming at a country club?”"
                            },
                            {
                                "example_id": "d5b56096-830e-4190-8977-8d480c6996fb",
                                "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                                "text": "Instant fireworks. On cue, the usual suspects — The New York Times, the Washington Post and various other newspapers large and small went orbital. Pundits and odd and assorted talking heads and radio voices all got the vapors and tsk-tsk-tsked and cluck-clucked themselves into a froth."
                            },
                            {
                                "example_id": "c096caa0-8c29-4d39-8207-c4915492614b",
                                "sense_id": "a4232163-7bcb-31a9-bf9c-f3508522c83e",
                                "text": "Specifically, 40 percent of Gen Z and millennials determine the success of their vacation by social media reaction to their photos. Before you start wagging a finger and tsk-tsk-ing about millennials, the study also found that Gen X and boomers aren’t far behind them."
                            }
                        ]
                    }
                ],
