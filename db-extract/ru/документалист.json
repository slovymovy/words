                "senses": [
                    {
                        "sense_id": "fe15ba6f-6a56-36ee-9250-13d5300b8cb5",
                        "entry_id": "18352088-eeb1-357d-9f06-f1136a6153f6",
                        "glosses": [
                            "создатель документальных фильмов, документальных литературных произведений; тот, кто в своей работе основывается на документах"
                        ],
