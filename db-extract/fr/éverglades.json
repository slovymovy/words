                        "examples": [
                            {
                                "example_id": "32746f11-8b54-4a0e-9787-f497a4e26128",
                                "sense_id": "ad74579b-1547-3ded-991b-e8b3874c2443",
                                "text": "(M. Hollbrook fait dans ce moment avec Agasiz une excursion scientifique près des grands marais d’Éverglades.)"
                            },
                            {
                                "example_id": "940320ee-4023-46f6-8617-11de140cc964",
                                "sense_id": "ad74579b-1547-3ded-991b-e8b3874c2443",
                                "text": "Il est extrêmement curieux de noter que, nulle part sous les Éverglades, l’eau n’est stagnante ; elle semble s’écouler en masse du Nord-Ouest au Sud et au Sud-Est, subdivisée sous terre en nombreux courants et contre-courants."
                            },
                            {
                                "example_id": "ccb4544b-d986-4537-8652-9cf43f4d2a37",
                                "sense_id": "ad74579b-1547-3ded-991b-e8b3874c2443",
                                "text": "Lorsque les recherches de la police et celles de Malcolm permettent de l’identifier sous le nom d’Alan Delour, il enlève Christine et l’emmène dans les marais des Éverglades."
                            }
                        ]
                    }
