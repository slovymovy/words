                ],
                "senses": [
                    {
                        "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                        "entry_id": "07da0fa4-d94d-3b53-a6e1-899ae0b090d5",
                        "glosses": [
                            "стать, оказаться нужным, необходимым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a68458-48d6-4404-8b5a-242d39374eac",
                                "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                                "text": "[Оболдуева, жен, богатая купеческая дочь] Ежели вам на развод деньги нужны, так я могу дать сколько потребуется, я за этим не постою."
                            },
                            {
                                "example_id": "20b44dc3-b408-4709-a28a-4eece096c57c",
                                "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                                "text": "Потребовалось вмешательство полиции, и произошло нещадное избиение толпы."
                            },
                            {
                                "example_id": "13aa95b1-76ea-4b7b-af10-8a0b05281575",
                                "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                                "text": "Я потребуюсь, то у купца Епифанова остановился."
                            },
                            {
                                "example_id": "5dd0216c-b36c-428d-a223-0fbf4f433c49",
                                "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                                "text": "Мне для этого и не потребовалось больших усилий."
                            },
                            {
                                "example_id": "7ff22536-a49d-418d-917d-82310b11a41c",
                                "sense_id": "9571b09b-2a66-31c4-b72d-a70ba2154c93",
                                "text": "― Пойдем повторим алгебру. На это потребуется полчаса."
                            }
                        ]
                    }
                ],
