                ],
                "senses": [
                    {
                        "sense_id": "3538a446-3e27-3df0-a3f9-c0ae2308f999",
                        "entry_id": "392a2eaf-9a85-3983-84a8-da9c6b7cb89d",
                        "glosses": [
                            "Lehrer, der privat, das heißt nicht als Angestellter/Beamter an einer Schule beschäftigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8025a5df-7dc9-4906-90d7-1623d0d44431",
                                "sense_id": "3538a446-3e27-3df0-a3f9-c0ae2308f999",
                                "text": "„Der Stadtschreiber war also neben seinem Hauptamt zugleich als Privatlehrer tätig und betrieb in seinem Hause eine eigene kleine Schule: eine ›Schreiberschule‹ oder ›Schreibschule‹.“"
                            },
                            {
                                "example_id": "4d7018e9-6ce7-4fbe-97b6-8cc9a62fbd80",
                                "sense_id": "3538a446-3e27-3df0-a3f9-c0ae2308f999",
                                "text": "„Als Privatlehrer lebte er von 1629 bis 1631 in Paris; dort bekam er rein zufällig Euklids Elemente in die Hand und war von dem Werk fasziniert.“"
                            },
                            {
                                "example_id": "153d3939-7479-4651-bb3c-c11fd3cbb057",
                                "sense_id": "3538a446-3e27-3df0-a3f9-c0ae2308f999",
                                "text": "„Wiewohl er seinen Lebensunterhalt als Privatlehrer selbst verdienen musste, brachte er die ersten beiden Studienjahre mit Bravour hinter sich.“"
                            },
                            {
                                "example_id": "9b074d4e-bd88-4824-9285-97d3d248b221",
                                "sense_id": "3538a446-3e27-3df0-a3f9-c0ae2308f999",
                                "text": "„Brot und Spiele, denkt er und liefert, weil noch nicht lange genug aus den Diensten eines Privatlehrers entlassen, sofort die lateinische Übersetzung mit: panem et circenses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
