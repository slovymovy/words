                        "entry_id": "71270a14-1ec9-3b41-a14e-74d20fbf1aaa",
                        "glosses": [
                            "schriftliche Rechenschaft über die Einnahmen sowie die Ausgaben am Ende eines Quartals (Zeitraum von drei Monaten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3004d9-ef74-4a40-b8fc-36875f25369e",
                                "sense_id": "35cbfb12-235a-3d51-aa14-2cb377f71a42",
                                "text": "„Den Vormittag nutzte er mit den Angestellten für die Quartalsabrechnung.“"
                            },
                            {
                                "example_id": "24c2dc63-7162-403f-8f4d-12c7fc556339",
                                "sense_id": "35cbfb12-235a-3d51-aa14-2cb377f71a42",
                                "text": "„Ich muss die Quartalsabrechnungen noch fertig machen.“"
                            },
                            {
                                "example_id": "f250e252-e33d-40e6-8529-29aeeab047e6",
                                "sense_id": "35cbfb12-235a-3d51-aa14-2cb377f71a42",
                                "text": "„Die Juristen der ‚Kassenärztlichen Vereinigungen‘ nötigen Mediziner, auf ihren Quartalsabrechnungen bei jedem einzelnen Patienten die Diagnose zu vermerken - zur ‚Plausibilitätskontrolle‘ der Abrechnung.“"
                            }
                        ],
