                                "target_senses": [
                                    {
                                        "sense_id": "74210852-1920-3b16-88db-670bebbff310",
                                        "entry_id": "42a9ad3f-bb3b-3fcb-9ed5-fb59586fc260",
                                        "glosses": [
                                            "rondtrekkende zanger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9dc47c4-c5af-415f-b032-aed9c085df77",
                                                "sense_id": "74210852-1920-3b16-88db-670bebbff310",
                                                "text": "'Dossier H' van Kadare aan een filmregisseur; een geramsjt kleinood waarin twee Amerikanen in de jaren dertig met een reusachtige magnetofoon de bergen van Albanië intrekken om de stemmen van de laatste rapsoden vast te leggen en zo het raadsel van Homerus op te lossen. Aan Luc Pien als ode aan het epische dat verdwijnt en aan de vriendschap die eeuwig is."
                                            },
                                            {
                                                "example_id": "f42d2898-8678-4685-baf4-c19bf62775a0",
                                                "sense_id": "74210852-1920-3b16-88db-670bebbff310",
                                                "text": "Het is proza dat vanaf de eerste zin als een rapsode op je afkomt, een oud-Griekse troubadour, inderdaad, gewoon aan het met taal en verhalen overweldigen van zelfs het minst geïnteresseerde gehoor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
