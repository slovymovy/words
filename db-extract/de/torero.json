                                "sense_id": "76da8b62-77d4-3d00-9722-9596abd0fcb9",
                                "text": "„Trotzdem betrat Franziska das Lokal wie eine Arena, ein kleiner nervöser Torero unter den Augen einer schaulustigen Menge.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
