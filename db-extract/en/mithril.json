                        "sense_id": "299bc96d-8027-313f-9c7a-94a27715d91a",
                        "entry_id": "ad3cb96d-9f03-3703-a058-bfd8fac1ed04",
                        "glosses": [
                            "A fictional silvery metal of great strength and value, primarily in fantasy and role-playing settings."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "141cb01d-a3ef-4fd7-9709-465490cd3da0",
                                "sense_id": "299bc96d-8027-313f-9c7a-94a27715d91a",
                                "text": "In order to get the iron ore, mithril and leather strap, you must do the following."
                            },
                            {
                                "example_id": "d3c34806-2183-46dc-9b8e-fc85d3675bc9",
                                "sense_id": "299bc96d-8027-313f-9c7a-94a27715d91a",
                                "text": "Open the double doors to the south and get the mithril plate boots and mithril chain leggings."
                            },
                            {
                                "example_id": "25981e38-f5fb-456c-a7f2-6bfb06319573",
                                "sense_id": "299bc96d-8027-313f-9c7a-94a27715d91a",
                                "text": "Once the elf brought in the mithril chainmail shirt, the mithril bracers and leg guards he handed the items to Lord Kale, he put them in the magical pouch on his side for later use, in his mind he knew he had to die for his friends in the near future."
                            },
                            {
                                "example_id": "1c8523a8-4f61-4835-a375-3db52a2da98b",
                                "sense_id": "299bc96d-8027-313f-9c7a-94a27715d91a",
                                "text": "A gold dragon's fire could melt iron and steel in seconds, depending on its quality, but this heat only made mithril malleable. Ordin quickly placed a steel rod into the rough mithril sword blank to increase its mass."
                            }
                        ]
                    }
