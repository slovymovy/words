                "translations": [
                    {
                        "translation_id": "17b527b1-0ea2-447e-bb7b-6a15549accce",
                        "source_entry_id": "0096c845-9062-3539-94f3-2820696aa022",
                        "target_lang_word": "dummy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "965004b0-e9a8-39b5-9810-000cce67a297",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A silent person; a person who does not talk."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48e9170-a50b-4e0c-be15-cec2011052b6",
                                                "sense_id": "965004b0-e9a8-39b5-9810-000cce67a297",
                                                "text": "The man's name […] was engraved in the centre, and beneath this, written in ink with the same elaborate precision as the engraving, there was a brief message.\nI am a deaf-mute, but I read the lips and understand what is said to me. Please do not shout.\n […] Singer looked very carefully at his lips when he spoke—he had noticed that before. But a dummy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34989a68-2463-36eb-975c-7d5ada17c741",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A stupid person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029e09e2-679b-43b9-9c58-7cf4b7fcea3a",
                                                "sense_id": "34989a68-2463-36eb-975c-7d5ada17c741",
                                                "text": "Don't be such a dummy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbc4155-4e42-368d-9c7d-e7d7448d59f2",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A term of address."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3fb413-88d5-4d70-8d18-a125f069aa71",
                                                "sense_id": "9bbc4155-4e42-368d-9c7d-e7d7448d59f2",
                                                "text": "Hey dummy, what's good wit chu?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01656f5-ef12-3a01-90bb-60810de9cf87",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A figure of a person or animal used by a ventriloquist; a puppet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b7172c5-3a9c-3bef-ba16-61e93594ad21",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "Something constructed with the size and form of a human, to be used in place of a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ebea2c4-72e8-4b65-8f98-a14b2878d566",
                                                "sense_id": "6b7172c5-3a9c-3bef-ba16-61e93594ad21",
                                                "text": "To understand the effects of the accident, we dropped a dummy from the rooftop."
                                            },
                                            {
                                                "example_id": "20c49e5b-e419-4016-ab0a-28d9b2b18bb2",
                                                "sense_id": "6b7172c5-3a9c-3bef-ba16-61e93594ad21",
                                                "text": "\"There's a remedy, it does try one, but never mind,\" said Gubjor; \"I shall make a dummy baby, which I shall bury in the churchyard, and then the dead will believe they have got the child, take my word, they won't know but what it is the real baby!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5df70aab-6cbd-3ace-af58-1129b7c5fcd8",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A person who is the mere tool of another; a man of straw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "206a8d1d-9fd2-3edc-9929-01053bf6061d",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A deliberately nonfunctional device or tool used in place of a functional one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52258ceb-3dc2-46f8-8748-8a4c40b076f9",
                                                "sense_id": "206a8d1d-9fd2-3edc-9929-01053bf6061d",
                                                "text": "The hammer and drill in the display are dummies."
                                            },
                                            {
                                                "example_id": "ad0650ef-5aa1-48fa-ae9e-691c3aa9c0c5",
                                                "sense_id": "206a8d1d-9fd2-3edc-9929-01053bf6061d",
                                                "text": "The second method was to use two loadometers under the wheels of one axle, mounting the wheels of the other axle on what we called \"equalizing blocks\" or \"dummies.\" By that method the two axles are brought into the same horizontal plane […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ded64114-e2da-3571-a0e9-705a7041f71b",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A pacifier; a plastic or rubber teat used to soothe or comfort a baby."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157b8ef2-ad19-4900-bdf0-b3e5505cc059",
                                                "sense_id": "ded64114-e2da-3571-a0e9-705a7041f71b",
                                                "text": "The baby wants her dummy."
                                            },
                                            {
                                                "example_id": "9c300a3d-703e-4b68-99c8-a23c64ee8e16",
                                                "sense_id": "ded64114-e2da-3571-a0e9-705a7041f71b",
                                                "text": "Then on the fifth day, at the first sleep of the day, remove the dummy and follow my settling guide for your baby′s age. You should throw all her dummies in the bin to ensure you are not tempted to use them again – even outside sleep times."
                                            },
                                            {
                                                "example_id": "d7cc4035-8be8-4bb2-b219-3d27aaef5fc3",
                                                "sense_id": "ded64114-e2da-3571-a0e9-705a7041f71b",
                                                "text": "No Fairy baby has ever been seen to suck its thumb or to use a dummy."
                                            },
                                            {
                                                "example_id": "d46edb43-0b02-4293-b9b1-7a4833ed1f42",
                                                "sense_id": "ded64114-e2da-3571-a0e9-705a7041f71b",
                                                "text": "We′ve found that going cold turkey works best – you check that your baby isn't ill or teething, then throw all dummies away. When your baby cries for her dummy, you can look her in the eye and say, ‘It′s gone,’ and really mean it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433194da-6ee7-3e1a-b075-7d0f1487d43b",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A player whose hand is shown and is to be played from by another player."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c116a68e-6573-35fa-9a4e-7164508e9d2e",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A word serving only to make a construction grammatical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552fbc4c-9706-4224-983c-bafd435552bd",
                                                "sense_id": "c116a68e-6573-35fa-9a4e-7164508e9d2e",
                                                "text": "The pronoun \"it\" in \"It's a mystery why this happened\" is a dummy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c855f2e-07a5-3e6f-a15a-f51843c55ab2",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "An unused parameter or value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77af1ea7-b049-4f59-bcbe-f9caf0aeeaa5",
                                                "sense_id": "9c855f2e-07a5-3e6f-a15a-f51843c55ab2",
                                                "text": "If flag1 is false, the other parameters are dummies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07eae42e-4e35-38d2-abfa-47688bf09a77",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A feigned pass or kick or play in order to deceive an opponent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b99067cc-8bca-3987-85f9-93a6911bc923",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A bodily gesture meant to fool an opposing player; a feint."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f750548c-6169-49b6-a8b2-486f8aff765f",
                                                "sense_id": "b99067cc-8bca-3987-85f9-93a6911bc923",
                                                "text": "Raul Meireles was the victim of the home side's hustling on this occasion giving the ball away to the impressive David Vaughan who slipped in Taylor-Fletcher. The striker sold Daniel Agger with the best dummy of the night before placing his shot past keeper Pepe Reina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1f56111-ea45-3f1d-a211-9a76a2343cef",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A newborn animal that is indifferent to stimulus and does not voluntarily move."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24d481f-6540-49cf-b473-8cd3cf4c404f",
                                                "sense_id": "e1f56111-ea45-3f1d-a211-9a76a2343cef",
                                                "text": "a dummy calf, lamb, or foal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cc700e3-1db9-3e32-938f-08905cf790e1",
                                        "entry_id": "2fa21542-6c97-35ad-b228-3b7f8f542915",
                                        "glosses": [
                                            "A fairy chess piece that cannot move or capture, but can be captured and used to skip moving another piece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af403e92-7324-4acc-a75d-240c47c91413",
                                                "sense_id": "0cc700e3-1db9-3e32-938f-08905cf790e1",
                                                "text": "In Monochromatic chess moves are only allowed between cells of the same colour. Thus the kings are reduced to ferses, the rooks to dabbabariders, and the knights to dummies. […] The fers and camel can reach all the cells of one colour. The others are more restricted; the dummy cannot move at all, and the commuter can only move back and forth between two cells."
                                            },
                                            {
                                                "example_id": "90d77411-7b86-4a9e-993b-0228c8911321",
                                                "sense_id": "0cc700e3-1db9-3e32-938f-08905cf790e1",
                                                "text": "Everybody give the dummy a big round of applause."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dafeae-9a6a-3388-a142-34df618a1847",
                                        "entry_id": "14b222d6-4dcd-313a-8b05-93550dfa34ee",
                                        "glosses": [
                                            "To make a mock-up or prototype version of something, without some or all off its intended functionality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19203c72-c713-41af-aabb-2dafb9dce411",
                                                "sense_id": "a1dafeae-9a6a-3388-a142-34df618a1847",
                                                "text": "The carpenters dummied some props for the rehearsals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83c7bcc-ed9a-3147-9175-3a2cd7a01951",
                                        "entry_id": "14b222d6-4dcd-313a-8b05-93550dfa34ee",
                                        "glosses": [
                                            "To feint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f232b064-710d-44a7-a89c-617510812127",
                                                "sense_id": "c83c7bcc-ed9a-3147-9175-3a2cd7a01951",
                                                "text": "The more glamorous qualities usually associated with him are skill and pace and he used those to race on to a ball across him and dummy a defender before having a right-foot shot saved."
                                            },
                                            {
                                                "example_id": "fae18f0d-9844-4bd2-9fec-92256a227fb7",
                                                "sense_id": "c83c7bcc-ed9a-3147-9175-3a2cd7a01951",
                                                "text": "For the first, the 30-year-old allowed Walcott space on the right to send in a pass that was expertly dummied by Samir Nasri, allowing Van Persie to swivel and smash right-footed past Robert Green."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f70478-168f-3f23-96b6-ffa590531e0a",
