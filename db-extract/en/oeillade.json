                                                "sense_id": "102f9031-0c29-3603-8254-1a1974e0d403",
                                                "text": "Měl pronikavý pohled."
                                            },
                                            {
                                                "example_id": "9aa4a606-72f3-4e66-8328-840c505aae41",
                                                "sense_id": "102f9031-0c29-3603-8254-1a1974e0d403",
                                                "text": "Vrhla naň dlouhý, zamilovaný pohled."
                                            }
