                    {
                        "translation_id": "0e4632fe-d97e-42b9-b190-dabac31a30ba",
                        "source_entry_id": "5a45c4e8-fd14-3980-b6ae-7b5b806d7b69",
                        "target_lang_word": "Okklusion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okklusion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7888702-78a4-3829-8499-b8a3a18ca522",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Abdecken eines Auges"
                                        ],
                                        "tags": [
                                            "Augenheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19704bac-7511-4285-88b6-e24b37661732",
                                                "sense_id": "d7888702-78a4-3829-8499-b8a3a18ca522",
                                                "text": "„Bei diesen Kindern verwenden wir ohne Rücksicht auf die Fixation die direkte Okklusion mit den altersabhängigen Wechselintervallen. Das Schielauge wird jeweils für einen Tag okkludiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a061a15-dca0-3292-b0aa-dc302a115a4b",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Einschluss von Fremdbestandteilen oder Verunreinigungen bei einer Fällung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8348cf00-fa76-469d-9cec-cb6fd0c2b746",
                                                "sense_id": "4a061a15-dca0-3292-b0aa-dc302a115a4b",
                                                "text": "„Zwei andere Erscheinungen nicht kolloider Art sind in ihren Auswirkungen der Absorption eng verwandt, nämlich die Mischkristallbildung und die Okklusion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be792d92-c0a9-3efc-9cd8-ca1b104539be",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Zusammenschluss der Kalt- und Warmfront eines Tiefs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "043c48a2-d590-474b-adf1-6a84d6ad52a2",
                                                "sense_id": "be792d92-c0a9-3efc-9cd8-ca1b104539be",
                                                "text": "„Okklusion wird auch Mischfront genannt und ist Teil des meteorologischen Frontensystems eines Tiefdruckgebietes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b9528c5f-e80f-3348-8580-a814bb5a726d",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Reduktion von Erregungsprozessen aufgrund der Überlappung von Entladungszonen"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cba9bb-6d2e-4554-bf1f-17b50c4e75f1",
                                                "sense_id": "b9528c5f-e80f-3348-8580-a814bb5a726d",
                                                "text": "„Okklusion ist eine durch anatomische Identität bestimmter Strukturen bedingte Begrenzung und Verminderung von Bahnungsvorgängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "9428fe5d-6c9d-39dc-9109-44c79204ebdf",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Verschluss eines Hohlorganlumens oder Sperre einer Passage"
                                        ],
                                        "tags": [
                                            "Pathologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6fd5972-4c7e-4523-8066-78e60c61e5d4",
                                                "sense_id": "9428fe5d-6c9d-39dc-9109-44c79204ebdf",
                                                "text": "„Die Okklusion des Harnleiters durch den Tumor hat offenbar zu einer Selbstausschaltung der Niere und Bildung einer Hydronephrose geführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "e1cb312d-3d3b-3bd8-b182-89042b2e343b",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Abdecken von Hautarealen"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3853d2-5a97-4623-9346-693ed1a1c25d",
                                                "sense_id": "e1cb312d-3d3b-3bd8-b182-89042b2e343b",
                                                "text": "„Von vielen Autoren wird auch die Anwendung von Imidazol-Cremes unter nächtlicher Okklusion für die chemische Mazeration pilzbefallener Nagelanteile angegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "86346c0e-292b-3d95-ac3d-c640a01d855d",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "jeder Kontakt zwischen Zähnen des Ober- und Unterkiefers; räumliches Verhältnis der Zähne zueinander beim Zusammenbiss"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31780b68-bc4e-4db5-bb78-e1ac0151e48d",
                                                "sense_id": "86346c0e-292b-3d95-ac3d-c640a01d855d",
                                                "text": "„Während man früher zwischen Okklusion als statischer Position der Zähne im Kieferschluß und der Artikulation als dynamischem Geschehen bei Kieferbewegungen unterschied, bezeichnet man seit einigen Jahren jegliche Kontaktbeziehung der Zahnreihen als Okklusion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "6e6411f9-572f-34d1-bd03-0c1db17a4802",
                                        "entry_id": "576b156f-2e52-3ac3-a47f-b85d6d7dfe3c",
                                        "glosses": [
                                            "Einschließung, Verschließung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
