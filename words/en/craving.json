    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91f9debc-50cb-329e-a370-b258271dd024",
                    "sense_definition": "A powerful and intense desire for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a sudden <w>craving</w> for chocolate after dinner.",
                            "target_lang_translations": {
                                "nl": "Ze had na het eten plotseling een <w>snak naar</w> chocolade.",
                                "cs": "Po večeři dostala náhlou <w>chuť</w> na čokoládu."
                            }
                        },
                        {
                            "text": "He struggled to control his <w>craving</w> for sugar while on a diet.",
                            "target_lang_translations": {
                                "nl": "Hij had moeite om zijn <w>zucht</w> naar suiker te beheersen tijdens het diëten.",
                                "cs": "Během diety se snažil ovládat své <w>bažení</w> po cukru."
                            }
                        }
                    ],
                    "synonyms": [
                        "appetite",
                        "hunger",
                        "longing",
                        "thirst",
                        "urge",
                        "yearning"
                    ],
                    "common_phrases": [
                        "intense craving",
                        "food craving",
                        "sudden craving"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een krachtig en intens verlangen naar iets.",
                        "cs": "Silná a intenzivní touha po něčem."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "snakken naar",
                                "target_lang_sense_clarification": "sterke behoefte aan iets (vaak eten of drinken)"
                            },
                            {
                                "target_lang_word": "zucht",
                                "target_lang_sense_clarification": "onweerstaanbare drang of hunkering"
                            },
                            {
                                "target_lang_word": "hunkering",
                                "target_lang_sense_clarification": "diep, emotioneel verlangen"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chuť",
                                "target_lang_sense_clarification": "intenzivní touha, často po jídle"
                            },
                            {
                                "target_lang_word": "bažení",
                                "target_lang_sense_clarification": "silná, až nutkavá potřeba"
                            },
                            {
                                "target_lang_word": "choutky",
                                "target_lang_sense_clarification": "náhlá touha nebo chuť na něco konkrétního"
                            }
                        ]
                    }
                }
            ]
        },
        {
