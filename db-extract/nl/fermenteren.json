                                    {
                                        "sense_id": "7f11454e-83e5-39d5-b246-949470132bea",
                                        "entry_id": "27dfc115-88ee-30e4-85ed-78217afbbdac",
                                        "glosses": [
                                            "Être en fermentation."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c09c681-a8b0-4090-93ae-6178087ef127",
                                                "sense_id": "7f11454e-83e5-39d5-b246-949470132bea",
                                                "text": "Le jus contient, en outre du principe sucré, une foule de matières étrangères dont quelques-unes sont susceptibles de fermenter et d’altérer le sucre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d287187-fa49-3f3c-8411-76b70583f0cd",
                                        "entry_id": "27dfc115-88ee-30e4-85ed-78217afbbdac",
                                        "glosses": [
                                            "S’agiter ou bouillonner, en parlant des esprits, des passions dangereuses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9144d8-88cf-48ec-86a4-2401fe061776",
                                                "sense_id": "8d287187-fa49-3f3c-8411-76b70583f0cd",
                                                "text": "Les colères entassées fermentant dans le silence depuis vingt ans, grondaient de toutes parts ; la pensée se déchaînait, les livres qui d’ordinaire n’entraient en France que secrètement, commençaient à s’éditer à Paris."
                                            },
                                            {
                                                "example_id": "88696e68-2ef5-4251-b3ae-f8376425c348",
                                                "sense_id": "8d287187-fa49-3f3c-8411-76b70583f0cd",
                                                "text": "Depuis l’arrestation de Condé, la haine avait fermenté. Les colères, un instant comprimées, éclataient maintenant."
                                            },
                                            {
                                                "example_id": "15d52f02-d8cd-4bbd-9895-ad597131ca03",
                                                "sense_id": "8d287187-fa49-3f3c-8411-76b70583f0cd",
                                                "text": "C'est cette « pensée de derrière » qui est à l'origine de toutes les révolutions. Elle fermente pendant des mois, puis éclate subitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
