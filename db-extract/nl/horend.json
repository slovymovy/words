                                "example_id": "bae44dfb-24d7-4acf-97cc-eafd6c5e4344",
                                "sense_id": "50a36623-d9de-3dd0-91a8-31283fc22b9c",
                                "text": "De gemeenteraad van Rijssen-Holten stemde dinsdagavond in met de snellere aanpak van asbestdaken en de daarbij horende financiële regelingen."
                            }
