                "translations": [
                    {
                        "translation_id": "51cf2601-b1e6-4e2e-b5d6-e44dcbfc9f64",
                        "source_entry_id": "b11dfb31-fd41-3b1c-9543-48134362727c",
                        "source_sense_id": "390d6919-6b95-3df3-956a-48e290e80354",
                        "target_lang_word": "cesspit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cesspit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74d08bd5-36f6-3b73-a02b-a3a73a857992",
                                        "entry_id": "b0611706-0e17-3b97-b09c-14f79223871e",
                                        "glosses": [
                                            "A cesspool; a pit or covered cistern used to collect sewage and waste water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9782541-ae19-31cb-b8af-7afeb89e15cb",
                                        "entry_id": "b0611706-0e17-3b97-b09c-14f79223871e",
                                        "glosses": [
                                            "A place or situation characterised by corruption, filth or immoral activities."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984aa325-7cdf-4643-962f-60f8afdefba2",
                                                "sense_id": "e9782541-ae19-31cb-b8af-7afeb89e15cb",
                                                "text": "Politics devolved into a cesspit of lies and deceit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "022d3f2c-ac29-4a9e-a59f-31b6274174f6",
                        "source_entry_id": "b11dfb31-fd41-3b1c-9543-48134362727c",
                        "source_sense_id": "00c1cb2b-3f29-3d25-8b04-6a1d63bdd8f9",
                        "target_lang_word": "cloaca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloaca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "A sewer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2ed69a-67fe-4915-9db4-f3b8b192622b",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "The Thames, polluted with the filthy effusions of the cloacae."
                                            },
                                            {
                                                "example_id": "a423af0a-16c6-4a5a-a8dd-1a1bd0959d7d",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "[…] that tremendous cloaca of Pauperism […]"
                                            },
                                            {
                                                "example_id": "624d9826-a0ba-43b7-a2ba-1ae0308e9ae9",
                                                "sense_id": "97f9eaa4-d95b-3a2b-bff9-ff1a963661e8",
                                                "text": "After working an hour, I began to speculate on the distance one had to go before the cloaca was reached the chances we had of missing it altogether."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93925cb0-9f93-377b-9d36-60eccda58b3e",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "The opening in reptiles, amphibians and birds, as well as elasmobranchians, lobe-finned fishes, marsupials and monotreme mammals, which serves as the common outlet for the urogenital ducts and rectum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a909108-d4f9-43ef-8615-28167030130a",
                                                "sense_id": "93925cb0-9f93-377b-9d36-60eccda58b3e",
                                                "text": "In birds the rectum, at the termination of its canal, forms an oval or elongated pouch […] and then expands into a cavity, which has been named cloaca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "An outhouse or lavatory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12ab41a-26d0-4d8a-8cdd-36ab8c0fba04",
                                                "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                                "text": "To every house […] a cloaca."
                                            },
                                            {
                                                "example_id": "2fd0ec35-a07c-40bb-be94-dd61fb769d2a",
                                                "sense_id": "1bedb8bd-8ff7-30c5-92ff-956e82e2518c",
                                                "text": "Only think of that cloaca being supplied daily with such dainty bibliographical treasures!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a59b75-3c56-3bb9-bfe8-9b392bc6974c",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "A duct through which gangrenous material escapes a body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83944d1-8434-4e30-8413-7a5ce3980435",
                                                "sense_id": "b6a59b75-3c56-3bb9-bfe8-9b392bc6974c",
                                                "text": "Across this shell [sc. of bone] small holes are eaten, by which the matter escapes, and which are called cloacae (Weidmann)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54135835-8651-3ec7-ad38-9d682554140a",
                                        "entry_id": "89286f80-7374-3317-8fb6-f84056b5e20b",
                                        "glosses": [
                                            "Structure in the embryo during the development of the reproductive and urinary systems."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
