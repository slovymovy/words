                "senses": [
                    {
                        "sense_id": "728da10d-c86b-3296-bb80-705f0eb4f9b4",
                        "entry_id": "a0d91c72-62da-32d2-9524-1338152cd297",
                        "glosses": [
                            "Ausmaß des angeeigneten für die Gesellschaft relevanten Wissens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d6cf33-918d-4773-a7ae-883420bdc4f3",
                                "sense_id": "728da10d-c86b-3296-bb80-705f0eb4f9b4",
                                "text": "Manche sagen, dass das Einkommen mit dem Bildungsgrad steigt, andere wiederum vertreten die Meinung, dass der Bildungsgrad mit dem Einkommen steigt."
                            },
                            {
                                "example_id": "12b7fc61-d112-48d6-9606-be6c0e010aef",
                                "sense_id": "728da10d-c86b-3296-bb80-705f0eb4f9b4",
                                "text": "Wie die aktuellen Internet-Strukturdaten der Forschungsgruppe Wahlen Online (FGW Online) zeigen, steigert sich mit dem Bildungsgrad auch die Online-Nutzung in der deutschen Bevölkerung."
                            },
                            {
                                "example_id": "c818d186-b7c4-403b-876c-5af8f331bc6a",
                                "sense_id": "728da10d-c86b-3296-bb80-705f0eb4f9b4",
                                "text": "„Die Bildungsgrad hierzulande ist höher als in den USA, die Unterschicht ist kleiner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
