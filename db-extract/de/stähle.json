                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Frau Stähle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6e605338-e400-4ae1-b422-4d24f65cca79",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Herr Stähle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b00b4ab4-f807-40b8-b23a-50328895cbd4",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Die Stähles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c7ca34b0-1d7a-4bb1-8afb-e61d6efb3cdd",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Der Stähle trägt nie die Schals, die die Stähle ihm strickt."
                            },
                            {
                                "example_id": "1affc1bc-f436-42b7-ba24-9fe7b409a423",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stähle kommt, geht der Herr Stähle.“"
                            },
                            {
                                "example_id": "f03d19e8-b365-457d-bb08-6a08889024dd",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Stähle kommt und geht."
                            },
                            {
                                "example_id": "d2ea1fad-f6ab-4651-92b5-0cf994fc79ea",
                                "sense_id": "ed7ff307-dab3-39d2-a61c-80ccb16a0f8c",
                                "text": "Stähles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
