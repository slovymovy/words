                "senses": [
                    {
                        "sense_id": "6b49ca20-d044-3205-8ab8-ac47a6e225d8",
                        "entry_id": "98d857e6-5eba-3b9f-bfe9-933f6b5ed439",
                        "glosses": [
                            "Faire perdre son caractère conscient à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf85014a-9769-4240-afc2-391683b3bfec",
                                "sense_id": "6b49ca20-d044-3205-8ab8-ac47a6e225d8",
                                "text": "Le langage fonctionnerait alors comme déconscientisé, selon des lois autres que celles de la référenciation, c’est-à-dire autres que celles ayant réglé son ajustement à la perception et à la cognition."
                            }
                        ]
                    },
                    {
                        "sense_id": "698be3aa-3a7a-341b-9262-aebde13ad144",
                        "entry_id": "98d857e6-5eba-3b9f-bfe9-933f6b5ed439",
                        "glosses": [
                            "Faire perdre à quelqu’un sa conscience de certaines choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c4638e-4022-4f97-b51d-b6e6aa0e4633",
                                "sense_id": "698be3aa-3a7a-341b-9262-aebde13ad144",
                                "text": "Est-il même nécessaire de faire appel aux sélections génétiques pour déconscientiser les masses ?"
                            },
                            {
                                "example_id": "794b5fa2-88d7-4a7d-964f-504751b3cc1e",
                                "sense_id": "698be3aa-3a7a-341b-9262-aebde13ad144",
                                "text": "La Matrice n’est qu'un décor, une mise en scène, une programmation mentale et superficielle, nous incitant à nous déconscientiser, à nous déresponsabiliser et à suivre le troupeau."
                            }
                        ]
                    }
                ],
