                        "source_sense_id": "fb276931-c044-3487-b618-f51e52c7e2ac",
                        "target_lang_word": "лаконичность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лаконичность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "46370919-3690-3826-9984-ef842ea1da69",
                                        "entry_id": "ece66ba3-b88a-3215-a21d-7a2d615e7a0a",
                                        "glosses": [
                                            "свойство по значению прилагательного лаконичный; предельная краткость в высказываниях, выражениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7792c5af-0fea-4ce6-b82c-d97a134c9237",
                                                "sense_id": "46370919-3690-3826-9984-ef842ea1da69",
                                                "text": "Их роднила между собой присущая обоим скромность, застенчивость и лаконичность."
                                            },
                                            {
                                                "example_id": "047aaf8f-3c54-41de-a3bb-65eafa89a206",
                                                "sense_id": "46370919-3690-3826-9984-ef842ea1da69",
                                                "text": "Мы сочинили речь, упирая главным образом не на юмор, а на лаконичность, ― и последней достигли вполне."
                                            },
                                            {
                                                "example_id": "471c4d17-3236-40e5-a524-02b5b501d927",
                                                "sense_id": "46370919-3690-3826-9984-ef842ea1da69",
                                                "text": "Сводки эти были очень краткие, а за этой лаконичностью никак нельзя было разгадать ― что же происходит на фронтах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
