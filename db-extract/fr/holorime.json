                "senses": [
                    {
                        "sense_id": "79942d5a-8029-35f0-acad-7212cd26be90",
                        "entry_id": "d8703edc-ac97-3cae-855b-f3c95f20dba6",
                        "glosses": [
                            "Expression, phrase ou vers holorime d’un(e) autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b18621f-516f-43ae-b330-2e66b386dbc7",
                                "sense_id": "79942d5a-8029-35f0-acad-7212cd26be90",
                                "text": "L’holorime se lit en deux sens comme en un reflet inversé et place le poète acrobate à un point de basculement."
                            },
                            {
                                "example_id": "4f95eace-9b35-48bb-8da4-f103f8880b66",
                                "sense_id": "79942d5a-8029-35f0-acad-7212cd26be90",
                                "text": "« Gal, amant de la reine, alla, tour magnanime,\nGalamment de l’arène à la tour Magne à Nîmes » sont deux holorimes de Marc Monnier souvent attribuées à Victor Hugo."
                            }
                        ]
                    }
                ],
