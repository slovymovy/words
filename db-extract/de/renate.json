                "translations": [
                    {
                        "translation_id": "0916ac49-4c42-499e-87f6-c537ea72f589",
                        "source_entry_id": "b120e1bd-2c99-3e64-8182-318e204e018f",
                        "source_sense_id": "f6259b40-72ce-31f4-880f-af4fd133b8cb",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "René",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "René",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19e6aa9a-1b10-34c1-8608-e2f0acbc0d65",
                                        "entry_id": "1f000ca5-b600-381f-8b6b-699c538f5627",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886898f1-b4c0-47a7-9510-7fa00101cd75",
                                                "sense_id": "19e6aa9a-1b10-34c1-8608-e2f0acbc0d65",
                                                "text": "Les Normaliens dédaignaient ces cours que fréquentaient certains outsiders. Parmi ceux-ci, on remarquait René Daumal et Roger Vailland."
                                            },
                                            {
                                                "example_id": "612d9cfa-282d-4a93-b24b-5e50d6bf0dc8",
                                                "sense_id": "19e6aa9a-1b10-34c1-8608-e2f0acbc0d65",
                                                "text": "De fait, René se sentait apaisé plus que ne l'eût été aucun mortel en un lieu moins épouvantable qu'un franc-bord de canal au milieu de la nuit."
                                            },
                                            {
                                                "example_id": "e0ad0fd4-e075-4525-a75f-bd00ebe5cd8a",
                                                "sense_id": "19e6aa9a-1b10-34c1-8608-e2f0acbc0d65",
                                                "text": "Il y avait aussi un endroit qui s'appelait Saint-Just, à côté de Bourges, où on était très connus des gadjé, la Monique de l'épicerie et le père René, le garde champêtre. On stationnait auprès de la petite rivière qui s'appelait l'Arnon."
                                            },
                                            {
                                                "example_id": "b11a6cb5-81c4-4f01-9b67-8d190703e885",
                                                "sense_id": "19e6aa9a-1b10-34c1-8608-e2f0acbc0d65",
                                                "text": "Camille Laurin, René Lévesque, Bernard Landry et Jacques Parizeau doivent se retourner dans leur tombe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "René",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95f668b3-e790-3370-8c82-01aafa63f7a6",
                                        "entry_id": "48b7bf40-62a1-375f-8ade-f94b8f4817f3",
                                        "glosses": [
                                            "Commune française, située dans le département de la Sarthe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a86e225a-7e44-4f38-b95d-e54cbef27805",
                        "source_entry_id": "b120e1bd-2c99-3e64-8182-318e204e018f",
