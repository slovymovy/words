                    ]
                },
                {
                    "sense_id": "184e38d1-4ac2-3ac0-9d30-d99e193376e8",
                    "sense_definition": "jemandem gezielt große Mengen Alkohol zu trinken geben, damit die Person betrunken wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alkohol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der Feier versuchten einige Gäste, das Geburtstagskind mit Schnaps <w>abzufüllen</w>."
                        },
                        {
                            "text": "Er merkte gar nicht, wie seine Freunde ihn den ganzen Abend lang <w>abfüllten</w>."
