                "senses": [
                    {
                        "sense_id": "8edac64a-7861-3f8e-82f5-fb96c4dfcfb4",
                        "entry_id": "c4aa3723-5f9a-351a-950e-f971f66d7381",
                        "glosses": [
                            "Qui est installé à table, en particulier pour manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe271ea-9492-4d6e-9615-2f8789f4c2ff",
                                "sense_id": "8edac64a-7861-3f8e-82f5-fb96c4dfcfb4",
                                "text": "M. Boid’ho y était attablé, las et tertio-napoléonien, devant un long drink."
                            },
                            {
                                "example_id": "b9b5dd74-5801-40fb-ad0b-400759472d31",
                                "sense_id": "8edac64a-7861-3f8e-82f5-fb96c4dfcfb4",
                                "text": "À peine un quart d’heure plus tard, attablée au comptoir du coffee-shop, Evie dévorait son repas avec l’appétit de quelqu’un qui n’a pas mangé depuis deux jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "c038b903-b9b3-35b4-b62c-99d0c499d278",
                        "entry_id": "c4aa3723-5f9a-351a-950e-f971f66d7381",
                        "glosses": [
                            "Installé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "38ab75d3-2dab-40ae-817b-9e13c5f6e8e5",
                                "sense_id": "c038b903-b9b3-35b4-b62c-99d0c499d278",
                                "text": "Ce mariage de Gérard avec Camille, n’était-ce pas pour elle la fin heureuse, la certitude de laisser son fils riche, aimé, attablé enfin à la vie ?"
                            }
                        ]
                    }
                ],
