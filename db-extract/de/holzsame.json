                "senses": [
                    {
                        "sense_id": "e0296338-135b-37f9-afee-8b626a2f9616",
                        "entry_id": "10a34336-27a1-3fc5-a9a8-4890e4cbb404",
                        "glosses": [
                            "Same eines Holzgewächses (Bäume, Sträucher, …)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2a68940-a15b-4442-a057-5a3899953a45",
                                "sense_id": "e0296338-135b-37f9-afee-8b626a2f9616",
                                "text": "„[Der Same des großblaͤttrigen oder gemeinen Ahorns] iſt der einzige deutſche Holzſame, deſſen Kernſtuͤcke oder Lamellen im Samenkorne eine gruͤne Farbe haben.“ [1836]"
                            },
                            {
                                "example_id": "4be49e4c-a1ec-4885-82b6-c1ea7d2776d4",
                                "sense_id": "e0296338-135b-37f9-afee-8b626a2f9616",
                                "text": "„[Die gemeine Heide] pflanzt ſich durch den Samen und durch die Wurzeln, leider, nur zu haͤufig fort, und uͤberzieht oft große Strecken ſo dicht, daß kein Holzſame Wurzel ſchlagen kann.“ [1836]"
                            },
                            {
                                "example_id": "a68dd587-9e59-442c-b915-4b5662bb806f",
                                "sense_id": "e0296338-135b-37f9-afee-8b626a2f9616",
                                "text": "„Der kieferne Holzſame iſt ſchon an und fuͤr ſich von der Beſchaffenheit, daß er, wenn er auch nur die geringſte Krume findet, in das Erdreich eindringt, und Wurzel ſchlaͤgt.“ [1783]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
