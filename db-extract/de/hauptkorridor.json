                "senses": [
                    {
                        "sense_id": "92c9bd61-78e8-3164-86a1-bad469b74fe8",
                        "entry_id": "f0f8c20d-5691-36c8-b564-af7e1a3eedcc",
                        "glosses": [
                            "größter, zentraler Korridor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10051f8-4c62-465b-afa7-de7de8e7bbc7",
                                "sense_id": "92c9bd61-78e8-3164-86a1-bad469b74fe8",
                                "text": "„Als sie in den Hauptkorridor kamen, erschienen an mehreren Türen neugierige Gesichter, die sehen wollten, wen der Geheimdienst diesmal geholt hatte.“"
                            },
                            {
                                "example_id": "632df957-eb54-446f-b584-829eecf182bc",
                                "sense_id": "92c9bd61-78e8-3164-86a1-bad469b74fe8",
                                "text": "„Dann bogen sie um die Ecke in den Hauptkorridor.“"
                            },
                            {
                                "example_id": "2c81de07-d07c-4e3c-93c2-4dbef878a41b",
                                "sense_id": "92c9bd61-78e8-3164-86a1-bad469b74fe8",
                                "text": "„Ich gehe den Hauptkorridor des Dome hinunter, biege nach etwa zwei Dritteln auf eine Wendeltreppe aus Metall ab und steige vier Etagen nach oben in die Slums.“"
                            },
                            {
                                "example_id": "49f26b6c-fba9-4964-8509-7c00ed41b95b",
                                "sense_id": "92c9bd61-78e8-3164-86a1-bad469b74fe8",
                                "text": "„Nach zwei oder drei Kilometern gelangte Agvurs Gefährt zu einer dreifachen Weggabelung, wo in einander gegenüberliegenden Winkeln weitere aufwärtsführende Stollen vom Hauptkorridor abzweigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
