{
    "word_family": [
        "quadrangular"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2375a05-6d2d-3cd2-8f12-d0e617845a9c",
                    "sense_definition": "A four-sided open courtyard, especially one enclosed by large buildings on a college or university campus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "courtyard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students gathered in the central <w>quadrangle</w> to relax and talk between their morning classes.",
                            "target_lang_translations": {
                                "zh": "上午下课后，学生们聚集在中央<w>方庭</w>里休息聊天。"
                            }
                        },
                        {
                            "text": "The library doors open directly onto a grassy <w>quadrangle</w> shaded by old oak trees.",
                            "target_lang_translations": {
                                "zh": "图书馆大门直接通向一个绿草如茵、古老橡树遮荫的<w>四方院子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quad"
                    ],
                    "common_phrases": [
                        "college quadrangle",
                        "grassy quadrangle",
                        "central quadrangle"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指大学校园内四面被建筑环绕的）四合院，方庭，四方院子"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "方庭",
                                "target_lang_sense_clarification": "大学或学院内的四方形开阔院子"
                            },
                            {
                                "target_lang_word": "四合院",
                                "target_lang_sense_clarification": "四面有建筑环绕的院落"
                            },
                            {
                                "target_lang_word": "四方院子",
                                "target_lang_sense_clarification": "四周被大楼包围的中庭空地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "637eca70-9acc-3c9d-8f32-c3b337130254",
                    "sense_definition": "A flat geometric shape with four straight sides and four angles; a four-sided polygon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geometry teacher asked the students to calculate the perimeter of an irregular <w>quadrangle</w>.",
                            "target_lang_translations": {
                                "zh": "几何老师让学生们计算一个不规则<w>四边形</w>的周长。"
                            }
                        },
                        {
                            "text": "Any four-sided figure with straight lines can technically be classified as a <w>quadrangle</w>.",
                            "target_lang_translations": {
                                "zh": "从学术上讲，任何由直线构成的四边图形都可以归类为<w>四边形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quadrilateral",
                        "tetragon",
                        "4-gon"
                    ],
                    "target_lang_definitions": {
                        "zh": "四边形，四角形"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四边形",
                                "target_lang_sense_clarification": "几何学中具有四条边和四个内角的多边形"
                            },
                            {
                                "target_lang_word": "四角形",
                                "target_lang_sense_clarification": "由四条线段围成的平面图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85df38b8-7ab0-3cba-ba02-d018c882ca12",
                    "sense_definition": "A rectangular set of buildings that surrounds and encloses a courtyard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courtyard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic <w>quadrangle</w> was designed in the nineteenth century to house student dormitories.",
                            "target_lang_translations": {
                                "zh": "这座历史悠久的<w>四合院式建筑</w>建于十九世纪，用作学生宿舍。"
                            }
                        },
                        {
                            "text": "Architects planned the new university department as an enclosed <w>quadrangle</w> facing the gardens.",
                            "target_lang_translations": {
                                "zh": "建筑师将这栋新的大学院系大楼规划为面向花园的封闭式<w>方庭建筑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quad"
                    ],
                    "target_lang_definitions": {
                        "zh": "围绕庭院的四合院式建筑群，方庭建筑"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "方庭建筑",
                                "target_lang_sense_clarification": "四周环绕中庭的四方建筑群"
                            },
                            {
                                "target_lang_word": "四合院式建筑",
                                "target_lang_sense_clarification": "四面围合的建筑群落"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}