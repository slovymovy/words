                                    },
                                    {
                                        "sense_id": "e4145fc3-6e68-3bac-a5b6-ffbc820c53ba",
                                        "entry_id": "d09ff919-ce86-30db-91be-376ff034282c",
                                        "glosses": [
                                            "Qui concerne la possibilité et l’impossibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba90bd5-8007-47d6-a1f0-484f48adbfec",
                                                "sense_id": "e4145fc3-6e68-3bac-a5b6-ffbc820c53ba",
                                                "text": "La logique possibiliste est une logique de l’incertain, proposée par Dubois et Prade depuis 1987 et également développée par Lang, afin de traiter commodément le caractère incertain de l’information."
                                            }
                                        ]
