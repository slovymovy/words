        "nl-extract.jsonl": [
            {
                "entry_id": "9050d2fe-50e3-33f2-90ae-e3dec53e3c37",
                "word": "bedekt",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ce2fd71a-d337-3d22-a986-52a0cc84f4b4",
                        "entry_id": "9050d2fe-50e3-33f2-90ae-e3dec53e3c37",
                        "glosses": [
                            "met iets eroverheen, zodat je het niet ziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b26021-3544-45aa-9e55-a454503d5cca",
                                "sense_id": "ce2fd71a-d337-3d22-a986-52a0cc84f4b4",
                                "text": "Zoals aangegeven, ziet de regering het als een maatschappelijke norm dat burgers elkaar in bepaalde situaties niet met bedekt gezicht tegemoet treden, elkaar kunnen herkennen en in het gezicht kunnen kijken."
                            },
                            {
                                "example_id": "75fdf140-da28-4cf2-813f-fdb4cb8e8672",
                                "sense_id": "ce2fd71a-d337-3d22-a986-52a0cc84f4b4",
                                "text": "Zo ver je kon kijken waren de bergen bedekt met sneeuw, fonkelend in de ochtendzon."
                            },
                            {
                                "example_id": "45910b3c-130c-4dc3-a3da-a7f2ddda6f16",
                                "sense_id": "ce2fd71a-d337-3d22-a986-52a0cc84f4b4",
                                "text": "Als een deken die een slapend mythisch wezen bedekt ligt de nevel boven het IJ. Van de kade is weinig te zien: alleen hier en daar de kruin van een gebouw. Uit die witte duisternis doemt zijn schim op de kade op, een zongebruinde man in een zomerjasje en een grijze pantalon, die met zijn vuisten in zijn zakken begraven richting de kade loopt."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6f114d-585c-32e8-8329-67ecf9a8ce8b",
                        "entry_id": "9050d2fe-50e3-33f2-90ae-e3dec53e3c37",
                        "glosses": [
                            "met iets dat het beschermt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1f287a-d742-47a9-ab61-5c4c71ec1b0d",
                                "sense_id": "3b6f114d-585c-32e8-8329-67ecf9a8ce8b",
                                "text": "Rond de hele vesting liep een bedekte weg achter een aarden wal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6258bad-1d6d-3136-a260-63bc4a92bead",
                        "entry_id": "9050d2fe-50e3-33f2-90ae-e3dec53e3c37",
                        "glosses": [
                            "niet openlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6267053-8da2-4255-93e3-70e2402cb9fb",
                                "sense_id": "c6258bad-1d6d-3136-a260-63bc4a92bead",
                                "text": "De uitbundige lof voor haar inzet was ook een bedekt verwijt aan haar man, die nooit iets deed."
                            }
                        ]
                    }
                ],
