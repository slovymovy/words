                "senses": [
                    {
                        "sense_id": "fb7c2e13-dc2a-3dd0-b145-a747f9b96c36",
                        "entry_id": "baf08108-1d6f-3872-b00b-e11f6ea4599e",
                        "glosses": [
                            "Faire perdre son caractère amazigh à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462417e2-5791-4852-b7a7-b6a28e932ddf",
                                "sense_id": "fb7c2e13-dc2a-3dd0-b145-a747f9b96c36",
                                "text": "Quand on arabise en algérie, on veut désamazighiser !!!!"
                            },
                            {
                                "example_id": "f2a28969-bcc2-494f-aa99-2d4af0c9850b",
                                "sense_id": "fb7c2e13-dc2a-3dd0-b145-a747f9b96c36",
                                "text": "Au contraire, toute tentative de l'Etat pour « désamazighiser » l'Algérie s'est soldée par un raffermissement de la lutte pour imposer le fait amazigh."
                            },
                            {
                                "example_id": "2a3da3ed-14f3-42ea-a32b-ac5caad1aa9f",
                                "sense_id": "fb7c2e13-dc2a-3dd0-b145-a747f9b96c36",
                                "text": "Il est surprenant, voire inquiétant, par exemple, que des associations de développement, des centres d'études et de développement local aient «désamazighisé» leurs actions, alors qu'ils prétendent adopter une approche intégrée impliquant l'Homme, la Terre et la Culture."
                            }
                        ]
                    }
