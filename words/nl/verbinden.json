    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a101bee1-37df-33e6-9d0b-bd3b026fb0f4",
                    "sense_definition": "twee of meer onderdelen aan elkaar vastmaken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "koppelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee schepen werden met een kabel <w>verbonden</w>.",
                            "target_lang_translations": {
                                "en": "The two ships were <w>connected</w> by a cable.",
                                "ru": "Два корабля были <w>соединены</w> тросом."
                            }
                        },
                        {
                            "text": "Je moet de rode draad met de blauwe draad <w>verbinden</w>.",
                            "target_lang_translations": {
                                "en": "You must <w>join</w> the red wire to the blue wire.",
                                "ru": "Ты должен <w>соединить</w> красный провод с синим."
                            }
                        }
                    ],
                    "synonyms": [
                        "connecteren"
                    ],
                    "antonyms": [
                        "scheiden",
                        "losmaken"
                    ],
                    "common_phrases": [
                        "met elkaar verbinden",
                        "onderdelen verbinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To fasten two or more parts together.",
                        "ru": "Соединять две или более части друг с другом."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "to join two objects together"
                            },
                            {
                                "target_lang_word": "join",
                                "target_lang_sense_clarification": "to bring together to form a unit"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "to create a physical connection"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "скреплять физические объекты"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "соединять веревкой или кабелем"
                            },
                            {
                                "target_lang_word": "совмещать",
                                "target_lang_sense_clarification": "приводить в соприкосновение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74a9f3d9-2b30-3761-a107-13e0c1f09904",
                    "sense_definition": "een wond behandelen door het aanbrengen van een verband",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegster zal de diepe wond voorzichtig <w>verbinden</w>.",
                            "target_lang_translations": {
                                "en": "The nurse will carefully <w>bandage</w> the deep wound.",
                                "ru": "Медсестра осторожно <w>перевяжет</w> глубокую рану."
                            }
                        },
                        {
                            "text": "Na het ongeluk moest de arts zijn been direct <w>verbinden</w>.",
                            "target_lang_translations": {
                                "en": "After the accident, the doctor had to <w>dress</w> his leg immediately.",
                                "ru": "После аварии врачу пришлось немедленно <w>забинтовать</w> ему ногу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een wond verbinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat a wound by applying a bandage.",
                        "ru": "Обрабатывать рану путем наложения повязки."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bandage",
                                "target_lang_sense_clarification": "to apply a medical strip to a wound"
                            },
                            {
                                "target_lang_word": "dress",
                                "target_lang_sense_clarification": "to clean and cover a wound"
                            },
                            {
                                "target_lang_word": "bind up",
                                "target_lang_sense_clarification": "to wrap a wound tightly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перевязывать",
                                "target_lang_sense_clarification": "накладывать бинт на рану"
                            },
                            {
                                "target_lang_word": "бинтовать",
                                "target_lang_sense_clarification": "обматывать бинтом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dd2e34f-bff5-33af-9797-1694e4587b4c",
                    "sense_definition": "met iets of iemand contact maken via de telefoonlijn of internet",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger moest je met de hand <w>verbonden</w> worden door een telefoniste.",
                            "target_lang_translations": {
                                "en": "In the past, you had to be <w>connected</w> manually by an operator.",
                                "ru": "Раньше телефонистка должна была <w>соединять</w> вас вручную."
                            }
                        },
                        {
                            "text": "Kunt u mij <w>verbinden</w> met de afdeling verkoop?",
                            "target_lang_translations": {
                                "en": "Could you <w>put</w> me <w>through</w> to the sales department?",
                                "ru": "Вы можете <w>соединить</w> меня с отделом продаж?"
                            }
                        }
                    ],
                    "synonyms": [
                        "connecten",
                        "connecteren"
                    ],
                    "antonyms": [
                        "verbreken"
                    ],
                    "common_phrases": [
                        "iemand doorverbinden",
                        "met internet verbinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To establish contact with something or someone via a telephone line or the internet.",
                        "ru": "Устанавливать контакт с кем-либо или чем-либо по телефону или через интернет."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "to establish a technical communication link"
                            },
                            {
                                "target_lang_word": "put through",
                                "target_lang_sense_clarification": "to connect someone on the telephone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "устанавливать связь по телефону"
                            },
                            {
                                "target_lang_word": "подключать",
                                "target_lang_sense_clarification": "к сети или интернету"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bbf1ce3-786c-3731-86ac-976ba04026bb",
                    "sense_definition": "zichzelf een dwingende verplichting of belofte opleggen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belofte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij weigerde zich ertoe te <w>verbinden</w>.",
                            "target_lang_translations": {
                                "en": "He refused to <w>commit</w> himself to it.",
                                "ru": "Он отказался <w>обязываться</w> к этому."
                            }
                        },
                        {
                            "text": "De partijen <w>verbinden</w> zich aan de nieuwe regels van het contract.",
                            "target_lang_translations": {
                                "en": "The parties <w>bind</w> themselves to the new rules of the contract.",
                                "ru": "Стороны <w>обязуются</w> соблюдать новые правила контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "connecteren"
                    ],
                    "common_phrases": [
                        "zich verbinden aan",
                        "zich verbinden tot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak reflexief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To impose a binding obligation or promise upon oneself.",
                        "ru": "Налагать на себя обязательство или обещание."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commit",
                                "target_lang_sense_clarification": "to pledge oneself to a certain course of action"
                            },
                            {
                                "target_lang_word": "bind",
                                "target_lang_sense_clarification": "to hold someone to a promise or contract"
                            },
                            {
                                "target_lang_word": "obligate",
                                "target_lang_sense_clarification": "to bind by a legal or moral tie"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обязываться",
                                "target_lang_sense_clarification": "брать на себя обязательство"
                            },
                            {
                                "target_lang_word": "связывать себя",
                                "target_lang_sense_clarification": "обещанием или контрактом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c03e9c7-4ddd-3687-9639-f574f9321dc5",
                    "sense_definition": "onlosmakelijk met elkaar samenhangen of een abstracte relatie hebben",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Nationale 7 is <w>verbonden</w> met de opkomst van de auto in de jaren twintig.",
                            "target_lang_translations": {
                                "en": "The National 7 is <w>associated</w> with the rise of the car in the 1920s.",
                                "ru": "Трасса National 7 <w>связана</w> с появлением автомобиля в двадцатые годы."
                            }
                        },
                        {
                            "text": "Het is belangrijk om je innerlijke instincten te <w>verbinden</w> met de natuur.",
                            "target_lang_translations": {
                                "en": "It is important to <w>connect</w> your inner instincts with nature.",
                                "ru": "Важно <w>связать</w> свои внутренние инстинкты с природой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verbonden zijn met"
                    ],
                    "target_lang_definitions": {
                        "en": "To be inextricably linked or to have an abstract relationship.",
                        "ru": "Быть неразрывно связанным или иметь абстрактную связь."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "associate",
                                "target_lang_sense_clarification": "to connect ideas or things in the mind"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "to have a logical or causal connection"
                            },
                            {
                                "target_lang_word": "connect",
                                "target_lang_sense_clarification": "to have a relationship or association"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "иметь логическую или причинную связь"
                            },
                            {
                                "target_lang_word": "ассоциировать",
                                "target_lang_sense_clarification": "связывать понятия в уме"
                            },
                            {
                                "target_lang_word": "соотносить",
                                "target_lang_sense_clarification": "устанавливать соотношение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
