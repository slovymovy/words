                "senses": [
                    {
                        "sense_id": "311918da-28a9-361c-8da0-c33b75eb26a0",
                        "entry_id": "0d8af5a1-7d8e-3741-b1dc-872580c3a7d4",
                        "glosses": [
                            "in einem Raum eingerichtete Ecke (Sitzecke) zum Lesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e6d4b2b-6407-46fc-9e3a-4b6c7433ec18",
                                "sense_id": "311918da-28a9-361c-8da0-c33b75eb26a0",
                                "text": "„Viel Anklang finden der spielerische und kindergerechte Unterricht und das wohnliche Klassenzimmer. Spiel- und Leseecken, Puppen und Kuscheltiere sorgen für eine kindliche Atmosphäre.“"
                            },
                            {
                                "example_id": "10f69f21-cdcb-4752-b9fa-e34fae32c3b0",
                                "sense_id": "311918da-28a9-361c-8da0-c33b75eb26a0",
                                "text": "„Mancher Geschäftsinhaber wirbt mit Gratisgetränken, andere mit kuscheligen Leseecken.“"
                            },
                            {
                                "example_id": "6ea00b2b-1cba-4d03-b2e3-a0ad3b2c309d",
                                "sense_id": "311918da-28a9-361c-8da0-c33b75eb26a0",
                                "text": "„Manche verziehen sich gleich in die Leseecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
