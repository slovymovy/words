                                    {
                                        "sense_id": "07db15d3-0897-3eba-a66e-eb7b15ff6ce7",
                                        "entry_id": "b7b00375-a204-3de9-a8ee-dd134bdbacc3",
                                        "glosses": [
                                            "ein Unfall, der sich während der Arbeit oder auf dem Weg dahin ereignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f57565-5f14-4b97-ac0e-8eab79c69bbe",
                                                "sense_id": "07db15d3-0897-3eba-a66e-eb7b15ff6ce7",
                                                "text": "Die Zahl der Arbeitsunfälle ist gegenüber den Vorjahren deutlich zurückgegangen."
                                            },
                                            {
                                                "example_id": "93ca5516-fa88-4dfc-bcb8-b33e3f1b25ce",
                                                "sense_id": "07db15d3-0897-3eba-a66e-eb7b15ff6ce7",
                                                "text": "Arbeitsunfälle und Berufskrankheiten sind Versicherungsfälle der gesetzlichen Unfallversicherung."
                                            },
                                            {
                                                "example_id": "1d2c7ead-96bc-4ee5-980c-2fdb1d9f5c72",
                                                "sense_id": "07db15d3-0897-3eba-a66e-eb7b15ff6ce7",
                                                "text": "„Er arbeitete als Fensterputzer, bis er den Job nach einem Arbeitsunfall verlor.“"
                                            }
