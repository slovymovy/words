                        "examples": [
                            {
                                "example_id": "55cc7781-b126-4f50-b01f-4fea2dcdad0e",
                                "sense_id": "c0d2a973-979e-3229-b747-ed7eb6d099ea",
                                "text": "Issu cépages aspiran, carrignan, cinsault, grenache, lledoner pelut, mourvèdre, syrah et terret pour les vins rouges et rosés, bourboulenc, grenache, maccabeu, marsanne, roussanne et vermentino pour les vins blancs."
                            },
                            {
                                "example_id": "b979ff0b-dad5-4f9f-9a20-7022d4feae4b",
                                "sense_id": "c0d2a973-979e-3229-b747-ed7eb6d099ea",
                                "text": "Grenaches gris et blancs : ces cépages sont principalement employés pour les vins doux naturels. Récoltés très mûrs, ils donnent des degrés alcooliques élevés. Assemblés aux maccabeus, les grenaches apportent de la puissance, du corps."
                            }
                        ]
