                                    {
                                        "sense_id": "2cff651a-d42c-33fb-abb7-9ab5df2f0b59",
                                        "entry_id": "28d9e343-aa0c-3f03-9124-511ee2067853",
                                        "glosses": [
                                            "Someone who believes in individualism as a sociopolitical system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "205e0c38-e9d0-3cd1-b17f-3a4f99487274",
                                        "entry_id": "28d9e343-aa0c-3f03-9124-511ee2067853",
                                        "glosses": [
                                            "Someone who believes in the philosophy of individualism; a solipsist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "620d472a-e165-3458-be44-e945353bcf20",
                                        "entry_id": "28d9e343-aa0c-3f03-9124-511ee2067853",
                                        "glosses": [
                                            "Someone who does as they wish, unconstrained by external influences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef59366-1ada-40f7-9a70-ba00fe2f2ad1",
                                                "sense_id": "620d472a-e165-3458-be44-e945353bcf20",
                                                "text": "However, apart from all this, the Chief was a grand old man, belonging to a class of individualists which seems to be dying out in these days, when standard behaviour seems to be as prevalent as standard designs."
                                            },
                                            {
                                                "example_id": "e0267317-d749-4c9b-a4ad-b39e3c1e3c2a",
                                                "sense_id": "620d472a-e165-3458-be44-e945353bcf20",
                                                "text": "Miró was too much of an individualist to simply subscribe to an aesthetic party platform of Mediterranean art, which wanted to move forward, but only at a safe trot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
