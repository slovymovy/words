                    },
                    {
                        "form_id": "64daf54d-0cc9-4425-b4aa-d96c9223f1ca",
                        "entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
                        "tags": [
                            "past"
                        ],
                        "form": "teleported"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bea99aac-ba6b-33ea-956f-85c011c5ce88",
                        "entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
                        "glosses": [
                            "To travel, often instantaneously, from one point to another without physically crossing the distance between the two points."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "02552319-84d8-4398-95b9-02fd3eb6335d",
                                "sense_id": "bea99aac-ba6b-33ea-956f-85c011c5ce88",
                                "text": "I teleported home one night\nWith Ron and Sid and Meg.\nRon stole Meggie's heart away\nAnd I got Sidney's leg."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f4cd8d-c0d2-39c7-a882-13cd6ad96a59",
                        "entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
                        "glosses": [
                            "To move (an object) in this fashion, as by telekinesis."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027c7d3d-162c-44a8-85f0-139580833186",
                        "source_entry_id": "34231ce1-686c-39ed-9dad-477a8785d1e2",
