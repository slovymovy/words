                        "examples": [
                            {
                                "example_id": "193e1190-634d-4f18-8593-8cb008eb738a",
                                "sense_id": "b345a732-704e-3eab-a8df-722f587802a3",
                                "text": "Find 'em, feel 'em' fugg 'em, and forget 'm is my motto."
                            },
                            {
                                "example_id": "a7e9576b-6e2c-4fd8-a0bf-90e0e9271074",
                                "sense_id": "b345a732-704e-3eab-a8df-722f587802a3",
                                "text": "'Fugg me stiff! Fugg me gently! Fugg me sideways!'"
                            },
                            {
                                "example_id": "b3b5766d-3f65-499f-b4a5-edb612107132",
                                "sense_id": "b345a732-704e-3eab-a8df-722f587802a3",
                                "text": "The players on the team paid close attention to Justin, although most of them couldn't hear him finish just about everything that he signed by mouthing the phrase, “Fugg you, fugg you!”"
                            },
                            {
                                "example_id": "437318df-00ef-421b-ab20-539ed0b03f10",
                                "sense_id": "b345a732-704e-3eab-a8df-722f587802a3",
                                "text": "Oh fugg my duty."
                            }
                        ]
                    }
