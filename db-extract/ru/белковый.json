                    {
                        "form_id": "76a0215f-b834-43bf-bae3-64099fae9bb2",
                        "entry_id": "ee6f4f97-76ed-30b4-8913-e6ed42666e29",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "белко́вых"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd5852dd-bfb7-3fb6-80be-0e7e0ec40af1",
                        "entry_id": "ee6f4f97-76ed-30b4-8913-e6ed42666e29",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным белки; состоящий из белка или белков, с высоким содержанием белка или белков; протеиновый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7760fed4-9277-47f2-bd00-80822065e149",
                                "sense_id": "cd5852dd-bfb7-3fb6-80be-0e7e0ec40af1",
                                "text": "Молекулы отбирают, сортируют, группируют атомы, соединяя их в строгом порядке, для того чтобы создавать новые белковые молекулы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d8fc484-dcaa-4ccf-99d0-fb651b53e4fe",
                        "source_entry_id": "ee6f4f97-76ed-30b4-8913-e6ed42666e29",
                        "source_sense_id": "cd5852dd-bfb7-3fb6-80be-0e7e0ec40af1",
                        "target_lang_word": "protein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6cc60c-c7b9-31e5-a3b6-ff59f4e126c0",
                                        "entry_id": "ad89a659-b614-3f6f-b5ec-0b1beeb42979",
                                        "glosses": [
                                            "Any of numerous large, complex naturally-produced molecules composed of one or more long chains of amino acids, in which the amino acid groups are held together by peptide bonds."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "851a5180-e72f-4add-99a3-eff023b847ec",
                                                "sense_id": "ea6cc60c-c7b9-31e5-a3b6-ff59f4e126c0",
                                                "text": "Proteins carry out the bulk of cellular functions, including relaying signals, providing structural support, and accelerating biochemical reactions."
                                            },
                                            {
                                                "example_id": "52a1613e-5c2e-45d9-baa8-e6f6ab130d2d",
                                                "sense_id": "ea6cc60c-c7b9-31e5-a3b6-ff59f4e126c0",
                                                "text": "Because of her significant testing, Avery had had DNA sequencing of her “exome,” the part of her genome that makes proteins in the body, said Dr. Michael Wangler, a researcher at the Jan and Dan Duncan Neurological Research Institute at Texas Children’s Hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6c1b43-816b-3814-9472-e45969a653eb",
                                        "entry_id": "ad89a659-b614-3f6f-b5ec-0b1beeb42979",
                                        "glosses": [
                                            "One of three major classes of food or source of food energy (4 kcal/gram) abundant in animal-derived foods (meat) and some vegetables, such as legumes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94c1702-dcf6-46d0-9c6a-a44a78eb6859",
                                                "sense_id": "cf6c1b43-816b-3814-9472-e45969a653eb",
                                                "text": "Along with carbohydrates and fat, protein is one of the three main macronutrients that make up our diet. Furthermore, it is the only macronutrient that supplies us with amino acids, making it essential for survival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02b3ce8-9851-3f93-a589-99775831249a",
                                        "entry_id": "ad89a659-b614-3f6f-b5ec-0b1beeb42979",
                                        "glosses": [
                                            "A food rich in protein, often a meat or meat substitute."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e80d0ee-86ad-41e1-b958-a799afb1b0a7",
                                                "sense_id": "e02b3ce8-9851-3f93-a589-99775831249a",
                                                "text": "The preparation style should be the same for both proteins so that the side dishes compliment the meal."
                                            },
                                            {
                                                "example_id": "1c84981a-9d9f-4747-92a5-41e7aa3446b2",
                                                "sense_id": "e02b3ce8-9851-3f93-a589-99775831249a",
                                                "text": "Served with seasoned rice, classic Greek salad, pita, tzatziki, choice of 2 proteins & 2 sides"
                                            },
                                            {
                                                "example_id": "c7cb8d0d-8604-4bbd-99b1-1920138c7c84",
                                                "sense_id": "e02b3ce8-9851-3f93-a589-99775831249a",
                                                "text": "What should you get for lunch at a halal cart? Nutritionists explain how to pick a protein that isn't packed with calories and why you should beware the white sauce"
                                            }
                                        ]
                                    }
                                ]
                            }
