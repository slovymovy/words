                                        "entry_id": "2c0e02ba-a3b3-3e6a-a9c1-84a5b2215cc2",
                                        "glosses": [
                                            "Viande de porc préparée par les charcutiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a8b5d3-49b9-4bca-b900-a5d8fb03d54a",
                                                "sense_id": "69357b20-10d3-312e-b20f-1ec4e71cf319",
                                                "text": "L’équipe montre pour la première fois, in vivo chez le rat, qu'une charcuterie modèle riche en hème (…), salée, additionnée de nitrites, cuite et oxydée était promotrice du développement du cancer colorectal."
                                            }
                                        ]
