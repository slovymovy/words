{
    "word_family": [
        "wrenching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb7f91b7-6e93-3fbe-b541-d39f51b2d67c",
                    "sense_definition": "A hand tool used for holding, twisting, or turning objects such as nuts, bolts, or pipes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tool_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a <w>wrench</w> to tighten the loose bolt on the bicycle wheel.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>гаечный ключ</w>, чтобы затянуть разболтавшийся болт на велосипедном колесе.",
                                "zh": "他用<w>扳手</w>拧紧了自行车轮上松动的螺栓。",
                                "es": "Usó una <w>llave</w> para apretar el perno suelto de la rueda de la bicicleta."
                            }
                        },
                        {
                            "text": "Please pass me the adjustable <w>wrench</w> so I can fix this leaking pipe.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, передай мне <w>разводной ключ</w>, чтобы я мог починить эту протекающую трубу.",
                                "zh": "请把<w>活动扳手</w>递给我，我好修一下这个漏水的管子。",
                                "es": "Por favor, pásame la <w>llave</w> inglesa para que pueda arreglar esta tubería que gotea."
                            }
                        }
                    ],
                    "synonyms": [
                        "spanner"
                    ],
                    "common_phrases": [
                        "adjustable wrench",
                        "socket wrench",
                        "monkey wrench",
                        "torque wrench"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly North American English; see 'spanner' for British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент для удержания, вращения или закручивания таких предметов, как гайки, болты или трубы.",
                        "zh": "一种用于夹持、扭转或旋转螺母、螺栓或管道等物体的工具。",
                        "es": "Herramienta manual utilizada para sujetar, girar o apretar objetos como tuercas, pernos o tuberías."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гаечный ключ",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "разводной ключ",
                                "target_lang_sense_clarification": "инструмент с регулируемыми губками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扳手",
                                "target_lang_sense_clarification": "通用工具"
                            },
                            {
                                "target_lang_word": "活动扳手",
                                "target_lang_sense_clarification": "可调节开口大小的扳手"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "llave",
                                "target_lang_sense_clarification": "término general para herramientas de apriete"
                            },
                            {
                                "target_lang_word": "llave inglesa",
                                "target_lang_sense_clarification": "llave ajustable, común en España"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8456533-2309-387c-8709-19aed6a36e64",
                    "sense_definition": "A sudden, violent twisting or pulling movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a sudden <w>wrench</w>, she managed to open the stuck jar lid.",
                            "target_lang_translations": {
                                "ru": "Резким <w>рывком</w> ей удалось открыть застрявшую крышку банки.",
                                "zh": "她<w>猛地一扭</w>，终于打开了卡住的罐子盖。",
                                "es": "Con un <w>tirón</w> repentino, logró abrir la tapa atascada del frasco."
                            }
                        },
                        {
                            "text": "He gave the door handle a violent <w>wrench</w>, but it still refused to open.",
                            "target_lang_translations": {
                                "ru": "Он с силой <w>дёрнул</w> дверную ручку, но дверь всё равно не открывалась.",
                                "zh": "他<w>猛拉</w>了一下门把手，但门还是打不开。",
                                "es": "Le dio un <w>tirón</w> violento al pomo de la puerta, pero aun así no se abría."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a wrench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, резкое скручивающее или тянущее движение; рывок.",
                        "zh": "一种突然且剧烈的扭转或拉扯动作。",
                        "es": "Un movimiento repentino y violento de torsión o tirón."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "скручивание",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛拉",
                                "target_lang_sense_clarification": "剧烈的拉扯动作"
                            },
                            {
                                "target_lang_word": "猛扭",
                                "target_lang_sense_clarification": "剧烈的扭转动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tirón",
                                "target_lang_sense_clarification": "acción de tirar con fuerza"
                            },
                            {
                                "target_lang_word": "sacudida",
                                "target_lang_sense_clarification": "movimiento brusco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7da0e3f-959b-3c79-bd4c-85f81120d11e",
                    "sense_definition": "A feeling of sadness or distress caused by leaving a place or person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a terrible <w>wrench</w> to leave her friends and family behind.",
                            "target_lang_translations": {
                                "ru": "Для неё было настоящей <w>мукой</w> оставить своих друзей и семью.",
                                "zh": "离开她的朋友和家人真是一件让人<w>心痛</w>的事。",
                                "es": "Fue un <w>desgarro</w> terrible dejar atrás a sus amigos y familiares."
                            }
                        },
                        {
                            "text": "Moving abroad was a real <w>wrench</w>, but he knew it was necessary for his career.",
                            "target_lang_translations": {
                                "ru": "Переезд за границу дался ему с <w>болью</w>, но он знал, что это необходимо для его карьеры.",
                                "zh": "移居国外确实让人<w>难舍</w>，但他知道这对他的职业生涯是必要的。",
                                "es": "Mudarse al extranjero fue un verdadero <w>dolor</w>, pero sabía que era necesario para su carrera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a wrench to leave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокой печали или душевной боли, вызванное расставанием с кем-либо или чем-либо.",
                        "zh": "因离开某地或某人而产生的悲伤或痛苦的感觉。",
                        "es": "Sentimiento de tristeza o angustia causado por dejar un lugar o una persona."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "душевная боль",
                                "target_lang_sense_clarification": "чувство страдания"
                            },
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "сильное страдание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心痛",
                                "target_lang_sense_clarification": "深层的心理痛苦"
                            },
                            {
                                "target_lang_word": "难舍",
                                "target_lang_sense_clarification": "离别时的痛苦感受"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dolor",
                                "target_lang_sense_clarification": "sufrimiento emocional"
                            },
                            {
                                "target_lang_word": "desgarro",
                                "target_lang_sense_clarification": "sentimiento de pérdida profunda"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e44a04c-564e-376f-8729-dc6b8157b37c",
                    "sense_definition": "To pull or twist something suddenly and violently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wrenched</w> the door open and ran outside into the fresh air.",
                            "target_lang_translations": {
                                "ru": "Она <w>рванула</w> дверь на себя и выбежала на свежий воздух.",
                                "zh": "她<w>猛地拉</w>开门，跑到了外面的新鲜空气中。",
                                "es": "Ella <w>arrancó</w> la puerta al abrirla y salió corriendo al aire fresco."
                            }
                        },
                        {
                            "text": "The thief tried to <w>wrench</w> the bag from her hand, but she held on tight.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>вырвать</w> сумку у неё из рук, но она крепко держала её.",
                                "zh": "小偷试图从她手中<w>夺</w>走包，但她紧紧抓着不放。",
                                "es": "El ladrón intentó <w>arrancar</w> el bolso de su mano, pero ella se sujetó fuerte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrench open",
                        "wrench free",
                        "wrench away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рвать или крутить что-либо резко и с силой; вырывать.",
                        "zh": "突然且剧烈地拉扯或扭转某物。",
                        "es": "Tirar o torcer algo de manera repentina y violenta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырывать",
                                "target_lang_sense_clarification": "силой отнимать или извлекать"
                            },
                            {
                                "target_lang_word": "выкручивать",
                                "target_lang_sense_clarification": "крутить с силой"
                            },
                            {
                                "target_lang_word": "вывёртывать",
                                "target_lang_sense_clarification": "крутить, выворачивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛拉",
                                "target_lang_sense_clarification": "用力拉扯"
                            },
                            {
                                "target_lang_word": "夺",
                                "target_lang_sense_clarification": "强行抢走"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "arrancar",
                                "target_lang_sense_clarification": "quitar algo con fuerza"
                            },
                            {
                                "target_lang_word": "tirar",
                                "target_lang_sense_clarification": "ejercer fuerza sobre algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41ce3972-bf51-398f-9b3c-77a815c0e27e",
                    "sense_definition": "To injure a part of the body, especially a joint, by twisting it suddenly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>wrench</w> your ankle while walking on those loose stones.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не <w>подверни</w> лодыжку, гуляя по этим шатким камням.",
                                "zh": "走在那些松动的石头上时要小心，别<w>扭伤</w>了脚踝。",
                                "es": "Ten cuidado de no <w>torcerte</w> el tobillo mientras caminas sobre esas piedras sueltas."
                            }
                        },
                        {
                            "text": "The athlete <w>wrenched</w> his knee during the game and had to be carried off the field.",
                            "target_lang_translations": {
                                "ru": "Спортсмен <w>вывихнул</w> колено во время игры, и его пришлось уносить с поля.",
                                "zh": "那名运动员在比赛中<w>扭伤</w>了膝盖，不得不被抬下场。",
                                "es": "El atleta se <w>torció</w> la rodilla durante el partido y tuvo que ser retirado del campo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wrench an ankle",
                        "wrench a knee",
                        "wrench a back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повредить часть тела, особенно сустав, резким поворотом; вывихнуть или растянуть.",
                        "zh": "因突然扭转而损伤身体部位，尤其是关节。",
                        "es": "Lesionar una parte del cuerpo, especialmente una articulación, al torcerla repentinamente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывихнуть",
                                "target_lang_sense_clarification": "сместить сустав"
                            },
                            {
                                "target_lang_word": "подвернуть",
                                "target_lang_sense_clarification": "повредить сустав неловким движением"
                            },
                            {
                                "target_lang_word": "растянуть",
                                "target_lang_sense_clarification": "повредить связки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扭伤",
                                "target_lang_sense_clarification": "关节损伤"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "torcerse",
                                "target_lang_sense_clarification": "lesionar una articulación"
                            },
                            {
                                "target_lang_word": "esguinzarse",
                                "target_lang_sense_clarification": "sufrir un esguince"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "680e3168-ca0a-3b79-a5ee-6123022e75e0",
                    "sense_definition": "To cause great emotional pain or distress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic news <w>wrenched</w> our hearts and left us in deep mourning.",
                            "target_lang_translations": {
                                "ru": "Трагическая новость <w>разрывала</w> нам сердца и оставила нас в глубоком трауре.",
                                "zh": "这则悲剧新闻令我们<w>揪心</w>，让我们陷入了深深的哀悼之中。",
                                "es": "La trágica noticia nos <w>desgarró</w> el corazón y nos dejó en un profundo duelo."
                            }
                        },
                        {
                            "text": "It <w>wrenched</w> him to see his children suffering without being able to help.",
                            "target_lang_translations": {
                                "ru": "Ему <w>терзало</w> душу видеть страдания своих детей и не иметь возможности помочь.",
                                "zh": "看到孩子们受苦却无能为力，这让他感到十分<w>揪心</w>。",
                                "es": "Le <w>atormentaba</w> ver a sus hijos sufrir sin poder ayudar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gut-wrenching",
                        "heart-wrenching"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять сильную душевную боль или страдание.",
                        "zh": "引起巨大的情感痛苦或悲伤。",
                        "es": "Causar un gran dolor emocional o angustia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "мучить душевно"
                            },
                            {
                                "target_lang_word": "щемить",
                                "target_lang_sense_clarification": "вызывать болезненное чувство (о сердце)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "揪心",
                                "target_lang_sense_clarification": "引起极度痛苦"
                            },
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "引起心灵上的剧痛"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "desgarrar",
                                "target_lang_sense_clarification": "causar gran dolor emocional"
                            },
                            {
                                "target_lang_word": "atormentar",
                                "target_lang_sense_clarification": "causar sufrimiento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8640390c-2ffa-30c2-99d9-56dda34693b3",
                    "sense_definition": "A surname transferred from the nickname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wrench</w> was known in the village for his skill in carpentry.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ренч</w> был известен в деревне своим плотницким мастерством.",
                                "zh": "<w>伦奇</w>先生在村里以木工手艺闻名。",
                                "es": "El Sr. <w>Wrench</w> era conocido en el pueblo por su habilidad en la carpintería."
                            }
                        },
                        {
                            "text": "We looked up the history of the <w>Wrench</w> family in the local archives.",
                            "target_lang_translations": {
                                "ru": "Мы искали историю семьи <w>Ренч</w> в местных архивах.",
                                "zh": "我们在当地档案馆查阅了<w>伦奇</w>家族的历史。",
                                "es": "Buscamos la historia de la familia <w>Wrench</w> en los archivos locales."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "源自绰号的姓氏。",
                        "es": "Un apellido derivado de un apodo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ренч",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伦奇",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Wrench",
                                "target_lang_sense_clarification": "apellido"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}