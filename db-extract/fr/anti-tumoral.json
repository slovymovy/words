                "senses": [
                    {
                        "sense_id": "48a6b9d5-fd97-32a2-94bd-feee21d60fc0",
                        "entry_id": "45685161-9c31-3831-a825-17c95eb1a377",
                        "glosses": [
                            "Qui lutte contre les tumeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07830b6-db24-415e-9b3f-86d20a23cf98",
                                "sense_id": "48a6b9d5-fd97-32a2-94bd-feee21d60fc0",
                                "text": "Des études récentes montrent que la chlorella peut être particulièrement utile en complément des traitements anti-tumoraux pour ses propriétés anti-angiogéniques, anti-prolifératives."
                            },
                            {
                                "example_id": "34462050-efea-46ce-8f73-4cf44e927e8f",
                                "sense_id": "48a6b9d5-fd97-32a2-94bd-feee21d60fc0",
                                "text": "Les graines germées ou jeunes pousses de radis rose semblent particulièrement intéressantes pour leur teneur en glucosinolates, aux vertus anti-tumorales, en plus des vitamines A, B (1, 2, 3), C, des minéraux et oligo-éléments dont calcium, magnésium, phosphore, potassium, soufre, iode, fer…"
                            },
                            {
                                "example_id": "8ffc885c-8dab-429f-9abc-27d6ba259dbe",
                                "sense_id": "48a6b9d5-fd97-32a2-94bd-feee21d60fc0",
                                "text": "L’importance des lymphocytes T CD4+ dans la réponse immune anti-tumorale est de plus en plus révélée depuis ces dix dernières années."
                            }
                        ]
                    }
