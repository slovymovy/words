                "senses": [
                    {
                        "sense_id": "50c97469-d65b-3a25-9641-8a3090da52ea",
                        "entry_id": "2dafdc13-8064-315d-b695-06e66bb80594",
                        "glosses": [
                            "Espèce de lièvre des steppes et régions semi-désertiques d’Asie centrale, de la Caspienne à la Chine du Nord-est."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b9ceae0-3646-4c3d-b01e-d47a10555fdb",
                                "sense_id": "50c97469-d65b-3a25-9641-8a3090da52ea",
                                "text": "Le tolai a la queue beaucoup plus longue que le lapin & que le changeant ; mais la plupart des sujets l’ont plus courte que le lièvre, principalement les femelles."
                            },
                            {
                                "example_id": "be4f3459-5373-4dee-b324-3eb6d483cc54",
                                "sense_id": "50c97469-d65b-3a25-9641-8a3090da52ea",
                                "text": "La couleur du tolai est la même que celle de notre lièvre, et elle ne subit presque point d’altération pendant l’hiver."
                            }
                        ]
                    }
                ],
