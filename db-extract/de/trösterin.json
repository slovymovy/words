                        "glosses": [
                            "weibliche Person, die einer anderen Person in ihrer schweren Situation geistigen Beistand gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fadb0fe4-0947-4c1c-8162-9a6493d42ed8",
                                "sense_id": "79c8627d-54a5-3765-8c75-c2bc385816db",
                                "text": "Sie hatte ihre Tante Soffi, die stets als Trösterin in der Not zur Verfügung stand."
                            },
                            {
                                "example_id": "aa1b0bdd-4fad-4257-aeb8-2996d421c969",
                                "sense_id": "79c8627d-54a5-3765-8c75-c2bc385816db",
                                "text": "„Seine Briefe an die Geliebten, die Gefährtinnen, die Trösterinnen spiegeln vieles wider von seiner Sehnsucht nach Nähe und Gemeinsamkeit, seiner Neigung zur Eifersucht, seiner Hilfsbereitschaft.“"
                            }
                        ],
