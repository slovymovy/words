                        "glosses": [
                            "Prononcer de façon nasillarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5eb20b6-0b5a-4b61-a90c-58ecd20311ef",
                                "sense_id": "8e17fbf2-fddd-3ed3-b6a3-6de06d38fc15",
                                "text": "Il est impossible de figurer par exemple, le mot « maison » en patois, force est d’écrire « majon » mais il faudrait « majéon » car il faut allonger et nasillarder la dernière syllabe de façon à rendre un son entre « on et an »."
                            },
                            {
                                "example_id": "3c356c94-7512-4a23-8fd8-16d0923f6872",
                                "sense_id": "8e17fbf2-fddd-3ed3-b6a3-6de06d38fc15",
                                "text": "Il fallait immoler sans pitié, quelques-Uns de ces Lyonnais perfides, qui viennent nasillarder dans les Clubs aristocrates leur doctrine perverse et subversive de votre Gouvernement !"
                            }
                        ]
                    }
