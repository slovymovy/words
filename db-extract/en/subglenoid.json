                        "glosses": [
                            "Located immediately below the glenoid fossa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5f33a6-9765-4753-9e88-ce924d6d5100",
                                "sense_id": "8738ad16-bc3a-36e2-92a3-88b3bc4c4f82",
                                "text": "The patient was a cellarman, aged 58, who had eight weeks fallen on his elbow and received a subglenoid dislocation of the humerus, which, however, was not detected at the time."
                            },
                            {
                                "example_id": "6df68df1-20ff-46d9-9ec8-2f5030ebfbc5",
                                "sense_id": "8738ad16-bc3a-36e2-92a3-88b3bc4c4f82",
                                "text": "As in types of forward dislocation the differentiation between subglenoid and subcoracoid luxations may be merely a matter of slight difference in position of the head."
                            },
                            {
                                "example_id": "35e875a3-ff56-48b1-97d6-d93852167b9d",
                                "sense_id": "8738ad16-bc3a-36e2-92a3-88b3bc4c4f82",
                                "text": "This is distinct from anteroinferior / subglenoid glenohumeral dislocations for which alternative techniques should be used."
                            }
                        ]
                    }
                ],
