                    {
                        "translation_id": "e9c824ec-e75d-4b0e-a116-da7ec37fbdf6",
                        "source_entry_id": "12493cb8-0d6c-3089-b42f-0b15032a48a1",
                        "source_sense_description": "of or pertaining to a parabola or paraboloid",
                        "target_lang_word": "parabolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parabolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1db27847-6939-3781-a600-c38fa31ebe52",
                                        "entry_id": "5a4a3bb6-f5b9-380c-bd68-b9bb84a987d4",
                                        "glosses": [
                                            "Qui a la forme d’une parabole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cbd26eb-16d0-4bab-80e8-5b19d5c0ff41",
                                                "sense_id": "1db27847-6939-3781-a600-c38fa31ebe52",
                                                "text": "Un miroir parabolique."
                                            },
                                            {
                                                "example_id": "cb6057a7-5448-4e96-9314-2fad572502fd",
                                                "sense_id": "1db27847-6939-3781-a600-c38fa31ebe52",
                                                "text": "Par analogie, un radiateur parabolique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0999071a-e9e1-38a5-81d3-ae0dcc6dd7e6",
                                        "entry_id": "5a4a3bb6-f5b9-380c-bd68-b9bb84a987d4",
                                        "glosses": [
                                            "Qui évoque une parabole, qui s'y rapporte ou qui en a la forme."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e911dc4-004f-44c0-b87e-890a3a8aea90",
                                                "sense_id": "0999071a-e9e1-38a5-81d3-ae0dcc6dd7e6",
                                                "text": "Le récit parabolique des vignerons homicides Mc 12,1-12 est probablement une allégorie : le maître envoie plusieurs fois ses serviteurs afin d'encaisser le fermage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parabolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18ff7bfb-e0dc-3275-8a82-df0122eb2667",
                                        "entry_id": "44ec514d-0b95-33fd-a444-09fd47a2ab72",
                                        "glosses": [
                                            "Radiateur mobile ayant la forme d’une parabole."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27999fed-aa9b-4854-aa8c-b9d1eda1107a",
                                                "sense_id": "18ff7bfb-e0dc-3275-8a82-df0122eb2667",
                                                "text": "11 janvier 43 – Il fait toujours aussi froid et on a décidé à la maison de descendre du grenier les affaires de ski. On se croirait dans un Mégève misérable à nous voir groupés serrés autour du parabolique avec nos pantalons norvégiens et nos cols roulés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f599f349-712e-48a0-8f21-6d4e2a7c92b9",
                        "source_entry_id": "12493cb8-0d6c-3089-b42f-0b15032a48a1",
                        "source_sense_description": "of or pertaining to a parabola or paraboloid",
                        "target_lang_word": "parabolisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parabolisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c8c3a2-bcbf-373c-98eb-6961d8971780",
                                        "entry_id": "02e91d3f-e429-30f2-a9bd-ec8c41c5a3c8",
                                        "glosses": [
                                            "der Krümmung einer Parabel oder der Form eines Paraboloids entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b238eb6d-ef86-43e0-963c-b500cb177e17",
                                                "sense_id": "41c8c3a2-bcbf-373c-98eb-6961d8971780",
                                                "text": "In den 1660er-Jahren beobachtete er [der französische Astronom Adrien Auzout] einige Kometen und folgerte, diese liefen auf elliptischen oder parabolischen Bahnen und gehörten somit zum Sonnensystem."
                                            },
                                            {
                                                "example_id": "626718b7-ad99-47e7-a937-24f12d6e4d3a",
                                                "sense_id": "41c8c3a2-bcbf-373c-98eb-6961d8971780",
                                                "text": "Über seinen Gleiter schreibt Otto Lilienthal: „Der Apparat, dessen ich mich bediente, hatte die Gestalt ausgebreiteter Vogelflügel. Der Flügelquerschnitt nach der Flugrichtung war parabolisch gekrümmt.“"
                                            },
                                            {
                                                "example_id": "25998422-cd7a-4cfd-894d-ef5152e7df2b",
                                                "sense_id": "41c8c3a2-bcbf-373c-98eb-6961d8971780",
                                                "text": "In der andalusischen Wüste arbeiten Deutsche und Spanier an der Zukunft der Energieversorgung. Wohin das Auge reicht: Spiegel, rechteckige, runde parabolisch gekrümmte Spiegel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e767ba2c-1f62-3c47-acec-b04769377e8b",
                                        "entry_id": "02e91d3f-e429-30f2-a9bd-ec8c41c5a3c8",
                                        "glosses": [
                                            "in der Art einer lehrreichen kurzen Erzählung (einer Parabel) gleichnishaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42b47c1-8422-429d-86ff-7d2142180667",
                                                "sense_id": "e767ba2c-1f62-3c47-acec-b04769377e8b",
                                                "text": "In Schillers Balladen geht es weniger um Geschichte als um dramatische Geschichten, parabolische Erzählungen, Legenden."
                                            },
                                            {
                                                "example_id": "3cf5b1bd-e18a-4ff5-9c31-dfa8ed44e24b",
                                                "sense_id": "e767ba2c-1f62-3c47-acec-b04769377e8b",
                                                "text": "Es ist der Krieg zwischen Egoismus und Altruismus, zwischen Freiheit und Verantwortungsgefühl. Er bestimmt den ganzen Roman, und in der Katzenepisode verdichtet ihn Jonathan Franzen noch einmal parabolisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
