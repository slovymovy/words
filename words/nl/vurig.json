                    "sense_id": "4dd89f97-a4dc-3140-b29a-f385168b962a",
                    "sense_definition": "vol enthousiasme en passie voor iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
