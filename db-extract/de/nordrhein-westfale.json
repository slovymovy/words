                "senses": [
                    {
                        "sense_id": "0778ddf1-5bfe-340e-8e26-61a3e571086a",
                        "entry_id": "0c9a76e4-7af0-3a73-88d7-e2be28706aa2",
                        "glosses": [
                            "ein im Bundesland Nordrhein-Westfalen (Deutschland) geborener oder dort auf Dauer lebender Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81d0c8b-18d9-4e1a-8bcf-546a88746e78",
                                "sense_id": "0778ddf1-5bfe-340e-8e26-61a3e571086a",
                                "text": "„Den Nordrhein-Westfalen hingegen gibt es nicht als solchen. Er ist entweder Rheinländer oder aus dem Pott, ist Sauerländer, Lipper oder Westfale.“"
                            },
                            {
                                "example_id": "59410bc6-6fcd-41c8-9848-bdec11fb547e",
                                "sense_id": "0778ddf1-5bfe-340e-8e26-61a3e571086a",
                                "text": "Was, du bist Nordrhein-Westfale?"
                            },
                            {
                                "example_id": "529a2331-9ac9-489e-bcef-efeec49fb667",
                                "sense_id": "0778ddf1-5bfe-340e-8e26-61a3e571086a",
                                "text": "Seit 1989 ist Gerald ein Nordrhein-Westfale."
                            },
                            {
                                "example_id": "dac310a8-66a2-4f78-a896-9430562b76b7",
                                "sense_id": "0778ddf1-5bfe-340e-8e26-61a3e571086a",
                                "text": "Im Urlaub haben wir eine Familie aus waschechten Nordrhein-Westfalen getroffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
