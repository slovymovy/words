                },
                {
                    "sense_id": "ed2b6318-e85a-3b89-8e01-3b643c01d721",
                    "sense_definition": "A young Australian Aboriginal man who has completed the initiation into manhood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aboriginal_custom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elders presented weapons to each newly initiated <w>kipper</w>.",
                            "target_lang_translations": {
                                "ru": "Старейшины вручили оружие каждому новому <w>инициированному юноше</w>."
                            }
