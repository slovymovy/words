                        "source_entry_id": "6d169d12-2b83-336a-9238-f0cc262b4649",
                        "source_sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                        "source_sense_description": "eine auf Intuition und nicht auf rationaler Überlegung beruhende Einschätzung von etwas",
                        "target_lang_word": "gut feeling",
