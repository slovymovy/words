                    ],
                    "common_phrases": [
                        "inwendig lachen",
                        "inwendig koken",
                        "inwendige strijd"
                    ],
                    "target_lang_definitions": {
                        "en": "located within the mind or thoughts without showing it outwardly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inwardly",
                                "target_lang_sense_clarification": "in a way that is not expressed or shown to others"
                            },
                            {
                                "target_lang_word": "inner",
                                "target_lang_sense_clarification": "relating to private feelings or mental processes"
                            },
                            {
                                "target_lang_word": "internal",
                                "target_lang_sense_clarification": "experienced in one's mind rather than expressed"
                            }
                        ]
                    }
                }
            ]
