                "senses": [
                    {
                        "sense_id": "73038940-5c77-38ab-95e7-219d10d36f44",
                        "entry_id": "d9437e4a-f48e-3521-8b39-6f712595788e",
                        "glosses": [
                            "Tirer de prison."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "723778a1-504f-4ed2-8618-cc34360518ea",
                                "sense_id": "73038940-5c77-38ab-95e7-219d10d36f44",
                                "text": "Commandant, — et Anastasie porta militairement le dos de la main à sa perruque, — je viens vous déprisonner ..."
                            },
                            {
                                "example_id": "2800f5b5-b70b-459c-ba45-52c3e9027f10",
                                "sense_id": "73038940-5c77-38ab-95e7-219d10d36f44",
                                "text": "Quant à Merlin, il fut mis tout coffré qu'il était, dans la basse-fosse. Et le roi fit un édit portant : Celui qui déprisonnera Merlin je le ferai mourir."
                            },
                            {
                                "example_id": "82b24401-4eee-4935-8a33-31cb5589c41d",
                                "sense_id": "73038940-5c77-38ab-95e7-219d10d36f44",
                                "text": "— J’étais déprisonné, j’ajournais les tracas et les soucis ; je vivais !"
                            }
                        ]
                    }
                ],
