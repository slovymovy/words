                "senses": [
                    {
                        "sense_id": "68de3e77-c18a-3ed1-b8a8-14965ee385b7",
                        "entry_id": "be903894-6cfa-3556-bc46-8ced3e6c8bf3",
                        "glosses": [
                            "mehrere, in einer Linie stehende Häuser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b1eb92-6837-4ad7-81b1-68b70156a960",
                                "sense_id": "68de3e77-c18a-3ed1-b8a8-14965ee385b7",
                                "text": "„Dann steht Lassehn in der Landsberger Straße, die hier breit und ausladend aus der engen Häuserzeile auf den Alexanderplatz zustößt.“"
                            },
                            {
                                "example_id": "6eb337d6-f24b-4524-a082-08301fea04c2",
                                "sense_id": "68de3e77-c18a-3ed1-b8a8-14965ee385b7",
                                "text": "„Der Marktplatz wurde in der bisherigen Größe nicht mehr benötigt, weshalb man an den Einbau einer Häuserzeile schritt […]“"
                            },
                            {
                                "example_id": "9fe6ae6f-8887-4d12-ba11-461c8638245f",
                                "sense_id": "68de3e77-c18a-3ed1-b8a8-14965ee385b7",
                                "text": "„Jenseits des Kanals, zwischen den von Speichern unterbrochenen Häuserzeilen, stand der weite, klare Himmel in Flächen von tiefem Blau, und im Rückprall der Sonnenstrahlen blendeten die weißen Fassaden, die Schieferdächer und die Kais aus Granit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
