                ],
                "senses": [
                    {
                        "sense_id": "4e78a568-3761-3def-978c-daf2b731d29d",
                        "entry_id": "eee0f634-7ee4-36bd-a0db-d981827b9bc4",
                        "glosses": [
                            "Violence, en particulier psychologique, harcèlement moral ou sexuel, humiliation, intimidation, utilisant les moyens de communication technologiques (internet, etc.) comme support."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "afc9f180-d6fc-4b19-a17a-527ff47fc2ce",
                                "sense_id": "4e78a568-3761-3def-978c-daf2b731d29d",
                                "text": "Vente en ligne qui cible les jeunes, insultes, piratage et détournement de compte MSN ou Facebook, cyberharcèlement ou droit à l’image avec des photos qui circulent sur les réseaux sociaux sans autorisation…"
                            },
                            {
                                "example_id": "97e45c6b-b64a-4ac5-86a0-1c0bf25b6029",
                                "sense_id": "4e78a568-3761-3def-978c-daf2b731d29d",
                                "text": "Insultes, « cyberharcèlement », violences physiques... Le harcèlement en milieu scolaire était le sujet d’un rapport le mois dernier.’’ — (« Un plan contre le harcèlement à l’école », L’Express.fr, 2 mai 2011)"
                            },
                            {
                                "example_id": "75494106-2edd-4856-af7f-95934150fed6",
                                "sense_id": "4e78a568-3761-3def-978c-daf2b731d29d",
                                "text": "Les outils du parfait harceleur sont souvent les mêmes : rumeur faisant croire qu’untel est une « balance » ou qu’une telle est une « chienne d’intello », brimades, coups de projectile, dégradations vestimentaires, auxquels s’ajoute l’arme du XXIᵉ siècle : le cyberharcèlement via des blogs ou par SMS."
                            }
                        ]
                    }
                ],
