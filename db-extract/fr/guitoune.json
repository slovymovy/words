                    },
                    {
                        "translation_id": "517a6f65-c598-4780-898d-012dc429ee28",
                        "source_entry_id": "721728b4-4846-3657-92e1-1dfff7df0689",
                        "source_sense_id": "ef1626fb-e400-3e66-bf56-3c484985653a",
                        "source_sense_description": "Abri sommaire, baraque",
                        "target_lang_word": "Baracke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baracke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                        "entry_id": "5e7877a0-4a13-3742-a804-41aff1790e1d",
                                        "glosses": [
                                            "primitives, ein- oder zweigeschossiges Gebäude, das nach einfachen Technologien errichtet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b2b21c-9d7a-48f8-99e7-feed631e58a1",
                                                "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                                "text": "Nach dem zweiten Weltkrieg wurden Leute oft in Baracken untergebracht."
                                            },
                                            {
                                                "example_id": "7addd939-c9f3-4369-b996-187a8572bc59",
                                                "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                                "text": "„Wir haben uns auf der Sonnenseite der Baracken hingehauen.“"
                                            },
                                            {
                                                "example_id": "754a2ba0-3d82-4f67-b34b-a6be557af111",
                                                "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                                "text": "„Zwei Moldauer, zwei Transnistrier und drei Russen leben hier in einer Baracke zusammen, Soldaten dreier Armeen.“"
                                            },
                                            {
                                                "example_id": "0422da0f-1e3e-4bd2-a3c6-a66f0fb8e91a",
                                                "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                                "text": "„Die Baracken standen schief aneinander gelehnt wie die wackligen Tische eines schlechten Hobbyschreiners.“"
                                            },
                                            {
                                                "example_id": "17b2190e-d3f5-486b-a861-fbc117ef9b70",
                                                "sense_id": "079c4c95-dd1f-359e-876f-6c3a9987b7e1",
                                                "text": "„Mein Vater und Ditti schickten mich bereits kurz nach meiner Ankunft in den Feldafinger Kindergarten, der in Baracken am alten Fußballplatz des Dorfes untergebracht war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0b5185e-ba2b-3ed2-a50a-3269cf2f968d",
                                        "entry_id": "5e7877a0-4a13-3742-a804-41aff1790e1d",
                                        "glosses": [
                                            "primitives, ein- oder zweigeschossiges Gebäude, das nach einfachen Technologien errichtet wurde",
                                            "primitive Behausung für Insassen in einem Konzentrationslager"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758b5ba5-5189-4987-a099-5c4a36fb410c",
                                                "sense_id": "a0b5185e-ba2b-3ed2-a50a-3269cf2f968d",
                                                "text": "„Unmittelbar vor der Baracke donnerten die dröhnenden Schritte von schweren, beschlagenen Stiefeln.“"
                                            },
                                            {
                                                "example_id": "8ac7eaab-7802-4ab3-9040-4d13ce5b1615",
                                                "sense_id": "a0b5185e-ba2b-3ed2-a50a-3269cf2f968d",
                                                "text": "Der Romancier und Talmud-Gelehrte Elie Wiesel, er war als Halbwüchsiger im KZ Auschwitz, berichtet von einem Jungen, der dort gehängt wurde, weil er Untergrundnachrichten von Baracke zu Baracke geschmuggelt hatte."
                                            },
                                            {
                                                "example_id": "0c94ad03-75dc-4e68-a23a-dcb54bf8676d",
                                                "sense_id": "a0b5185e-ba2b-3ed2-a50a-3269cf2f968d",
                                                "text": "Es geht weiter durch die Gedenkstätte. Die Schüler sehen noch einige der engen Baracken, in die die Häftlinge eingepfercht wurden. Erzählt wird von der totalen Überwachung durch die SS-Wächter […]"
                                            },
                                            {
                                                "example_id": "48dec3c8-5a8b-42e0-8138-2f67127180ca",
                                                "sense_id": "a0b5185e-ba2b-3ed2-a50a-3269cf2f968d",
                                                "text": "Die Roten Khmer brachten die Verurteilten zunächst in Baracken und richteten sie binnen kurzer Zeit hin."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "671949b8-f136-4f7a-89c1-f5fb6aec8949",
                        "source_entry_id": "721728b4-4846-3657-92e1-1dfff7df0689",
                        "source_sense_id": "ef1626fb-e400-3e66-bf56-3c484985653a",
                        "source_sense_description": "Abri sommaire, baraque",
                        "target_lang_word": "Schuppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Hütte, Lagerraum für Gerätschaften oder Vorräte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcff3c56-e6a5-4ee5-a73e-067ac4003efd",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "Der Traktor steht im Schuppen."
                                            },
                                            {
                                                "example_id": "10d34e21-b432-43dd-89ed-943363a9f924",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Die Beiboote liegen regengeschützt in Schuppen am Ufer, sodass die Männer sie schnell ins Wasser wuchten können.“"
                                            },
                                            {
                                                "example_id": "6ec2bef9-51e1-47a0-a968-f38bed207d4a",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Auf der anderen Seite der Gleise stehen Schuppen voller Fahrräder.“"
                                            },
                                            {
                                                "example_id": "59349ae5-46b2-4902-b248-e6704785b7df",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Die Frau erlaubte uns, einen Schuppen zu nutzen, und willigte ein, den Proviant zu kaufen.“"
                                            },
                                            {
                                                "example_id": "92001537-0e79-4506-bbb4-d5699286b12b",
                                                "sense_id": "8f1f95c0-f77f-39fa-9b8b-f65a456f6cce",
                                                "text": "„Vor dem Haus standen Schuppen und ein riesiger Haufen Schrott, hinter dem Hexenhaus führte ein Weg zu einem größeren, schwarzen Holzhaus, das weit unten im Gelände stand und das alle nur »das kleine Haus« nannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Diskothek oder Kneipe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b33508-a599-4812-872f-5c7eda207f4e",
                                                "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                                "text": "Wo ist denn der Schuppen in dem man sich vergnügen kann?"
                                            },
                                            {
                                                "example_id": "cbcb2a44-7d8e-4b40-aa0f-8dc75fed0806",
                                                "sense_id": "516e7ab8-8b00-3bd8-91a4-6df8a1ebab7d",
                                                "text": "„Das Tram 83 war einer der Schuppen mit dem größten Angebot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "17306613-a886-38c6-a22b-f9cef2926d63",
                                        "entry_id": "9dfb8d44-7e2b-3c06-943f-4baa91dfd68e",
                                        "glosses": [
                                            "Schuppenfell, Fell des Waschbären"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9073c5db-b2e2-4edf-a45a-ef926b3d0e32",
                                                "sense_id": "17306613-a886-38c6-a22b-f9cef2926d63",
                                                "text": "Sie verarbeitete dazu Schuppen und Nutria."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
