                "senses": [
                    {
                        "sense_id": "b445a785-5dfe-33eb-9535-8aa99395520b",
                        "entry_id": "d8b888e6-ab51-30a7-a7e2-8e47292dea9c",
                        "glosses": [
                            "Cesser de claustrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc99dae-8c6c-46ef-8878-6587241710a9",
                                "sense_id": "b445a785-5dfe-33eb-9535-8aa99395520b",
                                "text": "L’explosion des taches est l’effervescence même, l’hyperesthésie d’un être intime qu’il fallait déclaustrer, dépenser dans l’aléa, contre une société et un langage entièrement rationalisés."
                            },
                            {
                                "example_id": "1a8162b7-4e79-4a8d-8e9c-4a27f2da8800",
                                "sense_id": "b445a785-5dfe-33eb-9535-8aa99395520b",
                                "text": "Cependant, et c’est là que leur habileté atteint ses limites, déclaustrer et désentableauter requièrent une faculté dont seules les Gracieuses disposent."
                            }
                        ]
                    }
                ],
