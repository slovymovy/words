                    {
                        "sense_id": "19991de7-079c-3299-8d94-98d084986b8a",
                        "entry_id": "3394b16a-ff50-3917-9941-26167f676d89",
                        "glosses": [
                            "een systeem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66a516a-4ca2-4cef-a793-a9557cf628d8",
                                "sense_id": "19991de7-079c-3299-8d94-98d084986b8a",
                                "text": "Hitler en het nazisme zijn weliswaar geschiedenis, stelt hij, maar de methodes en de mentaliteit van het nazisme zijn onder ons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df6deed9-15be-4ef6-920b-e23c3ed2eb07",
                        "source_entry_id": "3394b16a-ff50-3917-9941-26167f676d89",
                        "target_lang_word": "Methode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Methode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "636f57c3-22c9-370c-9c28-b182f1dc79e8",
                                        "entry_id": "4edd6e8a-b11c-318d-a67a-5bca0559b938",
                                        "glosses": [
                                            "Art und Weise, wie man etwas tut, um ein Ziel zu erreichen; Vorgehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50cc1aa9-0295-47f8-8fdf-77cb371222b1",
                                                "sense_id": "636f57c3-22c9-370c-9c28-b182f1dc79e8",
                                                "text": "Eine Methode für einen effizienten Softwareentwurf heißt „Extreme Programming“."
                                            },
                                            {
                                                "example_id": "526cc7a8-3860-4da2-88d1-8ba2040370f4",
                                                "sense_id": "636f57c3-22c9-370c-9c28-b182f1dc79e8",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb049a94-dbf0-3171-99b8-5e9dfe42bf24",
                                        "entry_id": "4edd6e8a-b11c-318d-a67a-5bca0559b938",
                                        "glosses": [
                                            "Oberbegriff für Funktionen und Prozeduren in der objektorientierten Programmierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4813fdc1-70cc-4d75-bf9b-d4988fb4c3a5",
                                                "sense_id": "bb049a94-dbf0-3171-99b8-5e9dfe42bf24",
                                                "text": "Viele Objekte besitzen Methoden zum Duplizieren, diese werden als „Copy-Constructor“ bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f2048029-714d-3c52-b5fe-cb253681e560",
                                        "entry_id": "4edd6e8a-b11c-318d-a67a-5bca0559b938",
                                        "glosses": [
                                            "auf einem Regelsystem aufbauendes Verfahren zur Erlangung von (wissenschaftlichen) Erkenntnissen oder praktischen Ergebnissen; Verfahren"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c93eca9-3f4e-4369-8e04-3498e95cb795",
                                                "sense_id": "f2048029-714d-3c52-b5fe-cb253681e560",
                                                "text": "Die vollständige Induktion ist eine mathematische Methode, nach der eine Aussage für alle natürlichen Zahlen bewiesen wird, die größer oder gleich einem bestimmten Startwert sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516fcd2d-8379-405c-81c8-8bb35c110426",
                        "source_entry_id": "3394b16a-ff50-3917-9941-26167f676d89",
                        "target_lang_word": "method",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "method",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3325da42-8c9d-3624-b7d0-b27e04778933",
                                        "entry_id": "e04e408a-caf9-3750-a7af-9ec9d0bc5279",
                                        "glosses": [
                                            "A process by which a task is completed; a way of doing something (followed by the adposition of, to or for before the purpose of the process)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3972b91-da61-42be-b211-a37dd807f272",
                                                "sense_id": "3325da42-8c9d-3624-b7d0-b27e04778933",
                                                "text": "If one method doesn't work, you should ask a friend to help you."
                                            },
                                            {
                                                "example_id": "ef6e9a20-03b1-4220-ae3c-2c559a663811",
                                                "sense_id": "3325da42-8c9d-3624-b7d0-b27e04778933",
                                                "text": "He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "bed86f32-47c6-403a-a078-bc1bf3572283",
                                                "sense_id": "3325da42-8c9d-3624-b7d0-b27e04778933",
                                                "text": "Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff89ad5-017e-30a3-824b-772774a992dc",
                                        "entry_id": "e04e408a-caf9-3750-a7af-9ec9d0bc5279",
                                        "glosses": [
                                            "Systematicity, methodicalness, intentionality, order"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79013e03-9e0d-453a-9da0-7c8d5f451c07",
                                                "sense_id": "bff89ad5-017e-30a3-824b-772774a992dc",
                                                "text": "Though this be madneſſe, / Yet there is Method in 't: […]"
                                            },
                                            {
                                                "example_id": "333425d6-d954-4944-b100-80125419e8cc",
                                                "sense_id": "bff89ad5-017e-30a3-824b-772774a992dc",
                                                "text": "There's method in the universe.\nWe're lucky that things aren't worse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521d5658-8c66-365e-9945-4dfe55cbbf32",
                                        "entry_id": "e04e408a-caf9-3750-a7af-9ec9d0bc5279",
                                        "glosses": [
                                            "A technique for acting based on the ideas articulated by Konstantin Stanislavski and focusing on authentically experiencing the inner life of the character being portrayed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a86526a-ee99-4d96-b466-2f4307247064",
                                                "sense_id": "521d5658-8c66-365e-9945-4dfe55cbbf32",
                                                "text": "In this case, the application of the famous method was a little shaky. To be fair, the director was dealing with a pretty stroppy cast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "024a0328-f162-31f4-8184-bc211c4120fb",
                                        "entry_id": "e04e408a-caf9-3750-a7af-9ec9d0bc5279",
                                        "glosses": [
                                            "A subroutine or function belonging to a class or object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a536ec86-3baf-4adc-9721-3e741062b161",
                                                "sense_id": "024a0328-f162-31f4-8184-bc211c4120fb",
                                                "text": "When you call the method, you provide values corresponding to these variables in your method call."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b74e4ed5-003b-3bd1-9b86-3d06e314f694",
                                        "entry_id": "e04e408a-caf9-3750-a7af-9ec9d0bc5279",
                                        "glosses": [
                                            "Marijuana."
                                        ],
                                        "tags": [
