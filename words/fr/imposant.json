        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "575b2132-fd1f-3275-b53a-cdffd8cac348",
                    "sense_definition": "Participe présent du verbe <w>imposer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a convaincu l'assemblée en <w>imposant</w> ses idées avec calme et rigueur.",
                            "target_lang_translations": {
                                "en": "He won over the assembly by <w>imposing</w> his ideas with calm and rigour.",
                                "ru": "Он убедил собрание, спокойно и последовательно <w>навязывая</w> свои идеи.",
                                "de": "Er hat die Versammlung überzeugt, indem er seine Ideen mit Ruhe und Konsequenz <w>durchsetzte</w>.",
                                "es": "Convenció a la asamblea <w>imponiendo</w> sus ideas con calma y rigor.",
                                "zh": "他以冷静严谨的态度<w>强加</w>自己的想法，最终说服了议会。"
                            }
                        },
                        {
                            "text": "L'équipe locale a remporté la compétition en s'<w>imposant</w> nettement lors du match final.",
                            "target_lang_translations": {
                                "en": "The local team won the competition by clearly <w>dominating</w> the final match.",
                                "ru": "Местная команда выиграла соревнование, в финальном матче уверенно <w>доминируя</w>.",
                                "de": "Die örtliche Mannschaft gewann den Wettbewerb, indem sie <w>sich</w> im Finale klar <w>durchsetzte</w>.",
                                "es": "El equipo local ganó la competición <w>imponiéndose</w> claramente en la final.",
                                "zh": "当地队在决赛中以明显优势<w>压倒</w>对手，夺得了冠军。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
