                            {
                                "example_id": "c0b4a76e-de6f-435b-8b34-31b096823807",
                                "sense_id": "88666e9c-664e-3aad-93f2-54f2f326da61",
                                "text": "Les idéogrammes d’origine de ce pétroglyphe ont été écrits en - 42 527 par un Atlante."
