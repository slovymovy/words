                                                "sense_id": "091f1b63-ae98-304e-a994-043eb144d399",
                                                "text": "It was a terrible crash; both cars were total losses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ea8635-72e8-328e-a096-d891e3992054",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "Defeat; an instance of being defeated."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
