                    {
                        "translation_id": "8c5b9889-fc89-47d0-adc8-485939a178da",
                        "source_entry_id": "7c767315-aa62-34cd-b464-ffe687a4c6ea",
                        "source_sense_id": "abf1d27e-4043-3f74-830c-a85760b4c1f3",
                        "target_lang_word": "caleçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caleçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                        "entry_id": "bba573d9-a48e-3382-a366-b6c5f99e05c4",
                                        "glosses": [
                                            "Vêtement de dessous en forme de pantalon ou de culotte et qui couvre le corps depuis la ceinture jusqu’à mi-cuisse, jusqu’aux genoux ou jusqu’à la cheville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d0dd041-0071-4b8e-a1ea-3d819b05ebd3",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Vêtu d’un caleçon, une bière dans une main, un sandwich dans l’autre, il était planté devant le poste de télévision."
                                            },
                                            {
                                                "example_id": "39542b61-aa86-4410-a3e6-ee6b9a2522ea",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Caleçon de toile, de laine, etc."
                                            },
                                            {
                                                "example_id": "b32ec27b-7779-4bbc-92ad-8469fb10f3ce",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Se mettre en caleçon, porter des caleçons."
                                            },
                                            {
                                                "example_id": "03fddea5-34a2-491e-ae71-7c9743ea0eae",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Caleçon de bain, slip que mettent les nageurs."
                                            },
                                            {
                                                "example_id": "df89dfe7-aeb6-4ef6-8570-1869d3fda18d",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Bien qu’en septembre on ne se baigne plus au moulin de M. Lapeyre, où l’eau est glacée, il faisait si chaud, ce jour-là, que je pris à tout hasard mon caleçon de bain."
                                            },
                                            {
                                                "example_id": "4cac955e-36c4-4ab9-bee7-9c4ffbd23a8f",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "La cabine en planches sentait le vernis à bateau et l’huile solaire. Debout, en caleçon de bain, dans ce réduit étouffant, Philippe imagina son correspondant tout vêtu, tout chaussé, la cravate au col, et se divertit un instant de ce contraste."
                                            },
                                            {
                                                "example_id": "cfe4d5cf-70e2-49a0-8e93-745deefc033e",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Être en caleçon, ne plus rien avoir."
                                            },
                                            {
                                                "example_id": "529e3c15-f81b-4ee5-8dd6-c49a27796fa8",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Quel profit le mâle de l’Astylosternus trouve-t-il, dans le moment des noces, à vêtir ses cuisses d’un caleçon de poils vasculaires."
                                            },
                                            {
                                                "example_id": "412c1975-e2d2-4778-a649-32f40f20969a",
                                                "sense_id": "900fd39d-2a44-39c1-b223-a45e3fdfd2c1",
                                                "text": "Nous nous apercevons que mon pantalon est furieusement mangé des vers ! […] Le blanc du caleçon apparaît en dessins bizarres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc053c0-c08c-3073-98cc-47c4ee4a84c7",
                                        "entry_id": "bba573d9-a48e-3382-a366-b6c5f99e05c4",
                                        "glosses": [
                                            "Préparation de condiments en feuilleté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f8292e-82db-4c92-a84f-49016cd9addf",
                                                "sense_id": "edc053c0-c08c-3073-98cc-47c4ee4a84c7",
                                                "text": "Petite salade de chèvre chaud en caleçon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
