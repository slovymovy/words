                        "target_lang_word": "mesquinerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesquinerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                        "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                                        "glosses": [
                                            "Caractère de ce qui est mesquin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5a732f-1c9b-40bb-bb1b-4ea4c89728fd",
                                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                                "text": "Avez-vous jamais vu une plus grande mesquinerie ?"
                                            },
                                            {
                                                "example_id": "c640bb20-9b41-4154-8a85-6237fa644b0e",
                                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                                "text": "Il était bien obligé de s’avouer alors la mesquinerie de ses arguments, les méprisables raisons de ses résistances."
                                            },
                                            {
                                                "example_id": "6a479551-0dd3-4da3-a582-0222273929ad",
                                                "sense_id": "b37c563e-71f4-305e-b783-b927648ea520",
                                                "text": "Ensuite, ils déciment les femmes sous des prétextes d'une parfaite mesquinerie, température de la soupe, chaussette mal repassée, protestation domestique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3901b71-ec1b-3747-b127-d5ab1f9fb445",
                                        "entry_id": "1fadb6d1-000e-3d4a-ba0a-8e129f1373a8",
                                        "glosses": [
                                            "Médiocrité matérielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ba517d-8957-47fa-b8ea-a2bc7fba89b0",
                                                "sense_id": "f3901b71-ec1b-3747-b127-d5ab1f9fb445",
                                                "text": "Il conservait cependant une humeur égale et mettait plus volontiers le monde en question qu’il ne s’apitoyait sur lui-même ; je m’émus qu’un homme aussi supérieur s’accommodât avec tant de simplicité de la mesquinerie de sa condition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
