                        "translation_id": "bd691e00-2c43-46be-9448-ede13730c341",
                        "source_entry_id": "3911c70b-7250-3d94-9433-317ba7893003",
                        "target_lang_word": "lewd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lewd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5730d3-46d9-3ebc-b898-bae8d38c8c9b",
                                        "entry_id": "2f30a267-c71e-3c57-a9b1-69c5142b7532",
                                        "glosses": [
                                            "Lascivious, sexually promiscuous, rude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9bf788e-d1cd-42e8-a5c8-f93881da4a7a",
                                                "sense_id": "5f5730d3-46d9-3ebc-b898-bae8d38c8c9b",
                                                "text": "Onstage he was known for ricochet riffs on politics, social issues and cultural matters both high and low; tales of drug and alcohol abuse; lewd commentaries on relations between the sexes; and lightning-like improvisations on anything an audience member might toss at him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1ca2cc-cf8d-336d-8ec6-128d1b564f79",
                                        "entry_id": "2f30a267-c71e-3c57-a9b1-69c5142b7532",
                                        "glosses": [
                                            "Lay; not clerical."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b93e5763-aa7e-4743-8b5f-df11d65f489a",
                                                "sense_id": "ec1ca2cc-cf8d-336d-8ec6-128d1b564f79",
                                                "text": "So these great clerks their little wisdom show / To mock the lewd, as learn'd in this as they."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e7a292-8e20-3cbe-8b62-530f20c00f51",
                                        "entry_id": "2f30a267-c71e-3c57-a9b1-69c5142b7532",
                                        "glosses": [
                                            "Uneducated."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76e6638-f8cb-4d53-9846-1298f2575c81",
                                                "sense_id": "e9e7a292-8e20-3cbe-8b62-530f20c00f51",
                                                "text": "My ſcoles are not for unthriftes untaught, / For frantick faitours half mad and half ſtraught; / But my learning is of another degree / To taunt theim like liddrons, lewde as thei bee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e03474-338b-3e6f-b9d1-c321490de22e",
                                        "entry_id": "2f30a267-c71e-3c57-a9b1-69c5142b7532",
                                        "glosses": [
                                            "Vulgar, common; typical of the lower orders."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18434464-de95-4007-9af7-eae643f1c06a",
                                                "sense_id": "02e03474-338b-3e6f-b9d1-c321490de22e",
                                                "text": "But the Jews, which believed not, […] took unto them certain lewd fellows of the baser sort, […] and assaulted the house of Jason."
                                            },
                                            {
                                                "example_id": "93203b37-8a43-404c-9964-0c870d0a9dbd",
                                                "sense_id": "02e03474-338b-3e6f-b9d1-c321490de22e",
                                                "text": "Too lewd to work, and ready for any kind of mischief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f18235e-bf59-34d9-9888-1c91e6590641",
                                        "entry_id": "2f30a267-c71e-3c57-a9b1-69c5142b7532",
                                        "glosses": [
                                            "Base, vile, reprehensible."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lewd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3845d4ce-b644-3f6c-87cd-cac5248ac8dc",
                                        "entry_id": "ebe315aa-f565-3822-a9fd-46dbe7d0d2b8",
                                        "glosses": [
                                            "A sexually suggestive image, particularly one which does not involve full nudity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7f5bf1-2475-4137-988a-ea9571c15887",
                                                "sense_id": "3845d4ce-b644-3f6c-87cd-cac5248ac8dc",
                                                "text": "Nudes, lewds and smutty outhouse cards, although they can be bought in some of the rowdy joints, are a negligible percentage of the total, and are unobtainable in the chain stores, drugstores and travel stations which are the outlets for […]"
                                            },
                                            {
                                                "example_id": "b33b09d7-aa54-4d29-ad38-1546826b6c0d",
                                                "sense_id": "3845d4ce-b644-3f6c-87cd-cac5248ac8dc",
                                                "text": "[…] also put it, he learned “the difference between nudes and lewds.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lewd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00b98f94-f27a-347d-b40c-f502151b276d",
                                        "entry_id": "620837f4-140c-38fc-b297-a25fc58eb91c",
                                        "glosses": [
                                            "To express lust; to behave in a lewd manner."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041b8f67-cbf3-4f6a-9bb1-3c31f2963a10",
                                                "sense_id": "00b98f94-f27a-347d-b40c-f502151b276d",
                                                "text": "\"Well then,” dropping her bathrobe, lewding her lips, “how 'bout some lovee?”"
                                            },
                                            {
                                                "example_id": "c0f73e52-7fb1-44e6-a621-5838375e2586",
                                                "sense_id": "00b98f94-f27a-347d-b40c-f502151b276d",
                                                "text": "Now, the men could just have been watching the unusual APC running on the road, or just lewding at the women."
                                            },
                                            {
                                                "example_id": "224b22d1-67aa-404e-980d-a93b912fecc8",
                                                "sense_id": "00b98f94-f27a-347d-b40c-f502151b276d",
                                                "text": "Each one lusting and lewding themselves - fighting against the spirit of change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f41041-85c6-3347-8c61-def7c360fc88",
                                        "entry_id": "620837f4-140c-38fc-b297-a25fc58eb91c",
                                        "glosses": [
                                            "To sexualize a character, especially in a fan illustration."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lewd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e31b2e72-c159-39a1-b6ae-d660c40bca62",
                                        "entry_id": "b0a4cec0-fd1e-34f6-a9c9-bab8ec748227",
                                        "glosses": [
                                            "Alternative form of lude (“take the drug quaalude”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0924eb39-fccf-47ca-bf18-5ec63c39ad45",
                                                "sense_id": "e31b2e72-c159-39a1-b6ae-d660c40bca62",
                                                "text": "Babbs, after many days of glumming in his Purina Chow redoubt, strolls over, lewding out, “Hi, Je-e-e-ed!” to Kesey's three-year-old son."
                                            },
                                            {
                                                "example_id": "aa94f132-f70d-46e3-ba6c-eb99912f23e7",
                                                "sense_id": "e31b2e72-c159-39a1-b6ae-d660c40bca62",
                                                "text": "I was just lewding around, fucking furiously, drinking and doping and daring the devil."
                                            },
                                            {
                                                "example_id": "ca7e40b9-bdb0-482b-a6d9-ed121f9bc5dd",
                                                "sense_id": "e31b2e72-c159-39a1-b6ae-d660c40bca62",
                                                "text": "Once lewded-out. I sampled the bourbon, then somebody suggested I take five more hits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
