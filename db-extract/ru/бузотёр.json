                        "target_lang_word": "chahuteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chahuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                        "entry_id": "fd7404a2-384e-3a66-8052-57cdb3d85606",
                                        "glosses": [
                                            "Qui fait du chahut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c1ff67-89be-4854-a8df-f1fbba291b51",
                                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                                "text": "Dans l’espace libre entre les tables, dominait le public ordinaire du lieu, un bataillon de canotiers chahuteurs avec leurs compagnes en courte jupe de flanelle."
                                            },
                                            {
                                                "example_id": "392128c7-586f-4ec7-84d8-069e38b2cbe1",
                                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                                "text": "Elle interpelle une femme maigriote et chahuteuse et lui crie avec un accent inimitable:\n— Té, ma petite, si jamais le mistral y souffle à Paris, tu vas t'envoler comme une aéroplane."
                                            },
                                            {
                                                "example_id": "e0a3895e-328f-442d-a3b6-27843ce4814d",
                                                "sense_id": "ad2480a3-fcb9-3803-8e6f-47ef30c3a2bf",
                                                "text": "Des garçons chahuteurs aux cheveux tartinés de gel se rentraient dedans au son bourrin d’un tube Eurodance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chahuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb35408e-3f04-339e-949f-1c96afa00453",
                                        "entry_id": "e3c00b26-1952-34dd-9b7f-b786d07fbafb",
                                        "glosses": [
                                            "Homme, garçon qui chahute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a96851bc-2421-4203-9281-85103be968d6",
                                                "sense_id": "eb35408e-3f04-339e-949f-1c96afa00453",
                                                "text": "C’est un chahuteur de première !"
                                            },
                                            {
                                                "example_id": "cb8193b7-9e39-46d1-a542-befedfafbdda",
                                                "sense_id": "eb35408e-3f04-339e-949f-1c96afa00453",
                                                "text": "Malgré ses six ans, le petit Jacob était déjà un chahuteur patenté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a80a97db-f02b-4af7-b299-e754ba26123e",
                        "source_entry_id": "30681110-154c-35e0-99b3-7b08532d3a2d",
                        "source_sense_description": "человек, затевающий скандалы, ссоры",
                        "target_lang_word": "rouspéteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouspéteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce62259-c0d0-397f-ac82-c2c87b947bf7",
                                        "entry_id": "73a25260-13bc-3d96-97a9-34f521b02f2c",
                                        "glosses": [
                                            "Personne qui rouspète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b47742b-2c92-4d39-83bd-d200e126759a",
                                                "sense_id": "2ce62259-c0d0-397f-ac82-c2c87b947bf7",
                                                "text": "Apporter cinq sacs à un rouspéteur, ça n’a guère de sens."
                                            },
                                            {
                                                "example_id": "ac1548a9-16f4-4ed0-9bf6-048ef4b10311",
                                                "sense_id": "2ce62259-c0d0-397f-ac82-c2c87b947bf7",
                                                "text": "Derrière le guichet, un préposé de mauvaise humeur tamponne inlassablement, sans sympathiser avec ses trop nombreux clients, il en a assez d’eux au moins autant qu’eux en ont assez de cette démarche. Par conséquent il rabroue les rouspéteurs à plusieurs reprises :\n— On ne bouscule pas ! On attend son tour !"
                                            },
                                            {
                                                "example_id": "2726c393-61e2-4027-b789-b64c017a1905",
                                                "sense_id": "2ce62259-c0d0-397f-ac82-c2c87b947bf7",
                                                "text": "Rouspéteur, va !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
