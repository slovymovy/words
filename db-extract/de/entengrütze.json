                "senses": [
                    {
                        "sense_id": "33a711b6-39f4-3860-8ece-3d8c8391bdc8",
                        "entry_id": "32b704c9-1445-3524-b411-b60e74387bbe",
                        "glosses": [
                            "Pflanzenart aus der Gattung der Wasserlinsen, die oft von Enten gefressen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8088007-d2a0-4082-b10a-cf9504314694",
                                "sense_id": "33a711b6-39f4-3860-8ece-3d8c8391bdc8",
                                "text": "„Vor Einbruch der Dunkelheit erreichte er wieder den nun schmaleren und klareren, von Entengrütze und Brunnenkresse gebremsten Bach; die grüne Aue dehnte sich unter den spärlichen Baumdecken überallhin, kupferne Dunstschleier durchflorten das Zwielicht wie kostbarer Staub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb2363fb-4185-4590-bd04-7152973635bf",
                        "source_entry_id": "32b704c9-1445-3524-b411-b60e74387bbe",
                        "source_sense_id": "33a711b6-39f4-3860-8ece-3d8c8391bdc8",
                        "source_sense_description": "Pflanzenart",
                        "target_lang_word": "duckweed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duckweed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0596dea4-c67c-3409-b1db-18923f6d8932",
                                        "entry_id": "80709f78-7c8f-3401-a59f-8a110da79003",
                                        "glosses": [
                                            "Any of several reduced floating aquatic plants in the subfamily Lemnoideae of the family Araceae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd945f2-883b-452c-a826-b8bbf2910013",
                                                "sense_id": "0596dea4-c67c-3409-b1db-18923f6d8932",
                                                "text": "He that vvould diſcern the rudimentall ſtroak of a plant, may behold it in the Originall of Duckvveed, at the bigneſſe of a pins point, from convenient vvater in glaſſes, vvherein a vvatchfull eye may alſo diſcover the puncticular Originals of Perivvincles and Gnats."
                                            },
                                            {
                                                "example_id": "cc4a585c-e367-4651-86c3-76b4b53ae8a4",
                                                "sense_id": "0596dea4-c67c-3409-b1db-18923f6d8932",
                                                "text": "But his face was a face of such happiness that, had you seen it, you would have understood indeed how that he had died happy, never knowing that cool and streaming silver for the duckweed in the pond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
