                        "entry_id": "3d6ef487-cc89-32c0-8069-9d6e86fc40a8",
                        "glosses": [
                            "meist im Freien stattfindende Versammlung ohne Redebeiträge, mit der auf ein bestimmtes politisches Anliegen aufmerksam gemacht werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71c30a97-44ad-453f-9909-cc57f14b5503",
                                "sense_id": "72540157-4a99-3cc6-9071-52de40da16c0",
                                "text": "Die Organisation rief zu einer Mahnwache gegen den Militäreinsatz auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a625bb46-172f-472e-80b3-32a0e91a7b2d",
                        "source_entry_id": "3d6ef487-cc89-32c0-8069-9d6e86fc40a8",
                        "source_sense_id": "72540157-4a99-3cc6-9071-52de40da16c0",
                        "source_sense_description": "Versammlung ohne Redebeiträge, um auf ein politisches Anliegen aufmerksam zu machen",
                        "target_lang_word": "candlelight vigil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candlelight vigil",
