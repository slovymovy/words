                "senses": [
                    {
                        "sense_id": "bfc0fa90-5b85-36fe-b0ec-036d93c59c7e",
                        "entry_id": "aa8c42ae-7031-395f-adb1-3ae8d544c33a",
                        "glosses": [
                            "Feston dont on bordait les bandes qui garnissaient les robes des dames."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5112c1c9-fedf-4306-a18c-08105f1ba5a3",
                                "sense_id": "bfc0fa90-5b85-36fe-b0ec-036d93c59c7e",
                                "text": "Mais deux éléments les signalent comme intimement liés à Dardanus : Vénus, seule avec le héros, porte une mante de satin bleu ainsi que des Tattefas couleur chair ; quant à Ismenor qui provoque, malgré qu'il en ait, la capture du héros, il partage avec Teucer, l’ennemi de Dardanus, le ponceau de la culotte et l’usage d’une passementerie qui n'est qu’à eux, le milleret."
                            },
                            {
                                "example_id": "4edf8651-b9f5-4660-ae0f-d9ba187ae9c5",
                                "sense_id": "bfc0fa90-5b85-36fe-b0ec-036d93c59c7e",
                                "text": "La chaîne, très-étroite des millerets, est accompagnée de crins ou de fils de laiton très-fins , tendus parallèlement de chaque côté de la chaine."
                            },
                            {
                                "example_id": "1a818a25-f284-4d3c-b574-4c3df8f8c697",
                                "sense_id": "bfc0fa90-5b85-36fe-b0ec-036d93c59c7e",
                                "text": "On tire encore de Paris, les gazes, les marlis, les dentelles, les blondes, les chenilles, les millerets, les rubans, les taffetas, les satins, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cc5d392-3096-3471-946d-70aeeaa596aa",
                        "entry_id": "aa8c42ae-7031-395f-adb1-3ae8d544c33a",
                        "glosses": [
                            "Monnaie du Portugal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb3d128-e127-4a3b-b225-76e47e8fb31b",
                                "sense_id": "8cc5d392-3096-3471-946d-70aeeaa596aa",
                                "text": "Le marc des louis d'or décriés, des pistoles d'Espagne, des millerets du Portugal & des guinées d'Angleterre, à 514 liv. 16 sols."
                            }
                        ]
                    }
