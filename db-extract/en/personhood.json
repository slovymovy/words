                        "sense_id": "9a488213-0635-3d42-94ee-68cb224b4881",
                        "entry_id": "ddd4af6b-0877-37b6-aa16-6fc40d38aa92",
                        "glosses": [
                            "The state or period of being a person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "40781469-544c-43c3-bb01-be26d31d028a",
                                "sense_id": "9a488213-0635-3d42-94ee-68cb224b4881",
                                "text": "[Animals] are conscious; they are subjectively aware; they have interests; they can suffer. No characteristic other than sentience is required for personhood."
                            },
                            {
                                "example_id": "f04fd254-2b20-4cd9-b9f5-9994c4b88cb9",
                                "sense_id": "9a488213-0635-3d42-94ee-68cb224b4881",
                                "text": "These examples reveal that the shared personhood of hunters and prey was mutually comprehensible, such that hunters could see the animalness of themselves and the humanness of prey, and prey could see the humanness of themselves […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "45ee0c07-1a57-31cb-86fd-1b85ab6ca184",
                        "entry_id": "ddd4af6b-0877-37b6-aa16-6fc40d38aa92",
                        "glosses": [
                            "The status of being considered as a person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d8cdd5ad-a3a6-4fb8-b18c-5301e319853e",
                                "sense_id": "45ee0c07-1a57-31cb-86fd-1b85ab6ca184",
                                "text": "A majority of the present world's peoples delay the conferral of personhood (to children)."
                            }
                        ]
                    }
                ],
