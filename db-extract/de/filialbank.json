                "senses": [
                    {
                        "sense_id": "baeef080-4a78-3108-8624-9778e7cf653c",
                        "entry_id": "18a514ce-70bb-3487-ae76-c0244454a72e",
                        "glosses": [
                            "Geldinstitut, bei dem Bankgeschäfte in eigenen Filialen abgewickelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5526d7f9-1037-4dd0-bc3b-b1cfe9ca0eab",
                                "sense_id": "baeef080-4a78-3108-8624-9778e7cf653c",
                                "text": "„Die Postbank gilt mit mehr als zehn Millionen Kunden als größte Filialbank Deutschlands und will im Herbst 2004 an die Börse gehen.“"
                            },
                            {
                                "example_id": "d4bfc676-a2d1-4b1b-9d94-4f250148d4bf",
                                "sense_id": "baeef080-4a78-3108-8624-9778e7cf653c",
                                "text": "„Fast jede Filialbank bietet ihren Kunden auch Online-Banking an.“"
                            },
                            {
                                "example_id": "eb94925b-f5a8-4a9a-90cc-5a02b6ef2868",
                                "sense_id": "baeef080-4a78-3108-8624-9778e7cf653c",
                                "text": "„Doch nicht alle Geldhäuser verschließen sich vor ihren Kunden, gehört es doch gerade zu den Stärken einer Filialbank, vor Ort und ansprechbar zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
