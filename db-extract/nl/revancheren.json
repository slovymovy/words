                ],
                "senses": [
                    {
                        "sense_id": "c7e99016-ee83-315e-a6fb-fec6fdf0a2a3",
                        "entry_id": "bb518374-90ed-3afe-9425-51ddcf07710b",
                        "glosses": [
                            "zich ~ een eerdere nederlaag tenietdoen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "a5608594-1040-452b-b9b0-4bce53cab971",
                                "sense_id": "c7e99016-ee83-315e-a6fb-fec6fdf0a2a3",
                                "text": "Hij wist zich uitstekend te revancheren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8d32d3d-c4ca-4c58-bb48-ef192103df31",
                        "source_entry_id": "bb518374-90ed-3afe-9425-51ddcf07710b",
                        "source_sense_id": "c7e99016-ee83-315e-a6fb-fec6fdf0a2a3",
                        "source_sense_description": "een eerdere nederlaag tenietdoen",
                        "target_lang_word": "vindicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vindicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf176c0-42d1-32f0-97d6-6498e9c8eeff",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To clear of an accusation, suspicion or criticism."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0ab40e3-a600-4698-bd01-14bf5065a774",
                                                "sense_id": "2bf176c0-42d1-32f0-97d6-6498e9c8eeff",
                                                "text": "to vindicate someone's honor"
                                            },
                                            {
                                                "example_id": "82a91067-2979-458e-80d8-dfadf2634e62",
                                                "sense_id": "2bf176c0-42d1-32f0-97d6-6498e9c8eeff",
                                                "text": "As a man of vision, he understood this. Without Cerberus, humanity was doomed to an existence of groveling subservience at the feet of alien masters. Still, there were those who would call what he did criminal. Unethical. Amoral. History would vindicate him, but until it did he and his followers were forced to exist in hiding, working toward their goals in secret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80df5475-b399-3203-b546-0c87b61e2bdb",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To justify by providing evidence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cee3394-1b0c-46be-813b-ccd59239c2f1",
                                                "sense_id": "80df5475-b399-3203-b546-0c87b61e2bdb",
                                                "text": "to vindicate a right, claim or title"
                                            },
                                            {
                                                "example_id": "55faeaac-33ff-4fea-bb46-c85a7fec4f08",
                                                "sense_id": "80df5475-b399-3203-b546-0c87b61e2bdb",
                                                "text": "The Ukrainians immediately demanded a goal and their claims were vindicated as replays showed the ball crossed the line before Terry's intervention."
                                            },
                                            {
                                                "example_id": "5b7e50b6-8c82-4d66-8a4c-e152a95d299d",
                                                "sense_id": "80df5475-b399-3203-b546-0c87b61e2bdb",
                                                "text": "Also see: United National Congress, Trinidad and Tobago"
                                            },
                                            {
                                                "example_id": "3c81c3a2-bfe3-4b78-9f10-c67f77d5fb19",
                                                "sense_id": "80df5475-b399-3203-b546-0c87b61e2bdb",
                                                "text": "Kamla Persad Bissessar: \" We have been vindicated, but it is a victory for the people\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12da1e7e-e60d-39a7-81e3-fdf243ae16e1",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To maintain or defend (a cause) against opposition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa3fcfd-1537-4680-887a-c8b360c9dcda",
                                                "sense_id": "12da1e7e-e60d-39a7-81e3-fdf243ae16e1",
                                                "text": "to vindicate the rights of labor movement in developing countries"
                                            },
                                            {
                                                "example_id": "9c58a1f6-04fa-4681-b85c-937649cad39d",
                                                "sense_id": "12da1e7e-e60d-39a7-81e3-fdf243ae16e1",
                                                "text": "When Trump's election pulled back the curtain on the rise of the far-right in America, I'd naively assumed the Jewish left would be vindicated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460043d6-9a2a-31d7-9ab8-6f068fed2d9e",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To be proven reasonable, correct, or justified."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "398c35d7-5839-32b5-9a64-b278903bb1df",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To provide justification for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cec2b05-b117-473e-bd55-0cdf313e5e6e",
                                                "sense_id": "398c35d7-5839-32b5-9a64-b278903bb1df",
                                                "text": "The violent history of the suspect vindicated the use of force by the police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268e9ca5-33e5-3494-9712-1184620e99f4",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To lay claim to; to assert a right to; to claim."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5151a144-664d-3451-bcf5-5e06744a6d73",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To liberate; to set free; to deliver."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2d48237-613d-38a2-9a55-baddb42c2483",
                                        "entry_id": "d9ee59b8-41df-3ef9-9b76-a397b021b858",
                                        "glosses": [
                                            "To avenge; to punish."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c14de7-4c49-4d79-bd9d-22042f25203c",
                                                "sense_id": "c2d48237-613d-38a2-9a55-baddb42c2483",
                                                "text": "a war to vindicate infidelity"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41e57b19-37bc-418f-9142-3324ea2254cc",
                        "source_entry_id": "bb518374-90ed-3afe-9425-51ddcf07710b",
                        "source_sense_id": "c7e99016-ee83-315e-a6fb-fec6fdf0a2a3",
                        "source_sense_description": "een eerdere nederlaag tenietdoen",
                        "target_lang_word": "revancher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revancher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1322a5f9-633b-319b-b9be-68ea82ba0c60",
                                        "entry_id": "2b63c926-aec4-30fe-91fc-de30f104ceb2",
                                        "glosses": [
                                            "Prendre sa revanche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "816e6b8b-e7a3-497a-a586-d9934f6c15f5",
                                                "sense_id": "1322a5f9-633b-319b-b9be-68ea82ba0c60",
                                                "text": "En présentant son texte comme s'il fût de moi, Mᵐᵉ Express se revanchait de mon coup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede167f3-6e90-3b99-b6a0-22f71f40398f",
                                        "entry_id": "2b63c926-aec4-30fe-91fc-de30f104ceb2",
                                        "glosses": [
                                            "Rendre la pareille d’une injure, d’un mal qu’on a reçu ; se venger."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b0f3e1-e851-4d77-9685-1e5d561102cf",
                                                "sense_id": "ede167f3-6e90-3b99-b6a0-22f71f40398f",
                                                "text": "Il singeait les manières et les tics de son père, comme pour se revancher de la tutelle où son père l’avait tenu."
                                            },
                                            {
                                                "example_id": "9197a489-f1a8-4eef-b288-4999c1e0e488",
                                                "sense_id": "ede167f3-6e90-3b99-b6a0-22f71f40398f",
                                                "text": "A certains moments du reste je n'étais pas loin de croire à plus de noirceur, à l'intention délibérée de nuire, de s'attaquer à ce groupe bien bouqueté que j'ai toujours considéré comme ma revanche, de s'en revancher à son tour en y portant la division."
                                            },
                                            {
                                                "example_id": "cf869bfd-1363-4c5f-b78a-50514f45ef08",
                                                "sense_id": "ede167f3-6e90-3b99-b6a0-22f71f40398f",
                                                "text": "Pour se revancher il lui dit que les villageois, gens simples et sans méchanceté, valaient bien les marchands trompeurs, comme était son père."
                                            }
                                        ]
