                "senses": [
                    {
                        "sense_id": "822dbbce-c9b2-3d09-b20a-29f656364c89",
                        "entry_id": "998fe8fc-a285-3892-b29c-d696e02a9baf",
                        "glosses": [
                            "Autorisation donnée à un navire ou un aéronef de faire mouvement."
                        ],
                        "tags": [
                            "Transport aérien",
                            "Transport maritime"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7e650e6c-195d-32fc-b1bf-45f940c890b0",
                        "entry_id": "998fe8fc-a285-3892-b29c-d696e02a9baf",
                        "glosses": [
                            "Paramètre biologique désignant la capacité d'un tissu, organe ou organisme à éliminer une substance donnée d'un fluide (le sang, la lymphe, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40029a90-72c9-47c7-8107-72a953e901f5",
                                "sense_id": "7e650e6c-195d-32fc-b1bf-45f940c890b0",
                                "text": "Il y a sans cesse une nette diminution du filtrat glomérulaire avec forte diminution de la clairance de l’urée et de la créatinine, pour atteindre le zéro dans les phases les plus avancées de l’urémie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba2ac92a-1060-36ea-a94f-9a5ef03df9ab",
                        "entry_id": "998fe8fc-a285-3892-b29c-d696e02a9baf",
                        "glosses": [
                            "Coefficient d’épuration plasmatique brute d’un corps, par voie extra-rénale aussi bien que rénale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b73bafc-32f1-4a19-a38c-62121d897ff1",
                        "source_entry_id": "998fe8fc-a285-3892-b29c-d696e02a9baf",
