                "senses": [
                    {
                        "sense_id": "b7584ae2-2966-35b3-b7ac-0f0c4358e8d0",
                        "entry_id": "c86520c2-8a4b-3457-a4f7-5a552eccfd06",
                        "glosses": [
                            "Valoriser en passant de produits de base à des produits à bonne valeur ajoutée, ou de simples produits à des solutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4eb568-148c-4fca-8aed-f69a038cff09",
                                "sense_id": "b7584ae2-2966-35b3-b7ac-0f0c4358e8d0",
                                "text": "Il s’agit de « décommodiser » l’offre et de changer la perspective du client."
                            },
                            {
                                "example_id": "b4a3e7c9-cc00-4bc2-b09b-d2514196d0f8",
                                "sense_id": "b7584ae2-2966-35b3-b7ac-0f0c4358e8d0",
                                "text": "M. Kamel a noté que de nombreux pays africains prenaient des mesures stratégiques pour décommodiser leurs exportations et mettre en œuvre des stratégies d’industrialisation, affirmant qu’ils étaient fatigués d’être fortement tributaires des produits de base."
                            }
                        ]
                    }
