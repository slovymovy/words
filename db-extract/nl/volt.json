                        "sense_id": "ff4e6594-5560-3be9-9292-d6ff4dd6734c",
                        "entry_id": "b31fafcf-83c0-39e0-a404-24470e453d9a",
                        "glosses": [
                            "de SI-basiseenheid van elektrische spanning, weergegeven met symbool V"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8329ed2f-02a0-4249-962e-371d4fed9b2d",
                                "sense_id": "ff4e6594-5560-3be9-9292-d6ff4dd6734c",
                                "text": "De elektrische spanning (symbool: U) wordt uitgedrukt in de eenheid volt."
                            },
                            {
                                "example_id": "89425898-fde8-4007-813b-a6ff189e258c",
                                "sense_id": "ff4e6594-5560-3be9-9292-d6ff4dd6734c",
                                "text": "De helft van Nederlands ingezetenen weet niet beter of de netspanning is nooit anders dan 220 volt geweest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c2aa5e7-912b-406c-af39-deebac36bb87",
