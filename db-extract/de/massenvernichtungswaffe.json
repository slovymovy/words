                    },
                    {
                        "translation_id": "df879632-a123-4bcc-977c-bf1469310735",
                        "source_entry_id": "bafd2838-4adc-3a34-b211-f8d5a0f3b04e",
                        "source_sense_id": "06ad6f27-989f-38ce-98dc-1b580fbb7578",
                        "source_sense_description": "Waffe, die besonders gravierende und dauerhafte Schäden für große Teile der Bevölkerung zur Folge hat",
                        "target_lang_word": "arme de destruction massive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arme de destruction massive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "986cc73a-2531-3416-86ee-17bf877b3442",
                                        "entry_id": "9ee71efd-eb38-3c0d-8b7b-9b7b4844d73e",
                                        "glosses": [
                                            "Arme conçue pour tuer une grande quantité de personnes sans discrimination, en particulier les armes nucléaires, radiologiques, biologique et chimique (NRBC)."
                                        ],
                                        "tags": [
                                            "Relations internationales",
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c85869c-d8ab-4731-8880-e40a5f851d49",
                                                "sense_id": "986cc73a-2531-3416-86ee-17bf877b3442",
                                                "text": "C’est le fil rouge de la propagande russe depuis le début de la guerre froide en 1949, explique Milton Leitenberg, spécialiste américain des armes de destruction massive, dans une étude sur l’histoire de cette forme de désinformation, publié en 2021. Cette obsession a débuté en 1950 lorsque Moscou a suggéré que les États-Unis envoyaient des doryphores porteurs d’un nouveau virus pour empoisonner les récoltes de pommes de terre en Allemagne de l’Est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd4f432-0451-3432-b787-eb8165103c19",
                                        "entry_id": "9ee71efd-eb38-3c0d-8b7b-9b7b4844d73e",
                                        "glosses": [
                                            "Élément destructeur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d888c07-748d-4f70-b57e-5c541d7b802b",
                                                "sense_id": "7dd4f432-0451-3432-b787-eb8165103c19",
                                                "text": "L’idéologie de la transparence – voire du soupçon –, qui avait été l’une des armes de destruction massive des médias, s’est retournée contre eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
