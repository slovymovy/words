                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a6254b-7846-47ed-9f9a-a5beef202cda",
                                "sense_id": "76060ba6-4112-3576-a6d1-dbf7bfe6a3b8",
                                "text": "„Zweitens kann, österreichischer Heeresoffizier gewesen zu sein, kein Verbrechen sein.“"
                            },
                            {
                                "example_id": "1330c40b-7afa-451d-bb9a-606ef0ba0195",
                                "sense_id": "76060ba6-4112-3576-a6d1-dbf7bfe6a3b8",
                                "text": "„Ein Grund für die Reduzierung waren massive Proteste von Heeresoffizieren.“"
                            },
                            {
                                "example_id": "c0fd9b93-9557-4301-ab8f-177ef80b9216",
                                "sense_id": "76060ba6-4112-3576-a6d1-dbf7bfe6a3b8",
                                "text": "„Bei einem Kameradschaftsessen von 500 Heeresoffizieren hielt Isabel unlängst eine Rede.“"
                            },
                            {
                                "example_id": "ecce0564-de00-4c64-a983-41c5f62a2d52",
                                "sense_id": "76060ba6-4112-3576-a6d1-dbf7bfe6a3b8",
                                "text": "„Hinter den überdicken Mauern der Militärakademie West Point werden seit 200 Jahren Amerikas Heeresoffiziere dazu erzogen, für ihr Land zu kämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
