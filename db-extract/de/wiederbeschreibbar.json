                ],
                "senses": [
                    {
                        "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                        "entry_id": "7ee0ce9b-6f7a-3956-ae72-95a9319cc79e",
                        "glosses": [
                            "geeignet, (auf einem Speichermedium) mehrfach/wiederholt Daten speichern zu können"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "83f9bd72-e8e6-486c-9084-a6444ed83f5e",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„Bei den DVD-Medien ist die DVD-RAM 100-mal so oft wiederbeschreibbar (circa 100.000-mal) wie die DVD-RW bzw. DVD+RW, die etwa 500 bis 1.000 Schreibvorgänge überstehen.“"
                            },
                            {
                                "example_id": "f7603e39-d567-450c-bc4f-ec923e5766d1",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„DVD R und + R sind einmal beschreibbare Medien. DVD-RAM, DVD +RW und DVD RW oder auch – RW sind mehrfach wiederbeschreibbar.“"
                            },
                            {
                                "example_id": "867de455-ce83-48f7-9a9a-ff0ea532966d",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„JVC hat die erste zweilagige wiederbeschreibbare DVD-RW entwickelt, die 8,5 GByte speichert.“"
                            },
                            {
                                "example_id": "de3a14a5-b3ec-4dcf-a7f7-23de216c9334",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„Die Blu-ray Disc gibt es in drei Varianten: als nur lesbare BD-ROM (vergleichbar mit DVD-ROM), als einmal beschreibbare Variante BD-R (vergleichbar mit DVD±R) und als wiederbeschreibbare BD-RE (vergleichbar mit DVD±RW).“"
                            },
                            {
                                "example_id": "d4f996e1-35aa-4a98-b300-18f96e067d76",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„RFID ist eine wiederbeschreibbare Technologie.“"
                            },
                            {
                                "example_id": "1c7e68ee-937d-4e73-a4aa-7891fa9089bc",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "[1970:] „Und erst ein Jahr zuvor hatte IBM die Floppy-Disk auf den Markt gebracht – eine 20 Zentimeter (acht Zoll) große Plastikscheibe mit 80 Kilobyte Speicherkapazität, die zunächst noch nicht einmal wiederbeschreibbar war.“"
                            },
                            {
                                "example_id": "da30ffef-d067-432f-8ede-402c204f6d40",
                                "sense_id": "0d90d638-95bd-37c4-8f6f-8cfd5077b7de",
                                "text": "„Eine Lithium-freie Filmbatterie ermöglicht das Schreiben von 15.000 Messwerten. Der Speicherbereich ist für 720 Messwerte ausgelegt und wiederbeschreibbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
