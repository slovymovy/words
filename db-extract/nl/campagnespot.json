                    {
                        "sense_id": "098039e9-7ba1-3529-8905-fbd43c3c981c",
                        "entry_id": "15a50eb3-0739-3534-9a41-986caa438e42",
                        "glosses": [
                            "kort filmpje dat mensen aanspoort op een bepaalde kandidaat of partij te stemmen"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "b90e9bbf-46a2-40f2-9d75-b5f1d1eec2ed",
                                "sense_id": "098039e9-7ba1-3529-8905-fbd43c3c981c",
                                "text": "Art.1, het kenniscentrum discriminatie Nederland, is geschrokken van de campagnespot. Onderzoeker Gregor Walz van Art.1 noemt het filmpje bizar. \"Het is een soort antisemitische complottheorie. Dit is heel raar. Je schrikt er wel van dat dit op nationale televisie te zien is.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9647eec2-d61f-3b91-a7ec-d9ed347e495c",
                        "entry_id": "15a50eb3-0739-3534-9a41-986caa438e42",
                        "glosses": [
                            "kort filmpje dat deel uitmaakt van een reclame- of voorlichtingscampagne"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "e0897fe7-7a21-4a77-9e56-bfd948e2b72e",
                                "sense_id": "9647eec2-d61f-3b91-a7ec-d9ed347e495c",
                                "text": "Dat is het Polen van vandaag, wil de door de regering betaalde campagnespot maar zeggen. Mede mogelijk gemaakt door de Europese Unie. En de cijfers spreken voor zich."
                            },
                            {
                                "example_id": "cccd8732-de0b-4ea9-871f-4f01f1675fc9",
                                "sense_id": "9647eec2-d61f-3b91-a7ec-d9ed347e495c",
                                "text": "In Groot-Brittannië is ophef ontstaan over een campagnespot van de Pancreatic Cancer Action, een vereniging van alvleesklierkankerpatiënten. Op posters zeggen patiënten dat ze liever een andere vorm van kanker hadden."
                            }
                        ]
                    }
