                        "sense_id": "19394db7-ccd5-34a1-9820-36035d220510",
                        "entry_id": "746aa1bd-e07d-3054-89b7-2d3a8fb012e4",
                        "glosses": [
                            "Compositeur de musique ou chef d’orchestre en renom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ccefefb-ac20-4a9a-bd6d-a150b1c04a9c",
                                "sense_id": "19394db7-ccd5-34a1-9820-36035d220510",
                                "text": "Le vieux maestro reçut un accueil enthousiaste."
                            },
                            {
                                "example_id": "75cf8ff2-2ad5-498b-8c9e-c04c571cd4ec",
                                "sense_id": "19394db7-ccd5-34a1-9820-36035d220510",
                                "text": "Une dame se met au piano, joue un morceau de Bellini, qui paraît être le maestro favori des Espagnols, ou chante une romance de Breton de los Herreros, le grand parolier de Madrid."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c3a941-6c99-31fa-8340-c9dcd32f171c",
                        "entry_id": "746aa1bd-e07d-3054-89b7-2d3a8fb012e4",
                        "glosses": [
                            "Musicien reconnu pour sa compétence."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7c54a808-33f4-4a96-99e4-7fdb8e4fdb9a",
                                "sense_id": "13c3a941-6c99-31fa-8340-c9dcd32f171c",
                                "text": "Elle devait se hâter, le maestro Pastore serait là dans une heure pour son cours de chant …."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bfac298-8384-3a70-b337-c178271c38cf",
                        "entry_id": "746aa1bd-e07d-3054-89b7-2d3a8fb012e4",
                        "glosses": [
                            "Virtuose."
