                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2b04aac-bb7b-4455-abfc-3aa2eb01a2a9",
                                                "sense_id": "94bb4678-a6a1-34ec-9d9d-99eb8124f0e7",
                                                "text": "Schlagen Sie die Eiklar zu festem Eischnee und heben Sie sie vorsichtig unter den Teig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
