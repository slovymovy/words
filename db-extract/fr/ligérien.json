                ],
                "senses": [
                    {
                        "sense_id": "e069683f-9f2b-3dc0-9972-0971bd98fc67",
                        "entry_id": "8ba9723a-c9da-3d90-9a7e-e4e9d9d408ce",
                        "glosses": [
                            "Qui appartient au bassin de la Loire, et à ses affluents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef82d12-7284-441c-aa8f-4731af0efbfd",
                                "sense_id": "e069683f-9f2b-3dc0-9972-0971bd98fc67",
                                "text": "Ainsi, l’abbaye de Saint-Martin de Tours, noyau d'un bourg à côté de la cité, possède, durant l’époque carolingienne, une quarantaine de domaines presque tous reliés au réseau ligérien, ainsi que douze navires et une exemption royale des tonlieux, ce qui lui assure une source importante de revenus."
                            },
                            {
                                "example_id": "351c9772-c4cb-4129-9d14-d48e6873c8ce",
                                "sense_id": "e069683f-9f2b-3dc0-9972-0971bd98fc67",
                                "text": "La région ligérienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "1718b9d6-ce5a-3d9e-962d-cb9a7a733c07",
                        "entry_id": "8ba9723a-c9da-3d90-9a7e-e4e9d9d408ce",
                        "glosses": [
                            "Relatif à la région des Pays de la Loire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4dd2006-f2e3-485d-aac9-a80b178d2224",
                                "sense_id": "1718b9d6-ce5a-3d9e-962d-cb9a7a733c07",
                                "text": "Association loi 1901, la CRESS des Pays de la Loire assure, sur le territoire ligérien la représentation, la promotion et le développement de l’ESS."
                            },
                            {
                                "example_id": "8c442769-57b2-4e1e-96b5-2a985b10faca",
                                "sense_id": "1718b9d6-ce5a-3d9e-962d-cb9a7a733c07",
                                "text": "Une cuvée originale à base de cépages locaux, le sémillon en sélection massale et le sauvignon, mais également avec 20 % de chenin, cépage ligérien planté récemment."
                            }
                        ]
                    }
