                                "target_senses": [
                                    {
                                        "sense_id": "c1a36114-cc3d-38b7-8193-4210585c6f93",
                                        "entry_id": "6fcecda2-4f79-36db-a6a7-9a32c066b509",
                                        "glosses": [
                                            "im Haushalt übliches Speisegewürz; enthält hauptsächlich Natriumchlorid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2575e4b4-e3e7-4c79-a9b5-b500f237258e",
                                                "sense_id": "c1a36114-cc3d-38b7-8193-4210585c6f93",
                                                "text": "Wasser mit Kochsalz ist elektrisch leitfähig."
                                            },
                                            {
                                                "example_id": "29e0880c-09bb-42f2-9073-56085187bcf1",
                                                "sense_id": "c1a36114-cc3d-38b7-8193-4210585c6f93",
                                                "text": "„Da es früher für den Menschen schwierig war, an ausreichende Mengen Kochsalz zu kommen, wird eine Salzaufnahme mit einer Dopaminausschüttung belohnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
