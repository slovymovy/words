                    },
                    {
                        "sense_id": "3e543e33-77d1-3741-8ac1-d7473e102dc1",
                        "entry_id": "ad7c38c1-7ecf-3038-a0e5-36991d0d5ebf",
                        "glosses": [
                            "The killer of a deity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
