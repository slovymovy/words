                "senses": [
                    {
                        "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                        "entry_id": "5fb1a4df-7bad-386a-bf5c-44d2feccaa91",
                        "glosses": [
                            "Emotionen auslösendes Wort oder Ausdruck mit entsprechender Wirkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08f47f8-5d97-4831-8024-0ca51f61db02",
                                "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                                "text": "Für viele Menschen ist „Reform“ ein Reizwort."
                            },
                            {
                                "example_id": "c0c235ad-faf3-48af-8d6a-4a97a6d87192",
                                "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                                "text": "„Wenn die Reizworte in einer Rede fielen, musste ich nichts mehr machen, es ging von allein los: klatsch, klatsch, klatsch.“"
                            },
                            {
                                "example_id": "3a75e7a6-3225-4edc-bf37-5d9b1b5f5dfc",
                                "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                                "text": "„Mit der sozialen Spaltung ist das Reizwort gefallen, das alle in ihre jeweiligen Schützengräben treibt.“"
                            },
                            {
                                "example_id": "0ed7fd31-17eb-4dcf-8254-f43aeba06999",
                                "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                                "text": "„Das Reizwort aber ist nahezu vergessen.“"
                            },
                            {
                                "example_id": "dea2091d-1693-459c-a99e-d025ddfaa2ec",
                                "sense_id": "860f6c07-2064-37ac-9288-9896bb1025d8",
                                "text": "„Das Reizwort kam rund und vollmundig heraus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63e67700-a867-349a-adcd-cb2a3f2cac31",
                        "entry_id": "5fb1a4df-7bad-386a-bf5c-44d2feccaa91",
                        "glosses": [
                            "Wort, auf das eine Versuchsperson reagieren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e6887a-4b7d-40fa-a7ea-e35fab494b5c",
                                "sense_id": "63e67700-a867-349a-adcd-cb2a3f2cac31",
                                "text": "Für Assoziationstests benötigt man Reizwörter."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
