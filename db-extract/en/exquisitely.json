                                    {
                                        "sense_id": "1e68edf5-231c-3b0b-ac0b-a8501be891e7",
                                        "entry_id": "aa7bb39b-086b-3902-be26-5b2144dc52e9",
                                        "glosses": [
                                            "D’une manière exquise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ed1bd5-12db-464f-a51f-ade0bd873b75",
                                                "sense_id": "1e68edf5-231c-3b0b-ac0b-a8501be891e7",
                                                "text": "Les trois femmes avaient arrangé Fernande avec le plus grand soin. Elle donne surtout l’impression d'être exquisement propre : les coulées de sueurs, le suintement des lochies ont été lavés et séchés ; une sorte d'arrêt temporaire semble se produire entre les dissolutions de la vie et celles de la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
