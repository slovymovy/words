{
    "word_family": [
        "marvelous",
        "marvellous",
        "marvelously",
        "marvellously"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16a94358-a9d3-39aa-ac11-88a58618f647",
                    "sense_definition": "To feel great surprise, wonder, or admiration at something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many tourists come to <w>marvel</w> at the ancient architecture of the cathedral.",
                            "target_lang_translations": {
                                "ru": "Многие туристы приезжают, чтобы <w>восхититься</w> древней архитектурой собора."
                            }
                        },
                        {
                            "text": "It is easy to <w>marvel</w> at the beauty of the stars on a clear night.",
                            "target_lang_translations": {
                                "ru": "Легко <w>изумляться</w> красоте звезд в ясную ночь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "marvel at the beauty",
                        "marvel at the sight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное удивление, восхищение или восторг перед чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восхищаться",
                                "target_lang_sense_clarification": "выражать восторг"
                            },
                            {
                                "target_lang_word": "изумляться",
                                "target_lang_sense_clarification": "сильно удивляться"
                            },
                            {
                                "target_lang_word": "дивоваться",
                                "target_lang_sense_clarification": "разг., смотреть с удивлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bed7aba-53c5-3167-8a36-775d9d912ee6",
                    "sense_definition": "To cause someone to feel wonder or surprise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange occurrences in the old house <w>marveled</w> the local residents.",
                            "target_lang_translations": {
                                "ru": "Странные происшествия в старом доме <w>изумляли</w> местных жителей."
                            }
                        },
                        {
                            "text": "It <w>marveled</w> me to see how quickly the landscape changed after the storm.",
                            "target_lang_translations": {
                                "ru": "Меня <w>удивило</w>, как быстро изменился пейзаж после шторма."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English as a transitive verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать у кого-либо чувство изумления или удивления (устаревшее использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумлять",
                                "target_lang_sense_clarification": "приводить в изумление"
                            },
                            {
                                "target_lang_word": "удивлять",
                                "target_lang_sense_clarification": "вызывать удивление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84b929a2-7672-3437-aac6-93e142d0bc0b",
                    "sense_definition": "A person or thing that causes a feeling of great wonder or admiration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wonder_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new bridge is a modern engineering <w>marvel</w> that connects the two islands.",
                            "target_lang_translations": {
                                "ru": "Новый мост — это современное инженерное <w>чудо</w>, соединяющее два острова."
                            }
                        },
                        {
                            "text": "The Great Wall of China remains a <w>marvel</w> of the ancient world.",
                            "target_lang_translations": {
                                "ru": "Великая Китайская стена остается <w>дивом</w> древнего мира."
                            }
                        }
                    ],
                    "synonyms": [
                        "lollapalooza"
                    ],
                    "common_phrases": [
                        "modern marvel",
                        "engineering marvel",
                        "architectural marvel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, вызывающий чувство великого удивления или восхищения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "нечто поразительное"
                            },
                            {
                                "target_lang_word": "диво",
                                "target_lang_sense_clarification": "нечто удивительное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14af7e23-b86e-33ef-9f30-7bdf59a7539d",
                    "sense_definition": "A feeling of great surprise, wonder, or astonishment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wonder_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children watched the magician's performance with wide-eyed <w>marvel</w>.",
                            "target_lang_translations": {
                                "ru": "Дети смотрели на выступление фокусника с широко раскрытыми от <w>изумления</w> глазами."
                            }
                        },
                        {
                            "text": "She looked at the vast canyon in <w>marvel</w> and silence.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на огромный каньон в <w>восхищении</w> и тишине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "filled with marvel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильного удивления, восторга или изумления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумление",
                                "target_lang_sense_clarification": "крайнее удивление"
                            },
                            {
                                "target_lang_word": "восхищение",
                                "target_lang_sense_clarification": "состояние восторга"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a255ce2e-9af3-3608-96a5-599d8593e77d",
                    "sense_definition": "A common short name for <w>Marvel</w> Comics or <w>Marvel</w> Studios, known for superhero stories.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_brand",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "The latest <w>Marvel</w> movie broke several box office records during its opening weekend.",
                            "target_lang_translations": {
                                "ru": "Последний фильм <w>Марвел</w> побил несколько кассовых рекордов в первые выходные проката."
                            }
                        },
                        {
                            "text": "He has a huge collection of <w>Marvel</w> comic books in his room.",
                            "target_lang_translations": {
                                "ru": "У него в комнате огромная коллекция комиксов <w>Марвел</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Marvel movie",
                        "Marvel universe",
                        "Marvel comics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое название компании Marvel Comics или Marvel Studios, известных своими историями о супергероях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Марвел",
                                "target_lang_sense_clarification": "бренд или студия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f1db4d4-6e9d-3197-afdc-caefa4acc631",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor introduced us to the works of Andrew <w>Marvel</w> during the literature class.",
                            "target_lang_translations": {
                                "ru": "Профессор познакомил нас с произведениями Эндрю <w>Марвелла</w> на уроке литературы."
                            }
                        },
                        {
                            "text": "There are several families with the name <w>Marvel</w> living in this county.",
                            "target_lang_translations": {
                                "ru": "В этом округе живут несколько семей с фамилией <w>Марвелл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "less common than the brand name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Марвелл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}