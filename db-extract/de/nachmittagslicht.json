                "senses": [
                    {
                        "sense_id": "806774ea-fe55-3357-87f2-d644b1171a3a",
                        "entry_id": "b792e879-a4f4-30ef-b292-602e96039105",
                        "glosses": [
                            "Lichtverhältnisse, wie sie sich am Nachmittag einstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053a772f-1771-4c2f-af5f-6ef015a9fc07",
                                "sense_id": "806774ea-fe55-3357-87f2-d644b1171a3a",
                                "text": "„Sie kennen ja das helle Nachmittagslicht, das kalt in alle Ecken der Welt hineinscheint, und alle Ecken der Welt sind öde.“"
                            },
                            {
                                "example_id": "8573d254-3693-4e90-a910-bc93145348d1",
                                "sense_id": "806774ea-fe55-3357-87f2-d644b1171a3a",
                                "text": "„Und auch die Pianistin Anke Helfrich mit ihrem Trio, die im strahlenden Nachmittagslicht ihr Set im Geiste der Moderne des Klavierjazz absolvierte, hatte es nicht leicht in diesem Zusammenhang.“"
                            },
                            {
                                "example_id": "81f7ffba-3f78-4643-a56e-7aef26f962e9",
                                "sense_id": "806774ea-fe55-3357-87f2-d644b1171a3a",
                                "text": "„Sie ließ den Laden in Julies Händen, eilte im schon dämmrigen Nachmittagslicht zum Jardin du Luxembourg und kaufte bei Louisa einen hübschen Weihnachtsstern, dann nahm sie wegen der Kälte ein Taxi zum Père Lachaise, obwohl sie sonst mit der Metro fuhr, um Geld zu sparen.“"
                            },
                            {
                                "example_id": "abfe46e5-6d88-4842-be81-a719fae077b2",
                                "sense_id": "806774ea-fe55-3357-87f2-d644b1171a3a",
                                "text": "„Ich setzte mich in eine Ecke, in der mir das Nachmittagslicht über die Schulter fiel, nahm mein Notizbuch und schrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
