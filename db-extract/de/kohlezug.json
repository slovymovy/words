                "senses": [
                    {
                        "sense_id": "72801b47-cf14-3e1b-8fa5-5209ffc3cd1e",
                        "entry_id": "44eac550-4f36-386d-a921-15d3580a7c51",
                        "glosses": [
                            "Eisenbahnzug, mit dem Kohle transportiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b8ace4-6131-4a7b-9dd0-d2649d80d8a9",
                                "sense_id": "72801b47-cf14-3e1b-8fa5-5209ffc3cd1e",
                                "text": "„Kohlezüge konnten am Samstagnachmittag das Werk nicht erreichen, wie der Betreiber Vattenfall und das Protestbündnis \"Ende Gelände\" übereinstimmend berichteten.“"
                            },
                            {
                                "example_id": "f868249f-36a4-406b-aa5c-91f33205b545",
                                "sense_id": "72801b47-cf14-3e1b-8fa5-5209ffc3cd1e",
                                "text": "„Seit dem Vortag hatten Hunderte Menschen die Gleise der Kohlezüge besetzt gehalten und damit den Nachschub mit Braunkohle abgeschnitten.“"
                            },
                            {
                                "example_id": "b004e4d5-46c6-4050-b3e4-8cd8bb7c0a9d",
                                "sense_id": "72801b47-cf14-3e1b-8fa5-5209ffc3cd1e",
                                "text": "„Es sollten möglichst viele Kohlezüge auf dem Weg in das Kraftwerk gestoppt werden - und ein Zeichen gegen den Energiekonzern RWE setzen, der das Kraftwerk betreibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
