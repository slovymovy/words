                                "target_lang_sense_clarification": "außergewöhnlich, auffällig"
                            },
                            {
                                "target_lang_word": "exzentrisch",
                                "target_lang_sense_clarification": "eigenwillig, schrill"
                            },
                            {
                                "target_lang_word": "gewagt",
                                "target_lang_sense_clarification": "mutig, unkonventionell"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5f9e486-928d-3d9f-9caf-cc03db2ba8c1",
                    "sense_definition": "Fierce, violent, or cruel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outrageous</w> storm destroyed the small village and left many people homeless.",
                            "target_lang_translations": {
                                "ru": "<w>Свирепый</w> шторм разрушил маленькую деревню и оставил многих людей без крова.",
                                "de": "Der <w>heftige</w> Sturm zerstörte das kleine Dorf und machte viele Menschen obdachlos."
                            }
                        },
                        {
                            "text": "He could not withstand the <w>outrageous</w> attack of the enemy forces.",
                            "target_lang_translations": {
                                "ru": "Он не смог противостоять <w>яростной</w> атаке вражеских сил.",
                                "de": "Er konnte dem <w>brutalen</w> Angriff der feindlichen Streitkräfte nicht standhalten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe violence or storms."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свирепый, насильственный или жестокий.",
                        "de": "Wild, gewalttätig oder grausam."
                    },
                    "translations": {
