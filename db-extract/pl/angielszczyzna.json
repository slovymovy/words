                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d9a87c-42fe-4d16-893d-4912eda98bd8",
                                                "sense_id": "7db9bb07-5b7c-3c58-b35c-4894c8963fb7",
                                                "text": "„Der Mann, der mich am Samstagvormittag an einem Stand mit diesen Worten ansprach, musste gerade aus der gegenüberliegenden Kneipe gekommen sein, nach einem ausgiebigen Frühschoppen, denn seine Sprache war mehr als leicht verwaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "777013f0-b77e-3ea5-87cf-f42830ba04c7",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
