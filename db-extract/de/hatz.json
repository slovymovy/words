                        ],
                        "examples": [
                            {
                                "example_id": "8dfeeb9f-238e-4920-bb47-cbd8184e2de6",
                                "sense_id": "b1de9f43-9980-3ab7-a822-ee5b7f4b11f9",
                                "text": "„Gruppen von 150 Männern ziehen zur Hatz in den Busch, jeder mit einem kleinen Beil bewaffnet, treiben einen Elefanten vor sich her und versuchen, ihm Wunden an den Beinen zuzufügen, bis das Tier unter seinem eigenen Gewicht zusammenbricht.“"
                            }
                        ],
