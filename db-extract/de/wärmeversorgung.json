                ],
                "senses": [
                    {
                        "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                        "entry_id": "53be2af5-f323-3926-a776-bdb87d8b6438",
                        "glosses": [
                            "Bereitstellung von Wärme, beispielsweise zum Heizen eines Hauses oder für Warmwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e31c8fc-bdbf-4097-a3a2-9146bfbaaa0d",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "Die Kosten für die Wärmeversorgung werden für die Mieter in der Nebenkostenabrechnung sichtbar."
                            },
                            {
                                "example_id": "4cf55c1c-8d41-4a1b-b93a-9842f6face28",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Um den Erdgasverbrauch zu senken, ist somit eine neue Strategie in der Wärmeversorgung, d. h. eine Wärmewende, erforderlich.“"
                            },
                            {
                                "example_id": "fbe6c61b-64a7-4276-ba2c-c5d7650b8be2",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Geothermie gilt unter Experten als eine zuverlässige und ausgereifte Technologie, mit der die Wärmeversorgung für ganze Städte realisiert werden kann - und das klimafreundlich.“"
                            },
                            {
                                "example_id": "4b90c285-5c2e-44df-8e49-ea79c594fe49",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Zwei Tage nach den massiven russischen Raketenangriffen war am Sonntag die Wärmeversorgung in der ukrainischen Hauptstadt Kiew wiederhergestellt.“"
                            },
                            {
                                "example_id": "c9e7cea3-9816-40e9-93c0-ad57f59917ec",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Wegen der Kriegsschäden an Strom- und Wärmeversorgung der Ukraine bittet die Regierung geflüchtete Frauen und Männer, erst im kommenden Frühjahr zurückzukehren.“"
                            },
                            {
                                "example_id": "fd196e44-65d6-4fb1-a07f-c103a31171b1",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Wenn die Wärmeversorgung nicht sichergestellt ist, kann bei Minustemperaturen zudem die Wasserversorgung einfrieren.“"
                            },
                            {
                                "example_id": "1fe23d09-e6b9-44c3-ae5f-edc7f4e95466",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Wien sucht nach Heißwasservorkommen, um diese im Erfolgsfall als Energiequelle für die Wärmeversorgung der Stadt zu nutzen.“"
                            },
                            {
                                "example_id": "514bbcc2-c933-4a3f-b1cd-1339926745dd",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "[Hamburg:] „Wenn die klimaneutrale Wärmeversorgung aus dem Süden gesichert ist, sollen planmäßig das Kohkekraftwerk Wedel 2025 und das Kraftwerk Tiefstack fünf Jahre später vom Netz gehen.“"
                            },
                            {
                                "example_id": "ea17c8f0-aef3-403e-a0c0-094238b7424c",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Geothermie gilt als Energie der Zukunft. Im Süddeutschen Raum sind bereits mehrere Kraftwerke in Betrieb, die Energie aus der Tiefe für die Wärmeversorgung nutzen.“"
                            },
                            {
                                "example_id": "bfee3651-39f3-4e87-9b1e-003726d1174b",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "[Grönland:] „Das staatliche Versorgungsunternehmen Nukissiorfiit ist für die Strom-, Wasser- und Wärmeversorgung in Qaanaaq zuständig.“"
                            },
                            {
                                "example_id": "616fff4c-6bf1-4492-bfe6-f26a91a50eec",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Auch im badischen Bruchsal sehen sie im Wasserstoff nicht die zentrale Lösung, um die Wärmeversorgung CO2-neutral zu gestalten.“"
                            },
                            {
                                "example_id": "0018590e-b29c-4ebf-abe3-6724105221c7",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "[…] „»wenn wir davon ausgehen, dass die Geothermie 40 Prozent der zukünftigen Wärmeversorgung abdecken kann, dann kann man davon ausgehen, dass durch die Nutzung der Geothermie 35 Millionen Tonnen CO2 pro Jahr eingespart werden können.«“"
                            },
                            {
                                "example_id": "ef148426-67f4-43da-afd9-066aa31fafd2",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Bis 2040 will die Stadt die gesamte Wärmeversorgung auf erneuerbaren Energien umstellen - und setzt dabei voll auf Erdwärme.“"
                            },
                            {
                                "example_id": "8db960d3-f391-453d-8064-4151de83d5d8",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Die Industriellen Werke Basel (IWB) wollen die Wärmeversorgung im Stadtkanton grundlegend umbauen.“"
                            },
                            {
                                "example_id": "06ee9ff0-e281-4a22-ad36-c85da8d6ff51",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Im Landkreis Ostholstein liegt das 180-Einwohner-Dorf Horsdorf. Hier hatten sie schon vor Jahren die Idee, Holzabfälle für die örtliche Wärmeversorgung zu verwenden.“"
                            },
                            {
                                "example_id": "bc62cb94-f4de-462d-9df8-3d5610a44bfa",
                                "sense_id": "d94d0075-63e7-3289-b9c1-eda6b517dc81",
                                "text": "„Durch die Konvektion ist es möglich, zur Wärmeversorgung von Häusern und Wohnungen Zentralheizungen zu bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
