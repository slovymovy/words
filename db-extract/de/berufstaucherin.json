                        "sense_id": "abbaaa18-8971-39b6-8669-9eb2470405a6",
                        "entry_id": "3774427e-e5ea-38f8-b5c4-7239a5212a10",
                        "glosses": [
                            "weibliche Person, die das Tauchen berufsmäßig ausübt"
