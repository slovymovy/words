                        "entry_id": "7250f166-28ab-3e0f-b05c-20f26474f2de",
                        "glosses": [
                            "The state or action of desiring or craving."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5159b3d2-2d43-4b65-b5b4-983300811dc6",
                                "sense_id": "be3eab94-099e-378c-b979-8f8211f937f9",
                                "text": "[T]hat fair femal Troop […] / Bred onely and completed to the taſte / Of luſtful appetence, to ſing, to dance, / To dreſs, and troule the Tongue, and roule the Eye."
                            },
                            {
                                "example_id": "fca403c0-cffd-4f4d-b0fb-ce457100b523",
                                "sense_id": "be3eab94-099e-378c-b979-8f8211f937f9",
                                "text": "The days passed quickly; I could see that the professor was all quivering with suppressed excitement, and I could scarce credit the eager appetence of his glance as we left the old manor house behind us, and began our journey."
                            },
                            {
                                "example_id": "9e599a1a-5d25-438e-b100-5c07426f9ab1",
                                "sense_id": "be3eab94-099e-378c-b979-8f8211f937f9",
                                "text": "They had assumed the wild sweet freedom of jacking off in their inviolable privacy. Their appetence became resilient with repetition."
                            }
                        ]
                    }
