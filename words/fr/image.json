                    "frequency": "High",
                    "semantic_group_id": "représentation visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur cette <w>image</w>, on voit toute la famille devant la maison."
                        },
                        {
                            "text": "Le journal publie chaque jour des <w>images</w> de la ville en fête."
                        },
                        {
                            "text": "Ce film utilise beaucoup d'<w>images</w> de synthèse pour les décors."
                        }
