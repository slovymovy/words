                "senses": [
                    {
                        "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                        "entry_id": "1e08de8d-4b2e-3d0b-baf2-60bb0b354ec3",
                        "glosses": [
                            "motorbetriebene, als Gatter organisierte Sägevorrichtung in Sägewerken oder Sägemühlen zum Längsschneiden von Baumstämmen zu Brettern und Balken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3dd974-9f4e-42b2-9937-97930694cfb0",
                                "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                                "text": "„Im Winter aber liegt das Sägewerk mit seinen beschneiten Baumstämmen wie ausgestorben da, und das Rattern der Gattersäge verstärkt den Eindruck des Todes, der von der Anlage ausgeht. Ab und zu streift ein Gendarm zwischen den Gebäuden herum mit umgehängtem Gewehr, selten hört man den gedämpften Ruf eines Entmündigten.“"
                            },
                            {
                                "example_id": "849d1921-ec9e-4fa6-92ea-e51f98ffb293",
                                "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                                "text": "„Für jedes Blockhaus verbaut er 60 bis 80 Baumstämme. Dabei benutzt er die alte Gattersäge nur selten, meistens genügt eine Motorsäge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
