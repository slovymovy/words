                "translations": [
                    {
                        "translation_id": "e7faf873-0b50-4450-b6e7-59970fbcaafb",
                        "source_entry_id": "4ab4dd2b-bb21-3f4b-986a-619e9ff3338a",
                        "target_lang_word": "karmeliet",
                        "target_lang_code": "nl",
