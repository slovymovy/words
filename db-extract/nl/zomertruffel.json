                        ],
                        "examples": [
                            {
                                "example_id": "8a31c7f7-4708-4726-988b-053a22fa4943",
                                "sense_id": "f26fa5e0-30ec-303f-8e8c-bbdf2a87e6e8",
                                "text": "Daarna verschijnt een mals gebraad van Bonte Bentheimer op tafel. Dit hoofdgerecht wordt geserveerd op een stamppotje van rucola, gedroogde tomaat en groene asperges, met een jus van zomertruffel. De bijpassende wijn is een Italiaanse Cabernet Montelvini, ook van Baeten Vinopolis."
                            },
                            {
                                "example_id": "62ad4643-1ee7-4881-aa58-e1e601be4766",
                                "sense_id": "f26fa5e0-30ec-303f-8e8c-bbdf2a87e6e8",
                                "text": "Aanschuiven voor een menu du marché, culinaire verwennerij voor 24 euro. Misschien wordt vandaag wel zomertruffel geserveerd..."
                            },
                            {
                                "example_id": "dbc7cf96-6b1d-4044-8834-a907d5f6582d",
                                "sense_id": "f26fa5e0-30ec-303f-8e8c-bbdf2a87e6e8",
                                "text": "Je hebt ook zomertruffel hoor. Die zijn volledig wit van binnen. Zelf vind ik die minder smakelijk’’, zegt Jaspers."
                            }
                        ]
                    }
