{
    "word_family": [
        "insularity",
        "insularism",
        "insularly",
        "insulate",
        "insulation",
        "insulator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be746238-9d6d-371e-b55c-d4f571564a0e",
                    "sense_definition": "Narrow-minded, provincial, or isolated from outside influences and viewpoints.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small mountain village developed an <w>insular</w> community that rarely welcomed strangers.",
                            "target_lang_translations": {
                                "de": "Das kleine Bergdorf entwickelte eine <w>abgeschottete</w> Gemeinschaft, die Fremde selten willkommen hieß."
                            }
                        },
                        {
                            "text": "Her travels broadened her worldview and helped her overcome an <w>insular</w> mindset.",
                            "target_lang_translations": {
                                "de": "Ihre Reisen erweiterten ihre Weltanschauung und halfen ihr, eine <w>engstirnige</w> Denkweise zu überwinden."
                            }
                        }
                    ],
                    "synonyms": [
                        "narrow-minded",
                        "parochial",
                        "provincial"
                    ],
                    "antonyms": [
                        "broad-minded",
                        "cosmopolitan",
                        "open-minded"
                    ],
                    "common_phrases": [
                        "insular community",
                        "insular mindset",
                        "insular attitude"
                    ],
                    "target_lang_definitions": {
                        "de": "Engstirnig, provinziell oder gegenüber äußeren Einflüssen und Ansichten isoliert."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "engstirnig",
                                "target_lang_sense_clarification": "geistig beschränkt oder unaufgeschlossen"
                            },
                            {
                                "target_lang_word": "provinziell",
                                "target_lang_sense_clarification": "kleinstädtisch, beschränkt in der Denkweise"
                            },
                            {
                                "target_lang_word": "isoliert",
                                "target_lang_sense_clarification": "abgeschottet von äußeren Einflüssen"
                            },
                            {
                                "target_lang_word": "insular",
                                "target_lang_sense_clarification": "gehoben oder bildungssprachlich für inselartig abgeschlossen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a3639f-00c2-372a-ab41-f76d467517c5",
                    "sense_definition": "Inward-looking, standoffish, or socially withdrawn in manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_isolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew increasingly <w>insular</w> after retiring, rarely leaving his country house.",
                            "target_lang_translations": {
                                "de": "Nach seiner Pensionierung lebte er zunehmend <w>zurückgezogen</w> und verließ sein Landhaus nur selten."
                            }
                        },
                        {
                            "text": "Her quiet, <w>insular</w> nature was often mistaken by new colleagues for cold hostility.",
                            "target_lang_translations": {
                                "de": "Ihre ruhige, <w>unnahbare</w> Art wurde von neuen Kollegen oft fälschlicherweise als kalte Feindseligkeit missverstanden."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdrawn",
                        "standoffish",
                        "introverted"
                    ],
                    "antonyms": [
                        "outgoing",
                        "sociable"
                    ],
                    "target_lang_definitions": {
                        "de": "In sich gekehrt, unnahbar oder sozial zurückgezogen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zurückgezogen",
                                "target_lang_sense_clarification": "wenig Kontakt zu anderen suchend"
                            },
                            {
                                "target_lang_word": "in sich gekehrt",
                                "target_lang_sense_clarification": "verschlossen und wenig kontaktfreudig"
                            },
                            {
                                "target_lang_word": "unnahbar",
                                "target_lang_sense_clarification": "distanziert und abweisend wirkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3d0744f-17d0-372d-ba73-790f5ad10f5a",
                    "sense_definition": "Of, relating to, situated on, or characteristic of an island.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "island_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country's <w>insular</w> geography provided natural defenses against foreign invaders.",
                            "target_lang_translations": {
                                "de": "Die <w>Inselgeografie</w> des Landes bot natürlichen Schutz vor fremden Angreifern."
                            }
                        },
                        {
                            "text": "Unique animal species evolved independently within the remote <w>insular</w> habitat.",
                            "target_lang_translations": {
                                "de": "Einzigartige Tierarten entwickelten sich unabhängig voneinander in dem abgelegenen <w>Inselhabitat</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "continental",
                        "mainland"
                    ],
                    "common_phrases": [
                        "insular climate",
                        "insular geography"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Insel betreffend, auf einer Insel gelegen oder für eine Insel charakteristisch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Insel-",
                                "target_lang_sense_clarification": "in Zusammensetzungen, z. B. Inselklima"
                            },
                            {
                                "target_lang_word": "insular",
                                "target_lang_sense_clarification": "gehoben oder fachsprachlich für inselartig oder die Inseln betreffend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecdf8ed2-ed23-3daa-a7c9-60c59257652e",
                    "sense_definition": "Relating to languages, cultures, or scripts specific to islands, especially the British Isles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "island_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars continue to debate the historical relationships among the different branches of <w>Insular</w> Celtic.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler debattieren weiterhin über die historischen Beziehungen zwischen den verschiedenen Zweigen des <w>Inselkeltischen</w>."
                            }
                        },
                        {
                            "text": "Medieval scribes copied the sacred manuscripts using a distinctive <w>insular</w> script.",
                            "target_lang_translations": {
                                "de": "Mittelalterliche Schreiber kopierten die heiligen Manuskripte in einer charakteristischen <w>insularen</w> Schrift."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Insular Celtic",
                        "Insular Latin",
                        "insular script"
                    ],
                    "target_lang_definitions": {
                        "de": "Bezieht sich auf Sprachen, Kulturen oder Schriften, die für Inseln, insbesondere die Britischen Inseln, charakteristisch sind."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "insulär",
                                "target_lang_sense_clarification": "fachsprachlich in Linguistik und Paläografie"
                            },
                            {
                                "target_lang_word": "Insel-",
                                "target_lang_sense_clarification": "als Bestimmungswort, z. B. Inselkeltisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce6909aa-64ac-3703-8a98-67994a3092ae",
                    "sense_definition": "Relating to the insula of the brain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered damage to the <w>insular</w> cortex following a severe stroke.",
                            "target_lang_translations": {
                                "de": "Der Patient erlitt nach einem schweren Schlaganfall Schäden am <w>insulären</w> Kortex."
                            }
                        },
                        {
                            "text": "Researchers measured brain activity in the <w>insular</w> lobe during the emotion processing test.",
                            "target_lang_translations": {
                                "de": "Forscher maßen die Gehirnaktivität im <w>Insellappen</w> während des Tests zur Emotionsverarbeitung."
                            }
                        }
                    ],
                    "common_phrases": [
                        "insular cortex"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Insula (Inselrinde) des Gehirns betreffend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "insulär",
                                "target_lang_sense_clarification": "anatomisch auf die Inselrinde bezogen"
                            },
                            {
                                "target_lang_word": "Insel-",
                                "target_lang_sense_clarification": "als medizinisches Präfix, z. B. Inselrinde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f71c594-5bed-3c72-9c67-98902bcb0ef8",
                    "sense_definition": "Relating to or derived from insulin or the islets of Langerhans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher examined <w>insular</w> tissue under a microscope to evaluate cellular function.",
                            "target_lang_translations": {
                                "de": "Der Forscher untersuchte <w>Inselgewebe</w> unter dem Mikroskop, um die Zellfunktion zu beurteilen."
                            }
                        },
                        {
                            "text": "Severe dysfunction of <w>insular</w> cells can lead to impaired regulation of blood sugar.",
                            "target_lang_translations": {
                                "de": "Eine schwere Fehlfunktion der <w>Inselzellen</w> kann zu einer gestörten Blutzuckerregulation führen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Auf Insulin oder die Langerhans-Inseln der Bauchspeicheldrüse bezogen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "insulär",
                                "target_lang_sense_clarification": "medizinisch bezüglich der Inselzellen"
                            },
                            {
                                "target_lang_word": "Insel-",
                                "target_lang_sense_clarification": "in Zusammensetzungen, z. B. Inselzellen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7a1eed9-41bc-3540-886d-957034e7b586",
                    "sense_definition": "An inhabitant of an island; an islander.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "island_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trade ships frequently arrived at port to barter with the local <w>insulars</w>.",
                            "target_lang_translations": {
                                "de": "Handelsschiffe liefen häufig den Hafen an, um mit den einheimischen <w>Inselbewohnern</w> Tauschhandel zu treiben."
                            }
                        },
                        {
                            "text": "The customs and traditions of these hardy <w>insulars</w> have survived for centuries.",
                            "target_lang_translations": {
                                "de": "Die Bräuche und Traditionen dieser abgehärteten <w>Insulaner</w> haben über Jahrhunderte hinweg überlebt."
                            }
                        }
                    ],
                    "synonyms": [
                        "islander"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Bewohner oder Bewohnerin einer Insel; Inselbewohner."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Inselbewohner",
                                "target_lang_sense_clarification": "männliche oder generische Person, die auf einer Insel lebt"
                            },
                            {
                                "target_lang_word": "Insulaner",
                                "target_lang_sense_clarification": "Bewohner einer Insel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}