                ],
                "senses": [
                    {
                        "sense_id": "10830574-c6c0-3b12-94bf-03a72def5ff4",
                        "entry_id": "e3e012cf-63d1-317c-849a-8c665f3a46d3",
                        "glosses": [
                            "À base de vinaigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c7474d-9794-4b04-8778-0f61b6f08156",
                                "sense_id": "10830574-c6c0-3b12-94bf-03a72def5ff4",
                                "text": "Il en est de même des moutardes douces (type Savora), des sauces vinaigrées d’origine anglaise (pickles, chutney) et de la Worcestershire sauce."
                            },
                            {
                                "example_id": "0bb70d28-7ad9-4179-90d6-e5638118285e",
                                "sense_id": "10830574-c6c0-3b12-94bf-03a72def5ff4",
                                "text": "– Ce qui m’a semblé le meilleur, c’était la salade de pommes de terre et la vinaigrette de veau.\n– Je sais bien pourquoi : c’est parce que maman te défend habituellement de manger des choses vinaigrées."
                            },
                            {
                                "example_id": "f4706356-58ae-4a68-bdd4-b2ab657e8dc7",
                                "sense_id": "10830574-c6c0-3b12-94bf-03a72def5ff4",
                                "text": "L’humble dépense de son dîner s’accroît maintenant, pour agacer l’appétit interrompu, d’inutiles suppléments de salades durement vinaigrées et d’un demi-siphon d’eau de Seltz."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f4e84f-f6ea-370d-b877-5b2e8ca5f7a8",
                        "entry_id": "e3e012cf-63d1-317c-849a-8c665f3a46d3",
                        "glosses": [
                            "Aigre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4ce55be3-f5cd-4ef4-aff0-3a1472e51284",
                                "sense_id": "90f4e84f-f6ea-370d-b877-5b2e8ca5f7a8",
                                "text": "La voix vinaigrée de mistress Mac Pherson dominait d’une octave le grave contralto de mistress Grant, abondamment pourvue par son mari de citations bibliques, au cours desquelles revenait comme un refrain le terrible : Tu enfanteras dans la douleur."
                            }
                        ]
                    }
