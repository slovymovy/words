                "translations": [
                    {
                        "translation_id": "cc313749-2d70-4256-a7c1-79567615dbcf",
                        "source_entry_id": "b35a9bf9-fb35-313c-8167-0db575056011",
                        "target_lang_word": "flou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "822a8f23-3f10-3916-aaf5-47e330edc6e3",
                                        "entry_id": "4bf0743f-fe30-3f2d-8d3a-b1696948df82",
                                        "glosses": [
                                            "D'un coloris sans vigueur, qui manque de netteté des contours ou des arêtes."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2add108-c51e-4b8e-9cd4-3c6b7c5567f2",
                                                "sense_id": "822a8f23-3f10-3916-aaf5-47e330edc6e3",
                                                "text": "Je suis consterné. Grâce aux progrès du progrès, il va devenir impossible de faire des photos floues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dcefdf0-92cb-3338-bd6d-e24604b923b5",
                                        "entry_id": "4bf0743f-fe30-3f2d-8d3a-b1696948df82",
                                        "glosses": [
                                            "Qualifie une chose un peu indistincte, dont le caractère n’est pas facilement déterminable ou discernable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2241c01a-578a-4c26-a182-e5e883342c3d",
                                                "sense_id": "3dcefdf0-92cb-3338-bd6d-e24604b923b5",
                                                "text": "Ces idées floues\nLà comme un serment qui gêne\nJe sais tu t'en fous\nC'est un soupir\nUn frisson qui ne vaut pas ces\nTrois francs six sous\nJ'ai les idées floues\nJe sais tu t'en fous\nJ'ai les idées floues."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32051692-bfbe-3566-844f-5b462134ed62",
                                        "entry_id": "26002411-b3eb-36be-8148-235f30ac72e9",
                                        "glosses": [
                                            "Coloris sans vigueur, manque de netteté des contours ou des arêtes."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352f3a6c-ebd6-4272-ba32-f0d5258f173b",
                                                "sense_id": "32051692-bfbe-3566-844f-5b462134ed62",
                                                "text": "[…] le flou des photos ratées parce qu’on n'a pas su se tenir immobile au bon moment […]."
                                            },
                                            {
                                                "example_id": "84659aec-0320-4587-bc93-824567c24eee",
                                                "sense_id": "32051692-bfbe-3566-844f-5b462134ed62",
                                                "text": "Or, le flou, c’est ce qu’il y a de mieux dans la photo. Le flou, c’est la vie. Le flou, c’est le mouvement. Le flou, c’est la poésie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0af4ae13-5ce2-3044-b768-1ecf5b85ea5a",
                                        "entry_id": "eed08eeb-72d6-3263-acf1-1c9ffe99e99e",
                                        "glosses": [
                                            "D'une manière pas nette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6678030-1a3b-405b-860b-2d2165928ff6",
                                                "sense_id": "0af4ae13-5ce2-3044-b768-1ecf5b85ea5a",
                                                "text": "Je revenais avec papa de chez l’oculiste, qui m'avait mis une pommade sur les yeux, et je voyais tout flou."
                                            },
                                            {
                                                "example_id": "324cad82-52e8-436d-bfc9-db3d3b8592cf",
                                                "sense_id": "0af4ae13-5ce2-3044-b768-1ecf5b85ea5a",
                                                "text": "Pour le moment, cet homme-là, au pied de son lit, elle le voit flou, elle n'a pas mis ses lunettes, et ne les mettra pas, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f4e4ace-fa9d-4d19-b8fa-7adea7c18cb3",
                        "source_entry_id": "b35a9bf9-fb35-313c-8167-0db575056011",
                        "target_lang_word": "imprécision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprécision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                                        "entry_id": "51970beb-e659-3574-933c-406194cb7590",
                                        "glosses": [
                                            "Qualité de ce qui est imprécis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6533f7-53a8-4021-9792-d233dc632c2c",
                                                "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                                                "text": "Dans le brouillard, les objets restent dans l’imprécision."
                                            },
                                            {
                                                "example_id": "eac0ab40-7725-47a0-ae0e-d3a845aab321",
                                                "sense_id": "747c19cf-8af6-36e2-b7b2-2be0cfe7fee2",
                                                "text": "L’imprécision du style, du souvenir, d’un récit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                                        "entry_id": "51970beb-e659-3574-933c-406194cb7590",
                                        "glosses": [
                                            "Point qui manque de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2cb761-3bfb-4880-9024-8159c8033b1e",
                                                "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                                                "text": "Néanmoins la vectorisation entraîne des imprécisions et des pertes d'informations qui peuvent être parfois gênantes pour des traitements ultérieurs. Pour vectoriser une image il faut au préalable extraire le squelette des objets."
                                            },
                                            {
                                                "example_id": "d8344850-0336-42a2-9344-48491029b44a",
                                                "sense_id": "0d36241a-3573-392e-b8c2-f11bf1a25243",
                                                "text": "L’utilisation de ce mot dans ce contexte est une imprécision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
