            {
                "entry_id": "da59ba77-d842-39fe-8737-7e0eb3d1f1ed",
                "word": "ingestort",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                        "entry_id": "da59ba77-d842-39fe-8737-7e0eb3d1f1ed",
                        "glosses": [
                            "voltooid deelwoord van instorten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1d8d547b-9875-4881-9f72-dc373dc6ecc7",
                                "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                                "text": "De aandelenmarkt is daarna volledig ingestort."
                            },
                            {
                                "example_id": "fb4a4a5a-641d-4e43-acb9-6a8ee046a82d",
                                "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                                "text": "Meteen liep ik naar mijn tent die onder het gewicht van de sneeuw voor de helft bleek te zijn ingestort."
                            },
                            {
                                "example_id": "80135afd-6cd3-47ff-923c-0669d1f85fc4",
                                "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                                "text": "Maar er moest ergens iets fout zijn gegaan, aangezien de hele gietvorm van de brugoverspanning in de slotfase was ingestort. Dat was het enige wat met zekerheid kon worden gezegd."
                            },
                            {
                                "example_id": "ae6a836b-7dc8-4786-b06d-f226196ae20e",
                                "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                                "text": "Het ingestorte huis moest geheel afgebroken worden."
                            },
                            {
                                "example_id": "0515f684-64ea-413b-9ca5-e5628c5686ca",
                                "sense_id": "a8ba8e7e-007b-3b72-b95a-f839cdea14e5",
                                "text": "In Nederland staan mogelijk honderd tot honderdvijftig gebouwen met vloeren zoals die in de ingestorte parkeergarage zijn gebruikt."
                            }
                        ]
                    }
