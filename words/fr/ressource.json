    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12a627d4-ced4-3760-8653-fc0c58087f0b",
                    "sense_definition": "Ensemble des moyens matériels, financiers ou naturels dont dispose une personne, une collectivité ou un pays.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moyens_disponibles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pays en voie de développement possède d'importantes <w>ressources</w> naturelles dans son sous-sol."
                        },
                        {
                            "text": "L'entreprise cherche un nouveau directeur pour gérer ses <w>ressources</w> humaines plus efficacement."
                        }
                    ],
                    "synonyms": [
                        "moyen",
                        "fonds",
                        "capital"
                    ],
                    "common_phrases": [
                        "ressources naturelles",
                        "ressources humaines",
                        "ressources financières"
                    ]
                },
                {
                    "sense_id": "ed89aefe-62ae-34b5-b09e-59f312c3a38d",
                    "sense_definition": "Moyen auquel on peut recourir pour se tirer d'embarras ou satisfaire un besoin urgent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "secours_recours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Acculé par ses créanciers, il n'avait plus d'autre <w>ressource</w> que de vendre sa maison."
                        },
                        {
                            "text": "Face à cette situation critique, notre dernière <w>ressource</w> a été de contacter les autorités locales."
                        }
                    ],
                    "synonyms": [
                        "recours",
                        "expédient",
                        "secours"
                    ],
                    "common_phrases": [
                        "sans ressource",
                        "dernière ressource",
                        "homme de ressource"
                    ]
                },
                {
                    "sense_id": "029a628e-cdbb-3b22-9af3-eccd95c29a45",
                    "sense_definition": "Organisme ou service d'assistance destiné à soutenir les personnes confrontées à des difficultés sociales ou psychologiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisme_aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il existe plusieurs <w>ressources</w> communautaires dans la région pour accueillir les jeunes sans domicile."
                        },
                        {
                            "text": "Si tu te sens dépassé par la situation, n'hésite pas à consulter une <w>ressource</w> spécialisée."
                        }
                    ],
                    "synonyms": [
                        "organisme",
                        "service"
                    ],
                    "common_phrases": [
                        "ressources communautaires",
                        "ressources spécialisées"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Courant au Québec"
                        }
                    ]
                },
                {
                    "sense_id": "b2fc99a7-08f6-37d5-8981-e706c7e19d2b",
                    "sense_definition": "Manœuvre par laquelle un pilote redresse brusquement un aéronef pour passer du piqué à la montée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote chevronné a effectué une <w>ressource</w> impressionnante juste avant de toucher le sol."
                        },
                        {
                            "text": "L'avion a subi de fortes turbulences pendant la <w>ressource</w> qui a suivi le piqué vertigineux."
                        }
                    ],
                    "synonyms": [
                        "redressement"
                    ],
                    "antonyms": [
                        "piqué"
                    ],
                    "common_phrases": [
                        "faire une ressource"
                    ]
                },
                {
                    "sense_id": "ed4f012c-feb8-332a-bb93-adb6c0cb5e1c",
                    "sense_definition": "Dans un vêtement, pli ou réserve d'étoffe conservé à l'intérieur pour pouvoir l'élargir.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière a laissé une généreuse <w>ressource</w> au bas du pantalon au cas où l'enfant grandirait."
                        },
                        {
                            "text": "Cette jupe ajustée ne comporte aucune <w>ressource</w> pour permettre une retouche ultérieure."
                        }
                    ],
                    "synonyms": [
                        "réserve",
                        "aisance"
                    ]
                }
            ]
        }
    ]
