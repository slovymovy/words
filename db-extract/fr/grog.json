                                    {
                                        "sense_id": "b2dd64da-23d5-3ca2-81e2-ddafbe770b1c",
                                        "entry_id": "5bdbc379-7e2f-3187-b845-a9e2ddd7416a",
                                        "glosses": [
                                            "крепкий спиртной напиток, приготовленный из водки или рома, разбавленного горячей водой с сахаром"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f03bbf4b-875d-4728-95a8-dc3299b80240",
                                                "sense_id": "b2dd64da-23d5-3ca2-81e2-ddafbe770b1c",
                                                "text": "В награду пьяным ― он нальёт // И пунш, и грог душистый .."
                                            },
                                            {
                                                "example_id": "7cfb2ad3-1af8-446b-b436-cb0fb11ed9bc",
                                                "sense_id": "b2dd64da-23d5-3ca2-81e2-ddafbe770b1c",
                                                "text": "Послужи с моё да испытай столько же бурь, тогда уверишься, что добрый стакан грогу лучше всех непромокаемых шинелей и всех противопростудных лекарств .."
                                            },
                                            {
                                                "example_id": "ef50906c-be92-4359-80c1-9ae775868037",
                                                "sense_id": "b2dd64da-23d5-3ca2-81e2-ddafbe770b1c",
                                                "text": "Я спросил стакан грогу, усаживаясь в стойло под трельяжем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
