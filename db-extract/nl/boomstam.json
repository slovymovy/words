                "senses": [
                    {
                        "sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
                        "entry_id": "fdfb7e77-8365-3e95-8ee7-bf09aa99fe0e",
                        "glosses": [
                            "een rechtop gaande houten schacht van een boom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf16e40-f56d-4d48-999a-88fa1a3971b7",
                                "sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
                                "text": "De omgehakte boomstammen worden drijvend op de rivier vervoerd."
                            },
                            {
                                "example_id": "eb79458d-f164-4702-bd63-00aebaa95247",
                                "sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
                                "text": "Grote omgevallen boomstammen zaten klem tussen de rotsen en waren geheel kaal en afgestompt door de sterke stroming die miljoenen liters smeltwater per dag uit de bergen moest verwerken."
                            },
                            {
                                "example_id": "3ba76442-8dae-40a8-a536-13de9935866a",
                                "sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
                                "text": "Die bezwering was een van de redenen dat hij liever in een eenvoudig ongeverfd houten huis bij de bouw was gaan wonen dan bij de andere ingenieurs in het Centralhotellet in Kramfors, hij wilde in de buurt van het gedreun van de heimachine zijn wanneer de boomstammen in de bodem van de rivier werden gedreven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37700c72-e9f6-4856-b025-565fdd15f900",
                        "source_entry_id": "fdfb7e77-8365-3e95-8ee7-bf09aa99fe0e",
                        "source_sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
                        "source_sense_description": "een rechtop gaande houten schacht van een boom",
                        "target_lang_word": "Baumstamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baumstamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61c4491c-189f-3ddc-82a2-7f92ec5a1df6",
                                        "entry_id": "8cd56809-e494-3eef-a13b-8eee58e62036",
                                        "glosses": [
                                            "die Verbindung eines Baumes zwischen der Wurzel und Baumkrone"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97833116-6207-41a9-ab23-2f053f48f9bd",
                                                "sense_id": "61c4491c-189f-3ddc-82a2-7f92ec5a1df6",
                                                "text": "„Er wollte sich auf einen abgehauenen Baumstamm am Ufer des künstlichen Baches stellen, um sich im Wasser zu spiegeln.“"
                                            },
                                            {
                                                "example_id": "88249d82-0fb2-41e2-8f58-420b5403ddb3",
                                                "sense_id": "61c4491c-189f-3ddc-82a2-7f92ec5a1df6",
                                                "text": "„Ich tastete mich vorsichtig an einen Baumstamm heran und ging dahinter in die Hocke.“"
                                            },
                                            {
                                                "example_id": "3ecbc277-8d12-427f-9d4e-e8775ce3a8d7",
                                                "sense_id": "61c4491c-189f-3ddc-82a2-7f92ec5a1df6",
                                                "text": "„Auf dem Wasser treibt ein Baumstamm vorbei, über die Hohenzollernbrücke fährt langsam ein roter Zug.“"
                                            },
                                            {
                                                "example_id": "11c745fb-d819-4068-8d4a-0f4e382f242b",
                                                "sense_id": "61c4491c-189f-3ddc-82a2-7f92ec5a1df6",
                                                "text": "„Es wimmelte von Haifischen, und wir mussten gut aufpassen, dass sie uns nicht am Bein schnappten, während wir uns mit den Baumstämmen abmühten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e654d5-0a1d-4bc7-92df-c64b7d44ca5b",
                        "source_entry_id": "fdfb7e77-8365-3e95-8ee7-bf09aa99fe0e",
                        "source_sense_id": "1cd1749d-a15e-3ed7-8cb3-e8599bd7ade0",
