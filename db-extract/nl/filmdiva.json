                        "examples": [
                            {
                                "example_id": "7b8a158e-9272-4a6c-9580-bacedbd85e7c",
                                "sense_id": "c85a5fc5-8f1f-371b-bbbc-22b9461714f5",
                                "text": "Sophia Loren, de bijna 84-jarige Italiaanse filmdiva, ontving vandaag de Grand Acting Award tijdens het filmfestival Film by the Sea. Jeroen Wollaars blikt met La Loren terug op haar productieve filmcarrière."
                            },
                            {
                                "example_id": "47f8b6b1-eb89-4501-b1fa-e746edd42f57",
                                "sense_id": "c85a5fc5-8f1f-371b-bbbc-22b9461714f5",
                                "text": "Voor het derde opeenvolgende jaar haalt Herman van der Zandt in het NOS jaaroverzicht Over de Doden herinneringen op aan personen die in 2012 zijn overleden. Sommige overledenen zijn wereldberoemd, zoals zangeres Whitney Houston, de eerste man op de maan Neil Armstrong en de Nederlandse filmdiva Sylvia Kristel. Anderen zijn in de schaduw gebleven terwijl hun verdiensten of vindingen veel invloed hebben op ons leven. De Amerikaan Eugene Polley bijvoorbeeld, hij is de uitvinder van de afstandsbediening. Of de Italiaan Carlo Rambaldi, hij ontwierp voor Steven Spielberg het bekendste en ontroerendste ruimtewezen: ET."
                            }
                        ]
                    }
