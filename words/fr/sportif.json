    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1866d6df-0125-31aa-a6ec-32ed64578a4d",
                    "sense_definition": "Qui pratique régulièrement une activité physique ou qui aime faire du sport.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère cadet est très <w>sportif</w> et va s'entraîner tous les matins au gymnase."
                        },
                        {
                            "text": "Toute la famille est particulièrement <w>sportive</w> et aime passer le week-end à vélo."
                        }
                    ],
                    "antonyms": [
                        "sédentaire"
                    ]
                },
                {
                    "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                    "sense_definition": "Relatif au sport ou à ses activités.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "domaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau complexe <w>sportif</w> de la ville ouvrira ses portes au public dès demain."
                        },
                        {
                            "text": "Les enfants participent chaque mercredi à une activité <w>sportive</w> organisée par l'école."
                        }
                    ],
                    "common_phrases": [
                        "complexe sportif",
                        "activité sportive",
                        "événement sportif"
                    ]
                },
                {
                    "sense_id": "63a17a2f-f0b0-3b97-9151-68dadce5596c",
                    "sense_definition": "Qui exige un effort physique soutenu, du dynamisme ou de la vivacité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dynamique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La montée vers le sommet du col a été particulièrement <w>sportive</w> pour les randonneurs."
                        },
                        {
                            "text": "Il conduit souvent de manière <w>sportive</w> sur les routes sinueuses de montagne."
                        }
                    ],
                    "common_phrases": [
                        "conduite sportive"
                    ]
                },
                {
                    "sense_id": "f4e45333-d990-33de-99eb-7a393cb15f82",
                    "sense_definition": "Conforme aux valeurs de loyauté, d'honnêteté et de respect propres à l'éthique du sport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accepter sa défaite sans chercher d'excuses est une réaction tout à fait <w>sportive</w>."
                        },
                        {
                            "text": "Les joueurs ont eu un comportement exemplaire et très <w>sportif</w> durant toute la finale."
                        }
                    ],
                    "synonyms": [
                        "fair play"
                    ],
                    "antonyms": [
                        "antisportif"
                    ],
                    "common_phrases": [
                        "esprit sportif"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e2a85e7f-4038-3964-a475-f2ca4425bb4f",
                    "sense_definition": "Personne qui pratique un sport, comme amateur ou comme professionnel.",
