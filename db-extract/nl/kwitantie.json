                                                "sense_id": "003344a6-fd6c-3644-af78-4adc7d300f59",
                                                "text": "She had a receipt to make white hair black."
                                            },
                                            {
                                                "example_id": "cf4c6cab-466b-485e-86a1-55af5ba81bf4",
                                                "sense_id": "003344a6-fd6c-3644-af78-4adc7d300f59",
                                                "text": "Nor were we without guests: sometimes farmer Flamborough, our talkative neighbour, and often the blind piper, would pay us a visit, and taste our gooseberry wine; for the making of which we had lost neither the receipt nor the reputation."
                                            },
                                            {
                                                "example_id": "0372c7df-e192-48af-8e6d-f97737cc9e73",
                                                "sense_id": "003344a6-fd6c-3644-af78-4adc7d300f59",
                                                "text": "Have you never eaten them, either preserved or candied […] if you will allow me, Sir, I shall be very happy to send the receipt to your housekeeper."
                                            }
                                        ]
