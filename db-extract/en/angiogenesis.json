                ],
                "senses": [
                    {
                        "sense_id": "241bbcce-3e32-3e4c-be87-5424f6b875ba",
                        "entry_id": "fbbe803b-6438-3853-823f-4677d295ad06",
                        "glosses": [
                            "The formation and development of new blood vessels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f8c0ac-df2c-4cc8-9fc2-e432ebb16eda",
                                "sense_id": "241bbcce-3e32-3e4c-be87-5424f6b875ba",
                                "text": "Some of the most promising new cancer drugs block this process of ‘angiogenesis’, or blood-vessel formation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4240cf0-27ea-4591-891d-da185b5c42ec",
                        "source_entry_id": "fbbe803b-6438-3853-823f-4677d295ad06",
                        "source_sense_id": "241bbcce-3e32-3e4c-be87-5424f6b875ba",
                        "source_sense_description": "The formation and development of new blood vessels",
                        "target_lang_word": "angiogenèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angiogenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c73fe3e-5b65-3252-be99-d46002e1fa95",
                                        "entry_id": "123481ed-f938-321a-864c-edad6f1c7533",
                                        "glosses": [
                                            "Création de vaisseaux sanguins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b24c71d-91fd-4f1c-8a1c-cd02b435705e",
                                                "sense_id": "5c73fe3e-5b65-3252-be99-d46002e1fa95",
                                                "text": "En revanche, l’angiogenèse est massive lors de la phase invasive et métastasiante."
                                            },
                                            {
                                                "example_id": "1744b84e-d34c-481d-9d7d-c5cdb127531a",
                                                "sense_id": "5c73fe3e-5b65-3252-be99-d46002e1fa95",
                                                "text": "L’angiogenèse est médiée par ce type de facteurs paracrines, tels que le VEGF (vascular endothelial growth factor) ou le FGF2 (fibroblast growth factor 2) ou des métalloprotéinases qui libèrent ces facteurs des matrices extracellulaires."
                                            },
                                            {
                                                "example_id": "75beca60-fcbb-4c9b-9c16-e5f2f8b06966",
                                                "sense_id": "5c73fe3e-5b65-3252-be99-d46002e1fa95",
                                                "text": "Le FGF1 (fibroblast growth factor 1) est un facteur de croissance connu pour son rôle dans l’angiogenèse, qui est également impliqué dans la myogenèse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
