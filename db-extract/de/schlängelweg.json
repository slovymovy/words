                    {
                        "sense_id": "bf6cf2e7-cae1-3b4d-90a6-c67830c0f705",
                        "entry_id": "1a1d62ea-95b0-3e6d-b127-c76b8421806c",
                        "glosses": [
                            "Weg mit sehr vielen Kurven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc3ae75-dbc5-4c76-8026-667b34007b2e",
                                "sense_id": "bf6cf2e7-cae1-3b4d-90a6-c67830c0f705",
                                "text": "„Dann, ohne daß weiter ein Wort gesprochen worden wäre, schritt man dem Schlängelwege zu, der auf die Roßtrappe hinaufführte.“"
                            },
                            {
                                "example_id": "2b574580-0b43-42ac-afba-8e3fce5c6a72",
                                "sense_id": "bf6cf2e7-cae1-3b4d-90a6-c67830c0f705",
                                "text": "Alte Eisenbahnstrecken erfordern oft eine erhebliche Fahrzeit, da sie einst als Schlängelwege gebaut wurden, ohne Rücksicht auf höhere Geschwindigkeit."
                            }
                        ],
