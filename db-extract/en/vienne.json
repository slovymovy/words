                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a1a7376-41e9-3fc4-897a-fd74d1bb13df",
                        "entry_id": "462247e9-e4dd-3ddf-bf0c-f99aa6bd780d",
                        "glosses": [
                            "A department of Nouvelle-Aquitaine, France. Capital and largest city: Poitiers."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a6e9fd7d-a0d7-3778-ad18-06a36f9bd5ee",
                        "entry_id": "462247e9-e4dd-3ddf-bf0c-f99aa6bd780d",
                        "glosses": [
                            "A left tributary of the Loire in southwest France, flowing through the departments of Corrèze, Creuse, Haute-Vienne, Charente, Vienne and Indre-et-Loire."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0a13fcc5-cf7b-3aae-b144-1dfaa9b6af00",
                        "entry_id": "462247e9-e4dd-3ddf-bf0c-f99aa6bd780d",
                        "glosses": [
                            "A town and commune of Isère department, Auvergne-Rhône-Alpes, France."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f63f20e0-dc44-4ace-b893-14ec43b2f13c",
                        "source_entry_id": "462247e9-e4dd-3ddf-bf0c-f99aa6bd780d",
                        "source_sense_description": "department of France",
                        "target_lang_word": "Vienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2076db-23f1-3e47-b044-398708cdc0a7",
                                        "entry_id": "790ee6af-323c-3e59-bebb-3ae842b8d4d0",
                                        "glosses": [
                                            "Capitale de l’Autriche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12a523a-4b2d-4bfe-b196-34f4e64992fc",
                                                "sense_id": "4d2076db-23f1-3e47-b044-398708cdc0a7",
                                                "text": "Il existe à Vienne une ordonnance de police qui défend de fumer dans les rues ; chaque individu, au moment d’arriver sous la porte du rempart, éteint sa pipe sans murmurer, sauf à la rallumer quand il sortira de la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f991f142-8951-3719-9316-3a35a3bb0d43",
                                        "entry_id": "790ee6af-323c-3e59-bebb-3ae842b8d4d0",
                                        "glosses": [
                                            "Land d’Autriche, enclavé dans celui de Basse-Autriche, ayant pour capitale la ville de Vienne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "300cf002-f45b-3b63-a670-7ed99aa61570",
                                        "entry_id": "790ee6af-323c-3e59-bebb-3ae842b8d4d0",
                                        "glosses": [
                                            "Petite rivière affluent du Danube traversant la ville de Vienne en Autriche."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Vienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5687931d-f930-3ca0-b063-c3142f29ab5f",
                                        "entry_id": "892fb8c1-d7ad-3443-a1e0-d6a44faac905",
                                        "glosses": [
                                            "Commune française, située dans le département de l’Isère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a284f2d8-0b2c-4457-b12f-d3e0363245f1",
                                                "sense_id": "5687931d-f930-3ca0-b063-c3142f29ab5f",
                                                "text": "Mais, pour que ne périsse pas la mémoire à tant de titres recommandable des trois sièges archiépiscopaux , savoir, Arles, Narbonne et Vienne en Dauphiné, dont l'érection n'a pas lieu, nous ordonnons d'ajouter leurs noms titulaires à d'autres sièges archiépiscopaux , […]."
                                            },
                                            {
                                                "example_id": "7a608e95-dd06-4179-8d3a-84a023f9a3f6",
                                                "sense_id": "5687931d-f930-3ca0-b063-c3142f29ab5f",
                                                "text": "Les moines et les prêtres surprirent le pauvre homme, le jetèrent en prison, et le firent conduire à Vienne en Dauphiné, où résidait l’archevêque. Rénier préféra être brûlé vif, plutôt que de rien céder."
                                            },
                                            {
                                                "example_id": "949e5a62-74fd-4378-8265-6efb2d3e6981",
                                                "sense_id": "5687931d-f930-3ca0-b063-c3142f29ab5f",
                                                "text": "Le Chêne-vert remonte jusqu'à Vienne, l'Alaterne va au Lyonnais et au Graisivaudan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Vienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ed45e7-ed3e-3f0c-bdd3-bb3098e5b64b",
                                        "entry_id": "805e3eb7-0669-3804-aa3e-361849db33b0",
                                        "glosses": [
                                            "Rivière du centre-ouest de la France qui court du Limousin au Poitou, affluent de la Loire."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62487efb-e3de-31cd-9b6e-e9da45aae17d",
                                        "entry_id": "805e3eb7-0669-3804-aa3e-361849db33b0",
                                        "glosses": [
                                            "Département de Nouvelle-Aquitaine, qui porte le numéro 86 et dont le chef-lieu est Poitiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c991e49-97f8-4120-acb1-d1a7aa5ae18b",
                                                "sense_id": "62487efb-e3de-31cd-9b6e-e9da45aae17d",
                                                "text": "Tels furent jadis le Clairon de Sidi-Brahim de la place du Tertre, ou le Chat-Noir, du temps que Narcisse Lebeau rimait :\nDans le passage Vivienne,\nElle me dit : Je suis d’ la Vienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d593a73-233f-3b7c-acf5-e29d6ba8d225",
                                        "entry_id": "805e3eb7-0669-3804-aa3e-361849db33b0",
                                        "glosses": [
                                            "Petite rivière en Seine-Maritime, affluent de la Saâne."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
