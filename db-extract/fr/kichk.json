                        "examples": [
                            {
                                "example_id": "4d32cdbd-86e2-4930-91ad-c0cd89e1200d",
                                "sense_id": "2e8305c5-31a1-3106-8837-2f190599196e",
                                "text": "Le mot kichk n’est nullement destiné à servir de sobriquet ; il désigne une sorte de soupe épaisse et aigre à base de lait caillé et de blé. C’est l’un des plus vieux monuments culinaires que l’on puisse visiter aujourd’hui […]"
                            },
                            {
                                "example_id": "f080e799-60d5-4b6b-9b01-b3be284258a5",
                                "sense_id": "2e8305c5-31a1-3106-8837-2f190599196e",
                                "text": "Le dimanche soir, la famille était rassemblée autour d’un plat de kichk, à tremper des bouchées de pain dans la soupe épaisse."
                            }
                        ]
                    }
