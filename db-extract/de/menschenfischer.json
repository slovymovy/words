                "senses": [
                    {
                        "sense_id": "0c45a681-5691-382f-8c13-c6ff3e2e25b0",
                        "entry_id": "154bb2ea-ddb7-3cf7-b20e-7e0741119a49",
                        "glosses": [
                            "jemand, der Menschen für seine Überzeugung, Sache oder Glauben gewinnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6abb3c2b-120d-4796-b217-e5081f6ee484",
                                "sense_id": "0c45a681-5691-382f-8c13-c6ff3e2e25b0",
                                "text": "„Die Interview-Impressionen zeigen, wie ungewöhnlich dieser Menschenfischer an der Spitze des Welt-Währungsfonds wirkte, sonst Arbeitsstätte nüchterner Technokraten, die Geldmassen bewegen, aber dabei selten die Massen. Einer von Strauss-Kahns Vorgängern hieß: Horst Köhler.“"
                            },
                            {
                                "example_id": "1850a578-b510-473b-ac48-785d86f39d73",
                                "sense_id": "0c45a681-5691-382f-8c13-c6ff3e2e25b0",
                                "text": "„Und er sprach zu ihnen: Folgt mir nach; ich will euch zu Menschenfischern machen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
