                "senses": [
                    {
                        "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                        "entry_id": "b7613141-5e11-3be8-81ab-c144b57d484b",
                        "glosses": [
                            "bestimmter Aspekt/bestimmte Dimension der Persönlichkeit (eines Menschen)"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "37134d58-74e2-4141-8670-c85061b5b953",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Die analytische Psychotherapie fokussiert Persönlichkeitsanteile, lebensüberdauernde Muster im Erleben und Verhalten, von Denk- und Bewertungsprozessen wie v. a. auch Muster in Beziehungen.“"
                            },
                            {
                                "example_id": "24a15dfe-fdab-4565-a68b-7f326a6cb763",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Das Ausleben weiblicher Persönlichkeitsanteile bedeutete dabei auch die Befreiung von bürgerlichen Normen und Männlichkeitsidealen.“"
                            },
                            {
                                "example_id": "a98ed88b-bf05-4af5-9c6e-23fc8d1526f7",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Gleichzeitig kann man den individuellen Menschen als System verstehen, mit all seinen Persönlichkeitsanteilen, Verhaltensmustern, Wünschen, Werten, Glaubenssätzen, Fähigkeiten, usw.“"
                            },
                            {
                                "example_id": "823e497d-73e0-4f0b-b2bc-586e5d78232c",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Beim Atmen und Spüren begleite ich mit dir diese oft unbewussten Persönlichkeitsanteile.“"
                            },
                            {
                                "example_id": "e4afed4f-ee54-48e0-a64f-e64c54bb0305",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Sie symbolisieren verschiedene Persönlichkeitsanteile, innere Stimmen und schlummernde Anlagen persönlicher sowie kollektiver Art.“"
                            },
                            {
                                "example_id": "7ec83f87-7260-49ea-bea8-b22f0f6ada38",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Damit ich durch den Tag komme, unterdrücke ich einige meiner Persönlichkeitsanteile, wie z. B. meinen Humor.“"
                            },
                            {
                                "example_id": "88c08b23-5338-4cef-9d54-45b14364738f",
                                "sense_id": "7d0ee908-023e-3717-a36b-588b7e05bda0",
                                "text": "„Der Persönlichkeitsanteil, der am Leben verhindert und zurückhalten wurde und noch wird, erzeugt Angst und manifestiert Angst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
