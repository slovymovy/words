                        "entry_id": "527db3d1-18ec-36a9-b780-b6fec76ce36a",
                        "glosses": [
                            "stubby, stumpy; Lacking shapeliness or finesse."
                        ],
                        "tags": [
                            "dated",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "a1547467-b59e-4361-9ca6-2be0c555a710",
                                "sense_id": "288ffd6c-ce33-3ae1-9b6a-4bafdf3a9a9c",
                                "text": "Why is its brim an object to be perpetually plucked and pinched with dubby fingers?"
                            },
                            {
                                "example_id": "ac5f404b-57ef-41db-8833-18fbaaf54585",
                                "sense_id": "288ffd6c-ce33-3ae1-9b6a-4bafdf3a9a9c",
                                "text": "I look just like all short, dubby, light-complexioned girls."
                            }
