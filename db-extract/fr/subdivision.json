                                    {
                                        "sense_id": "50f11b35-860a-36f3-9780-993beb61e6b5",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A division into smaller pieces of something that has already been divided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cf19f8-7b5a-4458-86ee-9e677969f08a",
                                                "sense_id": "50f11b35-860a-36f3-9780-993beb61e6b5",
                                                "text": "Formosa: Prewar conditions in Formosa were described in an article in FOREIGN COMMERCE WEEKLY of January 1, 1944. According to an announcement of the official Chinese News Service, there are to be 8 chief administrative subdivisions of Formosa. Although it is not known that their boundary lines will exactly coincide with those of the provinces under Japanese rule, this is probable. Names of the new hsien (districts), with corresponding Japanese province names in parentheses, are as follows: Taipei (Taihoku); Hsinchu (Shinchiku); Taichung (Taichu); Tainan (Tainan); Kaohsiung (Takao); Hwalienkan (Karenko); and Taitung (Taito). The Pescadores Islands form the eighth hsien. Nine cities will continue to be recognized as municipalities: Taipei (Taihoku); Taichung (Taichu); Tainan (Tainan); Chilung (Kiirun or Keelung); Kaohsiung (Takao); Hsinchu (Shinchiku); Chiayi (Kagi); Changhua (Shoka); and Pintung (Heito)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82054013-4c5c-31ad-9ecf-edc9b6a1d3a8",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "Such a piece that has been divided."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fbbf99-01e8-463e-8427-4c2c01daf521",
                                                "sense_id": "82054013-4c5c-31ad-9ecf-edc9b6a1d3a8",
                                                "text": "Work on one subdivision at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78d3f92-f7bb-3336-98bf-4d8dca064843",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A parcel of land that has been divided into lots."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A group of houses created by the same builder or in the same general area."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2718abd6-8d5b-41d1-9a0c-41622c7b2fcc",
                                                "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                                                "text": "They're putting in a new subdivision out past Black Ranch Road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                        "entry_id": "ee4714c6-d77f-3072-b9a7-8693b15028b5",
                                        "glosses": [
                                            "A gated community located within a barangay."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73fe8a2a-b510-4850-aa5d-02d3c139f575",
                                                "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                                "text": "... By the 1970s, cattle rustling had fallen by the wayside, as tractors replaced carabaos and industrial estates and residential subdivisions supplanted rice fields as the mainstays of Cavite's suburban northern towns."
                                            },
                                            {
                                                "example_id": "b55569e5-2234-4e90-b10a-4a10485f8e2e",
                                                "sense_id": "b9232ed8-141a-3d49-a499-f2b448ae44a5",
                                                "text": "As the farms give way to the residential subdivisions and industrial estates, the centuries-old traditional Filipino houses, slightly raised above grounds and standing on stilts, are abandoned in the quest for more living space."
                                            }
                                        ]
                                    }
                                ]
