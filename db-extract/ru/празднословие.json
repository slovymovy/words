                    },
                    {
                        "translation_id": "aac2d0f0-8b17-4d57-b5cf-731a2e72704b",
                        "source_entry_id": "b9982d2c-0dd4-3123-a779-1dfe75c522b0",
                        "source_sense_id": "c2cd2be5-8aa6-3653-bcd2-c0e4cc27c938",
                        "target_lang_word": "verbalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "636b3cf8-4300-33cb-b26a-b3a67d96b41e",
                                        "entry_id": "74122a0f-89a8-319c-8459-47ba610f5493",
                                        "glosses": [
                                            "Caractère de ce qui est purement verbal, c’est-à-dire où il n’y a que des mots et pas d’idées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dfedc2-5f50-4519-b1d6-8258c24370c7",
                                                "sense_id": "636b3cf8-4300-33cb-b26a-b3a67d96b41e",
                                                "text": "Le développement de ce discours n’est que verbalisme."
                                            },
                                            {
                                                "example_id": "4da672c2-cc80-41bd-9b67-3f653ba31326",
                                                "sense_id": "636b3cf8-4300-33cb-b26a-b3a67d96b41e",
                                                "text": "C’est du pur verbalisme."
                                            },
                                            {
                                                "example_id": "cc54d3fe-a8be-43fb-810b-9cdbeb5c77fa",
                                                "sense_id": "636b3cf8-4300-33cb-b26a-b3a67d96b41e",
                                                "text": "Quelques beaux vers, quelques beaux cris, ne rachètent pas ce flot incolore de verbalisme romain, d’où toute vie s’est retirée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
