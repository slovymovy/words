    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                "word": "irritability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3f76b121-bf67-4a9c-92f0-10fd3b127198",
                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "tags": [
                            "plural"
                        ],
                        "form": "irritabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "glosses": [
                            "The state or quality of being irritable; quick excitability."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "68377965-7c3c-4f14-b138-cde94830a2b1",
                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                "text": "irritability of temper"
                            },
                            {
                                "example_id": "e08ccc36-3a93-40a6-b0fd-7b7059eddddf",
                                "sense_id": "bb85c4d6-6ca0-3d43-a612-8ca2103f3e3d",
                                "text": "Blue No. 1 and yellow No. 6 may also be toxic to some human cells. And as little as 1 milligram of yellow dye No. 5 may cause irritability, restlessness and sleep disturbances for sensitive children."
                            }
                        ]
                    },
                    {
                        "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "glosses": [
                            "A natural susceptibility, characteristic of all living organisms, tissues, and cells, to the influence of certain stimuli, response being manifested in a variety of ways."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0b6d0c-eaa6-47c6-87d3-8c8efe97b192",
                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                "text": "We find a renitency in ourselves to ascribe life and irritability to the cold and motionless fibres of plants."
                            },
                            {
                                "example_id": "67512995-dc4c-47a9-99ac-90a1e34da714",
                                "sense_id": "8792fa4c-4ec0-324a-b86e-d2e15038c23d",
                                "text": "There is growth only in plants; but there is irritability, or, a better word, instinctivity, in insects."
                            }
                        ]
                    },
                    {
                        "sense_id": "74ccd5ce-5409-3500-9eb8-f5cd47deee34",
                        "entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "glosses": [
                            "A condition of morbid excitability of an organ or part of the body; undue susceptibility to the influence of stimuli."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02f514a4-0250-47ab-8d35-cbb938cdf836",
                        "source_entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "source_sense_description": "state or quality of being irritable",
                        "target_lang_word": "irritabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irritabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                        "entry_id": "e3b68897-7e88-3388-a178-011dcb9168ac",
                                        "glosses": [
                                            "Caractère de celui qui s’irrite facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16da00c5-532b-4e9b-8f03-0846eb37114e",
                                                "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                                "text": "Il est d’une grande irritabilité."
                                            },
                                            {
                                                "example_id": "eb8080c2-c5e5-441e-b4f2-2f224c60b574",
                                                "sense_id": "eaeb3d51-3b83-32f5-a6af-5f03fc8d0407",
                                                "text": "L’irritabilité du caractère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                        "entry_id": "e3b68897-7e88-3388-a178-011dcb9168ac",
                                        "glosses": [
                                            "Qualité de ce qui est irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cead8176-45fc-4e02-8c5e-ef76ed1ef1c1",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "L’irritabilité des fibres, des muscles."
                                            },
                                            {
                                                "example_id": "eb38ff5d-187a-4d45-bc79-3b151d3cba10",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "Les premiers montraient que l’irritabilité musculaire était conservée lorsque le cerveau ou la moelle étaient lésés, ce qui tendait à faire de l’irritabilité une propriété inhérente à la fibre musculaire."
                                            },
                                            {
                                                "example_id": "972ee3a3-ee86-4d2a-8ac3-01e67ec2a2a6",
                                                "sense_id": "2c7163bc-a99b-3d56-a4bf-ec8ebbfbbd08",
                                                "text": "Les névroses idiopathiques de la vie de relation, dont le siége peut être dans les expansions ou les cordons nerveux, sont également précédées de phlegmasies, lorsque l’inflammation, en ramollissant les tissus, a exalté la sensibilité, au point de développer des névralgies, des mouvemens convulsifs, des paralysies, a augmenté, diminué ou aboli l’irritabilité des expansions vasculo-nerveuses qui forment les sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f61ac708-789a-48ac-8640-134ed53ef701",
                        "source_entry_id": "4cdfa1fc-8d63-344e-ba3f-b2959167b209",
                        "source_sense_description": "state or quality of being irritable",
                        "target_lang_word": "Reizbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reizbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                                        "entry_id": "afe7ce93-e840-3570-b784-cc72e332b4a9",
                                        "glosses": [
                                            "Eigenschaft, leicht aufgeregt/erregt werden zu können/leicht reizbar zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c8edf9-034e-4693-a1a6-640886ff9684",
                                                "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                                                "text": "„Seine Reizbarkeit nahm zu, und seine grundlosen Wutausbrüche gingen jetzt grösstenteils auf die Prinzessin Marja nieder.“"
                                            },
                                            {
                                                "example_id": "927be16e-198a-42b9-b0e7-e7c2ed6651ec",
                                                "sense_id": "cc51d636-20b4-3fe9-9ed1-a0a4685a2a24",
                                                "text": "„Aber seine Reizbarkeit nahm mit jedem Monat zu, man kann auch sagen mit jedem Tag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
